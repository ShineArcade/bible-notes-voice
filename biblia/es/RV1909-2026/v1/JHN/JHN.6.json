{"book": "JHN", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 516683, "verses": [{"verse": 1, "start": 300, "end": 6799, "text": "Pasadas estas cosas, Jesús fue al otro lado del mar de Galilea, que es de Tiberias.", "words": [[0, 300], [8, 788], [14, 1088], [21, 2128], [27, 2588], [31, 2993], [34, 3293], [39, 3533], [44, 3873], [48, 4153], [52, 4606], [55, 5060], [64, 5513], [68, 5553], [71, 5793], [74, 5933]]}, {"verse": 2, "start": 7149, "end": 12250, "text": "Y le seguía grande multitud, porque veían sus señales que hacía en los enfermos.", "words": [[0, 7149], [2, 7234], [5, 7354], [12, 7834], [19, 8394], [29, 8954], [36, 9534], [42, 10054], [46, 10254], [54, 10834], [58, 11001], [64, 11167], [67, 11334], [71, 11494]]}, {"verse": 3, "start": 12600, "end": 17516, "text": "Y subió Jesús a un monte, y se sentó allí con sus discípulos.", "words": [[0, 12600], [2, 12723], [8, 13123], [14, 13443], [16, 13743], [19, 13843], [26, 14303], [28, 15103], [31, 15223], [37, 15723], [42, 15943], [46, 16203], [50, 16463]]}, {"verse": 4, "start": 17866, "end": 21434, "text": "Y estaba cerca la Pascua, la fiesta de los judíos.", "words": [[0, 17866], [2, 18129], [9, 18409], [15, 18789], [18, 19049], [26, 19989], [29, 20069], [36, 20449], [39, 20589], [43, 20709]]}, {"verse": 5, "start": 21784, "end": 31411, "text": "Y como alzó Jesús los ojos, y vio que había venido a él grande multitud, dice a Felipe: ¿De dónde compraremos pan para que coman estos?", "words": [[0, 21784], [2, 21930], [7, 22230], [12, 22830], [18, 23130], [22, 23670], [28, 24490], [30, 24750], [34, 24950], [38, 25090], [44, 25290], [51, 25750], [53, 25850], [56, 25990], [63, 26330], [73, 27410], [78, 27730], [80, 27910], [88, 28661], [92, 28925], [98, 29125], [110, 29805], [114, 30165], [119, 30405], [123, 30565], [129, 30905]]}, {"verse": 6, "start": 31761, "end": 36327, "text": "Pero esto decía para probarle; porque él sabía lo que había de hacer.", "words": [[0, 31761], [5, 31941], [10, 32201], [16, 32861], [21, 33161], [31, 33971], [38, 34234], [41, 34534], [47, 34994], [50, 35154], [54, 35334], [60, 35574], [63, 35754]]}, {"verse": 7, "start": 36677, "end": 43534, "text": "Le respondió Felipe: Doscientos denarios de pan no les bastarán, para que cada uno de ellos tome un poco.", "words": [[0, 36677], [3, 36822], [13, 37562], [21, 38679], [32, 38869], [41, 39509], [44, 39689], [48, 39989], [51, 40229], [55, 40389], [65, 41029], [70, 41529], [74, 41689], [79, 41929], [83, 42209], [86, 42369], [92, 42629], [97, 42949], [100, 43049]]}, {"verse": 8, "start": 43814, "end": 48163, "text": "Le dice uno de sus discípulos, Andrés, hermano de Simón Pedro:", "words": [[0, 43814], [3, 43938], [8, 44218], [12, 44578], [15, 44738], [19, 44918], [31, 45818], [39, 46438], [47, 46918], [50, 47038], [56, 47418]]}, {"verse": 9, "start": 48363, "end": 54200, "text": "Un muchacho está aquí que tiene cinco panes de cebada y dos pececillos; ¿pero qué es esto entre tantos?", "words": [[0, 48363], [3, 48492], [12, 48932], [17, 49192], [22, 49432], [26, 49592], [32, 49832], [38, 50212], [44, 50692], [47, 50812], [54, 51292], [56, 51392], [60, 51937], [72, 52648], [78, 52774], [82, 52974], [85, 53114], [90, 53374], [96, 53534]]}, {"verse": 10, "start": 54480, "end": 64790, "text": "Entonces Jesús dijo: Haced recostar la gente. Y había mucha hierba en aquel lugar: y se recostaron como número de cinco mil varones.", "words": [[0, 54480], [9, 54996], [15, 55576], [21, 56571], [27, 56995], [36, 57735], [39, 57875], [46, 58744], [48, 58841], [54, 59001], [60, 59401], [67, 59981], [70, 60121], [76, 60421], [83, 61034], [85, 61254], [88, 61374], [99, 62154], [104, 62434], [111, 62934], [114, 63264], [120, 63594], [124, 64227]]}, {"verse": 11, "start": 65140, "end": 76614, "text": "Y tomó Jesús aquellos panes, y habiendo dado gracias, repartió a los discípulos, y los discípulos a los que estaban recostados: asimismo de los peces, cuanto querían.", "words": [[0, 65140], [2, 65264], [7, 65544], [13, 65844], [22, 66204], [29, 66904], [31, 67424], [40, 67724], [45, 67964], [54, 69224], [63, 69744], [65, 69824], [69, 69924], [81, 70644], [83, 71084], [87, 71224], [98, 71864], [100, 72244], [104, 72344], [108, 72444], [116, 72804], [128, 74424], [137, 74714], [140, 74834], [144, 74954], [151, 75404], [158, 75854]]}, {"verse": 12, "start": 76964, "end": 84593, "text": "Y como fueron saciados, dijo a sus discípulos: Recoged los pedazos que han quedado, porque no se pierda nada.", "words": [[0, 76964], [2, 77070], [7, 77270], [14, 77570], [24, 78650], [29, 79030], [31, 79250], [35, 79410], [47, 80519], [55, 81243], [59, 81443], [67, 82103], [71, 82203], [75, 82323], [84, 82863], [91, 83283], [94, 83523], [97, 83663], [104, 84063]]}, {"verse": 13, "start": 84943, "end": 93411, "text": "Recogieron pues, y llenaron doce cestas de pedazos de los cinco panes de cebada, que sobraron a los que habían comido.", "words": [[0, 84943], [11, 85568], [17, 85828], [19, 86208], [28, 86648], [33, 87128], [40, 87708], [43, 87808], [51, 88448], [54, 88568], [58, 88768], [64, 89268], [70, 89928], [73, 90048], [81, 90608], [85, 91148], [94, 91828], [96, 92068], [100, 92188], [104, 92328], [111, 92668]]}, {"verse": 14, "start": 93761, "end": 102235, "text": "Aquellos hombres entonces, cuando vieron la señal que Jesús había hecho, decían: Este verdaderamente es el profeta que había de venir al mundo.", "words": [[0, 93761], [9, 94180], [17, 94460], [27, 95380], [34, 95480], [41, 95900], [44, 96040], [50, 96460], [54, 96580], [60, 96860], [66, 97220], [73, 97860], [81, 98866], [86, 99106], [101, 99926], [104, 100226], [107, 100366], [115, 100806], [119, 100986], [125, 101186], [128, 101366], [134, 101566], [137, 101726]]}, {"verse": 15, "start": 102515, "end": 110813, "text": "Y entendiendo Jesús que habían de venir para arrebatarle, y hacerle rey, volvió a retirarse al monte, él solo.", "words": [[0, 102515], [2, 102658], [14, 103338], [20, 103738], [24, 104113], [31, 104353], [34, 104573], [40, 104833], [45, 105113], [58, 106193], [60, 106633], [68, 107153], [73, 107893], [80, 108373], [82, 108453], [92, 109073], [95, 109233], [102, 109723], [105, 110213]]}, {"verse": 16, "start": 111163, "end": 114986, "text": "Y como se hizo tarde, descendieron sus discípulos al mar;", "words": [[0, 111163], [2, 111249], [7, 111469], [10, 111669], [15, 111929], [22, 112769], [35, 113489], [39, 113709], [50, 114329], [53, 114549]]}, {"verse": 17, "start": 115336, "end": 124335, "text": "Y entrando en un barco, venían de la otra parte del mar hacia Capernaum. Y era ya oscuro, y Jesús no había venido a ellos.", "words": [[0, 115336], [2, 115520], [11, 116040], [14, 116200], [17, 116320], [24, 116840], [31, 117520], [34, 117660], [37, 117780], [42, 117920], [48, 118280], [52, 118560], [56, 118820], [62, 119260], [73, 120340], [75, 120608], [79, 120778], [82, 120948], [90, 121928], [92, 122028], [98, 122368], [101, 122928], [107, 123168], [114, 123648], [116, 123788]]}, {"verse": 18, "start": 124685, "end": 128385, "text": "Y levantábase el mar con un gran viento que soplaba.", "words": [[0, 124685], [2, 124815], [14, 125695], [17, 125915], [21, 126195], [25, 126495], [28, 126675], [33, 126875], [40, 127455], [44, 127615]]}, {"verse": 19, "start": 128735, "end": 138990, "text": "Y cuando hubieron navegado como veinticinco o treinta estadios, ven a Jesús que andaba sobre el mar, y se acercaba al barco: y tuvieron miedo.", "words": [[0, 128735], [2, 128977], [9, 129237], [18, 129697], [27, 130257], [32, 130727], [44, 131197], [46, 131597], [54, 131997], [64, 133137], [68, 133477], [70, 133777], [76, 134097], [80, 134437], [87, 134857], [93, 135177], [96, 135397], [101, 135657], [103, 136137], [106, 136277], [115, 136937], [118, 137117], [125, 137878], [127, 137998], [136, 138398]]}, {"verse": 20, "start": 139340, "end": 142973, "text": "Pero él les dijo: Yo soy; no tengáis miedo.", "words": [[0, 139340], [5, 139503], [8, 139923], [12, 140128], [18, 140857], [21, 141104], [26, 141736], [29, 141919], [37, 142359]]}, {"verse": 21, "start": 143323, "end": 150322, "text": "Ellos entonces quisieron recibirle en el barco: y de inmediato el barco llegó a la tierra donde iban.", "words": [[0, 143323], [6, 143721], [15, 144061], [25, 144801], [35, 145601], [38, 145821], [41, 145981], [48, 146868], [50, 147016], [53, 147096], [63, 147856], [66, 147996], [72, 148376], [78, 148616], [80, 148836], [83, 148936], [90, 149216], [96, 149596]]}, {"verse": 22, "start": 150672, "end": 165354, "text": "El día siguiente, la gente que estaba de la otra parte del mar, cuando vio que no había allí otra navecilla sino una, y que Jesús no había entrado con sus discípulos en ella, sino que sus discípulos se habían ido solos;", "words": [[0, 150672], [3, 150818], [7, 151018], [18, 151698], [21, 151798], [27, 152138], [31, 152358], [38, 152718], [41, 152918], [44, 153038], [49, 153238], [55, 153598], [59, 153878], [64, 154158], [71, 155018], [75, 155378], [79, 155538], [82, 155718], [88, 155958], [93, 156258], [98, 156558], [108, 157158], [113, 157418], [118, 158200], [120, 158324], [124, 158444], [130, 158864], [133, 159279], [139, 159519], [147, 160139], [151, 160319], [155, 160559], [166, 161299], [169, 161539], [175, 162239], [180, 162519], [184, 162739], [188, 162939], [199, 163859], [202, 164179], [209, 164459], [213, 164699]]}, {"verse": 23, "start": 165704, "end": 174019, "text": "Y que otras barcas habían arribado de Tiberias junto al lugar donde habían comido el pan después de haber el Señor dado gracias;", "words": [[0, 165704], [2, 165826], [6, 165946], [12, 166186], [19, 166826], [26, 167426], [35, 168086], [38, 168246], [47, 168846], [53, 169166], [56, 169466], [62, 169766], [68, 170086], [75, 170506], [82, 170946], [85, 171066], [89, 171306], [97, 171926], [100, 172146], [106, 172306], [109, 172506], [115, 172746], [120, 173126]]}, {"verse": 24, "start": 174369, "end": 183864, "text": "Cuando vio pues la gente que Jesús no estaba allí, ni sus discípulos, entraron ellos en las barcas, y vinieron a Capernaum buscando a Jesús.", "words": [[0, 174369], [7, 174570], [11, 174910], [16, 175110], [19, 175310], [25, 175610], [29, 175810], [35, 176150], [38, 176690], [45, 177070], [51, 177490], [54, 177910], [58, 178130], [70, 179310], [79, 179950], [85, 180270], [88, 180530], [92, 180650], [100, 181110], [102, 181490], [111, 181930], [113, 182130], [123, 182630], [132, 182950], [134, 183230]]}, {"verse": 25, "start": 184214, "end": 189206, "text": "Y hallándole de la otra parte del mar, le dijeron: Rabí, ¿cuándo llegaste acá?", "words": [[0, 184214], [2, 184547], [13, 184917], [16, 185097], [19, 185237], [24, 185437], [30, 185877], [34, 186117], [39, 186717], [42, 186917], [51, 187971], [57, 188121], [65, 188321], [74, 188781]]}, {"verse": 26, "start": 189486, "end": 200156, "text": "Les respondió Jesús, y dijo: De cierto, de cierto os digo, que me buscáis, no porque habéis visto las señales, sino porque comisteis el pan y os hartasteis.", "words": [[0, 189545], [4, 189635], [14, 190255], [21, 190555], [23, 190835], [29, 191878], [32, 192210], [40, 192542], [43, 192874], [50, 193206], [53, 193426], [59, 193686], [63, 193906], [66, 194046], [75, 194846], [78, 194926], [85, 195246], [92, 195506], [98, 195766], [102, 195966], [111, 196906], [116, 197126], [123, 197486], [133, 198106], [136, 198246], [140, 198546], [142, 198946], [145, 199106]]}, {"verse": 27, "start": 200506, "end": 211504, "text": "Trabajad no por la comida que perece, sino por la comida que a vida eterna permanece, la cual el Hijo del hombre os dará: porque a este señaló el Padre, que es Dios.", "words": [[0, 200684], [9, 200904], [12, 201384], [16, 201624], [19, 201764], [26, 202104], [30, 202324], [38, 203064], [43, 203364], [47, 203724], [50, 203884], [57, 204324], [61, 204564], [63, 204724], [68, 204884], [75, 205404], [86, 206564], [89, 206664], [94, 206864], [97, 207084], [102, 207384], [106, 207604], [113, 207924], [116, 208144], [122, 208870], [129, 209111], [131, 209271], [136, 209511], [143, 210111], [146, 210191], [153, 210631], [157, 210771], [160, 210911]]}, {"verse": 28, "start": 211854, "end": 215601, "text": "Y le dijeron: ¿Qué haremos para que obremos las obras de Dios?", "words": [[0, 211854], [2, 211978], [5, 212078], [14, 212995], [19, 213099], [27, 213539], [32, 213859], [36, 214039], [44, 214399], [48, 214599], [54, 214859], [57, 215099]]}, {"verse": 29, "start": 215881, "end": 223260, "text": "Respondió Jesús, y les dijo: Esta es la obra de Dios, que creáis en el que él ha enviado.", "words": [[0, 216258], [10, 216668], [17, 217008], [19, 217308], [23, 217468], [29, 218230], [34, 218613], [37, 218953], [40, 219433], [45, 219773], [48, 220013], [54, 220333], [58, 220953], [65, 221533], [68, 221773], [71, 221933], [75, 222113], [78, 222313], [81, 222453]]}, {"verse": 30, "start": 223610, "end": 229782, "text": "Le dijeron entonces: ¿Qué señal pues haces tú, para que veamos, y te creamos? ¿Qué obras?", "words": [[0, 223610], [3, 223755], [11, 224295], [21, 225372], [26, 225470], [32, 225990], [37, 226310], [43, 226610], [47, 226910], [52, 227190], [56, 227370], [64, 227790], [66, 228070], [69, 228210], [78, 229112], [83, 229232]]}, {"verse": 31, "start": 230132, "end": 236433, "text": "Nuestros padres comieron el maná en el desierto, como está escrito: Pan del cielo les dio a comer.", "words": [[0, 230132], [9, 230515], [16, 230815], [25, 231375], [28, 231575], [33, 231935], [36, 232055], [39, 232155], [49, 232855], [54, 233015], [59, 233215], [68, 234090], [72, 234273], [76, 234433], [82, 234813], [86, 235013], [90, 235233], [92, 235333]]}, {"verse": 32, "start": 236713, "end": 247159, "text": "Y Jesús les dijo: De cierto, de cierto os digo: No os dio Moisés pan del cielo; sino que mi Padre os da el verdadero pan del cielo.", "words": [[0, 236713], [2, 236837], [8, 237217], [12, 237537], [18, 238533], [21, 238850], [29, 239167], [32, 239484], [39, 239801], [42, 240101], [48, 240831], [51, 241042], [54, 241382], [58, 241602], [65, 241788], [69, 241973], [73, 242159], [80, 243946], [85, 244106], [89, 244306], [92, 244486], [98, 244806], [101, 245026], [104, 245166], [107, 245286], [117, 245906], [121, 246246], [125, 246486]]}, {"verse": 33, "start": 247509, "end": 252557, "text": "Porque el pan de Dios es aquel que descendió del cielo y da vida al mundo.", "words": [[0, 247509], [7, 247793], [10, 247993], [14, 248333], [17, 248573], [22, 248913], [25, 249273], [31, 249693], [35, 249793], [45, 250453], [49, 250613], [55, 251173], [57, 251376], [60, 251578], [65, 251758], [68, 252018]]}, {"verse": 34, "start": 252907, "end": 256130, "text": "Y le dijeron: Señor, danos siempre este pan.", "words": [[0, 252907], [2, 253031], [5, 253131], [14, 254047], [21, 254551], [27, 254811], [35, 255191], [40, 255671]]}, {"verse": 35, "start": 256410, "end": 266478, "text": "Y Jesús les dijo: Yo soy el pan de vida: el que a mí viene, nunca tendrá hambre; y el que en mí cree, no tendrá sed jamás.", "words": [[0, 256410], [2, 256533], [8, 256913], [12, 257233], [18, 257954], [21, 258198], [25, 258478], [28, 258798], [32, 259138], [35, 259418], [41, 260192], [44, 260357], [48, 260517], [50, 260617], [53, 260757], [60, 261217], [66, 261937], [73, 262308], [81, 263374], [83, 263694], [86, 264014], [90, 264174], [93, 264314], [96, 264474], [102, 264754], [105, 265194], [112, 265635], [116, 266075]]}, {"verse": 36, "start": 266828, "end": 270215, "text": "Pero os he dicho, que aunque me habéis visto, no creéis.", "words": [[0, 266828], [5, 267033], [8, 267273], [11, 267353], [18, 267753], [22, 267968], [29, 268128], [32, 268428], [39, 268708], [46, 269268], [49, 269388]]}, {"verse": 37, "start": 270565, "end": 275179, "text": "Todo lo que el Padre me da, vendrá a mí; y al que a mí viene, no le echo fuera.", "words": [[0, 270565], [5, 270689], [8, 270909], [12, 271009], [15, 271129], [21, 271489], [24, 271609], [28, 271789], [35, 272369], [37, 272469], [41, 272993], [43, 273140], [46, 273280], [50, 273440], [52, 273520], [55, 273640], [62, 274020], [65, 274280], [68, 274470], [73, 274660]]}, {"verse": 38, "start": 275529, "end": 282782, "text": "Porque he descendido del cielo, no para hacer mi voluntad, sino la voluntad del que me envió.", "words": [[0, 275529], [7, 275813], [10, 276193], [21, 276873], [25, 277073], [32, 277533], [35, 278353], [40, 278633], [46, 279013], [49, 279193], [59, 279933], [64, 280493], [67, 280833], [76, 281343], [80, 281853], [84, 281973], [87, 282153]]}, {"verse": 39, "start": 283132, "end": 291842, "text": "Y esta es la voluntad del que me envió, del Padre: Que todo lo que me da, no pierda de ello, sino que lo resucite en el día postrero.", "words": [[0, 283132], [2, 283489], [7, 283809], [10, 284049], [13, 284209], [22, 284829], [26, 284989], [30, 285169], [33, 285349], [40, 285869], [44, 285989], [51, 286840], [55, 286922], [60, 287202], [63, 287442], [67, 287582], [70, 287742], [74, 287942], [77, 288082], [84, 288502], [87, 288742], [93, 288982], [98, 289302], [102, 289482], [105, 289642], [114, 290322], [117, 290462], [120, 290602], [124, 290802]]}, {"verse": 40, "start": 292192, "end": 302081, "text": "Y esta es la voluntad del que me ha enviado: Que todo aquel que ve al Hijo, y cree en él, tenga vida eterna: y yo le resucitaré en el día postrero.", "words": [[0, 292192], [2, 292360], [7, 292800], [10, 293380], [13, 293520], [22, 294200], [26, 294400], [30, 294580], [33, 294740], [36, 294840], [45, 295793], [49, 295895], [54, 296135], [60, 296575], [64, 296675], [67, 296855], [70, 296995], [76, 297215], [78, 297395], [83, 297615], [86, 297835], [90, 298085], [96, 298335], [101, 298475], [109, 299434], [111, 299552], [114, 299732], [117, 299872], [128, 300812], [131, 300932], [134, 301092], [138, 301292]]}, {"verse": 41, "start": 302431, "end": 309025, "text": "Murmuraban entonces de él los judíos, porque había dicho: Yo soy el pan que descendí del cielo.", "words": [[0, 302431], [11, 303157], [20, 303637], [23, 304017], [26, 304217], [30, 304337], [38, 304977], [45, 305317], [51, 305597], [58, 306401], [61, 306586], [65, 306806], [68, 307046], [72, 307326], [76, 307566], [85, 308246], [89, 308386]]}, {"verse": 42, "start": 309375, "end": 318134, "text": "Y decían: ¿No es este Jesús, el hijo de José, cuyo padre y madre nosotros conocemos? ¿cómo, pues, dice este: Del cielo he descendido?", "words": [[0, 309375], [2, 309852], [10, 310561], [14, 310725], [17, 310925], [22, 311145], [29, 311905], [32, 311985], [37, 312205], [40, 312305], [46, 312885], [51, 313105], [57, 313465], [59, 313545], [65, 313825], [74, 314045], [85, 315281], [92, 315445], [98, 315765], [103, 316025], [109, 316785], [113, 316947], [119, 317267], [122, 317447]]}, {"verse": 43, "start": 318414, "end": 322996, "text": "Y Jesús respondió, y les dijo: No murmuréis entre vosotros.", "words": [[0, 318414], [2, 318537], [8, 318877], [19, 319837], [21, 320077], [25, 320197], [31, 320995], [34, 321181], [44, 321821], [50, 322121]]}, {"verse": 44, "start": 323346, "end": 330387, "text": "Ninguno puede venir a mí, si el Padre que me envió no le trae; y yo le resucitaré en el día postrero.", "words": [[0, 323346], [8, 323895], [14, 324115], [20, 324515], [22, 324655], [26, 325015], [29, 325295], [32, 325455], [38, 325755], [42, 325995], [45, 326155], [51, 326515], [54, 326835], [57, 326975], [63, 327740], [65, 327858], [68, 328038], [71, 328178], [82, 329118], [85, 329238], [88, 329398], [92, 329598]]}, {"verse": 45, "start": 330737, "end": 339192, "text": "Escrito está en los profetas: Y serán todos enseñados de Dios. Así que, todo aquel que oyó del Padre, y aprendió, viene a mí.", "words": [[0, 330737], [8, 331175], [13, 331455], [16, 331595], [20, 331695], [30, 332733], [32, 332860], [38, 333240], [44, 333680], [54, 334500], [57, 334660], [63, 335404], [67, 335569], [72, 335749], [77, 335969], [83, 336389], [87, 336599], [91, 336809], [95, 336929], [102, 337309], [104, 337609], [114, 338189], [120, 338649], [122, 338909]]}, {"verse": 46, "start": 339542, "end": 345973, "text": "No que alguno haya visto al Padre, sino aquel que vino de Dios, este ha visto al Padre.", "words": [[0, 339542], [3, 339711], [7, 339871], [14, 340331], [19, 340451], [25, 340771], [28, 340951], [35, 341851], [40, 342121], [46, 342391], [50, 342511], [55, 342731], [58, 342931], [64, 343751], [69, 344031], [72, 344171], [78, 344371], [81, 344551]]}, {"verse": 47, "start": 346323, "end": 351709, "text": "De cierto, de cierto os digo: El que cree en mí, tiene vida eterna.", "words": [[0, 346599], [3, 346916], [11, 347233], [14, 347550], [21, 347867], [24, 348167], [30, 348897], [33, 349150], [37, 349436], [42, 349723], [45, 349903], [49, 350123], [55, 350643], [60, 350963]]}, {"verse": 48, "start": 352059, "end": 353658, "text": "Yo soy el pan de vida.", "words": [[0, 352059], [3, 352246], [7, 352486], [10, 352726], [14, 352966], [17, 353166]]}, {"verse": 49, "start": 354008, "end": 357822, "text": "Vuestros padres comieron el maná en el desierto, y han muerto.", "words": [[0, 354008], [9, 354391], [16, 354771], [25, 355311], [28, 355551], [33, 355951], [36, 356051], [39, 356171], [49, 356751], [51, 356971], [55, 357131]]}, {"verse": 50, "start": 358172, "end": 363876, "text": "Este es el pan que desciende del cielo, para que el que de él come, no muera.", "words": [[0, 358172], [5, 358498], [8, 358718], [11, 358878], [15, 359258], [19, 359498], [29, 360018], [33, 360238], [40, 360838], [45, 361378], [49, 361598], [52, 361918], [56, 362098], [59, 362318], [62, 362458], [68, 362878], [71, 363338]]}, {"verse": 51, "start": 364226, "end": 375928, "text": "Yo soy el pan vivo que he descendido del cielo: si alguno come de este pan, vivirá para siempre; y el pan que yo daré es mi carne, la cual yo daré por la vida del mundo.", "words": [[0, 364226], [3, 364412], [7, 364632], [10, 364892], [14, 365172], [19, 365572], [23, 365852], [26, 366012], [37, 366712], [41, 366892], [48, 367765], [51, 367902], [58, 368382], [63, 368642], [66, 368842], [71, 369022], [76, 369522], [83, 370122], [88, 370282], [97, 371157], [99, 371277], [102, 371417], [106, 371697], [110, 371917], [113, 372097], [118, 372497], [121, 372757], [124, 372937], [131, 373717], [134, 373957], [139, 374137], [142, 374337], [147, 374637], [151, 374777], [154, 374937], [159, 375137], [163, 375377]]}, {"verse": 52, "start": 376278, "end": 382974, "text": "Entonces los judíos contendían entre sí, diciendo: ¿Cómo puede este darnos su carne a comer?", "words": [[0, 376278], [9, 376917], [13, 377517], [20, 378077], [31, 378917], [37, 379217], [41, 379957], [51, 380872], [57, 381092], [63, 381352], [68, 381612], [75, 381952], [78, 382152], [84, 382452], [86, 382592]]}, {"verse": 53, "start": 383254, "end": 393934, "text": "Y Jesús les dijo: De cierto, de cierto os digo: Si no coméis la carne del Hijo del hombre, y bebéis su sangre, no tendréis vida en vosotros.", "words": [[0, 383254], [2, 383378], [8, 383758], [12, 384078], [18, 385074], [21, 385391], [29, 385708], [32, 386025], [39, 386342], [42, 386642], [48, 387373], [51, 387552], [54, 387732], [61, 388192], [64, 388392], [70, 388692], [74, 388992], [79, 389292], [83, 389452], [91, 390072], [93, 390332], [100, 390772], [103, 390932], [111, 391852], [114, 391952], [123, 392572], [128, 392872], [131, 393052]]}, {"verse": 54, "start": 394284, "end": 401817, "text": "El que come mi carne y bebe mi sangre, tiene vida eterna: y yo le resucitaré en el día postrero.", "words": [[0, 394284], [3, 394454], [7, 394614], [12, 394954], [15, 395174], [21, 395694], [23, 396034], [28, 396374], [31, 396534], [39, 397034], [45, 397694], [50, 398054], [58, 399170], [60, 399288], [63, 399468], [66, 399608], [77, 400548], [80, 400668], [83, 400828], [87, 401028]]}, {"verse": 55, "start": 402167, "end": 406804, "text": "Porque mi carne es verdadera comida, y mi sangre es verdadera bebida.", "words": [[0, 402167], [7, 402329], [10, 402549], [16, 402869], [19, 403129], [29, 403769], [37, 404089], [39, 404409], [42, 404529], [49, 404949], [52, 405249], [62, 406129]]}, {"verse": 56, "start": 407154, "end": 412691, "text": "El que come mi carne y bebe mi sangre, en mí permanece, y yo en él.", "words": [[0, 407154], [3, 407316], [7, 407456], [12, 407776], [15, 407996], [21, 408456], [23, 408896], [28, 409196], [31, 409336], [39, 410416], [42, 410536], [45, 410736], [56, 411116], [58, 411496], [61, 412016], [64, 412376]]}, {"verse": 57, "start": 413041, "end": 420271, "text": "Como me envió el Padre viviente, y yo vivo por el Padre, asimismo el que me come, él también vivirá por mí.", "words": [[0, 413041], [5, 413206], [8, 413406], [14, 413726], [17, 413846], [23, 414106], [33, 415066], [35, 415186], [38, 415326], [43, 415566], [47, 415906], [50, 416026], [57, 416816], [66, 417606], [69, 417766], [73, 417886], [76, 418026], [82, 418786], [85, 418926], [93, 419286], [100, 419786], [104, 419946]]}, {"verse": 58, "start": 420621, "end": 431410, "text": "Este es el pan que descendió del cielo: no como vuestros padres comieron el maná, y han muerto: el que come de este pan, vivirá eternamente.", "words": [[0, 420621], [5, 420865], [8, 421025], [11, 421145], [15, 421425], [19, 421645], [29, 422265], [33, 422405], [40, 423290], [43, 423497], [48, 423777], [57, 424217], [64, 424637], [73, 425217], [76, 425437], [82, 425917], [84, 426597], [88, 426777], [96, 427761], [99, 428106], [103, 428266], [108, 428606], [111, 428846], [116, 429046], [121, 429446], [128, 430286]]}, {"verse": 59, "start": 431760, "end": 436122, "text": "Estas cosas dijo en la sinagoga, enseñando en Capernaum.", "words": [[0, 431760], [6, 431942], [12, 432654], [17, 432987], [20, 433167], [23, 433287], [33, 434367], [43, 435147], [46, 435656]]}, {"verse": 60, "start": 436472, "end": 442334, "text": "Y muchos de sus discípulos oyéndolo, dijeron: Dura es esta palabra: ¿quién la puede oír?", "words": [[0, 436472], [2, 436581], [9, 436861], [12, 437101], [16, 437281], [27, 437901], [37, 438581], [46, 439681], [51, 440004], [54, 440244], [59, 440524], [68, 441324], [75, 441530], [78, 441610], [84, 441830]]}, {"verse": 61, "start": 442614, "end": 449795, "text": "Y sabiendo Jesús en sí mismo que sus discípulos murmuraban de esto, les dijo: ¿Esto os escandaliza?", "words": [[0, 442614], [2, 442737], [11, 443217], [17, 443577], [20, 443917], [23, 444117], [29, 444537], [33, 444737], [37, 444957], [48, 445697], [59, 446417], [62, 446677], [68, 447377], [72, 447517], [78, 448231], [84, 448556], [87, 448781]]}, {"verse": 62, "start": 450145, "end": 454110, "text": "¿Pues qué, si veis al Hijo del hombre que sube donde estaba primero?", "words": [[0, 450145], [6, 450417], [11, 450537], [14, 450677], [19, 451037], [22, 451177], [27, 451377], [31, 451597], [38, 451897], [42, 452097], [47, 452677], [53, 453057], [60, 453437]]}, {"verse": 63, "start": 454460, "end": 462310, "text": "El espíritu es el que da vida; la carne nada aprovecha: las palabras que yo os he hablado, son espíritu, y son vida.", "words": [[0, 454460], [3, 454586], [12, 455126], [15, 455226], [18, 455346], [22, 455486], [25, 455606], [31, 456339], [34, 456443], [40, 456823], [45, 457203], [56, 458416], [60, 458596], [69, 458976], [73, 459276], [76, 459536], [79, 459756], [82, 459876], [91, 460396], [95, 460636], [105, 461316], [107, 461436], [111, 461576]]}, {"verse": 64, "start": 462660, "end": 472051, "text": "Pero hay algunos de vosotros que no creen. Porque Jesús desde el principio sabía quiénes eran los que no creían, y quién le había de entregar.", "words": [[0, 462660], [5, 463000], [9, 463220], [17, 463560], [20, 463740], [29, 464120], [33, 464300], [36, 464440], [43, 465345], [50, 465550], [56, 466030], [62, 466530], [65, 466810], [75, 467410], [81, 467990], [89, 468530], [94, 468770], [98, 469010], [102, 469190], [105, 469370], [113, 469970], [115, 470450], [121, 470690], [124, 470910], [130, 471130], [133, 471350]]}, {"verse": 65, "start": 472401, "end": 478569, "text": "Y dijo: Por eso os he dicho que ninguno puede venir a mí, si no le es dado del Padre.", "words": [[0, 472401], [2, 472548], [8, 473242], [12, 473406], [16, 473646], [19, 474206], [22, 474446], [28, 474726], [32, 474866], [40, 475306], [46, 475586], [52, 475926], [54, 476066], [58, 476246], [61, 476786], [64, 476946], [67, 477126], [70, 477326], [75, 477646], [79, 477886]]}, {"verse": 66, "start": 478919, "end": 483576, "text": "Desde esto, muchos de sus discípulos volvieron atrás, y ya no andaban con él.", "words": [[0, 478919], [6, 479145], [12, 479645], [19, 480005], [22, 480225], [26, 480405], [37, 480985], [47, 481485], [54, 481805], [56, 482325], [59, 482505], [62, 482645], [70, 483065], [74, 483245]]}, {"verse": 67, "start": 483926, "end": 488389, "text": "Dijo entonces Jesús a los doce: ¿Queréis vosotros iros también?", "words": [[0, 483926], [5, 484234], [14, 484694], [20, 485114], [22, 485394], [26, 485534], [32, 486306], [41, 486712], [50, 487272], [55, 487692]]}, {"verse": 68, "start": 488739, "end": 494657, "text": "Y le respondió Simón Pedro: Señor, ¿a quién iremos? tú tienes palabras de vida eterna.", "words": [[0, 488739], [2, 488859], [5, 488979], [15, 489599], [21, 489999], [28, 490830], [35, 491645], [38, 491705], [44, 491845], [52, 492732], [55, 492830], [62, 493070], [71, 493490], [74, 493790], [79, 493950]]}, {"verse": 69, "start": 495007, "end": 500222, "text": "Y nosotros creemos y conocemos que tú eres el Cristo, el Hijo de Dios viviente.", "words": [[0, 495007], [2, 495112], [11, 495392], [19, 496032], [21, 496192], [31, 496692], [35, 496912], [38, 497112], [43, 497312], [46, 497452], [54, 498312], [57, 498392], [62, 498612], [65, 498712], [70, 498952]]}, {"verse": 70, "start": 500502, "end": 507187, "text": "Jesús le respondió: ¿No he escogido yo a vosotros doce, y uno de vosotros es diablo?", "words": [[0, 500502], [6, 500790], [9, 501270], [20, 502133], [24, 502300], [27, 502540], [36, 503180], [39, 503380], [41, 503600], [50, 504080], [56, 505280], [58, 505400], [62, 505560], [65, 505680], [74, 506140], [77, 506460]]}, {"verse": 71, "start": 507537, "end": 516283, "text": "Y hablaba de Judas Iscariote, hijo de Simón, porque este era el que le había de entregar, el cual era uno de los doce.", "words": [[0, 507537], [2, 507683], [10, 508083], [13, 508223], [19, 508543], [30, 510043], [35, 510343], [38, 510523], [45, 511363], [52, 511763], [57, 512223], [61, 512543], [64, 512743], [68, 512903], [71, 513063], [77, 513323], [80, 513523], [90, 514403], [93, 514563], [98, 514783], [102, 515103], [106, 515383], [109, 515543], [113, 515703]]}]}