{"book": "ACT", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 237899, "verses": [{"verse": 1, "start": 300, "end": 6158, "text": "Y en el mismo tiempo el rey Herodes echó mano a maltratar algunos de la iglesia.", "words": [[0, 300], [2, 452], [5, 592], [8, 712], [14, 1012], [21, 1552], [24, 1932], [28, 2392], [36, 2912], [41, 3632], [46, 3892], [48, 4052], [58, 4952], [66, 5252], [69, 5472], [72, 5572]]}, {"verse": 2, "start": 6508, "end": 9839, "text": "Y mató con espada a Jacobo, hermano de Juan.", "words": [[0, 6508], [2, 6621], [7, 6981], [11, 7141], [18, 7601], [20, 7821], [28, 8741], [36, 9181], [39, 9261]]}, {"verse": 3, "start": 10189, "end": 20293, "text": "Y viendo que había agradado a los judíos, pasó adelante para prender también a Pedro. Eran entonces los días de los panes sin levadura.", "words": [[0, 10189], [2, 10313], [9, 10613], [13, 10833], [19, 11343], [28, 11853], [30, 11973], [34, 12093], [42, 12993], [47, 13493], [56, 14113], [61, 14513], [69, 14913], [77, 15413], [79, 15633], [86, 16550], [91, 16775], [100, 17675], [104, 18115], [109, 18435], [112, 18595], [116, 18715], [122, 19315], [126, 19475]]}, {"verse": 4, "start": 20643, "end": 30662, "text": "Y habiéndole preso, le puso en la cárcel, entregándole a cuatro grupos de cuatro soldados que le guardasen; queriendo sacarle al pueblo después de la Pascua.", "words": [[0, 20643], [2, 20785], [13, 21265], [20, 22025], [23, 22105], [28, 22485], [31, 22645], [34, 22785], [42, 23825], [55, 24845], [57, 24965], [64, 25285], [71, 25805], [74, 26005], [81, 26225], [90, 26905], [94, 27045], [97, 27572], [108, 28272], [118, 28614], [126, 29174], [129, 29314], [136, 29694], [144, 30014], [147, 30230], [150, 30446]]}, {"verse": 5, "start": 31012, "end": 38334, "text": "Así que, Pedro era guardado en la cárcel; y la iglesia hacía sin cesar oración a Dios por él.", "words": [[0, 31012], [4, 31615], [9, 31815], [15, 32135], [19, 32395], [28, 32975], [31, 33075], [34, 33195], [42, 34127], [44, 34273], [47, 34393], [55, 34933], [61, 35513], [65, 36093], [71, 36633], [79, 37153], [81, 37413], [86, 37633], [90, 37973]]}, {"verse": 6, "start": 38684, "end": 51231, "text": "Y cuando Herodes le había de sacar, aquella misma noche estaba Pedro durmiendo entre dos soldados, preso con dos cadenas, y los guardas delante de la puerta, que guardaban la cárcel.", "words": [[0, 38684], [2, 38786], [9, 39086], [17, 39786], [20, 40206], [26, 40506], [29, 40706], [36, 41106], [44, 41706], [50, 41946], [56, 42266], [63, 42626], [69, 43046], [79, 43806], [85, 44106], [89, 44366], [99, 45106], [105, 45806], [109, 45986], [113, 46166], [122, 46746], [124, 47186], [128, 47346], [136, 47946], [144, 48666], [147, 48846], [150, 48946], [158, 49787], [162, 49869], [172, 50349], [175, 50529]]}, {"verse": 7, "start": 51581, "end": 66424, "text": "Y he aquí, el ángel del Señor sobrevino, y una luz resplandeció en la cárcel; y golpeando a Pedro en el costado, le despertó, diciendo: Levántate rápidamente. Y las cadenas se le cayeron de las manos.", "words": [[0, 51581], [2, 51781], [5, 51961], [11, 52281], [14, 52521], [20, 52981], [24, 53141], [30, 53501], [41, 54781], [43, 55121], [47, 55401], [51, 56001], [64, 57136], [67, 57276], [70, 57416], [78, 58272], [80, 58555], [90, 59175], [92, 59335], [98, 59615], [101, 59815], [104, 59915], [113, 60455], [116, 60595], [126, 61195], [136, 62111], [146, 62651], [159, 63883], [161, 64005], [165, 64145], [173, 64785], [176, 65065], [179, 65205], [187, 65685], [190, 65785], [194, 65905]]}, {"verse": 8, "start": 66774, "end": 75469, "text": "Y le dijo el ángel: Cíñete, y átate tus sandalias. Y lo hizo así. Y le dijo: Envuélvete en tu manto, y sígueme.", "words": [[0, 66774], [2, 66900], [5, 66980], [10, 67240], [13, 67400], [20, 68465], [28, 68805], [30, 69025], [36, 69365], [40, 69525], [51, 70602], [53, 70769], [56, 70909], [61, 71129], [66, 71895], [68, 72062], [71, 72142], [77, 72891], [88, 73556], [91, 73657], [94, 73776], [101, 74236], [103, 74816]]}, {"verse": 9, "start": 75749, "end": 82584, "text": "Y saliendo, le seguía; y no sabía que era verdad lo que hacía el ángel, pero pensaba que veía visión.", "words": [[0, 75749], [2, 75854], [12, 76354], [15, 76534], [23, 77432], [25, 77559], [28, 77699], [34, 78098], [38, 78279], [42, 78459], [49, 78759], [52, 79139], [56, 79298], [62, 79559], [65, 79779], [72, 80518], [77, 80839], [85, 81339], [89, 81498], [94, 81878]]}, {"verse": 10, "start": 82934, "end": 97815, "text": "Y como pasaron la primera y la segunda guardia, vinieron a la puerta de hierro que va a la ciudad, la cual se les abrió por sí sola: y salidos, pasaron una calle; y de inmediato el ángel se apartó de él.", "words": [[0, 82934], [2, 83048], [7, 83288], [15, 83848], [18, 84028], [26, 84368], [28, 84668], [31, 84788], [39, 85168], [48, 86208], [57, 86808], [59, 87008], [62, 87068], [69, 87408], [72, 87878], [79, 88348], [83, 88508], [86, 88728], [88, 88808], [91, 88908], [99, 89928], [102, 90028], [107, 90268], [110, 90468], [114, 90608], [120, 91068], [124, 91288], [127, 91528], [133, 92379], [135, 92589], [144, 93209], [152, 93934], [156, 94154], [163, 94961], [165, 95088], [168, 95188], [178, 95968], [181, 96108], [187, 96548], [190, 96708], [197, 97248], [200, 97408]]}, {"verse": 11, "start": 98165, "end": 109920, "text": "Entonces Pedro, volviendo en sí, dijo: Ahora entiendo verdaderamente que el Señor ha enviado su ángel, y me ha librado de la mano de Herodes, y de todo lo que el pueblo de los judíos esperaba.", "words": [[0, 98165], [9, 99102], [16, 99702], [26, 100182], [29, 100382], [33, 100942], [39, 101590], [45, 101848], [54, 102348], [69, 103108], [73, 103368], [76, 103468], [82, 103728], [85, 103968], [93, 104348], [96, 104568], [103, 105008], [105, 105348], [108, 105468], [111, 105548], [119, 105968], [122, 106088], [125, 106188], [130, 106428], [133, 106588], [142, 106968], [144, 107528], [147, 107648], [152, 107828], [155, 108028], [159, 108148], [162, 108268], [169, 108508], [172, 108668], [176, 108788], [183, 109248]]}, {"verse": 12, "start": 110200, "end": 120924, "text": "Y habiendo considerado esto, llegó a casa de María la madre de Juan, el que tenía por sobrenombre Marcos, donde muchos estaban juntos orando.", "words": [[0, 110200], [2, 110324], [11, 110664], [23, 111564], [29, 112504], [35, 112844], [37, 113084], [42, 113324], [45, 113564], [51, 113824], [54, 114064], [60, 114364], [63, 114564], [69, 115464], [72, 115544], [76, 115684], [82, 116024], [86, 116344], [98, 117244], [106, 118284], [112, 118444], [119, 118964], [127, 119484], [134, 120024]]}, {"verse": 13, "start": 121274, "end": 128256, "text": "Y tocando Pedro a la puerta del patio, salió una muchacha, para escuchar, llamada Rode:", "words": [[0, 121274], [2, 121397], [10, 121797], [16, 122277], [18, 122637], [21, 122717], [28, 122977], [32, 123257], [39, 124117], [45, 124577], [49, 124777], [59, 125437], [64, 126057], [74, 126977], [82, 127648]]}, {"verse": 14, "start": 128606, "end": 138112, "text": "La cual como conoció la voz de Pedro, de gozo no abrió la puerta, sino corriendo adentro, dio la noticia de que Pedro estaba a la puerta.", "words": [[0, 128606], [3, 128734], [8, 129254], [13, 129554], [21, 130094], [24, 130234], [28, 130434], [31, 130554], [38, 131434], [41, 131474], [46, 131774], [49, 131994], [55, 132314], [58, 132454], [66, 133274], [71, 133394], [81, 133954], [90, 135074], [94, 135394], [97, 135554], [105, 136154], [108, 136354], [112, 136494], [118, 136954], [125, 137294], [127, 137474], [130, 137514]]}, {"verse": 15, "start": 138462, "end": 147126, "text": "Y ellos le dijeron: Estás loca. Pero ella afirmaba que así era. Entonces ellos decían: Su ángel es.", "words": [[0, 138462], [2, 138722], [8, 139002], [11, 139262], [20, 140082], [26, 140382], [32, 141189], [37, 141355], [42, 141675], [51, 142520], [55, 142740], [59, 142960], [64, 143817], [73, 144441], [79, 145081], [87, 146211], [90, 146514], [96, 146850]]}, {"verse": 16, "start": 147406, "end": 154487, "text": "Pero Pedro perseveraba en llamar: y cuando abrieron, le vieron, y se espantaron.", "words": [[0, 147406], [5, 147590], [11, 148130], [23, 149370], [26, 149650], [34, 150496], [36, 150601], [43, 150801], [53, 151801], [56, 151901], [64, 152341], [66, 153081], [69, 153281]]}, {"verse": 17, "start": 154837, "end": 169354, "text": "Pero él haciéndoles con la mano señal de que callasen, les contó cómo el Señor le había sacado de la cárcel. Y dijo: Haced saber esto a Jacobo y a los hermanos. Y salió, y partió a otro lugar.", "words": [[0, 154837], [5, 154999], [8, 155479], [20, 156219], [24, 156479], [27, 156639], [32, 156879], [38, 157439], [41, 157559], [45, 158189], [55, 158819], [59, 158919], [65, 159439], [70, 159699], [73, 159839], [79, 160179], [82, 160699], [88, 160899], [95, 161419], [98, 161559], [101, 161699], [109, 162549], [111, 162678], [117, 163520], [123, 163680], [129, 164000], [134, 164260], [136, 164400], [143, 164860], [145, 164940], [147, 165000], [151, 165100], [161, 166076], [163, 166261], [170, 166701], [172, 167341], [179, 167941], [181, 168221], [186, 168541]]}, {"verse": 18, "start": 169704, "end": 176165, "text": "Luego que fue de día, hubo no poco alboroto entre los soldados sobre qué se había hecho de Pedro.", "words": [[0, 169704], [6, 170066], [10, 170346], [14, 170566], [17, 170746], [22, 171646], [27, 172026], [30, 172146], [35, 172426], [44, 173106], [50, 173386], [54, 173606], [63, 174206], [69, 174466], [73, 174666], [76, 174866], [82, 175086], [88, 175386], [91, 175586]]}, {"verse": 19, "start": 176515, "end": 188476, "text": "Pero Herodes, como le buscó y no le halló, tras interrogar a los guardias, mandó que los llevaran a ejecutar. Después descendiendo de Judea a Cesarea, se quedó allí.", "words": [[0, 176515], [5, 176722], [14, 177162], [19, 177562], [22, 177722], [28, 178322], [30, 178542], [33, 178702], [36, 178862], [43, 179682], [48, 180042], [59, 180702], [61, 180782], [65, 180922], [75, 181782], [81, 182222], [85, 182342], [89, 182482], [98, 183062], [100, 183202], [110, 184268], [118, 185033], [131, 185773], [134, 185933], [140, 186500], [142, 187066], [151, 187633], [154, 187713], [160, 188033]]}, {"verse": 20, "start": 188826, "end": 204980, "text": "Y Herodes estaba enojado contra los de Tiro y los de Sidón: pero ellos vinieron concordes a él, y sobornado Blasto, que era el encargado de la cámara del rey, pedían paz; porque las tierras de ellos eran abastecidas por las del rey.", "words": [[0, 188826], [2, 189007], [10, 189387], [17, 189787], [25, 190347], [32, 190707], [36, 190927], [39, 191127], [44, 191547], [46, 191727], [50, 191887], [53, 192107], [60, 192848], [65, 193012], [71, 193252], [80, 193892], [90, 194532], [92, 194672], [96, 194872], [98, 195132], [108, 195932], [116, 196892], [120, 196972], [124, 197212], [127, 197452], [137, 198132], [140, 198292], [143, 198412], [150, 198812], [154, 198972], [159, 199652], [166, 200072], [171, 200837], [178, 201059], [182, 201259], [190, 201879], [193, 202099], [199, 202419], [204, 202739], [216, 203719], [220, 204019], [224, 204239], [228, 204499]]}, {"verse": 21, "start": 205330, "end": 211292, "text": "Y un día señalado, Herodes vestido de ropa real, se sentó en el tribunal, y les arengó.", "words": [[0, 205330], [2, 205594], [5, 205714], [9, 205974], [19, 206524], [27, 207074], [35, 207714], [38, 207854], [43, 208264], [49, 208674], [52, 209054], [58, 209494], [61, 209574], [64, 209694], [74, 210294], [76, 210479], [80, 210911]]}, {"verse": 22, "start": 211642, "end": 215187, "text": "Y el pueblo aclamaba: Voz de Dios, y no de hombre.", "words": [[0, 211642], [2, 211789], [5, 211909], [12, 212369], [22, 213435], [26, 213678], [29, 213858], [35, 214118], [37, 214518], [40, 214638], [43, 214778]]}, {"verse": 23, "start": 215467, "end": 223486, "text": "Y luego el ángel del Señor le hirió, por cuanto no dio la gloria a Dios; y murió comido de gusanos.", "words": [[0, 215467], [2, 215609], [8, 215909], [11, 216309], [17, 216769], [21, 216909], [27, 217349], [30, 217649], [37, 218109], [41, 219009], [48, 219309], [51, 219709], [55, 219929], [58, 220149], [65, 220649], [67, 220869], [73, 221692], [75, 221795], [81, 222115], [88, 222515], [91, 222655]]}, {"verse": 24, "start": 223836, "end": 227331, "text": "Pero la palabra del Señor crecía y era multiplicada.", "words": [[0, 223836], [5, 224126], [8, 224306], [16, 224646], [20, 224846], [26, 225186], [33, 225786], [35, 226046], [39, 226266]]}, {"verse": 25, "start": 227681, "end": 237499, "text": "Y Bernabé y Saulo volvieron de Jerusalén cumplido su servicio, tomando también consigo a Juan, el que tenía por sobrenombre Marcos.", "words": [[0, 227681], [2, 227820], [10, 228440], [12, 228600], [18, 229060], [28, 229620], [31, 229820], [41, 230460], [50, 231020], [53, 231180], [63, 232140], [71, 232740], [79, 233140], [87, 233660], [89, 233900], [95, 234740], [98, 234980], [102, 235100], [108, 235420], [112, 235680], [124, 236600]]}]}