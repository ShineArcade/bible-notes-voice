{"book": "GEN", "chapter": 25, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 273579, "verses": [{"verse": 1, "start": 300, "end": 4111, "text": "Y Abraham tomó otra mujer, cuyo nombre fue Cetura;", "words": [[0, 300], [2, 426], [10, 766], [15, 1426], [20, 1726], [27, 2206], [32, 2651], [39, 2971], [43, 3271]]}, {"verse": 2, "start": 4461, "end": 11409, "text": "La cual le parió a Zimram, y a Jocsán, y a Medan, y a Madián, y a Isbac, y a Sua.", "words": [[0, 4461], [3, 4741], [8, 5001], [11, 5301], [17, 5721], [19, 6341], [27, 6961], [29, 6981], [31, 7471], [39, 7961], [41, 7981], [43, 8061], [50, 8821], [52, 8881], [54, 9331], [62, 9781], [64, 9821], [66, 9881], [73, 10741], [75, 10741], [77, 10821]]}, {"verse": 3, "start": 11759, "end": 19366, "text": "Y Jocsán engendró a Seba, y a Dedán: e hijos de Dedán fueron Assurim, y Letusim, y Leumim.", "words": [[0, 11759], [2, 12058], [9, 12378], [18, 12958], [20, 13138], [26, 13618], [28, 13858], [30, 13958], [37, 14910], [39, 15080], [45, 15380], [48, 15600], [54, 15980], [61, 16548], [70, 17116], [72, 17684], [81, 18252], [83, 18820]]}, {"verse": 4, "start": 19716, "end": 27883, "text": "E hijos de Madián: Efa, y Efer, y Hanoc, y Abida, y Eldaa. Todos estos fueron hijos de Cetura.", "words": [[0, 19716], [2, 19842], [8, 20162], [11, 20629], [19, 21305], [24, 21719], [26, 22177], [32, 22634], [34, 23091], [41, 23549], [43, 24006], [50, 24463], [52, 24920], [59, 25568], [65, 25872], [71, 26192], [78, 26692], [84, 27012], [87, 27477]]}, {"verse": 5, "start": 28233, "end": 31621, "text": "Y Abraham dio todo cuanto tenía a Isaac.", "words": [[0, 28233], [2, 28522], [10, 28922], [14, 29282], [19, 29602], [26, 29982], [32, 30582], [34, 30902]]}, {"verse": 6, "start": 31971, "end": 43871, "text": "Y a los hijos de sus concubinas dio Abraham dones, y los envió de junto Isaac su hijo, mientras él vivía, hacia el oriente, a la tierra oriental.", "words": [[0, 31971], [2, 32097], [4, 32157], [8, 32317], [14, 32617], [17, 32797], [21, 32957], [32, 33757], [36, 34097], [44, 34717], [51, 35497], [53, 36077], [57, 36237], [63, 36697], [66, 36857], [72, 37157], [78, 37697], [81, 38337], [87, 38737], [96, 39417], [99, 39877], [106, 40497], [112, 41017], [115, 41297], [124, 41837], [126, 42377], [129, 42477], [136, 42817]]}, {"verse": 7, "start": 44221, "end": 50138, "text": "Y estos fueron los días de vida que vivió Abraham: ciento setenta y cinco años.", "words": [[0, 44221], [2, 44385], [8, 44645], [15, 45045], [19, 45305], [24, 45525], [27, 45725], [32, 45965], [36, 46145], [42, 46585], [51, 47868], [58, 48060], [66, 48252], [68, 48444], [74, 48636]]}, {"verse": 8, "start": 50488, "end": 59074, "text": "Y exhaló el espíritu, y murió Abraham en buena vejez, anciano y lleno de días, y fue unido a su pueblo.", "words": [[0, 50488], [2, 50645], [9, 51205], [12, 51325], [22, 52465], [24, 52585], [30, 53045], [38, 53685], [41, 54078], [47, 54472], [54, 54865], [62, 55885], [64, 56065], [70, 56385], [73, 56505], [79, 56825], [81, 57585], [85, 57765], [91, 58145], [93, 58245], [96, 58365]]}, {"verse": 9, "start": 59424, "end": 69853, "text": "Y lo sepultaron Isaac e Ismael sus hijos en la cueva de Macpela, en la heredad de Efrón, hijo de Zoar heteo, que está enfrente de Mamre;", "words": [[0, 59424], [2, 59551], [5, 59711], [16, 60351], [22, 60771], [24, 61271], [31, 61951], [35, 62051], [41, 62391], [44, 62671], [47, 62791], [53, 63191], [56, 63291], [65, 64271], [68, 64451], [71, 64611], [79, 65251], [82, 65791], [89, 66331], [94, 66631], [97, 67164], [102, 67698], [109, 68231], [113, 68271], [118, 68611], [127, 68951], [130, 69432]]}, {"verse": 10, "start": 70203, "end": 77029, "text": "Heredad que compró Abraham de los hijos de Het; allí fue Abraham sepultado, y Sara su mujer.", "words": [[0, 70464], [8, 70754], [12, 70874], [19, 71394], [27, 71914], [30, 72234], [34, 72354], [40, 72694], [43, 73172], [48, 73802], [53, 74108], [57, 74248], [65, 74958], [76, 75668], [78, 75863], [83, 76183], [86, 76443]]}, {"verse": 11, "start": 77379, "end": 86651, "text": "Y sucedió, después de muerto Abraham, que Dios bendijo a Isaac su hijo: y habitó Isaac junto al pozo del Viviente que me ve.", "words": [[0, 77379], [2, 77507], [11, 78147], [19, 78587], [22, 78807], [29, 79227], [38, 80347], [42, 80427], [47, 80687], [55, 81447], [57, 81727], [63, 82087], [66, 82547], [72, 83311], [74, 83453], [81, 83853], [87, 84213], [93, 84653], [96, 84913], [101, 85293], [105, 85453], [114, 85913], [118, 86093], [121, 86253]]}, {"verse": 12, "start": 87001, "end": 93908, "text": "Y estas son las generaciones de Ismael, hijo de Abraham, que le parió Agar egipcia, sierva de Sara:", "words": [[0, 87001], [2, 87275], [8, 87455], [12, 87695], [16, 87835], [29, 88535], [32, 88715], [40, 89395], [45, 89515], [48, 89735], [57, 90695], [61, 90815], [64, 90955], [70, 91375], [75, 91795], [84, 92775], [91, 93195], [94, 93335]]}, {"verse": 13, "start": 94258, "end": 106790, "text": "Estos, pues, son los nombres de los hijos de Ismael, por sus nombres, por sus linajes: El primogénito de Ismael, Nebaiot; luego Cedar, y Abdeel, y Mibsam,", "words": [[0, 94258], [7, 94581], [13, 94901], [17, 95521], [21, 95761], [29, 96441], [32, 96981], [36, 97101], [42, 97401], [45, 97641], [53, 98401], [57, 98721], [61, 98941], [70, 99801], [74, 99981], [78, 100221], [87, 101306], [90, 101453], [102, 102313], [105, 102533], [113, 103285], [122, 104196], [128, 104521], [135, 105241], [137, 105591], [145, 105941], [147, 106365]]}, {"verse": 14, "start": 107140, "end": 109367, "text": "Y Misma, y Duma, y Masah,", "words": [[0, 107140], [2, 107359], [9, 107619], [11, 107959], [17, 108319], [19, 108861]]}, {"verse": 15, "start": 109717, "end": 113619, "text": "Hadad, y Tema, y Jetur, y Nafis, y Cedema.", "words": [[0, 109979], [7, 110259], [9, 110439], [15, 112489], [17, 112687], [24, 112886], [26, 113084], [33, 113283], [35, 113481]]}, {"verse": 16, "start": 113969, "end": 123042, "text": "Estos son los hijos de Ismael, y estos sus nombres, por sus aldeas y por sus campamentos; doce príncipes por sus familias.", "words": [[0, 113969], [6, 114437], [10, 114797], [14, 114957], [20, 115237], [23, 115477], [31, 116177], [33, 116577], [39, 116817], [43, 117037], [52, 117617], [56, 118117], [60, 118317], [67, 118917], [69, 119057], [73, 119217], [77, 119377], [90, 120831], [95, 120971], [105, 121791], [109, 121991], [113, 122151]]}, {"verse": 17, "start": 123392, "end": 133615, "text": "Y estos fueron los años de la vida de Ismael, ciento treinta y siete años: y exhaló el espíritu Ismael, y murió; y fue unido a su pueblo.", "words": [[0, 123392], [2, 123540], [8, 123730], [15, 124090], [19, 124310], [24, 124670], [27, 124890], [30, 124990], [35, 125210], [38, 125410], [46, 125887], [53, 126364], [61, 126841], [63, 127318], [69, 127795], [75, 128760], [77, 128885], [84, 129425], [87, 129605], [96, 130205], [104, 130765], [106, 131125], [113, 131935], [115, 132065], [119, 132225], [125, 132765], [127, 132905], [130, 133025]]}, {"verse": 18, "start": 133965, "end": 142922, "text": "Y habitaron desde Havila hasta Shur, que está enfrente de Egipto viniendo a Asiria; y murió en presencia de todos sus hermanos.", "words": [[0, 133965], [2, 134089], [12, 134589], [18, 134969], [25, 135349], [31, 135869], [37, 136389], [41, 136489], [46, 136789], [55, 137089], [58, 137409], [65, 137969], [74, 138529], [76, 138985], [84, 139604], [86, 139712], [92, 140052], [95, 140172], [105, 140812], [108, 140972], [114, 141272], [118, 141712]]}, {"verse": 19, "start": 143272, "end": 149888, "text": "Y estas son las generaciones de Isaac, hijo de Abraham. Abraham engendró a Isaac:", "words": [[0, 143272], [2, 143272], [8, 143498], [12, 143738], [16, 144218], [29, 145058], [32, 145258], [39, 146198], [44, 146338], [47, 146558], [56, 147489], [64, 148016], [73, 149136], [75, 149256]]}, {"verse": 20, "start": 150238, "end": 159715, "text": "Y era Isaac de cuarenta años cuando tomó por mujer a Rebeca, hija de Betuel arameo de Padan-aram, hermana de Labán arameo.", "words": [[0, 150238], [2, 150375], [6, 150675], [12, 150975], [15, 151155], [24, 151715], [29, 152055], [36, 152595], [41, 153115], [45, 153275], [51, 153748], [53, 154222], [61, 154695], [66, 154995], [69, 155225], [76, 155455], [83, 156375], [86, 157125], [98, 157875], [106, 158395], [109, 158555], [115, 158955]]}, {"verse": 21, "start": 160065, "end": 168120, "text": "Y oró Isaac a Jehová por su mujer, que era estéril; y lo aceptó Jehová, y concibió Rebeca su mujer.", "words": [[0, 160065], [2, 160242], [6, 160662], [12, 161082], [14, 161482], [21, 162022], [25, 162162], [28, 162382], [35, 163002], [39, 163302], [43, 163562], [52, 164677], [54, 164805], [57, 164925], [64, 165425], [72, 165925], [74, 166325], [83, 166945], [90, 167385], [93, 167545]]}, {"verse": 22, "start": 168470, "end": 176475, "text": "Y los hijos se combatían dentro de ella; y dijo: Si es así ¿para qué vivo yo? Y fue a consultar a Jehová.", "words": [[0, 168470], [2, 168577], [6, 168717], [12, 168977], [15, 169197], [25, 169877], [32, 170157], [35, 170477], [41, 171201], [43, 171348], [49, 172033], [52, 172213], [55, 172453], [59, 173073], [65, 173393], [69, 173553], [74, 173753], [78, 174524], [80, 174666], [84, 174866], [86, 175046], [96, 175826], [98, 175866]]}, {"verse": 23, "start": 176825, "end": 190035, "text": "Y le respondió Jehová: Dos naciones hay en tu seno, y dos pueblos serán divididos desde tus entrañas: y el un pueblo será más fuerte que el otro pueblo, y el mayor servirá al menor.", "words": [[0, 176825], [2, 176989], [5, 177109], [15, 177749], [23, 178529], [27, 178785], [36, 179545], [40, 179985], [43, 180165], [46, 180305], [52, 181025], [54, 181245], [58, 181445], [66, 181925], [72, 182225], [82, 182785], [88, 183025], [92, 183285], [102, 184575], [104, 184693], [107, 184773], [110, 184913], [117, 185293], [122, 185793], [126, 186053], [133, 186493], [137, 186693], [140, 186813], [145, 186973], [153, 187413], [155, 187813], [158, 187933], [164, 188253], [172, 189133], [175, 189313]]}, {"verse": 24, "start": 190315, "end": 195002, "text": "Y como se cumplieron sus días para parir, he aquí mellizos en su vientre.", "words": [[0, 190315], [2, 190422], [7, 190642], [10, 190842], [21, 191482], [25, 191682], [30, 191982], [35, 192262], [42, 192652], [45, 193042], [50, 193482], [59, 193922], [62, 194122], [65, 194262]]}, {"verse": 25, "start": 195352, "end": 202123, "text": "Y salió el primero rubio, y todo él velludo como un manto de pelo; y llamaron su nombre Esaú.", "words": [[0, 195352], [2, 195462], [8, 195882], [11, 196022], [19, 196362], [26, 197202], [28, 197522], [33, 197802], [36, 198212], [44, 198622], [49, 198922], [52, 199082], [58, 199522], [61, 199682], [67, 200440], [69, 200546], [78, 200966], [81, 201166], [88, 201676]]}, {"verse": 26, "start": 202473, "end": 213674, "text": "Y después salió su hermano, trabada su mano al talón de Esaú: y fue llamado su nombre Jacob. Y era Isaac de edad de sesenta años cuando ella los parió.", "words": [[0, 202473], [2, 202598], [10, 202898], [16, 203458], [19, 203618], [28, 204378], [36, 204978], [39, 205098], [44, 205378], [47, 205578], [53, 205978], [56, 206361], [62, 206908], [64, 207015], [68, 207135], [76, 207435], [79, 207735], [86, 208495], [93, 209335], [95, 209523], [99, 209703], [105, 210223], [108, 210743], [113, 211103], [116, 211323], [124, 211543], [129, 212163], [136, 212663], [141, 212903], [145, 213143]]}, {"verse": 27, "start": 214024, "end": 223139, "text": "Y crecieron los niños, y Esaú fue diestro en la caza, hombre del campo: pero Jacob era hombre tranquilo, que habitaba en tiendas.", "words": [[0, 214024], [2, 214355], [12, 214725], [16, 214925], [23, 215365], [25, 215738], [30, 216112], [34, 216485], [42, 216925], [45, 217085], [48, 217585], [54, 218085], [61, 218385], [65, 218645], [72, 219548], [77, 219692], [83, 220012], [87, 220472], [94, 220852], [105, 221632], [109, 221812], [118, 222292], [121, 222512]]}, {"verse": 28, "start": 223489, "end": 229640, "text": "Y amó Isaac a Esaú, porque comía de su caza; mas Rebeca amaba a Jacob.", "words": [[0, 223489], [2, 223615], [6, 224015], [12, 224415], [14, 224815], [20, 225215], [27, 225555], [33, 226015], [36, 226155], [39, 226566], [45, 227181], [49, 227645], [56, 228248], [62, 228808], [64, 229048]]}, {"verse": 29, "start": 229990, "end": 234601, "text": "Y guisó Jacob un potaje; y volviendo Esaú del campo cansado,", "words": [[0, 229990], [2, 230155], [8, 230435], [14, 230835], [17, 231255], [25, 232265], [27, 232389], [37, 232799], [42, 233209], [46, 233389], [52, 233689]]}, {"verse": 30, "start": 234951, "end": 243618, "text": "Dijo a Jacob: Te ruego que me des a comer de ese guiso rojo, pues estoy muy cansado. Por tanto fue llamado su nombre Edom.", "words": [[0, 234951], [5, 235277], [7, 235417], [14, 236193], [17, 236331], [23, 236651], [27, 236831], [30, 236991], [34, 237211], [36, 237391], [42, 237651], [45, 237931], [49, 238131], [55, 238471], [61, 239331], [66, 239591], [72, 239931], [76, 240111], [85, 241081], [89, 241183], [95, 241603], [99, 241763], [107, 242083], [110, 242403], [117, 242763]]}, {"verse": 31, "start": 243968, "end": 247805, "text": "Y Jacob respondió: Véndeme en este día tu primogenitura.", "words": [[0, 243968], [2, 244114], [8, 244434], [19, 245683], [27, 246080], [30, 246260], [35, 246440], [39, 246700], [42, 246860]]}, {"verse": 32, "start": 248085, "end": 254163, "text": "Entonces dijo Esaú: He aquí yo me voy a morir; ¿para qué, pues, me servirá la primogenitura?", "words": [[0, 248085], [9, 248669], [14, 249359], [20, 250223], [23, 250293], [28, 250513], [31, 250733], [34, 250853], [38, 251013], [40, 251113], [47, 251768], [53, 251913], [58, 252073], [64, 252433], [67, 252773], [75, 253213], [78, 253273]]}, {"verse": 33, "start": 254443, "end": 260833, "text": "Y dijo Jacob: Júramelo en este día. Y él le juró, y vendió a Jacob su primogenitura.", "words": [[0, 254443], [2, 254571], [7, 254811], [14, 255819], [23, 256099], [26, 256259], [31, 256459], [36, 257175], [38, 257346], [41, 257466], [44, 257606], [50, 258246], [52, 258446], [59, 258846], [61, 258946], [67, 259306], [70, 259666]]}, {"verse": 34, "start": 261183, "end": 273179, "text": "Entonces Jacob dio a Esaú pan y del guisado de las lentejas; y él comió y bebió, y se levantó, y se fue. Así menospreció Esaú la primogenitura.", "words": [[0, 261183], [9, 261945], [15, 262225], [19, 262685], [21, 263032], [26, 263378], [30, 263725], [32, 264165], [36, 264515], [44, 264865], [47, 265005], [51, 265145], [61, 266183], [63, 266308], [66, 266428], [72, 266888], [74, 267008], [81, 267608], [83, 267848], [86, 267948], [95, 268628], [97, 268828], [100, 268948], [105, 269633], [109, 269917], [121, 270867], [126, 271817], [129, 271917]]}]}