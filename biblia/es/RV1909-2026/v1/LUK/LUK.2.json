{"book": "LUK", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 386414, "verses": [{"verse": 1, "start": 300, "end": 8240, "text": "Y aconteció en aquellos días que salió edicto de parte de Augusto César, que toda la tierra fuese empadronada.", "words": [[0, 300], [2, 425], [12, 1185], [15, 1385], [24, 1625], [29, 2065], [33, 2265], [39, 2705], [46, 3425], [49, 3525], [55, 3825], [58, 4105], [66, 4745], [73, 5305], [77, 5765], [82, 6025], [85, 6245], [92, 6505], [98, 7402]]}, {"verse": 2, "start": 8590, "end": 14000, "text": "Este empadronamiento primero fue hecho siendo Cirenio gobernador de la Siria.", "words": [[0, 8590], [5, 9110], [21, 10410], [29, 10770], [33, 11130], [39, 11370], [46, 11850], [54, 12330], [65, 13070], [68, 13230], [71, 13330]]}, {"verse": 3, "start": 14350, "end": 18332, "text": "E iban todos para ser empadronados, cada uno a su ciudad.", "words": [[0, 14350], [2, 14477], [7, 14777], [13, 15117], [18, 15477], [22, 15717], [36, 16857], [41, 17097], [45, 17437], [47, 17597], [50, 17717]]}, {"verse": 4, "start": 18682, "end": 30161, "text": "Y subió José de Galilea, de la ciudad de Nazaret, a Judea, a la ciudad de David, que se llama Belén, por cuanto era de la casa y familia de David;", "words": [[0, 18682], [2, 18964], [8, 19384], [13, 19784], [16, 19984], [25, 21184], [28, 21244], [31, 21384], [38, 21644], [41, 21984], [50, 23044], [52, 23164], [59, 24164], [61, 24284], [64, 24364], [71, 24704], [74, 25024], [81, 25804], [85, 25884], [88, 26024], [94, 26324], [101, 27498], [105, 27626], [112, 27886], [116, 28206], [119, 28346], [122, 28486], [127, 28786], [129, 28946], [137, 29426], [140, 29586]]}, {"verse": 5, "start": 30511, "end": 36263, "text": "Para ser empadronado con María su mujer, desposada con él, la cual estaba encinta.", "words": [[0, 30511], [5, 30655], [9, 30895], [21, 31775], [25, 31995], [31, 32435], [34, 32535], [41, 33225], [51, 33915], [55, 34195], [59, 34615], [62, 34835], [67, 35035], [74, 35677]]}, {"verse": 6, "start": 36613, "end": 42862, "text": "Y aconteció que estando ellos allí, se cumplieron los días en que ella había de parir.", "words": [[0, 36613], [2, 36722], [12, 37482], [16, 37702], [24, 38222], [30, 38482], [36, 39382], [39, 39642], [50, 40322], [54, 40542], [59, 40862], [62, 41182], [66, 41342], [71, 41662], [77, 42042], [80, 42471]]}, {"verse": 7, "start": 43212, "end": 52901, "text": "Y parió a su hijo primogénito, y le envolvió en pañales, y lo acostó en un pesebre, porque no había lugar para ellos en el mesón.", "words": [[0, 43212], [2, 43356], [8, 43816], [10, 44036], [13, 44216], [18, 45126], [31, 46036], [33, 46236], [36, 46376], [45, 46896], [48, 46996], [57, 47596], [59, 48036], [62, 48156], [69, 48676], [72, 48776], [75, 48936], [84, 49996], [91, 50276], [94, 50476], [100, 50716], [106, 51016], [111, 51356], [117, 51736], [120, 52116], [123, 52256]]}, {"verse": 8, "start": 53251, "end": 60084, "text": "Y había pastores en la misma tierra, que velaban y guardaban las vigilias de la noche sobre su ganado.", "words": [[0, 53251], [2, 53388], [8, 53628], [17, 54248], [20, 54488], [23, 54628], [29, 54828], [37, 55308], [41, 55603], [49, 56163], [51, 56583], [61, 57183], [65, 57383], [74, 58203], [77, 58323], [80, 58463], [86, 58743], [92, 59163], [95, 59403]]}, {"verse": 9, "start": 60434, "end": 68648, "text": "Y he aquí el ángel del Señor vino sobre ellos, y la claridad de Dios los cercó de resplandor; y tuvieron gran temor.", "words": [[0, 60434], [2, 60579], [5, 60859], [10, 61199], [13, 61379], [19, 61779], [23, 61959], [29, 62259], [34, 62639], [40, 62959], [47, 63599], [49, 63879], [52, 64019], [61, 64579], [64, 64759], [69, 65079], [73, 65539], [79, 65869], [82, 66199], [94, 67274], [96, 67375], [105, 67775], [110, 68055]]}, {"verse": 10, "start": 68998, "end": 76776, "text": "Pero el ángel les dijo: No temáis; porque he aquí os anuncio buenas noticias de gran gozo, que será para todo el pueblo:", "words": [[0, 68998], [5, 69142], [8, 69322], [14, 69742], [18, 69902], [24, 70604], [27, 71097], [35, 71787], [42, 72004], [45, 72284], [50, 72544], [53, 72724], [61, 73204], [68, 73484], [77, 74084], [80, 74264], [85, 74444], [91, 75184], [95, 75324], [100, 75564], [105, 75824], [110, 76084], [113, 76284]]}, {"verse": 11, "start": 77126, "end": 81679, "text": "Que os ha nacido hoy, en la ciudad de David, un Salvador, que es CRISTO el Señor.", "words": [[0, 77126], [4, 77228], [7, 77408], [10, 77528], [17, 77968], [22, 78208], [25, 78428], [28, 78528], [35, 78808], [38, 79028], [45, 79548], [48, 79668], [58, 80128], [62, 80548], [65, 80818], [72, 81088], [75, 81248]]}, {"verse": 12, "start": 82029, "end": 87177, "text": "Y esto os será por señal: hallaréis al niño envuelto en pañales, echado en un pesebre.", "words": [[0, 82029], [2, 82174], [7, 82304], [10, 82434], [15, 82794], [19, 82994], [26, 83774], [36, 84234], [39, 84374], [44, 84614], [53, 85114], [56, 85214], [65, 85794], [72, 86314], [75, 86434], [78, 86534]]}, {"verse": 13, "start": 87457, "end": 95711, "text": "Y repentinamente hubo con el ángel una multitud de los ejércitos celestiales, que alababan a Dios, y decían:", "words": [[0, 87457], [2, 87583], [17, 88483], [22, 88943], [26, 89063], [29, 89263], [35, 89663], [39, 89903], [48, 90603], [51, 90803], [55, 90943], [65, 91723], [78, 93163], [82, 93403], [91, 93983], [93, 94063], [99, 94323], [101, 94903]]}, {"verse": 14, "start": 95911, "end": 100997, "text": "Gloria en las alturas a Dios, y en la tierra paz, buena voluntad para con los hombres.", "words": [[0, 95911], [7, 96337], [10, 96437], [14, 96557], [22, 97057], [24, 97217], [30, 97417], [32, 97817], [35, 97917], [38, 98017], [45, 98477], [50, 98997], [56, 99297], [65, 99897], [70, 100117], [74, 100317], [78, 100457]]}, {"verse": 15, "start": 101277, "end": 115089, "text": "Y aconteció que como los ángeles se fueron de ellos al cielo, los pastores dijeron los unos a los otros: Pasemos pues hasta Belén, y veamos esto que ha sucedido, que el Señor nos ha manifestado.", "words": [[0, 101277], [2, 101398], [12, 102158], [16, 102358], [21, 102618], [25, 102838], [33, 103458], [36, 103678], [43, 104038], [46, 104338], [52, 104598], [55, 104898], [62, 106018], [66, 106138], [75, 106718], [83, 107318], [87, 107478], [92, 107758], [94, 108018], [98, 108178], [105, 109093], [113, 109501], [118, 109821], [124, 110321], [131, 110841], [133, 111301], [140, 111741], [145, 112221], [149, 112461], [152, 112561], [162, 113221], [166, 113441], [169, 113601], [175, 113861], [179, 114161], [182, 114281]]}, {"verse": 16, "start": 115369, "end": 121391, "text": "Y vinieron aprisa, y hallaron a María, y a José, y al niño acostado en el pesebre.", "words": [[0, 115369], [2, 115466], [11, 116083], [19, 116701], [21, 116781], [30, 117201], [32, 117301], [39, 117641], [41, 118241], [43, 118321], [49, 118661], [51, 119181], [54, 119321], [59, 119661], [68, 120401], [71, 120521], [74, 120661]]}, {"verse": 17, "start": 121741, "end": 126438, "text": "Y viéndolo, hicieron notorio lo que les había sido dicho del niño.", "words": [[0, 121741], [2, 121888], [12, 122488], [21, 123148], [29, 123868], [32, 124288], [36, 124428], [40, 124568], [46, 124888], [51, 125248], [57, 125588], [61, 125848]]}, {"verse": 18, "start": 126788, "end": 131280, "text": "Y todos los que oyeron, se maravillaron de lo que los pastores les decían.", "words": [[0, 126788], [2, 126932], [8, 127172], [12, 127472], [16, 127672], [24, 128172], [27, 128332], [40, 129052], [43, 129232], [46, 129352], [50, 129452], [54, 129592], [63, 130172], [67, 130512]]}, {"verse": 19, "start": 131630, "end": 137032, "text": "Pero María guardaba todas estas cosas, meditándolas en su corazón.", "words": [[0, 131630], [5, 131852], [11, 132252], [20, 133232], [26, 133492], [32, 133912], [39, 134812], [52, 135752], [55, 136052], [58, 136252]]}, {"verse": 20, "start": 137382, "end": 146157, "text": "Y se volvieron los pastores glorificando y alabando a Dios de todas las cosas que habían oído y visto, como les había sido dicho.", "words": [[0, 137382], [2, 137503], [5, 137623], [15, 138143], [19, 138323], [28, 139043], [41, 140243], [43, 140383], [52, 140943], [54, 141063], [59, 141283], [62, 141843], [68, 142063], [72, 142343], [78, 142683], [82, 142943], [89, 143183], [94, 143563], [96, 143683], [103, 144063], [108, 144703], [112, 144883], [118, 145223], [123, 145503]]}, {"verse": 21, "start": 146507, "end": 156955, "text": "Y pasados los ocho días para circuncidar al niño, llamaron su nombre JESÚS; el cual le fue puesto por el ángel antes que él fuese concebido en el vientre.", "words": [[0, 146507], [2, 146612], [10, 147092], [14, 147272], [19, 147672], [24, 147852], [29, 148112], [41, 148852], [44, 149052], [50, 149832], [59, 150452], [62, 150652], [69, 150952], [76, 151949], [79, 152114], [84, 152334], [87, 152534], [91, 152714], [98, 153074], [102, 153354], [105, 153514], [111, 153954], [117, 154414], [121, 154994], [124, 155154], [130, 155494], [140, 156174], [143, 156294], [146, 156394]]}, {"verse": 22, "start": 157305, "end": 166579, "text": "Y como se cumplieron los días de la purificación de ella, conforme a la ley de Moisés, le trajeron a Jerusalén para presentarle al Señor,", "words": [[0, 157305], [2, 157451], [7, 157731], [10, 157951], [21, 158671], [25, 158891], [30, 159191], [33, 159371], [36, 159491], [49, 160171], [52, 160471], [58, 161131], [67, 161751], [69, 161851], [72, 161891], [76, 162091], [79, 162231], [87, 163091], [90, 163171], [99, 163751], [101, 163831], [111, 164511], [116, 164951], [128, 165711], [131, 166011]]}, {"verse": 23, "start": 166929, "end": 173177, "text": "(Como está escrito en la ley del Señor: Todo varón que abra la matriz, será llamado santo al Señor),", "words": [[0, 166929], [6, 167093], [11, 167273], [19, 167613], [22, 167893], [25, 168013], [29, 168233], [33, 168413], [40, 169229], [45, 169373], [51, 169713], [55, 169893], [60, 170113], [63, 170293], [71, 171053], [76, 171453], [84, 171833], [90, 172353], [93, 172493]]}, {"verse": 24, "start": 173527, "end": 181038, "text": "Y para dar la ofrenda, conforme a lo que está dicho en la ley del Señor: un par de tórtolas, o dos palominos.", "words": [[0, 173527], [2, 173635], [7, 173855], [11, 174115], [14, 174295], [23, 174975], [32, 175735], [34, 175835], [37, 175915], [41, 176015], [46, 176215], [52, 176535], [55, 176775], [58, 176935], [62, 177175], [66, 177375], [73, 178226], [76, 178371], [80, 178631], [83, 178771], [93, 179471], [95, 179911], [99, 180111]]}, {"verse": 25, "start": 181388, "end": 194024, "text": "Y he aquí, había un hombre en Jerusalén, llamado Simeón, y este hombre, justo y piadoso, esperaba la consolación de Israel: y el Espíritu Santo era sobre él.", "words": [[0, 181388], [2, 181472], [5, 181592], [11, 181852], [17, 182312], [20, 182652], [27, 182972], [30, 183372], [41, 184232], [49, 185032], [57, 186052], [59, 186592], [64, 186852], [72, 187172], [78, 187592], [80, 187832], [89, 188512], [98, 189232], [101, 189372], [113, 190192], [116, 190372], [124, 191313], [126, 191598], [129, 191698], [138, 192258], [144, 192658], [148, 193158], [154, 193498]]}, {"verse": 26, "start": 194374, "end": 200750, "text": "Y había recibido respuesta del Espíritu Santo, que no vería la muerte antes que viese al Cristo del Señor.", "words": [[0, 194374], [2, 194499], [8, 194699], [17, 195419], [27, 195859], [31, 196199], [40, 196699], [47, 197519], [51, 197679], [54, 197859], [60, 198179], [63, 198279], [70, 198559], [76, 198899], [80, 199099], [86, 199399], [89, 199579], [96, 199879], [100, 200139]]}, {"verse": 27, "start": 201100, "end": 210856, "text": "Y vino por Espíritu al templo. Y cuando metieron al niño Jesús sus padres en el templo, para hacer por él conforme a la costumbre de la ley,", "words": [[0, 201100], [2, 201225], [7, 201445], [11, 201665], [20, 202225], [23, 202325], [31, 203179], [33, 203300], [40, 203540], [49, 204160], [52, 204340], [57, 204680], [63, 205080], [67, 205400], [74, 205960], [77, 206300], [80, 206460], [88, 207660], [93, 207920], [99, 208260], [103, 208500], [106, 208660], [115, 209360], [117, 209420], [120, 209500], [130, 210120], [133, 210260], [136, 210400]]}, {"verse": 28, "start": 211206, "end": 215889, "text": "Entonces él le tomó en sus brazos, y bendijo a Dios, y dijo:", "words": [[0, 211206], [9, 211812], [12, 212372], [15, 212572], [20, 212952], [23, 213032], [27, 213192], [35, 213752], [37, 213972], [45, 214572], [47, 214732], [53, 215012], [55, 215387]]}, {"verse": 29, "start": 216089, "end": 220015, "text": "Ahora despides, Señor, a tu siervo, conforme a tu palabra, en paz;", "words": [[0, 216089], [6, 216391], [16, 217051], [23, 217571], [25, 217631], [28, 217711], [36, 218191], [45, 218771], [47, 218811], [50, 218911], [59, 219271], [62, 219511]]}, {"verse": 30, "start": 220365, "end": 222519, "text": "Porque han visto mis ojos tu salvación,", "words": [[0, 220365], [7, 220544], [11, 220724], [17, 221004], [21, 221224], [26, 221484], [29, 221704]]}, {"verse": 31, "start": 222869, "end": 225793, "text": "La cual has preparado en presencia de todos los pueblos;", "words": [[0, 222869], [3, 222991], [8, 223171], [12, 223391], [22, 223951], [25, 224051], [35, 224611], [38, 224751], [44, 224931], [48, 225151]]}, {"verse": 32, "start": 226143, "end": 230573, "text": "Luz para ser revelada a los Gentiles, y la gloria de tu pueblo Israel.", "words": [[0, 226143], [4, 226351], [9, 226751], [13, 227011], [22, 227571], [24, 227731], [28, 228091], [38, 228451], [40, 228891], [43, 229011], [50, 229351], [53, 229471], [56, 229631], [63, 229911]]}, {"verse": 33, "start": 230853, "end": 235755, "text": "Y José y su madre estaban maravillados de las cosas que se decían de él.", "words": [[0, 230853], [2, 231034], [7, 231334], [9, 231754], [12, 231934], [18, 232354], [26, 232794], [39, 233674], [42, 233834], [46, 233954], [52, 234254], [56, 234494], [59, 234634], [66, 235134], [69, 235354]]}, {"verse": 34, "start": 236105, "end": 245982, "text": "Y los bendijo Simeón, y dijo a su madre María: He aquí, este es puesto para caída y para levantamiento de muchos en Israel; y para señal que será contradicha;", "words": [[0, 236105], [2, 236312], [6, 236552], [14, 236792], [22, 237492], [24, 238132], [29, 238432], [31, 238572], [34, 238692], [40, 238972], [47, 239945], [50, 240089], [56, 240569], [61, 240789], [64, 240929], [71, 241129], [76, 241469], [82, 241889], [84, 242009], [89, 242169], [103, 242869], [106, 243009], [113, 243249], [116, 243469], [124, 244235], [126, 244333], [131, 244493], [137, 244873], [141, 244993], [146, 245193]]}, {"verse": 35, "start": 246332, "end": 252344, "text": "Y una espada traspasará tu misma alma, para que sean manifestados los pensamientos de muchos corazones.", "words": [[0, 246332], [2, 246432], [6, 246592], [13, 247012], [24, 247652], [27, 247832], [33, 248072], [39, 248452], [44, 249072], [48, 249232], [53, 249492], [66, 250232], [70, 250392], [83, 251052], [86, 251232], [93, 251452]]}, {"verse": 36, "start": 252624, "end": 266780, "text": "Estaba también allí Ana, profetisa, hija de Fanuel, de la tribu de Aser; la cual había venido en grande edad, y había vivido con su marido siete años desde su virginidad;", "words": [[0, 252624], [7, 252969], [15, 253349], [20, 253589], [25, 254899], [36, 256209], [41, 256529], [44, 256629], [52, 257709], [55, 257729], [58, 257849], [64, 258229], [67, 258659], [73, 259252], [76, 259357], [81, 259657], [87, 260077], [94, 260537], [97, 260697], [104, 260897], [110, 261797], [112, 261957], [118, 262197], [125, 262717], [129, 262857], [132, 263097], [139, 263577], [145, 264177], [150, 264877], [156, 265477], [159, 266147]]}, {"verse": 37, "start": 267130, "end": 275589, "text": "Y era viuda de hasta ochenta y cuatro años, que no se apartaba del templo, sirviendo de noche y de día con ayunos y oraciones.", "words": [[0, 267130], [2, 267307], [6, 267487], [12, 267887], [15, 268067], [21, 268257], [29, 268447], [31, 268637], [38, 268827], [44, 270147], [48, 270227], [51, 270387], [54, 270527], [63, 271027], [67, 271227], [75, 272027], [85, 272707], [88, 272867], [94, 273167], [96, 273547], [99, 273687], [103, 273947], [107, 274187], [114, 274627], [116, 274747]]}, {"verse": 38, "start": 275939, "end": 286319, "text": "Y esta, sobreviniendo en la misma hora, juntamente confesaba al Señor, y hablaba de él a todos los que esperaban la redención en Jerusalén.", "words": [[0, 275939], [2, 276097], [8, 276767], [22, 277437], [25, 277557], [28, 277697], [34, 277957], [40, 278357], [51, 279377], [61, 280137], [64, 280357], [71, 280737], [73, 281317], [81, 281757], [84, 281937], [87, 282177], [89, 282417], [95, 282697], [99, 282977], [103, 283157], [113, 283777], [116, 284237], [126, 284957], [129, 285337]]}, {"verse": 39, "start": 286669, "end": 293750, "text": "Pero como cumplieron todas las cosas según la ley del Señor, se volvieron a Galilea, a su ciudad de Nazaret.", "words": [[0, 286669], [5, 286796], [10, 287036], [21, 287756], [27, 287996], [31, 288296], [37, 288736], [43, 289096], [46, 289296], [50, 289496], [54, 289676], [61, 290696], [64, 290856], [74, 291316], [76, 291496], [85, 292256], [87, 292296], [90, 292436], [97, 292796], [100, 293036]]}, {"verse": 40, "start": 294100, "end": 301467, "text": "Y el niño crecía, y se fortalecía, y se llenaba de sabiduría; y la gracia de Dios era sobre él.", "words": [[0, 294100], [2, 294205], [5, 294345], [10, 294645], [18, 295325], [20, 295750], [23, 295890], [35, 296710], [37, 297190], [40, 297310], [48, 297810], [51, 297950], [62, 299115], [64, 299242], [67, 299342], [74, 299842], [77, 299962], [82, 300262], [86, 300622], [92, 300962]]}, {"verse": 41, "start": 301817, "end": 306331, "text": "E iban sus padres todos los años a Jerusalén en la fiesta de la Pascua.", "words": [[0, 301817], [2, 301939], [7, 302199], [11, 302359], [18, 302739], [24, 303059], [28, 303319], [33, 303679], [35, 303899], [45, 304619], [48, 304939], [51, 305059], [58, 305439], [61, 305559], [64, 305679]]}, {"verse": 42, "start": 306681, "end": 313520, "text": "Y cuando fue de doce años, subieron ellos a Jerusalén conforme a la costumbre del día de la fiesta.", "words": [[0, 306681], [2, 306778], [9, 306998], [13, 307398], [16, 307618], [21, 307838], [27, 308758], [36, 309458], [42, 309678], [44, 309898], [54, 310578], [63, 310928], [65, 311278], [68, 311398], [78, 312058], [82, 312318], [86, 312558], [89, 312698], [92, 312838]]}, {"verse": 43, "start": 313870, "end": 321480, "text": "Y acabados los días, volviendo ellos, se quedó el niño Jesús en Jerusalén, sin saberlo José y su madre.", "words": [[0, 313870], [2, 313995], [11, 314515], [15, 314695], [21, 314975], [31, 315635], [38, 316215], [41, 316475], [47, 316835], [50, 316955], [55, 317375], [61, 317835], [64, 318135], [75, 318955], [79, 319455], [87, 320155], [92, 320535], [94, 320815], [97, 320955]]}, {"verse": 44, "start": 321830, "end": 329452, "text": "Y pensando que estaba en el grupo, anduvieron camino de un día; y le buscaban entre los parientes y entre los conocidos:", "words": [[0, 321830], [2, 322167], [11, 322567], [15, 322827], [22, 323047], [25, 323227], [28, 323347], [35, 324247], [46, 324727], [53, 325027], [56, 325347], [59, 325447], [64, 326142], [66, 326266], [69, 326366], [78, 326966], [84, 327226], [88, 327426], [98, 327946], [100, 328146], [106, 328326], [110, 328526]]}, {"verse": 45, "start": 329802, "end": 334019, "text": "Pero como no le hallasen, volvieron a Jerusalén buscándole.", "words": [[0, 329802], [5, 329946], [10, 330206], [13, 330426], [16, 331006], [26, 331586], [36, 332126], [38, 332526], [48, 332926]]}, {"verse": 46, "start": 334369, "end": 342531, "text": "Y aconteció, que tres días después le hallaron en el templo, sentado en medio de los maestros, oyéndoles y preguntándoles.", "words": [[0, 334369], [2, 334508], [13, 335228], [17, 335408], [22, 335648], [27, 335928], [35, 336228], [38, 336428], [47, 336908], [50, 337068], [53, 337228], [61, 337908], [69, 338688], [72, 338868], [78, 339148], [81, 339348], [85, 339488], [95, 340648], [105, 341128], [107, 341308]]}, {"verse": 47, "start": 342881, "end": 348972, "text": "Y todos los que le oían, se maravillaban de su entendimiento y de sus respuestas.", "words": [[0, 342881], [2, 343002], [8, 343382], [12, 344002], [16, 344162], [19, 344342], [25, 344862], [28, 345442], [41, 346202], [44, 346402], [47, 346542], [61, 347602], [63, 347722], [66, 347842], [70, 348022]]}, {"verse": 48, "start": 349322, "end": 359516, "text": "Y cuando le vieron, se maravillaron; y le dijo su madre: Hijo, ¿por qué nos has hecho así? He aquí, tu padre y yo te hemos buscado con dolor.", "words": [[0, 349322], [2, 349410], [9, 349610], [12, 349830], [20, 350470], [23, 350570], [37, 351731], [39, 351926], [42, 352121], [47, 352316], [50, 352616], [57, 353427], [63, 353842], [68, 353922], [72, 354102], [76, 354262], [80, 354482], [86, 354722], [91, 355578], [94, 355668], [100, 355888], [103, 356088], [109, 356468], [111, 356888], [114, 357028], [117, 357148], [123, 357328], [131, 357828], [135, 358048]]}, {"verse": 49, "start": 359796, "end": 367601, "text": "Entonces él les dice: ¿Qué hay? ¿por qué me buscabais? ¿No sabíais que en los asuntos de mi Padre me conviene estar?", "words": [[0, 359796], [9, 360344], [12, 360864], [16, 361204], [22, 361994], [27, 362159], [32, 362677], [37, 362803], [41, 362943], [44, 363106], [55, 364026], [59, 364369], [67, 364889], [71, 365149], [74, 365309], [78, 365449], [86, 366009], [89, 366109], [92, 366229], [98, 366509], [101, 366709], [110, 367109]]}, {"verse": 50, "start": 367951, "end": 370488, "text": "Pero ellos no entendieron las palabras que les habló.", "words": [[0, 367951], [5, 368131], [11, 368371], [14, 368591], [26, 369151], [30, 369311], [39, 369651], [43, 369871], [47, 370011]]}, {"verse": 51, "start": 370838, "end": 379326, "text": "Y descendió con ellos, y vino a Nazaret, y estaba sujeto a ellos. Y su madre guardaba todas estas cosas en su corazón.", "words": [[0, 370838], [2, 370960], [12, 371480], [16, 371700], [23, 371940], [25, 372540], [30, 372740], [32, 372880], [41, 373360], [43, 373780], [50, 374040], [57, 374620], [59, 374720], [66, 375484], [68, 375582], [71, 375702], [77, 376082], [86, 376982], [92, 377302], [98, 377722], [104, 378142], [107, 378422], [110, 378582]]}, {"verse": 52, "start": 379676, "end": 386014, "text": "Y Jesús crecía en sabiduría, y en edad, y en gracia para con Dios y los hombres.", "words": [[0, 379676], [2, 379801], [8, 380181], [15, 381001], [18, 381181], [29, 381981], [31, 382241], [34, 382421], [40, 383081], [42, 383321], [45, 383481], [52, 384041], [57, 384241], [61, 384481], [66, 384801], [68, 385201], [72, 385381]]}]}