{"book": "MRK", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 270484, "verses": [{"verse": 1, "start": 300, "end": 9131, "text": "Y como fueron cerca de Jerusalén, de Betfagé, y de Betania, al monte de los Olivos, envía dos de sus discípulos,", "words": [[0, 300], [2, 403], [7, 624], [14, 924], [20, 1404], [23, 1724], [34, 2923], [37, 3383], [46, 3843], [48, 4103], [51, 4224], [60, 5403], [63, 5504], [69, 5804], [72, 6004], [76, 6143], [84, 6624], [90, 7363], [94, 7684], [97, 7943], [101, 8143]]}, {"verse": 2, "start": 9481, "end": 22009, "text": "Y les dice: Id a la aldea que está frente a vosotros, y al entrar en ella, hallaréis un pollino atado, sobre el cual ningún hombre ha subido; desatadlo y traedlo.", "words": [[0, 9481], [2, 9609], [6, 9769], [12, 10632], [15, 10726], [17, 10819], [20, 11019], [26, 11519], [30, 11679], [35, 11879], [42, 12159], [44, 12399], [54, 12899], [56, 13159], [59, 13279], [66, 13719], [69, 14079], [75, 14639], [85, 15419], [88, 15579], [96, 16039], [103, 16679], [109, 17199], [112, 17399], [117, 17559], [124, 17979], [131, 18639], [134, 19079], [142, 19972], [152, 20878], [154, 21078]]}, {"verse": 3, "start": 22359, "end": 29811, "text": "Y si alguien os dice: ¿Por qué hacéis eso? decid que el Señor lo necesita: y que luego lo devolverá.", "words": [[0, 22359], [2, 22478], [5, 22598], [13, 22958], [16, 23278], [22, 24170], [27, 24274], [31, 24474], [38, 24854], [43, 25559], [49, 26046], [53, 26266], [56, 26486], [62, 26826], [65, 27106], [75, 28186], [77, 28304], [81, 28424], [87, 28684], [90, 28944]]}, {"verse": 4, "start": 30161, "end": 36567, "text": "Y fueron, y hallaron el pollino atado a la puerta fuera, entre dos caminos; y le desataron.", "words": [[0, 30161], [2, 30423], [10, 30723], [12, 31063], [21, 31523], [24, 31853], [32, 32183], [38, 32643], [40, 32763], [43, 32843], [50, 33163], [57, 33963], [63, 34283], [67, 34523], [76, 35449], [78, 35572], [81, 35652]]}, {"verse": 5, "start": 36917, "end": 41516, "text": "Y unos de los que estaban allí, les dijeron: ¿Qué hacéis desatando el pollino?", "words": [[0, 36917], [2, 37068], [7, 37258], [10, 37438], [14, 37578], [18, 37738], [26, 37998], [32, 38398], [36, 38918], [45, 39882], [50, 39982], [57, 40342], [67, 40882], [70, 40982]]}, {"verse": 6, "start": 41796, "end": 47001, "text": "Ellos entonces les dijeron como Jesús había mandado: y los dejaron.", "words": [[0, 41796], [6, 42203], [15, 42743], [19, 43203], [27, 43803], [32, 44043], [38, 44383], [44, 44943], [53, 45973], [55, 46117], [59, 46237]]}, {"verse": 7, "start": 47351, "end": 53694, "text": "Y trajeron el pollino a Jesús, y echaron sobre él sus vestidos, y se sentó sobre él.", "words": [[0, 47351], [2, 47476], [11, 48056], [14, 48176], [22, 48656], [24, 48776], [31, 49116], [33, 49856], [41, 50336], [47, 50676], [50, 50916], [54, 51136], [64, 51736], [66, 52256], [69, 52396], [75, 52916], [81, 53236]]}, {"verse": 8, "start": 54044, "end": 61374, "text": "Y muchos tendían sus vestidos por el camino, y otros cortaban hojas de los árboles, y las tendían por el camino.", "words": [[0, 54044], [2, 54187], [9, 54507], [17, 55107], [21, 55327], [30, 55867], [34, 56107], [37, 56207], [45, 57027], [47, 57287], [53, 57507], [62, 58227], [68, 58727], [71, 58867], [75, 58967], [84, 59567], [86, 59772], [90, 59892], [98, 60412], [102, 60632], [105, 60772]]}, {"verse": 9, "start": 61724, "end": 69725, "text": "Y los que iban delante, y los que iban detrás, daban voces diciendo: ¡Hosanna! Bendito el que viene en el nombre del Señor.", "words": [[0, 61724], [2, 61960], [6, 62060], [10, 62220], [15, 62480], [24, 63000], [26, 63400], [30, 63540], [34, 63680], [39, 63960], [47, 64480], [53, 65140], [59, 65600], [69, 66967], [79, 67540], [87, 68017], [90, 68137], [94, 68237], [100, 68497], [103, 68677], [106, 68777], [113, 68997], [117, 69197]]}, {"verse": 10, "start": 70075, "end": 74424, "text": "Bendito el reino de nuestro padre David que viene: ¡Hosanna en las alturas!", "words": [[0, 70075], [8, 70578], [11, 70698], [17, 71038], [20, 71158], [28, 71318], [34, 71838], [40, 72138], [44, 72338], [51, 73254], [60, 73494], [63, 73694], [67, 73814]]}, {"verse": 11, "start": 74704, "end": 84698, "text": "Y entró Jesús en Jerusalén, y en el templo: y habiendo mirado alrededor todas las cosas, y siendo ya tarde, se salió a Betania con los doce.", "words": [[0, 74704], [2, 74861], [8, 75281], [14, 75561], [17, 75861], [28, 76621], [30, 76781], [33, 76901], [36, 77021], [44, 77856], [46, 78141], [55, 78461], [62, 78901], [72, 79181], [78, 79821], [82, 80081], [89, 80541], [91, 80861], [98, 81161], [101, 81361], [108, 82201], [111, 82421], [117, 82801], [119, 82881], [127, 83461], [131, 83921], [135, 84101]]}, {"verse": 12, "start": 85048, "end": 88806, "text": "Y el día siguiente, cuando salieron de Betania, tuvo hambre.", "words": [[0, 85048], [2, 85170], [5, 85290], [9, 85470], [20, 86230], [27, 86390], [36, 87050], [39, 87230], [48, 87870], [53, 88070]]}, {"verse": 13, "start": 89156, "end": 100932, "text": "Y viendo de lejos una higuera que tenía hojas, se acercó, si quizá hallaría en ella algo: y cuando vino a ella, nada halló sino hojas; porque no era tiempo de higos.", "words": [[0, 89156], [2, 89283], [9, 89603], [12, 89824], [18, 90124], [22, 90383], [30, 90863], [34, 91003], [40, 91343], [47, 92083], [50, 92303], [58, 93324], [61, 93544], [67, 94063], [76, 94583], [79, 94764], [84, 95003], [90, 95807], [92, 95913], [99, 96133], [104, 96433], [106, 96653], [112, 96813], [117, 97533], [123, 98073], [128, 98313], [135, 99192], [142, 99396], [145, 99616], [149, 99736], [156, 100036], [159, 100316]]}, {"verse": 14, "start": 101282, "end": 110663, "text": "Entonces Jesús respondiendo, dijo a la higuera: Nunca más coma nadie fruto de ti para siempre. Y lo oyeron sus discípulos.", "words": [[0, 101282], [9, 101802], [15, 102367], [29, 103587], [34, 104007], [36, 104267], [39, 104367], [48, 105302], [54, 105748], [58, 105988], [63, 106208], [69, 106528], [75, 106948], [78, 107088], [81, 107268], [86, 107488], [95, 108489], [97, 108631], [100, 109051], [107, 109471], [111, 109631]]}, {"verse": 15, "start": 111013, "end": 125191, "text": "Vienen, pues, a Jerusalén; y entrando Jesús en el templo, comenzó a echar fuera a los que vendían y compraban en el templo; y volcó las mesas de los cambistas, y las sillas de los que vendían palomas;", "words": [[0, 111013], [8, 111360], [14, 111700], [16, 112160], [27, 113287], [29, 113432], [38, 113912], [44, 114292], [47, 114612], [50, 114772], [58, 115432], [66, 116132], [68, 116232], [74, 116392], [80, 116792], [82, 117272], [86, 117392], [90, 117512], [98, 118072], [100, 118292], [110, 118992], [113, 119112], [116, 119272], [124, 120166], [126, 120271], [132, 120731], [136, 120871], [142, 121331], [145, 121411], [149, 121841], [160, 122271], [162, 122586], [166, 122746], [173, 123206], [176, 123666], [180, 123786], [184, 123906], [192, 124346]]}, {"verse": 16, "start": 125541, "end": 130584, "text": "Y no consentía que alguien transportara ningún objeto por el templo.", "words": [[0, 125541], [2, 125792], [5, 125912], [15, 126772], [19, 126972], [27, 127312], [40, 128332], [47, 128712], [54, 129372], [58, 129712], [61, 129872]]}, {"verse": 17, "start": 130934, "end": 141473, "text": "Y les enseñaba diciendo: ¿No está escrito que mi casa, casa de oración será llamada por todas las naciones? Pero vosotros la habéis hecho cueva de ladrones.", "words": [[0, 130934], [2, 131058], [6, 131218], [15, 131938], [25, 133055], [29, 133163], [34, 133323], [42, 133763], [46, 134003], [49, 134143], [55, 134563], [60, 134863], [63, 135083], [71, 135623], [76, 135763], [84, 136243], [88, 136443], [94, 136743], [98, 137043], [108, 138051], [113, 138196], [122, 138796], [125, 139336], [132, 139716], [138, 140016], [144, 140476], [147, 140596]]}, {"verse": 18, "start": 141823, "end": 153102, "text": "Y lo oyeron los escribas y los principales sacerdotes, y buscaban cómo le matarían; porque le tenían miedo, por cuanto todo el pueblo estaba maravillado de su enseñanza.", "words": [[0, 141823], [2, 141948], [5, 142128], [12, 142588], [16, 142768], [25, 143468], [27, 143628], [31, 143728], [43, 144508], [55, 145308], [57, 145868], [66, 146388], [71, 146728], [74, 146948], [84, 148018], [91, 148223], [94, 148403], [101, 148703], [108, 149183], [112, 149403], [119, 149703], [124, 150043], [127, 150243], [134, 150603], [141, 151003], [153, 151843], [156, 152003], [159, 152163]]}, {"verse": 19, "start": 153452, "end": 157064, "text": "Pero como fue tarde, Jesús salió de la ciudad.", "words": [[0, 153452], [5, 153578], [10, 153818], [14, 154018], [21, 154998], [27, 155418], [33, 156178], [36, 156298], [39, 156418]]}, {"verse": 20, "start": 157414, "end": 162390, "text": "Y pasando por la mañana, vieron que la higuera se había secado desde las raíces.", "words": [[0, 157414], [2, 157520], [10, 157860], [14, 158180], [17, 158320], [25, 159020], [32, 159340], [36, 159560], [39, 159700], [47, 160180], [50, 160340], [56, 160580], [63, 161120], [69, 161320], [73, 161580]]}, {"verse": 21, "start": 162740, "end": 169608, "text": "Entonces Pedro, recordando, le dice: Maestro, he aquí la higuera que maldijiste, se ha secado.", "words": [[0, 162740], [9, 163398], [16, 164298], [28, 165278], [31, 165358], [37, 166063], [46, 166862], [49, 166942], [54, 167222], [57, 167382], [65, 167722], [69, 168272], [81, 168822], [84, 168962], [87, 169082]]}, {"verse": 22, "start": 169888, "end": 173837, "text": "Y respondiendo Jesús, les dice: Tened fe en Dios.", "words": [[0, 169888], [2, 170032], [15, 170812], [22, 171672], [26, 171792], [32, 172558], [38, 172882], [41, 173102], [44, 173302]]}, {"verse": 23, "start": 174187, "end": 186756, "text": "Porque de cierto os digo que cualquiera que diga a este monte: Quítate, y échate en el mar, y no dude en su corazón, sino crea que será hecho lo que dice, lo que diga le será hecho.", "words": [[0, 174187], [7, 174411], [10, 174611], [17, 174871], [20, 175251], [25, 175491], [29, 175731], [40, 176411], [44, 176571], [49, 176761], [51, 176951], [56, 177271], [63, 178223], [72, 178687], [74, 179047], [81, 179467], [84, 179747], [87, 179887], [92, 180147], [94, 180707], [97, 180867], [102, 181247], [105, 181407], [108, 181567], [117, 182267], [122, 182967], [127, 183407], [131, 183567], [136, 183847], [142, 184247], [145, 184467], [149, 184627], [155, 185107], [158, 185227], [162, 185447], [167, 185667], [170, 185807], [175, 186087]]}, {"verse": 24, "start": 187106, "end": 192887, "text": "Por tanto, os digo que todo lo que orando pidáis, creed que lo recibiréis, y os vendrá.", "words": [[0, 187106], [4, 187233], [11, 187593], [14, 187793], [19, 187993], [23, 188193], [28, 188493], [31, 188733], [35, 188893], [42, 189403], [50, 189913], [56, 190668], [60, 190868], [63, 191028], [75, 191828], [77, 192068], [80, 192228]]}, {"verse": 25, "start": 193237, "end": 203721, "text": "Y cuando estéis orando, perdonad, si tenéis algo contra alguno, para que vuestro Padre que está en los cielos os perdone también a vosotros vuestras ofensas.", "words": [[0, 193237], [2, 193364], [9, 193644], [16, 194104], [24, 195144], [34, 195844], [37, 196304], [44, 196724], [49, 197044], [56, 197424], [64, 198524], [69, 198684], [73, 198844], [81, 199184], [87, 199624], [91, 199764], [96, 199984], [99, 200164], [103, 200324], [110, 200784], [113, 200924], [121, 201404], [129, 201724], [131, 202004], [140, 202424], [149, 202824]]}, {"verse": 26, "start": 204071, "end": 211164, "text": "Porque si vosotros no perdonáis, tampoco vuestro Padre que está en los cielos os perdonará vuestras ofensas.", "words": [[0, 204071], [7, 204233], [10, 204453], [19, 204973], [22, 205193], [33, 205873], [41, 206473], [49, 207093], [55, 207393], [59, 207633], [64, 207833], [67, 207973], [71, 208113], [78, 208693], [81, 208833], [91, 209778], [100, 210238]]}, {"verse": 27, "start": 211514, "end": 220490, "text": "Y volvieron a Jerusalén; y andando él por el templo, vienen a él los principales sacerdotes, y los escribas, y los ancianos;", "words": [[0, 211514], [2, 211624], [12, 212084], [14, 212224], [25, 213272], [27, 213400], [35, 213880], [38, 214060], [42, 214260], [45, 214440], [53, 215140], [60, 215600], [62, 215980], [65, 216200], [69, 216380], [81, 217120], [93, 217960], [95, 218140], [99, 218320], [109, 219040], [111, 219460], [115, 219620]]}, {"verse": 28, "start": 220840, "end": 227056, "text": "Y le dicen: ¿Con qué autoridad haces estas cosas? ¿y quién te ha dado esta autoridad para hacer estas cosas?", "words": [[0, 220840], [2, 221005], [5, 221085], [12, 221862], [17, 221995], [21, 222195], [31, 222795], [37, 223075], [43, 223315], [50, 224199], [53, 224340], [59, 224500], [62, 224660], [65, 224760], [70, 224960], [75, 225160], [85, 225660], [90, 225940], [96, 226160], [102, 226360]]}, {"verse": 29, "start": 227336, "end": 237010, "text": "Y Jesús respondiendo entonces, les dice: Os haré también una pregunta; y respondedme, y os diré con qué autoridad hago estas cosas:", "words": [[0, 227336], [2, 227458], [8, 227838], [21, 228978], [31, 229438], [35, 230118], [41, 231011], [44, 231180], [49, 231480], [57, 231680], [61, 231940], [71, 232928], [73, 233391], [86, 233891], [88, 234291], [91, 234431], [96, 234731], [100, 234871], [104, 235051], [114, 235651], [119, 236031], [125, 236251]]}, {"verse": 30, "start": 237360, "end": 241826, "text": "El bautismo de Juan, ¿era del cielo, o de los hombres? Respondedme.", "words": [[0, 237360], [3, 237486], [12, 237986], [15, 238126], [21, 238526], [26, 238946], [30, 239186], [37, 239486], [39, 239806], [42, 239866], [46, 239986], [55, 241371]]}, {"verse": 31, "start": 242176, "end": 250078, "text": "Entonces ellos pensaron dentro de sí, diciendo: Si decimos, del cielo, dirá: ¿Por qué, pues, no le creísteis?", "words": [[0, 242176], [9, 242642], [15, 243022], [24, 243682], [31, 243942], [34, 244182], [38, 244902], [48, 245846], [51, 245978], [60, 246438], [64, 246658], [71, 247478], [77, 248112], [82, 248236], [87, 248416], [93, 248756], [96, 249036], [99, 249176]]}, {"verse": 32, "start": 250428, "end": 257213, "text": "Y si decimos, de los hombres, tememos al pueblo: porque todos juzgaban de Juan, que verdaderamente era profeta.", "words": [[0, 250428], [2, 250546], [5, 250646], [14, 251106], [17, 251286], [21, 251426], [30, 251806], [38, 252466], [41, 252646], [49, 253481], [56, 253668], [62, 253988], [71, 254608], [74, 254788], [80, 255088], [84, 255528], [99, 256288], [103, 256488]]}, {"verse": 33, "start": 257493, "end": 270083, "text": "Y respondiendo, dicen a Jesús: No sabemos. Entonces respondiendo Jesús, les dice: Tampoco yo os diré con qué autoridad hago estas cosas.", "words": [[0, 257493], [2, 257622], [16, 258982], [22, 259462], [24, 259922], [31, 260842], [34, 261000], [43, 262026], [52, 263070], [65, 264110], [72, 264370], [76, 264830], [82, 265722], [90, 266122], [93, 266582], [96, 266842], [101, 267282], [105, 267662], [109, 267922], [119, 268782], [124, 269142], [130, 269362]]}]}