[102, 69945], [105, 70085], [108, 70245]]}, {"verse": 8, "start": 71187, "end": 82763, "text": "Entonces murió Débora, nodriza de Rebeca, y fue sepultada a las raíces de Bet-el, debajo de una encina: y se llamó su nombre Alón-bacut.", "words": [[0, 71187], [9, 71644], [15, 72384], [23, 72884], [31, 73544], [34, 73724], [42, 74344], [44, 74884], [48, 75064], [58, 75844], [60, 76004], [64, 76124], [71, 76724], [74, 76944], [82, 77744], [89, 78504], [92, 78664], [96, 78824], [104, 79903], [106, 80163], [109, 80263], [115, 80603], [118, 80723], [125, 81743]]}, {"verse": 9, "start": 83113, "end": 90203, "text": "Y se apareció otra vez Dios a Jacob, cuando se había vuelto de Padan-aram, y le bendijo.", "words": [[0, 83113], [2, 83254], [5, 83374], [14, 84054], [19, 84434], [23, 84754], [28, 85154], [30, 85494], [37, 86474], [44, 86894], [47, 87154], [53, 87374], [60, 87854], [63, 88494], [75, 89134], [77, 89299], [80, 89419]]}, {"verse": 10, "start": 90553, "end": 100907, "text": "Y le dijo Dios: Tu nombre es Jacob; no se llamará más tu nombre Jacob, sino Israel será tu nombre: y llamó su nombre Israel.", "words": [[0, 90553], [2, 90678], [5, 90758], [10, 91038], [16, 92034], [19, 92118], [26, 92438], [29, 92818], [36, 94014], [39, 94196], [42, 94476], [50, 94756], [54, 94936], [57, 95116], [64, 95496], [71, 96256], [76, 96556], [83, 97036], [88, 97396], [91, 97616], [99, 98678], [101, 98827], [107, 99127], [110, 99287], [117, 100097]]}, {"verse": 11, "start": 101257, "end": 113123, "text": "Y le dijo Dios: Yo soy el Dios Omnipotente: crece y multiplícate; una nación y conjunto de naciones procederá de ti, y reyes saldrán de tus lomos:", "words": [[0, 101257], [2, 101382], [5, 101462], [10, 101742], [16, 102738], [19, 102876], [23, 103136], [26, 103436], [31, 103656], [44, 105271], [50, 105707], [52, 105907], [66, 107342], [70, 107523], [77, 107983], [79, 108203], [88, 108683], [91, 108943], [100, 109463], [110, 110183], [113, 110263], [117, 110883], [119, 110943], [125, 111383], [133, 112003], [136, 112103], [140, 112243]]}, {"verse": 12, "start": 113473, "end": 121729, "text": "Y la tierra que yo he dado a Abraham y a Isaac, la daré a ti: y a tu descendencia después de ti daré la tierra.", "words": [[0, 113473], [2, 113580], [5, 113700], [12, 114000], [16, 114280], [19, 114480], [22, 114560], [27, 114840], [29, 115160], [37, 115520], [39, 115710], [41, 115900], [48, 116780], [51, 116980], [56, 117280], [58, 117360], [62, 118186], [64, 118368], [66, 118428], [69, 118548], [82, 119528], [90, 119888], [93, 120128], [96, 120568], [101, 120808], [104, 120868]]}, {"verse": 13, "start": 122009, "end": 126596, "text": "Y se fue de él Dios, del lugar donde con él había hablado.", "words": [[0, 122009], [2, 122131], [5, 122271], [9, 122471], [12, 122671], [15, 122971], [21, 123711], [25, 123971], [31, 124331], [37, 124751], [41, 125091], [44, 125311], [50, 125691]]}, {"verse": 14, "start": 126946, "end": 137792, "text": "Y Jacob erigió una columna en el lugar donde había hablado con él, una columna de piedra, y derramó sobre él libación, y echó sobre él aceite.", "words": [[0, 126946], [2, 127070], [8, 127350], [15, 127870], [19, 128030], [27, 128590], [30, 128730], [33, 128890], [39, 129170], [45, 129430], [51, 129790], [59, 130210], [63, 130430], [67, 131010], [71, 131290], [79, 131810], [82, 131930], [90, 132590], [92, 133150], [100, 133790], [106, 134070], [109, 134350], [119, 135090], [121, 135770], [126, 136150], [132, 136450], [135, 136850]]}, {"verse": 15, "start": 138142, "end": 143635, "text": "Y llamó Jacob el nombre de aquel lugar donde Dios había hablado con él, Bet-el.", "words": [[0, 138142], [2, 138248], [8, 138608], [14, 138988], [17, 139388], [24, 139748], [27, 139948], [33, 140288], [39, 140548], [45, 140888], [50, 141188], [56, 141628], [64, 142208], [68, 142408], [72, 143108]]}, {"verse": 16, "start": 143985, "end": 153612, "text": "Y partieron de Bet-el, y había aún como media legua de tierra para llegar a Efrata, cuando parió Raquel, y hubo trabajo en su parto.", "words": [[0, 143985], [2, 144108], [12, 144748], [15, 145398], [23, 146048], [25, 146288], [31, 146608], [35, 146948], [40, 147268], [46, 147628], [52, 148148], [55, 148308], [62, 148688], [67, 149008], [74, 149248], [76, 149428], [84, 150368], [91, 150608], [97, 151008], [105, 151428], [107, 151668], [112, 152208], [120, 152648], [123, 152848], [126, 153249]]}, {"verse": 17, "start": 153962, "end": 161970, "text": "Y aconteció, que como tenía dificultades en el parto, le dijo la partera: No temas, que también tendrás este hijo.", "words": [[0, 153962], [2, 154098], [13, 154758], [17, 155058], [22, 155198], [28, 155598], [41, 156538], [44, 156758], [47, 156898], [54, 158158], [57, 158278], [62, 158558], [65, 158718], [74, 159672], [77, 159878], [84, 160158], [88, 160378], [96, 160758], [104, 161178], [109, 161478]]}, {"verse": 18, "start": 162250, "end": 171416, "text": "Y aconteció que al exhalar su último aliento, (pues murió) llamó su nombre Benoni; mas su padre lo llamó Benjamín.", "words": [[0, 162250], [2, 162397], [12, 163197], [16, 163557], [19, 163697], [27, 164257], [30, 164457], [37, 164837], [46, 166077], [52, 166157], [59, 167017], [65, 167317], [68, 167517], [75, 167857], [83, 168811], [87, 168891], [90, 169191], [96, 169691], [99, 170051], [105, 170431]]}, {"verse": 19, "start": 171766, "end": 177242, "text": "Así murió Raquel, y fue sepultada en el camino de Efrata, la cual es Belén.", "words": [[0, 171766], [4, 171992], [10, 172372], [18, 172872], [20, 173452], [24, 173612], [34, 174352], [37, 174492], [40, 174592], [47, 174932], [50, 175382], [58, 175832], [61, 175932], [66, 176172], [69, 176432]]}, {"verse": 20, "start": 177592, "end": 185199, "text": "Y puso Jacob una columna sobre su sepultura: esta es la columna de la sepultura de Raquel hasta hoy.", "words": [[0, 177592], [2, 177740], [7, 178140], [13, 178500], [17, 178960], [25, 179620], [31, 179880], [34, 180120], [45, 181307], [50, 181667], [53, 182027], [56, 182407], [64, 182967], [67, 183067], [70, 183187], [80, 183807], [83, 184047], [90, 184467], [96, 184727]]}, {"verse": 21, "start": 185549, "end": 190612, "text": "Y salió Israel, y tendió su tienda de la otra parte de Migdal-edar.", "words": [[0, 185549], [2, 185687], [8, 186087], [16, 187107], [18, 187367], [25, 187787], [28, 187947], [35, 188427], [38, 188587], [41, 188727], [46, 188947], [52, 189367], [55, 189607]]}, {"verse": 22, "start": 190962, "end": 204749, "text": "Y acaeció, morando Israel en aquella tierra, que fue Rubén y durmió con Bilha la concubina de su padre; lo cual llegó a entender Israel. Ahora bien, los hijos de Israel fueron doce:", "words": [[0, 190962], [2, 191268], [11, 191988], [19, 192708], [26, 193188], [29, 193348], [37, 193668], [45, 194108], [49, 194388], [53, 194608], [59, 195208], [61, 195628], [68, 196088], [72, 196438], [78, 196788], [81, 196928], [91, 197648], [94, 197788], [97, 197928], [104, 198787], [107, 198913], [112, 199233], [118, 199673], [120, 199933], [129, 200233], [137, 201133], [143, 201478], [149, 202318], [153, 202538], [159, 202898], [162, 203098], [169, 203538], [176, 203898]]}, {"verse": 23, "start": 205099, "end": 213386, "text": "Los hijos de Lea: Rubén el primogénito de Jacob, y Simeón, y Leví, y Judá, e Isacar, y Zabulón.", "words": [[0, 205099], [4, 205399], [10, 205699], [13, 205939], [18, 207279], [24, 207749], [27, 207829], [39, 208649], [42, 208769], [49, 209629], [51, 209709], [59, 210529], [61, 210589], [67, 211109], [69, 211314], [75, 211519], [77, 211724], [85, 211929], [87, 212687]]}, {"verse": 24, "start": 213736, "end": 216734, "text": "Los hijos de Raquel: José, y Benjamín.", "words": [[0, 213736], [4, 213885], [10, 214185], [13, 214405], [21, 215210], [27, 215592], [29, 215912]]}, {"verse": 25, "start": 217084, "end": 221427, "text": "Y los hijos de Bilha, sierva de Raquel: Dan, y Neftalí.", "words": [[0, 217084], [2, 217188], [6, 217328], [12, 217608], [15, 218038], [22, 218468], [29, 218948], [32, 219088], [40, 220312], [45, 220697], [47, 221082]]}, {"verse": 26, "start": 221777, "end": 229926, "text": "Y los hijos de Zilpa, sierva de Lea: Gad, y Aser. Estos fueron los hijos de Jacob, que le nacieron en Padan-aram.", "words": [[0, 221777], [2, 221862], [6, 221982], [12, 222262], [15, 222595], [22, 222929], [29, 223262], [32, 223542], [37, 224371], [42, 225011], [44, 225483], [50, 226126], [56, 226432], [63, 226632], [67, 226872], [73, 227152], [76, 227332], [83, 228092], [87, 228172], [90, 228292], [99, 228752], [102, 229367]]}, {"verse": 27, "start": 230276, "end": 239242, "text": "Y vino Jacob a Isaac su padre a Mamre, a la ciudad de Arba, que es Hebrón, donde habitaron Abraham e Isaac.", "words": [[0, 230276], [2, 230401], [7, 230621], [13, 230961], [15, 231361], [21, 231941], [24, 232081], [30, 232614], [32, 233148], [39, 233681], [41, 233861], [44, 233941], [51, 234221], [54, 234601], [60, 235481], [64, 235501], [67, 236071], [75, 236641], [81, 236841], [91, 237621], [99, 238041], [101, 238641]]}, {"verse": 28, "start": 239592, "end": 242696, "text": "Y fueron los días de Isaac ciento ochenta años.", "words": [[0, 239592], [2, 239698], [9, 239938], [13, 240158], [18, 240378], [21, 240838], [27, 241118], [34, 241398], [42, 241678]]}, {"verse": 29, "start": 243046, "end": 253673, "text": "Y exhaló Isaac el espíritu, y murió, y fue recogido a sus pueblos, viejo y lleno de días; y lo sepultaron Esaú y Jacob sus hijos.", "words": [[0, 243046], [2, 243194], [9, 243794], [15, 244394], [18, 244554], [28, 245494], [30, 245554], [37, 246014], [39, 246434], [43, 246594], [52, 247294], [54, 247414], [58, 247554], [67, 248254], [73, 248954], [75, 249254], [81, 249534], [84, 249654], [90, 250471], [92, 250592], [95, 250752], [106, 251312], [111, 251872], [113, 252092], [119, 252832], [123, 253032]]}]}