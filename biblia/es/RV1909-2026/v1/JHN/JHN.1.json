{"book": "JHN", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 360389, "verses": [{"verse": 1, "start": 300, "end": 6275, "text": "En el principio era el Verbo, y el Verbo era con Dios, y el Verbo era Dios.", "words": [[0, 300], [3, 467], [6, 567], [16, 1167], [20, 1507], [23, 1667], [30, 2467], [32, 2707], [35, 2847], [41, 3267], [45, 3427], [49, 3647], [55, 4607], [57, 4707], [60, 4887], [66, 5367], [70, 5567]]}, {"verse": 2, "start": 6625, "end": 9271, "text": "Este era en el principio con Dios.", "words": [[0, 6625], [5, 7006], [9, 7286], [12, 7426], [15, 7586], [25, 8166], [29, 8606]]}, {"verse": 3, "start": 9621, "end": 15660, "text": "Todas las cosas por él fueron hechas; y sin él nada de lo que es hecho, fue hecho.", "words": [[0, 9621], [6, 9947], [10, 10127], [16, 10447], [20, 10787], [23, 10927], [30, 11247], [38, 12246], [40, 12369], [44, 12569], [47, 12789], [52, 13169], [55, 13429], [58, 13569], [62, 13709], [65, 13909], [72, 14389], [76, 15069]]}, {"verse": 4, "start": 16010, "end": 20617, "text": "En él estaba la vida, y la vida era la luz de los hombres.", "words": [[0, 16010], [3, 16208], [6, 16488], [13, 17108], [16, 17348], [22, 17988], [24, 18108], [27, 18248], [32, 18468], [36, 18748], [39, 18928], [43, 19308], [46, 19688], [50, 19828]]}, {"verse": 5, "start": 20967, "end": 26791, "text": "Y la luz en las tinieblas resplandece; pero las tinieblas no la comprendieron.", "words": [[0, 20967], [2, 21055], [5, 21195], [9, 21515], [12, 21935], [16, 22095], [26, 23056], [39, 24194], [44, 24340], [48, 24540], [58, 25300], [61, 25580], [64, 25720]]}, {"verse": 6, "start": 27141, "end": 31755, "text": "fue un hombre enviado de Dios, el cual se llamaba Juan.", "words": [[0, 27141], [4, 27471], [7, 27811], [14, 28151], [22, 28851], [25, 29051], [31, 29811], [34, 30031], [39, 30311], [42, 30651], [50, 31131]]}, {"verse": 7, "start": 32105, "end": 38889, "text": "Este vino por testimonio, para que diese testimonio de la luz, para que todos creyesen por él.", "words": [[0, 32105], [5, 32449], [10, 32849], [14, 33109], [26, 34189], [31, 34409], [35, 34689], [41, 34969], [52, 35709], [55, 35789], [58, 35949], [63, 36589], [68, 36989], [72, 37129], [78, 37469], [87, 38289], [91, 38509]]}, {"verse": 8, "start": 39239, "end": 43424, "text": "No era él la luz, sino para que diese testimonio de la luz.", "words": [[0, 39239], [3, 39465], [7, 39745], [10, 40005], [13, 40185], [18, 40805], [23, 41125], [28, 41365], [32, 41595], [38, 41825], [49, 42705], [52, 42805], [55, 42945]]}, {"verse": 9, "start": 43774, "end": 49369, "text": "Aquel era la luz verdadera, que alumbra a todo hombre que viene a este mundo.", "words": [[0, 43944], [6, 44114], [10, 44459], [13, 44639], [17, 44979], [28, 45879], [32, 46179], [40, 46719], [42, 46939], [47, 47159], [54, 47759], [58, 48019], [64, 48359], [66, 48539], [71, 48759]]}, {"verse": 10, "start": 49719, "end": 55373, "text": "En el mundo estaba, y el mundo fue hecho por él; y el mundo no le conoció.", "words": [[0, 49719], [3, 49866], [6, 50006], [12, 50306], [20, 50806], [22, 51346], [25, 51506], [31, 51806], [35, 52086], [41, 52366], [45, 52666], [49, 53275], [51, 53373], [54, 53513], [60, 53893], [63, 54333], [66, 54493]]}, {"verse": 11, "start": 55723, "end": 59931, "text": "A lo suyo vino, y los suyos no le recibieron.", "words": [[0, 55723], [2, 55922], [5, 56022], [10, 56482], [16, 57042], [18, 57562], [22, 57722], [28, 58302], [31, 58632], [34, 58962]]}, {"verse": 12, "start": 60281, "end": 67843, "text": "Pero a todos los que le recibieron, les dio potestad de ser hechos hijos de Dios, a los que creen en su nombre:", "words": [[0, 60281], [5, 60423], [7, 60563], [13, 60943], [17, 61203], [21, 61703], [24, 62203], [36, 62703], [40, 62963], [44, 63163], [53, 63863], [56, 64023], [60, 64243], [67, 64543], [73, 64843], [76, 65043], [82, 65683], [84, 65903], [88, 66043], [92, 66183], [98, 66723], [101, 67003], [104, 67163]]}, {"verse": 13, "start": 68193, "end": 76015, "text": "Los cuales no son engendrados de sangre, ni de voluntad de carne, ni de voluntad de varón, sino de Dios.", "words": [[0, 68193], [4, 68373], [11, 68693], [14, 69233], [18, 69493], [30, 70233], [33, 70413], [41, 71273], [44, 71533], [47, 71673], [56, 72213], [59, 72353], [66, 73133], [69, 73373], [72, 73493], [81, 74073], [84, 74193], [91, 75113], [96, 75213], [99, 75453]]}, {"verse": 14, "start": 76365, "end": 86709, "text": "Y aquel Verbo fue hecho carne, y habitó entre nosotros (y vimos su gloria, gloria como del unigénito del Padre), lleno de gracia y de verdad.", "words": [[0, 76365], [2, 76489], [8, 76809], [14, 77209], [18, 77449], [24, 77729], [31, 78289], [33, 78809], [40, 79229], [46, 79449], [55, 79989], [58, 80389], [64, 80689], [67, 81262], [75, 81836], [82, 82409], [87, 82649], [91, 82889], [101, 83789], [105, 83989], [113, 84969], [119, 85269], [122, 85369], [129, 85889], [131, 86009], [134, 86109]]}, {"verse": 15, "start": 87059, "end": 97303, "text": "Juan dio testimonio de él, y clamó diciendo: Este es del que yo decía: El que viene tras mí, es superior a mí: porque existía antes que yo.", "words": [[0, 87059], [5, 87576], [9, 87896], [20, 88876], [23, 89036], [27, 89336], [29, 89756], [35, 90216], [45, 91144], [50, 91427], [53, 91707], [57, 91867], [61, 92047], [64, 92207], [71, 93049], [74, 93175], [78, 93315], [84, 93515], [89, 93755], [93, 94055], [96, 94575], [105, 94915], [107, 95175], [111, 95636], [118, 95854], [126, 96454], [132, 96734], [136, 96974]]}, {"verse": 16, "start": 97583, "end": 101567, "text": "Porque de su plenitud tomamos todos, y gracia por gracia.", "words": [[0, 97583], [7, 97807], [10, 97967], [13, 98127], [22, 98687], [30, 99267], [37, 99707], [39, 100092], [46, 100755], [50, 100897]]}, {"verse": 17, "start": 101917, "end": 108556, "text": "Porque la ley por Moisés fue dada: pero la gracia y la verdad por Jesucristo fue hecha.", "words": [[0, 101917], [7, 102158], [10, 102338], [14, 102578], [18, 102798], [25, 103298], [29, 103638], [35, 104433], [40, 104576], [43, 104756], [50, 105256], [52, 105336], [55, 105476], [62, 105736], [66, 106256], [77, 107116], [81, 107356]]}, {"verse": 18, "start": 108906, "end": 116894, "text": "A Dios nadie le vio jamás: el unigénito Hijo, que está en el seno del Padre, él le dio a conocer.", "words": [[0, 109243], [2, 109617], [7, 109990], [13, 110170], [16, 110450], [20, 110670], [27, 111712], [30, 111860], [40, 112330], [46, 112800], [50, 113040], [55, 113220], [58, 113360], [61, 113500], [66, 113800], [70, 113900], [77, 115000], [80, 115400], [83, 115760], [87, 116020], [89, 116160]]}, {"verse": 19, "start": 117244, "end": 127105, "text": "Y este es el testimonio de Juan, cuando los judíos enviaron de Jerusalén sacerdotes y levitas, que le preguntasen: ¿Tú, quién eres?", "words": [[0, 117244], [2, 117389], [7, 117669], [10, 117869], [13, 118009], [24, 118689], [27, 118789], [33, 119149], [40, 119789], [44, 120009], [51, 120469], [60, 120969], [63, 121189], [73, 121869], [84, 122749], [86, 122969], [95, 123509], [99, 123969], [102, 124434], [115, 125099], [120, 125239], [126, 125479]]}, {"verse": 20, "start": 127385, "end": 131467, "text": "Y confesó, y no negó; pero declaró: No soy yo el Cristo.", "words": [[0, 127385], [2, 127509], [11, 128229], [13, 128469], [16, 128669], [22, 129341], [27, 129505], [36, 130406], [39, 130532], [43, 130712], [46, 130872], [49, 130972]]}, {"verse": 21, "start": 131747, "end": 140260, "text": "Y le preguntaron: ¿Qué pues? ¿Eres tú Elías? Dijo: No soy. ¿Eres tú el profeta? Y respondió: No.", "words": [[0, 131747], [2, 131870], [5, 131970], [18, 133231], [23, 133331], [29, 134061], [35, 134294], [38, 134654], [45, 135504], [51, 136318], [54, 136522], [59, 137226], [65, 137445], [68, 137705], [71, 137845], [80, 138769], [82, 138916], [93, 139924]]}, {"verse": 22, "start": 140540, "end": 146802, "text": "Le dijeron: ¿Pues quién eres? para que demos respuesta a los que nos enviaron. ¿Qué dices de ti mismo?", "words": [[0, 140540], [3, 140641], [12, 141616], [18, 141745], [24, 141965], [30, 142595], [35, 142759], [39, 142899], [45, 143179], [55, 143719], [57, 144179], [61, 144319], [65, 144459], [69, 144619], [79, 145552], [84, 145654], [90, 145974], [93, 146154], [96, 146274]]}, {"verse": 23, "start": 147082, "end": 153648, "text": "Dijo: Yo soy la voz del que clama en el desierto: Enderezad el camino del Señor, como dijo Isaías profeta.", "words": [[0, 147082], [6, 147896], [9, 148012], [13, 148172], [16, 148312], [20, 148472], [24, 148612], [28, 148752], [34, 149112], [37, 149212], [40, 149292], [50, 150423], [60, 150693], [63, 150853], [70, 151113], [74, 151333], [81, 152173], [86, 152293], [91, 152573], [98, 153013]]}, {"verse": 24, "start": 153928, "end": 157162, "text": "Y los que habían sido enviados eran de los fariseos.", "words": [[0, 153928], [2, 154055], [6, 154215], [10, 154395], [17, 154675], [22, 155035], [31, 155655], [36, 156015], [39, 156235], [43, 156375]]}, {"verse": 25, "start": 157512, "end": 164898, "text": "Y le preguntaron, y le dijeron: ¿Por qué pues bautizas, si tú no eres el Cristo, ni Elías, ni el profeta?", "words": [[0, 157512], [2, 157660], [5, 157720], [18, 158500], [20, 158795], [23, 158875], [32, 159858], [37, 159983], [41, 160303], [46, 160603], [56, 161303], [59, 161683], [62, 161903], [65, 162043], [70, 162283], [73, 162423], [81, 163063], [84, 163543], [91, 164023], [94, 164123], [97, 164223]]}, {"verse": 26, "start": 165178, "end": 173718, "text": "Y Juan les respondió, diciendo: Yo bautizo con agua; pero en medio de vosotros está uno a quien vosotros no conocéis.", "words": [[0, 165178], [2, 165327], [7, 165627], [11, 166187], [22, 167287], [32, 168669], [35, 168807], [43, 169247], [47, 169487], [53, 170141], [58, 170287], [61, 170427], [67, 170627], [70, 170787], [79, 171267], [84, 171587], [88, 171867], [90, 172047], [96, 172187], [105, 172707], [108, 172967]]}, {"verse": 27, "start": 174068, "end": 181283, "text": "Este es el que ha de venir tras mí, el cual es superior a mí: del cual yo no soy digno de desatar la correa del zapato.", "words": [[0, 174068], [5, 174370], [8, 174610], [11, 174770], [15, 174910], [18, 175030], [21, 175110], [27, 175370], [32, 175610], [36, 176230], [39, 176330], [44, 176510], [47, 176710], [56, 177010], [58, 177270], [62, 177714], [66, 177893], [71, 178213], [74, 178513], [77, 178653], [81, 178893], [87, 179393], [90, 179453], [98, 179933], [101, 180173], [108, 180573], [112, 180733]]}, {"verse": 28, "start": 181563, "end": 187587, "text": "Estas cosas acontecieron en Betábara, del otro lado del Jordán, donde Juan bautizaba.", "words": [[0, 181563], [6, 181872], [12, 182132], [25, 183072], [28, 183602], [38, 184132], [42, 184232], [47, 184472], [52, 184792], [56, 185012], [64, 185872], [70, 186052], [75, 186472]]}, {"verse": 29, "start": 187937, "end": 195476, "text": "El siguiente día ve Juan a Jesús que venía a él, y dice: He aquí el Cordero de Dios, que quita el pecado del mundo.", "words": [[0, 187937], [3, 188097], [13, 188397], [17, 188797], [20, 188997], [25, 189277], [27, 189517], [33, 189817], [37, 190217], [43, 190677], [45, 190917], [49, 191197], [51, 191379], [57, 192257], [60, 192402], [65, 192682], [68, 192802], [76, 193222], [79, 193342], [85, 193942], [89, 194002], [95, 194322], [98, 194422], [105, 194782], [109, 194962]]}, {"verse": 30, "start": 195826, "end": 201823, "text": "Este es del que dije: Tras mí viene un varón, el cual es superior a mí: porque existía antes que yo.", "words": [[0, 195826], [5, 196084], [8, 196244], [12, 196404], [16, 196524], [22, 197210], [27, 197472], [30, 197552], [36, 197812], [39, 197932], [46, 198632], [49, 198712], [54, 198912], [57, 199132], [66, 199412], [68, 199652], [72, 200157], [79, 200374], [87, 200974], [93, 201254], [97, 201494]]}, {"verse": 31, "start": 202173, "end": 207616, "text": "Y yo no le conocía; pero para que fuese manifestado a Israel, por eso vine yo bautizando con agua.", "words": [[0, 202173], [2, 202280], [5, 202420], [8, 202540], [11, 202640], [20, 203563], [25, 203684], [30, 203904], [34, 204064], [40, 204364], [52, 205024], [54, 205104], [62, 205704], [66, 205744], [70, 205944], [75, 206184], [78, 206384], [89, 207004], [93, 207204]]}, {"verse": 32, "start": 207896, "end": 214855, "text": "Y Juan dio testimonio, diciendo: Vi al Espíritu que descendía del cielo como paloma, y reposó sobre él.", "words": [[0, 207896], [2, 208017], [7, 208317], [11, 208622], [23, 209602], [33, 210725], [36, 210879], [39, 211032], [48, 211632], [52, 211732], [62, 212292], [66, 212452], [72, 212812], [77, 213092], [85, 213612], [87, 213777], [94, 214237], [100, 214477]]}, {"verse": 33, "start": 215205, "end": 227127, "text": "Y yo no le conocía; pero el que me envió a bautizar con agua, aquel me dijo: Sobre quien veas descender el Espíritu, y que reposa sobre él, este es el que bautiza con Espíritu Santo.", "words": [[0, 215205], [2, 215312], [5, 215452], [8, 215572], [11, 215672], [20, 216595], [25, 216723], [28, 216823], [32, 216943], [35, 217063], [41, 217363], [43, 217463], [52, 217903], [56, 218123], [62, 218723], [68, 219023], [71, 219123], [77, 219813], [83, 220096], [89, 220376], [94, 220856], [104, 221396], [107, 221536], [117, 222216], [119, 222596], [123, 222736], [130, 223216], [136, 223536], [140, 224136], [145, 224456], [148, 224776], [151, 225016], [155, 225156], [163, 225716], [167, 225936], [176, 226516]]}, {"verse": 34, "start": 227477, "end": 231234, "text": "Y yo le vi, y he dado testimonio que este es el Hijo de Dios.", "words": [[0, 227477], [2, 227594], [5, 227754], [8, 227894], [12, 228094], [14, 228654], [17, 228754], [22, 228954], [33, 229734], [37, 229874], [42, 230174], [45, 230414], [48, 230554], [53, 230774], [56, 230914]]}, {"verse": 35, "start": 231514, "end": 236268, "text": "El siguiente día otra vez estaba Juan, y dos de sus discípulos.", "words": [[0, 231514], [3, 231693], [13, 232073], [17, 232573], [22, 232873], [26, 233213], [33, 233453], [39, 233933], [41, 234298], [45, 234618], [48, 235038], [52, 235258]]}, {"verse": 36, "start": 236268, "end": 241727, "text": "Y mirando a Jesús que andaba por allí, dijo: He aquí el Cordero de Dios.", "words": [[0, 236268], [2, 236508], [10, 236888], [12, 237028], [18, 237288], [22, 237608], [29, 237948], [33, 238208], [39, 239128], [45, 239926], [48, 240068], [53, 240368], [56, 240628], [64, 241048], [67, 241168]]}, {"verse": 37, "start": 242007, "end": 245894, "text": "Y le oyeron los dos discípulos hablar, y siguieron a Jesús.", "words": [[0, 242007], [2, 242129], [5, 242249], [12, 242669], [16, 242849], [20, 243069], [31, 243749], [39, 244129], [41, 244589], [51, 245129], [53, 245249]]}, {"verse": 38, "start": 246244, "end": 256639, "text": "Y volviéndose Jesús, y viéndolos seguirle, les dice: ¿Qué buscáis? Y ellos le dijeron: Rabí (que traducido quiere decir Maestro) ¿dónde te hospedas?", "words": [[0, 246244], [2, 246332], [14, 246912], [21, 247632], [23, 247902], [33, 248172], [43, 248642], [47, 249112], [53, 249917], [58, 250019], [67, 251136], [69, 251593], [75, 251813], [78, 252033], [87, 253192], [92, 253403], [97, 253476], [107, 254056], [114, 254276], [120, 254616], [129, 255596], [136, 255836], [139, 255976]]}, {"verse": 39, "start": 256919, "end": 265601, "text": "Les dice: Venid y ved. Vinieron, y vieron donde moraba, y se quedaron con él aquel día: porque era como la hora de las diez.", "words": [[0, 256919], [4, 257108], [10, 258017], [16, 258524], [18, 258764], [23, 259444], [33, 259970], [35, 260230], [42, 260530], [48, 260750], [56, 261370], [58, 261570], [61, 261710], [70, 262150], [74, 262350], [77, 262510], [83, 262810], [88, 263467], [95, 263711], [99, 263931], [104, 264171], [107, 264391], [112, 264611], [115, 264771], [119, 265186]]}, {"verse": 40, "start": 265951, "end": 272889, "text": "Era Andrés, hermano de Simón Pedro, uno de los dos que habían oído de Juan, y le habían seguido.", "words": [[0, 265951], [4, 266215], [12, 266855], [20, 267535], [23, 267615], [29, 268155], [36, 269140], [40, 269480], [43, 269640], [47, 269820], [51, 270060], [55, 270280], [62, 270560], [67, 270900], [70, 271080], [76, 271360], [78, 271860], [81, 271980], [88, 272220]]}, {"verse": 41, "start": 273239, "end": 279672, "text": "Este halló primero a su hermano Simón, y le dijo: Hemos hallado al Mesías (que traducido es, el Cristo).", "words": [[0, 273239], [5, 273485], [11, 273745], [19, 274045], [21, 274245], [24, 274345], [32, 274785], [39, 275185], [41, 275385], [44, 275505], [50, 276282], [56, 276483], [64, 276883], [67, 277003], [74, 277979], [79, 278063], [89, 278723], [93, 278843], [96, 279003]]}, {"verse": 42, "start": 280022, "end": 289969, "text": "Y le trajo a Jesús. Y mirándole Jesús, dijo: Tú eres Simón, hijo de Jonás: tú serás llamado Cefas (que quiere decir, Piedra).", "words": [[0, 280022], [2, 280187], [5, 280387], [11, 280587], [13, 280667], [20, 281495], [22, 281612], [32, 282092], [39, 282492], [45, 283576], [48, 283721], [53, 283961], [60, 285061], [65, 285261], [68, 285441], [75, 286291], [78, 286373], [84, 286713], [92, 287079], [98, 287666], [103, 288086], [110, 288466], [117, 288906]]}, {"verse": 43, "start": 290319, "end": 296890, "text": "El siguiente día quiso Jesús ir a Galilea, y halla a Felipe, al cual dijo: Sígueme.", "words": [[0, 290368], [3, 290448], [13, 290808], [17, 291268], [23, 291808], [29, 292268], [32, 292688], [34, 292788], [43, 293748], [45, 294028], [51, 294308], [53, 294508], [61, 295168], [64, 295268], [69, 295448], [75, 296274]]}, {"verse": 44, "start": 297240, "end": 301136, "text": "Y era Felipe de Betsaida, la ciudad de Andrés y de Pedro.", "words": [[0, 297240], [2, 297337], [6, 297477], [13, 297817], [16, 298497], [26, 299177], [29, 299257], [36, 299537], [39, 299837], [46, 300257], [48, 300477], [51, 300577]]}, {"verse": 45, "start": 301486, "end": 310511, "text": "Felipe halló a Natanael, y le dice: Hemos hallado a aquel de quien escribió Moisés en la ley, y los profetas: a Jesús, el hijo de José, de Nazaret.", "words": [[0, 301486], [7, 301876], [13, 302298], [15, 302720], [25, 303142], [27, 303564], [30, 303986], [36, 304608], [42, 304775], [50, 304975], [52, 305175], [58, 305435], [61, 305535], [67, 305655], [76, 306115], [83, 306415], [86, 306595], [89, 306695], [94, 306915], [96, 307295], [100, 307415], [110, 308348], [112, 308446], [119, 309046], [122, 309126], [127, 309326], [130, 309406], [136, 309726], [139, 309906]]}, {"verse": 46, "start": 310791, "end": 317199, "text": "Y le dijo Natanael: ¿De Nazaret puede haber algo de bueno? Le dice Felipe: Ven y ve.", "words": [[0, 310791], [2, 310928], [5, 311028], [10, 311811], [20, 312795], [24, 312941], [32, 313501], [38, 313741], [44, 313961], [49, 314221], [52, 314381], [59, 315164], [62, 315313], [67, 315533], [75, 316635], [79, 316837], [81, 317040]]}, {"verse": 47, "start": 317479, "end": 325208, "text": "Jesús vio venir a sí a Natanael, y dijo de él: He aquí un verdadero israelita, en el cual no hay engaño.", "words": [[0, 317479], [6, 317807], [10, 318287], [16, 318967], [18, 319277], [21, 319587], [23, 319767], [33, 319947], [35, 320227], [40, 320507], [43, 320707], [47, 321252], [50, 321572], [55, 321852], [58, 322012], [68, 322552], [79, 323672], [82, 323792], [85, 323912], [90, 324092], [93, 324352], [97, 324532]]}, {"verse": 48, "start": 325558, "end": 334846, "text": "Le dice Natanael: ¿De dónde me conoces? Respondió Jesús, y le dijo: Antes que Felipe te llamara, cuando estabas debajo de la higuera te vi.", "words": [[0, 325558], [3, 325981], [8, 326436], [18, 327064], [22, 327225], [28, 327365], [31, 327605], [40, 328890], [50, 329180], [57, 329480], [59, 329740], [62, 329860], [68, 330589], [74, 331069], [78, 331229], [85, 331549], [88, 331829], [97, 332309], [104, 332809], [112, 333269], [119, 333629], [122, 333809], [125, 333929], [133, 334255], [136, 334582]]}, {"verse": 49, "start": 335196, "end": 340803, "text": "Respondió Natanael, y le dijo: Rabí, tú eres el Hijo de Dios; tú eres el Rey de Israel.", "words": [[0, 335196], [10, 335824], [20, 336484], [22, 336684], [25, 336764], [31, 337687], [37, 337907], [40, 338007], [45, 338227], [48, 338407], [53, 338587], [56, 338707], [62, 339446], [65, 339588], [70, 339768], [73, 339988], [77, 340148], [80, 340268]]}, {"verse": 50, "start": 341083, "end": 347965, "text": "Respondió Jesús y le dijo: ¿Porque te dije, te vi debajo de la higuera, crees? cosas mayores que estas verás.", "words": [[0, 341083], [10, 341587], [16, 341907], [18, 342167], [21, 342287], [27, 342921], [35, 343127], [38, 343347], [44, 343587], [47, 343827], [50, 344067], [57, 344507], [60, 344647], [63, 344767], [72, 345347], [79, 346171], [85, 346375], [93, 346935], [97, 347155], [103, 347375]]}, {"verse": 51, "start": 347965, "end": 359989, "text": "Y le dice: De cierto, de cierto os digo: De aquí en adelante veréis el cielo abierto, y los ángeles de Dios que suben y descienden sobre el Hijo del hombre.", "words": [[0, 348030], [2, 348095], [5, 348215], [11, 349846], [14, 350058], [22, 350270], [25, 350482], [32, 350694], [35, 351034], [41, 351871], [44, 352039], [49, 352359], [52, 352579], [61, 352999], [68, 353539], [71, 353739], [77, 354079], [86, 354799], [88, 354964], [92, 355144], [100, 355684], [103, 355904], [108, 356244], [112, 356744], [118, 357364], [120, 357584], [131, 358244], [137, 358664], [140, 358944], [145, 359204], [149, 359404]]}]}