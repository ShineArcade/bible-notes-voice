 62047], [12, 62207], [16, 62487], [19, 62687], [26, 63227], [31, 63907], [35, 64067], [38, 64247], [46, 65007], [49, 65347], [52, 65507], [59, 65967], [62, 66367], [67, 66667], [71, 66947], [76, 67705], [78, 67869], [81, 67989], [90, 68669], [93, 68809], [100, 69109], [102, 69309], [105, 69429], [111, 69809], [114, 69949], [117, 70089], [127, 70729], [130, 70889], [137, 71589], [142, 71949], [148, 72429], [152, 72689], [160, 73189], [164, 73389]]}, {"verse": 9, "start": 74393, "end": 78959, "text": "Y llamó Jehová Dios al hombre, y le dijo: ¿Dónde estás tú?", "words": [[0, 74393], [2, 74503], [8, 74890], [15, 75276], [20, 75663], [23, 75923], [31, 76283], [33, 76783], [36, 76903], [42, 77651], [49, 77931], [55, 78171]]}, {"verse": 10, "start": 79239, "end": 84991, "text": "Y él respondió: Oí tu voz en el huerto, y tuve miedo, porque estaba desnudo; y me escondí.", "words": [[0, 79239], [2, 79421], [5, 79561], [16, 80556], [19, 80882], [22, 80982], [26, 81262], [29, 81542], [32, 81642], [40, 82002], [42, 82202], [47, 82442], [54, 82762], [61, 83062], [68, 83402], [77, 84272], [79, 84378], [82, 84438]]}, {"verse": 11, "start": 85271, "end": 91983, "text": "Y le dijo: ¿Quién te enseñó que estabas desnudo? ¿Has comido del árbol de que yo te mandé no comieses?", "words": [[0, 85271], [2, 85392], [5, 85492], [11, 86207], [18, 86491], [21, 86571], [28, 87071], [32, 87211], [40, 87651], [49, 88811], [54, 89030], [61, 89430], [65, 89670], [71, 90030], [74, 90190], [78, 90290], [81, 90450], [84, 90550], [90, 90990], [93, 91070]]}, {"verse": 12, "start": 92263, "end": 97662, "text": "Y el hombre respondió: La mujer que me diste por compañera me dio del árbol, y yo comí.", "words": [[0, 92263], [2, 92405], [5, 92505], [12, 92805], [23, 94062], [26, 94161], [32, 94401], [36, 94621], [39, 94741], [45, 95081], [49, 95241], [59, 95861], [62, 96021], [66, 96161], [70, 96301], [77, 96741], [79, 96981], [82, 97121]]}, {"verse": 13, "start": 97942, "end": 107071, "text": "Entonces Jehová Dios dijo a la mujer: ¿Qué es lo que has hecho? Y dijo la mujer: La serpiente me engañó, y comí.", "words": [[0, 97942], [9, 98466], [16, 99426], [21, 99746], [26, 100426], [28, 100586], [31, 100666], [38, 101445], [43, 101602], [46, 101882], [49, 102002], [53, 102142], [57, 102322], [64, 103384], [66, 103502], [71, 103782], [74, 103942], [81, 104709], [84, 104856], [94, 105456], [97, 105636], [105, 106276], [107, 106556]]}, {"verse": 14, "start": 107351, "end": 122259, "text": "Y Jehová Dios dijo a la serpiente: Por cuanto esto hiciste, maldita serás entre todas las bestias y entre todos los animales del campo; sobre tu pecho andarás, y polvo comerás todos los días de tu vida:", "words": [[0, 107351], [2, 107519], [9, 108059], [14, 108299], [19, 109159], [21, 109339], [24, 109399], [35, 110521], [39, 110658], [46, 110898], [51, 111318], [60, 112258], [68, 112778], [74, 113298], [80, 113658], [86, 113958], [90, 114218], [98, 114798], [100, 115058], [106, 115258], [112, 115598], [116, 115838], [125, 116218], [129, 116498], [136, 117581], [142, 117804], [145, 117984], [151, 118404], [160, 119004], [162, 119364], [168, 119804], [176, 120324], [182, 120584], [186, 120944], [191, 121204], [194, 121424], [197, 121524]]}, {"verse": 15, "start": 122609, "end": 132463, "text": "Y enemistad pondré entre ti y la mujer, y entre tu simiente y la simiente suya; esta te herirá en la cabeza, y tú le herirás en el talón.", "words": [[0, 122609], [2, 122769], [12, 123409], [19, 123869], [25, 124129], [28, 124469], [30, 124709], [33, 124809], [40, 125549], [42, 125729], [48, 125929], [51, 126109], [60, 126709], [62, 127029], [65, 127149], [74, 127649], [80, 128712], [85, 129013], [88, 129273], [95, 129653], [98, 129753], [101, 129833], [109, 130293], [111, 130713], [114, 130853], [117, 131053], [125, 131453], [128, 131613], [131, 131733]]}, {"verse": 16, "start": 132743, "end": 143551, "text": "A la mujer dijo: Multiplicaré en gran manera tus dolores y tus embarazos; con dolor darás a luz a tus hijos; y a tu marido será tu deseo, y él te dominará.", "words": [[0, 132743], [2, 132852], [5, 132952], [11, 133232], [17, 134215], [30, 134954], [33, 135094], [38, 135254], [45, 135654], [49, 135874], [57, 136454], [59, 136654], [63, 136794], [74, 137987], [78, 138108], [84, 138488], [90, 138988], [92, 139068], [96, 139168], [98, 139328], [102, 139468], [109, 140372], [111, 140475], [113, 140515], [116, 140615], [123, 141015], [128, 141255], [131, 141435], [138, 142295], [140, 142375], [143, 142495], [146, 142655]]}, {"verse": 17, "start": 143831, "end": 158492, "text": "Y al hombre dijo: Por cuanto obedeciste a la voz de tu mujer, y comiste del árbol de que te mandé diciendo, No comerás de él; maldita será la tierra por tu causa; con dolor comerás de ella todos los días de tu vida;", "words": [[0, 143831], [2, 143952], [5, 144092], [12, 144412], [18, 145314], [22, 145453], [29, 146063], [40, 146673], [42, 146813], [45, 146893], [49, 147153], [52, 147293], [55, 147413], [62, 147813], [64, 148008], [72, 148468], [76, 148728], [82, 149068], [85, 149188], [89, 149288], [92, 149428], [98, 149808], [108, 150648], [111, 150908], [119, 151448], [122, 151608], [126, 152401], [134, 152900], [139, 153160], [142, 153360], [149, 153640], [153, 153940], [156, 154080], [163, 155124], [167, 155300], [173, 155640], [181, 156240], [184, 156400], [189, 156600], [195, 156880], [199, 157200], [204, 157480], [207, 157680], [210, 157800]]}, {"verse": 18, "start": 158842, "end": 163124, "text": "Espinos y cardos te producirá, y comerás hierba del campo;", "words": [[0, 158842], [8, 159360], [10, 159540], [17, 160040], [20, 160140], [31, 160860], [33, 161240], [41, 161780], [48, 162200], [52, 162360]]}, {"verse": 19, "start": 163474, "end": 173314, "text": "En el sudor de tu rostro comerás el pan hasta que vuelvas a la tierra; porque de ella fuiste tomado: pues polvo eres, y al polvo volverás.", "words": [[0, 163474], [3, 163677], [6, 163917], [12, 164157], [15, 164297], [