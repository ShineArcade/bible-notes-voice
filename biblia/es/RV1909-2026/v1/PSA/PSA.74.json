{"book": "PSA", "chapter": 74, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 158578, "verses": [{"verse": 1, "start": 300, "end": 9395, "text": "Masquil de Asaf. ¿POR qué, oh Dios, nos has desechado para siempre? ¿por qué ha humeado tu furor contra las ovejas de tu prado?", "words": [[0, 300], [8, 832], [11, 972], [17, 1760], [22, 2042], [27, 2462], [30, 2562], [36, 3302], [40, 3472], [44, 3642], [54, 4262], [59, 4502], [68, 5510], [73, 5632], [77, 5912], [80, 6172], [88, 6712], [91, 6892], [97, 7412], [104, 7752], [108, 8132], [115, 8512], [118, 8652], [121, 8792]]}, {"verse": 2, "start": 9745, "end": 20096, "text": "Acuérdate de tu congregación, que adquiriste de antiguo, cuando redimiste la vara de tu herencia; este monte de Sion, donde has habitado.", "words": [[0, 9745], [10, 10334], [13, 10594], [16, 10774], [30, 11674], [34, 12374], [45, 13354], [48, 13574], [57, 14254], [64, 14474], [74, 15534], [77, 15714], [82, 15934], [85, 16114], [88, 16294], [98, 17249], [103, 17574], [109, 17899], [112, 18239], [118, 18579], [124, 19099], [128, 19299]]}, {"verse": 3, "start": 20446, "end": 27099, "text": "Levanta tus pies a los asolamientos eternos: a todo enemigo que ha hecho mal en el santuario.", "words": [[0, 20446], [8, 20997], [12, 21177], [17, 21437], [19, 21897], [23, 22017], [36, 22697], [45, 23805], [47, 23958], [52, 24178], [60, 24818], [64, 25018], [67, 25178], [73, 25398], [77, 25738], [80, 26018], [83, 26584]]}, {"verse": 4, "start": 27449, "end": 33852, "text": "Tus enemigos han bramado en medio de tus sinagogas: han puesto sus insignias por señas.", "words": [[0, 27449], [4, 27553], [13, 28133], [17, 28353], [25, 28873], [28, 29013], [34, 29393], [37, 29613], [41, 29773], [52, 31163], [56, 31423], [63, 31683], [67, 32063], [77, 32883], [81, 33063]]}, {"verse": 5, "start": 34202, "end": 39102, "text": "Cualquiera se hacía famoso según que había levantado el hacha sobre los gruesos maderos.", "words": [[0, 34202], [11, 34728], [14, 34928], [20, 35228], [27, 35628], [33, 36068], [37, 36308], [43, 36508], [53, 37128], [56, 37268], [62, 37508], [68, 37808], [72, 38028], [80, 38448]]}, {"verse": 6, "start": 39452, "end": 44107, "text": "Y ahora con hachas y martillos han quebrado todas sus entalladuras.", "words": [[0, 39452], [2, 39558], [8, 39818], [12, 40118], [19, 40558], [21, 40738], [31, 41278], [35, 41758], [44, 42298], [50, 42578], [54, 42918]]}, {"verse": 7, "start": 44457, "end": 50978, "text": "Han puesto a fuego tus santuarios, han profanado el tabernáculo de tu nombre echándolo a tierra.", "words": [[0, 44457], [4, 44640], [11, 44894], [13, 45148], [19, 45400], [23, 45580], [35, 46700], [39, 47101], [49, 47860], [52, 48330], [64, 48800], [67, 49020], [70, 49160], [77, 49520], [87, 50200], [89, 50340]]}, {"verse": 8, "start": 51328, "end": 58648, "text": "Dijeron en su corazón: Destruyámoslos de una vez; han quemado todas las sinagogas de Dios en la tierra.", "words": [[0, 51328], [8, 51831], [11, 51951], [14, 52071], [23, 53455], [38, 53915], [41, 54095], [45, 54235], [50, 54991], [54, 55195], [62, 55735], [68, 56055], [72, 56415], [82, 57175], [85, 57315], [90, 57595], [93, 57855], [96, 57995]]}, {"verse": 9, "start": 58998, "end": 65467, "text": "No vemos ya nuestras señales: no hay más profeta; ni con nosotros hay quien sepa hasta cuándo.", "words": [[0, 58998], [3, 59144], [9, 59384], [12, 59684], [21, 59924], [30, 61142], [33, 61346], [37, 61712], [41, 62079], [50, 62623], [53, 62771], [57, 62991], [66, 63530], [70, 63811], [76, 64050], [81, 64530], [87, 64750]]}, {"verse": 10, "start": 65817, "end": 73357, "text": "¿Hasta cuándo, oh Dios, el angustiador nos afrentará? ¿ha de blasfemar el enemigo perpetuamente tu nombre?", "words": [[0, 65817], [7, 66038], [15, 66718], [18, 66858], [24, 67678], [27, 67798], [39, 68438], [43, 68658], [54, 69816], [58, 70156], [61, 70256], [71, 71016], [74, 71176], [82, 71616], [96, 72556], [99, 72776]]}, {"verse": 11, "start": 73707, "end": 79248, "text": "¿Por qué retraes tu mano, y tu diestra? ¿ por qué la escondes dentro de tu seno?", "words": [[0, 73707], [5, 73829], [9, 74179], [17, 74529], [20, 74769], [26, 75049], [28, 75249], [31, 75349], [40, 76384], [42, 76387], [46, 76727], [50, 77062], [53, 77398], [62, 77733], [69, 78293], [72, 78533], [75, 78693]]}, {"verse": 12, "start": 79598, "end": 85488, "text": "Pero Dios es mi rey ya de antiguo; el que obra salvación en medio de la tierra.", "words": [[0, 79598], [5, 79722], [10, 80002], [13, 80282], [16, 80622], [20, 81002], [23, 81142], [26, 81282], [35, 82197], [38, 82322], [42, 82482], [47, 82742], [57, 83562], [60, 84102], [66, 84462], [69, 84662], [72, 84782]]}, {"verse": 13, "start": 85838, "end": 91994, "text": "Tú hendiste el mar con tu fortaleza: quebrantaste cabezas de ballenas en las aguas.", "words": [[0, 85838], [3, 86252], [12, 86702], [15, 87042], [19, 87382], [23, 87902], [26, 88082], [37, 89674], [50, 90094], [58, 90514], [61, 90614], [70, 90994], [73, 91194], [77, 91334]]}, {"verse": 14, "start": 92344, "end": 98182, "text": "Tú magullaste las cabezas del leviathán; lo diste por comida al pueblo de los desiertos.", "words": [[0, 92344], [3, 92729], [14, 93149], [18, 93369], [26, 93929], [30, 94465], [41, 95178], [44, 95322], [50, 95742], [54, 95942], [61, 96382], [64, 96602], [71, 96922], [74, 97162], [78, 97282]]}, {"verse": 15, "start": 98532, "end": 102937, "text": "Tú abriste fuente y río; tú secaste ríos impetuosos.", "words": [[0, 98532], [3, 98654], [11, 99054], [18, 99614], [20, 99914], [25, 100582], [28, 100686], [36, 101456], [41, 102227]]}, {"verse": 16, "start": 103287, "end": 108458, "text": "Tuyo es el día, tuya también es la noche: tú preparaste la luna y el sol.", "words": [[0, 103287], [5, 103667], [8, 103787], [11, 103927], [16, 104567], [21, 104847], [29, 105187], [32, 105387], [35, 105547], [42, 106342], [45, 106488], [56, 107148], [59, 107328], [64, 107668], [66, 107828], [69, 107948]]}, {"verse": 17, "start": 108808, "end": 114879, "text": "Tú estableciste todos los términos de la tierra: el verano y el invierno tú los formaste.", "words": [[0, 108808], [3, 108931], [16, 109711], [22, 110071], [26, 110371], [35, 110911], [38, 110991], [41, 111071], [49, 111967], [52, 112250], [59, 112570], [61, 112750], [64, 112870], [73, 113390], [76, 113750], [80, 113950]]}, {"verse": 18, "start": 115229, "end": 123244, "text": "Acuérdate de esto: que el enemigo ha dicho afrentas a Jehová, y que el pueblo insensato ha blasfemado tu nombre.", "words": [[0, 115229], [10, 115969], [13, 116249], [19, 117040], [23, 117164], [26, 117304], [34, 117804], [37, 117924], [43, 118324], [52, 118724], [54, 118824], [62, 119584], [64, 119764], [68, 119924], [71, 120064], [78, 120384], [88, 121044], [91, 121704], [102, 122364], [105, 122544]]}, {"verse": 19, "start": 123594, "end": 130469, "text": "No entregues a las bestias el alma de tu tórtola: y no olvides para siempre la congregación de tus afligidos.", "words": [[0, 123594], [3, 123799], [13, 124539], [15, 124639], [19, 124759], [27, 125239], [30, 125459], [35, 125719], [38, 125919], [41, 126039], [50, 127068], [52, 127210], [55, 127370], [63, 127850], [68, 128110], [76, 128450], [79, 128750], [92, 129430], [95, 129590], [99, 129730]]}, {"verse": 20, "start": 130819, "end": 136417, "text": "Mira al pacto: porque las tinieblas de la tierra llenas están de habitaciones de violencia.", "words": [[0, 130819], [5, 131107], [8, 131467], [15, 132353], [22, 132520], [26, 132740], [36, 133320], [39, 133400], [42, 133500], [49, 133780], [56, 134300], [62, 134620], [65, 134800], [78, 135380], [81, 135600]]}, {"verse": 21, "start": 136767, "end": 143023, "text": "No vuelva avergonzado el abatido: el afligido y el necesitado alabarán tu nombre.", "words": [[0, 136767], [3, 136955], [10, 137535], [22, 138495], [25, 138755], [34, 139666], [37, 139814], [46, 140454], [48, 140594], [51, 140694], [62, 141474], [71, 142134], [74, 142334]]}, {"verse": 22, "start": 143373, "end": 150528, "text": "Levántate, oh Dios, defiende tu causa: acuérdate de cómo el insensato te injuria cada día.", "words": [[0, 143373], [11, 143800], [14, 144260], [20, 144560], [29, 145560], [32, 145760], [39, 146620], [49, 147203], [52, 147483], [57, 147843], [60, 148393], [70, 148943], [73, 149163], [81, 149723], [86, 149943]]}, {"verse": 23, "start": 150878, "end": 158178, "text": "No olvides las voces de tus enemigos: el alboroto de los que se levantan contra ti sube continuamente.", "words": [[0, 150878], [3, 151064], [11, 151604], [15, 151844], [21, 152264], [24, 152444], [28, 152584], [38, 153751], [41, 153896], [50, 154496], [53, 154696], [57, 154816], [61, 154956], [64, 155096], [73, 155596], [80, 155956], [83, 156216], [88, 156936]]}]}