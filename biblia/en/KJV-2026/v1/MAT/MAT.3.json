{"book": "MAT", "chapter": 3, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 124581, "verses": [{"verse": 1, "start": 300, "end": 4784, "text": "In those days came John the Baptist, preaching in the wilderness of Judaea,", "words": [[0, 300], [3, 426], [9, 626], [14, 947], [19, 1266], [24, 1586], [28, 1766], [37, 2626], [47, 3086], [50, 3346], [54, 3446], [65, 3766], [68, 4276]]}, {"verse": 2, "start": 5134, "end": 8761, "text": "And saying, Repent: for the kingdom of heaven is at hand.", "words": [[0, 5134], [4, 5280], [12, 6030], [20, 6919], [24, 7010], [28, 7110], [36, 7390], [39, 7610], [46, 7850], [49, 8050], [52, 8210]]}, {"verse": 3, "start": 9041, "end": 17746, "text": "For this is he that was spoken of by the prophet Esaias, saying, The voice of one crying in the wilderness, Prepare the way of the Lord, make his paths straight.", "words": [[0, 9041], [4, 9133], [9, 9333], [12, 9473], [15, 9713], [20, 9913], [24, 10033], [31, 10353], [34, 10613], [37, 10833], [41, 10973], [49, 11453], [57, 11933], [65, 12622], [69, 12721], [75, 12961], [78, 13201], [82, 13421], [89, 13801], [92, 13961], [96, 14061], [108, 14861], [116, 15181], [120, 15441], [124, 15601], [127, 15721], [131, 15821], [137, 16481], [142, 16641], [146, 16861], [152, 17081]]}, {"verse": 4, "start": 18026, "end": 26159, "text": "And the same John had his clothing of camel’s hair, and a leathern girdle about his loins; and his food was locusts and wild honey.", "words": [[0, 18026], [4, 18160], [8, 18280], [13, 18560], [18, 18900], [22, 19220], [26, 19360], [35, 19760], [38, 20020], [46, 20560], [52, 21200], [56, 21420], [58, 21680], [67, 21940], [74, 22360], [80, 22580], [84, 22800], [91, 23692], [95, 23809], [99, 23929], [104, 24249], [108, 24449], [116, 25169], [120, 25329], [125, 25629]]}, {"verse": 5, "start": 26509, "end": 32678, "text": "Then went out to him Jerusalem, and all Judaea, and all the region round about Jordan,", "words": [[0, 26509], [5, 26772], [10, 27012], [14, 27212], [17, 27432], [21, 27592], [32, 28692], [36, 28992], [40, 29562], [48, 30132], [52, 30392], [56, 30632], [60, 30812], [67, 31152], [73, 31472], [79, 31812]]}, {"verse": 6, "start": 32678, "end": 36461, "text": "And were baptized of him in Jordan, confessing their sins.", "words": [[0, 32678], [4, 32838], [9, 32998], [18, 33418], [21, 33858], [25, 34008], [28, 34158], [36, 34858], [47, 35558], [53, 35738]]}, {"verse": 7, "start": 36811, "end": 46600, "text": "¶ But when he saw many of the Pharisees and Sadducees come to his baptism, he said to them, O generation of vipers, who has warned you to flee from the wrath to come?", "words": [[2, 36811], [6, 36913], [11, 37073], [14, 37233], [18, 37493], [23, 37813], [26, 38013], [30, 38133], [40, 38873], [44, 38993], [54, 39753], [59, 39953], [62, 40133], [66, 40293], [75, 41333], [78, 41513], [83, 41773], [86, 41953], [92, 42633], [94, 42743], [105, 43223], [108, 43503], [116, 44043], [120, 44343], [124, 44463], [131, 44763], [135, 44943], [138, 45083], [143, 45363], [148, 45603], [152, 45743], [158, 45943], [161, 46163]]}, {"verse": 8, "start": 46950, "end": 49567, "text": "Bring forth therefore fruits meet for repentance:", "words": [[0, 46950], [6, 47113], [12, 47513], [22, 48013], [29, 48253], [34, 48493], [38, 48693]]}, {"verse": 9, "start": 49917, "end": 58856, "text": "And think not to say within yourselves, We have Abraham to our father: for I say to you, that God is able of these stones to raise up children to Abraham.", "words": [[0, 49917], [4, 50059], [10, 50219], [14, 50439], [17, 50619], [21, 50879], [28, 51119], [40, 52019], [43, 52259], [48, 52459], [56, 52859], [59, 53159], [63, 53279], [71, 54003], [75, 54108], [77, 54308], [81, 54528], [84, 54728], [89, 54948], [94, 55428], [98, 55708], [101, 55928], [106, 56248], [109, 56428], [115, 56608], [122, 57008], [125, 57228], [131, 57468], [134, 57628], [143, 57968], [146, 58188]]}, {"verse": 10, "start": 59206, "end": 67553, "text":