{"book": "GEN", "chapter": 17, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 239066, "verses": [{"verse": 1, "start": 300, "end": 12005, "text": "Y siendo Abram de edad de noventa y nueve años, le apareció Jehová, y le dijo: Yo soy el Dios Todopoderoso; anda delante de mí, y sé perfecto.", "words": [[0, 300], [2, 432], [9, 892], [15, 1352], [18, 1812], [23, 2212], [26, 2412], [34, 2612], [36, 2812], [42, 3012], [48, 3872], [51, 4072], [60, 4732], [68, 5512], [70, 5672], [73, 5772], [79, 6493], [82, 6676], [86, 6916], [89, 7136], [94, 7826], [108, 9000], [113, 9438], [121, 9898], [124, 10058], [128, 10278], [130, 10698], [133, 10878]]}, {"verse": 2, "start": 12355, "end": 16852, "text": "Y pondré mi pacto entre mí y ti, y te multiplicaré mucho en gran manera.", "words": [[0, 12355], [2, 12458], [9, 12858], [12, 12978], [18, 13478], [24, 13678], [27, 13938], [29, 14158], [33, 14338], [35, 14523], [38, 14623], [51, 15303], [57, 15603], [60, 15803], [65, 15963]]}, {"verse": 3, "start": 17132, "end": 22644, "text": "Entonces Abram cayó sobre su rostro, y Dios habló con él diciendo:", "words": [[0, 17132], [9, 17590], [15, 18390], [20, 18910], [26, 19170], [29, 19410], [37, 20570], [39, 20790], [44, 21030], [50, 21510], [54, 21650], [57, 21830]]}, {"verse": 4, "start": 22844, "end": 27736, "text": "Yo, he aquí mi pacto contigo: Serás padre de una multitud de naciones:", "words": [[0, 22844], [4, 22973], [7, 23113], [12, 23313], [15, 23453], [21, 23893], [30, 24980], [36, 25342], [42, 25702], [45, 25902], [49, 26062], [58, 26702], [61, 26842]]}, {"verse": 5, "start": 28086, "end": 36084, "text": "Y no se llamará más tu nombre Abram, sino que será tu nombre Abraham, porque te he puesto por padre de muchedumbre de gentes.", "words": [[0, 28086], [2, 28190], [5, 28330], [8, 28510], [16, 28910], [20, 29170], [23, 29350], [30, 29690], [37, 30530], [42, 30790], [46, 31010], [51, 31250], [54, 31490], [61, 32120], [70, 32750], [77, 33070], [