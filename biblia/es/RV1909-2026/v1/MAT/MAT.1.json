{"book": "MAT", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 214550, "verses": [{"verse": 1, "start": 300, "end": 5690, "text": "Libro de la genealogía de Jesucristo, hijo de David, hijo de Abraham.", "words": [[0, 300], [6, 801], [9, 901], [12, 1041], [23, 1821], [26, 1941], [38, 3261], [43, 3561], [46, 3721], [53, 4481], [58, 4761], [61, 4921]]}, {"verse": 2, "start": 6140, "end": 14221, "text": "Abraham engendró a Isaac: e Isaac engendró a Jacob: y Jacob engendró a Judas y a sus hermanos:", "words": [[0, 6140], [8, 6560], [17, 7380], [19, 7500], [26, 8715], [28, 9021], [34, 9328], [43, 9908], [45, 10362], [52, 11041], [54, 11341], [60, 11641], [69, 12481], [71, 12621], [77, 12841], [79, 13201], [81, 13321], [85, 13441]]}, {"verse": 3, "start": 14671, "end": 23354, "text": "Y Judas engendró de Tamar a Fares y a Zara: y Fares engendró a Esrom: y Esrom engendró a Aram:", "words": [[0, 14671], [2, 14817], [8, 15137], [17, 16037], [20, 16157], [26, 16450], [28, 16744], [34, 17037], [36, 17318], [38, 17598], [44, 18123], [46, 18418], [52, 18934], [61, 19450], [63, 19966], [70, 20732], [72, 21131], [78, 21531], [87, 22391], [89, 22591]]}, {"verse": 4, "start": 23804, "end": 32107, "text": "Y Aram engendró a Aminadab: y Aminadab engendró a Naassón: y Naassón engendró a Salmón:", "words": [[0, 24000], [2, 24220], [7, 24440], [16, 25420], [18, 26030], [28, 26941], [30, 27034], [39, 27128], [48, 27221], [50, 28362], [59, 29802], [61, 30146], [69, 30526], [78, 31206], [80, 31426]]}, {"verse": 5, "start": 32557, "end": 40674, "text": "Y Salmón engendró de Rahab a Booz, y Booz engendró de Ruth a Obed: y Obed engendró a Isaí:", "words": [[0, 32557], [2, 32679], [9, 33199], [18, 33859], [21, 34019], [27, 34639], [29, 35189], [35, 35739], [37, 35929], [42, 36119], [51, 36939], [54, 37079], [59, 37379], [61, 37699], [67, 38796], [69, 39146], [74, 39496], [83, 39846], [85, 40106]]}, {"verse": 6, "start": 41124, "end": 48314, "text": "Y Isaí engendró al rey David: y el rey David engendró a Salomón de la que fue mujer de Urías:", "words": [[0, 41124], [2, 41329], [7, 41849], [16, 42749], [19, 43029], [23, 43409], [30, 44226], [32, 44388], [35, 44528], [39, 44828], [45, 45088], [54, 45888], [56, 46068], [64, 46508], [67, 46768], [70, 46868], [74, 46988], [78, 47168], [84, 47528], [87, 47728]]}, {"verse": 7, "start": 48764, "end": 56611, "text": "Y Salomón engendró a Roboam: y Roboam engendró a Abía: y Abía engendró a Asa:", "words": [[0, 48764], [2, 48907], [10, 49394], [19, 49880], [21, 50367], [29, 51490], [31, 51710], [38, 52440], [47, 53170], [49, 53628], [55, 54341], [57, 54736], [62, 55150], [71, 55563], [73, 55963]]}, {"verse": 8, "start": 57061, "end": 64753, "text": "Y Asa engendró a Josafat: y Josafat engendró a Joram: y Joram engendró a Uzías:", "words": [[0, 57336], [2, 57651], [6, 57966], [15, 58281], [17, 58798], [26, 59537], [28, 59948], [36, 60388], [45, 61088], [47, 61557], [54, 62257], [56, 62398], [62, 62798], [71, 63538], [73, 64171]]}, {"verse": 9, "start": 65203, "end": 73444, "text": "Y Uzías engendró a Jotam: y Jotam engendró a Acaz: y Acaz engendró a Ezequías:", "words": [[0, 65203], [2, 65715], [8, 66261], [17, 66808], [19, 67048], [26, 68043], [28, 68339], [34, 68969], [43, 69599], [45, 70115], [51, 71280], [53, 71729], [58, 72177], [67, 72625], [69, 73074]]}, {"verse": 10, "start": 73894, "end": 81345, "text": "Y Ezequías engendró a Manasés: y Manasés engendró a Amón: y Amón engendró a Josías:", "words": [[0, 73894], [2, 74377], [11, 74897], [20, 75477], [22, 75597], [31, 76647], [33, 77009], [41, 77409], [50, 77719], [52, 78029], [58, 79080], [60, 79306], [65, 79533], [74, 80433], [76, 80593]]}, {"verse": 11, "start": 81795, "end": 88343, "text": "Y Josías engendró a Jeconías y a sus hermanos, en la deportación de Babilonia.", "words": [[0, 81795], [2, 82083], [9, 82663], [18, 83383], [20, 83623], [29, 84343], [31, 84663], [33, 84763], [37, 84903], [47, 85863], [50, 86083], [53, 86223], [65, 87303], [68, 87503]]}, {"verse": 12, "start": 88793, "end": 96418, "text": "Y después de la deportación de Babilonia, Jeconías engendró a Salatiel: y Salatiel engendró a Zorobabel:", "words": [[0, 88793], [2, 88912], [10, 89172], [13, 89412], [16, 89512], [28, 90212], [31, 90372], [42, 91282], [51, 92192], [60, 92792], [62, 92952], [72, 94006], [74, 94114], [83, 94714], [92, 95474], [94, 95976]]}, {"verse": 13, "start": 96868, "end": 104797, "text": "Y Zorobabel engendró a Abiud: y Abiud engendró a Eliaquim: y Eliaquim engendró a Azor:", "words": [[0, 96868], [2, 97297], [12, 97757], [21, 98217], [23, 98681], [30, 99601], [32, 99827], [38, 100054], [47, 100794], [49, 101411], [59, 102289], [61, 102763], [70, 103243], [79, 104083], [81, 104462]]}, {"verse": 14, "start": 105247, "end": 112035, "text": "Y Azor engendró a Sadoc: y Sadoc engendró a Aquim: y Aquim engendró a Eliud:", "words": [[0, 105247], [2, 105395], [7, 105775], [16, 106355], [18, 106775], [25, 107430], [27, 107657], [33, 107917], [42, 108577], [44, 108988], [51, 109853], [53, 110099], [59, 110346], [68, 111046], [70, 111346]]}, {"verse": 15, "start": 112485, "end": 119870, "text": "Y Eliud engendró a Eleazar: y Eleazar engendró a Matán: y Matán engendró a Jacob:", "words": [[0, 112485], [2, 112908], [8, 113368], [17, 113828], [19, 114362], [28, 115196], [30, 115736], [38, 116276], [47, 116816], [49, 117016], [56, 117951], [58, 118053], [64, 118623], [73, 119193], [75, 119293]]}, {"verse": 16, "start": 120320, "end": 127246, "text": "Y Jacob engendró a José, marido de María, de la cual nació Jesús, el cual es llamado el Cristo.", "words": [[0, 120320], [2, 120445], [8, 120785], [17, 121585], [19, 121685], [25, 122465], [32, 122945], [35, 123085], [42, 124005], [45, 124085], [48, 124205], [53, 124405], [59, 124865], [66, 125765], [69, 125865], [74, 126085], [77, 126265], [85, 126592], [88, 126919]]}, {"verse": 17, "start": 127696, "end": 144651, "text": "De manera que todas las generaciones desde Abraham hasta David son catorce generaciones: y desde David hasta la deportación de Babilonia, catorce generaciones: y desde la deportación de Babilonia hasta Cristo, catorce generaciones.", "words": [[0, 127696], [3, 128340], [10, 128560], [14, 128880], [20, 129140], [24, 129440], [37, 130180], [43, 130460], [51, 130880], [57, 131420], [63, 131800], [67, 132320], [75, 133040], [89, 134537], [91, 134679], [97, 134919], [103, 135339], [109, 135779], [112, 135959], [124, 136659], [127, 136819], [138, 137579], [146, 138339], [160, 140038], [162, 140142], [168, 140323], [171, 140503], [183, 141103], [186, 141242], [196, 141742], [202, 141962], [210, 142612], [218, 143263]]}, {"verse": 18, "start": 145101, "end": 156504, "text": "Y el nacimiento de Jesucristo fue así: Que siendo María su madre desposada con José, antes que se juntasen, se halló que había concebido del Espíritu Santo.", "words": [[0, 145101], [2, 145230], [5, 145350], [16, 146090], [19, 146290], [30, 147090], [34, 147310], [39, 148057], [43, 148162], [50, 148502], [56, 148862], [59, 149162], [65, 149562], [75, 150562], [79, 150802], [85, 151862], [91, 152062], [95, 152262], [98, 152402], [108, 153642], [111, 153862], [117, 154182], [121, 154322], [127, 154522], [137, 155202], [141, 155382], [150, 155902]]}, {"verse": 19, "start": 156954, "end": 164411, "text": "Y José su marido, como era justo, y no quisiese avergonzarla públicamente, quiso dejarla secretamente.", "words": [[0, 156954], [2, 157118], [7, 157338], [10, 157598], [18, 158418], [23, 158618], [27, 158818], [34, 159818], [36, 159918], [39, 160018], [48, 160498], [61, 161378], [75, 162498], [81, 162758], [89, 163358]]}, {"verse": 20, "start": 164861, "end": 177709, "text": "Y pensando él en esto, he aquí el ángel del Señor se le apareció en sueños, diciendo: José, hijo de David, no temas de recibir a María tu mujer, porque lo que en ella es engendrado, del Espíritu Santo es.", "words": [[0, 164861], [2, 164967], [11, 165327], [14, 165687], [17, 165827], [23, 166327], [26, 166407], [31, 166727], [34, 166947], [40, 167367], [44, 167547], [50, 167907], [53, 168227], [56, 168387], [65, 169007], [68, 169147], [76, 169987], [86, 171068], [92, 171356], [97, 171576], [100, 171696], [107, 172316], [110, 172436], [116, 172756], [119, 172956], [127, 173336], [129, 173496], [135, 173736], [138, 173936], [145, 174516], [152, 174696], [155, 174876], [159, 175016], [162, 175136], [167, 175276], [170, 175456], [182, 176076], [186, 176376], [195, 176916], [201, 177176]]}, {"verse": 21, "start": 178159, "end": 184093, "text": "Y dará a luz un hijo, y llamarás su nombre JESÚS, porque él salvará a su pueblo de sus pecados.", "words": [[0, 178159], [2, 178277], [7, 178597], [9, 178697], [13, 178977], [16, 179077], [22, 179317], [24, 179787], [33, 180257], [36, 180457], [43, 180737], [50, 181557], [57, 181897], [60, 182077], [68, 182597], [70, 182677], [73, 182777], [80, 183097], [83, 183257], [87, 183417]]}, {"verse": 22, "start": 184443, "end": 190660, "text": "Todo esto aconteció para que se cumpliese lo que fue dicho por el Señor, por el profeta que dijo:", "words": [[0, 184443], [5, 184606], [10, 184966], [20, 185706], [25, 185926], [29, 186086], [32, 186246], [42, 186826], [45, 187006], [49, 187126], [53, 187306], [59, 187606], [63, 187886], [66, 188006], [73, 189046], [77, 189226], [80, 189366], [88, 190026], [92, 190166]]}, {"verse": 23, "start": 191110, "end": 200853, "text": "He aquí la virgen concebirá y parirá un hijo, y llamarás su nombre Emanuel, que traducido significa: Dios con nosotros.", "words": [[0, 191166], [3, 191256], [8, 191496], [11, 191676], [18, 192056], [28, 192796], [30, 192896], [37, 193336], [40, 193456], [46, 194236], [48, 194546], [57, 194856], [60, 195116], [67, 195916], [76, 196716], [80, 197016], [90, 197696], [101, 199766], [106, 199766], [110, 199930]]}, {"verse": 24, "start": 201303, "end": 208257, "text": "Y despertando José del sueño, hizo como el ángel del Señor le había mandado, y recibió a su mujer.", "words": [[0, 201303], [2, 201400], [14, 202080], [19, 202440], [23, 202700], [30, 203760], [35, 204140], [40, 204440], [43, 204600], [49, 204980], [53, 205100], [59, 205460], [62, 205740], [68, 205960], [77, 206560], [79, 206800], [87, 207460], [89, 207540], [92, 207680]]}, {"verse": 25, "start": 208707, "end": 214150, "text": "Y no la conoció hasta que parió a su hijo primogénito: y llamó su nombre JESÚS.", "words": [[0, 208707], [2, 208833], [5, 209013], [8, 209153], [16, 209753], [22, 210073], [26, 210253], [32, 210633], [34, 210793], [37, 210933], [42, 211173], [55, 212463], [57, 212569], [63, 212889], [66, 213009], [73, 213329]]}]}