{"book": "PSA", "chapter": 72, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 136167, "verses": [{"verse": 1, "start": 300, "end": 6058, "text": "Para Salomón. OH Dios, da tus juicios al rey, y tu justicia al hijo del rey.", "words": [[0, 300], [5, 486], [14, 1623], [17, 1723], [23, 2116], [26, 2510], [30, 2903], [38, 3383], [41, 3703], [46, 4043], [48, 4183], [51, 4323], [60, 4983], [63, 5203], [68, 5383], [72, 5603]]}, {"verse": 2, "start": 6408, "end": 11206, "text": "Él juzgará tu pueblo con justicia, y tus afligidos con juicio.", "words": [[0, 6408], [3, 6771], [11, 7271], [14, 7471], [21, 7891], [25, 8191], [35, 9071], [37, 9451], [41, 9611], [51, 10251], [55, 10551]]}, {"verse": 3, "start": 11556, "end": 15120, "text": "Los montes llevarán paz al pueblo, y los collados justicia.", "words": [[0, 11556], [4, 11682], [11, 12142], [20, 12542], [24, 12762], [27, 12962], [35, 13402], [37, 13677], [41, 13837], [50, 14297]]}, {"verse": 4, "start": 15470, "end": 22315, "text": "Juzgará los afligidos del pueblo, salvará los hijos del necesitado, y quebrantará al violento.", "words": [[0, 15470], [8, 15946], [12, 16086], [22, 16706], [26, 16886], [34, 17666], [42, 18226], [46, 18406], [52, 18726], [56, 19046], [68, 20066], [70, 20426], [82, 21186], [85, 21446]]}, {"verse": 5, "start": 22665, "end": 28467, "text": "Te temerán mientras duren el sol y la luna, por generación de generaciones.", "words": [[0, 22665], [3, 22787], [11, 23347], [20, 23707], [26, 24367], [29, 24627], [33, 24987], [35, 25287], [38, 25427], [44, 25807], [48, 26587], [59, 27247], [62, 27387]]}, {"verse": 6, "start": 28817, "end": 35891, "text": "Descenderá como la lluvia sobre la hierba cortada; como el rocío que destila sobre la tierra.", "words": [[0, 28817], [11, 29670], [16, 29910], [19, 30090], [26, 30550], [32, 30810], [35, 31030], [42, 31510], [51, 32651], [56, 32864], [59, 33384], [65, 33904], [69, 34044], [77, 34664], [83, 34924], [86, 35144]]}, {"verse": 7, "start": 36241, "end": 42076, "text": "Florecerá en sus días justicia, y muchedumbre de paz, hasta que no haya luna.", "words": [[0, 36241], [10, 36958], [13, 37058], [17, 37218], [22, 37478], [32, 38398], [34, 39018], [46, 39638], [49, 39778], [54, 40238], [60, 40858], [64, 41058], [67, 41238], [72, 41478]]}, {"verse": 8, "start": 42426, "end": 47129, "text": "Y dominará de mar a mar, y desde el río hasta los cabos de la tierra.", "words": [[0, 42426], [2, 42530], [11, 43110], [14, 43210], [18, 43450], [20, 43550], [25, 43870], [27, 44270], [33, 44470], [36, 44770], [40, 45190], [46, 45470], [50, 45690], [56, 46230], [59, 46390], [62, 46490]]}, {"verse": 9, "start": 47479, "end": 53072, "text": "Delante de él se postrarán los etíopes; y sus enemigos lamerán la tierra.", "words": [[0, 47479], [8, 48024], [11, 48144], [14, 48424], [17, 48624], [27, 49344], [31, 49524], [40, 50665], [42, 50835], [46, 50995], [55, 51635], [63, 52215], [66, 52375]]}, {"verse": 10, "start": 53422, "end": 61018, "text": "Los reyes de Tarsis y de las islas traerán presentes: los reyes de Sheba y de Seba ofrecerán dones.", "words": [[0, 53422], [4, 53548], [10, 53968], [13, 54108], [20, 54688], [22, 54848], [25, 54968], [29, 55128], [35, 55588], [43, 56528], [54, 57737], [58, 58024], [64, 58354], [67, 58514], [73, 58954], [75, 59074], [78, 59284], [83, 59494], [93, 60194]]}, {"verse": 11, "start": 61368, "end": 66867, "text": "Todos los reyes se postrarán delante de él; todas las naciones le servirán.", "words": [[0, 61368], [6, 61673], [10, 62073], [16, 62513], [19, 62713], [29, 63433], [37, 63893], [40, 64113], [44, 64683], [50, 65107], [54, 65287], [63, 65677], [66, 66067]]}, {"verse": 12, "start": 67217, "end": 73517, "text": "Porque él librará al necesitado que clama, y al afligido que no tiene quien le socorra.", "words": [[0, 67217], [7, 67463], [10, 67823], [18, 68663], [21, 68943], [32, 69763], [36, 69943], [43, 70443], [45, 70823], [48, 70943], [57, 71703], [61, 71883], [64, 72023], [70, 72283], [76, 72703], [79, 73123]]}, {"verse": 13, "start": 73867, "end": 79751, "text": "Tendrá misericordia del pobre y del necesitado, y salvará las almas de los pobres.", "words": [[0, 73867], [7, 74211], [20, 75091], [24, 75271], [30, 75691], [32, 76031], [36, 76231], [48, 77151], [50, 77671], [58, 78211], [62, 78371], [68, 78791], [71, 78931], [75, 79051]]}, {"verse": 14, "start": 80101, "end": 86565, "text": "De engaño y de violencia redimirá sus almas; y la sangre de ellos será preciosa en sus ojos.", "words": [[0, 80101], [3, 80286], [10, 80866], [12, 80946], [15, 81066], [25, 81706], [34, 82446], [38, 82586], [45, 83648], [47, 83925], [50, 84045], [57, 84445], [60, 84665], [66, 84925], [71, 85205], [80, 85885], [83, 85985], [87, 86125]]}, {"verse": 15, "start": 86915, "end": 94832, "text": "Y vivirá, y se le dará del oro de Seba; y se orará por él continuamente; todo el día se le bendecirá.", "words": [[0, 86915], [2, 87059], [10, 87619], [12, 87799], [15, 87959], [18, 88099], [23, 88439], [27, 88579], [31, 88799], [34, 89039], [40, 89859], [42, 90039], [45, 90179], [51, 90639], [55, 90919], [58, 91079], [73, 92765], [78, 92950], [81, 93210], [85, 93430], [88, 93650], [91, 93790]]}, {"verse": 16, "start": 95182, "end": 106849, "text": "Será echado un puño de grano en tierra, en las cumbres de los montes; su fruto hará ruido como el Líbano, y los de la ciudad florecerán como la hierba de la tierra.", "words": [[0, 95182], [5, 95425], [12, 95885], [15, 96045], [20, 96465], [23, 96625], [29, 96965], [32, 97125], [40, 97485], [43, 98265], [47, 98405], [55, 98905], [58, 99045], [62, 99165], [70, 100178], [73, 100358], [79, 100818], [84, 101198], [90, 101798], [95, 102018], [98, 102218], [106, 102778], [108, 103258], [112, 103418], [115, 103558], [118, 103658], [125, 104018], [136, 105078], [141, 105298], [144, 105478], [151, 105938], [154, 106058], [157, 106178]]}, {"verse": 17, "start": 107199, "end": 118912, "text": "Será su nombre para siempre, se perpetuará su nombre mientras el sol dure: y benditas serán en él todas las naciones: lo llamarán bienaventurado.", "words": [[0, 107199], [5, 107481], [8, 107721], [15, 108081], [20, 108341], [29, 109401], [32, 109681], [43, 110581], [46, 110761], [53, 111201], [62, 111581], [65, 111981], [69, 112476], [75, 113136], [77, 113278], [86, 113958], [92, 114698], [95, 114918], [98, 115138], [104, 115373], [108, 115733], [118, 116894], [121, 116974], [130, 117534]]}, {"verse": 18, "start": 119262, "end": 124202, "text": "Bendito Jehová Dios, el Dios de Israel, que solo hace maravillas.", "words": [[0, 119262], [8, 119890], [15, 120410], [21, 120990], [24, 121090], [29, 121330], [32, 121530], [40, 122270], [44, 122530], [49, 122850], [54, 123210]]}, {"verse": 19, "start": 124552, "end": 131503, "text": "Y bendito su nombre glorioso para siempre: y toda la tierra sea llena de su gloria. Amén y Amén.", "words": [[0, 124552], [2, 124657], [10, 125157], [13, 125337], [20, 125637], [29, 126237], [34, 126517], [43, 127408], [45, 127554], [50, 127774], [53, 128014], [60, 128354], [64, 128694], [70, 129114], [73, 129234], [76, 129434], [84, 130277], [89, 130737], [91, 131037]]}, {"verse": 20, "start": 131853, "end": 135767, "text": "Acábanse las oraciones de David, hijo de Isaí.", "words": [[0, 131853], [9, 132613], [13, 132773], [23, 133393], [26, 133613], [33, 134613], [38, 134833], [41, 135093]]}]}