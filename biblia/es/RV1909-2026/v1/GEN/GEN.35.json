{"book": "GEN", "chapter": 35, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 261752, "verses": [{"verse": 1, "start": 300, "end": 11035, "text": "Y dijo Dios a Jacob: Levántate, sube a Bet-el, y quédate allí; y haz allí un altar al Dios que te apareció cuando huías de tu hermano Esaú.", "words": [[0, 300], [2, 442], [7, 702], [12, 962], [14, 1162], [21, 2003], [32, 2541], [37, 3121], [39, 3181], [47, 3621], [49, 4141], [57, 4561], [63, 5630], [65, 5775], [69, 5955], [74, 6215], [77, 6355], [83, 6675], [86, 6835], [91, 7095], [95, 7375], [98, 7515], [107, 8055], [114, 8335], [120, 8815], [123, 8955], [126, 9075], [134, 9455]]}, {"verse": 2, "start": 11385, "end": 21894, "text": "Entonces Jacob dijo a su familia y a todos los que con él estaban: Quitad los dioses ajenos que hay entre vosotros, y limpiaos, y cambiad vuestros vestidos.", "words": [[0, 11385], [9, 12289], [15, 12589], [20, 13029], [22, 13229], [25, 13349], [33, 13949], [35, 14309], [37, 14389], [43, 14849], [47, 15309], [51, 15489], [55, 15709], [58, 15829], [67, 16870], [74, 17050], [78, 17270], [85, 17630], [92, 18190], [96, 18350], [100, 18510], [106, 18730], [116, 19310], [118, 19530], [128, 20190], [130, 20450], [138, 20710], [147, 21190]]}, {"verse": 3, "start": 22344, "end": 32381, "text": "Y levantémonos, y subamos a Bet-el; y haré allí altar al Dios que me respondió en el día de mi angustia, y ha sido conmigo en el camino que he andado.", "words": [[0, 22344], [2, 22444], [16, 23264], [18, 23384], [26, 23804], [28, 23984], [36, 25324], [38, 25478], [43, 25818], [48, 26078], [54, 26438], [57, 26658], [62, 26918], [66, 27158], [69, 27278], [79, 27938], [82, 28098], [85, 28218], [89, 28458], [92, 28598], [95, 28718], [105, 29418], [107, 29858], [110, 29978], [115, 30198], [123, 30738], [126, 30878], [129, 30978], [136, 31318], [140, 31618], [143, 31818]]}, {"verse": 4, "start": 32731, "end": 46592, "text": "Así dieron a Jacob todos los dioses ajenos que había en poder de ellos, y los aretes que estaban en sus orejas; y Jacob los escondió debajo de una encina, que estaba junto a Siquem.", "words": [[0, 32731], [4, 33033], [11, 33453], [13, 33693], [19, 34073], [25, 34473], [29, 34793], [36, 35253], [43, 35913], [47, 36053], [53, 36313], [56, 36593], [62, 36873], [65, 37173], [72, 37533], [74, 38173], [78, 38353], [85, 38933], [89, 39493], [97, 39853], [100, 40093], [104, 40273], [112, 41630], [114, 41855], [120, 42080], [124, 42305], [133, 42925], [140, 43365], [143, 43605], [147, 43785], [155, 44805], [159, 45105], [166, 45365], [172, 45705], [174, 46161]]}, {"verse": 5, "start": 47042, "end": 55644, "text": "Y salieron, y el terror de Dios fue sobre las ciudades que había en sus alrededores, y no siguieron tras los hijos de Jacob.", "words": [[0, 47042], [2, 47208], [12, 48388], [14, 48688], [17, 48848], [24, 49248], [27, 49488], [32, 49788], [36, 50208], [42, 50568], [46, 50808], [55, 51488], [59, 51648], [65, 51908], [68, 52068], [72, 52228], [85, 53128], [87, 53568], [90, 53708], [100, 54208], [105, 54408], [109, 54628], [115, 54908], [118, 55088]]}, {"verse": 6, "start": 56094, "end": 64798, "text": "Y llegó Jacob a Luz, que está en tierra de Canaán, (esta es Bet-el) él y todo el pueblo que con él estaba;", "words": [[0, 56094], [2, 56194], [8, 56454], [14, 56834], [16, 57294], [21, 57714], [25, 58294], [30, 58514], [33, 58714], [40, 59014], [43, 59254], [51, 60434], [57, 60754], [60, 61241], [68, 61727], [71, 62214], [73, 62534], [78, 62754], [81, 62974], [88, 63274], [92, 63614], [96, 63874], [99, 64014]]}, {"verse": 7, "start": 65248, "end": 74122, "text": "Y edificó allí un altar, y llamó al lugar El-bet-el, porque allí le había aparecido Dios, cuando huía de su hermano.", "words": [[0, 65248], [2, 65390], [10, 65990], [15, 66250], [18, 66470], [25, 66890], [27, 67690], [33, 68130], [36, 68290], [42, 68970], [53, 69650], [60, 70230], [65, 70550], [68, 70750], [74, 71030], [84, 71690], [90, 72090], [97, 72670], [102, 73230], [105, 73370], [108, 73530]]}, {"verse": 8, "start": 74572, "end": 86228, "text": "Entonces murió Débora, nodriza de Rebeca, y fue sepultada a las raíces de Bet-el, debajo de una encina: y se llamó su nombre Alón-bacut.", "words": [[0, 74572], [9, 75029], [15, 75769], [23, 76269], [31, 76929], [34, 77109], [42, 77729], [44, 78269], [48, 78449], [58, 79229], [60, 79389], [64, 79509], [71, 80109], [74, 80329], [82, 81129], [89, 81889], [92, 82049], [96, 82209], [104, 83368], [106, 83628], [109, 83728], [115, 84068], [118, 84188], [125, 85208]]}, {"verse": 9, "start": 86678, "end": 94082, "text": "Y se apareció otra vez Dios a Jacob, cuando se había vuelto de Padan-aram, y le bendijo.", "words": [[0, 86678], [2, 86818], [5, 86938], [14, 87618], [19, 87998], [23, 88318], [28, 88718], [30, 89059], [37, 90038], [44, 90458], [47, 90718], [53, 90938], [60, 91419], [63, 92059], [75, 92698], [77, 93178], [80, 93298]]}, {"verse": 10, "start": 94532, "end": 105270, "text": "Y le dijo Dios: Tu nombre es Jacob; no se llamará más tu nombre Jacob, sino Israel será tu nombre: y llamó su nombre Israel.", "words": [[0, 94532], [2, 94658], [5, 94738], [10, 95018], [16, 96064], [19, 96148], [26, 96468], [29, 96848], [36, 98123], [39, 98306], [42, 98586], [50, 98866], [54, 99046], [57, 99226], [64, 99606], [71, 100366], [76, 100666], [83, 101146], [88, 101506], [91, 101726], [99, 102857], [101, 103007], [107, 103307], [110, 103467], [117, 104395]]}, {"verse": 11, "start": 105720, "end": 117796, "text": "Y le dijo Dios: Yo soy el Dios Omnipotente: crece y multiplícate; una nación y conjunto de naciones procederá de ti, y reyes saldrán de tus lomos:", "words": [[0, 105720], [2, 105846], [5, 105926], [10, 106206], [16, 107252], [19, 107390], [23, 107650], [26, 107950], [31, 108170], [44, 109864], [50, 110301], [52, 110501], [66, 112016], [70, 112196], [77, 112656], [79, 112876], [88, 113356], [91, 113616], [100, 114136], [110, 114856], [113, 114936], [117, 115556], [119, 115616], [125, 116056], [133, 116676], [136, 116776], [140, 116916]]}, {"verse": 12, "start": 118246, "end": 126583, "text": "Y la tierra que yo he dado a Abraham y a Isaac, la daré a ti: y a tu descendencia después de ti daré la tierra.", "words": [[0, 118246], [2, 118354], [5, 118474], [12, 118774], [16, 119054], [19, 119254], [22, 119334], [27, 119614], [29, 119934], [37, 120294], [39, 120484], [41, 120674], [48, 121554], [51, 121754], [56, 122054], [58, 122134], [62, 123040], [64, 123221], [66, 123281], [69, 123401], [82, 124381], [90, 124741], [93, 124981], [96, 125421], [101, 125661], [104, 125721]]}, {"verse": 13, "start": 126933, "end": 131519, "text": "Y se fue de él Dios, del lugar donde con él había hablado.", "words": [[0, 126933], [2, 127054], [5, 127194], [9, 127394], [12, 127594], [15, 127894], [21, 128634], [25, 128894], [31, 129254], [37, 129674], [41, 130014], [44, 130234], [50, 130614]]}, {"verse": 14, "start": 131969, "end": 142816, "text": "Y Jacob erigió una columna en el lugar donde había hablado con él, una columna de piedra, y derramó sobre él libación, y echó sobre él aceite.", "words": [[0, 131969], [2, 132093], [8, 132373], [15, 132893], [19, 133053], [27, 133613], [30, 133753], [33, 133913], [39, 134193], [45, 134453], [51, 134813], [59, 135233], [63, 135453], [67, 136033], [71, 136313], [79, 136833], [82, 136953], [90, 137613], [92, 138173], [100, 138813], [106, 139093], [109, 139373], [119, 140113], [121, 140793], [126, 141173], [132, 141473], [135, 141873]]}, {"verse": 15, "start": 143266, "end": 148759, "text": "Y llamó Jacob el nombre de aquel lugar donde Dios había hablado con él, Bet-el.", "words": [[0, 143266], [2, 143371], [8, 143731], [14, 144111], [17, 144511], [24, 144871], [27, 145071], [33, 145411], [39, 145671], [45, 146011], [50, 146311], [56, 146751], [64, 147331], [68, 147531], [72, 148231]]}, {"verse": 16, "start": 149209, "end": 158835, "text": "Y partieron de Bet-el, y había aún como media legua de tierra para llegar a Efrata, cuando parió Raquel, y hubo trabajo en su parto.", "words": [[0, 149209], [2, 149332], [12, 149972], [15, 150622], [23, 151272], [25, 151512], [31, 151832], [35, 152172], [40, 152492], [46, 152852], [52, 153372], [55, 153532], [62, 153912], [67, 154232], [74, 154472], [76, 154652], [84, 155592], [91, 155832], [97, 156232], [105, 156652], [107, 156892], [112, 157432], [120, 157872], [123, 158072], [126, 158473]]}, {"verse": 17, "start": 159285, "end": 167344, "text": "Y aconteció, que como tenía dificultades en el parto, le dijo la partera: No temas, que también tendrás este hijo.", "words": [[0, 159285], [2, 159421], [13, 160081], [17, 160381], [22, 160521], [28, 160921], [41, 161861], [44, 162081], [47, 162221], [54, 163481], [57, 163601], [62, 163881], [65, 164041], [74, 165046], [77, 165252], [84, 165532], [88, 165752], [96, 166132], [104, 166552], [109, 166852]]}, {"verse": 18, "start": 167694, "end": 176939, "text": "Y aconteció que al exhalar su último aliento, (pues murió) llamó su nombre Benoni; mas su padre lo llamó Benjamín.", "words": [[0, 167694], [2, 167841], [12, 168641], [16, 169001], [19, 169141], [27, 169701], [30, 169901], [37, 170281], [46, 171521], [52, 171601], [59, 172461], [65, 172761], [68, 172961], [75, 173301], [83, 174335], [87, 174415], [90, 174715], [96, 175215], [99, 175575], [105, 175955]]}, {"verse": 19, "start": 177389, "end": 182866, "text": "Así murió Raquel, y fue sepultada en el camino de Efrata, la cual es Belén.", "words": [[0, 177389], [4, 177615], [10, 177995], [18, 178495], [20, 179075], [24, 179235], [34, 179975], [37, 180115], [40, 180215], [47, 180555], [50, 181005], [58, 181455], [61, 181555], [66, 181795], [69, 182055]]}, {"verse": 20, "start": 183316, "end": 191139, "text": "Y puso Jacob una columna sobre su sepultura: esta es la columna de la sepultura de Raquel hasta hoy.", "words": [[0, 183316], [2, 183463], [7, 183863], [13, 184223], [17, 184683], [25, 185343], [31, 185603], [34, 185843], [45, 187111], [50, 187608], [53, 187968], [56, 188348], [64, 188908], [67, 189008], [70, 189128], [80, 189748], [83, 189988], [90, 190408], [96, 190668]]}, {"verse": 21, "start": 191589, "end": 196652, "text": "Y salió Israel, y tendió su tienda de la otra parte de Migdal-edar.", "words": [[0, 191589], [2, 191727], [8, 192127], [16, 193147], [18, 193407], [25, 193827], [28, 193987], [35, 194467], [38, 194627], [41, 194767], [46, 194987], [52, 195407], [55, 195647]]}, {"verse": 22, "start": 197102, "end": 211191, "text": "Y acaeció, morando Israel en aquella tierra, que fue Rubén y durmió con Bilha la concubina de su padre; lo cual llegó a entender Israel. Ahora bien, los hijos de Israel fueron doce:", "words": [[0, 197102], [2, 197408], [11, 198128], [19, 198848], [26, 199328], [29, 199488], [37, 199808], [45, 200248], [49, 200528], [53, 200748], [59, 201348], [61, 201768], [68, 202228], [72, 202578], [78, 202928], [81, 203068], [91, 203788], [94, 203928], [97, 204068], [104, 205007], [107, 205133], [112, 205453], [118, 205893], [120, 206153], [129, 206453], [137, 207576], [143, 207921], [149, 208761], [153, 208981], [159, 209341], [162, 209541], [169, 209981], [176, 210341]]}, {"verse": 23, "start": 211641, "end": 220008, "text": "Los hijos de Lea: Rubén el primogénito de Jacob, y Simeón, y Leví, y Judá, e Isacar, y Zabulón.", "words": [[0, 211641], [4, 211941], [10, 212241], [13, 212481], [18, 213902], [24, 214372], [27, 214452], [39, 215272], [42, 215392], [49, 216252], [51, 216332], [59, 217152], [61, 217212], [67, 217732], [69, 217937], [75, 218142], [77, 218347], [85, 218552], [87, 219310]]}, {"verse": 24, "start": 220458, "end": 223536, "text": "Los hijos de Raquel: José, y Benjamín.", "words": [[0, 220458], [4, 220607], [10, 220907], [13, 221127], [21, 222013], [27, 222395], [29, 222715]]}, {"verse": 25, "start": 223986, "end": 228466, "text": "Y los hijos de Bilha, sierva de Raquel: Dan, y Neftalí.", "words": [[0, 223986], [2, 224091], [6, 224231], [12, 224511], [15, 224981], [22, 225451], [29, 225851], [32, 225991], [40, 227667], [45, 227667], [47, 227806]]}, {"verse": 26, "start": 228916, "end": 237225, "text": "Y los hijos de Zilpa, sierva de Lea: Gad, y Aser. Estos fueron los hijos de Jacob, que le nacieron en Padan-aram.", "words": [[0, 228916], [2, 229001], [6, 229121], [12, 229401], [15, 229734], [22, 230068], [29, 230401], [32, 230681], [37, 231590], [42, 232230], [44, 232702], [50, 233424], [56, 233731], [63, 233931], [67, 234171], [73, 234451], [76, 234631], [83, 235391], [87, 235471], [90, 235591], [99, 236051], [102, 236666]]}, {"verse": 27, "start": 237675, "end": 246641, "text": "Y vino Jacob a Isaac su padre a Mamre, a la ciudad de Arba, que es Hebrón, donde habitaron Abraham e Isaac.", "words": [[0, 237675], [2, 237800], [7, 238020], [13, 238360], [15, 238760], [21, 239340], [24, 239480], [30, 240013], [32, 240547], [39, 241080], [41, 241260], [44, 241340], [51, 241620], [54, 242000], [60, 242880], [64, 242900], [67, 243470], [75, 244040], [81, 244240], [91, 245020], [99, 245440], [101, 246040]]}, {"verse": 28, "start": 247091, "end": 250195, "text": "Y fueron los días de Isaac ciento ochenta años.", "words": [[0, 247091], [2, 247197], [9, 247437], [13, 247657], [18, 247877], [21, 248337], [27, 248617], [34, 248897], [42, 249177]]}, {"verse": 29, "start": 250645, "end": 261352, "text": "Y exhaló Isaac el espíritu, y murió, y fue recogido a sus pueblos, viejo y lleno de días; y lo sepultaron Esaú y Jacob sus hijos.", "words": [[0, 250645], [2, 250793], [9, 251393], [15, 251993], [18, 252153], [28, 253093], [30, 253153], [37, 253613], [39, 254033], [43, 254193], [52, 254893], [54, 255013], [58, 255153], [67, 255853], [73, 256553], [75, 256853], [81, 257133], [84, 257253], [90, 258150], [92, 258271], [95, 258431], [106, 258991], [111, 259551], [113, 259771], [119, 260511], [123, 260711]]}]}