{"book": "PSA", "chapter": 62, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 95088, "verses": [{"verse": 1, "start": 300, "end": 9528, "text": "Al Músico principal: a Jedutún: Salmo de David. EN Dios solamente está acallada mi alma: de él viene mi salvación.", "words": [[0, 300], [3, 483], [10, 1003], [21, 2473], [23, 2781], [32, 3309], [38, 3773], [41, 3913], [48, 4717], [51, 4903], [56, 5163], [66, 5923], [71, 6353], [80, 6783], [83, 6963], [89, 7728], [92, 8028], [95, 8168], [101, 8428], [104, 8608]]}, {"verse": 2, "start": 9528, "end": 15239, "text": "Él solamente es mi fuerte, y mi salvación; es mi refugio, no resbalaré mucho.", "words": [[0, 9528], [3, 9788], [13, 10208], [16, 10568], [19, 10648], [27, 11048], [29, 11388], [32, 11488], [43, 12420], [46, 12780], [49, 13340], [58, 13900], [61, 14330], [71, 14760]]}, {"verse": 3, "start": 15589, "end": 23896, "text": "¿Hasta cuándo maquinaréis contra un hombre? Pereceréis todos vosotros, caeréis como pared inclinada, como cerca ruinosa.", "words": [[0, 15589], [7, 15854], [14, 16134], [26, 16894], [33, 17174], [36, 17394], [44, 18108], [55, 18832], [61, 19252], [71, 19912], [79, 20532], [84, 20812], [90, 21212], [101, 22452], [106, 22948], [112, 23445]]}, {"verse": 4, "start": 24246, "end": 33765, "text": "Solamente tratan de arrojarle de su grandeza; aman la mentira, con su boca bendicen, pero maldicen en sus entrañas. (Selah.)", "words": [[0, 24246], [10, 24864], [17, 25624], [20, 25744], [30, 26464], [33, 26604], [36, 26744], [46, 27876], [51, 28264], [54, 28364], [63, 28904], [67, 29104], [70, 29284], [75, 29544], [85, 30704], [90, 30864], [99, 31684], [102, 31824], [106, 31964], [116, 33455]]}, {"verse": 5, "start": 34115, "end": 39319, "text": "Alma mía, en Dios solamente reposa; porque de él es mi esperanza.", "words": [[0, 34115], [5, 34415], [10, 34815], [13, 34895], [18, 35155], [28, 35979], [36, 37379], [43, 37769], [46, 37929], [49, 38109], [52, 38289], [55, 38489]]}, {"verse": 6, "start": 39669, "end": 45007, "text": "Él solamente es mi fuerte y mí salvación: es mi refugio, no resbalaré.", "words": [[0, 39669], [3, 39834], [13, 40274], [16, 40574], [19, 40674], [26, 41074], [28, 41314], [31, 41434], [42, 42578], [45, 42752], [48, 42932], [57, 43632], [60, 43952]]}, {"verse": 7, "start": 45357, "end": 52238, "text": "En Dios está mi salvación y mi gloria: en Dios está la roca de mi fortaleza, y mi refugio.", "words": [[0, 45357], [3, 45521], [8, 45821], [13, 46541], [16, 46761], [26, 47441], [28, 47681], [31, 47781], [39, 48679], [42, 48990], [47, 49170], [52, 49470], [55, 49630], [60, 50030], [63, 50170], [66, 50290], [77, 51030], [79, 51170], [82, 51330]]}, {"verse": 8, "start": 52588, "end": 62230, "text": "Esperad en él en todo tiempo, oh pueblos; derramad delante de él vuestro corazón: Dios es nuestro amparo. (Selah.)", "words": [[0, 52588], [8, 53328], [11, 53588], [14, 53788], [17, 54068], [22, 54248], [30, 54708], [33, 55168], [42, 56393], [51, 57101], [59, 57641], [62, 57861], [65, 58021], [73, 58401], [82, 59428], [87, 59712], [90, 60132], [98, 60632], [106, 61920]]}, {"verse": 9, "start": 62580, "end": 72344, "text": "Por cierto, vanidad son los hijos de los hombres, mentira los hijos de varón: pesándolos a todos igualmente en la balanza, serán menos que la vanidad.", "words": [[0, 62580], [4, 62860], [12, 63460], [20, 63900], [24, 64260], [28, 64500], [34, 64780], [37, 64980], [41, 65100], [50, 65900], [58, 66500], [62, 66700], [68, 66980], [71, 67200], [78, 67890], [89, 68655], [91, 68775], [97, 69075], [108, 69795], [111, 69915], [114, 70015], [123, 70775], [129, 71135], [135, 71395], [139, 71575], [142, 71715]]}, {"verse": 10, "start": 72694, "end": 81866, "text": "No confiéis en la violencia, ni en la rapiña; no os envanezcáis: si se aumentan las riquezas, no pongáis el corazón en ellas.", "words": [[0, 72694], [3, 72802], [12, 73402], [15, 73522], [18, 73642], [29, 74302], [32, 74582], [35, 74702], [38, 74842], [46, 75727], [49, 75938], [52, 76178], [65, 77362], [68, 77504], [71, 77664], [80, 78264], [84, 78444], [94, 79464], [97, 79724], [105, 80364], [108, 80564], [116, 81004], [119, 81264]]}, {"verse": 11, "start": 82216, "end": 88137, "text": "Una vez habló Dios; dos veces he oído esto: Que de Dios es la fortaleza.", "words": [[0, 82216], [4, 82406], [8, 82686], [14, 83246], [20, 84084], [24, 84270], [30, 84690], [33, 85089], [38, 85389], [44, 86136], [48, 86237], [51, 86377], [56, 86677], [59, 86997], [62, 87217]]}, {"verse": 12, "start": 88137, "end": 94688, "text": "Y de ti, oh Señor, es la misericordia: porque tú pagas a cada uno conforme a su obra.", "words": [[0, 88137], [2, 88377], [5, 88517], [9, 88897], [12, 89137], [19, 89837], [22, 89997], [25, 90237], [39, 91414], [46, 91638], [49, 91858], [55, 92398], [57, 92518], [62, 92738], [66, 93118], [75, 93878], [77, 93918], [80, 94078]]}]}