{"book": "ROM", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 242296, "verses": [{"verse": 1, "start": 300, "end": 5894, "text": "Pablo, siervo de Jesucristo, llamado a ser apóstol, apartado para el evangelio de Dios,", "words": [[0, 300], [7, 570], [14, 1050], [17, 1150], [29, 2270], [37, 2570], [39, 2790], [43, 2890], [52, 3690], [61, 4350], [66, 4570], [69, 4710], [79, 5270], [82, 5370]]}, {"verse": 2, "start": 6244, "end": 10056, "text": "Que él había antes prometido por sus profetas en las santas Escrituras,", "words": [[0, 6244], [4, 6364], [7, 6524], [13, 6724], [19, 7104], [29, 7724], [33, 7864], [37, 8024], [46, 8564], [49, 8744], [53, 8884], [60, 9264]]}, {"verse": 3, "start": 10406, "end": 14131, "text": "Acerca de su Hijo, (que fue hecho del linaje de David según la carne;", "words": [[0, 10406], [7, 10748], [10, 10948], [13, 11108], [19, 11688], [24, 11708], [28, 11908], [34, 12148], [38, 12328], [45, 12768], [48, 12868], [54, 13308], [60, 13488], [63, 13688]]}, {"verse": 4, "start": 14481, "end": 23576, "text": "El cual fue declarado Hijo de Dios con poder, según el espíritu de santidad, por la resurrección de los muertos), de Jesucristo Señor nuestro,", "words": [[0, 14481], [3, 14603], [8, 14863], [12, 15183], [22, 15863], [27, 16203], [30, 16423], [35, 16643], [39, 16923], [46, 17283], [52, 17703], [55, 17943], [64, 18543], [67, 18623], [77, 19223], [81, 19743], [84, 19903], [97, 20663], [100, 20783], [104, 20903], [114, 21443], [117, 21843], [128, 22643], [134, 22823]]}, {"verse": 5, "start": 23926, "end": 30856, "text": "Por el cual recibimos la gracia y el apostolado, para la obediencia de la fe en todas las naciones en su nombre,", "words": [[0, 23926], [4, 24053], [7, 24153], [12, 24413], [22, 25273], [25, 25453], [32, 26113], [34, 26253], [37, 26353], [49, 27313], [54, 27593], [57, 27963], [68, 28333], [71, 28533], [74, 28653], [77, 28893], [80, 29053], [86, 29233], [90, 29553], [99, 29973], [102, 30193], [105, 30353]]}, {"verse": 6, "start": 31206, "end": 34696, "text": "Entre las cuales sois también vosotros, llamados de Jesucristo:", "words": [[0, 31206], [6, 31388], [10, 31548], [17, 31808], [22, 32208], [30, 32408], [40, 33308], [49, 33788], [52, 33928]]}, {"verse": 7, "start": 35046, "end": 43608, "text": "A todos los que estáis en Roma, amados de Dios, llamados santos: Gracia y paz tengáis de Dios nuestro Padre, y del Señor Jesucristo.", "words": [[0, 35046], [2, 35190], [8, 35410], [12, 35670], [16, 35850], [23, 36290], [26, 36410], [32, 36950], [39, 37290], [42, 37470], [48, 38230], [57, 38630], [65, 39825], [72, 40035], [74, 40255], [78, 40495], [86, 41015], [89, 41175], [94, 41395], [102, 41695], [109, 42255], [111, 42375], [115, 42495], [121, 42735]]}, {"verse": 8, "start": 43958, "end": 51421, "text": "Primeramente, doy gracias a mi Dios por Jesucristo acerca de todos vosotros, de que vuestra fe es predicada en todo el mundo.", "words": [[0, 43958], [14, 44678], [18, 44978], [26, 45258], [28, 45558], [31, 45638], [36, 45918], [40, 46238], [51, 46958], [58, 47358], [61, 47638], [67, 47878], [77, 48578], [80, 48793], [84, 48913], [92, 49293], [95, 49533], [98, 49793], [108, 50433], [111, 50553], [116, 50753], [119, 50973]]}, {"verse": 9, "start": 51771, "end": 59569, "text": "Porque testigo me es Dios, al cual sirvo en mi espíritu en el evangelio de su Hijo, que sin cesar me acuerdo de vosotros siempre en mis oraciones,", "words": [[0, 51771], [7, 51931], [15, 52431], [18, 52571], [21, 52731], [27, 53391], [30, 53531], [35, 53691], [41, 54091], [44, 54171], [47, 54271], [56, 54791], [59, 54871], [62, 54951], [72, 55431], [75, 55531], [78, 55711], [84, 56311], [88, 56451], [92, 56611], [98, 57031], [101, 57131], [109, 57431], [112, 57651], [121, 58091], [129, 58451], [132, 58671], [136, 58811]]}, {"verse": 10, "start": 59919, "end": 65864, "text": "Rogando, si por fin pudiera tener, por la voluntad de Dios, próspero viaje para ir a vosotros.", "words": [[0, 59919], [9, 60423], [12, 60663], [16, 60843], [20, 61063], [28, 61463], [35, 62123], [39, 62223], [42, 62343], [51, 62883], [54, 62983], [60, 63703], [69, 64223], [75, 64543], [80, 64843], [83, 65023], [85, 65123]]}, {"verse": 11, "start": 66214, "end": 72072, "text": "Porque os deseo ver, para repartir con vosotros algún don espiritual, para fortaleceros;", "words": [[0, 66214], [7, 66456], [10, 66656], [16, 67096], [21, 67316], [26, 67856], [35, 68476], [39, 68596], [48, 69156], [54, 69476], [58, 69676], [70, 70356], [75, 71016]]}, {"verse": 12, "start": 72422, "end": 77998, "text": "Es decir, para ser juntamente consolado con vosotros por la común fe vuestra y juntamente mía.", "words": [[0, 72422], [3, 72567], [10, 73087], [15, 73247], [19, 73507], [30, 74107], [40, 74807], [44, 74967], [53, 75487], [57, 75727], [60, 75867], [66, 76107], [69, 76387], [77, 76867], [79, 77007], [90, 77567]]}, {"verse": 13, "start": 78348, "end": 89270, "text": "Pero no quiero, hermanos, que ignoréis que muchas veces me he propuesto ir a vosotros (pero hasta ahora he sido estorbado), para tener también entre vosotros algún fruto, como entre los demás Gentiles.", "words": [[0, 78348], [5, 78488], [8, 78608], [16, 78828], [26, 79708], [30, 79848], [39, 80308], [43, 80448], [50, 80648], [56, 81108], [59, 81348], [62, 81448], [72, 81908], [75, 82088], [77, 82188], [86, 83128], [92, 83288], [98, 83548], [104, 83848], [107, 84008], [112, 84268], [124, 84968], [129, 85408], [135, 85688], [143, 86048], [149, 86308], [158, 86828], [164, 87128], [171, 87883], [176, 88040], [182, 88220], [186, 88400], [192, 88640]]}, {"verse": 14, "start": 89620, "end": 93120, "text": "A griegos y a no griegos, a sabios y a no sabios soy deudor.", "words": [[0, 89620], [2, 89751], [10, 90171], [12, 90291], [14, 90371], [17, 90451], [26, 91131], [28, 91211], [35, 91671], [37, 91811], [39, 91871], [42, 91951], [49, 92371], [53, 92571]]}, {"verse": 15, "start": 93470, "end": 98633, "text": "Así que, cuanto a mí, dispuesto estoy a anunciar el evangelio también a vosotros que estáis en Roma.", "words": [[0, 93470], [4, 93658], [9, 93798], [16, 94018], [18, 94218], [22, 94598], [32, 95058], [38, 95298], [40, 95538], [49, 96038], [52, 96118], [62, 96698], [70, 96918], [72, 97138], [81, 97518], [85, 97718], [92, 98078], [95, 98218]]}, {"verse": 16, "start": 98983, "end": 106784, "text": "Porque no me avergüenzo del evangelio: porque es poder de Dios para salvación a todo aquel que cree; al judío primeramente y también al griego.", "words": [[0, 98983], [7, 99148], [10, 99348], [13, 99468], [24, 100028], [28, 100168], [39, 101110], [46, 101349], [49, 101489], [55, 101729], [58, 101949], [63, 102169], [68, 102429], [78, 103049], [80, 103289], [85, 103469], [91, 103809], [95, 103929], [101, 104575], [104, 104726], [110, 105126], [123, 105706], [125, 105866], [133, 106046], [136, 106286]]}, {"verse": 17, "start": 107134, "end": 113026, "text": "Porque en él la justicia de Dios se descubre de fe en fe; como está escrito: Pero el justo vivirá por la fe.", "words": [[0, 107134], [7, 107332], [10, 107492], [13, 107612], [16, 107752], [25, 108232], [28, 108372], [33, 108592], [36, 108772], [45, 109292], [48, 109392], [51, 109612], [54, 109752], [58, 110343], [63, 110483], [68, 110683], [77, 111503], [82, 111645], [85, 111765], [91, 111945], [98, 112425], [102, 112585], [105, 112705]]}, {"verse": 18, "start": 113376, "end": 120141, "text": "Porque manifiesta es la ira de Dios del cielo contra toda impiedad e injusticia de los hombres, que detienen la verdad con injusticia:", "words": [[0, 113376], [7, 113556], [18, 114236], [21, 114416], [24, 114556], [28, 114756], [31, 114856], [36, 115056], [40, 115236], [46, 115556], [53, 115856], [58, 116116], [67, 116736], [69, 116816], [80, 117416], [83, 117536], [87, 117656], [96, 118036], [100, 118231], [109, 118651], [112, 118791], [119, 119071], [123, 119331]]}, {"verse": 19, "start": 120491, "end": 125307, "text": "Porque lo que de Dios se conoce, a ellos es manifiesto; porque Dios se lo manifestó.", "words": [[0, 120491], [7, 120678], [10, 120818], [14, 120938], [17, 121058], [22, 121238], [25, 121438], [33, 122058], [35, 122338], [41, 122558], [44, 122778], [56, 123815], [63, 124015], [68, 124255], [71, 124475], [74, 124555]]}, {"verse": 20, "start": 125657, "end": 136762, "text": "Porque las cosas invisibles de él, su eterno poder y divinidad, se perciben desde la creación del mundo, siendo entendidas por las cosas que son hechas; de modo que son inexcusables:", "words": [[0, 125657], [7, 125803], [11, 126023], [17, 126283], [28, 126983], [31, 127223], [35, 127783], [38, 127883], [45, 128363], [51, 128603], [53, 128803], [64, 129643], [67, 129723], [76, 130283], [82, 130443], [85, 130663], [94, 131143], [98, 131323], [105, 132043], [112, 132383], [123, 133043], [127, 133263], [131, 133403], [137, 133723], [141, 133923], [145, 134143], [153, 134921], [156, 135066], [161, 135266], [165, 135466], [169, 135646]]}, {"verse": 21, "start": 137112, "end": 146866, "text": "Porque habiendo conocido a Dios, no le glorificaron como a Dios, ni dieron gracias; sino que sus razonamientos se volvieron vanos, y el necio corazón de ellos fue oscurecido.", "words": [[0, 137112], [7, 137278], [16, 137578], [25, 138098], [27, 138198], [33, 138798], [36, 138878], [39, 138978], [52, 139638], [57, 139838], [59, 139998], [65, 140518], [68, 140718], [75, 140958], [84, 141891], [89, 142052], [93, 142232], [97, 142392], [111, 143132], [114, 143352], [124, 143692], [131, 144232], [133, 144432], [136, 144572], [142, 144872], [150, 145212], [153, 145492], [159, 145772], [163, 146032]]}, {"verse": 22, "start": 147216, "end": 149917, "text": "Diciéndose ser sabios, se hicieron necios,", "words": [[0, 147216], [11, 147833], [15, 148093], [23, 148573], [26, 148773], [35, 149193]]}, {"verse": 23, "start": 150267, "end": 159295, "text": "Y cambiaron la gloria del Dios incorruptible en semejanza de imagen de hombre corruptible, y de aves, y de animales de cuatro pies, y de serpientes.", "words": [[0, 150267], [2, 150353], [12, 150773], [15, 150933], [22, 151333], [26, 151473], [31, 151713], [45, 152593], [48, 152713], [58, 153373], [61, 153493], [68, 153813], [71, 154073], [78, 154293], [91, 155093], [93, 155473], [96, 155573], [102, 155913], [104, 156133], [107, 156233], [116, 156593], [119, 156873], [126, 157093], [132, 157493], [134, 157713], [137, 157833]]}, {"verse": 24, "start": 159645, "end": 169198, "text": "Por lo cual también Dios los entregó a inmundicia, en los malos deseos de sus corazones, de suerte que contaminaron sus cuerpos entre sí mismos:", "words": [[0, 159645], [4, 159772], [7, 159892], [12, 160172], [20, 160592], [25, 161052], [29, 161352], [37, 161912], [39, 162032], [51, 162772], [54, 163312], [58, 163452], [64, 163892], [71, 164392], [74, 164512], [78, 164672], [89, 165792], [92, 165992], [99, 166412], [103, 166592], [116, 167292], [120, 167472], [128, 167992], [134, 168272], [137, 168532]]}, {"verse": 25, "start": 169548, "end": 178394, "text": "Los cuales cambiaron la verdad de Dios en mentira, honrando y sirviendo a las criaturas en lugar de al Creador, el cual es bendito por los siglos. Amén.", "words": [[0, 169548], [4, 169654], [11, 169934], [21, 170514], [24, 170674], [31, 170894], [34, 171114], [39, 171334], [42, 171514], [51, 172234], [60, 172954], [62, 173034], [72, 173514], [74, 173614], [78, 173774], [88, 174254], [91, 174434], [97, 174674], [100, 174874], [103, 174974], [112, 175914], [115, 175974], [120, 176194], [123, 176374], [131, 176814], [135, 177014], [139, 177154], [147, 177994]]}, {"verse": 26, "start": 178744, "end": 186362, "text": "Por esto Dios los entregó a pasiones vergonzosas; pues aun sus mujeres cambiaron el uso natural por el que es contra naturaleza:", "words": [[0, 178744], [4, 178875], [9, 179135], [14, 179475], [18, 179715], [26, 180255], [28, 180315], [37, 180735], [50, 182009], [55, 182139], [59, 182399], [63, 182579], [71, 183039], [81, 183719], [84, 183859], [88, 184059], [96, 184559], [100, 184819], [103, 184959], [107, 185099], [110, 185279], [117, 185539]]}, {"verse": 27, "start": 186712, "end": 201445, "text": "Y del mismo modo también los hombres, dejando el uso natural de las mujeres, se encendieron en pasiones los unos por los otros, cometiendo actos vergonzosos hombres con hombres, y recibiendo en sí mismos la recompensa que convino a su extravío.", "words": [[0, 186712], [2, 186815], [6, 186915], [12, 187235], [17, 187515], [25, 187835], [29, 188095], [38, 188895], [46, 189415], [49, 189535], [53, 189735], [61, 190135], [64, 190335], [68, 190475], [77, 191315], [80, 191415], [92, 191955], [95, 192115], [104, 192575], [108, 192815], [113, 193055], [117, 193315], [121, 193495], [128, 194135], [139, 194715], [145, 195135], [157, 195955], [165, 196275], [169, 196555], [178, 197357], [180, 197479], [191, 198159], [194, 198299], [197, 198479], [204, 198859], [207, 199059], [218, 199819], [222, 200169], [230, 200519], [232, 200639], [235, 200759]]}, {"verse": 28, "start": 201795, "end": 208798, "text": "Y como a ellos no les pareció reconocer a Dios, Dios los entregó a una mente depravada, para hacer lo que no conviene,", "words": [[0, 201795], [2, 201888], [7, 202068], [9, 202188], [15, 202368], [18, 202608], [22, 202748], [30, 203248], [40, 203908], [42, 203968], [48, 204708], [53, 204988], [57, 205168], [65, 205708], [67, 205768], [71, 205908], [77, 206248], [88, 206908], [93, 207428], [99, 207728], [102, 207888], [106, 208008], [109, 208148]]}, {"verse": 29, "start": 209148, "end": 218673, "text": "Estando llenos de toda iniquidad, de inmoralidad sexual, de malicia, de avaricia, de maldad; llenos de envidia, de homicidios, de contiendas, de engaños, de malignidades;", "words": [[0, 209148], [8, 209527], [15, 209867], [18, 209967], [23, 210147], [34, 211067], [37, 211107], [49, 211667], [57, 212427], [60, 212487], [69, 213147], [72, 213167], [82, 213727], [85, 213787], [93, 214527], [100, 214774], [103, 214914], [112, 215514], [115, 215534], [127, 216294], [130, 216334], [142, 217114], [145, 217154], [154, 217714], [157, 217774]]}, {"verse": 30, "start": 219023, "end": 228101, "text": "Murmuradores, difamadores, aborrecedores de Dios, injuriosos, soberbios, altivos, inventores de males, desobedientes a los padres,", "words": [[0, 219023], [14, 219641], [27, 220741], [41, 221421], [44, 221581], [50, 222341], [62, 223301], [73, 224121], [82, 224981], [93, 225521], [96, 225721], [103, 226501], [117, 227161], [119, 227381], [123, 227501]]}, {"verse": 31, "start": 228451, "end": 232997, "text": "Necios, desleales, sin afecto natural, implacables, sin misericordia:", "words": [[0, 228451], [8, 228962], [19, 229762], [23, 230122], [30, 230602], [39, 231222], [52, 231842], [56, 232082]]}, {"verse": 32, "start": 233347, "end": 241896, "text": "Que, habiendo entendido el juicio de Dios que los que hacen tales cosas son dignos de muerte, no sólo las hacen, sino que también aprueban a los que las hacen.", "words": [[0, 233347], [5, 233441], [14, 233821], [24, 234421], [27, 234541], [34, 234841], [37, 235001], [42, 235261], [46, 235521], [50, 235661], [54, 235841], [60, 236021], [66, 236301], [72, 236701], [76, 237021], [83, 237461], [86, 237541], [94, 238361], [97, 238621], [102, 238861], [106, 239061], [113, 239641], [118, 239881], [122, 240041], [130, 240341], [139, 240901], [141, 241001], [145, 241101], [149, 241221], [153, 241321]]}]}