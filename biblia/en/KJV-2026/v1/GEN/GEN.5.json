{"book": "GEN", "chapter": 5, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 174722, "verses": [{"verse": 1, "start": 300, "end": 7555, "text": "This is the book of the generations of Adam. In the day that God created man, in the likeness of God made he him;", "words": [[0, 300], [5, 523], [8, 683], [12, 843], [17, 1123], [20, 1283], [24, 1383], [36, 1983], [39, 2283], [45, 3034], [48, 3158], [52, 3258], [56, 3518], [61, 3718], [65, 3978], [73, 4478], [78, 5318], [81, 5478], [85, 5598], [94, 6058], [97, 6178], [101, 6478], [106, 6758], [109, 6978]]}, {"verse": 2, "start": 7905, "end": 14704, "text": "Male and female created he them; and blessed them, and called their name Adam, in the day when they were created.", "words": [[0, 7905], [5, 8192], [9, 8472], [16, 8852], [24, 9392], [27, 9672], [33, 10494], [37, 10625], [45, 10965], [51, 11345], [55, 11545], [62, 11825], [68, 12045], [73, 12305], [79, 12865], [82, 13345], [86, 13485], [90, 13645], [95, 13845], [100, 13985], [105, 14125]]}, {"verse": 3, "start": 15054, "end": 22341, "text": "¶ And Adam lived a hundred and thirty years, and begot a son in his own likeness, after his image; and called his name Seth:", "words": [[2, 15054], [6, 15200], [11, 15540], [17, 15744], [19, 15948], [27, 16152], [31, 16356], [38, 16560], [45, 17100], [49, 17680], [55, 18000], [57, 18100], [61, 18360], [64, 18520], [68, 18680], [72, 18880], [82, 19460], [88, 19780], [92, 20020], [99, 20746], [103, 20871], [110, 21171], [114, 21431], [119, 21771]]}, {"verse": 4, "start": 22691, "end": 28578, "text": "And the days of Adam after he had begotten Seth were eight hundred years: and he begot sons and daughters:", "words": [[0, 22691], [4, 22833], [8, 22933], [13, 23213], [16, 23373], [21, 23693], [27, 23993], [30, 24213], [34, 24333], [43, 24793], [48, 25053], [53, 25286], [59, 25520], [67, 25753], [74, 26781], [78, 26888], [81, 26968], [87, 27328], [92, 27688], [96, 27928]]}, {"verse": 5, "start": 28928