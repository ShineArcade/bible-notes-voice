{"book": "PSA", "chapter": 80, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 107325, "verses": [{"verse": 1, "start": 300, "end": 7930, "text": "Give ear, O Shepherd of Israel, you that lead Joseph like a flock; you that dwell between the cherubims, shine forth.", "words": [[0, 300], [5, 453], [10, 853], [12, 873], [21, 1153], [24, 1393], [32, 2053], [36, 2193], [41, 2893], [46, 3153], [53, 3533], [58, 3873], [60, 4013], [67, 4880], [71, 5028], [76, 5228], [82, 5528], [90, 5948], [94, 6408], [105, 6868], [111, 7288]]}, {"verse": 2, "start": 8380, "end": 13610, "text": "Before Ephraim and Benjamin and Manasseh stir up your strength, and come and save us.", "words": [[0, 8380], [7, 8662], [15, 9362], [19, 9482], [28, 9942], [32, 10402], [41, 10862], [46, 11142], [49, 11382], [54, 11522], [64, 11982], [68, 12522], [73, 12762], [77, 12922], [82, 13202]]}, {"verse": 3, "start": 14060, "end": 18747, "text": "Turn us again, O God, and cause your face to shine; and we shall be saved.", "words": [[0, 14060], [5, 14224], [8, 14404], [15, 14784], [17, 14864], [22, 15584], [26, 15684], [32, 15924], [37, 16184], [42, 16444], [45, 16644], [52, 17495], [56, 17622], [59, 17782], [65, 17982], [68, 18142]]}, {"verse": 4, "start": 19197, "end": 24010, "text": "O LORD God of hosts, how long will you be angry against the prayer of your people?", "words": [[0, 19197], [2, 19357], [7, 19637], [11, 19937], [14, 20117], [21, 20977], [25, 21177], [30, 21457], [35, 21657], [39, 21777], [42, 21917], [48, 22297], [56, 22657], [60, 22857], [67, 23157], [70, 23337], [75, 23457]]}, {"verse": 5, "start": 24460, "end": 28944, "text": "You feed them with the bread of tears; and give them tears to drink in great measure.", "words": [[0, 24460], [4, 24569], [9, 24789], [14, 24969], [19, 25129], [23, 25249], [29, 25469], [32, 25609], [39, 26582], [43, 26709], [48, 26889], [53, 27069], [59, 27389], [62, 27649], [68, 27929], [71, 28089], [77, 28349]]}, {"verse": 6, "start": 29394, "end": 33930, "text": "You make us a strife to our neighbours: and our enemies laugh among themselves.", "words": [[0, 29394], [4, 29560], [9, 29780], [12, 29980], [14, 30120], [21, 30500], [24, 30680], [28, 31102], [40, 31756], [44, 31899], [48, 32039], [56, 32399], [62, 32799], [68, 33079]]}, {"verse": 7, "start": 34380, "end": 39786, "text": "Turn us again, O God of hosts, and cause your face to shine; and we shall be saved.", "words": [[0, 34380], [5, 34562], [8, 34782], [15, 35262], [17, 35382], [21, 35622], [24, 35782], [31, 36342], [35, 36462], [41, 36702], [46, 36882], [51, 37162], [54, 37362], [61, 38302], [65, 38542], [68, 38742], [74, 38942], [77, 39122]]}, {"verse": 8, "start": 40236, "end": 45156, "text": "You have brought a vine out of Egypt: you have cast out the heathen, and planted it.", "words": [[0, 40236], [4, 40352], [9, 40512], [17, 40772], [19, 40932], [24, 41292], [28, 41612], [31, 41772], [38, 42623], [42, 42748], [47, 42888], [52, 43188], [56, 43468], [60, 43648], [69, 44088], [73, 44368], [81, 44848]]}, {"verse": 9, "start": 45606, "end": 50630, "text": "You prepared room before it, and did cause it to take deep root, and it filled the land.", "words": [[0, 45606], [4, 45695], [13, 46015], [18, 46315], [25, 46635], [29, 46955], [33, 47335], [37, 47535], [43, 47875], [46, 48015], [49, 48135], [54, 48335], [59, 48575], [65, 48895], [69, 49515], [72, 49615], [79, 49855], [83, 50055]]}, {"verse": 10, "start": 51080, "end": 55723, "text": "The hills were covered with the shadow of it, and the boughs of it were like the goodly cedars.", "words": [[0, 51080], [4, 51186], [10, 51406], [15, 51626], [23, 51906], [28, 52126], [32, 52266], [39, 52606], [42, 52846], [46, 53166], [50, 53406], [54, 53526], [61, 53886], [64, 54026], [67, 54146], [72, 54286], [77, 54486], [81, 54626], [88, 54986]]}, {"verse": 11, "start": 56173, "end": 59578, "text": "She sent out her boughs to the sea, and her branches to the river.", "words": [[0, 56173], [4, 56293], [9, 56533], [13, 56733], [17, 56933], [24, 57133], [27, 57373], [31, 57513], [36, 57833], [40, 58233], [44, 58353], [53, 58733], [56, 59013], [60, 59113]]}, {"verse": 12, "start": 60028, "end": 65709, "text": "Why have you then broken down her hedges, so that all they which pass by the way do pluck her?", "words": [[0, 60028], [4, 60197], [9, 60397], [13, 60557], [18, 60777], [25, 61097], [30, 61457], [34, 61677], [42, 62477], [45, 62717], [50, 62897], [54, 63177], [59, 63477], [65, 63777], [70, 64097], [73, 64437], [77, 64597], [81, 64777], [84, 64997], [90, 65337]]}, {"verse": 13, "start": 66159, "end": 71104, "text": "The boar out of the wood does waste it, and the wild beast of the field does devour it.", "words": [[0, 66159], [4, 66272], [9, 66632], [13, 66792], [16, 66892], [20, 66992], [25, 67212], [30, 67492], [36, 67892], [40, 68432], [44, 68652], [48, 68772], [53, 69112], [59, 69392], [62, 69612], [66, 69732], [72, 70072], [77, 70352], [84, 70892]]}, {"verse": 14, "start": 71554, "end": 77864, "text": "Return, we beseech you, O God of hosts: look down from heaven, and behold, and visit this vine;", "words": [[0, 71554], [8, 72120], [11, 72200], [19, 72720], [24, 73020], [26, 73100], [30, 73360], [33, 73520], [40, 74500], [45, 74671], [50, 75011], [55, 75291], [63, 75871], [67, 75951], [75, 76691], [79, 76771], [85, 77031], [90, 77291]]}, {"verse": 15, "start": 78314, "end": 83149, "text": "And the vineyard which your right hand has planted, and the branch that you made strong for yourself.", "words": [[0, 78314], [4, 78421], [8, 78521], [17, 78901], [23, 79101], [28, 79281], [34, 79481], [39, 79781], [43, 79961], [52, 80741], [56, 80821], [60, 80941], [67, 81221], [72, 81461], [76, 81621], [81, 81861], [88, 82261], [92, 82541]]}, {"verse": 16, "start": 83599, "end": 89268, "text": "It is burned with fire, it is cut down: they perish at the rebuke of your countenance.", "words": [[0, 83599], [3, 83707], [6, 83827], [13, 84127], [18, 84387], [24, 8