{"book": "PSA", "chapter": 71, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 166258, "verses": [{"verse": 1, "start": 300, "end": 4729, "text": "En ti, oh Jehová, he esperado; no sea yo confuso para siempre.", "words": [[0, 300], [3, 504], [7, 764], [10, 1024], [18, 1564], [21, 1724], [31, 2745], [34, 2870], [38, 3090], [41, 3290], [49, 3810], [54, 4010]]}, {"verse": 2, "start": 5079, "end": 10430, "text": "Hazme escapar, y líbrame en tu justicia: inclina tu oído y sálvame.", "words": [[0, 5079], [6, 5424], [15, 6044], [17, 6304], [25, 6884], [28, 7044], [31, 7164], [41, 8617], [49, 8967], [52, 9207], [57, 9567], [59, 9707]]}, {"verse": 3, "start": 10780, "end": 20384, "text": "Sé para mí roca de refugio, adonde recurra yo continuamente: has mandado que yo sea salvo; porque tú eres mi roca, y mi fortaleza.", "words": [[0, 10780], [3, 10984], [8, 11164], [11, 11364], [16, 11744], [19, 11864], [28, 12544], [35, 13224], [43, 13944], [46, 14124], [61, 15502], [65, 15802], [73, 16302], [77, 16462], [80, 16642], [84, 16862], [91, 17794], [98, 17978], [101, 18298], [106, 18478], [109, 18698], [115, 19158], [117, 19278], [120, 19418]]}, {"verse": 4, "start": 20734, "end": 26031, "text": "Dios mío, líbrame de la mano del impío, de la mano del perverso y violento.", "words": [[0, 20734], [5, 21099], [10, 21659], [18, 22039], [21, 22239], [24, 22359], [29, 22639], [33, 22819], [40, 23759], [43, 24119], [46, 24219], [51, 24419], [55, 24619], [64, 25179], [66, 25279]]}, {"verse": 5, "start": 26381, "end": 32566, "text": "Porque tú, oh Señor Jehová, eres mi esperanza: seguridad mía desde mi juventud.", "words": [[0, 26381], [7, 26625], [11, 26925], [14, 27225], [20, 27585], [28, 28445], [33, 28805], [36, 29225], [47, 30297], [57, 30860], [61, 31360], [67, 31520], [70, 31740]]}, {"verse": 6, "start": 32916, "end": 42145, "text": "Por ti he sido sustentado desde el vientre: de las entrañas de mi madre tú fuiste el que me sacaste: de ti será siempre mi alabanza.", "words": [[0, 32916], [4, 33040], [7, 33320], [10, 33680], [15, 33940], [26, 34760], [32, 35020], [35, 35480], [44, 36457], [47, 36564], [51, 36704], [60, 37304], [63, 37464], [66, 37584], [72, 37864], [75, 38104], [82, 38584], [85, 38824], [89, 38964], [92, 39104], [101, 40060], [104, 40207], [107, 40447], [112, 40727], [120, 41127], [123, 41387]]}, {"verse": 7, "start": 42495, "end": 46524, "text": "Como prodigio he sido a muchos; y tú mi refugio fuerte.", "words": [[0, 42495], [5, 42699], [14, 43479], [17, 43619], [22, 43859], [24, 44039], [32, 44863], [34, 44990], [37, 45130], [40, 45270], [48, 45850]]}, {"verse": 8, "start": 46874, "end": 50948, "text": "Sea llena mi boca de tu alabanza, de tu gloria todo el día.", "words": [[0, 47116], [4, 47382], [10, 47649], [13, 47829], [18, 48089], [21, 48269], [24, 48739], [34, 49209], [37, 49449], [40, 49589], [47, 50009], [52, 50189], [55, 50449]]}, {"verse": 9, "start": 51298, "end": 57288, "text": "No me deseches en el tiempo de la vejez; cuando mi fuerza se acabe, no me desampares.", "words": [[0, 51298], [3, 51482], [6, 51642], [15, 52282], [18, 52442], [21, 52582], [28, 52942], [31, 53142], [34, 53282], [41, 54191], [48, 54335], [51, 54555], [58, 54895], [61, 55135], [68, 55855], [71, 56155], [74, 56721]]}, {"verse": 10, "start": 57638, "end": 64325, "text": "Porque mis enemigos han tratado de mí; y los que acechan mi alma, consultaron juntamente,", "words": [[0, 57638], [7, 57823], [11, 58063], [20, 58683], [24, 58943], [32, 59603], [35, 59763], [39, 60288], [41, 60392], [45, 60532], [49, 60732], [57, 61232], [60, 61472], [66, 62152], [78, 63232]]}, {"verse": 11, "start": 64675, "end": 70027, "text": "Diciendo: Dios lo ha dejado: perseguid y tomadle, porque no hay quien le libre.", "words": [[0, 64675], [10, 65682], [15, 65944], [18, 66184], [21, 66304], [29, 67055], [39, 67644], [41, 68074], [50, 68504], [57, 68844], [60, 69064], [64, 69224], [70, 69404], [73, 69544]]}, {"verse": 12, "start": 70307, "end": 75233, "text": "Oh Dios, no te alejes de mí: Dios mío, acude pronto a mi socorro.", "words": [[0, 70307], [3, 70494], [9, 70854], [12, 70954], [15, 71114], [22, 71534], [25, 71714], [29, 72250], [34, 72474], [39, 73374], [45, 73754], [52, 74194], [54, 74454], [57, 74534]]}, {"verse": 13, "start": 75583, "end": 84120, "text": "Sean avergonzados, fallezcan los adversarios de mi alma; sean cubiertos de vergüenza y de confusión los que mi mal buscan.", "words": [[0, 75583], [5, 75884], [19, 77264], [29, 77864], [33, 78044], [45, 78844], [48, 79004], [51, 79144], [57, 79878], [62, 80122], [72, 80882], [75, 81062], [85, 81662], [87, 81782], [90, 81882], [100, 82542], [104, 82922], [108, 83082], [111, 83222], [115, 83422]]}, {"verse": 14, "start": 84470, "end": 89161, "text": "Mas yo siempre esperaré, y añadiré sobre toda tu alabanza.", "words": [[0, 84540], [4, 84640], [7, 84820], [15, 85240], [25, 86060], [27, 86720], [35, 87380], [41, 87790], [46, 88200], [49, 88340]]}, {"verse": 15, "start": 89511, "end": 96098, "text": "Mi boca publicará tu justicia y tu salud todo el día, aunque no sé el número de ellas.", "words": [[0, 89511], [3, 89811], [8, 90111], [18, 90851], [21, 91051], [30, 91811], [32, 92031], [35, 92171], [41, 92971], [46, 93291], [49, 93551], [54, 93931], [61, 94111], [64, 94311], [67, 94531], [70, 94851], [77, 95191], [80, 95431]]}, {"verse": 16, "start": 96448, "end": 101883, "text": "Vendré a las valentías del Señor Jehová: haré memoria de sola tu justicia.", "words": [[0, 96448], [7, 96956], [9, 97156], [13, 97296], [23, 98016], [27, 98196], [33, 98496], [41, 99409], [46, 99719], [54, 100179], [57, 100529], [62, 100879], [65, 101019]]}, {"verse": 17, "start": 102233, "end": 108611, "text": "Oh Dios, me enseñaste desde mi juventud; y hasta ahora he manifestado tus maravillas.", "words": [[0, 102291], [3, 102381], [9, 102601], [12, 102861], [22, 103601], [28, 103901], [31, 104161], [41, 105280], [43, 105571], [49, 105791], [55, 106211], [58, 106551], [70, 107491], [74, 107651]]}, {"verse": 18, "start": 108961, "end": 119492, "text": "Y aun hasta la vejez y las canas; oh Dios, no me desampares, hasta que denuncie tu brazo a la posteridad, tus valentías a todos los que han de venir.", "words": [[0, 108961], [2, 109086], [6, 109266], [12, 109546], [15, 109753], [21, 109959], [23, 110166], [27, 110346], [34, 111208], [37, 111376], [43, 112196], [46, 112336], [49, 112476], [61, 113036], [67, 113596], [71, 114156], [80, 114716], [83, 114916], [89, 115336], [91, 115436], [94, 115516], [106, 116416], [110, 116536], [120, 117561], [122, 117641], [128, 117961], [132, 118521], [136, 118701], [140, 118841], [143, 118961]]}, {"verse": 19, "start": 119842, "end": 127671, "text": "Y tu justicia, oh Dios, hasta lo excelso; porque has hecho grandes cosas: oh Dios, ¿quién como tú?", "words": [[0, 119842], [2, 119961], [5, 120081], [15, 120711], [18, 121341], [24, 122141], [30, 122361], [33, 122581], [42, 123746], [49, 123886], [53, 124066], [59, 124246], [67, 124626], [74, 125672], [77, 125837], [83, 126617], [90, 126957], [95, 127197]]}, {"verse": 20, "start": 128021, "end": 136117, "text": "Tú, que me has hecho ver muchas angustias y males, volverás a darme vida, y de nuevo me levantarás de los abismos de la tierra.", "words": [[0, 128021], [4, 128106], [8, 128286], [11, 128446], [15, 128666], [21, 129106], [25, 129366], [32, 129726], [42, 130506], [44, 130666], [51, 131466], [60, 132046], [62, 132166], [68, 132526], [74, 132826], [76, 133071], [79, 133191], [85, 133491], [88, 133731], [99, 134471], [102, 134571], [106, 134691], [114, 135291], [117, 135371], [120, 135491]]}, {"verse": 21, "start": 136467, "end": 139986, "text": "Aumentarás mi grandeza, y volverás a consolarme.", "words": [[0, 136467], [11, 137095], [14, 137235], [24, 137975], [26, 138415], [35, 138915], [37, 139035]]}, {"verse": 22, "start": 140336, "end": 149277, "text": "Asimismo yo te alabaré con instrumento de salterio, oh Dios mío: tu verdad cantaré yo a ti en el arpa, oh Santo de Israel.", "words": [[0, 140654], [9, 140994], [12, 141274], [15, 141454], [23, 141894], [27, 142114], [39, 142934], [42, 143014], [52, 143521], [55, 144027], [60, 144534], [65, 145202], [68, 145288], [75, 145588], [83, 146268], [86, 146528], [88, 146688], [91, 146828], [94, 147028], [97, 147168], [103, 147508], [106, 147848], [112, 148328], [115, 148508]]}, {"verse": 23, "start": 149627, "end": 154713, "text": "Mis labios cantarán cuando a ti cante salmos, y mi alma, a la cual redimiste.", "words": [[0, 149627], [4, 149773], [11, 150233], [20, 150913], [27, 151133], [29, 151453], [32, 151573], [38, 152013], [46, 152693], [48, 153293], [51, 153473], [57, 153773], [59, 154093], [62, 154153], [67, 154433]]}, {"verse": 24, "start": 155063, "end": 165858, "text": "Mi lengua hablará también de tu justicia todo el día: por cuanto fueron avergonzados, porque fueron confusos los que mi mal procuraban.", "words": [[0, 155585], [3, 155725], [10, 156265], [18, 156805], [26, 157125], [29, 157385], [32, 157545], [41, 158165], [46, 158445], [49, 158725], [54, 159393], [58, 159538], [65, 159858], [72, 160258], [86, 162118], [93, 162518], [100, 162818], [109, 163898], [113, 164318], [117, 164478], [120, 164638], [124, 164898]]}]}