{"book": "GEN", "chapter": 36, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 363641, "verses": [{"verse": 1, "start": 300, "end": 4661, "text": "Y estas son las generaciones de Esaú, el cual es Edom.", "words": [[0, 300], [2, 470], [8, 710], [12, 1070], [16, 1250], [29, 2110], [32, 2690], [38, 3270], [41, 3370], [46, 3610], [49, 3990]]}, {"verse": 2, "start": 5111, "end": 15789, "text": "Esaú tomó sus mujeres de las hijas de Canaán: a Ada, hija de Elón heteo, y a Aholibama, hija de Ana, hija de Zibeón el heveo;", "words": [[0, 5325], [5, 5575], [10, 5895], [14, 6015], [22, 6475], [25, 6735], [29, 6895], [35, 7235], [38, 7355], [46, 8495], [48, 8669], [53, 8842], [58, 9342], [61, 9482], [66, 10032], [73, 10582], [75, 11002], [77, 11432], [88, 11862], [93, 12282], [96, 12382], [101, 12622], [106, 13042], [109, 13745], [116, 14447], [119, 15150]]}, {"verse": 3, "start": 16239, "end": 19433, "text": "Y a Basemat, hija de Ismael, hermana de Nebaiot.", "words": [[0, 16239], [2, 16239], [4, 16239], [13, 16239], [18, 16586], [21, 16646], [29, 17586], [37, 18526], [40, 19013]]}, {"verse": 4, "start": 19883, "end": 24935, "text": "Y Ada parió a Esaú a Elifaz; y Basemat parió a Reuel.", "words": [[0, 19883], [2, 20175], [6, 20501], [12, 20828], [14, 21238], [19, 21648], [21, 22224], [29, 23219], [31, 23433], [39, 23646], [45, 24066], [47, 24522]]}, {"verse": 5, "start": 25385, "end": 34877, "text": "Y Aholibama parió a Jeús, y a Jaalam, y a Coré: estos son los hijos de Esaú, que le nacieron en la tierra de Canaán.", "words": [[0, 25385], [2, 25769], [12, 26189], [18, 26709], [20, 26909], [26, 27909], [28, 27969], [30, 28459], [38, 28949], [40, 29189], [42, 29269], [48, 29964], [54, 30562], [58, 30802], [62, 30982], [68, 31282], [71, 31562], [77, 32322], [81, 32522], [84, 32642], [93, 33162], [96, 33462], [99, 33582], [106, 33942], [109, 34436]]}, {"verse": 6, "start": 35327, "end": 55109, "text": "Y Esaú tomó sus mujeres, y sus hijos, y sus hijas, y todas las personas de su casa, y sus ganados, y todas sus bestias, y todo cuanto había adquirido en la tierra de Canaán, y se fue a otra tierra, separándose de Jacob su hermano:", "words": [[0, 35327], [2, 35473], [7, 35993], [12, 36453], [16, 36553], [25, 37113], [27, 38033], [31, 38273], [38, 38713], [40, 39313], [44, 39513], [51, 40453], [53, 40673], [59, 40973], [63, 41293], [72, 41853], [75, 42033], [78, 42213], [84, 42573], [86, 43233], [90, 43673], [99, 44113], [101, 44693], [107, 44893], [111, 45173], [120, 46188], [122, 46312], [127, 46512], [134, 46932], [140, 47452], [150, 48392], [153, 48512], [156, 48672], [163, 49052], [166, 49272], [174, 50352], [176, 50452], [179, 50612], [183, 50912], [185, 51152], [190, 51392], [198, 52432], [210, 53372], [213, 53532], [219, 53952], [222, 54312]]}, {"verse": 7, "start": 55559, "end": 65111, "text": "Porque los bienes de ellos eran muchos, y no podían habitar juntos, ni la tierra donde vivían los podía sostener a causa de sus ganados.", "words": [[0, 55559], [7, 55786], [11, 55986], [18, 56386], [21, 56526], [27, 56726], [32, 57006], [40, 57546], [42, 58246], [45, 58406], [52, 58766], [60, 59166], [68, 59686], [71, 60406], [74, 60586], [81, 60886], [87, 61246], [94, 61906], [98, 62066], [104, 62486], [113, 63246], [115, 63486], [121, 63886], [124, 64106], [128, 64286]]}, {"verse": 8, "start": 65561, "end": 70323, "text": "Y Esaú habitó en el monte de Seir: Esaú es Edom.", "words": [[0, 65876], [2, 66210], [7, 66543], [14, 67223], [17, 67483], [20, 67623], [26, 67983], [29, 68263], [35, 69218], [40, 69218], [43, 69794]]}, {"verse": 9, "start": 70773, "end": 75710, "text": "Estos son los linajes de Esaú, padre de Edom, en el monte de Seir.", "words": [[0, 70773], [6, 71262], [10, 71502], [14, 71682], [22, 72242], [25, 72602], [31, 72962], [37, 73182], [40, 73462], [46, 74162], [49, 74282], [52, 74422], [58, 74722], [61, 74942]]}, {"verse": 10, "start": 76160, "end": 86024, "text": "Estos son los nombres de los hijos de Esaú: Elifaz, hijo de Ada, mujer de Esaú; Reuel, hijo de Basemat, mujer de Esaú.", "words": [[0, 76160], [6, 76610], [10, 76790], [14, 76930], [22, 77470], [25, 77870], [29, 77990], [35, 78270], [38, 78691], [44, 79709], [52, 80104], [57, 80498], [60, 80893], [65, 81288], [71, 81683], [74, 82078], [80, 83157], [87, 83617], [92, 83797], [95, 83977], [104, 84817], [110, 85217], [113, 85649]]}, {"verse": 11, "start": 86474, "end": 91181, "text": "Y los hijos de Elifaz fueron Temán, Omar, Zefo, Gatam, y Cenaz.", "words": [[0, 86474], [2, 86559], [6, 86679], [12, 86979], [15, 87319], [22, 87659], [29, 87919], [36, 88463], [42, 89006], [48, 89550], [55, 90093], [57, 90637]]}, {"verse": 12, "start": 91631, "end": 101268, "text": "Y Timna fue concubina de Elifaz, hijo de Esaú, la cual le parió a Amalec: estos son los hijos de Ada, mujer de Esaú.", "words": [[0, 91631], [2, 92416], [8, 93236], [12, 93806], [22, 94376], [25, 94966], [33, 95556], [38, 95736], [41, 96146], [47, 96556], [50, 96696], [55, 96876], [58, 97056], [64, 97456], [66, 97931], [74, 98651], [80, 98962], [84, 99102], [88, 99262], [94, 99502], [97, 99762], [102, 100262], [108, 100462], [111, 100899]]}, {"verse": 13, "start": 101718, "end": 109993, "text": "Y los hijos de Reuel fueron Nahat, Zera, Sama, y Miza: estos son los hijos de Basemat, mujer de Esaú.", "words": [[0, 101718], [2, 101805], [6, 101925], [12, 102225], [15, 102585], [21, 103065], [28, 103945], [35, 104825], [41, 105705], [47, 106005], [49, 106353], [55, 106945], [61, 107387], [65, 107567], [69, 107727], [75, 108007], [78, 108267], [87, 109027], [93, 109287], [96, 109664]]}, {"verse": 14, "start": 110443, "end": 121799, "text": "Estos fueron los hijos de Aholibama, mujer de Esaú, hija de Ana, que fue hija de Zibeón: ella parió a Esaú a Jeús, Jaalam, y Coré.", "words": [[0, 110443], [6, 110708], [13, 110968], [17, 111228], [23, 111588], [26, 111968], [37, 113288], [43, 113668], [46, 113908], [52, 114908], [57, 115268], [60, 115388], [65, 116168], [69, 116188], [73, 116428], [78, 117008], [81, 117491], [89, 118426], [94, 118660], [100, 118893], [102, 119321], [107, 119749], [109, 120177], [115, 120605], [123, 121033], [125, 121444]]}, {"verse": 15, "start": 122249, "end": 134417, "text": "Estos son los jefes de los hijos de Esaú. Hijos de Elifaz, primogénito de Esaú: el jefe Temán, el jefe Omar, el jefe Zefo, el jefe Cenaz,", "words": [[0, 122249], [6, 122717], [10, 123037], [14, 123297], [20, 123957], [23, 124157], [27, 124297], [33, 124637], [36, 125105], [42, 125808], [48, 126153], [51, 126613], [59, 127073], [71, 127993], [74, 128398], [80, 129045], [83, 129461], [88, 129907], [95, 130354], [98, 130807], [103, 131261], [109, 131714], [112, 132181], [117, 132647], [123, 133114], [126, 133566], [131, 134018]]}, {"verse": 16, "start": 134867, "end": 145511, "text": "El jefe Coré, el jefe Gatam, y el jefe Amalec: estos son los jefes de Elifaz en la tierra de Edom; estos fueron los hijos de Ada.", "words": [[0, 134867], [3, 135036], [8, 135376], [14, 136096], [17, 136316], [22, 136656], [29, 137556], [31, 137816], [34, 137936], [39, 138578], [47, 139457], [53, 139817], [57, 140017], [61, 140197], [67, 140717], [70, 141027], [77, 141337], [80, 141477], [83, 141617], [90, 141977], [93, 142217], [99, 143229], [105, 143709], [112, 143929], [116, 144169], [122, 144469], [125, 144789]]}, {"verse": 17, "start": 145961, "end": 163780, "text": "Y estos son los hijos de Reuel, hijo de Esaú: el jefe Nahat, el jefe Zera, el jefe Sama, y el jefe Miza: estos son los jefes de la línea de Reuel en la tierra de Edom; estos hijos vienen de Basemat, mujer de Esaú.", "words": [[0, 145961], [2, 146138], [8, 146398], [12, 146798], [16, 146978], [22, 147258], [25, 147918], [32, 148578], [37, 148938], [40, 149178], [46, 150210], [49, 150336], [54, 150966], [61, 151596], [64, 151636], [69, 152216], [75, 152796], [78, 152816], [83, 153116], [89, 153516], [91, 154036], [94, 154116], [99, 154662], [105, 155485], [111, 155875], [115, 156095], [119, 156295], [125, 156915], [128, 157015], [131, 157155], [137, 157495], [140, 157855], [146, 158215], [149, 158595], [152, 158755], [159, 159135], [162, 159415], [168, 160342], [174, 160835], [180, 161055], [187, 161395], [190, 161675], [199, 162695], [205, 163015], [208, 163425]]}, {"verse": 18, "start": 164230, "end": 177282, "text": "Y estos son los hijos de Aholibama, mujer de Esaú: el jefe Jeús, el jefe Jaalam, y el jefe Coré: estos fueron los jefes que salieron de Aholibama, mujer de Esaú, hija de Ana.", "words": [[0, 164230], [2, 164526], [8, 164726], [12, 165046], [16, 165306], [22, 165626], [25, 166236], [36, 166846], [42, 167106], [45, 167525], [51, 168187], [54, 168311], [59, 168901], [65, 169491], [68, 169571], [73, 170071], [81, 170571], [83, 171111], [86, 171231], [91, 171591], [97, 172415], [103, 172683], [110, 172943], [114, 173163], [120, 173623], [124, 173683], [133, 174143], [136, 174733], [147, 175323], [153, 175523], [156, 175993], [162, 176463], [167, 176763], [170, 176863]]}, {"verse": 19, "start": 177732, "end": 182651, "text": "Estos, pues, son los hijos de Esaú, y sus jefes: él es Edom.", "words": [[0, 177732], [7, 177996], [13, 178196], [17, 178656], [21, 178816], [27, 179116], [30, 179456], [36, 179796], [38, 180276], [42, 180456], [49, 181540], [52, 181741], [55, 182231]]}, {"verse": 20, "start": 183101, "end": 190819, "text": "Y estos son los hijos de Seir horeo, moradores de aquella tierra: Lotán, Sobal, Zibeón, Ana,", "words": [[0, 183101], [2, 183219], [8, 183479], [12, 183879], [16, 184059], [22, 184379], [25, 184819], [30, 185259], [37, 185699], [47, 186519], [50, 186759], [58, 187059], [66, 188607], [73, 189172], [80, 189737], [88, 190302]]}, {"verse": 21, "start": 191269, "end": 198515, "text": "Disón, Ezer, y Disán: estos son los jefes de los horeos, hijos de Seir en la tierra de Edom.", "words": [[0, 191269], [7, 191746], [13, 192256], [15, 192516], [22, 193450], [28, 193856], [32, 194056], [36, 194276], [42, 194796], [45, 194896], [49, 195506], [57, 196116], [63, 196296], [66, 196606], [71, 196916], [74, 197236], [77, 197396], [84, 197736], [87, 197996]]}, {"verse": 22, "start": 198965, "end": 204167, "text": "Los hijos de Lotán fueron Hori y Hemán; y Timna fue hermana de Lotán.", "words": [[0, 198965], [4, 199092], [10, 199412], [13, 199732], [19, 200052], [26, 200502], [31, 200952], [33, 201393], [40, 202093], [42, 202239], [48, 202739], [52, 202979], [60, 203399], [63, 203809]]}, {"verse": 23, "start": 204617, "end": 210360, "text": "Y los hijos de Sobal fueron Alván, Manahat, Ebal, Sefo, y Onán.", "words": [[0, 204617], [2, 204739], [6, 204879], [12, 205179], [15, 205459], [21, 205739], [28, 206539], [35, 207339], [44, 208139], [50, 208939], [56, 209379], [58, 209779]]}, {"verse": 24, "start": 210810, "end": 222134, "text": "Y los hijos de Zibeón fueron Aja, y Ana. Este Ana es el que descubrió los mulos en el desierto, cuando apacentaba los asnos de Zibeón su padre.", "words": [[0, 210810], [2, 210917], [6, 211057], [12, 211337], [15, 211687], [22, 212037], [29, 212610], [34, 213183], [36, 213755], [41, 214566], [46, 214850], [50, 215230], [53, 215770], [56, 215930], [60, 216090], [70, 216650], [74, 216790], [80, 217250], [83, 217410], [86, 217550], [96, 218170], [103, 218750], [114, 219610], [118, 219850], [124, 220410], [127, 220890], [134, 221370], [137, 221470]]}, {"verse": 25, "start": 222584, "end": 226910, "text": "Los hijos de Ana fueron Disón, y Aholibama, hija de Ana.", "words": [[0, 222584], [4, 222687], [10, 222987], [13, 223227], [17, 223387], [24, 223667], [31, 224327], [33, 225197], [44, 226067], [49, 226347], [52, 226467]]}, {"verse": 26, "start": 227360, "end": 232576, "text": "Y estos fueron los hijos de Disón: Hemdán, Eshbán, Itrán, y Querán.", "words": [[0, 227360], [2, 227516], [8, 227776], [15, 228136], [19, 228376], [25, 228676], [28, 228916], [35, 230191], [43, 230486], [51, 230781], [58, 231076], [60, 231826]]}, {"verse": 27, "start": 233026, "end": 237228, "text": "Y estos fueron los hijos de Ezer: Bilhán, Zaaván, y Acán.", "words": [[0, 233026], [2, 233135], [8, 233315], [15, 233575], [19, 233775], [25, 234075], [28, 234451], [34, 235391], [42, 235737], [50, 236084], [52, 236384]]}, {"verse": 28, "start": 237678, "end": 240905, "text": "Estos fueron los hijos de Disán: Huz, y Arán.", "words": [[0, 237678], [6, 237678], [13, 237852], [17, 238072], [23, 238352], [26, 238672], [33, 240230], [38, 240477], [40, 240723]]}, {"verse": 29, "start": 241355, "end": 249622, "text": "Y estos fueron los jefes de los horeos: el jefe Lotán, el jefe Sobal, el jefe Zibeón, el jefe Ana,", "words": [[0, 241355], [2, 241517], [8, 241777], [15, 242197], [19, 242437], [25, 242877], [28, 242977], [32, 243468], [40, 244209], [43, 244355], [48, 244635], [55, 245695], [58, 245775], [63, 246455], [70, 247135], [73, 247155], [78, 247905], [86, 248655], [89, 248735], [94, 249055]]}, {"verse": 30, "start": 250072, "end": 260031, "text": "El jefe Disón, el jefe Ezer, el jefe Disán: estos fueron los jefes de los horeos: por sus ducados en la tierra de Seir.", "words": [[0, 250072], [3, 250201], [8, 250811], [15, 251421], [18, 251661], [23, 252441], [29, 253221], [32, 253281], [37, 254034], [44, 255033], [50, 255382], [57, 255642], [61, 255882], [67, 256322], [70, 256422], [74, 256894], [82, 257582], [86, 257707], [90, 257907], [98, 258467], [101, 258687], [104, 258807], [111, 259147], [114, 259367]]}, {"verse": 31, "start": 260481, "end": 268385, "text": "Y los reyes que reinaron en la tierra de Edom, antes que reinase rey sobre los hijos de Israel, fueron estos:", "words": [[0, 260481], [2, 260605], [6, 260745], [12, 261145], [16, 261345], [25, 261965], [28, 262165], [31, 262285], [38, 262625], [41, 262865], [47, 263725], [53, 264185], [57, 264405], [65, 265025], [69, 265345], [75, 265545], [79, 265785], [85, 266065], [88, 266265], [96, 266825], [103, 267025]]}, {"verse": 32, "start": 268835, "end": 274359, "text": "Bela, hijo de Beor, reinó en Edom: y el nombre de su ciudad fue Dinaba.", "words": [[0, 268835], [6, 268835], [11, 269120], [14, 269600], [20, 270080], [26, 270560], [29, 270880], [35, 271743], [37, 271908], [40, 272088], [47, 272508], [50, 272728], [53, 272928], [60, 273368], [64, 273628]]}, {"verse": 33, "start": 274809, "end": 280725, "text": "Y murió Bela, y reinó en su lugar Jobab, hijo de Zera, de Bosra.", "words": [[0, 274809], [2, 274935], [8, 275535], [14, 276135], [16, 276415], [22, 277075], [25, 277195], [28, 277355], [34, 278125], [41, 278895], [46, 279195], [49, 279635], [55, 280075], [58, 280427]]}, {"verse": 34, "start": 281175, "end": 286963, "text": "Y murió Jobab, y en su lugar reinó Husam, de tierra de Temán.", "words": [[0, 281175], [2, 281296], [8, 281986], [15, 282676], [17, 282976], [20, 283156], [23, 283416], [29, 284069], [35, 284723], [42, 285376], [45, 285596], [52, 286076], [55, 286316]]}, {"verse": 35, "start": 287413, "end": 297766, "text": "Y murió Husam, y reinó en su lugar Adad, hijo de Badad, el que hirió a Madián en el campo de Moab: y el nombre de su ciudad fue Avit.", "words": [[0, 287413], [2, 287577], [8, 288047], [15, 288517], [17, 289177], [23, 289617], [26, 289817], [29, 289997], [35, 290337], [41, 291117], [46, 291337], [49, 291557], [56, 292077], [59, 292217], [63, 292547], [69, 292877], [71, 293167], [78, 293457], [81, 293657], [84, 293777], [90, 294057], [93, 294337], [99, 295233], [101, 295380], [104, 295500], [111, 295900], [114, 296100], [117, 296280], [124, 296700], [128, 297260]]}, {"verse": 36, "start": 298216, "end": 303522, "text": "Y murió Adad, y en su lugar reinó Samla, de Masreca.", "words": [[0, 298216], [2, 298377], [8, 299057], [14, 299737], [16, 300017], [19, 300217], [22, 300457], [28, 300797], [34, 301277], [41, 301917], [44, 302751]]}, {"verse": 37, "start": 303972, "end": 309536, "text": "Y murió Samla, y reinó en su lugar Saúl, de Rehobot del Río.", "words": [[0, 303972], [2, 304119], [8, 304589], [15, 305059], [17, 305519], [23, 306039], [26, 306159], [29, 306339], [35, 306659], [41, 307479], [44, 308009], [52, 308539], [56, 308859]]}, {"verse": 38, "start": 309986, "end": 315605, "text": "Y murió Saúl, y en lugar suyo reinó Baal-hanán, hijo de Acbor.", "words": [[0, 309986], [2, 310111], [8, 310411], [14, 311331], [16, 311591], [19, 311731], [25, 312011], [30, 312818], [36, 313624], [48, 314431], [53, 314791], [56, 315227]]}, {"verse": 39, "start": 316055, "end": 329810, "text": "Y murió Baal-hanán, hijo de Acbor, y reinó Adar en lugar suyo: y el nombre de su ciudad fue Pau; y el nombre de su mujer Mehetabel, hija de Matred, hija de Mezaab.", "words": [[0, 316055], [2, 316315], [8, 317045], [20, 317775], [25, 318115], [28, 318675], [35, 319235], [37, 319335], [43, 319785], [48, 320235], [51, 320455], [57, 320735], [63, 321850], [65, 321977], [68, 322077], [75, 322457], [78, 322657], [81, 322877], [88, 323357], [92, 323697], [97, 324710], [99, 324841], [102, 324961], [109, 325301], [112, 325501], [115, 325701], [121, 326501], [132, 327301], [137, 327661], [140, 327741], [148, 328621], [153, 328941], [156, 329409]]}, {"verse": 40, "start": 330260, "end": 341554, "text": "Estos, pues, son los nombres de los jefes de Esaú por sus linajes, por sus lugares, y sus nombres: el jefe Timna, el jefe Alva, el jefe Jetet,", "words": [[0, 330435], [7, 330645], [13, 331265], [17, 331605], [21, 331785], [29, 332265], [32, 332445], [36, 332565], [42, 332965], [45, 333285], [50, 333605], [54, 333705], [58, 333925], [67, 334985], [71, 335105], [75, 335535], [84, 335965], [86, 336185], [90, 336345], [99, 337350], [102, 337566], [107, 337806], [114, 338926], [117, 339439], [122, 339953], [128, 340466], [131, 340829], [136, 341191]]}, {"verse": 41, "start": 342004, "end": 345996, "text": "El duque Aholibama, el duque Ela, el duque Pinón,", "words": [[0, 342004], [3, 342211], [9, 342971], [20, 343731], [23, 344051], [29, 344431], [34, 344951], [37, 344971], [43, 345271]]}, {"verse": 42, "start": 346446, "end": 350264, "text": "El duque Cenaz, el duque Temán, el duque Mibzar,", "words": [[0, 346446], [3, 346588], [9, 347228], [16, 347868], [19, 347948], [25, 348248], [32, 349068], [35, 349148], [41, 349706]]}, {"verse": 43, "start": 350714, "end": 363241, "text": "El jefe Magdiel, y el jefe Hiram. Estos fueron los jefes de Edom por sus habitaciones en la tierra de su posesión. Edom es el mismo Esaú, padre de los edomitas.", "words": [[0, 350714], [3, 351161], [8, 351607], [17, 352054], [19, 352314], [22, 352702], [27, 353090], [34, 353754], [40, 354099], [47, 354359], [51, 354579], [57, 355039], [60, 355309], [65, 355579], [69, 355759], [73, 355939], [86, 356679], [89, 356899], [92, 357039], [99, 357379], [102, 357559], [105, 357739], [115, 358834], [120, 359260], [123, 359720], [126, 360020], [132, 360760], [138, 361500], [144, 362020], [147, 362160], [151, 362300]]}]}