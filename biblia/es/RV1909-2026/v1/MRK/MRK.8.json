{"book": "MRK", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 296227, "verses": [{"verse": 1, "start": 300, "end": 8248, "text": "En aquellos días, cuando hubo gran multitud, y no tenían qué comer, Jesús llamó a sus discípulos, y les dijo:", "words": [[0, 300], [3, 407], [12, 647], [18, 1667], [25, 1827], [30, 2247], [35, 2487], [45, 3247], [47, 3472], [50, 3732], [57, 3992], [61, 4212], [68, 4987], [74, 5367], [80, 6187], [82, 6267], [86, 6447], [98, 7307], [100, 7527], [104, 7687]]}, {"verse": 2, "start": 8598, "end": 15002, "text": "Tengo compasión de la multitud, porque ya hace tres días que están conmigo, y no tienen qué comer:", "words": [[0, 8598], [6, 8840], [16, 9500], [19, 9640], [22, 9740], [32, 10380], [39, 10960], [42, 11300], [47, 11680], [52, 11960], [57, 12320], [61, 12520], [67, 12720], [76, 13580], [78, 13780], [81, 13970], [88, 14160], [92, 14400]]}, {"verse": 3, "start": 15352, "end": 22903, "text": "Y si los envío en ayunas a sus casas, desmayarán en el camino; porque algunos de ellos han venido de lejos.", "words": [[0, 15352], [2, 15631], [5, 15751], [9, 15911], [15, 16411], [18, 16511], [25, 16991], [27, 17111], [31, 17251], [38, 17871], [49, 19011], [52, 19271], [55, 19411], [63, 20236], [70, 20440], [78, 20860], [81, 21080], [87, 21340], [91, 21580], [98, 22040], [101, 22180]]}, {"verse": 4, "start": 23253, "end": 29646, "text": "Y sus discípulos le respondieron: ¿De dónde podrá alguien hartar a estos de pan aquí en el desierto?", "words": [[0, 23253], [2, 23360], [6, 23540], [17, 24340], [20, 24560], [34, 25941], [38, 26117], [44, 26317], [50, 26797], [58, 27037], [65, 27497], [67, 27577], [73, 27777], [76, 27997], [80, 28257], [85, 28557], [88, 28857], [91, 28957]]}, {"verse": 5, "start": 29926, "end": 35027, "text": "Y les preguntó: ¿Cuántos panes tenéis? Y ellos dijeron: Siete.", "words": [[0, 29926], [2, 30069], [6, 30149], [16, 31382], [25, 31768], [31, 32188], [39, 33127], [41, 33295], [47, 33495], [56, 34735]]}, {"verse": 6, "start": 35307, "end": 49432, "text": "Entonces mandó a la multitud que se recostase en tierra; y tomando los siete panes, habiendo dado gracias, partió, y dio a sus discípulos que los pusiesen delante: y los pusieron delante a la multitud.", "words": [[0, 35307], [9, 35887], [15, 36747], [17, 36827], [20, 36927], [29, 37487], [33, 37667], [36, 37807], [46, 38447], [49, 38667], [57, 39568], [59, 39676], [67, 40096], [71, 40256], [77, 40556], [84, 41436], [93, 41776], [98, 42016], [107, 42936], [115, 43436], [117, 44076], [121, 44316], [123, 44556], [127, 44756], [138, 45656], [142, 45836], [146, 46196], [155, 46556], [164, 47413], [166, 47516], [170, 47616], [179, 48056], [187, 48556], [189, 48676], [192, 48736]]}, {"verse": 7, "start": 49782, "end": 55729, "text": "Tenían también unos pocos pececillos: y los bendijo, y mandó que también los pusiesen delante.", "words": [[0, 49782], [7, 50046], [15, 50426], [20, 50665], [26, 51375], [38, 52253], [40, 52340], [44, 52460], [53, 53500], [55, 53580], [61, 53900], [65, 54000], [73, 54320], [77, 54460], [86, 54920]]}, {"verse": 8, "start": 56079, "end": 62527, "text": "Y comieron, y se saciaron: y levantaron de los pedazos que habían sobrado, siete canastas.", "words": [[0, 56079], [2, 56186], [12, 56586], [14, 56786], [17, 56886], [27, 57939], [29, 58064], [40, 58724], [43, 58924], [47, 59064], [55, 60084], [59, 60304], [66, 60544], [75, 61144], [81, 61464]]}, {"verse": 9, "start": 62877, "end": 66850, "text": "Y eran los que comieron, como cuatro mil: y los despidió.", "words": [[0, 62877], [2, 63173], [7, 63373], [11, 63573], [15, 63733], [25, 64173], [30, 64656], [37, 65140], [42, 65789], [44, 65929], [48, 66050]]}, {"verse": 10, "start": 67200, "end": 72893, "text": "Y luego entrando en el barco con sus discípulos, vino a las partes de Dalmanutha.", "words": [[0, 67200], [2, 67341], [8, 67521], [17, 68161], [20, 68321], [23, 68461], [29, 68921], [33, 69141], [37, 69341], [49, 70541], [54, 71021], [56, 71241], [60, 71361], [67, 71781], [70, 72357]]}, {"verse": 11, "start": 73243, "end": 80849, "text": "Y vinieron los fariseos, y comenzaron a discutir con él, pidiéndole señal del cielo, poniéndolo a prueba.", "words": [[0, 73243], [2, 73364], [11, 73804], [15, 74004], [25, 74864], [27, 75264], [38, 76024], [40, 76144], [49, 76724], [53, 76904], [57, 77604], [68, 78164], [74, 78624], [78, 78744], [85, 79524], [96, 80144], [98, 80264]]}, {"verse": 12, "start": 81199, "end": 90484, "text": "Y gimiendo en su espíritu, dice: ¿Por qué pide señal esta generación? De cierto os digo que no se dará señal a esta generación.", "words": [[0, 81199], [2, 81542], [11, 81902], [14, 82022], [17, 82202], [27, 83002], [33, 83789], [38, 83914], [42, 84094], [47, 84434], [53, 84934], [58, 85134], [70, 86403], [73, 86569], [80, 87129], [83, 87229], [88, 87509], [92, 87749], [95, 87929], [98, 88109], [103, 88449], [109, 88969], [111, 89129], [116, 89449]]}, {"verse": 13, "start": 90834, "end": 95581, "text": "Y dejándolos, volvió a entrar en el barco, y se fue de la otra parte.", "words": [[0, 90834], [2, 90956], [14, 91756], [21, 92376], [23, 92436], [30, 92796], [33, 93056], [36, 93176], [43, 93716], [45, 94136], [48, 94276], [52, 94476], [55, 94596], [58, 94716], [63, 94896]]}, {"verse": 14, "start": 95931, "end": 101392, "text": "Y se habían olvidado de tomar pan, y no tenían sino un pan consigo en el barco.", "words": [[0, 95931], [2, 96049], [5, 96149], [12, 96349], [21, 97009], [24, 97189], [30, 97469], [35, 97809], [37, 98289], [40, 98429], [47, 98829], [52, 99249], [55, 99609], [59, 99909], [67, 100469], [70, 100709], [73, 100849]]}, {"verse": 15, "start": 101742, "end": 108947, "text": "Y les advirtió, diciendo: Mirad, guardaos de la levadura de los fariseos, y de la levadura de Herodes.", "words": [[0, 101742], [2, 101887], [6, 102087], [16, 102827], [26, 103757], [33, 104582], [42, 105222], [45, 105402], [48, 105542], [57, 106042], [60, 106202], [64, 106322], [74, 107102], [76, 107322], [79, 107442], [82, 107582], [91, 108082], [94, 108262]]}, {"verse": 16, "start": 109297, "end": 112045, "text": "Y discutían entre sí porque no tenían pan.", "words": [[0, 109297], [2, 109725], [12, 110306], [18, 110546], [21, 110806], [28, 111046], [31, 111246], [38, 111526]]}, {"verse": 17, "start": 112325, "end": 122310, "text": "Y como Jesús lo entendió, les dice: ¿Por qué discutís, porque no tenéis pan? ¿no consideráis ni entendéis? ¿aún tenéis endurecido vuestro corazón?", "words": [[0, 112325], [2, 112446], [7, 112706], [13, 113066], [16, 113366], [26, 114366], [30, 114586], [36, 115373], [41, 115477], [45, 115657], [55, 116217], [62, 116437], [65, 116657], [72, 117017], [77, 117708], [81, 117816], [93, 118576], [96, 118716], [107, 119906], [112, 120090], [119, 120510], [130, 121150], [138, 121490]]}, {"verse": 18, "start": 122660, "end": 127967, "text": "¿Teniendo ojos no veis, y teniendo oídos no oís? ¿y no os acordáis?", "words": [[0, 122660], [10, 123064], [15, 123364], [18, 123624], [24, 124024], [26, 124204], [35, 124704], [41, 125444], [44, 125764], [49, 126634], [52, 126763], [55, 126903], [58, 127043]]}, {"verse": 19, "start": 128317, "end": 137382, "text": "Cuando partí los cinco panes entre cinco mil, ¿cuántas cestas llenas de los pedazos recogisteis? Y ellos dijeron: Doce.", "words": [[0, 128317], [7, 128499], [13, 128999], [17, 129119], [23, 129439], [29, 129979], [35, 130179], [41, 130659], [46, 131319], [55, 132049], [62, 132669], [69, 133089], [72, 133229], [76, 133349], [84, 134049], [97, 135525], [99, 135693], [105, 135893], [114, 137109]]}, {"verse": 20, "start": 137662, "end": 145595, "text": "Y cuando los siete panes entre cuatro mil, ¿cuántas canastas llenas de los pedazos recogisteis? Y ellos dijeron: Siete.", "words": [[0, 137662], [2, 137765], [9, 137965], [13, 138225], [19, 138585], [25, 139165], [31, 139405], [38, 139705], [43, 140165], [52, 140760], [61, 141420], [68, 141740], [71, 141840], [75, 141960], [83, 142420], [96, 143695], [98, 143863], [104, 144063], [113, 145303]]}, {"verse": 21, "start": 145875, "end": 148735, "text": "Y les dijo: ¿Cómo aún no entendéis?", "words": [[0, 145875], [2, 146023], [6, 146163], [12, 146898], [18, 147285], [22, 147525], [25, 147765]]}, {"verse": 22, "start": 149085, "end": 153924, "text": "Y vino a Betsaida; y le traen un ciego, y le ruegan que le tocase.", "words": [[0, 149085], [2, 149211], [7, 149471], [9, 149920], [19, 150550], [21, 150662], [24, 150742], [30, 151182], [33, 151322], [40, 151862], [42, 152342], [45, 152462], [52, 152882], [56, 153042], [59, 153142]]}, {"verse": 23, "start": 154274, "end": 164760, "text": "Entonces, tomando la mano del ciego, le sacó fuera de la aldea; y escupiendo en sus ojos, y poniéndole las manos encima, le preguntó si veía algo.", "words": [[0, 154274], [10, 154794], [18, 155414], [21, 155534], [26, 155754], [30, 155954], [37, 156454], [40, 156914], [45, 157294], [51, 157574], [54, 157754], [57, 157914], [64, 158906], [66, 159049], [77, 159769], [80, 159929], [84, 160089], [90, 160529], [92, 160804], [103, 161177], [107, 161551], [113, 161924], [121, 162484], [124, 163024], [133, 163604], [136, 163764], [141, 164164]]}, {"verse": 24, "start": 165110, "end": 170475, "text": "Y él mirando, dijo: Veo a los hombres; parecen árboles que caminan.", "words": [[0, 165110], [2, 165298], [5, 165518], [14, 166258], [20, 167026], [24, 167402], [26, 167502], [30, 167642], [39, 168568], [47, 169012], [55, 169592], [59, 169772]]}, {"verse": 25, "start": 170755, "end": 180322, "text": "Luego le puso otra vez las manos sobre sus ojos, y le hizo que mirase; y fue restablecido, y vio a todos de lejos y con claridad.", "words": [[0, 170755], [6, 170978], [9, 171258], [14, 171718], [19, 171978], [23, 172338], [27, 172618], [33, 173098], [39, 173498], [43, 173738], [49, 174138], [51, 174838], [54, 174978], [59, 175238], [63, 175696], [71, 176315], [73, 176419], [77, 176579], [91, 177559], [93, 177939], [97, 178179], [99, 178279], [105, 178519], [108, 178739], [114, 179159], [116, 179379], [120, 179559]]}, {"verse": 26, "start": 180672, "end": 187484, "text": "Y le envió a su casa, diciendo: No entres en la aldea, ni lo digas a nadie en la aldea.", "words": [[0, 180672], [2, 180791], [5, 180891], [11, 181171], [13, 181291], [16, 181391], [22, 181731], [32, 182688], [35, 182932], [42, 183752], [45, 184132], [48, 184352], [55, 184932], [58, 185392], [61, 185592], [67, 185952], [69, 186072], [75, 186392], [78, 186632], [81, 186832]]}, {"verse": 27, "start": 187834, "end": 199423, "text": "Y salió Jesús y sus discípulos por las aldeas de Cesarea de Filipo. Y en el camino preguntó a sus discípulos, diciéndoles: ¿Quién dicen los hombres que soy yo?", "words": [[0, 187834], [2, 187959], [8, 188299], [14, 188839], [16, 189379], [20, 189599], [31, 190379], [35, 190579], [39, 190779], [46, 191219], [49, 191589], [57, 191959], [60, 192364], [68, 192935], [70, 193097], [73, 193227], [76, 193357], [83, 193857], [92, 194457], [94, 194557], [98, 194717], [110, 195937], [123, 197305], [130, 197609], [136, 197949], [140, 198169], [148, 198549], [152, 198749], [156, 198949]]}, {"verse": 28, "start": 199773, "end": 206217, "text": "Y ellos respondieron: Juan Bautista; y otros, Elías; y otros, Alguno de los profetas.", "words": [[0, 199773], [2, 200058], [8, 200258], [22, 201457], [27, 201720], [37, 202820], [39, 202982], [46, 203262], [53, 204320], [55, 204444], [62, 204804], [69, 205164], [72, 205344], [76, 205444]]}, {"verse": 29, "start": 206497, "end": 215755, "text": "Entonces él les dice: Y vosotros, ¿quién decís que soy yo? Y respondiendo Pedro, le dice: Tú eres el Cristo.", "words": [[0, 206497], [9, 207484], [12, 207727], [16, 208047], [22, 208960], [24, 209068], [34, 209888], [41, 210168], [47, 210588], [51, 210708], [55, 210948], [59, 211638], [61, 211748], [74, 212848], [81, 213188], [84, 213788], [90, 214589], [93, 214733], [98, 214973], [101, 215173]]}, {"verse": 30, "start": 216035, "end": 218666, "text": "Y les mandó que no hablasen de él a ninguno.", "words": [[0, 216035], [2, 216156], [6, 216276], [12, 216696], [16, 216836], [19, 217166], [28, 217496], [31, 217656], [34, 217876], [36, 217956]]}, {"verse": 31, "start": 219016, "end": 233154, "text": "Y comenzó a enseñarles, que convenía que el Hijo del hombre padeciese mucho, fuese rechazado por los ancianos, los principales sacerdotes y los escribas, fuera muerto y resucitara después de tres días.", "words": [[0, 219016], [2, 219140], [10, 219640], [12, 219720], [24, 220500], [28, 220960], [37, 221580], [41, 221740], [44, 222000], [49, 222260], [53, 222400], [60, 222890], [70, 223380], [77, 224280], [83, 224720], [93, 225860], [97, 226060], [101, 226260], [111, 227360], [115, 227460], [127, 228220], [138, 228920], [140, 229080], [144, 229200], [154, 230241], [160, 230503], [167, 231043], [169, 231123], [180, 231863], [188, 232163], [191, 232383], [196, 232583]]}, {"verse": 32, "start": 233504, "end": 240063, "text": "Y claramente decía esta palabra. Entonces Pedro le tomó, y le comenzó a reprender.", "words": [[0, 233504], [2, 233631], [13, 234291], [19, 234811], [24, 235151], [33, 236094], [42, 236636], [48, 237081], [51, 237361], [57, 237861], [59, 238181], [62, 238321], [70, 238981], [72, 239181]]}, {"verse": 33, "start": 240413, "end": 253381, "text": "Y él, volviéndose y mirando a sus discípulos, reprendió a Pedro, diciendo: Apártate de mí, Satanás; porque no pones la mira en las cosas de Dios, sino en las que son de los hombres.", "words": [[0, 240413], [2, 240561], [6, 240701], [18, 241581], [20, 241801], [28, 242221], [30, 242341], [34, 242561], [46, 243681], [56, 244381], [58, 244481], [65, 244821], [75, 246109], [84, 246850], [87, 247010], [91, 247170], [100, 248347], [107, 248551], [110, 248771], [116, 249151], [119, 249331], [124, 249611], [127, 249831], [131, 249991], [137, 250291], [140, 250531], [146, 251111], [151, 251431], [154, 251631], [158, 251791], [162, 251971], [166, 252251], [169, 252431], [173, 252591]]}, {"verse": 34, "start": 253731, "end": 263764, "text": "Y llamando a la gente con sus discípulos, les dijo: Si alguno quiere venir en pos de mí, niéguese a sí mismo, y tome su cruz, y sígame.", "words": [[0, 253731], [2, 253837], [11, 254357], [13, 254457], [16, 254517], [22, 254857], [26, 255117], [30, 255357], [42, 256377], [46, 256497], [52, 257286], [55, 257433], [62, 257853], [69, 258073], [75, 258453], [78, 258653], [82, 258873], [85, 259053], [89, 259793], [98, 260553], [100, 260733], [103, 260833], [110, 261273], [112, 261538], [117, 261898], [120, 262038], [126, 262958], [128, 263078]]}, {"verse": 35, "start": 264114, "end": 273077, "text": "Porque todo el que quiera salvar su vida, la perderá; y todo el que pierda su vida por causa de mí y del evangelio, la salvará.", "words": [[0, 264114], [7, 264358], [12, 264758], [15, 264998], [19, 265158], [26, 265478], [33, 265858], [36, 266138], [42, 266498], [45, 267158], [54, 268248], [56, 268371], [61, 268691], [64, 268951], [68, 269091], [75, 269571], [78, 269751], [83, 270071], [87, 270291], [93, 270611], [96, 270911], [99, 271091], [101, 271331], [105, 271471], [116, 272171], [119, 272371]]}, {"verse": 36, "start": 273427, "end": 278272, "text": "Porque ¿qué aprovechará al hombre, si gana todo el mundo, y pierde su alma?", "words": [[0, 273561], [7, 273731], [12, 273951], [24, 274771], [27, 274911], [35, 275211], [38, 275511], [43, 275811], [48, 276011], [51, 276211], [58, 276551], [60, 276991], [67, 277471], [70, 277671]]}, {"verse": 37, "start": 278622, "end": 281873, "text": "¿O qué dará el hombre a cambio de su alma?", "words": [[0, 278622], [3, 278763], [7, 278963], [12, 279403], [15, 279623], [22, 279983], [24, 280243], [31, 280663], [34, 280923], [37, 281143]]}, {"verse": 38, "start": 282223, "end": 295827, "text": "Porque el que se avergüence de mí y de mis palabras en esta generación adúltera y pecadora, el Hijo del hombre se avergonzará también de él, cuando venga en la gloria de su Padre con los santos ángeles.", "words": [[0, 282223], [7, 282485], [10, 282765], [14, 282925], [17, 283345], [28, 283765], [31, 283985], [34, 284265], [36, 284485], [39, 284625], [43, 284745], [52, 285225], [55, 285545], [60, 285805], [71, 286485], [80, 287165], [82, 287325], [92, 288545], [95, 288685], [100, 288965], [104, 289145], [111, 289565], [114, 289925], [126, 290705], [134, 291005], [137, 291325], [141, 291942], [148, 292124], [154, 292604], [157, 292724], [160, 292864], [167, 293244], [170, 293404], [173, 293564], [179, 294144], [183, 294304], [187, 294504], [194, 295004]]}]}