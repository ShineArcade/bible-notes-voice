{"book": "GEN", "chapter": 5, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 187831, "verses": [{"verse": 1, "start": 300, "end": 7635, "text": "This is the book of the generations of Adam. In the day that God created man, in the likeness of God made he him;", "words": [[0, 300], [5, 523], [8, 683], [12, 843], [17, 1123], [20, 1283], [24, 1383], [36, 1983], [39, 2283], [45, 3114], [48, 3238], [52, 3338], [56, 3598], [61, 3798], [65, 4058], [73, 4558], [78, 5398], [81, 5558], [85, 5678], [94, 6138], [97, 6258], [101, 6558], [106, 6838], [109, 7058]]}, {"verse": 2, "start": 8085, "end": 14964, "text": "Male and female created he them; and blessed them, and called their name Adam, in the day when they were created.", "words": [[0, 8085], [5, 8372], [9, 8652], [16, 9032], [24, 9572], [27, 9852], [33, 10754], [37, 10885], [45, 11225], [51, 11605], [55, 11805], [62, 12085], [68, 12305], [73, 12565], [79, 13125], [82, 13605], [86, 13745], [90, 13905], [95, 14105], [100, 14245], [105, 14385]]}, {"verse": 3, "start": 15414, "end": 22781, "text": "¶ And Adam lived a hundred and thirty years, and begot a son in his own likeness, after his image; and called his name Seth:", "words": [[2, 15414], [6, 15560], [11, 15900], [17, 16104], [19, 16308], [27, 16512], [31, 16716], [38, 16920], [45, 17460], [49, 18040], [55, 18360], [57, 18460], [61, 18720], [64, 18880], [68, 19040], [72, 19240], [82, 19820], [88, 20140], [92, 20380], [99, 21186], [103, 21311], [110, 21611], [114, 21871], [119, 22211]]}, {"verse": 4, "start": 23231, "end": 29198, "text": "And the days of Adam after he had begotten Seth were eight hundred years: and he begot sons and daughters:", "words": [[0, 23231], [4, 23373], [8, 23473], [13, 23753], [16, 23913], [21, 24233], [27, 24533], [30, 24753], [34, 24873], [43, 25333], [48, 25593], [53, 25826], [59, 26060], [67, 26293], [74, 27401], [78, 27508], [81, 27588], [87, 27948], [92, 28308], [96, 28548]]}, {"verse": 5, "start": 29648