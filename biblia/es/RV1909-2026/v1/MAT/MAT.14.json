{"book": "MAT", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 267137, "verses": [{"verse": 1, "start": 300, "end": 4614, "text": "En aquel tiempo Herodes el tetrarca oyó la fama de Jesús,", "words": [[0, 300], [3, 424], [9, 724], [16, 1260], [24, 1796], [27, 2333], [36, 2869], [40, 3349], [43, 3489], [48, 3869], [51, 3949]]}, {"verse": 2, "start": 4964, "end": 13360, "text": "Y dijo a sus criados: Este es Juan el Bautista: él ha resucitado de los muertos, y por eso actúan en él poderes milagrosos.", "words": [[0, 4964], [2, 5244], [7, 5544], [9, 5724], [13, 5844], [22, 7002], [27, 7286], [30, 7526], [35, 7786], [38, 7986], [48, 8913], [51, 9092], [54, 9252], [65, 9932], [68, 10072], [72, 10192], [81, 10692], [83, 10917], [87, 11097], [91, 11297], [98, 11857], [101, 11957], [104, 12117], [112, 12557]]}, {"verse": 3, "start": 13640, "end": 23123, "text": "Porque Herodes había prendido a Juan, y le había aprisionado y puesto en la cárcel, por causa de Herodías, mujer de Felipe su hermano;", "words": [[0, 13640], [7, 13906], [15, 14466], [21, 15006], [30, 15546], [32, 15646], [38, 15966], [40, 16506], [43, 16626], [49, 16906], [61, 17826], [63, 17946], [70, 18426], [73, 18646], [76, 18766], [84, 19286], [88, 19666], [94, 19946], [97, 20246], [107, 21386], [113, 21646], [116, 21886], [123, 22226], [126, 22486]]}, {"verse": 4, "start": 23473, "end": 26914, "text": "Porque Juan le decía: No te es lícito tenerla.", "words": [[0, 23473], [7, 23674], [12, 24034], [15, 24454], [22, 25316], [25, 25518], [28, 25771], [31, 26025], [38, 26278]]}, {"verse": 5, "start": 27194, "end": 32122, "text": "Y quería matarle, pero temía al pueblo; porque le tenían como a profeta.", "words": [[0, 27194], [2, 27312], [9, 27572], [18, 28412], [23, 28532], [29, 29032], [32, 29212], [40, 30129], [47, 30336], [50, 30496], [57, 30876], [62, 31304], [64, 31732]]}, {"verse": 6, "start": 32472, "end": 40790, "text": "Pero celebrándose el día del nacimiento de Herodes, la hija de Herodías danzó en medio, y agradó a Herodes.", "words": [[0, 32472], [5, 32636], [18, 33476], [21, 33776], [25, 33996], [29, 34196], [40, 34816], [43, 34996], [52, 36056], [55, 36136], [60, 36516], [63, 36616], [72, 37176], [78, 38116], [81, 38276], [88, 38696], [90, 39256], [97, 39816], [99, 39996]]}, {"verse": 7, "start": 41140, "end": 44943, "text": "Y prometió él con juramento de darle todo lo que pidiese.", "words": [[0, 41140], [2, 41264], [11, 41864], [14, 42044], [18, 42284], [28, 42884], [31, 43124], [37, 43484], [42, 43884], [45, 44124], [49, 44244]]}, {"verse": 8, "start": 45293, "end": 52414, "text": "Y ella, instruída primero de su madre, dijo: Dame aquí en un plato la cabeza de Juan el Bautista.", "words": [[0, 45293], [2, 45462], [8, 45922], [18, 46582], [26, 46882], [29, 47162], [32, 47322], [39, 48062], [45, 48867], [50, 49127], [55, 49547], [58, 49847], [61, 49987], [67, 50427], [70, 50567], [77, 51007], [80, 51207], [85, 51587], [88, 51847]]}, {"verse": 9, "start": 52694, "end": 61234, "text": "Entonces el rey se entristeció; pero por el juramento, y por los que estaban juntamente a la mesa, mandó que se le diese.", "words": [[0, 52694], [9, 53254], [12, 53694], [16, 54074], [19, 54174], [32, 55346], [37, 55511], [41, 55731], [44, 55851], [55, 56931], [57, 57191], [61, 57331], [65, 57491], [69, 57631], [77, 57971], [88, 58671], [90, 58831], [93, 58911], [99, 59651], [105, 60191], [109, 60311], [112, 60451], [115, 60591]]}, {"verse": 10, "start": 61584, "end": 64538, "text": "Y enviando, degolló a Juan en la cárcel.", "words": [[0, 61584], [2, 61708], [12, 62308], [20, 62908], [22, 63048], [27, 63388], [30, 63668], [33, 63828]]}, {"verse": 11, "start": 64888, "end": 71501, "text": "Y fue traída su cabeza en un plato, y dada a la muchacha; y ella la presentó a su madre.", "words": [[0, 64888], [2, 65014], [6, 65154], [13, 65614], [16, 65834], [23, 66314], [26, 66514], [29, 66654], [36, 67274], [38, 67694], [43, 68094], [45, 68194], [48, 68254], [58, 69277], [60, 69423], [65, 69743], [68, 70143], [77, 70763], [79, 70843], [82, 70943]]}, {"verse": 12, "start": 71851, "end": 80091, "text": "Entonces llegaron sus discípulos, y tomaron el cuerpo, y lo enterraron; y fueron, y dieron la noticia a Jesús.", "words": [[0, 71851], [9, 72503], [18, 73403], [22, 73603], [34, 74443], [36, 74663], [44, 75083], [47, 75243], [55, 75743], [57, 76103], [60, 76243], [72, 77213], [74, 77378], [82, 77658], [84, 78118], [91, 78458], [94, 78638], [102, 79258], [104, 79418]]}, {"verse": 13, "start": 80441, "end": 91089, "text": "Y oyéndolo Jesús, se apartó de allí en un barco a un lugar desierto, apartado: y cuando la gente lo oyó y lo siguió a pie desde las ciudades.", "words": [[0, 80441], [2, 80795], [11, 81185], [18, 82045], [21, 82165], [28, 82665], [31, 82785], [36, 83045], [39, 83285], [42, 83465], [48, 83925], [50, 84185], [53, 84305], [59, 84605], [69, 85465], [79, 86505], [81, 86610], [88, 86850], [91, 87050], [97, 87370], [100, 87690], [104, 88170], [106, 88610], [109, 88750], [116, 89210], [118, 89330], [122, 89550], [128, 89830], [132, 90030]]}, {"verse": 14, "start": 91439, "end": 99765, "text": "Y saliendo Jesús, vio una gran multitud, y tuvo compasión de ellos, y sanó a los que de ellos había enfermos.", "words": [[0, 91439], [2, 91561], [11, 92041], [18, 93161], [22, 93541], [26, 93741], [31, 94001], [41, 94781], [43, 95261], [48, 95481], [58, 96201], [61, 96381], [68, 96701], [70, 97001], [75, 97621], [77, 97961], [81, 98081], [85, 98221], [88, 98361], [94, 98611], [100, 98861]]}, {"verse": 15, "start": 100115, "end": 113597, "text": "Y cuando fue la tarde del día, se llegaron a él sus discípulos, diciendo: El lugar es desierto, y el tiempo es ya pasado: despide a la multitud, para que se vayan por las aldeas, y compren para sí de comer.", "words": [[0, 100115], [2, 100216], [9, 100436], [13, 100736], [16, 100896], [22, 101176], [26, 101496], [31, 102276], [34, 102416], [43, 102936], [45, 103056], [48, 103216], [52, 103396], [64, 104436], [74, 105613], [77, 105734], [83, 105974], [86, 106174], [96, 106774], [98, 107174], [101, 107314], [108, 107634], [111, 107874], [114, 107994], [122, 108839], [130, 109319], [132, 109419], [135, 109479], [145, 110059], [150, 110499], [154, 110639], [157, 110779], [163, 111079], [167, 111239], [171, 111439], [179, 111979], [181, 112159], [189, 112559], [194, 112769], [197, 112979], [200, 113099]]}, {"verse": 16, "start": 113877, "end": 119946, "text": "Y Jesús les dijo: No tienen necesidad de irse: dadles vosotros de comer.", "words": [[0, 113877], [2, 114020], [8, 114420], [12, 114820], [18, 115552], [21, 115661], [28, 115981], [38, 116801], [41, 116921], [47, 117917], [54, 118523], [63, 119223], [66, 119604]]}, {"verse": 17, "start": 120295, "end": 124690, "text": "Y ellos dijeron: No tenemos aquí sino cinco panes y dos peces.", "words": [[0, 120295], [2, 120476], [8, 120676], [17, 121615], [20, 121798], [28, 122138], [33, 122598], [38, 122898], [44, 123198], [50, 123718], [52, 123848], [56, 123978]]}, {"verse": 18, "start": 124970, "end": 127363, "text": "Y él les dijo: Traédmelos acá.", "words": [[0, 124970], [2, 125177], [5, 125317], [9, 125477], [15, 126536], [26, 126886]]}, {"verse": 19, "start": 127713, "end": 141873, "text": "Y mandando a la gente recostarse sobre la hierba, tomando los cinco panes y los dos peces, alzando los ojos al cielo, bendijo, y partió y dio los panes a los discípulos, y los discípulos a la multitud.", "words": [[0, 127713], [2, 127816], [11, 128316], [13, 128396], [16, 128456], [22, 128736], [33, 129516], [39, 129816], [42, 130036], [50, 130556], [58, 130916], [62, 131096], [68, 131436], [74, 132036], [76, 132176], [80, 132316], [84, 132496], [91, 133376], [99, 133856], [103, 134056], [108, 134336], [111, 134616], [118, 135336], [127, 136293], [129, 136420], [136, 137100], [138, 137420], [142, 137600], [146, 137800], [152, 138380], [154, 138480], [158, 138600], [170, 139360], [172, 139800], [176, 139940], [187, 140660], [189, 140940], [192, 141020]]}, {"verse": 20, "start": 142223, "end": 149672, "text": "Y comieron todos, y se saciaron; y alzaron lo que sobró de los pedazos, doce cestas llenas.", "words": [[0, 142223], [2, 142332], [11, 142692], [18, 143092], [20, 143447], [23, 143587], [33, 144710], [35, 144835], [43, 145435], [46, 145635], [50, 145775], [56, 146595], [59, 146775], [63, 146915], [72, 147548], [77, 148182], [84, 148815]]}, {"verse": 21, "start": 150022, "end": 155900, "text": "Y los que comieron fueron como cinco mil hombres, sin las mujeres y los niños.", "words": [[0, 150022], [2, 150146], [6, 150266], [10, 150446], [19, 150986], [26, 151306], [31, 151676], [37, 152046], [41, 152546], [50, 153526], [54, 154026], [58, 154246], [66, 154686], [68, 154926], [72, 155066]]}, {"verse": 22, "start": 156250, "end": 167808, "text": "Y luego Jesús hizo a sus discípulos entrar en el barco, e ir delante de él al otro lado del lago, entre tanto que él despedía a la multitud.", "words": [[0, 156250], [2, 156431], [8, 156731], [14, 157471], [19, 158231], [21, 158491], [25, 158671], [36, 159371], [43, 159911], [46, 160231], [49, 160411], [56, 160871], [58, 161291], [61, 161511], [69, 162131], [72, 162331], [75, 162651], [78, 162931], [83, 163191], [88, 163531], [92, 163831], [98, 164671], [104, 165071], [110, 165511], [114, 165791], [117, 166011], [126, 166691], [128, 166871], [131, 166951]]}, {"verse": 23, "start": 168158, "end": 176807, "text": "Y despedida la multitud, subió al monte, apartado, a orar: y como fue la tarde del día, estaba allí solo.", "words": [[0, 168158], [2, 168264], [12, 168824], [15, 168944], [25, 169544], [31, 170084], [34, 170304], [41, 171104], [51, 172324], [53, 172658], [59, 173157], [61, 173400], [66, 173600], [70, 173840], [73, 174000], [79, 174300], [83, 174580], [88, 175300], [95, 175700], [100, 176040]]}, {"verse": 24, "start": 177157, "end": 183724, "text": "Y ya el barco estaba en medio del mar, atormentado de las olas; porque el viento era contrario.", "words": [[0, 177157], [2, 177418], [5, 177618], [8, 177738], [14, 178118], [21, 178378], [24, 178558], [30, 178798], [34, 179018], [39, 179738], [51, 180598], [54, 180758], [58, 180918], [64, 181809], [71, 182030], [74, 182190], [81, 182570], [85, 182770]]}, {"verse": 25, "start": 184074, "end": 189777, "text": "Pero a la cuarta vigilia de la noche, Jesús fue a ellos andando sobre el mar.", "words": [[0, 184074], [5, 184217], [7, 184337], [10, 184397], [17, 184797], [25, 185257], [28, 185377], [31, 185517], [38, 186337], [44, 186837], [48, 187597], [50, 187917], [56, 188157], [64, 188837], [70, 189137], [73, 189337]]}, {"verse": 26, "start": 190127, "end": 198163, "text": "Y los discípulos, viéndole andar sobre el mar, se turbaron, diciendo: Fantasma es. Y dieron voces de miedo.", "words": [[0, 190127], [2, 190373], [6, 190513], [18, 191133], [27, 191613], [33, 191973], [39, 192373], [42, 192573], [47, 192773], [50, 193293], [60, 194333], [70, 195724], [79, 196104], [83, 196718], [85, 196843], [92, 197123], [98, 197583], [101, 197703]]}, {"verse": 27, "start": 198513, "end": 204250, "text": "Pero luego Jesús les habló, diciendo: Confiad, yo soy; no tengáis miedo.", "words": [[0, 198518], [5, 198678], [11, 198978], [17, 199318], [21, 199658], [28, 200269], [38, 201923], [47, 201923], [50, 202130], [55, 202706], [58, 203046], [66, 203566]]}, {"verse": 28, "start": 204600, "end": 210884, "text": "Entonces le respondió Pedro, y dijo: Señor, si tú eres, manda que yo vaya a ti sobre las aguas.", "words": [[0, 204600], [9, 205117], [12, 205637], [22, 206237], [29, 206617], [31, 206817], [37, 207529], [44, 207886], [47, 207966], [50, 208126], [56, 208786], [62, 209086], [66, 209186], [69, 209326], [74, 209506], [76, 209726], [79, 209846], [85, 210066], [89, 210306]]}, {"verse": 29, "start": 211164, "end": 217213, "text": "Y él dijo: Ven. Y descendiendo Pedro del barco, andaba sobre las aguas para ir a Jesús.", "words": [[0, 211164], [2, 211325], [5, 211445], [11, 212391], [16, 212864], [18, 212973], [31, 213633], [37, 214013], [41, 214253], [48, 214733], [55, 215253], [61, 215493], [65, 215773], [71, 216233], [76, 216433], [79, 216653], [81, 216713]]}, {"verse": 30, "start": 217563, "end": 224903, "text": "Pero viendo el viento fuerte, tuvo miedo; y comenzándose a hundir, dio voces, diciendo: Señor, sálvame.", "words": [[0, 217563], [5, 217707], [12, 217987], [15, 218147], [22, 218447], [30, 218887], [35, 219207], [42, 220195], [44, 220303], [57, 221123], [59, 221283], [67, 221743], [71, 222103], [78, 222643], [88, 223753], [95, 224071]]}, {"verse": 31, "start": 225183, "end": 233493, "text": "Y luego Jesús, extendiendo la mano, lo sujetó, y le dice: Oh hombre de poca fe, ¿por qué dudaste?", "words": [[0, 225183], [2, 225329], [8, 225569], [15, 226089], [27, 227289], [30, 227429], [36, 228189], [39, 228409], [47, 229149], [49, 229509], [52, 229649], [58, 230500], [61, 230620], [68, 230960], [71, 231180], [76, 231540], [80, 232180], [85, 232480], [89, 232660]]}, {"verse": 32, "start": 233843, "end": 237853, "text": "Y como ellos entraron en el barco, se sosegó el viento.", "words": [[0, 233843], [2, 234027], [7, 234287], [13, 234567], [22, 235407], [25, 235527], [28, 235707], [35, 236487], [38, 236587], [45, 237127], [48, 237247]]}, {"verse": 33, "start": 238203, "end": 246162, "text": "Entonces los que estaban en el barco, vinieron y le adoraron, diciendo: Verdaderamente eres Hijo de Dios.", "words": [[0, 238203], [9, 238869], [13, 239344], [17, 239484], [25, 239784], [28, 240004], [31, 240144], [38, 240604], [47, 241404], [49, 241704], [52, 241804], [62, 242844], [72, 243924], [87, 244708], [92, 244968], [97, 245448], [100, 245628]]}, {"verse": 34, "start": 246442, "end": 250089, "text": "Y llegando a la otra parte, vinieron a la tierra de Genezaret.", "words": [[0, 246442], [2, 246571], [11, 246971], [13, 247091], [16, 247151], [21, 247331], [28, 247711], [37, 248271], [39, 248431], [42, 248511], [49, 248851], [52, 249503]]}, {"verse": 35, "start": 250439, "end": 259336, "text": "Y como le conocieron los hombres de aquel lugar, enviaron por toda aquella tierra alrededor, y trajeron a él todos los enfermos;", "words": [[0, 250439], [2, 250546], [7, 250746], [10, 250886], [21, 251546], [25, 251686], [33, 252046], [36, 252226], [42, 252526], [49, 253326], [58, 254046], [62, 254306], [67, 254666], [75, 255166], [82, 255506], [93, 256006], [95, 256426], [104, 256946], [106, 257046], [109, 257246], [115, 257926], [119, 258366]]}, {"verse": 36, "start": 259686, "end": 266737, "text": "Y le rogaban que solamente tocasen el borde de su manto; y todos los que tocaron, quedaron sanos.", "words": [[0, 259686], [2, 259808], [5, 259908], [13, 260488], [17, 260668], [27, 261348], [35, 262028], [38, 262168], [44, 262508], [47, 262648], [50, 262808], [57, 263655], [59, 263938], [65, 264278], [69, 264758], [73, 264918], [82, 265418], [91, 265878]]}]}