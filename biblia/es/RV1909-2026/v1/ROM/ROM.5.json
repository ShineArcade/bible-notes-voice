{"book": "ROM", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 172133, "verses": [{"verse": 1, "start": 300, "end": 5894, "text": "Justificados pues por la fe, tenemos paz para con Dios por medio de nuestro Señor Jesucristo:", "words": [[0, 300], [13, 1020], [18, 1340], [22, 1620], [25, 1760], [29, 2260], [37, 2640], [41, 2980], [46, 3260], [50, 3480], [55, 3720], [59, 4040], [65, 4300], [68, 4500], [76, 4660], [82, 5040]]}, {"verse": 2, "start": 6244, "end": 13824, "text": "Por el cual también tenemos entrada por la fe a esta gracia en la cual estamos firmes, y nos gloriamos en la esperanza de la gloria de Dios.", "words": [[0, 6244], [4, 6363], [7, 6443], [12, 6623], [20, 6943], [28, 7363], [36, 7743], [40, 8043], [43, 8163], [46, 8363], [48, 8483], [53, 8703], [60, 9303], [63, 9483], [66, 9583], [71, 9763], [79, 10083], [87, 10843], [89, 11183], [93, 11323], [103, 11803], [106, 12023], [109, 12123], [119, 12623], [122, 12743], [125, 12843], [132, 13203], [135, 13323]]}, {"verse": 3, "start": 14174, "end": 21130, "text": "Y no sólo esto, sino que también nos gloriamos en las tribulaciones, sabiendo que la tribulación produce paciencia;", "words": [[0, 14174], [2, 14272], [5, 14392], [10, 14612], [16, 15432], [21, 15732], [25, 15892], [33, 16212], [37, 16452], [47, 16972], [50, 17192], [54, 17312], [69, 18412], [78, 18932], [82, 19132], [85, 19252], [97, 19852], [105, 20212]]}, {"verse": 4, "start": 21480, "end": 25895, "text": "Y la paciencia, carácter probado; y el carácter probado, esperanza;", "words": [[0, 21480], [2, 21586], [5, 21666], [16, 22566], [25, 23126], [34, 23927], [36, 24045], [39, 24145], [48, 24665], [57, 25105]]}, {"verse": 5, "start": 26245, "end": 34236, "text": "Y la esperanza no avergüenza; porque el amor de Dios está derramado en nuestros corazones por el Espíritu Santo que nos es dado.", "words": [[0, 26245], [2, 26387], [5, 26487], [15, 27007], [18, 27187], [30, 28654], [37, 28885], [40, 29025], [45, 29245], [48, 29445], [53, 29685], [58, 30085], [68, 30725], [71, 30845], [80, 31025], [90, 31865], [94, 32145], [97, 32285], [106, 32845], [112, 33145], [116, 33425], [120, 33585], [123, 33805]]}, {"verse": 6, "start": 34586, "end": 39371, "text": "Porque Cristo, cuando aún éramos débiles, a su tiempo murió por los impíos.", "words": [[0, 34586], [7, 34822], [15, 35222], [22, 35522], [26, 35942], [33, 36282], [42, 37162], [44, 37362], [47, 37482], [54, 37802], [60, 38242], [64, 38422], [68, 38582]]}, {"verse": 7, "start": 39721, "end": 45866, "text": "Ciertamente apenas muere alguno por un justo: con todo podrá ser que alguno se atreviera a morir por el bueno.", "words": [[0, 39721], [12, 40390], [19, 40670], [25, 41110], [32, 41530], [36, 41670], [39, 41770], [46, 42498], [50, 42615], [55, 42935], [61, 43375], [65, 43535], [69, 43715], [76, 44135], [79, 44235], [89, 44735], [91, 44835], [97, 45215], [101, 45355], [104, 45475]]}, {"verse": 8, "start": 46216, "end": 52678, "text": "Pero Dios demuestra su amor para con nosotros, porque siendo aún pecadores, Cristo murió por nosotros.", "words": [[0, 46216], [5, 46373], [10, 46633], [20, 47273], [23, 47413], [28, 47733], [33, 47993], [37, 48233], [47, 49013], [54, 49413], [61, 49793], [65, 50053], [76, 51053], [83, 51373], [89, 51793], [93, 51973]]}, {"verse": 9, "start": 53028, "end": 57965, "text": "Luego mucho más ahora, justificados en su sangre, por él seremos salvos de la ira.", "words": [[0, 53028], [6, 53275], [12, 53615], [16, 53895], [23, 54615], [36, 55315], [39, 55495], [42, 55615], [50, 56335], [54, 56475], [57, 56615], [65, 56935], [72, 57395], [75, 57495], [78, 57615]]}, {"verse": 10, "start": 58315, "end": 67644, "text": "Porque si siendo enemigos, fuimos reconciliados con Dios por la muerte de su Hijo, mucho más, estando reconciliados, seremos salvos por su vida.", "words": [[0, 58315], [7, 58562], [10, 58762], [17, 59122], [27, 59742], [34, 60207], [48, 61067], [52, 61327], [57, 61507], [61, 61807], [64, 61947], [71, 62247], [74, 62447], [77, 62647], [83, 63507], [89, 63667], [94, 64447], [102, 64847], [117, 66107], [125, 66387], [132, 66867], [136, 67087], [139, 67227]]}, {"verse": 11, "start": 67994, "end": 75594, "text": "Y no sólo esto, sino que también nos gloriamos en Dios por el Señor nuestro Jesucristo, por el cual hemos ahora recibido la reconciliación.", "words": [[0, 67994], [2, 68098], [5, 68198], [10, 68418], [16, 69058], [21, 69218], [25, 69378], [33, 69658], [37, 69878], [47, 70358], [50, 70578], [55, 70758], [59, 71058], [62, 71178], [68, 71378], [76, 71678], [88, 72838], [92, 73078], [95, 73198], [100, 73338], [106, 73558], [112, 73838], [121, 74438], [124, 74558]]}, {"verse": 12, "start": 75944, "end": 87461, "text": "Por consiguiente, vino la reconciliación por uno, así como el pecado entró en el mundo por un hombre, y por el pecado la muerte, y la muerte así pasó a todos los hombres, pues que todos pecaron.", "words": [[0, 75944], [4, 76052], [18, 76732], [23, 76952], [26, 77152], [41, 77972], [45, 78192], [50, 78912], [54, 79212], [59, 79492], [62, 79612], [69, 80012], [75, 80352], [78, 80452], [81, 80552], [87, 80812], [91, 81072], [94, 81212], [102, 81492], [104, 81892], [108, 82072], [111, 82172], [118, 82572], [121, 82712], [129, 83473], [131, 83577], [134, 83677], [141, 84057], [145, 84377], [150, 84757], [152, 84977], [158, 85217], [162, 85497], [171, 86197], [176, 86317], [180, 86517], [186, 86757]]}, {"verse": 13, "start": 87811, "end": 92947, "text": "Porque hasta la ley, el pecado estaba en el mundo; pero no se imputa pecado no habiendo ley.", "words": [[0, 87811], [7, 88028], [13, 88288], [16, 88488], [21, 88748], [24, 89028], [31, 89468], [38, 89788], [41, 89968], [44, 90068], [51, 90735], [56, 90875], [59, 91035], [62, 91195], [69, 91615], [76, 92075], [79, 92235], [88, 92575]]}, {"verse": 14, "start": 93297, "end": 103429, "text": "No obstante, reinó la muerte desde Adam hasta Moisés, aun en los que no pecaron a la manera de la rebelión de Adam; el cual es figura del que había de venir.", "words": [[0, 93297], [3, 93476], [13, 94176], [19, 94536], [22, 94656], [29, 94996], [35, 95296], [40, 95716], [46, 95996], [54, 96916], [58, 97316], [61, 97656], [65, 97796], [69, 97976], [72, 98116], [80, 98596], [82, 98676], [85, 98736], [92, 99036], [95, 99216], [98, 99336], [107, 99776], [110, 99936], [116, 100585], [119, 100725], [124, 100945], [127, 101265], [134, 101625], [138, 101965], [142, 102145], [148, 102405], [151, 102585]]}, {"verse": 15, "start": 103779, "end": 115622, "text": "Pero no como el delito, tal fue el don: porque si por el delito de aquel uno murieron los muchos, mucho más abundó la gracia de Dios a los muchos, y el don por la gracia de un hombre, Jesucristo.", "words": [[0, 103779], [5, 103921], [8, 104121], [13, 104381], [16, 104521], [24, 105281], [28, 105481], [32, 105741], [35, 105881], [40, 106499], [47, 106686], [50, 106866], [54, 107086], [57, 107186], [64, 107566], [67, 107706], [73, 108006], [77, 108146], [86, 108606], [90, 108786], [98, 109666], [104, 109986], [108, 110206], [115, 110686], [118, 110786], [125, 111206], [128, 111326], [133, 111526], [135, 111726], [139, 111846], [147, 112266], [149, 112786], [152, 112926], [156, 113106], [160, 113346], [163, 113466], [170, 113866], [173, 113946], [176, 114086], [184, 114763]]}, {"verse": 16, "start": 115972, "end": 125847, "text": "Ni tampoco de la manera que por un pecado, así también el don: porque el juicio a la verdad vino de un pecado para condenación, pero la gracia vino de muchos delitos para justificación.", "words": [[0, 115972], [3, 116068], [11, 116368], [14, 116568], [17, 116668], [24, 116908], [28, 117108], [32, 117308], [35, 117428], [43, 118028], [47, 118188], [55, 118548], [58, 118748], [63, 119365], [70, 119457], [73, 119587], [80, 120087], [82, 120187], [85, 120247], [92, 120587], [97, 120847], [100, 121027], [103, 121107], [110, 121487], [115, 121667], [128, 122647], [133, 122907], [136, 123047], [143, 123467], [148, 123627], [151, 123827], [158, 124027], [166, 124547], [171, 124807]]}, {"verse": 17, "start": 126197, "end": 135972, "text": "Porque, si por un delito reinó la muerte por uno, mucho más reinarán en vida por un Jesucristo los que reciben la abundancia de la gracia, y del don de la justicia.", "words": [[0, 126197], [8, 126408], [11, 126628], [15, 126928], [18, 127068], [25, 127488], [31, 127828], [34, 128008], [41, 128348], [45, 128648], [50, 129208], [56, 129468], [60, 129708], [69, 130308], [72, 130408], [77, 130608], [81, 130928], [84, 131028], [95, 131748], [99, 131948], [103, 132148], [111, 132688], [114, 132828], [125, 133468], [128, 133588], [131, 133708], [139, 134507], [141, 134608], [145, 134748], [149, 134968], [152, 135108], [155, 135208]]}, {"verse": 18, "start": 136322, "end": 147175, "text": "Así que, de la manera que por un delito vino la culpa a todos los hombres para condenación, así por un acto de justicia vino la gracia a todos los hombres para justificación de vida.", "words": [[0, 136322], [4, 136499], [9, 136739], [12, 136799], [15, 136919], [22, 137159], [26, 137379], [30, 137599], [33, 137719], [40, 138059], [45, 138299], [48, 138479], [54, 138839], [56, 139119], [62, 139279], [66, 139499], [74, 139759], [79, 140019], [92, 141847], [96, 142088], [100, 142348], [103, 142508], [108, 142828], [111, 142908], [120, 143681], [125, 143933], [128, 144093], [135, 144593], [137, 144713], [143, 144893], [147, 145133], [155, 145433], [160, 145753], [174, 146533], [177, 146813]]}, {"verse": 19, "start": 147525, "end": 156342, "text": "Porque como por la desobediencia de un hombre los muchos fueron constituidos pecadores, así por la obediencia de uno los muchos serán constituidos justos.", "words": [[0, 147525], [7, 147725], [12, 147965], [16, 148165], [19, 148285], [33, 149045], [36, 149225], [39, 149365], [46, 149625], [50, 149825], [57, 150105], [64, 150485], [77, 151325], [88, 152365], [92, 152585], [96, 152825], [99, 152945], [110, 153545], [113, 153725], [117, 153985], [121, 154185], [128, 154565], [134, 154945], [147, 155685]]}, {"verse": 20, "start": 156692, "end": 162871, "text": "Pero la ley entró para que el pecado creciese; pero cuando el pecado aumentó, la gracia abundó mucho más;", "words": [[0, 156692], [5, 156834], [8, 156994], [12, 157194], [18, 157654], [23, 157814], [27, 157994], [30, 158094], [37, 158434], [47, 159435], [52, 159572], [59, 159812], [62, 160012], [69, 160372], [78, 161252], [81, 161352], [88, 161772], [95, 162152], [101, 162392]]}, {"verse": 21, "start": 163221, "end": 171733, "text": "Para que, de la manera que el pecado reinó para muerte, así también la gracia reine por la justicia para vida eterna por Jesucristo Señor nuestro.", "words": [[0, 163221], [5, 163373], [10, 163573], [13, 163633], [16, 163753], [23, 163973], [27, 164233], [30, 164353], [37, 164733], [43, 165113], [48, 165293], [56, 166193], [60, 166353], [68, 166733], [71, 166913], [78, 167293], [84, 167673], [88, 167853], [91, 167993], [100, 168893], [105, 169193], [110, 169393], [117, 169893], [121, 170073], [132, 170873], [138, 171073]]}]}