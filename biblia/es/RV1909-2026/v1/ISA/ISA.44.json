{"book": "ISA", "chapter": 44, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 327055, "verses": [{"verse": 1, "start": 300, "end": 5492, "text": "Ahora pues oye, Jacob, siervo mío, y tú, Israel, a quien yo escogí.", "words": [[0, 300], [6, 582], [11, 1162], [16, 1462], [23, 1922], [30, 2242], [35, 3022], [37, 3102], [41, 3602], [49, 4422], [51, 4522], [57, 4662], [60, 4862]]}, {"verse": 2, "start": 6085, "end": 17214, "text": "Así dice Jehová, Hacedor tuyo, y el que te formó desde el vientre, el cual te ayudará: No temas, siervo mío Jacob, y tú, Jesurún, a quien yo escogí.", "words": [[0, 6085], [4, 6424], [9, 6824], [17, 7224], [25, 7744], [31, 8724], [33, 8804], [36, 8944], [40, 9064], [43, 9204], [49, 9704], [55, 9904], [58, 10124], [67, 11004], [70, 11104], [75, 11344], [78, 11544], [87, 12590], [90, 12754], [97, 13234], [104, 13574], [108, 13874], [115, 14774], [117, 14854], [121, 15384], [130, 15914], [132, 16154], [138, 16294], [141, 16554]]}, {"verse": 3, "start": 17885, "end": 28454, "text": "Porque yo derramaré aguas sobre el sequedal, y ríos sobre la tierra árida: mi espíritu derramaré sobre tu generación, y mi bendición sobre tus renuevos:", "words": [[0, 17885], [7, 18066], [10, 18326], [20, 18786], [26, 19246], [32, 19566], [35, 19926], [45, 20286], [47, 20646], [52, 21006], [58, 21286], [61, 21486], [68, 21786], [75, 23006], [78, 23154], [87, 23894], [97, 24474], [103, 24754], [106, 24974], [118, 25714], [120, 26274], [123, 26394], [133, 27034], [139, 27394], [143, 27924]]}, {"verse": 4, "start": 29160, "end": 33757, "text": "Y brotarán entre hierba, como sauces junto a las riberas de las aguas.", "words": [[0, 29160], [2, 29257], [11, 29777], [17, 30037], [25, 30557], [30, 31117], [37, 31637], [43, 32057], [45, 32277], [49, 32617], [57, 32957], [60, 33057], [64, 33217]]}, {"verse": 5, "start": 34491, "end": 46109, "text": "Este dirá: Yo soy de Jehová; el otro se llamará del nombre de Jacob; y otro escribirá con su mano, A Jehová, y se apellidará con el nombre de Israel.", "words": [[0, 34491], [5, 34836], [11, 35884], [14, 36084], [18, 36304], [21, 36664], [29, 37568], [32, 37709], [37, 37989], [40, 38189], [48, 38709], [52, 39009], [59, 39369], [62, 39549], [69, 40713], [71, 40879], [76, 41099], [86, 41779], [90, 41959], [93, 42159], [99, 42499], [101, 42919], [109, 43619], [111, 43879], [114, 44059], [125, 44719], [129, 44919], [132, 45059], [139, 45319], [142, 45499]]}, {"verse": 6, "start": 46697, "end": 57325, "text": "Así dice Jehová, Rey de Israel, y su Redentor, Jehová de los ejércitos: Yo el primero, y yo el postrero, y fuera de mí no hay Dios.", "words": [[0, 46697], [4, 46958], [9, 47318], [17, 48018], [21, 48378], [24, 48478], [32, 49558], [34, 49738], [37, 49918], [47, 51278], [54, 51878], [57, 51978], [61, 52158], [72, 53408], [75, 53535], [78, 53635], [87, 53995], [89, 54355], [92, 54515], [95, 54615], [105, 55355], [107, 55695], [113, 55935], [116, 56155], [119, 56355], [122, 56615], [126, 56795]]}, {"verse": 7, "start": 58014, "end": 67430, "text": "¿Y quién llamará como yo, y denunciará esto, y lo ordenará por mí, desde que hice el pueblo antiguo? Anúncienles lo que viene, y lo que está por venir.", "words": [[0, 58014], [3, 58116], [9, 58277], [17, 58696], [22, 58896], [26, 59177], [28, 59656], [39, 60196], [45, 60576], [47, 60976], [50, 61076], [59, 61476], [63, 61677], [67, 61876], [73, 62216], [77, 62497], [82, 62677], [85, 62836], [92, 63016], [101, 64215], [113, 65020], [116, 65220], [120, 65380], [127, 65720], [129, 66220], [132, 66340], [136, 66480], [141, 66700], [145, 66940]]}, {"verse": 8, "start": 68164, "end": 81596, "text": "No temáis, ni os amedrentéis: ¿no te lo hice oír desde antiguo, y te lo dije? Luego vosotros sois mis testigos. No hay Dios sino yo. No hay Fuerte: no conozco ninguno.", "words": [[0, 68164], [3, 68445], [11, 68765], [14, 69085], [17, 69225], [30, 70608], [34, 70733], [37, 70873], [40, 71013], [45, 71233], [49, 71613], [55, 71773], [64, 72633], [66, 72713], [69, 72813], [72, 72933], [78, 74004], [84, 74269], [93, 74849], [98, 75189], [102, 75309], [112, 76572], [115, 76749], [119, 76969], [124, 77349], [129, 77749], [133, 78741], [136, 78922], [140, 79122], [148, 80323], [151, 80466], [159, 80986]]}, {"verse": 9, "start": 82176, "end": 96270, "text": "Los formadores de imágenes de talla, todos ellos son vanidad, y lo más precioso de ellos para nada es útil; y ellos mismos para su confusión son testigos, que ellos ni ven ni entienden.", "words": [[0, 82176], [4, 82282], [15, 82862], [18, 83062], [27, 83462], [30, 83702], [37, 84282], [43, 84482], [49, 84822], [53, 85102], [62, 85622], [64, 86182], [67, 86322], [71, 86562], [80, 87222], [83, 87422], [89, 88142], [94, 88362], [99, 88602], [102, 88942], [108, 89966], [110, 90286], [116, 90486], [123, 90846], [128, 91166], [131, 91366], [141, 92026], [145, 92226], [155, 93466], [159, 93726], [165, 94206], [168, 94686], [172, 95016], [175, 95346]]}, {"verse": 10, "start": 96720, "end": 101456, "text": "¿Quién formó un dios, o quién fundó una estatua que para nada es de provecho?", "words": [[0, 96720], [7, 96984], [13, 97404], [16, 97524], [22, 98304], [24, 98404], [30, 98644], [36, 98994], [40, 99344], [48, 99944], [52, 100064], [57, 100284], [62, 100484], [65, 100664], [68, 100784]]}, {"verse": 11, "start": 101906, "end": 115079, "text": "He aquí que todos sus compañeros serán avergonzados; porque los mismos artífices son de los hombres. Todos ellos se juntarán, estarán, se asombrarán, y serán avergonzados a una.", "words": [[0, 101957], [3, 102047], [8, 102267], [12, 102487], [18, 102747], [22, 103067], [33, 103767], [39, 104167], [53, 105624], [60, 105944], [64, 106144], [71, 106444], [81, 107324], [85, 107704], [88, 107864], [92, 107984], [101, 108883], [107, 109108], [113, 109608], [116, 109928], [126, 111248], [135, 111888], [138, 112068], [150, 112908], [152, 113068], [158, 113528], [171, 114408], [173, 114648]]}, {"verse": 12, "start": 115529, "end": 131175, "text": "El herrero tomará la tenaza, obrará en las ascuas, le dará forma con los martillos, y trabajará en ella con la fuerza de su brazo: tiene luego hambre, y le faltan las fuerzas; no beberá agua, y se desmaya.", "words": [[0, 115529], [3, 115712], [11, 116152], [18, 116692], [21, 116812], [29, 118032], [36, 118592], [39, 118732], [43, 118892], [51, 120092], [54, 120212], [59, 120512], [65, 120812], [69, 121092], [73, 121272], [84, 121992], [86, 122312], [96, 122932], [99, 123112], [104, 123332], [108, 123572], [111, 123712], [118, 124112], [121, 124312], [124, 124472], [131, 125396], [137, 125621], [143, 125901], [151, 126601], [153, 127041], [156, 127161], [163, 127681], [167, 127821], [176, 129002], [179, 129228], [186, 129788], [192, 130188], [194, 130348], [197, 130448]]}, {"verse": 13, "start": 131625, "end": 145369, "text": "El carpintero tiende la regla, señala aquella con almagre, la labra con los cepillos, le da figura con el compás, la hace en forma de varón, a semejanza de hombre hermoso, para estar en casa.", "words": [[0, 131625], [3, 131886], [14, 132666], [21, 132986], [24, 133166], [31, 133746], [38, 134166], [46, 134546], [50, 134766], [59, 135886], [62, 136006], [68, 136346], [72, 136506], [76, 136686], [86, 137666], [89, 137846], [92, 137986], [99, 138286], [103, 138626], [106, 138746], [114, 139746], [117, 139866], [122, 140246], [125, 140446], [131, 140766], [134, 141026], [141, 141925], [143, 142090], [153, 142750], [156, 142910], [163, 143170], [172, 144130], [177, 144350], [183, 144590], [186, 144810]]}, {"verse": 14, "start": 145819, "end": 155457, "text": "Cortará cedros, y tomará encina y alcornoque, y entre los árboles del bosque se esforzará; plantará pino, que se críe con la lluvia.", "words": [[0, 145819], [8, 146260], [16, 146900], [18, 147260], [25, 147680], [32, 148440], [34, 148910], [46, 149380], [48, 149820], [54, 150080], [58, 150280], [66, 150760], [70, 151020], [77, 151480], [80, 151640], [91, 153214], [100, 153580], [106, 153947], [110, 154147], [113, 154407], [118, 154667], [122, 154807], [125, 154947]]}, {"verse": 15, "start": 155907, "end": 172088, "text": "De él se servirá luego el hombre para quemar, y tomará de ellos para calentarse; encenderá también el horno, y cocerá panes: hará además un dios, y lo adorará; fabricará un ídolo, y se arrodillará delante de él.", "words": [[0, 155907], [3, 156152], [6, 156332], [9, 156512], [17, 157052], [23, 157312], [26, 157552], [33, 157772], [38, 158072], [46, 158672], [48, 159012], [55, 159452], [58, 159612], [64, 159852], [69, 160132], [81, 161505], [91, 162211], [99, 162511], [102, 162771], [109, 163471], [111, 163881], [118, 164291], [125, 165249], [130, 165574], [137, 165934], [140, 166234], [146, 166494], [148, 167174], [151, 167314], [160, 168390], [170, 168983], [173, 169203], [180, 169823], [182, 170023], [185, 170223], [197, 171003], [205, 171503], [208, 171703]]}, {"verse": 16, "start": 172538, "end": 185907, "text": "Parte del leño quemará en el fuego; con parte de él comerá carne, aderezará asado, y se saciará; después se calentará, y dirá: ¡Oh! me he calentado, he visto el fuego;", "words": [[0, 172538], [6, 172864], [10, 173124], [15, 173624], [23, 174344], [26, 174544], [29, 174704], [36, 175874], [40, 176088], [46, 176301], [49, 176501], [52, 176841], [59, 177141], [66, 178141], [76, 178781], [83, 179441], [85, 179801], [88, 179961], [97, 181040], [105, 181542], [108, 181782], [119, 182442], [121, 182702], [127, 183475], [132, 184049], [135, 184208], [138, 184348], [149, 185048], [152, 185068], [158, 185268], [161, 185448]]}, {"verse": 17, "start": 186257, "end": 197539, "text": "Y torna su sobrante en un dios, en su escultura; se humilla delante de ella, la adora, y le ruega diciendo: Líbrame, que mi dios eres tú.", "words": [[0, 186257], [2, 186381], [8, 186881], [11, 187061], [20, 187701], [23, 188001], [26, 188161], [32, 188941], [35, 189041], [38, 189241], [49, 190575], [52, 190860], [60, 191420], [68, 191920], [71, 192100], [77, 192420], [80, 192700], [87, 193220], [89, 193620], [92, 193900], [98, 194180], [108, 195439], [117, 195699], [121, 195899], [124, 196039], [129, 196259], [134, 196559]]}, {"verse": 18, "start": 197889, "end": 205071, "text": "No supieron ni entendieron: porque cegados están sus ojos para no ver, y su corazón para no entender.", "words": [[0, 197889], [3, 198097], [12, 198677], [15, 199017], [28, 200255], [35, 200457], [43, 201037], [49, 201337], [53, 201637], [58, 201957], [63, 202217], [66, 202437], [71, 202717], [73, 203217], [76, 203377], [84, 203817], [89, 204157], [92, 204377]]}, {"verse": 19, "start": 205521, "end": 225429, "text": "No discurre para consigo, no tiene sentido ni entendimiento para decir: Parte de esto quemé en el fuego, y sobre sus brasas cocí pan, asé carne, y la comí; ¿he de tornar en una abominación lo restante de ello? ¿delante de un tronco de árbol tengo de humillarme?", "words": [[0, 205521], [3, 205669], [12, 206229], [17, 206409], [26, 207609], [29, 207889], [35, 208149], [43, 208749], [46, 209009], [60, 209909], [65, 210149], [72, 211068], [78, 211435], [81, 211635], [86, 212025], [92, 212415], [95, 212535], [98, 212675], [105, 213055], [107, 213675], [113, 213915], [117, 214398], [124, 214882], [129, 215365], [134, 215848], [138, 216332], [145, 216815], [147, 217235], [150, 217375], [156, 218171], [160, 218251], [163, 218331], [170, 218771], [173, 219251], [177, 219511], [189, 220531], [192, 220771], [201, 221411], [204, 221591], [210, 222398], [219, 222799], [222, 222979], [225, 223079], [232, 223499], [235, 223639], [241, 223999], [247, 224339], [250, 224579]]}, {"verse": 20, "start": 225879, "end": 235592, "text": "De ceniza se apacienta; su corazón engañado le desvía, para que no libre su alma, ni diga: ¿No hay una mentira a mi mano derecha?", "words": [[0, 225879], [3, 226047], [10, 226687], [13, 227127], [24, 228319], [27, 228626], [35, 229106], [44, 229946], [47, 230106], [55, 230686], [60, 231106], [64, 231246], [67, 231386], [73, 231666], [76, 231906], [82, 232186], [85, 232446], [91, 233243], [95, 233350], [99, 233470], [103, 233630], [111, 234270], [113, 234450], [116, 234570], [121, 234830]]}, {"verse": 21, "start": 235892, "end": 245952, "text": "Acuérdate de estas cosas, oh Jacob, e Israel, pues que tú mi siervo eres: Yo te formé; siervo mío eres tú: Israel, no me olvides.", "words": [[0, 235892], [10, 236416], [13, 236636], [19, 236856], [26, 237236], [29, 237616], [36, 237956], [38, 238216], [46, 239116], [51, 239256], [55, 239436], [58, 239616], [61, 239776], [68, 240216], [74, 241246], [77, 241410], [80, 241530], [87, 242832], [94, 243052], [98, 243332], [103, 243492], [107, 244462], [115, 245102], [118, 245202], [121, 245302]]}, {"verse": 22, "start": 246648, "end": 253980, "text": "Yo deshice como a nube tus rebeliones, y como a niebla tus pecados: vuélvete a mí, porque yo te redimí.", "words": [[0, 246648], [3, 246972], [11, 247332], [16, 247545], [18, 247759], [23, 247972], [27, 248172], [39, 248912], [41, 249492], [46, 249732], [48, 249972], [55, 250212], [59, 250412], [68, 251841], [77, 252260], [79, 252400], [83, 252880], [90, 253040], [93, 253240], [96, 253400]]}, {"verse": 23, "start": 254561, "end": 272990, "text": "Cantad loores, oh cielos, porque Jehová lo hizo; gritad con júbilo, profundidades de la tierra; prorrumpid, montes, en alabanza; bosque, y todo árbol que en él está: porque Jehová redimió a Jacob, y en Israel será glorificado.", "words": [[0, 254861], [7, 255196], [15, 255531], [18, 255866], [26, 256446], [33, 256766], [40, 257306], [43, 257426], [49, 258199], [56, 258766], [60, 259006], [68, 259553], [82, 260099], [85, 260646], [88, 260806], [96, 262059], [108, 262449], [116, 263289], [119, 263469], [129, 264558], [137, 265046], [139, 265406], [144, 265686], [150, 266326], [154, 266486], [157, 266626], [160, 266706], [166, 267500], [173, 267764], [180, 268364], [188, 269084], [190, 269304], [197, 269744], [199, 270344], [202, 270504], [209, 271124], [214, 271704]]}, {"verse": 24, "start": 273440, "end": 285125, "text": "Así dice Jehová, tu Redentor, y formador tuyo desde el vientre: Yo Jehová, que lo hago todo, que extiendo solo los cielos, que extiendo la tierra por mí mismo;", "words": [[0, 273440], [4, 273820], [9, 274140], [17, 274660], [20, 274740], [30, 275660], [32, 276220], [41, 276760], [46, 277320], [52, 277540], [55, 277760], [64, 278662], [67, 278905], [75, 279365], [79, 279525], [82, 279665], [87, 279845], [93, 280665], [97, 280865], [106, 281405], [111, 281785], [115, 282005], [123, 282965], [127, 283045], [136, 283625], [139, 283765], [146, 284145], [150, 284405], [153, 284585]]}, {"verse": 25, "start": 285799, "end": 294641, "text": "Que deshago las señales de los adivinos, y enloquezco a los agoreros; que hago volver atrás los sabios, y desvanezco su sabiduría;", "words": [[0, 285799], [4, 286041], [12, 286541], [16, 286661], [24, 287161], [27, 287281], [31, 287401], [41, 288061], [43, 288481], [54, 289141], [56, 289241], [60, 289341], [70, 290634], [74, 290731], [79, 291011], [86, 291351], [92, 291751], [96, 292051], [104, 292611], [106, 292991], [117, 293671], [120, 293791]]}, {"verse": 26, "start": 295334, "end": 309259, "text": "Que despierta la palabra de su siervo, y cumple el consejo de sus mensajeros; que dice a Jerusalén: Serás habitada; y a las ciudades de Judá: Reedificadas serán, y sus ruinas levantaré;", "words": [[0, 295334], [4, 295398], [14, 296018], [17, 296118], [25, 296458], [28, 296658], [31, 296798], [39, 297338], [41, 297638], [48, 298078], [51, 298198], [59, 298718], [62, 298838], [66, 298998], [78, 300462], [82, 300546], [87, 300806], [89, 300946], [100, 302247], [106, 302608], [116, 303835], [118, 303958], [120, 304038], [124, 304118], [133, 304658], [136, 304838], [142, 306329], [155, 306739], [162, 307279], [164, 307739], [168, 307919], [175, 308459]]}, {"verse": 27, "start": 309956, "end": 314314, "text": "Que dice al profundo: Sécate, y tus ríos haré secar;", "words": [[0, 309956], [4, 310172], [9, 310472], [12, 310632], [22, 311912], [30, 312434], [32, 312794], [36, 312994], [41, 313454], [46, 313814]]}, {"verse": 28, "start": 315006, "end": 326371, "text": "Que dice de Ciro: Es mi pastor, y cumplirá todo lo que yo quiero, al decir a Jerusalén, Serás edificada; y al templo: Serás fundado.", "words": [[0, 315006], [4, 315256], [9, 315536], [12, 315876], [18, 316795], [21, 316992], [24, 317132], [32, 317552], [34, 317952], [43, 318572], [48, 318952], [51, 319192], [55, 319312], [58, 319452], [66, 320032], [69, 320312], [75, 320632], [77, 320812], [88, 321515], [94, 322219], [105, 323450], [107, 323575], [110, 323675], [118, 324770], [124, 325091]]}]}