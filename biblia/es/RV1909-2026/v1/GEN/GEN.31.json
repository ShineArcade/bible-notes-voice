{"book": "GEN", "chapter": 31, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 457529, "verses": [{"verse": 1, "start": 300, "end": 10709, "text": "Y oía él las palabras de los hijos de Labán, que decían: Jacob ha tomado todo lo que era de nuestro padre; y de lo que era de nuestro padre ha adquirido toda esta grandeza.", "words": [[0, 300], [2, 502], [6, 842], [9, 1222], [13, 1382], [22, 1742], [25, 2002], [29, 2102], [35, 2402], [38, 2582], [45, 3002], [49, 3442], [57, 4518], [63, 4887], [66, 5207], [73, 5607], [78, 5847], [81, 6067], [85, 6227], [89, 6387], [92, 6507], [100, 6667], [107, 7494], [109, 7576], [112, 7676], [115, 7796], [119, 7956], [123, 8136], [126, 8256], [134, 8436], [140, 9116], [143, 9196], [153, 9636], [158, 9816], [163, 10076]]}, {"verse": 2, "start": 10989, "end": 17242, "text": "Miraba también Jacob el semblante de Labán, y veía que no era para con él como ayer y antes de ayer.", "words": [[0, 10989], [7, 11374], [15, 11694], [21, 12134], [24, 12434], [34, 13014], [37, 13194], [44, 13614], [46, 13994], [51, 14314], [55, 14474], [58, 14654], [62, 14814], [67, 15034], [71, 15274], [74, 15434], [79, 15674], [84, 16074], [86, 16314], [92, 16634], [95, 16834]]}, {"verse": 3, "start": 17592, "end": 25314, "text": "También Jehová dijo a Jacob: Vuélvete a la tierra de tus padres, y a tu parentela; que yo seré contigo.", "words": [[0, 17592], [8, 17856], [15, 18441], [20, 18631], [22, 18821], [29, 19659], [38, 20240], [40, 20380], [43, 20480], [50, 20820], [53, 21020], [57, 21200], [65, 21660], [67, 22280], [69, 22400], [72, 22520], [83, 23821], [87, 23921], [90, 24081], [95, 24421]]}, {"verse": 4, "start": 25594, "end": 30339, "text": "Y envió Jacob, y llamó a Raquel y a Lea al campo a sus ovejas,", "words": [[0, 25594], [2, 25741], [8, 26141], [15, 26521], [17, 26866], [23, 27226], [25, 27346], [32, 27726], [34, 28026], [36, 28326], [40, 28626], [43, 28886], [49, 29286], [51, 29426], [55, 29526]]}, {"verse": 5, "start": 30689, "end": 38569, "text": "Y les dijo: Veo que el semblante de vuestro padre no es para conmigo como ayer y antes de ayer: mas el Dios de mi padre ha sido conmigo.", "words": [[0, 30689], [2, 30833], [6, 30973], [12, 31732], [16, 32011], [20, 32131], [23, 32231], [33, 32751], [36, 32871], [44, 33191], [50, 33511], [53, 33791], [56, 33991], [61, 34151], [69, 34631], [74, 34851], [79, 35191], [81, 35431], [87, 35711], [90, 35891], [96, 36470], [100, 36610], [103, 36790], [108, 36990], [111, 37170], [114, 37290], [120, 37690], [123, 37770], [128, 37930]]}, {"verse": 6, "start": 38919, "end": 42863, "text": "Y vosotras sabéis que con todas mis fuerzas he servido a vuestro padre:", "words": [[0, 38919], [2, 39040], [11, 39520], [18, 39880], [22, 40020], [26, 40220], [32, 40420], [36, 40680], [44, 41260], [47, 41460], [55, 41920], [57, 42020], [65, 42360]]}, {"verse": 7, "start": 43213, "end": 50035, "text": "Y vuestro padre me ha engañado, y me ha cambiado el salario diez veces: pero Dios no le ha permitido que me hiciese mal.", "words": [[0, 43213], [2, 43316], [10, 43636], [16, 43936], [19, 44196], [22, 44276], [32, 44876], [34, 45216], [37, 45336], [40, 45456], [49, 45916], [52, 46016], [60, 46456], [65, 46616], [72, 47426], [77, 47568], [82, 47788], [85, 48108], [88, 48248], [91, 48328], [101, 48948], [105, 49068], [108, 49228], [116, 49608]]}, {"verse": 8, "start": 50385, "end": 62923, "text": "Si él decía así: Los pintados serán tu salario; entonces todas las ovejas parían pintados: y si decía así: Los listados serán tu salario; entonces todas las ovejas parían listados.", "words": [[0, 50385], [3, 50605], [6, 50765], [12, 51045], [17, 51866], [21, 51967], [30, 52507], [36, 52867], [39, 52987], [48, 53842], [57, 54539], [63, 54699], [67, 54999], [74, 55379], [81, 55779], [91, 56839], [93, 56996], [96, 57076], [102, 57476], [107, 58210], [111, 58519], [120, 58869], [126, 59229], [129, 59329], [138, 60149], [147, 60614], [153, 60954], [157, 61294], [164, 61734], [171, 62134]]}, {"verse": 9, "start": 63273, "end": 66849, "text": "Así quitó Dios el ganado de vuestro padre, y me lo dio a mí.", "words": [[0, 63273], [4, 63509], [10, 63849], [15, 64169], [18, 64349], [25, 64749], [28, 64869], [36, 65189], [43, 65709], [45, 65889], [48, 66029], [51, 66169], [55, 66329], [57, 66509]]}, {"verse": 10, "start": 67199, "end": 78507, "text": "Y sucedió que al tiempo que las ovejas estaban en celo, alcé yo mis ojos y vi en sueños, y he aquí los machos que cubrían a las hembras eran listados, pintados y abigarrados.", "words": [[0, 67199], [2, 67303], [10, 67763], [14, 67943], [17, 68083], [24, 68403], [28, 68663], [32, 68823], [39, 69243], [47, 69703], [50, 69943], [56, 70330], [61, 70716], [64, 71103], [68, 71263], [73, 71603], [75, 71983], [78, 72163], [81, 72283], [89, 73145], [91, 73285], [94, 73405], [99, 73645], [103, 73825], [110, 74305], [114, 74405], [122, 74885], [124, 74965], [128, 75125], [136, 75525], [141, 75765], [151, 76865], [160, 77465], [162, 77995]]}, {"verse": 11, "start": 78857, "end": 83711, "text": "Y me dijo el ángel de Dios en sueños: Jacob. Y yo dije: Aquí estoy.", "words": [[0, 78857], [2, 78967], [5, 79067], [10, 79287], [13, 79447], [19, 79767], [22, 79867], [27, 80067], [30, 80247], [38, 81424], [45, 81928], [47, 82053], [50, 82173], [56, 82894], [61, 83101]]}, {"verse": 12, "start": 84061, "end": 94424, "text": "Y él dijo: Alza ahora tus ojos, y verás todos los machos que cubren a las ovejas listados, pintados y abigarrados; porque yo he visto todo lo que Labán te ha hecho.", "words": [[0, 84061], [2, 84191], [5, 84311], [11, 84945], [16, 85342], [22, 85602], [26, 85822], [32, 86202], [34, 86582], [40, 86922], [46, 87142], [50, 87422], [57, 87882], [61, 88002], [68, 88402], [70, 88482], [74, 88622], [81, 89002], [91, 90002], [100, 90622], [102, 91167], [115, 91893], [122, 92347], [125, 92547], [128, 92647], [134, 92867], [139, 93187], [142, 93387], [146, 93554], [152, 93720], [155, 93887], [158, 94047]]}, {"verse": 13, "start": 94774, "end": 104477, "text": "Yo soy el Dios de Bet-el, donde tú ungiste la columna, y donde me hiciste un voto. Levántate ahora, y sal de esta tierra, y vuélvete a la tierra de tu naturaleza.", "words": [[0, 94774], [3, 94919], [7, 95099], [10, 95299], [15, 95579], [18, 95699], [26, 96499], [32, 96739], [35, 96999], [43, 97459], [46, 97599], [55, 98199], [57, 98559], [63, 98759], [66, 98979], [74, 99419], [77, 99539], [83, 100202], [93, 100689], [100, 100929], [102, 101109], [106, 101329], [109, 101489], [114, 101649], [122, 102049], [124, 102362], [133, 102676], [135, 102989], [138, 103089], [145, 103369], [148, 103569], [151, 103709]]}, {"verse": 14, "start": 104757, "end": 111763, "text": "Y respondió Raquel y Lea, y le dijeron: ¿Tenemos ya parte ni heredad en la casa de nuestro padre?", "words": [[0, 104757], [2, 104914], [12, 105474], [19, 105894], [21, 106194], [26, 106574], [28, 106934], [31, 107054], [40, 108009], [49, 108351], [52, 108631], [58, 108951], [61, 109331], [69, 109871], [72, 110091], [75, 110251], [80, 110531], [83, 110771], [91, 110951]]}, {"verse": 15, "start": 112113, "end": 119544, "text": "¿No nos tiene ya como por extrañas, pues que nos vendió, y aun se ha comido del todo nuestro precio?", "words": [[0, 112113], [4, 112278], [8, 112518], [14, 112758], [17, 113038], [22, 113298], [26, 113578], [36, 114718], [41, 115118], [45, 115298], [49, 115458], [57, 115958], [59, 116598], [63, 116798], [66, 117078], [69, 117178], [76, 117638], [80, 117838], [85, 118218], [93, 118518]]}, {"verse": 16, "start": 119894, "end": 129968, "text": "Porque toda la riqueza que Dios ha quitado a nuestro padre, nuestra es y de nuestros hijos: ahora pues, haz todo lo que Dios te ha dicho.", "words": [[0, 119894], [7, 120116], [12, 120456], [15, 120716], [23, 121336], [27, 121516], [32, 121796], [35, 122096], [43, 122636], [45, 122716], [53, 122896], [60, 123896], [68, 124136], [71, 124836], [73, 125156], [76, 125276], [85, 125496], [92, 126533], [98, 126792], [104, 127152], [108, 127912], [113, 128232], [116, 128532], [120, 128692], [125, 129012], [128, 129292], [131, 129412]]}, {"verse": 17, "start": 130318, "end": 135581, "text": "Entonces se levantó Jacob, y subió sus hijos y sus mujeres sobre los camellos.", "words": [[0, 130318], [9, 130778], [12, 131138], [20, 131658], [27, 132038], [29, 132453], [35, 132853], [39, 133053], [45, 133393], [47, 133593], [51, 133773], [59, 134153], [65, 134593], [69, 134793]]}, {"verse": 18, "start": 135931, "end": 149541, "text": "Y puso en camino todo su ganado, y toda su hacienda que había adquirido, el ganado de su ganancia que había obtenido en Padan-aram, para volverse a Isaac su padre en la tierra de Canaán.", "words": [[0, 135931], [2, 136052], [7, 136392], [10, 136512], [17, 136872], [22, 137232], [25, 137512], [33, 137992], [35, 138512], [40, 138772], [43, 139012], [52, 139492], [56, 139652], [62, 139932], [73, 141052], [76, 141492], [83, 141932], [86, 142092], [89, 142272], [98, 142892], [102, 143092], [108, 143372], [117, 144332], [120, 144572], [132, 145814], [137, 145979], [146, 146519], [148, 146659], [154, 147239], [157, 147339], [163, 147999], [166, 148139], [169, 148259], [176, 148579], [179, 149092]]}, {"verse": 19, "start": 149891, "end": 155749, "text": "Y Labán había ido a trasquilar sus ovejas: y Raquel hurtó los ídolos de su padre.", "words": [[0, 149891], [2, 150017], [8, 150437], [14, 150737], [18, 151057], [20, 151407], [31, 151757], [35, 151937], [43, 152900], [45, 153018], [52, 153398], [58, 153958], [62, 154278], [69, 154898], [72, 154998], [75, 155118]]}, {"verse": 20, "start": 156099, "end": 160939, "text": "Y engañó Jacob a Labán arameo, no haciéndole saber que se huía.", "words": [[0, 156099], [2, 156240], [9, 156700], [15, 157000], [17, 157360], [23, 157720], [31, 158700], [34, 158940], [45, 159560], [51, 159840], [55, 160100], [58, 160260]]}, {"verse": 21, "start": 161289, "end": 169261, "text": "Huyó, pues, con todo lo que tenía; y se levantó, y pasó el río, y puso su rostro al monte de Galaad.", "words": [[0, 161289], [6, 161734], [12, 162494], [16, 162634], [21, 162914], [24, 163114], [28, 163254], [35, 164048], [37, 164174], [40, 164274], [49, 164994], [51, 165314], [56, 165594], [59, 165814], [64, 166274], [66, 166574], [71, 166894], [74, 167074], [81, 167674], [84, 167914], [90, 168294], [93, 168494]]}, {"verse": 22, "start": 169611, "end": 173889, "text": "Y fue dicho a Labán al tercero día como Jacob se había huido.", "words": [[0, 169611], [2, 169738], [6, 169898], [12, 170198], [14, 170418], [20, 170838], [23, 171358], [31, 171918], [35, 172158], [40, 172438], [46, 172778], [49, 173058], [55, 173278]]}, {"verse": 23, "start": 174239, "end": 182195, "text": "Entonces tomó a sus hermanos consigo, y fue tras él camino de siete días, y le alcanzó en el monte de Galaad.", "words": [[0, 174239], [9, 174721], [14, 175341], [16, 175501], [20, 175681], [29, 176241], [38, 176801], [40, 177256], [44, 177436], [49, 177696], [52, 178076], [59, 178356], [62, 178656], [68, 178976], [74, 179436], [76, 179644], [79, 179851], [87, 180611], [90, 180811], [93, 180951], [99, 181271], [102, 181763]]}, {"verse": 24, "start": 182545, "end": 189875, "text": "Y vino Dios a Labán arameo en sueños aquella noche, y le dijo: Cuídate de no hablar a Jacob con dureza.", "words": [[0, 182545], [2, 182669], [7, 182869], [12, 183169], [14, 183499], [20, 183829], [27, 184529], [30, 184749], [37, 185349], [45, 185689], [52, 185989], [54, 186434], [57, 186554], [63, 187247], [71, 187584], [74, 187864], [77, 188024], [84, 188304], [86, 188424], [92, 188744], [96, 189024]]}, {"verse": 25, "start": 190155, "end": 199321, "text": "Alcanzó pues Labán a Jacob, y este había fijado su tienda en el monte: y Labán plantó su tienda con sus hermanos en el monte de Galaad.", "words": [[0, 190155], [8, 190842], [13, 191062], [19, 191482], [21, 191622], [28, 191962], [30, 192447], [35, 192667], [41, 192927], [48, 193467], [51, 193627], [58, 193987], [61, 194147], [64, 194247], [71, 195140], [73, 195395], [79, 195755], [86, 196235], [89, 196355], [96, 196775], [100, 196975], [104, 197175], [113, 197815], [116, 197955], [119, 198075], [125, 198415], [128, 198655]]}, {"verse": 26, "start": 199671, "end": 206103, "text": "Y dijo Labán a Jacob: ¿Qué has hecho, que me hurtaste el corazón, y has traído a mis hijas como prisioneras de guerra?", "words": [[0, 199671], [2, 199843], [7, 200053], [13, 200553], [15, 200988], [22, 201570], [27, 201665], [31, 201845], [38, 202045], [42, 202205], [45, 202485], [54, 202765], [57, 202925], [66, 203345], [68, 203620], [72, 203780], [79, 204100], [81, 204220], [85, 204360], [91, 204700], [96, 205070], [108, 205440], [111, 205620]]}, {"verse": 27, "start": 206453, "end": 215115, "text": "¿Por qué te escondiste para huir, y me engañaste, y no me diste noticia, para que yo te despidiera con alegría y con cantares, con tamborín y vihuela?", "words": [[0, 206453], [5, 206570], [9, 206730], [12, 206850], [23, 207390], [28, 207630], [34, 208010], [36, 208130], [39, 208210], [50, 208790], [52, 209070], [55, 209210], [58, 209330], [64, 209670], [73, 210550], [78, 210810], [82, 210950], [85, 211110], [88, 211230], [99, 211830], [103, 212010], [111, 212550], [113, 212710], [117, 212890], [127, 213650], [131, 213750], [140, 214310], [142, 214550]]}, {"verse": 28, "start": 215465, "end": 219971, "text": "Que aun no me dejaste besar mis hijos y mis hijas. Ahora locamente has hecho.", "words": [[0, 215465], [4, 215562], [8, 215742], [11, 215942], [14, 216042], [22, 216482], [28, 216782], [32, 217062], [38, 217362], [40, 217562], [44, 217722], [51, 218495], [57, 218762], [67, 219302], [71, 219522]]}, {"verse": 29, "start": 220321, "end": 227683, "text": "Poder hay en mi mano para haceros mal: mas el Dios de vuestro padre me habló anoche diciendo: Cuídate de no hablar a Jacob con dureza.", "words": [[0, 220321], [6, 220625], [10, 220725], [13, 220845], [16, 220965], [21, 221205], [26, 221465], [34, 221925], [39, 222537], [43, 222682], [46, 222862], [51, 223102], [54, 223202], [62, 223522], [68, 223862], [71, 223962], [77, 224222], [84, 224542], [94, 225417], [102, 225760], [105, 225980], [108, 226140], [115, 226420], [117, 226540], [123, 226840], [127, 227080]]}, {"verse": 30, "start": 228033, "end": 233352, "text": "Y ya que te ibas, porque tenías deseo de la casa de tu padre, ¿por qué me hurtaste mis dioses?", "words": [[0, 228033], [2, 228119], [5, 228279], [9, 228399], [12, 228539], [18, 229179], [25, 229379], [32, 229759], [38, 230159], [41, 230239], [44, 230339], [49, 230579], [52, 230779], [55, 230899], [62, 231659], [67, 231879], [71, 232019], [74, 232139], [83, 232539], [87, 232719]]}, {"verse": 31, "start": 233632, "end": 240469, "text": "Y Jacob respondió, y dijo a Labán: Porque tuve miedo; pues dije, que quizá me quitarías por fuerza tus hijas.", "words": [[0, 233632], [2, 233774], [8, 234014], [19, 234814], [21, 235034], [26, 235264], [28, 235494], [35, 236263], [42, 236442], [47, 236742], [54, 237500], [59, 237632], [65, 237932], [69, 238332], [75, 238672], [78, 238732], [88, 239172], [92, 239372], [99, 239692], [103, 239892]]}, {"verse": 32, "start": 240819, "end": 250476, "text": "En quien halles tus dioses, no viva: delante de nuestros hermanos reconoce lo que yo tenga tuyo, y llévatelo. Jacob no sabía que Raquel los había hurtado.", "words": [[0, 240819], [3, 240945], [9, 241125], [16, 241305], [20, 241485], [28, 241985], [31, 242245], [37, 242916], [45, 243339], [48, 243459], [57, 243619], [66, 244619], [75, 245039], [78, 245179], [82, 245279], [85, 245419], [91, 245619], [97, 246079], [99, 246299], [110, 247208], [116, 247512], [119, 247892], [125, 248312], [129, 248492], [136, 248932], [140, 249252], [146, 249892]]}, {"verse": 33, "start": 250826, "end": 262768, "text": "Y entró Labán en la tienda de Jacob, y en la tienda de Lea, y en la tienda de las dos siervas, y no los halló, y salió de la tienda de Lea, y vino a la tienda de Raquel.", "words": [[0, 250826], [2, 251124], [8, 251564], [14, 252004], [17, 252224], [20, 252384], [27, 252784], [30, 252924], [37, 253684], [39, 253844], [42, 253964], [45, 254084], [52, 254504], [55, 254684], [60, 255544], [62, 255584], [65, 255704], [68, 255824], [75, 256264], [78, 256424], [82, 256564], [86, 256724], [95, 257564], [97, 257804], [100, 258024], [104, 258324], [111, 259228], [113, 259353], [119, 259753], [122, 259873], [125, 259993], [132, 260413], [135, 260553], [140, 260933], [142, 261093], [147, 261333], [149, 261473], [152, 261533], [159, 261913], [162, 262376]]}, {"verse": 34, "start": 263118, "end": 273026, "text": "Y tomó Raquel los ídolos, y los puso en la montura de un camello, y se sentó sobre ellos: y buscó Labán por toda la tienda, y no los halló.", "words": [[0, 263118], [2, 263397], [7, 263737], [14, 264077], [18, 264317], [26, 264977], [28, 265297], [32, 265437], [37, 265777], [40, 265897], [43, 265997], [51, 266497], [54, 266657], [57, 266797], [66, 267357], [68, 267737], [71, 267877], [77, 268377], [83, 268657], [90, 269604], [92, 269749], [98, 270089], [104, 270429], [108, 270649], [113, 270909], [116, 271149], [124, 271629], [126, 272089], [129, 272422], [133, 272755]]}, {"verse": 35, "start": 273376, "end": 284602, "text": "Y ella dijo a su padre: No se enoje mi señor, porque no me puedo levantar delante de ti; pues tengo la menstruación. Y él buscó, pero no halló los ídolos.", "words": [[0, 273376], [2, 273570], [7, 273796], [12, 274023], [14, 274263], [17, 274363], [24, 275202], [27, 275388], [30, 275608], [36, 275988], [39, 276128], [46, 276748], [53, 277248], [56, 277448], [59, 277588], [65, 277848], [74, 278588], [82, 279088], [85, 279248], [89, 279791], [94, 279919], [100, 280219], [103, 280399], [117, 281633], [119, 281772], [122, 281912], [129, 282972], [134, 283172], [137, 283392], [143, 283792], [147, 283972]]}, {"verse": 36, "start": 284822, "end": 292434, "text": "Entonces Jacob se enojó y discutió con Labán. Jacob le dijo: ¿Qué falta he cometido? ¿cuál es mi pecado, que me persigues con tanto ardor?", "words": [[0, 284822], [9, 285323], [15, 285538], [18, 285753], [24, 285968], [26, 286183], [35, 286703], [39, 286863], [46, 287548], [52, 287814], [55, 288014], [61, 288653], [66, 288737], [72, 289017], [75, 289237], [85, 290081], [91, 290258], [94, 290338], [97, 290438], [105, 290838], [109, 290998], [112, 291098], [122, 291578], [126, 291738], [132, 291958]]}, {"verse": 37, "start": 292784, "end": 302275, "text": "Pues que has registrado todos mis muebles, ¿qué has hallado de todas las pertenencias de tu casa? Ponlo aquí delante de mis hermanos y tuyos, y juzguen entre nosotros ambos.", "words": [[0, 292784], [5, 292915], [9, 293075], [13, 293275], [24, 293935], [30, 294175], [34, 294495], [43, 295035], [48, 295250], [52, 295430], [60, 295790], [63, 295950], [69, 296130], [73, 296410], [86, 297110], [89, 297310], [92, 297430], [98, 298153], [104, 298412], [109, 298612], [117, 299012], [120, 299152], [124, 299272], [133, 299752], [135, 299872], [142, 300312], [144, 300492], [152, 300952], [158, 301152], [167, 301572]]}, {"verse": 38, "start": 302625, "end": 309584, "text": "Estos veinte años he estado contigo: tus ovejas y tus cabras nunca abortaron, ni yo comí carnero de tus ovejas.", "words": [[0, 302625], [6, 302904], [13, 303224], [18, 303604], [21, 303784], [28, 304024], [37, 304950], [41, 305046], [48, 305546], [50, 305686], [54, 305846], [61, 306286], [67, 306486], [78, 307406], [81, 307746], [84, 307926], [89, 308226], [97, 308686], [100, 308766], [104, 308926]]}, {"verse": 39, "start": 309934, "end": 317510, "text": "Nunca te traje lo arrebatado por las fieras; yo pagaba el daño; lo hurtado así de día como de noche, a mí me lo cobrabas.", "words": [[0, 309934], [6, 310277], [9, 310397], [15, 310737], [18, 310837], [29, 311397], [33, 311557], [37, 311717], [45, 312447], [48, 312747], [55, 313147], [58, 313247], [64, 313919], [67, 314171], [75, 314461], [79, 314701], [82, 314861], [86, 315081], [91, 315341], [94, 315501], [101, 316281], [103, 316341], [106, 316521], [109, 316681], [112, 316821]]}, {"verse": 40, "start": 317860, "end": 322959, "text": "De día me consumía el calor, y de noche la helada, y el sueño se huía de mis ojos.", "words": [[0, 317860], [3, 317962], [7, 318182], [10, 318342], [19, 318942], [22, 319062], [29, 319402], [31, 319862], [34, 319982], [40, 320202], [43, 320422], [51, 320842], [53, 321162], [56, 321262], [62, 321662], [65, 321842], [70, 322162], [73, 322282], [77, 322402]]}, {"verse": 41, "start": 323309, "end": 331685, "text": "Así he estado veinte años en tu casa: catorce años te serví por tus dos hijas, y seis años por tu ganado; y has cambiado mi salario diez veces.", "words": [[0, 323309], [4, 323530], [7, 323650], [14, 323920], [21, 324190], [26, 324530], [29, 324770], [32, 324870], [38, 325705], [46, 325915], [51, 326295], [54, 326535], [60, 326915], [64, 327015], [68, 327215], [72, 327395], [79, 327895], [81, 328055], [86, 328255], [91, 328575], [95, 328875], [98, 328955], [106, 329718], [108, 329845], [112, 329965], [121, 330445], [124, 330565], [132, 330885], [137, 331205]]}, {"verse": 42, "start": 332035, "end": 344497, "text": "Si el Dios de mi padre, el Dios de Abraham, y el temor de Isaac, no fuera conmigo, de cierto me enviarías ahora vacío: vio Dios mi aflicción y el trabajo de mis manos, y te reprendió anoche.", "words": [[0, 332035], [3, 332236], [6, 332356], [11, 332616], [14, 332736], [17, 332856], [24, 333816], [27, 333876], [32, 334156], [35, 334276], [44, 334676], [46, 334891], [49, 335031], [55, 335351], [58, 335491], [65, 335951], [68, 336331], [74, 336591], [83, 337731], [86, 337791], [93, 338031], [96, 338391], [106, 338971], [112, 339231], [119, 340379], [123, 340560], [128, 340780], [131, 340920], [141, 341520], [143, 341660], [146, 341780], [154, 342180], [157, 342360], [161, 342460], [168, 342880], [170, 343180], [173, 343550], [183, 343920]]}, {"verse": 43, "start": 344777, "end": 359154, "text": "Y respondió Labán, y dijo a Jacob: Las hijas son hijas mías, y los hijos, hijos míos son, y las ovejas son mis ovejas, y todo lo que tú ves es mío: ¿y qué puedo yo hacer hoy a estas mis hijas, o a sus hijos que ellas han parido?", "words": [[0, 344777], [2, 344894], [12, 345514], [19, 345974], [21, 346194], [26, 346474], [28, 346614], [35, 347322], [39, 347441], [45, 347781], [49, 347921], [55, 348241], [61, 348921], [63, 349201], [67, 349361], [74, 349961], [80, 350121], [85, 350521], [90, 351121], [92, 351241], [96, 351401], [103, 351761], [107, 352001], [111, 352161], [119, 352921], [121, 353101], [126, 353281], [129, 353481], [133, 353601], [136, 353781], [140, 353981], [143, 354301], [148, 354980], [151, 355087], [155, 355207], [161, 355507], [164, 355687], [170, 355947], [174, 356127], [176, 356227], [182, 356387], [186, 356647], [193, 357127], [195, 357507], [197, 357607], [201, 357787], [207, 357987], [211, 358247], [217, 358427], [221, 358607]]}, {"verse": 44, "start": 359504, "end": 364854, "text": "Ven pues ahora, y hagamos alianza yo y tú; y sea en testimonio entre mí y entre ti.", "words": [[0, 359504], [4, 359684], [9, 359864], [16, 360244], [18, 360424], [26, 360764], [34, 361344], [37, 361604], [39, 361744], [43, 362284], [45, 362410], [49, 362650], [52, 362850], [63, 363490], [69, 363710], [72, 363990], [74, 364210], [80, 364450]]}, {"verse": 45, "start": 365134, "end": 369621, "text": "Entonces Jacob tomó una piedra, y la levantó por señal.", "words": [[0, 365134], [9, 365938], [15, 366378], [20, 366918], [24, 367058], [32, 367918], [34, 368098], [37, 368218], [45, 368798], [49, 368958]]}, {"verse": 46, "start": 369971, "end": 380611, "text": "Y dijo Jacob a sus hermanos: Recoged piedras. Y tomaron piedras e hicieron un montón de piedras; y comieron allí sobre aquel montón.", "words": [[0, 369971], [2, 370200], [7, 370460], [13, 370820], [15, 371360], [19, 371500], [29, 372497], [37, 372707], [46, 373790], [48, 373931], [56, 374391], [64, 375191], [66, 375471], [75, 376071], [78, 376291], [85, 376791], [88, 377111], [97, 378176], [99, 378263], [108, 378723], [113, 379023], [119, 379363], [125, 379743]]}, {"verse": 47, "start": 380961, "end": 386469, "text": "Y lo llamó Labán Jegar Sahadutha: y lo llamó Jacob Galaad.", "words": [[0, 380961], [2, 381221], [5, 381341], [11, 381701], [17, 382521], [23, 383197], [34, 384036], [36, 384160], [39, 384737], [45, 385314], [51, 385891]]}, {"verse": 48, "start": 386819, "end": 393730, "text": "Porque Labán dijo: Este montón es testigo hoy entre mí y entre ti; por eso fue llamado su nombre Galaad;", "words": [[0, 386819], [7, 387175], [13, 387615], [19, 388352], [24, 388554], [31, 388874], [34, 389154], [42, 389574], [46, 389754], [52, 389974], [55, 390214], [57, 390454], [63, 390674], [67, 391292], [71, 391396], [75, 391616], [79, 391836], [87, 392116], [90, 392396], [97, 392736]]}, {"verse": 49, "start": 394080, "end": 400630, "text": "Y Mizpa, por cuanto dijo: Vigile Jehová entre mí y entre ti, cuando nos apartemos el uno del otro.", "words": [[0, 394080], [2, 394571], [9, 395081], [13, 395341], [20, 395581], [26, 396436], [33, 396895], [40, 397355], [46, 397575], [49, 397855], [51, 398055], [57, 398255], [61, 398535], [68, 398875], [72, 399055], [82, 399465], [85, 399875], [89, 400055], [93, 400215]]}, {"verse": 50, "start": 400980, "end": 409991, "text": "Si afliges mis hijas, o si tomas otras mujeres además de mis hijas, aunque no haya otro testigo entre nosotros; mira, Dios es testigo entre mí y entre ti.", "words": [[0, 400980], [3, 401104], [11, 401564], [15, 401724], [22, 402224], [24, 402404], [27, 402544], [33, 402864], [39, 403044], [47, 403504], [54, 403904], [57, 404124], [61, 404264], [68, 404904], [75, 405104], [78, 405364], [83, 405524], [88, 405764], [96, 406284], [102, 406464], [112, 407438], [118, 407643], [123, 408016], [126, 408390], [134, 408763], [140, 408963], [143, 409223], [145, 409403], [151, 409603]]}, {"verse": 51, "start": 410271, "end": 417905, "text": "Dijo más Labán a Jacob: He aquí este montón de piedras, y he aquí esta señal, que he erigido entre mí y ti.", "words": [[0, 410271], [5, 410573], [9, 410853], [15, 411533], [17, 411653], [24, 412410], [27, 412559], [32, 412839], [37, 413119], [44, 413439], [47, 413679], [56, 414199], [58, 414599], [61, 414739], [66, 414979], [71, 415259], [78, 415839], [82, 416219], [85, 416359], [93, 416779], [99, 416999], [102, 417299], [104, 417539]]}, {"verse": 52, "start": 418255, "end": 428146, "text": "Testigo sea este montón, y testigo sea esta columna, que ni yo pasaré contra ti este montón, ni tú pasarás contra mí este montón ni esta columna, para mal.", "words": [[0, 418412], [8, 418672], [12, 418892], [17, 419132], [25, 419972], [27, 420172], [35, 420612], [39, 420832], [44, 421092], [53, 421932], [57, 422092], [60, 422232], [63, 422392], [70, 422812], [77, 423052], [80, 423292], [85, 423492], [93, 424332], [96, 424472], [99, 424612], [107, 425092], [114, 425332], [117, 425572], [122, 425772], [129, 426172], [132, 426432], [137, 426652], [146, 427452], [151, 427692]]}, {"verse": 53, "start": 428496, "end": 438089, "text": "El Dios de Abraham, y el Dios de Nacor juzgue entre nosotros, el Dios de sus padres. Y Jacob juró por el temor de Isaac su padre.", "words": [[0, 428496], [3, 428656], [8, 428916], [11, 429156], [20, 429596], [22, 430056], [25, 430196], [30, 430396], [33, 430596], [39, 431056], [46, 431456], [52, 431696], [62, 432256], [65, 432896], [70, 433116], [73, 433296], [77, 433436], [85, 434467], [87, 434585], [93, 435185], [98, 435785], [102, 435985], [105, 436125], [111, 436505], [114, 436645], [120, 437285], [123, 437405]]}, {"verse": 54, "start": 438439, "end": 447774, "text": "Entonces Jacob inmoló víctimas en el monte, y llamó a sus hermanos a comer pan: y comieron pan, y durmieron aquella noche en el monte.", "words": [[0, 438439], [9, 439094], [15, 439774], [22, 440454], [31, 440954], [34, 441134], [37, 441254], [44, 441554], [46, 441834], [52, 442194], [54, 442274], [58, 442414], [67, 443034], [69, 443134], [75, 443374], [80, 444177], [82, 444295], [91, 444715], [96, 445135], [98, 445435], [108, 446015], [116, 446435], [122, 446735], [125, 447035], [128, 447175]]}, {"verse": 55, "start": 448124, "end": 457129, "text": "Y se levantó Labán de mañana, y besó sus hijos y sus hijas, y los bendijo; y retrocedió y se volvió a su lugar.", "words": [[0, 448124], [2, 448250], [5, 448430], [13, 449030], [19, 449630], [22, 449830], [30, 450370], [32, 450665], [37, 451045], [41, 451305], [47, 451625], [49, 451845], [53, 452085], [60, 452465], [62, 452605], [66, 452765], [75, 453867], [77, 454144], [88, 455124], [90, 455584], [93, 455744], [100, 456224], [102, 456344], [105, 456504]]}]}