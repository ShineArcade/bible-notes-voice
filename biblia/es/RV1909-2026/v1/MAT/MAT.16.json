{"book": "MAT", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 257842, "verses": [{"verse": 1, "start": 300, "end": 8237, "text": "Y llegándose los fariseos y los saduceos para tentarle, le pedían que les mostrase señal del cielo.", "words": [[0, 300], [2, 427], [13, 1167], [17, 1347], [26, 2127], [28, 2247], [32, 2387], [41, 3187], [46, 4117], [56, 5047], [59, 5267], [66, 5787], [70, 5987], [74, 6147], [83, 6827], [89, 7427], [93, 7567]]}, {"verse": 2, "start": 8687, "end": 17534, "text": "Pero él respondiendo, les dijo: Cuando es la tarde del día, decís: Sereno; porque el cielo está rojizo.", "words": [[0, 8687], [5, 9031], [8, 9771], [22, 10791], [26, 10891], [32, 11817], [39, 11982], [42, 12222], [45, 12382], [51, 12662], [55, 12962], [60, 13510], [67, 14358], [75, 15519], [82, 15801], [85, 16001], [91, 16381], [96, 16681]]}, {"verse": 3, "start": 17984, "end": 30299, "text": "Y a la mañana: Hoy tempestad; porque el cielo está rojizo y sombrío. Hipócritas, que sabéis hacer diferencia en el aspecto del cielo; ¿y en las señales de los tiempos no podéis?", "words": [[0, 17984], [2, 18152], [4, 18232], [7, 18292], [15, 19184], [19, 19374], [30, 20520], [37, 20745], [40, 20925], [46, 21325], [51, 21585], [58, 22145], [60, 22285], [69, 23280], [81, 24380], [85, 24520], [92, 24980], [98, 25260], [109, 26000], [112, 26200], [115, 26300], [123, 26780], [127, 26940], [134, 27772], [137, 27888], [140, 28008], [144, 28128], [152, 28708], [155, 28808], [159, 28948], [167, 29428], [170, 29568]]}, {"verse": 4, "start": 30749, "end": 40512, "text": "La generación mala y adúltera demanda señal; pero señal no le será dada, sino la señal de Jonás profeta. Y dejándolos, se fue.", "words": [[0, 30749], [3, 30856], [14, 31496], [19, 31896], [21, 32286], [30, 32676], [38, 33176], [45, 34131], [50, 34431], [56, 35071], [59, 35371], [62, 35671], [67, 35891], [73, 36291], [78, 36571], [81, 36831], [87, 37291], [90, 37411], [96, 37651], [105, 38870], [107, 38997], [119, 39817], [122, 40117]]}, {"verse": 5, "start": 40962, "end": 46629, "text": "Y viniendo sus discípulos del otro lado del lago, se habían olvidado de tomar pan.", "words": [[0, 40962], [2, 41090], [11, 41630], [15, 41810], [26, 42550], [30, 42770], [35, 42990], [40, 43290], [44, 43550], [50, 44290], [53, 44770], [60, 44990], [69, 45590], [72, 45750], [78, 45970]]}, {"verse": 6, "start": 47079, "end": 53772, "text": "Y Jesús les dijo: Mirad, y guardaos de la levadura de los fariseos y de los saduceos.", "words": [[0, 47079], [2, 47203], [8, 47543], [12, 47863], [18, 49399], [25, 49399], [27, 49727], [36, 50087], [39, 50347], [42, 50507], [51, 51027], [54, 51227], [58, 51387], [67, 52287], [69, 52507], [72, 52607], [76, 52767]]}, {"verse": 7, "start": 54222, "end": 59278, "text": "Y ellos pensaban dentro de sí, diciendo: Esto dice porque no tomamos pan.", "words": [[0, 54222], [2, 54348], [8, 54548], [17, 55168], [24, 55488], [27, 55748], [31, 56448], [41, 57389], [46, 57626], [51, 57946], [58, 58286], [61, 58486], [69, 58866]]}, {"verse": 8, "start": 59628, "end": 67094, "text": "Y entendiéndolo Jesús, les dijo: ¿Por qué pensáis dentro de vosotros, hombres de poca fe, que no tomasteis pan?", "words": [[0, 59628], [2, 60082], [16, 60572], [23, 61012], [27, 61432], [33, 62251], [38, 62375], [42, 62515], [50, 63135], [57, 63475], [60, 63815], [70, 64535], [78, 64815], [81, 65015], [86, 65295], [90, 65875], [94, 65935], [97, 66344], [107, 66753]]}, {"verse": 9, "start": 67544, "end": 75129, "text": "¿No entendéis aún, ni os acordáis de los cinco panes entre cinco mil hombres, y cuántos cestos recogisteis?", "words": [[0, 67544], [4, 67732], [14, 68312], [19, 68812], [22, 69312], [25, 69472], [34, 70072], [37, 70252], [41, 70412], [47, 70732], [53, 71272], [59, 71532], [65, 71932], [69, 72212], [78, 72592], [80, 73172], [88, 73532], [95, 73892]]}, {"verse": 10, "start": 75579, "end": 79758, "text": "¿Ni de los siete panes entre cuatro mil, y cuántas canastas tomasteis?", "words": [[0, 75579], [4, 75704], [7, 75804], [11, 75984], [17, 76164], [23, 76704], [29, 76957], [36, 77211], [41, 77464], [43, 77844], [51, 78244], [60, 78904]]}, {"verse": 11, "start": 80208, "end": 88703, "text": "¿Cómo es que no entendéis que no por el pan os dije, que os guardaseis de la levadura de los fariseos y de los saduceos?", "words": [[0, 80208], [6, 80438], [9, 80638], [13, 80778], [16, 80938], [26, 81938], [30, 82038], [33, 82198], [37, 82438], [40, 82558], [44, 82838], [47, 82998], [53, 83918], [57, 84038], [60, 84178], [71, 85058], [74, 85438], [77, 85578], [86, 86078], [89, 86218], [93, 86338], [102, 87118], [104, 87318], [107, 87438], [111, 87578]]}, {"verse": 12, "start": 89153, "end": 98354, "text": "Entonces entendieron que no les había dicho que se guardasen de la levadura de pan, sino de la doctrina de los fariseos y de los saduceos.", "words": [[0, 89153], [9, 89957], [21, 90557], [25, 90757], [28, 90897], [32, 91057], [38, 91317], [44, 91697], [48, 91897], [51, 92037], [61, 92777], [64, 92897], [67, 93057], [76, 93517], [79, 93677], [84, 94077], [89, 94417], [92, 94617], [95, 94757], [104, 95357], [107, 95517], [111, 96017], [120, 96517], [122, 96897], [125, 97017], [129, 97157]]}, {"verse": 13, "start": 98804, "end": 107856, "text": "Y viniendo Jesús a las partes de Cesarea de Filipo, preguntó a sus discípulos, diciendo: ¿Quién dicen los hombres que es el Hijo del hombre?", "words": [[0, 98804], [2, 98908], [11, 99428], [17, 99688], [19, 99928], [23, 100028], [30, 100408], [33, 100798], [41, 101188], [44, 101668], [52, 102148], [61, 102848], [63, 102928], [67, 103108], [79, 103768], [89, 104812], [96, 105136], [102, 105536], [106, 105796], [114, 106236], [118, 106456], [121, 106676], [124, 106816], [129, 107056], [133, 107256]]}, {"verse": 14, "start": 108306, "end": 116256, "text": "Y ellos dijeron: Unos, Juan el Bautista; y otros, Elías; y otros, Jeremías, o alguno de los profetas.", "words": [[0, 108306], [2, 108576], [8, 108846], [17, 109942], [23, 110246], [28, 110566], [31, 110726], [41, 111776], [43, 111955], [50, 112215], [57, 113471], [59, 113614], [66, 113854], [76, 114674], [78, 114914], [85, 115314], [88, 115354], [92, 115474]]}, {"verse": 15, "start": 116606, "end": 120122, "text": "Él les dice: Y vosotros, ¿quién decís que soy?", "words": [[0, 116606], [3, 116815], [7, 116995], [13, 117933], [15, 118039], [25, 118599], [32, 119059], [38, 119559], [42, 119639]]}, {"verse": 16, "start": 120572, "end": 126261, "text": "Y respondiendo Simón Pedro, dijo: Tú eres el Cristo, el Hijo del Dios viviente.", "words": [[0, 120572], [2, 120572], [15, 121660], [21, 122000], [28, 122440], [34, 123586], [37, 123743], [42, 123923], [45, 124103], [53, 124883], [56, 124983], [61, 125203], [65, 125343], [70, 125543]]}, {"verse": 17, "start": 126611, "end": 138750, "text": "Entonces, respondiendo Jesús, le dijo: Bienaventurado eres, Simón, hijo de Jonás; porque no te lo reveló carne ni sangre, sino mi Padre que está en los cielos.", "words": [[0, 126611], [10, 127131], [23, 128251], [30, 129071], [33, 129211], [39, 130728], [54, 131308], [60, 131528], [67, 132368], [72, 132528], [75, 132688], [82, 133642], [89, 133826], [92, 134046], [95, 134166], [98, 134461], [105, 134756], [111, 135051], [114, 135346], [122, 136066], [127, 136386], [130, 136646], [136, 137246], [140, 137526], [145, 137746], [148, 137906], [152, 138006]]}, {"verse": 18, "start": 139200, "end": 150129, "text": "Pero yo también te digo, que tú eres Pedro, y sobre esta piedra edificaré mi iglesia; y las puertas del infierno no prevalecerán contra ella.", "words": [[0, 139200], [5, 139341], [8, 139521], [16, 139841], [19, 140181], [25, 140601], [29, 141081], [32, 141241], [37, 141421], [44, 141981], [46, 142721], [52, 143021], [57, 143401], [64, 144201], [74, 145001], [77, 145553], [86, 146370], [88, 146478], [92, 146578], [100, 146938], [104, 147138], [113, 147798], [116, 148338], [129, 149198], [136, 149578]]}, {"verse": 19, "start": 150579, "end": 162945, "text": "Y a ti daré las llaves del reino de los cielos; y todo lo que ligues en la tierra será ligado en los cielos; y todo lo que desates en la tierra será desatado en los cielos.", "words": [[0, 150579], [2, 150758], [4, 150878], [7, 151058], [12, 151438], [16, 151598], [23, 152158], [27, 152478], [33, 152978], [36, 153098], [40, 153218], [48, 154332], [50, 154584], [55, 154764], [58, 154984], [62, 155104], [69, 155464], [72, 155564], [75, 155704], [82, 156004], [87, 156454], [94, 156904], [97, 157024], [101, 157144], [109, 158171], [111, 158292], [116, 158612], [119, 158932], [123, 159092], [131, 159672], [134, 159952], [137, 160092], [144, 160532], [149, 160932], [158, 161872], [161, 161992], [165, 162152]]}, {"verse": 20, "start": 163395, "end": 168486, "text": "Entonces mandó a sus discípulos que a nadie dijesen que él era Jesús el Cristo.", "words": [[0, 163395], [9, 163875], [15, 164455], [17, 164555], [21, 164695], [32, 165355], [36, 165575], [38, 165695], [44, 166175], [52, 166655], [56, 166855], [59, 167035], [63, 167175], [69, 167633], [72, 168091]]}, {"verse": 21, "start": 168936, "end": 186419, "text": "Desde aquel tiempo comenzó Jesús a declarar a sus discípulos que le convenía ir a Jerusalén, y padecer mucho de los ancianos, y de los príncipes de los sacerdotes, y de los escribas; y ser muerto, y resucitar al tercer día.", "words": [[0, 168936], [6, 169122], [12, 169502], [19, 169822], [27, 170522], [33, 170842], [35, 171122], [44, 171762], [46, 171842], [50, 172022], [61, 172942], [65, 173502], [68, 173642], [77, 174322], [80, 174662], [82, 174762], [93, 176022], [95, 176342], [103, 176862], [109, 177322], [112, 177502], [116, 177662], [126, 178422], [128, 178682], [131, 178782], [135, 179292], [145, 179802], [148, 179982], [152, 180102], [164, 181386], [166, 181533], [169, 181573], [173, 181733], [183, 182963], [185, 183104], [189, 183264], [197, 183924], [199, 184304], [209, 185144], [212, 185424], [219, 185744]]}, {"verse": 22, "start": 186869, "end": 197286, "text": "Y Pedro, tomándolo aparte, comenzó a reprenderle, diciendo: Señor, ten compasión de ti: en ninguna manera esto te acontezca.", "words": [[0, 186869], [2, 187148], [9, 187628], [19, 188188], [27, 189228], [35, 189688], [37, 189788], [50, 190568], [60, 191785], [67, 192426], [71, 192506], [81, 193066], [84, 193206], [88, 193787], [91, 193925], [99, 194185], [106, 194685], [111, 195065], [114, 196205]]}, {"verse": 23, "start": 197636, "end": 209775, "text": "Entonces él, volviéndose, dijo a Pedro: Quítate de delante de mí, Satanás; me eres tropiezo; porque no entiendes lo que es de Dios sino lo que es de los hombres.", "words": [[0, 197636], [9, 198276], [13, 198946], [26, 199646], [31, 200046], [33, 200206], [40, 201031], [48, 201456], [51, 201676], [59, 202116], [62, 202296], [66, 202776], [75, 204055], [78, 204465], [83, 204910], [93, 205590], [100, 205774], [103, 205994], [113, 206674], [116, 206814], [120, 206954], [123, 207094], [126, 207174], [131, 207494], [136, 207954], [139, 208494], [143, 208674], [146, 208834], [149, 208954], [153, 209094]]}, {"verse": 24, "start": 210225, "end": 219700, "text": "Entonces Jesús dijo a sus discípulos: Si alguno quiere venir en pos de mí, niéguese a sí mismo, y tome su cruz, y sígame.", "words": [[0, 210225], [9, 210643], [15, 211243], [20, 211863], [22, 212103], [26, 212303], [38, 213637], [41, 213781], [48, 214221], [55, 214401], [61, 214741], [64, 214981], [68, 215221], [71, 215421], [75, 216041], [84, 216481], [86, 216601], [89, 216701], [96, 217081], [98, 217541], [103, 217821], [106, 217961], [112, 218561], [114, 219163]]}, {"verse": 25, "start": 220150, "end": 228173, "text": "Porque todo el que quiera salvar su vida, la perderá, y todo el que pierda su vida por causa de mí, la hallará.", "words": [[0, 220150], [7, 220373], [12, 220713], [15, 220953], [19, 221093], [26, 221433], [33, 221793], [36, 222073], [42, 222433], [45, 222953], [54, 223573], [56, 224033], [61, 224293], [64, 224513], [68, 224613], [75, 224993], [78, 225153], [83, 225413], [87, 225653], [93, 225873], [96, 226233], [100, 226393], [103, 226893]]}, {"verse": 26, "start": 228623, "end": 237206, "text": "Porque ¿de qué aprovecha al hombre, si gana todo el mundo y pierde su alma? O ¿qué recompensa dará el hombre por su alma?", "words": [[0, 228623], [7, 228905], [11, 229445], [15, 229605], [25, 229965], [28, 230325], [36, 230585], [39, 231045], [44, 231325], [49, 231585], [52, 231805], [58, 232085], [60, 232245], [67, 232645], [70, 232785], [76, 234302], [78, 234302], [83, 234405], [94, 235325], [99, 235725], [102, 235845], [109, 236145], [113, 236425], [116, 236605]]}, {"verse": 27, "start": 237656, "end": 247926, "text": "Porque el Hijo del hombre vendrá en la gloria de su Padre con sus ángeles, y entonces recompensará a cada uno conforme a sus obras.", "words": [[0, 237656], [7, 237932], [10, 238152], [15, 238432], [19, 238632], [26, 239052], [33, 239872], [36, 240172], [39, 240352], [46, 240752], [49, 240912], [52, 241092], [58, 241452], [62, 241752], [66, 241972], [75, 242552], [77, 243092], [86, 243632], [99, 245432], [101, 245672], [106, 245892], [110, 246192], [119, 246972], [121, 247072], [125, 247212]]}, {"verse": 28, "start": 248376, "end": 257442, "text": "De cierto os digo: hay algunos de los que están aquí, que no probarán la muerte, hasta que hayan visto al Hijo del hombre viniendo en su reino.", "words": [[0, 248376], [3, 248500], [10, 248780], [13, 249120], [19, 249859], [23, 250036], [31, 250436], [34, 250616], [38, 250716], [42, 250856], [48, 251056], [54, 251396], [58, 251976], [61, 252176], [70, 252716], [73, 252876], [81, 253356], [87, 254036], [91, 254256], [97, 254596], [103, 254916], [106, 255156], [111, 255336], [115, 255556], [122, 255836], [131, 256436], [134, 256576], [137, 256736]]}]}