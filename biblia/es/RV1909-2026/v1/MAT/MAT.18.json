{"book": "MAT", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 301458, "verses": [{"verse": 1, "start": 300, "end": 6038, "text": "En aquel tiempo se llegaron los discípulos a Jesús, diciendo: ¿Quién es el mayor en el reino de los cielos?", "words": [[0, 300], [3, 444], [9, 744], [16, 1024], [19, 1264], [28, 1704], [32, 1904], [43, 2624], [45, 2824], [52, 3244], [62, 3687], [69, 3946], [72, 4086], [75, 4206], [81, 4546], [84, 4746], [87, 4886], [93, 5186], [96, 5286], [100, 5406]]}, {"verse": 2, "start": 6318, "end": 10231, "text": "Y llamando Jesús a un niño, le puso en medio de ellos,", "words": [[0, 6318], [2, 6479], [11, 6779], [17, 7039], [19, 7319], [22, 7479], [28, 8439], [31, 8579], [36, 9039], [39, 9199], [45, 9459], [48, 9699]]}, {"verse": 3, "start": 10581, "end": 18760, "text": "Y dijo: De cierto os digo, que si no os volvéis y os hacéis como niños, no entraréis en el reino de los cielos.", "words": [[0, 10581], [2, 10909], [8, 11427], [11, 11610], [18, 11930], [21, 12290], [27, 12550], [31, 12955], [34, 13115], [37, 13355], [40, 13495], [48, 14155], [50, 14355], [53, 14515], [60, 14995], [65, 15215], [72, 15615], [75, 16355], [85, 16995], [88, 17175], [91, 17335], [97, 17755], [100, 17875], [104, 18015]]}, {"verse": 4, "start": 19110, "end": 25984, "text": "Así que, cualquiera que se humille como este niño, este es el mayor en el reino de los cielos.", "words": [[0, 19110], [4, 19431], [9, 19631], [20, 20231], [24, 20391], [27, 20551], [35, 20991], [40, 21251], [45, 21471], [51, 22331], [56, 22871], [59, 23411], [62, 23571], [68, 23931], [71, 24271], [74, 24431], [80, 24831], [83, 24951], [87, 25091]]}, {"verse": 5, "start": 26334, "end": 31331, "text": "Y cualquiera que reciba en mi nombre a un niño como este, me recibe a mí.", "words": [[0, 26334], [2, 26439], [13, 26979], [17, 27159], [24, 27739], [27, 27859], [30, 27979], [37, 28319], [39, 28599], [42, 28759], [47, 29139], [52, 29499], [58, 29939], [61, 30254], [68, 30854], [70, 30994]]}, {"verse": 6, "start": 31681, "end": 44681, "text": "Y cualquiera que haga tropezar a alguno de estos pequeños que creen en mí, mejor le fuera que se le colgase al cuello una piedra de un molino movido por un asno, y que se le hundiese en el profundo del mar.", "words": [[0, 31681], [2, 31789], [13, 32269], [17, 32429], [22, 32629], [31, 33369], [33, 33629], [40, 34129], [43, 34209], [49, 34389], [58, 35029], [62, 35169], [68, 35609], [71, 35749], [75, 36390], [81, 36757], [84, 36917], [90, 37137], [94, 37357], [97, 37517], [100, 37637], [108, 38157], [111, 38297], [118, 38677], [122, 38877], [129, 39397], [132, 39517], [135, 39637], [142, 40177], [149, 40597], [153, 40797], [156, 41327], [162, 41857], [164, 42037], [168, 42237], [171, 42537], [174, 42677], [183, 43137], [186, 43337], [189, 43437], [198, 43997], [202, 44237]]}, {"verse": 7, "start": 45031, "end": 55417, "text": "¡Ay del mundo por las causas de tropiezo! porque necesario es que vengan causas de tropiezo; pero ¡ay de aquel hombre por el cual viene la causa de tropiezo!", "words": [[0, 45138], [4, 45278], [8, 45498], [14, 45858], [18, 46178], [22, 46378], [29, 46898], [32, 46998], [42, 48022], [49, 48244], [59, 48884], [62, 49144], [66, 49264], [73, 49624], [80, 50264], [83, 50344], [93, 51351], [98, 51643], [102, 51973], [105, 52113], [111, 52353], [118, 52573], [122, 52853], [125, 52953], [130, 53213], [136, 53693], [139, 53953], [145, 54253], [148, 54513]]}, {"verse": 8, "start": 55767, "end": 69927, "text": "Por tanto, si tu mano o tu pie te es ocasión de caer, córtalo y échalo de ti: mejor te es entrar cojo o manco en la vida, que teniendo dos manos o dos pies ser echado en el fuego eterno.", "words": [[0, 55767], [4, 55889], [11, 57009], [14, 57249], [17, 57429], [22, 57789], [24, 58089], [27, 58209], [31, 58469], [34, 58649], [37, 58869], [45, 59389], [48, 59529], [54, 60309], [62, 60969], [64, 61229], [71, 61629], [74, 61789], [78, 62382], [84, 62725], [87, 63018], [90, 63312], [97, 63605], [102, 64205], [104, 64385], [110, 64825], [113, 64925], [116, 65045], [122, 65565], [126, 65975], [135, 66385], [139, 66725], [145, 67145], [147, 67445], [151, 67625], [156, 67965], [160, 68385], [167, 68785], [170, 68905], [173, 69025], [179, 69245]]}, {"verse": 9, "start": 70277, "end": 82872, "text": "Y si tu ojo te es ocasión de caer, sácalo y échalo de ti: mejor te es entrar con un solo ojo en la vida, que teniendo dos ojos ser echado en el infierno del fuego.", "words": [[0, 70277], [2, 70385], [5, 70565], [8, 70725], [12, 71045], [15, 71205], [18, 71405], [26, 71925], [29, 72065], [35, 72765], [42, 73585], [44, 73865], [51, 74285], [54, 74465], [58, 75061], [64, 75505], [67, 75765], [70, 75985], [77, 76405], [81, 76685], [84, 76905], [89, 77145], [93, 77725], [96, 77845], [99, 77985], [105, 78485], [109, 78705], [118, 79205], [122, 79525], [127, 79905], [131, 80345], [138, 80885], [141, 81305], [144, 81445], [153, 82005], [157, 82225]]}, {"verse": 10, "start": 83222, "end": 92883, "text": "Mirad no tengáis en poco a alguno de estos pequeños; porque os digo que sus ángeles en los cielos ven siempre la faz de mi Padre que está en los cielos.", "words": [[0, 83222], [6, 83930], [9, 84030], [17, 84510], [20, 84750], [25, 85050], [27, 85250], [34, 85670], [37, 85730], [43, 85890], [53, 86923], [60, 87147], [63, 87307], [68, 87507], [72, 87707], [76, 87867], [84, 88427], [87, 88627], [91, 88767], [98, 89387], [102, 89727], [110, 90227], [113, 90427], [117, 90667], [120, 90867], [123, 91007], [129, 91467], [133, 91587], [138, 91847], [141, 92007], [145, 92127]]}, {"verse": 11, "start": 93233, "end": 98178, "text": "Porque el Hijo del hombre ha venido para salvar lo que se había perdido.", "words": [[0, 93233], [7, 93457], [10, 93717], [15, 93957], [19, 94137], [26, 94517], [29, 94877], [36, 95337], [41, 95597], [48, 96117], [51, 96837], [55, 96997], [58, 97137], [64, 97377]]}, {"verse": 12, "start": 98528, "end": 110497, "text": "¿Qué os parece? Si tuviese algún hombre cien ovejas, y se descarriase una de ellas, ¿no iría por los montes, dejadas las noventa y nueve, a buscar la que se había descarriado?", "words": [[0, 98528], [5, 98630], [8, 98750], [16, 99649], [19, 99792], [27, 100192], [33, 100472], [40, 100832], [45, 101152], [53, 101672], [55, 102192], [58, 102332], [70, 102992], [74, 103232], [77, 103432], [84, 103992], [88, 104292], [93, 104752], [97, 104992], [101, 105212], [109, 105852], [117, 106772], [121, 107032], [129, 107552], [131, 107652], [138, 108172], [140, 108479], [147, 108785], [150, 109092], [154, 109212], [157, 109352], [163, 109953]]}, {"verse": 13, "start": 110847, "end": 119993, "text": "Y si aconteciese hallarla, de cierto os digo, que más se goza de aquella, que de las noventa y nueve que no se descarriaron.", "words": [[0, 110847], [2, 110963], [5, 111083], [17, 111843], [27, 112743], [30, 112843], [37, 113263], [40, 113683], [46, 114563], [50, 114723], [54, 115043], [57, 115323], [62, 115683], [65, 115863], [74, 116343], [78, 116803], [81, 116963], [85, 117243], [93, 117523], [95, 117803], [101, 118083], [105, 118463], [108, 118683], [111, 118843]]}, {"verse": 14, "start": 120343, "end": 127109, "text": "Así, no es la voluntad de vuestro Padre que está en los cielos, que se pierda uno de estos pequeños.", "words": [[0, 120343], [5, 120689], [8, 120989], [11, 121229], [14, 121409], [23, 122089], [26, 122229], [34, 122649], [40, 123189], [44, 123309], [49, 123549], [52, 123709], [56, 123869], [64, 124769], [68, 124949], [71, 125109], [78, 125529], [82, 125769], [85, 125969], [91, 126149]]}, {"verse": 15, "start": 127459, "end": 135789, "text": "Por tanto, si tu hermano peca contra ti, ve, y corrígelo entre ti y él solo: si te oye, has ganado a tu hermano.", "words": [[0, 127459], [4, 127581], [11, 128001], [14, 128181], [17, 128321], [25, 128801], [30, 129161], [37, 129521], [41, 130121], [45, 130241], [47, 130501], [57, 131241], [63, 131441], [66, 131761], [68, 132001], [71, 132241], [77, 133085], [80, 133251], [83, 133431], [88, 134271], [92, 134471], [99, 134971], [101, 135071], [104, 135171]]}, {"verse": 16, "start": 136139, "end": 144438, "text": "Pero si no te oye, toma aún contigo uno o dos, para que en boca de dos o de tres testigos conste toda palabra.", "words": [[0, 136139], [5, 136267], [8, 136447], [11, 136647], [14, 136807], [19, 137587], [24, 137877], [28, 138167], [36, 138727], [40, 138987], [42, 139147], [47, 139787], [52, 140067], [56, 140247], [59, 140427], [64, 140667], [67, 140887], [71, 141127], [73, 141287], [76, 141447], [81, 141707], [90, 142367], [97, 143327], [102, 143607]]}, {"verse": 17, "start": 144788, "end": 151927, "text": "Y si no oye a ellos, dilo a la iglesia: y si no oye a la iglesia, tenle por gentil y publicano.", "words": [[0, 144788], [2, 144913], [5, 145053], [8, 145253], [12, 145693], [14, 145793], [21, 146533], [26, 146853], [28, 147053], [31, 147153], [40, 148146], [42, 148290], [45, 148430], [48, 148590], [52, 148990], [54, 149090], [57, 149170], [66, 149630], [72, 150090], [76, 150310], [83, 150850], [85, 151030]]}, {"verse": 18, "start": 152277, "end": 162198, "text": "De cierto os digo que todo lo que atéis en la tierra, será atado en el cielo; y todo lo que desatéis en la tierra, será desatado en el cielo.", "words": [[0, 152426], [3, 152611], [10, 152796], [13, 152981], [18, 153281], [22, 153461], [27, 153721], [30, 153941], [34, 154081], [40, 154481], [43, 154621], [46, 154781], [54, 155201], [59, 155761], [65, 156341], [68, 156481], [71, 156601], [78, 157329], [80, 157455], [85, 157775], [88, 158075], [92, 158235], [101, 159015], [104, 159235], [107, 159395], [115, 159855], [120, 160515], [129, 161275], [132, 161415], [135, 161555]]}, {"verse": 19, "start": 162548, "end": 171762, "text": "Otra vez os digo, que si dos de vosotros se ponen de acuerdo en la tierra, de toda cosa que pidan, les será hecho por mi Padre que está en los cielos.", "words": [[0, 162548], [5, 162875], [9, 163055], [12, 163195], [18, 163615], [22, 164075], [25, 164255], [29, 164475], [32, 164615], [41, 165055], [44, 165275], [50, 165615], [53, 165735], [61, 166015], [64, 166255], [67, 166355], [75, 167135], [78, 167315], [83, 167535], [88, 167935], [92, 168155], [99, 169033], [103, 169113], [108, 169393], [114, 169693], [118, 169953], [121, 170133], [127, 170633], [131, 170733], [136, 170893], [139, 171053], [143, 171153]]}, {"verse": 20, "start": 172112, "end": 177826, "text": "Porque donde están dos o tres congregados en mi nombre, allí estoy en medio de ellos.", "words": [[0, 172112], [7, 172315], [13, 172515], [19, 172855], [23, 173215], [25, 173475], [30, 173715], [42, 174515], [45, 174715], [48, 174875], [56, 175655], [61, 175955], [67, 176575], [70, 176795], [76, 177015], [79, 177255]]}, {"verse": 21, "start": 178176, "end": 186310, "text": "Entonces Pedro, llegándose a él, dijo: Señor, ¿cuántas veces perdonaré a mi hermano que peque contra mí? ¿hasta siete?", "words": [[0, 178176], [9, 179153], [16, 179593], [27, 180413], [29, 180573], [33, 180793], [39, 181532], [46, 182153], [55, 182573], [61, 182753], [71, 183493], [73, 183613], [76, 183733], [84, 184173], [88, 184273], [94, 184593], [101, 184913], [105, 185517], [112, 185926]]}, {"verse": 22, "start": 186590, "end": 192375, "text": "Jesús le dice: No te digo hasta siete, sino aun hasta setenta veces siete.", "words": [[0, 186590], [6, 186991], [9, 187511], [15, 188294], [18, 188399], [21, 188539], [26, 188799], [32, 188999], [39, 189619], [44, 189799], [48, 190199], [54, 190539], [62, 191219], [68, 191559]]}, {"verse": 23, "start": 192725, "end": 200829, "text": "Por lo cual, el reino de los cielos es semejante a un hombre rey, que quiso hacer cuentas con sus siervos.", "words": [[0, 192725], [4, 192886], [7, 193026], [13, 193466], [16, 194126], [22, 194606], [25, 194726], [29, 194886], [36, 195506], [39, 195726], [49, 196506], [51, 196686], [54, 196846], [61, 197146], [66, 198066], [70, 198426], [76, 198846], [82, 199206], [90, 199746], [94, 199926], [98, 200086]]}, {"verse": 24, "start": 201179, "end": 207383, "text": "Y comenzando a hacer cuentas, le fue presentado uno que le debía diez mil talentos.", "words": [[0, 201179], [2, 201300], [13, 202120], [15, 202240], [21, 202480], [30, 203480], [33, 203680], [37, 203840], [48, 204640], [52, 204940], [56, 205120], [59, 205260], [65, 205667], [70, 206073], [74, 206480]]}, {"verse": 25, "start": 207733, "end": 216179, "text": "Pero a este, no pudiendo pagar, mandó su señor venderle, y a su mujer e hijos, con todo lo que tenía, y que se le pagase.", "words": [[0, 207733], [5, 207894], [7, 208054], [13, 208294], [16, 208474], [25, 208934], [32, 209274], [38, 209834], [41, 209974], [47, 210334], [57, 211054], [59, 211574], [61, 211694], [64, 211854], [70, 212234], [72, 212514], [79, 212914], [83, 213534], [88, 213854], [91, 214074], [95, 214194], [102, 214594], [104, 215034], [108, 215174], [111, 215314], [114, 215434]]}, {"verse": 26, "start": 216529, "end": 224699, "text": "Entonces aquel siervo, postrado, le adoraba, diciendo: Señor, ten paciencia conmigo, y yo te lo pagaré todo.", "words": [[0, 216529], [9, 217034], [15, 217534], [23, 217994], [33, 218654], [36, 219134], [45, 219774], [55, 221044], [62, 221647], [66, 221707], [76, 222247], [85, 222867], [87, 223547], [90, 223667], [93, 223787], [96, 223907], [103, 224287]]}, {"verse": 27, "start": 225049, "end": 230181, "text": "El señor, movido a misericordia de aquel siervo, le soltó y le perdonó la deuda.", "words": [[0, 225049], [3, 225270], [10, 225550], [17, 226090], [19, 226190], [32, 227010], [35, 227110], [41, 227390], [49, 227830], [52, 228070], [58, 228650], [60, 228910], [63, 229010], [71, 229550], [74, 229630]]}, {"verse": 28, "start": 230531, "end": 241878, "text": "Y saliendo aquel siervo, halló a uno de sus compañeros de servicio, que le debía cien denarios; y agarrándolo, lo estrangulaba, diciendo: Págame lo que debes.", "words": [[0, 230531], [2, 230677], [11, 231137], [17, 231477], [25, 232017], [31, 232517], [33, 232697], [37, 232897], [40, 233077], [44, 233217], [55, 234017], [58, 234137], [68, 234737], [72, 234962], [75, 235102], [81, 235412], [86, 235722], [96, 236939], [98, 237082], [111, 237962], [114, 238482], [128, 239402], [138, 240461], [145, 240786], [148, 241026], [152, 241166]]}, {"verse": 29, "start": 242228, "end": 251872, "text": "Entonces su compañero de servicio, postrándose a sus pies, le rogaba, diciendo: Ten paciencia conmigo, y yo te lo pagaré todo.", "words": [[0, 242228], [9, 243035], [12, 243187], [22, 243887], [25, 244007], [35, 244927], [47, 245807], [49, 245947], [53, 246107], [59, 246517], [62, 246927], [70, 247487], [80, 248675], [84, 248799], [94, 249419], [103, 250079], [105, 250559], [108, 250739], [111, 250879], [114, 250999], [121, 251439]]}, {"verse": 30, "start": 252222, "end": 258118, "text": "Pero él no quiso; sino fue, y le echó en la cárcel hasta que pagase la deuda.", "words": [[0, 252222], [5, 252465], [8, 252885], [11, 253125], [18, 253898], [23, 254160], [28, 254460], [30, 255140], [33, 255300], [38, 255580], [41, 255720], [44, 255840], [51, 256320], [57, 256600], [61, 256800], [68, 257320], [71, 257480]]}, {"verse": 31, "start": 258468, "end": 267911, "text": "Y viendo sus compañeros de servicio lo que pasaba, se entristecieron mucho, y viniendo, declararon a su señor todo lo que había pasado.", "words": [[0, 258468], [2, 258571], [9, 258811], [13, 259011], [24, 259791], [27, 259911], [36, 260371], [39, 260571], [43, 260711], [51, 261591], [54, 261791], [69, 262771], [76, 263171], [78, 263731], [88, 264391], [99, 265631], [101, 265731], [104, 265871], [110, 266251], [115, 266506], [118, 266806], [122, 266946], [128, 267226]]}, {"verse": 32, "start": 268261, "end": 275561, "text": "Entonces llamándole su señor, le dice: Siervo malvado, toda aquella deuda te perdoné, porque me rogaste:", "words": [[0, 268261], [9, 269184], [20, 269744], [23, 269924], [30, 270284], [33, 270564], [39, 271295], [46, 271755], [55, 272475], [60, 272695], [68, 273155], [74, 273555], [77, 273735], [86, 274575], [93, 274855], [96, 275055]]}, {"verse": 33, "start": 275911, "end": 283524, "text": "¿No te convenía también a ti tener misericordia de tu compañero de servicio, como también yo tuve misericordia de ti?", "words": [[0, 275911], [4, 276457], [7, 276577], [16, 277097], [24, 277377], [26, 277617], [29, 277737], [35, 278057], [48, 279177], [51, 279317], [54, 279657], [64, 279997], [67, 280137], [77, 281017], [82, 281297], [90, 281677], [93, 281857], [98, 282217], [111, 282977], [114, 283137]]}, {"verse": 34, "start": 283874, "end": 291380, "text": "Entonces su señor, enojado, le entregó a los verdugos, hasta que pagase todo lo que le debía.", "words": [[0, 283874], [9, 284797], [12, 285077], [19, 285457], [28, 286177], [31, 286857], [39, 287417], [41, 287517], [45, 287637], [55, 288737], [61, 288997], [65, 289197], [72, 289757], [77, 290157], [80, 290477], [84, 290597], [87, 290737]]}, {"verse": 35, "start": 291730, "end": 301058, "text": "Así también hará con vosotros mi Padre celestial, si no perdonáis de vuestros corazones cada uno a su hermano sus ofensas.", "words": [[0, 291730], [4, 292133], [12, 292733], [17, 293233], [21, 293353], [30, 294073], [33, 294533], [39, 294993], [50, 296133], [53, 296353], [56, 296693], [66, 297253], [69, 297473], [78, 297853], [88, 298513], [93, 298773], [97, 299173], [99, 299373], [102, 299493], [110, 299953], [114, 300113]]}]}