{"book": "PSA", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 326548, "verses": [{"verse": 1, "start": 300, "end": 17785, "text": "Al Músico principal: Salmo de David, siervo de Jehová, el cual profirió a Jehová las palabras de este cántico el día que le libró Jehová de mano de todos sus enemigos, y de mano de Saúl. Entonces dijo: TE AMARÉ, oh Jehová, fortaleza mía.", "words": [[0, 300], [3, 491], [10, 971], [21, 2191], [27, 2814], [30, 3074], [37, 3994], [44, 4394], [47, 4514], [55, 5334], [58, 5334], [63, 5534], [72, 6294], [74, 6434], [81, 6854], [85, 6994], [94, 7334], [97, 7674], [102, 7874], [110, 8614], [113, 8634], [117, 8834], [121, 9014], [124, 9154], [130, 9554], [137, 9994], [140, 10094], [145, 10314], [148, 10494], [154, 10734], [158, 11214], [168, 12301], [170, 12426], [173, 12546], [178, 12766], [181, 12986], [187, 13832], [196, 14397], [202, 15333], [205, 15437], [212, 15844], [215, 16250], [223, 16657], [233, 17237]]}, {"verse": 2, "start": 18135, "end": 28902, "text": "Jehová, roca mía y castillo mío, y mi libertador; Dios mío, fuerte mío, en él confiaré; escudo mío, y el cuerno de mi salvación, mi refugio.", "words": [[0, 18135], [8, 18562], [13, 18962], [17, 19342], [19, 19422], [28, 19962], [33, 20302], [35, 20402], [38, 20502], [50, 21509], [55, 21829], [60, 22369], [67, 22609], [72, 23049], [75, 23189], [78, 23309], [88, 24336], [95, 24779], [100, 25779], [102, 25979], [105, 26159], [112, 26719], [115, 26799], [118, 26959], [129, 27939], [132, 27999]]}, {"verse": 3, "start": 29252, "end": 34330, "text": "Invocaré a Jehová, digno de ser alabado, y seré salvo de mis enemigos.", "words": [[0, 29252], [9, 30033], [11, 30113], [19, 30513], [25, 30973], [28, 31053], [32, 31273], [41, 31993], [43, 32433], [48, 32733], [54, 33213], [57, 33353], [61, 33453]]}, {"verse": 4, "start": 34680, "end": 39868, "text": "Me cercaron dolores de muerte, y torrentes de perversidad me atemorizaron.", "words": [[0, 34680], [3, 34788], [12, 35288], [20, 35768], [23, 35908], [31, 36328], [33, 36848], [43, 37608], [46, 37708], [58, 38568], [61, 38748]]}, {"verse": 5, "start": 40218, "end": 45638, "text": "Dolores del sepulcro me rodearon, me sorprendieron lazos de muerte.", "words": [[0, 40218], [8, 40763], [12, 41023], [21, 41743], [24, 41903], [34, 43063], [37, 43343], [51, 44223], [57, 44783], [60, 44903]]}, {"verse": 6, "start": 45988, "end": 55886, "text": "En mi angustia invoqué a Jehová, y clamé a mi Dios: él oyó mi voz desde su templo, y mi clamor llegó delante de él, a sus oídos.", "words": [[0, 45988], [3, 46317], [6, 46457], [15, 47097], [23, 47537], [25, 47677], [33, 48277], [35, 48537], [41, 48957], [43, 49257], [46, 49377], [52, 50226], [55, 50412], [59, 50732], [62, 50852], [66, 51212], [72, 51612], [75, 51912], [83, 52972], [85, 53012], [88, 53152], [95, 53632], [101, 53872], [109, 54392], [112, 54612], [116, 54792], [118, 55012], [122, 55172]]}, {"verse": 7, "start": 56236, "end": 64575, "text": "Y la tierra fue conmovida y tembló; y se movieron los fundamentos de los montes, y se estremecieron, porque se indignó él.", "words": [[0, 56236], [2, 56340], [5, 56480], [12, 56800], [16, 57140], [26, 57780], [28, 57940], [36, 58765], [38, 58930], [41, 59010], [50, 59510], [54, 59690], [66, 60390], [69, 60470], [73, 60610], [81, 61190], [83, 61590], [86, 61770], [101, 62850], [108, 63175], [111, 63435], [119, 64315]]}, {"verse": 8, "start": 64925, "end": 71885, "text": "Humo subió de su nariz, y de su boca consumidor fuego; carbones fueron por él encendidos.", "words": [[0, 64925], [5, 65410], [11, 66010], [14, 66130], [17, 66310], [24, 66930], [26, 67110], [29, 67210], [32, 67370], [37, 67710], [48, 68590], [55, 69573], [64, 70177], [71, 70417], [75, 70737], [78, 70897]]}, {"verse": 9, "start": 72235, "end": 77464, "text": "Y bajó los cielos, y descendió; y oscuridad debajo de sus pies.", "words": [[0, 72235], [2, 72361], [7, 72681], [11, 72801], [19, 73581], [21, 73901], [32, 74894], [34, 75239], [44, 75959], [51, 76459], [54, 76599], [58, 76739]]}, {"verse": 10, "start": 77814, "end": 82989, "text": "Y cabalgó sobre un querubín, y voló: voló sobre las alas del viento.", "words": [[0, 77814], [2, 78150], [10, 78520], [16, 78800], [19, 78980], [29, 79720], [31, 80140], [37, 80927], [42, 81313], [48, 81573], [52, 81793], [57, 82153], [61, 82313]]}, {"verse": 11, "start": 83339, "end": 91880, "text": "Puso tinieblas por escondedero suyo, su pabellón en derredor de sí; oscuridad de aguas, nubes de los cielos.", "words": [[0, 83339], [5, 83563], [15, 84163], [19, 84633], [31, 85103], [37, 85983], [40, 86223], [49, 86843], [52, 87233], [61, 87623], [64, 87923], [68, 88535], [78, 89222], [81, 89442], [88, 90322], [94, 90802], [97, 90942], [101, 91062]]}, {"verse": 12, "start": 92230, "end": 98080, "text": "Por el resplandor delante de él, sus nubes pasaron; granizo y carbones ardientes.", "words": [[0, 92230], [4, 92527], [7, 92707], [18, 93327], [26, 93787], [29, 93927], [33, 94127], [37, 94307], [43, 94727], [52, 95587], [60, 96327], [62, 96567], [71, 97047]]}, {"verse": 13, "start": 98430, "end": 105331, "text": "Y tronó en los cielos Jehová, y el Altísimo dio su voz; granizo y carbones de fuego.", "words": [[0, 98430], [2, 98575], [8, 98995], [11, 99095], [15, 99215], [22, 99695], [30, 100455], [32, 100695], [35, 100835], [44, 101515], [48, 101895], [51, 102195], [56, 102977], [64, 103602], [66, 104082], [75, 104622], [78, 104762]]}, {"verse": 14, "start": 105681, "end": 111698, "text": "Y envió sus flechas, y los desbarató; y echó relámpagos, y los destruyó.", "words": [[0, 105681], [2, 105806], [8, 106226], [12, 106426], [21, 107106], [23, 107566], [27, 107706], [38, 108723], [40, 109005], [45, 109325], [57, 110585], [59, 110785], [63, 110925]]}, {"verse": 15, "start": 112048, "end": 121733, "text": "Y aparecieron las honduras de las aguas, y se descubrieron los cimientos del mundo, a tu reprensión, oh Jehová, por el soplo del viento de tu nariz.", "words": [[0, 112048], [2, 112192], [14, 112852], [18, 113202], [27, 113552], [30, 113692], [34, 113872], [41, 114492], [43, 114672], [46, 114792], [59, 115572], [63, 115732], [73, 116252], [77, 116492], [84, 117252], [86, 117620], [89, 117988], [101, 118356], [104, 118724], [112, 119092], [116, 119412], [119, 119552], [125, 120072], [129, 120272], [136, 120752], [139, 121102], [142, 121451]]}, {"verse": 16, "start": 122083, "end": 126740, "text": "Envió desde lo alto; me tomó, me sacó de las muchas aguas.", "words": [[0, 122083], [6, 122483], [12, 122683], [15, 122923], [21, 123740], [24, 123886], [30, 124866], [33, 125026], [38, 125446], [41, 125566], [45, 125706], [52, 125946]]}, {"verse": 17, "start": 127090, "end": 133403, "text": "Me libró de mi poderoso enemigo, y de los que me aborrecían, aunque eran ellos más fuertes que yo.", "words": [[0, 127090], [3, 127217], [9, 127677], [12, 127777], [15, 127917], [24, 128497], [33, 129297], [35, 129557], [38, 129677], [42, 129857], [46, 130037], [49, 130217], [61, 131317], [68, 131557], [73, 131917], [79, 132137], [83, 132417], [91, 132937], [95, 133037]]}, {"verse": 18, "start": 133753, "end": 138178, "text": "Me asaltaron en el día de mi quebranto: mas Jehová fue mi apoyo.", "words": [[0, 133753], [3, 133900], [13, 134720], [16, 134920], [19, 135060], [23, 135300], [26, 135420], [29, 135580], [40, 136558], [44, 136835], [51, 137145], [55, 137345], [58, 137784]]}, {"verse": 19, "start": 138528, "end": 142688, "text": "Y me sacó a anchura: me libró, porque se agradó de mí.", "words": [[0, 138528], [2, 138675], [5, 138775], [10, 139025], [12, 139275], [21, 140398], [24, 140505], [31, 141185], [38, 141525], [41, 141725], [48, 142205], [51, 142365]]}, {"verse": 20, "start": 143038, "end": 148654, "text": "Me ha pagado Jehová conforme a mi justicia: conforme a la limpieza de mis manos me ha vuelto.", "words": [[0, 143038], [3, 143156], [6, 143276], [13, 143656], [20, 144076], [29, 144696], [31, 144756], [34, 144856], [44, 145905], [53, 146489], [55, 146569], [58, 146629], [67, 147229], [70, 147329], [74, 147489], [80, 147789], [83, 148009], [86, 148089]]}, {"verse": 21, "start": 149004, "end": 155121, "text": "Porque yo he guardado los caminos de Jehová, y no me aparté impíamente de mi Dios.", "words": [[0, 149004], [7, 149206], [10, 149486], [13, 149606], [22, 150126], [26, 150286], [34, 150746], [37, 150926], [45, 151646], [47, 151866], [50, 152086], [53, 152306], [60, 152986], [71, 154066], [74, 154346], [77, 154466]]}, {"verse": 22, "start": 155471, "end": 160990, "text": "Pues todos sus juicios estuvieron delante de mí, y no eché de mí sus estatutos.", "words": [[0, 155471], [5, 155614], [11, 155874], [15, 156154], [23, 156574], [34, 157214], [42, 157714], [45, 157874], [49, 158114], [51, 158974], [54, 159254], [59, 159534], [62, 159694], [65, 159834], [69, 160054]]}, {"verse": 23, "start": 161340, "end": 166039, "text": "Y fui íntegro para con él, y me he guardado de mi maldad.", "words": [[0, 161340], [2, 161467], [6, 161647], [14, 162507], [19, 162747], [23, 163027], [27, 163227], [29, 164067], [32, 164287], [35, 164407], [44, 164987], [47, 165167], [50, 165327]]}, {"verse": 24, "start": 166389, "end": 172882, "text": "Me pagó pues Jehová conforme a mi justicia; conforme a la limpieza de mis manos delante de sus ojos.", "words": [[0, 166389], [3, 166498], [8, 166898], [13, 167138], [20, 167718], [29, 168008], [31, 168298], [34, 168398], [44, 169438], [53, 169982], [55, 170062], [58, 170122], [67, 170782], [70, 170902], [74, 171042], [80, 171462], [88, 171962], [91, 172102], [95, 172262]]}, {"verse": 25, "start": 173232, "end": 179591, "text": "Con el misericordioso te mostrarás misericordioso, y recto para con el hombre íntegro.", "words": [[0, 173232], [4, 173381], [7, 173501], [22, 174521], [25, 174891], [35, 175261], [51, 176301], [53, 177021], [59, 177741], [64, 178021], [68, 178241], [71, 178361], [78, 178621]]}, {"verse": 26, "start": 179941, "end": 184868, "text": "Limpio te mostrarás para con el limpio, y severo serás para con el perverso.", "words": [[0, 179941], [7, 180585], [10, 180705], [20, 181385], [25, 181605], [29, 181845], [32, 181985], [40, 182605], [42, 182705], [49, 183165], [55, 183465], [60, 183645], [64, 183885], [67, 184005]]}, {"verse": 27, "start": 185218, "end": 189611, "text": "Y tú salvarás al pueblo humilde, y humillarás los ojos altivos.", "words": [[0, 185218], [2, 185329], [5, 185469], [14, 186109], [17, 186249], [24, 186489], [33, 187169], [35, 187689], [46, 188289], [50, 188409], [55, 188689]]}, {"verse": 28, "start": 189961, "end": 195732, "text": "Tú pues alumbrarás mi lámpara: Jehová mi Dios alumbrará mis tinieblas.", "words": [[0, 189961], [3, 190596], [8, 190816], [19, 191476], [22, 191676], [31, 192643], [38, 193151], [41, 193231], [46, 193971], [56, 194591], [60, 194791]]}, {"verse": 29, "start": 196082, "end": 201022, "text": "Porque contigo desharé ejércitos; y con mi Dios asaltaré muros.", "words": [[0, 196082], [7, 196287], [15, 196847], [23, 197407], [34, 198705], [36, 198810], [40, 198970], [43, 199170], [48, 199470], [57, 200370]]}, {"verse": 30, "start": 201372, "end": 208620, "text": "Dios, perfecto su camino: es purificada la palabra de Jehová: escudo es a todos los que en él esperan.", "words": [[0, 201372], [6, 201698], [15, 202558], [18, 202678], [26, 203564], [29, 203794], [40, 204734], [43, 204914], [51, 205254], [54, 205454], [62, 206254], [69, 206738], [72, 206878], [74, 206998], [80, 207318], [84, 207558], [88, 207758], [91, 207918], [94, 207998]]}, {"verse": 31, "start": 208970, "end": 213624, "text": "Porque ¿qué Dios hay fuera de Jehová? ¿y qué fuerte fuera de nuestro Dios?", "words": [[0, 208970], [7, 209499], [12, 209752], [17, 210006], [21, 210259], [27, 210559], [30, 210719], [38, 211452], [41, 211540], [45, 211660], [52, 212140], [58, 212460], [61, 212720], [69, 212900]]}, {"verse": 32, "start": 213974, "end": 218367, "text": "Dios es el que me ciñe de fuerza, e hizo perfecto mi camino;", "words": [[0, 213974], [5, 214243], [8, 214703], [11, 214923], [15, 215083], [18, 215203], [23, 215603], [26, 215683], [34, 216043], [36, 216363], [41, 216663], [50, 217523], [53, 217623]]}, {"verse": 33, "start": 218717, "end": 223972, "text": "Quien pone mis pies como pies de ciervas, y me hizo estar sobre mis alturas;", "words": [[0, 218717], [6, 218842], [11, 219162], [15, 219382], [20, 219702], [25, 220262], [30, 220542], [33, 220942], [42, 221342], [44, 221722], [47, 221862], [52, 222142], [58, 222482], [64, 222802], [68, 223042]]}, {"verse": 34, "start": 224322, "end": 231199, "text": "Quien enseña mis manos para la batalla, y será quebrado con mis brazos el arco de acero.", "words": [[0, 224322], [6, 224527], [13, 225407], [17, 225587], [23, 226027], [28, 226447], [31, 226607], [40, 227147], [42, 227867], [47, 228087], [56, 228727], [60, 228907], [64, 229107], [71, 229747], [74, 229972], [79, 230452], [82, 230612]]}, {"verse": 35, "start": 231549, "end": 239447, "text": "Me diste asimismo el escudo de tu salvación: y tu diestra me sustentó, y tu benignidad me ha acrecentado.", "words": [[0, 231867], [3, 232217], [9, 232567], [18, 232917], [21, 233117], [28, 233577], [31, 233737], [34, 233897], [45, 234917], [47, 235019], [50, 235179], [58, 235559], [61, 235739], [71, 236419], [73, 236979], [76, 237419], [87, 237859], [90, 238179], [93, 238840]]}, {"verse": 36, "start": 239797, "end": 244289, "text": "Ensanchaste mis pasos debajo de mí, y no titubearon mis rodillas.", "words": [[0, 239797], [12, 240563], [16, 240743], [22, 241163], [29, 241543], [32, 241683], [36, 241863], [38, 242243], [41, 242423], [52, 243163], [56, 243403]]}, {"verse": 37, "start": 244639, "end": 249777, "text": "He perseguido a mis enemigos, y los alcancé, y no volví hasta acabarlos.", "words": [[0, 244639], [3, 244786], [14, 245506], [16, 245606], [20, 245706], [30, 246366], [32, 246811], [36, 246971], [45, 247771], [47, 247931], [50, 248071], [56, 248571], [62, 248811]]}, {"verse": 38, "start": 250127, "end": 254669, "text": "Los he herido, y no podrán levantarse: cayeron debajo de mis pies.", "words": [[0, 250127], [4, 250272], [7, 250592], [15, 251092], [17, 251212], [20, 251332], [27, 251812], [39, 253247], [47, 253497], [54, 253897], [57, 254037], [61, 254177]]}, {"verse": 39, "start": 254669, "end": 260192, "text": "Pues me ceñiste de fortaleza para la pelea; has agobiado mis enemigos debajo de mí.", "words": [[0, 254669], [5, 254869], [8, 255189], [16, 255509], [19, 255669], [29, 256349], [34, 256549], [37, 256729], [44, 257549], [48, 257832], [57, 258592], [61, 258752], [70, 259312], [77, 259732], [80, 259912]]}, {"verse": 40, "start": 260542, "end": 265144, "text": "Y me diste la cerviz de mis enemigos, y destruí a los que me aborrecían.", "words": [[0, 260542], [2, 260786], [5, 260926], [11, 261273], [14, 261619], [21, 261966], [24, 262066], [28, 262166], [38, 262826], [40, 263021], [48, 263641], [50, 263801], [54, 263941], [58, 264061], [61, 264201]]}, {"verse": 41, "start": 265494, "end": 270163, "text": "Clamaron, y no hubo quien salvase: aun a Jehová, pero no los oyó.", "words": [[0, 265494], [10, 265976], [12, 266196], [15, 266356], [20, 266796], [26, 266956], [35, 268095], [39, 268095], [41, 268560], [49, 269061], [54, 269224], [57, 269557], [61, 269890]]}, {"verse": 42, "start": 270513, "end": 275950, "text": "Y los molí como polvo delante del viento; los esparcí como lodo de las calles.", "words": [[0, 270513], [2, 270619], [6, 270759], [11, 271159], [16, 271359], [22, 271939], [30, 272439], [34, 272659], [42, 273548], [46, 273696], [54, 274356], [59, 274556], [64, 274916], [67, 275076], [71, 275216]]}, {"verse": 43, "start": 276300, "end": 283733, "text": "Me libraste de contiendas de pueblo: me pusiste por cabeza de las naciones: pueblo que yo no conocía, me sirvió.", "words": [[0, 276300], [3, 276482], [12, 276982], [15, 277162], [26, 277982], [29, 278082], [37, 278950], [40, 279116], [48, 279656], [52, 279896], [59, 280336], [62, 280556], [66, 280716], [76, 281758], [83, 281940], [87, 282240], [90, 282400], [93, 282750], [102, 283100], [105, 283160]]}, {"verse": 44, "start": 284083, "end": 289144, "text": "Tan pronto como oyó, me obedeció; los hijos de extraños me mintieron;", "words": [[0, 284083], [4, 284227], [11, 284607], [16, 284997], [21, 285387], [24, 285847], [34, 286853], [38, 286959], [44, 287259], [47, 287419], [56, 288099], [59, 288622]]}, {"verse": 45, "start": 289494, "end": 293895, "text": "Los extraños flaquearon, y tuvieron miedo desde sus escondites.", "words": [[0, 289494], [4, 289620], [13, 290380], [25, 291180], [27, 291440], [36, 291860], [42, 292340], [48, 292620], [52, 292900]]}, {"verse": 46, "start": 294245, "end": 300735, "text": "Viva Jehová, y sea bendita mi roca; y enaltecido sea el Dios de mi salvación:", "words": [[0, 294245], [5, 294651], [13, 295351], [15, 295531], [19, 295751], [27, 296371], [30, 296551], [36, 297400], [38, 297917], [49, 298467], [53, 298807], [56, 299227], [61, 299467], [64, 299727], [67, 299847]]}, {"verse": 47, "start": 301085, "end": 304800, "text": "El Dios que me da las venganzas, y sujetó pueblos a mí.", "words": [[0, 301085], [3, 301269], [8, 301569], [12, 301969], [15, 302109], [18, 302249], [22, 302369], [33, 303029], [35, 303389], [42, 303829], [50, 304349], [52, 304489]]}, {"verse": 48, "start": 305150, "end": 311818, "text": "Mi libertador de mis enemigos: me hiciste también superior de mis adversarios; me libraste de varón violento.", "words": [[0, 305150], [3, 305277], [14, 305897], [17, 306077], [21, 306197], [31, 307190], [34, 307317], [42, 307697], [50, 307997], [59, 308497], [62, 308777], [66, 308897], [79, 309940], [82, 310260], [91, 310580], [94, 310740], [100, 311020]]}, {"verse": 49, "start": 312168, "end": 317517, "text": "Por tanto yo te confesaré entre las naciones, oh Jehová, y cantaré a tu nombre.", "words": [[0, 312168], [4, 312293], [10, 312773], [13, 312913], [16, 313053], [26, 313793], [32, 314093], [36, 314353], [46, 314915], [49, 315476], [57, 316038], [59, 316138], [67, 316658], [69, 316798], [72, 316898]]}, {"verse": 50, "start": 317867, "end": 326148, "text": "El cual da grandes triunfos a su rey, y hace misericordia a su ungido, a David y a su descendencia, para siempre.", "words": [[0, 317867], [3, 318012], [8, 318212], [11, 318412], [19, 318712], [28, 319432], [30, 319532], [33, 319672], [38, 320427], [40, 320587], [45, 320827], [58, 321867], [60, 322087], [63, 322247], [71, 323047], [73, 323227], [79, 323507], [81, 323807], [83, 323907], [86, 324047], [100, 325067], [105, 325447]]}]}