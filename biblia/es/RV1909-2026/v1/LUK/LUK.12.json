{"book": "LUK", "chapter": 12, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 503272, "verses": [{"verse": 1, "start": 300, "end": 13469, "text": "En esto, juntándose la multitud, tanto que unos a otros se pisoteaban, comenzó a decir a sus discípulos, primeramente: Guardaos de la levadura de los fariseos, que es hipocresía.", "words": [[0, 300], [3, 462], [9, 1162], [20, 1822], [23, 1982], [33, 2962], [39, 3182], [43, 3422], [48, 3582], [50, 3802], [56, 4062], [59, 4342], [71, 5562], [79, 6102], [81, 6182], [87, 6482], [89, 6622], [93, 6822], [105, 7502], [119, 8857], [128, 9763], [131, 10063], [134, 10203], [143, 10703], [146, 10863], [150, 10983], [160, 11843], [164, 12123], [167, 12363]]}, {"verse": 2, "start": 13919, "end": 22212, "text": "Porque nada hay encubierto, que no haya de ser descubierto; ni oculto, que no haya de ser sabido.", "words": [[0, 13919], [7, 14143], [12, 14463], [16, 14903], [28, 15823], [32, 16403], [35, 16643], [40, 16923], [43, 17123], [47, 17323], [60, 18937], [63, 19057], [71, 20097], [75, 20557], [78, 20777], [83, 20997], [86, 21177], [90, 21417]]}, {"verse": 3, "start": 22662, "end": 34194, "text": "Por tanto, las cosas que dijisteis en tinieblas, a la luz serán oídas; y lo que hablasteis al oído en las habitaciones, será pregonado en las azoteas.", "words": [[0, 22662], [4, 22766], [11, 23186], [15, 23326], [21, 23626], [25, 23846], [35, 24466], [38, 24916], [49, 25366], [51, 25886], [54, 25986], [58, 26286], [64, 27006], [71, 28285], [73, 28371], [76, 28491], [80, 28631], [91, 29391], [94, 29631], [99, 29931], [102, 30071], [106, 30191], [120, 31011], [125, 31651], [135, 32591], [138, 33011], [142, 33191]]}, {"verse": 4, "start": 34644, "end": 41263, "text": "Pero os digo, amigos míos: No temáis de los que matan el cuerpo, y después no tienen más que hacer.", "words": [[0, 34644], [5, 34789], [8, 34989], [14, 35249], [21, 35429], [27, 36465], [30, 36626], [37, 37146], [40, 37466], [44, 37606], [48, 37766], [54, 38166], [57, 38286], [65, 38726], [67, 39146], [75, 39486], [78, 40026], [85, 40306], [89, 40626], [93, 40786]]}, {"verse": 5, "start": 41713, "end": 52509, "text": "Pero os enseñaré a quién temáis: temed a aquel que después de haber quitado la vida, tiene poder de echar en la Gehenna: así os digo: a este temed.", "words": [[0, 41713], [5, 41898], [8, 42198], [17, 42918], [19, 43078], [25, 43258], [33, 44625], [39, 44855], [41, 45075], [47, 45495], [51, 45675], [59, 45915], [62, 46075], [68, 46255], [76, 46775], [79, 46915], [85, 47555], [91, 47955], [97, 48295], [100, 48615], [106, 48955], [109, 49135], [112, 49609], [121, 50322], [125, 50584], [128, 50724], [134, 51777], [136, 52036], [141, 52294]]}, {"verse": 6, "start": 52959, "end": 60666, "text": "¿No se venden cinco pajarillos por dos monedas de poco valor? pues ni uno de ellos está olvidado delante de Dios.", "words": [[0, 52959], [4, 53187], [7, 53367], [14, 53787], [20, 54227], [31, 55087], [35, 55327], [39, 55587], [47, 56067], [50, 56167], [55, 56367], [62, 57278], [67, 57540], [70, 57800], [74, 58080], [77, 58260], [83, 58500], [88, 58820], [97, 59420], [105, 59860], [108, 60020]]}, {"verse": 7, "start": 61116, "end": 69310, "text": "Y aun los cabellos de vuestra cabeza están todos contados. No temáis pues: de más estima sois que muchos pajarillos.", "words": [[0, 61116], [2, 61242], [6, 61402], [10, 61622], [19, 62182], [22, 62282], [30, 62622], [37, 62942], [43, 63342], [49, 63962], [59, 65191], [62, 65319], [69, 65659], [75, 66456], [78, 66582], [82, 66722], [89, 67222], [94, 67622], [98, 67782], [105, 68162]]}, {"verse": 8, "start": 69760, "end": 78250, "text": "Y os digo que todo aquel que me confiese delante de los hombres, también el Hijo del hombre le confesará delante de los ángeles de Dios;", "words": [[0, 69760], [2, 70012], [5, 70092], [10, 70292], [14, 70492], [19, 70792], [25, 71272], [29, 71352], [32, 71492], [41, 72052], [49, 72492], [52, 72652], [56, 72772], [65, 73492], [73, 73772], [76, 73992], [81, 74252], [85, 74412], [92, 74852], [95, 75192], [105, 75972], [113, 76632], [116, 76792], [120, 76932], [128, 77432], [131, 77632]]}, {"verse": 9, "start": 78700, "end": 84358, "text": "Pero el que me niegue delante de los hombres, será negado delante de los ángeles de Dios.", "words": [[0, 78700], [5, 78867], [8, 79027], [12, 79167], [15, 79327], [22, 79787], [30, 80247], [33, 80407], [37, 80547], [46, 80987], [51, 81727], [58, 82327], [66, 82807], [69, 82947], [73, 83067], [81, 83607], [84, 83747]]}, {"verse": 10, "start": 84808, "end": 94558, "text": "Y todo aquel que dice palabra contra el Hijo del hombre, le será perdonado; pero al que blasfeme contra el Espíritu Santo, no le será perdonado.", "words": [[0, 84808], [2, 84915], [7, 85115], [13, 85535], [17, 85635], [22, 85915], [30, 86375], [37, 86855], [40, 87095], [45, 87375], [49, 87555], [57, 88295], [60, 88575], [65, 88855], [76, 90009], [81, 90172], [84, 90432], [88, 90592], [97, 91212], [104, 91572], [107, 91792], [116, 92352], [123, 92691], [126, 93272], [129, 93432], [134, 93691]]}, {"verse": 11, "start": 95008, "end": 106448, "text": "Y cuando os traigan a las sinagogas, y a los magistrados y potestades, no os preocupéis cómo o qué hayáis de responder, o qué hayáis de decir;", "words": [[0, 95008], [2, 95150], [9, 95450], [12, 95730], [20, 96310], [22, 96510], [26, 96630], [37, 97550], [39, 98070], [41, 98130], [45, 98250], [57, 99063], [59, 99877], [71, 100690], [74, 101050], [77, 101250], [88, 102030], [93, 102450], [95, 102870], [99, 103170], [106, 103470], [109, 103650], [120, 104110], [122, 104890], [126, 105230], [133, 105570], [136, 105750]]}, {"verse": 12, "start": 106898, "end": 113399, "text": "Porque el Espíritu Santo os enseñará en la misma hora lo que será necesario decir.", "words": [[0, 106898], [7, 107221], [10, 107581], [19, 108341], [25, 108741], [28, 109201], [37, 110081], [40, 110301], [43, 110441], [49, 110681], [54, 111101], [57, 111621], [61, 111781], [66, 112041], [76, 112746]]}, {"verse": 13, "start": 113849, "end": 119345, "text": "Y le dijo uno de la multitud: Maestro, di a mi hermano que parta conmigo la herencia.", "words": [[0, 113849], [2, 114069], [5, 114169], [10, 114469], [14, 114889], [17, 115049], [20, 115169], [30, 116200], [39, 116453], [42, 116739], [44, 117026], [47, 117226], [55, 117666], [59, 117746], [65, 118186], [73, 118606], [76, 118766]]}, {"verse": 14, "start": 119695, "end": 124731, "text": "Pero él le dijo: Hombre, ¿quién me puso por juez o partidor sobre vosotros?", "words": [[0, 119695], [5, 119843], [8, 120043], [11, 120163], [17, 121705], [25, 121759], [32, 121812], [35, 121972], [40, 122352], [44, 122572], [49, 122972], [51, 123092], [60, 123632], [66, 123912]]}, {"verse": 15, "start": 125181, "end": 135036, "text": "Y les dijo: Mirad, y guardaos de toda avaricia; porque la vida del hombre no consiste en la abundancia de los bienes que posee.", "words": [[0, 125181], [2, 125401], [6, 125521], [12, 126527], [19, 126787], [21, 127147], [30, 127747], [33, 127947], [38, 128187], [48, 129537], [55, 129722], [58, 129962], [63, 130182], [67, 130422], [74, 130762], [77, 131322], [86, 132022], [89, 132382], [92, 132542], [103, 133542], [106, 133722], [110, 133882], [117, 134302], [121, 134402]]}, {"verse": 16, "start": 135486, "end": 142204, "text": "Y les refirió una parábola, diciendo: La tierra de un hombre rico había producido mucho;", "words": [[0, 135486], [2, 135746], [6, 135946], [14, 136646], [18, 136846], [28, 137466], [38, 138979], [41, 139067], [48, 139427], [51, 139667], [54, 139767], [61, 140027], [66, 140507], [72, 140867], [82, 141567]]}, {"verse": 17, "start": 142654, "end": 148891, "text": "Y él pensaba dentro de sí, diciendo: ¿Qué haré, porque no tengo donde juntar mis frutos?", "words": [[0, 142654], [2, 142799], [5, 142939], [13, 143499], [20, 143779], [23, 144059], [27, 144319], [37, 145544], [42, 145688], [48, 146048], [55, 146288], [58, 146528], [64, 146928], [70, 147148], [77, 147848], [81, 148048]]}, {"verse": 18, "start": 149341, "end": 158284, "text": "Y dijo: Esto haré: derribaré mis graneros, y los edificaré mayores, y allí juntaré todos mis frutos y mis bienes;", "words": [[0, 149341], [2, 149480], [8, 150586], [13, 150922], [19, 151505], [29, 152213], [33, 152623], [43, 153033], [45, 153313], [49, 153493], [59, 154153], [68, 154713], [70, 155513], [75, 155733], [83, 156293], [89, 156553], [93, 156853], [100, 157273], [102, 157433], [106, 157593]]}, {"verse": 19, "start": 158734, "end": 167399, "text": "Y diré a mi alma: Alma, muchos bienes tienes almacenados para muchos años; repósate, come, bebe, alégrate.", "words": [[0, 158734], [2, 158861], [7, 159201], [9, 159341], [12, 159481], [18, 160392], [24, 161078], [31, 161378], [38, 161858], [45, 162018], [57, 163018], [62, 163258], [69, 163498], [75, 165022], [85, 165562], [91, 166222], [97, 166823]]}, {"verse": 20, "start": 167849, "end": 174973, "text": "Y le dijo Dios: Necio, esta noche vuelven a pedir tu alma; y lo que has preparado, ¿de quién será?", "words": [[0, 167849], [2, 167995], [5, 168095], [10, 168335], [16, 169264], [23, 169745], [28, 169985], [34, 170305], [42, 170845], [44, 170925], [50, 171125], [53, 171385], [59, 172462], [61, 172560], [64, 172680], [68, 172820], [72, 172960], [83, 173900], [87, 173980], [93, 174160]]}, {"verse": 21, "start": 175323, "end": 179700, "text": "Así es el que hace para sí tesoro, y no es rico en Dios.", "words": [[0, 175323], [4, 175748], [7, 176028], [10, 176128], [14, 176308], [19, 176568], [24, 176848], [27, 177088], [35, 177728], [37, 178308], [40, 178488], [43, 178738], [48, 178988], [51, 179148]]}, {"verse": 22, "start": 180150, "end": 189188, "text": "Y dijo a sus discípulos: Por tanto os digo: No estéis afanosos de vuestra vida, qué comeréis; ni del cuerpo, qué vestiréis.", "words": [[0, 180150], [2, 180295], [7, 180535], [9, 180695], [13, 180815], [25, 182047], [29, 182243], [35, 182477], [38, 182710], [44, 183508], [47, 183678], [54, 184238], [63, 184998], [66, 185158], [74, 185498], [80, 185818], [84, 185978], [94, 187166], [97, 187393], [101, 187553], [109, 187993], [113, 188253]]}, {"verse": 23, "start": 189638, "end": 194809, "text": "La vida más es que la comida, y el cuerpo que el vestido.", "words": [[0, 189638], [3, 189774], [8, 189954], [12, 190214], [15, 190454], [19, 190554], [22, 190674], [30, 191154], [32, 191654], [35, 191814], [42, 192174], [46, 192434], [49, 192574]]}, {"verse": 24, "start": 195259, "end": 206818, "text": "Considerad los cuervos, que ni siembran, ni siegan; que ni tienen almacén, ni granero; y Dios los alimenta. ¿Cuánto de más estima sois vosotros que las aves?", "words": [[0, 195259], [11, 195259], [15, 195259], [24, 195622], [28, 195802], [31, 195982], [41, 197142], [44, 197692], [52, 198490], [56, 198573], [59, 198753], [66, 199093], [75, 200633], [78, 200933], [87, 202010], [89, 202148], [94, 202528], [98, 202948], [108, 204093], [116, 204264], [119, 204470], [123, 204677], [130, 205217], [135, 205497], [144, 205957], [148, 206268], [152, 206579]]}, {"verse": 25, "start": 207268, "end": 211910, "text": "¿Y quién de vosotros podrá con afán añadir a su estatura un codo?", "words": [[0, 207268], [3, 207388], [9, 207668], [12, 207848], [21, 208348], [27, 208828], [31, 208908], [36, 209348], [43, 210348], [45, 210428], [48, 210568], [57, 211068], [60, 211308]]}, {"verse": 26, "start": 212360, "end": 217873, "text": "Pues si no podéis aun lo que es menos, ¿para qué estaréis afanosos de lo demás?", "words": [[0, 212360], [5, 212507], [8, 212687], [11, 212847], [18, 213327], [22, 213807], [25, 214147], [29, 214327], [32, 214467], [39, 215267], [45, 215507], [49, 215747], [58, 216367], [67, 217027], [70, 217167], [73, 217267]]}, {"verse": 27, "start": 218323, "end": 227900, "text": "Considerad los lirios, cómo crecen: no trabajan, ni hilan; y os digo, que ni Salomón con toda su gloria se vistió como uno de ellos.", "words": [[0, 218323], [11, 219066], [15, 219266], [23, 219786], [28, 220146], [36, 221304], [39, 221431], [49, 222131], [52, 222431], [59, 223223], [61, 223345], [64, 223445], [70, 223645], [74, 223805], [77, 223965], [85, 224545], [89, 224725], [94, 224985], [97, 225225], [104, 225705], [107, 226185], [114, 226605], [119, 226845], [123, 227105], [126, 227305]]}, {"verse": 28, "start": 228350, "end": 238237, "text": "Y si así viste Dios a la hierba, que hoy está en el campo, y mañana es echada en el horno; ¿cuánto más a vosotros, hombres de poca fe?", "words": [[0, 228350], [2, 228479], [5, 228619], [9, 228879], [15, 229279], [20, 229619], [22, 229839], [25, 229939], [33, 230439], [37, 230899], [41, 231119], [46, 231459], [49, 231639], [52, 231759], [59, 232219], [61, 232919], [68, 233259], [71, 233699], [78, 234279], [81, 234479], [84, 234619], [91, 235528], [99, 235874], [103, 236114], [105, 236334], [115, 237134], [123, 237394], [126, 237614], [131, 237874]]}, {"verse": 29, "start": 238687, "end": 246266, "text": "Vosotros, pues, no procuréis qué hayáis de comer, o qué hayáis de beber; ni estéis en ansiosa perplejidad.", "words": [[0, 238687], [10, 239243], [16, 239523], [19, 240303], [29, 240963], [33, 241183], [40, 241683], [43, 241783], [50, 242063], [52, 242383], [56, 242483], [63, 242923], [66, 243023], [73, 244078], [76, 244344], [83, 244611], [86, 244771], [94, 245251]]}, {"verse": 30, "start": 246716, "end": 253233, "text": "Porque todas estas cosas buscan las gentes del mundo; que vuestro Padre sabe que necesitáis estas cosas.", "words": [[0, 246716], [7, 246880], [13, 247180], [19, 247500], [25, 247960], [32, 248480], [36, 248660], [43, 249020], [47, 249220], [54, 250024], [58, 250106], [66, 250406], [72, 250646], [77, 251046], [81, 251286], [92, 252246], [98, 252506]]}, {"verse": 31, "start": 253683, "end": 259110, "text": "Pero procurad el reino de Dios, y todas estas cosas os serán añadidas.", "words": [[0, 253683], [5, 254057], [14, 254467], [17, 254667], [23, 255027], [26, 255187], [32, 255587], [34, 256167], [40, 256427], [46, 256727], [52, 257187], [55, 257507], [61, 258187]]}, {"verse": 32, "start": 259560, "end": 265546, "text": "No temáis, rebaño pequeño; porque al Padre le ha agradado daros el reino.", "words": [[0, 259560], [3, 259990], [11, 260444], [18, 260897], [27, 261981], [34, 262251], [37, 262521], [43, 263201], [46, 263401], [49, 263541], [58, 264281], [64, 264741], [67, 264941]]}, {"verse": 33, "start": 265996, "end": 277893, "text": "Vended lo que poseéis, y dad limosna; haceos bolsas que no se envejecen, tesoro en los cielos que nunca falta; donde ladrón no llega, ni polilla corrompe.", "words": [[0, 265996], [7, 266440], [10, 266760], [14, 266880], [23, 267640], [25, 268220], [29, 268380], [38, 269827], [45, 270141], [52, 270454], [56, 270634], [59, 270774], [62, 270914], [73, 271704], [80, 272494], [83, 272774], [87, 272934], [94, 273474], [98, 273554], [104, 273734], [111, 274791], [117, 275175], [124, 275555], [127, 275815], [134, 276215], [137, 276615], [145, 277015]]}, {"verse": 34, "start": 278343, "end": 283071, "text": "Porque donde está vuestro tesoro, allí también estará vuestro corazón.", "words": [[0, 278343], [7, 278587], [13, 278807], [18, 279147], [26, 279587], [34, 280807], [39, 281087], [47, 281487], [54, 281927], [62, 282307]]}, {"verse": 35, "start": 283521, "end": 288480, "text": "Mantened la ropa ceñida a la cintura, y vuestras lámparas encendidas;", "words": [[0, 283796], [9, 284096], [12, 284356], [17, 284806], [24, 285256], [26, 285356], [29, 285396], [38, 285956], [40, 286436], [49, 286836], [58, 287496]]}, {"verse": 36, "start": 288930, "end": 299005, "text": "Y vosotros sed semejantes a hombres que esperan a que su señor regrese de las bodas, para que cuando venga y llame, luego le abran.", "words": [[0, 288930], [2, 289076], [11, 289956], [15, 290296], [26, 291096], [28, 291316], [36, 291596], [40, 291856], [48, 292456], [50, 292616], [54, 292716], [57, 292876], [63, 293536], [71, 294196], [74, 294376], [78, 294516], [85, 295156], [90, 295596], [94, 295756], [101, 295996], [107, 296536], [109, 296676], [116, 297456], [122, 297896], [125, 298436]]}, {"verse": 37, "start": 299455, "end": 311710, "text": "Bienaventurados aquellos siervos a los cuales su señor, cuando venga, halle velando: de cierto os digo, que se ceñirá, y hará que se sienten a la mesa, y vendrá a servirles.", "words": [[0, 299455], [16, 300568], [25, 300988], [33, 301748], [35, 302148], [39, 302268], [46, 302568], [49, 303008], [56, 303348], [63, 303648], [70, 304208], [76, 304768], [85, 305721], [88, 305947], [95, 306207], [98, 306467], [104, 306827], [108, 307047], [111, 307207], [119, 307887], [121, 308247], [126, 308527], [130, 308647], [133, 308787], [141, 309347], [143, 309447], [146, 309547], [152, 309827], [154, 310287], [161, 310727], [163, 310827]]}, {"verse": 38, "start": 312160, "end": 322014, "text": "Y aunque venga a la segunda vigilia, y aunque venga a la tercera vigilia, y los halle así, bienaventurados son los tales siervos.", "words": [[0, 312160], [2, 312325], [9, 312525], [15, 313025], [17, 313165], [20, 313225], [28, 313565], [37, 314565], [39, 314605], [46, 314785], [52, 315165], [54, 315345], [57, 315425], [65, 315885], [74, 316925], [76, 317185], [80, 317405], [86, 317625], [91, 319085], [107, 320185], [111, 320485], [115, 320705], [121, 321005]]}, {"verse": 39, "start": 322464, "end": 333606, "text": "Pero sabed esto, que si supiese el padre de familia a qué hora había de venir el ladrón, velaría ciertamente, y no dejaría abrir un boquete en su casa.", "words": [[0, 322464], [5, 322747], [11, 323067], [17, 323267], [21, 323447], [24, 323587], [32, 324047], [35, 324227], [41, 324487], [44, 324687], [52, 325207], [54, 325427], [58, 325607], [63, 325827], [69, 326067], [72, 326247], [78, 326507], [81, 326707], [89, 327547], [97, 328067], [110, 328987], [112, 329467], [115, 329627], [123, 330167], [129, 330527], [132, 330887], [140, 331387], [143, 331527], [146, 331687]]}, {"verse": 40, "start": 334056, "end": 340834, "text": "Vosotros pues también, estad preparados; porque a la hora que no pensáis, el Hijo del hombre vendrá.", "words": [[0, 334056], [9, 334056], [14, 334200], [23, 334670], [29, 335140], [41, 336644], [48, 336908], [50, 337188], [53, 337288], [58, 337448], [62, 337608], [65, 337748], [74, 338768], [77, 339248], [82, 339508], [86, 339728], [93, 340068]]}, {"verse": 41, "start": 341284, "end": 349140, "text": "Entonces Pedro le dijo: Señor, ¿dices esta parábola a nosotros, o también a todos?", "words": [[0, 341284], [9, 342501], [15, 342821], [18, 343061], [24, 343866], [31, 344707], [38, 344927], [43, 345307], [52, 345767], [54, 345907], [64, 346287], [66, 346707], [74, 346967], [76, 347107]]}, {"verse": 42, "start": 349490, "end": 358311, "text": "Y dijo el Señor: ¿Quién es el mayordomo fiel y prudente, al cual el señor pondrá sobre su familia, para que a tiempo les dé su ración?", "words": [[0, 349490], [2, 349619], [7, 349899], [10, 350059], [17, 350992], [24, 351387], [27, 351527], [30, 351927], [40, 352327], [45, 352627], [47, 352727], [57, 353287], [60, 353467], [65, 353627], [68, 353847], [74, 354147], [81, 354787], [87, 355107], [90, 355347], [99, 355887], [104, 356347], [108, 356527], [110, 356627], [117, 356907], [121, 357147], [124, 357387], [127, 357547]]}, {"verse": 43, "start": 358761, "end": 364863, "text": "Bienaventurado aquel siervo, al cual, cuando su señor venga, le halle haciendo así.", "words": [[0, 359290], [15, 359850], [21, 360290], [29, 360830], [32, 361010], [38, 361810], [45, 362170], [48, 362390], [54, 362810], [61, 363230], [64, 363450], [70, 363670], [79, 363890]]}, {"verse": 44, "start": 365313, "end": 369402, "text": "En verdad os digo, que él le pondrá sobre todos sus bienes.", "words": [[0, 365313], [3, 365429], [10, 365669], [13, 365909], [19, 366269], [23, 366769], [26, 367089], [29, 367289], [36, 367829], [42, 368129], [48, 368429], [52, 368729]]}, {"verse": 45, "start": 369852, "end": 381937, "text": "Pero si el tal siervo dice en su corazón: Mi señor tarda en venir: y comienza a herir a los siervos y a las criadas, y a comer y a beber y a embriagarse;", "words": [[0, 369852], [5, 369999], [8, 370219], [11, 370339], [15, 370519], [22, 371059], [27, 371359], [30, 371539], [33, 371679], [42, 372756], [45, 372943], [51, 373343], [57, 374003], [60, 374183], [67, 375008], [69, 375125], [78, 375825], [80, 376145], [86, 376565], [88, 376645], [92, 376805], [100, 377385], [102, 377525], [104, 377605], [108, 377725], [117, 378385], [119, 378845], [121, 378925], [127, 379285], [129, 379785], [131, 379845], [137, 380145], [139, 380805], [141, 380885]]}, {"verse": 46, "start": 382387, "end": 391532, "text": "Vendrá el señor de aquel siervo el día que no espera, y a la hora que no sabe, y le apartará, y pondrá su parte con los infieles.", "words": [[0, 382387], [7, 382832], [10, 382952], [16, 383252], [19, 383512], [25, 383792], [32, 384232], [35, 384352], [39, 384592], [43, 384772], [46, 384932], [54, 385412], [56, 386072], [58, 386192], [61, 386292], [66, 386532], [70, 386712], [73, 386852], [79, 387292], [81, 387612], [84, 387712], [94, 388392], [96, 388952], [103, 389412], [106, 389592], [112, 390112], [116, 390412], [120, 390572]]}, {"verse": 47, "start": 391982, "end": 401705, "text": "Porque el siervo que entendió la voluntad de su señor, y no se preparó, ni hizo conforme a su voluntad, será azotado mucho.", "words": [[0, 391982], [7, 392224], [10, 392384], [17, 392904], [21, 393064], [30, 393684], [33, 393844], [42, 394444], [45, 394584], [48, 394764], [55, 395284], [57, 396044], [60, 396184], [63, 396364], [72, 397044], [75, 397524], [80, 398004], [89, 398744], [91, 398784], [94, 398904], [104, 399724], [109, 400244], [117, 400984]]}, {"verse": 48, "start": 402155, "end": 417087, "text": "Pero el que no entendió, e hizo cosas dignas de azotes, será azotado poco: porque a cualquiera que fue dado mucho, mucho será vuelto a demandar de él; y al que encomendaron mucho, más le será pedido.", "words": [[0, 402155], [5, 402299], [8, 402479], [12, 402619], [15, 402799], [25, 403539], [27, 404199], [32, 404459], [38, 404859], [45, 405379], [48, 405499], [56, 406519], [61, 406719], [69, 407459], [75, 408399], [82, 408583], [84, 408703], [95, 409183], [99, 409323], [103, 409503], [108, 409703], [115, 410703], [121, 411023], [126, 411303], [133, 411803], [135, 411883], [144, 412443], [147, 412603], [151, 413227], [153, 413371], [156, 413551], [160, 413611], [173, 414311], [180, 414671], [184, 415591], [187, 416051], [192, 416371]]}, {"verse": 49, "start": 417537, "end": 422304, "text": "Fuego vine a meter en la tierra: ¿y qué quiero, si ya está encendido?", "words": [[0, 417537], [6, 417835], [11, 418235], [13, 418455], [19, 418775], [22, 419015], [25, 419175], [33, 420177], [36, 420300], [40, 420460], [48, 420820], [51, 421080], [54, 421280], [59, 421500]]}, {"verse": 50, "start": 422754, "end": 429654, "text": "Pero de bautismo me es necesario ser bautizado: y ¡cómo me angustio hasta que sea cumplido!", "words": [[0, 422754], [5, 422940], [8, 423120], [17, 423860], [20, 424440], [23, 424600], [33, 425400], [37, 425720], [48, 427022], [50, 427148], [56, 427528], [59, 427768], [68, 428268], [74, 428428], [78, 428608], [82, 428788]]}, {"verse": 51, "start": 430104, "end": 434997, "text": "¿Pensáis que he venido a la tierra a dar paz? No, os digo; sino división.", "words": [[0, 430104], [9, 430569], [13, 430809], [16, 430909], [23, 431269], [25, 431389], [28, 431429], [35, 431689], [37, 431989], [41, 432109], [46, 432973], [50, 433047], [53, 433120], [59, 433981], [64, 434223]]}, {"verse": 52, "start": 435447, "end": 442309, "text": "Porque estarán de aquí en adelante cinco en una casa divididos; tres contra dos, y dos contra tres.", "words": [[0, 435447], [7, 435731], [15, 436371], [18, 436471], [23, 436671], [26, 436811], [35, 437281], [41, 437751], [44, 438211], [48, 438391], [53, 438671], [64, 440038], [69, 440178], [76, 440538], [81, 440898], [83, 441108], [87, 441318], [94, 441843]]}, {"verse": 53, "start": 442759, "end": 455881, "text": "El padre estará dividido contra el hijo, y el hijo contra el padre; la madre contra la hija, y la hija contra la madre; la suegra contra su nuera, y la nuera contra su suegra.", "words": [[0, 442759], [3, 442924], [9, 443444], [16, 443924], [25, 444464], [32, 444764], [35, 445024], [41, 445464], [43, 445984], [46, 446144], [51, 446444], [58, 446784], [61, 446984], [68, 448003], [71, 448281], [77, 448581], [84, 449041], [87, 449301], [93, 450221], [95, 450441], [98, 450601], [103, 450941], [110, 451241], [113, 451461], [120, 452342], [123, 452482], [130, 453022], [137, 453362], [140, 453622], [147, 454082], [149, 454322], [152, 454462], [158, 454762], [165, 455042], [168, 455262]]}, {"verse": 54, "start": 456331, "end": 465059, "text": "Y decía también a la multitud: Cuando veis la nube que sale del poniente, luego decís: Agua viene; y es así.", "words": [[0, 456331], [2, 456685], [8, 457065], [16, 457445], [18, 457705], [21, 457765], [31, 458877], [38, 459041], [43, 459361], [46, 459501], [51, 459821], [55, 459961], [60, 460261], [64, 460461], [74, 461521], [80, 461761], [87, 463087], [92, 463440], [99, 464290], [101, 464434], [104, 464614]]}, {"verse": 55, "start": 465509, "end": 470230, "text": "Y cuando sopla el sur, decís: Habrá calor; y lo hay.", "words": [[0, 465509], [2, 465634], [9, 465934], [15, 466494], [18, 466924], [23, 467354], [30, 468372], [36, 468637], [43, 469490], [45, 469639], [48, 469799]]}, {"verse": 56, "start": 470680, "end": 477539, "text": "¡Hipócritas! Sabéis examinar la faz del cielo y de la tierra; ¿y cómo no reconocéis este tiempo?", "words": [[0, 471207], [13, 471995], [20, 472453], [29, 473093], [32, 473233], [36, 473433], [40, 473653], [46, 474053], [48, 474213], [51, 474293], [54, 474413], [62, 475397], [65, 475518], [70, 475738], [73, 475958], [84, 476678], [89, 476898]]}, {"verse": 57, "start": 477989, "end": 482568, "text": "¿Y por qué aun de vosotros mismos no juzgáis lo que es justo?", "words": [[0, 477989], [3, 478116], [7, 478316], [11, 478556], [15, 478936], [18, 479136], [27, 479596], [34, 480056], [37, 480816], [45, 481336], [48, 481716], [52, 481856], [55, 481996]]}, {"verse": 58, "start": 483018, "end": 497244, "text": "Pues cuando vas al magistrado con tu adversario, procura en el camino llegar a un acuerdo con él; no sea que te arrastre al juez, y el juez te entregue al alguacil, y el alguacil te meta en la cárcel.", "words": [[0, 483018], [5, 483202], [12, 483642], [16, 483922], [19, 484082], [30, 484742], [34, 484942], [37, 485102], [49, 486162], [57, 486682], [60, 486782], [63, 486902], [70, 487182], [77, 487522], [79, 487722], [82, 487842], [90, 488142], [94, 488422], [98, 489081], [101, 489228], [105, 489588], [109, 489808], [112, 490008], [121, 490668], [124, 490848], [130, 491468], [132, 491968], [135, 492108], [140, 492748], [143, 493028], [152, 493608], [155, 494018], [165, 494428], [167, 494948], [170, 495348], [179, 495748], [182, 495888], [187, 496208], [190, 496368], [193, 496528]]}, {"verse": 59, "start": 497694, "end": 502872, "text": "Te digo que no saldrás de allá, hasta que hayas pagado hasta el último centavo.", "words": [[0, 497694], [3, 497780], [8, 498060], [12, 498260], [15, 498420], [23, 499020], [26, 499140], [32, 499920], [38, 500260], [42, 500440], [48, 500660], [55, 501160], [61, 501580], [64, 501760], [71, 501980]]}]}