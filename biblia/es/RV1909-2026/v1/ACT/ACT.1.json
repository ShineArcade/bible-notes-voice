{"book": "ACT", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 234812, "verses": [{"verse": 1, "start": 300, "end": 8070, "text": "En el primer tratado, oh Teófilo, he hablado de todas las cosas que Jesús comenzó a hacer y a enseñar,", "words": [[0, 300], [3, 444], [6, 564], [13, 904], [22, 1434], [25, 1964], [34, 2624], [37, 3304], [45, 3744], [48, 3884], [54, 4184], [58, 4504], [64, 4924], [68, 5404], [74, 5744], [82, 6444], [84, 6544], [90, 6904], [92, 7164], [94, 7264]]}, {"verse": 2, "start": 8420, "end": 17326, "text": "Hasta el día en que, habiendo dado mandamientos por el Espíritu Santo a los apóstoles que escogió, fue recibido arriba;", "words": [[0, 8420], [6, 8685], [9, 8865], [13, 9145], [16, 9505], [21, 10285], [30, 10765], [35, 11025], [48, 11805], [52, 12085], [55, 12205], [64, 12765], [70, 13105], [72, 13365], [76, 13485], [86, 14125], [90, 14345], [99, 15565], [103, 15705], [112, 16505]]}, {"verse": 3, "start": 17676, "end": 27995, "text": "A los cuales, después de haber padecido, se presentó vivo con muchas pruebas indudables, apareciéndoles por cuarenta días, y hablándoles del reino de Dios.", "words": [[0, 17676], [2, 17866], [6, 17966], [14, 18266], [22, 18686], [25, 18806], [31, 18966], [41, 20106], [44, 20206], [53, 20826], [58, 21066], [62, 21366], [69, 21766], [77, 22286], [89, 23446], [104, 24346], [108, 24676], [117, 25006], [123, 25566], [125, 25891], [137, 26571], [141, 26811], [147, 27231], [150, 27391]]}, {"verse": 4, "start": 28345, "end": 38572, "text": "Y estando juntos, les mandó que no se fuesen de Jerusalén, sino que esperasen la promesa del Padre, que oísteis, dijo, de mí.", "words": [[0, 28345], [2, 28463], [10, 28902], [18, 29472], [22, 30042], [28, 30482], [32, 30643], [35, 30803], [38, 31072], [45, 31342], [48, 31542], [59, 32662], [64, 33022], [68, 33262], [78, 33962], [81, 34122], [89, 34622], [93, 34842], [100, 35883], [104, 36025], [113, 37210], [119, 38015], [122, 38241]]}, {"verse": 5, "start": 38922, "end": 46768, "text": "Porque Juan a la verdad bautizó con agua, pero vosotros seréis bautizados con el Espíritu Santo no muchos días después de estos.", "words": [[0, 38922], [7, 39126], [12, 39506], [14, 39766], [17, 39886], [24, 40246], [32, 40986], [36, 41206], [42, 41666], [47, 41826], [56, 42326], [63, 42726], [74, 43506], [78, 43746], [81, 43906], [90, 44381], [96, 44661], [99, 44981], [106, 45241], [111, 45621], [119, 45941], [122, 46181]]}, {"verse": 6, "start": 47118, "end": 54302, "text": "Entonces los que se habían reunido le preguntaron, diciendo: Señor, ¿restituirás el reino a Israel en este tiempo?", "words": [[0, 47118], [9, 47767], [13, 48172], [17, 48292], [20, 48432], [27, 48672], [35, 49332], [38, 49452], [51, 50152], [61, 51148], [68, 51887], [81, 52587], [84, 52727], [90, 52867], [92, 53007], [99, 53367], [102, 53547], [107, 53727]]}, {"verse": 7, "start": 54582, "end": 61857, "text": "Y les dijo: No toca a vosotros saber los tiempos o los períodos que el Padre puso en su sola potestad;", "words": [[0, 54582], [2, 54746], [6, 54866], [12, 55604], [15, 55751], [20, 56051], [22, 56291], [31, 56811], [37, 57291], [41, 57551], [49, 58151], [51, 58251], [55, 58371], [64, 58911], [68, 59031], [71, 59191], [77, 59671], [82, 60251], [85, 60491], [88, 60731], [93, 61322]]}, {"verse": 8, "start": 62207, "end": 74079, "text": "Pero recibiréis el poder del Espíritu Santo que vendrá sobre vosotros; y me seréis testigos en Jerusalén, y en toda Judea, y Samaria, y hasta lo último de la tierra.", "words": [[0, 62207], [5, 62607], [16, 63407], [19, 63587], [25, 63887], [29, 64147], [38, 64667], [44, 64927], [48, 65187], [55, 65587], [61, 65867], [71, 66930], [73, 67036], [76, 67136], [83, 67536], [92, 68116], [95, 68356], [106, 69156], [108, 69676], [111, 69836], [116, 70076], [123, 70936], [125, 71176], [134, 71696], [136, 72256], [142, 72426], [145, 72596], [152, 72956], [155, 73236], [158, 73376]]}, {"verse": 9, "start": 74429, "end": 82024, "text": "Y habiendo dicho estas cosas, viéndolo ellos, fue alzado; y una nube le recibió y le quitó de sus ojos.", "words": [[0, 74429], [2, 74553], [11, 74893], [17, 75233], [23, 75473], [30, 76433], [39, 76993], [46, 77273], [50, 77613], [58, 78691], [60, 78852], [64, 79052], [69, 79472], [72, 79632], [80, 80392], [82, 80652], [85, 80752], [91, 81092], [94, 81212], [98, 81352]]}, {"verse": 10, "start": 82374, "end": 90323, "text": "Y estando con los ojos puestos en el cielo, entre tanto que él iba, he aquí dos varones se pusieron junto a ellos en vestidos blancos;", "words": [[0, 82374], [2, 82520], [10, 82940], [14, 83120], [18, 83280], [23, 83540], [31, 84120], [34, 84280], [37, 84420], [44, 84840], [50, 85020], [56, 85420], [60, 85700], [63, 85880], [68, 86760], [71, 86840], [76, 87240], [80, 87340], [88, 87940], [91, 88020], [100, 88420], [106, 88680], [108, 88900], [114, 89080], [117, 89320], [126, 89720]]}, {"verse": 11, "start": 90673, "end": 101841, "text": "Los cuales también les dijeron: Varones galileos, ¿qué estáis mirando al cielo? este mismo Jesús que ha sido tomado desde vosotros arriba en el cielo, así vendrá como le habéis visto ir al cielo.", "words": [[0, 90673], [4, 90784], [11, 91004], [19, 91304], [23, 91564], [32, 92587], [40, 92747], [50, 93707], [55, 93787], [62, 94147], [70, 94527], [73, 94667], [80, 95445], [85, 95729], [91, 96009], [97, 96369], [101, 96629], [104, 96749], [109, 96929], [116, 97369], [122, 97549], [131, 98129], [138, 98449], [141, 98629], [144, 98729], [151, 99549], [155, 99749], [162, 100129], [167, 100329], [170, 100489], [177, 100709], [183, 101029], [186, 101189], [189, 101329]]}, {"verse": 12, "start": 102121, "end": 109494, "text": "Entonces se volvieron a Jerusalén del monte que se llama del Olivar, el cual está cerca de Jerusalén camino de un sábado.", "words": [[0, 102121], [9, 102564], [12, 102864], [22, 103404], [24, 103524], [34, 104104], [38, 104384], [44, 104664], [48, 104824], [51, 104944], [57, 105264], [61, 105464], [69, 106329], [72, 106429], [77, 106629], [82, 106909], [88, 107269], [91, 107489], [101, 108109], [108, 108389], [111, 108709], [114, 108829]]}, {"verse": 13, "start": 109844, "end": 124842, "text": "Y entrados, subieron al aposento alto, donde moraban Pedro y Jacobo, y Juan y Andrés, Felipe y Tomás, Bartolomé y Mateo, Jacobo hijo de Alfeo, y Simón Zelote, y Judas hermano de Jacobo.", "words": [[0, 109844], [2, 109982], [12, 110682], [21, 111442], [24, 111622], [33, 112122], [39, 112662], [45, 113442], [53, 114042], [59, 114502], [61, 114702], [69, 115402], [71, 115582], [76, 115942], [78, 116262], [86, 117082], [93, 117422], [95, 117702], [102, 118422], [112, 119082], [114, 119282], [121, 120082], [128, 120662], [133, 120862], [136, 121062], [143, 121562], [145, 121702], [151, 122278], [159, 123075], [161, 123220], [167, 123500], [175, 124080], [178, 124160]]}, {"verse": 14, "start": 125192, "end": 133864, "text": "Todos estos perseveraban unánimes en oración y ruego, con las mujeres, y con María la madre de Jesús, y con sus hermanos.", "words": [[0, 125192], [6, 125416], [12, 125736], [25, 126756], [34, 127556], [37, 127776], [45, 128276], [47, 128416], [54, 128896], [58, 129496], [62, 129676], [71, 130136], [73, 130776], [77, 130936], [83, 131436], [86, 131516], [92, 131776], [95, 131956], [102, 132336], [104, 132896], [108, 133116], [112, 133276]]}, {"verse": 15, "start": 134214, "end": 143193, "text": "Y en aquellos días, Pedro, levantándose en medio de los hermanos, dijo (y estaba reunido un grupo de unas ciento veinte personas):", "words": [[0, 134214], [2, 134342], [5, 134442], [14, 134702], [20, 135222], [27, 136242], [40, 137182], [43, 137382], [49, 137662], [52, 137862], [56, 138002], [66, 138862], [71, 139177], [74, 139277], [81, 139757], [89, 140237], [92, 140417], [98, 140717], [101, 141017], [106, 141384], [113, 141750], [120, 142117]]}, {"verse": 16, "start": 143393, "end": 152571, "text": "Varones hermanos, convino que se cumpliese la Escritura, la cual dijo antes el Espíritu Santo por la boca de David, de Judas, que fue guía de los que prendieron a Jesús;", "words": [[0, 143561], [8, 143731], [18, 144251], [26, 144671], [30, 144791], [33, 145101], [43, 145411], [46, 145571], [57, 146411], [60, 146511], [65, 146691], [70, 146951], [76, 147271], [79, 147491], [88, 147971], [94, 148271], [98, 148531], [101, 148651], [106, 148851], [109, 149011], [116, 149571], [119, 149611], [126, 150418], [130, 150500], [134, 150680], [139, 151020], [142, 151120], [146, 151240], [150, 151400], [161, 151880], [163, 152000]]}, {"verse": 17, "start": 152921, "end": 156908, "text": "El cuál era contado con nosotros, y tenía parte en este ministerio.", "words": [[0, 152921], [3, 153061], [8, 153301], [12, 153521], [20, 154021], [24, 154181], [34, 154641], [36, 155006], [42, 155306], [48, 155686], [51, 155926], [56, 156126]]}, {"verse": 18, "start": 157188, "end": 167289, "text": "Este, pues, adquirió un campo del salario de su iniquidad, y colgándose, reventó por medio, y todas sus entrañas se derramaron.", "words": [[0, 157188], [6, 157549], [12, 157949], [21, 158969], [24, 159189], [30, 159649], [34, 159929], [42, 160489], [45, 160649], [48, 160849], [59, 161709], [61, 162269], [73, 163129], [81, 163989], [85, 164149], [92, 164549], [94, 165089], [100, 165289], [104, 165569], [113, 166249], [116, 166509]]}, {"verse": 19, "start": 167639, "end": 178622, "text": "Y fue notorio a todos los habitantes de Jerusalén; de tal manera que aquel campo es llamado en su propia lengua, Acéldama, que es, Campo de sangre.", "words": [[0, 167639], [2, 167938], [6, 168078], [14, 168758], [16, 168938], [22, 169158], [26, 169398], [37, 170038], [40, 170178], [51, 171356], [54, 171464], [58, 171664], [65, 172064], [69, 172324], [75, 172604], [81, 172944], [84, 173184], [92, 173504], [95, 173744], [98, 173904], [105, 174324], [113, 175444], [123, 176664], [127, 176924], [131, 177264], [137, 177719], [140, 177979]]}, {"verse": 20, "start": 178842, "end": 188056, "text": "Porque está escrito en el libro de los salmos: Sea hecha desierta su habitación, y no haya quien more en ella; y: Tome otro su cargo.", "words": [[0, 178842], [7, 179046], [12, 179326], [20, 179706], [23, 179926], [26, 180066], [32, 180266], [35, 180446], [39, 180566], [47, 181567], [51, 181851], [57, 182301], [66, 182751], [69, 182911], [81, 183531], [83, 183756], [86, 183916], [91, 184116], [97, 184356], [102, 184636], [105, 184816], [111, 185351], [114, 186856], [119, 187060], [124, 187340], [127, 187540]]}, {"verse": 21, "start": 188406, "end": 196327, "text": "Conviene, pues, que de estos hombres que han estado juntos con nosotros todo el tiempo que el Señor Jesús entró y salió entre nosotros,", "words": [[0, 188406], [10, 188801], [16, 189681], [20, 189761], [23, 189921], [29, 190161], [37, 190661], [41, 190881], [45, 191021], [52, 191281], [59, 191761], [63, 192001], [72, 192741], [77, 192861], [80, 193061], [87, 193381], [91, 193621], [94, 193741], [100, 193981], [106, 194321], [112, 194921], [114, 195041], [120, 195341], [126, 195521]]}, {"verse": 22, "start": 196677, "end": 205553, "text": "Comenzando desde el bautismo de Juan, hasta el día que fue recibido arriba de entre nosotros, uno sea hecho testigo con nosotros de su resurrección.", "words": [[0, 196677], [11, 197313], [17, 197513], [20, 197713], [29, 198213], [32, 198353], [38, 199233], [44, 199493], [47, 199653], [51, 199813], [55, 199973], [59, 200153], [68, 200693], [75, 200953], [78, 201193], [84, 201373], [94, 202433], [98, 202663], [102, 202893], [108, 203263], [116, 203633], [120, 203833], [129, 204253], [132, 204493], [135, 204653]]}, {"verse": 23, "start": 205833, "end": 212961, "text": "Y señalaron a dos: a José, llamado Barsabas, que tenía por sobrenombre Justo, y a Matías.", "words": [[0, 205833], [2, 205958], [12, 206698], [14, 206958], [19, 207754], [21, 208014], [27, 208434], [35, 209264], [45, 210094], [49, 210114], [55, 210454], [59, 210674], [71, 211454], [78, 211854], [80, 212246], [82, 212638]]}, {"verse": 24, "start": 213311, "end": 219987, "text": "Y orando, dijeron: Tú, Señor, que conoces los corazones de todos, muestra cuál escoges de estos dos,", "words": [[0, 213311], [2, 213490], [10, 213850], [19, 214895], [23, 215013], [30, 215693], [34, 215773], [42, 216213], [46, 216373], [56, 216933], [59, 217073], [66, 217773], [74, 218220], [79, 218666], [87, 219113], [90, 219253], [96, 219433]]}, {"verse": 25, "start": 220337, "end": 226850, "text": "Para que tome el oficio de este ministerio y apostolado, del cual cayó Judas por transgresión, para irse a su lugar.", "words": [[0, 220337], [5, 220477], [9, 220617], [14, 220917], [17, 221017], [24, 221397], [27, 221557], [32, 221717], [43, 222357], [45, 222437], [57, 223137], [61, 223557], [66, 223777], [71, 224157], [77, 224357], [81, 224657], [95, 225397], [100, 225817], [105, 226197], [107, 226277], [110, 226377]]}, {"verse": 26, "start": 227130, "end": 234412, "text": "Y les echaron suertes, y cayó la suerte sobre Matías; y fue contado con los once apóstoles.", "words": [[0, 227130], [2, 227256], [6, 227436], [14, 227876], [23, 228696], [25, 229076], [30, 229436], [33, 229556], [40, 229976], [46, 230256], [54, 231325], [56, 231449], [60, 231609], [68, 232349], [72, 232609], [76, 232989], [81, 233369]]}]}