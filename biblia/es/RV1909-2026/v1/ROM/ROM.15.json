{"book": "ROM", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 243495, "verses": [{"verse": 1, "start": 300, "end": 6634, "text": "Así que, los que somos más firmes debemos soportar las debilidades de los débiles, y no agradarnos a nosotros mismos.", "words": [[0, 300], [4, 504], [9, 704], [13, 844], [17, 1004], [23, 1244], [27, 1524], [34, 2044], [42, 2424], [51, 3064], [55, 3184], [67, 3764], [70, 3944], [74, 4064], [83, 4504], [85, 4784], [88, 4924], [99, 5504], [101, 5684], [110, 5864]]}, {"verse": 2, "start": 7084, "end": 10923, "text": "Cada uno de nosotros agrade a su prójimo en bien, a edificación.", "words": [[0, 7084], [5, 7225], [9, 7505], [12, 7625], [21, 8125], [28, 8505], [30, 8745], [33, 8865], [41, 9345], [44, 9485], [50, 9705], [52, 10045]]}, {"verse": 3, "start": 11373, "end": 19636, "text": "Porque Cristo no se agradó a sí mismo; antes bien, como está escrito: Los insultos de los que te insultan, cayeron sobre mí.", "words": [[0, 11373], [7, 11622], [14, 12062], [17, 12342], [20, 12522], [27, 12962], [29, 13082], [32, 13162], [39, 13959], [45, 14221], [51, 15081], [56, 15381], [61, 15621], [70, 16588], [74, 16728], [83, 17428], [86, 17548], [90, 17668], [94, 17828], [97, 17968], [107, 18688], [115, 19108], [121, 19328]]}, {"verse": 4, "start": 20086, "end": 30434, "text": "Porque las cosas que antes fueron escritas, para nuestra enseñanza fueron escritas; para que por la paciencia, y por la consolación de las Escrituras, tengamos esperanza.", "words": [[0, 20086], [7, 20275], [11, 20475], [17, 20795], [21, 21055], [27, 21295], [34, 21595], [44, 22395], [49, 22775], [57, 22995], [67, 23815], [74, 24095], [84, 25247], [89, 25392], [93, 25532], [97, 25712], [100, 25832], [111, 26492], [113, 26912], [117, 27092], [120, 27192], [132, 27832], [135, 27952], [139, 28092], [151, 28772], [160, 29612]]}, {"verse": 5, "start": 30884, "end": 37175, "text": "Pero el Dios de la paciencia y de la consolación os dé que entre vosotros seáis unánimes según Cristo Jesús;", "words": [[0, 30884], [5, 31022], [8, 31162], [13, 31322], [16, 31502], [19, 31602], [29, 32202], [31, 32342], [34, 32422], [37, 32542], [49, 33362], [52, 33882], [55, 34082], [59, 34222], [65, 34442], [74, 34982], [80, 35362], [89, 35882], [95, 36102], [102, 36482]]}, {"verse": 6, "start": 37625, "end": 42801, "text": "Para que concordes, a una boca glorifiquéis al Dios y Padre de nuestro Señor Jesucristo.", "words": [[0, 37625], [5, 37778], [9, 37898], [20, 38578], [22, 38778], [26, 38938], [31, 39238], [44, 40078], [47, 40258], [52, 40478], [54, 40818], [60, 41198], [63, 41278], [71, 41658], [77, 41858]]}, {"verse": 7, "start": 43251, "end": 49748, "text": "Por tanto, recibíos los unos a los otros, como también Cristo nos recibió, para gloria de Dios.", "words": [[0, 43251], [4, 43354], [11, 43774], [20, 44414], [24, 44614], [29, 44894], [31, 45114], [35, 45254], [42, 45894], [47, 46174], [55, 46534], [62, 46854], [66, 47054], [75, 48234], [80, 48474], [87, 48874], [90, 49014]]}, {"verse": 8, "start": 50198, "end": 58340, "text": "Digo, pues, que Cristo Jesús fue hecho ministro de la circuncisión por la verdad de Dios, para confirmar las promesas hechas a los padres,", "words": [[0, 50198], [6, 50378], [12, 51078], [16, 51158], [23, 51498], [29, 52018], [33, 52278], [39, 52478], [48, 53038], [51, 53118], [54, 53218], [67, 54078], [71, 54278], [74, 54398], [81, 54698], [84, 54878], [90, 55178], [95, 55758], [105, 56378], [109, 56518], [118, 57058], [125, 57298], [127, 57498], [131, 57638]]}, {"verse": 9, "start": 58790, "end": 67918, "text": "Y para que los Gentiles glorifiquen a Dios por la misericordia; como está escrito: Por tanto yo te confesaré entre los Gentiles, y cantaré a tu nombre.", "words": [[0, 58790], [2, 58898], [7, 59078], [11, 59238], [15, 59378], [24, 59898], [36, 60738], [38, 60818], [43, 60998], [47, 61258], [50, 61378], [64, 62589], [69, 62765], [74, 63045], [83, 63985], [87, 64086], [93, 64546], [96, 64646], [99, 64806], [109, 65426], [115, 65666], [119, 65886], [129, 66446], [131, 66706], [139, 67166], [141, 67286], [144, 67386]]}, {"verse": 10, "start": 68368, "end": 71895, "text": "Y otra vez dice: Alegraos, Gentiles, con su pueblo.", "words": [[0, 68368], [2, 68527], [7, 68667], [11, 68927], [17, 69945], [27, 70185], [37, 70825], [41, 71085], [44, 71225]]}, {"verse": 11, "start": 72345, "end": 78253, "text": "Y otra vez: Alabad al Señor todos los Gentiles, y magnificadle, todos los pueblos.", "words": [[0, 72345], [2, 72511], [7, 72651], [12, 73712], [19, 73962], [22, 74062], [28, 74282], [34, 74642], [38, 74882], [48, 75522], [50, 76202], [64, 76882], [70, 77322], [74, 77602]]}, {"verse": 12, "start": 78703, "end": 87919, "text": "Y otra vez, dice Isaías: Estará la raíz de Isaí, y el que se levantará a regir los Gentiles: los Gentiles esperarán en él.", "words": [[0, 78703], [2, 78959], [7, 79099], [12, 79399], [17, 79699], [25, 81469], [32, 81929], [35, 82029], [40, 82429], [43, 82569], [49, 83209], [51, 83449], [54, 83549], [58, 83669], [61, 83809], [71, 84429], [73, 84629], [79, 85029], [83, 85169], [93, 86210], [97, 86330], [106, 86850], [116, 87530], [119, 87650]]}, {"verse": 13, "start": 88369, "end": 96342, "text": "Y el Dios de esperanza os llene de todo gozo y paz creyendo, para que abundéis en esperanza por el poder del Espíritu Santo.", "words": [[0, 88369], [2, 88514], [5, 88634], [10, 88874], [13, 89114], [23, 89814], [26, 90074], [32, 90394], [35, 90534], [40, 90794], [45, 91254], [47, 91434], [51, 91694], [61, 92774], [66, 92974], [70, 93154], [79, 93674], [82, 93834], [92, 94434], [96, 94674], [99, 94794], [105, 95034], [109, 95294], [118, 95834]]}, {"verse": 14, "start": 96792, "end": 108190, "text": "Pero cierto estoy yo de vosotros, hermanos míos, que aun vosotros mismos estáis llenos de bondad, llenos de todo conocimiento, de tal manera que podáis amonestaros los unos a los otros.", "words": [[0, 96792], [5, 96948], [12, 97468], [18, 97648], [21, 97888], [24, 97988], [34, 98688], [43, 99108], [49, 99828], [53, 99908], [57, 100068], [66, 100548], [73, 100888], [80, 101448], [87, 101708], [90, 101848], [98, 102528], [105, 102828], [108, 102968], [113, 103128], [127, 104394], [130, 104500], [134, 104700], [141, 104980], [145, 105180], [152, 105560], [164, 106260], [168, 106400], [173, 106600], [175, 106800], [179, 106940]]}, {"verse": 15, "start": 108640, "end": 115525, "text": "Pero os he escrito, hermanos, en parte resueltamente, como amonestándoos por la gracia que de Dios me es dada,", "words": [[0, 108640], [5, 108792], [8, 108972], [11, 109072], [20, 109652], [30, 110352], [33, 110432], [39, 111302], [54, 112172], [59, 112432], [73, 113332], [77, 113532], [80, 113672], [87, 114132], [91, 114232], [94, 114372], [99, 114612], [102, 114872], [105, 115012]]}, {"verse": 16, "start": 115975, "end": 126758, "text": "Para ser ministro de Jesucristo a los Gentiles, ministrando el evangelio de Dios, para que la ofrenda de los Gentiles sea agradable, santificada por el Espíritu Santo.", "words": [[0, 115975], [5, 116134], [9, 116314], [18, 116894], [21, 116994], [32, 117734], [34, 117834], [38, 117954], [48, 119214], [60, 119734], [63, 119894], [73, 120454], [76, 120554], [82, 121314], [87, 121514], [91, 121674], [94, 121794], [102, 122254], [105, 122334], [109, 122474], [118, 123054], [122, 123314], [133, 124214], [145, 124894], [149, 125114], [152, 125234], [161, 125834]]}, {"verse": 17, "start": 127208, "end": 132361, "text": "Tengo, pues, de qué gloriarme en Cristo Jesús en lo que se refiere a Dios.", "words": [[0, 127208], [7, 127427], [13, 127707], [16, 128207], [20, 128387], [30, 129067], [33, 129167], [40, 129467], [46, 130007], [49, 130547], [52, 130627], [56, 130747], [59, 130867], [67, 131267], [69, 131407]]}, {"verse": 18, "start": 132811, "end": 140865, "text": "Porque no me atrevería a hablar alguna cosa que Cristo no haya hecho por mí para la obediencia de los Gentiles, con la palabra y con las obras,", "words": [[0, 132811], [7, 133021], [10, 133261], [13, 133401], [23, 134041], [25, 134141], [32, 134321], [39, 134621], [44, 135021], [48, 135241], [55, 135561], [58, 135841], [63, 136001], [69, 136301], [73, 136521], [76, 136701], [81, 136921], [84, 137081], [95, 137621], [98, 137761], [102, 137901], [112, 138641], [116, 138961], [119, 139101], [127, 139481], [129, 139621], [133, 139761], [137, 139921]]}, {"verse": 19, "start": 141315, "end": 151649, "text": "Con poder de milagros y prodigios, por el poder del Espíritu de Dios: de manera que desde Jerusalén, y por los alrededores hasta Ilírico, he llenado todo del evangelio de Cristo.", "words": [[0, 141315], [4, 141436], [10, 141676], [13, 141856], [22, 142396], [24, 142516], [35, 143156], [39, 143496], [42, 143616], [48, 143816], [52, 144056], [61, 144596], [64, 144696], [70, 145516], [73, 145580], [80, 145760], [84, 146000], [90, 146180], [101, 147060], [103, 147320], [107, 147480], [111, 147640], [123, 148300], [129, 148580], [138, 149420], [141, 149720], [149, 150040], [154, 150320], [158, 150540], [168, 151040], [171, 151140]]}, {"verse": 20, "start": 152099, "end": 159778, "text": "Y de esta manera me esforcé a predicar el evangelio, no donde antes Cristo fuese nombrado, por no edificar sobre ajeno fundamento:", "words": [[0, 152099], [2, 152219], [5, 152299], [10, 152519], [17, 152859], [20, 153079], [28, 153519], [30, 153619], [39, 154019], [42, 154159], [53, 155179], [56, 155339], [62, 155559], [68, 155879], [75, 156219], [81, 156679], [91, 157279], [95, 157699], [98, 157899], [107, 158319], [113, 158639], [119, 159019]]}, {"verse": 21, "start": 160228, "end": 166237, "text": "Sino, como está escrito: A los que no fue anunciado de él, verán: y los que no oyeron, entenderán.", "words": [[0, 160228], [6, 160506], [11, 160766], [16, 160966], [25, 161823], [27, 161925], [31, 162025], [35, 162185], [38, 162345], [42, 162525], [52, 163065], [55, 163245], [59, 163445], [66, 164270], [68, 164348], [72, 164468], [76, 164648], [79, 164828], [87, 165348]]}, {"verse": 22, "start": 166687, "end": 170536, "text": "Por lo cual aun he sido impedido muchas veces de venir a vosotros.", "words": [[0, 166687], [4, 166796], [7, 166936], [12, 167276], [16, 167816], [19, 167976], [24, 168196], [33, 168696], [40, 168896], [46, 169256], [49, 169476], [55, 169696], [57, 169836]]}, {"verse": 23, "start": 170986, "end": 176558, "text": "Pero ahora no teniendo más lugar en estas regiones, y deseando ir a vosotros desde hace muchos años,", "words": [[0, 170986], [5, 171143], [11, 171443], [14, 171603], [23, 172023], [27, 172203], [33, 172523], [36, 172683], [42, 172883], [52, 173783], [54, 173943], [63, 174423], [66, 174583], [68, 174683], [77, 175103], [83, 175323], [88, 175663], [95, 175923]]}, {"verse": 24, "start": 177008, "end": 185825, "text": "Cuando vaya a España, iré a vosotros; porque espero que pasando os veré, y que seré llevado de vosotros allá, una vez que haya gozado de vosotros.", "words": [[0, 177008], [7, 177171], [12, 177451], [14, 177571], [22, 177911], [26, 178491], [28, 178551], [38, 179534], [45, 179734], [52, 180034], [56, 180214], [64, 180634], [67, 180914], [73, 181474], [75, 181694], [79, 181794], [84, 182094], [92, 182434], [95, 182574], [104, 183014], [110, 183294], [114, 183954], [118, 184174], [122, 184334], [127, 184494], [134, 184974], [137, 185114]]}, {"verse": 25, "start": 186275, "end": 189450, "text": "Pero ahora parto para Jerusalén a ministrar a los santos.", "words": [[0, 186275], [5, 186396], [11, 186676], [17, 187116], [22, 187276], [32, 187723], [34, 188169], [44, 188616], [46, 188676], [50, 188816]]}, {"verse": 26, "start": 189900, "end": 196062, "text": "Porque Macedonia y Acaya tuvieron por bien hacer una colecta para los pobres de los santos que están en Jerusalén.", "words": [[0, 189900], [7, 190128], [17, 190728], [19, 190868], [25, 191228], [34, 191668], [38, 191848], [43, 192068], [49, 192328], [53, 192548], [61, 193108], [66, 193288], [70, 193468], [77, 193848], [80, 194008], [84, 194148], [91, 194688], [95, 194828], [101, 195108], [104, 195268]]}, {"verse": 27, "start": 196512, "end": 206601, "text": "Porque les pareció bueno, y son deudores a ellos: porque si los Gentiles han sido hechos participantes de sus bienes espirituales, deben también ellos servirles en los bienes materiales.", "words": [[0, 196512], [7, 196698], [11, 196858], [19, 197238], [26, 197558], [28, 197958], [32, 198118], [41, 198598], [43, 198758], [50, 199562], [57, 199722], [60, 199882], [64, 200002], [73, 200462], [77, 200682], [82, 200902], [89, 201182], [103, 201962], [106, 202162], [110, 202322], [117, 202722], [131, 203882], [137, 204162], [145, 204482], [151, 204762], [161, 205342], [164, 205462], [168, 205582], [175, 205902]]}, {"verse": 28, "start": 207051, "end": 212678, "text": "Así que, cuando haya concluido esto, y les haya entregado este fruto, pasaré por vosotros a España.", "words": [[0, 207051], [4, 207225], [9, 207385], [16, 207565], [21, 207885], [31, 208485], [37, 208785], [39, 209025], [43, 209145], [48, 209365], [58, 209905], [63, 210105], [70, 210925], [77, 211365], [81, 211465], [90, 211945], [92, 212085]]}, {"verse": 29, "start": 213128, "end": 217932, "text": "Y sé que cuando llegue a vosotros, llegaré con abundancia de la bendición del evangelio de Cristo.", "words": [[0, 213128], [2, 213230], [5, 213330], [9, 213470], [16, 213690], [23, 214050], [25, 214090], [35, 214590], [43, 215050], [47, 215230], [58, 215850], [61, 215990], [64, 216090], [74, 216610], [78, 216790], [88, 217350], [91, 217430]]}, {"verse": 30, "start": 218382, "end": 225611, "text": "Pero os ruego, hermanos, por el Señor nuestro Jesucristo, y por el amor del Espíritu, que me ayudéis con oraciones por mí a Dios,", "words": [[0, 218382], [5, 218561], [8, 218721], [15, 218981], [25, 219521], [29, 219781], [32, 219941], [38, 220161], [46, 220441], [58, 221281], [60, 221721], [64, 221941], [67, 222021], [72, 222261], [76, 222441], [86, 223121], [90, 223421], [93, 223561], [101, 223941], [105, 224141], [115, 224621], [119, 224901], [122, 225154], [124, 225408]]}, {"verse": 31, "start": 226061, "end": 232639, "text": "Que sea librado de los rebeldes que están en Judea, y que la ofrenda de mi servicio a los santos en Jerusalén sea acepta;", "words": [[0, 226061], [4, 226153], [8, 226353], [16, 226853], [19, 226973], [23, 227093], [32, 227613], [36, 227733], [42, 227933], [45, 228053], [52, 228813], [54, 228953], [58, 229073], [61, 229193], [69, 229673], [72, 229773], [75, 229873], [84, 230313], [86, 230473], [90, 230573], [97, 231013], [100, 231113], [110, 231513], [114, 231913]]}, {"verse": 32, "start": 233089, "end": 239233, "text": "Para que con gozo llegue a vosotros por la voluntad de Dios, y que halle descanso juntamente con vosotros.", "words": [[0, 233089], [5, 233242], [9, 233495], [13, 233749], [18, 234002], [25, 234322], [27, 234382], [36, 234862], [40, 235142], [43, 235262], [52, 235762], [55, 235882], [61, 236202], [63, 236662], [67, 236822], [73, 236982], [82, 237642], [93, 238242], [97, 238482]]}, {"verse": 33, "start": 239683, "end": 243095, "text": "Y el Dios de paz sea con todos vosotros. Amén.", "words": [[0, 239683], [2, 239806], [5, 239926], [10, 240126], [13, 240326], [17, 240546], [21, 240806], [25, 241026], [31, 241286], [41, 242916]]}]}