{"book": "PSA", "chapter": 81, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 106581, "verses": [{"verse": 1, "start": 300, "end": 10374, "text": "Al Músico principal: sobre Gittith: Salmo de Asaf. CANTAD a Dios, fortaleza nuestra: al Dios de Jacob celebrad con júbilo.", "words": [[0, 300], [3, 487], [10, 987], [21, 2153], [27, 2500], [36, 3505], [42, 4245], [45, 4405], [51, 5418], [58, 5618], [60, 5818], [66, 6098], [76, 6938], [85, 7980], [88, 8571], [93, 8891], [96, 9011], [102, 9431], [111, 10051], [115, 10212]]}, {"verse": 2, "start": 10824, "end": 16553, "text": "Tomad la canción, y tañed el pandero, el arpa deliciosa con el salterio.", "words": [[0, 10824], [6, 11944], [9, 12064], [18, 12564], [20, 12831], [26, 13097], [29, 13364], [38, 14004], [41, 14244], [46, 14604], [56, 15384], [60, 15584], [63, 15704]]}, {"verse": 3, "start": 17003, "end": 23284, "text": "Tocad la trompeta en la nueva luna, en el día señalado, en el día de nuestra solemnidad.", "words": [[0, 17115], [6, 17265], [9, 17585], [18, 18345], [21, 18445], [24, 18605], [30, 18865], [36, 19505], [39, 19785], [42, 19945], [46, 20145], [56, 21185], [59, 21325], [62, 21485], [66, 21705], [69, 21865], [77, 22085]]}, {"verse": 4, "start": 23734, "end": 28376, "text": "Porque estatuto es de Israel, ordenanza del Dios de Jacob.", "words": [[0, 23734], [7, 24017], [16, 24817], [19, 25017], [22, 25157], [30, 25937], [40, 27017], [44, 27277], [49, 27557], [52, 27717]]}, {"verse": 5, "start": 28826, "end": 36737, "text": "Por testimonio en José lo ha constituido, cuando salió por la tierra de Egipto; donde oí lenguaje que no entendía.", "words": [[0, 28826], [4, 28826], [15, 29751], [18, 29831], [23, 30091], [26, 30351], [29, 30471], [42, 31351], [49, 31971], [55, 32471], [59, 32671], [62, 32831], [69, 33131], [72, 33391], [80, 34339], [86, 34609], [89, 34969], [98, 35529], [102, 35689], [105, 35869]]}, {"verse": 6, "start": 37037, "end": 42483, "text": "Aparté su hombro de debajo de la carga; sus manos se quitaron de vasijas de barro.", "words": [[0, 37037], [7, 37561], [10, 37741], [17, 38141], [20, 38241], [27, 38641], [30, 38761], [33, 38861], [40, 39959], [44, 40076], [50, 40416], [53, 40656], [62, 41076], [65, 41176], [73, 41676], [76, 41796]]}, {"verse": 7, "start": 42933, "end": 52356, "text": "En la calamidad clamaste, y yo te libré: te respondí en el secreto del trueno; te probé sobre las aguas de Meriba. (Selah.)", "words": [[0, 42933], [3, 43077], [6, 43177], [16, 43737], [26, 44597], [28, 44677], [31, 44797], [34, 44917], [41, 45945], [44, 46026], [53, 46666], [56, 46886], [59, 46986], [67, 47486], [71, 47626], [79, 48754], [82, 48804], [88, 49224], [94, 49724], [98, 49984], [104, 50384], [107, 50724], [115, 52016]]}, {"verse": 8, "start": 52656, "end": 57156, "text": "Oye, pueblo mío, y te advertiré. Israel, si me oyes,", "words": [[0, 52656], [5, 52943], [12, 53123], [17, 53843], [19, 54003], [22, 54103], [33, 55433], [41, 55859], [44, 56139], [47, 56299]]}, {"verse": 9, "start": 57606, "end": 62919, "text": "No habrá en ti dios ajeno, ni te encorvarás a dios extraño.", "words": [[0, 57606], [3, 57756], [9, 58116], [12, 58256], [15, 58416], [20, 58656], [27, 59476], [30, 59736], [33, 60156], [44, 60576], [46, 60676], [51, 60856]]}, {"verse": 10, "start": 63369, "end": 70969, "text": "Yo soy Jehová tu Dios, que te hice subir de la tierra de Egipto: ensancha tu boca, y yo la llenaré.", "words": [[0, 63369], [3, 63559], [7, 63779], [14, 64219], [17, 64339], [23, 65019], [27, 65339], [30, 65499], [35, 65719], [41, 66079], [44, 66359], [47, 66459], [54, 66739], [57, 66979], [65, 68407], [74, 68687], [77, 68847], [83, 69187], [85, 69827], [88, 70007], [91, 70127]]}, {"verse": 11, "start": 71419, "end": 74996, "text": "Pero mi pueblo no oyó mi voz, e Israel no me quiso a mí.", "words": [[0, 71419], [5, 71560], [8, 71720], [15, 72040], [18, 72280], [22, 72520], [25, 72640], [30, 73280], [32, 73360], [39, 73720], [42, 73960], [45, 74080], [51, 74380], [53, 74500]]}, {"verse": 12, "start": 75446, "end": 80702, "text": "Los dejé por tanto a la dureza de su corazón: caminaron en sus consejos.", "words": [[0, 75446], [4, 75589], [9, 75989], [13, 76109], [19, 76489], [21, 76849], [24, 76949], [31, 77349], [34, 77489], [37, 77609], [46, 78819], [56, 79320], [59, 79500], [63, 79620]]}, {"verse": 13, "start": 81152, "end": 86526, "text": "¡Oh, si me hubiera oído mi pueblo, si en mis caminos hubiera Israel andado!", "words": [[0, 81238], [5, 81358], [8, 81618], [11, 81758], [19, 82138], [24, 82438], [27, 82618], [35, 83578], [38, 83898], [41, 83998], [45, 84158], [53, 84698], [61, 85178], [68, 85558]]}, {"verse": 14, "start": 86976, "end": 92414, "text": "En una nada habría yo derribado sus enemigos, y vuelto mi mano sobre sus adversarios.", "words": [[0, 86976], [3, 87115], [7, 87295], [12, 87635], [19, 88015], [22, 88155], [32, 88695], [36, 88875], [46, 89475], [48, 89915], [55, 90295], [58, 90435], [63, 90695], [69, 90995], [73, 91195]]}, {"verse": 15, "start": 92764, "end": 98779, "text": "Los aborrecedores de Jehová se le hubieran sometido; y el tiempo de ellos fuera para siempre.", "words": [[0, 92764], [4, 93245], [18, 93745], [21, 93885], [28, 94325], [31, 94405], [34, 94565], [43, 95005], [53, 96205], [55, 96373], [58, 96533], [65, 96953], [68, 97173], [74, 97453], [80, 97833], [85, 98073]]}, {"verse": 16, "start": 99229, "end": 106181, "text": "Y Dios lo hubiera mantenido de lo mejor del trigo: y de miel de la piedra te hubiera saciado.", "words": [[0, 99229], [2, 99474], [7, 99814], [10, 100294], [18, 100674], [28, 101354], [31, 101514], [34, 101614], [40, 101914], [44, 102114], [51, 103098], [53, 103222], [56, 103322], [61, 103622], [64, 103802], [67, 103922], [74, 104362], [77, 104802], [85, 105242]]}]}