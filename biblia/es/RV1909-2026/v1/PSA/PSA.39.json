{"book": "PSA", "chapter": 39, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 100361, "verses": [{"verse": 1, "start": 300, "end": 13606, "text": "Al Músico principal, a Jedutún: Salmo de David. YO DIJE: Atenderé a mis caminos, para no pecar con mi lengua: guardaré mi boca con freno, en tanto que el impío esté contra mí.", "words": [[0, 300], [3, 446], [10, 946], [21, 1552], [23, 2158], [32, 2921], [38, 3405], [41, 3585], [48, 4546], [51, 4787], [57, 5188], [66, 5848], [68, 5908], [72, 6028], [81, 6608], [86, 7128], [89, 7328], [95, 7868], [99, 8108], [102, 8328], [110, 9154], [119, 9622], [122, 9822], [127, 10082], [131, 10342], [138, 11062], [141, 11362], [147, 11662], [151, 11922], [154, 12262], [160, 12602], [165, 12842], [172, 13182]]}, {"verse": 2, "start": 13956, "end": 19951, "text": "Enmudecí con silencio, me callé aun respecto de lo bueno: y se excitó mi dolor.", "words": [[0, 14302], [9, 14682], [13, 14842], [23, 15482], [26, 15662], [32, 16102], [36, 16542], [45, 16982], [48, 17282], [51, 17422], [58, 18180], [60, 18347], [63, 18467], [70, 19267], [73, 19367]]}, {"verse": 3, "start": 20301, "end": 28396, "text": "Se enardeció mi corazón dentro de mí; en mi meditación se encendió fuego, y así proferí con mi lengua:", "words": [[0, 20301], [3, 20744], [13, 21224], [16, 21384], [24, 21824], [31, 22204], [34, 22524], [38, 22867], [41, 23147], [44, 23327], [55, 24047], [58, 24247], [67, 24847], [74, 25827], [76, 25907], [80, 26087], [88, 26747], [92, 26927], [95, 27107]]}, {"verse": 4, "start": 28746, "end": 36780, "text": "Hazme saber, Jehová, mi fin, y cuánta sea la medida de mis días; sepa yo cuánto tengo de ser del mundo.", "words": [[0, 28746], [6, 29170], [13, 29730], [21, 30290], [24, 30390], [29, 31190], [31, 31270], [38, 31770], [42, 32070], [45, 32290], [52, 32690], [55, 32950], [59, 33110], [65, 34388], [70, 34648], [73, 34768], [80, 35248], [86, 35488], [89, 35668], [93, 35928], [97, 36088]]}, {"verse": 5, "start": 37130, "end": 46992, "text": "He aquí diste a mis días término corto, y mi edad es como nada delante de ti: ciertamente es completa vanidad todo hombre que vive. (Selah.)", "words": [[0, 37130], [3, 37370], [8, 37644], [14, 37917], [16, 38017], [20, 38117], [25, 38337], [33, 38957], [40, 39737], [42, 39937], [45, 40117], [50, 40537], [53, 40737], [58, 40977], [63, 41317], [71, 41857], [74, 42037], [78, 42623], [90, 43367], [93, 43527], [102, 43987], [110, 44507], [115, 44767], [122, 45147], [126, 45367], [132, 46781]]}, {"verse": 6, "start": 46992, "end": 55395, "text": "Ciertamente en tinieblas anda el hombre; ciertamente en vano se afana: amontona riquezas y no sabe quién las recogerá.", "words": [[0, 46992], [12, 47732], [15, 47892], [25, 48552], [30, 48892], [33, 49132], [41, 49859], [53, 50706], [56, 50866], [61, 51166], [64, 51286], [71, 52211], [80, 52662], [89, 53148], [91, 53635], [94, 53795], [99, 54075], [105, 54315], [109, 54535]]}, {"verse": 7, "start": 55745, "end": 59994, "text": "Y ahora, Señor, ¿qué esperaré? Mi esperanza en ti está.", "words": [[0, 55745], [2, 56005], [9, 56245], [16, 57105], [21, 57205], [31, 58367], [34, 58478], [44, 58978], [47, 59178], [50, 59338]]}, {"verse": 8, "start": 60344, "end": 65482, "text": "Líbrame de todas mis rebeliones; no me pongas por burla del insensato.", "words": [[0, 60344], [8, 60880], [11, 61100], [17, 61300], [21, 61640], [33, 62940], [36, 63067], [39, 63207], [46, 63627], [50, 63867], [56, 64247], [60, 64467]]}, {"verse": 9, "start": 65832, "end": 69196, "text": "Enmudecí, no abrí mi boca; porque tú lo hiciste.", "words": [[0, 66189], [10, 66579], [13, 67039], [18, 67359], [21, 67499], [27, 68173], [34, 68357], [37, 68597], [40, 68757]]}, {"verse": 10, "start": 69546, "end": 74159, "text": "Quita de sobre mí tu plaga; de la guerra de tu mano soy consumido.", "words": [[0, 69546], [6, 70240], [9, 70380], [15, 70620], [18, 70860], [21, 71000], [28, 71826], [31, 71951], [34, 72071], [41, 72331], [44, 72551], [47, 72711], [52, 72951], [56, 73211]]}, {"verse": 11, "start": 74509, "end": 84360, "text": "Con castigos sobre el pecado corriges al hombre, y haces consumirse como de polilla su grandeza: ciertamente vanidad es todo hombre. (Selah.)", "words": [[0, 74509], [4, 74825], [13, 75175], [19, 75515], [22, 75715], [29, 76245], [38, 76775], [41, 76955], [49, 77255], [51, 77775], [57, 78075], [68, 78915], [73, 79215], [76, 79395], [84, 79895], [87, 80095], [97, 81135], [109, 81985], [117, 82465], [120, 82685], [125, 82865], [133, 84078]]}, {"verse": 12, "start": 84710, "end": 95798, "text": "Oye mi oración, oh Jehová, y escucha mi clamor: no calles a mis lágrimas; porque forastero soy para ti, y advenedizo, como todos mis padres.", "words": [[0, 84710], [4, 85036], [7, 85196], [16, 85709], [19, 86223], [27, 86736], [29, 87016], [37, 87516], [40, 87862], [48, 88399], [51, 88715], [58, 89065], [60, 89205], [64, 89325], [74, 90503], [81, 91159], [91, 91849], [95, 92109], [100, 92409], [104, 92709], [106, 93209], [118, 94049], [123, 94569], [129, 94889], [133, 95129]]}, {"verse": 13, "start": 96148, "end": 99961, "text": "Déjame, y tomaré fuerzas, antes que vaya y perezca.", "words": [[0, 96148], [8, 96735], [10, 97155], [17, 97535], [26, 98255], [32, 98675], [36, 98915], [41, 99264], [43, 99612]]}]}