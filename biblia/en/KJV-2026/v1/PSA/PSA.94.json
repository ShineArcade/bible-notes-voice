{"book": "PSA", "chapter": 94, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 123942, "verses": [{"verse": 1, "start": 300, "end": 5907, "text": "O LORD God, to whom vengeance belongs; O God, to whom vengeance belongs, show yourself.", "words": [[0, 300], [2, 459], [7, 719], [12, 1219], [15, 1319], [20, 1519], [30, 1959], [39, 3308], [41, 3398], [46, 3838], [49, 3918], [54, 4078], [64, 4438], [73, 5198], [78, 5318]]}, {"verse": 2, "start": 6357, "end": 10475, "text": "Lift up yourself, you judge of the earth: render a reward to the proud.", "words": [[0, 6357], [5, 6523], [8, 6783], [18, 7163], [22, 7403], [28, 7623], [31, 7803], [35, 7923], [42, 8639], [49, 8924], [51, 9124], [58, 9544], [61, 9764], [65, 9864]]}, {"verse": 3, "start": 10925, "end": 15100, "text": "LORD, how long shall the wicked, how long shall the wicked triumph?", "words": [[0, 10925], [6, 11306], [10, 11406], [15, 11806], [21, 12106], [25, 12306], [33, 12946], [37, 13286], [42, 13626], [48, 13906], [52, 14066], [59, 14326]]}, {"verse": 4, "start": 15550, "end": 21540, "text": "How long shall they utter and speak hard things? and all the workers of iniquity boast themselves?", "words": [[0, 15550], [4, 15711], [9, 16011], [15, 16291], [20, 16511], [26, 16771], [30, 17031], [36, 17251], [41, 17671], [49, 18671], [53, 18795], [57, 18935], [61, 19075], [69, 19375], [72, 19675], [81, 20275], [87, 20595]]}, {"verse": 5, "start": 21990, "end": 26247, "text": "They break in pieces your people, O LORD, and afflict your heritage.", "words": [[0, 21990], [5, 22100], [11, 22440], [14, 22720], [21, 23120], [26, 23440], [34, 24080], [36, 24200], [42, 24780], [46, 24900], [54, 25220], [59, 25520]]}, {"verse": 6, "start": 26697, "end": 30271, "text": "They slay the widow and the stranger, and murder the fatherless.", "words": [[0, 26697], [5, 26814], [10, 27194], [14, 27334], [20, 27594], [24, 27934], [28, 28054], [38, 28494], [42, 28994], [49, 29294], [53, 29474]]}, {"verse": 7, "start": 30721, "end": 35152, "text": "Yet they say, The LORD shall not see, neither shall the God of Jacob regard it.", "words": [[0, 30721], [4, 30909], [9, 31109], [14, 31891], [18, 32017], [23, 32177], [29, 32417], [33, 32617], [38, 33217], [46, 33457], [52, 33797], [56, 33957], [60, 34117], [63, 34217], [69, 34477], [76, 34817]]}, {"verse": 8, "start": 35502, "end": 40252, "text": "Understand, you brutish among the people: and you fools, when will you be wise?", "words": [[0, 35502], [12, 36000], [16, 36260], [24, 36780], [30, 36980], [34, 37200], [42, 37981], [46, 38103], [50, 38223], [57, 38943], [62, 39123], [67, 39323], [71, 39443], [74, 39583]]}, {"verse": 9, "start": 40702, "end": 45924, "text": "He that planted the ear, shall he not hear? he that formed the eye, shall he not see?", "words": [[0, 40702], [3, 40847], [8, 41027], [16, 41367], [20, 41587], [25, 42087], [31, 42387], [34, 42567], [38, 42747], [44, 43572], [47, 43680], [52, 43840], [59, 44140], [63, 44320], [68, 44880], [74, 45020], [77, 45180], [81, 45360]]}, {"verse": 10, "start": 46374, "end": 53043, "text": "He that chastises the heathen, shall not he correct? he that teaches man knowledge, shall not he know?", "words": [[0, 46374], [3, 46504], [8, 46664], [18, 47524], [22, 47784], [31, 48344], [37, 48804], [41, 49044], [44, 49224], [53, 50150], [56, 50280], [61, 50460], [69, 50760], [73, 51120], [84, 51840], [90, 52080], [94, 52320], [97, 52540]]}, {"verse": 11, "start": 53493, "end": 56729, "text": "The LORD knows the thoughts of man, that they are vanity.", "words": [[0, 53493], [4, 53599], [9, 53799], [15, 54119], [19, 54399], [28, 54679], [31, 54899], [36, 55279], [41, 55739], [46, 55899], [50, 56039]]}, {"verse": 12, "start": 57179, "end": 61912, "text": "Blessed is the man whom you chasten, O LORD, and teach him out of your law;", "words": [[0, 57179], [8, 57483], [11, 57803], [15, 57983], [19, 58283], [24, 58543], [28, 58743], [37, 59403], [39, 59523], [45, 60243], [49, 60343], [55, 60643], [59, 60863], [63, 61063], [66, 61223], [71, 61343]]}, {"verse": 13, "start": 62362, "end": 67279, "text": "That you may give him rest from the days of adversity, until the pit be dug for the wicked.", "words": [[0, 62362], [5, 62478], [9, 62618], [13, 62798], [18, 63038], [22, 63218], [27, 63598], [32, 63818], [36, 63958], [41, 64238], [44, 64378], [55, 64918], [61, 65618], [65, 65838], [69, 66018], [72, 66178], [76, 66438], [80, 66678], [84, 66798]]}, {"verse": 14, "start": 67729, "end": 72348, "text": "For the LORD will not cast off his people, neither will he forsake his inheritance.", "words": [[0, 67729], [4, 67827], [8, 67927], [13, 68207], [18, 68387], [22, 68567], [27, 68867], [31, 69167], [35, 69347], [43, 70187], [51, 70367], [56, 70687], [59, 70847], [67, 71327], [71, 71467]]}, {"verse": 15, "start": 72798, "end": 77762, "text": "But judgment shall return to righteousness: and all the upright in heart shall follow it.", "words": [[0, 72798], [4, 72903], [13, 73323], [19, 73683], [26, 74163], [29, 74323], [44, 75471], [48, 75593], [52, 75833], [56, 76033], [64, 76373], [67, 76633], [73, 76853], [79, 77113], [86, 77453]]}, {"verse": 16, "start": 78212, "end": 84850, "text": "Who will rise up for me against the evildoers? or who will stand up for me against the workers of iniquity?", "words": [[0, 78212], [4, 78329], [9, 78529], [14, 78829], [17, 79109], [21, 79309], [24, 79469], [32, 79769], [36, 80009], [47, 81194], [50, 81484], [54, 81724], [59, 81884], [65, 82224], [68, 82504], [72, 82704], [75, 82884], [83, 83224], [87, 83524], [95, 83884], [98, 84164]]}, {"verse": 17, "start": 85300, "end": 90168, "text": "Unless the LORD had been my help, my soul had almost dwelt in silence.", "words": [[0, 85300], [7, 85586], [11, 85806], [16, 86086], [20, 86306], [25, 86506], [28, 86726], [34, 87466], [37, 87626], [42, 87966], [46, 88186], [53, 88546], [59, 89086], [62, 89286]]}, {"verse": 18, "start": 90618, "end": 94694, "text": "When I said, My foot