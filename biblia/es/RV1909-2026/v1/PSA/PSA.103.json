{"book": "PSA", "chapter": 103, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 147456, "verses": [{"verse": 1, "start": 300, "end": 7583, "text": "Salmo de David. BENDICE, alma mía, a Jehová; y bendigan todas mis entrañas su santo nombre.", "words": [[0, 300], [6, 804], [9, 964], [16, 1733], [25, 2338], [30, 2658], [35, 3138], [37, 3358], [45, 4177], [47, 4521], [56, 4901], [62, 5221], [66, 5541], [75, 6221], [78, 6441], [84, 6941]]}, {"verse": 2, "start": 8033, "end": 13179, "text": "Bendice, alma mía a Jehová, y no olvides ninguno de sus beneficios.", "words": [[0, 8033], [9, 8511], [14, 9025], [18, 9538], [20, 9758], [28, 10358], [30, 10698], [33, 10918], [41, 11358], [49, 11938], [52, 12058], [56, 12218]]}, {"verse": 3, "start": 13629, "end": 19294, "text": "Él es quien perdona todas tus iniquidades, el que sana todas tus dolencias;", "words": [[0, 13629], [3, 13837], [6, 13997], [12, 14157], [20, 14817], [26, 15157], [30, 15537], [43, 16577], [46, 16937], [50, 17097], [55, 17377], [61, 17737], [65, 18157]]}, {"verse": 4, "start": 19744, "end": 24799, "text": "El que rescata del hoyo tu vida, el que te corona de favores y misericordias;", "words": [[0, 19744], [3, 19883], [7, 20223], [15, 20563], [19, 20763], [24, 21103], [27, 21223], [33, 21863], [36, 22143], [40, 22263], [43, 22403], [50, 22743], [53, 22963], [61, 23483], [63, 23643]]}, {"verse": 5, "start": 25249, "end": 29913, "text": "El que sacia de bien tu boca de modo que te rejuvenezcas como el águila.", "words": [[0, 25249], [3, 25390], [7, 25720], [13, 26050], [16, 26230], [21, 26430], [24, 26690], [29, 26970], [32, 27150], [37, 27390], [41, 27590], [44, 27750], [57, 28750], [62, 29090], [65, 29310]]}, {"verse": 6, "start": 30363, "end": 35851, "text": "Jehová el que hace justicia y derecho a todos los que padecen violencia.", "words": [[0, 30363], [7, 30812], [10, 31282], [14, 31582], [19, 31882], [28, 32702], [30, 32802], [38, 33202], [40, 33402], [46, 33622], [50, 33922], [54, 34142], [62, 34722]]}, {"verse": 7, "start": 36301, "end": 40784, "text": "Sus caminos notificó a Moisés, y a los hijos de Israel sus obras.", "words": [[0, 36301], [4, 36428], [12, 36868], [21, 37548], [23, 37648], [31, 38068], [33, 38788], [35, 38868], [39, 38988], [45, 39268], [48, 39448], [55, 39868], [59, 40108]]}, {"verse": 8, "start": 41234, "end": 47948, "text": "Misericordioso y clemente es Jehová; lento para la ira, y grande en misericordia.", "words": [[0, 41640], [15, 42080], [17, 42400], [26, 42720], [29, 42980], [37, 43947], [43, 44395], [48, 44635], [51, 44835], [56, 45595], [58, 45875], [65, 46355], [68, 46795]]}, {"verse": 9, "start": 48398, "end": 52697, "text": "No contenderá para siempre, ni para siempre guardará el enojo.", "words": [[0, 48398], [3, 48607], [14, 49367], [19, 49527], [28, 50057], [31, 50587], [36, 50827], [44, 51227], [53, 51907], [56, 52107]]}, {"verse": 10, "start": 53147, "end": 60752, "text": "No ha hecho con nosotros conforme a nuestras iniquidades; ni nos ha pagado conforme a nuestros pecados.", "words": [[0, 53147], [3, 53549], [6, 53729], [12, 53949], [16, 54209], [25, 54609], [34, 55469], [36, 55589], [45, 55849], [58, 57829], [61, 58077], [65, 58325], [68, 58573], [75, 58821], [84, 59561], [86, 59621], [95, 59801]]}, {"verse": 11, "start": 61202, "end": 68811, "text": "Porque como la altura de los cielos sobre la tierra, engrandeció su misericordia sobre los que le temen.", "words": [[0, 61202], [7, 61448], [12, 61808], [15, 62068], [22, 62708], [25, 63048], [29, 63188], [36, 63848], [42, 64148], [45, 64368], [53, 64808], [65, 66268], [68, 66488], [81, 67408], [87, 67688], [91, 67928], [95, 68068], [98, 68188]]}, {"verse": 12, "start": 69261, "end": 75901, "text": "Cuanto está lejos el oriente del occidente, hizo alejar de nosotros nuestras rebeliones.", "words": [[0, 69261], [7, 69425], [12, 69685], [18, 70145], [21, 70345], [29, 70845], [33, 71105], [44, 71885], [49, 72535], [56, 73185], [59, 73325], [68, 73825], [77, 74465]]}, {"verse": 13, "start": 76351, "end": 81530, "text": "Como el padre se compadece de los hijos, se compadece Jehová de los que le temen.", "words": [[0, 76351], [5, 76535], [8, 76695], [14, 77115], [17, 77395], [27, 78095], [30, 78315], [34, 78455], [41, 79195], [44, 79455], [54, 80015], [61, 80515], [64, 80635], [68, 80735], [72, 80855], [75, 80975]]}, {"verse": 14, "start": 81980, "end": 86980, "text": "Porque él conoce nuestra condición; se acuerda de que somos polvo.", "words": [[0, 81980], [7, 82244], [10, 82644], [17, 83224], [25, 83404], [36, 84834], [39, 85084], [47, 85564], [50, 85724], [54, 85804], [60, 86064]]}, {"verse": 15, "start": 87430, "end": 92093, "text": "El hombre, como la hierba son sus días: florece como la flor del campo.", "words": [[0, 87430], [3, 87549], [11, 87809], [16, 88089], [19, 88269], [26, 88669], [30, 88889], [34, 89109], [40, 90105], [48, 90551], [53, 90791], [56, 90951], [61, 91151], [65, 91351]]}, {"verse": 16, "start": 92543, "end": 97614, "text": "Que pasó el viento por ella, y pereció: y su lugar no la conoce más.", "words": [[0, 92543], [4, 92627], [9, 92867], [12, 93107], [19, 93427], [23, 93687], [29, 93907], [31, 94527], [40, 95535], [42, 95654], [45, 95754], [51, 96134], [54, 96494], [57, 96614], [64, 97074]]}, {"verse": 17, "start": 98064, "end": 106956, "text": "Mas la misericordia de Jehová desde el siglo y hasta el siglo sobre los que le temen, y su justicia sobre los hijos de los hijos;", "words": [[0, 98064], [4, 98251], [7, 98351], [20, 99171], [23, 99311], [30, 99751], [36, 99951], [39, 100231], [45, 100611], [47, 101191], [53, 101411], [56, 101651], [62, 102151], [68, 102931], [72, 103131], [76, 103271], [79, 103411], [86, 104091], [88, 104391], [91, 104551], [100, 105151], [106, 105451], [110, 105671], [116, 105991], [119, 106151], [123, 106311]]}, {"verse": 18, "start": 107406, "end": 113908, "text": "Sobre los que guardan su pacto, y los que se acuerdan de sus mandamientos para ponerlos por obra.", "words": [[0, 107406], [6, 107805], [10, 108005], [14, 108205], [22, 108725], [25, 108925], [32, 109885], [34, 110005], [38, 110145], [42, 110305], [45, 110445], [54, 111025], [57, 111165], [61, 111365], [74, 112165], [79, 112485], [88, 113105], [92, 113365]]}, {"verse": 19, "start": 114358, "end": 120384, "text": "Jehová afirmó en los cielos su trono; y su reino domina sobre todos.", "words": [[0, 114358], [7, 114862], [14, 115422], [17, 115502], [21, 115622], [28, 116282], [31, 116602], [38, 117586], [40, 117886], [43, 118026], [49, 118686], [56, 119446], [62, 119666]]}, {"verse": 20, "start": 120834, "end": 129778, "text": "Bendecid a Jehová, vosotros sus ángeles, poderosos en fortaleza, que ejecutáis su palabra, obedeciendo a la voz de su precepto.", "words": [[0, 120834], [9, 121457], [11, 121617], [19, 122017], [28, 122477], [32, 122937], [41, 123397], [51, 124017], [54, 124237], [65, 124977], [69, 125377], [79, 126057], [82, 126277], [91, 127017], [103, 127977], [105, 128317], [108, 128397], [112, 128637], [115, 128777], [118, 128937]]}, {"verse": 21, "start": 130228, "end": 137228, "text": "Bendecid a Jehová, vosotros todos sus ejércitos, ministros suyos, que hacéis su voluntad.", "words": [[0, 130521], [9, 130851], [11, 131071], [19, 131531], [28, 132011], [34, 132331], [38, 132711], [49, 133731], [59, 134511], [66, 135551], [70, 135651], [77, 136171], [80, 136431]]}, {"verse": 22, "start": 137678, "end": 147056, "text": "Bendecid a Jehová, vosotras todas sus obras, en todos los lugares de su señorío. Bendice, alma mía, a Jehová.", "words": [[0, 137678], [9, 138380], [11, 138640], [19, 139140], [28, 139880], [34, 140200], [38, 140540], [45, 140980], [48, 141760], [54, 142120], [58, 142460], [66, 142840], [69, 143100], [72, 143260], [81, 144269], [90, 145144], [95, 145564], [100, 146124], [102, 146424]]}]}