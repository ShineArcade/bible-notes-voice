{"book": "ISA", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 316715, "verses": [{"verse": 1, "start": 300, "end": 6184, "text": "¡Ay de los que establecen leyes injustas, y determinando prescriben tiranía,", "words": [[0, 458], [4, 658], [7, 1138], [11, 1278], [15, 1398], [26, 1998], [32, 2358], [42, 3538], [44, 3798], [57, 4678], [68, 5338]]}, {"verse": 2, "start": 6634, "end": 16429, "text": "Por apartar del juicio a los pobres, y por quitar el derecho a los afligidos de mi pueblo; por despojar las viudas, y robar los huérfanos!", "words": [[0, 6634], [4, 6776], [12, 7356], [16, 7516], [23, 8076], [25, 8236], [29, 8356], [37, 8956], [39, 9416], [43, 9596], [50, 9996], [53, 10156], [61, 10496], [63, 10656], [67, 10776], [77, 11416], [80, 11576], [83, 11696], [91, 12652], [95, 12816], [104, 13476], [108, 13676], [116, 14396], [118, 14796], [124, 15276], [128, 15416]]}, {"verse": 3, "start": 16879, "end": 27510, "text": "¿Y qué haréis en el día del castigo? ¿y a quién os acogeréis que os ayude, cuando venga de lejos el asolamiento? ¿y en dónde dejaréis vuestra gloria?", "words": [[0, 16879], [3, 17163], [7, 17343], [14, 18003], [17, 18263], [20, 18443], [24, 18683], [28, 18863], [37, 20095], [40, 20355], [42, 20495], [48, 20655], [51, 20915], [61, 21635], [65, 21795], [68, 21975], [75, 22515], [82, 22875], [88, 23315], [91, 23435], [97, 23775], [100, 23975], [113, 25240], [116, 25383], [119, 25543], [125, 25763], [134, 26443], [142, 26823]]}, {"verse": 4, "start": 27960, "end": 38569, "text": "Sin mí se inclinarán entre los presos, y entre los muertos caerán. Ni con todo esto ha cesado su furor, antes todavía extendida su mano.", "words": [[0, 27960], [4, 28164], [7, 28504], [10, 28664], [21, 29484], [27, 29724], [31, 29904], [39, 30784], [41, 31024], [47, 31224], [51, 31444], [59, 31924], [67, 33061], [70, 33187], [74, 33427], [79, 33647], [84, 33967], [87, 34207], [94, 34668], [97, 34848], [104, 35768], [110, 36168], [118, 36727], [128, 37848], [131, 38047]]}, {"verse": 5, "start": 39019, "end": 43744, "text": "Oh Assur, vara y bastón de mi furor: en su mano he puesto mi ira.", "words": [[0, 39258], [3, 39528], [10, 39798], [15, 40068], [17, 40188], [24, 40648], [27, 40768], [30, 40908], [37, 41775], [40, 41953], [43, 42133], [48, 42453], [51, 42633], [58, 42953], [61, 43253]]}, {"verse": 6, "start": 44194, "end": 57236, "text": "Le mandaré contra una nación pérfida, y sobre el pueblo de mi ira le enviaré, para que quite despojos, y arrebate presa, y que lo ponga a ser pisoteado como lodo de las calles.", "words": [[0, 44194], [3, 44331], [11, 44831], [18, 45131], [22, 45431], [29, 45871], [38, 46651], [40, 47311], [46, 47591], [49, 47811], [56, 48211], [59, 48404], [62, 48598], [66, 48791], [69, 49051], [78, 49671], [83, 49911], [87, 50431], [93, 50951], [103, 51471], [105, 51911], [114, 52351], [121, 53535], [123, 53643], [127, 53743], [130, 53903], [136, 54303], [138, 54383], [142, 54583], [152, 55583], [157, 55883], [162, 56243], [165, 56383], [169, 56543]]}, {"verse": 7, "start": 57686, "end": 67591, "text": "Aunque él no lo pensará así, ni su corazón lo imaginará de esta manera; sino que su pensamiento será desarraigar y cortar naciones no pocas.", "words": [[0, 57686], [7, 57915], [10, 58135], [13, 58295], [16, 58415], [24, 59035], [29, 59675], [32, 59875], [35, 60015], [43, 60515], [46, 61055], [56, 61795], [59, 61875], [64, 62115], [72, 62989], [77, 63194], [81, 63354], [84, 63514], [96, 64274], [101, 64924], [113, 65574], [115, 65674], [122, 66074], [131, 66774], [134, 67209]]}, {"verse": 8, "start": 68041, "end": 71114, "text": "Porque él dice: Mis príncipes ¿no son todos reyes?", "words": [[0, 68041], [7, 68265], [10, 68465], [16, 69162], [20, 69263], [30, 69863], [34, 70023], [38, 70223], [44, 70423]]}, {"verse": 9, "start": 71564, "end": 76047, "text": "¿No es Calno como Carquemis, Hamat como Arfad, y Samaria como Damasco?", "words": [[0, 71564], [4, 71727], [7, 71927], [13, 72247], [18, 72447], [29, 73127], [35, 73807], [40, 74127], [47, 74447], [49, 74767], [57, 75207], [62, 75427]]}, {"verse": 10, "start": 76497, "end": 82103, "text": "Como halló mi mano los reinos de los ídolos, siendo sus imágenes más que Jerusalén y Samaria;", "words": [[0, 76497], [5, 76678], [11, 76958], [14, 77078], [19, 77338], [23, 77558], [30, 77978], [33, 78098], [37, 78258], [45, 79158], [52, 79478], [56, 79778], [65, 80278], [69, 80598], [73, 80798], [83, 81418], [85, 81518]]}, {"verse": 11, "start": 82553, "end": 88168, "text": "Como hice a Samaria y a sus ídolos, ¿no haré también así a Jerusalén y a sus ídolos?", "words": [[0, 82553], [5, 82737], [10, 83037], [12, 83197], [20, 83677], [22, 83837], [24, 83897], [28, 84057], [36, 85017], [40, 85217], [45, 85457], [53, 85697], [57, 86137], [59, 86277], [69, 87037], [71, 87177], [73, 87237], [77, 87397]]}, {"verse": 12, "start": 88518, "end": 102852, "text": "Pero acontecerá que después que el Señor haya acabado toda su obra en el monte de Sion, y en Jerusalén, castigará el fruto de la soberbia del corazón del rey de Asiria, y la gloria de la altivez de sus ojos.", "words": [[0, 88518], [5, 88682], [16, 89462], [20, 89602], [28, 89882], [32, 90142], [35, 90282], [41, 90562], [46, 90962], [54, 91602], [59, 91802], [62, 92102], [67, 92422], [70, 92602], [73, 92742], [79, 93042], [82, 93282], [88, 93722], [90, 94302], [93, 94442], [104, 95640], [114, 96263], [117, 96423], [123, 96843], [126, 96983], [129, 97103], [138, 97703], [142, 97923], [150, 98463], [154, 98843], [158, 99263], [161, 99633], [169, 100003], [171, 100383], [174, 100543], [181, 100963], [184, 101123], [187, 101493], [195, 101863], [198, 102023], [202, 102163]]}, {"verse": 13, "start": 103302, "end": 117831, "text": "Porque dijo: Con la fortaleza de mi mano lo he hecho, y con mi sabiduría; porque he sido prudente: y quité los términos de los pueblos, y saqueé sus tesoros, y derribé como valientes los que estaban sentados:", "words": [[0, 103417], [7, 103567], [13, 104327], [17, 104427], [20, 104567], [30, 105247], [33, 105367], [36, 105467], [41, 105747], [44, 105947], [47, 106127], [54, 106487], [56, 106807], [60, 107007], [63, 107167], [74, 108233], [81, 108481], [84, 108661], [89, 108841], [99, 111280], [101, 111398], [107, 111678], [111, 111858], [120, 112438], [123, 112518], [127, 112658], [136, 113298], [138, 113638], [145, 113978], [149, 114178], [158, 114858], [160, 115118], [168, 115378], [173, 115658], [183, 116238], [187, 116518], [191, 116698], [199, 116998]]}, {"verse": 14, "start": 118281, "end": 129821, "text": "Y halló mi mano como nido las riquezas de los pueblos; y como se recogen los huevos dejados, así me apoderé yo de toda la tierra; y no hubo quien moviese ala, o abriese boca y graznase.", "words": [[0, 118281], [2, 118383], [8, 118623], [11, 118743], [16, 118983], [21, 119243], [26, 119543], [30, 119703], [39, 120183], [42, 120343], [46, 120463], [55, 121501], [57, 121587], [62, 121767], [65, 121927], [73, 122407], [77, 122587], [84, 123007], [93, 123807], [97, 124107], [100, 124307], [108, 124727], [111, 124927], [114, 125067], [119, 125267], [122, 125467], [130, 126335], [132, 126436], [135, 126556], [140, 126796], [146, 126936], [154, 127396], [159, 127936], [161, 128156], [169, 128536], [174, 128856], [176, 129361]]}, {"verse": 15, "start": 130171, "end": 145190, "text": "¿Se gloriará el hacha contra el que con ella corta? ¿se ensoberbecerá la sierra contra el que la mueve? como si el bastón se levantase contra los que lo levantan; como si se levantase la vara: ¿no es leño?", "words": [[0, 130171], [4, 130396], [13, 131176], [16, 131356], [22, 131776], [29, 132156], [32, 132376], [36, 132516], [40, 132776], [45, 132956], [52, 134452], [56, 134926], [70, 135399], [73, 135519], [80, 135999], [87, 136399], [90, 136659], [94, 136799], [97, 136959], [104, 137864], [109, 138030], [112, 138230], [115, 138350], [122, 138870], [125, 139010], [135, 139650], [142, 139970], [146, 140190], [150, 140350], [153, 140450], [163, 141581], [168, 141848], [171, 142148], [174, 142368], [184, 143068], [187, 143268], [193, 144087], [197, 144367], [200, 144507]]}, {"verse": 16, "start": 145640, "end": 156234, "text": "Por tanto el Señor Jehová de los ejércitos enviará debilidad sobre sus gordos; y debajo de su gloria encenderá incendio, como ardor de fuego.", "words": [[0, 145640], [4, 145745], [10, 146145], [13, 146205], [19, 146525], [26, 147165], [29, 147245], [33, 147385], [43, 148165], [51, 149105], [61, 149765], [67, 150125], [71, 150345], [79, 151449], [81, 151575], [88, 152015], [91, 152175], [94, 152335], [101, 152755], [111, 153435], [121, 154375], [126, 154975], [132, 155495], [135, 155635]]}, {"verse": 17, "start": 156684, "end": 165348, "text": "Y la luz de Israel será por fuego, y su Santo por llama que abrase y consuma en un día sus cardos y sus espinas.", "words": [[0, 156684], [2, 156811], [5, 156951], [9, 157231], [12, 157431], [19, 157911], [24, 158251], [28, 158531], [35, 159071], [37, 159771], [40, 159911], [46, 160351], [50, 160671], [56, 160891], [60, 161271], [67, 161651], [69, 161831], [77, 162451], [80, 162531], [83, 162671], [87, 163011], [91, 163571], [98, 164171], [100, 164291], [104, 164511]]}, {"verse": 18, "start": 165798, "end": 175374, "text": "La gloria de su bosque y de su campo fértil consumirá, desde el alma hasta la carne: y vendrá a ser como abanderado en derrota.", "words": [[0, 165798], [3, 165917], [10, 166317], [13, 166477], [16, 166617], [23, 167197], [25, 167357], [28, 167497], [31, 167637], [37, 167977], [44, 168657], [55, 169737], [61, 170257], [64, 170597], [69, 170917], [75, 171417], [78, 171617], [85, 172514], [87, 172620], [94, 173060], [96, 173280], [100, 173520], [105, 173800], [116, 174520], [119, 174660]]}, {"verse": 19, "start": 175824, "end": 180805, "text": "Y los árboles que queden en su bosque, serán en número que un niño los pueda contar.", "words": [[0, 175824], [2, 175930], [6, 176070], [14, 176570], [18, 176830], [25, 177190], [28, 177350], [31, 177530], [39, 177990], [45, 178250], [48, 178510], [55, 178810], [59, 179110], [62, 179270], [67, 179650], [71, 179830], [77, 180130]]}, {"verse": 20, "start": 181255, "end": 197755, "text": "Y acontecerá en aquel tiempo, que los que hayan quedado de Israel y los que hayan quedado de la casa de Jacob, nunca más estriben sobre el que los hirió; sino que se apoyarán con verdad en Jehová Santo de Israel.", "words": [[0, 181255], [2, 181399], [13, 182299], [16, 182419], [22, 182739], [30, 183219], [34, 184119], [38, 184279], [42, 184499], [48, 184899], [56, 185399], [59, 185579], [66, 186039], [68, 186699], [72, 186819], [76, 186999], [82, 187379], [90, 187819], [93, 187939], [96, 188039], [101, 188259], [104, 188459], [111, 188839], [117, 189599], [121, 190229], [130, 190859], [136, 191319], [139, 191559], [143, 191739], [147, 191959], [154, 193572], [159, 193923], [163, 194183], [166, 194363], [175, 195103], [179, 195263], [186, 195683], [189, 195923], [196, 196363], [202, 196663], [205, 196983]]}, {"verse": 21, "start": 198205, "end": 202984, "text": "Las reliquias se convertirán, las reliquias de Jacob, al Dios fuerte.", "words": [[0, 198205], [4, 198369], [14, 199089], [17, 199209], [30, 200009], [34, 200209], [44, 200849], [47, 200969], [54, 201349], [57, 201989], [62, 202209]]}, {"verse": 22, "start": 203434, "end": 214376, "text": "Porque si tu pueblo, oh Israel, es como las arenas del mar, las reliquias de él se convertirán: la destrucción decretada será abrumadora y justa.", "words": [[0, 203434], [7, 203638], [10, 203858], [13, 204038], [21, 204438], [24, 204838], [32, 205418], [35, 206038], [40, 206238], [44, 206438], [51, 206918], [55, 207098], [60, 207898], [64, 208298], [74, 208698], [77, 208878], [80, 209058], [83, 209178], [96, 210543], [99, 210824], [111, 211604], [121, 212384], [126, 212664], [137, 213544], [139, 213764]]}, {"verse": 23, "start": 214826, "end": 220975, "text": "Pues el Señor Jehová de los ejércitos hará consumación y fenecimiento en medio de la tierra.", "words": [[0, 214826], [5, 214950], [8, 215170], [14, 215450], [21, 215970], [24, 216070], [28, 216190], [38, 216990], [43, 217770], [55, 218550], [57, 218810], [70, 219610], [73, 219750], [79, 220030], [82, 220210], [85, 220350]]}, {"verse": 24, "start": 221425, "end": 235358, "text": "Por tanto el Señor Jehová de los ejércitos dice así: Pueblo mío, habitante de Sion, no temas de Assur. Con vara te herirá, y contra ti alzará su palo, a la manera de Egipto:", "words": [[0, 221425], [4, 221528], [10, 222228], [13, 222348], [19, 222668], [26, 223268], [29, 223368], [33, 223508], [43, 224308], [48, 224688], [53, 225575], [60, 225815], [65, 226695], [75, 227255], [78, 227415], [84, 228395], [87, 228515], [93, 228875], [96, 229270], [103, 230207], [107, 230348], [112, 230708], [115, 230928], [123, 231408], [125, 231748], [132, 232108], [135, 232408], [142, 233028], [145, 233188], [151, 233748], [153, 234028], [156, 234128], [163, 234488], [166, 234708]]}, {"verse": 25, "start": 236046, "end": 242083, "text": "Mas de aquí a muy poco tiempo, se acabará el furor y mi enojo, para fenecimiento de ellos.", "words": [[0, 236046], [4, 236223], [7, 236403], [12, 236663], [14, 236943], [18, 237083], [23, 237323], [31, 238243], [34, 238343], [42, 238803], [45, 239003], [51, 239443], [53, 239603], [56, 239723], [63, 240143], [68, 240743], [81, 241343], [84, 241543]]}, {"verse": 26, "start": 242662, "end": 255620, "text": "Y levantará Jehová de los ejércitos azote contra él, cual la matanza de Madián en la peña de Oreb: y alzará su vara sobre el mar, según hizo por la vía de Egipto.", "words": [[0, 242662], [2, 242789], [12, 243369], [19, 243889], [22, 243969], [26, 244089], [36, 244829], [42, 245329], [49, 245689], [53, 246089], [58, 246749], [61, 246989], [69, 247509], [72, 247869], [79, 248229], [82, 248709], [85, 248849], [90, 249209], [93, 249349], [99, 250078], [101, 250515], [108, 250995], [111, 251215], [116, 251495], [122, 251902], [125, 252308], [130, 252715], [136, 253115], [141, 254075], [145, 254255], [148, 254435], [152, 254715], [155, 254875]]}, {"verse": 27, "start": 256070, "end": 266776, "text": "Y acaecerá en aquel tiempo, que su carga será quitada de tu hombro, y su yugo de tu cerviz, y el yugo se pudrirá por causa de la unción.", "words": [[0, 256070], [2, 256198], [11, 257018], [14, 257138], [20, 257498], [28, 257878], [32, 258178], [35, 258358], [41, 258758], [46, 259118], [54, 259718], [57, 259938], [60, 260118], [68, 260958], [70, 261178], [73, 261358], [78, 261878], [81, 262038], [84, 262338], [92, 262638], [94, 263278], [97, 263438], [102, 264018], [105, 264518], [113, 265018], [117, 265278], [123, 265638], [126, 265918], [129, 266018]]}, {"verse": 28, "start": 267226, "end": 272657, "text": "Vino hasta Ajat, pasó hasta Migrón; en Micmas contará su ejército:", "words": [[0, 267226], [5, 267534], [11, 267774], [17, 268694], [22, 268954], [28, 269456], [36, 270206], [39, 270683], [46, 271193], [54, 271693], [57, 271813]]}, {"verse": 29, "start": 273107, "end": 279148, "text": "Pasaron el vado; alojaron en Geba: Ramá tembló; Gabaa de Saúl huyó.", "words": [[0, 273107], [8, 273473], [11, 273693], [17, 274488], [26, 275031], [29, 275420], [35, 276389], [40, 276775], [48, 277620], [54, 277870], [57, 277990], [62, 278569]]}, {"verse": 30, "start": 279598, "end": 285740, "text": "Grita en alta voz, hija de Galim; haz que se oiga hacia Lais, pobrecilla Anatot.", "words": [[0, 279598], [6, 280138], [9, 280278], [14, 280478], [19, 281038], [24, 281298], [27, 281398], [34, 282354], [38, 282454], [42, 282554], [45, 282694], [50, 282994], [56, 283624], [62, 284254], [73, 284994]]}, {"verse": 31, "start": 286190, "end": 290654, "text": "Madmena se alborotó: los habitantes de Gebim se juntarán.", "words": [[0, 286599], [8, 287044], [11, 287489], [21, 288221], [25, 288327], [36, 288947], [39, 289247], [45, 289547], [48, 289727]]}, {"verse": 32, "start": 291104, "end": 298771, "text": "Aún vendrá día cuando reposará en Nob: alzará su mano al monte de la hija de Sion, al collado de Jerusalén.", "words": [[0, 291104], [4, 291424], [11, 291904], [15, 292144], [22, 292674], [31, 293204], [34, 293324], [39, 294342], [46, 294622], [49, 294769], [54, 294915], [57, 295062], [63, 295582], [66, 295742], [69, 295842], [74, 296202], [77, 296282], [83, 296702], [86, 297182], [94, 297702], [97, 297862]]}, {"verse": 33, "start": 299221, "end": 310397, "text": "He aquí el Señor Jehová de los ejércitos desgajará el ramo con fortaleza: y los de grande altura serán cortados, y los altos serán humillados.", "words": [[0, 299272], [3, 299362], [8, 299642], [11, 299882], [17, 300222], [24, 300842], [27, 300942], [31, 301102], [41, 301922], [51, 303102], [54, 303422], [59, 303882], [63, 304062], [74, 305440], [76, 305546], [80, 305666], [83, 305826], [90, 306046], [97, 306566], [103, 307026], [113, 307906], [115, 308366], [119, 308526], [125, 309006], [131, 309406]]}, {"verse": 34, "start": 310847, "end": 316315, "text": "Y cortará con hierro la espesura del bosque, y el Líbano caerá con fortaleza.", "words": [[0, 310847], [2, 310953], [10, 311433], [14, 311633], [21, 312213], [24, 312373], [33, 313013], [37, 313193], [45, 313853], [47, 314173], [50, 314313], [57, 314833], [63, 315213], [67, 315353]]}]}