{"book": "PSA", "chapter": 17, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 102869, "verses": [{"verse": 1, "start": 300, "end": 6060, "text": "Hear the right, O LORD, attend to my cry, give ear to my prayer, that goes not out of feigned lips.", "words": [[0, 300], [5, 440], [9, 640], [16, 1020], [18, 1100], [24, 1620], [31, 1880], [34, 2140], [37, 2260], [42, 2900], [47, 3040], [51, 3300], [54, 3500], [57, 3680], [65, 4160], [70, 4260], [75, 4480], [79, 4780], [83, 5060], [86, 5180], [94, 5580]]}, {"verse": 2, "start": 6510, "end": 11911, "text": "Let my sentence come forth from your presence; let your eyes behold the things that are equal.", "words": [[0, 6510], [4, 6636], [7, 6816], [16, 7196], [21, 7556], [27, 7856], [32, 8096], [37, 8236], [47, 9195], [51, 9322], [56, 9542], [61, 9882], [68, 10402], [72, 10702], [79, 11002], [84, 11242], [88, 11362]]}, {"verse": 3, "start": 12361, "end": 22234, "text": "You have proved my heart; you have visited me in the night; you have tried me, and shall find nothing; I am purposed that my mouth shall not transgress.", "words": [[0, 12361], [4, 12485], [9, 12665], [16, 13045], [19, 13405], [26, 14199], [30, 14338], [35, 14498], [43, 14878], [46, 15218], [49, 15398], [53, 15478], [60, 16229], [64, 16354], [69, 16494], [75, 16854], [79, 17114], [83, 17434], [89, 17654], [94, 17994], [103, 18953], [105, 19165], [108, 19285], [117, 19845], [122, 20025], [125, 20245], [131, 20605], [137, 20865], [141, 21145]]}, {"verse": 4, "start": 22684, "end": 27967, "text": "Concerning the works of men, by the word of your lips I have kept me from the paths of the destroyer.", "words": [[0, 22684], [11, 23166], [15, 23286], [21, 23526], [24, 23746], [29, 24046], [32, 24426], [36, 24566], [41, 24786], [44, 24926], [49, 25066], [54, 25546], [56, 25686], [61, 25826], [66, 26046], [69, 26246], [74, 26426], [78, 26546], [84, 26906], [87, 27106], [91, 27226]]}, {"verse": 5, "start": 28417, "end": 32321, "text":