{"book": "PSA", "chapter": 132, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 93031, "verses": [{"verse": 1, "start": 300, "end": 3379, "text": "LORD, remember David, and all his afflictions:", "words": [[0, 300], [6, 547], [15, 907], [22, 1787], [26, 1947], [30, 2267], [34, 2467]]}, {"verse": 2, "start": 3829, "end": 7550, "text": "How he swore to the LORD, and vowed to the mighty God of Jacob;", "words": [[0, 3829], [4, 4036], [7, 4196], [13, 4596], [16, 4736], [20, 4876], [26, 5196], [30, 5636], [36, 6016], [39, 6116], [43, 6216], [50, 6496], [54, 6836], [57, 6976]]}, {"verse": 3, "start": 7850, "end": 12928, "text": "Surely I will not come into the tabernacle of my house, nor go up into my bed;", "words": [[0, 7850], [7, 8145], [9, 8485], [14, 8665], [18, 8945], [23, 9285], [28, 9645], [32, 9805], [43, 10485], [46, 10625], [49, 10785], [56, 11165], [60, 11645], [63, 11925], [66, 12145], [71, 12345], [74, 12525]]}, {"verse": 4, "start": 13378, "end": 16727, "text": "I will not give sleep to my eyes, or slumber to my eyelids,", "words": [[0, 13378], [2, 13499], [7, 13659], [11, 13859], [16, 14099], [22, 14399], [25, 14579], [28, 14739], [34, 15059], [37, 15339], [45, 15779], [48, 15959], [51, 16119]]}, {"verse": 5, "start": 17177, "end": 21925, "text": "Until I find out a place for the LORD, a habitation for the mighty God of Jacob.", "words": [[0, 17177], [6, 17489], [8, 17709], [13, 18029], [17, 18249], [19, 18409], [25, 18649], [29, 18869], [33, 18989], [39, 19629], [41, 19729], [52, 20229], [56, 20589], [60, 20709], [67, 21009], [71, 21329], [74, 21449]]}, {"verse": 6, "start": 22275, "end": 26302, "text": "Lo, we heard of it at Ephratah: we found it in the fields of the wood.", "words": [[0, 22275], [4, 22603], [7, 22703], [13, 22903], [16, 23043], [19, 23143], [22, 23634], [32, 24362], [35, 24469], [41, 24729], [44, 24909], [47, 25049], [51, 25149], [58, 25489], [61, 25729], [65, 25869]]}, {"verse": 7, "start": 26752, "en