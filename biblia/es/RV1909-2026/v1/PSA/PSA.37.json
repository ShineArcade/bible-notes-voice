{"book": "PSA", "chapter": 37, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 265801, "verses": [{"verse": 1, "start": 300, "end": 8019, "text": "Salmo de David. NO te impacientes a causa de los malignos, ni tengas envidia de los que hacen iniquidad.", "words": [[0, 300], [6, 744], [9, 904], [16, 1948], [19, 2096], [22, 2276], [34, 2936], [36, 3196], [42, 3476], [45, 3696], [49, 3836], [59, 4916], [62, 5236], [69, 5676], [77, 6336], [80, 6456], [84, 6616], [88, 6776], [94, 7076]]}, {"verse": 2, "start": 8469, "end": 13381, "text": "Porque como hierba serán pronto cortados, y decaerán como verdor de renuevo.", "words": [[0, 8469], [7, 8693], [12, 9083], [19, 9473], [25, 9813], [32, 10153], [42, 10973], [44, 11293], [53, 11873], [58, 12243], [65, 12613], [68, 12733]]}, {"verse": 3, "start": 13831, "end": 19956, "text": "Espera en Jehová, y haz bien; vivirás en la tierra, y en verdad serás alimentado.", "words": [[0, 13831], [7, 14470], [10, 14590], [18, 15010], [20, 15190], [24, 15350], [30, 16238], [38, 16683], [41, 16863], [44, 17003], [52, 17443], [54, 17943], [57, 18063], [64, 18423], [70, 18983]]}, {"verse": 4, "start": 20406, "end": 25833, "text": "Pon asimismo tu delicia en Jehová, y él te dará las peticiones de tu corazón.", "words": [[0, 20406], [4, 20888], [13, 21398], [16, 21638], [24, 22238], [27, 22418], [35, 23098], [37, 23418], [40, 23618], [43, 23798], [48, 24098], [52, 24238], [63, 24858], [66, 25038], [69, 25178]]}, {"verse": 5, "start": 26283, "end": 31257, "text": "Encomienda a Jehová tu camino, y espera en él; y él hará.", "words": [[0, 26283], [11, 26967], [13, 27227], [20, 27687], [23, 27787], [31, 28267], [33, 28847], [40, 29287], [43, 29707], [47, 30375], [49, 30535], [52, 30695]]}, {"verse": 6, "start": 31707, "end": 36838, "text": "Y exhibirá tu justicia como la luz, y tus derechos como el medio día.", "words": [[0, 31707], [2, 31997], [11, 32577], [14, 32717], [23, 33397], [28, 33617], [31, 33777], [36, 34097], [38, 34757], [42, 34937], [51, 35357], [56, 35837], [59, 36186], [65, 36535]]}, {"verse": 7, "start": 37288, "end": 45908, "text": "Calla a Jehová, y espera en él: no te alteres con motivo del que prospera en su camino, por el hombre que hace maldades.", "words": [[0, 37288], [6, 37784], [8, 37924], [16, 38444], [18, 38604], [25, 38924], [28, 39304], [32, 40001], [35, 40150], [38, 40310], [46, 40830], [50, 41010], [57, 41390], [61, 41770], [65, 41890], [74, 42550], [77, 42630], [80, 42810], [88, 43770], [92, 43910], [95, 44070], [102, 44350], [106, 44590], [111, 44830]]}, {"verse": 8, "start": 46358, "end": 52750, "text": "Déjate de la ira, y depón el enojo: no te excites en manera alguna a hacer lo malo.", "words": [[0, 46358], [7, 46906], [10, 47046], [13, 47186], [18, 47746], [20, 47946], [26, 48366], [29, 48626], [36, 49590], [39, 49717], [42, 49917], [50, 50457], [53, 50677], [60, 50957], [67, 51417], [69, 51637], [75, 51857], [78, 52077]]}, {"verse": 9, "start": 53200, "end": 59732, "text": "Porque los malignos serán destruidos, pero los que esperan en Jehová, ellos heredarán la tierra.", "words": [[0, 53200], [7, 53406], [11, 53586], [20, 54206], [26, 54506], [38, 55486], [43, 55686], [47, 55886], [51, 56086], [59, 56566], [62, 56686], [70, 57446], [76, 57846], [86, 58846], [89, 59006]]}, {"verse": 10, "start": 60182, "end": 66254, "text": "Pues de aquí a poco no será el malo: y contemplarás sobre su lugar, y no aparecerá.", "words": [[0, 60182], [5, 60325], [8, 60445], [13, 60665], [15, 60885], [20, 61105], [23, 61345], [28, 61605], [31, 61805], [37, 62538], [39, 62660], [52, 63760], [58, 64200], [61, 64500], [68, 64900], [70, 65180], [73, 65340]]}, {"verse": 11, "start": 66704, "end": 72891, "text": "Pero los mansos heredarán la tierra, y se recrearán con abundancia de paz.", "words": [[0, 66704], [5, 67004], [9, 67164], [16, 68184], [26, 69024], [29, 69184], [37, 69704], [39, 70164], [42, 70324], [52, 71204], [56, 71364], [67, 72164], [70, 72304]]}, {"verse": 12, "start": 73341, "end": 78562, "text": "Maquina el impío contra el justo, y cruje sobre él sus dientes.", "words": [[0, 73341], [8, 73926], [11, 74246], [17, 74906], [24, 75306], [27, 75506], [34, 75926], [36, 76446], [42, 76926], [48, 77226], [51, 77506], [55, 77686]]}, {"verse": 13, "start": 79012, "end": 82664, "text": "El Señor se reirá de él; porque ve que viene su día.", "words": [[0, 79012], [3, 79154], [9, 79534], [12, 79914], [18, 80294], [21, 80454], [25, 81124], [32, 81340], [35, 81520], [39, 81660], [45, 81920], [48, 82160]]}, {"verse": 14, "start": 83114, "end": 94354, "text": "Los impíos desenvainaron espada, y tensaron su arco, para derribar al pobre y al necesitado, para matar a los de recto proceder.", "words": [[0, 83114], [4, 83222], [11, 84102], [25, 84982], [33, 85582], [35, 86022], [44, 86602], [47, 86862], [53, 87302], [58, 87822], [67, 88682], [70, 88842], [76, 89902], [78, 90242], [81, 90382], [93, 91282], [98, 91722], [104, 92022], [106, 92262], [110, 92535], [113, 92809], [119, 93082]]}, {"verse": 15, "start": 94804, "end": 100615, "text": "La espada de ellos entrará en su mismo corazón, y su arco será quebrado.", "words": [[0, 94804], [3, 94950], [10, 95530], [13, 95710], [19, 96090], [27, 96970], [30, 97190], [33, 97410], [39, 97770], [48, 98310], [50, 99030], [53, 99230], [58, 99570], [63, 99830]]}, {"verse": 16, "start": 101065, "end": 105055, "text": "Mejor es lo poco del justo, que las riquezas de muchos pecadores.", "words": [[0, 101065], [6, 101392], [9, 101512], [12, 101632], [17, 102032], [21, 102432], [28, 102832], [32, 102932], [36, 103072], [45, 103652], [48, 103852], [55, 104072]]}, {"verse": 17, "start": 105505, "end": 111689, "text": "Porque los brazos de los impíos serán quebrados: mas el que sostiene a los justos es Jehová.", "words": [[0, 105505], [7, 105905], [11, 106285], [18, 106765], [21, 106905], [25, 107265], [32, 107625], [38, 107965], [49, 109087], [53, 109274], [56, 109534], [60, 109694], [69, 110274], [71, 110568], [75, 110863], [82, 111157], [85, 111451]]}, {"verse": 18, "start": 112139, "end": 117442, "text": "Conoce Jehová los días de los perfectos: y la heredad de ellos será para siempre.", "words": [[0, 112139], [7, 112564], [14, 113024], [18, 113164], [23, 113444], [26, 113644], [30, 113764], [41, 115023], [43, 115142], [46, 115282], [54, 115802], [57, 115962], [63, 116182], [68, 116462], [73, 116702]]}, {"verse": 19, "start": 117892, "end": 123521, "text": "No serán avergonzados en el mal tiempo; y en los días de hambre serán hartos.", "words": [[0, 117892], [3, 118120], [9, 118560], [22, 119460], [25, 119680], [28, 119840], [32, 119980], [40, 120994], [42, 121125], [45, 121245], [49, 121385], [54, 121625], [57, 121825], [64, 122185], [70, 122625]]}, {"verse": 20, "start": 123971, "end": 133214, "text": "Mas los impíos perecerán, y los enemigos de Jehová como la grasa de los carneros serán consumidos: se disiparán como humo.", "words": [[0, 123971], [4, 124118], [8, 124278], [15, 125018], [26, 125938], [28, 126498], [32, 126618], [41, 127138], [44, 127298], [51, 127798], [56, 127958], [59, 128118], [65, 128498], [68, 128658], [72, 129088], [81, 129518], [87, 130118], [99, 131494], [102, 131635], [112, 132375], [117, 132575]]}, {"verse": 21, "start": 133664, "end": 139141, "text": "El impío toma prestado, y no paga; mas el justo tiene misericordia, y da.", "words": [[0, 133664], [3, 133803], [9, 134363], [14, 134663], [24, 135363], [26, 135483], [29, 135603], [35, 136508], [39, 136594], [42, 136681], [48, 137181], [54, 137601], [68, 138661], [70, 138801]]}, {"verse": 22, "start": 139591, "end": 145482, "text": "Porque los benditos de él heredarán la tierra; y los malditos de él serán destruidos.", "words": [[0, 139591], [7, 139753], [11, 139953], [20, 140513], [23, 140713], [26, 140933], [36, 141633], [39, 141753], [47, 142754], [49, 142859], [53, 142999], [62, 143679], [65, 143879], [68, 144079], [74, 144499]]}, {"verse": 23, "start": 145932, "end": 150641, "text": "Por Jehová son ordenados los pasos del hombre, y aprueba su camino.", "words": [[0, 145932], [4, 146096], [11, 146616], [15, 146816], [25, 147596], [29, 147796], [35, 148256], [39, 148416], [47, 148736], [49, 149256], [57, 149756], [60, 149956]]}, {"verse": 24, "start": 151091, "end": 156645, "text": "Cuando caiga el hombre, no quedará postrado; porque Jehová sostiene su mano.", "words": [[0, 151091], [7, 151275], [13, 151855], [16, 152035], [24, 152355], [27, 152915], [35, 153355], [45, 154496], [52, 154741], [59, 155301], [68, 155841], [71, 156041]]}, {"verse": 25, "start": 157095, "end": 164217, "text": "Joven fui, y he envejecido, y no he visto justo desamparado, ni su descendencia que mendigue pan.", "words": [[0, 157095], [6, 157437], [11, 157717], [13, 158397], [16, 158557], [28, 159317], [30, 159837], [33, 159997], [36, 160077], [42, 160337], [48, 160657], [61, 161317], [64, 161977], [67, 162157], [80, 162997], [84, 163297], [93, 163597]]}, {"verse": 26, "start": 164667, "end": 170477, "text": "En todo tiempo tiene misericordia, y presta; y su descendencia es para bendición.", "words": [[0, 164667], [3, 164836], [8, 165116], [15, 165516], [21, 165856], [35, 166736], [37, 166856], [45, 167896], [47, 168156], [50, 168276], [63, 169216], [66, 169376], [71, 169596]]}, {"verse": 27, "start": 170927, "end": 175023, "text": "Apártate del mal, y haz el bien, y vivirás para siempre.", "words": [[0, 170927], [9, 171614], [13, 171834], [18, 172114], [20, 172354], [24, 172594], [27, 172754], [33, 173014], [35, 173654], [43, 174134], [48, 174334]]}, {"verse": 28, "start": 175473, "end": 187415, "text": "Porque Jehová ama la rectitud, y no desampara sus santos: para siempre serán guardados; mas la descendencia de los impíos será extirpada.", "words": [[0, 175473], [7, 175755], [14, 176355], [18, 176595], [21, 176815], [31, 177515], [33, 178055], [36, 178235], [46, 178895], [50, 179075], [58, 180182], [63, 180348], [71, 180648], [77, 181288], [88, 182999], [92, 182999], [95, 183149], [108, 184009], [111, 184129], [115, 184249], [122, 185049], [127, 185469]]}, {"verse": 29, "start": 187865, "end": 192608, "text": "Los justos heredarán la tierra, y vivirán para siempre sobre ella.", "words": [[0, 187865], [4, 188061], [11, 188661], [21, 189381], [24, 189521], [32, 189981], [34, 190501], [42, 190981], [47, 191201], [55, 191521], [61, 192021]]}, {"verse": 30, "start": 193058, "end": 197774, "text": "La boca del justo hablará sabiduría; y su lengua proferirá juicio.", "words": [[0, 193058], [3, 193186], [8, 193386], [12, 193606], [18, 193946], [26, 194466], [37, 195708], [39, 195816], [42, 195956], [49, 196456], [59, 196956]]}, {"verse": 31, "start": 198224, "end": 203935, "text": "La ley de su Dios está en su corazón; por tanto sus pasos no vacilarán.", "words": [[0, 198224], [3, 198504], [7, 198804], [10, 198984], [13, 199144], [18, 199464], [23, 199824], [26, 199984], [29, 200144], [38, 201339], [42, 201483], [48, 201783], [52, 202084], [58, 202603], [61, 202903]]}, {"verse": 32, "start": 204385, "end": 207736, "text": "Acecha el impío al justo, y procura matarlo.", "words": [[0, 204694], [7, 205034], [10, 205384], [16, 205734], [19, 205874], [26, 206234], [28, 206474], [36, 206894]]}, {"verse": 33, "start": 208186, "end": 213502, "text": "Jehová no lo dejará en sus manos, ni lo condenará cuando le juzguen.", "words": [[0, 208186], [7, 208732], [10, 209172], [13, 209292], [20, 209792], [23, 209892], [27, 210032], [34, 211012], [37, 211292], [40, 211452], [50, 212112], [57, 212332], [60, 212632]]}, {"verse": 34, "start": 213952, "end": 222818, "text": "Espera en Jehová, y guarda su camino, y él te ensalzará para heredar la tierra: cuando serán talados los pecadores, lo verás.", "words": [[0, 214155], [7, 214385], [10, 214545], [18, 214945], [20, 215025], [27, 215385], [30, 215505], [38, 216225], [40, 216545], [43, 216705], [46, 216885], [56, 217705], [61, 217965], [69, 218485], [72, 218625], [80, 219636], [87, 219799], [93, 220219], [101, 220739], [105, 221369], [116, 221999], [119, 222239]]}, {"verse": 35, "start": 223268, "end": 229554, "text": "Vi yo al impío sumamente enaltecido, y que se extendía como un laurel verde.", "words": [[0, 223464], [3, 223692], [6, 223920], [9, 224148], [15, 224376], [25, 225216], [37, 226056], [39, 226636], [43, 226796], [46, 226996], [55, 227956], [60, 228236], [63, 228436], [70, 229022]]}, {"verse": 36, "start": 230004, "end": 235769, "text": "Pero se pasó, y he aquí no aparece; y lo busqué, y no fue hallado.", "words": [[0, 230004], [5, 230168], [8, 230308], [14, 230748], [16, 231108], [19, 231468], [24, 231748], [27, 232348], [36, 233511], [38, 233625], [41, 233745], [49, 234225], [51, 234745], [54, 234885], [58, 235105]]}, {"verse": 37, "start": 236219, "end": 242175, "text": "Considera al íntegro, y mira al justo: que el final de cada uno de ellos es paz.", "words": [[0, 236219], [10, 237001], [13, 237221], [22, 237921], [24, 238501], [29, 238781], [32, 238921], [39, 239866], [43, 239970], [46, 240050], [52, 240350], [55, 240570], [60, 240710], [64, 241010], [67, 241170], [73, 241430], [76, 241650]]}, {"verse": 38, "start": 242625, "end": 249040, "text": "Mas los transgresores fueron todos a una destruidos: el final de los impíos fue talado.", "words": [[0, 242625], [4, 242911], [8, 243291], [22, 244131], [29, 244491], [35, 244784], [37, 245078], [41, 245371], [53, 246789], [56, 247049], [62, 247389], [65, 247549], [69, 247889], [76, 248229], [80, 248389]]}, {"verse": 39, "start": 249490, "end": 255384, "text": "Pero la salvación de los justos es de Jehová, y él es su fortaleza en el tiempo de angustia.", "words": [[0, 249490], [5, 249635], [8, 249795], [18, 250415], [21, 250575], [25, 250675], [32, 251195], [35, 251335], [38, 251495], [46, 252195], [48, 252435], [51, 252615], [54, 252735], [57, 252895], [67, 253695], [70, 253835], [73, 253975], [80, 254335], [83, 254595]]}, {"verse": 40, "start": 255834, "end": 265401, "text": "Y Jehová los ayudará, y los librará: y los libertará de los impíos, y los salvará, por cuanto en él esperaron.", "words": [[0, 255834], [2, 255981], [9, 256461], [13, 256581], [22, 257201], [24, 257661], [28, 257861], [37, 259115], [39, 259239], [43, 259419], [53, 260259], [56, 260379], [60, 260499], [68, 261259], [70, 261839], [74, 261979], [83, 262739], [87, 263319], [94, 263759], [97, 263999], [100, 264199]]}]}