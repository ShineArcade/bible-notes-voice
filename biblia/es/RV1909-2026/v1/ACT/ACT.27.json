{"book": "ACT", "chapter": 27, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 370881, "verses": [{"verse": 1, "start": 300, "end": 12251, "text": "Pero como fue determinado que habíamos de navegar para Italia, entregaron a Pablo y a algunos otros presos a un centurión, llamado Julio, de la unidad militar Augusta.", "words": [[0, 300], [5, 466], [10, 726], [14, 1026], [26, 1826], [30, 2006], [39, 2406], [42, 2606], [50, 3126], [55, 3326], [63, 4466], [74, 5306], [76, 5426], [82, 5806], [84, 6066], [86, 6206], [94, 6646], [100, 7086], [107, 7786], [109, 7966], [112, 8106], [123, 8766], [131, 9266], [138, 10126], [141, 10406], [144, 10526], [151, 10946], [159, 11466]]}, {"verse": 2, "start": 12601, "end": 23438, "text": "Así que, embarcándonos en una nave Adramitio, partimos, estando con nosotros Aristarco, macedonio de Tesalónica, para navegar hacia los puertos de Asia.", "words": [[0, 12601], [4, 12852], [9, 13072], [23, 14212], [26, 14452], [30, 14632], [35, 15198], [46, 15764], [56, 16347], [64, 17227], [68, 17427], [77, 17867], [88, 18837], [98, 19807], [101, 19987], [113, 20967], [118, 21187], [126, 21727], [132, 21947], [136, 22147], [144, 22707], [147, 22907]]}, {"verse": 3, "start": 23788, "end": 33907, "text": "Y otro día llegamos a Sidón; y Julio, tratando a Pablo con humanidad, le permitió que fuese a los amigos, para ser de ellos asistido.", "words": [[0, 23788], [2, 23954], [7, 24134], [11, 24514], [20, 25334], [22, 25514], [29, 26258], [31, 26402], [38, 27402], [47, 28062], [49, 28222], [55, 28562], [59, 28882], [70, 29942], [73, 30022], [82, 30562], [86, 30682], [92, 31022], [94, 31142], [98, 31222], [106, 31662], [111, 32044], [115, 32427], [118, 32627], [124, 32907]]}, {"verse": 4, "start": 34257, "end": 41258, "text": "Y haciéndonos a la vela desde allí, navegamos al abrigo de Chipre, porque los vientos eran contrarios.", "words": [[0, 34257], [2, 34401], [14, 35001], [16, 35201], [19, 35321], [24, 35641], [30, 35821], [36, 36221], [46, 37261], [49, 37481], [56, 37941], [59, 38021], [67, 38601], [74, 39201], [78, 39461], [86, 39861], [91, 40121]]}, {"verse": 5, "start": 41608, "end": 47352, "text": "Y habiendo pasado el mar de Cilicia y Panfilia, arribamos a Mira, ciudad de Licia.", "words": [[0, 41608], [2, 41712], [11, 42012], [18, 42352], [21, 42592], [25, 42792], [28, 43182], [36, 43572], [38, 43672], [48, 44652], [58, 45572], [60, 45822], [66, 46072], [73, 46352], [76, 46692]]}, {"verse": 6, "start": 47702, "end": 54058, "text": "Y hallando allí el centurión una nave alejandrina que navegaba a Italia, nos puso en ella.", "words": [[0, 47702], [2, 47923], [11, 48263], [16, 48523], [19, 48683], [29, 49543], [33, 49743], [38, 50043], [50, 50763], [54, 50943], [63, 51523], [65, 51783], [73, 52363], [77, 52923], [82, 53363], [85, 53543]]}, {"verse": 7, "start": 54408, "end": 65037, "text": "Y navegando muchos días despacio, y habiendo apenas llegado delante de Gnido, no dejándonos el viento, navegamos al abrigo de Creta, junto a Salmón.", "words": [[0, 54408], [2, 54557], [12, 55137], [19, 55437], [24, 55857], [34, 57177], [36, 57417], [45, 57777], [52, 58037], [60, 58817], [68, 59237], [71, 59527], [78, 59817], [81, 60317], [92, 61057], [95, 61277], [103, 62257], [113, 62857], [116, 63057], [123, 63457], [126, 63557], [133, 63997], [139, 64277], [141, 64537]]}, {"verse": 8, "start": 65387, "end": 74041, "text": "Y costeándola difícilmente, llegamos a un lugar que llaman Buenos Puertos, cerca del cual estaba la ciudad de Lasea.", "words": [[0, 65387], [2, 65807], [14, 66267], [28, 67307], [37, 67707], [39, 67887], [42, 68027], [48, 68327], [52, 68547], [59, 68947], [66, 69647], [75, 70867], [81, 71337], [85, 71807], [90, 71927], [97, 72307], [100, 72527], [107, 72907], [110, 73488]]}, {"verse": 9, "start": 74391, "end": 83109, "text": "Y pasado mucho tiempo, y siendo ya peligrosa la navegación, porque ya era pasado el ayuno, Pablo amonestaba,", "words": [[0, 74391], [2, 74512], [9, 74792], [15, 75192], [23, 76192], [25, 76452], [32, 76752], [35, 76932], [45, 77652], [48, 77752], [60, 79092], [67, 79392], [70, 79652], [74, 79812], [81, 80152], [84, 80472], [91, 81512], [97, 81992]]}, {"verse": 10, "start": 83459, "end": 92600, "text": "Diciéndoles: Varones, veo que con trabajo y mucho daño, no sólo de la carga y de la nave, pero aun de nuestras personas, habrá de ser la navegación.", "words": [[0, 83459], [13, 84741], [22, 85080], [26, 85340], [30, 85520], [34, 85700], [42, 86100], [44, 86260], [50, 86500], [56, 87200], [59, 87380], [64, 87640], [67, 87800], [70, 87900], [76, 88160], [78, 88340], [81, 88420], [84, 88560], [90, 89180], [95, 89380], [99, 89660], [102, 89840], [111, 90020], [121, 90720], [127, 91360], [130, 91480], [134, 91700], [137, 91840]]}, {"verse": 11, "start": 92880, "end": 98880, "text": "Pero el centurión creía más al piloto y al patrón de la nave, que a lo que Pablo decía.", "words": [[0, 92880], [5, 93062], [8, 93202], [18, 93822], [24, 94302], [28, 94522], [31, 94762], [38, 95502], [40, 95602], [43, 95722], [50, 96202], [53, 96302], [56, 96422], [62, 96822], [66, 97187], [68, 97267], [71, 97387], [75, 97507], [81, 98027]]}, {"verse": 12, "start": 99230, "end": 112134, "text": "Y no habiendo puerto cómodo para invernar, muchos acordaron pasar aún de allí, por si pudiesen arribar a Fenice e invernar allí, que es un puerto de Creta que mira al Nordeste y Sudeste.", "words": [[0, 99230], [2, 99354], [5, 99454], [14, 99814], [21, 100254], [28, 100854], [33, 101094], [43, 102314], [50, 102574], [60, 103274], [66, 103594], [70, 103894], [73, 104074], [79, 104354], [83, 104814], [86, 105014], [95, 105574], [103, 106134], [105, 106214], [112, 106774], [114, 107074], [123, 107814], [129, 108450], [133, 108554], [136, 108734], [139, 108894], [146, 109261], [149, 109627], [155, 109994], [159, 110154], [164, 110394], [167, 110594], [176, 111234], [178, 111434]]}, {"verse": 13, "start": 112484, "end": 121273, "text": "Y soplando el viento del sur, pareciéndoles que ya tenían lo que deseaban, alzando velas, iban cerca de la costa de Creta.", "words": [[0, 112484], [2, 112610], [11, 113070], [14, 113210], [21, 113590], [25, 113790], [30, 114210], [44, 115370], [48, 115550], [51, 115850], [58, 116150], [61, 116350], [65, 116490], [75, 117630], [83, 118090], [90, 118830], [95, 119270], [101, 119630], [104, 119930], [107, 120030], [113, 120490], [116, 120915]]}, {"verse": 14, "start": 121623, "end": 127332, "text": "Pero no mucho después dio en ella un viento repentino, que se llama Euroclidón.", "words": [[0, 121623], [5, 121787], [8, 122007], [14, 122307], [22, 122807], [26, 123227], [29, 123527], [34, 123727], [37, 123907], [44, 124287], [55, 125107], [59, 125467], [62, 125647], [68, 125967]]}, {"verse": 15, "start": 127682, "end": 133845, "text": "Y siendo arrebatada la nave, y no pudiendo resistir contra el viento, la dejamos, y éramos llevados.", "words": [[0, 127682], [2, 127789], [9, 128149], [20, 128829], [23, 128989], [29, 129329], [31, 129589], [34, 129709], [43, 130149], [52, 130789], [59, 131109], [62, 131289], [70, 131649], [73, 131829], [82, 132389], [84, 132829], [91, 133109]]}, {"verse": 16, "start": 134195, "end": 140351, "text": "Y habiendo corrido a sotavento de una pequeña isla que se llama Clauda, apenas pudimos asegurar el bote:", "words": [[0, 134195], [2, 134342], [11, 134662], [19, 135102], [21, 135242], [31, 135702], [34, 135862], [38, 135982], [46, 136282], [51, 136802], [55, 136922], [58, 137062], [64, 137282], [72, 138282], [79, 138582], [87, 139142], [96, 139702], [99, 139902]]}, {"verse": 17, "start": 140701, "end": 151864, "text": "El cual tomado, usaban cuerdas de refuerzo, rodeando la nave; y teniendo temor de que diesen en la Sirte, bajadas las velas, eran así llevados.", "words": [[0, 140701], [3, 140837], [8, 140997], [16, 141784], [23, 142224], [31, 142784], [34, 142924], [44, 143604], [53, 144504], [56, 144724], [62, 145425], [64, 145729], [73, 146069], [79, 146409], [82, 146589], [86, 146809], [93, 147029], [96, 147502], [99, 147976], [106, 148449], [114, 149189], [118, 149389], [125, 150189], [130, 150729], [134, 151049]]}, {"verse": 18, "start": 152214, "end": 159391, "text": "Pero siendo atormentados de una vehemente tempestad, al siguiente día arrojaron carga al mar;", "words": [[0, 152214], [5, 152355], [12, 152735], [25, 153615], [28, 153775], [32, 153915], [42, 154795], [53, 155935], [56, 156035], [66, 156335], [70, 156935], [80, 158115], [86, 158515], [89, 158955]]}, {"verse": 19, "start": 159741, "end": 165149, "text": "Y al tercer día nosotros con nuestras manos arrojamos los aparejos de la nave.", "words": [[0, 159741], [2, 159868], [5, 159988], [12, 160408], [16, 160788], [25, 161308], [29, 161688], [38, 162108], [44, 162648], [54, 163608], [58, 163768], [67, 164408], [70, 164528], [73, 164648]]}, {"verse": 20, "start": 165499, "end": 175646, "text": "Y no pareciendo sol ni estrellas por muchos días, y viniendo una tempestad no pequeña, ya era perdida toda la esperanza de salvarnos.", "words": [[0, 165499], [2, 165626], [5, 165766], [16, 166346], [20, 166706], [23, 166966], [33, 167626], [37, 167846], [44, 168146], [50, 168546], [52, 169186], [61, 169706], [65, 169906], [75, 170726], [78, 171006], [87, 172206], [90, 172446], [94, 172646], [102, 173466], [107, 173766], [110, 174026], [120, 174706], [123, 174866]]}, {"verse": 21, "start": 175996, "end": 189507, "text": "Entonces Pablo, habiendo ya mucho que no comíamos, puesto en pie en medio de ellos, dijo: Convenía, pues, oh varones, haberme oído, y no partir de Creta, y evitar este inconveniente y daño.", "words": [[0, 175996], [9, 176685], [16, 177229], [25, 177773], [28, 178317], [34, 178577], [38, 178817], [41, 178997], [51, 180032], [58, 180392], [61, 180772], [65, 181012], [68, 181332], [74, 181672], [77, 181952], [84, 182632], [90, 183344], [100, 183937], [106, 184247], [109, 184557], [118, 185217], [126, 185557], [132, 185857], [134, 186117], [137, 186257], [144, 186604], [147, 186950], [154, 187297], [156, 187477], [163, 187797], [168, 188057], [182, 188877], [184, 189017]]}, {"verse": 22, "start": 189857, "end": 197063, "text": "Pero ahora os amonesto que tengáis buen ánimo; porque ninguna pérdida habrá de persona de vosotros, sino solamente de la nave.", "words": [[0, 189857], [5, 190024], [11, 190384], [14, 190704], [23, 191224], [27, 191404], [35, 191804], [40, 192044], [47, 192804], [54, 192984], [62, 193284], [70, 193864], [76, 194144], [79, 194224], [87, 194524], [90, 194724], [100, 195284], [105, 195724], [115, 196204], [118, 196524], [121, 196644]]}, {"verse": 23, "start": 197413, "end": 202029, "text": "Porque esta noche ha estado conmigo el ángel del Dios del cual yo soy, y al cual sirvo,", "words": [[0, 197413], [7, 197599], [12, 197779], [18, 197979], [21, 198139], [28, 198379], [36, 198879], [39, 198999], [45, 199319], [49, 199499], [54, 199739], [58, 200019], [63, 200279], [66, 200479], [71, 200799], [73, 201119], [76, 201239], [81, 201399]]}, {"verse": 24, "start": 202379, "end": 210839, "text": "Diciendo: Pablo, no temas; es necesario que comparezcas ante César; y he aquí, Dios te ha dado todos los que navegan contigo.", "words": [[0, 202379], [10, 203256], [17, 203623], [20, 203999], [27, 204596], [30, 204776], [40, 205356], [44, 205556], [56, 206236], [61, 206516], [68, 207344], [70, 207531], [73, 207591], [79, 208291], [84, 208531], [87, 208771], [90, 208871], [95, 209051], [101, 209311], [105, 209591], [109, 209751], [117, 210151]]}, {"verse": 25, "start": 211189, "end": 216938, "text": "Por tanto, oh varones, tened buen ánimo; porque yo confío en Dios que será así como me ha dicho;", "words": [[0, 211189], [4, 211308], [11, 211548], [14, 211788], [23, 212588], [29, 212828], [34, 213008], [41, 213808], [48, 214008], [51, 214168], [58, 214708], [61, 214868], [66, 215088], [70, 215328], [75, 215608], [79, 215908], [84, 216148], [87, 216388], [90, 216468]]}, {"verse": 26, "start": 217288, "end": 219715, "text": "Si bien es necesario que demos en una isla.", "words": [[0, 217288], [3, 217426], [8, 217686], [11, 217806], [21, 218166], [25, 218526], [31, 218886], [34, 219086], [38, 219206]]}, {"verse": 27, "start": 219995, "end": 229957, "text": "Y venida la decimocuarta noche, y siendo llevados por el mar Adriático, los marineros a la media noche sospecharon que estaban cerca de alguna tierra;", "words": [[0, 219995], [2, 220142], [9, 220522], [12, 220642], [25, 221382], [32, 222282], [34, 222542], [41, 222822], [50, 223302], [54, 223542], [57, 223722], [61, 223902], [72, 225402], [76, 225502], [86, 226242], [88, 226322], [91, 226562], [97, 226802], [103, 227042], [115, 227762], [119, 227942], [127, 228302], [133, 228742], [136, 229002], [143, 229242]]}, {"verse": 28, "start": 230307, "end": 239492, "text": "Y echando la sonda, hallaron veinte brazas; y pasando un poco más adelante, volviendo a echar la sonda, hallaron quince brazas.", "words": [[0, 230307], [2, 230531], [10, 230971], [13, 231151], [20, 231831], [29, 232402], [36, 232972], [44, 233717], [46, 233822], [54, 234202], [57, 234442], [62, 234662], [66, 234922], [76, 235902], [86, 236382], [88, 236542], [94, 236682], [97, 236882], [104, 237762], [113, 238182], [120, 238682]]}, {"verse": 29, "start": 239842, "end": 246654, "text": "Y temiendo chocar contra los escollos, echaron cuatro anclas por la popa y ansiaban que se hiciese de día.", "words": [[0, 239842], [2, 239968], [11, 240368], [18, 240828], [25, 241108], [29, 241368], [39, 242348], [47, 242868], [54, 243148], [61, 243648], [65, 243828], [68, 243988], [73, 244328], [75, 244428], [84, 244988], [88, 245208], [91, 245368], [99, 245828], [102, 246088]]}, {"verse": 30, "start": 247004, "end": 257386, "text": "Entonces procurando los marineros huir de la nave, echado que hubieron el bote al mar, aparentando como que querían largar las anclas de proa,", "words": [[0, 247004], [9, 248227], [20, 249007], [24, 249207], [34, 249947], [39, 250387], [42, 250507], [45, 250667], [51, 251507], [58, 252007], [62, 252207], [71, 252527], [74, 252727], [79, 253087], [82, 253267], [87, 253887], [99, 254807], [104, 255047], [108, 255227], [116, 255627], [123, 256107], [127, 256287], [134, 256767], [137, 256887]]}, {"verse": 31, "start": 257736, "end": 265153, "text": "Pablo dijo al centurión y a los soldados: Si estos no quedan en la nave, vosotros no podéis salvaros.", "words": [[0, 257736], [6, 258107], [11, 258642], [14, 258862], [24, 259602], [26, 259782], [28, 259862], [32, 259982], [42, 261043], [45, 261187], [51, 261447], [54, 261667], [61, 262007], [64, 262107], [67, 262207], [73, 262887], [82, 263327], [85, 263507], [92, 263807]]}, {"verse": 32, "start": 265433, "end": 271141, "text": "Entonces los soldados cortaron las cuerdas del bote, y lo dejaron perder.", "words": [[0, 265433], [9, 266497], [13, 266837], [22, 267477], [31, 268177], [35, 268357], [43, 268857], [47, 269037], [53, 269437], [55, 269817], [58, 269957], [66, 270397]]}, {"verse": 33, "start": 271491, "end": 283070, "text": "Y como comenzó a ser de día, Pablo exhortaba a todos que comiesen, diciendo: Este es el decimocuarto día que esperáis y permanecéis ayunos, no comiendo nada.", "words": [[0, 271491], [2, 271738], [7, 271978], [15, 272578], [17, 272698], [21, 272918], [24, 273098], [29, 273838], [35, 274338], [45, 275158], [47, 275318], [53, 275578], [57, 275858], [67, 276938], [77, 277855], [82, 278173], [85, 278373], [88, 278473], [101, 279153], [105, 279473], [109, 279673], [118, 280273], [120, 280553], [132, 281293], [140, 282113], [143, 282213], [152, 282633]]}, {"verse": 34, "start": 283420, "end": 290128, "text": "Por tanto, os ruego que comáis por vuestra salud: que ni aun un cabello de la cabeza de ninguno de vosotros perecerá.", "words": [[0, 283420], [4, 283526], [11, 284026], [14, 284106], [20, 284366], [24, 284506], [31, 284926], [35, 285126], [43, 285486], [50, 286174], [54, 286275], [57, 286415], [61, 286655], [64, 286835], [72, 287315], [75, 287435], [78, 287555], [85, 288015], [88, 288235], [96, 288715], [99, 288795], [108, 289275]]}, {"verse": 35, "start": 290408, "end": 299032, "text": "Y habiendo dicho esto, tomando el pan, dio gracias a Dios en presencia de todos, y partiendo, comenzó a comer.", "words": [[0, 290408], [2, 290551], [11, 290891], [17, 291211], [23, 292071], [31, 292451], [34, 292591], [39, 293351], [43, 293711], [51, 294151], [53, 294471], [58, 294731], [61, 295151], [71, 295731], [74, 295931], [81, 296611], [83, 297031], [94, 298071], [102, 298471], [104, 298551]]}, {"verse": 36, "start": 299382, "end": 303138, "text": "Entonces todos teniendo ya mejor ánimo, comieron ellos también.", "words": [[0, 299382], [9, 299930], [15, 300170], [24, 300750], [27, 300910], [33, 301250], [40, 301770], [49, 302210], [55, 302470]]}, {"verse": 37, "start": 303488, "end": 308028, "text": "Y éramos todas las personas en la nave doscientas setenta y seis.", "words": [[0, 303488], [2, 303654], [9, 303934], [15, 304334], [19, 304634], [28, 305094], [31, 305354], [34, 305494], [39, 306015], [50, 306536], [58, 307056], [60, 307577]]}, {"verse": 38, "start": 308378, "end": 313415, "text": "Y satisfechos de comida, aliviaban la nave, echando el grano al mar.", "words": [[0, 308378], [2, 308523], [14, 309183], [17, 309323], [25, 309783], [35, 310823], [38, 311103], [44, 311423], [52, 312243], [55, 312513], [61, 312783], [64, 312923]]}, {"verse": 39, "start": 313765, "end": 323654, "text": "Y como se hizo de día, no conocían la tierra: pero veían una bahía que tenía playa, a la cual acordaron echar, si pudiesen, la nave.", "words": [[0, 313765], [2, 313873], [7, 314053], [10, 314233], [15, 314493], [18, 314673], [23, 315313], [26, 315513], [35, 316073], [38, 316253], [46, 317103], [51, 317305], [57, 317785], [61, 318065], [67, 318525], [71, 318665], [77, 319025], [84, 319625], [86, 319765], [89, 319825], [94, 320085], [104, 320945], [111, 321585], [114, 322125], [124, 322745], [127, 323125]]}, {"verse": 40, "start": 324004, "end": 334714, "text": "Cortando pues las anclas, las dejaron en el mar, largando también las ataduras de los timones; y alzada la vela mayor al viento, se iban a la orilla.", "words": [[0, 324004], [9, 324628], [14, 325248], [18, 325778], [26, 326308], [30, 326448], [38, 326968], [41, 327148], [44, 327288], [49, 327908], [58, 328528], [66, 328908], [70, 329188], [79, 329788], [82, 329928], [86, 330048], [95, 331052], [97, 331173], [104, 331673], [107, 331833], [112, 332133], [118, 332413], [121, 332613], [129, 333033], [132, 333593], [137, 333933], [139, 334033], [142, 334133]]}, {"verse": 41, "start": 335064, "end": 345252, "text": "Pero dando en un lugar de dos aguas, hicieron encallar la nave; y la proa, hincada, estaba sin moverse, y la popa se abría con la fuerza del mar.", "words": [[0, 335064], [5, 335207], [11, 335567], [14, 335767], [17, 335927], [23, 336227], [26, 336447], [30, 336667], [37, 337527], [46, 338067], [55, 338707], [58, 338827], [64, 339554], [66, 339680], [69, 339800], [75, 340240], [84, 340960], [91, 341560], [95, 341860], [104, 342440], [106, 342880], [109, 343020], [114, 343380], [117, 343520], [123, 343840], [127, 344040], [130, 344180], [137, 344500], [141, 344780]]}, {"verse": 42, "start": 345602, "end": 352299, "text": "Entonces el acuerdo de los soldados era que matasen los presos, porque ninguno se fugase nadando.", "words": [[0, 345602], [9, 346584], [12, 346744], [20, 347104], [23, 347344], [27, 347484], [36, 348104], [40, 348344], [44, 348524], [52, 349084], [56, 349284], [64, 349944], [71, 350444], [79, 351004], [82, 351164], [89, 351753]]}, {"verse": 43, "start": 352649, "end": 362610, "text": "Pero el centurión, queriendo salvar a Pablo, impidió este plan, y mandó que los que pudiesen nadar, se echasen los primeros, y saliesen a tierra;", "words": [[0, 352649], [5, 352833], [8, 352993], [19, 353573], [29, 354033], [36, 354433], [38, 354653], [45, 355113], [53, 355978], [58, 356238], [64, 356658], [66, 357238], [72, 357638], [76, 357758], [80, 357898], [84, 358038], [93, 358618], [100, 359318], [103, 359618], [111, 360078], [115, 360238], [125, 361118], [127, 361318], [136, 361798], [138, 361998]]}, {"verse": 44, "start": 362960, "end": 370481, "text": "Y los demás, parte en tablas, parte en cosas de la nave. Y así aconteció que todos se salvaron saliendo a tierra.", "words": [[0, 362960], [2, 363082], [6, 363222], [13, 363495], [19, 363769], [22, 364042], [30, 364494], [36, 364945], [39, 365397], [45, 365757], [48, 366037], [51, 366137], [57, 366874], [59, 367018], [63, 367238], [73, 367938], [77, 368098], [83, 368438], [86, 368798], [95, 369338], [104, 369818], [106, 369898]]}]}