07], [18, 88707], [22, 88867], [33, 90627], [36, 90782], [41, 90942], [46, 91603], [50, 91699], [53, 91879], [57, 92019], [62, 92099], [72, 92819], [75, 92919], [78, 93099], [81, 93219], [86, 93379], [89, 93579], [94, 94189], [98, 94314], [102, 94454], [110, 94794], [114, 95054], [121, 95374], [124, 95654], [128, 95964], [137, 96274]]}, {"verse": 14, "start": 97063, "end": 102346, "text": "¶ And when Jesus was come into Peter’s house, he saw his wife’s mother laid, and sick of a fever.", "words": [[2, 97063], [6, 97194], [11, 97314], [17, 97634], [21, 97887], [26, 98141], [31, 98394], [39, 98814], [46, 99454], [49, 99574], [53, 99834], [57, 100034], [64, 100414], [71, 100654], [77, 101074], [81, 101374], [86, 101594], [89, 101754], [91, 101834]]}, {"verse": 15, "start": 102696, "end": 107928, "text": "And he touched her hand, and the fever left her: and she arose, and ministered to them.", "words": [[0, 102696], [4, 102816], [7, 102916], [15, 103176], [19, 103376], [25, 103756], [29, 104156], [33, 104276], [39, 104556], [44, 104896], [49, 105500], [53, 105644], [57, 105804], [64, 106224], [68, 106784], [79, 107384], [82, 107504]]}, {"verse": 16, "start": 108278, "end": 116641, "text": "¶ When the even was come, they brought to him many that were demon-possessed: and he cast out the spirits with his word, and healed all that were sick:", "words": [[2, 108278], [7, 108401], [11, 108581], [16, 108821], [20, 109081], [26, 109781], [31, 109941], [39, 110181], [42, 110401], [46, 110561], [51, 110821], [56, 111081], [61, 111755], [78, 112578], [82, 112726], [85, 112786], [90, 113126], [94, 113306], [98, 113486], [106, 113886], [111, 114166], [115, 114326], [121, 114966], [125, 115226], [132, 115466], [136, 115786], [141, 115966], [146, 116126]]}, {"verse": 17, "start": 116991, "end": 124847, "text": "That it might be fulfilled which was spoken by Esaias the prophet, saying, Himself took our infirmities, and bore our sicknesses.", "words": [[0, 116991], [5, 117121], [8, 117