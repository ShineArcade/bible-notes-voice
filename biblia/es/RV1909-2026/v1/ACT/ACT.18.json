{"book": "ACT", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 263743, "verses": [{"verse": 1, "start": 300, "end": 4510, "text": "Pasadas estas cosas, Pablo salió de Atenas, y vino a Corinto.", "words": [[0, 300], [8, 708], [14, 948], [21, 1288], [27, 1768], [33, 2188], [36, 2328], [44, 2868], [46, 3288], [51, 3548], [53, 3748]]}, {"verse": 2, "start": 4960, "end": 20204, "text": "Y hallando a un judío llamado Aquila, natural del Ponto, que hacía poco que había venido de Italia, y a Priscila su mujer, (porque Claudio había mandado que todos los judíos saliesen de Roma) se vino a ellos;", "words": [[0, 4960], [2, 5220], [11, 5700], [13, 5940], [16, 6120], [22, 6600], [30, 6860], [38, 7860], [46, 8320], [50, 8580], [57, 9540], [61, 9620], [67, 9880], [72, 10320], [76, 10620], [82, 10820], [89, 11240], [92, 11420], [100, 12420], [102, 12820], [104, 13220], [113, 13620], [116, 13860], [123, 14717], [131, 15117], [139, 15557], [145, 15757], [153, 16337], [157, 16497], [163, 16777], [167, 17017], [174, 17497], [183, 17937], [186, 18177], [192, 18957], [195, 19177], [200, 19397], [202, 19577]]}, {"verse": 3, "start": 20654, "end": 28934, "text": "Y porque era del mismo oficio, se alojó con ellos, y trabajaba; porque el oficio de ellos era hacer tiendas.", "words": [[0, 20654], [2, 20739], [9, 20979], [13, 21339], [17, 21519], [23, 21879], [31, 22939], [34, 23179], [40, 23699], [44, 23919], [51, 24159], [53, 24519], [64, 25679], [71, 25925], [74, 26145], [81, 26585], [84, 26845], [90, 27105], [94, 27365], [100, 28178]]}, {"verse": 4, "start": 29384, "end": 34918, "text": "Y disputaba en la sinagoga todos los sábados, y persuadía a judíos y a griegos.", "words": [[0, 29384], [2, 29509], [12, 30049], [15, 30189], [18, 30289], [27, 30869], [33, 31109], [37, 31449], [46, 32109], [48, 32469], [58, 33229], [60, 33449], [67, 34009], [69, 34149], [71, 34289]]}, {"verse": 5, "start": 35368, "end": 45050, "text": "Y cuando Silas y Timoteo vinieron de Macedonia, Pablo se dedicaba por completo a la palabra, testificando a los judíos que Jesús era el Cristo.", "words": [[0, 35368], [2, 35445], [9, 35820], [15, 36195], [17, 36570], [25, 36945], [34, 37365], [37, 37525], [48, 38525], [54, 39145], [57, 39385], [66, 40005], [70, 40245], [79, 40845], [81, 41045], [84, 41125], [93, 41945], [106, 42705], [108, 42825], [112, 42945], [119, 43425], [123, 43545], [129, 43845], [133, 44265], [136, 44425]]}, {"verse": 6, "start": 45500, "end": 57526, "text": "Pero contradiciendo y blasfemando ellos, les dijo, sacudiendo sus vestidos: Vuestra sangre sea sobre vuestra cabeza; yo, limpio; desde ahora me iré a los Gentiles.", "words": [[0, 45500], [5, 45683], [20, 46743], [22, 46883], [34, 47703], [41, 48623], [45, 48903], [51, 49683], [62, 50423], [66, 50623], [76, 51660], [84, 52020], [91, 52360], [95, 52700], [101, 52980], [109, 53360], [117, 54240], [121, 54485], [129, 55491], [135, 55639], [141, 55999], [144, 56239], [148, 56499], [150, 56559], [154, 56679]]}, {"verse": 7, "start": 57876, "end": 66804, "text": "Y partiendo de allí, entró en casa de uno llamado Justo, temeroso de Dios, la casa del cual estaba junto a la sinagoga.", "words": [[0, 57876], [2, 58000], [12, 58580], [15, 58780], [21, 59580], [27, 60160], [30, 60280], [35, 60560], [38, 60840], [42, 61020], [50, 61340], [57, 62620], [66, 63120], [69, 63320], [75, 64020], [78, 64100], [83, 64380], [87, 64600], [92, 64840], [99, 65220], [105, 65580], [107, 65800], [110, 65880]]}, {"verse": 8, "start": 67254, "end": 77699, "text": "Y Crispo, el dirigente de la sinagoga, creyó al Señor con toda su casa: y muchos de los Corintios oyendo creían, y eran bautizados.", "words": [[0, 67254], [2, 67414], [10, 68234], [13, 68594], [23, 69234], [26, 69374], [29, 69514], [39, 70574], [45, 71014], [48, 71294], [54, 71634], [58, 71974], [63, 72294], [66, 72554], [72, 73453], [74, 73749], [81, 74069], [84, 74289], [88, 74389], [98, 74989], [105, 75449], [113, 76089], [115, 76369], [120, 76569]]}, {"verse": 9, "start": 78149, "end": 84767, "text": "Entonces el Señor dijo de noche en visión a Pablo: No temas, sino habla, y no calles:", "words": [[0, 78149], [9, 78630], [12, 78990], [18, 79310], [23, 79670], [26, 79850], [32, 80110], [35, 80330], [42, 80730], [44, 80850], [51, 81668], [54, 81837], [61, 82217], [66, 82757], [73, 83337], [75, 83897], [78, 84365]]}, {"verse": 10, "start": 85217, "end": 91675, "text": "Porque yo estoy contigo, y ninguno te podrá hacer mal; porque yo tengo mucho pueblo en esta ciudad.", "words": [[0, 85217], [7, 85404], [10, 85604], [16, 85824], [25, 86564], [27, 86984], [35, 87524], [38, 87704], [44, 88144], [50, 88364], [55, 89212], [62, 89376], [65, 89556], [71, 89816], [77, 90136], [84, 90616], [87, 90816], [92, 90996]]}, {"verse": 11, "start": 92125, "end": 98020, "text": "Y permaneció allí un año y seis meses, enseñándoles la palabra de Dios.", "words": [[0, 92125], [2, 92251], [13, 93011], [18, 93271], [21, 93551], [25, 93791], [27, 93951], [32, 94151], [39, 94691], [52, 96331], [55, 96791], [63, 97171], [66, 97411]]}, {"verse": 12, "start": 98470, "end": 107083, "text": "Y siendo Galión procónsul de Acaya, los judíos se levantaron de común acuerdo contra Pablo, y le llevaron al tribunal,", "words": [[0, 98470], [2, 98766], [9, 99226], [16, 99686], [26, 100486], [29, 100646], [36, 101666], [40, 101806], [47, 102346], [50, 102506], [61, 103106], [64, 103306], [70, 103586], [78, 104066], [85, 104526], [92, 105046], [94, 105366], [97, 105686], [106, 106166], [109, 106286]]}, {"verse": 13, "start": 107533, "end": 111973, "text": "Diciendo: Que este persuade a los hombres a honrar a Dios contra la ley.", "words": [[0, 107533], [10, 108633], [14, 108754], [19, 108994], [28, 109554], [30, 109674], [34, 109794], [42, 110094], [44, 110354], [51, 110674], [53, 110794], [58, 111014], [65, 111394], [68, 111594]]}, {"verse": 14, "start": 112323, "end": 122249, "text": "Y comenzando Pablo a abrir la boca, Galión dijo a los judíos: Si fuera algún agravio o algún crimen enorme, oh judíos, conforme a derecho yo os tolerara:", "words": [[0, 112323], [2, 112431], [13, 113111], [19, 113341], [21, 113571], [27, 113871], [30, 114071], [36, 114611], [43, 115291], [48, 115991], [50, 116171], [54, 116291], [62, 117229], [65, 117350], [71, 117590], [77, 117830], [85, 118310], [87, 118410], [93, 118630], [100, 118990], [108, 119460], [111, 119930], [119, 120450], [128, 120950], [130, 120990], [138, 121290], [141, 121490], [144, 121650]]}, {"verse": 15, "start": 122699, "end": 131347, "text": "Pero si son cuestiones de palabras, y de nombres, y de vuestra ley, vedlo vosotros; porque yo no quiero ser juez de estas cosas.", "words": [[0, 122699], [5, 122823], [8, 122963], [12, 123143], [23, 123603], [26, 123743], [36, 124163], [38, 124523], [41, 124603], [50, 125003], [52, 125343], [55, 125443], [63, 125783], [68, 126193], [74, 126603], [84, 128592], [91, 128799], [94, 129019], [97, 129159], [104, 129459], [108, 129759], [113, 130239], [116, 130359], [122, 130559]]}, {"verse": 16, "start": 131697, "end": 133348, "text": "Y los echó del tribunal.", "words": [[0, 131697], [2, 131818], [6, 131958], [11, 132398], [15, 132498]]}, {"verse": 17, "start": 133798, "end": 145052, "text": "Entonces todos los griegos tomando a Sóstenes, dirigente de la sinagoga, le herían delante del tribunal: y a Galión nada de ello le importaba.", "words": [[0, 133798], [9, 134660], [15, 135100], [19, 135420], [27, 135860], [35, 136307], [37, 136753], [47, 137200], [57, 138040], [60, 138220], [63, 138340], [73, 139060], [76, 139580], [83, 140200], [91, 140780], [95, 141040], [105, 142169], [107, 142350], [109, 142470], [116, 142850], [121, 143390], [124, 143710], [129, 143950], [132, 144150]]}, {"verse": 18, "start": 145502, "end": 162132, "text": "Pero Pablo habiendo permanecido aún allí muchos días, después se despidió de los hermanos, y navegó a Siria, y con él Priscila y Aquila, habiéndose cortado el cabello de la cabeza en Cencrea, porque tenía voto.", "words": [[0, 145502], [5, 145747], [11, 147027], [20, 147567], [32, 148467], [36, 148687], [41, 148947], [48, 149247], [54, 150627], [62, 150627], [65, 151167], [74, 151707], [77, 151827], [81, 151947], [91, 152767], [93, 153087], [100, 153567], [102, 153727], [109, 154247], [111, 154867], [115, 155087], [118, 155487], [127, 155887], [129, 156067], [137, 157087], [148, 157627], [156, 158247], [159, 158367], [167, 158847], [170, 158987], [173, 159127], [180, 159727], [183, 160327], [192, 160927], [199, 161127], [205, 161487]]}, {"verse": 19, "start": 162582, "end": 170077, "text": "Y llegó a Éfeso, y los dejó allí: y él entrando en la sinagoga, disputó con los judíos,", "words": [[0, 162582], [2, 162991], [8, 163436], [10, 163881], [17, 164326], [19, 164486], [23, 164646], [28, 165063], [34, 165713], [36, 166077], [39, 166337], [48, 166977], [51, 167137], [54, 167277], [64, 168297], [72, 168957], [76, 169137], [80, 169297]]}, {"verse": 20, "start": 170527, "end": 175614, "text": "Los cuales le rogaban que se quedase con ellos por más tiempo; pero no accedió,", "words": [[0, 170527], [4, 170647], [11, 170927], [14, 171347], [22, 171927], [26, 172127], [29, 172287], [37, 172727], [41, 172987], [47, 173227], [51, 173467], [55, 173647], [63, 174552], [68, 174717], [71, 174917]]}, {"verse": 21, "start": 176064, "end": 187849, "text": "Sino que se despidió de ellos, diciendo: Es necesario que en todo caso tenga la fiesta que viene, en Jerusalén; pero otra vez volveré a vosotros, queriendo Dios. Y partió de Éfeso.", "words": [[0, 176064], [5, 176384], [9, 176584], [12, 176744], [21, 177364], [24, 177504], [31, 177864], [41, 179350], [44, 179472], [54, 180052], [58, 180292], [61, 180412], [66, 180592], [71, 180892], [77, 181232], [80, 181412], [87, 181792], [91, 181952], [98, 182232], [101, 182492], [112, 183500], [117, 183640], [122, 183860], [126, 184100], [134, 184580], [136, 184580], [146, 185040], [156, 185580], [162, 186453], [164, 186578], [171, 187038], [174, 187469]]}, {"verse": 22, "start": 188299, "end": 195565, "text": "Y habiendo arribado a Cesarea subió a Jerusalén; y después de saludar a la iglesia, descendió a Antioquía.", "words": [[0, 188299], [2, 188409], [11, 188749], [20, 189149], [22, 189549], [30, 189949], [36, 190349], [38, 190429], [49, 191525], [51, 191869], [59, 192129], [62, 192329], [70, 192849], [72, 192909], [75, 193049], [84, 193449], [94, 194249], [96, 194549]]}, {"verse": 23, "start": 196015, "end": 205794, "text": "Y habiendo estado allí algún tiempo, salió, andando por orden la provincia de Galacia, y la Frigia, fortaleciendo a todos los discípulos.", "words": [[0, 196015], [2, 196138], [11, 196498], [18, 196798], [23, 197118], [29, 197398], [37, 198338], [44, 199358], [52, 199998], [56, 200258], [62, 200578], [65, 200858], [75, 201758], [78, 201878], [87, 202478], [89, 202678], [92, 202818], [100, 203358], [114, 204198], [116, 204398], [122, 204598], [126, 204858]]}, {"verse": 24, "start": 206244, "end": 215914, "text": "Llegó entonces a Éfeso un judío, llamado Apolos, natural de Alejandría, varón elocuente, poderoso en las Escrituras.", "words": [[0, 206244], [6, 206592], [15, 207012], [17, 207452], [23, 207892], [26, 208092], [33, 208632], [41, 208972], [49, 210232], [57, 210712], [60, 210932], [72, 212112], [78, 212632], [89, 213552], [98, 214372], [101, 214652], [105, 214832]]}, {"verse": 25, "start": 216364, "end": 228934, "text": "Este era instruido en el camino del Señor; y ferviente de espíritu, hablaba y enseñaba con exactitud las cosas que son del Señor, conociendo solamente el bautismo de Juan.", "words": [[0, 216364], [5, 216690], [9, 217010], [19, 217670], [22, 217790], [25, 217890], [32, 218150], [36, 218470], [43, 219389], [45, 219514], [55, 220094], [58, 220314], [68, 221154], [76, 221934], [78, 222294], [87, 222914], [91, 223134], [101, 223954], [105, 224374], [111, 224754], [115, 224954], [119, 225234], [123, 225414], [130, 226334], [141, 226914], [151, 227314], [154, 227674], [163, 228234], [166, 228414]]}, {"verse": 26, "start": 229384, "end": 240878, "text": "Y comenzó a hablar confiadamente en la sinagoga: al cual cuando oyeron Priscila y Aquila, le tomaron, y le explicaron con más precisión el camino de Dios.", "words": [[0, 229384], [2, 229501], [10, 230061], [12, 230161], [19, 230711], [33, 231261], [36, 231421], [39, 231541], [49, 232605], [52, 232815], [57, 233095], [64, 233515], [71, 234195], [80, 234875], [82, 235015], [90, 235555], [93, 235995], [102, 236655], [104, 237195], [107, 237295], [118, 238195], [122, 238415], [126, 238715], [136, 239535], [139, 239695], [146, 239975], [149, 240255]]}, {"verse": 27, "start": 241328, "end": 254299, "text": "Y queriendo él pasar a Acaya, los hermanos exhortados, escribieron a los discípulos que le recibiesen; y venido él, ayudó mucho por la gracia a los que habían creído:", "words": [[0, 241328], [2, 241469], [12, 241969], [15, 242169], [21, 242509], [23, 242789], [30, 243769], [34, 243849], [43, 244409], [55, 245389], [67, 246609], [69, 246909], [73, 247049], [84, 247729], [88, 247949], [91, 248129], [103, 249790], [105, 249894], [112, 250254], [116, 250754], [122, 251194], [128, 251494], [132, 251794], [135, 251994], [142, 252874], [144, 253014], [148, 253134], [152, 253274], [159, 253574]]}, {"verse": 28, "start": 254749, "end": 263343, "text": "Porque con gran vehemencia convencía públicamente a los judíos, mostrando por las Escrituras que Jesús era el Cristo.", "words": [[0, 254749], [7, 255036], [11, 255456], [16, 255756], [27, 256776], [37, 257556], [50, 258376], [52, 258496], [56, 258616], [64, 259616], [74, 260316], [78, 260636], [82, 260816], [93, 261476], [97, 261636], [103, 262036], [107, 262496], [110, 262676]]}]}