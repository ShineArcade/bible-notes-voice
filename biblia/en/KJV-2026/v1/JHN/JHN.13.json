{"book": "JHN", "chapter": 13, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 266240, "verses": [{"verse": 1, "start": 300, "end": 11142, "text": "Now before the feast of the passover, when Jesus knew that his hour was come that he should depart out of this world to the Father, having loved his own which were in the world, he loved them to the end.", "words": [[0, 300], [4, 486], [11, 726], [15, 946], [21, 1186], [24, 1346], [28, 1426], [38, 2446], [43, 2585], [49, 2846], [54, 3186], [59, 3386], [63, 3506], [68, 3806], [72, 4026], [77, 4486], [82, 4546], [85, 4646], [92, 4826], [99, 5126], [103, 5345], [106, 5466], [111, 5626], [117, 5926], [120, 6106], [124, 6206], [132, 6891], [139, 7093], [145, 7433], [149, 7693], [153, 8253], [159, 8413], [164, 8633], [167, 8773], [171, 8893], [178, 9653], [181, 9753], [187, 10073], [192, 10333], [195, 10533], [199, 10673]]}, {"verse": 2, "start": 11492, "end": 18449, "text": "And supper being ended, the devil having now put into the heart of Judas Iscariot, Simon’s son, to betray him;", "words": [[0, 11492], [4, 11677], [11, 11937], [17, 12277], [24, 13157], [28, 13217], [34, 13497], [41, 13817], [45, 14117], [49, 14357], [54, 14597], [58, 14737], [64, 14997], [67, 15117], [73, 15457], [83, 16497], [91, 17077], [96, 17617], [99, 17717], [106, 18017]]}, {"verse": 3, "start": 18799, "end": 25330, "text": "Jesus knowing that the Father had given all things into his hands, and that he was come from God, and went to God;", "words": [[0, 18799], [6, 19059], [14, 19539], [19, 19799], [23, 19919], [30, 20239], [34, 20459], [40, 20639], [44, 20919], [51, 21199], [56, 21499], [60, 21719], [67, 22139], [71, 22699], [76, 22839], [79, 22959], [83, 23119], [88, 23359], [93, 23619], [98, 24039], [102, 24459], [107, 24679], [110, 24879]]}, {"verse": 4, "start": 25680, "end": 31403, "text": "He rises from supper, and laid aside his garments; and took a towel, and girded himself.", "words": [[0, 25680], [3, 25785], [9, 26185], [14, 26505], [22, 26865], [26, 27445], [31, 27665], [37, 28045], [41, 28285], [51, 29218], [55, 29373], [60, 29533], [62, 29693], [69, 30073], [73, 30308], [80, 30728]]}, {"verse": 5, "start": 31753, "end": 39298, "text": "After that he pours water into a basin, and began to wash the disciples’ feet, and to wipe them with the towel with which he was girded.", "words": [[0, 31753], [6, 32000], [11, 32260], [14, 32460], [20, 32860], [26, 33160], [31, 33440], [33, 33640], [40, 33960], [44, 34520], [50, 34820], [53, 35040], [58, 35340], [62, 35640], [73, 36080], [79, 36480], [83, 36725], [86, 36885], [91, 37105], [96, 37365], [101, 37545], [105, 37665], [111, 38025], [116, 38245], [122, 38465], [125, 38585], [129, 38745]]}, {"verse": 6, "start": 39648, "end": 44602, "text": "Then comes he to Simon Peter: and Peter says to him, Lord, do you wash my feet?", "words": [[0, 39648], [5, 39858], [11, 40198], [14, 40418], [17, 40618], [23, 40978], [30, 41874], [34, 41978], [40, 42238], [45, 42538], [48, 42758], [53, 43354], [59, 43672], [62, 43712], [66, 43772], [71, 43972], [74, 44152]]}, {"verse": 7, "start": 44882, "end": 50553, "text": "Jesus answered and said to him, What I do you know not now; but you shall know hereafter.", "words": [[0, 44882], [6, 45112], [15, 45672], [19, 45872], [24, 46092], [27, 46292], [32, 46829], [37, 46919], [39, 47119], [42, 47359], [46, 47539], [51, 47799], [55, 48059], [60, 48855], [64, 49055], [68, 49255], [74, 49495], [79, 49755]]}, {"verse": 8, "start": 50833, "end": 58979, "text": "Peter says to him, You shall never wash my feet. Jesus answered him, If I wash you not, you have no part with me.", "words": [[0, 50833], [6, 51013], [11, 51273], [14, 51513], [19, 52670], [23, 52816], [29, 53016], [35, 53396], [40, 53756], [43, 53916], [49, 54646], [55, 54918], [64, 55338], [69, 55926], [72, 56070], [74, 56250], [79, 56570], [83, 56750], [88, 57430], [92, 57710], [97, 57910], [100, 58110], [105, 58390], [110, 58610]]}, {"verse": 9, "start": 59259, "end": 64459, "text": "Simon Peter says to him, Lord, not my feet only, but also my hands and my head.", "words": [[0, 59259], [6, 59546], [12, 59786], [17, 60106], [20, 60306], [25, 60824], [31, 61185], [35, 61385], [38, 61665], [43, 61905], [49, 62605], [53, 62885], [58, 63245], [61, 63445], [67, 63745], [71, 63885], [74, 64065]]}, {"verse": 10, "start": 64739, "end": 73394, "text": "Jesus says to him, He that is washed needs not save to wash his feet, but is clean every whit: and you are clean, but not all.", "words": [[0, 64739], [6, 64994], [11, 65354], [14, 65594], [19, 66869], [22, 67038], [27, 67258], [30, 67378], [37, 67718], [43, 68038], [47, 68398], [52, 68758], [55, 68958], [60, 69198], [64, 69358], [70, 69858], [74, 70098], [77, 70238], [83, 70558], [89, 71013], [95, 71634], [99, 71754], [103, 71894], [107, 72014], [114, 72634], [118, 72794], [122, 72954]]}, {"verse": 11, "start": 73674, "end": 78442, "text": "For he knew who should betray him; therefore said he, You are not all clean.", "words": [[0, 73674], [4, 73792], [7, 73992], [12, 74272], [16, 74552], [23, 74732], [30, 75072], [35, 75712], [45, 76074], [50, 76414], [54, 77074], [58, 77254], [62, 77374], [66, 77654], [70, 77834]]}, {"verse": 12, "start": 78792, "end": 87739, "text": "So after he had washed their feet, and had taken his garments, and was set down again, he said to them, Do you know what I have done to you?", "words": [[0, 78792], [3, 79012], [9, 79432], [12, 79672], [16, 79772], [23, 80112], [29, 80452], [35, 80772], [39, 81272], [43, 81432], [49, 81732], [53, 81972], [63, 82332], [67, 82952], [71, 83112], [75, 83332], [80, 83612], [87, 84252], [90, 84352], [95, 84572], [98, 84752], [104, 85961], [107, 86059], [111, 86219], [116, 86439], [121, 86619], [123, 86779], [128, 86939], [133, 87139], [136, 87339]]}, {"verse": 13, "start": 88089, "end": 92483, "text": "You call me Master and Lord: and you say well; for so I am.", "words": [[0, 88089], [4, 88289], [9, 88509], [12, 88669], [19, 89109], [23, 89369], [29, 90133], [33, 90276], [37, 90416], [41, 90656], [47, 91445], [51, 91567], [54, 91787], [56, 92027]]}, {"verse": 14, "start": 92833, "end": 98617, "text": "If I then, your Lord and Master, have washed your feet; you also ought to wash one another’s feet.", "words": [[0, 92833], [3, 93094], [5, 93234], [11, 93574], [16, 93634], [21, 93874], [25, 94074], [33, 94834], [38, 94934], [45, 95274], [50, 95454], [56, 96156], [60, 96279], [65, 96659], [71, 96959], [74, 97159], [79, 97439], [83, 97719], [93, 98179]]}, {"verse": 15, "start": 98967, "end": 102719, "text": "For I have given you an example, that you should do as I have done to you.", "words": [[0, 98967], [4, 99057], [6, 99237], [11, 99397], [17, 99657], [21, 99837], [24, 99937], [33, 100397], [38, 100857], [42, 101037], [49, 101197], [52, 101437], [55, 101657], [57, 101817], [62, 101937], [67, 102137], [70, 102317]]}, {"verse": 16, "start": 103069, "end": 110233, "text": "Most assuredly, I say to you, The servant is not greater than his lord; neither he that is sent greater than he that sent him.", "words": [[0, 103069], [5, 103232], [16, 103872], [18, 103992], [22, 104212], [25, 104412], [30, 105012], [34, 105132], [42, 105452], [45, 105692], [49, 105932], [57, 106252], [62, 106512], [66, 106652], [72, 107385], [80, 107722], [83, 108022], [88, 108222], [91, 108382], [96, 108602], [104, 108902], [109, 109182], [112, 109362], [117, 109522], [122, 109762]]}, {"verse": 17, "start": 110583, "end": 114098, "text": "If you know these things, happy are you if you do them.", "words": [[0, 110583], [3, 110770], [7, 111030], [12, 111210], [18, 111450], [26, 112230], [32, 112550], [36, 112790], [40, 113070], [43, 113390], [47, 113550], [50, 113710]]}, {"verse": 18, "start": 114448, "end": 123310, "text": "¶ I speak not of you all: I know whom I have chosen: but that the scripture may be fulfilled, He that eats bread with me has lifted up his heel against me.", "words": [[2, 114448], [4, 114607], [10, 114867], [14, 115127], [17, 115307], [21, 115427], [26, 116050], [28, 116233], [33, 116453], [38, 116693], [40, 116833], [45, 116973], [53, 117780], [57, 117952], [62, 118152], [66, 118292], [76, 118612], [80, 118912], [83, 119052], [94, 120132], [97, 120312], [102, 120572], [107, 120792], [113, 121092], [118, 121292], [121, 121492], [125, 121672], [132, 121972], [135, 122172], [139, 122332], [144, 122592], [152, 122932]]}, {"verse": 19, "start": 123660, "end": 130346, "text": "Now I tell you before it come, that, when it is come to pass, you may believe that I am he.", "words": [[0, 123660], [4, 123960], [6, 124340], [11, 124580], [15, 124820], [22, 125160], [25, 125360], [31, 126180], [37, 126520], [42, 127080], [45, 127220], [48, 127340], [53, 127560], [56, 127720], [62, 128500], [66, 128620], [70, 128820], [78, 129260], [83, 129560], [85, 129840], [88, 130000]]}, {"verse": 20, "start": 130696, "end": 138495, "text": "Most assuredly, I say to you, He that receives whomsoever I send receives me; and he that receives me receives him that sent me.", "words": [[0, 130696], [5, 130859], [16, 131499], [18, 131639], [22, 131879], [25, 132079], [30, 132619], [33, 132859], [38, 133266], [47, 133672], [58, 134079], [60, 134279], [65, 134789], [74, 135299], [78, 135826], [82, 135945], [85, 136085], [90, 136375], [99, 136665], [102, 136965], [111, 137265], [115, 137525], [120, 137905], [125, 138145]]}, {"verse": 21, "start": 138775, "end": 147166, "text": "When Jesus had thus said, he was troubled in spirit, and testified, and said, Most assuredly, I say to you, that one of you shall betray me.", "words": [[0, 138775], [5, 138902], [11, 139222], [15, 139522], [20, 139722], [26, 140222], [29, 140322], [33, 140482], [42, 140822], [45, 141062], [53, 141462], [57, 141722], [68, 142122], [72, 142662], [78, 143305], [83, 143488], [94, 144188], [96, 144308], [100, 144548], [103, 144728], [108, 144948], [113, 145488], [117, 145768], [120, 145928], [124, 146108], [130, 146368], [137, 146728]]}, {"verse": 22, "start": 147446, "end": 151488, "text": "Then the disciples looked one on another, doubting of whom he spoke.", "words": [[0, 147446], [5, 147707], [9, 147887], [19, 148347], [26, 148707], [30, 149007], [33, 149207], [42, 149947], [51, 150407], [54, 150587], [59, 150747], [62, 150907]]}, {"verse": 23, "start": 151838, "end": 157184, "text": "Now there was leaning on Jesus’ bosom one of his disciples, whom Jesus loved.", "words": [[0, 151838], [4, 152087], [10, 152267], [14, 152447], [22, 152747], [25, 152987], [32, 153547], [38, 154087], [42, 154167], [45, 154327], [49, 154467], [60, 155407], [65, 155507], [71, 155807]]}, {"verse": 24, "start": 157534, "end": 162760, "text": "Simon Peter therefore beckoned to him, that he should ask who it should be of whom he spoke.", "words": [[0, 157534], [6, 157794], [12, 158214], [22, 158694], [31, 159254], [34, 159434], [39, 159654], [44, 160114], [47, 160254], [54, 160434], [58, 160754], [62, 160994], [65, 161134], [72, 161354], [75, 161614], [78, 161814], [83, 162014], [86, 162214]]}, {"verse": 25, "start": 163110, "end": 166776, "text": "He then lying on Jesus’ breast says to him, Lord, who is it?", "words": [[0, 163110], [3, 163221], [8, 163401], [14, 163801], [17, 164041], [24, 164581], [31, 164881], [36, 165261], [39, 165481], [44, 166022], [50, 166414], [54, 166434], [57, 166614]]}, {"verse": 26, "start": 167056, "end": 178716, "text": "Jesus answered, He it is, to whom I shall give a piece of bread, when I have dipped it. And when he had dipped the piece of bread, he gave it to Judas Iscariot, the son of Simon.", "words": [[0, 167056], [6, 167334], [16, 168304], [19, 168532], [22, 168912], [26, 169312], [29, 169592], [34, 169812], [36, 170132], [42, 170332], [47, 170592], [49, 170772], [55, 170992], [58, 171172], [65, 171552], [70, 171932], [72, 172112], [77, 172212], [84, 172472], [88, 173076], [92, 173224], [97, 173384], [100, 173604], [104, 173784], [111, 173984], [115, 174204], [121, 174464], [124, 174604], [131, 175324], [134, 175504], [139, 175744], [142, 175924], [145, 176044], [151, 176424], [161, 177484], [165, 177584], [169, 177844], [172, 177944]]}, {"verse": 27, "start": 179066, "end": 185211, "text": "And after the piece of bread Satan entered into him. Then said Jesus to him, That you do, do quickly.", "words": [[0, 179066], [4, 179306], [10, 179606], [14, 179786], [20, 180046], [23, 180206], [29, 180446], [35, 180886], [43, 181306], [48, 181666], [53, 182260], [58, 182465], [63, 182745], [69, 183065], [72, 183405], [77, 184024], [82, 184094], [86, 184254], [90, 184454], [93, 184634]]}, {"verse": 28, "start": 185491, "end": 188934, "text": "Now no man at the table knew for what intent he spoke this to him.", "words": [[0, 185491], [4, 185741], [7, 185981], [11, 186221], [14, 186401], [18, 186481], [24, 186761], [29, 187041], [33, 187261], [38, 187461], [45, 187661], [48, 187941], [54, 188201], [59, 188441], [62, 188641]]}, {"verse": 29, "start": 189284, "end": 199853, "text": "For some of them thought, because Judas had the bag, that Jesus had said to him, Buy those things that we have need of against the feast; or, that he should give something to the poor.", "words": [[0, 189284], [4, 189411], [9, 189631], [12, 189771], [17, 189931], [26, 190671], [34, 190951], [40, 191291], [44, 191651], [48, 191791], [53, 192111], [58, 192436], [64, 192696], [68, 193016], [73, 193216], [76, 193436], [81, 193896], [85, 194356], [91, 194616], [98, 194956], [103, 195216], [106, 195376], [111, 195556], [116, 195776], [119, 196116], [127, 196496], [131, 196776], [138, 197551], [142, 197674], [147, 197854], [150, 198074], [157, 198274], [162, 198514], [172, 198934], [175, 199214], [179, 199334]]}, {"verse": 30, "start": 200203, "end": 204712, "text": "He then having received the piece of bread went immediately out: and it was night.", "words": [[0, 200203], [3, 200310], [8, 200670], [15, 200850], [24, 201330], [28, 201590], [34, 201850], [37, 201990], [43, 202470], [48, 202570], [60, 203030], [65, 203825], [69, 203964], [72, 204044], [76, 204204]]}, {"verse": 31, "start": 205062, "end": 212448, "text": "¶ Therefore, when he was gone out, Jesus said, Now is the Son of man glorified, and God is glorified in him.", "words": [[2, 205062], [13, 205690], [18, 205770], [21, 205890], [25, 206030], [30, 206250], [35, 206710], [41, 206950], [47, 207733], [51, 207998], [54, 208338], [58, 208498], [62, 208758], [65, 208898], [69, 209218], [80, 210558], [84, 210658], [88, 210998], [91, 211218], [101, 211898], [104, 212178]]}, {"verse": 32, "start": 212798, "end": 219670, "text": "If God be glorified in him, God shall also glorify him in himself, and shall immediately glorify him.", "words": [[0, 212798], [3, 212934], [7, 213214], [10, 213374], [20, 213994], [23, 214254], [28, 214854], [32, 215054], [38, 215314], [43, 215674], [51, 216334], [55, 216594], [58, 216814], [67, 217254], [71, 217794], [77, 218014], [89, 218494], [97, 219314]]}, {"verse": 33, "start": 220020, "end": 228298, "text": "Little children, yet a little while I am with you. You shall seek me: and as I said to the Jews, Where I go, you cannot come; so now I say to you.", "words": [[0, 220020], [7, 220223], [17, 220603], [21, 221303], [23, 221383], [30, 221563], [36, 221783], [38, 222023], [41, 222143], [46, 222323], [51, 222885], [55, 223006], [61, 223186], [66, 223426], [70, 224012], [74, 224153], [77, 224313], [79, 224453], [84, 224633], [87, 224773], [91, 224893], [97, 225393], [103, 225493], [105, 225613], [109, 226013], [113, 226093], [120, 226313], [126, 227144], [129, 227269], [133, 227429], [135, 227609], [139, 227789], [142, 227969]]}, {"verse": 34, "start": 228648, "end": 235531, "text": "A new commandment I give to you, That you love one another; as I have loved you, that you also love one another.", "words": [[0, 228648], [2, 228772], [6, 228972], [18, 229652], [20, 229772], [25, 229992], [28, 230192], [33, 230452], [38, 230932], [42, 231132], [47, 231432], [51, 231632], [60, 232378], [63, 232546], [65, 232746], [70, 232906], [76, 233166], [81, 233426], [86, 233926], [90, 234086], [95, 234466], [100, 234826], [104, 234986]]}, {"verse": 35, "start": 235881, "end": 241277, "text": "By this shall all men know that you are my disciples, if you have love one to another.", "words": [[0, 235881], [3, 236011], [8, 236431], [14, 236891], [18, 237191], [22, 237431], [27, 237771], [32, 237991], [36, 238171], [40, 238291], [43, 238451], [54, 239311], [57, 239731], [61, 239891], [66, 240131], [71, 240371], [75, 240591], [78, 240791]]}, {"verse": 36, "start": 241557, "end": 250483, "text": "¶ Simon Peter said to him, Lord, where are you going? Jesus answered him, Where I go, you can not follow me now; but you shall follow me afterwards.", "words": [[2, 241557], [8, 241848], [14, 242108], [19, 242408], [22, 242588], [27, 243155], [33, 243822], [39, 243982], [43, 244142], [47, 244262], [54, 244948], [60, 245220], [69, 245640], [74, 246228], [80, 246370], [82, 246610], [86, 247030], [90, 247137], [94, 247243], [98, 247350], [105, 247790], [108, 247970], [113, 248601], [117, 248697], [121, 248897], [127, 249117], [134, 249457], [137, 249677]]}, {"verse": 37, "start": 250763, "end": 256526, "text": "Peter said to him, Lord, why cannot I follow you now? I will lay down my life for your sake.", "words": [[0, 250763], [6, 250943], [11, 251223], [14, 251443], [19, 251941], [25, 252381], [29, 252521], [36, 252801], [38, 253021], [45, 253261], [49, 253461], [54, 254161], [56, 254296], [61, 254436], [65, 254616], [70, 254816], [73, 255016], [78, 255316], [82, 255516], [87, 255676]]}, {"verse": 38, "start": 256806, "end": 265840, "text": "Jesus answered him, Will you lay down your life for my sake? Most assuredly, I say to you, The rooster shall not crow, till you have denied me three times.", "words": [[0, 256806], [6, 257079], [15, 257499], [20, 258087], [25, 258235], [29, 258395], [33, 258615], [38, 258835], [43, 258995], [48, 259275], [52, 259475], [55, 259655], [61, 260415], [66, 260611], [77, 261251], [79, 261391], [83, 261591], [86, 261771], [91, 262331], [95, 262451], [103, 262831], [109, 263111], [113, 263331], [119, 263671], [124, 264071], [128, 264231], [133, 264371], [140, 264691], [143, 264931], [149, 265151]]}]}