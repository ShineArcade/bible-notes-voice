{"book": "PSA", "chapter": 22, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 193531, "verses": [{"verse": 1, "start": 300, "end": 8365, "text": "My God, my God, why have you forsaken me? why are you so far from helping me, and from the words of my roaring?", "words": [[0, 300], [3, 450], [8, 1230], [11, 1430], [16, 2410], [20, 2690], [25, 2910], [29, 3089], [38, 3669], [42, 4385], [46, 4612], [50, 4772], [54, 4932], [57, 5132], [61, 5432], [66, 5652], [74, 5952], [78, 6292], [82, 6612], [87, 6792], [91, 6952], [97, 7272], [100, 7452], [103, 7632]]}, {"verse": 2, "start": 8815, "end": 14832, "text": "O my God, I cry in the daytime, but you hear not; and in the night season, and am not silent.", "words": [[0, 8888], [2, 8998], [5, 9198], [10, 9658], [12, 9718], [16, 9998], [19, 10218], [23, 10318], [32, 10998], [36, 11098], [40, 11278], [45, 11478], [50, 12303], [54, 12465], [57, 12605], [61, 12705], [67, 12905], [75, 13325], [79, 13625], [82, 13925], [86, 14125]]}, {"verse": 3, "start": 15282, "end": 19015, "text": "But you are holy, O you that inhabit the praises of Israel.", "words": [[0, 15282], [4, 15446], [8, 15646], [12, 15786], [18, 16386], [20, 16486], [24, 17126], [29, 17246], [37, 17566], [41, 17826], [49, 18206], [52, 18406]]}, {"verse": 4, "start": 19465, "end": 23548, "text": "Our fathers trusted in you: they trusted, and you did deliver them.", "words": [[0, 19465], [4, 19603], [12, 20003], [20, 20523], [23, 20823], [28, 21430], [33, 21593], [42, 22033], [46, 22413], [50, 22573], [54, 22773], [62, 23153]]}, {"verse": 5, "start": 23998, "end": 28580, "text": "They cried to you, and were delivered: they trusted in you, and were not confounded.", "words": [[0, 23998], [5, 24099], [11, 24419], [14, 24719], [19, 24899], [23, 25159], [28, 25279], [39, 26209], [44, 26317], [52, 26717], [55, 26997], [60, 27197], [64, 27417], [69, 27537], [73, 27697]]}, {"verse": 6, "start": 29030, "end": 33984, "text": "But I am a worm, and no man; a reproach of men, and despised of the people.", "words": [[0, 29030], [4, 29175], [6, 29375], [9, 29535], [11, 29635], [17, 29975], [21, 30235], [24, 30475], [29, 31356], [31, 31454], [40, 31974], [43, 32074], [48, 32394], [52, 32634], [61, 33234], [64, 33374], [68, 33474]]}, {"verse": 7, "start": 34434, "end": 40942, "text": "All they that see me laugh me to scorn: they shoot out the lip, they shake the head, saying,", "words": [[0, 34434], [4, 34834], [9, 35094], [14, 35414], [18, 35714], [21, 35874], [27, 36154], [30, 36374], [33, 36534], [40, 37466], [45, 37575], [51, 37835], [55, 38035], [59, 38195], [64, 38735], [69, 38955], [75, 39235], [79, 39455], [85, 39695]]}, {"verse": 8, "start": 41192, "end": 46498, "text": "He trusted on the LORD that he would deliver him: let him deliver him, seeing he delighted in him.", "words": [[0, 41192], [3, 41275], [11, 41655], [14, 41895], [18, 41995], [23, 42255], [28, 42435], [31, 42595], [37, 42755], [45, 43095], [50, 43792], [54, 43978], [58, 44198], [66, 44558], [71, 44818], [78, 45338], [81, 45558], [91, 45958], [94, 46198]]}, {"verse": 9, "start": 46848, "end": 52571, "text": "But you are he that took me out of the womb: you did make me hope when I was upon my mother’s breasts.", "words": [[0, 46848], [4, 46946], [8, 47166], [12, 47346], [15, 47586], [20, 47846], [25, 48046], [28, 48226], [32, 48386], [35, 48486], [39, 48586], [45, 49470], [49, 49639], [53, 49819], [58, 50039], [61, 50219], [66, 50499], [71, 50719], [73, 50859], [77, 50999], [82, 51259], [85, 51499], [94, 51899]]}, {"verse": 10, "start": 53021, "end": 57802, "text": "I was cast upon you from the womb: you are my God from my mother’s belly.", "words": [[0, 53021], [2, 53120], [6, 53280], [11, 53560], [16, 53880], [20, 54120], [25, 54260], [29, 54420], [35, 55239], [39, 55452], [43, 55712], [46, 55892], [50, 56252], [55, 56552], [58, 56792], [67, 57292]]}, {"verse": 11, "start": 58252, "end": 63357, "text": "Be not far from me; for trouble is near; for there is none to help.", "words": [[0, 58252], [3, 58441], [7, 58681], [11, 59021], [16, 59261], [20, 60052], [24, 60173], [32, 60533], [35, 60793], [41, 61752], [45, 61878], [51, 62078], [54, 62278], [59, 62558], [62, 62818]]}, {"verse": 12, "start": 63807, "end": 68684, "text": "Many bulls have compassed me: strong bulls of Bashan have beset me round.", "words": [[0, 63807], [5, 64072], [11, 64672], [16, 64772], [26, 65352], [30, 65886], [37, 66086], [43, 66666], [46, 67026], [53, 67386], [58, 67586], [64, 68006], [67, 68146]]}, {"verse": 13, "start": 69134, "end": 73174, "text": "They gaped upon me with their mouths, as a ravening and a roaring lion.", "words": [[0, 69134], [5, 69238], [11, 69658], [16, 69798], [19, 70078], [24, 70278], [30, 70398], [38, 70798], [41, 71178], [43, 71278], [52, 71898], [56, 72058], [58, 72158], [66, 72478]]}, {"verse": 14, "start": 73624, "end": 82030, "text": "I am poured out like water, and all my bones are out of joint: my heart is like wax; it is melted in the midst of my bowels.", "words": [[0, 73624], [2, 73831], [5, 73971], [12, 74271], [16, 74491], [21, 74751], [28, 75191], [32, 75791], [36, 76011], [39, 76191], [45, 76551], [49, 76791], [53, 76951], [56, 77091], [63, 77954], [66, 78102], [72, 78382], [75, 78562], [80, 78762], [85, 79731], [88, 79839], [91, 79959], [98, 80319], [101, 80559], [105, 80639], [111, 80899], [114, 81099], [117, 81259]]}, {"verse": 15, "start": 82480, "end": 89846, "text": "My strength is dried up like a potsherd; and my tongue clings to my jaws; and you have brought me into the dust of death.", "words": [[0, 82480], [3, 82606], [12, 83006], [15, 83286], [21, 83566], [24, 83786], [29, 84006], [31, 84449], [41, 85193], [45, 85310], [48, 85470], [55, 85850], [62, 86350], [65, 86510], [68, 86650], [74, 87671], [78, 87800], [82, 87920], [87, 88080], [95, 88340], [98, 88600], [103, 88800], [107, 88960], [112, 89280], [115, 89460]]}, {"verse": 16, "start": 90296, "end": 96569, "text": "For dogs have compassed me: the assembly of the wicked have inclosed me: they pierced my hands and my feet.", "words": [[0, 90296], [4, 90402], [9, 90742], [14, 91022], [24, 91622], [28, 92132], [32, 92227], [41, 92667], [44, 92927], [48, 93027], [55, 93307], [60, 93647], [69, 93987], [73, 94742], [78, 94843], [86, 95203], [89, 95383], [95, 95743], [99, 95943], [102, 96103]]}, {"verse": 17, "start": 97019, "end": 100523, "text": "I may tell all my bones: they look and stare upon me.", "words": [[0, 97019], [2, 97124], [6, 97244], [11, 97504], [15, 97724], [18, 97884], [25, 98830], [30, 99121], [35, 99361], [39, 99501], [45, 99801], [50, 100121]]}, {"verse": 18, "start": 100973, "end": 104984, "text": "They part my garments among them, and cast lots upon my vesture.", "words": [[0, 100973], [5, 101139], [10, 101399], [13, 101619], [22, 101939], [28, 102299], [34, 102599], [38, 103079], [43, 103419], [48, 103799], [53, 104079], [56, 104399]]}, {"verse": 19, "start": 105434, "end": 109870, "text": "But be not you far from me, O LORD: O my strength, hurry to help me.", "words": [[0, 105434], [4, 105563], [7, 105723], [11, 105923], [15, 106163], [19, 106443], [24, 106683], [28, 107063], [30, 107163], [36, 108055], [38, 108125], [41, 108305], [51, 109005], [57, 109165], [60, 109365], [65, 109525]]}, {"verse": 20, "start": 110320, "end": 114766, "text": "Deliver my soul from the sword; my darling from the power of the dog.", "words": [[0, 110320], [8, 110684], [11, 110864], [16, 111244], [21, 111544], [25, 111704], [32, 112544], [35, 112673], [43, 113053], [48, 113333], [52, 113493], [58, 113813], [61, 114053], [65, 114173]]}, {"verse": 21, "start": 115216, "end": 120443, "text": "Save me from the lion’s mouth: for you have heard me from the horns of the wild oxen.", "words": [[0, 115216], [5, 115500], [8, 115740], [13, 115920], [17, 116080], [24, 116560], [31, 117409], [35, 117513], [39, 117713], [44, 117893], [50, 118113], [53, 118333], [58, 118553], [62, 118753], [68, 119073], [71, 119293], [75, 119433], [80, 119733]]}, {"verse": 22, "start": 120893, "end": 126307, "text": "I will declare your name to my brethren: in the midst of the congregation will I praise you.", "words": [[0, 120893], [2, 121037], [7, 121197], [15, 121577], [20, 121837], [25, 122137], [28, 122317], [31, 122517], [41, 123533], [44, 123678], [48, 123778], [54, 124018], [57, 124218], [61, 124318], [74, 124938], [79, 125318], [81, 125498], [88, 125778]]}, {"verse": 23, "start": 126757, "end": 135257, "text": "You that fear the LORD, praise him; all you the seed of Jacob, glorify him; and fear him, all you the seed of Israel.", "words": [[0, 126757], [4, 126984], [9, 127244], [14, 127544], [18, 127764], [24, 128484], [31, 128684], [36, 129494], [40, 129672], [44, 129892], [48, 130052], [53, 130352], [56, 130492], [63, 131192], [71, 131872], [76, 132573], [80, 132720], [85, 133020], [90, 133680], [94, 133860], [98, 134040], [102, 134180], [107, 134460], [110, 134620]]}, {"verse": 24, "start": 135707, "end": 145640, "text": "For he has not despised nor abhorred the affliction of the afflicted; neither has he hid his face from him; but when he cried to him, he heard.", "words": [[0, 135707], [4, 135836], [7, 136056], [11, 136276], [15, 136556], [24, 137476], [28, 137836], [37, 138696], [41, 138836], [52, 139376], [55, 139676], [59, 139816], [70, 140768], [78, 141053], [82, 141413], [85, 141613], [89, 141873], [93, 142073], [98, 142373], [103, 142673], [108, 143341], [112, 143448], [117, 143648], [120, 143808], [126, 144128], [129, 144408], [134, 144948], [137, 145088]]}, {"verse": 25, "start": 146090, "end": 152268, "text": "My praise shall be of you in the great congregation: I will pay my vows before them that fear him.", "words": [[0, 146090], [3, 146236], [10, 146636], [16, 147016], [19, 147216], [22, 147436], [26, 147696], [29, 148016], [33, 148116], [39, 148356], [53, 149673], [55, 149790], [60, 149930], [64, 150150], [67, 150330], [72, 150710], [79, 151030], [84, 151410], [89, 151650], [94, 151890]]}, {"verse": 26, "start": 152718, "end": 159621, "text": "The meek shall eat and be satisfied: they shall praise the LORD that seek him: your heart shall live for ever.", "words": [[0, 152718], [4, 152820], [9, 153100], [15, 153340], [19, 153640], [23, 153880], [26, 154040], [37, 155181], [42, 155312], [48, 155532], [55, 155892], [59, 156152], [64, 156472], [69, 156872], [74, 157112], [79, 157900], [84, 158026], [90, 158326], [96, 158586], [101, 158952], [105, 159318]]}, {"verse": 27, "start": 160071, "end": 167563, "text": "All the ends of the world shall remember and turn to the LORD: and all the kindreds of the nations shall worship before you.", "words": [[0, 160071], [4, 160396], [8, 160576], [13, 160876], [16, 161036], [20, 161156], [26, 161476], [32, 161736], [41, 162196], [45, 162616], [50, 163016], [53, 163276], [57, 163416], [63, 164197], [67, 164321], [71, 164621], [75, 164781], [84, 165381], [87, 165441], [91, 165661], [99, 165881], [105, 166241], [113, 166661], [120, 167101]]}, {"verse": 28, "start": 168013, "end": 171994, "text": "For the kingdom is the LORD’s: and he is the governor among the nations.", "words": [[0, 168013], [4, 168119], [8, 168219], [16, 168539], [19, 168799], [23, 168959], [31, 169868], [35, 169985], [38, 170125], [41, 170285], [45, 170425], [54, 170725], [60, 171065], [64, 171265]]}, {"verse": 29, "start": 172444, "end": 181442, "text": "All they that be fat upon earth shall eat and worship: all they that go down to the dust shall bow before him: and none can keep alive his own soul.", "words": [[0, 172444], [4, 172655], [9, 172835], [14, 173015], [17, 173175], [21, 173475], [26, 173775], [32, 174095], [38, 174415], [42, 174715], [46, 174975], [55, 175800], [59, 176005], [64, 176205], [69, 176365], [72, 176545], [77, 176785], [80, 176965], [84, 177085], [89, 177405], [95, 177785], [99, 178065], [106, 178405], [111, 179194], [115, 179344], [120, 179604], [124, 179864], [129, 180104], [135, 180444], [139, 180704], [143, 180884]]}, {"verse": 30, "start": 181892, "end": 186227, "text": "A seed shall serve him; it shall be accounted to the Lord for a generation.", "words": [[0, 181892], [2, 181984], [7, 182264], [13, 182564], [19, 182904], [24, 183544], [27, 183649], [33, 183829], [36, 184009], [46, 184409], [49, 184669], [53, 184809], [58, 185049], [62, 185329], [64, 185469]]}, {"verse": 31, "start": 186677, "end": 193131, "text": "They shall come, and shall declare his righteousness to a people that shall be born, that he has done this.", "words": [[0, 186677], [5, 186775], [11, 187015], [17, 187395], [21, 187735], [27, 187975], [35, 188415], [39, 188695], [53, 189275], [56, 189675], [58, 189815], [65, 190135], [70, 190435], [76, 190695], [79, 190875], [85, 191755], [90, 191955], [93, 192115], [97, 192335], [102, 192595]]}]}