{"book": "PSA", "chapter": 44, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 170971, "verses": [{"verse": 1, "start": 300, "end": 14508, "text": "Al Músico principal: de los hijos de Coré: Masquil. OH Dios, con nuestros oídos hemos oído, nuestros padres nos han contado, la obra que hiciste en sus días, en los tiempos antiguos.", "words": [[0, 300], [3, 470], [10, 950], [21, 2004], [24, 2130], [28, 2270], [34, 2530], [37, 2875], [43, 3397], [52, 4540], [55, 4709], [61, 5309], [65, 5429], [74, 5789], [80, 6589], [86, 6849], [92, 8009], [101, 8349], [108, 8669], [112, 9149], [116, 9369], [125, 9989], [128, 10389], [133, 10769], [137, 11049], [145, 11689], [148, 11849], [152, 12029], [158, 12949], [161, 13109], [165, 13229], [173, 13729]]}, {"verse": 2, "start": 14858, "end": 21429, "text": "Tú con tu mano echaste las naciones, y los plantaste a ellos; afligiste los pueblos, y los arrojaste.", "words": [[0, 14858], [3, 15044], [7, 15344], [10, 15484], [15, 15704], [23, 16124], [27, 16324], [37, 17004], [39, 17309], [43, 17449], [53, 18009], [55, 18129], [62, 18954], [72, 19496], [76, 19656], [85, 20216], [87, 20366], [91, 20516]]}, {"verse": 3, "start": 21779, "end": 32985, "text": "Porque no se apoderaron de la tierra por su espada, ni su brazo los libró; sino tu diestra, y tu brazo, y la luz de tu rostro, porque te complaciste en ellos.", "words": [[0, 21779], [7, 21960], [10, 22140], [13, 22320], [24, 23080], [27, 23260], [30, 23400], [37, 23760], [41, 24040], [44, 24220], [52, 24601], [55, 24982], [58, 25364], [64, 25745], [68, 25945], [75, 26784], [80, 27009], [83, 27209], [92, 27689], [94, 27809], [97, 27929], [104, 28829], [106, 29209], [109, 29329], [113, 29669], [116, 29989], [119, 30129], [127, 30869], [134, 31329], [137, 31529], [149, 32249], [152, 32449]]}, {"verse": 4, "start": 33335, "end": 37189, "text": "Tú, oh Dios, eres mi rey: manda salvación a Jacob.", "words": [[0, 33335], [4, 33667], [7, 34033], [13, 34400], [18, 34560], [21, 34940], [26, 35489], [32, 35758], [42, 36418], [44, 36678]]}, {"verse": 5, "start": 37539, "end": 45057, "text": "Por medio de ti sacudiremos a nuestros enemigos: en tu nombre atropellaremos a nuestros adversarios.", "words": [[0, 37539], [4, 37685], [10, 38065], [13, 38345], [16, 38767], [28, 39750], [30, 39890], [39, 40090], [49, 41373], [52, 41557], [55, 41777], [62, 42137], [77, 43237], [79, 43497], [88, 43717]]}, {"verse": 6, "start": 45407, "end": 50344, "text": "Porque no confiaré en mi arco, ni mi espada me salvará.", "words": [[0, 45407], [7, 45751], [10, 46371], [19, 47291], [22, 47531], [25, 47771], [31, 48631], [34, 48751], [37, 48891], [44, 49411], [47, 49591]]}, {"verse": 7, "start": 50694, "end": 55750, "text": "Pues tú nos has guardado de nuestros enemigos, y has avergonzado a los que nos aborrecían.", "words": [[0, 50694], [5, 50838], [8, 50978], [12, 51098], [16, 51258], [25, 51798], [28, 51958], [37, 52118], [47, 52938], [49, 53163], [53, 53323], [65, 54243], [67, 54363], [71, 54463], [75, 54583], [79, 54743]]}, {"verse": 8, "start": 56100, "end": 61915, "text": "En Dios nos gloriaremos todo tiempo, y para siempre alabaremos tu nombre. (Selah.)", "words": [[0, 56100], [3, 56340], [8, 56620], [12, 57140], [24, 57740], [29, 58000], [37, 58440], [39, 58660], [44, 58860], [52, 59300], [63, 60340], [66, 60540], [74, 61652]]}, {"verse": 9, "start": 62265, "end": 69059, "text": "Pero nos has desechado, y nos has hecho avergonzar; y no sales en nuestros ejércitos.", "words": [[0, 62265], [5, 62454], [9, 62674], [13, 62954], [24, 64094], [26, 64694], [30, 64834], [34, 65074], [40, 65474], [52, 66897], [54, 67097], [57, 67237], [63, 67497], [66, 67757], [75, 67957]]}, {"verse": 10, "start": 69408, "end": 75399, "text": "Nos hiciste retroceder del enemigo, y nos saquearon para sí los que nos aborrecían.", "words": [[0, 69408], [4, 69574], [12, 70274], [23, 71294], [27, 71494], [36, 72194], [38, 72594], [42, 72754], [52, 73554], [57, 73794], [60, 74054], [64, 74214], [68, 74354], [72, 74514]]}, {"verse": 11, "start": 75749, "end": 81187, "text": "Nos pusiste como a ovejas para comida, y nos esparciste entre las naciones.", "words": [[0, 75749], [4, 75875], [12, 76475], [17, 76795], [19, 76955], [26, 77495], [31, 77775], [39, 78315], [41, 78608], [45, 78900], [56, 79840], [62, 80160], [66, 80380]]}, {"verse": 12, "start": 81537, "end": 85987, "text": "Has vendido tu pueblo de balde, y no exigiste ningún precio.", "words": [[0, 81537], [4, 81763], [12, 82423], [15, 82563], [22, 82923], [25, 83283], [32, 83643], [34, 84103], [37, 84263], [46, 84963], [53, 85223]]}, {"verse": 13, "start": 86337, "end": 92026, "text": "Nos pusiste por vergüenza a nuestros vecinos, por burla y por burla a los que nos rodean.", "words": [[0, 86337], [4, 86482], [12, 87022], [16, 87302], [26, 87922], [28, 88062], [37, 88222], [46, 89102], [50, 89382], [56, 89822], [58, 90002], [62, 90202], [68, 90662], [70, 90802], [74, 90922], [78, 91062], [82, 91222]]}, {"verse": 14, "start": 92376, "end": 98388, "text": "Nos pusiste en objeto de burla entre las naciones; todos al vernos menean la cabeza.", "words": [[0, 92376], [4, 92521], [12, 93121], [15, 93341], [22, 93721], [25, 94001], [31, 94441], [37, 94701], [41, 94921], [51, 95929], [57, 96386], [60, 96686], [67, 97086], [74, 97626], [77, 97746]]}, {"verse": 15, "start": 98738, "end": 103949, "text": "Cada día mi vergüenza está delante de mí, y me cubre la confusión de mi rostro,", "words": [[0, 98738], [5, 98900], [9, 99340], [12, 99420], [22, 100040], [27, 100320], [35, 100800], [38, 100980], [42, 101200], [44, 101415], [47, 101555], [53, 102015], [56, 102155], [66, 102875], [69, 103055], [72, 103195]]}, {"verse": 16, "start": 104299, "end": 110298, "text": "Por la voz del que me vitupera y deshonra, por razón del enemigo y del que se venga.", "words": [[0, 104299], [4, 104441], [7, 104601], [11, 105001], [15, 105341], [19, 105521], [22, 105681], [31, 106341], [33, 106441], [43, 107601], [47, 107961], [53, 108341], [57, 108601], [65, 109161], [67, 109261], [71, 109421], [75, 109581], [78, 109741]]}, {"verse": 17, "start": 110648, "end": 116885, "text": "Todo esto nos ha venido, y no nos hemos olvidado de ti; y no hemos faltado a tu pacto.", "words": [[0, 110648], [5, 110790], [10, 111150], [14, 111370], [17, 111590], [25, 112150], [27, 112630], [30, 112790], [34, 112990], [40, 113190], [49, 113890], [52, 114050], [56, 114640], [58, 114787], [61, 114987], [67, 115347], [75, 116067], [77, 116167], [80, 116267]]}, {"verse": 18, "start": 117235, "end": 123003, "text": "No se ha vuelto atrás nuestro corazón, ni tampoco se han apartado nuestros pasos de tus caminos.", "words": [[0, 117235], [3, 117421], [6, 117621], [9, 117701], [16, 118041], [22, 118241], [30, 118521], [39, 119201], [42, 119881], [50, 120141], [53, 120501], [57, 120601], [66, 121181], [75, 121381], [81, 121961], [84, 122081], [88, 122201]]}, {"verse": 19, "start": 123353, "end": 129676, "text": "Cuando nos quebrantaste en el lugar de los dragones, y nos cubriste con sombra de muerte,", "words": [[0, 123353], [7, 123613], [11, 123913], [24, 125013], [27, 125533], [30, 125673], [36, 126013], [39, 126233], [43, 126373], [53, 127073], [55, 127433], [59, 127573], [68, 128173], [72, 128373], [79, 128853], [82, 128993]]}, {"verse": 20, "start": 130026, "end": 135774, "text": "Si nos hubiésemos olvidado del nombre de nuestro Dios, o alzado nuestras manos a dios ajeno,", "words": [[0, 130026], [3, 130189], [7, 130329], [18, 130949], [27, 131549], [31, 131769], [38, 132129], [41, 132309], [49, 132489], [55, 132969], [57, 133409], [64, 133989], [73, 134189], [79, 134729], [81, 134969], [86, 135129]]}, {"verse": 21, "start": 136124, "end": 140992, "text": "¿No pediría cuentas Dios de esto? porque él conoce los secretos del corazón.", "words": [[0, 136124], [4, 136229], [12, 136739], [20, 137249], [25, 137369], [28, 137609], [34, 138265], [41, 138762], [44, 138942], [51, 139362], [55, 139502], [64, 140082], [68, 140222]]}, {"verse": 22, "start": 141342, "end": 147227, "text": "Pero por tu causa nos matan cada día; somos tenidos como ovejas para el matadero.", "words": [[0, 141342], [5, 141508], [9, 141768], [12, 141968], [18, 142318], [22, 142668], [28, 143168], [33, 143368], [38, 144165], [44, 144363], [52, 144883], [57, 145143], [64, 145923], [69, 146223], [72, 146363]]}, {"verse": 23, "start": 147577, "end": 152507, "text": "Despierta; ¿por qué duermes, Señor? Despierta, no te alejes para siempre.", "words": [[0, 147577], [11, 148667], [16, 148927], [20, 149197], [29, 149467], [36, 150480], [47, 150715], [50, 150950], [53, 151185], [60, 151505], [65, 151745]]}, {"verse": 24, "start": 152857, "end": 159370, "text": "¿Por qué escondes tu rostro, y te olvidas de nuestra aflicción, y de la opresión nuestra?", "words": [[0, 152857], [5, 153000], [9, 153280], [18, 154060], [21, 154180], [29, 155300], [31, 155520], [34, 155660], [42, 156180], [45, 156300], [53, 156480], [64, 157380], [66, 157715], [69, 157815], [72, 157955], [81, 158555]]}, {"verse": 25, "start": 159720, "end": 165732, "text": "Porque nuestra alma está agobiada hasta el polvo: nuestro vientre está pegado con la tierra.", "words": [[0, 159720], [7, 159925], [15, 160225], [20, 160625], [25, 160925], [34, 161665], [40, 161985], [43, 162484], [50, 163144], [58, 163372], [66, 163992], [71, 164332], [78, 164792], [82, 164952], [85, 165112]]}, {"verse": 26, "start": 166082, "end": 170571, "text": "Levántate para ayudarnos, y redímenos por tu misericordia.", "words": [[0, 166082], [10, 166787], [15, 167107], [26, 168127], [28, 168342], [38, 169062], [42, 169262], [45, 169462]]}]}