{"book": "LUK", "chapter": 19, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 352718, "verses": [{"verse": 1, "start": 300, "end": 3625, "text": "Y habiendo entrado Jesús, iba pasando por Jericó;", "words": [[0, 300], [2, 429], [11, 749], [19, 1189], [26, 1929], [30, 2269], [38, 2669], [42, 2969]]}, {"verse": 2, "start": 3975, "end": 11520, "text": "Y he aquí un varón llamado Zaqueo, el cual era el jefe de los recaudadores de impuestos, y era rico;", "words": [[0, 3975], [2, 4235], [5, 4455], [10, 4735], [13, 4975], [19, 5435], [27, 6145], [35, 6855], [38, 6895], [43, 7135], [47, 7795], [50, 8095], [55, 8575], [58, 8715], [62, 8855], [75, 9775], [78, 9975], [89, 10535], [91, 10755], [95, 10915]]}, {"verse": 3, "start": 11870, "end": 19310, "text": "Y procuraba ver a Jesús quién fuese; pero no podía a causa de la multitud, porque era pequeño de estatura.", "words": [[0, 11870], [2, 11979], [12, 12599], [16, 12819], [18, 12919], [24, 13219], [30, 13619], [37, 14574], [42, 14869], [45, 15029], [51, 15469], [53, 15749], [59, 16029], [62, 16309], [65, 16389], [75, 17249], [82, 17789], [86, 18009], [94, 18369], [97, 18629]]}, {"verse": 4, "start": 19660, "end": 26883, "text": "Y corriendo delante, se subió a un árbol sicómoro para verle; porque había de pasar por allí.", "words": [[0, 19660], [2, 19783], [12, 20303], [21, 20843], [24, 21263], [30, 21763], [32, 21963], [35, 22143], [41, 22983], [50, 23823], [55, 24123], [62, 25074], [69, 25298], [75, 25578], [78, 25758], [84, 26078], [88, 26398]]}, {"verse": 5, "start": 27233, "end": 38960, "text": "Y cuando vino a aquel lugar Jesús, mirando, le vio, y le dijo: Zaqueo, date prisa, desciende, porque hoy es necesario que me hospede en tu casa.", "words": [[0, 27233], [2, 27467], [9, 27674], [14, 27880], [16, 28087], [22, 28567], [28, 28807], [35, 29747], [44, 30547], [47, 30747], [52, 31067], [54, 31587], [57, 31727], [63, 32902], [71, 33382], [76, 33542], [83, 34402], [94, 35302], [101, 35542], [105, 35862], [108, 36162], [118, 36922], [122, 37422], [125, 37582], [133, 38042], [136, 38242], [139, 38362]]}, {"verse": 6, "start": 39310, "end": 43529, "text": "Entonces él descendió aprisa, y le recibió gozoso.", "words": [[0, 39310], [9, 40215], [12, 40447], [22, 41168], [30, 41890], [32, 41982], [35, 42142], [43, 42782]]}, {"verse": 7, "start": 43879, "end": 49966, "text": "Y viendo esto, todos murmuraban, diciendo que había entrado a hospedarse con un hombre pecador.", "words": [[0, 43879], [2, 44141], [9, 44401], [15, 44741], [21, 44981], [33, 46221], [42, 46681], [46, 46981], [52, 47161], [60, 47741], [62, 47861], [73, 48501], [77, 48761], [80, 48901], [87, 49181]]}, {"verse": 8, "start": 50316, "end": 62161, "text": "Entonces Zaqueo, puesto en pie, dijo al Señor: He aquí, Señor, la mitad de mis bienes doy a los pobres; y si en algo he defraudado a alguno, lo devuelvo cuadruplicado.", "words": [[0, 50316], [9, 51190], [17, 52100], [24, 52420], [27, 52780], [32, 53560], [37, 53920], [40, 54180], [47, 54944], [50, 55074], [56, 55374], [63, 56154], [66, 56334], [72, 56554], [75, 56794], [79, 56914], [86, 57334], [90, 57574], [92, 57614], [96, 57714], [104, 58589], [106, 58709], [109, 58849], [112, 58969], [117, 59189], [120, 59349], [131, 59619], [133, 59889], [141, 60569], [144, 60809], [153, 61289]]}, {"verse": 9, "start": 62441, "end": 70032, "text": "Y Jesús le dijo: Hoy ha venido la salvación a esta casa; por cuanto él también es hijo de Abraham.", "words": [[0, 62441], [2, 62567], [8, 62947], [11, 63367], [17, 64097], [21, 64365], [24, 64625], [31, 65025], [34, 65165], [44, 65825], [46, 65965], [51, 66125], [57, 66992], [61, 67136], [68, 67496], [71, 67876], [79, 68316], [82, 68716], [87, 69096], [90, 69316]]}, {"verse": 10, "start": 70382, "end": 74906, "text": "Porque el Hijo del hombre vino a buscar y a salvar lo que se había perdido.", "words": [[0, 70382], [7, 70627], [10, 70947], [15, 71227], [19, 71387], [26, 71687], [31, 71967], [33, 72127], [40, 72467], [42, 72727], [44, 72787], [51, 73227], [54, 73512], [58, 73652], [61, 73812], [67, 74052]]}, {"verse": 11, "start": 75256, "end": 87834, "text": "Y oyendo ellos estas cosas, prosiguió Jesús y dijo una parábola, por cuanto estaba cerca de Jerusalén, y porque pensaban que enseguida había de ser manifestado el reino de Dios.", "words": [[0, 75256], [2, 75398], [9, 75778], [15, 76118], [21, 76478], [28, 77358], [38, 77978], [44, 78358], [46, 78643], [51, 78923], [55, 79123], [65, 79743], [69, 80483], [76, 80803], [83, 81223], [89, 81563], [92, 81823], [103, 82623], [105, 82923], [112, 83183], [121, 83883], [125, 84343], [135, 85083], [141, 85403], [144, 85603], [148, 85803], [160, 86603], [163, 86743], [169, 87143], [172, 87283]]}, {"verse": 12, "start": 88184, "end": 95782, "text": "Dijo pues: Un hombre noble partió a una provincia lejos, para tomar para sí un reino, y volver.", "words": [[0, 88184], [5, 88572], [11, 89418], [14, 89585], [21, 89845], [27, 90245], [34, 90945], [36, 91165], [40, 91305], [50, 91945], [57, 92385], [62, 93025], [68, 93365], [73, 93625], [76, 93885], [79, 94085], [86, 94645], [88, 95205]]}, {"verse": 13, "start": 96132, "end": 103489, "text": "Pero llamados diez siervos suyos, les dio diez minas, y les dijo: Haced negocios entre tanto que vengo.", "words": [[0, 96132], [5, 96401], [14, 96881], [19, 97341], [27, 98301], [34, 99121], [38, 99301], [42, 99501], [47, 99821], [54, 100381], [56, 100481], [60, 100621], [66, 101500], [72, 101680], [81, 102200], [87, 102460], [93, 102800], [97, 103000]]}, {"verse": 14, "start": 103769, "end": 112729, "text": "Pero sus ciudadanos le aborrecían, y enviaron tras de él una delegación, diciendo: No queremos que este reine sobre nosotros.", "words": [[0, 103769], [5, 103933], [9, 104113], [20, 104893], [23, 105033], [35, 105793], [37, 106693], [46, 107193], [51, 107453], [54, 107733], [57, 107893], [61, 108193], [73, 109013], [83, 110331], [86, 110455], [95, 110735], [99, 111055], [104, 111365], [110, 111675], [116, 111915]]}, {"verse": 15, "start": 113009, "end": 125028, "text": "Y aconteció, que vuelto él, habiendo tomado el reino, mandó llamar a sí a aquellos siervos a los cuales había dado el dinero, para saber lo que había negociado cada uno.", "words": [[0, 113009], [2, 113132], [13, 113832], [17, 114132], [24, 114572], [28, 115212], [37, 115612], [44, 116152], [47, 116292], [54, 117432], [60, 117892], [67, 118119], [69, 118345], [72, 118572], [74, 118852], [83, 119172], [91, 119952], [93, 120292], [97, 120412], [104, 120632], [110, 120972], [115, 121252], [118, 121412], [126, 122251], [131, 122491], [137, 122911], [140, 123291], [144, 123431], [150, 123571], [160, 124191], [165, 124431]]}, {"verse": 16, "start": 125378, "end": 129837, "text": "Y vino el primero, diciendo: Señor, tu mina ha ganado diez minas.", "words": [[0, 125378], [2, 125518], [7, 125738], [10, 125898], [19, 126398], [29, 127572], [36, 127837], [39, 128137], [44, 128437], [47, 128617], [54, 128887], [59, 129157]]}, {"verse": 17, "start": 130117, "end": 136904, "text": "Y él le dice: Está bien, buen siervo; pues que en lo poco has sido fiel, tendrás autoridad sobre diez ciudades.", "words": [[0, 130117], [2, 130343], [5, 130523], [8, 130703], [14, 131481], [19, 131722], [25, 131902], [30, 132142], [38, 132940], [43, 133064], [47, 133244], [50, 133344], [53, 133464], [58, 133684], [62, 133904], [67, 134044], [73, 134704], [81, 135084], [91, 135584], [97, 135874], [102, 136164]]}, {"verse": 18, "start": 137184, "end": 141457, "text": "Y vino otro, diciendo: Señor, tu mina ha hecho cinco minas.", "words": [[0, 137184], [2, 137309], [7, 137569], [13, 138029], [23, 139138], [30, 139409], [33, 139715], [38, 140022], [41, 140222], [47, 140442], [53, 140742]]}, {"verse": 19, "start": 141737, "end": 146028, "text": "Y también a este dijo: Tú también gobierna sobre cinco ciudades.", "words": [[0, 141737], [2, 141841], [10, 142161], [12, 142401], [17, 142621], [23, 143448], [26, 143553], [34, 144083], [43, 144613], [49, 144853], [55, 145233]]}, {"verse": 20, "start": 146308, "end": 151916, "text": "Y vino otro, diciendo: Señor, he aquí tu mina, la cual he tenido guardada en un pañuelo:", "words": [[0, 146308], [2, 146432], [7, 146692], [13, 147152], [23, 148262], [30, 148530], [33, 148839], [38, 149147], [41, 149456], [47, 149764], [50, 149887], [55, 150067], [58, 150267], [65, 150507], [74, 151067], [77, 151187], [80, 151287]]}, {"verse": 21, "start": 152266, "end": 158237, "text": "Porque tuve miedo de ti, que eres hombre severo; tomas lo que no pusiste, y siegas lo que no sembraste.", "words": [[0, 152266], [7, 152441], [12, 152741], [18, 153001], [21, 153161], [25, 153421], [29, 153761], [34, 153921], [41, 154201], [49, 155042], [55, 155542], [58, 155642], [62, 155742], [65, 155862], [74, 156402], [76, 156772], [83, 157142], [86, 157302], [90, 157382], [93, 157502]]}, {"verse": 22, "start": 158517, "end": 166922, "text": "Entonces él le dijo: Mal siervo, de tu boca te juzgo. Sabías que yo era hombre severo, que tomo lo que no puse, y que siego lo que no sembré;", "words": [[0, 158517], [9, 159077], [12, 159562], [15, 159782], [21, 160528], [25, 160703], [33, 161083], [36, 161203], [39, 161323], [44, 161583], [47, 161763], [54, 162499], [61, 162836], [65, 162996], [68, 163136], [72, 163296], [79, 163556], [87, 164056], [91, 164156], [96, 164456], [99, 164496], [103, 164636], [106, 164756], [112, 165176], [114, 165536], [118, 165766], [124, 165996], [127, 166136], [131, 166256], [134, 166396]]}, {"verse": 23, "start": 167272, "end": 172627, "text": "¿Por qué, pues, no diste mi dinero al banco, y yo viniendo lo reclamara con los intereses?", "words": [[0, 167272], [5, 167395], [10, 167675], [16, 168255], [19, 168315], [25, 168675], [28, 168755], [35, 169055], [38, 169255], [45, 170035], [47, 170135], [50, 170255], [59, 170755], [62, 170895], [72, 171475], [76, 171635], [80, 171815]]}, {"verse": 24, "start": 172907, "end": 178270, "text": "Y dijo a los que estaban presentes: Quitadle la mina, y dadla al que tiene las diez minas.", "words": [[0, 172907], [2, 173012], [7, 173312], [9, 173452], [13, 173552], [17, 173692], [25, 173992], [36, 175425], [45, 175675], [48, 175815], [54, 176095], [56, 176385], [62, 176675], [65, 176915], [69, 177035], [75, 177275], [79, 177475], [84, 177675]]}, {"verse": 25, "start": 178550, "end": 181744, "text": "Y ellos le dijeron: Señor, tiene diez minas.", "words": [[0, 178550], [2, 178733], [8, 178953], [11, 179133], [20, 180032], [27, 180393], [33, 180793], [38, 181053]]}, {"verse": 26, "start": 182024, "end": 188598, "text": "Pues yo os digo que a todo el que tiene, se le dará; pero al que no tiene, aun lo que tiene se le quitará.", "words": [[0, 182024], [5, 182146], [8, 182366], [11, 182506], [16, 182726], [20, 182946], [22, 183066], [27, 183246], [30, 183446], [34, 183546], [41, 183906], [44, 184386], [47, 184526], [53, 185216], [58, 185360], [61, 185480], [65, 185620], [68, 185780], [75, 186680], [79, 186840], [82, 187080], [86, 187200], [92, 187520], [95, 187740], [98, 187880]]}, {"verse": 27, "start": 188818, "end": 195486, "text": "Y también a aquellos mis enemigos que no querían que yo reinase sobre ellos, traedlos acá, y degolladlos delante de mí.", "words": [[0, 188818], [2, 188904], [10, 189204], [12, 189384], [21, 189624], [25, 189904], [34, 190444], [38, 190644], [41, 190764], [49, 191144], [53, 191284], [56, 191404], [64, 191864], [70, 192144], [77, 192714], [86, 193284], [91, 193604], [93, 194094], [105, 194584], [113, 195044], [116, 195204]]}, {"verse": 28, "start": 195766, "end": 198862, "text": "Y dicho esto, iba delante subiendo a Jerusalén.", "words": [[0, 195766], [2, 195868], [8, 196148], [14, 196488], [18, 196918], [26, 197348], [35, 197948], [37, 198048]]}, {"verse": 29, "start": 199212, "end": 208150, "text": "Y aconteció, que llegando cerca de Betfagé, y de Betania, al monte que se llama de los Olivos, envió dos de sus discípulos,", "words": [[0, 199212], [2, 199319], [13, 200119], [17, 200539], [26, 201019], [32, 201399], [35, 201909], [44, 202419], [46, 202619], [49, 202739], [58, 203579], [61, 203679], [67, 203959], [71, 204159], [74, 204299], [80, 204579], [83, 204739], [87, 204839], [95, 205599], [101, 205979], [105, 206479], [108, 206919], [112, 207119]]}, {"verse": 30, "start": 208500, "end": 221189, "text": "Diciendo: Id a la aldea de enfrente; y al entrar en ella, hallaréis un burro joven atado, en el que ningún hombre se ha sentado jamás; desatadlo, y traedlo.", "words": [[0, 208500], [10, 209559], [13, 209679], [15, 209799], [18, 209959], [24, 210459], [27, 210639], [37, 211703], [39, 211840], [42, 211940], [49, 212360], [52, 212600], [58, 213380], [68, 214060], [71, 214220], [77, 214620], [83, 215040], [90, 215540], [93, 216000], [96, 216120], [100, 216260], [107, 216680], [114, 217160], [117, 217420], [120, 217560], [128, 218080], [135, 219012], [146, 219977], [148, 220297]]}, {"verse": 31, "start": 221539, "end": 228323, "text": "Y si alguien os pregunta, ¿por qué lo desatáis? le responderéis así: Porque el Señor lo necesita.", "words": [[0, 221539], [2, 221664], [5, 221744], [13, 221994], [16, 222244], [26, 223064], [31, 223464], [35, 223684], [38, 224182], [48, 224875], [51, 225298], [64, 225758], [69, 226431], [76, 226657], [79, 226817], [85, 227157], [88, 227477]]}, {"verse": 32, "start": 228673, "end": 232474, "text": "Y fueron los que habían sido enviados, y hallaron como les dijo.", "words": [[0, 228673], [2, 228779], [9, 229019], [13, 229219], [17, 229379], [24, 229639], [29, 229919], [39, 230559], [41, 230979], [50, 231459], [55, 231699], [59, 231899]]}, {"verse": 33, "start": 232694, "end": 238630, "text": "Y desatando ellos el burro joven, sus dueños les dijeron: ¿Por qué desatáis el burro joven?", "words": [[0, 232694], [2, 232796], [12, 233456], [18, 233736], [21, 233956], [27, 234296], [34, 235176], [38, 235296], [45, 235816], [49, 235956], [58, 236786], [63, 236925], [67, 237125], [76, 237725], [79, 237865], [85, 238165]]}, {"verse": 34, "start": 238910, "end": 243107, "text": "Y ellos dijeron: Porque el Señor lo necesita.", "words": [[0, 238910], [2, 239076], [8, 239256], [17, 240249], [24, 240509], [27, 240689], [33, 240949], [36, 241209]]}, {"verse": 35, "start": 243387, "end": 250686, "text": "Y lo trajeron a Jesús; y habiendo echado sus vestidos sobre el burro joven, pusieron a Jesús encima.", "words": [[0, 243387], [2, 243511], [5, 243611], [14, 244231], [16, 244311], [23, 245173], [25, 245427], [34, 245787], [41, 246267], [45, 246467], [54, 247067], [60, 247387], [63, 247587], [69, 248007], [76, 248707], [85, 249267], [87, 249407], [93, 249687]]}, {"verse": 36, "start": 251036, "end": 253952, "text": "Y yendo él tendían sus capas por el camino.", "words": [[0, 251036], [2, 251162], [8, 251502], [11, 251722], [19, 252262], [23, 252502], [29, 253002], [33, 253182], [36, 253322]]}, {"verse": 37, "start": 254302, "end": 267526, "text": "Y como llegasen ya cerca de la bajada del monte de los Olivos, toda la multitud de los discípulos, gozándose, comenzaron a alabar a Dios a gran voz por todas las maravillas que habían visto,", "words": [[0, 254302], [2, 254386], [7, 254626], [16, 255186], [19, 255366], [25, 255666], [28, 255906], [31, 256006], [38, 256406], [42, 256586], [48, 256906], [51, 257126], [55, 257246], [63, 258206], [68, 258566], [71, 259036], [80, 259506], [83, 259746], [87, 259886], [99, 261131], [110, 262241], [121, 262825], [123, 263145], [130, 263565], [132, 263645], [137, 263825], [139, 264065], [144, 264245], [148, 264565], [152, 265145], [158, 265485], [162, 265865], [173, 266465], [177, 266645], [184, 266825]]}, {"verse": 38, "start": 267876, "end": 274117, "text": "Diciendo: ¡Bendito el rey que viene en el nombre del Señor: paz en el cielo, y gloria en lo altísimo!", "words": [[0, 267876], [10, 268831], [19, 269155], [22, 269515], [26, 269755], [30, 269855], [36, 270115], [39, 270335], [42, 270455], [49, 270715], [53, 270915], [60, 271814], [64, 271944], [67, 272064], [70, 272164], [77, 272524], [79, 272739], [86, 273179], [89, 273299], [92, 273399]]}, {"verse": 39, "start": 274397, "end": 280644, "text": "Entonces algunos de los fariseos de la multitud, le dijeron: Maestro, reprende a tus discípulos.", "words": [[0, 274397], [9, 274863], [17, 275363], [20, 275603], [24, 275703], [33, 276423], [36, 276523], [39, 276623], [49, 277223], [52, 277723], [61, 278571], [70, 279032], [79, 279652], [81, 279692], [85, 279812]]}, {"verse": 40, "start": 280924, "end": 286557, "text": "Y él respondiendo, les dijo: Os digo que si estos callan, las piedras clamarán.", "words": [[0, 280924], [2, 281089], [5, 281249], [19, 281989], [23, 282129], [29, 282835], [32, 283106], [37, 283446], [41, 283686], [44, 283906], [50, 284206], [58, 285166], [62, 285346], [70, 285766]]}, {"verse": 41, "start": 286907, "end": 290765, "text": "Y cuando llegó cerca, viendo la ciudad, lloró sobre ella,", "words": [[0, 286907], [2, 287012], [9, 287172], [15, 287532], [22, 288152], [29, 288312], [32, 288572], [40, 289352], [46, 289872], [52, 290172]]}, {"verse": 42, "start": 291115, "end": 299830, "text": "Diciendo: ¡Oh si también tú conocieses, a lo menos en este tu día, lo que toca a tu paz! pero ahora está encubierto de tus ojos.", "words": [[0, 291115], [10, 292157], [14, 292257], [17, 292417], [25, 292777], [28, 293057], [40, 293425], [42, 293794], [45, 294162], [51, 294422], [54, 294682], [59, 294862], [62, 295062], [67, 295862], [70, 295962], [74, 296082], [79, 296362], [81, 296562], [84, 296662], [89, 297344], [94, 297506], [100, 297726], [105, 298066], [116, 298846], [119, 298986], [123, 299146]]}, {"verse": 43, "start": 300180, "end": 310007, "text": "Porque vendrán días sobre ti, que tus enemigos te rodearán con una barrera de asedio, y te pondrán cerco, y de todas partes te pondrán en estrecho,", "words": [[0, 300180], [7, 300404], [15, 300944], [20, 301184], [26, 301584], [30, 302124], [34, 302424], [38, 302544], [47, 303044], [50, 303204], [59, 303904], [63, 304084], [67, 304304], [75, 304724], [78, 305094], [86, 305464], [88, 305824], [91, 305944], [99, 306424], [106, 307044], [108, 307484], [111, 307644], [117, 307824], [124, 308484], [127, 308664], [135, 309124], [138, 309264]]}, {"verse": 44, "start": 310357, "end": 321607, "text": "Y te derribarán a tierra, y a tus hijos dentro de ti; y no dejarán sobre ti piedra sobre piedra; por cuanto no conociste el tiempo de tu visitación.", "words": [[0, 310357], [2, 310526], [5, 310666], [16, 311506], [18, 311606], [26, 312046], [28, 312401], [30, 312501], [34, 312661], [40, 313061], [47, 313941], [50, 314361], [54, 314950], [56, 315311], [59, 315471], [67, 315971], [73, 316211], [76, 316451], [83, 316971], [89, 317211], [97, 318163], [101, 318284], [108, 318504], [111, 318824], [121, 319504], [124, 319704], [131, 320044], [134, 320304], [137, 320484]]}, {"verse": 45, "start": 321957, "end": 328084, "text": "Y entrando en el templo, comenzó a echar fuera a todos los que vendían y compraban en él.", "words": [[0, 321957], [2, 322114], [11, 322634], [14, 322814], [17, 322954], [25, 323874], [33, 324454], [35, 324534], [41, 324774], [47, 325074], [49, 325474], [55, 325714], [59, 325994], [63, 326214], [71, 326814], [73, 327034], [83, 327754], [86, 327914]]}, {"verse": 46, "start": 328434, "end": 337393, "text": "Diciéndoles: Escrito está: Mi casa, casa de oración es; pero vosotros la habéis hecho cueva de ladrones.", "words": [[0, 328434], [13, 329885], [21, 330527], [27, 331243], [30, 331410], [36, 332250], [41, 332610], [44, 332870], [52, 333650], [56, 334192], [61, 334354], [70, 334914], [73, 335254], [80, 335634], [86, 335994], [92, 336434], [95, 336554]]}, {"verse": 47, "start": 337743, "end": 346610, "text": "Y enseñaba cada día en el templo; pero los principales sacerdotes, y los escribas, y los principales del pueblo procuraban matarle.", "words": [[0, 337743], [2, 337866], [11, 338486], [16, 338706], [20, 339046], [23, 339226], [26, 339366], [34, 340376], [39, 340518], [43, 340678], [55, 341418], [67, 342158], [69, 342338], [73, 342458], [83, 343398], [85, 343738], [89, 343878], [101, 344558], [105, 344718], [112, 345118], [123, 345838]]}, {"verse": 48, "start": 346960, "end": 352318, "text": "Y no hallaban qué hacerle, porque todo el pueblo estaba muy atento oyéndole.", "words": [[0, 346960], [2, 347086], [5, 347206], [14, 347626], [18, 347826], [27, 348726], [34, 349046], [39, 349326], [42, 349586], [49, 349886], [56, 350266], [60, 350666], [67, 351286]]}]}