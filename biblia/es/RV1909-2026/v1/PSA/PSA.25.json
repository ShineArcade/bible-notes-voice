{"book": "PSA", "chapter": 25, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 136517, "verses": [{"verse": 1, "start": 300, "end": 4535, "text": "Salmo de David. A TI, oh Jehová, levantaré mi alma.", "words": [[0, 300], [6, 776], [9, 917], [16, 1727], [18, 1868], [22, 2028], [25, 2188], [33, 3108], [43, 3688], [46, 3948]]}, {"verse": 2, "start": 4985, "end": 10826, "text": "Dios mío, en ti confío; no sea yo avergonzado, no se alegren de mí mis enemigos.", "words": [[0, 4985], [5, 5170], [10, 5690], [13, 5870], [16, 6050], [24, 7120], [27, 7383], [31, 7653], [34, 7913], [47, 8813], [50, 9033], [53, 9253], [61, 9473], [64, 9653], [67, 9873], [71, 10033]]}, {"verse": 3, "start": 11276, "end": 19034, "text": "Ciertamente ninguno de cuantos en ti esperan será confundido: serán avergonzados los que se rebelan sin causa.", "words": [[0, 11276], [12, 11999], [20, 12579], [23, 12659], [31, 12952], [34, 13246], [37, 13539], [45, 13979], [50, 14139], [62, 15563], [68, 16063], [81, 17023], [85, 17263], [89, 17423], [92, 17603], [100, 18183], [104, 18323]]}, {"verse": 4, "start": 19484, "end": 23929, "text": "Muéstrame, oh Jehová, tus caminos; enséñame tus sendas.", "words": [[0, 19833], [11, 20213], [14, 20593], [22, 20973], [26, 21173], [35, 22277], [44, 22957], [48, 23157]]}, {"verse": 5, "start": 24379, "end": 32802, "text": "Encamíname en tu verdad, y enséñame; porque tú eres el Dios de mi salvación: en ti he esperado todo el día.", "words": [[0, 24379], [11, 25003], [14, 25323], [17, 25463], [25, 25803], [27, 26363], [37, 27574], [44, 27781], [47, 28101], [52, 28341], [55, 28641], [60, 28901], [63, 29121], [66, 29261], [77, 30517], [80, 30685], [83, 30965], [86, 31225], [95, 31785], [100, 32065], [103, 32345]]}, {"verse": 6, "start": 33252, "end": 39318, "text": "Acuérdate, oh Jehová, de tus compasiones y de tus misericordias, que son perpetuas.", "words": [[0, 33252], [11, 33781], [14, 34341], [22, 34901], [25, 35081], [29, 35221], [41, 36001], [43, 36321], [46, 36441], [50, 36601], [65, 37621], [69, 38101], [73, 38301]]}, {"verse": 7, "start": 39768, "end": 50160, "text": "De los pecados de mi juventud, y de mis rebeliones, no te acuerdes; conforme a tu misericordia acuérdate de mí, por tu bondad, oh Jehová.", "words": [[0, 39768], [3, 39894], [7, 40014], [15, 40654], [18, 40814], [21, 40914], [31, 41994], [33, 42134], [36, 42274], [40, 42454], [52, 43634], [55, 43734], [58, 43874], [68, 44955], [77, 45519], [79, 45559], [82, 45659], [95, 46519], [105, 47119], [108, 47539], [112, 48119], [116, 48379], [119, 48539], [127, 49049], [130, 49559]]}, {"verse": 8, "start": 50610, "end": 57046, "text": "Bueno y recto es Jehová: por tanto él enseñará a los pecadores el camino.", "words": [[0, 50610], [6, 51016], [8, 51356], [14, 51896], [17, 52056], [25, 52924], [29, 53048], [35, 53848], [38, 54308], [47, 55248], [49, 55448], [53, 55588], [63, 56228], [66, 56428]]}, {"verse": 9, "start": 57496, "end": 63580, "text": "Encaminará a los humildes por el juicio, y enseñará a los mansos su camino.", "words": [[0, 57496], [11, 58306], [13, 58526], [17, 58686], [26, 59366], [30, 59526], [33, 59646], [41, 60226], [43, 60766], [52, 61626], [54, 61906], [58, 62006], [65, 62726], [68, 62986]]}, {"verse": 10, "start": 64030, "end": 70584, "text": "Todas las sendas de Jehová son misericordia y verdad, para los que guardan su pacto y sus testimonios.", "words": [[0, 64030], [6, 64255], [10, 64595], [17, 65055], [20, 65175], [27, 65575], [31, 65735], [44, 66715], [46, 66795], [54, 67515], [59, 67915], [63, 68095], [67, 68235], [75, 68675], [78, 68855], [84, 69375], [86, 69475], [90, 69655]]}, {"verse": 11, "start": 71034, "end": 77039, "text": "Por amor de tu nombre, oh Jehová, perdonarás también mi pecado; porque es grande.", "words": [[0, 71034], [4, 71294], [9, 71554], [12, 71794], [15, 71934], [23, 72534], [26, 72714], [34, 73374], [45, 74174], [53, 74514], [56, 74754], [64, 75760], [71, 76004], [74, 76244]]}, {"verse": 12, "start": 77489, "end": 83833, "text": "¿Quién es el hombre que teme a Jehová? Él le enseñará el camino que ha de escoger.", "words": [[0, 77489], [7, 77733], [10, 77853], [13, 78013], [20, 78233], [24, 78433], [29, 78753], [31, 78853], [39, 79676], [42, 79874], [45, 80034], [54, 80694], [57, 80854], [64, 81234], [68, 81534], [71, 81714], [74, 81814]]}, {"verse": 13, "start": 84283, "end": 89174, "text": "Su alma reposará en el bien, y su descendencia heredará la tierra.", "words": [[0, 84283], [3, 84283], [8, 84283], [17, 85123], [20, 85403], [23, 85563], [29, 86223], [31, 86443], [34, 86583], [47, 87643], [56, 88323], [59, 88463]]}, {"verse": 14, "start": 89624, "end": 95145, "text": "El secreto de Jehová es para los que le temen; y a ellos hará conocer su pacto.", "words": [[0, 89624], [3, 89766], [11, 90426], [14, 90546], [21, 90966], [24, 91066], [29, 91226], [33, 91406], [37, 91526], [40, 91646], [47, 92490], [49, 92896], [51, 93016], [57, 93336], [62, 93856], [70, 94216], [73, 94476]]}, {"verse": 15, "start": 95595, "end": 100551, "text": "Mis ojos están siempre hacia Jehová; porque él sacará mis pies de la red.", "words": [[0, 95595], [4, 95761], [9, 96141], [15, 96581], [23, 97061], [29, 97541], [37, 98371], [44, 98747], [47, 98967], [54, 99407], [58, 99567], [63, 99807], [66, 100069], [69, 100332]]}, {"verse": 16, "start": 101001, "end": 105985, "text": "Mírame, y ten misericordia de mí; porque estoy solo y afligido.", "words": [[0, 101001], [8, 101588], [10, 102088], [14, 102268], [27, 103268], [30, 103388], [34, 104052], [41, 104275], [47, 104535], [52, 104975], [54, 105235]]}, {"verse": 17, "start": 106435, "end": 111026, "text": "Las angustias de mi corazón se han aumentado: sácame de mis congojas.", "words": [[0, 106435], [4, 106532], [14, 107192], [17, 107312], [20, 107432], [28, 107852], [31, 108092], [35, 108212], [46, 109356], [53, 109797], [56, 110017], [60, 110137]]}, {"verse": 18, "start": 111476, "end": 116009, "text": "Mira mi aflicción y mi trabajo: y perdona todos mis pecados.", "words": [[0, 111646], [5, 111816], [8, 111935], [18, 112536], [20, 112736], [23, 112836], [32, 113954], [34, 114061], [42, 114641], [48, 114881], [52, 115161]]}, {"verse": 19, "start": 116459, "end": 121390, "text": "Mira mis enemigos, que se han multiplicado, y con odio violento me aborrecen.", "words": [[0, 116459], [5, 116824], [9, 116924], [19, 117484], [23, 117644], [26, 117784], [30, 117904], [44, 118784], [46, 119144], [50, 119344], [55, 119844], [64, 120484], [67, 120937]]}, {"verse": 20, "start": 121840, "end": 126625, "text": "Guarda mi alma, y líbrame: no sea yo avergonzado, porque en ti confié.", "words": [[0, 122040], [7, 122240], [10, 122440], [16, 122760], [18, 123080], [27, 124073], [30, 124179], [34, 124339], [37, 124559], [50, 125399], [57, 125639], [60, 125799], [63, 125919]]}, {"verse": 21, "start": 127075, "end": 131679, "text": "Integridad y rectitud me guarden; porque en ti he esperado.", "words": [[0, 127075], [11, 127915], [13, 128155], [22, 128775], [25, 129015], [34, 129909], [41, 130154], [44, 130394], [47, 130574], [50, 130834]]}, {"verse": 22, "start": 132129, "end": 136117, "text": "Redime, oh Dios, a Israel de todas sus angustias.", "words": [[0, 132129], [8, 132656], [11, 132876], [17, 133736], [19, 133856], [26, 134336], [29, 134576], [35, 134836], [39, 135156]]}]}