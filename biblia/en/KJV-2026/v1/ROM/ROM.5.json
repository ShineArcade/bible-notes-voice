{"book": "ROM", "chapter": 5, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 151764, "verses": [{"verse": 1, "start": 300, "end": 4989, "text": "Therefore being justified by faith, we have peace with God through our Lord Jesus Christ:", "words": [[0, 300], [10, 639], [16, 859], [26, 1279], [29, 1599], [36, 2219], [39, 2359], [44, 2519], [50, 2799], [55, 3039], [59, 3279], [67, 3559], [71, 3739], [76, 3979], [82, 4279]]}, {"verse": 2, "start": 5439, "end": 12607, "text": "By whom also we have access by faith into this grace in which we stand, and rejoice in hope of the glory of God.", "words": [[0, 5439], [3, 5578], [8, 5838], [13, 6238], [16, 6438], [21, 6618], [28, 7038], [31, 7358], [37, 7738], [42, 8038], [47, 8318], [53, 8658], [56, 8978], [62, 9178], [65, 9358], [72, 9738], [76, 10178], [84, 10578], [87, 10958], [92, 11198], [95, 11478], [99, 11618], [105, 11998], [108, 12178]]}, {"verse": 3, "start": 13057, "end": 18697, "text": "And not only so, but we glory in tribulations also: knowing that tribulation works patience;", "words": [[0, 13057], [4, 13155], [8, 13335], [13, 13515], [17, 14135], [21, 14255], [24, 14395], [30, 14735], [33, 15015], [46, 15635], [52, 16543], [60, 16763], [65, 16983], [77, 17563], [83, 18158]]}, {"verse": 4, "start": 19147, "end": 22433, "text": "And patience, experience; and experience, hope:", "words": [[0, 19147], [4, 19283], [14, 20063], [26, 21189], [30, 21291], [42, 21771]]}, {"verse": 5, "start": 22883, "end": 30791, "text": "And hope makes not ashamed; because the love of God is shed abroad in our hearts by the Holy Spirit which is given to us.", "words": [[0, 22883], [4, 23044], [9, 23244], [15, 23524], [19, 23744], [28, 24641], [36, 24881], [40, 25101], [45, 25381], [48, 25521], [52, 25801], [55, 26021], [60, 26261], [67, 26581], [70, 26861], [74, 26981], [81, 27281], [84, 27521], [88, 27681], [93, 27961], [100, 28401], [106, 28661], [109, 28801], [115, 29021], [118, 29281]]}, {"verse": 