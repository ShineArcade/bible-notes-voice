{"book": "LUK", "chapter": 22, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 467536, "verses": [{"verse": 1, "start": 300, "end": 4667, "text": "Now the feast of unleavened bread drew near, which is called the Passover.", "words": [[0, 300], [4, 473], [8, 633], [14, 953], [17, 1173], [28, 1813], [34, 2073], [39, 2393], [45, 3153], [51, 3313], [54, 3453], [61, 3733], [65, 3913]]}, {"verse": 2, "start": 5117, "end": 10183, "text": "And the chief priests and scribes sought how they might kill him; for they feared the people.", "words": [[0, 5117], [4, 5252], [8, 5352], [14, 5592], [22, 6012], [26, 6292], [34, 6972], [41, 7292], [45, 7532], [50, 7672], [56, 7912], [61, 8212], [66, 8861], [70, 8966], [75, 9086], [82, 9446], [86, 9666]]}, {"verse": 3, "start": 10633, "end": 16362, "text": "¶ Then entered Satan into Judas surnamed Iscariot, being of the number of the twelve.", "words": [[2, 10633], [7, 10863], [15, 11303], [21, 11803], [26, 12508], [32, 13213], [41, 13918], [51, 14623], [57, 14923], [60, 15103], [64, 15223], [71, 15483], [74, 15683], [78, 15763]]}, {"verse": 4, "start": 16812, "end": 22642, "text": "And he went his way, and communed with the chief priests and captains, how he might betray him to them.", "words": [[0, 16812], [4, 16948], [7, 17048], [12, 17248], [16, 17448], [21, 17848], [25, 18268], [34, 18848], [39, 18948], [43, 19108], [49, 19328], [57, 19748], [61, 20088], [71, 20728], [75, 21148], [78, 21308], [84, 21508], [91, 21888], [95, 22108], [98, 22308]]}, {"verse": 5, "start": 23092, "end": 26400, "text": "And they were glad, and covenanted to give him money.", "words": [[0, 23092], [4, 23255], [9, 23375], [14, 23535], [20, 23955], [24, 24635], [35, 25235], [38, 25535], [43, 25755], [47, 25895]]}, {"verse": 6, "start": 26850, "end": 32218, "text": "And he promised, and sought opportunity to betray him to them in the absence of the multitude.", "words": [[0, 26850], [4, 27017], [7, 27157], [17, 27657], [21, 27997], [28, 28337], [40, 28977], [43, 29357], [50, 29657], [54, 29937], [57, 30117], [62, 30337], [65, 30597], [69, 30717], [77, 31037], [80, 31317], [84, 31437]]}, {"verse": 7, "start": 32668, "end": 36957, "text": "¶ Then came the day of unleavened bread, when the passover must be killed.", "words": [[2, 32668], [7, 32875], [12, 33155], [16, 33355], [20, 33595], [23, 33755], [34, 34455], [41, 35115], [46, 35275], [50, 35415], [59, 35875], [64, 36215], [67, 36415]]}, {"verse": 8, "start": 37407, "end": 43021, "text": "And he sent Peter and John, saying, Go and prepare us the passover, that we may eat.", "words": [[0, 37407], [4, 37550], [7, 37650], [12, 37870], [18, 38210], [22, 38470], [28, 38810], [36, 39779], [39, 40057], [43, 40337], [51, 40617], [54, 40897], [58, 41037], [68, 41537], [73, 42177], [76, 42357], [80, 42557]]}, {"verse": 9, "start": 43371, "end": 46004, "text": "And they said to him, Where will you that we prepare?", "words": [[0, 43371], [4, 43513], [9, 43633], [14, 43873], [17, 44093], [22, 44696], [28, 44796], [33, 45016], [37, 45136], [42, 45316], [45, 45456]]}, {"verse": 10, "start": 46354, "end": 55599, "text": "And he said to them, Behold, when you are entered into the city, there shall a man meet you, bearing a pitcher of water; follow him into the house where he enters in.", "words": [[0, 46354], [4, 46485], [7, 46605], [12, 46845], [15, 47045], [21, 47640], [29, 48257], [34, 48377], [38, 48497], [42, 48597], [50, 48897], [55, 49217], [59, 49377], [65, 50157], [71, 50277], [77, 50517], [79, 50657], [83, 50877], [88, 51137], [93, 51797], [101, 52017], [103, 52197], [111, 52417], [114, 52637], [121, 53405], [128, 53645], [132, 53905], [137, 54105], [141, 54265], [147, 54505], [153, 54725], [156, 54845], [163, 55125]]}, {"verse": 11, "start": 56049, "end": 64996, "text": "And you shall say to the goodman of the house, The Master says to you, Where is the guestchamber, where I shall eat the passover with my disciples?", "words": [[0, 56049], [4, 56222], [8, 56402], [14, 56622], [18, 56942], [21, 57122], [25, 57372], [33, 57622], [36, 57802], [40, 57902], [47, 58682], [51, 58782], [58, 59122], [63, 59442], [66, 59662], [71, 60302], [77, 60582], [80, 60902], [84, 61502], [98, 62102], [104, 62302], [106, 62562], [112, 62782], [116, 63042], [120, 63202], [129, 63662], [134, 64002], [137, 64162]]}, {"verse": 12, "start": 65446, "end": 69449, "text": "And he shall show you a large upper room furnished: there make ready.", "words": [[0, 65446], [4, 65578], [7, 65738], [13, 65938], [18, 66218], [22, 66398], [24, 66558], [30, 66858], [36, 67238], [41, 67638], [52, 68717], [58, 68807], [63, 68987]]}, {"verse": 13, "start": 69799, "end": 74440, "text": "And they went, and found as he had said to them: and they made ready the passover.", "words": [[0, 69799], [4, 69950], [9, 70070], [15, 70350], [19, 70610], [25, 70910], [28, 71170], [31, 71310], [35, 71470], [40, 71690], [43, 71890], [49, 72564], [53, 72671], [58, 72831], [63, 73111], [69, 73391], [73, 73551]]}, {"verse": 14, "start": 74890, "end": 79262, "text": "And when the hour was come, he sat down, and the twelve apostles with him.", "words": [[0, 74890], [4, 75019], [9, 75179], [13, 75359], [18, 75579], [22, 75819], [28, 76419], [31, 76599], [35, 76859], [41, 77239], [45, 77659], [49, 77779], [56, 78099], [65, 78539], [70, 78959]]}, {"verse": 15, "start": 79712, "end": 85258, "text": "And he said to them, With desire I have desired to eat this passover with you before I suffer:", "words": [[0, 79712], [4, 79842], [7, 79962], [12, 80202], [15, 80402], [21, 80998], [26, 81195], [33, 81755], [35, 82075], [40, 82375], [48, 82675], [51, 82895], [55, 83095], [60, 83335], [69, 83755], [74, 84095], [78, 84235], [85, 84535], [87, 84755]]}, {"verse": 16, "start": 85708, "end": 91723, "text": "For I say to you, I will not any more eat of it, until it be fulfilled in the kingdom of God.", "words": [[0, 85708], [4, 85857], [6, 86077], [10, 86317], [13, 86477], [18, 87157], [20, 87317], [25, 87477], [29, 87717], [33, 87997], [38, 88257], [42, 88517], [45, 88657], [49, 89077], [55, 89397], [58, 89597], [61, 89757], [71, 90277], [74, 90597], [78, 90697], [86, 90997], [89, 91257]]}, {"verse": 17, "start": 92073, "end": 97859, "text": "And he took the cup, and gave thanks, and said, Take this, and divide it among yourselves:", "words": [[0, 92073], [4, 92209], [7, 92289], [12, 92449], [16, 92629], [21, 92889], [25, 93109], [30, 93309], [38, 93709], [42, 93949], [48, 95130], [53, 95287], [59, 95707], [63, 96167], [70, 96487], [73, 96727], [79, 96967]]}, {"verse": 18, "start": 98309, "end": 103891, "text": "For I say to you, I will not drink of the fruit of the vine, until the kingdom of God shall come.", "words": [[0, 98309], [4, 98419], [6, 98599], [10, 98819], [13, 99039], [18, 99579], [20, 99779], [25, 99919], [29, 100139], [35, 100459], [38, 100619], [42, 100739], [48, 100979], [51, 101119], [55, 101219], [61, 101619], [67, 102079], [71, 102279], [79, 102539], [82, 102759], [86, 103059], [92, 103319]]}, {"verse": 19, "start": 104241, "end": 114156, "text": "¶ And he took bread, and gave thanks, and broke it, and gave to them, saying, This is my body which is given for you: this do in remembrance of me.", "words": [[2, 104241], [6, 104367], [9, 104467], [14, 104687], [21, 105047], [25, 105467], [30, 105767], [38, 106647], [42, 106947], [48, 107247], [52, 107447], [56, 107627], [61, 107867], [64, 108067], [70, 108427], [78, 109650], [83, 109937], [86, 110117], [89, 110317], [94, 110697], [100, 110977], [103, 111137], [109, 111357], [113, 111677], [118, 112285], [123, 112554], [126, 112864], [129, 113104], [141, 113524], [144, 113844]]}, {"verse": 20, "start": 114506, "end": 121541, "text": "Likewise also the cup after supper, saying, This cup is the new testament in my blood, which is shed for you.", "words": [[0, 114506], [9, 114858], [14, 115318], [18, 115518], [22, 115798], [28, 116118], [36, 116778], [44, 117623], [49, 117853], [53, 118193], [56, 118453], [60, 118613], [64, 118793], [74, 119173], [77, 119493], [80, 119673], [87, 120213], [93, 120513], [96, 120633], [101, 120913], [105, 121173]]}, {"verse": 21, "start": 121991, "end": 126124, "text": "¶ But, behold, the hand of him that betrays me is with me on the table.", "words": [[2, 121991], [7, 122096], [15, 122956], [19, 123196], [24, 123476], [27, 123616], [31, 123796], [36, 123956], [44, 124556], [47, 124716], [50, 124956], [55, 125116], [58, 125316], [61, 125476], [65, 125596]]}, {"verse": 22, "start": 126574, "end": 132846, "text": "And truly the Son of man goes, as it was determined: but woe to that man by whom he is betrayed!", "words": [[0, 126574], [4, 126716], [10, 127016], [14, 127256], [18, 127536], [21, 127636], [25, 127896], [31, 128296], [34, 128836], [37, 128976], [41, 129136], [53, 130152], [57, 130288], [61, 130728], [64, 130829], [69, 131029], [73, 131329], [76, 131588], [81, 131868], [84, 132109], [87, 132228]]}, {"verse": 23, "start": 133196, "end": 138802, "text": "And they began to enquire among themselves, which of them it was that should do this thing.", "words": [[0, 133196], [4, 133337], [9, 133477], [15, 133817], [18, 134257], [26, 134697], [32, 134937], [44, 135557], [50, 136397], [53, 136637], [58, 136837], [61, 137017], [65, 137317], [70, 137617], [77, 137797], [80, 138017], [85, 138237]]}, {"verse": 24, "start": 139252, "end": 143647, "text": "¶ And there was also a strife among them, which of them should be accounted the greatest.", "words": [[2, 139252], [6, 139413], [12, 139513], [16, 139693], [21, 140013], [23, 140173], [30, 140573], [36, 140793], [42, 141393], [48, 141633], [51, 141793], [56, 141953], [63, 142133], [66, 142293], [76, 142693], [80, 142933]]}, {"verse": 25, "start": 144097, "end": 152654, "text": "And he said to them, The kings of the Gentiles exercise lordship over them; and they that exercise authority upon them are called benefactors.", "words": [[0, 144097], [4, 144227], [7, 144347], [12, 144587], [15, 144787], [21, 145383], [25, 145469], [31, 145809], [34, 146029], [38, 146129], [47, 146949], [56, 147389], [65, 148029], [70, 148289], [76, 148972], [80, 149115], [85, 149315], [90, 149515], [99, 149975], [109, 150575], [114, 150875], [119, 151135], [123, 151295], [130, 151595]]}, {"verse": 26, "start": 153104, "end": 161307, "text": "But you shall not be so: but he that is greatest among you, let him be as the younger; and he that is chief, as he that does serve.", "words": [[0, 153104], [4, 153208], [8, 153368], [14, 153548], [18, 153728], [21, 153928], [25, 154641], [29, 154765], [32, 154985], [37, 155205], [40, 155325], [49, 155605], [55, 155925], [60, 156645], [64, 156965], [68, 157185], [71, 157465], [74, 157765], [78, 157945], [87, 158755], [91, 158897], [94, 159097], [99, 159277], [102, 159437], [109, 159997], [112, 160277], [115, 160437], [120, 160617], [125, 160837]]}, {"verse": 27, "start": 161757, "end": 170304, "text": "For whether is greater, he that sits at the table, or he that serves? is not he that sits at the table? but I am among you as he that serves.", "words": [[0, 161757], [4, 161886], [12, 162146], [15, 162386], [24, 163226], [27, 163346], [32, 163546], [37, 163766], [40, 163946], [44, 164026], [51, 164366], [54, 164746], [57, 164926], [62, 165106], [70, 166046], [73, 166330], [77, 166510], [80, 166750], [85, 166930], [90, 167110], [93, 167290], [97, 167370], [104, 168161], [108, 168421], [110, 168581], [113, 168681], [119, 168921], [123, 169161], [126, 169401], [129, 169561], [134, 169741]]}, {"verse": 28, "start": 170754, "end": 173954, "text": "You are they which have continued with me in my temptations.", "words": [[0, 170754], [4, 170929], [8, 171129], [13, 171349], [19, 171609], [24, 171749], [34, 172189], [39, 172469], [42, 172709], [45, 172869], [48, 173009]]}, {"verse": 29, "start": 174404, "end": 177819, "text": "And I appoint to you a kingdom, as my Father has appointed to me;", "words": [[0, 174404], [4, 174507], [6, 174647], [14, 174967], [17, 175167], [21, 175327], [23, 175427], [32, 175807], [35, 176267], [38, 176427], [45, 176747], [49, 176967], [59, 177287], [62, 177567]]}, {"verse": 30, "start": 178269, "end": 184828, "text": "That you may eat and drink at my table in my kingdom, and sit on thrones judging the twelve tribes of Israel.", "words": [[0, 178269], [5, 178391], [9, 178531], [13, 178711], [17, 179091], [21, 179331], [27, 179631], [30, 179811], [33, 179931], [39, 180351], [42, 180511], [45, 180671], [54, 181531], [58, 181711], [62, 181951], [65, 182131], [73, 182691], [81, 183071], [85, 183311], [92, 183631], [99, 184031], [102, 184271]]}, {"verse": 31, "start": 185178, "end": 192125, "text": "¶ And the Lord said, Simon, Simon, behold, Satan has desired to have you, that he may sift you as wheat:", "words": [[2, 185178], [6, 185307], [10, 185427], [15, 185627], [21, 186968], [28, 187467], [35, 188027], [43, 188827], [49, 189127], [53, 189347], [61, 189787], [64, 189987], [69, 190187], [74, 190747], [79, 190847], [82, 190947], [86, 191067], [91, 191347], [95, 191547], [98, 191687]]}, {"verse": 32, "start": 192575, "end": 198495, "text": "But I have prayed for you, that your faith fail not: and when you are converted, strengthen your brethren.", "words": [[0, 192575], [4, 192657], [6, 192777], [11, 192877], [18, 193137], [22, 193337], [27, 193537], [32, 193717], [37, 193817], [43, 194137], [48, 194557], [53, 195401], [57, 195554], [62, 195734], [66, 195954], [70, 196094], [81, 196914], [92, 197534], [97, 197854]]}, {"verse": 33, "start": 198845, "end": 203950, "text": "And he said to him, Lord, I am ready to go with you, both into prison, and to death.", "words": [[0, 198845], [4, 198971], [7, 199071], [12, 199291], [15, 199491], [20, 200143], [26, 200600], [28, 200780], [31, 200960], [37, 201160], [40, 201340], [43, 201500], [48, 201720], [53, 202120], [58, 202320], [63, 202620], [71, 202980], [75, 203460], [78, 203620]]}, {"verse": 34, "start": 204300, "end": 211655, "text": "And he said, I tell you, Peter, the rooster shall not crow this day, before that you shall three times deny that you know me.", "words": [[0, 204300], [4, 204435], [7, 204575], [13, 206034], [15, 206170], [20, 206390], [25, 206630], [32, 207210], [36, 207330], [44, 207670], [50, 207870], [54, 208090], [59, 208350], [64, 208590], [69, 209050], [76, 209370], [81, 209590], [85, 209710], [91, 209850], [97, 210130], [103, 210450], [108, 210750], [113, 211010], [117, 211150], [122, 211350]]}, {"verse": 35, "start": 212005, "end": 223626, "text": "And he said to them, When I sent you without purse, and bag, and shoes, lacked you any thing? And they said, Nothing.", "words": [[0, 212005], [4, 212136], [7, 212256], [12, 212496], [15, 212696], [21, 213291], [26, 213442], [28, 213602], [33, 213862], [37, 214042], [45, 214322], [52, 214822], [56, 215342], [61, 215662], [65, 216182], [72, 216582], [79, 217142], [83, 217495], [87, 217849], [92, 219704], [94, 221245], [98, 221372], [103, 221532], [109, 222879]]}, {"verse": 36, "start": 223976, "end": 235002, "text": "Then said he to them, But now, he that has a purse, let him take it, and likewise his bag: and he that has no sword, let him sell his garment, and buy one.", "words": [[0, 223976], [5, 224196], [10, 224436], [13, 224596], [16, 224736], [22, 226710], [26, 226813], [31, 227114], [34, 227433], [39, 227693], [43, 227954], [45, 228054], [52, 228674], [56, 228913], [60, 229054], [65, 229293], [69, 229713], [73, 229793], [82, 230133], [86, 230493], [91, 231338], [95, 231446], [98, 231646], [103, 231846], [107, 232046], [110, 232246], [117, 232886], [121, 233126], [125, 233286], [130, 233526], [134, 233686], [143, 234006], [147, 234366], [151, 234606]]}, {"verse": 37, "start": 235452, "end": 244864, "text": "For I say to you, that this that is written must yet be accomplished in me, And he was reckoned among the transgressors: for the things concerning me have an end.", "words": [[0, 235452], [4, 235653], [6, 235933], [10, 236213], [13, 236453], [18, 236693], [23, 237293], [28, 237553], [33, 237753], [36, 237893], [44, 238193], [49, 238473], [53, 238773], [56, 238973], [69, 239433], [72, 239753], [76, 240253], [80, 240473], [83, 240593], [87, 240753], [96, 241173], [102, 241333], [106, 241553], [121, 242774], [125, 242974], [129, 243094], [136, 243354], [147, 243854], [150, 244114], [155, 244334], [158, 244474]]}, {"verse": 38, "start": 245214, "end": 251304, "text": "And they said, Lord, behold, here are two swords. And he said to them, It is enough.", "words": [[0, 245214], [4, 245363], [9, 245483], [15, 246222], [21, 246488], [29, 247368], [34, 247568], [38, 247808], [42, 248068], [50, 249140], [54, 249270], [57, 249390], [62, 249630], [65, 249830], [71, 250426], [74, 250544], [77, 250704]]}, {"verse": 39, "start": 251654, "end": 258820, "text": "¶ And he came out, and went, as he was accustomed, to the mount of Olives; and his disciples also followed him.", "words": [[2, 251654], [6, 251805], [9, 251945], [14, 252205], [19, 252605], [23, 253265], [29, 253585], [32, 253965], [35, 254105], [39, 254265], [51, 254745], [54, 255185], [58, 255285], [64, 255545], [67, 255685], [75, 256655], [79, 256778], [83, 256918], [93, 257458], [98, 257878], [107, 258398]]}, {"verse": 40, "start": 259270, "end": 264836, "text": "And when he was at the place, he said to them, Pray that you enter not into temptation.", "words": [[0, 259270], [4, 259408], [9, 259588], [12, 259768], [16, 259928], [19, 260088], [23, 260268], [30, 260908], [33, 261148], [38, 261408], [41, 261608], [47, 262282], [52, 262536], [57, 262776], [61, 262956], [67, 263316], [71, 263636], [76, 264016]]}, {"verse": 41, "start": 265186, "end": 270384, "text": "And he was withdrawn from them about a stone’s cast, and kneeled down, and prayed,", "words": [[0, 265186], [4, 265289], [7, 265409], [11, 265569], [21, 265989], [26, 266309], [31, 266509], [37, 266769], [39, 266949], [47, 267409], [53, 268049], [57, 268329], [65, 268649], [71, 268969], [75, 269289]]}, {"verse": 42, "start": 270834, "end": 277432, "text": "Saying, Father, if you be willing, remove this cup from me: nevertheless not my will, but yours, be done.", "words": [[0, 270938], [8, 271327], [16, 271781], [19, 271861], [23, 271981], [26, 272081], [35, 272741], [42, 272981], [47, 273341], [51, 273621], [56, 273821], [60, 274433], [73, 275012], [77, 275192], [80, 275432], [86, 275892], [90, 275952], [97, 276792], [100, 276932]]}, {"verse": 43, "start": 277782, "end": 281421, "text": "And there appeared an angel to him from heaven, strengthening him.", "words": [[0, 277782], [4, 277925], [10, 278125], [19, 278485], [22, 278665], [28, 279105], [31, 279365], [35, 279565], [40, 279805], [48, 280485], [62, 280985]]}, {"verse": 44, "start": 281871, "end": 288845, "text": "And being in an agony he prayed more earnestly: and his sweat was as it were great drops of blood falling down to the ground.", "words": [[0, 281871], [4, 281999], [10, 282239], [13, 282459], [16, 282579], [22, 282959], [25, 283179], [32, 283479], [37, 283739], [48, 284735], [52, 284897], [56, 285037], [62, 285377], [66, 285617], [69, 285877], [72, 285997], [77, 286157], [83, 286477], [89, 286797], [92, 287017], [98, 287337], [106, 287777], [111, 288057], [114, 288217], [118, 288317]]}, {"verse": 45, "start": 289295, "end": 294773, "text": "And when he rose up from prayer, and was come to his disciples, he found them sleeping for sorrow,", "words": [[0, 289295], [4, 289421], [9, 289581], [12, 289741], [17, 290001], [20, 290241], [25, 290461], [33, 290881], [37, 291441], [41, 291581], [46, 291801], [49, 291981], [53, 292101], [64, 293061], [67, 293181], [73, 293421], [78, 293601], [87, 293941], [91, 294201]]}, {"verse": 46, "start": 295223, "end": 300444, "text": "And said to them, Why do you sleep? rise and pray, lest you enter into temptation.", "words": [[0, 295223], [4, 295347], [9, 295547], [12, 295747], [18, 296290], [22, 296566], [25, 296806], [29, 296906], [36, 297789], [41, 298094], [45, 298414], [51, 298734], [56, 299074], [60, 299194], [66, 299454], [71, 299734]]}, {"verse": 47, "start": 300794, "end": 309864, "text": "¶ And while he yet spoke, behold a multitude, and he that was called Judas, one of the twelve, went before them, and drew near to Jesus to kiss him.", "words": [[2, 300794], [6, 300929], [12, 301149], [15, 301349], [19, 301529], [26, 302169], [33, 302409], [35, 302629], [46, 303629], [50, 303749], [53, 303869], [58, 304049], [62, 304209], [69, 304509], [76, 305389], [80, 305629], [83, 305749], [87, 305869], [95, 306489], [100, 306669], [107, 307069], [113, 307789], [117, 307889], [122, 308129], [127, 308369], [130, 308569], [136, 308909], [139, 309229], [144, 309429]]}, {"verse": 48, "start": 310314, "end": 315088, "text": "But Jesus said to him, Judas, do you betray the Son of man with a kiss?", "words": [[0, 310314], [4, 310714], [10, 311014], [15, 311434], [18, 311654], [23, 312255], [30, 312728], [33, 312808], [37, 312908], [44, 313248], [48, 313488], [52, 313748], [55, 313888], [59, 314188], [64, 314408], [66, 314508]]}, {"verse": 49, "start": 315438, "end": 321482, "text": "When they which were about him saw what would follow, they said to him, Lord, shall we strike with the sword?", "words": [[0, 315438], [5, 315646], [10, 315966], [16, 316186], [21, 316386], [27, 316666], [31, 317006], [35, 317206], [40, 317446], [46, 317586], [54, 318526], [59, 318666], [64, 318926], [67, 319146], [72, 319732], [78, 320112], [84, 320252], [87, 320412], [94, 320712], [99, 320932], [103, 321072]]}, {"verse": 50, "start": 321832, "end": 326081, "text": "¶ And one of them struck the servant of the high priest, and cut off his right ear.", "words": [[2, 321832], [6, 321989], [10, 322209], [13, 322349], [18, 322549], [25, 322869], [29, 323109], [37, 323409], [40, 323669], [44, 323789], [49, 323969], [57, 324309], [61, 324709], [65, 324969], [69, 325129], [73, 325329], [79, 325609]]}, {"verse": 51, "start": 326531, "end": 332337, "text": "And Jesus answered and said, Permit even this. And he touched his ear, and healed him.", "words": [[0, 326531], [4, 326678], [10, 326998], [19, 327538], [23, 327838], [29, 328474], [36, 328870], [41, 329130], [47, 330060], [51, 330197], [54, 330297], [62, 330597], [66, 330877], [71, 331177], [75, 331637], [82, 331917]]}, {"verse": 52, "start": 332787, "end": 344006, "text": "Then Jesus said to the chief priests, and captains of the temple, and the elders, which were come to him, Be you come out, as against a thief, with swords and staves?", "words": [[0, 332787], [5, 333075], [11, 333355], [16, 333715], [19, 333895], [23, 334015], [29, 334235], [38, 334715], [42, 335295], [51, 335815], [54, 335935], [58, 336075], [66, 336355], [70, 336915], [74, 337055], [82, 337295], [88, 337895], [93, 338055], [98, 338275], [101, 338475], [106, 340187], [109, 340443], [113, 340643], [118, 340883], [123, 341203], [126, 341663], [134, 341923], [136, 342123], [143, 342423], [148, 342803], [155, 343163], [159, 343363]]}, {"verse": 53, "start": 344456, "end": 351845, "text": "When I was daily with you in the temple, you stretched forth no hands against me: but this is your hour, and the power of darkness.", "words": [[0, 344456], [5, 344580], [7, 344700], [11, 344840], [17, 345120], [22, 345380], [26, 345500], [29, 345600], [33, 345680], [41, 346360], [45, 346500], [55, 346780], [61, 347140], [64, 347420], [70, 347720], [78, 347940], [82, 348663], [86, 348765], [91, 349045], [94, 349225], [99, 349365], [105, 349725], [109, 350165], [113, 350285], [119, 350625], [122, 350825]]}, {"verse": 54, "start": 352195, "end": 358936, "text": "¶ Then took they him, and led him, and brought him into the high priest’s house. And Peter followed afar off.", "words": [[2, 352195], [7, 352473], [12, 352833], [17, 353053], [22, 353373], [26, 353773], [30, 354053], [35, 354353], [39, 354893], [47, 355133], [51, 355353], [56, 355573], [60, 355733], [65, 355913], [74, 356513], [81, 357248], [85, 357372], [91, 357652], [100, 358042], [105, 358432]]}, {"verse": 55, "start": 359386, "end": 365893, "text": "And when they had kindled a fire in the midst of the hall, and were set down together, Peter sat down among them.", "words": [[0, 359386], [4, 359520], [9, 359660], [14, 359820], [18, 360000], [26, 360270], [28, 360540], [33, 360860], [36, 361100], [40, 361180], [46, 361400], [49, 361600], [53, 361720], [59, 362140], [63, 362520], [68, 362660], [72, 362900], [77, 363180], [87, 364140], [93, 364420], [97, 364780], [102, 365100], [108, 365400]]}, {"verse": 56, "start": 366343, "end": 374669, "text": "But a certain maid beheld him as he sat by the fire, and earnestly looked upon him, and said, This man was also with him.", "words": [[0, 366343], [4, 366449], [6, 366569], [14, 366789], [19, 367189], [26, 367689], [30, 367889], [33, 368069], [36, 368169], [40, 368409], [43, 368649], [47, 368769], [53, 369609], [57, 369729], [67, 370169], [74, 370429], [79, 370749], [84, 371029], [88, 371189], [94, 371976], [99, 372203], [103, 372503], [107, 372743], [112, 373123], [117, 373463]]}, {"verse": 57, "start": 375019, "end": 378305, "text": "And he denied him, saying, Woman, I know him not.", "words": [[0, 375019], [4, 375213], [7, 375373], [14, 375733], [19, 376013], [27, 376929], [34, 377171], [36, 377431], [41, 377631], [45, 377831]]}, {"verse": 58, "start": 378655, "end": 386284, "text": "And after a little while another saw him, and said, You are also of them. And Peter said, Man, I am not.", "words": [[0, 378655], [4, 378782], [10, 379042], [12, 379242], [19, 379402], [25, 379802], [33, 380022], [37, 380442], [42, 380682], [46, 381102], [52, 381838], [56, 381995], [60, 382155], [65, 382415], [68, 382735], [74, 383485], [78, 383591], [84, 383831], [90, 384744], [95, 384924], [97, 385584], [100, 385784]]}, {"verse": 59, "start": 386634, "end": 396138, "text": "And about the space of one hour after another confidently affirmed, saying, Of a truth this fellow also was with him: for he is a Galilæan.", "words": [[0, 386634], [4, 386762], [10, 386962], [14, 387142], [20, 387442], [23, 387742], [27, 388022], [32, 388302], [38, 388662], [46, 389062], [58, 389702], [68, 390622], [76, 391989], [79, 392168], [81, 392288], [87, 392548], [92, 392828], [99, 393148], [104, 393568], [108, 393808], [113, 394028], [118, 394607], [122, 394731], [125, 394991], [128, 395271], [130, 395731]]}, {"verse": 60, "start": 396488, "end": 403500, "text": "And Peter said, Man, I know not what you say. And immediately, while he yet spoke, the rooster crew.", "words": [[0, 396488], [4, 396594], [10, 396834], [16, 397567], [21, 397873], [23, 397893], [28, 398073], [32, 398293], [37, 398513], [41, 398673], [46, 400223], [50, 400369], [63, 400809], [69, 401349], [72, 401629], [76, 401829], [83, 402549], [87, 402629], [95, 402989]]}, {"verse": 61, "start": 403950, "end": 414148, "text": "And the Lord turned, and looked upon Peter. And Peter remembered the word of the Lord, how he had said to him, Before the rooster crow, you shall deny me three times.", "words": [[0, 403950], [4, 404095], [8, 404215], [13, 404435], [21, 404815], [25, 405115], [32, 405355], [37, 405635], [44, 406638], [48, 406959], [54, 407259], [65, 407719], [69, 408019], [74, 408259], [77, 408399], [81, 408539], [87, 408959], [91, 409099], [94, 409319], [98, 409459], [103, 409679], [106, 409899], [111, 410495], [118, 410734], [122, 410934], [130, 411274], [136, 412194], [140, 412334], [146, 412514], [151, 412874], [154, 413114], [160, 413414]]}, {"verse": 62, "start": 414498, "end": 417027, "text": "And Peter went out, and wept bitterly.", "words": [[0, 414498], [4, 414642], [10, 414942], [15, 415242], [20, 415542], [24, 415962], [29, 416342]]}, {"verse": 63, "start": 417477, "end": 420765, "text": "¶ And the men that held Jesus mocked him, and struck him.", "words": [[2, 417477], [6, 417622], [10, 417742], [14, 417962], [19, 418182], [24, 418382], [30, 418782], [37, 419462], [42, 419582], [46, 419802], [53, 420142]]}, {"verse": 64, "start": 421215, "end": 428464, "text": "And when they had blindfolded him, they struck him on the face, and asked him, saying, Prophesy, who is it that struck you?", "words": [[0, 421215], [4, 421352], [9, 421512], [14, 421712], [18, 421852], [30, 422752], [35, 423232], [40, 423392], [47, 423732], [51, 423932], [54, 424072], [58, 424192], [64, 424532], [68, 425092], [74, 425452], [79, 425792], [87, 427069], [97, 427319], [101, 427399], [104, 427539], [107, 427619], [112, 427759], [119, 428039]]}, {"verse": 65, "start": 428814, "end": 432125, "text": "And many other things blasphemously spoke they against him.", "words": [[0, 428814], [4, 428943], [9, 429163], [15, 429463], [22, 429843], [36, 430783], [42, 431143], [47, 431403], [55, 431743]]}, {"verse": 66, "start": 432575, "end": 440296, "text": "¶ And as soon as it was day, the elders of the people and the chief priests and the scribes came together, and led him into their council, saying,", "words": [[2, 432575], [6, 432705], [9, 432845], [14, 433045], [17, 433185], [20, 433285], [24, 433445], [29, 433885], [33, 433945], [40, 434225], [43, 434445], [47, 434545], [54, 434865], [58, 435085], [62, 435205], [68, 435405], [76, 435905], [80, 436125], [84, 436285], [92, 436725], [97, 436885], [107, 437305], [111, 437925], [115, 438105], [119, 438265], [124, 438405], [130, 438755], [139, 439105]]}, {"verse": 67, "start": 440546, "end": 445980, "text": "Are you the Christ? tell us. And he said to them, If I tell you, you will not believe:", "words": [[0, 440546], [4, 440646], [8, 440726], [12, 440806], [20, 441674], [25, 441838], [29, 442607], [33, 442738], [36, 442858], [41, 443098], [44, 443298], [50, 443893], [53, 444019], [55, 444179], [60, 444399], [65, 444839], [69, 444979], [74, 445119], [78, 445299]]}, {"verse": 68, "start": 446430, "end": 450182, "text": "And if I also ask you, you will not answer me, nor let me go.", "words": [[0, 446430], [4, 446529], [7, 446649], [9, 446769], [14, 447089], [18, 447449], [23, 447929], [27, 448069], [32, 448189], [36, 448369], [43, 448789], [47, 449129], [51, 449389], [55, 449609], [58, 449729]]}, {"verse": 69, "start": 450632, "end": 454738, "text": "Hereafter shall the Son of man sit on the right hand of the power of God.", "words": [[0, 450632], [10, 451186], [16, 451486], [20, 451686], [24, 451926], [27, 452046], [31, 452326], [35, 452626], [38, 452786], [42, 452906], [48, 453146], [53, 453446], [56, 453626], [60, 453726], [66, 454046], [69, 454246]]}, {"verse": 70, "start": 455088, "end": 461775, "text": "Then said they all, Are you then the Son of God? And he said to them, You say that I am.", "words": [[0, 455088], [5, 455291], [10, 455611], [15, 455851], [20, 457402], [24, 457548], [28, 457688], [33, 457948], [37, 458128], [41, 458408], [44, 458508], [49, 459316], [53, 459446], [56, 459566], [61, 459806], [64, 460006], [70, 460602], [74, 460735], [78, 460955], [83, 461155], [85, 461355]]}, {"verse": 71, "start": 462125, "end": 467136, "text": "And they said, What need we any further witness? for we ourselves have heard of his own mouth.", "words": [[0, 462125], [4, 462275], [9, 462395], [15, 463195], [20, 463265], [25, 463505], [28, 463685], [32, 463905], [40, 464165], [49, 465158], [53, 465266], [56, 465466], [66, 465826], [71, 466086], [77, 466326], [80, 466466], [84, 466586], [88, 466726]]}]}