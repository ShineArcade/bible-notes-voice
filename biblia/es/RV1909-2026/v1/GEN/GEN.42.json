{"book": "GEN", "chapter": 42, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 336962, "verses": [{"verse": 1, "start": 300, "end": 6464, "text": "Y viendo Jacob que en Egipto había alimentos, dijo a sus hijos: ¿Por qué os estáis mirando?", "words": [[0, 300], [2, 426], [9, 686], [15, 1066], [19, 1426], [22, 1726], [29, 2266], [35, 2506], [46, 3666], [51, 4026], [53, 4206], [57, 4346], [64, 5130], [69, 5272], [73, 5452], [76, 5592], [83, 5912]]}, {"verse": 2, "start": 6744, "end": 16178, "text": "Y dijo: He aquí, yo he oído que hay víveres en Egipto; descended allá, y comprad de allí para nosotros, para que podamos vivir, y no nos muramos.", "words": [[0, 6744], [2, 6873], [8, 7646], [11, 7736], [17, 7996], [20, 8276], [23, 8376], [28, 8676], [32, 8876], [36, 9036], [44, 9496], [47, 9596], [55, 10372], [65, 10876], [71, 11196], [73, 11716], [81, 12196], [84, 12296], [89, 12496], [94, 12736], [104, 13616], [109, 13936], [113, 14056], [121, 14476], [128, 14716], [130, 15236], [133, 15376], [137, 15536]]}, {"verse": 3, "start": 16458, "end": 20234, "text": "Y descendieron los diez hermanos de José a comprar trigo a Egipto.", "words": [[0, 16458], [2, 16564], [15, 17204], [19, 17497], [24, 17791], [33, 18084], [36, 18224], [41, 18484], [43, 18744], [51, 19044], [57, 19544], [59, 19664]]}, {"verse": 4, "start": 20584, "end": 28828, "text": "Mas Jacob no envió a Benjamín hermano de José con sus hermanos; porque dijo: No sea acaso que le acontezca algún desastre.", "words": [[0, 20584], [4, 20852], [10, 21412], [13, 21832], [19, 22212], [21, 22432], [30, 23052], [38, 23552], [41, 23632], [46, 23892], [50, 24172], [54, 24372], [64, 25154], [71, 25361], [77, 26134], [80, 26282], [84, 26522], [90, 26962], [94, 27142], [97, 27282], [107, 27922], [113, 28162]]}, {"verse": 5, "start": 29178, "end": 36618, "text": "Y vinieron los hijos de Israel a comprar entre los que venían: porque había hambre en la tierra de Canaán.", "words": [[0, 29178], [2, 29300], [11, 29780], [15, 29980], [21, 30300], [24, 30480], [31, 30860], [33, 31020], [41, 31560], [47, 32100], [51, 32320], [55, 32500], [63, 33446], [70, 33832], [76, 34312], [83, 34952], [86, 35232], [89, 35372], [96, 35692], [99, 36184]]}, {"verse": 6, "start": 36968, "end": 48784, "text": "Y José era el gobernador del país, quien vendía alimento a todo el pueblo: y llegaron los hermanos de José, y se inclinaron a él rostro por tierra.", "words": [[0, 36968], [2, 37096], [7, 37476], [11, 37911], [14, 38211], [25, 38971], [29, 39151], [35, 39691], [41, 40531], [48, 41171], [57, 41731], [59, 41971], [64, 42211], [67, 42411], [75, 43643], [77, 43749], [86, 44169], [90, 44369], [99, 44849], [102, 44949], [108, 45309], [110, 45784], [113, 45944], [124, 46844], [126, 47024], [129, 47224], [136, 47824], [140, 48044]]}, {"verse": 7, "start": 49134, "end": 63056, "text": "Y José como vio a sus hermanos, los conoció; mas hizo que no los conocía, y les habló ásperamente, y les dijo: ¿De dónde habéis venido? Ellos respondieron: De la tierra de Canaán a comprar alimentos.", "words": [[0, 49134], [2, 49399], [7, 49919], [12, 50079], [16, 50379], [18, 50499], [22, 50639], [32, 51559], [36, 51719], [45, 52740], [49, 52906], [54, 53073], [58, 53273], [61, 53433], [65, 53573], [74, 54213], [76, 54393], [80, 54553], [86, 55053], [99, 55873], [101, 56133], [105, 56253], [111, 57056], [115, 57213], [121, 57373], [128, 57733], [136, 58571], [142, 58938], [156, 60200], [159, 60342], [162, 60462], [169, 60782], [172, 61022], [179, 61462], [181, 61662], [189, 62022]]}, {"verse": 8, "start": 63406, "end": 68456, "text": "José, pues, conoció a sus hermanos; pero ellos no le conocieron.", "words": [[0, 63406], [6, 63834], [12, 64294], [20, 65054], [22, 65254], [26, 65374], [36, 66378], [41, 66544], [47, 66864], [50, 67444], [53, 67584]]}, {"verse": 9, "start": 68806, "end": 78609, "text": "Entonces se acordó José de los sueños que había tenido de ellos, y les dijo: Espías sois; habéis venido a ver las zonas desprotegidas del país.", "words": [[0, 68806], [9, 69584], [12, 69844], [19, 70344], [24, 70664], [27, 70864], [31, 71004], [38, 71504], [42, 71644], [48, 71844], [55, 72184], [58, 72484], [65, 72764], [67, 73064], [71, 73244], [77, 74062], [84, 74630], [90, 75444], [97, 75762], [104, 76162], [106, 76282], [110, 76402], [114, 76562], [120, 76922], [134, 77742], [138, 77942]]}, {"verse": 10, "start": 78889, "end": 85440, "text": "Y ellos le respondieron: No, señor mío: mas tus siervos han venido a comprar alimentos.", "words": [[0, 78889], [2, 79056], [8, 79416], [11, 79836], [25, 80976], [29, 81176], [35, 81376], [40, 82136], [44, 82387], [48, 82527], [56, 83147], [60, 83407], [67, 83867], [69, 83987], [77, 84347]]}, {"verse": 11, "start": 85790, "end": 92391, "text": "Todos nosotros somos hijos de un varón: somos hombres de verdad: tus siervos nunca fueron espías.", "words": [[0, 85790], [6, 86032], [15, 86512], [21, 86892], [27, 87212], [30, 87452], [33, 87751], [40, 88302], [46, 88692], [54, 89082], [57, 89472], [65, 90049], [69, 90153], [77, 90593], [83, 91073], [90, 91533]]}, {"verse": 12, "start": 92741, "end": 96985, "text": "Y él les dijo: No; a ver lo descubierto del país habéis venido.", "words": [[0, 92741], [2, 92925], [5, 93065], [9, 93245], [15, 94036], [19, 94615], [21, 94737], [25, 94857], [28, 95017], [40, 95617], [44, 95797], [49, 96077], [56, 96457]]}, {"verse": 13, "start": 97265, "end": 109811, "text": "Y ellos respondieron: Tus siervos somos doce hermanos, hijos de un varón en la tierra de Canaán; y he aquí el menor está hoy con nuestro padre, y otro no aparece.", "words": [[0, 97265], [2, 97429], [8, 97669], [22, 99121], [26, 99335], [34, 99548], [40, 99968], [45, 100508], [55, 101488], [61, 101688], [64, 101988], [67, 102128], [73, 102948], [76, 103148], [79, 103308], [86, 103688], [89, 103908], [97, 104678], [99, 104887], [102, 105007], [107, 105287], [110, 105447], [116, 105727], [121, 106007], [125, 106367], [129, 106587], [137, 106887], [144, 107567], [146, 108107], [151, 108407], [154, 109027]]}, {"verse": 14, "start": 110161, "end": 114871, "text": "Y José les dijo: Eso es lo que os he dicho, afirmando que sois espías:", "words": [[0, 110161], [2, 110363], [7, 110643], [11, 110923], [17, 111788], [21, 112013], [24, 112153], [27, 112273], [31, 112393], [34, 112533], [37, 112633], [44, 113253], [54, 113713], [58, 113853], [63, 114113]]}, {"verse": 15, "start": 115221, "end": 121247, "text": "En esto seréis probados: Vive Faraón que no saldréis de aquí, sino cuando vuestro hermano menor aquí venga.", "words": [[0, 115221], [3, 115387], [8, 115597], [15, 116017], [25, 116966], [30, 117171], [37, 117631], [41, 117771], [44, 117891], [53, 118391], [56, 118491], [62, 119071], [67, 119251], [74, 119491], [82, 119891], [90, 120271], [96, 120431], [101, 120731]]}, {"verse": 16, "start": 121597, "end": 132433, "text": "Enviad uno de vosotros, y traiga a vuestro hermano; y vosotros quedad presos, y vuestras palabras serán probadas, si hay verdad con vosotros: y si no, vive Faraón, que sois espías.", "words": [[0, 121597], [7, 122040], [11, 122200], [14, 122360], [24, 122920], [26, 123240], [33, 123640], [35, 123720], [43, 124040], [52, 124835], [54, 124960], [63, 125420], [70, 125860], [78, 126440], [80, 126720], [89, 127040], [98, 127380], [104, 127760], [114, 128300], [117, 128660], [121, 128800], [128, 129080], [132, 129360], [142, 130246], [144, 130373], [147, 130493], [151, 130793], [156, 130973], [164, 131493], [168, 131693], [173, 131953]]}, {"verse": 17, "start": 132713, "end": 135191, "text": "Y los juntó en la cárcel por tres días.", "words": [[0, 132713], [2, 132810], [6, 132940], [12, 133360], [15, 133420], [18, 133560], [25, 133940], [29, 134160], [34, 134500]]}, {"verse": 18, "start": 135541, "end": 140412, "text": "Y al tercer día les dijo José: Haced esto, y vivid: Yo temo a Dios:", "words": [[0, 135541], [2, 135645], [5, 135765], [12, 136065], [16, 136465], [20, 136665], [25, 136985], [31, 137903], [37, 138093], [43, 138473], [45, 138823], [52, 139340], [55, 139496], [60, 139856], [62, 139956]]}, {"verse": 19, "start": 140762, "end": 149380, "text": "Si sois hombres de verdad, quede preso en la casa de vuestra cárcel uno de vuestros hermanos; y vosotros id, llevad el alimento para el hambre de vuestra casa:", "words": [[0, 140762], [3, 140904], [8, 141244], [16, 141484], [19, 141724], [27, 142464], [33, 142684], [39, 143104], [42, 143164], [45, 143284], [50, 143544], [53, 143744], [61, 144084], [68, 144524], [72, 144824], [75, 145004], [84, 145344], [94, 146074], [96, 146181], [105, 146481], [109, 146781], [116, 147081], [119, 147381], [128, 147801], [133, 148101], [136, 148241], [143, 148481], [146, 148601], [154, 148921]]}, {"verse": 20, "start": 149730, "end": 157794, "text": "Pero habéis de traerme a vuestro hermano menor, y serán verificadas vuestras palabras, y no moriréis. Y ellos lo hicieron así.", "words": [[0, 149730], [5, 149872], [12, 150152], [15, 150272], [23, 150652], [25, 150792], [33, 151052], [41, 151452], [48, 151732], [50, 152132], [56, 152432], [68, 153052], [77, 153432], [87, 153852], [89, 154372], [92, 154512], [102, 155516], [104, 155681], [110, 156041], [113, 156541], [122, 157041]]}, {"verse": 21, "start": 158144, "end": 171317, "text": "Y decían el uno al otro: Verdaderamente hemos pecado contra nuestro hermano, que vimos la angustia de su alma cuando nos rogaba, y no le oímos: por eso ha venido sobre nosotros esta angustia.", "words": [[0, 158144], [2, 158232], [9, 158692], [12, 158872], [16, 159092], [19, 159292], [25, 160032], [40, 160917], [46, 161157], [53, 161677], [60, 162037], [68, 162277], [77, 163037], [81, 163317], [87, 163557], [90, 163777], [99, 164277], [102, 164417], [105, 164617], [110, 164917], [117, 165177], [121, 165497], [129, 166077], [131, 166497], [134, 166697], [137, 166837], [144, 167779], [148, 167901], [152, 168201], [155, 168541], [162, 168961], [168, 169221], [177, 169841], [182, 170481]]}, {"verse": 22, "start": 171667, "end": 182476, "text": "Entonces Rubén les respondió, diciendo: ¿No os hablé yo y dije: No pequéis contra el joven; y no escuchasteis? He aquí también su sangre es requerida.", "words": [[0, 171776], [9, 172448], [15, 173119], [19, 173419], [30, 174219], [40, 175801], [44, 175983], [47, 176143], [53, 176443], [56, 176663], [58, 176803], [64, 177440], [67, 177677], [75, 177947], [82, 178207], [85, 178387], [92, 179045], [94, 179143], [97, 179243], [111, 180444], [114, 180514], [119, 180734], [127, 181014], [130, 181294], [137, 181674], [140, 181854]]}, {"verse": 23, "start": 182756, "end": 187923, "text": "Y ellos no sabían que los entendía José, porque había intérprete entre ellos.", "words": [[0, 182756], [2, 182900], [8, 183120], [11, 183340], [18, 183780], [22, 183940], [26, 184100], [35, 184740], [41, 185380], [48, 185780], [54, 186120], [65, 187020], [71, 187280]]}, {"verse": 24, "start": 188273, "end": 199227, "text": "Y se apartó él de ellos, y lloró: después volvió a ellos, y les habló, y tomó de entre ellos a Simeón, y lo aprisionó a vista de ellos.", "words": [[0, 188273], [2, 188420], [5, 188500], [12, 189020], [15, 189320], [18, 189540], [25, 189860], [27, 190400], [34, 191075], [42, 191497], [49, 192537], [51, 192657], [58, 192957], [60, 193342], [64, 193522], [71, 194242], [73, 194442], [78, 194882], [81, 195002], [87, 195302], [93, 195642], [95, 195922], [103, 196502], [105, 196922], [108, 197102], [118, 198082], [120, 198222], [126, 198482], [129, 198762]]}, {"verse": 25, "start": 199577, "end": 212211, "text": "Y mandó José que llenaran sus sacos de trigo, y devolviesen el dinero de cada uno de ellos, poniéndolo en su saco, y les diesen comida para el camino: y se hizo así con ellos.", "words": [[0, 199577], [2, 199719], [8, 200179], [13, 200499], [17, 200739], [26, 201279], [30, 201559], [36, 202139], [39, 202239], [46, 202739], [48, 203199], [60, 203859], [63, 204199], [70, 204559], [73, 204799], [78, 205019], [82, 205339], [85, 205499], [92, 206079], [103, 206859], [106, 206999], [109, 207139], [115, 207879], [117, 208159], [121, 208299], [128, 208679], [135, 209199], [140, 209459], [143, 209619], [151, 210455], [153, 210584], [156, 210724], [161, 211004], [165, 211244], [169, 211544]]}, {"verse": 26, "start": 212561, "end": 216439, "text": "Y ellos pusieron su trigo sobre sus asnos, y se fueron de allí.", "words": [[0, 212561], [2, 212689], [8, 212889], [17, 213349], [20, 213569], [26, 213989], [32, 214289], [36, 214529], [43, 215009], [45, 215409], [48, 215529], [55, 215749], [58, 216029]]}, {"verse": 27, "start": 216789, "end": 224447, "text": "Y abriendo uno de ellos su saco para dar de comer a su asno en el posada, vio su dinero que estaba en la boca de su costal.", "words": [[0, 216789], [2, 216906], [11, 217446], [15, 217786], [18, 217986], [24, 218286], [27, 218506], [32, 218986], [37, 219206], [41, 219446], [44, 219646], [50, 219906], [52, 220106], [55, 220266], [60, 220666], [63, 220786], [66, 220906], [74, 221726], [78, 222046], [81, 222186], [88, 222566], [92, 222806], [99, 223026], [102, 223186], [105, 223306], [110, 223506], [113, 223686], [116, 223826]]}, {"verse": 28, "start": 224797, "end": 238040, "text": "Y dijo a sus hermanos: Mi dinero se me ha devuelto, y aquí está en mi saco. Se les sobresaltó entonces el corazón, y espantados dijeron el uno al otro: ¿Qué es esto que nos ha hecho Dios?", "words": [[0, 224797], [2, 224941], [7, 225261], [9, 225461], [13, 225601], [23, 226641], [26, 226768], [33, 227128], [36, 227408], [39, 227548], [42, 227648], [52, 228288], [54, 228788], [59, 229048], [64, 229368], [67, 229548], [70, 229688], [76, 230469], [79, 230615], [83, 230835], [94, 231815], [103, 232295], [106, 232635], [115, 233095], [117, 233595], [128, 234195], [136, 234735], [139, 234875], [143, 235075], [146, 235255], [152, 236015], [157, 236181], [160, 236381], [165, 236681], [169, 236861], [173, 237061], [176, 237241], [182, 237441]]}, {"verse": 29, "start": 238390, "end": 246326, "text": "Y venidos a Jacob su padre en tierra de Canaán, le contaron todo lo que les había acontecido, diciendo:", "words": [[0, 238390], [2, 238516], [10, 238956], [12, 239136], [18, 239816], [21, 239956], [27, 240296], [30, 240656], [37, 241016], [40, 241256], [48, 242276], [51, 242376], [60, 242956], [65, 243296], [68, 243676], [72, 243876], [76, 244056], [82, 244456], [94, 245496]]}, {"verse": 30, "start": 246676, "end": 252733, "text": "Aquel varón, señor de la tierra, nos habló ásperamente, y nos trató como a espías de la tierra:", "words": [[0, 246676], [6, 247004], [13, 247324], [19, 247624], [22, 247864], [25, 247984], [33, 248424], [37, 249064], [43, 249484], [56, 250304], [58, 250424], [62, 250544], [68, 251004], [73, 251244], [75, 251404], [82, 251924], [85, 252124], [88, 252224]]}, {"verse": 31, "start": 253083, "end": 258613, "text": "Y nosotros le dijimos: Somos hombres de verdad, nunca fuimos espías:", "words": [[0, 253083], [2, 253443], [11, 253763], [14, 254143], [23, 255004], [29, 255591], [37, 256031], [40, 256251], [48, 256651], [54, 257211], [61, 257943]]}, {"verse": 32, "start": 258963, "end": 267668, "text": "Somos doce hermanos, hijos de nuestro padre; uno no aparece, y el menor está hoy con nuestro padre en la tierra de Canaán.", "words": [[0, 258963], [6, 259462], [11, 259902], [21, 260542], [27, 260742], [30, 261022], [38, 261202], [45, 262204], [49, 262448], [52, 262808], [61, 263468], [63, 263753], [66, 263893], [72, 264233], [77, 264553], [81, 264833], [85, 265053], [93, 265433], [99, 266093], [102, 266293], [105, 266433], [112, 266793], [115, 267230]]}, {"verse": 33, "start": 268018, "end": 280809, "text": "Y aquel varón, señor de la tierra, nos dijo: En esto conoceré que sois hombres de verdad; dejad conmigo uno de vuestros hermanos, y tomad para el hambre de vuestras casas, y andad,", "words": [[0, 268018], [2, 268208], [8, 268488], [15, 268808], [21, 269128], [24, 269328], [27, 269468], [35, 269748], [39, 270128], [45, 270908], [48, 271052], [53, 271312], [62, 272032], [66, 272152], [71, 272532], [79, 272992], [82, 273272], [90, 274158], [96, 274849], [104, 275389], [108, 275689], [111, 275849], [120, 276269], [130, 277109], [132, 277329], [138, 277549], [143, 277909], [146, 278229], [153, 278589], [156, 278749], [165, 279069], [172, 279909], [174, 280149]]}, {"verse": 34, "start": 281159, "end": 292615, "text": "Y traedme a vuestro hermano el menor, para que yo sepa que no sois espías, sino hombres de verdad: así os daré a vuestro hermano, y negociaréis en la tierra.", "words": [[0, 281159], [2, 281309], [10, 281989], [12, 282109], [20, 282429], [28, 282869], [31, 282949], [38, 283969], [43, 284249], [47, 284389], [50, 284549], [55, 284929], [59, 285089], [62, 285269], [67, 285629], [75, 286749], [80, 287089], [88, 287629], [91, 287869], [99, 288699], [103, 288933], [106, 289153], [111, 289473], [113, 289493], [121, 289793], [130, 290613], [132, 290753], [144, 291573], [147, 291773], [150, 291933]]}, {"verse": 35, "start": 292965, "end": 304031, "text": "Y aconteció que vaciando ellos sus sacos, he aquí que en el saco de cada uno estaba el atado de su dinero: y viendo ellos y su padre los atados de su dinero, tuvieron temor.", "words": [[0, 292965], [2, 293093], [12, 293813], [16, 294013], [25, 294593], [31, 294893], [35, 295173], [42, 295773], [45, 296373], [50, 296713], [54, 296933], [57, 297113], [60, 297233], [65, 297693], [68, 297753], [73, 297933], [77, 298233], [84, 298533], [87, 298833], [93, 299133], [96, 299273], [99, 299413], [107, 300236], [109, 300340], [116, 300600], [122, 300860], [124, 301100], [127, 301240], [133, 301700], [137, 301820], [144, 302320], [147, 302480], [150, 302600], [158, 302960], [167, 303460]]}, {"verse": 36, "start": 304381, "end": 315250, "text": "Entonces su padre Jacob les dijo: Me habéis privado de mis hijos; José no aparece, ni Simeón tampoco, y a Benjamín le llevaréis: contra mí son todas estas cosas.", "words": [[0, 304381], [9, 305166], [12, 305386], [18, 305886], [24, 306506], [28, 306606], [34, 307323], [37, 307428], [44, 307648], [52, 308108], [55, 308228], [59, 308348], [66, 309138], [71, 309366], [74, 309606], [83, 310046], [86, 310366], [93, 310866], [102, 311286], [104, 311906], [106, 311986], [115, 312506], [118, 312606], [129, 313366], [136, 313703], [139, 313823], [143, 314023], [149, 314223], [155, 314523]]}, {"verse": 37, "start": 315530, "end": 324130, "text": "Y Rubén habló a su padre, diciendo: Harás morir a mis dos hijos, si no te lo devuelvo; entrégalo en mi mano, que yo te lo devolveré.", "words": [[0, 315530], [2, 315809], [8, 316119], [14, 316659], [16, 316759], [19, 316879], [26, 317819], [36, 318929], [42, 319189], [48, 319509], [50, 319569], [54, 319689], [58, 319829], [65, 320169], [68, 320489], [71, 320569], [74, 320709], [77, 320829], [87, 321892], [97, 322172], [100, 322292], [103, 322412], [109, 323012], [113, 323092], [116, 323252], [119, 323392], [122, 323492]]}, {"verse": 38, "start": 324410, "end": 336562, "text": "Y él dijo: No descenderá mi hijo con vosotros; que su hermano es muerto, y él solo ha quedado: y si le acontece algún desastre en el camino por donde vais, haréis descender mis canas con dolor a la sepultura.", "words": [[0, 324410], [2, 324598], [5, 324758], [11, 325477], [14, 325601], [25, 326221], [28, 326361], [33, 326581], [37, 326781], [47, 327770], [51, 327850], [54, 328010], [62, 328410], [65, 328530], [73, 328970], [75, 329290], [78, 329410], [83, 329690], [86, 329870], [95, 330608], [97, 330691], [100, 330771], [103, 330871], [112, 331271], [118, 331631], [127, 332171], [130, 332291], [133, 332371], [140, 332671], [144, 332931], [150, 333131], [156, 333911], [163, 334171], [173, 334631], [177, 334811], [183, 335191], [187, 335351], [193, 335631], [195, 335751], [198, 335851]]}]}