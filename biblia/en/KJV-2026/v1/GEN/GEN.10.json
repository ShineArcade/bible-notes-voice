{"book": "GEN", "chapter": 10, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 201182, "verses": [{"verse": 1, "start": 300, "end": 7590, "text": "Now these are the generations of the sons of Noah, Shem, Ham, and Japheth: and to them were sons born after the flood.", "words": [[0, 300], [4, 551], [10, 911], [14, 1191], [18, 1311], [30, 1851], [33, 2151], [37, 2251], [42, 2511], [45, 2691], [51, 3311], [57, 3811], [62, 4211], [66, 4271], [75, 5243], [79, 5366], [82, 5566], [87, 5786], [92, 5966], [97, 6226], [102, 6586], [108, 6926], [112, 7106]]}, {"verse": 2, "start": 8040, "end": 14463, "text": "The sons of Japheth; Gomer, and Magog, and Madai, and Javan, and Tubal, and Meshech, and Tiras.", "words": [[0, 8040], [4, 8141], [9, 8461], [12, 8899], [21, 9803], [28, 10063], [32, 10123], [39, 10563], [43, 10933], [50, 11303], [54, 11683], [61, 12063], [65, 12263], [72, 12763], [76, 13123], [85, 13483], [89, 13973]]}, {"verse": 3, "start": 14913, "end": 19232, "text": "And the sons of Gomer; Ashkenaz, and Riphath, and Togarmah.", "words": [[0, 14913], [4, 15173], [8, 15293], [13, 15613], [16, 16021], [23, 16730], [33, 17451], [37, 17851], [46, 18251], [50, 18741]]}, {"verse": 4, "start": 19682, "end": 24138, "text": "And the sons of Javan; Elishah, and Tarshish, Kittim, and Dodanim.", "words": [[0, 19682], [4, 19829], [8, 19969], [13, 20289], [16, 20710], [23, 21576], [32, 21796], [36, 22116], [46, 22656], [54, 23196], [58, 23700]]}, {"verse": 5, "start": 24588, "end": 32666, "text": "By these were the isles of the Gentiles divided in their lands; every one after his tongue, after their families, in their nations.", "words": [[0, 24588], [3, 24777], [9, 25117], [14, 25417], [18, 25707], [24, 25997], [27, 26097], [31, 26197], [40, 26897], [48, 27377], [51, 27717], [57, 27917], [64, 28961], [70, 29081], [74, 29201], [80, 29661], [84, 29901], [92, 30561], [98, 30761], [104, 30981], [114, 31721], [117, 31801], [123, 31921]]}, {"verse": 6, "start": 33116, "end": 38699, "text": "¶ And the sons of Ham; Cush, and Mizraim, and Phut, and Canaan.", "words": [[2, 33116], [6, 33356], [10, 33496], [15, 33756], [18, 33956], [23, 35073], [29, 35393], [33, 35963], [42, 36533], [46, 37203], [52, 37873], [56, 38325]]}, {"verse": 7, "start": 39149, "end": 49916, "text": "And the sons of Cush; Seba, and Havilah, and Sabtah, and Raamah, and Sabtecha: and the sons of Raamah; Sheba, and Dedan.", "words": [[0, 39149], [4, 39388], [8, 39508], [13, 39828], [16, 40251], [22, 40912], [28, 41429], [32, 41869], [41, 42549], [45, 43119], [53, 43689], [57, 44059], [65, 44429], [69, 45270], [79, 46348], [83, 46808], [87, 46928], [92, 47168], [95, 47579], [103, 48531], [110, 48821], [114, 49394]]}, {"verse": 8, "start": 50366, "end": 55703, "text": "And Cush begot Nimrod: he began to be a mighty one in the earth.", "words": [[0, 50366], [4, 50775], [9, 51185], [15, 51685], [23, 53134], [26, 53224], [32, 53584], [35, 53744], [38, 53944], [40, 54064], [47, 54404], [51, 54764], [54, 55084], [58, 55204]]}, {"verse": 9, "start": 56153, "end": 63421, "text": "He was a mighty hunter before the LORD: therefore it is said, Even as Nimrod the mighty hunter before the LORD.", "words": [[0, 56153], [3, 56267], [7, 56447], [9, 56587], [16, 56887], [23, 57327], [30, 57707], [34, 57967], [40, 58789], [50, 59215], [53, 59595], [56, 59755], [62, 60395], [67, 60695], [70, 60975], [77, 61495], [81, 61715], [88, 61955], [95, 62335], [102, 62695], [106, 62935]]}, {"verse": 10, "start": 63871, "end": 71052, "text": "And the beginning of his kingdom was Babel, and Erech, and Accad, and Calneh, in the land of Shinar.", "words": [[0, 63871], [4, 64045], [8, 64125], [18, 64405], [21, 64665], [25, 64765], [33, 65125], [37, 65405], [44, 66005], [48, 66545], [55, 67145], [59, 67715], [66, 68285], [70, 68685], [78, 69085], [81, 69745], [85, 69885], [90, 70145], [93, 70285]]}, {"verse": 11, "start": 71502, "end": 77378, "text": "Out of that land went forth Asshur, and built Nineveh, and the city Rehoboth, and Calah,", "words": [[0, 71502], [4, 71671], [7, 71831], [12, 72051], [17, 72391], [22, 72591], [28, 73291], [36, 73991], [40, 73991], [46, 74251], [55, 75151], [59, 75251], [63, 75351], [68, 75611], [78, 76671], [82, 77035]]}, {"verse": 12, "start": 77828, "end": 81777, "text": "And Resen between Nineveh and Calah: the same is a great city.", "words": [[0, 77828], [4, 78054], [10, 78294], [18, 78674], [26, 79394], [30, 79759], [37, 80350], [41, 80455], [46, 80715], [49, 80915], [51, 81015], [57, 81195]]}, {"verse": 13, "start": 82227, "end": 86817, "text": "And Mizraim begot Ludim, and Anamim, and Lehabim, and Naphtuhim,", "words": [[0, 82227], [4, 82574], [12, 82934], [18, 83414], [25, 83894], [29, 84374], [37, 84854], [41, 85274], [50, 85694], [54, 86256]]}, {"verse": 14, "start": 87267, "end": 92120, "text": "And Pathrusim, and Casluhim, (out of whom came Philistim,) and Caphtorim.", "words": [[0, 87267], [4, 87920], [15, 88600], [19, 89050], [29, 89500], [34, 89700], [37, 89840], [42, 90020], [47, 90300], [59, 91280], [63, 91730]]}, {"verse": 15, "start": 92570, "end": 96069, "text": "¶ And Canaan begot Sidon his firstborn, and Heth,", "words": [[2, 92570], [6, 92832], [13, 93332], [19, 93872], [25, 94412], [29, 94592], [40, 95252], [44, 95672]]}, {"verse": 16, "start": 96519, "end": 99790, "text": "And the Jebusite, and the Amorite, and the Girgasite,", "words": [[0, 96519], [4, 96673], [8, 96773], [18, 97493], [22, 97673], [26, 97773], [35, 98373], [39, 98853], [43, 99356]]}, {"verse": 17, "start": 100240, "end": 103547, "text": "And the Hivite, and the Arkite, and the Sinite,", "words": [[0, 100240], [4, 100378], [8, 100458], [16, 101218], [20, 101538], [24, 102098], [32, 102658], [36, 102698], [40, 102778]]}, {"verse": 18, "start": 103997, "end": 111524, "text": "And the Arvadite, and the Zemarite, and the Hamathite: and afterward were the families of the Canaanites spread abroad.", "words": [[0, 103997], [4, 104139], [8, 104709], [18, 105279], [22, 105559], [26, 106149], [36, 106739], [40, 107019], [44, 107467], [55, 108153], [59, 108258], [69, 108648], [74, 109038], [78, 109178], [87, 109598], [90, 109818], [94, 109958], [105, 110558], [112, 110878]]}, {"verse": 19, "start": 111974, "end": 123226, "text": "And the border of the Canaanites was from Sidon, as you come to Gerar, to Gaza; as you go, to Sodom, and Gomorrah, and Admah, and Zeboim, even to Lasha.", "words": [[0, 111974], [4, 112098], [8, 112198], [15, 112478], [18, 112678], [22, 112798], [33, 113378], [37, 113538], [42, 113758], [49, 114418], [52, 114818], [56, 114938], [61, 115138], [64, 115298], [71, 115738], [74, 116098], [80, 117032], [83, 117216], [87, 117296], [91, 117436], [94, 117556], [101, 118616], [105, 118696], [115, 119816], [119, 120396], [126, 120976], [130, 121156], [138, 121956], [143, 122216], [146, 122416]]}, {"verse": 20, "start": 123676, "end": 130416, "text": "These are the sons of Ham, after their families, after their tongues, in their countries, and in their nations.", "words": [[0, 123676], [6, 124036], [10, 124176], [14, 124316], [19, 124596], [22, 124796], [27, 125136], [33, 125636], [39, 125836], [49, 126816], [55, 126996], [61, 127216], [70, 127596], [73, 128056], [79, 128216], [90, 128656], [94, 129356], [97, 129556], [103, 129716]]}, {"verse": 21, "start": 130866, "end": 138026, "text": "¶ To Shem also, the father of all the children of Eber, the brother of Japheth the elder, even to him were children born.", "words": [[2, 130866], [5, 130966], [10, 131306], [16, 131606], [20, 131826], [27, 132146], [30, 132426], [34, 132586], [38, 132746], [47, 133066], [50, 133266], [56, 134046], [60, 134246], [68, 134506], [71, 134746], [79, 135226], [83, 135366], [90, 136086], [95, 136326], [98, 136586], [102, 136786], [107, 137026], [116, 137386]]}, {"verse": 22, "start": 138476, "end": 143847, "text": "The children of Shem; Elam, and Asshur, and Arphaxad, and Lud, and Aram.", "words": [[0, 138476], [4, 138554], [13, 138914], [16, 139094], [22, 139980], [28, 140371], [32, 140761], [40, 141151], [44, 141691], [54, 142231], [58, 142591], [63, 142951], [67, 143211]]}, {"verse": 23, "start": 144297, "end": 148776, "text": "And the children of Aram; Uz, and Hul, and Gether, and Mash.", "words": [[0, 144297], [4, 144437], [8, 144537], [17, 144917], [20, 145438], [26, 146363], [30, 146563], [34, 146803], [39, 147043], [43, 147373], [51, 147703], [55, 148123]]}, {"verse": 24, "start": 149226, "end": 153118, "text": "And Arphaxad begot Salah; and Salah begot Eber.", "words": [[0, 149226], [4, 149640], [13, 150080], [19, 150520], [26, 151511], [30, 151655], [36, 152135], [42, 152535]]}, {"verse": 25, "start": 153568, "end": 162519, "text": "And to Eber were born two sons: the name of one was Peleg; for in his days was the earth divided; and his brother’s name was Joktan.", "words": [[0, 153568], [4, 153709], [7, 153939], [12, 154169], [17, 154369], [22, 154709], [26, 155029], [32, 156098], [36, 156183], [41, 156443], [44, 156623], [48, 156843], [52, 157358], [59, 158100], [63, 158191], [66, 158391], [70, 158551], [75, 158871], [79, 159131], [83, 159291], [89, 159491], [98, 160490], [102, 160613], [106, 160753], [116, 161213], [121, 161453], [125, 161986]]}, {"verse": 26, "start": 162969, "end": 167685, "text": "And Joktan begot Almodad, and Sheleph, and Hazarmaveth, and Jerah,", "words": [[0, 162969], [4, 163279], [11, 163619], [17, 164159], [26, 164699], [30, 165099], [39, 165499], [43, 166029], [56, 166559], [60, 167143]]}, {"verse": 27, "start": 168135, "end": 171065, "text": "And Hadoram, and Uzal, and Diklah,", "words": [[0, 168135], [4, 168299], [13, 168999], [17, 169439], [23, 170099], [27, 170582]]}, {"verse": 28, "start": 171515, "end": 173976, "text": "And Obal, and Abimael, and Sheba,", "words": [[0, 171515], [4, 171921], [10, 172361], [14, 172811], [23, 173261], [27, 173640]]}, {"verse": 29, "start": 174426, "end": 179675, "text": "And Ophir, and H