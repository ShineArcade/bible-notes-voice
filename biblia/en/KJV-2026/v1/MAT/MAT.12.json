{"book": "MAT", "chapter": 12, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 358190, "verses": [{"verse": 1, "start": 300, "end": 8331, "text": "At that time Jesus went on the sabbath day through the grain; and his disciples were hungry, and began to pluck the heads of grain, and to eat.", "words": [[0, 300], [3, 430], [8, 670], [13, 1170], [19, 1390], [24, 1750], [27, 1950], [31, 2090], [39, 2410], [43, 2790], [51, 3010], [55, 3170], [62, 3943], [66, 4091], [70, 4231], [80, 4731], [85, 5011], [93, 5391], [97, 5711], [103, 6031], [106, 6231], [112, 6471], [116, 6731], [122, 6971], [125, 7151], [132, 7491], [136, 7771], [139, 7951]]}, {"verse": 2, "start": 8681, "end": 15660, "text": "But when the Pharisees saw it, they said to him, Behold, your disciples do that which is not lawful to do upon the sabbath day.", "words": [[0, 8681], [4, 8782], [9, 8942], [13, 9082], [23, 9662], [27, 9922], [31, 10202], [36, 10282], [41, 10522], [44, 10742], [49, 11272], [57, 11595], [62, 11735], [72, 12255], [75, 12555], [80, 12875], [86, 13215], [89, 13395], [93, 13615], [100, 14035], [103, 14195], [106, 14455], [111, 14695], [115, 14895], [123, 15195]]}, {"verse": 3, "start": 15940, "end": 21172, "text": "But he said to them, Have you not read what David did, when he was hungry, and they that were with him;", "words": [[0, 15940], [4, 16068], [7, 16148], [12, 16348], [15, 16548], [21, 17066], [26, 17207], [30, 17327], [34, 17527], [39, 17847], [44, 18067], [50, 18407], [55, 18767], [60, 19027], [63, 19167], [67, 19327], [75, 19667], [79, 19942], [84, 20202], [89, 20462], [94, 20602], [99, 20862]]}, {"verse": 4, "start": 21522, "end": 30780, "text": "How he entered into the house of God and did eat the show bread which was not lawful for him to eat neither for them which were with him but only for the priests", "words": [[0, 21522], [4, 21687], [7, 21847], [15, 22167], [20, 22407], [24, 22547], [30, 22787], [33, 22967], [37, 23287], [41, 23567], [45, 23827], [49, 24107], [53, 24267], [58, 24487], [64, 24987], [70, 25127], [74, 25267], [78, 25467], [85, 25887], [89, 26047], [93, 26207], [96, 26347], [100, 26507], [108, 26747], [112, 27027], [117, 28442], [123, 28702], [128, 28862], [133, 29102], [137, 29482], [141, 29562], [146, 29862], [150, 30022], [154, 30102]]}, {"verse": 5, "start": 31130, "end": 37737, "text": "Or have you not read in the law, how that on the sabbath days the priests in the temple profane the sabbath, and are blameless?", "words": [[0, 31130], [3, 31269], [8, 31469], [12, 31589], [16, 31769], [21, 32029], [24, 32149], [28, 32249], [33, 32529], [37, 33149], [42, 33329], [45, 33469], [49, 33609], [57, 33869], [62, 34249], [66, 34489], [74, 34789], [77, 35029], [81, 35129], [88, 35369], [96, 35929], [100, 36089], [109, 36429], [113, 36949], [117, 37069]]}, {"verse": 6, "start": 38087, "end": 41910, "text": "But I say to you, That in this place is one greater than the temple.", "words": [[0, 38087], [4, 38189], [6, 38329], [10, 38549], [13, 38749], [18, 38989], [23, 39589], [26, 39729], [31, 39909], [37, 40269], [40, 40469], [44, 40709], [52, 41049], [57, 41309], [61, 41429]]}, {"verse": 7, "start": 42260, "end": 48250, "text": "But if you had known what this means, I will have mercy, and not sacrifice, you would not have condemned the guiltless.", "words": [[0, 42260], [4, 42397], [7, 42517], [11, 42637], [15, 42757], [21, 42957], [26, 43157], [31, 43357], [38, 44057], [40, 44217], [45, 44337], [50, 44497], [57, 44897], [61, 45277], [65, 45477], [76, 46557], [80, 46697], [86, 46817], [90, 46977], [95, 47077], [105, 47397], [109, 47637]]}, {"verse": 8, "start": 48601, "end": 51214, "text": "For the Son of man is Lord even of the sabbath day.", "words": [[0, 48601], [4, 48686], [8, 48806], [12, 49006], [15, 49106], [19, 49366], [22, 49546], [27, 49806], [32, 50106], [35, 50266], [39, 50406], [47, 50666]]}, {"verse": 9, "start": 51494, "end": 54990, "text": "And when he was departed from there, he went into their synagogue:", "words": [[0, 51494], [4, 51604], [9, 51764], [12, 51924], [16, 52064], [25, 52484], [30, 52804], [37, 53424], [40, 53584], [45, 53784], [50, 54024], [56, 54244]]}, {"verse": 10, "start": 55340, "end": 64176, "text": "¶ And, behold, there was a man which had his hand withered. And they asked him, saying, Is it lawful to heal on the sabbath days? that they might accuse him.", "words": [[2, 55340], [7, 55468], [15, 56168], [21, 56388], [25, 56548], [27, 56688], [31, 56968], [37, 57268], [41, 57468], [45, 57608], [50, 57868], [60, 58748], [64, 58910], [69, 59070], [75, 59370], [80, 59610], [88, 60374], [91, 60498], [94, 60618], [101, 61098], [104, 61238], [109, 61538], [112, 61698], [116, 61918], [124, 62138], [130, 62991], [135, 63104], [140, 63224], [146, 63424], [153, 63724]]}, {"verse": 11, "start": 64526, "end": 74815, "text": "And he said to them, What man shall there be among you, that shall have one sheep, and if it fall into a pit on the sabbath day, will he not lay hold on it, and lift it out?", "words": [[0, 64526], [4, 64643], [7, 64723], [12, 64943], [15, 65123], [21, 65493], [26, 65683], [30, 66063], [36, 66403], [42, 66643], [45, 66823], [51, 67083], [56, 67843], [61, 68023], [67, 68223], [72, 68503], [76, 68743], [83, 69543], [87, 69703], [90, 69823], [93, 69923], [98, 70163], [103, 70403], [105, 70603], [109, 70803], [112, 71023], [116, 71163], [124, 71443], [129, 72203], [134, 72343], [137, 72503], [141, 72703], [145, 72903], [150, 73143], [153, 73423], [157, 73893], [161, 74025], [166, 74225], [169, 74385]]}, {"verse": 12, "start": 75165, "end": 80270, "text": "How much then is a man better than a sheep? Therefore it is lawful to do well on the sabbath days.", "words": [[0, 75165], [4, 75291], [9, 75511], [14, 75730], [17, 75910], [19, 76030], [23, 76230], [30, 76511], [35, 76730], [37, 76830], [44, 77473], [54, 77795], [57, 78055], [60, 78175], [67, 78575], [70, 78715], [73, 78875], [78, 79075], [81, 79275], [85, 79395], [93, 79635]]}, {"verse": 13, "start": 80550, "end": 87656, "text": "Then says he to the man, Stretch forth your hand. And he stretched it forth; and it was restored whole, like as the other.", "words": [[0, 80550], [5, 80769], [10, 81069], [13, 81349], [16, 81509], [20, 81629], [25, 82363], [33, 82646], [39, 82926], [44, 83126], [50, 83914], [54, 84041], [57, 84141], [67, 84461], [70, 84741], [77, 85381], [81, 85488], [84, 85568], [88, 85708], [97, 86148], [104, 86588], [109, 86848], [112, 87108], [116, 87288]]}, {"verse": 14, "start": 88006, "end": 93232, "text": "¶ Then the Pharisees went out, and held a council against him, how they might destroy him.", "words": [[2, 88006], [7, 88149], [11, 88269], [21, 88909], [26, 89089], [31, 89349], [35, 89809], [40, 89989], [42, 90169], [50, 90469], [58, 90869], [63, 91289], [67, 91409], [72, 91549], [78, 91729], [86, 92149]]}, {"verse": 15, "start": 93582, "end": 100414, "text": "But when Jesus knew it, he withdrew himself from there: and great multitudes followed him, and he healed them all;", "words": [[0, 93582], [4, 93670], [9, 93870], [15, 94230], [20, 94630], [24, 95030], [27, 95130], [36, 95630], [44, 96030], [49, 96350], [56, 97064], [60, 97204], [66, 97484], [77, 98224], [86, 98584], [91, 99244], [95, 99364], [98, 99504], [105, 99804], [110, 100024]]}, {"verse": 16, "start": 100764, "end": 103379, "text": "And charged them that they should not make him known:", "words": [[0, 100764], [4, 100892], [12, 101252], [17, 101612], [22, 101812], [27, 101972], [34, 102132], [38, 102372], [43, 102672], [47, 102792]]}, {"verse": 17, "start": 103729, "end": 107952, "text": "That it might be fulfilled which was spoken by Esaias the prophet, saying,", "words": [[0, 103729], [5, 103858], [8, 103938], [14, 104138], [17, 104338], [27, 104798], [33, 105138], [37, 105278], [44, 105638], [47, 106088], [54, 106538], [58, 106658], [67, 107338]]}, {"verse": 18, "start": 108152, "end": 117902, "text": "Behold my servant, whom I have chosen; my beloved, in whom my soul is well pleased: I will put my spirit upon him, and he shall show judgment to the Gentiles.", "words": [[0, 108152], [7, 108474], [10, 108674], [19, 109094], [24, 109314], [26, 109494], [31, 109634], [39, 110688], [42, 110829], [51, 111249], [54, 111609], [59, 111789], [62, 112029], [67, 112409], [70, 112629], [75, 112829], [84, 113973], [86, 114072], [91, 114192], [95, 114372], [98, 114512], [105, 114872], [110, 115112], [115, 115732], [119, 115812], [122, 115932], [128, 116112], [133, 116352], [142, 116812], [145, 117052], [149, 117132]]}, {"verse": 19, "start": 118431, "end": 123814, "text": "He shall not strive, nor cry; neither shall any man hear his voice in the streets.", "words": [[0, 118431], [3, 118540], [9, 118760], [13, 118980], [21, 119520], [25, 119920], [30, 120817], [38, 121025], [44, 121325], [48, 121645], [52, 122025], [57, 122305], [61, 122525], [67, 122865], [70, 123045], [74, 123165]]}, {"verse": 20, "start": 124034, "end": 131032, "text": "A bruised reed shall he not break, and smoking flax shall he not quench, till he send forth judgment to victory.", "words": [[0, 124034], [2, 124182], [10, 124562], [15, 125002], [21, 125142], [24, 125302], [28, 125502], [35, 126262], [39, 126502], [47, 126952], [52, 127402], [58, 127622], [61, 127802], [65, 128002], [73, 128782], [78, 128962], [81, 129102], [86, 129382], [92, 129682], [101, 130122], [104, 130382]]}, {"verse": 21, "start": 131618, "end": 134036, "text": "And in his name shall the Gentiles trust.", "words": [[0, 131618], [4, 131756], [7, 131856], [11, 132036], [16, 132396], [22, 132696], [26, 132836], [35, 133416]]}, {"verse": 22, "start": 134579, "end": 143048, "text": "¶ Then was brought to him one demon-possessed, blind, and dumb: and he healed him, so that the blind and dumb both spoke and saw.", "words": [[2, 134579], [7, 134782], [11, 135042], [19, 135302], [22, 135542], [26, 135762], [30, 136594], [47, 137427], [54, 138207], [58, 138287], [64, 139010], [68, 139135], [71, 139255], [78, 139575], [83, 139815], [86, 140215], [91, 140395], [95, 140535], [101, 140955], [105, 141135], [110, 141435], [115, 141715], [121, 142155], [125, 142475]]}, {"verse": 23, "start": 143398, "end": 147398, "text": "And all the people were amazed, and said, Is not this the son of David?", "words": [[0, 143398], [4, 143544], [8, 143744], [12, 143884], [19, 144124], [24, 144404], [32, 144804], [36, 145164], [42, 145849], [45, 145981], [49, 146201], [54, 146441], [58, 146621], [62, 146841], [65, 146961]]}, {"verse": 24, "start": 147678, "end": 154991, "text": "But when the Pharisees heard it, they said, This fellow does not cast out demons, but by Beelzebub the prince of the demons.", "words": [[0, 147678], [4, 147778], [9, 147938], [13, 148078], [23, 148658], [29, 148878], [33, 149138], [38, 149238], [44, 150525], [49, 150663], [56, 150923], [61, 151143], [65, 151303], [70, 151603], [74, 151783], [82, 152583], [86, 152683], [89, 152863], [99, 153583], [103, 153743], [110, 154043], [113, 154283], [117, 154403]]}, {"verse": 25, "start": 155271, "end": 164980, "text": "And Jesus knew their thoughts, and said to them, Every kingdom divided against itself is brought to desolation; and every city or house divided against itself shall not stand:", "words": [[0, 155271], [4, 155401], [10, 155721], [15, 156141], [21, 156341], [31, 156741], [35, 157101], [40, 157341], [43, 157501], [49, 158035], [55, 158280], [63, 158620], [71, 159080], [79, 159440], [86, 159940], [89, 160140], [97, 160380], [100, 160560], [112, 161612], [116, 161735], [122, 161995], [127, 162275], [130, 162415], [136, 162695], [144, 163115], [152, 163455], [159, 163935], [165, 164175], [169, 164395]]}, {"verse": 26, "start": 165330, "end": 170704, "text": "And if Satan cast out Satan, he is divided against himself; how shall then his kingdom stand?", "words": [[0, 165330], [4, 165450], [7, 165550], [13, 165830], [18, 166190], [22, 166390], [29, 167110], [32, 167190], [35, 167290], [43, 167650], [51, 167930], [60, 168810], [64, 168987], [70, 169207], [75, 169447], [79, 169647], [87, 169987]]}, {"verse": 27, "start": 171054, "end": 177621, "text": "And if I by Beelzebub cast out demons, by whom do your children cast them out? therefore they shall be your judges.", "words": [[0, 171054], [4, 171179], [7, 171359], [9, 171539], [12, 171719], [22, 172439], [27, 172699], [31, 172959], [39, 173739], [42, 173919], [47, 174139], [50, 174339], [55, 174459], [64, 174779], [69, 175119], [74, 175339], [79, 175921], [89, 176223], [94, 176483], [100, 176703], [103, 176883], [108, 176983]]}, {"verse": 28, "start": 177971, "end": 183239, "text": "But if I cast out demons by the Spirit of God, then the kingdom of God is come to you.", "words": [[0, 177971], [4, 178148], [7, 178288], [9, 178408], [14, 178808], [18, 178988], [25, 179428], [28, 179748], [32, 179928], [39, 180208], [42, 180368], [47, 181128], [52, 181368], [56, 181508], [64, 181808], [67, 182048], [71, 182368], [74, 182548], [79, 182748], [82, 182948]]}, {"verse": 29, "start": 183589, "end": 192883, "text": "Or else how can one enter into a strong man’s house, and spoil his goods, unless he first bind the strong man? and then he will spoil his house.", "words": [[0, 183589], [3, 183731], [8, 183991], [12, 184311], [16, 184531], [20, 184771], [26, 185171], [31, 185451], [33, 185611], [40, 185931], [46, 186471], [53, 186691], [57, 187231], [63, 187611], [67, 187871], [74, 188251], [81, 188851], [84, 189091], [90, 189311], [95, 189731], [99, 189931], [106, 190211], [111, 191015], [115, 191174], [120, 191394], [123, 191594], [128, 191754], [134, 192094], [138, 192374]]}, {"verse": 30, "start": 193233, "end": 198310, "text": "He that is not with me is against me; and he that gathers not with me scatters abroad.", "words": [[0, 193233], [3, 193419], [8, 193619], [11, 193759], [15, 193939], [20, 194159], [23, 194439], [26, 194719], [34, 194979], [38, 195632], [42, 195753], [45, 195933], [50, 196133], [58, 196533], [62, 196793], [67, 197033], [70, 197233], [79, 197773]]}, {"verse": 31, "start": 198660, "end": 207324, "text": "¶ Therefore I say to you, All manner of sin and blasphemy shall be forgiven to men: but the blasphemy against the Holy Spirit shall not be forgiven to men.", "words": [[2, 198660], [12, 198946], [14, 199186], [18, 199406], [21, 199606], [26, 199946], [30, 200106], [37, 200426], [40, 200646], [44, 200946], [48, 201146], [58, 201786], [64, 202026], [67, 202166], [76, 202506], [79, 202746], [84, 203360], [88, 203496], [92, 203616], [102, 204216], [110, 204516], [114, 204736], [119, 204956], [126, 205516], [132, 205796], [136, 206056], [139, 206276], [148, 206636], [151, 206916]]}, {"verse": 32, "start": 207674, "end": 218755, "text": "And whoever speaks a word against the Son of man it shall be forgiven him but who soever speaks against the Holy Spirit it shall not be forgiven him neither in this world neither in the world to come", "words": [[0, 207674], [4, 207792], [12, 208032], [19, 208432], [21, 208652], [26, 208832], [34, 209112], [38, 209392], [42, 209592], [45, 209712], [49, 210152], [52, 210212], [58, 210392], [61, 210572], [70, 210912], [74, 211572], [78, 211839], [82, 212105], [89, 212372], [96, 212732], [104, 213092], [108, 213332], [113, 213552], [120, 214092], [123, 214172], [129, 214927], [133, 215095], [136, 215275], [145, 215615], [149, 215975], [157, 216215], [160, 216455], [165, 216595], [171, 216975], [179, 217215], [182, 217435], [186, 217515], [192, 217735], [195, 217895]]}, {"verse": 33, "start": 219105, "end": 226352, "text": "Either make the tree good, and his fruit good; or else make the tree corrupt, and his fruit corrupt: for the tree is known by his fruit.", "words": [[0, 219105], [7, 219308], [12, 219528], [16, 219648], [21, 219888], [27, 220188], [31, 220648], [35, 220788], [41, 221028], [47, 221736], [50, 221860], [55, 222080], [60, 222340], [64, 222480], [69, 222680], [78, 223080], [82, 223420], [86, 223620], [92, 223840], [101, 224641], [105, 224735], [109, 224875], [114, 225115], [117, 225275], [123, 225455], [126, 225715], [130, 225855]]}, {"verse": 34, "start": 226702, "end": 233561, "text": "O generation of vipers, how can you, being evil, speak good things? for out of the abundance of the heart the mouth speaks.", "words": [[0, 226702], [2, 226826], [13, 227186], [16, 227566], [24, 228306], [28, 228446], [32, 228686], [37, 228926], [43, 229146], [49, 229806], [55, 230026], [60, 230266], [68, 231068], [72, 231137], [76, 231317], [79, 231417], [83, 231517], [93, 231837], [96, 232117], [100, 232237], [106, 232617], [110, 232677], [116, 232917]]}, {"verse": 35, "start": 233911, "end": 241481, "text": "A good man out of the good treasure of the heart brings forth good things: and an evil man out of the evil treasure brings forth evil things.", "words": [[0, 233911], [2, 234015], [7, 234255], [11, 234595], [15, 234855], [18, 234975], [22, 235095], [27, 235275], [36, 235615], [39, 235835], [43, 235935], [49, 236175], [56, 236515], [62, 236815], [67, 237095], [75, 237945], [79, 238069], [82, 238169], [87, 238469], [91, 238809], [95, 239069], [98, 239189], [102, 239289], [107, 239529], [116, 239909], [123, 240249], [129, 240509], [134, 240809]]}, {"verse": 36, "start": 241831, "end": 247823, "text": "But I say to you, That every idle word that men shall speak, they shall give account of it in the day of judgment.", "words": [[0, 241831], [4, 241935], [6, 242075], [10, 242335], [13, 242535], [18, 242755], [23, 243175], [29, 243515], [34, 243815], [39, 244155], [44, 244355], [48, 244575], [54, 244795], [61, 245375], [66, 245615], [72, 245775], [77, 245935], [85, 246295], [88, 246495], [91, 246635], [94, 246855], [98, 246955], [102, 247155], [105, 247255]]}, {"verse": 37, "start": 248173, "end": 252940, "text": "For by your words you shall be justified, and by your words you shall be condemned.", "words": [[0, 248173], [4, 248320], [7, 248680], [12, 248840], [18, 249260], [22, 249500], [28, 249700], [31, 249860], [42, 250760], [46, 251060], [49, 251260], [54, 251400], [60, 251800], [64, 251960], [70, 252140], [73, 252280]]}, {"verse": 38, "start": 253220, "end": 259637, "text": "¶ Then certain of the scribes and of the Pharisees answered, saying, Master, we would see a sign from you.", "words": [[2, 253220], [7, 253469], [15, 253829], [18, 254049], [22, 254169], [30, 254829], [34, 254949], [37, 255049], [41, 255169], [51, 255869], [61, 256469], [69, 257202], [77, 258019], [80, 258299], [86, 258479], [90, 258699], [92, 258879], [97, 259099], [102, 259299]]}, {"verse": 39, "start": 259917, "end": 269780, "text": "But he answered and said to them, An evil and adulterous generation seeks after a sign; and there shall no sign be given to it, but the sign of the prophet Jonas:", "words": [[0, 259917], [4, 260101], [7, 260281], [16, 260741], [20, 261061], [25, 261341], [28, 261541], [34, 262108], [37, 262248], [42, 262588], [46, 262908], [57, 263548], [68, 264168], [74, 264608], [80, 264988], [82, 265148], [88, 265851], [92, 265972], [98, 266092], [104, 266252], [107, 266492], [112, 266812], [115, 267012], [121, 267232], [124, 267492], [128, 267832], [132, 268052], [136, 268192], [141, 268512], [144, 268632], [148, 268732], [156, 269032]]}, {"verse": 40, "start": 270130, "end": 277711, "text": "For as Jonas was three days and three nights in the whale’s belly; so shall the Son of man be three days and three nights in the heart of the earth.", "words": [[0, 270130], [4, 270269], [7, 270489], [13, 270789], [17, 271089], [23, 271329], [28, 271609], [32, 271909], [38, 272149], [45, 272409], [48, 272689], [52, 272809], [60, 273149], [67, 273811], [70, 273971], [76, 274191], [80, 274351], [84, 274551], [87, 274671], [91, 274911], [94, 275111], [100, 275371], [105, 275651], [109, 276031], [115, 276251], [122, 276551], [125, 276911], [129, 277031], [135, 277211], [138, 277331], [142, 277491]]}, {"verse": 41, "start": 278061, "end": 288172, "text": "The men of Nineveh shall rise in judgment with this generation, and shall condemn it: because they repented at the preaching of Jonas; and, behold, a greater than Jonas is here.", "words": [[0, 278061], [4, 278145], [8, 278345], [11, 278465], [19, 279045], [25, 279205], [30, 279565], [33, 279785], [42, 280145], [47, 280425], [52, 280645], [64, 281225], [68, 281530], [74, 281750], [82, 282130], [86, 282707], [94, 282909], [99, 283169], [108, 283709], [111, 283889], [115, 283989], [125, 284309], [128, 284509], [135, 285269], [140, 285809], [148, 286409], [150, 286589], [158, 286889], [163, 287169], [169, 287509], [172, 287789]]}, {"verse": 42, "start": 288522, "end": 300102, "text": "The queen of the south shall rise up in the judgment with this generation, and shall condemn it: for she came from the uttermost parts of the earth to hear the wisdom of Solomon; and, behold, a greater than Solomon is here.", "words": [[0, 288522], [4, 288602], [10, 288902], [13, 289062], [17, 289162], [23, 289482], [29, 289762], [34, 290122], [37, 290382], [40, 290502], [44, 290602], [53, 290922], [58, 291262], [63, 291482], [75, 292042], [79, 292327], [85, 292567], [93, 292907], [97, 293502], [101, 293587], [105, 293787], [110, 294027], [115, 294207], [119, 294367], [129, 294787], [135, 295087], [138, 295247], [142, 295367], [148, 295627], [151, 295907], [156, 296067], [160, 296207], [167, 296547], [170, 296747], [179, 297592], [184, 297712], [192, 298392], [194, 298472], [202, 298752], [207, 298992], [215, 299392], [218, 299672]]}, {"verse": 43, "start": 300452, "end": 306528, "text": "When the unclean spirit is gone out of a man, he walks through dry places, seeking rest, and finds none.", "words": [[0, 300452], [5, 300550], [9, 300670], [17, 301130], [24, 301410], [27, 301690], [32, 301910], [36, 302090], [39, 302210], [41, 302290], [46, 302950], [49, 303030], [55, 303290], [63, 303530], [67, 303830], [75, 304670], [83, 304910], [89, 305330], [93, 305670], [99, 305990]]}, {"verse": 44, "start": 306878, "end": 314091, "text": "Then he says, I will return into my house from where I came out; and when he is come, he finds it empty, swept, and garnished.", "words": [[0, 306878], [5, 307073], [8, 307273], [14, 307673], [16, 307773], [21, 307933], [28, 308293], [33, 308533], [36, 308753], [42, 309033], [47, 309273], [53, 309473], [55, 309653], [60, 309853], [65, 310505], [69, 310630], [74, 310790], [77, 310950], [80, 311110], [86, 311730], [89, 311830], [95, 312090], [98, 312270], [105, 312830], [112, 313450], [116, 313470]]}, {"verse": 45, "start": 314441, "end": 328242, "text": "Then goes he, and takes with himself seven other spirits more wicked than himself, and they enter in and dwell there: and the last state of that man is worse than the first. Even so shall it be also to this wicked generation.", "words": [[0, 314441], [5, 314678], [10, 314978], [14, 315498], [18, 315618], [24, 315918], [29, 316158], [37, 316598], [43, 316998], [49, 317258], [57, 317738], [62, 318058], [69, 318378], [74, 318658], [83, 319478], [87, 319778], [92, 319938], [98, 320258], [101, 320538], [105, 320858], [111, 321138], [118, 321842], [122, 321987], [126, 322107], [131, 322406], [137, 322666], [140, 322806], [145, 323006], [149, 323306], [152, 323586], [158, 323867], [163, 324146], [167, 324266], [174, 325019], [179, 325262], [182, 325802], [188, 326002], [191, 326182], [194, 326302], [199, 326682], [202, 326962], [207, 327162], [214, 327462]]}, {"verse": 46, "start": 328522, "end": 334685, "text": "¶ While he yet talked to the people, behold, his mother and his brethren stood without, desiring to speak with him.", "words": [[2, 328522], [8, 328728], [11, 328948], [15, 329148], [22, 329428], [25, 329648], [29, 329748], [37, 330188], [45, 330968], [49, 331108], [56, 331388], [60, 331648], [64, 331768], [73, 332128], [79, 332508], [88, 333008], [97, 333748], [100, 333968], [106, 334188], [111, 334448]]}, {"verse": 47, "start": 335035, "end": 340540, "text": "Then one said to him, Behold, your mother and your brethren stand without, desiring to speak with you.", "words": [[0, 335035], [5, 335258], [9, 335478], [14, 335778], [17, 335978], [22, 336474], [30, 336872], [35, 337052], [42, 337332], [46, 337652], [51, 337772], [60, 338112], [66, 338452], [75, 338852], [84, 339652], [87, 339872], [93, 340092], [98, 340312]]}, {"verse": 48, "start": 340820, "end": 345903, "text": "But he answered and said to him that told him, Who is my mother? and who are my brethren?", "words": [[0, 340820], [4, 340924], [7, 341044], [16, 341484], [20, 341684], [25, 341964], [28, 342144], [32, 342324], [37, 342504], [42, 342784], [47, 343458], [51, 343573], [54, 343733], [57, 343913], [65, 344647], [69, 344746], [73, 344926], [77, 345086], [80, 345266]]}, {"verse": 49, "start": 346183, "end": 351872, "text": "And he stretched forth his hand toward his disciples, and said, Behold my mother and my brethren!", "words": [[0, 346183], [4, 346318], [7, 346438], [17, 346718], [23, 347138], [27, 347398], [32, 347718], [39, 348038], [43, 348278], [54, 348818], [58, 349158], [64, 349820], [71, 350064], [74, 350424], [81, 350744], [85, 351024], [88, 351204]]}, {"verse": 50, "start": 352222, "end": 357790, "text": "For who soever shall do the will of my Father which is in heaven the same is my brother and sister and mother", "words": [[0, 352222], [4, 352430], [8, 352670], [15, 352910], [21, 353130], [24, 353310], [28, 353430], [33, 353630], [36, 353770], [39, 353930], [46, 354470], [52, 354590], [55, 354710], [58, 354850], [65, 355470], [69, 355550], [74, 355750], [77, 355950], [80, 356110], [88, 356410], [92, 356750], [99, 357090], [103, 357390]]}]}