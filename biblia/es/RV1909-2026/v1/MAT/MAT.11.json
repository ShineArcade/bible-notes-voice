{"book": "MAT", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 250399, "verses": [{"verse": 1, "start": 300, "end": 9529, "text": "Y fue, que acabando Jesús de dar instrucciones a sus doce discípulos, se fue de allí a enseñar y a predicar en las ciudades de ellos.", "words": [[0, 300], [2, 405], [7, 565], [11, 925], [20, 1425], [26, 1765], [29, 2065], [33, 2265], [47, 3285], [49, 3545], [53, 3705], [58, 4185], [70, 5505], [73, 5745], [77, 5925], [80, 6105], [85, 6305], [87, 6425], [95, 7105], [97, 7245], [99, 7325], [108, 7845], [111, 8045], [115, 8205], [124, 8745], [127, 8905]]}, {"verse": 2, "start": 9879, "end": 15911, "text": "Y oyendo Juan en la prisión los hechos de Cristo, le envió dos de sus discípulos,", "words": [[0, 9879], [2, 10042], [9, 10422], [14, 10762], [17, 11062], [20, 11362], [28, 11662], [32, 11882], [39, 12202], [42, 12362], [50, 13282], [53, 13582], [59, 14022], [63, 14362], [66, 14542], [70, 14742]]}, {"verse": 3, "start": 16261, "end": 20552, "text": "Diciendo: ¿Eres tú aquel que había de venir, o esperaremos a otro?", "words": [[0, 16261], [10, 17348], [16, 17589], [19, 17849], [25, 18229], [29, 18349], [35, 18529], [38, 18729], [45, 19029], [47, 19214], [59, 19834], [61, 20094]]}, {"verse": 4, "start": 20832, "end": 27717, "text": "Y respondiendo Jesús, les dijo: Id, y haced saber a Juan las cosas que oís y veis:", "words": [[0, 20832], [2, 20954], [15, 21674], [22, 22124], [26, 22574], [32, 23428], [36, 23578], [38, 24058], [44, 24538], [50, 24958], [52, 25098], [57, 25398], [61, 25878], [67, 26178], [71, 26458], [75, 26918], [77, 27178]]}, {"verse": 5, "start": 28067, "end": 40213, "text": "Los ciegos ven, y los cojos andan; los leprosos son limpiados, y los sordos oyen; los muertos son resucitados, y a los pobres es anunciado el evangelio.", "words": [[0, 28067], [4, 28174], [11, 28694], [16, 29114], [18, 29694], [22, 29834], [28, 30334], [35, 31336], [39, 31455], [48, 32115], [52, 32395], [63, 33195], [65, 33455], [69, 33635], [76, 34235], [82, 35152], [86, 35276], [94, 35696], [98, 35976], [111, 36916], [113, 37456], [115, 37556], [119, 37656], [126, 38096], [129, 38296], [139, 39096], [142, 39276]]}, {"verse": 6, "start": 40563, "end": 43924, "text": "Y bienaventurado es el que no tropiece por causa de mí.", "words": [[0, 40563], [2, 40830], [17, 41790], [20, 41950], [23, 42070], [27, 42210], [30, 42350], [39, 42829], [43, 43070], [49, 43329], [52, 43610]]}, {"verse": 7, "start": 44274, "end": 53675, "text": "Y al irse ellos, comenzó Jesús a decir de Juan a la gente: ¿Qué salisteis a ver al desierto? ¿una caña que es sacudida por el viento?", "words": [[0, 44274], [2, 44421], [5, 44541], [10, 44921], [17, 45361], [25, 46066], [31, 46326], [33, 46646], [39, 46966], [42, 47286], [47, 47606], [49, 47786], [52, 47866], [59, 48704], [64, 49152], [74, 49632], [76, 49792], [80, 49912], [83, 50052], [93, 51108], [98, 51428], [103, 51888], [107, 52088], [110, 52418], [119, 52748], [123, 52908], [126, 53048]]}, {"verse": 8, "start": 54025, "end": 64285, "text": "Pero ¿qué salisteis a ver? ¿un hombre cubierto de delicados vestidos? He aquí, los que traen vestidos delicados, en las casas de los reyes están.", "words": [[0, 54025], [5, 54188], [10, 54628], [20, 55308], [22, 55448], [27, 56011], [31, 56194], [38, 56534], [47, 57274], [50, 57474], [60, 58154], [70, 59366], [73, 59541], [79, 59716], [83, 59891], [87, 60051], [93, 60491], [102, 61071], [113, 61911], [116, 62311], [120, 62451], [126, 63011], [129, 63111], [133, 63381], [139, 63651]]}, {"verse": 9, "start": 64635, "end": 69892, "text": "Pero ¿qué salisteis a ver? ¿un profeta? También os digo, y más que profeta.", "words": [[0, 64635], [5, 65012], [10, 65426], [20, 65839], [22, 65979], [27, 66492], [31, 66732], [40, 67610], [48, 67805], [51, 68035], [57, 68315], [59, 68735], [63, 68935], [67, 69115]]}, {"verse": 10, "start": 70242, "end": 78157, "text": "Porque este es de quien está escrito: He aquí, yo envío mi mensajero delante de ti, que preparará tu camino delante de ti.", "words": [[0, 70242], [7, 70484], [12, 70784], [15, 71124], [18, 71284], [24, 71464], [29, 71764], [38, 72713], [41, 72793], [47, 73053], [50, 73693], [56, 74113], [59, 74273], [69, 74953], [77, 75353], [80, 75533], [84, 75733], [88, 75913], [98, 76493], [101, 76693], [108, 77013], [116, 77593], [119, 77793]]}, {"verse": 11, "start": 78507, "end": 89657, "text": "De cierto os digo, que no se levantó entre los que nacen de mujeres otro mayor que Juan el Bautista; pero el más pequeño en el reino de los cielos, mayor es que él.", "words": [[0, 78696], [3, 78921], [10, 79146], [13, 79371], [19, 79911], [23, 79991], [26, 80151], [29, 80311], [37, 80971], [43, 81391], [47, 81631], [51, 81811], [57, 82231], [60, 82371], [68, 82831], [73, 83251], [79, 83651], [83, 83871], [88, 84171], [91, 84712], [101, 85420], [106, 85586], [109, 85746], [113, 85926], [121, 86386], [124, 86646], [127, 86766], [133, 87146], [136, 87266], [140, 87426], [148, 88186], [154, 88586], [157, 88946], [161, 89106]]}, {"verse": 12, "start": 90007, "end": 98384, "text": "Desde los días de Juan el Bautista hasta ahora, al reino de los cielos se hace fuerza, y los valientes lo arrebatan.", "words": [[0, 90007], [6, 90172], [10, 90392], [15, 90632], [18, 90812], [23, 91312], [26, 91412], [35, 92252], [41, 92352], [48, 93332], [51, 93472], [57, 93852], [60, 93972], [64, 94112], [71, 94652], [74, 94812], [79, 95012], [87, 95512], [89, 96052], [93, 96192], [103, 96712], [106, 97272]]}, {"verse": 13, "start": 98734, "end": 102663, "text": "Porque todos los profetas y la ley hasta Juan profetizaron.", "words": [[0, 98734], [7, 98917], [13, 99317], [17, 99717], [26, 100217], [28, 100397], [31, 100517], [35, 100797], [41, 101157], [46, 101517]]}, {"verse": 14, "start": 103013, "end": 107219, "text": "Y si queréis recibir, él es aquel Elías que había de venir.", "words": [[0, 103013], [2, 103179], [5, 103259], [13, 103739], [22, 104999], [25, 105259], [28, 105419], [34, 105739], [40, 106219], [44, 106359], [50, 106579], [53, 106779]]}, {"verse": 15, "start": 107569, "end": 110384, "text": "El que tiene oídos para oír, oiga.", "words": [[0, 107569], [3, 107695], [7, 107835], [13, 108195], [19, 108855], [24, 109115], [29, 109895]]}, {"verse": 16, "start": 110734, "end": 119502, "text": "Pero ¿a quién compararé esta generación? Es semejante a los muchachos que se sientan en las plazas, y dan voces a sus compañeros,", "words": [[0, 110734], [5, 110916], [8, 111316], [14, 111556], [24, 112356], [29, 112676], [41, 113887], [44, 114173], [54, 115133], [56, 115233], [60, 115333], [70, 115873], [74, 115973], [77, 116093], [85, 116593], [88, 116693], [92, 116813], [100, 117353], [102, 117673], [106, 117833], [112, 118293], [114, 118433], [118, 118573]]}, {"verse": 17, "start": 119852, "end": 128281, "text": "Y dicen: Tocamos la flauta para vosotros, y no bailasteis; cantamos canciones de duelo para vosotros, y no lamentasteis.", "words": [[0, 119852], [2, 120286], [9, 120970], [17, 121394], [20, 121614], [27, 122074], [32, 122274], [42, 122874], [44, 123114], [47, 123234], [59, 124372], [68, 125016], [78, 125536], [81, 125776], [87, 126116], [92, 126336], [102, 126856], [104, 127136], [107, 127296]]}, {"verse": 18, "start": 128631, "end": 133512, "text": "Porque vino Juan, que ni comía ni bebía, y dicen: Demonio tiene.", "words": [[0, 128631], [7, 128812], [12, 129092], [18, 129512], [22, 130052], [25, 130232], [31, 130652], [34, 130812], [41, 131332], [43, 131532], [50, 132647], [58, 132947]]}, {"verse": 19, "start": 133862, "end": 146678, "text": "Vino el Hijo del hombre, que come y bebe, y dicen: He aquí un hombre comilón, y bebedor de vino, amigo de publicanos y de pecadores. Pero la sabiduría es justificada por sus hijos.", "words": [[0, 133862], [5, 134147], [8, 134347], [13, 134647], [17, 134807], [25, 135407], [29, 135727], [34, 136067], [36, 136327], [42, 136707], [44, 136907], [51, 137734], [54, 137862], [59, 138142], [62, 138322], [69, 138862], [78, 139402], [80, 139882], [88, 140322], [91, 140502], [97, 141142], [103, 141462], [106, 141662], [117, 142342], [119, 142522], [122, 142642], [133, 143719], [138, 143864], [141, 144024], [151, 144684], [154, 144804], [166, 145584], [170, 145804], [174, 146024]]}, {"verse": 20, "start": 147028, "end": 156479, "text": "Entonces comenzó a reprender a las ciudades en las cuales habían sido hechas muchas de sus maravillas, porque no se habían arrepentido, diciendo:", "words": [[0, 147028], [9, 147508], [17, 148208], [19, 148288], [29, 148788], [31, 148928], [35, 149048], [44, 149568], [47, 149728], [51, 149888], [58, 150088], [65, 150508], [70, 150888], [77, 151168], [84, 151488], [87, 151748], [91, 151888], [103, 152508], [110, 153128], [113, 153708], [116, 153888], [123, 154188], [136, 155448]]}, {"verse": 21, "start": 156829, "end": 171611, "text": "¡Ay de ti, Corazín! ¡Ay de ti, Betsaida! porque si en Tiro y en Sidón fueran hechas las maravillas que han sido hechas en vosotras, en otro tiempo se hubieran arrepentido con ropa de luto y ceniza.", "words": [[0, 156829], [4, 157352], [7, 157392], [11, 158002], [20, 158832], [24, 159332], [27, 159790], [31, 160248], [41, 160877], [48, 161101], [51, 161381], [54, 161841], [59, 162141], [61, 162361], [64, 162711], [70, 163061], [77, 163781], [84, 164161], [88, 164361], [99, 164981], [103, 165161], [107, 165301], [112, 165621], [119, 166001], [122, 166221], [132, 167261], [135, 167381], [140, 167601], [147, 167981], [150, 168221], [159, 168601], [171, 169581], [175, 169741], [180, 170261], [183, 170401], [188, 170761], [190, 170901]]}, {"verse": 22, "start": 171961, "end": 178841, "text": "Por tanto os digo, que a Tiro y a Sidón será más tolerable el castigo en el día del juicio, que a vosotras.", "words": [[0, 171961], [4, 172085], [10, 172565], [13, 172665], [19, 172845], [23, 173145], [25, 173445], [30, 173745], [32, 173998], [34, 174252], [40, 174505], [45, 174725], [49, 174985], [59, 175625], [62, 175765], [70, 176285], [73, 176405], [76, 176505], [80, 176745], [84, 176905], [92, 177485], [96, 177925], [98, 178045]]}, {"verse": 23, "start": 179191, "end": 195094, "text": "Y tú, Capernaum, que eres levantada hasta el cielo, hasta los infiernos serás abatida; porque si en los de Sodoma fueran hechas las maravillas que han sido hechas en ti, hubieran quedado hasta el día de hoy.", "words": [[0, 179191], [2, 179332], [6, 179532], [17, 180872], [21, 181132], [26, 181372], [36, 182192], [42, 182392], [45, 182552], [52, 183052], [58, 183812], [62, 184032], [72, 184779], [78, 185527], [87, 186447], [94, 186729], [97, 187109], [100, 187329], [104, 187702], [107, 188076], [114, 188449], [121, 188949], [128, 189429], [132, 189789], [143, 190569], [147, 190829], [151, 191049], [156, 191349], [163, 191749], [166, 191969], [170, 192569], [179, 193309], [187, 193869], [193, 194129], [196, 194329], [200, 194549], [203, 194729]]}, {"verse": 24, "start": 195444, "end": 202699, "text": "Por tanto os digo, que a la tierra de los de Sodoma será más tolerable el castigo en el día del juicio, que a ti.", "words": [[0, 195444], [4, 195566], [10, 195706], [13, 195846], [19, 196226], [23, 196506], [25, 196946], [28, 197026], [35, 197426], [38, 197706], [42, 197956], [45, 198206], [52, 198456], [57, 198706], [61, 199066], [71, 199586], [74, 200106], [82, 200786], [85, 200906], [88, 201046], [92, 201246], [96, 201426], [104, 201926], [108, 202146], [110, 202246]]}, {"verse": 25, "start": 202699, "end": 215884, "text": "En aquel tiempo, respondiendo Jesús, dijo: Te alabo, Padre, Señor del cielo y de la tierra, que hayas escondido estas cosas de los sabios y de los entendidos, y las hayas revelado a los niños.", "words": [[0, 202699], [3, 202919], [9, 203199], [17, 203659], [30, 204399], [37, 205239], [43, 205944], [46, 206030], [53, 206350], [60, 207170], [66, 207610], [70, 207910], [76, 208350], [78, 208570], [81, 208650], [84, 208770], [92, 209610], [96, 209810], [102, 210150], [112, 210850], [118, 210990], [124, 211470], [127, 211710], [131, 211830], [138, 212350], [140, 212510], [143, 212590], [147, 212730], [159, 213490], [161, 213795], [165, 213955], [171, 214295], [180, 214895], [182, 214995], [186, 215115]]}, {"verse": 26, "start": 216234, "end": 218716, "text": "Así, Padre, pues que así te agradó.", "words": [[0, 216234], [5, 216656], [12, 217456], [17, 217576], [21, 217756], [25, 217936], [28, 218116]]}, {"verse": 27, "start": 219066, "end": 231173, "text": "Todas las cosas me son entregadas de mi Padre: y nadie conoció al Hijo, sino el Padre; ni al Padre conoció alguno, sino el Hijo, y aquel a quien el Hijo lo quiera revelar.", "words": [[0, 219066], [6, 219310], [10, 219430], [16, 219710], [19, 219950], [23, 220130], [34, 220710], [37, 220870], [40, 220990], [47, 221774], [49, 222141], [55, 222421], [63, 223041], [66, 223261], [72, 223801], [77, 224021], [80, 224241], [87, 225260], [90, 225470], [93, 225680], [99, 225890], [107, 226510], [115, 227130], [120, 227330], [123, 227690], [129, 228770], [131, 228870], [137, 229190], [139, 229310], [145, 229470], [148, 229730], [153, 229950], [156, 230110], [163, 230430]]}, {"verse": 28, "start": 231523, "end": 236693, "text": "Venid a mí todos los que estáis cansados y cargados, que yo os haré descansar.", "words": [[0, 231523], [6, 231861], [8, 231961], [11, 232081], [17, 232421], [21, 232681], [25, 233094], [32, 233508], [41, 233921], [43, 234101], [53, 234881], [57, 235201], [60, 235441], [63, 235621], [68, 235861]]}, {"verse": 29, "start": 237043, "end": 246514, "text": "Llevad mi yugo sobre vosotros, y aprended de mí, que soy manso y humilde de corazón; y hallaréis descanso para vuestras almas.", "words": [[0, 237043], [7, 237351], [10, 237691], [15, 238031], [21, 238231], [31, 238891], [33, 239151], [42, 239771], [45, 239991], [49, 240631], [53, 240891], [57, 241111], [63, 241871], [65, 242151], [73, 242611], [76, 242791], [85, 243820], [87, 243967], [97, 244447], [106, 245227], [111, 245447], [120, 245887]]}, {"verse": 30, "start": 246864, "end": 249999, "text": "Porque mi yugo es fácil, y ligera mi carga.", "words": [[0, 246864], [7, 247046], [10, 247336], [15, 247626], [18, 247806], [25, 248226], [27, 248786], [34, 249246], [37, 249406]]}]}