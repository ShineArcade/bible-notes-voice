{"book": "PSA", "chapter": 103, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 116369, "verses": [{"verse": 1, "start": 300, "end": 5121, "text": "Bless the LORD, O my soul: and all that is within me, bless his holy name.", "words": [[0, 300], [6, 537], [10, 857], [16, 1197], [18, 1257], [21, 1437], [27, 2226], [31, 2335], [35, 2555], [40, 2755], [43, 2915], [50, 3195], [54, 3715], [60, 3955], [64, 4235], [69, 4515]]}, {"verse": 2, "start": 5471, "end": 8635, "text": "Bless the LORD, O my soul, and forget not all his benefits:", "words": [[0, 5471], [6, 5698], [10, 5958], [16, 6278], [18, 6318], [21, 6518], [27, 7138], [31, 7198], [38, 7538], [42, 7778], [46, 7978], [50, 8138]]}, {"verse": 3, "start": 8985, "end": 13170, "text": "Who forgives all your iniquities; who heals all your diseases;", "words": [[0, 8985], [4, 9476], [13, 10016], [17, 10236], [22, 10436], [34, 11416], [38, 11513], [44, 11773], [48, 12133], [53, 12293]]}, {"verse": 4, "start": 13520, "end": 18835, "text": "Who redeems your life from destruction; who crowns you with lovingkindness and tender mercies;", "words": [[0, 13520], [4, 13612], [12, 14112], [17, 14272], [22, 14592], [27, 14792], [40, 15849], [44, 15937], [51, 16417], [55, 16497], [60, 16987], [75, 17477], [79, 17737], [86, 18017]]}, {"verse": 5, "start": 19185, "end": 24456, "text": "Who satisfies your mouth with good things; so that your youth is renewed like the eagle’s.", "words": [[0, 19185], [4, 19385], [14, 19765], [19, 20265], [25, 20545], [30, 20765], [35, 20985], [43, 21954], [46, 22054], [51, 22214], [56, 22334], [62, 22694], [65, 22874], [73, 23274], [78, 23554], [82, 23734]]}, {"verse": 6, "start": 24806, "end": 28671, "text": "The LORD executes righteousness and judgment for all that are oppressed.", "words": [[0, 24806], [4, 24909], [9, 25149], [18, 25789], [32, 26269], [36, 26669], [45, 27049], [49, 27369], [53, 27609], [58, 27809], [62, 27949]]}, {"verse": 7, "start": 29021, "end": 33212, "text": "He made known his ways to Moses, his acts to the children of Israel.", "words": [[0, 29021], [3, 29169], [8, 29449], [14, 29789], [18, 30029], [23, 30309], [26, 30489], [33, 31409], [37, 31509], [42, 31809], [45, 32049], [49, 32149], [58, 32469], [61, 32649]]}, {"verse": 8, "start": 33562, "end": 38591, "text": "The LORD is merciful and gracious, slow to anger, and plenteous in mercy.", "words": [[0, 33562], [4, 33688], [9, 34008], [12, 34228], [21, 34728], [25, 34988], [35, 35868], [40, 36228], [43, 36408], [50, 37148], [54, 37228], [64, 37908], [67, 38048]]}, {"verse": 9, "start": 38941, "end": 43114, "text": "He will not always chide: neither will he keep his anger for ever.", "words": [[0, 38941], [3, 39051], [8, 39211], [12, 39411], [19, 39771], [26, 40714], [34, 41022], [39, 41342], [42, 41482], [47, 41722], [51, 41942], [57, 42352], [61, 42762]]}, {"verse": 10, "start": 43464, "end": 48423, "text": "He has not dealt with us after our sins; nor rewarded us according to our iniquities.", "words": [[0, 43464], [3, 43567], [7, 43727], [11, 43887], [17, 44107], [22, 44327], [25, 44487], [31, 44767], [35, 44967], [41, 45825], [45, 46051], [54, 46571], [57, 46811], [67, 47131], [70, 47451], [74, 47631]]}, {"verse": 11, "start": 48773, "end": 54167, "text": "For as the heaven is high above the earth, so great is his mercy toward them that fear him.", "words": [[0, 48773], [4, 48890], [7, 49050], [11, 49210], [18, 49470], [21, 49730], [26, 49990], [32, 50290], [36, 50530], [43, 51150], [46, 51450], [52, 51810], [55, 52010], [59, 52150], [65, 52550], [72, 52910], [77, 53210], [82, 53470], [87, 53710]]}, {"verse": 12, "start": 54517, "end": 59567, "text": "As far as the east is from the west, so far has he removed our transgressions from us.", "words": [[0, 54517], [3, 54650], [7, 54910], [10, 55050], [14, 55190], [19, 55450], [22, 55670], [27, 55890], [31, 56050], [37, 56730], [40, 56930], [44, 57210], [48, 57430], [51, 57550], [59, 57910], [63, 58130], [