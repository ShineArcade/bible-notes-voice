{"book": "1CO", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 141937, "verses": [{"verse": 1, "start": 300, "end": 6984, "text": "Cuanto a la colecta para los santos, haced vosotros también de la manera que ordené en las iglesias de Galacia.", "words": [[0, 300], [7, 558], [9, 698], [12, 798], [20, 1358], [25, 1538], [29, 1718], [37, 2598], [43, 2898], [52, 3478], [60, 3878], [63, 4238], [66, 4358], [73, 4658], [77, 4918], [84, 5418], [87, 5478], [91, 5638], [100, 6198], [103, 6318]]}, {"verse": 2, "start": 7334, "end": 16944, "text": "Cada primer día de la semana cada uno de vosotros aparte en su casa, guardando lo que por la bondad de Dios pueda; para que cuando yo llegue, no se hagan entonces colectas.", "words": [[0, 7334], [5, 7488], [12, 7768], [16, 8048], [19, 8168], [22, 8288], [29, 8708], [34, 8968], [38, 9208], [41, 9348], [50, 9788], [57, 10308], [60, 10388], [63, 10508], [69, 11208], [79, 11768], [82, 11928], [86, 12068], [90, 12248], [93, 12388], [100, 12788], [103, 12908], [108, 13068], [115, 13849], [120, 14007], [124, 14147], [131, 14367], [134, 14607], [142, 15067], [145, 15247], [148, 15427], [154, 15727], [163, 16007]]}, {"verse": 3, "start": 17294, "end": 24063, "text": "Y cuando haya llegado, los que aprobéis por cartas, a estos enviaré que lleven vuestra ofrenda a Jerusalén.", "words": [[0, 17294], [2, 17403], [9, 17603], [14, 17983], [23, 18603], [27, 18943], [31, 19143], [40, 19663], [44, 19843], [52, 21023], [54, 21123], [60, 21323], [68, 21923], [72, 22063], [79, 22363], [87, 22723], [95, 23183], [97, 23303]]}, {"verse": 4, "start": 24413, "end": 28772, "text": "Y si es conveniente que yo también vaya, irán conmigo.", "words": [[0, 24413], [2, 24532], [5, 24672], [8, 24812], [20, 25352], [24, 25492], [27, 25632], [35, 25892], [41, 26992], [46, 27212]]}, {"verse": 5, "start": 29122, "end": 34589, "text": "Y a vosotros iré, cuando haya pasado por Macedonia, porque por Macedonia tengo que pasar:", "words": [[0, 29122], [2, 29243], [4, 29303], [13, 29743], [18, 30483], [25, 30723], [30, 30983], [37, 31383], [41, 31963], [52, 32543], [59, 32823], [63, 33223], [73, 33623], [79, 33863], [83, 34043]]}, {"verse": 6, "start": 34939, "end": 40935, "text": "Y podrá ser que me quede con vosotros, o invernaré también, para que vosotros me llevéis a donde haya de ir.", "words": [[0, 34939], [2, 35028], [8, 35368], [12, 35508], [16, 35688], [19, 35808], [25, 36068], [29, 36288], [39, 36848], [41, 37268], [51, 37828], [60, 38248], [65, 38768], [69, 38908], [78, 39348], [81, 39528], [89, 39888], [91, 40028], [97, 40188], [102, 40468], [105, 40688]]}, {"verse": 7, "start": 41285, "end": 47442, "text": "Porque no os quiero ahora ver de paso; porque espero estar con vosotros algún tiempo, si el Señor lo permite.", "words": [[0, 41285], [7, 41471], [10, 41691], [13, 41811], [20, 42071], [26, 42331], [30, 42551], [33, 42671], [39, 43365], [46, 43590], [53, 43970], [59, 44230], [63, 44510], [72, 44970], [78, 45290], [86, 46130], [89, 46290], [92, 46390], [98, 46630], [101, 46850]]}, {"verse": 8, "start": 47792, "end": 50216, "text": "Pero estaré en Éfeso hasta Pentecostés;", "words": [[0, 47792], [5, 48011], [12, 48451], [15, 48711], [21, 48971], [27, 49191]]}, {"verse": 9, "start": 50566, "end": 54901, "text": "Porque se me ha abierto puerta grande y eficaz, y muchos son los adversarios.", "words": [[0, 50566], [7, 50761], [10, 50961], [13, 51101], [16, 51221], [24, 51501], [31, 51781], [38, 52261], [40, 52441], [48, 53121], [50, 53361], [57, 53641], [61, 53921], [65, 54061]]}, {"verse": 10, "start": 55251, "end": 61916, "text": "Y si llega Timoteo, mirad que esté con vosotros sin temor; porque la obra del Señor hace también como yo.", "words": [[0, 55251], [2, 55358], [5, 55458], [11, 55738], [20, 56918], [26, 57278], [30, 57418], [35, 57638], [39, 57878], [48, 58318], [52, 58578], [59, 59269], [66, 59451], [69, 59651], [74, 59931], [78, 60111], [84, 60491], [89, 60911], [97, 61231], [102, 61531]]}, {"verse": 11, "start": 62266, "end": 68258, "text": "Por tanto, nadie le tenga en poco; antes, llevadlo en paz, para que venga a mí: porque lo espero con los hermanos.", "words": [[0, 62266], [4, 62389], [11, 62649], [17, 62989], [20, 63189], [26, 63409], [29, 63589], [35, 64234], [42, 64624], [51, 65054], [54, 65134], [59, 65414], [64, 65689], [68, 65829], [74, 66149], [76, 66229], [80, 66699], [87, 66865], [90, 67025], [97, 67265], [101, 67505], [105, 67625]]}, {"verse": 12, "start": 68608, "end": 78420, "text": "Acerca del hermano Apolos, mucho le he rogado que fuese a vosotros con los hermanos; pero en ninguna manera tuvo voluntad de ir por ahora; pero irá cuando tenga oportunidad.", "words": [[0, 68608], [7, 69030], [11, 69190], [19, 69590], [27, 70330], [33, 70530], [36, 70710], [39, 70830], [46, 71130], [50, 71310], [56, 71630], [58, 71730], [67, 72150], [71, 72370], [75, 72510], [85, 73350], [90, 73507], [93, 73647], [101, 73967], [108, 74447], [113, 74747], [122, 75427], [125, 75567], [128, 75727], [132, 75947], [139, 76621], [144, 76763], [148, 77023], [155, 77183], [161, 77563]]}, {"verse": 13, "start": 78770, "end": 83240, "text": "Velad, estad firmes en la fe; portaos varonilmente, y esforzaos.", "words": [[0, 79009], [7, 79289], [13, 79569], [20, 79969], [23, 80089], [26, 80229], [30, 80792], [38, 81414], [52, 82074], [54, 82688]]}, {"verse": 14, "start": 83590, "end": 85890, "text": "Todas vuestras cosas sean hechas con amor.", "words": [[0, 83590], [6, 83772], [15, 84292], [21, 84612], [26, 84932], [33, 85232], [37, 85452]]}, {"verse": 15, "start": 86240, "end": 93373, "text": "Y os ruego, hermanos, (ya sabéis que la casa de Estéfanas es las primicias de Acaya, y que se han dedicado al ministerio de los santos,)", "words": [[0, 86240], [2, 86361], [5, 86501], [12, 86801], [22, 87681], [26, 87741], [33, 88061], [37, 88181], [40, 88301], [45, 88541], [48, 88721], [58, 89361], [61, 89621], [65, 89761], [75, 90281], [78, 90461], [85, 90861], [87, 91006], [91, 91126], [94, 91266], [98, 91366], [107, 91866], [110, 91966], [121, 92546], [124, 92606], [128, 92766]]}, {"verse": 16, "start": 93723, "end": 97884, "text": "Que vosotros os sujetéis a los tales, y a todos los que ayudan y trabajan.", "words": [[0, 93723], [4, 93824], [13, 94304], [16, 94484], [25, 95044], [27, 95184], [31, 95304], [38, 95644], [40, 96044], [42, 96124], [48, 96324], [52, 96584], [56, 96784], [63, 97184], [65, 97244]]}, {"verse": 17, "start": 98234, "end": 104362, "text": "Me alegro de la llegada de Estéfanas y de Fortunato y de Acaico: porque estos suplieron lo que a vosotros faltaba.", "words": [[0, 98234], [3, 98360], [10, 98700], [13, 98820], [16, 98920], [24, 99300], [27, 99670], [37, 100040], [39, 100140], [42, 100240], [52, 100820], [54, 100960], [57, 101060], [65, 101906], [72, 102133], [78, 102393], [88, 102973], [91, 103093], [95, 103213], [97, 103293], [106, 103673]]}, {"verse": 18, "start": 104712, "end": 109033, "text": "Porque reconfortaron mi espíritu y el vuestro: reconoced pues a los tales.", "words": [[0, 104712], [7, 104895], [21, 105715], [24, 105895], [33, 106415], [35, 106495], [38, 106595], [47, 107612], [57, 107922], [62, 108142], [64, 108362], [68, 108462]]}, {"verse": 19, "start": 109383, "end": 116197, "text": "Las iglesias de Asia os saludan. Os saludan mucho en el Señor Aquila y Priscila, con la iglesia que está en su casa.", "words": [[0, 109383], [4, 109502], [13, 110022], [16, 110202], [21, 110442], [24, 110682], [33, 111445], [36, 111549], [44, 112049], [50, 112329], [53, 112489], [56, 112589], [62, 112829], [69, 113349], [71, 113449], [81, 114109], [85, 114549], [88, 114689], [96, 115049], [100, 115249], [105, 115449], [108, 115569], [111, 115669]]}, {"verse": 20, "start": 116547, "end": 121222, "text": "Os saludan todos los hermanos. Saludaos los unos a los otros con beso santo.", "words": [[0, 116570], [3, 116630], [11, 117110], [17, 117290], [21, 117530], [31, 118414], [40, 119011], [44, 119151], [49, 119411], [51, 119631], [55, 119771], [61, 120071], [65, 120391], [70, 120711]]}, {"verse": 21, "start": 121572, "end": 123632, "text": "El saludo de mí, Pablo, de mi mano.", "words": [[0, 121612], [3, 121692], [10, 122092], [13, 122272], [17, 122652], [24, 123032], [27, 123112], [30, 123212]]}, {"verse": 22, "start": 123982, "end": 128235, "text": "El que no ame al Señor Jesucristo, quede bajo maldición. Maranatha.", "words": [[0, 123982], [3, 124103], [7, 124223], [10, 124423], [14, 124703], [17, 124803], [23, 125023], [35, 125536], [41, 126050], [46, 126563], [57, 127891]]}, {"verse": 23, "start": 128585, "end": 131484, "text": "La gracia del Señor Jesucristo sea con vosotros.", "words": [[0, 128585], [3, 128842], [10, 129242], [14, 129362], [20, 129622], [31, 130382], [35, 130582], [39, 130802]]}, {"verse": 24, "start": 131834, "end": 141537, "text": "Mi amor en Cristo Jesús sea con todos vosotros. Amén. La primera a los Corintios fue enviada de Filipos con Estéfanas, y Fortunato, y Acaico, y Timoteo.", "words": [[0, 131834], [3, 131955], [8, 132155], [11, 132335], [18, 132695], [24, 133095], [28, 133475], [32, 133715], [38, 133975], [48, 134965], [54, 135662], [57, 135782], [65, 136102], [67, 136262], [71, 136362], [81, 136882], [85, 137082], [93, 137502], [96, 137682], [104, 138162], [108, 138342], [119, 139122], [121, 139282], [132, 139942], [134, 140182], [142, 140662], [144, 140862]]}]}