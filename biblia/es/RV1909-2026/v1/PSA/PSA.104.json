{"book": "PSA", "chapter": 104, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 224481, "verses": [{"verse": 1, "start": 300, "end": 10330, "text": "Bendice, alma mía, a Jehová. Jehová, Dios mío, mucho te has engrandecido; te has vestido de gloria y de magnificencia.", "words": [[0, 1870], [9, 2450], [14, 2870], [19, 3370], [21, 3610], [29, 4754], [37, 5054], [42, 5174], [47, 5734], [53, 5994], [56, 6094], [60, 6194], [74, 7611], [77, 7696], [81, 7796], [89, 8216], [92, 8336], [99, 8836], [101, 8976], [104, 9096]]}, {"verse": 2, "start": 10780, "end": 16690, "text": "El que se cubre de luz como de vestidura, que extiende los cielos como una cortina;", "words": [[0, 10780], [3, 10949], [7, 11089], [10, 11249], [16, 11709], [19, 11869], [23, 12049], [28, 12409], [31, 12589], [42, 13309], [46, 13869], [55, 14529], [59, 14709], [66, 15289], [71, 15509], [75, 15749]]}, {"verse": 3, "start": 17140, "end": 25428, "text": "Que establece sus aposentos entre las aguas; el que pone las nubes por su carroza, el que anda sobre las alas del viento;", "words": [[0, 17140], [4, 17242], [14, 17722], [18, 17862], [28, 18642], [34, 18862], [38, 19122], [45, 20085], [48, 20212], [52, 20352], [57, 20672], [61, 20892], [67, 21292], [71, 21512], [74, 22152], [83, 22792], [86, 23132], [90, 23312], [95, 23592], [101, 23972], [105, 24212], [110, 24552], [114, 24732]]}, {"verse": 4, "start": 25878, "end": 30892, "text": "El que hace a sus ángeles espíritus, sus ministros al fuego flameante.", "words": [[0, 25878], [3, 26004], [7, 26164], [12, 26464], [14, 26644], [18, 26744], [26, 27324], [37, 28444], [41, 28624], [51, 29324], [54, 29504], [60, 29804]]}, {"verse": 5, "start": 31342, "end": 36137, "text": "Él fundó la tierra sobre sus bases; no será jamás removida.", "words": [[0, 31342], [3, 31507], [9, 31967], [12, 32087], [19, 32447], [25, 32807], [29, 33047], [36, 34079], [39, 34452], [44, 34692], [50, 35424]]}, {"verse": 6, "start": 36587, "end": 41704, "text": "Con el abismo, como con vestido, la cubriste; sobre los montes estaban las aguas.", "words": [[0, 36587], [4, 36711], [7, 36851], [15, 37251], [20, 37531], [24, 37731], [33, 38311], [36, 38431], [46, 39491], [52, 39755], [56, 39975], [63, 40415], [71, 40775], [75, 41055]]}, {"verse": 7, "start": 42154, "end": 48087, "text": "A tu reprensión huyeron; al sonido de tu trueno se apresuraron;", "words": [[0, 42154], [2, 42466], [5, 42586], [16, 43386], [25, 44641], [28, 45020], [35, 45760], [38, 45940], [41, 46140], [48, 46600], [51, 47356]]}, {"verse": 8, "start": 48537, "end": 53401, "text": "Subieron los montes, descendieron los valles, al lugar que tú les fundaste.", "words": [[0, 48537], [9, 48995], [13, 49175], [21, 50115], [34, 50835], [38, 51055], [46, 51535], [49, 51915], [55, 52255], [59, 52475], [62, 52655], [66, 52835]]}, {"verse": 9, "start": 53851, "end": 59855, "text": "Les pusiste un límite, el cual no traspasarán; ni volverán a cubrir la tierra.", "words": [[0, 53851], [4, 54394], [12, 54874], [15, 55014], [23, 55594], [26, 56054], [31, 56214], [34, 56414], [47, 57876], [50, 57986], [59, 58566], [61, 58806], [68, 59046], [71, 59206]]}, {"verse": 10, "start": 60305, "end": 65285, "text": "Tú eres el que envías las fuentes por los arroyos; van entre los montes.", "words": [[0, 60305], [3, 60447], [8, 60707], [11, 60907], [15, 61067], [22, 61400], [26, 61734], [34, 62067], [38, 62307], [42, 62487], [51, 63575], [55, 63938], [61, 64238], [65, 64438]]}, {"verse": 11, "start": 65735, "end": 71646, "text": "Dan de beber a todas las bestias del campo: quebrantan su sed los asnos montaraces.", "words": [[0, 65735], [4, 65945], [7, 66105], [13, 66385], [15, 66565], [21, 66785], [25, 67065], [33, 67465], [37, 67585], [44, 68864], [55, 69174], [58, 69414], [62, 69774], [66, 70154], [72, 70614]]}, {"verse": 12, "start": 72096, "end": 77869, "text": "Junto a aquellos habitarán las aves de los cielos; entre las ramas dan voces.", "words": [[0, 72096], [6, 72357], [8, 72577], [17, 72877], [27, 73717], [31, 73897], [36, 74317], [39, 74457], [43, 74597], [51, 75756], [57, 76156], [61, 76396], [67, 76876], [71, 77373]]}, {"verse": 13, "start": 78319, "end": 84818, "text": "El que riega los montes desde sus aposentos: del fruto de sus obras se sacia la tierra.", "words": [[0, 78319], [3, 78465], [7, 78605], [13, 79045], [17, 79205], [24, 79745], [30, 80005], [34, 80305], [45, 81513], [49, 81853], [55, 82313], [58, 82453], [62, 82613], [68, 83053], [71, 83513], [77, 83993], [80, 84133]]}, {"verse": 14, "start": 85268, "end": 92984, "text": "El que hace producir el heno para las bestias, y la hierba para el servicio del hombre; sacando el pan de la tierra.", "words": [[0, 85268], [3, 85395], [7, 85555], [12, 85835], [21, 86515], [24, 86825], [29, 87135], [34, 87355], [38, 87535], [47, 88155], [49, 88575], [52, 88695], [59, 89215], [64, 89495], [67, 89655], [76, 90080], [80, 90505], [88, 91163], [96, 91605], [99, 91745], [103, 92065], [106, 92245], [109, 92345]]}, {"verse": 15, "start": 93434, "end": 102497, "text": "Y el vino que alegra el corazón del hombre, y el aceite que hace lucir el rostro, y el pan que sustenta el corazón del hombre.", "words": [[0, 93434], [2, 93557], [5, 93717], [10, 93957], [14, 94177], [21, 94637], [24, 94737], [32, 95137], [36, 95437], [44, 95737], [46, 96537], [49, 96717], [56, 97217], [60, 97537], [65, 97777], [71, 98237], [74, 98377], [82, 99297], [84, 99537], [87, 99717], [91, 100057], [95, 100317], [104, 101037], [107, 101197], [115, 101597], [119, 101917]]}, {"verse": 16, "start": 102947, "end": 108007, "text": "Se llenan de jugo los árboles de Jehová, los cedros del Líbano que él plantó.", "words": [[0, 102947], [3, 103110], [10, 103450], [13, 103630], [18, 104070], [22, 104230], [30, 104770], [33, 104910], [41, 105710], [45, 105790], [52, 106230], [56, 106410], [63, 106910], [67, 107130], [70, 107270]]}, {"verse": 17, "start": 108457, "end": 113085, "text": "Allí anidan las aves; en las hayas hace su casa la cigüeña.", "words": [[0, 108457], [5, 108795], [12, 109155], [16, 109395], [22, 110357], [25, 110524], [29, 110874], [35, 111224], [40, 111524], [43, 111764], [48, 112064], [51, 112284]]}, {"verse": 18, "start": 113535, "end": 119185, "text": "Los montes altos para las cabras monteses; las peñas, madrigueras para los conejos.", "words": [[0, 113535], [4, 113868], [11, 114348], [17, 114808], [22, 114988], [26, 115208], [33, 115628], [43, 116823], [47, 116983], [54, 117323], [66, 118023], [71, 118223], [75, 118383]]}, {"verse": 19, "start": 119635, "end": 124388, "text": "Hizo la luna para los tiempos: el sol conoce su ocaso.", "words": [[0, 119635], [5, 120065], [8, 120285], [13, 120605], [18, 120785], [22, 120925], [31, 122030], [34, 122278], [38, 122598], [45, 123398], [48, 123921]]}, {"verse": 20, "start": 124838, "end": 131099, "text": "Pone las tinieblas, y es la noche: en ella corretean todas las bestias de la selva.", "words": [[0, 125126], [5, 125422], [9, 125718], [20, 126014], [22, 126310], [25, 126450], [28, 126610], [35, 127524], [38, 127686], [43, 127866], [53, 128646], [59, 129226], [63, 129786], [71, 130226], [74, 130346], [77, 130737]]}, {"verse": 21, "start": 131549, "end": 135335, "text": "Los leoncillos rugen a la presa, y para buscar de Dios su comida.", "words": [[0, 131549], [4, 131698], [15, 132498], [21, 132818], [23, 132978], [26, 133058], [33, 133438], [35, 133518], [40, 133698], [47, 134018], [50, 134278], [55, 134498], [58, 134698]]}, {"verse": 22, "start": 135785, "end": 139501, "text": "Sale el sol, se recogen, y se echan en sus cuevas.", "words": [[0, 135785], [5, 136088], [8, 136348], [13, 136588], [16, 136808], [25, 137488], [27, 138008], [30, 138148], [36, 138408], [39, 138588], [43, 138768]]}, {"verse": 23, "start": 139951, "end": 144675, "text": "Sale el hombre a su labor, y a su labranza hasta la tarde.", "words": [[0, 139951], [5, 140297], [8, 140637], [15, 140937], [17, 141097], [20, 141217], [27, 141637], [29, 142377], [31, 142457], [34, 142577], [43, 143297], [49, 143917], [52, 144077]]}, {"verse": 24, "start": 145125, "end": 153942, "text": "¡Cuán muchas son tus obras, oh Jehová! Hiciste todas ellas con sabiduría: la tierra está llena de tus beneficios.", "words": [[0, 145125], [6, 145332], [13, 145672], [17, 145952], [21, 146132], [28, 146594], [31, 147057], [39, 147819], [47, 148376], [53, 148676], [59, 149076], [63, 149774], [74, 150712], [77, 151069], [84, 151429], [89, 151869], [95, 152309], [98, 152449], [102, 152649]]}, {"verse": 25, "start": 154392, "end": 162995, "text": "Asimismo esta gran mar y ancha de términos: en ella pescados sin número, animales pequeños y grandes.", "words": [[0, 154392], [9, 154947], [14, 155521], [19, 156094], [23, 156374], [25, 156754], [31, 157154], [34, 157314], [44, 158392], [47, 158579], [52, 159159], [61, 159879], [65, 160299], [73, 161079], [82, 161479], [91, 162159], [93, 162259]]}, {"verse": 26, "start": 163445, "end": 169930, "text": "Allí andan navíos; allí este leviathán que hiciste para que jugase en ella.", "words": [[0, 163777], [5, 164147], [11, 164647], [19, 165759], [24, 166219], [29, 166599], [39, 166979], [43, 167359], [51, 168099], [56, 168319], [60, 168499], [67, 169039], [70, 169239]]}, {"verse": 27, "start": 170380, "end": 175140, "text": "Todos ellos esperan en ti, para que les des su comida a su tiempo.", "words": [[0, 170380], [6, 170582], [12, 170922], [20, 171562], [23, 171722], [27, 171982], [32, 172742], [36, 172882], [40, 173022], [44, 173282], [47, 173722], [54, 174082], [56, 174402], [59, 174502]]}, {"verse": 28, "start": 175590, "end": 179674, "text": "Les das, recogen; abres tu mano, se hartan de bien.", "words": [[0, 175590], [4, 175699], [9, 176299], [18, 177383], [24, 177850], [27, 178030], [33, 178470], [36, 178610], [43, 179070], [46, 179190]]}, {"verse": 29, "start": 180124, "end": 187398, "text": "Escondes tu rostro, se turban: les quitas el espíritu, dejan de ser, y se convierten en su polvo.", "words": [[0, 180124], [9, 180804], [12, 180964], [20, 181444], [23, 181584], [31, 182633], [35, 182758], [42, 183218], [45, 183378], [55, 184358], [61, 184778], [64, 184938], [69, 185198], [71, 185638], [74, 185778], [85, 186418], [88, 186638], [91, 186798]]}, {"verse": 30, "start": 187848, "end": 193016, "text": "Envías tu espíritu, son creados: y renuevas la faz de la tierra.", "words": [[0, 187848], [7, 188285], [10, 188405], [20, 188985], [24, 189085], [33, 190279], [35, 190386], [44, 191046], [47, 191186], [51, 191406], [54, 191546], [57, 191666]]}, {"verse": 31, "start": 193466, "end": 198201, "text": "Sea la gloria de Jehová para siempre; alégrese Jehová en sus obras;", "words": [[0, 193466], [4, 193466], [7, 193846], [14, 194226], [17, 194536], [24, 194846], [29, 194966], [38, 196083], [47, 196574], [54, 197094], [57, 197234], [61, 197374]]}, {"verse": 32, "start": 198651, "end": 204009, "text": "El cual mira a la tierra, y ella tiembla; toca los montes, y humean.", "words": [[0, 198651], [3, 198818], [8, 199018], [13, 199358], [15, 199578], [18, 199658], [26, 200158], [28, 200698], [33, 200918], [42, 201916], [47, 202098], [51, 202298], [59, 202978], [61, 203298]]}, {"verse": 33, "start": 204459, "end": 209761, "text": "A Jehová cantaré en mi vida: a mi Dios cantaré salmos mientras viva.", "words": [[0, 204459], [2, 204597], [9, 204997], [17, 205477], [20, 205737], [23, 205917], [29, 206720], [31, 206920], [34, 207060], [39, 207300], [47, 207800], [54, 208460], [63, 208900]]}, {"verse": 34, "start": 210211, "end": 214535, "text": "Dulce será mi meditación en él: yo me alegraré en Jehová.", "words": [[0, 210211], [6, 210796], [11, 211176], [14, 211416], [25, 212116], [28, 212336], [32, 213204], [35, 213484], [38, 213764], [47, 214044], [50, 214324]]}, {"verse": 35, "start": 214985, "end": 224081, "text": "Sean consumidos de la tierra los pecadores, y los impíos dejen de ser. Bendice, alma mía, a Jehová. Aleluya.", "words": [[0, 214985], [5, 215271], [16, 216091], [19, 216211], [22, 216331], [29, 216851], [33, 216931], [44, 217551], [46, 218051], [50, 218156], [57, 218260], [63, 218365], [66, 218470], [71, 220444], [80, 221024], [85, 221444], [90, 221944], [92, 222184], [100, 223577]]}]}