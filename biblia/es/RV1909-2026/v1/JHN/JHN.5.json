{"book": "JHN", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 366062, "verses": [{"verse": 1, "start": 300, "end": 7120, "text": "Después de estas cosas, era un día de fiesta de los judíos, y subió Jesús a Jerusalén.", "words": [[0, 300], [8, 604], [11, 864], [17, 1084], [24, 2184], [28, 2504], [31, 2684], [35, 2844], [38, 3024], [45, 3484], [48, 3624], [52, 3804], [60, 4484], [62, 5004], [68, 5404], [74, 5784], [76, 6164]]}, {"verse": 2, "start": 7470, "end": 16694, "text": "Y hay en Jerusalén a la puerta del ganado un estanque, que en hebreo es llamado Betesda, el cual tiene cinco portales.", "words": [[0, 7470], [2, 7596], [6, 7736], [9, 7916], [19, 8696], [21, 8856], [24, 8976], [31, 9256], [35, 9556], [42, 10156], [45, 10416], [55, 11116], [59, 11796], [62, 12076], [69, 12536], [72, 12716], [80, 13376], [89, 14036], [92, 14216], [97, 14436], [103, 14856], [109, 15516]]}, {"verse": 3, "start": 17044, "end": 25769, "text": "En estos yacía multitud de enfermos, ciegos, cojos, con miembros atrofiados, que estaban esperando el movimiento del agua.", "words": [[0, 17044], [3, 17216], [9, 17796], [15, 18296], [24, 18976], [27, 19216], [37, 20356], [45, 21096], [52, 22076], [56, 22176], [65, 22676], [77, 23416], [81, 23616], [89, 23896], [99, 24276], [102, 24556], [113, 24956], [117, 25336]]}, {"verse": 4, "start": 26119, "end": 39982, "text": "Porque un ángel descendía a cierto tiempo al estanque, y revolvía el agua; y el que primero descendía en el estanque después del movimiento del agua, era sano de cualquier enfermedad que tuviese.", "words": [[0, 26119], [7, 26439], [10, 26659], [16, 27159], [26, 27859], [28, 28099], [35, 28359], [42, 29039], [45, 29339], [55, 30019], [57, 30609], [66, 31199], [69, 31399], [75, 32194], [77, 32340], [80, 32480], [84, 32640], [92, 33160], [102, 34040], [105, 34280], [108, 34420], [117, 35040], [125, 35360], [129, 35640], [140, 36160], [144, 36560], [150, 36920], [154, 37480], [159, 37840], [162, 38020], [172, 38320], [183, 39160], [187, 39280]]}, {"verse": 5, "start": 40332, "end": 44557, "text": "Y estaba allí un hombre que había treinta y ocho años que estaba enfermo.", "words": [[0, 40332], [2, 40440], [9, 40740], [14, 41060], [17, 41240], [24, 41560], [28, 41780], [34, 41980], [42, 42180], [44, 42380], [49, 42580], [54, 43320], [58, 43540], [65, 43800]]}, {"verse": 6, "start": 44907, "end": 51981, "text": "Como Jesús vio a este echado, y entendió que ya había mucho tiempo, le dice: ¿Quieres ser sano?", "words": [[0, 44907], [5, 45071], [11, 45411], [15, 46091], [17, 46311], [22, 46631], [30, 47311], [32, 47931], [41, 48571], [45, 48751], [48, 49011], [54, 49191], [60, 49491], [68, 50051], [71, 50131], [77, 50839], [86, 51183], [90, 51343]]}, {"verse": 7, "start": 52201, "end": 60647, "text": "Señor, le respondió el enfermo, no tengo quien me meta en el estanque cuando el agua sea revuelta; y mientras voy, otro desciende antes que yo.", "words": [[0, 52201], [7, 52966], [10, 53088], [20, 53668], [23, 53788], [32, 54748], [35, 54895], [41, 55215], [47, 55415], [50, 55575], [55, 55835], [58, 55955], [61, 56055], [70, 56535], [77, 56755], [80, 56935], [85, 57135], [89, 57335], [99, 58232], [101, 58334], [110, 58634], [115, 58974], [120, 59414], [130, 59914], [136, 60114], [140, 60334]]}, {"verse": 8, "start": 60927, "end": 64360, "text": "Le dice Jesús: Levántate, toma tu lecho, y anda.", "words": [[0, 60927], [3, 61075], [8, 61315], [15, 62243], [26, 62948], [31, 63168], [34, 63358], [41, 63548], [43, 63888]]}, {"verse": 9, "start": 64710, "end": 71874, "text": "Y de inmediato aquel hombre fue sanado, y tomó su lecho, e iba andando. Y era sábado aquel día.", "words": [[0, 64710], [2, 64838], [5, 64938], [15, 65538], [21, 65818], [28, 66018], [32, 66258], [40, 66818], [42, 67358], [47, 67658], [50, 67758], [57, 68198], [59, 68618], [63, 68838], [72, 69820], [74, 70100], [78, 70300], [85, 70920], [91, 71440]]}, {"verse": 10, "start": 72224, "end": 79888, "text": "Entonces los judíos decían a aquel que había sido sanado: Sábado es: no te es lícito llevar tu lecho.", "words": [[0, 72224], [9, 72977], [13, 73100], [20, 73740], [27, 74580], [29, 74800], [35, 75140], [39, 75280], [45, 75520], [50, 75940], [58, 77216], [65, 77542], [69, 78028], [72, 78192], [75, 78445], [78, 78699], [85, 78952], [92, 79172], [95, 79412]]}, {"verse": 11, "start": 80168, "end": 84758, "text": "Les respondió: El que me sanó, él mismo me dijo: Toma tu lecho y anda.", "words": [[0, 80168], [4, 80321], [15, 81365], [18, 81488], [22, 81588], [25, 81728], [31, 82328], [34, 82468], [40, 82748], [43, 82928], [49, 83586], [54, 83807], [57, 83907], [63, 84207], [65, 84387]]}, {"verse": 12, "start": 85038, "end": 89756, "text": "Le preguntaron entonces: ¿Quién es el que te dijo: Toma tu lecho y anda?", "words": [[0, 85038], [3, 85163], [15, 85903], [25, 87221], [32, 87427], [35, 87527], [38, 87647], [42, 87747], [45, 87887], [51, 88533], [56, 88789], [59, 88889], [65, 89209], [67, 89389]]}, {"verse": 13, "start": 90036, "end": 98267, "text": "Y el que había sido sanado, no sabía quién fuese; porque Jesús se había apartado de la gente que estaba en aquel lugar.", "words": [[0, 90036], [2, 90203], [5, 90323], [9, 90503], [15, 90703], [20, 91103], [28, 92063], [31, 92403], [37, 92863], [43, 93163], [50, 94149], [57, 94373], [63, 94813], [66, 95073], [72, 95313], [81, 96053], [84, 96213], [87, 96333], [93, 96653], [97, 96853], [104, 97153], [107, 97313], [113, 97613]]}, {"verse": 14, "start": 98616, "end": 108493, "text": "Después le halló Jesús en el templo, y le dijo: He aquí, has sido sanado; no peques más, porque no te venga alguna cosa peor.", "words": [[0, 98712], [8, 99336], [11, 99576], [17, 100036], [23, 100496], [26, 100976], [29, 101116], [37, 101756], [39, 101856], [42, 101996], [48, 102810], [51, 102900], [57, 103250], [61, 103600], [66, 103960], [74, 104882], [77, 105068], [84, 105408], [89, 106168], [96, 106568], [99, 106768], [102, 106908], [108, 107208], [115, 107488], [120, 107848]]}, {"verse": 15, "start": 108843, "end": 113742, "text": "Él se fue, y dio aviso a los judíos, que Jesús era el que le había sanado.", "words": [[0, 108843], [3, 108990], [6, 109170], [11, 109450], [13, 109730], [17, 109950], [23, 110290], [25, 110430], [29, 110530], [37, 111330], [41, 111550], [47, 111850], [51, 112310], [54, 112470], [58, 112610], [61, 112770], [67, 113010]]}, {"verse": 16, "start": 114092, "end": 121830, "text": "Y por esta causa los judíos perseguían a Jesús, y procuraban matarle, porque hacía estas cosas en sábado.", "words": [[0, 114092], [2, 114233], [6, 114453], [11, 114713], [17, 115173], [21, 115453], [28, 115953], [39, 116653], [41, 116753], [48, 117093], [50, 117673], [61, 118373], [70, 119533], [77, 119933], [83, 120313], [89, 120573], [95, 120913], [98, 121193]]}, {"verse": 17, "start": 122180, "end": 128043, "text": "Y Jesús les respondió: Mi Padre hasta ahora trabaja, y yo trabajo.", "words": [[0, 122180], [2, 122530], [8, 122940], [12, 123350], [23, 124364], [26, 124509], [32, 124769], [38, 125149], [44, 125429], [53, 126294], [55, 126494], [58, 126634]]}, {"verse": 18, "start": 128393, "end": 139998, "text": "Entonces, por tanto, más procuraban los judíos matarle, porque no sólo quebrantaba el sábado, sino que también a su Padre llamaba Dios, haciéndose igual a Dios.", "words": [[0, 128393], [10, 129119], [14, 129200], [21, 129851], [25, 130502], [36, 131154], [40, 131314], [47, 131834], [56, 132594], [63, 133134], [66, 133394], [71, 133674], [83, 134454], [86, 134614], [94, 135474], [99, 135654], [103, 135854], [111, 136194], [113, 136334], [116, 136454], [122, 136714], [130, 137194], [136, 137914], [147, 138594], [153, 139074], [155, 139434]]}, {"verse": 19, "start": 140348, "end": 155110, "text": "Respondió entonces Jesús, y les dijo: De cierto, de cierto os digo: No puede el Hijo hacer nada de sí mismo, sino lo que ve hacer al Padre: porque todo lo que él hace, esto también hace el Hijo juntamente.", "words": [[0, 140508], [10, 141008], [19, 141268], [26, 141908], [28, 142268], [32, 142388], [38, 143416], [41, 143672], [49, 143928], [52, 144184], [59, 144440], [62, 144640], [68, 145413], [71, 145604], [77, 145964], [80, 146324], [85, 146604], [91, 146904], [96, 147384], [99, 147644], [102, 147844], [109, 148584], [114, 148824], [117, 149004], [121, 149124], [124, 149364], [130, 149484], [133, 149664], [140, 150419], [147, 150623], [152, 151063], [155, 151343], [159, 151523], [162, 151703], [168, 152263], [173, 152563], [181, 152963], [186, 153403], [189, 153783], [194, 154063]]}, {"verse": 20, "start": 155460, "end": 166084, "text": "Porque el Padre ama al Hijo, y le muestra todas las cosas que él hace; y mayores obras que estas le mostrará, de suerte que vosotros os maravilléis.", "words": [[0, 155460], [7, 155702], [10, 155862], [16, 156362], [20, 156642], [23, 156962], [29, 157282], [31, 157942], [34, 158062], [42, 158562], [48, 158822], [52, 159142], [58, 159482], [62, 159782], [65, 159982], [71, 160853], [73, 160962], [81, 161422], [87, 161722], [91, 161962], [97, 162202], [100, 162442], [110, 163102], [113, 163602], [120, 164082], [124, 164282], [133, 164802], [136, 165042]]}, {"verse": 21, "start": 166434, "end": 173060, "text": "Porque como el Padre levanta los muertos, y les da vida, así también el Hijo a los que quiere da vida.", "words": [[0, 166434], [7, 166678], [12, 166958], [15, 167138], [21, 167698], [29, 168218], [33, 168338], [42, 168958], [44, 169558], [48, 169678], [51, 169898], [57, 170523], [61, 170783], [69, 171070], [72, 171356], [77, 171643], [79, 171823], [83, 171923], [87, 172063], [94, 172313], [97, 172563]]}, {"verse": 22, "start": 173410, "end": 178139, "text": "Porque el Padre a nadie juzga, sino que todo el juicio dio al Hijo;", "words": [[0, 173410], [7, 173632], [10, 173812], [16, 174332], [18, 174452], [24, 174772], [31, 175672], [36, 175992], [40, 176192], [45, 176432], [48, 176692], [55, 177132], [59, 177432], [62, 177712]]}, {"verse": 23, "start": 178489, "end": 187413, "text": "Para que todos honren al Hijo como honran al Padre. El que no honra al Hijo, no honra al Padre que le envió.", "words": [[0, 178489], [5, 178631], [9, 178791], [15, 179071], [22, 179851], [25, 180191], [30, 180531], [35, 180851], [42, 181491], [45, 181691], [52, 182535], [55, 182656], [59, 182816], [62, 182996], [68, 183536], [71, 183776], [77, 184716], [80, 184876], [86, 185536], [89, 185756], [95, 186356], [99, 186496], [102, 186676]]}, {"verse": 24, "start": 187763, "end": 199699, "text": "De cierto, de cierto os digo: El que oye mi palabra, y cree al que me ha enviado, tiene vida eterna; y no vendrá a condenación, sino que pasó de muerte a vida.", "words": [[0, 187981], [3, 188237], [11, 188493], [14, 188749], [21, 189005], [24, 189205], [30, 189979], [33, 190138], [37, 190338], [41, 190718], [44, 190878], [53, 191438], [55, 191778], [60, 192078], [63, 192358], [67, 192538], [70, 192698], [73, 192818], [82, 193418], [88, 194038], [93, 194458], [101, 195664], [103, 195785], [106, 195905], [113, 196265], [115, 196365], [128, 197605], [133, 197965], [137, 198145], [142, 198445], [145, 198625], [152, 198945], [154, 199165]]}, {"verse": 25, "start": 200049, "end": 209560, "text": "De cierto, de cierto os digo: Vendrá hora, y ahora es, cuando los muertos oirán la voz del Hijo de Dios: y los que oyen vivirán.", "words": [[0, 200268], [3, 200524], [11, 200780], [14, 201036], [21, 201292], [24, 201492], [30, 202265], [37, 202711], [43, 203111], [45, 203591], [51, 203851], [55, 204191], [62, 204611], [66, 204851], [74, 205291], [80, 205951], [83, 206151], [87, 206431], [91, 206751], [96, 207031], [99, 207171], [105, 208044], [107, 208166], [111, 208306], [115, 208486], [120, 209055]]}, {"verse": 26, "start": 209910, "end": 215968, "text": "Porque como el Padre tiene vida en sí mismo, así dio también al Hijo que tuviese vida en sí mismo:", "words": [[0, 209910], [7, 210094], [12, 210374], [15, 210534], [21, 210954], [27, 211174], [32, 211494], [35, 211674], [38, 211854], [45, 212694], [49, 213034], [53, 213254], [61, 213614], [64, 213854], [69, 214154], [73, 214334], [81, 214774], [86, 215094], [89, 215294], [92, 215454]]}, {"verse": 27, "start": 216318, "end": 221067, "text": "Y también le dio poder de hacer juicio, en cuanto es el Hijo del hombre.", "words": [[0, 216318], [2, 216423], [10, 216763], [13, 217003], [17, 217183], [23, 217543], [26, 217783], [32, 217983], [40, 218683], [43, 219283], [50, 219503], [53, 219843], [56, 220003], [61, 220243], [65, 220503]]}, {"verse": 28, "start": 221417, "end": 229246, "text": "No os maravilléis de esto; porque vendrá hora, cuando todos los que están en los sepulcros oirán su voz;", "words": [[0, 221417], [3, 221827], [6, 222277], [18, 222727], [21, 222947], [27, 223737], [34, 223941], [41, 224421], [47, 225181], [54, 225541], [60, 225941], [64, 226241], [68, 226421], [74, 226661], [77, 226821], [81, 226961], [91, 227721], [97, 228441], [100, 228681]]}, {"verse": 29, "start": 229596, "end": 237863, "text": "Y los que hicieron bien, saldrán a resurrección de vida; pero los que hicieron mal, a resurrección de condenación.", "words": [[0, 229596], [2, 229718], [6, 229838], [10, 230018], [19, 230498], [25, 230838], [33, 232078], [35, 232238], [48, 233038], [51, 233218], [57, 233936], [62, 234161], [66, 234381], [70, 234561], [79, 235021], [84, 235421], [86, 235881], [99, 236681], [102, 236821]]}, {"verse": 30, "start": 238213, "end": 249488, "text": "No puedo yo de mí mismo hacer nada: como oigo, juzgo: y mi juicio es justo; porque no busco mi voluntad, sino la voluntad del que me envió, del Padre.", "words": [[0, 238213], [3, 238341], [9, 238601], [12, 238861], [15, 239021], [18, 239181], [24, 239501], [30, 239781], [36, 240746], [41, 240866], [47, 241466], [54, 242677], [56, 242802], [59, 242902], [66, 243342], [69, 243622], [76, 244445], [83, 244646], [86, 244846], [92, 245166], [95, 245326], [105, 246246], [110, 246466], [113, 246686], [122, 247406], [126, 247646], [130, 247826], [133, 248006], [140, 248626], [144, 248846]]}, {"verse": 31, "start": 249838, "end": 254309, "text": "Si yo doy testimonio de mí mismo, mi testimonio no es verdadero.", "words": [[0, 249838], [3, 250020], [6, 250220], [10, 250460], [21, 251100], [24, 251220], [27, 251360], [34, 252020], [37, 252160], [48, 252960], [51, 253220], [54, 253440]]}, {"verse": 32, "start": 254659, "end": 260974, "text": "Otro es el que da testimonio de mí; y sé que el testimonio que da de mí, es verdadero.", "words": [[0, 254659], [5, 255023], [8, 255203], [11, 255343], [15, 255503], [18, 255723], [29, 256523], [32, 256663], [36, 257235], [38, 257362], [41, 257582], [45, 257782], [48, 257982], [59, 258802], [63, 258922], [66, 259082], [69, 259242], [73, 259422], [76, 260042]]}, {"verse": 33, "start": 261324, "end": 265397, "text": "Vosotros enviasteis a Juan, y él dio testimonio a la verdad.", "words": [[0, 261324], [9, 261770], [20, 262650], [22, 262770], [28, 263090], [30, 263445], [33, 263665], [37, 263865], [48, 264625], [50, 264725], [53, 264805]]}, {"verse": 34, "start": 265747, "end": 272032, "text": "Pero yo no tomo el testimonio de hombre; pero digo esto, para que vosotros seáis salvos.", "words": [[0, 265747], [5, 265891], [8, 266071], [11, 266251], [16, 266631], [19, 266711], [30, 267331], [33, 267451], [41, 268210], [46, 268376], [51, 268676], [57, 269343], [62, 269543], [66, 269703], [75, 270323], [81, 271003]]}, {"verse": 35, "start": 272382, "end": 279471, "text": "Él era antorcha que ardía y alumbraba: y vosotros quisisteis alegraros por un tiempo en su luz.", "words": [[0, 272382], [3, 272753], [7, 272993], [16, 273813], [20, 274013], [26, 274493], [28, 274653], [39, 275701], [41, 275827], [50, 276327], [61, 277147], [71, 277827], [75, 278067], [78, 278227], [85, 278607], [88, 278827], [91, 278987]]}, {"verse": 36, "start": 279821, "end": 292632, "text": "Pero yo tengo mayor testimonio que el de Juan: porque las obras que el Padre me dio que cumpliese, las mismas obras que yo hago, dan testimonio de mí, que el Padre me haya enviado.", "words": [[0, 279821], [5, 279965], [8, 280125], [14, 280425], [20, 280765], [31, 281625], [35, 281805], [38, 282245], [41, 282405], [47, 283254], [54, 283478], [58, 283678], [64, 284038], [68, 284318], [71, 284498], [77, 285098], [80, 285258], [84, 285478], [88, 285638], [99, 286758], [103, 286858], [110, 287278], [116, 287578], [120, 287778], [123, 288018], [129, 288358], [133, 288898], [144, 289598], [147, 289738], [151, 289958], [155, 290478], [158, 290638], [164, 291358], [167, 291538], [172, 291818]]}, {"verse": 37, "start": 292982, "end": 301683, "text": "Y el que me envió, el Padre, él ha dado testimonio de mí. Ni nunca habéis oído su voz, ni habéis visto su aspecto.", "words": [[0, 292982], [2, 293143], [5, 293263], [9, 293463], [12, 293643], [19, 294063], [22, 294363], [29, 295283], [32, 295476], [35, 295670], [40, 295863], [51, 296623], [54, 296723], [58, 297352], [61, 297539], [67, 298039], [74, 298639], [79, 298979], [82, 299179], [87, 299959], [90, 300139], [97, 300479], [103, 300919], [106, 301219]]}, {"verse": 38, "start": 302033, "end": 309165, "text": "Ni tenéis su palabra permanente en vosotros; porque al que él envió, a este vosotros no creéis.", "words": [[0, 302307], [3, 302617], [10, 303037], [13, 303357], [21, 303717], [32, 304437], [35, 304577], [45, 305545], [52, 305747], [55, 305947], [59, 306087], [62, 306267], [69, 306987], [71, 307347], [76, 307527], [85, 308087], [88, 308307]]}, {"verse": 39, "start": 309515, "end": 319592, "text": "Examinad cuidadosamente las Escrituras, porque a vosotros os parece que en ellas tenéis la vida eterna; y ellas son las que dan testimonio de mí.", "words": [[0, 309515], [9, 310385], [24, 311305], [28, 311585], [40, 312565], [47, 312925], [49, 313085], [58, 313705], [61, 314145], [68, 314485], [72, 314765], [75, 314905], [81, 315125], [88, 315665], [91, 315845], [96, 316065], [104, 317055], [106, 317213], [112, 317453], [116, 317773], [120, 317993], [124, 318173], [128, 318353], [139, 319133], [142, 319253]]}, {"verse": 40, "start": 319942, "end": 322375, "text": "Y no queréis venir a mí, para que tengáis vida.", "words": [[0, 319942], [2, 320045], [5, 320165], [13, 320545], [19, 320765], [21, 321005], [25, 321125], [30, 321305], [34, 321465], [42, 321865]]}, {"verse": 41, "start": 322725, "end": 324635, "text": "Gloria de los hombres no recibo.", "words": [[0, 322725], [7, 323170], [10, 323290], [14, 323430], [22, 323750], [25, 323990]]}, {"verse": 42, "start": 324985, "end": 328453, "text": "Pero yo os conozco, que no tenéis amor de Dios en vosotros.", "words": [[0, 324985], [5, 325107], [8, 325347], [11, 325487], [20, 325987], [24, 326127], [27, 326267], [34, 326707], [39, 326987], [42, 327207], [47, 327447], [50, 327687]]}, {"verse": 43, "start": 328803, "end": 336235, "text": "Yo he venido en nombre de mi Padre, y no me recibís: si otro viene en su propio nombre, a aquel recibiréis.", "words": [[0, 328803], [3, 329143], [6, 329263], [13, 329623], [16, 329743], [23, 330043], [26, 330243], [29, 330383], [36, 330743], [38, 331018], [41, 331178], [44, 331278], [53, 332293], [56, 332454], [61, 332694], [67, 333034], [70, 333234], [73, 333414], [80, 333694], [88, 334154], [90, 334554], [96, 335014]]}, {"verse": 44, "start": 336585, "end": 345552, "text": "¿Cómo podéis vosotros creer, pues tomáis la gloria los unos de los otros, y no buscáis la gloria que de sólo Dios viene?", "words": [[0, 336585], [6, 336808], [13, 337348], [22, 337988], [29, 338588], [34, 338788], [41, 339428], [44, 339708], [51, 340328], [55, 340488], [60, 340728], [63, 340908], [67, 341048], [74, 341388], [76, 341948], [79, 342148], [87, 342728], [90, 343008], [97, 343508], [101, 344108], [104, 344248], [109, 344548], [114, 344868]]}, {"verse": 45, "start": 345902, "end": 353492, "text": "No penséis que yo os voy a acusar delante del Padre; hay quien os acusa, Moisés, en quien vosotros esperáis.", "words": [[0, 345902], [3, 346032], [11, 346472], [15, 346652], [18, 346892], [21, 347132], [25, 347372], [27, 347552], [34, 348032], [42, 348472], [46, 348692], [53, 349547], [57, 349776], [63, 350076], [66, 350376], [73, 350836], [81, 351336], [84, 351736], [90, 351976], [99, 352596]]}, {"verse": 46, "start": 353842, "end": 360438, "text": "Porque si vosotros creyeseis a Moisés, creeríais a mí; porque de mí escribió él.", "words": [[0, 353842], [7, 354027], [10, 354207], [19, 354857], [29, 355507], [31, 355647], [39, 356667], [49, 357447], [51, 357567], [55, 358087], [62, 358352], [65, 358592], [68, 358892], [77, 359872]]}, {"verse": 47, "start": 360788, "end": 365662, "text": "Y si a sus escritos no creéis, ¿cómo creeréis a mis palabras?", "words": [[0, 360788], [2, 360928], [5, 361088], [7, 361268], [11, 361488], [20, 362088], [23, 362408], [31, 363508], [37, 363848], [46, 364548], [48, 364648], [52, 364788]]}]}