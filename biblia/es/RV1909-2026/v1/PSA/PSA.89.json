{"book": "PSA", "chapter": 89, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 316834, "verses": [{"verse": 1, "start": 300, "end": 10497, "text": "Masquil de Etán ezraíta. LAS misericordias de Jehová cantaré perpetuamente: en generación y generación haré notoria tu verdad con mi boca.", "words": [[0, 300], [8, 962], [11, 1202], [16, 1928], [25, 3100], [29, 3406], [43, 3713], [46, 3833], [53, 4253], [61, 4733], [76, 6300], [79, 6448], [90, 7208], [92, 7428], [103, 8168], [108, 8508], [116, 9028], [119, 9208], [126, 9408], [130, 9788], [133, 9968]]}, {"verse": 2, "start": 10497, "end": 17571, "text": "Porque dije: Para siempre será edificada misericordia; en los mismos cielos apoyarás tu verdad.", "words": [[0, 10497], [7, 10837], [13, 11577], [18, 11763], [26, 12303], [31, 12843], [41, 13723], [55, 15058], [58, 15201], [62, 15341], [69, 15621], [76, 16221], [85, 16861], [88, 16981]]}, {"verse": 3, "start": 17791, "end": 22343, "text": "Hice pacto con mi escogido; juré a David mi siervo, diciendo:", "words": [[0, 17936], [5, 18086], [11, 18606], [15, 18786], [18, 18906], [28, 20117], [33, 20463], [35, 20543], [41, 20903], [44, 21023], [52, 21603]]}, {"verse": 4, "start": 22915, "end": 30198, "text": "Para siempre confirmaré tu descendencia, y edificaré tu trono por todas las generaciones. (Selah.)", "words": [[0, 22915], [5, 23080], [13, 23480], [24, 24220], [27, 24360], [41, 25240], [43, 25700], [53, 26260], [56, 26420], [62, 26800], [66, 27020], [72, 27240], [76, 27520], [90, 29573]]}, {"verse": 5, "start": 30718, "end": 37932, "text": "Y celebrarán los cielos tu maravilla, oh Jehová; tu verdad también en la congregación de los santos.", "words": [[0, 30718], [2, 30825], [13, 31605], [17, 31745], [24, 32265], [27, 32405], [38, 32926], [41, 33448], [49, 34124], [52, 34229], [59, 34509], [67, 35209], [70, 35769], [73, 35909], [86, 36809], [89, 37009], [93, 37129]]}, {"verse": 6, "start": 38282, "end": 45708, "text": "Porque ¿quién en los cielos se igualará con Jehová? ¿quién será semejante a Jehová entre los hijos de los potentados?", "words": [[0, 38282], [7, 38544], [14, 39084], [17, 39284], [21, 39444], [28, 39984], [31, 40124], [40, 40624], [44, 40864], [52, 41734], [59, 42054], [64, 42274], [74, 42994], [76, 43134], [83, 43574], [89, 43774], [93, 44014], [99, 44334], [102, 44494], [106, 44614]]}, {"verse": 7, "start": 46058, "end": 53566, "text": "Dios temible en la grande congregación de los santos, y formidable sobre todos cuantos están alrededor suyo.", "words": [[0, 46058], [5, 46345], [13, 47105], [16, 47325], [19, 47465], [26, 47825], [39, 48685], [42, 48845], [46, 48985], [54, 49845], [56, 50335], [67, 50825], [73, 51065], [79, 51555], [87, 52045], [93, 52325], [103, 52665]]}, {"verse": 8, "start": 53916, "end": 61200, "text": "Oh Jehová, Dios de los ejércitos, ¿quién como tú? Poderoso eres, Jehová, y tu fidelidad te rodea.", "words": [[0, 54111], [3, 54337], [11, 54564], [16, 54804], [19, 55084], [23, 55244], [34, 56224], [41, 56524], [46, 56724], [50, 57492], [59, 58014], [65, 58274], [73, 59054], [75, 59314], [78, 59474], [88, 60234], [91, 60474]]}, {"verse": 9, "start": 61550, "end": 67738, "text": "Tú tienes dominio sobre la bravura del mar: cuando se levantan sus ondas, tú las sosiegas.", "words": [[0, 61550], [3, 61872], [10, 62172], [18, 62772], [24, 63012], [27, 63232], [35, 63672], [39, 63852], [44, 64444], [51, 64784], [54, 65004], [63, 65564], [67, 65764], [74, 66544], [77, 66704], [81, 67242]]}, {"verse": 10, "start": 68088, "end": 75249, "text": "Tú quebrantaste a Rahab como a un muerto: con el brazo de tu fortaleza esparciste a tus enemigos.", "words": [[0, 68088], [3, 68191], [16, 69011], [18, 69241], [24, 69471], [29, 69738], [31, 70004], [34, 70271], [42, 71313], [46, 71606], [49, 71766], [55, 72186], [58, 72306], [61, 72466], [71, 73206], [82, 74046], [84, 74186], [88, 74306]]}, {"verse": 11, "start": 75599, "end": 82134, "text": "Tuyos los cielos, tuya también la tierra: el mundo y su plenitud, tú lo fundaste.", "words": [[0, 75775], [6, 75985], [10, 76125], [18, 76685], [23, 77005], [31, 77365], [34, 77625], [42, 78598], [45, 78758], [51, 79138], [53, 79338], [56, 79498], [66, 80698], [69, 81138], [72, 81278]]}, {"verse": 12, "start": 82484, "end": 88470, "text": "Al norte y al sur tú los creaste: Tabor y Hermón cantarán en tu nombre.", "words": [[0, 82484], [3, 82694], [9, 83174], [11, 83534], [14, 83714], [18, 84317], [21, 84429], [25, 84629], [34, 85717], [40, 86042], [42, 86222], [49, 86892], [58, 87562], [61, 87722], [64, 87862]]}, {"verse": 13, "start": 88820, "end": 94422, "text": "Tuyo el brazo con valentía; fuerte es tu mano, exaltada tu diestra.", "words": [[0, 88820], [5, 89122], [8, 89262], [14, 89642], [18, 89862], [28, 91015], [35, 91452], [38, 91752], [41, 91852], [47, 92672], [56, 93432], [59, 93652]]}, {"verse": 14, "start": 94772, "end": 100988, "text": "Justicia y juicio son el asiento de tu trono: misericordia y verdad van delante de tu rostro.", "words": [[0, 94772], [9, 95331], [11, 95431], [18, 95931], [22, 96346], [25, 96546], [33, 96946], [36, 97146], [39, 97286], [46, 98141], [59, 98945], [61, 99025], [68, 99245], [72, 99565], [80, 99985], [83, 100145], [86, 100305]]}, {"verse": 15, "start": 101338, "end": 107541, "text": "Bienaventurado el pueblo que sabe aclamarte: andarán, oh Jehová, a la luz de tu rostro.", "words": [[0, 101895], [15, 102465], [18, 102605], [25, 102885], [29, 103105], [34, 103689], [45, 104433], [54, 104877], [57, 105357], [65, 105837], [67, 106037], [70, 106117], [74, 106437], [77, 106757], [80, 106897]]}, {"verse": 16, "start": 107891, "end": 113584, "text": "En tu nombre se alegrarán todo el día; y en tu justicia serán ensalzados.", "words": [[0, 107891], [3, 108055], [6, 108215], [13, 108575], [16, 108855], [26, 109575], [31, 109815], [34, 110155], [39, 110845], [41, 111085], [44, 111225], [47, 111385], [56, 112065], [62, 112465]]}, {"verse": 17, "start": 113934, "end": 120575, "text": "Porque tú eres la gloria de su fortaleza; y por tu buena voluntad acrecentarás nuestro poder.", "words": [[0, 113934], [7, 114138], [10, 114458], [15, 114838], [18, 115198], [25, 115658], [28, 115818], [31, 115998], [42, 117189], [44, 117416], [48, 117596], [51, 117756], [57, 117996], [66, 118786], [79, 119576], [87, 119736]]}, {"verse": 18, "start": 120925, "end": 126134, "text": "Porque Jehová es nuestro escudo; y nuestro rey es el Santo de Israel.", "words": [[0, 120925], [7, 121309], [14, 121729], [17, 121969], [25, 122389], [33, 123610], [35, 123697], [43, 123877], [47, 124337], [50, 124617], [53, 124757], [59, 125097], [62, 125377]]}, {"verse": 19, "start": 126484, "end": 135594, "text": "Entonces hablaste en visión a tu santo, y dijiste: Yo he puesto el socorro sobre valiente; he ensalzado un escogido de mi pueblo.", "words": [[0, 126484], [9, 127306], [18, 128246], [21, 128446], [28, 128826], [30, 128966], [33, 129046], [40, 129426], [42, 129566], [51, 130519], [54, 130652], [57, 130772], [64, 130992], [67, 131272], [75, 131712], [81, 131992], [91, 133232], [94, 133414], [104, 134074], [107, 134214], [116, 134774], [119, 134894], [122, 135014]]}, {"verse": 20, "start": 136186, "end": 140255, "text": "Hallé a David mi siervo; lo ungí con el aceite de mi santidad.", "words": [[0, 136287], [6, 136427], [8, 136567], [14, 136947], [17, 137067], [25, 138137], [28, 138395], [33, 138695], [37, 138815], [40, 138935], [47, 139235], [50, 139475], [53, 139575]]}, {"verse": 21, "start": 140839, "end": 145195, "text": "Mi mano será firme con él, mi brazo también lo fortificará.", "words": [[0, 140839], [3, 140965], [8, 141225], [13, 141505], [19, 141985], [23, 142185], [27, 142965], [30, 143145], [36, 143565], [44, 143925], [47, 144185]]}, {"verse": 22, "start": 145776, "end": 150096, "text": "No lo avasallará enemigo, ni hijo de iniquidad lo quebrantará.", "words": [[0, 145776], [3, 145976], [6, 146156], [17, 146896], [26, 147656], [29, 148056], [34, 148356], [37, 148516], [47, 149096], [50, 149256]]}, {"verse": 23, "start": 150687, "end": 155826, "text": "Mas yo quebrantaré delante de él a sus enemigos, y heriré a sus aborrecedores.", "words": [[0, 150687], [4, 150866], [7, 151106], [19, 151786], [27, 152226], [30, 152386], [33, 152546], [35, 152646], [39, 152766], [49, 153426], [51, 153986], [58, 154466], [60, 154626], [64, 154746]]}, {"verse": 24, "start": 156413, "end": 161874, "text": "Y mi verdad y mi misericordia serán con él; y en mi nombre será exaltado su cuerno.", "words": [[0, 156413], [2, 156510], [5, 156590], [12, 156970], [14, 157390], [17, 157490], [30, 158230], [36, 158550], [40, 158690], [44, 159495], [46, 159614], [49, 159714], [52, 159834], [59, 160174], [64, 160494], [73, 161174], [76, 161314]]}, {"verse": 25, "start": 162474, "end": 166284, "text": "Asimismo pondré su mano en el mar, y en los ríos su diestra.", "words": [[0, 162474], [9, 163034], [16, 163394], [19, 163534], [24, 163754], [27, 163894], [30, 164014], [35, 164234], [37, 164634], [40, 164734], [44, 164834], [49, 165334], [52, 165614]]}, {"verse": 26, "start": 166863, "end": 172584, "text": "Él me llamará: Mi padre eres tú, mi Dios, y la roca de mi salvación.", "words": [[0, 166863], [3, 167039], [6, 167159], [15, 168214], [18, 168332], [24, 168732], [29, 168972], [33, 169652], [36, 169732], [42, 170052], [44, 170317], [47, 170437], [52, 170757], [55, 170877], [58, 170977]]}, {"verse": 27, "start": 172804, "end": 176999, "text": "Yo también le pondré por primogénito, alto sobre los reyes de la tierra.", "words": [[0, 172804], [3, 172939], [11, 173179], [14, 173399], [21, 173759], [25, 173919], [38, 175019], [43, 175379], [49, 175719], [53, 175919], [59, 176259], [62, 176359], [65, 176439]]}, {"verse": 28, "start": 177579, "end": 182328, "text": "Para siempre le conservaré mi misericordia; y mi pacto será firme con él.", "words": [[0, 177579], [5, 177741], [13, 178141], [16, 178341], [27, 178941], [30, 179081], [44, 180506], [46, 180578], [49, 180688], [55, 181188], [60, 181368], [66, 181808], [70, 181968]]}, {"verse": 29, "start": 182918, "end": 188165, "text": "Y pondré su descendencia para siempre, y su trono como los días de los cielos.", "words": [[0, 182918], [2, 183025], [9, 183485], [12, 183685], [25, 184545], [30, 184765], [39, 185285], [41, 185765], [44, 185905], [50, 186385], [55, 186625], [59, 186805], [64, 187105], [67, 187325], [71, 187445]]}, {"verse": 30, "start": 188741, "end": 192276, "text": "Si dejan sus hijos mi ley, y no andan en mis juicios;", "words": [[0, 188741], [3, 188886], [9, 189266], [13, 189466], [19, 189786], [22, 190046], [27, 190326], [29, 190786], [32, 190986], [38, 191406], [41, 191526], [45, 191686]]}, {"verse": 31, "start": 192910, "end": 196680, "text": "Si profanan mis estatutos, y no guardan mis mandamientos;", "words": [[0, 192910], [3, 193060], [12, 193600], [16, 193820], [27, 194420], [29, 195000], [32, 195140], [40, 195580], [44, 195740]]}, {"verse": 32, "start": 197274, "end": 201794, "text": "Entonces visitaré con vara su rebelión, y con azotes sus iniquidades.", "words": [[0, 197274], [9, 197734], [18, 198514], [22, 198764], [27, 199014], [30, 199134], [40, 199654], [42, 200094], [46, 200374], [53, 200654], [57, 200874]]}, {"verse": 33, "start": 202372, "end": 205976, "text": "Mas no quitaré de él mi misericordia, ni falsearé mi verdad.", "words": [[0, 202372], [4, 202556], [7, 202696], [15, 203156], [18, 203256], [21, 203396], [24, 203476], [38, 204596], [41, 204946], [50, 205296], [53, 205436]]}, {"verse": 34, "start": 206593, "end": 210647, "text": "No olvidaré mi pacto, ni mudaré lo que ha salido de mis labios.", "words": [[0, 206593], [3, 206797], [12, 207277], [15, 207397], [22, 208357], [25, 208517], [32, 208917], [35, 209077], [39, 209197], [42, 209297], [49, 209677], [52, 209797], [56, 209917]]}, {"verse": 35, "start": 211233, "end": 214527, "text": "Una vez he jurado por mi santidad, que no mentiré a David.", "words": [[0, 211233], [4, 211417], [8, 211657], [11, 211837], [18, 212197], [22, 212377], [25, 212517], [35, 213357], [39, 213457], [42, 213597], [50, 214117], [52, 214157]]}, {"verse": 36, "start": 215161, "end": 219672, "text": "Su descendencia será para siempre, y su trono como el sol delante de mí.", "words": [[0, 215161], [3, 215322], [16, 216122], [21, 216342], [26, 216622], [35, 217082], [37, 217582], [40, 217722], [46, 218142], [51, 218362], [54, 218502], [58, 218702], [66, 219162], [69, 219322]]}, {"verse": 37, "start": 220253, "end": 226728, "text": "Como la luna será firme para siempre, y como un testigo fiel en el cielo. (Selah.)", "words": [[0, 220253], [5, 220417], [8, 220557], [13, 220897], [18, 221117], [24, 221577], [29, 221757], [38, 222197], [40, 222677], [45, 222897], [48, 223037], [56, 223517], [61, 223877], [64, 224017], [67, 224137], [74, 226103]]}, {"verse": 38, "start": 227249, "end": 232056, "text": "Mas tú desechaste y menospreciaste a tu ungido; y te has airado con él.", "words": [[0, 227249], [4, 227449], [7, 227649], [18, 228389], [20, 228909], [35, 229429], [37, 229589], [40, 229689], [48, 230624], [50, 230728], [53, 230968], [57, 231208], [64, 231448], [68, 231688]]}, {"verse": 39, "start": 232406, "end": 237909, "text": "Rompiste el pacto de tu siervo; has profanado su corona hasta la tierra.", "words": [[0, 232732], [9, 233092], [12, 233252], [18, 233832], [21, 233952], [24, 234112], [32, 234996], [36, 235222], [46, 236122], [49, 236342], [56, 236742], [62, 237042], [65, 237222]]}, {"verse": 40, "start": 238259, "end": 242966, "text": "Rompiste todos sus vallados; has quebrantado sus fortalezas.", "words": [[0, 238259], [9, 238839], [15, 239159], [19, 239746], [29, 240491], [33, 240746], [45, 241504], [49, 242262]]}, {"verse": 41, "start": 243316, "end": 248945, "text": "Lo saquearon todos los que pasaron por el camino: es deshonra a sus vecinos.", "words": [[0, 243316], [3, 243636], [13, 244276], [19, 244556], [23, 244796], [27, 244956], [35, 245436], [39, 245606], [42, 245776], [50, 246636], [53, 246840], [62, 247740], [64, 247940], [68, 248080]]}, {"verse": 42, "start": 249295, "end": 255614, "text": "Has exaltado la diestra de sus enemigos; has alegrado a todos sus adversarios.", "words": [[0, 249435], [4, 249575], [13, 250575], [16, 250715], [24, 251155], [27, 251355], [31, 251495], [41, 252428], [45, 252768], [54, 253568], [56, 253788], [62, 254068], [66, 254388]]}, {"verse": 43, "start": 255964, "end": 261575, "text": "Embotaste asimismo el filo de su espada, y no lo levantaste en la batalla.", "words": [[0, 255964], [10, 256741], [19, 257561], [22, 257881], [27, 258321], [30, 258421], [33, 258561], [41, 259081], [43, 259501], [46, 259661], [49, 259801], [60, 260641], [63, 260781], [66, 260921]]}, {"verse": 44, "start": 261925, "end": 266357, "text": "Hiciste cesar su brillo, y echaste su trono por tierra.", "words": [[0, 261925], [8, 262530], [14, 263030], [17, 263190], [25, 264150], [27, 264290], [35, 264730], [38, 264970], [44, 265370], [48, 265590]]}, {"verse": 45, "start": 266707, "end": 272049, "text": "Has acortado los días de su juventud; lo has cubierto de afrenta. (Selah.)", "words": [[0, 266993], [4, 267319], [13, 267646], [17, 267806], [22, 268086], [25, 268266], [28, 268446], [38, 269483], [41, 269609], [45, 269809], [54, 270389], [57, 270569], [66, 271735]]}, {"verse": 46, "start": 272399, "end": 277814, "text": "¿Hasta cuándo, oh Jehová? ¿te esconderás para siempre? ¿arderá tu ira como el fuego?", "words": [[0, 272399], [7, 272623], [15, 272963], [18, 273303], [26, 274036], [30, 274177], [41, 274817], [46, 274977], [55, 275839], [63, 276405], [66, 276565], [70, 276845], [75, 277045], [78, 277185]]}, {"verse": 47, "start": 278164, "end": 284556, "text": "Acuérdate de cuán corto sea mi tiempo: ¿por qué habrás creado en vano a todos los hijos del hombre?", "words": [[0, 278164], [10, 278727], [13, 279027], [18, 279387], [24, 280007], [28, 280207], [31, 280467], [39, 281294], [44, 281401], [48, 281661], [55, 282041], [62, 282461], [65, 282601], [70, 282961], [72, 283041], [78, 283241], [82, 283481], [88, 283761], [92, 284001]]}, {"verse": 48, "start": 284906, "end": 291320, "text": "¿Qué hombre vivirá y no verá muerte? ¿librarás su vida del poder del sepulcro? (Selah.)", "words": [[0, 284906], [5, 285033], [12, 285373], [19, 285953], [21, 286033], [24, 286193], [29, 286433], [37, 287550], [47, 287840], [50, 288120], [55, 288420], [59, 288640], [65, 289200], [69, 289500], [79, 291005]]}, {"verse": 49, "start": 291670, "end": 297244, "text": "Señor, ¿dónde están tus antiguas misericordias, que juraste a David por tu verdad?", "words": [[0, 291670], [7, 292534], [14, 292814], [20, 293054], [24, 293274], [33, 293914], [48, 295254], [52, 295334], [60, 295814], [62, 295994], [68, 296234], [72, 296494], [75, 296674]]}, {"verse": 50, "start": 297594, "end": 304353, "text": "Señor, acuérdate de la deshonra de tus siervos; deshonra que llevo yo en mi seno de muchos pueblos.", "words": [[0, 297594], [7, 298334], [17, 298874], [20, 299114], [23, 299494], [32, 299874], [35, 300034], [39, 300214], [48, 301537], [57, 301827], [61, 301987], [67, 302327], [70, 302527], [73, 302687], [76, 302867], [81, 303227], [84, 303327], [91, 303547]]}, {"verse": 51, "start": 304703, "end": 312387, "text": "Porque tus enemigos, oh Jehová, han deshonrado, porque tus enemigos han deshonrado los pasos de tu ungido.", "words": [[0, 304703], [7, 304945], [11, 305185], [21, 305672], [24, 306158], [32, 306645], [36, 306865], [48, 308025], [55, 308605], [59, 308865], [68, 309505], [72, 309805], [83, 310685], [87, 310865], [93, 311405], [96, 311752], [99, 312100]]}, {"verse": 52, "start": 312737, "end": 316434, "text": "Bendito Jehová para siempre. Amén, y Amén.", "words": [[0, 312737], [8, 313364], [15, 313864], [20, 314024], [29, 315100], [35, 315537], [37, 315817]]}]}