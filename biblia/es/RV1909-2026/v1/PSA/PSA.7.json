{"book": "PSA", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 122347, "verses": [{"verse": 1, "start": 300, "end": 12956, "text": "Sigaión de David, que cantó a Jehová sobre las palabras de Cus, hijo de Benjamín. JEHOVÁ Dios mío, en ti he confiado: sálvame de todos los que me persiguen, y líbrame;", "words": [[0, 594], [8, 924], [11, 1064], [18, 1564], [22, 1664], [28, 2204], [30, 2324], [37, 2764], [43, 3024], [47, 3224], [56, 3604], [59, 3844], [64, 4724], [69, 4944], [72, 5124], [82, 6208], [89, 7006], [94, 7166], [99, 7846], [102, 7906], [105, 8146], [108, 8366], [118, 9548], [126, 10095], [129, 10275], [135, 10555], [139, 10815], [143, 10995], [146, 11135], [157, 11795], [159, 12275]]}, {"verse": 2, "start": 13406, "end": 18853, "text": "No sea que arrebate mi alma, cual león que despedaza, sin que haya quien libre.", "words": [[0, 13406], [3, 13534], [7, 13754], [11, 14114], [20, 14474], [23, 14714], [29, 15234], [34, 15334], [39, 15934], [43, 16094], [54, 17214], [58, 17474], [62, 17714], [67, 17934], [73, 18174]]}, {"verse": 3, "start": 19303, "end": 24401, "text": "Jehová Dios mío, si yo he hecho esto, si hay en mis manos iniquidad;", "words": [[0, 19520], [7, 19780], [12, 20040], [17, 20740], [20, 20900], [23, 21180], [26, 21300], [32, 21520], [38, 22220], [41, 22380], [45, 22580], [48, 22760], [52, 22900], [58, 23260]]}, {"verse": 4, "start": 24851, "end": 31176, "text": "Si di mal pago al pacífico conmigo, (hasta he libertado al que sin causa era mi enemigo;)", "words": [[0, 24851], [3, 25041], [6, 25201], [10, 25441], [15, 25901], [18, 26021], [27, 26661], [36, 27801], [43, 28141], [46, 28481], [56, 29041], [59, 29161], [63, 29281], [67, 29481], [73, 29841], [77, 30161], [80, 30381]]}, {"verse": 5, "start": 31626, "end": 40571, "text": "Persiga el enemigo mi alma, y la alcance; y pise en tierra mi vida, y mi honra ponga en el polvo. (Selah.)", "words": [[0, 31626], [8, 32171], [11, 32351], [19, 32831], [22, 33031], [28, 33411], [30, 33811], [33, 34211], [42, 35351], [44, 35455], [49, 35855], [52, 35995], [59, 36235], [62, 36515], [68, 36855], [70, 37435], [73, 37575], [79, 38075], [85, 38775], [88, 38855], [91, 38975], [98, 40233]]}, {"verse": 6, "start": 41021, "end": 50213, "text": "Levántate, oh Jehová, con tu furor; álzate a causa de las iras de mis angustiadores, y despierta en favor mío el juicio que mandaste.", "words": [[0, 41021], [11, 41442], [14, 41876], [22, 42309], [26, 42549], [29, 42709], [36, 43607], [43, 44252], [45, 44472], [51, 44832], [54, 45092], [58, 45312], [63, 45532], [66, 45672], [70, 45772], [85, 46632], [87, 47192], [97, 47792], [100, 47912], [106, 48132], [110, 48552], [113, 48672], [120, 49132], [124, 49332]]}, {"verse": 7, "start": 50663, "end": 56810, "text": "Y te rodeará congregación de pueblos; por cuyo amor vuélvete luego a levantar en alto.", "words": [[0, 50663], [2, 50885], [5, 51025], [13, 51585], [26, 52505], [29, 52705], [38, 53712], [42, 53849], [47, 54209], [52, 54489], [61, 55149], [67, 55429], [69, 55609], [78, 56129], [81, 56249]]}, {"verse": 8, "start": 57260, "end": 63678, "text": "Jehová juzgará los pueblos: júzgame, oh Jehová, conforme a mi justicia y conforme a mi integridad.", "words": [[0, 57592], [7, 57952], [15, 58312], [19, 58452], [28, 59370], [37, 59823], [40, 60283], [48, 60743], [57, 61323], [59, 61383], [62, 61443], [71, 62063], [73, 62163], [82, 62703], [84, 62783], [87, 62883]]}, {"verse": 9, "start": 64128, "end": 72412, "text": "Acábese ahora la malicia de los inicuos, y establece al justo; pues el Dios justo prueba los corazones y los riñones.", "words": [[0, 64450], [8, 64810], [14, 65030], [17, 65210], [25, 65670], [28, 65830], [32, 65950], [41, 66710], [43, 67030], [53, 67410], [56, 67790], [63, 68657], [68, 68801], [71, 68961], [76, 69141], [82, 69521], [89, 69861], [93, 70121], [103, 70841], [105, 70981], [109, 71161]]}, {"verse": 10, "start": 72862, "end": 76059, "text": "Mi escudo está en