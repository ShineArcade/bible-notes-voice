{"book": "JHN", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 299221, "verses": [{"verse": 1, "start": 300, "end": 5202, "text": "Y pasando Jesús, vio un hombre ciego desde su nacimiento.", "words": [[0, 300], [2, 404], [10, 764], [17, 2044], [21, 2504], [24, 2684], [31, 2924], [37, 3504], [43, 3764], [46, 4104]]}, {"verse": 2, "start": 5552, "end": 12550, "text": "Y le preguntaron sus discípulos, diciendo: Rabí, ¿quién pecó, este o sus padres, para que naciese ciego?", "words": [[0, 5552], [2, 5677], [5, 5817], [17, 6717], [21, 6997], [33, 8077], [43, 9088], [49, 9390], [56, 9590], [62, 9970], [67, 10250], [69, 10370], [73, 10530], [81, 11170], [86, 11390], [90, 11690], [98, 11990]]}, {"verse": 3, "start": 12830, "end": 19614, "text": "Respondió Jesús: Ni este pecó, ni sus padres: pero para que las obras de Dios se manifiesten en él.", "words": [[0, 12830], [10, 13334], [17, 14276], [20, 14576], [25, 14966], [31, 15356], [34, 15613], [38, 15869], [46, 16806], [51, 17007], [56, 17227], [60, 17367], [64, 17527], [70, 17827], [73, 18007], [78, 18247], [81, 18447], [93, 19107], [96, 19247]]}, {"verse": 4, "start": 19964, "end": 27245, "text": "Debo realizar las obras del que me envió, entre tanto que el día dura: la noche viene, cuando nadie puede obrar.", "words": [[0, 19964], [5, 20268], [14, 20748], [18, 21048], [24, 21328], [28, 21528], [32, 21688], [35, 21848], [42, 22608], [48, 23008], [54, 23388], [58, 23608], [61, 23808], [65, 23988], [71, 24767], [74, 24884], [80, 25104], [87, 25464], [94, 25704], [100, 26184], [106, 26504]]}, {"verse": 5, "start": 27595, "end": 30886, "text": "Entre tanto que estoy en el mundo, luz soy del mundo.", "words": [[0, 27595], [6, 27817], [12, 28197], [16, 28417], [22, 28697], [25, 28937], [28, 29057], [35, 29347], [39, 29637], [43, 29977], [47, 30197]]}, {"verse": 6, "start": 31236, "end": 38489, "text": "Esto dicho, escupió en tierra, e hizo lodo con la saliva, y untó con el lodo sobre los ojos del ciego,", "words": [[0, 31236], [5, 31624], [12, 32164], [20, 32664], [23, 32844], [31, 33224], [33, 33589], [38, 33929], [43, 34329], [47, 34589], [50, 34749], [58, 35209], [60, 35829], [65, 36169], [69, 36369], [72, 36529], [77, 36949], [83, 37229], [87, 37469], [92, 37789], [96, 38069]]}, {"verse": 7, "start": 38839, "end": 48365, "text": "Y le dijo: Ve, lávate en el estanque de Siloé (que traducido significa Enviado). Y fue entonces, y se lavó, y volvió viendo.", "words": [[0, 38919], [2, 39039], [5, 39119], [11, 40193], [15, 40193], [22, 40719], [25, 40959], [28, 41079], [37, 41599], [40, 41759], [46, 42585], [51, 42669], [61, 43349], [71, 43889], [81, 44949], [83, 45076], [87, 45236], [97, 45896], [99, 46456], [102, 46596], [108, 47256], [110, 47416], [117, 48136]]}, {"verse": 8, "start": 48715, "end": 56185, "text": "Entonces los vecinos, y los que antes le habían visto que era ciego, decían: ¿No es este el que se sentaba y mendigaba?", "words": [[0, 48715], [9, 49163], [13, 49443], [22, 49963], [24, 50123], [28, 50243], [32, 50403], [38, 50643], [41, 50883], [48, 51123], [54, 51403], [58, 51623], [62, 51763], [69, 52243], [77, 53529], [81, 53688], [84, 53868], [89, 54248], [92, 54388], [96, 54508], [99, 54628], [107, 55168], [109, 55448]]}, {"verse": 9, "start": 56465, "end": 62850, "text": "Unos decían: Este es; y otros: A él se parece. Él decía: Yo soy.", "words": [[0, 56550], [5, 56670], [13, 57930], [18, 58206], [22, 58763], [24, 58900], [31, 59747], [33, 59911], [36, 60111], [39, 60311], [47, 61221], [50, 61392], [57, 62199], [60, 62420]]}, {"verse": 10, "start": 63130, "end": 66269, "text": "Y le dijeron: ¿Cómo te fueron abiertos los ojos?", "words": [[0, 63130], [2, 63277], [5, 63357], [14, 64320], [20, 64477], [23, 64657], [30, 64937], [39, 65517], [43, 65657]]}, {"verse": 11, "start": 66549, "end": 78186, "text": "Respondió él y dijo: El hombre que se llama Jesús, hizo lodo, y me untó los ojos, y me dijo: Ve al Siloé, y lávate: y fui, y me lavé, y recibí la vista.", "words": [[0, 66549], [10, 67233], [13, 67553], [15, 67793], [21, 68582], [24, 68722], [31, 69002], [35, 69202], [38, 69362], [44, 69622], [51, 70162], [56, 70702], [62, 71242], [64, 71522], [67, 71622], [72, 71882], [76, 72082], [82, 72322], [84, 72542], [87, 72662], [93, 73337], [96, 73495], [99, 73695], [106, 74115], [108, 74355], [116, 75133], [118, 75256], [123, 75476], [125, 75756], [128, 75856], [134, 76176], [136, 76376], [143, 76796], [146, 76876]]}, {"verse": 12, "start": 78466, "end": 83380, "text": "Entonces le dijeron: ¿Dónde está aquel? Él dijo: No sé.", "words": [[0, 78466], [9, 78914], [12, 79174], [21, 80076], [28, 80339], [33, 80599], [40, 81959], [43, 82168], [49, 82869], [52, 83028]]}, {"verse": 13, "start": 83660, "end": 87415, "text": "Llevaron a los fariseos al que antes había sido ciego.", "words": [[0, 83660], [9, 84208], [11, 84508], [15, 84668], [24, 85118], [27, 85568], [31, 85748], [37, 85988], [43, 86328], [48, 86668]]}, {"verse": 14, "start": 87765, "end": 93201, "text": "Y era sábado cuando Jesús había hecho el lodo, y le había abierto los ojos.", "words": [[0, 87765], [2, 88063], [6, 88243], [13, 88783], [20, 89043], [26, 89443], [32, 89963], [38, 90343], [41, 90543], [47, 90983], [49, 91443], [52, 91543], [58, 91803], [66, 92243], [70, 92483]]}, {"verse": 15, "start": 93551, "end": 104548, "text": "Y le volvieron a preguntar también los fariseos de qué manera había recibido la vista. Y él les dijo: Me puso lodo sobre los ojos, y me lavé, y veo.", "words": [[0, 93551], [2, 93693], [5, 93793], [15, 94353], [17, 94453], [27, 95133], [35, 95493], [39, 96033], [48, 96853], [51, 97033], [55, 97293], [62, 97673], [68, 98233], [77, 98933], [80, 99073], [87, 99912], [89, 100263], [92, 100423], [96, 100643], [102, 101486], [105, 101603], [110, 101943], [115, 102243], [121, 102523], [125, 102723], [131, 103083], [133, 103383], [136, 103503], [142, 103863], [144, 104143]]}, {"verse": 16, "start": 104828, "end": 117496, "text": "Entonces unos de los fariseos decían: Este hombre no es de Dios, que no guarda el sábado. Otros decían: ¿Cómo puede un hombre pecador hacer estas señales? Y había división entre ellos.", "words": [[0, 104828], [9, 105329], [14, 105867], [17, 106007], [21, 106127], [30, 106747], [38, 107772], [43, 108013], [50, 108313], [53, 108553], [56, 108693], [59, 108813], [65, 109453], [69, 109533], [72, 109693], [79, 110133], [82, 110173], [90, 110994], [96, 111365], [104, 112593], [110, 112772], [116, 113132], [119, 113292], [126, 113512], [134, 114032], [140, 114292], [146, 114532], [155, 115542], [157, 115707], [163, 115907], [172, 116507], [178, 116747]]}, {"verse": 17, "start": 117846, "end": 124027, "text": "Vuelven a decir al ciego: ¿Tú, qué dices del que te abrió los ojos? Y él dijo: Que es profeta.", "words": [[0, 117846], [8, 118312], [10, 118412], [16, 118692], [19, 118912], [26, 119743], [31, 119863], [35, 119963], [41, 120283], [45, 120443], [49, 120603], [52, 120723], [58, 120983], [62, 121143], [68, 121983], [70, 122171], [73, 122331], [79, 123050], [83, 123171], [86, 123331]]}, {"verse": 18, "start": 124307, "end": 134219, "text": "Pero los judíos no creían de él, que había sido ciego, y hubiese recibido la vista, hasta que llamaron a los padres del que había recibido la vista;", "words": [[0, 124307], [5, 124452], [9, 124652], [16, 125212], [19, 125612], [26, 126172], [29, 126412], [33, 127092], [37, 127332], [43, 127512], [48, 127852], [55, 128392], [57, 128772], [65, 129052], [74, 129692], [77, 129812], [84, 130452], [90, 130772], [94, 130912], [103, 131352], [105, 131492], [109, 131612], [116, 132072], [120, 132492], [124, 132672], [130, 132892], [139, 133512], [142, 133632]]}, {"verse": 19, "start": 134569, "end": 142217, "text": "Y les preguntaron, diciendo: ¿Es este vuestro hijo, el que vosotros decís que nació ciego? ¿Cómo, pues, ve ahora?", "words": [[0, 134569], [2, 134801], [6, 134901], [19, 135681], [29, 137090], [33, 137267], [38, 137527], [46, 137907], [52, 138587], [55, 138667], [59, 138787], [68, 139207], [74, 139747], [78, 139907], [84, 140227], [91, 141066], [98, 141226], [104, 141706], [107, 141766]]}, {"verse": 20, "start": 142497, "end": 148361, "text": "Les respondieron sus padres y dijeron: Sabemos que este es nuestro hijo, y que nació ciego:", "words": [[0, 142497], [4, 142795], [17, 143735], [21, 143915], [28, 144315], [30, 144595], [39, 145519], [47, 145924], [51, 146164], [56, 146364], [59, 146504], [67, 146644], [73, 147144], [75, 147444], [79, 147544], [85, 147844]]}, {"verse": 21, "start": 148711, "end": 161574, "text": "Pero cómo vea ahora, no sabemos; o quién le haya abierto los ojos, nosotros no lo sabemos; él ya es adulto, preguntadle a él; él hablará de sí.", "words": [[0, 148711], [5, 148838], [10, 149098], [14, 149438], [21, 149758], [24, 149838], [33, 150712], [35, 150812], [41, 151012], [44, 151212], [49, 151372], [57, 151772], [61, 151952], [67, 152592], [76, 152992], [79, 153192], [82, 153292], [91, 154149], [94, 154311], [97, 154491], [100, 154631], [108, 155151], [120, 155671], [122, 155811], [126, 156266], [129, 156424], [137, 156784], [140, 156904]]}, {"verse": 22, "start": 161854, "end": 174587, "text": "Esto dijeron sus padres, porque tenían miedo de los judíos: porque ya los judíos habían resuelto que si alguno confesase ser él el Mesías, fuese expulsado de la sinagoga.", "words": [[0, 161854], [5, 162180], [13, 162800], [17, 162940], [25, 163980], [32, 164360], [39, 164800], [45, 165440], [48, 165660], [52, 165820], [60, 166899], [67, 167082], [70, 167342], [74, 167502], [81, 168082], [88, 168322], [97, 169002], [101, 169142], [104, 169282], [111, 169762], [121, 170482], [125, 170842], [128, 171182], [131, 171382], [139, 171962], [145, 172712], [155, 173462], [158, 173642], [161, 173742]]}, {"verse": 23, "start": 174937, "end": 178625, "text": "Por eso dijeron sus padres: Ya es adulto, preguntadle a él.", "words": [[0, 174937], [4, 175043], [8, 175223], [16, 175763], [20, 175903], [28, 176909], [31, 177071], [34, 177231], [42, 177741], [54, 178251], [56, 178371]]}, {"verse": 24, "start": 178905, "end": 187719, "text": "Así que, volvieron a llamar al hombre que había sido ciego, y le dijeron: Da gloria a Dios: nosotros sabemos que este hombre es pecador.", "words": [[0, 178905], [4, 179145], [9, 179385], [19, 179985], [21, 180125], [28, 180505], [31, 180625], [38, 180885], [42, 181085], [48, 181325], [53, 181645], [60, 182245], [62, 182805], [65, 182945], [74, 183920], [77, 184116], [84, 184536], [86, 184696], [92, 185430], [101, 185835], [109, 186135], [113, 186455], [118, 186675], [125, 186935], [128, 187155]]}, {"verse": 25, "start": 187999, "end": 196677, "text": "Entonces él respondió, y dijo: Si es pecador, no lo sé: una cosa sé, que habiendo yo sido ciego, ahora veo.", "words": [[0, 187999], [9, 188963], [12, 189383], [23, 190403], [25, 190663], [31, 191432], [34, 191608], [37, 191848], [46, 192328], [49, 192448], [52, 192568], [56, 193174], [60, 193360], [65, 193660], [69, 194420], [73, 194500], [82, 194860], [85, 195060], [90, 195280], [97, 196060], [103, 196200]]}, {"verse": 26, "start": 196957, "end": 200721, "text": "Y le volvieron a decir: ¿Qué te hizo? ¿Cómo te abrió los ojos?", "words": [[0, 196957], [2, 197083], [5, 197183], [15, 197723], [17, 197843], [24, 198595], [29, 198696], [32, 198836], [38, 199479], [44, 199621], [47, 199781], [53, 200001], [57, 200141]]}, {"verse": 27, "start": 201001, "end": 208930, "text": "Les respondió: Ya os lo he dicho, y no habéis atendido: ¿por qué lo queréis otra vez oír? ¿queréis también vosotros haceros sus discípulos?", "words": [[0, 201001], [4, 201154], [15, 202198], [18, 202416], [21, 202556], [24, 202696], [27, 202796], [34, 203056], [36, 203416], [39, 203556], [46, 203796], [56, 204594], [61, 204711], [65, 204871], [68, 205011], [76, 205311], [81, 205531], [85, 205791], [90, 206442], [99, 206764], [107, 206984], [116, 207544], [124, 208004], [128, 208124]]}, {"verse": 28, "start": 209210, "end": 215725, "text": "Y le ultrajaron, y dijeron: Tú eres su discípulo; pero nosotros discípulos de Moisés somos.", "words": [[0, 209210], [2, 209392], [5, 209962], [17, 210532], [19, 210867], [28, 211801], [31, 211928], [36, 212108], [39, 212348], [50, 213343], [55, 213484], [64, 213824], [75, 214544], [78, 214704], [85, 215064]]}, {"verse": 29, "start": 216075, "end": 220575, "text": "Nosotros sabemos que a Moisés habló Dios: pero este no sabemos de dónde es.", "words": [[0, 216075], [9, 216522], [17, 216882], [21, 217162], [23, 217262], [30, 217582], [36, 218062], [42, 218735], [47, 218875], [52, 219155], [55, 219355], [63, 219695], [66, 219995], [72, 220175]]}, {"verse": 30, "start": 220855, "end": 229444, "text": "Respondió aquel hombre, y les dijo: Por cierto, maravillosa cosa es esta, que vosotros no sabéis de dónde sea, y a mí me abrió los ojos.", "words": [[0, 220855], [10, 221579], [16, 221779], [24, 222039], [26, 222339], [30, 222499], [36, 223288], [40, 223394], [48, 223914], [60, 224474], [65, 224674], [68, 225034], [74, 225774], [78, 225854], [87, 226274], [90, 226474], [97, 226854], [100, 226994], [106, 227154], [111, 228094], [113, 228194], [115, 228254], [118, 228374], [121, 228514], [127, 228854], [131, 229014]]}, {"verse": 31, "start": 229794, "end": 236398, "text": "Y sabemos que Dios no oye a los pecadores: pero si alguno es temeroso de Dios, y hace su voluntad, a este oye.", "words": [[0, 229794], [2, 229878], [10, 230138], [14, 230438], [19, 230698], [22, 231078], [26, 231338], [28, 231418], [32, 231518], [43, 232458], [48, 232624], [51, 232804], [58, 233264], [61, 233444], [70, 233884], [73, 234064], [79, 234304], [81, 234624], [86, 234824], [89, 235004], [99, 235584], [101, 235684], [106, 235924]]}, {"verse": 32, "start": 236748, "end": 241980, "text": "Desde el principio del mundo no fue oído, que abriese alguno los ojos de uno que nació ciego.", "words": [[0, 236748], [6, 236932], [9, 237132], [19, 237572], [23, 237792], [29, 238052], [32, 238252], [36, 238492], [42, 239152], [46, 239352], [54, 239702], [61, 240052], [65, 240232], [70, 240512], [73, 240752], [77, 240952], [81, 241112], [87, 241452]]}, {"verse": 33, "start": 242330, "end": 245532, "text": "Si este no fuera de Dios, no pudiera hacer nada.", "words": [[0, 242330], [3, 242463], [8, 242783], [11, 242983], [17, 243223], [20, 243403], [26, 244103], [29, 244383], [37, 244783], [43, 245043]]}, {"verse": 34, "start": 245812, "end": 252959, "text": "Respondieron, y le dijeron: Tú naciste enteramente en pecado, ¿y tú nos enseñas? Y le echaron fuera.", "words": [[0, 245812], [14, 246616], [16, 247036], [19, 247156], [28, 248037], [31, 248139], [39, 248599], [51, 249179], [54, 249359], [62, 249799], [65, 250179], [68, 250319], [72, 250479], [81, 251525], [83, 251673], [86, 251813], [94, 252293]]}, {"verse": 35, "start": 253309, "end": 259892, "text": "Oyó Jesús que le habían echado fuera; y hallándole, le dijo: ¿Crees tú en el Hijo de Dios?", "words": [[0, 253469], [4, 253659], [10, 254331], [14, 254404], [17, 254544], [24, 254824], [31, 255224], [38, 256152], [40, 256270], [52, 256810], [55, 256930], [61, 257939], [68, 258224], [71, 258524], [74, 258824], [77, 258944], [82, 259164], [85, 259364]]}, {"verse": 36, "start": 260242, "end": 264227, "text": "Respondió él, y dijo: ¿Quién es, Señor, para que crea en él?", "words": [[0, 260242], [10, 260866], [14, 261246], [16, 261526], [22, 262315], [29, 262452], [33, 262572], [40, 262932], [45, 263352], [49, 263492], [54, 263832], [57, 263972]]}, {"verse": 37, "start": 264507, "end": 269615, "text": "Y le dijo Jesús: Y le has visto, y el que habla contigo, él es.", "words": [[0, 264507], [2, 264634], [5, 264734], [10, 265014], [17, 266044], [19, 266184], [22, 266264], [26, 266444], [33, 266844], [35, 267139], [38, 267279], [42, 267459], [48, 267739], [57, 268679], [60, 269039]]}, {"verse": 38, "start": 269965, "end": 273096, "text": "Y él dice: Creo, Señor; y le adoró.", "words": [[0, 269965], [2, 270161], [5, 270321], [11, 271015], [17, 271312], [24, 272135], [26, 272316], [29, 272436]]}, {"verse": 39, "start": 273446, "end": 281870, "text": "Y dijo Jesús: Yo, para juicio he venido a este mundo: para que los que no ven, vean; y los que ven, sean cegados.", "words": [[0, 273446], [2, 273705], [7, 273925], [14, 274803], [18, 275010], [23, 275270], [30, 275830], [33, 276070], [40, 276470], [42, 276570], [47, 276750], [54, 277559], [59, 277724], [63, 277864], [67, 278004], [71, 278144], [74, 278304], [79, 278544], [85, 279726], [87, 279805], [91, 279925], [95, 280105], [100, 280345], [105, 280885]]}, {"verse": 40, "start": 282220, "end": 289323, "text": "Y ciertos de los fariseos que estaban con él oyeron esto, y le dijeron: ¿Somos nosotros también ciegos?", "words": [[0, 282220], [2, 282383], [10, 282943], [13, 283043], [17, 283163], [26, 283983], [30, 284143], [38, 284443], [42, 284763], [45, 284963], [52, 285683], [58, 286143], [60, 286483], [63, 286623], [72, 287501], [79, 287906], [88, 288246], [96, 288586]]}, {"verse": 41, "start": 289603, "end": 298821, "text": "Jesús les respondió: Si fuerais ciegos, no tuvierais pecado: pero ahora porque decís, Vemos, por tanto vuestro pecado permanece.", "words": [[0, 289603], [6, 289911], [10, 290231], [21, 291307], [24, 291448], [32, 291888], [40, 292768], [43, 292968], [53, 293488], [61, 294398], [66, 294543], [72, 294843], [79, 295163], [86, 296003], [93, 296283], [97, 296763], [103, 297043], [111, 297483], [118, 297923]]}]}