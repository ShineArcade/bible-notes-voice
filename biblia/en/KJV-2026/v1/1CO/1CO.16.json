{"book": "1CO", "chapter": 16, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 133727, "verses": [{"verse": 1, "start": 300, "end": 6010, "text": "Now concerning the collection for the saints, as I have given order to the churches of Galatia, even so do you.", "words": [[0, 300], [4, 518], [15, 918], [19, 1118], [30, 1498], [34, 1738], [38, 1898], [46, 2578], [49, 2718], [51, 2878], [56, 3038], [62, 3238], [68, 3598], [71, 3798], [75, 3938], [84, 4218], [87, 4438], [96, 5158], [101, 5318], [104, 5538], [107, 5698]]}, {"verse": 2, "start": 6460, "end": 13119, "text": "Upon the first day of the week let every one of you lay by him in store, as God has prospered him, that there be no gatherings when I come.", "words": [[0, 6460], [5, 6640], [9, 6840], [15, 7080], [19, 7300], [22, 7380], [26, 7500], [31, 7820], [35, 7920], [41, 8140], [45, 8360], [48, 8460], [52, 8600], [56, 8740], [59, 8940], [63, 9140], [66, 9260], [73, 9820], [76, 9960], [80, 10160], [84, 10380], [94, 10940], [99, 11260], [104, 11340], [110, 11500], [113, 11640], [116, 11860], [127, 12300], [132, 12600], [134, 12720]]}, {"verse": 3, "start": 13569, "end": 20009, "text": "And when I come, whomsoever you shall approve by your letters, them will I send to bring your liberality to Jerusalem.", "words": [[0, 13569], [4, 13741], [9, 13901], [11, 14061], [17, 14671], [28, 15281], [32, 15481], [38, 15701], [46, 16041], [49, 16241], [54, 16361], [63, 16811], [68, 17261], [73, 17461], [75, 17581], [80, 17841], [83, 18041], [89, 18261], [94, 18441], [105, 19141], [108, 19361]]}, {"verse": 4, "start": 20459, "end": 23184, "text": "And if it be meet that I go also, they shall go with me.", "words": [[0, 20459], [4, 20595], [7, 20715], [10, 20855], [13, 20995], [18, 21135], [23, 21335], [25, 21455], [28, 21655], [34, 22255], [39, 22375], [45, 22555], [48, 22735], [53, 22915]]}, {"verse": 5, "start": 23634, "end": 28345, "text": "Now I will come to you, when I shall pass through Macedonia: for I do pass through Macedonia.", "words": [[0, 23634], [4, 23911], [6, 24131], [11, 24251], [16, 24471], [19, 24651], [24, 24811], [29, 25211], [31, 25351], [37, 25471], [42, 25691], [50, 25911], [61, 26869], [65, 26983], [67, 27123], [70, 27263], [75, 27463], [83, 27663]]}, {"verse": 6, "start": 28795, "end": 35096, "text": "And it may be that I will abide, yes, and winter with you, that you may bring me on my journey wherever I go.", "words": [[0, 28795], [4, 28937], [7, 29057], [11, 29257], [14, 29537], [19, 29837], [21, 29977], [26, 30137], [33, 30677], [38, 31257], [42, 31357], [49, 31637], [54, 31937], [59, 32217], [64, 32757], [68, 32897], [72, 33037], [78, 33337], [81, 33537], [84, 33657], [87, 33797], [95, 34097], [104, 34417], [106, 34697]]}, {"verse": 7, "start": 35546, "end": 40174, "text": "For I will not see you now by the way; but I trust to stay a while with you, if the Lord permit.", "words": [[0, 35546], [4, 35652], [6, 35772], [11, 35892], [15, 36092], [19, 36352], [23, 36432], [27, 36672], [30, 36872], [34, 36992], [39, 37575], [43, 37730], [45, 37830], [51, 38070], [54, 38290], [59, 38510], [61, 38670], [67, 38850], [72, 39090], [77, 39230], [80, 39430], [84, 39550], [89, 39885]]}, {"verse": 8, "start": 40624, "end": 43114, "text": "But I will stay at Ephesus until Pentecost.", "words": [[0, 40624], [4, 40721], [6, 40821], [11, 40981], [16, 41221], [19, 41401], [27, 41761], [33, 42201]]}, {"verse": 9, "start": 43564, "end": 48254, "text": "For a great door and effectual is opened to me, and there are many adversaries.", "words": [[0, 43564], [4, 43687], [6, 43807], [12, 44007], [17, 44327], [21, 44607], [31, 45087], [34, 45347], [41, 45607], [44, 45847], [48, 46067], [52, 46687], [58, 46847], [62, 46967], [67, 47267]]}, {"verse": 10, "start": 48704, "end": 55602, "text": "Now if Timotheus come, see that he may be with you without fear: for he works the work of the Lord, as I also do.", "words": [[0, 48704], [4, 48866], [7, 49236], [1