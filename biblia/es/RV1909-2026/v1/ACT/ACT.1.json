{"book": "ACT", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 243237, "verses": [{"verse": 1, "start": 300, "end": 8070, "text": "En el primer tratado, oh Teófilo, he hablado de todas las cosas que Jesús comenzó a hacer y a enseñar,", "words": [[0, 300], [3, 444], [6, 564], [13, 904], [22, 1434], [25, 1964], [34, 2624], [37, 3304], [45, 3744], [48, 3884], [54, 4184], [58, 4504], [64, 4924], [68, 5404], [74, 5744], [82, 6444], [84, 6544], [90, 6904], [92, 7164], [94, 7264]]}, {"verse": 2, "start": 8520, "end": 17426, "text": "Hasta el día en que, habiendo dado mandamientos por el Espíritu Santo a los apóstoles que escogió, fue recibido arriba;", "words": [[0, 8520], [6, 8785], [9, 8965], [13, 9245], [16, 9605], [21, 10385], [30, 10865], [35, 11125], [48, 11905], [52, 12185], [55, 12305], [64, 12865], [70, 13205], [72, 13465], [76, 13585], [86, 14225], [90, 14445], [99, 15665], [103, 15805], [112, 16605]]}, {"verse": 3, "start": 17876, "end": 28470, "text": "A los cuales, después de haber padecido, se presentó vivo con muchas pruebas indudables, apareciéndoles por cuarenta días, y hablándoles del reino de Dios.", "words": [[0, 17876], [2, 18066], [6, 18166], [14, 18466], [22, 18886], [25, 19006], [31, 19166], [41, 20306], [44, 20406], [53, 21026], [58, 21266], [62, 21566], [69, 21966], [77, 22486], [89, 23646], [104, 24546], [108, 24876], [117, 25206], [123, 25766], [125, 26366], [137, 27046], [141, 27286], [147, 27706], [150, 27866]]}, {"verse": 4, "start": 28920, "end": 39387, "text": "Y estando juntos, les mandó que no se fuesen de Jerusalén, sino que esperasen la promesa del Padre, que oísteis, dijo, de mí.", "words": [[0, 28920], [2, 29038], [10, 29478], [18, 30048], [22, 30618], [28, 31058], [32, 31218], [35, 31378], [38, 31648], [45, 31918], [48, 32118], [59, 33238], [64, 33598], [68, 33838], [78, 34538], [81, 34698], [89, 35198], [93, 35418], [100, 36538], [104, 36680], [113, 37945], [119, 38830], [122, 39056]]}, {"verse": 5, "start": 39837, "end": 47968, "text": "Porque Juan a la verdad bautizó con agua, pero vosotros seréis bautizados con el Espíritu Santo no muchos días después de estos.", "words": [[0, 39837], [7, 40041], [12, 40421], [14, 40681], [17, 40801], [24, 41161], [32, 41901], [36, 42121], [42, 42581], [47, 42741], [56, 43241], [63, 43641], [74, 44421], [78, 44661], [81, 44821], [90, 45581], [96, 45861], [99, 46181], [106, 46441], [111, 46821], [119, 47141], [122, 47381]]}, {"verse": 6, "start": 48418, "end": 56642, "text": "Entonces los que se habían reunido le preguntaron, diciendo: Señor, ¿restituirás el reino a Israel en este tiempo?", "words": [[0, 48418], [9, 49067], [13, 49847], [17, 49967], [20, 50107], [27, 50347], [35, 51007], [38, 51127], [51, 51827], [61, 52873], [68, 53612], [81, 54312], [84, 54452], [90, 54592], [92, 54732], [99, 55092], [102, 55272], [107, 55452]]}, {"verse": 7, "start": 56992, "end": 64347, "text": "Y les dijo: No toca a vosotros saber los tiempos o los períodos que el Padre puso en su sola potestad;", "words": [[0, 56992], [2, 57156], [6, 57276], [12, 58094], [15, 58240], [20, 58540], [22, 58780], [31, 59300], [37, 59780], [41, 60040], [49, 60640], [51, 60740], [55, 60860], [64, 61400], [68, 61520], [71, 61680], [77, 62160], [82, 62740], [85, 62980], [88, 63220], [93, 63811]]}, {"verse": 8, "start": 64797, "end": 76749, "text": "Pero recibiréis el poder del Espíritu Santo que vendrá sobre vosotros; y me seréis testigos en Jerusalén, y en toda Judea, y Samaria, y hasta lo último de la tierra.", "words": [[0, 64797], [5, 65197], [16, 65997], [19, 66177], [25, 66477], [29, 66737], [38, 67257], [44, 67517], [48, 67777], [55, 68177], [61, 68457], [71, 69600], [73, 69706], [76, 69806], [83, 70206], [92, 70786], [95, 71026], [106, 71826], [108, 72346], [111, 72506], [116, 72746], [123, 73606], [125, 73846], [134, 74366], [136, 74926], [142, 75096], [145, 75266], [152, 75626], [155, 75906], [158, 76046]]}, {"verse": 9, "start": 77199, "end": 84874, "text": "Y habiendo dicho estas cosas, viéndolo ellos, fue alzado; y una nube le recibió y le quitó de sus ojos.", "words": [[0, 77199], [2, 77323], [11, 77663], [17, 78003], [23, 78243], [30, 79203], [39, 79763], [46, 80043], [50, 80383], [58, 81541], [60, 81702], [64, 81902], [69, 82322], [72, 82482], [80, 83242], [82, 83502], [85, 83602], [91, 83942], [94, 84062], [98, 84202]]}, {"verse": 10, "start": 85324, "end": 93418, "text": "Y estando con los ojos puestos en el cielo, entre tanto que él iba, he aquí dos varones se pusieron junto a ellos en vestidos blancos;", "words": [[0, 85324], [2, 85470], [10, 85890], [14, 86070], [18, 86230], [23, 86490], [31, 87070], [34, 87230], [37, 87370], [44, 87790], [50, 87970], [56, 88370], [60, 88650], [63, 88830], [68, 89710], [71, 89790], [76, 90190], [80, 90290], [88, 90890], [91, 90970], [100, 91370], [106, 91630], [108, 91850], [114, 92030], [117, 92270], [126, 92670]]}, {"verse": 11, "start": 93868, "end": 105166, "text": "Los cuales también les dijeron: Varones galileos, ¿qué estáis mirando al cielo? este mismo Jesús que ha sido tomado desde vosotros arriba en el cielo, así vendrá como le habéis visto ir al cielo.", "words": [[0, 93868], [4, 93979], [11, 94199], [19, 94499], [23, 94759], [32, 95832], [40, 95992], [50, 96952], [55, 97032], [62, 97392], [70, 97772], [73, 97912], [80, 98769], [85, 99053], [91, 99333], [97, 99693], [101, 99953], [104, 100073], [109, 100253], [116, 100693], [122, 100873], [131, 101453], [138, 101773], [141, 101953], [144, 102053], [151, 102873], [155, 103073], [162, 103453], [167, 103653], [170, 103813], [177, 104033], [183, 104353], [186, 104513], [189, 104653]]}, {"verse": 12, "start": 105516, "end": 113424, "text": "Entonces se volvieron a Jerusalén del monte que se llama del Olivar, el cual está cerca de Jerusalén camino de un sábado.", "words": [[0, 105516], [9, 105959], [12, 106259], [22, 106799], [24, 106919], [34, 107499], [38, 107779], [44, 108059], [48, 108219], [51, 108339], [57, 108659], [61, 108859], [69, 110259], [72, 110359], [77, 110559], [82, 110839], [88, 111199], [91, 111419], [101, 112039], [108, 112319], [111, 112639], [114, 112759]]}, {"verse": 13, "start": 113874, "end": 128952, "text": "Y entrados, subieron al aposento alto, donde moraban Pedro y Jacobo, y Juan y Andrés, Felipe y Tomás, Bartolomé y Mateo, Jacobo hijo de Alfeo, y Simón Zelote, y Judas hermano de Jacobo.", "words": [[0, 113874], [2, 114012], [12, 114712], [21, 115472], [24, 115652], [33, 116152], [39, 116692], [45, 117472], [53, 118072], [59, 118532], [61, 118732], [69, 119432], [71, 119612], [76, 119972], [78, 120292], [86, 121112], [93, 121452], [95, 121732], [102, 122452], [112, 123112], [114, 123312], [121, 124112], [128, 124692], [133, 124892], [136, 125092], [143, 125592], [145, 125732], [151, 126308], [159, 127185], [161, 127330], [167, 127610], [175, 128190], [178, 128270]]}, {"verse": 14, "start": 129402, "end": 138241, "text": "Todos estos perseveraban unánimes en oración y ruego, con las mujeres, y con María la madre de Jesús, y con sus hermanos.", "words": [[0, 129402], [6, 129626], [12, 129946], [25, 130966], [34, 131766], [37, 131986], [45, 132486], [47, 132626], [54, 133106], [58, 133706], [62, 133886], [71, 134346], [73, 134986], [77, 135146], [83, 135646], [86, 135726], [92, 135986], [95, 136166], [102, 136546], [104, 137106], [108, 137326], [112, 137486]]}, {"verse": 15, "start": 138691, "end": 148236, "text": "Y en aquellos días, Pedro, levantándose en medio de los hermanos, dijo (y estaba reunido un grupo de unas ciento veinte personas):", "words": [[0, 138691], [2, 138819], [5, 138919], [14, 139179], [20, 139699], [27, 140719], [40, 141659], [43, 141859], [49, 142139], [52, 142339], [56, 142479], [66, 143339], [71, 144219], [74, 144319], [81, 144799], [89, 145279], [92, 145459], [98, 145759], [101, 146059], [106, 146426], [113, 146792], [120, 147159]]}, {"verse": 16, "start": 148486, "end": 157743, "text": "Varones hermanos, convino que se cumpliese la Escritura, la cual dijo antes el Espíritu Santo por la boca de David, de Judas, que fue guía de los que prendieron a Jesús;", "words": [[0, 148653], [8, 148823], [18, 149343], [26, 149763], [30, 149883], [33, 150193], [43, 150503], [46, 150663], [57, 151503], [60, 151603], [65, 151783], [70, 152043], [76, 152363], [79, 152583], [88, 153063], [94, 153363], [98, 153623], [101, 153743], [106, 153943], [109, 154103], [116, 154663], [119, 154703], [126, 155590], [130, 155672], [134, 155852], [139, 156192], [142, 156292], [146, 156412], [150, 156572], [161, 157052], [163, 157172]]}, {"verse": 17, "start": 158193, "end": 162535, "text": "El cuál era contado con nosotros, y tenía parte en este ministerio.", "words": [[0, 158193], [3, 158333], [8, 158573], [12, 158793], [20, 159293], [24, 159453], [34, 159913], [36, 160633], [42, 160933], [48, 161313], [51, 161553], [56, 161753]]}, {"verse": 18, "start": 162885, "end": 173209, "text": "Este, pues, adquirió un campo del salario de su iniquidad, y colgándose, reventó por medio, y todas sus entrañas se derramaron.", "words": [[0, 162885], [6, 163247], [12, 163647], [21, 164667], [24, 164887], [30, 165347], [34, 165627], [42, 166187], [45, 166347], [48, 166547], [59, 167407], [61, 167967], [73, 168827], [81, 169687], [85, 169847], [92, 170247], [94, 170787], [100, 170987], [104, 171267], [113, 171947], [116, 172207]]}, {"verse": 19, "start": 173659, "end": 185046, "text": "Y fue notorio a todos los habitantes de Jerusalén; de tal manera que aquel campo es llamado en su propia lengua, Acéldama, que es, Campo de sangre.", "words": [[0, 173659], [2, 173958], [6, 174098], [14, 174778], [16, 174958], [22, 175178], [26, 175418], [37, 176058], [40, 176198], [51, 177456], [54, 177564], [58, 177764], [65, 178164], [69, 178424], [75, 178704], [81, 179044], [84, 179284], [92, 179604], [95, 179844], [98, 180004], [105, 180424], [113, 181544], [123, 182764], [127, 183024], [131, 183364], [137, 184144], [140, 184404]]}, {"verse": 20, "start": 185346, "end": 195136, "text": "Porque está escrito en el libro de los salmos: Sea hecha desierta su habitación, y no haya quien more en ella; y: Tome otro su cargo.", "words": [[0, 185346], [7, 185551], [12, 185831], [20, 186211], [23, 186431], [26, 186571], [32, 186771], [35, 186951], [39, 187071], [47, 188152], [51, 188436], [57, 188885], [66, 189335], [69, 189496], [81, 190115], [83, 190675], [86, 190835], [91, 191035], [97, 191276], [102, 191556], [105, 191735], [111, 192351], [114, 193936], [119, 194140], [124, 194420], [127, 194620]]}, {"verse": 21, "start": 195586, "end": 203506, "text": "Conviene, pues, que de estos hombres que han estado juntos con nosotros todo el tiempo que el Señor Jesús entró y salió entre nosotros,", "words": [[0, 195586], [10, 195981], [16, 196861], [20, 196941], [23, 197101], [29, 197341], [37, 197841], [41, 198061], [45, 198201], [52, 198461], [59, 198941], [63, 199181], [72, 199921], [77, 200041], [80, 200241], [87, 200561], [91, 200801], [94, 200921], [100, 201161], [106, 201501], [112, 202101], [114, 202221], [120, 202521], [126, 202701]]}, {"verse": 22, "start": 203956, "end": 212833, "text": "Comenzando desde el bautismo de Juan, hasta el día que fue recibido arriba de entre nosotros, uno sea hecho testigo con nosotros de su resurrección.", "words": [[0, 203956], [11, 204593], [17, 204793], [20, 204993], [29, 205493], [32, 205633], [38, 206513], [44, 206773], [47, 206933], [51, 207093], [55, 207253], [59, 207433], [68, 207973], [75, 208233], [78, 208473], [84, 208653], [94, 209713], [98, 209943], [102, 210173], [108, 210543], [116, 210913], [120, 211113], [129, 211533], [132, 211773], [135, 211933]]}, {"verse": 23, "start": 213183, "end": 220391, "text": "Y señalaron a dos: a José, llamado Barsabas, que tenía por sobrenombre Justo, y a Matías.", "words": [[0, 213183], [2, 213308], [12, 214048], [14, 214308], [19, 215184], [21, 215444], [27, 215864], [35, 216694], [45, 217524], [49, 217544], [55, 217884], [59, 218104], [71, 218884], [78, 219284], [80, 219676], [82, 220068]]}, {"verse": 24, "start": 220841, "end": 227567, "text": "Y orando, dijeron: Tú, Señor, que conoces los corazones de todos, muestra cuál escoges de estos dos,", "words": [[0, 220841], [2, 221020], [10, 221380], [19, 222475], [23, 222592], [30, 223272], [34, 223352], [42, 223792], [46, 223953], [56, 224512], [59, 224652], [66, 225352], [74, 225800], [79, 226246], [87, 226692], [90, 226832], [96, 227012]]}, {"verse": 25, "start": 228017, "end": 235124, "text": "Para que tome el oficio de este ministerio y apostolado, del cual cayó Judas por transgresión, para irse a su lugar.", "words": [[0, 228017], [5, 228157], [9, 228297], [14, 228597], [17, 228697], [24, 229077], [27, 229237], [32, 229397], [43, 230037], [45, 230117], [57, 230817], [61, 231237], [66, 231457], [71, 231837], [77, 232037], [81, 232337], [95, 233077], [100, 233497], [105, 233877], [107, 233957], [110, 234057]]}, {"verse": 26, "start": 235474, "end": 242837, "text": "Y les echaron suertes, y cayó la suerte sobre Matías; y fue contado con los once apóstoles.", "words": [[0, 235474], [2, 235600], [6, 235780], [14, 236220], [23, 237040], [25, 237420], [30, 237780], [33, 237900], [40, 238320], [46, 238600], [54, 239750], [56, 239873], [60, 240033], [68, 240773], [72, 241033], [76, 241413], [81, 241793]]}]}