{"book": "PSA", "chapter": 137, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 65690, "verses": [{"verse": 1, "start": 300, "end": 7221, "text": "Junto a los ríos de Babilonia, allí nos sentábamos, y aun llorábamos, acordándonos de Sion.", "words": [[0, 300], [6, 544], [8, 784], [12, 884], [17, 1244], [20, 1344], [31, 2044], [36, 2544], [40, 2744], [52, 3584], [54, 3984], [58, 4244], [70, 5344], [83, 6344], [86, 6544]]}, {"verse": 2, "start": 7571, "end": 11825, "text": "Sobre los sauces en medio de ella colgamos nuestras arpas.", "words": [[0, 7571], [6, 7894], [10, 8154], [17, 8814], [20, 9154], [26, 9474], [29, 9734], [34, 9954], [43, 10634], [52, 10874]]}, {"verse": 3, "start": 12175, "end": 21095, "text": "Y los que allí nos habían llevado cautivos nos pedían que cantásemos, y los que nos habían desolado nos pedían alegría, diciendo:", "words": [[0, 12175], [2, 12299], [6, 12459], [10, 12659], [15, 12879], [19, 13099], [26, 13439], [34, 13919], [43, 14679], [47, 15004], [54, 15464], [58, 16174], [70, 16884], [72, 17224], [76, 17364], [80, 17484], [84, 17604], [91, 17944], [100, 18604], [104, 18764], [111, 19244], [120, 20024]]}, {"verse": 4, "start": 21295, "end": 27630, "text": "Cantadnos algunos de los himnos de Sion. ¿Cómo cantaremos canción de Jehová en tierra de extraños?", "words": [[0, 21295], [10, 21840], [18, 22220], [21, 22440], [25, 22560], [32, 23000], [35, 23140], [41, 23914], [47, 24079], [58, 24739], [66, 25199], [69, 25559], [76, 26019], [79, 26159], [86, 26439], [89, 26739]]}, {"verse": 5, "start": 27980, "end": 33201, "text": "Si me olvido de ti, oh Jerusalén, mi diestra pierda su destreza.", "words": [[0, 27980], [3, 28138], [6, 28278], [13, 28698], [16, 28838], [20, 29418], [23, 29798], [34, 31098], [37, 31218], [45, 31618], [52, 32178], [55, 32378]]}, {"verse": 6, "start": 33551, "end": 43188, "text": "Mi lengua se pegue a mi paladar, si de ti no me acuerdo; si no ensalzo a Jerusalén como preferente as