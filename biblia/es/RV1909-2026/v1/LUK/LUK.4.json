{"book": "LUK", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 353362, "verses": [{"verse": 1, "start": 300, "end": 7460, "text": "Y Jesús, lleno del Espíritu Santo, volvió del Jordán, y fue llevado por el Espíritu al desierto", "words": [[0, 300], [2, 465], [9, 1405], [15, 1925], [19, 2065], [28, 2625], [35, 3545], [42, 3985], [46, 4125], [54, 4865], [56, 5285], [60, 5445], [68, 5905], [72, 6145], [75, 6265], [84, 6825], [87, 6945]]}, {"verse": 2, "start": 7810, "end": 16335, "text": "Por cuarenta días, y era tentado del diablo. Y no comió cosa en aquellos días: los cuales pasados, tuvo hambre.", "words": [[0, 7810], [4, 8230], [13, 8650], [19, 9110], [21, 9610], [25, 9750], [33, 10350], [37, 10590], [45, 11598], [47, 11723], [50, 11843], [56, 12263], [61, 12683], [64, 12863], [73, 13123], [79, 14196], [83, 14276], [90, 14616], [99, 15336], [104, 15676]]}, {"verse": 3, "start": 16685, "end": 22783, "text": "Entonces el diablo le dijo: Si eres Hijo de Dios, di a esta piedra que se haga pan.", "words": [[0, 16685], [9, 17632], [12, 17952], [19, 18392], [22, 18572], [28, 19327], [31, 19540], [36, 19780], [41, 20040], [44, 20200], [50, 20920], [53, 21100], [55, 21200], [60, 21380], [67, 21860], [71, 21960], [74, 22140], [79, 22300]]}, {"verse": 4, "start": 23063, "end": 31751, "text": "Y Jesús respondiéndole, dijo: Escrito está: Que no con pan solo vivirá el hombre, sino con toda palabra de Dios.", "words": [[0, 23063], [2, 23191], [8, 24061], [24, 24931], [30, 25745], [38, 26345], [44, 27130], [48, 27212], [51, 27459], [55, 27705], [59, 27952], [64, 28272], [71, 28812], [74, 28952], [82, 29592], [87, 29832], [91, 30152], [96, 30412], [104, 30952], [107, 31192]]}, {"verse": 5, "start": 32101, "end": 39304, "text": "Y le llevó el diablo a un alto monte, y le mostró en un momento de tiempo todos los reinos de la tierra.", "words": [[0, 32101], [2, 32220], [5, 32340], [11, 32720], [14, 32840], [21, 33280], [23, 33520], [26, 33700], [31, 33940], [38, 34400], [40, 34820], [43, 34960], [50, 35560], [53, 35800], [56, 35960], [64, 36400], [67, 36600], [74, 37000], [80, 37460], [84, 37920], [91, 38460], [94, 38580], [97, 38680]]}, {"verse": 6, "start": 39654, "end": 46745, "text": "Y le dijo el diablo: A ti te daré toda esta potestad, y la gloria de ellos; porque a mí es entregada, y a quien quiero la doy:", "words": [[0, 39654], [2, 39782], [5, 39882], [10, 40142], [13, 40302], [21, 41111], [23, 41218], [26, 41378], [29, 41498], [34, 41798], [39, 41958], [44, 42278], [54, 42978], [56, 43278], [59, 43398], [66, 43738], [69, 43858], [76, 44563], [83, 44811], [85, 44951], [88, 45031], [91, 45171], [102, 45691], [104, 45851], [106, 45911], [112, 46051], [119, 46311], [122, 46451]]}, {"verse": 7, "start": 47095, "end": 50008, "text": "Pues si tú adoras delante de mí, serán todos tuyos.", "words": [[0, 47095], [5, 47235], [8, 47395], [11, 47495], [18, 47875], [26, 48275], [29, 48375], [33, 48815], [39, 49115], [45, 49335]]}, {"verse": 8, "start": 50288, "end": 60367, "text": "Y respondiendo Jesús, le dijo: Vete de mí, Satanás, porque escrito está: A tu Señor Dios adorarás, y a él solo servirás.", "words": [[0, 50288], [2, 50409], [15, 51189], [22, 51529], [25, 51909], [31, 52697], [36, 53001], [39, 53181], [43, 53441], [52, 54481], [59, 54701], [67, 55161], [73, 56021], [75, 56227], [78, 56347], [84, 56707], [89, 57127], [99, 58087], [101, 58447], [103, 58547], [106, 58787], [111, 59207]]}, {"verse": 9, "start": 60717, "end": 69029, "text": "Y le llevó a Jerusalén, y le puso sobre el pináculo del templo, y le dijo: Si eres Hijo de Dios, échate de aquí abajo:", "words": [[0, 60717], [2, 60859], [5, 60959], [11, 61319], [13, 61419], [24, 62599], [26, 62819], [29, 62959], [34, 63379], [40, 63699], [43, 63899], [52, 64619], [56, 64839], [64, 65499], [66, 65599], [69, 65679], [75, 66402], [78, 66593], [83, 66793], [88, 67073], [91, 67233], [97, 67793], [104, 68113], [107, 68313], [112, 68493]]}, {"verse": 10, "start": 69379, "end": 73316, "text": "Porque escrito está: Que a sus ángeles mandará de ti, que te guarden;", "words": [[0, 69379], [7, 69672], [15, 70012], [21, 70762], [25, 70842], [27, 70942], [31, 71042], [39, 71442], [47, 71882], [50, 72042], [54, 72242], [58, 72582], [61, 72702]]}, {"verse": 11, "start": 73666, "end": 77378, "text": "Y en las manos te llevarán, para que no dañes tu pie en piedra.", "words": [[0, 73666], [2, 73793], [5, 73893], [9, 74013], [15, 74313], [18, 74533], [28, 75093], [33, 75553], [37, 75713], [40, 75853], [46, 76273], [49, 76393], [53, 76633], [56, 76833]]}, {"verse": 12, "start": 77658, "end": 83141, "text": "Y respondiendo Jesús, le dijo: Dicho está: No tentarás al Señor tu Dios.", "words": [[0, 77658], [2, 77780], [15, 78560], [22, 78900], [25, 79280], [31, 80068], [37, 80378], [43, 81160], [46, 81507], [55, 81887], [58, 82027], [64, 82347], [67, 82587]]}, {"verse": 13, "start": 83491, "end": 87959, "text": "Y acabada toda tentación, el diablo se fue de él por un tiempo.", "words": [[0, 83491], [2, 83715], [10, 84255], [15, 84475], [26, 85695], [29, 85795], [36, 86155], [39, 86395], [43, 86615], [46, 86815], [49, 86975], [53, 87175], [56, 87335]]}, {"verse": 14, "start": 88309, "end": 95086, "text": "Y Jesús volvió en el poder del Espíritu a Galilea, y salió la fama de él por toda la tierra de alrededor.", "words": [[0, 88309], [2, 88451], [8, 88811], [15, 89611], [18, 89711], [21, 89851], [27, 90151], [31, 90431], [40, 91011], [42, 91071], [51, 91731], [53, 92091], [59, 92411], [62, 92551], [67, 92891], [70, 93011], [73, 93131], [77, 93311], [82, 93611], [85, 93791], [92, 94111], [95, 94311]]}, {"verse": 15, "start": 95436, "end": 100525, "text": "Y enseñaba en las sinagogas de ellos, y era glorificado de todos.", "words": [[0, 95436], [2, 95705], [11, 96365], [14, 96485], [18, 96625], [28, 97385], [31, 97565], [38, 98405], [40, 98945], [44, 99395], [56, 99845], [59, 100025]]}, {"verse": 16, "start": 100875, "end": 110854, "text": "Y vino a Nazaret, donde había sido criado; y entró, conforme a su costumbre, el día del sábado en la sinagoga, y se levantó a leer.", "words": [[0, 100875], [2, 101012], [7, 101232], [9, 101392], [18, 101872], [24, 102692], [30, 103052], [35, 103372], [43, 104326], [45, 104471], [52, 104971], [61, 105711], [63, 105771], [66, 105891], [77, 106551], [80, 106991], [84, 107251], [88, 107471], [95, 108131], [98, 108251], [101, 108391], [111, 109071], [113, 109531], [116, 109651], [124, 110251], [126, 110391]]}, {"verse": 17, "start": 111204, "end": 118536, "text": "Y le fue dado el libro del profeta Isaías; y como abrió el libro, halló el lugar donde estaba escrito:", "words": [[0, 111204], [2, 111329], [5, 111429], [9, 111609], [14, 111909], [17, 112169], [23, 112429], [27, 112669], [35, 113309], [43, 114466], [45, 114570], [50, 114790], [56, 115210], [59, 115410], [66, 116210], [72, 116650], [75, 116790], [81, 117150], [87, 117450], [94, 117830]]}, {"verse": 18, "start": 118886, "end": 136368, "text": "El Espíritu del Señor es sobre mí, por cuanto me ha ungido para dar buenas nuevas a los pobres: me ha enviado para sanar a los quebrantados de corazón; para pregonar a los cautivos libertad, y a los ciegos vista; para poner en libertad a los quebrantados:", "words": [[0, 118886], [3, 119027], [12, 119667], [16, 119807], [22, 120147], [25, 120367], [31, 120587], [35, 121187], [39, 121347], [46, 121527], [49, 121827], [52, 122107], [59, 122387], [64, 122627], [68, 122887], [75, 123167], [82, 123487], [84, 123827], [88, 123927], [96, 124909], [99, 125038], [102, 125178], [110, 125658], [115, 125918], [121, 126418], [123, 126478], [127, 126618], [140, 127518], [143, 127698], [152, 128691], [157, 128858], [166, 129538], [168, 129598], [172, 129738], [181, 130278], [191, 131038], [193, 131218], [195, 131298], [199, 131478], [206, 132118], [213, 133081], [218, 133341], [224, 133701], [227, 134081], [236, 134761], [238, 134961], [242, 135101]]}, {"verse": 19, "start": 136718, "end": 139455, "text": "Para predicar el año agradable del Señor.", "words": [[0, 136718], [5, 136865], [14, 137505], [17, 137785], [21, 138215], [31, 138645], [35, 138805]]}, {"verse": 20, "start": 139805, "end": 148673, "text": "Y enrollando el libro, lo dio al ministro, y se sentó: y los ojos de todos en la sinagoga estaban fijos en él.", "words": [[0, 139805], [2, 139929], [13, 140589], [16, 140789], [23, 141689], [26, 141929], [30, 142169], [33, 142409], [43, 143189], [45, 143769], [48, 143929], [55, 144906], [57, 145014], [61, 145154], [66, 145474], [69, 145714], [75, 146054], [78, 146334], [81, 146474], [90, 147034], [98, 147414], [104, 148114], [107, 148334]]}, {"verse": 21, "start": 149023, "end": 154326, "text": "Y comenzó a decirles: Hoy se ha cumplido esta Escritura en vuestros oídos.", "words": [[0, 149023], [2, 149398], [10, 149958], [12, 150058], [22, 151153], [26, 151339], [29, 151539], [32, 151679], [41, 152379], [46, 152559], [56, 153199], [59, 153299], [68, 153659]]}, {"verse": 22, "start": 154676, "end": 163412, "text": "Y todos le daban testimonio, y estaban maravillados de las palabras de gracia que salían de su boca, y decían: ¿No es este el hijo de José?", "words": [[0, 154676], [2, 154801], [8, 155021], [11, 155261], [17, 155561], [29, 156481], [31, 156601], [39, 156901], [52, 157781], [55, 157941], [59, 158061], [68, 158461], [71, 158641], [78, 159141], [82, 159241], [89, 159661], [92, 159821], [95, 159961], [101, 160281], [103, 160721], [111, 161643], [115, 161858], [118, 162098], [123, 162418], [126, 162598], [131, 162778], [134, 162898]]}, {"verse": 23, "start": 163692, "end": 175046, "text": "Y les dijo: Sin duda me diréis este refrán: Médico, cúrate a ti mismo: de tantas cosas que hemos oído haber sido hechas en Capernaum, haz también aquí en tu tierra.", "words": [[0, 163692], [2, 163840], [6, 163940], [12, 164729], [16, 164914], [21, 165174], [24, 165394], [31, 165754], [36, 166034], [44, 166931], [52, 167881], [59, 168161], [61, 168341], [64, 168441], [71, 169258], [74, 169403], [81, 169823], [87, 170203], [91, 170783], [97, 170963], [102, 171343], [108, 171523], [113, 171843], [120, 172163], [123, 172588], [134, 173013], [138, 173438], [146, 173863], [151, 174083], [154, 174263], [157, 174383]]}, {"verse": 24, "start": 175396, "end": 181020, "text": "Y dijo: De cierto os digo, que ningún profeta es acepto en su tierra.", "words": [[0, 175396], [2, 175599], [8, 176776], [11, 176978], [18, 177298], [21, 177718], [27, 178018], [31, 178233], [38, 178593], [46, 179313], [49, 179493], [56, 180033], [59, 180133], [62, 180293]]}, {"verse": 25, "start": 181370, "end": 194136, "text": "Pero en verdad os digo, que muchas viudas había en Israel en los días de Elías, cuando el cielo fue cerrado por tres años y seis meses, que hubo una gran hambruna en toda la tierra;", "words": [[0, 181370], [5, 181574], [8, 181694], [15, 181954], [18, 182234], [24, 182594], [28, 182834], [35, 183134], [42, 183914], [48, 184314], [51, 184574], [58, 184974], [61, 185454], [65, 185614], [70, 185874], [73, 186094], [80, 186554], [87, 187134], [90, 187394], [96, 187674], [100, 187954], [108, 188454], [112, 188714], [117, 189214], [122, 189634], [124, 189854], [129, 190094], [136, 190998], [140, 191103], [145, 191503], [149, 191643], [154, 191943], [163, 192883], [166, 193063], [171, 193203], [174, 193423]]}, {"verse": 26, "start": 194486, "end": 200581, "text": "Pero a ninguna de ellas fue enviado Elías, sino a Sarepta de Sidón, a una mujer viuda.", "words": [[0, 194486], [5, 194628], [7, 194748], [15, 194995], [18, 195241], [24, 195488], [28, 195668], [36, 196168], [43, 197268], [48, 197688], [50, 198008], [58, 198328], [61, 198468], [68, 199408], [70, 199488], [74, 199628], [80, 199968]]}, {"verse": 27, "start": 200931, "end": 210618, "text": "Y muchos leprosos había en Israel en tiempo del profeta Eliseo; pero ninguno de ellos fue limpio, sino Naamán el sirio.", "words": [[0, 200931], [2, 201076], [9, 201356], [18, 202316], [24, 202756], [27, 203016], [34, 203516], [37, 203956], [44, 204416], [48, 204676], [56, 205395], [64, 206286], [69, 206430], [77, 206930], [80, 207110], [86, 207370], [90, 207630], [98, 208550], [103, 209060], [110, 209570], [113, 209890]]}, {"verse": 28, "start": 210968, "end": 216611, "text": "Entonces todos en la sinagoga fueron llenos de ira, oyendo estas cosas;", "words": [[0, 210968], [9, 211754], [15, 212214], [18, 212654], [21, 212774], [30, 213414], [37, 213734], [44, 214374], [47, 214574], [52, 215114], [59, 215654], [65, 215854]]}, {"verse": 29, "start": 216961, "end": 226859, "text": "Y levantándose, le echaron fuera de la ciudad, y le llevaron hasta la cumbre del monte sobre el cual la ciudad de ellos estaba edificada, para despeñarle.", "words": [[0, 216961], [2, 217082], [16, 218502], [19, 218702], [27, 219102], [33, 219362], [36, 219582], [39, 219702], [47, 219962], [49, 220467], [52, 220587], [61, 221067], [67, 221387], [70, 221567], [77, 222007], [81, 222187], [87, 222487], [93, 222807], [96, 223027], [101, 223247], [104, 223887], [111, 224307], [114, 224527], [120, 224787], [127, 225207], [138, 225987], [143, 226407]]}, {"verse": 30, "start": 227209, "end": 230042, "text": "Pero él, pasando por medio de ellos, se fue.", "words": [[0, 227209], [5, 227373], [9, 227653], [17, 228093], [21, 228453], [27, 228713], [30, 228973], [37, 229273], [40, 229553]]}, {"verse": 31, "start": 230392, "end": 236594, "text": "Y descendió a Capernaum, ciudad de Galilea. Y los enseñaba en los sábados.", "words": [[0, 230392], [2, 230664], [12, 231304], [14, 231904], [25, 232504], [32, 232824], [35, 233144], [44, 234142], [46, 234334], [50, 234564], [59, 235444], [62, 235624], [66, 235744]]}, {"verse": 32, "start": 236944, "end": 241596, "text": "Y se maravillaban de su doctrina, porque su palabra era con autoridad.", "words": [[0, 236944], [2, 237154], [5, 237314], [18, 238094], [21, 238274], [24, 238454], [34, 239054], [41, 239434], [44, 239634], [52, 240114], [56, 240494], [60, 240754]]}, {"verse": 33, "start": 241946, "end": 249363, "text": "Y estaba en la sinagoga un hombre que tenía un espíritu de un demonio inmundo, el cual exclamó a gran voz,", "words": [[0, 241946], [2, 242075], [9, 242475], [12, 242675], [15, 242795], [24, 243475], [27, 243735], [34, 244095], [38, 244315], [44, 244675], [47, 244875], [56, 245515], [59, 245635], [62, 245755], [70, 246235], [79, 246855], [82, 247375], [87, 247945], [95, 248515], [97, 248615], [102, 248795]]}, {"verse": 34, "start": 249713, "end": 257468, "text": "Diciendo: Déjanos, ¿qué tenemos contigo, Jesús nazareno? ¿has venido a destruirnos? Yo te conozco quién eres, el Santo de Dios.", "words": [[0, 249713], [10, 250747], [19, 251193], [24, 251333], [32, 251673], [41, 252233], [47, 252393], [57, 253413], [62, 253582], [69, 253982], [71, 254082], [84, 255148], [87, 255229], [90, 255349], [98, 255789], [104, 255969], [110, 256489], [113, 256549], [119, 256849], [122, 257049]]}, {"verse": 35, "start": 257748, "end": 269687, "text": "Y Jesús le reprendió, diciendo: Enmudece, y sal de él. Entonces el demonio, derribándole en medio, salió de él, y no le hizo daño alguno.", "words": [[0, 257748], [2, 257871], [8, 258251], [11, 258606], [22, 259570], [32, 260659], [42, 261710], [44, 261890], [48, 262150], [51, 262450], [55, 263085], [64, 263637], [67, 264017], [76, 264557], [89, 265337], [92, 265617], [99, 265977], [105, 266817], [108, 267017], [112, 267297], [114, 267937], [117, 268097], [120, 268237], [125, 268537], [130, 269097]]}, {"verse": 36, "start": 270037, "end": 279713, "text": "Y hubo espanto en todos, y hablaban unos a otros, diciendo: ¿Qué palabra es esta, que con autoridad y poder manda a los espíritus inmundos, y salen?", "words": [[0, 270037], [2, 270198], [7, 270498], [15, 271078], [18, 271298], [25, 271778], [27, 272193], [36, 272693], [41, 273013], [43, 273273], [50, 273693], [60, 275030], [65, 275110], [73, 275390], [76, 275670], [82, 276310], [86, 276310], [90, 276490], [100, 277030], [102, 277130], [108, 277370], [114, 277590], [116, 277810], [120, 277930], [130, 278470], [140, 278930], [142, 279230]]}, {"verse": 37, "start": 279993, "end": 284615, "text": "Y la fama de él se divulgaba de todas partes por todos los lugares de la comarca.", "words": [[0, 279993], [2, 280101], [5, 280241], [10, 280601], [13, 280701], [16, 280881], [19, 281041], [29, 281641], [32, 281801], [38, 281961], [45, 282441], [49, 282661], [55, 282941], [59, 283201], [67, 283541], [70, 283761], [73, 283881]]}, {"verse": 38, "start": 284965, "end": 295671, "text": "Y levantándose Jesús de la sinagoga, entró en casa de Simón: y la suegra de Simón estaba con una grande fiebre; y le rogaron por ella.", "words": [[0, 284965], [2, 285466], [15, 286226], [21, 286686], [24, 287106], [27, 287226], [37, 288386], [43, 288826], [46, 289006], [51, 289266], [54, 289526], [61, 290423], [63, 290546], [66, 290666], [73, 291226], [76, 291346], [82, 291886], [89, 292266], [93, 292566], [97, 292766], [104, 293106], [112, 294141], [114, 294275], [117, 294445], [125, 295025], [129, 295205]]}, {"verse": 39, "start": 296021, "end": 305336, "text": "E inclinándose hacia ella, reprendió a la fiebre; y la fiebre la dejó; y ella levantándose luego, les servía.", "words": [[0, 296021], [2, 296181], [15, 297461], [21, 297861], [27, 298661], [37, 299401], [39, 299541], [42, 299601], [50, 300454], [52, 300678], [55, 300798], [62, 301178], [65, 301338], [71, 302093], [73, 302239], [78, 302539], [91, 303639], [98, 304019], [102, 304539]]}, {"verse": 40, "start": 305686, "end": 317019, "text": "Y poniéndose el sol, todos los que tenían enfermos de diversas enfermedades, los traían a él; y él, poniendo las manos sobre cada uno de ellos, los sanaba.", "words": [[0, 305686], [2, 305813], [13, 306493], [16, 306673], [21, 307333], [27, 307653], [31, 307953], [35, 308093], [42, 308433], [51, 309113], [54, 309233], [63, 309773], [77, 311033], [81, 311273], [88, 311833], [90, 311973], [94, 312639], [96, 312825], [100, 313385], [109, 313785], [113, 313965], [119, 314325], [125, 314685], [130, 314965], [134, 315325], [137, 315525], [144, 315905], [148, 316285]]}, {"verse": 41, "start": 317369, "end": 329862, "text": "Y salían también demonios de muchos, dando voces, y diciendo: Tú eres el Hijo de Dios. Pero reprendiéndolos no les dejaba hablar; porque sabían que él era el Cristo.", "words": [[0, 317369], [2, 317494], [9, 317974], [17, 318314], [26, 318954], [29, 319074], [37, 319814], [43, 320134], [50, 320834], [52, 321294], [62, 322270], [65, 322387], [70, 322627], [73, 322827], [78, 323027], [81, 323167], [87, 324233], [92, 324930], [108, 325660], [111, 326120], [115, 326340], [122, 326780], [130, 327639], [137, 327824], [144, 328284], [148, 328484], [151, 328704], [155, 328904], [158, 329104]]}, {"verse": 42, "start": 330212, "end": 340762, "text": "Y siendo ya de día salió, y se fue a un lugar desierto: y la gente lo buscaba y acudía a él; y le detenían para que no se apartase de ellos.", "words": [[0, 330212], [2, 330336], [9, 330676], [12, 330956], [15, 331116], [19, 331396], [26, 332536], [28, 332656], [31, 332756], [35, 332976], [37, 333116], [40, 333216], [46, 333556], [56, 334820], [58, 334944], [61, 335044], [67, 335324], [70, 335564], [78, 336104], [80, 336244], [87, 336784], [89, 337004], [93, 337729], [95, 337872], [98, 337992], [107, 338572], [112, 338832], [116, 338992], [119, 339132], [122, 339312], [131, 339932], [134, 340132]]}, {"verse": 43, "start": 341112, "end": 350106, "text": "Pero él les dijo: Que también a otras ciudades es necesario que anuncie el evangelio del reino de Dios; porque para esto soy enviado.", "words": [[0, 341112], [5, 341253], [8, 341473], [12, 341593], [18, 342334], [22, 342418], [30, 342718], [32, 342978], [38, 343178], [47, 343818], [50, 344038], [60, 344938], [64, 345198], [72, 346058], [75, 346318], [85, 346978], [89, 347178], [95, 347578], [98, 347738], [104, 348366], [111, 348569], [116, 348869], [121, 349089], [125, 349369]]}, {"verse": 44, "start": 350456, "end": 352962, "text": "Y predicaba en las sinagogas de Galilea.", "words": [[0, 350456], [2, 350566], [12, 351186], [15, 351346], [19, 351466], [29, 352066], [32, 352146]]}]}