{"book": "MAT", "chapter": 23, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 338682, "verses": [{"verse": 1, "start": 300, "end": 3670, "text": "Entonces habló Jesús a la gente y a sus discípulos,", "words": [[0, 300], [9, 802], [15, 1382], [21, 1582], [23, 1902], [26, 1982], [32, 2322], [34, 2542], [36, 2602], [40, 2782]]}, {"verse": 2, "start": 4020, "end": 9876, "text": "Diciendo: Sobre la cátedra de Moisés se sentaron los escribas y los fariseos:", "words": [[0, 4020], [10, 5047], [16, 5247], [19, 5557], [27, 6077], [30, 6197], [37, 6697], [40, 7197], [49, 7817], [53, 7977], [62, 8697], [64, 8877], [68, 9017]]}, {"verse": 3, "start": 10226, "end": 19019, "text": "Así que, todo lo que os digan que guardéis, guardadlo y hacedlo; pero no hagáis conforme a sus obras: porque dicen, y no hacen.", "words": [[0, 10226], [4, 10473], [9, 10653], [14, 10913], [17, 11133], [21, 11273], [24, 11393], [30, 11733], [34, 11893], [44, 12833], [54, 13593], [56, 13733], [65, 14653], [70, 14816], [73, 15116], [80, 15556], [89, 16256], [91, 16316], [95, 16436], [102, 17281], [109, 17508], [116, 17968], [118, 18233], [121, 18453]]}, {"verse": 4, "start": 19369, "end": 28292, "text": "Porque atan cargas pesadas y difíciles de llevar, y las ponen sobre los hombros de los hombres; pero ni aun con su dedo las quieren mover.", "words": [[0, 19369], [7, 19655], [12, 20195], [19, 20615], [27, 21135], [29, 21295], [39, 21935], [42, 22035], [50, 22375], [52, 22895], [56, 23015], [62, 23395], [68, 23675], [72, 23955], [80, 24495], [83, 24615], [87, 24755], [96, 25724], [101, 25868], [104, 26088], [108, 26348], [112, 26608], [115, 26828], [120, 27168], [124, 27268], [132, 27628]]}, {"verse": 5, "start": 28642, "end": 39942, "text": "Antes, todas sus obras hacen para ser mirados de los hombres; porque ensanchan sus filacterias, y extienden los flecos de sus mantos;", "words": [[0, 28642], [7, 29196], [13, 29641], [17, 30001], [23, 30441], [29, 31341], [34, 31881], [38, 32181], [46, 32761], [49, 32921], [53, 33061], [62, 34139], [69, 34381], [79, 35461], [83, 35781], [96, 36821], [98, 37301], [108, 38061], [112, 38261], [119, 38801], [122, 38921], [126, 39101]]}, {"verse": 6, "start": 40292, "end": 46016, "text": "Y aman los primeros asientos en las cenas, y las primeras sillas en las sinagogas;", "words": [[0, 40292], [2, 40496], [7, 40696], [11, 40956], [20, 41476], [29, 41976], [32, 42256], [36, 42416], [43, 42916], [45, 43336], [49, 43516], [58, 43996], [65, 44436], [68, 44676], [72, 44876]]}, {"verse": 7, "start": 46366, "end": 52199, "text": "Y los saludos en las plazas, y ser llamados de los hombres Rabí, Rabí.", "words": [[0, 46366], [2, 46638], [6, 46798], [14, 47398], [17, 47538], [21, 47718], [29, 48418], [31, 48898], [35, 49098], [44, 49618], [47, 49778], [51, 49898], [59, 50683], [65, 51468]]}, {"verse": 8, "start": 52549, "end": 60139, "text": "Pero vosotros, no queráis ser llamados Rabí; porque uno es vuestro Maestro, el Cristo; y todos vosotros sois hermanos.", "words": [[0, 52549], [5, 52675], [15, 53155], [18, 53375], [26, 53775], [30, 53975], [39, 54555], [45, 55395], [52, 55640], [56, 55900], [59, 56020], [67, 56340], [76, 57140], [79, 57240], [87, 58168], [89, 58278], [95, 58538], [104, 59078], [109, 59438]]}, {"verse": 9, "start": 60489, "end": 67968, "text": "Y vuestro padre no llaméis a nadie en la tierra; porque uno es vuestro Padre, el cual está en los cielos.", "words": [[0, 60489], [2, 60595], [10, 60915], [16, 61275], [19, 61635], [27, 62155], [29, 62395], [35, 62795], [38, 63135], [41, 63295], [49, 64202], [56, 64446], [60, 64726], [63, 64966], [71, 65411], [78, 65819], [81, 66226], [86, 66486], [91, 66866], [94, 67026], [98, 67186]]}, {"verse": 10, "start": 68318, "end": 73276, "text": "Ni seáis llamados maestros; porque uno es vuestro Maestro, el Cristo.", "words": [[0, 68318], [3, 68543], [9, 68803], [18, 69503], [28, 70188], [35, 71212], [39, 71612], [42, 71792], [50, 72112], [59, 72492], [62, 72872]]}, {"verse": 11, "start": 73626, "end": 77114, "text": "El que es el mayor de vosotros, sea vuestro siervo.", "words": [[0, 73928], [3, 74268], [7, 74388], [10, 74568], [13, 74648], [19, 75008], [22, 75208], [32, 75748], [36, 76048], [44, 76408]]}, {"verse": 12, "start": 77464, "end": 83685, "text": "Porque el que se exalte, será humillado; y el que se humille, será exaltado.", "words": [[0, 77464], [7, 77728], [10, 77928], [14, 78068], [17, 78248], [25, 78968], [30, 79388], [41, 80609], [43, 80795], [46, 80955], [50, 81135], [53, 81335], [62, 81915], [67, 82495]]}, {"verse": 13, "start": 84035, "end": 96402, "text": "Pero ¡ay de vosotros, escribas y fariseos, hipócritas! porque cerráis el reino de los cielos delante de los hombres; que ni vosotros entráis, ni a los que están entrando dejáis entrar.", "words": [[0, 84035], [5, 84337], [9, 84677], [12, 85057], [22, 85577], [31, 86257], [33, 86417], [43, 87110], [55, 88022], [62, 88622], [70, 89282], [73, 89462], [79, 89902], [82, 90022], [86, 90162], [93, 90682], [101, 91162], [104, 91302], [108, 91422], [117, 92312], [121, 92434], [124, 92534], [133, 93054], [142, 93481], [145, 93907], [147, 94334], [151, 94474], [155, 94614], [161, 94814], [170, 95454], [177, 95754]]}, {"verse": 14, "start": 96752, "end": 109312, "text": "¡Ay de vosotros, escribas y fariseos, hipócritas! porque devoráis las casas de las viudas, y por pretexto hacéis larga oración: por esto llevaréis más grave juicio.", "words": [[0, 96920], [4, 97130], [7, 97310], [17, 97770], [26, 98410], [28, 98550], [38, 99250], [50, 100549], [57, 100850], [66, 101370], [70, 101590], [76, 102050], [79, 102150], [83, 102270], [91, 102790], [93, 103130], [97, 103350], [106, 104490], [113, 105050], [119, 105550], [128, 106340], [132, 106462], [137, 106954], [147, 107607], [151, 107987], [157, 108507]]}, {"verse": 15, "start": 109662, "end": 123107, "text": "¡Ay de vosotros, escribas y fariseos, hipócritas! porque recorréis mar y tierra por hacer un convertido; y cuando es hecho, le hacéis dos veces más hijo del infierno que vosotros.", "words": [[0, 109829], [4, 110039], [7, 110219], [17, 110679], [26, 111319], [28, 111459], [38, 112159], [50, 113458], [57, 113838], [67, 114538], [71, 114878], [73, 115198], [80, 115518], [84, 115898], [90, 116218], [93, 116518], [105, 117828], [107, 117938], [114, 118118], [117, 118418], [124, 118758], [127, 119083], [134, 119603], [138, 119843], [144, 120383], [148, 120843], [153, 121163], [157, 121423], [166, 122083], [170, 122283]]}, {"verse": 16, "start": 123457, "end": 133201, "text": "¡Ay de vosotros, guías ciegos! que decís: Cualquiera que jure por el templo es nada; pero cualquiera que jure por el oro del templo, queda obligado.", "words": [[0, 123567], [4, 123717], [7, 123897], [17, 124417], [23, 124837], [31, 125755], [35, 126150], [42, 126801], [53, 127228], [57, 127368], [62, 127708], [66, 127908], [69, 128068], [76, 128548], [79, 128548], [85, 129328], [90, 129472], [101, 130092], [105, 130352], [110, 130612], [114, 130852], [117, 131032], [121, 131212], [125, 131412], [133, 132052], [139, 132232]]}, {"verse": 17, "start": 133551, "end": 139479, "text": "¡Insensatos y ciegos! porque ¿cuál es mayor, el oro, o el templo que santifica al oro?", "words": [[0, 133551], [12, 134517], [14, 134737], [22, 135596], [29, 135738], [35, 136098], [38, 136238], [45, 136638], [48, 136838], [53, 137078], [55, 137418], [58, 137578], [65, 138118], [69, 138218], [79, 138658], [82, 139098]]}, {"verse": 18, "start": 139829, "end": 147531, "text": "Y: Cualquiera que jure por el altar, es nada; pero cualquiera que jure por la ofrenda que está sobre él, queda obligado.", "words": [[0, 139829], [3, 140240], [14, 140742], [18, 140902], [23, 141262], [27, 141542], [30, 141662], [37, 142062], [40, 142462], [46, 143536], [51, 143660], [62, 144220], [66, 144380], [71, 144720], [75, 144960], [78, 145160], [86, 145680], [90, 145780], [95, 145960], [101, 146260], [105, 146560], [111, 146860]]}, {"verse": 19, "start": 147881, "end": 155018, "text": "¡Necios y ciegos! porque, ¿cuál es mayor, la ofrenda, o el altar que santifica la ofrenda?", "words": [[0, 147881], [8, 148386], [10, 148666], [18, 149606], [26, 149890], [32, 150310], [35, 150490], [42, 150850], [45, 151070], [54, 152090], [56, 152510], [59, 152710], [65, 153110], [69, 153390], [79, 154050], [82, 154230]]}, {"verse": 20, "start": 155368, "end": 160405, "text": "Pues el que jura por el altar, jura por él, y por todo lo que está sobre él;", "words": [[0, 155368], [5, 155511], [8, 155691], [12, 155831], [17, 156191], [21, 156371], [24, 156531], [31, 157171], [36, 157431], [40, 157691], [44, 157911], [46, 158451], [50, 158691], [55, 159011], [58, 159231], [62, 159351], [67, 159551], [73, 159871]]}, {"verse": 21, "start": 160755, "end": 165635, "text": "Y el que jura por el templo, jura por él, y por Aquel que habita en él;", "words": [[0, 160755], [2, 160914], [5, 161034], [9, 161214], [14, 161594], [18, 161794], [21, 161974], [29, 162914], [34, 163174], [38, 163374], [42, 163634], [44, 164174], [48, 164354], [54, 164694], [58, 164754], [65, 165094], [68, 165274]]}, {"verse": 22, "start": 165985, "end": 173029, "text": "Y el que jura por el cielo, jura por el trono de Dios, y por Aquel que está sentado sobre él.", "words": [[0, 165985], [2, 166148], [5, 166268], [9, 166448], [14, 166828], [18, 167028], [21, 167208], [28, 168188], [33, 168668], [37, 168948], [40, 169148], [46, 169588], [49, 169748], [55, 170128], [57, 170828], [61, 171008], [67, 171308], [71, 171408], [76, 171608], [84, 172228], [90, 172548]]}, {"verse": 23, "start": 173379, "end": 190578, "text": "¡Ay de vosotros, escribas y fariseos, hipócritas! porque diezmáis la menta y el eneldo y el comino, y dejasteis lo más importante de la ley, es decir, la justicia, la misericordia y la fe: esto era necesario hacer, y no dejar lo otro.", "words": [[0, 173547], [4, 173757], [7, 173937], [17, 174397], [26, 175037], [28, 175177], [38, 175877], [50, 177176], [57, 177562], [66, 177982], [69, 178282], [75, 178722], [77, 178842], [80, 178982], [87, 179482], [89, 179602], [92, 179742], [100, 180242], [102, 180662], [112, 181402], [115, 181722], [119, 181882], [130, 182462], [133, 182742], [136, 182882], [141, 183182], [144, 183602], [151, 184282], [154, 184682], [164, 185822], [167, 185882], [180, 186682], [182, 186782], [185, 186882], [189, 187405], [194, 187681], [198, 187901], [208, 188521], [215, 188961], [217, 189346], [220, 189586], [226, 189826], [229, 190066]]}, {"verse": 24, "start": 190928, "end": 195302, "text": "¡Guías ciegos, que coláis el mosquito, pero tragáis el camello!", "words": [[0, 190928], [7, 191408], [15, 191988], [19, 192148], [26, 192648], [29, 192788], [39, 193428], [44, 193668], [52, 194368], [55, 194548]]}, {"verse": 25, "start": 195652, "end": 207203, "text": "¡Ay de vosotros, escribas y fariseos, hipócritas! porque limpiáis lo que está de fuera del vaso y del plato; pero de dentro están llenos de robo y de injusticia.", "words": [[0, 195820], [4, 196030], [7, 196210], [17, 196670], [26, 197310], [28, 197450], [38, 198150], [50, 199448], [57, 199670], [66, 200690], [69, 201130], [73, 201270], [78, 201490], [81, 201630], [87, 201870], [91, 202190], [96, 202610], [98, 202690], [102, 202850], [109, 203713], [114, 203875], [117, 204055], [124, 204415], [130, 204735], [137, 205075], [140, 205415], [145, 205855], [147, 206075], [150, 206215]]}, {"verse": 26, "start": 207553, "end": 215203, "text": "¡Fariseo ciego, limpia primero lo de dentro del vaso y del plato, para que también lo de fuera se haga limpio!", "words": [[0, 207553], [9, 208153], [16, 208533], [23, 209093], [31, 209573], [34, 210133], [37, 210293], [44, 210673], [48, 210933], [53, 211333], [55, 211393], [59, 211573], [66, 212213], [71, 212833], [75, 212973], [83, 213353], [86, 213553], [89, 213673], [95, 213973], [98, 214313], [103, 214553]]}, {"verse": 27, "start": 215553, "end": 231272, "text": "¡Ay de vosotros, escribas y fariseos, hipócritas! porque sois semejantes a sepulcros blanqueados, que de fuera, a la verdad, se muestran hermosos, pero de dentro están llenos de huesos de muertos y de toda suciedad.", "words": [[0, 215721], [4, 215931], [7, 216111], [17, 216571], [26, 217211], [28, 217351], [38, 218051], [50, 219349], [57, 219572], [62, 220092], [73, 220992], [75, 221292], [85, 222212], [98, 223352], [102, 223577], [105, 223717], [112, 224137], [114, 224557], [117, 224677], [125, 225057], [128, 225577], [137, 225997], [147, 227037], [152, 227337], [155, 227497], [162, 227837], [168, 228077], [175, 228557], [178, 228717], [185, 229117], [188, 229257], [196, 229697], [198, 229957], [201, 230097], [206, 230317]]}, {"verse": 28, "start": 231622, "end": 241646, "text": "Así también vosotros de fuera, a la verdad, os mostráis justos a los hombres; pero de dentro, llenos estáis de hipocresía e iniquidad.", "words": [[0, 231622], [4, 231922], [12, 232402], [21, 233002], [24, 233182], [31, 233542], [33, 233722], [36, 233802], [44, 234162], [47, 234742], [56, 235382], [63, 235922], [65, 236062], [69, 236202], [78, 237161], [83, 237325], [86, 237485], [94, 237985], [101, 238905], [108, 239425], [111, 239545], [122, 240465], [124, 240705]]}, {"verse": 29, "start": 241996, "end": 252005, "text": "¡Ay de vosotros, escribas y fariseos, hipócritas! porque edificáis los sepulcros de los profetas, y adornáis los monumentos de los justos,", "words": [[0, 242164], [4, 242374], [7, 242554], [17, 243014], [26, 243654], [28, 243794], [38, 244494], [50, 245793], [57, 246057], [67, 247017], [71, 247297], [81, 248097], [84, 248277], [88, 248417], [98, 249057], [100, 249617], [109, 250277], [113, 250517], [124, 251197], [127, 251317], [131, 251437]]}, {"verse": 30, "start": 252355, "end": 260794, "text": "Y decís: Si hubiéramos vivido en los días de nuestros padres, no hubiéramos sido sus compañeros en la sangre de los profetas.", "words": [[0, 252355], [2, 252474], [9, 253298], [12, 253519], [23, 254219], [30, 254739], [33, 254799], [37, 254919], [42, 255219], [45, 255379], [54, 255559], [62, 256599], [65, 256879], [76, 257519], [81, 257839], [85, 258059], [96, 258859], [99, 259039], [102, 259179], [109, 259599], [112, 259779], [116, 259899]]}, {"verse": 31, "start": 261144, "end": 268819, "text": "Así que, testimonio dais a vosotros mismos, que sois hijos de aquellos que mataron a los profetas.", "words": [[0, 261144], [4, 261534], [9, 261734], [20, 262754], [25, 263334], [27, 263594], [36, 264034], [44, 264494], [48, 265154], [53, 265534], [59, 265994], [62, 266574], [71, 266954], [75, 267174], [83, 267734], [85, 267834], [89, 267994]]}, {"verse": 32, "start": 269169, "end": 272463, "text": "¡Vosotros también llenad la medida de vuestros padres!", "words": [[0, 269169], [10, 269697], [18, 270157], [25, 270617], [28, 270837], [35, 271237], [38, 271437], [47, 271777]]}, {"verse": 33, "start": 272813, "end": 278117, "text": "¡Serpientes, generación de víboras! ¿cómo evitaréis el juicio del infierno?", "words": [[0, 273252], [13, 273692], [24, 274472], [27, 274922], [36, 275538], [42, 275722], [52, 276462], [55, 276642], [62, 277042], [66, 277222]]}, {"verse": 34, "start": 278467, "end": 293587, "text": "Por tanto, he aquí, yo envío a vosotros profetas, y sabios, y escribas: y de ellos, a unos mataréis y crucificaréis, y a otros de ellos azotaréis en vuestras sinagogas, y perseguiréis de ciudad en ciudad:", "words": [[0, 278467], [4, 278572], [11, 279092], [14, 279192], [20, 279992], [23, 280112], [29, 280552], [31, 280612], [40, 281052], [50, 281692], [52, 281892], [60, 282492], [62, 282692], [72, 283751], [74, 283919], [77, 284019], [84, 284359], [86, 284579], [91, 284759], [100, 285659], [102, 286139], [117, 287259], [119, 287459], [121, 287559], [127, 287839], [130, 288079], [136, 288579], [146, 289079], [149, 289199], [158, 289599], [169, 290579], [171, 290779], [184, 291779], [187, 292139], [194, 292499], [197, 292879]]}, {"verse": 35, "start": 293937, "end": 308664, "text": "Para que venga sobre vosotros toda la sangre justa que se ha derramado sobre la tierra, desde la sangre de Abel el justo, hasta la sangre de Zacarías, hijo de Berequías, al cual matasteis entre el templo y el altar.", "words": [[0, 293937], [5, 294081], [9, 294311], [15, 294541], [21, 294821], [30, 295421], [35, 295681], [38, 295921], [45, 296301], [51, 296841], [55, 296961], [58, 297161], [61, 297301], [71, 297941], [77, 298241], [80, 298461], [88, 298861], [94, 299481], [97, 299701], [104, 300081], [107, 300281], [112, 300581], [115, 300821], [122, 301641], [128, 301881], [131, 302061], [138, 302441], [141, 302661], [151, 303764], [156, 304037], [159, 304257], [170, 304987], [173, 305717], [178, 305877], [188, 306777], [194, 307137], [197, 307397], [204, 307877], [206, 307977], [209, 308117]]}, {"verse": 36, "start": 309014, "end": 313267, "text": "De cierto os digo que todo esto vendrá sobre esta generación.", "words": [[0, 309014], [3, 309161], [10, 309421], [13, 309821], [18, 310121], [22, 310381], [27, 310641], [32, 311001], [39, 311561], [45, 311921], [50, 312261]]}, {"verse": 37, "start": 313617, "end": 327147, "text": "¡Jerusalén, Jerusalén, que matas a los profetas, y apedreas a los que son enviados a ti! ¡cuántas veces quise juntar tus hijos, como la gallina junta sus pollos debajo de las alas, y no quisiste!", "words": [[0, 313617], [12, 314500], [23, 315620], [27, 315680], [33, 316100], [35, 316200], [39, 316300], [49, 316860], [51, 317380], [60, 318020], [62, 318240], [66, 318360], [70, 318480], [74, 318720], [83, 319380], [85, 319580], [89, 320089], [98, 320506], [104, 320766], [110, 321266], [117, 321846], [121, 322026], [128, 323066], [133, 323226], [136, 323406], [144, 323826], [150, 324226], [154, 324446], [161, 324886], [168, 325246], [171, 325406], [175, 325546], [181, 325986], [183, 326246], [186, 326366]]}, {"verse": 38, "start": 327497, "end": 330136, "text": "He aquí vuestra casa os es dejada desierta.", "words": [[0, 327546], [3, 327626], [8, 327786], [16, 328166], [21, 328466], [24, 328746], [27, 328906], [34, 329539]]}, {"verse": 39, "start": 330486, "end": 338282, "text": "Porque os digo que desde ahora no me veréis, hasta que digáis: Bendito el que viene en el nombre del Señor.", "words": [[0, 330486], [7, 330712], [10, 330892], [15, 331092], [19, 331292], [25, 331512], [31, 331872], [34, 332112], [37, 332252], [45, 332772], [51, 333432], [55, 333652], [63, 334682], [71, 335426], [74, 335886], [78, 336086], [84, 336486], [87, 336886], [90, 337046], [97, 337426], [101, 337686]]}]}