{"book": "PSA", "chapter": 83, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 112316, "verses": [{"verse": 1, "start": 300, "end": 6506, "text": "Canción: Salmo de Asaf. OH Dios, no tengas silencio: no calles, oh Dios, ni te estés quieto.", "words": [[0, 300], [9, 1457], [15, 1899], [18, 2079], [24, 2980], [27, 3060], [33, 3300], [36, 3610], [43, 3920], [53, 5136], [56, 5416], [64, 5696], [67, 5976], [73, 6096], [76, 6215], [79, 6335], [85, 6455]]}, {"verse": 2, "start": 6956, "end": 13759, "text": "Porque he aquí que rugen tus enemigos; y tus aborrecedores han alzado cabeza.", "words": [[0, 8103], [7, 8423], [10, 8703], [15, 9043], [19, 9393], [25, 9743], [29, 9903], [39, 11024], [41, 11224], [45, 11734], [59, 12244], [63, 12504], [70, 13004]]}, {"verse": 3, "start": 14209, "end": 21434, "text": "Sobre tu pueblo han consultado astuta y secretamente, y han entrado en consejo contra tus escondidos.", "words": [[0, 14209], [6, 14511], [9, 14731], [16, 15171], [20, 15431], [31, 16211], [38, 16711], [40, 16831], [54, 17591], [56, 18191], [60, 18351], [68, 18991], [71, 19151], [79, 19851], [86, 20231], [90, 20491]]}, {"verse": 4, "start": 21884, "end": 27743, "text": "Han dicho: Venid, y cortémoslos de ser pueblo, y no haya más memoria del nombre de Israel.", "words": [[0, 22141], [4, 22397], [11, 22877], [18, 23241], [20, 23691], [32, 24141], [35, 24341], [39, 24521], [47, 25321], [49, 25481], [52, 25601], [57, 25821], [61, 26061], [69, 26561], [73, 26741], [80, 27041], [83, 27221]]}, {"verse": 5, "start": 28093, "end": 33251, "text": "Por esto han conspirado de corazón a una, contra ti han hecho liga;", "words": [[0, 28093], [4, 28236], [9, 28536], [13, 29016], [24, 29836], [27, 29996], [35, 30436], [37, 30816], [42, 31396], [49, 31936], [52, 32096], [56, 32356], [62, 32576]]}, {"verse": 6, "start": 33701, "end": 39664, "text": "Las tiendas de los edomitas y de los ismaelitas, Moab y los agarenos;", "words": [[0, 33701], [4, 33827], [12, 34287], [15, 34387], [19, 34527], [28, 35127], [30, 35327], [33, 35427], [37, 35587], [49, 36687], [54, 37347], [56, 37847], [60, 38782]]}, {"verse": 7, "start": 40114, "end": 44714, "text": "Gebal, y Amón, y Amalec; los filisteos con los habitantes de Tiro.", "words": [[0, 40389], [7, 40699], [9, 40972], [15, 41245], [17, 41519], [25, 42032], [29, 42172], [39, 43012], [43, 43292], [47, 43412], [58, 44052], [61, 44192]]}, {"verse": 8, "start": 45164, "end": 53402, "text": "También el Assur se ha juntado con ellos: son por brazo a los hijos de Lot. (Selah.)", "words": [[0, 45164], [8, 45508], [11, 45968], [17, 46428], [20, 46888], [23, 46988], [31, 47548], [35, 47788], [42, 50107], [46, 50107], [50, 50107], [56, 50107], [58, 50214], [62, 50354], [68, 50654], [71, 50894], [76, 52938]]}, {"verse": 9, "start": 53852, "end": 59498, "text": "Hazles como a Madián; como a Sísara, como a Jabín en el arroyo de Cisón;", "words": [[0, 53852], [7, 53852], [12, 54073], [14, 54913], [22, 56014], [27, 56201], [29, 56511], [37, 56821], [42, 57141], [44, 57471], [50, 57801], [53, 58081], [56, 58391], [63, 58701], [66, 58881]]}, {"verse": 10, "start": 59948, "end": 64494, "text": "Que perecieron en Endor, fueron hechos estiércol para la tierra.", "words": [[0, 59948], [4, 60381], [15, 60851], [18, 61151], [25, 61591], [32, 62111], [39, 62571], [49, 63331], [54, 63631], [57, 63791]]}, {"verse": 11, "start": 64944, "end": 74033, "text": "Pon a ellos y a sus capitanes como a Oreb y como a Zeeb; y como a Zeba y como a Zalmuna, a todos sus príncipes;", "words": [[0, 65029], [4, 65149], [6, 65289], [12, 65649], [14, 65949], [16, 66089], [20, 66249], [30, 67089], [35, 67309], [37, 67589], [42, 67989], [44, 68449], [49, 68749], [51, 69215], [57, 69925], [59, 70032], [64, 70292], [66, 70592], [71, 70892], [73, 71032], [78, 71252], [80, 71752], [89, 72252], [91, 72372], [97, 72652], [101, 73052]]}, {"verse": 12, "start": 74483, "end": 78102, "text": "Que han dicho: Heredemos para nosotros las moradas de Dios.", "words": [[0, 74483], [4, 74605], [8, 74725], [15, 75447], [25, 75930], [30, 76170], [39, 76630], [43, 76890], [51, 77370], [54, 77570]]}, {"verse": 13, "start": 78452, "end": 83984, "text": "Dios mío, ponlos como a torbellinos; como a hojarascas delante del viento.", "words": [[0, 78452], [5, 78660], [10, 79140], [17, 79620], [22, 80206], [24, 80792], [37, 81619], [42, 81824], [44, 82254], [55, 82684], [63, 83124], [67, 83364]]}, {"verse": 14, "start": 84434, "end": 88679, "text": "Como fuego que quema el monte, como llama que abrasa las breñas.", "words": [[0, 84434], [5, 84599], [11, 84919], [15, 85199], [21, 85459], [24, 85599], [31, 86559], [36, 86719], [42, 86999], [46, 87349], [53, 87699], [57, 87839]]}, {"verse": 15, "start": 89129, "end": 93855, "text": "Persíguelos así con tu tempestad, y asómbralos con tu torbellino.", "words": [[0, 89129], [12, 90153], [16, 90453], [20, 90693], [23, 91123], [34, 91553], [36, 91973], [47, 92733], [51, 92913], [54, 93398]]}, {"verse": 16, "start": 94305, "end": 99326, "text": "Llena sus rostros de vergüenza; y busquen tu nombre, oh Jehová.", "words": [[0, 94305], [6, 94731], [10, 94931], [18, 95611], [21, 95791], [32, 97036], [34, 97160], [42, 97660], [45, 97840], [53, 98240], [56, 98640]]}, {"verse": 17, "start": 99776, "end": 105625, "text": "Sean afrentados y turbados para siempre; y sean deshonrados, y perezcan.", "words": [[0, 99776], [5, 100136], [16, 100996], [18, 101196], [27, 101736], [32, 101996], [41, 103178], [43, 103303], [48, 103563], [61, 104503], [63, 104723]]}, {"verse": 18, "start": 106075, "end": 111916, "text": "Y conozcan que tu nombre es JEHOVÁ; tú solo Altísimo sobre toda la tierra.", "words": [[0, 106075], [2, 106326], [11, 106926], [15, 107106], [18, 107266], [25, 107586], [28, 107986], [36, 109170], [39, 109275], [44, 109575], [53, 110295], [59, 110655], [64, 110955], [67, 111215]]}]}