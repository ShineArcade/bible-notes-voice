{"book": "MAT", "chapter": 25, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 308334, "verses": [{"verse": 1, "start": 300, "end": 6789, "text": "Then shall the kingdom of heaven be likened to ten virgins, which took their lamps, and went forth to meet the bridegroom.", "words": [[0, 300], [5, 528], [11, 808], [15, 968], [23, 1228], [26, 1448], [33, 1708], [36, 1968], [44, 2408], [47, 2488], [51, 2688], [60, 3528], [66, 3688], [71, 3908], [77, 4128], [84, 4928], [88, 5068], [93, 5248], [99, 5568], [102, 5828], [107, 5968], [111, 6128]]}, {"verse": 2, "start": 7139, "end": 9968, "text": "And five of them were wise, and five were foolish.", "words": [[0, 7139], [4, 7265], [9, 7505], [12, 7665], [17, 7845], [22, 7965], [28, 8345], [32, 8845], [37, 9125], [42, 9345]]}, {"verse": 3, "start": 10317, "end": 13557, "text": "They that were foolish took their lamps, and took no oil with them:", "words": [[0, 10317], [5, 10421], [10, 10561], [15, 10701], [23, 11021], [28, 11301], [34, 11501], [41, 11861], [45, 12321], [50, 12521], [53, 12721], [57, 13001], [62, 13261]]}, {"verse": 4, "start": 13907, "end": 16544, "text": "But the wise took oil in their vessels with their lamps.", "words": [[0, 13907], [4, 14007], [8, 14127], [13, 14407], [18, 14707], [22, 15027], [25, 15247], [31, 15347], [39, 15627], [44, 15907], [50, 16007]]}, {"verse": 5, "start": 16894, "end": 19891, "text": "While the bridegroom was delayed, they all slumbered and slept.", "words": [[0, 16894], [6, 16999], [10, 17119], [21, 17579], [25, 17739], [34, 18519], [39, 18639], [43, 18759], [53, 19299], [57, 19379]]}, {"verse": 6, "start": 20241, "end": 25228, "text": "And at mid night there was a cry made Behold the bridegroom comes go you out to meet him", "words": [[0, 20241], [4, 20363], [7, 20550], [11, 20736], [17, 20923], [23, 21263], [27, 21423], [29, 21543], [33, 21903], [38, 22183], [45, 22828], [49, 22888], [60, 23488], [66, 23888], [69, 24088], [73, 24248], [77, 24468], [80, 24668], [85, 24848]]}, {"verse": 7, "start": 25578, "end": 28832, "text": "Then all those virgins arose, and trimmed their lamps.", "words": [[0, 25578], [5, 25717], [9, 25937], [15, 26157], [23, 26617], [30, 27077], [34, 27637], [42, 27937], [48, 28177]]}, {"verse": 8, "start": 29182, "end": 33570, "text": "And the foolish said to the wise, Give us of your oil; for our lamps are gone out.", "words": [[0, 29182], [4, 29300], [8, 29400], [16, 29680], [21, 30000], [24, 30160], [28, 30260], [34, 30960], [39, 31100], [42, 31260], [45, 31380], [50, 31500], [55, 32150], [59, 32274], [63, 32414], [69, 32714], [73, 32894], [78, 33074]]}, {"verse": 9, "start": 33920, "end": 41820, "text": "But the wise answered, saying, Not so; lest there be not enough for us and you: but go rather to them that sell, and buy for yourselves.", "words": [[0, 33920], [4, 34000], [8, 34120], [13, 34340], [23, 34780], [31, 35360], [35, 35580], [39, 36288], [44, 36471], [50, 36631], [53, 36731], [57, 36931], [64, 37171], [68, 37391], [71, 37551], [75, 37691], [80, 38256], [84, 38376], [87, 38596], [94, 38876], [97, 39116], [102, 39356], [107, 39576], [113, 39996], [117, 40496], [121, 40836], [125, 41056]]}, {"verse": 10, "start": 42170, "end": 48810, "text": "And while they went to buy, the bridegroom came; and they that were ready went in with him to the marriage: and the door was shut.", "words": [[0, 42170], [4, 42275], [10, 42475], [15, 42655], [20, 42815], [23, 42955], [28, 43575], [32, 43675], [43, 44175], [49, 44765], [53, 44945], [58, 45105], [63, 45305], [68, 45425], [74, 45705], [79, 45985], [82, 46205], [87, 46385], [91, 46545], [94, 46665], [98, 46785], [108, 47617], [112, 47736], [116, 47836], [121, 48116], [125, 48316]]}, {"verse": 11, "start": 49160, "end": 53217, "text": "Afterward came also the other virgins, saying, Lord, Lord, open to us.", "words": [[0, 49160], [10, 49538], [15, 49818], [20, 50118], [24, 50318], [30, 50498], [39, 50958], [47, 51538], [53, 52098], [59, 52418], [64, 52638], [67, 52898]]}, {"verse": 12, "start": 53567, "end": 57218, "text": "But he answered and said, Assuredly I say to you, I know you not.", "words": [[0, 53567], [4, 53673], [7, 53773], [16, 54113], [20, 54353], [26, 54813], [36, 55453], [38, 55533], [42, 55713], [45, 55873], [50, 56293], [52, 56413], [57, 56613], [61, 56773]]}, {"verse": 13, "start": 57568, "end": 62375, "text": "Watch therefore, for you know neither the day nor the hour in which the Son of man comes.", "words": [[0, 57568], [6, 57861], [17, 58361], [21, 58661], [25, 58801], [30, 59001], [38, 59221], [42, 59461], [46, 59741], [50, 59981], [54, 60141], [59, 60461], [62, 60701], [68, 60861], [72, 61061], [76, 61301], [79, 61401], [83, 61681]]}, {"verse": 14, "start": 62725, "end": 69508, "text": "¶ For the kingdom of heaven is as a man travelling into a far country, who called his own servants, and delivered to them his goods.", "words": [[2, 62725], [6, 62835], [10, 62935], [18, 63235], [21, 63475], [28, 63735], [31, 63995], [34, 64155], [36, 64275], [40, 64655], [51, 65035], [56, 65355], [58, 65535], [62, 65775], [71, 66215], [75, 66430], [82, 66710], [86, 66930], [90, 67110], [100, 67510], [104, 68050], [114, 68370], [117, 68590], [122, 68790], [126, 68950]]}, {"verse": 15, "start": 69858, "end": 78542, "text": "And to one he gave five talents, to another two, and to another one; to every man according to his several ability; and immediately took his journey.", "words": [[0, 69858], [4, 70039], [7, 70199], [11, 70519], [14, 70759], [19, 70939], [24, 71279], [33, 72139], [36, 72239], [44, 72519], [49, 73159], [53, 73299], [56, 73499], [64, 73739], [69, 74383], [72, 74503], [78, 74763], [82, 75083], [92, 75423], [95, 75683], [99, 75823], [107, 76083], [116, 76937], [120, 77082], [132, 77422], [137, 77882], [141, 78082]]}, {"verse": 16, "start": 78892, "end": 84698, "text": "Then he that had received the five talents went and traded with the same, and made them other five talents.", "words": [[0, 78892], [5, 79036], [8, 79336], [13, 79676], [17, 79816], [26, 80196], [30, 80436], [35, 80676], [43, 81076], [48, 81376], [52, 81636], [59, 81916], [64, 82136], [68, 82316], [74, 82636], [78, 83116], [83, 83316], [88, 83536], [94, 83756], [99, 84076]]}, {"verse": 17, "start": 85048, "end": 88753, "text": "And likewise he that had received two, he also gained other two.", "words": [[0, 85048], [4, 85173], [13, 85793], [16, 85893], [21, 86053], [25, 86213], [34, 86493], [39, 87293], [42, 87413], [47, 87673], [54, 88013], [60, 88293]]}, {"verse": 18, "start": 89103, "end": 93630, "text": "But he that had received one went and dug in the earth, and hid his lord’s money.", "words": [[0, 89103], [4, 89205], [7, 89405], [12, 89605], [16, 89745], [25, 90105], [29, 90505], [34, 90925], [38, 91165], [42, 91425], [45, 91585], [49, 91705], [56, 92005], [60, 92365], [64, 92625], [68, 92825], [75, 93265]]}, {"verse": 19, "start": 93980, "end": 98047, "text": "After a long time the lord of those servants comes, and reckons with them.", "words": [[0, 93980], [6, 94222], [8, 94402], [13, 94582], [18, 95262], [22, 95342], [27, 95602], [30, 95722], [36, 95882], [45, 96242], [52, 96622], [56, 97082], [64, 97522], [69, 97722]]}, {"verse": 20, "start": 98397, "end": 109262, "text": "And so he that had received five talents came and brought other five talents, saying, Lord, you delivered to me five talents: behold, I have gained beside them five talents more.", "words": [[0, 98397], [4, 98517], [7, 98817], [10, 99137], [15, 99437], [19, 99617], [28, 100017], [33, 100457], [41, 100877], [46, 101217], [50, 101437], [58, 101637], [64, 101917], [69, 102197], [78, 102737], [86, 103417], [92, 104017], [96, 104077], [106, 104417], [109, 104657], [112, 104797], [117, 105097], [126, 105994], [134, 106775], [136, 106955], [141, 107095], [148, 107375], [155, 107655], [160, 108035], [165, 108335], [173, 108715]]}, {"verse": 21, "start": 109612, "end": 120539, "text": "His lord said to him, Well done, you good and faithful servant: you have been faithful over a few things, I will make you ruler over many things: enter into the joy of your lord.", "words": [[0, 109662], [4, 109752], [9, 109972], [14, 110252], [17, 110452], [22, 110952], [27, 111292], [33, 112052], [37, 112192], [42, 112532], [46, 112772], [55, 113152], [64, 113995], [68, 114136], [73, 114316], [78, 114516], [87, 114936], [92, 115236], [94, 115416], [98, 115576], [106, 116236], [108, 116416], [113, 116576], [118, 116776], [122, 116956], [128, 117276], [133, 117596], [138, 117896], [146, 118729], [152, 118989], [157, 119329], [161, 119489], [165, 119789], [168, 119969], [173, 120069]]}, {"verse": 22, "start": 120889, "end": 130327, "text": "He also that had received two talents came and said, Lord, you delivered to me two talents: behold, I have gained two other talents beside them.", "words": [[0, 120889], [3, 120988], [8, 121328], [13, 121608], [17, 121748], [26, 122088], [30, 122388], [38, 122788], [43, 123168], [47, 123408], [53, 124028], [59, 124848], [63, 124948], [73, 125308], [76, 125548], [79, 125728], [83, 125968], [92, 126883], [100, 127685], [102, 127945], [107, 128105], [114, 128425], [118, 128725], [124, 129005], [132, 129425], [139, 129825]]}, {"verse": 23, "start": 130677, "end": 142802, "text": "His lord said to him, Well done, good and faithful servant; you have been faithful over a few things, I will make you ruler over many things: enter into the joy of your lord.", "words": [[0, 130677], [4, 130815], [9, 131115], [14, 131395], [17, 131575], [22, 132075], [27, 132415], [33, 133175], [38, 133635], [42, 133715], [51, 134095], [60, 136171], [64, 136371], [69, 136551], [74, 136711], [83, 137111], [88, 137411], [90, 137611], [94, 137731], [102, 138511], [104, 138771], [109, 138911], [114, 139111], [118, 139271], [124, 139611], [129, 139931], [134, 140211], [142, 141118], [148, 141382], [153, 141622], [157, 141782], [161, 142042], [164, 142222], [169, 142322]]}, {"verse": 24, "start": 143082, "end": 154212, "text": "Then he which had received the one talent came and said, Lord, I knew you that you are a hard man, reaping where you have not sown, and gathering where you have not scattered:", "words": [[0, 143082], [5, 143347], [8, 143847], [14, 144027], [18, 144227], [27, 144607], [31, 144927], [35, 145167], [42, 145727], [47, 145947], [51, 146287], [57, 146923], [63, 147410], [65, 147610], [70, 147910], [74, 148390], [79, 148550], [83, 148750], [87, 148950], [89, 149050], [94, 149310], [99, 150150], [107, 150610], [113, 150770], [117, 150930], [122, 151070], [126, 151270], [132, 152170], [136, 152290], [146, 152650], [152, 152990], [156, 153170], [161, 153310], [165, 153510]]}, {"verse": 25, "start": 154562, "end": 160341, "text": "And I was afraid, and went and hid your talent in the earth: lo, there you have that is yours.", "words": [[0, 154562], [4, 154720], [6, 154880], [10, 155040], [18, 155740], [22, 156100], [27, 156340], [31, 156620], [35, 156800], [40, 156980], [47, 157340], [50, 157560], [54, 157700], [61, 158429], [65, 158779], [71, 158879], [75, 159059], [80, 159499], [85, 159579], [88, 159739]]}, {"verse": 26, "start": 160691, "end": 168913, "text": "His lord answered and said to him, You wicked and slothful servant, you knew that I reap where I sowed not, and gather where I have not scattered:", "words": [[0, 160691], [4, 160851], [9, 161091], [18, 161551], [22, 161791], [27, 161991], [30, 162151], [35, 162831], [39, 163091], [46, 163451], [50, 163671], [59, 164171], [68, 165051], [72, 165131], [77, 165331], [82, 165531], [84, 165671], [89, 165891], [95, 166131], [97, 166291], [103, 166651], [108, 167191], [112, 167331], [119, 167611], [125, 167851], [127, 168011], [132, 168151], [136, 168311]]}, {"verse": 27, "start": 169263, "end": 176634, "text": "You ought therefore to have put my money to the exchangers, and then at my coming I should have received my own with usury.", "words": [[0, 169263], [4, 169441], [10, 169641], [20, 170101], [23, 170321], [28, 170481], [32, 170701], [35, 170921], [41, 171241], [44, 171401], [48, 171541], [60, 172761], [64, 172961], [69, 173161], [72, 173321], [75, 173481], [82, 173841], [84, 174301], [91, 174481], [96, 174601], [105, 174961], [108, 175321], [112, 175681], [117, 175941]]}, {"verse": 28, "start": 176984, "end": 181545, "text": "Take therefore the talent from him, and give it to him which has ten talents.", "words": [[0, 176984], [5, 177180], [15, 177620], [19, 177880], [26, 178220], [31, 178500], [36, 179140], [40, 179340], [45, 179520], [48, 179660], [51, 179840], [55, 180080], [61, 180300], [65, 180540], [69, 180840]]}, {"verse": 29, "start": 181895, "end": 189964, "text": "For to every one that has shall be given, and he shall have abundance: but from him that has not shall be taken away even that which he has.", "words": [[0, 181895], [4, 182004], [7, 182151], [13, 182297], [17, 182444], [22, 182884], [26, 183104], [32, 183384], [35, 183584], [42, 184144], [46, 184404], [49, 184564], [55, 184784], [60, 184984], [71, 185966], [75, 186062], [80, 186262], [84, 186482], [89, 186682], [93, 186822], [97, 187142], [103, 187602], [106, 187762], [112, 188022], [117, 188362], [122, 188762], [127, 189062], [133, 189262], [136, 189422]]}, {"verse": 30, "start": 190314, "end": 195608, "text": "And cast the unprofitable servant into outer darkness: there shall be weeping and gnashing of teeth.", "words": [[0, 190314], [4, 190416], [9, 190716], [13, 190916], [26, 191636], [34, 192036], [39, 192396], [45, 192676], [55, 193655], [61, 193738], [67, 193898], [70, 194058], [78, 194478], [82, 194678], [91, 195098], [94, 195258]]}, {"verse": 31, "start": 195958, "end": 203961, "text": "¶ When the Son of man shall come in his glory, and all the holy angels with him, then shall he sit upon the throne of his glory:", "words": [[2, 195958], [7, 196129], [11, 196249], [15, 196529], [18, 196649], [22, 196989], [28, 197289], [33, 197549], [36, 197689], [40, 197829], [47, 198689], [51, 198849], [55, 199209], [59, 199369], [64, 199629], [71, 200089], [76, 200429], [81, 201009], [86, 201349], [92, 201669], [95, 201849], [99, 202129], [104, 202469], [108, 202749], [115, 203069], [118, 203289], [122, 203409]]}, {"verse": 32, "start": 204311, "end": 211722, "text": "And before him shall be gathered all nations: and he shall separate them one from another, as a shepherd divides his sheep from the goats:", "words": [[0, 204311], [4, 204433], [11, 204733], [15, 204973], [21, 205193], [24, 205333], [33, 205653], [37, 206013], [46, 206932], [50, 207037], [53, 207157], [59, 207337], [68, 207777], [73, 208077], [77, 208317], [82, 208537], [91, 209157], [94, 209497], [96, 209597], [105, 209877], [113, 210277], [117, 210597], [123, 210857], [128, 211097], [132, 211257]]}, {"verse": 33, "start": 212072, "end": 216002, "text": "And he shall set the sheep on his right hand, but the goats on the left.", "words": [[0, 212072], [4, 212197], [7, 212357], [13, 212557], [17, 212817], [21, 212997], [27, 213237], [30, 213457], [34, 213637], [40, 213857], [46, 214557], [50, 214797], [54, 214937], [60, 215157], [63, 215417], [67, 215537]]}, {"verse": 34, "start": 216352, "end": 225176, "text": "Then shall the King say to them on his right hand, Come, you blessed of my Father, inherit the kingdom prepared for you from the foundation of the world:", "words": [[0, 216352], [5, 216588], [11, 216868], [15, 217048], [20, 217248], [24, 217548], [27, 217728], [32, 217928], [35, 218088], [39, 218288], [45, 218488], [51, 219288], [57, 220048], [61, 220148], [69, 220448], [72, 220668], [75, 220848], [83, 221688], [91, 221968], [95, 222268], [103, 222548], [112, 222948], [116, 223288], [120, 223448], [125, 223648], [129, 223788], [140, 224288], [143, 224528], [147, 224648]]}, {"verse": 35, "start": 225526, "end": 232604, "text": "For I was hungry, and you gave me food: I was thirsty, and you gave me drink: I was a stranger, and you took me in:", "words": [[0, 225526], [4, 225664], [6, 225864], [10, 226024], [18, 226604], [22, 226944], [26, 227064], [31, 227224], [34, 227384], [40, 228158], [42, 228279], [46, 228439], [55, 228859], [59, 229259], [63, 229359], [68, 229519], [71, 229679], [78, 230519], [80, 230699], [84, 230839], [86, 230939], [96, 231379], [100, 231759], [104, 231879], [109, 232019], [112, 232219]]}, {"verse": 36, "start": 232954, "end": 238438, "text": "Naked, and you clothed me: I was sick, and you visited me: I was in prison, and you came to me.", "words": [[0, 232954], [7, 233334], [11, 233694], [15, 233934], [23, 234174], [27, 234685], [29, 234829], [33, 235009], [39, 235289], [43, 235489], [47, 235609], [55, 235889], [59, 236557], [61, 236702], [65, 236842], [68, 237002], [76, 237282], [80, 237562], [84, 237702], [89, 237942], [92, 238142]]}, {"verse": 37, "start": 238788, "end": 245433, "text": "Then shall the righteous answer him, saying, Lord, when saw we you hungry, and fed you? or thirsty, and gave you drink?", "words": [[0, 238788], [5, 238971], [11, 239231], [15, 239391], [25, 239671], [32, 240111], [37, 240431], [45, 240871], [51, 241631], [56, 241771], [60, 242031], [63, 242231], [67, 242351], [75, 242711], [79, 242931], [83, 243171], [88, 243806], [91, 243926], [100, 244306], [104, 244626], [109, 244826], [113, 244966]]}, {"verse": 38, "start": 245783, "end": 250082, "text": "When saw we you a stranger, and took you in? or naked, and clothed you?", "words": [[0, 245783], [5, 245922], [9, 246202], [12, 246442], [16, 246622], [18, 246742], [28, 247182], [32, 247602], [37, 247802], [41, 247962], [45, 248592], [48, 248716], [55, 249076], [59, 249276], [67, 249816]]}, {"verse": 39, "start": 250432, "end": 253693, "text": "Or when saw we you sick, or in prison, and came to you?", "words": [[0, 250432], [3, 250555], [8, 250755], [12, 251015], [15, 251235], [19, 251395], [25, 251735], [28, 252135], [31, 252275], [39, 252575], [43, 252955], [48, 253195], [51, 253375]]}, {"verse": 40, "start": 254043, "end": 263040, "text": "And the King shall answer and say to them, Assuredly I say to you, Inasmuch as you have done it to one of the least of these my brethren, you have done it to me.", "words": [[0, 254043], [4, 254185], [8, 254305], [13, 254545], [19, 254805], [26, 255205], [30, 255405], [34, 255645], [37, 255805], [43, 256365], [53, 257005], [55, 257205], [59, 257425], [62, 257625], [67, 258445], [76, 258845], [79, 259005], [83, 259145], [88, 259245], [93, 259465], [96, 259565], [99, 259705], [103, 259845], [106, 259965], [110, 260065], [116, 260345], [119, 260525], [125, 260885], [128, 260965], [138, 261798], [142, 261980], [147, 262180], [152, 262420], [155, 262560], [158, 262720]]}, {"verse": 41, "start": 263390, "end": 271371, "text": "Then shall he say also to them on the left hand, Depart from me, you cursed, into everlasting fire, prepared for the devil and his angels:", "words": [[0, 263390], [5, 263595], [11, 263855], [14, 264015], [18, 264215], [23, 264555], [26, 264755], [31, 264935], [34, 265115], [38, 265235], [43, 265435], [49, 266115], [56, 266375], [61, 266695], [65, 267015], [69, 267135], [77, 267875], [82, 268015], [94, 268475], [100, 269495], [109, 269795], [113, 270015], [117, 270135], [123, 270415], [127, 270615], [131, 270775]]}, {"verse": 42, "start": 271721, "end": 276632, "text": "For I was hungry, and you gave me no food: I was thirsty, and you gave me no drink:", "words": [[0, 271721], [4, 271921], [6, 272181], [10, 272321], [18, 272701], [22, 273121], [26, 273221], [31, 273381], [34, 273541], [37, 273701], [43, 274478], [45, 274587], [49, 274727], [58, 275127], [62, 275527], [66, 275647], [71, 275787], [74, 275947], [77, 276107]]}, {"verse": 43, "start": 276982, "end": 284301, "text": "I was a stranger, and you took me not in: naked, and you clothed me not: sick, and in prison, and you visited me not.", "words": [[0, 276982], [2, 277088], [6, 277188], [8, 277288], [18, 277688], [22, 278248], [26, 278368], [31, 278508], [34, 278668], [38, 278848], [42, 279568], [49, 279998], [53, 280298], [57, 280418], [65, 281018], [68, 281138], [73, 281906], [79, 282229], [83, 282429], [86, 282569], [94, 282869], [98, 283129], [102, 283249], [110, 283569], [113, 283849]]}, {"verse": 44, "start": 284651, "end": 294340, "text": "Then shall they also answer him, saying, Lord, when saw we you hungry, or thirsty, or a stranger, or naked, or sick, or in prison, and did not minister to you?", "words": [[0, 284651], [5, 284885], [11, 285125], [16, 285305], [21, 285605], [28, 286025], [33, 286445], [41, 286945], [47, 287685], [52, 287845], [56, 288145], [59, 288345], [63, 288505], [71, 289105], [74, 289165], [83, 289905], [86, 289925], [88, 289945], [98, 290785], [101, 290825], [108, 291385], [111, 291445], [117, 291945], [120, 291985], [123, 292105], [131, 292905], [135, 293013], [139, 293153], [143, 293333], [152, 293753], [155, 294013]]}, {"verse": 45, "start": 294690, "end": 302175, "text": "Then shall he answer them, saying, Assuredly I say to you, Inasmuch as you did it not to one of the least of these, you did it not to me.", "words": [[0, 294690], [5, 294862], [11, 295162], [14, 295322], [21, 295622], [27, 295962], [35, 296602], [45, 297182], [47, 297322], [51, 297562], [54, 297722], [59, 298262], [68, 298782], [71, 298942], [75, 299062], [79, 299242], [82, 299342], [86, 299542], [89, 299742], [93, 299882], [96, 299982], [100, 300082], [106, 300282], [109, 300442], [116, 301022], [120, 301142], [124, 301302], [127, 301422], [131, 301622], [134, 301822]]}, {"verse": 46, "start": 302525, "end": 307934, "text": "And these shall go away into everlasting punishment: but the righteous into life eternal.", "words": [[0, 302525], [4, 302666], [10, 302886], [16, 303186], [19, 303386], [24, 303786], [29, 304146], [41, 304646], [53, 305874], [57, 305960], [61, 306100], [71, 306520], [76, 306880], [81, 307220]]}]}