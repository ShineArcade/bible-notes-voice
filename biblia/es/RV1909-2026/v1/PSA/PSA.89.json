{"book": "PSA", "chapter": 89, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 316431, "verses": [{"verse": 1, "start": 300, "end": 10497, "text": "Masquil de Etán ezraíta. LAS misericordias de Jehová cantaré perpetuamente: en generación y generación haré notoria tu verdad con mi boca.", "words": [[0, 300], [8, 962], [11, 1202], [16, 1928], [25, 3100], [29, 3406], [43, 3713], [46, 3833], [53, 4253], [61, 4733], [76, 6300], [79, 6448], [90, 7208], [92, 7428], [103, 8168], [108, 8508], [116, 9028], [119, 9208], [126, 9408], [130, 9788], [133, 9968]]}, {"verse": 2, "start": 10847, "end": 17936, "text": "Porque dije: Para siempre será edificada misericordia; en los mismos cielos apoyarás tu verdad.", "words": [[0, 10847], [7, 11187], [13, 11942], [18, 12128], [26, 12668], [31, 13208], [41, 14088], [55, 15423], [58, 15566], [62, 15706], [69, 15986], [76, 16586], [85, 17226], [88, 17346]]}, {"verse": 3, "start": 18156, "end": 22930, "text": "Hice pacto con mi escogido; juré a David mi siervo, diciendo:", "words": [[0, 18301], [5, 18451], [11, 18971], [15, 19151], [18, 19271], [28, 20482], [33, 20828], [35, 20908], [41, 21268], [44, 21388], [52, 21968]]}, {"verse": 4, "start": 23280, "end": 30199, "text": "Para siempre confirmaré tu descendencia, y edificaré tu trono por todas las generaciones. (Selah.)", "words": [[0, 23280], [5, 23445], [13, 23845], [24, 24585], [27, 24725], [41, 25605], [43, 26065], [53, 26625], [56, 26785], [62, 27165], [66, 27385], [72, 27605], [76, 27885], [90, 29616]]}, {"verse": 5, "start": 30479, "end": 37693, "text": "Y celebrarán los cielos tu maravilla, oh Jehová; tu verdad también en la congregación de los santos.", "words": [[0, 30479], [2, 30586], [13, 31366], [17, 31506], [24, 32026], [27, 32166], [38, 32687], [41, 33209], [49, 33885], [52, 33990], [59, 34270], [67, 34970], [70, 35530], [73, 35670], [86, 36570], [89, 36770], [93, 36890]]}, {"verse": 6, "start": 38043, "end": 45469, "text": "Porque ¿quién en los cielos se igualará con Jehová? ¿quién será semejante a Jehová entre los hijos de los potentados?", "words": [[0, 38043], [7, 38305], [14, 38845], [17, 39045], [21, 39205], [28, 39745], [31, 39885], [40, 40385], [44, 40625], [52, 41495], [59, 41815], [64, 42035], [74, 42755], [76, 42895], [83, 43335], [89, 43535], [93, 43775], [99, 44095], [102, 44255], [106, 44375]]}, {"verse": 7, "start": 45819, "end": 53327, "text": "Dios temible en la grande congregación de los santos, y formidable sobre todos cuantos están alrededor suyo.", "words": [[0, 45819], [5, 46106], [13, 46866], [16, 47086], [19, 47226], [26, 47586], [39, 48446], [42, 48606], [46, 48746], [54, 49606], [56, 50096], [67, 50586], [73, 50826], [79, 51316], [87, 51806], [93, 52086], [103, 52426]]}, {"verse": 8, "start": 53677, "end": 60961, "text": "Oh Jehová, Dios de los ejércitos, ¿quién como tú? Poderoso eres, Jehová, y tu fidelidad te rodea.", "words": [[0, 53872], [3, 54098], [11, 54325], [16, 54565], [19, 54845], [23, 55005], [34, 55985], [41, 56285], [46, 56485], [50, 57253], [59, 57775], [65, 58035], [73, 58815], [75, 59075], [78, 59235], [88, 59995], [91, 60235]]}, {"verse": 9, "start": 61311, "end": 67719, "text": "Tú tienes dominio sobre la bravura del mar: cuando se levantan sus ondas, tú las sosiegas.", "words": [[0, 61311], [3, 61633], [10, 61933], [18, 62533], [24, 62773], [27, 62993], [35, 63433], [39, 63613], [44, 64425], [51, 64765], [54, 64985], [63, 65545], [67, 65745], [74, 66525], [77, 66685], [81, 67223]]}, {"verse": 10, "start": 68069, "end": 75230, "text": "Tú quebrantaste a Rahab como a un muerto: con el brazo de tu fortaleza esparciste a tus enemigos.", "words": [[0, 68069], [3, 68172], [16, 68992], [18, 69222], [24, 69452], [29, 69719], [31, 69985], [34, 70252], [42, 71295], [46, 71587], [49, 71747], [55, 72167], [58, 72287], [61, 72447], [71, 73187], [82, 74027], [84, 74167], [88, 74287]]}, {"verse": 11, "start": 75580, "end": 82115, "text": "Tuyos los cielos, tuya también la tierra: el mundo y su plenitud, tú lo fundaste.", "words": [[0, 75756], [6, 75966], [10, 76106], [18, 76666], [23, 76986], [31, 77346], [34, 77606], [42, 78579], [45, 78739], [51, 79119], [53, 79319], [56, 79479], [66, 80679], [69, 81119], [72, 81259]]}, {"verse": 12, "start": 82465, "end": 88451, "text": "Al norte y al sur tú los creaste: Tabor y Hermón cantarán en tu nombre.", "words": [[0, 82465], [3, 82676], [9, 83156], [11, 83516], [14, 83696], [18, 84299], [21, 84411], [25, 84611], [34, 85698], [40, 86023], [42, 86203], [49, 86873], [58, 87543], [61, 87703], [64, 87843]]}, {"verse": 13, "start": 88801, "end": 94403, "text": "Tuyo el brazo con valentía; fuerte es tu mano, exaltada tu diestra.", "words": [[0, 88801], [5, 89103], [8, 89243], [14, 89623], [18, 89843], [28, 90996], [35, 91433], [38, 91733], [41, 91833], [47, 92653], [56, 93413], [59, 93633]]}, {"verse": 14, "start": 94753, "end": 100969, "text": "Justicia y juicio son el asiento de tu trono: misericordia y verdad van delante de tu rostro.", "words": [[0, 94753], [9, 95312], [11, 95412], [18, 95912], [22, 96327], [25, 96527], [33, 96927], [36, 97127], [39, 97267], [46, 98122], [59, 98927], [61, 99007], [68, 99227], [72, 99547], [80, 99967], [83, 100127], [86, 100287]]}, {"verse": 15, "start": 101319, "end": 107522, "text": "Bienaventurado el pueblo que sabe aclamarte: andarán, oh Jehová, a la luz de tu rostro.", "words": [[0, 101876], [15, 102446], [18, 102586], [25, 102866], [29, 103086], [34, 103670], [45, 104414], [54, 104858], [57, 105338], [65, 105818], [67, 106018], [70, 106098], [74, 106418], [77, 106738], [80, 106878]]}, {"verse": 16, "start": 107872, "end": 113565, "text": "En tu nombre se alegrarán todo el día; y en tu justicia serán ensalzados.", "words": [[0, 107872], [3, 108036], [6, 108196], [13, 108556], [16, 108836], [26, 109556], [31, 109796], [34, 110136], [39, 110826], [41, 111066], [44, 111206], [47, 111366], [56, 112046], [62, 112446]]}, {"verse": 17, "start": 113915, "end": 120556, "text": "Porque tú eres la gloria de su fortaleza; y por tu buena voluntad acrecentarás nuestro poder.", "words": [[0, 113915], [7, 114119], [10, 114439], [15, 114819], [18, 115179], [25, 115639], [28, 115799], [31, 115979], [42, 117170], [44, 117398], [48, 117578], [51, 117738], [57, 117978], [66, 118768], [79, 119558], [87, 119718]]}, {"verse": 18, "start": 120906, "end": 126115, "text": "Porque Jehová es nuestro escudo; y nuestro rey es el Santo de Israel.", "words": [[0, 120906], [7, 121290], [14, 121710], [17, 121950], [25, 122370], [33, 123591], [35, 123678], [43, 123858], [47, 124318], [50, 124598], [53, 124738], [59, 125078], [62, 125358]]}, {"verse": 19, "start": 126465, "end": 135817, "text": "Entonces hablaste en visión a tu santo, y dijiste: Yo he puesto el socorro sobre valiente; he ensalzado un escogido de mi pueblo.", "words": [[0, 126465], [9, 127287], [18, 128227], [21, 128427], [28, 128807], [30, 128947], [33, 129027], [40, 129407], [42, 129547], [51, 130500], [54, 130633], [57, 130753], [64, 130973], [67, 131253], [75, 131693], [81, 131973], [91, 133213], [94, 133395], [104, 134055], [107, 134195], [116, 134755], [119, 134875], [122, 134995]]}, {"verse": 20, "start": 136167, "end": 140470, "text": "Hallé a David mi siervo; lo ungí con el aceite de mi santidad.", "words": [[0, 136268], [6, 136408], [8, 136548], [14, 136928], [17, 137048], [25, 138118], [28, 138376], [33, 138676], [37, 138796], [40, 138916], [47, 139216], [50, 139456], [53, 139556]]}, {"verse": 21, "start": 140820, "end": 145407, "text": "Mi mano será firme con él, mi brazo también lo fortificará.", "words": [[0, 140820], [3, 140946], [8, 141206], [13, 141486], [19, 141966], [23, 142166], [27, 142946], [30, 143126], [36, 143546], [44, 143906], [47, 144166]]}, {"verse": 22, "start": 145757, "end": 150318, "text": "No lo avasallará enemigo, ni hijo de iniquidad lo quebrantará.", "words": [[0, 145757], [3, 145957], [6, 146137], [17, 146877], [26, 147637], [29, 148037], [34, 148337], [37, 148497], [47, 149077], [50, 149237]]}, {"verse": 23, "start": 150668, "end": 156044, "text": "Mas yo quebrantaré delante de él a sus enemigos, y heriré a sus aborrecedores.", "words": [[0, 150668], [4, 150847], [7, 151087], [19, 151767], [27, 152207], [30, 152367], [33, 152527], [35, 152627], [39, 152747], [49, 153407], [51, 153967], [58, 154447], [60, 154607], [64, 154727]]}, {"verse": 24, "start": 156394, "end": 162105, "text": "Y mi verdad y mi misericordia serán con él; y en mi nombre será exaltado su cuerno.", "words": [[0, 156394], [2, 156491], [5, 156571], [12, 156951], [14, 157371], [17, 157471], [30, 158211], [36, 158531], [40, 158671], [44, 159476], [46, 159595], [49, 159695], [52, 159815], [59, 160155], [64, 160475], [73, 161155], [76, 161295]]}, {"verse": 25, "start": 162455, "end": 166494, "text": "Asimismo pondré su mano en el mar, y en los ríos su diestra.", "words": [[0, 162455], [9, 163015], [16, 163375], [19, 163515], [24, 163735], [27, 163875], [30, 163995], [35, 164215], [37, 164615], [40, 164715], [44, 164815], [49, 165315], [52, 165595]]}, {"verse": 26, "start": 166844, "end": 172565, "text": "Él me llamará: Mi padre eres tú, mi Dios, y la roca de mi salvación.", "words": [[0, 166844], [3, 167020], [6, 167140], [15, 168195], [18, 168313], [24, 168713], [29, 168953], [33, 169633], [36, 169713], [42, 170033], [44, 170298], [47, 170418], [52, 170738], [55, 170858], [58, 170958]]}, {"verse": 27, "start": 172785, "end": 177210, "text": "Yo también le pondré por primogénito, alto sobre los reyes de la tierra.", "words": [[0, 172785], [3, 172921], [11, 173161], [14, 173381], [21, 173741], [25, 173901], [38, 175001], [43, 175361], [49, 175701], [53, 175901], [59, 176241], [62, 176341], [65, 176421]]}, {"verse": 28, "start": 177560, "end": 182549, "text": "Para siempre le conservaré mi misericordia; y mi pacto será firme con él.", "words": [[0, 177560], [5, 177722], [13, 178122], [16, 178322], [27, 178922], [30, 179062], [44, 180487], [46, 180559], [49, 180669], [55, 181169], [60, 181349], [66, 181789], [70, 181949]]}, {"verse": 29, "start": 182899, "end": 188373, "text": "Y pondré su descendencia para siempre, y su trono como los días de los cielos.", "words": [[0, 182899], [2, 183006], [9, 183466], [12, 183666], [25, 184526], [30, 184746], [39, 185266], [41, 185746], [44, 185886], [50, 186366], [55, 186606], [59, 186786], [64, 187086], [67, 187306], [71, 187426]]}, {"verse": 30, "start": 188723, "end": 192541, "text": "Si dejan sus hijos mi ley, y no andan en mis juicios;", "words": [[0, 188723], [3, 188868], [9, 189248], [13, 189448], [19, 189768], [22, 190028], [27, 190308], [29, 190768], [32, 190968], [38, 191388], [41, 191508], [45, 191668]]}, {"verse": 31, "start": 192891, "end": 196905, "text": "Si profanan mis estatutos, y no guardan mis mandamientos;", "words": [[0, 192891], [3, 193041], [12, 193581], [16, 193801], [27, 194401], [29, 194981], [32, 195121], [40, 195561], [44, 195721]]}, {"verse": 32, "start": 197255, "end": 202003, "text": "Entonces visitaré con vara su rebelión, y con azotes sus iniquidades.", "words": [[0, 197255], [9, 197715], [18, 198495], [22, 198745], [27, 198995], [30, 199115], [40, 199635], [42, 200075], [46, 200355], [53, 200635], [57, 200855]]}, {"verse": 33, "start": 202353, "end": 206224, "text": "Mas no quitaré de él mi misericordia, ni falsearé mi verdad.", "words": [[0, 202353], [4, 202537], [7, 202677], [15, 203137], [18, 203237], [21, 203377], [24, 203457], [38, 204577], [41, 204927], [50, 205277], [53, 205417]]}, {"verse": 34, "start": 206574, "end": 210864, "text": "No olvidaré mi pacto, ni mudaré lo que ha salido de mis labios.", "words": [[0, 206574], [3, 206778], [12, 207258], [15, 207378], [22, 208338], [25, 208498], [32, 208898], [35, 209058], [39, 209178], [42, 209278], [49, 209658], [52, 209778], [56, 209898]]}, {"verse": 35, "start": 211214, "end": 214792, "text": "Una vez he jurado por mi santidad, que no mentiré a David.", "words": [[0, 211214], [4, 211398], [8, 211638], [11, 211818], [18, 212178], [22, 212358], [25, 212498], [35, 213338], [39, 213438], [42, 213578], [50, 214098], [52, 214138]]}, {"verse": 36, "start": 215142, "end": 219884, "text": "Su descendencia será para siempre, y su trono como el sol delante de mí.", "words": [[0, 215142], [3, 215303], [16, 216103], [21, 216323], [26, 216603], [35, 217063], [37, 217563], [40, 217703], [46, 218123], [51, 218343], [54, 218483], [58, 218683], [66, 219143], [69, 219303]]}, {"verse": 37, "start": 220234, "end": 226346, "text": "Como la luna será firme para siempre, y como un testigo fiel en el cielo. (Selah.)", "words": [[0, 220234], [5, 220398], [8, 220538], [13, 220878], [18, 221098], [24, 221558], [29, 221738], [38, 222178], [40, 222658], [45, 222878], [48, 223018], [56, 223498], [61, 223858], [64, 223998], [67, 224118], [74, 225762]]}, {"verse": 38, "start": 226626, "end": 231433, "text": "Mas tú desechaste y menospreciaste a tu ungido; y te has airado con él.", "words": [[0, 226626], [4, 226826], [7, 227026], [18, 227766], [20, 228286], [35, 228806], [37, 228966], [40, 229066], [48, 230001], [50, 230105], [53, 230345], [57, 230585], [64, 230825], [68, 231065]]}, {"verse": 39, "start": 231783, "end": 237286, "text": "Rompiste el pacto de tu siervo; has profanado su corona hasta la tierra.", "words": [[0, 232109], [9, 232469], [12, 232629], [18, 233209], [21, 233329], [24, 233489], [32, 234373], [36, 234599], [46, 235499], [49, 235719], [56, 236119], [62, 236419], [65, 236599]]}, {"verse": 40, "start": 237636, "end": 242343, "text": "Rompiste todos sus vallados; has quebrantado sus fortalezas.", "words": [[0, 237636], [9, 238216], [15, 238536], [19, 239123], [29, 239868], [33, 240123], [45, 240881], [49, 241639]]}, {"verse": 41, "start": 242693, "end": 248322, "text": "Lo saquearon todos los que pasaron por el camino: es deshonra a sus vecinos.", "words": [[0, 242693], [3, 243013], [13, 243653], [19, 243933], [23, 244173], [27, 244333], [35, 244813], [39, 244983], [42, 245153], [50, 246013], [53, 246217], [62, 247117], [64, 247317], [68, 247457]]}, {"verse": 42, "start": 248672, "end": 255211, "text": "Has exaltado la diestra de sus enemigos; has alegrado a todos sus adversarios.", "words": [[0, 248812], [4, 248952], [13, 249952], [16, 250092], [24, 250532], [27, 250732], [31, 250872], [41, 252025], [45, 252365], [54, 253165], [56, 253385], [62, 253665], [66, 253985]]}, {"verse": 43, "start": 255561, "end": 261172, "text": "Embotaste asimismo el filo de su espada, y no lo levantaste en la batalla.", "words": [[0, 255561], [10, 256338], [19, 257158], [22, 257478], [27, 257918], [30, 258018], [33, 258158], [41, 258678], [43, 259098], [46, 259258], [49, 259398], [60, 260238], [63, 260378], [66, 260518]]}, {"verse": 44, "start": 261522, "end": 265954, "text": "Hiciste cesar su brillo, y echaste su trono por tierra.", "words": [[0, 261522], [8, 262127], [14, 262627], [17, 262787], [25, 263747], [27, 263887], [35, 264327], [38, 264567], [44, 264967], [48, 265187]]}, {"verse": 45, "start": 266304, "end": 271646, "text": "Has acortado los días de su juventud; lo has cubierto de afrenta. (Selah.)", "words": [[0, 266590], [4, 266916], [13, 267243], [17, 267403], [22, 267683], [25, 267863], [28, 268043], [38, 269080], [41, 269206], [45, 269406], [54, 269986], [57, 270166], [66, 271332]]}, {"verse": 46, "start": 271996, "end": 277411, "text": "¿Hasta cuándo, oh Jehová? ¿te esconderás para siempre? ¿arderá tu ira como el fuego?", "words": [[0, 271996], [7, 272220], [15, 272560], [18, 272900], [26, 273633], [30, 273774], [41, 274414], [46, 274574], [55, 275436], [63, 276002], [66, 276162], [70, 276442], [75, 276642], [78, 276782]]}, {"verse": 47, "start": 277761, "end": 284153, "text": "Acuérdate de cuán corto sea mi tiempo: ¿por qué habrás creado en vano a todos los hijos del hombre?", "words": [[0, 277761], [10, 278324], [13, 278624], [18, 278984], [24, 279604], [28, 279804], [31, 280064], [39, 280891], [44, 280998], [48, 281258], [55, 281638], [62, 282058], [65, 282198], [70, 282558], [72, 282638], [78, 282838], [82, 283078], [88, 283358], [92, 283598]]}, {"verse": 48, "start": 284503, "end": 290917, "text": "¿Qué hombre vivirá y no verá muerte? ¿librarás su vida del poder del sepulcro? (Selah.)", "words": [[0, 284503], [5, 284630], [12, 284970], [19, 285550], [21, 285630], [24, 285790], [29, 286030], [37, 287147], [47, 287437], [50, 287717], [55, 288017], [59, 288237], [65, 288797], [69, 289097], [79, 290602]]}, {"verse": 49, "start": 291267, "end": 296841, "text": "Señor, ¿dónde están tus antiguas misericordias, que juraste a David por tu verdad?", "words": [[0, 291267], [7, 292131], [14, 292411], [20, 292651], [24, 292871], [33, 293511], [48, 294851], [52, 294931], [60, 295411], [62, 295591], [68, 295831], [72, 296091], [75, 296271]]}, {"verse": 50, "start": 297191, "end": 303950, "text": "Señor, acuérdate de la deshonra de tus siervos; deshonra que llevo yo en mi seno de muchos pueblos.", "words": [[0, 297191], [7, 297932], [17, 298472], [20, 298712], [23, 299092], [32, 299472], [35, 299632], [39, 299812], [48, 301134], [57, 301424], [61, 301584], [67, 301924], [70, 302124], [73, 302284], [76, 302464], [81, 302824], [84, 302924], [91, 303144]]}, {"verse": 51, "start": 304300, "end": 311984, "text": "Porque tus enemigos, oh Jehová, han deshonrado, porque tus enemigos han deshonrado los pasos de tu ungido.", "words": [[0, 304300], [7, 304542], [11, 304782], [21, 305269], [24, 305755], [32, 306242], [36, 306462], [48, 307622], [55, 308202], [59, 308462], [68, 309102], [72, 309402], [83, 310282], [87, 310462], [93, 311002], [96, 311349], [99, 311697]]}, {"verse": 52, "start": 312334, "end": 316031, "text": "Bendito Jehová para siempre. Amén, y Amén.", "words": [[0, 312334], [8, 312961], [15, 313461], [20, 313621], [29, 314697], [35, 315134], [37, 315414]]}]}