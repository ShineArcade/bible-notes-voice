{"book": "PSA", "chapter": 107, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 257544, "verses": [{"verse": 1, "start": 300, "end": 6083, "text": "Alabad a Jehová, porque es bueno; porque para siempre es su misericordia.", "words": [[0, 606], [7, 926], [9, 1186], [17, 1746], [24, 2046], [27, 2286], [34, 3132], [41, 3337], [46, 3597], [54, 4177], [57, 4797], [60, 4957]]}, {"verse": 2, "start": 6533, "end": 11573, "text": "Díganlo los redimidos de Jehová, los que ha redimido del poder del enemigo,", "words": [[0, 6533], [8, 7056], [12, 7256], [22, 7876], [25, 8036], [33, 8836], [37, 8916], [41, 9096], [44, 9276], [53, 10076], [57, 10256], [63, 10576], [67, 10836]]}, {"verse": 3, "start": 12023, "end": 17573, "text": "Y los ha congregado de las tierras, del oriente y del occidente, del norte y del mar.", "words": [[0, 12023], [2, 12116], [6, 12236], [9, 12456], [20, 13156], [23, 13296], [27, 13436], [36, 14416], [40, 14676], [48, 15136], [50, 15296], [54, 15416], [65, 16176], [69, 16316], [75, 16776], [77, 16976], [81, 17156]]}, {"verse": 4, "start": 18023, "end": 24535, "text": "Anduvieron perdidos por el desierto, por la soledad sin camino, no hallando ciudad de población.", "words": [[0, 18023], [11, 18742], [20, 19342], [24, 19562], [27, 19702], [37, 20362], [41, 20482], [44, 20622], [52, 21162], [56, 21302], [64, 22142], [67, 22242], [76, 22722], [83, 23122], [86, 23442]]}, {"verse": 5, "start": 24985, "end": 29225, "text": "Hambrientos y sedientos, su alma desfallecía en ellos.", "words": [[0, 24985], [12, 25829], [14, 26009], [25, 26689], [28, 27109], [33, 27429], [45, 28409], [48, 28589]]}, {"verse": 6, "start": 29675, "end": 35265, "text": "Pero habiendo clamado a Jehová en su angustia, los libró de sus aflicciones:", "words": [[0, 29675], [5, 29822], [14, 30182], [22, 30542], [24, 30922], [31, 31362], [34, 31482], [37, 31662], [47, 32742], [51, 32882], [57, 33622], [60, 33782], [64, 33962]]}, {"verse": 7, "start": 35715, "end": 40840, "text": "Y los dirigió por camino derecho, para que viniesen a ciudad de población.", "words": [[0, 35715], [2, 35823], [6, 35983], [14, 36583], [18, 36803], [25, 37163], [34, 37763], [39, 38403], [43, 38603], [52, 39123], [54, 39323], [61, 39643], [64, 39983]]}, {"verse": 8, "start": 41290, "end": 46844, "text": "Alaben la misericordia de Jehová, y sus maravillas para con los hijos de los hombres.", "words": [[0, 41457], [7, 41657], [10, 41837], [23, 42637], [26, 42737], [34, 43677], [36, 43877], [40, 44017], [51, 44697], [56, 45097], [60, 45357], [64, 45557], [70, 45857], [73, 46017], [77, 46157]]}, {"verse": 9, "start": 47294, "end": 52992, "text": "Porque sació al alma menesterosa, y llenó de bien al alma hambrienta.", "words": [[0, 47294], [7, 47500], [13, 48080], [16, 48320], [21, 48940], [34, 49560], [36, 50320], [42, 50740], [45, 50880], [50, 51140], [53, 51480], [58, 51800]]}, {"verse": 10, "start": 53442, "end": 59814, "text": "Los que moraban en tinieblas y sombra de muerte, aprisionados en aflicción y en hierros;", "words": [[0, 53442], [4, 53549], [8, 53689], [16, 54209], [19, 54659], [29, 55109], [31, 55229], [38, 55709], [41, 55829], [49, 57149], [62, 57629], [65, 57849], [75, 58549], [77, 58789], [80, 58949]]}, {"verse": 11, "start": 60264, "end": 66545, "text": "Por cuanto fueron rebeldes a las palabras de Jehová, y aborrecieron el consejo del Altísimo,", "words": [[0, 60264], [4, 60408], [11, 60708], [18, 61168], [27, 61868], [29, 62028], [33, 62148], [42, 62528], [45, 62828], [53, 63508], [55, 63728], [68, 64628], [71, 64788], [79, 65448], [83, 65648]]}, {"verse": 12, "start": 66995, "end": 73141, "text": "Por lo que quebrantó él con trabajo sus corazones, cayeron y no hubo quien les ayudase;", "words": [[0, 66995], [4, 67157], [7, 67277], [11, 67437], [21, 68097], [24, 68317], [28, 68557], [36, 68937], [40, 69197], [51, 70027], [59, 70857], [61, 71357], [64, 71537], [69, 71837], [75, 72017], [79, 72257]]}, {"verse": 13, "start": 73591, "end": 78597, "text": "Luego que clamaron a Jehová en su angustia, los libró de sus aflicciones.", "words": [[0, 73591], [6, 73811], [10, 74051], [19, 74531], [21, 74691], [28, 74991], [31, 75091], [34, 75231], [44, 76291], [48, 76491], [54, 77151], [57, 77251], [61, 77411]]}, {"verse": 14, "start": 79047, "end": 84598, "text": "Los sacó de las tinieblas y de la sombra de muerte, y rompió sus prisiones.", "words": [[0, 79094], [4, 79174], [9, 79654], [12, 79754], [16, 80244], [26, 80734], [28, 80934], [31, 81034], [34, 81154], [41, 81614], [44, 81734], [52, 82214], [54, 82814], [61, 83414], [65, 83614]]}, {"verse": 15, "start": 85048, "end": 91053, "text": "Alaben la misericordia de Jehová, y sus maravillas para con los hijos de los hombres.", "words": [[0, 85327], [7, 85637], [10, 85837], [23, 86737], [26, 86857], [34, 87797], [36, 88097], [40, 88277], [51, 88957], [56, 89217], [60, 89477], [64, 89677], [70, 89997], [73, 90197], [77, 90317]]}, {"verse": 16, "start": 91503, "end": 97461, "text": "Porque quebrantó las puertas de bronce, y desmenuzó los cerrojos de hierro.", "words": [[0, 91503], [7, 91805], [17, 92725], [21, 92885], [29, 93425], [32, 93605], [40, 94205], [42, 94685], [52, 95745], [56, 96195], [65, 96645], [68, 96845]]}, {"verse": 17, "start": 97911, "end": 105393, "text": "Los insensatos, a causa del camino de su rebelión y a causa de sus maldades, fueron afligidos.", "words": [[0, 97911], [4, 98486], [16, 99096], [18, 99296], [24, 99576], [28, 99896], [35, 100256], [38, 100456], [41, 100636], [50, 101316], [52, 101816], [54, 101936], [60, 102516], [63, 102756], [67, 102956], [77, 103796], [84, 104356]]}, {"verse": 18, "start": 105843, "end": 110942, "text": "Su alma abominó toda comida, y llegaron hasta las puertas de la muerte.", "words": [[0, 105843], [3, 106012], [8, 106372], [16, 107232], [21, 107452], [29, 107992], [31, 108652], [40, 109192], [46, 109492], [50, 109712], [58, 110112], [61, 110252], [64, 110352]]}, {"verse": 19, "start": 111392, "end": 116332, "text": "Pero clamaron a Jehová en su angustia, y los salvó de sus aflicciones.", "words": [[0, 111392], [5, 111914], [14, 112674], [16, 112834], [23, 113234], [26, 113354], [29, 113514], [39, 114254], [41, 114354], [45, 114514], [51, 115014], [54, 115094], [58, 115254]]}, {"verse": 20, "start": 116782, "end": 121138, "text": "Envió su palabra, y los curó, y los libró de su ruina.", "words": [[0, 116782], [6, 117166], [9, 117366], [18, 117866], [20, 118066], [24, 118226], [30, 118746], [32, 119486], [36, 119686], [42, 120206], [45, 120286], [48, 120466]]}, {"verse": 21, "start": 121588, "end": 127027, "text": "Alaben la misericordia de Jehová, y sus maravillas para con los hijos de los hombres:", "words": [[0, 121799], [7, 122049], [10, 122289], [23, 123189], [26, 123309], [34, 123989], [36, 124189], [40, 124349], [51, 125009], [56, 125269], [60, 125509], [64, 125709], [70, 125989], [73, 126169], [77, 126289]]}, {"verse": 22, "start": 127477, "end": 131647, "text": "Y sacrifiquen sacrificios de alabanza, y publiquen sus obras con júbilo.", "words": [[0, 127477], [2, 127862], [14, 128282], [26, 128982], [29, 129102], [39, 129642], [41, 129932], [51, 130222], [55, 130382], [61, 130682], [65, 130942]]}, {"verse": 23, "start": 132097, "end": 136859, "text": "Los que descienden al mar en naves, y hacen negocio en las muchas aguas,", "words": [[0, 132097], [4, 132385], [8, 132525], [19, 133085], [22, 133325], [26, 133525], [29, 133745], [36, 134205], [38, 134685], [44, 134905], [52, 135645], [55, 135805], [59, 135885], [66, 136145]]}, {"verse": 24, "start": 137309, "end": 141795, "text": "Ellos han visto las obras de Jehová, y sus maravillas en el profundo.", "words": [[0, 137309], [6, 137533], [10, 137793], [16, 138053], [20, 138273], [26, 138573], [29, 138753], [37, 139573], [39, 139813], [43, 139953], [54, 140573], [57, 140793], [60, 140933]]}, {"verse": 25, "start": 142245, "end": 147832, "text": "Él dijo, e hizo saltar el viento de la tempestad, que levanta sus ondas.", "words": [[0, 142245], [3, 142449], [9, 142869], [11, 143309], [16, 143729], [23, 144629], [26, 144709], [33, 145169], [36, 145309], [39, 145449], [50, 146149], [54, 146489], [62, 146969], [66, 147109]]}, {"verse": 26, "start": 148282, "end": 155455, "text": "Suben a los cielos, descienden a los abismos: sus almas se derriten con el mal.", "words": [[0, 148282], [6, 148922], [8, 149122], [12, 149262], [20, 150522], [31, 151362], [33, 151662], [37, 151782], [46, 152887], [50, 153050], [56, 153570], [59, 153950], [68, 154630], [72, 154790], [75, 154990]]}, {"verse": 27, "start": 155905, "end": 161844, "text": "Tiemblan, y titubean como borrachos, y de nada les sirve toda su pericia.", "words": [[0, 155905], [10, 156470], [12, 156770], [21, 157490], [26, 157750], [37, 158610], [39, 159450], [42, 159570], [47, 159790], [51, 160010], [57, 160410], [62, 160690], [65, 161010]]}, {"verse": 28, "start": 162294, "end": 166467, "text": "Pero claman a Jehová en su angustia, y los libra de sus aflicciones.", "words": [[0, 162294], [5, 162463], [12, 162903], [14, 163043], [21, 163423], [24, 163523], [27, 163663], [37, 164283], [39, 164443], [43, 164603], [49, 164983], [52, 165123], [56, 165303]]}, {"verse": 29, "start": 166917, "end": 171370, "text": "Hace parar la tempestad en sosiego, y se apaciguan sus ondas.", "words": [[0, 167143], [5, 167409], [11, 167676], [14, 167776], [24, 168416], [27, 168846], [36, 169276], [38, 169696], [41, 170076], [51, 170456], [55, 170656]]}, {"verse": 30, "start": 171820, "end": 177996, "text": "Alégranse luego porque se reposaron; y él los guía al puerto que deseaban.", "words": [[0, 171820], [10, 172717], [16, 172977], [23, 173357], [26, 173537], [37, 174828], [39, 175027], [42, 175227], [46, 175607], [51, 176067], [54, 176307], [61, 176787], [65, 176967]]}, {"verse": 31, "start": 178446, "end": 184049, "text": "Alaben la misericordia de Jehová, y sus maravillas para con los hijos de los hombres.", "words": [[0, 178666], [7, 178886], [10, 179446], [23, 180226], [26, 180326], [34, 181106], [36, 181246], [40, 181386], [51, 182026], [56, 182286], [60, 182486], [64, 182686], [70, 182986], [73, 183166], [77, 183286]]}, {"verse": 32, "start": 184499, "end": 191604, "text": "Y ensálcenlo en la congregación del pueblo; y en asamblea de ancianos lo alaben.", "words": [[0, 184499], [2, 184679], [13, 185819], [16, 186239], [19, 186379], [32, 187179], [36, 187379], [44, 188486], [46, 188692], [49, 188852], [58, 189752], [61, 189852], [70, 190512], [73, 190832]]}, {"verse": 33, "start": 192054, "end": 197308, "text": "El vuelve los ríos en desierto, y los manantiales de las aguas en lugares secos;", "words": [[0, 192054], [3, 192242], [10, 192662], [14, 192802], [19, 193222], [22, 193382], [32, 194042], [34, 194522], [38, 194662], [50, 195402], [53, 195482], [57, 195602], [63, 196022], [66, 196142], [74, 196442]]}, {"verse": 34, "start": 197758, "end": 203177, "text": "La tierra fructífera en terreno salado, por la maldad de los que la habitan.", "words": [[0, 197758], [3, 197884], [10, 198224], [21, 199264], [24, 199504], [32, 199924], [40, 200524], [44, 201144], [47, 201304], [54, 201764], [57, 201984], [61, 202124], [65, 202264], [68, 202424]]}, {"verse": 35, "start": 203627, "end": 209210, "text": "Vuelve el desierto en estanques de aguas, y la tierra seca en manantiales.", "words": [[0, 203627], [7, 204327], [10, 204567], [19, 205227], [22, 205407], [32, 206027], [35, 206207], [42, 206747], [44, 207127], [47, 207247], [54, 207527], [59, 208047], [62, 208167]]}, {"verse": 36, "start": 209660, "end": 214783, "text": "Y allí aposenta a los hambrientos, y disponen ciudad para habitación;", "words": [[0, 209660], [2, 209844], [7, 210104], [16, 210924], [18, 211124], [22, 211244], [35, 212224], [37, 212694], [46, 213164], [53, 213564], [58, 213984]]}, {"verse": 37, "start": 215233, "end": 219977, "text": "Y siembran campos, y plantan viñas, y rinden crecido fruto.", "words": [[0, 215233], [2, 215433], [11, 215893], [19, 216533], [21, 216713], [29, 217213], [36, 217793], [38, 218213], [45, 218633], [53, 219313]]}, {"verse": 38, "start": 220427, "end": 225757, "text": "Y los bendice, y se multiplican en gran manera; y no disminuye sus bestias.", "words": [[0, 220427], [2, 220525], [6, 220645], [15, 221245], [17, 221585], [20, 221705], [32, 222465], [35, 222585], [40, 222765], [48, 223688], [50, 223872], [53, 224292], [63, 224712], [67, 224892]]}, {"verse": 39, "start": 226207, "end": 231173, "text": "Y luego son menoscabados y abatidos a causa de tiranía, de males y congojas.", "words": [[0, 226207], [2, 226316], [8, 226496], [12, 227106], [25, 227716], [27, 227896], [36, 228416], [38, 228576], [44, 228856], [47, 229136], [56, 229736], [59, 229876], [65, 230156], [67, 230376]]}, {"verse": 40, "start": 231623, "end": 238797, "text": "El derrama menosprecio sobre los príncipes, y les hace andar errados, vagabundos, sin camino:", "words": [[0, 231623], [3, 231945], [11, 232535], [23, 233125], [29, 233465], [33, 233665], [44, 234365], [46, 234745], [50, 234925], [55, 235465], [61, 235985], [70, 236805], [82, 237625], [86, 238065]]}, {"verse": 41, "start": 239247, "end": 245418, "text": "Y levanta al pobre de la miseria, y hace multiplicar las familias como rebaños de ovejas.", "words": [[0, 239247], [2, 239374], [10, 239704], [13, 240034], [19, 240414], [22, 240634], [25, 240754], [34, 241674], [36, 241934], [41, 242154], [53, 243014], [57, 243114], [66, 243714], [71, 243954], [79, 244534], [82, 244694]]}, {"verse": 42, "start": 245868, "end": 250677, "text": "Vean los rectos, y alégrense; y toda maldad cierre su boca.", "words": [[0, 245868], [5, 246196], [9, 246356], [17, 246936], [19, 247036], [30, 248235], [32, 248360], [37, 248540], [44, 249120], [51, 249880], [54, 250060]]}, {"verse": 43, "start": 251127, "end": 257144, "text": "¿Quién es sabio y guardará estas cosas, y entenderá las misericordias de Jehová?", "words": [[0, 251127], [7, 251331], [10, 251611], [16, 252211], [18, 252691], [27, 253171], [33, 253371], [40, 253971], [42, 254731], [52, 255391], [56, 255531], [70, 256371], [73, 256531]]}]}