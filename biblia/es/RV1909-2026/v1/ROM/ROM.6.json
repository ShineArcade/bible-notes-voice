{"book": "ROM", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 162721, "verses": [{"verse": 1, "start": 300, "end": 3905, "text": "¿Pues qué diremos? ¿Perseveraremos en pecado para que la gracia crezca?", "words": [[0, 300], [6, 422], [10, 582], [19, 1323], [35, 1985], [38, 2205], [45, 2565], [50, 2745], [54, 2905], [57, 3025], [64, 3385]]}, {"verse": 2, "start": 4255, "end": 9206, "text": "En ninguna manera. Porque los que somos muertos al pecado, ¿cómo viviremos aún en él?", "words": [[0, 4255], [3, 4376], [11, 4696], [19, 5507], [26, 5689], [30, 5829], [34, 5989], [40, 6209], [48, 6669], [51, 6869], [59, 7729], [65, 7889], [75, 8489], [79, 8709], [82, 8909]]}, {"verse": 3, "start": 9556, "end": 14787, "text": "¿O no sabéis que todos los que somos bautizados en Cristo Jesús, somos bautizados en su muerte?", "words": [[0, 9556], [3, 9658], [6, 9698], [13, 10078], [17, 10238], [23, 10498], [27, 10778], [31, 10938], [37, 11178], [48, 11918], [51, 12118], [58, 12378], [65, 12878], [71, 13213], [82, 13933], [85, 14113], [88, 14233]]}, {"verse": 4, "start": 15137, "end": 25407, "text": "Porque somos sepultados juntamente con él a muerte por el bautismo; para que como Cristo resucitó de los muertos por la gloria del Padre, así también nosotros andemos en novedad de vida.", "words": [[0, 15137], [7, 15299], [13, 15579], [24, 16239], [35, 16839], [39, 17059], [42, 17219], [44, 17279], [51, 17559], [55, 17799], [58, 17899], [68, 18760], [73, 18900], [77, 19040], [82, 19280], [89, 19680], [98, 20340], [101, 20400], [105, 20540], [113, 20940], [117, 21180], [120, 21300], [127, 21620], [131, 21760], [138, 22700], [142, 22880], [150, 23280], [159, 23580], [167, 24240], [170, 24420], [178, 24880], [181, 25020]]}, {"verse": 5, "start": 25757, "end": 32327, "text": "Porque si fuimos plantados juntamente en él a la semejanza de su muerte, así también lo seremos a la de su resurrección:", "words": [[0, 25757], [7, 25936], [10, 26076], [17, 26436], [27, 26996], [38, 27636], [41, 27776], [44, 27896], [46, 27976], [49, 28056], [59, 28676], [62, 28776], [65, 28896], [73, 29776], [77, 29996], [85, 30356], [88, 30516], [96, 30876], [98, 31116], [101, 31156], [104, 31316], [107, 31456]]}, {"verse": 6, "start": 32677, "end": 41578, "text": "Sabiendo esto, que nuestro viejo hombre juntamente fue crucificado con él, para que el cuerpo del pecado sea deshecho, a fin de que no sirvamos más al pecado.", "words": [[0, 32677], [9, 33131], [15, 33451], [19, 33651], [27, 33791], [33, 34311], [40, 34571], [51, 35211], [55, 35411], [67, 36111], [71, 36331], [75, 36511], [80, 37071], [84, 37231], [87, 37371], [94, 37671], [98, 37871], [105, 38291], [109, 38821], [119, 39351], [121, 39631], [125, 39811], [128, 39971], [132, 40071], [135, 40211], [144, 40691], [148, 40851], [151, 41011]]}, {"verse": 7, "start": 41928, "end": 44861, "text": "Porque el que es muerto, justificado es del pecado.", "words": [[0, 41928], [7, 42168], [10, 42288], [14, 42408], [17, 42528], [25, 43108], [37, 43888], [40, 44088], [44, 44248]]}, {"verse": 8, "start": 45211, "end": 48869, "text": "Y si morimos con Cristo, creemos que también viviremos con él;", "words": [[0, 45211], [2, 45329], [5, 45449], [13, 45849], [17, 46069], [25, 46849], [33, 47249], [37, 47409], [45, 47749], [55, 48409], [59, 48589]]}, {"verse": 9, "start": 49219, "end": 56063, "text": "Sabiendo que Cristo, habiendo resucitado de entre los muertos, ya no muere: la muerte ya no tiene dominio sobre él.", "words": [[0, 49219], [9, 49677], [13, 49837], [21, 50617], [30, 50977], [41, 51737], [44, 51877], [50, 52077], [54, 52237], [63, 52877], [66, 52897], [69, 53037], [76, 53735], [79, 53839], [86, 54159], [89, 54459], [92, 54599], [98, 54839], [106, 55359], [112, 55639]]}, {"verse": 10, "start": 56413, "end": 61277, "text": "Porque el haber muerto, al pecado murió una vez; pero el vivir, a Dios vive.", "words": [[0, 56413], [7, 56654], [10, 56814], [16, 56974], [24, 57534], [27, 57794], [34, 58234], [40, 58594], [44, 58734], [49, 59462], [54, 59664], [57, 59824], [64, 60124], [66, 60464], [71, 60664]]}, {"verse": 11, "start": 61627, "end": 69061, "text": "Así también vosotros, pensad que de cierto estáis muertos al pecado, pero vivos a Dios en Cristo Jesús Señor nuestro.", "words": [[0, 61627], [4, 61852], [12, 62232], [22, 62712], [29, 63272], [33, 63412], [36, 63552], [43, 63852], [50, 64332], [58, 64692], [61, 64892], [69, 65772], [74, 66112], [80, 66512], [82, 66612], [87, 66792], [90, 67012], [97, 67592], [103, 68172], [109, 68352]]}, {"verse": 12, "start": 69411, "end": 75270, "text": "No reine, pues, el pecado en vuestro cuerpo mortal, para que le obedezcáis en sus malos deseos;", "words": [[0, 69411], [3, 69637], [10, 70017], [16, 70277], [19, 70697], [26, 71157], [29, 71297], [37, 71677], [44, 71917], [52, 72497], [57, 72782], [61, 72942], [64, 73082], [75, 73722], [78, 73882], [82, 74042], [88, 74542]]}, {"verse": 13, "start": 75620, "end": 86057, "text": "Ni tampoco presentéis vuestros miembros al pecado por instrumentos de iniquidad; antes presentaos a Dios como vivos de los muertos, y vuestros miembros a Dios por instrumentos de justicia.", "words": [[0, 75620], [3, 75740], [11, 76080], [22, 76800], [31, 77160], [40, 77580], [43, 77760], [50, 78160], [54, 78360], [67, 79060], [70, 79180], [81, 79983], [87, 80301], [98, 81101], [100, 81221], [105, 81421], [110, 81741], [116, 82161], [119, 82261], [123, 82381], [132, 82861], [134, 83096], [143, 83456], [152, 83896], [154, 84076], [159, 84256], [163, 84536], [176, 85216], [179, 85296]]}, {"verse": 14, "start": 86407, "end": 92132, "text": "Porque el pecado ya no tendrá dominio sobre vosotros; pues no estáis bajo la ley, sino bajo la gracia.", "words": [[0, 86407], [7, 86625], [10, 86765], [17, 87205], [20, 87405], [23, 87545], [30, 87925], [38, 88325], [44, 88505], [54, 89534], [59, 89654], [62, 89814], [69, 90194], [74, 90354], [77, 90554], [82, 91074], [87, 91214], [92, 91434], [95, 91594]]}, {"verse": 15, "start": 92482, "end": 98054, "text": "¿Pues qué? ¿Pecaremos, porque no estamos bajo de la ley, sino bajo de la gracia? En ninguna manera.", "words": [[0, 92482], [6, 92661], [11, 93250], [23, 93694], [30, 94014], [33, 94214], [41, 94514], [46, 94814], [49, 95014], [52, 95114], [57, 95554], [62, 95694], [67, 95994], [70, 96194], [73, 96274], [81, 97056], [84, 97182], [92, 97442]]}, {"verse": 16, "start": 98404, "end": 109306, "text": "¿No sabéis que a quien os prestáis vosotros mismos por siervos para obedecerle, sois siervos de aquel a quien obedecéis, o del pecado para muerte, o de la obediencia para justicia?", "words": [[0, 98404], [4, 98513], [11, 98913], [15, 99113], [17, 99273], [23, 99393], [26, 99573], [35, 100133], [44, 100633], [51, 101033], [55, 101413], [63, 101853], [68, 102073], [80, 103133], [85, 103573], [93, 103953], [96, 104133], [102, 104473], [104, 104553], [110, 104713], [121, 105513], [123, 105873], [127, 106013], [134, 106393], [139, 106593], [147, 107389], [149, 107509], [152, 107609], [155, 107689], [166, 108289], [171, 108529]]}, {"verse": 17, "start": 109656, "end": 117737, "text": "Pero gracias a Dios, que aunque fuisteis siervos del pecado, habéis obedecido de corazón a aquella forma de doctrina a la cual sois entregados;", "words": [[0, 109656], [5, 109796], [13, 110116], [15, 110396], [21, 110976], [25, 111076], [32, 111196], [41, 111776], [49, 112176], [53, 112356], [61, 113136], [68, 113416], [78, 113996], [81, 114176], [89, 114356], [91, 114536], [99, 115036], [105, 115336], [108, 115516], [117, 116036], [119, 116296], [122, 116356], [127, 116576], [132, 116896]]}, {"verse": 18, "start": 118087, "end": 121599, "text": "Y libertados del pecado, sois hechos siervos de la justicia.", "words": [[0, 118087], [2, 118188], [13, 118748], [17, 118928], [25, 119448], [30, 119988], [37, 120248], [45, 120688], [48, 120788], [51, 120868]]}, {"verse": 19, "start": 121949, "end": 135547, "text": "Humana cosa digo, por la debilidad de vuestra naturaleza humana: que como para iniquidad presentasteis vuestros miembros a servir a la inmundicia y a la iniquidad, así ahora para santidad presentéis vuestros miembros a servir a la justicia.", "words": [[0, 121949], [7, 122396], [12, 122556], [18, 122896], [22, 123196], [25, 123316], [35, 123836], [38, 123996], [46, 124336], [57, 124996], [65, 125787], [69, 125880], [74, 126100], [79, 126340], [89, 126900], [103, 127840], [112, 128200], [121, 128720], [123, 128860], [130, 129140], [132, 129320], [135, 129400], [146, 130020], [148, 130140], [150, 130180], [153, 130300], [164, 131220], [168, 131520], [174, 131900], [179, 132120], [188, 132660], [199, 133320], [208, 133680], [217, 134180], [219, 134300], [226, 134600], [228, 134720], [231, 134800]]}, {"verse": 20, "start": 135897, "end": 140366, "text": "Porque cuando fuisteis siervos del pecado, erais libres acerca de la justicia.", "words": [[0, 135897], [7, 136097], [14, 136337], [23, 136877], [31, 137257], [35, 137417], [43, 138097], [49, 138557], [56, 138997], [63, 139277], [66, 139517], [69, 139597]]}, {"verse": 21, "start": 140716, "end": 146735, "text": "¿Qué fruto, pues, teníais de aquellas cosas de las cuales ahora os avergonzáis? porque el fin de ellas es muerte.", "words": [[0, 140716], [5, 140797], [12, 141217], [18, 141657], [26, 142097], [29, 142257], [38, 142657], [44, 142937], [47, 143157], [51, 143277], [58, 143497], [64, 143897], [67, 144077], [80, 145216], [87, 145397], [90, 145537], [94, 145697], [97, 145857], [103, 145977], [106, 146177]]}, {"verse": 22, "start": 147085, "end": 154795, "text": "Pero ahora, librados del pecado, y hechos siervos a Dios, tenéis por vuestro fruto la santificación, y por fin la vida eterna.", "words": [[0, 147085], [5, 147218], [12, 147478], [21, 148018], [25, 148198], [33, 148758], [35, 149098], [42, 149358], [50, 149798], [52, 149958], [58, 150718], [65, 151058], [69, 151218], [77, 151618], [83, 151978], [86, 152118], [101, 152898], [103, 153378], [107, 153538], [111, 153798], [114, 153958], [119, 154158]]}, {"verse": 23, "start": 155145, "end": 162321, "text": "Porque la paga del pecado es muerte: pero el regalo de Dios es vida eterna en Cristo Jesús Señor nuestro.", "words": [[0, 155145], [7, 155325], [10, 155565], [15, 155805], [19, 155925], [26, 156405], [29, 156645], [37, 157470], [42, 157627], [45, 157767], [52, 158147], [55, 158287], [60, 158567], [63, 158967], [68, 159267], [75, 159827], [78, 159967], [85, 160647], [91, 161407], [97, 161647]]}]}