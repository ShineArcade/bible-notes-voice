{"book": "PSA", "chapter": 68, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 270549, "verses": [{"verse": 1, "start": 300, "end": 11092, "text": "Al Músico principal: Salmo de David: Canción. LEVÁNTESE Dios, sean esparcidos sus enemigos, y huyan de su presencia los que le aborrecen.", "words": [[0, 300], [3, 471], [10, 971], [21, 2066], [27, 2563], [30, 2723], [37, 3498], [46, 4411], [56, 5019], [62, 5839], [67, 6039], [78, 6819], [82, 7059], [92, 7739], [94, 8099], [100, 8479], [103, 8619], [106, 8759], [116, 9499], [120, 9959], [124, 10099], [127, 10239]]}, {"verse": 2, "start": 11442, "end": 21359, "text": "Como es lanzado el humo, los lanzarás: como se derrite la cera delante del fuego, así perecerán los impíos delante de Dios.", "words": [[0, 11442], [5, 11832], [8, 12012], [16, 12752], [19, 12912], [25, 13712], [29, 13952], [39, 15202], [44, 15366], [47, 15716], [55, 16066], [58, 16286], [63, 16606], [71, 17026], [75, 17246], [82, 18086], [86, 18466], [96, 19206], [100, 19366], [107, 20106], [115, 20566], [118, 20726]]}, {"verse": 3, "start": 21709, "end": 27807, "text": "Mas los justos se alegrarán: se gozarán delante de Dios, y saltarán de alegría.", "words": [[0, 21709], [4, 21984], [8, 22290], [15, 22597], [18, 22937], [29, 24059], [32, 24319], [40, 24839], [48, 25239], [51, 25399], [57, 25699], [59, 26299], [68, 26939], [71, 27039]]}, {"verse": 4, "start": 28157, "end": 38118, "text": "Cantad a Dios, cantad salmos a su nombre: exaltad al que sube sobre los cielos en JAH su nombre, y alegraos delante de él.", "words": [[0, 28157], [7, 28725], [9, 28845], [15, 29605], [22, 30065], [29, 30685], [31, 30885], [34, 31045], [42, 31847], [50, 32732], [53, 32932], [57, 33092], [62, 33512], [68, 33772], [72, 34012], [79, 34492], [82, 34712], [86, 34932], [89, 35152], [97, 35592], [99, 36252], [108, 36912], [116, 37532], [119, 37732]]}, {"verse": 5, "start": 38468, "end": 44882, "text": "Padre de huérfanos y defensor de viudas, es Dios en la morada de su santuario:", "words": [[0, 38468], [6, 38893], [9, 39033], [19, 39813], [21, 39953], [30, 40553], [33, 40753], [41, 41373], [44, 42073], [49, 42573], [52, 42973], [55, 43113], [62, 43553], [65, 43733], [68, 43893]]}, {"verse": 6, "start": 45232, "end": 54242, "text": "El Dios que hace habitar en familia los solos; que saca a los aprisionados con grillos: mas los rebeldes habitan en sequedad.", "words": [[0, 45232], [3, 45512], [8, 45812], [12, 46072], [17, 46422], [25, 46772], [28, 47012], [36, 47452], [40, 47672], [47, 48594], [51, 48676], [56, 49176], [58, 49216], [62, 49356], [75, 50116], [79, 50336], [88, 51323], [92, 51729], [96, 52109], [105, 52809], [113, 53369], [116, 53831]]}, {"verse": 7, "start": 54592, "end": 60432, "text": "Oh Dios, cuando tú saliste delante de tu pueblo, cuando anduviste por el desierto, (Selah,)", "words": [[0, 54642], [3, 54722], [9, 54962], [16, 55302], [19, 55722], [27, 56342], [35, 56862], [38, 57042], [41, 57162], [49, 57662], [56, 57862], [66, 58422], [70, 58662], [73, 58782], [83, 59636]]}, {"verse": 8, "start": 60782, "end": 70574, "text": "La tierra tembló; también destilaron los cielos a la presencia de Dios: aquel Sinaí tembló delante de Dios, del Dios de Israel.", "words": [[0, 60782], [3, 60908], [10, 61188], [18, 62248], [26, 62712], [37, 63472], [41, 63612], [48, 64212], [50, 64412], [53, 64512], [63, 65212], [66, 65412], [72, 66172], [78, 66559], [84, 67159], [91, 67779], [99, 68279], [102, 68459], [108, 69139], [112, 69399], [117, 69679], [120, 69859]]}, {"verse": 9, "start": 70924, "end": 78407, "text": "Abundante lluvia esparciste, oh Dios, a tu heredad; y cuando se cansó, tú la recreaste.", "words": [[0, 70924], [10, 71511], [17, 72011], [29, 72561], [32, 73111], [38, 73371], [40, 73851], [43, 74011], [52, 74916], [54, 75022], [61, 75242], [64, 75462], [71, 76622], [74, 77022], [77, 77342]]}, {"verse": 10, "start": 78757, "end": 84601, "text": "Los que son de tu grey han morado en ella: por tu bondad, oh Dios, has provisto al pobre.", "words": [[0, 78793], [4, 78863], [8, 79003], [12, 79243], [15, 79403], [18, 79563], [23, 80063], [27, 80303], [34, 80823], [37, 81003], [43, 81708], [47, 81852], [50, 82012], [58, 82362], [61, 82712], [67, 82972], [71, 83332], [80, 83832], [83, 83992]]}, {"verse": 11, "start": 84951, "end": 90348, "text": "El Señor daba palabra: de las que anunciaban las buenas nuevas había grande ejército.", "words": [[0, 84951], [3, 85079], [9, 85379], [14, 85739], [23, 86686], [26, 86851], [30, 86970], [34, 87110], [45, 87750], [49, 87931], [56, 88190], [63, 88511], [69, 89142], [76, 89772]]}, {"verse": 12, "start": 90698, "end": 97253, "text": "Huyeron, huyeron reyes de ejércitos; y las que se quedaban en casa repartían los despojos.", "words": [[0, 90698], [9, 91424], [17, 91851], [23, 92277], [26, 92704], [37, 94164], [39, 94273], [43, 94373], [47, 94513], [50, 94653], [59, 95113], [62, 95233], [67, 95553], [77, 96333], [81, 96793]]}, {"verse": 13, "start": 97603, "end": 106431, "text": "Bien que fuisteis echados entre los tiestos, seréis como las alas de la paloma cubierta de plata, y sus plumas con amarillez de oro.", "words": [[0, 97603], [5, 97827], [9, 98027], [18, 98727], [26, 99287], [32, 99607], [36, 99847], [45, 100647], [52, 101127], [57, 101387], [61, 101627], [66, 102107], [69, 102227], [72, 102327], [79, 102687], [88, 103307], [91, 103427], [98, 103807], [100, 104247], [104, 104427], [111, 104962], [115, 105392], [125, 105822], [128, 106062]]}, {"verse": 14, "start": 106781, "end": 112260, "text": "Cuando esparció el Omnipotente los reyes en ella, se emblanqueció esta como la nieve en Salmón.", "words": [[0, 106781], [7, 107005], [16, 107605], [19, 107785], [31, 108485], [35, 108665], [41, 109013], [44, 109362], [50, 109710], [53, 110130], [66, 110550], [71, 110730], [76, 111010], [79, 111150], [85, 111470], [88, 111590]]}, {"verse": 15, "start": 112610, "end": 117074, "text": "Monte de Dios es el monte de Basán; monte alto el de Basán.", "words": [[0, 112610], [6, 112895], [9, 113115], [14, 113395], [17, 113735], [20, 113895], [26, 114175], [29, 114355], [36, 115228], [42, 115668], [47, 116188], [50, 116268], [53, 116388]]}, {"verse": 16, "start": 117424, "end": 126679, "text": "¿Por qué os levantáis, oh montes altos? Este monte amó Dios para su asiento; ciertamente Jehová habitará en él para siempre.", "words": [[0, 117424], [5, 117566], [9, 117746], [12, 117846], [23, 118546], [26, 119246], [33, 119766], [40, 120704], [45, 120910], [51, 121250], [55, 121630], [60, 121810], [65, 122150], [68, 122310], [77, 123209], [89, 124015], [96, 124535], [105, 125195], [108, 125435], [111, 125615], [116, 125895]]}, {"verse": 17, "start": 127029, "end": 136910, "text": "Los carros de Dios son veinte mil, y más millares de ángeles. El Señor entre ellos, como en Sinaí, así en el santuario.", "words": [[0, 127029], [4, 127304], [11, 127614], [14, 127734], [19, 127994], [23, 128621], [30, 129247], [35, 129874], [37, 130074], [41, 130254], [50, 130814], [53, 131034], [62, 132063], [65, 132223], [71, 132503], [77, 132863], [84, 133363], [89, 133963], [92, 134223], [99, 135203], [103, 135443], [106, 135783], [109, 135923]]}, {"verse": 18, "start": 137260, "end": 147419, "text": "Subiste a lo alto, cautivaste la cautividad, tomaste dones para los hombres, y también para los rebeldes, para que habite entre ellos JAH Dios.", "words": [[0, 137260], [8, 137861], [10, 138041], [13, 138161], [19, 139021], [30, 139881], [33, 140041], [45, 140861], [53, 141681], [59, 142161], [64, 142361], [68, 142561], [77, 143001], [79, 143501], [87, 143801], [92, 144041], [96, 144261], [106, 145121], [111, 145301], [115, 145461], [122, 145761], [128, 146001], [134, 146474], [138, 146947]]}, {"verse": 19, "start": 147769, "end": 156943, "text": "Bendito el Señor; cada día nos colma de beneficios el Dios de nuestra salvación. (Selah.)", "words": [[0, 147769], [8, 148277], [11, 148417], [18, 149200], [23, 149385], [27, 149665], [31, 149845], [37, 150345], [40, 150505], [51, 151245], [54, 151445], [59, 151685], [62, 151885], [70, 152065], [81, 155665]]}, {"verse": 20, "start": 157293, "end": 160506, "text": "Dios, nuestro Dios ha de salvarnos; y de Dios Jehová es el librar de la muerte.", "words": [[0, 157695], [6, 157841], [14, 157987], [19, 158132], [22, 158278], [25, 158424], [36, 158732], [38, 158732], [41, 158732], [46, 158732], [53, 158732], [56, 158915], [59, 159095], [66, 159595], [69, 159695], [72, 159835]]}, {"verse": 21, "start": 160856, "end": 167505, "text": "Ciertamente Dios herirá la cabeza de sus enemigos, la cabelluda mollera del que camina en sus pecados.", "words": [[0, 160856], [12, 161618], [17, 161898], [24, 162538], [27, 162678], [34, 163038], [37, 163238], [41, 163398], [51, 164358], [54, 164598], [64, 165148], [72, 165698], [76, 165878], [80, 166078], [87, 166538], [90, 166618], [94, 166778]]}, {"verse": 22, "start": 167855, "end": 173199, "text": "El Señor dijo: De Basán haré volver, te haré volver de los profundos del mar:", "words": [[0, 167855], [3, 168001], [9, 168301], [15, 169105], [18, 169165], [24, 169665], [29, 170165], [37, 170665], [40, 170925], [45, 171145], [52, 171425], [55, 171685], [59, 171825], [69, 172405], [73, 172645]]}, {"verse": 23, "start": 173549, "end": 179265, "text": "Porque tu pie se enrojecerá de sangre de tus enemigos, y de ella la lengua de tus perros.", "words": [[0, 173549], [7, 173750], [10, 173930], [14, 174250], [17, 174570], [28, 175230], [31, 175310], [38, 175710], [41, 175930], [45, 176050], [55, 176650], [57, 177090], [60, 177210], [65, 177510], [68, 177710], [75, 178070], [78, 178150], [82, 178330]]}, {"verse": 24, "start": 179545, "end": 185694, "text": "Vieron tus caminos, oh Dios; los caminos de mi Dios, de mi Rey, en el santuario.", "words": [[0, 179545], [7, 179930], [11, 180130], [20, 180830], [23, 181090], [29, 181966], [33, 182069], [41, 182529], [44, 182709], [47, 182809], [53, 183789], [56, 183849], [59, 183989], [64, 184589], [67, 184729], [70, 184869]]}, {"verse": 25, "start": 186044, "end": 193002, "text": "Los cantores iban delante, los músicos detrás; en medio, las doncellas con panderos.", "words": [[0, 186044], [4, 186304], [13, 186964], [18, 187484], [27, 188564], [31, 188664], [39, 189184], [47, 190261], [50, 190386], [57, 190806], [61, 191286], [71, 191926], [75, 192106]]}, {"verse": 26, "start": 193352, "end": 199807, "text": "Bendecid a Dios en congregaciones: al Señor, vosotros de la estirpe de Israel.", "words": [[0, 193752], [9, 194152], [11, 194372], [16, 194592], [19, 194892], [35, 196458], [38, 196704], [45, 197044], [54, 197824], [57, 198239], [60, 198359], [68, 198839], [71, 198959]]}, {"verse": 27, "start": 200157, "end": 209879, "text": "Allí estaba el joven Benjamín gobernante de ellos, los príncipes de Judá en su congregación, los príncipes de Zabulón, los príncipes de Neftalí.", "words": [[0, 200157], [5, 200597], [12, 200897], [15, 201117], [21, 201557], [30, 202197], [41, 202877], [44, 203037], [51, 203697], [55, 203937], [65, 204577], [68, 204677], [73, 205017], [76, 205157], [79, 205317], [93, 206597], [97, 206677], [107, 207237], [110, 207797], [119, 208357], [123, 208437], [133, 209037], [136, 209157]]}, {"verse": 28, "start": 210229, "end": 216233, "text": "Tu Dios ha ordenado tu fuerza; confirma, oh Dios, lo que has hecho en nosotros.", "words": [[0, 210229], [3, 210331], [8, 210651], [11, 211011], [20, 211531], [23, 211691], [31, 212646], [41, 213080], [44, 213550], [50, 213970], [53, 214285], [57, 214445], [61, 214625], [67, 214905], [70, 215085]]}, {"verse": 29, "start": 216583, "end": 221510, "text": "Por razón de tu templo en Jerusalén los reyes te ofrecerán dones.", "words": [[0, 216583], [4, 216724], [10, 217104], [13, 217404], [16, 217564], [23, 218104], [26, 218184], [36, 219404], [40, 219504], [46, 219944], [49, 220124], [59, 220804]]}, {"verse": 30, "start": 221860, "end": 234784, "text": "Reprime la reunión de gentes armadas, la multitud de toros con los becerros de los pueblos, hasta que todos se sometan con sus piezas de plata: disipa los pueblos que se complacen en la guerra.", "words": [[0, 221860], [8, 222525], [11, 222705], [19, 223285], [22, 223445], [29, 223905], [38, 225145], [41, 225285], [50, 225805], [53, 225965], [59, 226345], [63, 226525], [67, 226925], [76, 227325], [79, 227425], [83, 227565], [92, 228225], [98, 228645], [102, 228905], [108, 229225], [111, 229545], [119, 230125], [123, 230325], [127, 230525], [134, 231065], [137, 231185], [144, 232264], [151, 232564], [155, 232664], [163, 233084], [167, 233184], [170, 233304], [180, 233904], [183, 234024], [186, 234164]]}, {"verse": 31, "start": 235134, "end": 240505, "text": "Vendrán príncipes de Egipto; Etiopía apresurará sus manos a Dios.", "words": [[0, 235404], [8, 235859], [18, 236499], [21, 236699], [29, 238157], [37, 238723], [48, 239290], [52, 239430], [58, 239730], [60, 239990]]}, {"verse": 32, "start": 240855, "end": 245686, "text": "Reinos de la tierra, cantad a Dios, cantad al Señor (Selah);", "words": [[0, 241068], [7, 241318], [10, 241418], [13, 241518], [21, 241985], [28, 242451], [30, 242918], [36, 243371], [43, 243825], [46, 244278], [52, 244985]]}, {"verse": 33, "start": 246036, "end": 253212, "text": "Al que cabalga sobre los cielos de los cielos que son de antiguo: he aquí a su voz dará voz de fortaleza.", "words": [[0, 246108], [3, 246218], [7, 246378], [15, 246978], [21, 247278], [25, 247518], [32, 248178], [35, 248238], [39, 248378], [46, 248978], [50, 249058], [54, 249258], [57, 249458], [66, 250528], [69, 250618], [74, 250838], [76, 251038], [79, 251178], [83, 251478], [88, 251898], [92, 252098], [95, 252298]]}, {"verse": 34, "start": 253562, "end": 261062, "text": "Atribuid fortaleza a Dios: sobre Israel es su magnificencia, y su poder está en los cielos.", "words": [[0, 253854], [9, 254184], [19, 254715], [21, 255246], [27, 255972], [33, 256334], [40, 257134], [43, 257554], [46, 257774], [61, 258954], [63, 259174], [66, 259394], [72, 259754], [77, 260054], [80, 260214], [84, 260334]]}, {"verse": 35, "start": 261412, "end": 270149, "text": "Temible eres, oh Dios, desde tus santuarios: el Dios de Israel, él da fortaleza y vigor a su pueblo. Bendito Dios.", "words": [[0, 261412], [8, 261896], [14, 262276], [17, 262656], [23, 263036], [29, 263356], [33, 263616], [45, 264711], [48, 264844], [53, 265064], [56, 265224], [64, 265984], [67, 266124], [70, 266304], [80, 267144], [82, 267324], [88, 267584], [90, 267824], [93, 267964], [101, 268835], [109, 269521]]}]}