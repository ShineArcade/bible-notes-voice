{"book": "MAT", "chapter": 8, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 244832, "verses": [{"verse": 1, "start": 300, "end": 4218, "text": "When he was come down from the mountain, great multitudes followed him.", "words": [[0, 300], [5, 445], [8, 585], [12, 785], [17, 1005], [22, 1305], [27, 1545], [31, 1725], [41, 2305], [47, 2685], [58, 3385], [67, 3805]]}, {"verse": 2, "start": 4568, "end": 11155, "text": "And, behold, there came a leper and worshipped him, saying, Lord, if you will, you can make me clean.", "words": [[0, 4568], [5, 4752], [13, 5532], [19, 5812], [24, 6052], [26, 6252], [32, 6652], [36, 7052], [47, 7452], [52, 7852], [60, 9050], [66, 9291], [69, 9491], [73, 9611], [79, 10151], [83, 10231], [87, 10411], [92, 10591], [95, 10731]]}, {"verse": 3, "start": 11435, "end": 19909, "text": "And Jesus put forth his hand, and touched him, saying, I will; be clean. And immediately his leprosy was cleansed.", "words": [[0, 11435], [4, 11576], [10, 11916], [14, 12256], [20, 12596], [24, 12816], [30, 13156], [34, 13456], [42, 13796], [47, 14316], [55, 15091], [57, 15350], [63, 16120], [66, 16317], [73, 17222], [77, 17422], [89, 17882], [93, 18442], [101, 19022], [105, 19202]]}, {"verse": 4, "start": 20260, "end": 29745, "text": "And Jesus says to him, See that you tell no man; but go your way, show yourself to the priest, and offer the gift that Moses commanded, for a testimony to them.", "words": [[0, 20260], [4, 20405], [10, 20685], [15, 21045], [18, 21305], [23, 21877], [27, 22101], [32, 22281], [36, 22421], [41, 22641], [44, 22841], [49, 23583], [53, 23703], [56, 23903], [61, 24103], [66, 24683], [71, 24883], [80, 25303], [83, 25483], [87, 25583], [95, 26223], [99, 26383], [105, 26643], [109, 26803], [114, 27103], [119, 27403], [125, 27683], [136, 28203], [140, 28563], [142, 28703], [152, 29063], [155, 29383]]}, {"verse": 5, "start": 30025, "end": 36232, "text": "¶ And when Jesus was entered into Capernaum, there came to him a centurion, beseeching him,", "words": [[2, 30025], [6, 30146], [11, 30306], [17, 30626], [21, 30926], [29, 31266], [34, 31546], [45, 32806], [51, 32886], [56, 33146], [59, 33326], [63, 33486], [65, 33606], [76, 34606], [87, 35126]]}, {"verse": 6, "start": 36582, "end": 41078, "text": "And saying, Lord, my servant lies at home paralyzed, grievously tormented.", "words": [[0, 36582], [4, 36743], [12, 37146], [18, 37563], [21, 37643], [29, 38143], [34, 38503], [37, 38763], [42, 39023], [53, 39963], [64, 40383]]}, {"verse": 7, "start": 41358, "end": 44523, "text": "And Jesus says to him, I will come and heal him.", "words": [[0, 41358], [4, 41504], [10, 41804], [15, 42144], [18, 42384], [23, 42915], [25, 43092], [30, 43212], [35, 43532], [39, 43832], [44, 44072]]}, {"verse": 8, "start": 44803, "end": 52553, "text": "The centurion answered and said, Lord, I am not worthy that you should come under my roof: but speak the word only, and my servant shall be healed.", "words": [[0, 44803], [4, 44893], [14, 45533], [23, 45873], [27, 46173], [33, 46773], [39, 47228], [41, 47308], [44, 47428], [48, 47628], [55, 47988], [60, 48208], [64, 48348], [71, 48508], [76, 48728], [82, 48948], [85, 49108], [91, 49728], [95, 49833], [101, 50033], [105, 50193], [110, 50393], [116, 51013], [120, 51253], [123, 51393], [131, 51733], [137, 51973], [140, 52113]]}, {"verse": 9, "start": 52903, "end": 63509, "text": "For I am a man under authority, having soldiers under me: and I say to this man, Go, and he goes; and to another, Come, and he comes; and to my servant, Do this, and he does it.", "words": [[0, 52903], [4, 52997], [6, 53157], [9, 53257], [11, 53357], [15, 53597], [21, 53877], [32, 54337], [39, 54637], [48, 55077], [54, 55357], [58, 55849], [62, 55933], [64, 56053], [68, 56233], [71, 56373], [76, 56553], [81, 57053], [85, 57373], [89, 57853], [92, 58033], [98, 58817], [102, 58940], [105, 59060], [114, 59740], [120, 60140], [124, 60240], [127, 60340], [134, 61035], [138, 6116