{"book": "JHN", "chapter": 17, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 207415, "verses": [{"verse": 1, "start": 300, "end": 11948, "text": "Estas cosas habló Jesús, y levantados los ojos al cielo, dijo: Padre, la hora es llegada; glorifica a tu Hijo, para que también tu Hijo te glorifique a ti;", "words": [[0, 300], [6, 676], [12, 1016], [18, 1476], [25, 1856], [27, 2596], [38, 3296], [42, 3496], [47, 3836], [50, 4136], [57, 4456], [63, 5376], [70, 6118], [73, 6258], [78, 6438], [81, 6718], [90, 8230], [100, 8620], [102, 8820], [105, 8980], [111, 9240], [116, 9820], [120, 9960], [128, 10280], [131, 10520], [136, 10760], [139, 10960], [150, 11520], [152, 11680]]}, {"verse": 2, "start": 12398, "end": 19068, "text": "Como le has dado autoridad sobre toda carne, para que dé vida eterna a todos los que le diste.", "words": [[0, 12398], [5, 12586], [8, 12746], [12, 12866], [17, 13106], [27, 13746], [33, 14066], [38, 14426], [45, 15486], [50, 15866], [54, 16046], [57, 16206], [62, 16606], [69, 17246], [71, 17486], [77, 17926], [81, 18206], [85, 18366], [88, 18486]]}, {"verse": 3, "start": 19518, "end": 27668, "text": "Y esta es la vida eterna: que te conozcan a ti, el único Dios verdadero, y a Jesucristo, al cual has enviado.", "words": [[0, 19518], [2, 19684], [7, 19864], [10, 20024], [13, 20124], [18, 20284], [26, 21293], [30, 21397], [33, 21517], [42, 22077], [44, 22217], [48, 22897], [51, 23197], [57, 23637], [62, 24077], [73, 24877], [75, 25057], [77, 25177], [89, 25937], [92, 26217], [97, 26437], [101, 26817]]}, {"verse": 4, "start": 28118, "end": 33296, "text": "Yo te he glorificado en la tierra: he acabado la obra que me diste que hiciese.", "words": [[0, 28118], [3, 28304], [6, 28484], [9, 28944], [21, 29404], [24, 29504], [27, 29604], [35, 30593], [38, 30837], [46, 31337], [49, 31497], [54, 31757], [58, 31957], [61, 32097], [67, 32457], [71, 32557]]}, {"verse": 5, "start": 33746, "end": 41326, "text": "Ahora pues, Padre, glorifícame tú cerca de ti mismo con aquella gloria que tuve cerca de ti antes que el mundo fuese.", "words": [[0, 33746], [6, 34232], [12, 34632], [19, 35372], [31, 36112], [34, 36392], [40, 36752], [43, 37072], [46, 37192], [52, 37532], [56, 37812], [64, 38172], [71, 38572], [75, 38712], [80, 38992], [86, 39272], [89, 39532], [92, 39712], [98, 40112], [102, 40312], [105, 40432], [111, 40672]]}, {"verse": 6, "start": 41776, "end": 48962, "text": "He manifestado tu nombre a los hombres que del mundo me diste: tuyos eran, y me los diste, y guardaron tu palabra.", "words": [[0, 41776], [3, 42021], [15, 42701], [18, 42861], [25, 43201], [27, 43361], [31, 43501], [39, 43881], [43, 44081], [47, 44221], [53, 44652], [56, 45082], [63, 45970], [69, 46230], [75, 46490], [77, 46630], [80, 46750], [84, 46890], [91, 47370], [93, 47530], [103, 48150], [106, 48330]]}, {"verse": 7, "start": 49412, "end": 52824, "text": "Ahora han conocido que todas las cosas que me diste, son de ti;", "words": [[0, 49412], [6, 49660], [10, 49880], [19, 50420], [23, 50540], [29, 50800], [33, 51100], [39, 51400], [43, 51600], [46, 51720], [53, 52080], [57, 52220], [60, 52480]]}, {"verse": 8, "start": 53274, "end": 63298, "text": "Porque las palabras que me diste, les he dado; y ellos las recibieron, y han conocido verdaderamente que salí de ti, y han creído que tú me enviaste.", "words": [[0, 53274], [7, 53654], [11, 53834], [20, 54214], [24, 54454], [27, 54594], [34, 55114], [38, 55394], [41, 55614], [47, 56476], [49, 56619], [55, 56879], [59, 57099], [71, 57819], [73, 58419], [77, 58539], [86, 59099], [101, 59879], [105, 60099], [110, 60479], [113, 60579], [117, 60839], [119, 61519], [123, 61639], [130, 62079], [134, 62259], [137, 62419], [140, 62539]]}, {"verse": 9, "start": 63748, "end": 70048, "text": "Yo ruego por ellos: no ruego por el mundo, sino por los que me diste; porque tuyos son:", "words": [[0, 63748], [3, 63936], [9, 64276], [13, 64496], [20, 65417], [23, 65581], [29, 65961], [33, 66181], [36, 66321], [43, 66601], [48, 66901], [52, 67421], [56, 67561], [60, 67721], [63, 67861], [70, 68772], [77, 69106], [83, 69476]]}, {"verse": 10, "start": 70498, "end": 77107, "text": "Y todas mis cosas son tus cosas, y tus cosas son mis cosas: y he sido glorificado en ellas.", "words": [[0, 70498], [2, 70606], [8, 70766], [12, 71046], [18, 71406], [22, 71726], [26, 71886], [33, 72706], [35, 72906], [39, 73046], [45, 73346], [49, 73666], [53, 73826], [60, 74866], [62, 75143], [65, 75243], [70, 75463], [82, 76363], [85, 76523]]}, {"verse": 11, "start": 77557, "end": 89286, "text": "Y ya no estoy en el mundo; pero estos están en el mundo, y yo a ti vengo. Padre santo, a los que me has dado, guárdalos por tu nombre, para que sean uno, como también nosotros.", "words": [[0, 77557], [2, 77674], [5, 77814], [8, 77934], [14, 78134], [17, 78334], [20, 78434], [27, 79317], [32, 79459], [38, 79719], [44, 80159], [47, 80359], [50, 80499], [57, 80879], [59, 81659], [62, 81919], [64, 82179], [67, 82339], [74, 83245], [80, 83547], [87, 83887], [89, 84127], [93, 84207], [97, 84347], [100, 84467], [104, 84627], [110, 85347], [120, 85967], [124, 86147], [127, 86327], [135, 86667], [140, 86987], [144, 87127], [149, 87407], [154, 87807], [159, 88067], [167, 88447]]}, {"verse": 12, "start": 89736, "end": 102765, "text": "Cuando estaba con ellos en el mundo, yo los guardaba en tu nombre; a los que me diste, yo los guardé, y ninguno de ellos se perdió, sino el hijo de perdición; para que la Escritura se cumpliese.", "words": [[0, 89736], [7, 89920], [14, 90220], [18, 90580], [24, 90760], [27, 91040], [30, 91180], [37, 91500], [40, 91700], [44, 91900], [53, 92440], [56, 92620], [59, 92760], [67, 93758], [69, 93898], [73, 94018], [77, 94158], [80, 94338], [87, 95118], [90, 95278], [94, 95478], [102, 96358], [104, 96438], [112, 97118], [115, 97278], [121, 97558], [124, 97818], [132, 98618], [137, 98878], [140, 99098], [145, 99358], [148, 99498], [159, 100752], [164, 100896], [168, 101056], [171, 101176], [181, 101716], [184, 101876]]}, {"verse": 13, "start": 103215, "end": 109939, "text": "Pero ahora vengo a ti; y hablo esto en el mundo, para que tengan mi gozo cumplido en sí mismos.", "words": [[0, 103215], [5, 103361], [11, 103581], [17, 103961], [19, 104061], [23, 104662], [25, 104807], [31, 105147], [36, 105387], [39, 105567], [42, 105687], [49, 106047], [54, 106647], [58, 106807], [65, 107147], [68, 107447], [73, 107827], [82, 108527], [85, 108707], [88, 108867]]}, {"verse": 14, "start": 110389, "end": 117733, "text": "Yo les he dado tu palabra; y el mundo los aborreció, porque no son del mundo, como tampoco yo soy del mundo.", "words": [[0, 110389], [3, 110640], [7, 110980], [10, 111180], [15, 111460], [18, 111660], [27, 112715], [29, 112854], [32, 113034], [38, 113334], [42, 113614], [53, 114454], [60, 114734], [63, 114954], [67, 115174], [71, 115354], [78, 115734], [83, 116014], [91, 116414], [94, 116754], [98, 116974], [102, 117154]]}, {"verse": 15, "start": 118183, "end": 122645, "text": "No ruego que los quites del mundo, sino que los guardes del mal.", "words": [[0, 118183], [3, 118516], [9, 118976], [13, 119156], [17, 119336], [24, 119696], [28, 119876], [35, 120716], [40, 121056], [44, 121276], [48, 121436], [56, 121936], [60, 122096]]}, {"verse": 16, "start": 123095, "end": 126126, "text": "No son del mundo, como tampoco yo soy del mundo.", "words": [[0, 123095], [3, 123279], [7, 123479], [11, 123659], [18, 124039], [23, 124299], [31, 124719], [34, 125099], [38, 125339], [42, 125519]]}, {"verse": 17, "start": 126576, "end": 129892, "text": "Santifícalos en tu verdad: tu palabra es verdad.", "words": [[0, 127062], [13, 127582], [16, 127742], [19, 127842], [27, 128674], [30, 128760], [38, 129120], [41, 129340]]}, {"verse": 18, "start": 130342, "end": 134972, "text": "Como tú me enviaste al mundo, también los he enviado al mundo.", "words": [[0, 130342], [5, 130505], [8, 130765], [11, 130985], [20, 131625], [23, 131805], [30, 132605], [38, 132885], [42, 133265], [45, 133645], [53, 134245], [56, 134405]]}, {"verse": 19, "start": 135422, "end": 142267, "text": "Y por ellos yo me santifico a mí mismo, para que también ellos sean santificados en verdad.", "words": [[0, 135422], [2, 135539], [6, 135799], [12, 136179], [15, 136819], [18, 136999], [28, 137719], [30, 137739], [33, 137859], [40, 138559], [45, 138979], [49, 139139], [57, 139519], [63, 139939], [68, 140479], [81, 141419], [84, 141619]]}, {"verse": 20, "start": 142717, "end": 149008, "text": "Mas no ruego solamente por estos, sino también por los que han de creer en mí por la palabra de ellos.", "words": [[0, 142717], [4, 142717], [7, 143002], [13, 143382], [23, 143742], [27, 144202], [34, 145082], [39, 145422], [47, 145822], [51, 146142], [55, 146322], [59, 146522], [63, 146682], [66, 146822], [72, 147182], [75, 147302], [78, 147462], [82, 147702], [85, 147842], [93, 148182], [96, 148402]]}, {"verse": 21, "start": 149458, "end": 159429, "text": "Para que todos sean uno; como tú, oh Padre, en mí, y yo en ti, que también ellos sean uno en nosotros: para que el mundo crea que tú me enviaste.", "words": [[0, 149458], [5, 149605], [9, 149725], [15, 149945], [20, 150305], [25, 151059], [30, 151242], [34, 151482], [37, 151722], [44, 152102], [47, 152442], [51, 152662], [53, 152942], [56, 153142], [59, 153322], [63, 153822], [67, 154002], [75, 154362], [81, 154682], [86, 155042], [90, 155442], [93, 155642], [103, 156783], [108, 156987], [112, 157187], [115, 157327], [121, 157587], [126, 158067], [130, 158167], [133, 158387], [136, 158587]]}, {"verse": 22, "start": 159879, "end": 166560, "text": "Y yo, la gloria que me diste les he dado; para que sean uno, como también nosotros somos uno.", "words": [[0, 159879], [2, 159985], [6, 160165], [9, 160325], [16, 160725], [20, 160865], [23, 161025], [29, 161445], [33, 161525], [36, 161725], [42, 162505], [47, 162668], [51, 162828], [56, 163108], [61, 163728], [66, 163908], [74, 164288], [83, 164608], [89, 165128]]}, {"verse": 23, "start": 167010, "end": 177422, "text": "Yo en ellos, y tú en mí, para que sean plenamente uno; que el mundo conozca que tú me enviaste, y que los has amado, como también a mí me has amado.", "words": [[0, 167010], [3, 167010], [6, 167179], [13, 167499], [15, 167839], [18, 168079], [21, 168259], [25, 168479], [30, 169019], [34, 169179], [39, 169479], [50, 170219], [55, 171035], [59, 171157], [62, 171277], [68, 171557], [76, 172177], [80, 172317], [83, 172477], [86, 172617], [96, 173197], [98, 173777], [102, 173897], [106, 174057], [110, 174317], [117, 175017], [122, 175437], [130, 175897], [132, 176177], [135, 176357], [138, 176557], [142, 176777]]}, {"verse": 24, "start": 177872, "end": 189909, "text": "Padre, aquellos que me has dado, quiero que donde yo estoy, ellos estén también conmigo; para que vean mi gloria que me has dado: por cuanto me has amado desde antes de la fundación del mundo.", "words": [[0, 177872], [7, 178316], [16, 178576], [20, 178876], [23, 179016], [27, 179196], [33, 179676], [40, 179876], [44, 180096], [50, 180276], [53, 180616], [60, 181536], [66, 181936], [72, 182416], [80, 182970], [89, 183754], [94, 184084], [98, 184244], [103, 184584], [106, 184764], [113, 185184], [117, 185344], [120, 185504], [124, 185684], [130, 186507], [134, 186631], [141, 186851], [144, 187171], [148, 187331], [154, 187771], [160, 188011], [166, 188311], [169, 188491], [172, 188591], [182, 189111], [186, 189311]]}, {"verse": 25, "start": 190359, "end": 196610, "text": "Padre justo, el mundo no te ha conocido, pero yo te he conocido; y estos han conocido que tú me enviaste;", "words": [[0, 190359], [6, 190739], [13, 190979], [16, 191219], [22, 191579], [25, 191679], [28, 191819], [31, 191899], [41, 192539], [46, 192679], [49, 192899], [52, 193079], [55, 193179], [65, 194203], [67, 194349], [73, 194609], [77, 194868], [86, 195409], [90, 195549], [93, 195709], [96, 195849]]}, {"verse": 26, "start": 197060, "end": 207015, "text": "Y yo les he manifestado tu nombre, y lo manifestaré aún; para que el amor con que me has amado, esté en ellos, y yo en ellos.", "words": [[0, 197060], [2, 197202], [5, 197422], [9, 197662], [12, 197862], [24, 198622], [27, 198802], [35, 199242], [37, 199882], [40, 200002], [52, 200762], [57, 201729], [62, 201873], [66, 202053], [69, 202293], [74, 202653], [78, 203193], [82, 203373], [85, 203573], [89, 203773], [96, 204413], [101, 204793], [104, 205053], [111, 205353], [113, 205993], [116, 206253], [119, 206453]]}]}