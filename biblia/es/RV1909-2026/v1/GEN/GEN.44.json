{"book": "GEN", "chapter": 44, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 275470, "verses": [{"verse": 1, "start": 300, "end": 10833, "text": "Y mandó José al mayordomo de su casa, diciendo: Llena los costales de estos varones de alimentos, cuanto puedan llevar, y pon el dinero de cada uno en la boca de su costal:", "words": [[0, 300], [2, 427], [8, 787], [13, 1107], [16, 1567], [26, 2027], [29, 2127], [32, 2267], [38, 3367], [48, 4508], [54, 4704], [58, 4884], [67, 5324], [70, 5524], [76, 5704], [84, 6204], [87, 6364], [98, 6804], [105, 7104], [112, 7524], [120, 7844], [122, 8194], [126, 8544], [129, 8664], [136, 8904], [139, 9084], [144, 9284], [148, 9584], [151, 9724], [154, 9804], [159, 10004], [162, 10184], [165, 10284]]}, {"verse": 2, "start": 11283, "end": 20037, "text": "Y pondrás mi copa, la copa de plata, en la boca del costal del menor, con el dinero de su trigo. Y él hizo como dijo José.", "words": [[0, 11283], [2, 11406], [10, 11826], [13, 12026], [19, 12986], [22, 13106], [27, 13446], [30, 13546], [37, 13966], [40, 14526], [43, 14646], [48, 14866], [52, 15106], [59, 15566], [63, 15706], [70, 16406], [74, 16566], [77, 16686], [84, 16986], [87, 17166], [90, 17286], [97, 18150], [99, 18307], [102, 18427], [107, 18867], [112, 19147], [117, 19467]]}, {"verse": 3, "start": 20487, "end": 24305, "text": "Venida la mañana, los hombres fueron despedidos con sus asnos.", "words": [[0, 20487], [7, 21095], [10, 21235], [18, 21595], [22, 21835], [30, 22195], [37, 22495], [48, 23235], [52, 23415], [56, 23595]]}, {"verse": 4, "start": 24755, "end": 38960, "text": "Habiendo ellos salido de la ciudad, de la que aún no se habían alejado, dijo José a su mayordomo: Levántate, y sigue a esos hombres; y cuando los alcances, diles: ¿Por qué habéis vuelto mal por bien?", "words": [[0, 24755], [9, 25068], [15, 25418], [22, 25978], [25, 26118], [28, 26258], [36, 27018], [39, 27258], [42, 27398], [46, 27598], [50, 27958], [53, 28398], [56, 28898], [63, 29398], [72, 29898], [77, 30298], [82, 30798], [84, 31178], [87, 31780], [98, 32566], [109, 33185], [111, 33445], [117, 33725], [119, 33865], [124, 34025], [133, 34950], [135, 35052], [142, 35232], [146, 35452], [156, 36452], [163, 37248], [168, 37369], [172, 37529], [179, 37809], [186, 38129], [190, 38329], [194, 38529]]}, {"verse": 5, "start": 39410, "end": 45316, "text": "¿No es esta en la que bebe mi señor, y por la que suele adivinar? habéis hecho mal en lo que hicisteis.", "words": [[0, 39410], [4, 39572], [7, 39772], [12, 40052], [15, 40192], [18, 40292], [22, 40412], [27, 40672], [30, 40772], [37, 41072], [39, 41552], [43, 41732], [46, 41832], [50, 41952], [56, 42232], [66, 43090], [73, 43490], [79, 43730], [83, 44030], [86, 44190], [89, 44310], [93, 44450]]}, {"verse": 6, "start": 45666, "end": 49056, "text": "Y como él los alcanzó, les dijo estas palabras.", "words": [[0, 45666], [2, 45768], [7, 46008], [10, 46228], [14, 46348], [23, 47468], [27, 47588], [32, 47948], [38, 48168]]}, {"verse": 7, "start": 49506, "end": 55637, "text": "Y ellos le respondieron: ¿Por qué dice mi señor tales cosas? Nunca tal hagan tus siervos.", "words": [[0, 49506], [2, 49713], [8, 49953], [11, 50133], [25, 51312], [30, 51436], [34, 51616], [39, 51896], [42, 52076], [48, 52376], [54, 52616], [61, 53667], [67, 54115], [71, 54355], [77, 54735], [81, 54875]]}, {"verse": 8, "start": 56087, "end": 67689, "text": "He aquí, el dinero que hallamos en la boca de nuestros costales, te lo volvimos a traer desde la tierra de Canaán; ¿cómo, pues, habíamos de hurtar de casa de tu señor plata ni oro?", "words": [[0, 56133], [3, 56213], [9, 56473], [12, 56693], [19, 57053], [23, 57273], [32, 57633], [35, 57793], [38, 57913], [43, 58113], [46, 58313], [55, 58493], [65, 59573], [68, 59793], [71, 59933], [80, 60373], [82, 60573], [88, 60993], [94, 61173], [97, 61373], [104, 61693], [107, 61933], [115, 62880], [122, 63104], [128, 64124], [137, 64644], [140, 64964], [147, 65284], [150, 65444], [155, 65844], [158, 66084], [161, 66244], [167, 66584], [173, 66924], [176, 67264]]}, {"verse": 9, "start": 68139, "end": 76858, "text": "Aquel de tus siervos en quien sea hallada la copa, que muera, y los demás seremos esclavos de mi señor.", "words": [[0, 68139], [6, 68656], [9, 68796], [13, 68956], [21, 69636], [24, 69916], [30, 70136], [34, 70596], [42, 71156], [45, 71316], [51, 72196], [55, 72256], [62, 73196], [64, 73556], [68, 73736], [74, 74096], [82, 75176], [91, 75896], [94, 76056], [97, 76196]]}, {"verse": 10, "start": 77308, "end": 85456, "text": "Y él dijo: También ahora sea conforme a vuestras palabras; aquel en quien se halle, será mi siervo, y vosotros seréis sin culpa.", "words": [[0, 77308], [2, 77497], [5, 77657], [11, 78425], [19, 78701], [25, 79021], [29, 79301], [38, 79981], [40, 80021], [49, 80401], [59, 81449], [65, 81813], [68, 81933], [74, 82073], [77, 82293], [84, 82573], [89, 82893], [92, 83093], [100, 83573], [102, 83953], [111, 84393], [118, 84753], [122, 84913]]}, {"verse": 11, "start": 85806, "end": 93699, "text": "Ellos entonces se dieron prisa, y derribando cada uno su costal en tierra, abrió cada cual el costal suyo.", "words": [[0, 85806], [6, 86190], [15, 86730], [18, 87030], [25, 87330], [32, 88530], [34, 88570], [45, 89330], [50, 89570], [54, 89890], [57, 90110], [64, 90590], [67, 90730], [75, 91570], [81, 91950], [86, 92190], [91, 92490], [94, 92630], [101, 93130]]}, {"verse": 12, "start": 94149, "end": 101628, "text": "Y buscó; desde el mayor comenzó, y acabó en el menor; y la copa fue hallada en el costal de Benjamín.", "words": [[0, 94149], [2, 94292], [9, 95119], [15, 95325], [18, 95505], [24, 95765], [33, 96545], [35, 96865], [41, 97405], [44, 97565], [47, 97725], [54, 98565], [56, 98688], [59, 98808], [64, 99208], [68, 99388], [76, 99888], [79, 100028], [82, 100168], [89, 100688], [92, 100808]]}, {"verse": 13, "start": 102078, "end": 109144, "text": "Entonces ellos rasgaron sus vestidos, y cargó cada uno su asno, y volvieron a la ciudad.", "words": [[0, 102078], [9, 102595], [15, 103475], [24, 104355], [28, 104535], [38, 105215], [40, 105455], [46, 105975], [51, 106215], [55, 106515], [58, 106755], [64, 107235], [66, 107695], [76, 108255], [78, 108395], [81, 108495]]}, {"verse": 14, "start": 109594, "end": 116533, "text": "Y llegó Judá con sus hermanos a casa de José, que aún estaba allí, y se postraron delante de él en tierra.", "words": [[0, 109594], [2, 109716], [8, 109976], [13, 110396], [17, 110616], [21, 110816], [30, 111496], [32, 111596], [37, 111836], [40, 112036], [46, 112536], [50, 112616], [54, 112816], [61, 113116], [67, 113876], [69, 113956], [72, 114076], [82, 114896], [90, 115376], [93, 115556], [96, 115716], [99, 115856]]}, {"verse": 15, "start": 116983, "end": 122472, "text": "Y les dijo José: ¿Qué obra es esta que habéis hecho? ¿no sabéis que un hombre como yo sabe adivinar?", "words": [[0, 116983], [2, 117089], [6, 117209], [11, 117489], [17, 118246], [22, 118328], [27, 118508], [30, 118748], [35, 119008], [39, 119168], [46, 119468], [53, 120210], [57, 120309], [64, 120649], [68, 120829], [71, 120949], [78, 121129], [83, 121369], [86, 121569], [91, 121789]]}, {"verse": 16, "start": 122822, "end": 138206, "text": "Entonces dijo Judá: ¿Qué diremos a mi señor? ¿qué hablaremos? ¿o con qué nos justificaremos? Dios ha hallado la maldad de tus siervos: he aquí, nosotros somos siervos de mi señor, nosotros, y también aquel en cuyo poder fue hallada la copa.", "words": [[0, 122822], [9, 123385], [14, 124045], [20, 124892], [25, 124976], [33, 125356], [35, 125456], [38, 125556], [45, 126326], [50, 126410], [62, 127420], [65, 127504], [69, 127664], [73, 127764], [77, 127924], [93, 129190], [98, 129408], [101, 129708], [109, 130088], [112, 130208], [119, 130568], [122, 130708], [126, 130848], [135, 131786], [138, 131929], [144, 132189], [153, 132409], [159, 132969], [167, 133509], [170, 133669], [173, 133769], [180, 134469], [190, 135409], [192, 135529], [200, 135829], [206, 136309], [209, 136429], [214, 136669], [220, 136929], [224, 137249], [232, 137609], [235, 137729]]}, {"verse": 17, "start": 138556, "end": 147447, "text": "Y él respondió: Nunca yo tal haga: el varón en cuyo poder fue hallada la copa, él será mi siervo; vosotros id en paz a vuestro padre.", "words": [[0, 138556], [2, 138738], [5, 138878], [16, 139923], [22, 140320], [25, 140623], [29, 140927], [35, 141486], [38, 141589], [44, 141909], [47, 142049], [52, 142269], [58, 142569], [62, 142789], [70, 143129], [73, 143269], [79, 144029], [82, 144109], [87, 144329], [90, 144529], [98, 145365], [107, 145753], [110, 146183], [113, 146283], [117, 146443], [119, 146603], [127, 146923]]}, {"verse": 18, "start": 147797, "end": 160752, "text": "Entonces Judá se llegó a él, y dijo: Ay señor mío, te ruego que hable tu siervo una palabra en oídos de mi señor, y no se encienda tu enojo contra tu siervo, pues que tú eres como Faraón.", "words": [[0, 147797], [9, 148377], [14, 148987], [17, 149367], [23, 149687], [25, 149847], [29, 150107], [31, 150727], [37, 151626], [40, 151843], [46, 152103], [51, 153083], [54, 153223], [60, 153483], [64, 153683], [70, 153923], [73, 154063], [80, 154463], [84, 154623], [92, 155003], [95, 155223], [101, 155563], [104, 155663], [107, 155763], [114, 156143], [116, 156643], [119, 156783], [122, 156923], [131, 157343], [134, 157503], [140, 157863], [147, 158143], [150, 158363], [158, 159247], [163, 159349], [167, 159529], [170, 159709], [175, 159889], [180, 160129]]}, {"verse": 19, "start": 161202, "end": 165264, "text": "Mi señor preguntó a sus siervos, diciendo: ¿Tenéis padre o hermano?", "words": [[0, 161202], [3, 161288], [9, 161548], [18, 162128], [20, 162188], [24, 162348], [33, 163028], [43, 163911], [51, 164191], [57, 164531], [59, 164731]]}, {"verse": 20, "start": 165714, "end": 176865, "text": "Y nosotros respondimos a mi señor: Tenemos un padre anciano, y un mozo que le nació en su vejez, pequeño aún; y un hermano suyo murió, y él quedó solo de su madre, y su padre lo ama.", "words": [[0, 165714], [2, 165814], [11, 166094], [23, 166794], [25, 166954], [28, 167034], [35, 167806], [43, 168010], [46, 168230], [52, 168490], [61, 169150], [63, 169410], [66, 169530], [71, 169870], [75, 169990], [78, 170090], [84, 170410], [87, 170650], [90, 170890], [97, 171130], [105, 171390], [110, 172167], [112, 172306], [115, 172446], [123, 172846], [128, 173106], [135, 173826], [137, 174106], [140, 174226], [146, 174506], [151, 174726], [154, 174886], [157, 175026], [164, 175746], [166, 175806], [169, 175926], [175, 176206], [178, 176446]]}, {"verse": 21, "start": 177315, "end": 181506, "text": "Y tú dijiste a tus siervos: Traédmelo, y pondré mis ojos sobre él.", "words": [[0, 177315], [2, 177417], [5, 177557], [13, 177977], [15, 178077], [19, 178177], [28, 179112], [39, 179657], [41, 179957], [48, 180337], [52, 180497], [57, 180717], [63, 181057]]}, {"verse": 22, "start": 181956, "end": 188088, "text": "Y nosotros dijimos a mi señor: El joven no puede dejar a su padre, porque si lo deja, su padre morirá.", "words": [[0, 181956], [2, 182062], [11, 182342], [19, 182902], [21, 183062], [24, 183142], [31, 183970], [34, 184076], [40, 184376], [43, 184516], [49, 184756], [55, 185096], [57, 185176], [60, 185316], [67, 185956], [74, 186196], [77, 186376], [80, 186516], [86, 187076], [89, 187196], [95, 187476]]}, {"verse": 23, "start": 188538, "end": 194651, "text": "Y dijiste a tus siervos: Si vuestro hermano menor no desciende con vosotros, no veáis más mi rostro.", "words": [[0, 188538], [2, 188647], [10, 189027], [12, 189107], [16, 189187], [25, 190178], [28, 190338], [36, 190698], [44, 191058], [50, 191338], [53, 191558], [63, 192018], [67, 192238], [77, 193018], [80, 193298], [86, 193698], [90, 193858], [93, 194078]]}, {"verse": 24, "start": 195101, "end": 199869, "text": "Aconteció pues, que como llegamos a mi padre tu siervo, le contamos las palabras de mi señor.", "words": [[0, 195101], [10, 195644], [16, 195864], [20, 196064], [25, 196264], [34, 196704], [36, 196804], [39, 196904], [45, 197264], [48, 197384], [56, 198124], [59, 198204], [68, 198604], [72, 198744], [81, 199044], [84, 199304], [87, 199404]]}, {"verse": 25, "start": 200319, "end": 203897, "text": "Y dijo nuestro padre: Volved a comprarnos un poco de alimento.", "words": [[0, 200319], [2, 200425], [7, 200625], [15, 200865], [22, 201755], [29, 202099], [31, 202199], [42, 202739], [45, 202939], [50, 203119], [53, 203279]]}, {"verse": 26, "start": 204347, "end": 214783, "text": "Y nosotros respondimos: No podemos ir: si nuestro hermano va con nosotros, iremos; porque no podemos ver el rostro del varón, si no está con nosotros nuestro hermano el menor.", "words": [[0, 204347], [2, 204450], [11, 204730], [24, 206043], [27, 206149], [35, 206449], [39, 207156], [42, 207282], [50, 207442], [58, 207922], [61, 208022], [65, 208182], [75, 208982], [83, 209864], [90, 210049], [93, 210229], [101, 210549], [105, 210829], [108, 210989], [115, 211349], [119, 211469], [126, 211909], [129, 212389], [132, 212509], [137, 212749], [141, 212989], [150, 213449], [158, 213809], [166, 214289], [169, 214369]]}, {"verse": 27, "start": 215233, "end": 220334, "text": "Entonces tu siervo mi padre nos dijo: Vosotros sabéis que dos me parió mi mujer;", "words": [[0, 215233], [9, 215655], [12, 215895], [19, 216295], [22, 216415], [28, 216695], [32, 216895], [38, 217663], [47, 218107], [54, 218567], [58, 218747], [62, 218947], [65, 219147], [71, 219427], [74, 219567]]}, {"verse": 28, "start": 220784, "end": 226879, "text": "Y el uno salió de conmigo, y pienso de cierto que fue despedazado, y hasta ahora no le he visto;", "words": [[0, 220784], [2, 220879], [5, 220919], [9, 221059], [15, 221419], [18, 221519], [27, 222059], [29, 222299], [36, 222579], [39, 222859], [46, 223139], [50, 223359], [54, 223539], [67, 224399], [69, 224819], [75, 225019], [81, 225279], [84, 225439], [87, 225579], [90, 225679]]}, {"verse": 29, "start": 227329, "end": 235565, "text": "Y si también tomáis a este de delante de mí, y le ocurre algún desastre, haréis descender mis canas con dolor a la sepultura.", "words": [[0, 227329], [2, 227426], [5, 227486], [13, 227806], [20, 228186], [22, 228326], [27, 228546], [30, 228706], [38, 229066], [41, 229206], [45, 229426], [47, 229946], [50, 230046], [57, 230366], [63, 230606], [73, 231546], [80, 231886], [90, 232326], [94, 232506], [100, 232886], [104, 233046], [110, 233326], [112, 233426], [115, 233526]]}, {"verse": 30, "start": 236015, "end": 243169, "text": "Ahora, pues, cuando yo vuelva a tu siervo mi padre, si el joven no va conmigo, como su alma está ligada al alma de él,", "words": [[0, 236015], [7, 236234], [13, 236994], [20, 237194], [23, 237504], [30, 237814], [32, 237854], [35, 237974], [42, 238334], [45, 238454], [52, 239214], [55, 239414], [58, 239514], [64, 239874], [67, 240034], [70, 240134], [79, 240954], [84, 241134], [87, 241334], [92, 241574], [97, 241854], [104, 242314], [107, 242434], [112, 242654], [115, 242874]]}, {"verse": 31, "start": 243619, "end": 251798, "text": "Sucederá que cuando no vea al joven, morirá: y tus siervos harán descender las canas de tu siervo nuestro padre con dolor a la sepultura.", "words": [[0, 243619], [9, 244203], [13, 244323], [20, 244563], [23, 244763], [27, 244963], [30, 245123], [37, 245663], [45, 246968], [47, 247074], [51, 247194], [59, 247614], [65, 247934], [75, 248414], [79, 248554], [85, 248954], [88, 249054], [91, 249174], [98, 249614], [106, 249774], [112, 250354], [116, 250494], [122, 250814], [124, 250994], [127, 251054]]}, {"verse": 32, "start": 252148, "end": 261753, "text": "Como tu siervo salió por fiador del joven con mi padre, diciendo: Si no te lo vuelvo a traer, entonces yo seré culpable ante mi padre para siempre;", "words": [[0, 252148], [5, 252293], [8, 252493], [15, 252973], [21, 253353], [25, 253593], [32, 254113], [36, 254373], [42, 254793], [46, 254953], [49, 255153], [56, 255953], [66, 256907], [69, 257024], [72, 257164], [75, 257284], [78, 257404], [85, 257724], [87, 257844], [94, 258544], [103, 258924], [106, 259344], [111, 259684], [120, 260184], [125, 260384], [128, 260564], [134, 260884], [139, 261144]]}, {"verse": 33, "start": 262203, "end": 269091, "text": "Te ruego por tanto que quede ahora tu siervo por el mozo por siervo de mi señor, y que el joven vaya con sus hermanos.", "words": [[0, 262203], [3, 262301], [9, 262581], [13, 262761], [19, 263021], [23, 263281], [29, 263561], [35, 263801], [38, 264001], [45, 264461], [49, 264661], [52, 264781], [57, 265501], [61, 265661], [68, 266121], [71, 266221], [74, 266321], [81, 267121], [83, 267181], [87, 267301], [90, 267401], [96, 267741], [101, 267981], [105, 268181], [109, 268341]]}, {"verse": 34, "start": 269541, "end": 275070, "text": "Porque ¿cómo iré yo a mi padre sin el joven? No podré, por no ver el mal que sobrevendrá a mi padre.", "words": [[0, 269661], [7, 269781], [13, 270061], [17, 270321], [20, 270501], [22, 270621], [25, 270741], [31, 271041], [35, 271301], [38, 271461], [45, 272235], [48, 272339], [55, 272639], [59, 272879], [62, 272999], [66, 273199], [69, 273339], [73, 273519], [77, 273699], [89, 274359], [91, 274459], [94, 274539]]}]}