{"book": "LUK", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 267609, "verses": [{"verse": 1, "start": 300, "end": 11653, "text": "Y dijo también a sus discípulos: Había un hombre rico, el cual tenía un mayordomo, y este fue acusado delante de él como derrochador de sus bienes.", "words": [[0, 300], [2, 407], [7, 687], [15, 1167], [17, 1527], [21, 1707], [33, 2974], [39, 3278], [42, 3418], [49, 3738], [55, 4938], [58, 5018], [63, 5198], [69, 5558], [72, 6238], [83, 6918], [85, 6998], [90, 7218], [94, 7478], [102, 8238], [110, 8758], [113, 8978], [116, 9178], [121, 9518], [133, 10498], [136, 10738], [140, 10938]]}, {"verse": 2, "start": 12003, "end": 19530, "text": "Y le llamó, y le dijo: ¿Qué es esto que oigo de ti? Da cuenta de tu mayordomía, porque ya no podrás más ser mayordomo.", "words": [[0, 12003], [2, 12214], [5, 12444], [12, 12904], [14, 13104], [17, 13224], [23, 14002], [28, 14141], [31, 14321], [36, 14521], [40, 14741], [45, 14941], [48, 15101], [52, 15644], [55, 15744], [62, 15984], [65, 16224], [68, 16344], [80, 17244], [87, 17584], [90, 17804], [93, 17924], [100, 18344], [104, 18484], [108, 18804]]}, {"verse": 3, "start": 19810, "end": 29349, "text": "Entonces el mayordomo dijo dentro de sí: ¿Qué haré? que mi señor me quita la mayordomía. Cavar, no puedo; mendigar, tengo vergüenza.", "words": [[0, 19810], [9, 20395], [12, 21023], [22, 21650], [27, 21910], [34, 22530], [37, 22870], [41, 23407], [46, 23524], [52, 24184], [56, 24264], [59, 24384], [65, 24704], [68, 24904], [74, 25184], [77, 25669], [89, 26469], [96, 26659], [99, 26799], [106, 27543], [116, 28141], [122, 28541]]}, {"verse": 4, "start": 29699, "end": 34580, "text": "Yo sé lo que haré para que cuando sea quitado de la mayordomía, me reciban en sus casas.", "words": [[0, 29699], [3, 29920], [6, 30120], [9, 30240], [13, 30380], [18, 30640], [23, 30820], [27, 30980], [34, 31220], [38, 31520], [46, 32000], [49, 32120], [52, 32240], [64, 32980], [67, 33200], [75, 33660], [78, 33780], [82, 33900]]}, {"verse": 5, "start": 34860, "end": 40836, "text": "Y llamando a cada uno de los deudores de su señor, dijo al primero: ¿Cuánto debes a mi señor?", "words": [[0, 34860], [2, 34964], [11, 35464], [13, 35584], [18, 35744], [22, 36064], [25, 36204], [29, 36344], [38, 36864], [41, 37024], [44, 37164], [51, 38024], [56, 38344], [59, 38544], [68, 39399], [76, 39722], [82, 40082], [84, 40222], [87, 40282]]}, {"verse": 6, "start": 41116, "end": 49251, "text": "Y él dijo: Cien barriles de aceite. Y le dijo: Toma tu documento de deuda, y siéntate pronto, y escribe cincuenta.", "words": [[0, 41116], [2, 41304], [5, 41464], [11, 42263], [16, 42383], [25, 42923], [28, 43063], [36, 43967], [38, 44088], [41, 44188], [47, 44903], [52, 45162], [55, 45262], [65, 45882], [68, 45942], [75, 46342], [77, 46762], [86, 47242], [94, 47682], [96, 48082], [104, 48702]]}, {"verse": 7, "start": 49531, "end": 59204, "text": "Después dijo a otro: ¿Y tú, cuánto debes? Y él dijo: Cien coros de trigo. Y él le dijo: Toma tu documento de deuda, y escribe ochenta.", "words": [[0, 49531], [8, 49755], [13, 50035], [15, 50175], [21, 50854], [24, 50994], [28, 51174], [35, 51674], [42, 52433], [44, 52621], [47, 52781], [53, 53589], [58, 53719], [64, 54239], [67, 54339], [74, 55166], [76, 55333], [79, 55473], [82, 55633], [88, 56358], [93, 56618], [96, 56718], [106, 57338], [109, 57418], [116, 57778], [118, 58078], [126, 58668]]}, {"verse": 8, "start": 59484, "end": 70106, "text": "Y alabó el señor al mayordomo malo por haber actuado con astucia; porque los hijos de este siglo son en su generación más sagaces que los hijos de luz.", "words": [[0, 59484], [2, 59608], [8, 59878], [11, 60148], [17, 60588], [20, 61158], [30, 61728], [35, 62228], [39, 62373], [45, 62553], [53, 63053], [57, 63273], [66, 64210], [73, 64414], [77, 64634], [83, 64894], [86, 65114], [91, 65294], [97, 65774], [101, 66374], [104, 66634], [107, 66854], [118, 67494], [122, 68024], [130, 68554], [134, 69014], [138, 69174], [144, 69514], [147, 69674]]}, {"verse": 9, "start": 70456, "end": 79580, "text": "Y yo os digo: Haceos amigos por medio de las riquezas injustas, para que cuando estas falten, os reciban en las moradas eternas.", "words": [[0, 70456], [2, 70615], [5, 70755], [8, 70895], [14, 71584], [21, 72131], [28, 72451], [32, 72791], [38, 73151], [41, 73351], [45, 73511], [54, 73991], [64, 75171], [69, 75411], [73, 75591], [80, 75851], [86, 76211], [94, 76971], [97, 77246], [105, 77886], [108, 78046], [112, 78186], [120, 78686]]}, {"verse": 10, "start": 79930, "end": 89423, "text": "El que es fiel en lo muy poco, también en lo más es fiel: y el que en lo muy poco es injusto, también en lo más es injusto.", "words": [[0, 79930], [3, 80062], [7, 80242], [10, 80599], [15, 80959], [18, 81199], [21, 81319], [25, 81579], [31, 82299], [39, 82719], [42, 83059], [45, 83259], [49, 83429], [52, 83599], [58, 84572], [60, 84754], [63, 84934], [67, 85174], [70, 85534], [73, 85694], [77, 85914], [82, 86254], [85, 86474], [94, 87434], [102, 87814], [105, 88114], [108, 88254], [112, 88494], [115, 88594]]}, {"verse": 11, "start": 89773, "end": 94826, "text": "Pues si en las malas riquezas no fuisteis fieles, ¿quién os confiará lo verdadero?", "words": [[0, 89773], [5, 89895], [8, 90215], [11, 90355], [15, 90515], [21, 90915], [30, 91375], [33, 91595], [42, 92095], [50, 92915], [57, 93155], [60, 93315], [69, 93955], [72, 94075]]}, {"verse": 12, "start": 95176, "end": 99821, "text": "Y si en lo ajeno no fuisteis fieles, ¿quién os dará lo que es vuestro?", "words": [[0, 95176], [2, 95300], [5, 95460], [8, 95600], [11, 95760], [17, 96160], [20, 96340], [29, 96920], [37, 97780], [44, 98070], [47, 98360], [52, 98700], [55, 98840], [59, 99000], [62, 99160]]}, {"verse": 13, "start": 100171, "end": 114471, "text": "Ningún siervo puede servir a dos señores; porque o aborrecerá al uno y amará al otro, o se allegará al uno y menospreciará al otro. No podéis servir a Dios y a las riquezas.", "words": [[0, 100171], [7, 100581], [14, 101061], [20, 101291], [27, 101521], [29, 101751], [33, 101981], [42, 103155], [49, 103537], [51, 104037], [62, 104977], [65, 105217], [69, 105497], [71, 105797], [77, 106137], [80, 106417], [86, 107217], [88, 107490], [91, 107764], [100, 108037], [103, 108377], [107, 108737], [109, 109537], [123, 110337], [126, 110677], [132, 111473], [135, 111663], [142, 112143], [149, 112623], [151, 112863], [156, 113063], [158, 113303], [160, 113383], [164, 113483]]}, {"verse": 14, "start": 114821, "end": 121293, "text": "Y oían también todas estas cosas los fariseos, los cuales eran avaros, y se burlaban de él.", "words": [[0, 114821], [2, 114980], [7, 115280], [15, 115640], [21, 115940], [27, 116300], [33, 117240], [37, 117320], [47, 118300], [51, 118420], [58, 118620], [63, 118940], [71, 119460], [73, 119880], [76, 120020], [85, 120540], [88, 120840]]}, {"verse": 15, "start": 121643, "end": 134673, "text": "Y les dijo: Vosotros sois los que os justificáis a vosotros mismos delante de los hombres; pero Dios conoce vuestros corazones; porque lo que los hombres tienen por sublime, delante de Dios es abominación.", "words": [[0, 121643], [2, 121768], [6, 121888], [12, 122620], [21, 123086], [26, 123586], [30, 123966], [34, 124066], [37, 124166], [49, 125046], [51, 125166], [60, 125586], [67, 125886], [75, 126446], [78, 126586], [82, 126726], [91, 127585], [96, 127730], [101, 127930], [108, 128450], [117, 128830], [128, 129966], [135, 130130], [138, 130310], [142, 130430], [146, 130590], [154, 130890], [161, 131230], [165, 131700], [174, 132170], [182, 132770], [185, 132950], [190, 133190], [193, 133530]]}, {"verse": 16, "start": 135023, "end": 144948, "text": "La ley y los profetas hasta Juan: desde entonces el reino de Dios es anunciado, y todos se esfuerzan a entrar en él.", "words": [[0, 135023], [3, 135220], [7, 135727], [9, 135867], [13, 135967], [22, 136547], [28, 137027], [34, 137810], [40, 137978], [49, 138538], [52, 138898], [58, 139318], [61, 139458], [66, 139858], [69, 140378], [80, 141138], [82, 141878], [88, 142238], [91, 142898], [101, 143678], [103, 143938], [110, 144378], [113, 144718]]}, {"verse": 17, "start": 145298, "end": 151992, "text": "Pero más fácil cosa es pasar el cielo y la tierra, que caer un solo trazo de una letra de la ley.", "words": [[0, 145298], [5, 145442], [9, 145642], [15, 146082], [20, 146482], [23, 146762], [29, 147162], [32, 147402], [38, 147742], [40, 147942], [43, 148042], [51, 149002], [55, 149002], [60, 149422], [63, 149582], [68, 149862], [74, 150422], [77, 150582], [81, 150742], [87, 151242], [90, 151362], [93, 151502]]}, {"verse": 18, "start": 152342, "end": 162859, "text": "Cualquiera que se divorcia de su mujer, y se casa con otra, comete adulterio: y el que se casa con una mujer divorciada de su marido, comete adulterio.", "words": [[0, 152342], [11, 152805], [15, 152985], [18, 153145], [27, 153725], [30, 153865], [33, 154025], [40, 154425], [42, 154685], [45, 154825], [50, 155125], [54, 155445], [60, 156285], [67, 156585], [78, 157713], [80, 157988], [83, 158088], [87, 158228], [90, 158388], [95, 158708], [99, 159008], [103, 159188], [109, 159548], [120, 160348], [123, 160528], [126, 160648], [134, 161248], [141, 161748]]}, {"verse": 19, "start": 163209, "end": 170410, "text": "Había un hombre rico, que se vestía de púrpura y de lino fino, y hacía cada día banquete con esplendidez.", "words": [[0, 163209], [6, 163453], [9, 163693], [16, 163993], [22, 164633], [26, 164908], [29, 165068], [36, 165488], [39, 165628], [47, 166228], [49, 166328], [52, 166468], [57, 166768], [63, 167088], [65, 167688], [71, 168008], [76, 168308], [80, 168608], [89, 169168], [93, 169818]]}, {"verse": 20, "start": 170760, "end": 177494, "text": "Había también un mendigo llamado Lázaro, el cual estaba echado a la puerta de él, lleno de llagas,", "words": [[0, 170760], [6, 171078], [14, 171398], [17, 171638], [25, 172238], [33, 172518], [41, 173838], [44, 173918], [49, 174078], [56, 174418], [63, 174858], [65, 174938], [68, 174998], [75, 175298], [78, 175578], [82, 176278], [88, 176638], [91, 176758]]}, {"verse": 21, "start": 177844, "end": 186212, "text": "Y deseando hartarse de las migajas que caían de la mesa del rico; y aun los perros venían y le lamían las llagas.", "words": [[0, 177844], [2, 177971], [11, 178571], [20, 179451], [23, 179951], [27, 180341], [35, 180731], [39, 180871], [45, 181331], [48, 181471], [51, 181571], [56, 181811], [60, 182071], [66, 182896], [68, 183061], [72, 183221], [76, 183461], [83, 183941], [90, 184501], [92, 184761], [95, 184861], [102, 185281], [106, 185776]]}, {"verse": 22, "start": 186562, "end": 195466, "text": "Y aconteció que murió el mendigo, y fue llevado por los ángeles al seno de Abraham: y murió también el rico, y fue sepultado.", "words": [[0, 186562], [2, 186662], [12, 187322], [16, 187482], [22, 187902], [25, 188042], [34, 188642], [36, 189122], [40, 189302], [48, 189802], [52, 189982], [56, 190182], [64, 190742], [67, 190982], [72, 191442], [75, 191562], [84, 192402], [86, 192532], [92, 192852], [100, 193152], [103, 193452], [109, 193812], [111, 194272], [115, 194432]]}, {"verse": 23, "start": 195816, "end": 203823, "text": "Y en el infierno alzó sus ojos, estando en los tormentos, y vio a Abraham de lejos, y a Lázaro en su seno.", "words": [[0, 195816], [2, 195960], [5, 196080], [8, 196220], [17, 196860], [22, 197420], [26, 197600], [32, 198320], [40, 198860], [43, 198980], [47, 199100], [58, 200040], [60, 200240], [64, 200540], [66, 200800], [74, 201320], [77, 201580], [84, 201940], [86, 202293], [88, 202647], [95, 203000], [98, 203160], [101, 203280]]}, {"verse": 24, "start": 204173, "end": 215700, "text": "Entonces él, dando voces, dijo: Padre Abraham, ten misericordia de mí, y envía a Lázaro que moje la punta de su dedo en agua, y refresque mi lengua; porque soy atormentado en esta llama.", "words": [[0, 204173], [9, 205130], [13, 205270], [19, 205530], [26, 206070], [32, 206919], [38, 207189], [47, 207729], [51, 207829], [64, 208589], [67, 208749], [71, 208929], [73, 209289], [79, 209589], [81, 209889], [88, 210189], [92, 210349], [97, 210669], [100, 210789], [106, 211149], [109, 211269], [112, 211429], [117, 211729], [120, 211829], [126, 212089], [128, 212274], [138, 212894], [141, 213034], [149, 213741], [156, 213937], [160, 214177], [172, 214917], [175, 215057], [180, 215237]]}, {"verse": 25, "start": 215980, "end": 225629, "text": "Y le dijo Abraham: Hijo, acuérdate que recibiste tus bienes en tu vida, y Lázaro también males; pero ahora este es consolado aquí, y tú atormentado.", "words": [[0, 215980], [2, 216125], [5, 216225], [10, 216525], [19, 217593], [25, 217977], [35, 218337], [39, 218537], [49, 219097], [53, 219297], [60, 219697], [63, 219817], [66, 219937], [72, 220217], [74, 220544], [81, 220872], [89, 221212], [96, 222189], [101, 222333], [107, 222653], [112, 222993], [115, 223173], [125, 223753], [131, 224013], [133, 224473], [136, 224633]]}, {"verse": 26, "start": 225979, "end": 235801, "text": "Y además de todo esto, un gran abismo está establecido entre nosotros y vosotros, que los que quieran pasar de aquí a vosotros, no pueden, ni de allá pasar acá.", "words": [[0, 225979], [2, 226104], [9, 226404], [12, 226584], [17, 226784], [23, 227824], [26, 227984], [31, 228164], [38, 228604], [43, 228844], [55, 229524], [61, 229764], [70, 230224], [72, 230504], [82, 231004], [86, 231484], [90, 231624], [94, 231764], [102, 232064], [108, 232304], [111, 232524], [116, 232704], [118, 232804], [128, 233344], [131, 233844], [139, 234284], [142, 234744], [145, 234864], [150, 235004], [156, 235304]]}, {"verse": 27, "start": 236081, "end": 240506, "text": "Y dijo: Te ruego pues, padre, que le envíes a la casa de mi padre;", "words": [[0, 236081], [2, 236210], [8, 236932], [11, 237056], [17, 237436], [23, 237576], [30, 238516], [34, 238596], [37, 238736], [44, 239216], [46, 239336], [49, 239416], [54, 239676], [57, 239896], [60, 239996]]}, {"verse": 28, "start": 240856, "end": 247024, "text": "Porque tengo cinco hermanos; para que les testifique, porque no vengan ellos también a este lugar de tormento.", "words": [[0, 240856], [7, 241036], [13, 241316], [19, 241656], [29, 242622], [34, 242767], [38, 242887], [42, 243027], [54, 244047], [61, 244267], [64, 244467], [71, 244807], [77, 244967], [85, 245367], [87, 245587], [92, 245807], [98, 246087], [101, 246307]]}, {"verse": 29, "start": 247304, "end": 252361, "text": "Y Abraham le dice: A Moisés y a los profetas tienen: óiganlos.", "words": [[0, 247304], [2, 247447], [10, 247787], [13, 248167], [19, 248993], [21, 249114], [28, 249514], [30, 249974], [32, 250054], [36, 250194], [45, 250734], [53, 251568]]}, {"verse": 30, "start": 252641, "end": 259275, "text": "Él entonces dijo: No, padre Abraham: pero si alguno va a ellos de los muertos, se arrepentirán.", "words": [[0, 252641], [3, 253063], [12, 253515], [18, 254491], [22, 254847], [28, 255247], [37, 255812], [42, 255953], [45, 256153], [52, 256593], [55, 256733], [57, 256893], [63, 257053], [66, 257213], [70, 257353], [79, 258113], [82, 258333]]}, {"verse": 31, "start": 259555, "end": 267209, "text": "Pero Abraham le dijo: Si no oyen a Moisés y a los profetas, tampoco se persuadirán, si alguno resucita de los muertos.", "words": [[0, 259555], [5, 259719], [13, 260279], [16, 260919], [22, 261655], [25, 261809], [28, 261969], [33, 262269], [35, 262309], [42, 262729], [44, 262969], [46, 262989], [50, 263129], [60, 264009], [68, 264269], [71, 264569], [84, 265289], [87, 265609], [94, 265989], [103, 266489], [106, 266609], [110, 266709]]}]}