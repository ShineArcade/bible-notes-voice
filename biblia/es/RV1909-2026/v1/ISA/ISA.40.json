{"book": "ISA", "chapter": 40, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 290262, "verses": [{"verse": 1, "start": 300, "end": 4660, "text": "Consolaos, consolaos, pueblo mío, dice vuestro Dios.", "words": [[0, 300], [11, 1025], [22, 1985], [29, 2185], [34, 3325], [39, 3647], [47, 4027]]}, {"verse": 2, "start": 4960, "end": 17331, "text": "Hablad al corazón de Jerusalén: decidle a voces que su tiempo es ya cumplido, que su pecado es perdonado; que doble ha recibido de la mano de Jehová por todos sus pecados.", "words": [[0, 5166], [7, 5406], [10, 5506], [18, 5986], [21, 6186], [32, 7594], [40, 8238], [42, 8318], [48, 8758], [52, 8918], [55, 9098], [62, 9478], [65, 9738], [68, 9858], [78, 10698], [82, 10958], [85, 11138], [92, 11678], [95, 11878], [106, 13300], [110, 13381], [116, 13801], [119, 13961], [128, 14601], [131, 14721], [134, 14821], [139, 15101], [142, 15261], [149, 15721], [153, 15921], [159, 16201], [163, 16521]]}, {"verse": 3, "start": 17916, "end": 24714, "text": "Voz que clama en el desierto: Barred camino a Jehová: enderezad calzada en la soledad a nuestro Dios.", "words": [[0, 18070], [4, 18260], [8, 18430], [14, 18600], [17, 18760], [20, 18880], [30, 20000], [37, 20501], [44, 20888], [46, 21274], [54, 21918], [64, 22555], [72, 23155], [75, 23235], [78, 23315], [86, 23815], [88, 23895], [96, 24035]]}, {"verse": 4, "start": 25064, "end": 32426, "text": "Todo valle sea alzado, y bájese todo monte y collado; y lo torcido se enderece, y lo áspero se allane.", "words": [[0, 25064], [5, 25303], [11, 25577], [15, 25850], [23, 26510], [25, 26650], [32, 27050], [37, 27410], [43, 27890], [45, 28090], [54, 29072], [56, 29170], [59, 29310], [67, 29910], [70, 30150], [80, 30770], [82, 30990], [85, 31170], [92, 31630], [95, 31870]]}, {"verse": 5, "start": 32876, "end": 39715, "text": "Y se manifestará la gloria de Jehová, y toda carne juntamente la verá; que la boca de Jehová habló.", "words": [[0, 32876], [2, 33150], [5, 33290], [17, 34070], [20, 34190], [27, 34610], [30, 34710], [38, 35230], [40, 35450], [45, 35730], [51, 36230], [62, 36970], [65, 37170], [71, 37898], [75, 37982], [78, 38102], [83, 38382], [86, 38582], [93, 39122]]}, {"verse": 6, "start": 40165, "end": 49936, "text": "Voz que decía: Da voces. Y yo respondí: ¿Qué tengo de decir a voces? Toda carne es hierba, y toda su gloria como flor del campo:", "words": [[0, 40165], [4, 40447], [8, 40787], [15, 41683], [18, 41868], [25, 42844], [27, 42968], [30, 43108], [40, 44081], [45, 44167], [51, 44487], [54, 44686], [60, 45006], [62, 45186], [69, 46025], [74, 46290], [80, 46570], [83, 46850], [91, 47470], [93, 47630], [98, 47830], [101, 48090], [108, 48510], [113, 48750], [118, 49165], [122, 49579]]}, {"verse": 7, "start": 50386, "end": 58900, "text": "La hierba se seca, y la flor se cae; porque el viento de Jehová sopló en ella: ciertamente hierba es el pueblo.", "words": [[0, 50386], [3, 50514], [10, 50954], [13, 51134], [19, 51554], [21, 51674], [24, 51814], [29, 52054], [32, 52254], [37, 53099], [44, 53382], [47, 53762], [54, 54162], [57, 54342], [64, 54802], [70, 55382], [73, 55542], [79, 56391], [91, 57294], [98, 57794], [101, 58014], [104, 58174]]}, {"verse": 8, "start": 59350, "end": 66150, "text": "Sécase la hierba, cáese la flor: mas la palabra del Dios nuestro permanece para siempre.", "words": [[0, 59593], [7, 59873], [10, 60053], [18, 60593], [24, 61133], [27, 61273], [33, 62116], [37, 62244], [40, 62384], [48, 62724], [52, 62944], [57, 63264], [65, 64144], [75, 65124], [80, 65364]]}, {"verse": 9, "start": 66600, "end": 82636, "text": "Súbete sobre un monte alto, anunciadora de Sion; levanta fuertemente tu voz, anunciadora de Jerusalén; levántala, no temas; di a las ciudades de Judá: ¡Ved aquí el Dios vuestro!", "words": [[0, 66600], [7, 67242], [13, 67562], [16, 67762], [22, 68202], [28, 68888], [40, 69574], [43, 70261], [49, 71247], [57, 71817], [69, 72517], [72, 72837], [77, 73277], [89, 74057], [92, 74297], [103, 75708], [114, 77128], [117, 77248], [124, 78502], [127, 78805], [129, 78885], [133, 79065], [142, 79585], [145, 79765], [151, 80789], [156, 80979], [161, 81379], [164, 81719], [169, 81939]]}, {"verse": 10, "start": 83086, "end": 92981, "text": "He aquí que el Señor Jehová vendrá con fortaleza, y su brazo dominará: he aquí que su salario viene con él, y su obra delante de su rostro.", "words": [[0, 83086], [3, 83227], [8, 83587], [12, 83787], [15, 83927], [21, 84227], [28, 84847], [35, 85207], [39, 85427], [50, 86367], [52, 86727], [55, 86907], [61, 87367], [71, 88540], [74, 88610], [79, 88830], [83, 89030], [86, 89190], [94, 89670], [100, 89950], [104, 90230], [108, 90470], [110, 90910], [113, 91110], [118, 91390], [126, 91930], [129, 92090], [132, 92250]]}, {"verse": 11, "start": 93431, "end": 102832, "text": "Como pastor apacentará su rebaño; en su brazo cogerá los corderos, y en su seno los llevará; pastoreará suavemente las paridas.", "words": [[0, 93431], [5, 93862], [12, 94328], [23, 94795], [26, 94955], [34, 96059], [37, 96244], [40, 96404], [46, 96844], [53, 97344], [57, 97464], [67, 98084], [69, 98644], [72, 98784], [75, 98944], [80, 99324], [84, 99464], [93, 100381], [104, 101127], [115, 101867], [119, 102027]]}, {"verse": 12, "start": 103282, "end": 115907, "text": "¿Quién midió las aguas con su puño, y aderezó los cielos con su palmo, y con tres dedos juntó el polvo de la tierra, y pesó los montes con balanza, y con peso los collados?", "words": [[0, 103282], [7, 103466], [13, 103906], [17, 104086], [23, 104486], [27, 104646], [30, 104866], [36, 105366], [38, 105946], [46, 106566], [50, 106746], [57, 107166], [61, 107346], [64, 107566], [71, 108066], [73, 108466], [77, 108666], [82, 109006], [88, 109386], [94, 109866], [97, 109986], [103, 110486], [106, 110606], [109, 110706], [117, 111146], [119, 111786], [124, 112246], [128, 112406], [135, 112926], [139, 113086], [148, 114113], [150, 114214], [154, 114414], [159, 114814], [163, 115014]]}, {"verse": 13, "start": 116357, "end": 121019, "text": "¿Quién enseñó al espíritu de Jehová, o le aconsejo enseñándole?", "words": [[0, 116357], [7, 116873], [14, 117593], [17, 117773], [26, 118433], [29, 118513], [37, 119033], [39, 119273], [42, 119413], [51, 119993]]}, {"verse": 14, "start": 121469, "end": 131571, "text": "¿A quién demandó consejo para ser avisado? ¿Quién le enseñó el camino del juicio, o le enseñó ciencia, o le mostró la senda de la prudencia?", "words": [[0, 121469], [3, 121669], [9, 121809], [17, 122369], [25, 122989], [30, 123189], [34, 123389], [43, 124410], [50, 124737], [53, 124897], [60, 125437], [63, 125537], [70, 125857], [74, 126117], [82, 126737], [84, 127237], [87, 127377], [94, 127897], [103, 128557], [105, 129117], [108, 129237], [115, 129637], [118, 129777], [124, 130277], [127, 130377], [130, 130517]]}, {"verse": 15, "start": 132021, "end": 141671, "text": "He aquí que las naciones son reputadas como la gota de un cubo, y como el orín del peso: he aquí que hace desaparecer las islas como polvo.", "words": [[0, 132078], [3, 132168], [8, 132408], [12, 132608], [16, 132788], [25, 133228], [29, 133528], [39, 134228], [44, 134488], [47, 134668], [52, 135068], [55, 135188], [58, 135348], [64, 136208], [66, 136348], [71, 136568], [74, 136728], [79, 137048], [83, 137188], [89, 138234], [92, 138314], [97, 138514], [101, 138714], [106, 138974], [118, 140074], [122, 140274], [128, 140694], [133, 140954]]}, {"verse": 16, "start": 142121, "end": 147831, "text": "Ni el Líbano bastará para el fuego, ni todos sus animales para el sacrificio.", "words": [[0, 142121], [3, 142325], [6, 142715], [13, 143105], [21, 143605], [26, 143825], [29, 143965], [36, 144585], [39, 145205], [45, 145465], [49, 145805], [58, 146365], [63, 146705], [66, 146845]]}, {"verse": 17, "start": 148281, "end": 156885, "text": "Como nada son todas las naciones delante de él; y en su comparación serán estimadas en menos que nada, y que lo que no es.", "words": [[0, 148281], [5, 148495], [10, 148745], [14, 148965], [20, 149305], [24, 149545], [33, 150065], [41, 150525], [44, 150705], [48, 151392], [50, 151536], [53, 151696], [56, 151916], [68, 152856], [74, 153316], [84, 153936], [87, 154136], [93, 154376], [97, 154596], [103, 154936], [105, 155716], [109, 155856], [112, 156016], [116, 156156], [119, 156356]]}, {"verse": 18, "start": 157335, "end": 161638, "text": "¿A qué pues haréis semejante a Dios, o qué imagen le compondréis?", "words": [[0, 157335], [3, 157504], [7, 157644], [12, 157904], [19, 158404], [29, 159084], [31, 159204], [37, 159444], [39, 159904], [43, 160024], [50, 160364], [53, 160584]]}, {"verse": 19, "start": 162088, "end": 169331, "text": "El artífice prepara la imagen de talla, el platero le extiende el oro, y le funde cadenas de plata.", "words": [[0, 162088], [3, 162233], [12, 162813], [20, 163393], [23, 163493], [30, 163873], [33, 164073], [40, 165073], [43, 165213], [51, 165733], [54, 165873], [63, 166433], [66, 166693], [71, 166993], [73, 167653], [76, 167753], [82, 168113], [90, 168553], [93, 168673]]}, {"verse": 20, "start": 169781, "end": 178734, "text": "El pobre escoge, para ofrecerle, madera que no se corrompa; búscase un maestro sabio, que le haga una imagen de talla que no se mueva.", "words": [[0, 169781], [3, 169908], [9, 170248], [17, 170848], [22, 171088], [33, 172028], [40, 172728], [44, 172868], [47, 173048], [50, 173208], [60, 174417], [68, 174941], [71, 175121], [79, 175521], [86, 176021], [90, 176181], [93, 176341], [98, 176601], [102, 176821], [109, 177201], [112, 177461], [118, 177821], [122, 177921], [125, 178081], [128, 178221]]}, {"verse": 21, "start": 179184, "end": 188453, "text": "¿No sabéis? ¿no habéis oído? ¿nunca os lo han dicho desde el principio? ¿no habéis sido enseñados desde que la tierra se fundó?", "words": [[0, 179184], [4, 179292], [12, 180140], [16, 180270], [23, 180550], [29, 181405], [36, 181825], [39, 182085], [42, 182245], [46, 182365], [52, 182645], [58, 182905], [61, 183085], [72, 184244], [76, 184490], [83, 184990], [88, 185270], [98, 186010], [104, 186610], [108, 186930], [111, 187070], [118, 187450], [121, 187710]]}, {"verse": 22, "start": 188903, "end": 201127, "text": "Él está asentado sobre el globo de la tierra, cuyos habitantes son como langostas: él extiende los cielos como una cortina, los tiende como una tienda para morar:", "words": [[0, 188903], [3, 189048], [8, 189348], [17, 190068], [23, 190388], [26, 190608], [32, 191028], [35, 191148], [38, 191268], [46, 192028], [52, 192588], [63, 193188], [67, 193468], [72, 193728], [83, 195132], [86, 195379], [95, 196159], [99, 196359], [106, 196899], [111, 197159], [115, 197379], [124, 198339], [128, 198819], [135, 199239], [140, 199519], [144, 199759], [151, 200259], [156, 200499]]}, {"verse": 23, "start": 201577, "end": 207808, "text": "El torna en nada los poderosos, y a los que gobiernan la tierra hace como cosa vana.", "words": [[0, 201577], [3, 201742], [9, 202422], [12, 202742], [17, 203122], [21, 203342], [32, 204082], [34, 204602], [36, 204682], [40, 204802], [44, 204942], [54, 205522], [57, 205702], [64, 206142], [69, 206622], [74, 207031], [79, 207439]]}, {"verse": 24, "start": 208258, "end": 221551, "text": "Como si nunca fueran plantados, como si nunca fueran sembrados, como si nunca su tronco hubiera tenido raíz en la tierra; así que sopla en ellos se secan, y el torbellino los lleva como hojarasca.", "words": [[0, 208258], [5, 208422], [8, 208602], [14, 208882], [21, 209382], [32, 210502], [37, 210562], [40, 210742], [46, 210962], [53, 211382], [64, 212342], [69, 212482], [72, 212662], [78, 212942], [81, 213202], [88, 213822], [96, 214162], [103, 214442], [108, 215002], [111, 215122], [114, 215242], [122, 216227], [126, 216463], [130, 216643], [136, 217143], [139, 217383], [145, 217603], [148, 217803], [155, 218283], [157, 218663], [160, 219093], [171, 219523], [175, 219703], [181, 220003], [186, 220800]]}, {"verse": 25, "start": 221851, "end": 227557, "text": "¿A qué pues me haréis semejante, o seré asimilado? dice el Santo.", "words": [[0, 221851], [3, 222017], [7, 222157], [12, 222497], [15, 222737], [22, 223157], [33, 224017], [35, 224637], [40, 225017], [51, 226501], [56, 226827], [59, 226967]]}, {"verse": 26, "start": 228007, "end": 243725, "text": "Levantad en alto vuestros ojos, y mirad quién creó estas cosas: él saca por cuenta su ejército: a todas llama por sus nombres; ninguna faltará: tal es la grandeza de su fuerza, y su poder y virtud.", "words": [[0, 228007], [9, 228612], [12, 228772], [17, 229052], [26, 229572], [32, 229892], [34, 230232], [40, 230612], [46, 230892], [51, 231372], [57, 231612], [64, 232707], [67, 232855], [72, 233335], [76, 233495], [83, 233875], [86, 234095], [96, 235221], [98, 235441], [104, 235701], [110, 236201], [114, 236501], [118, 236681], [127, 237736], [135, 238206], [144, 239234], [148, 239437], [151, 239917], [154, 240237], [163, 240917], [166, 241037], [169, 241177], [177, 241677], [179, 242157], [182, 242317], [188, 242737], [190, 242977]]}, {"verse": 27, "start": 244175, "end": 251692, "text": "¿Por qué dices, oh Jacob, y hablas tú, Israel: Mi camino es escondido de Jehová, y de mi Dios pasó mi juicio?", "words": [[0, 244175], [5, 244276], [9, 244456], [16, 245016], [19, 245116], [26, 245626], [28, 246136], [35, 246456], [39, 246896], [47, 247853], [50, 247972], [57, 248312], [60, 248552], [70, 249112], [73, 249232], [81, 249732], [83, 250152], [86, 250292], [89, 250412], [94, 250652], [99, 250972], [102, 251152]]}, {"verse": 28, "start": 252042, "end": 267517, "text": "¿No has sabido, no has oído que el Dios del siglo es Jehová, el cual creó los confines de la tierra? No se trabaja, ni se fatiga con cansancio, y su entendimiento no hay quien lo alcance.", "words": [[0, 252042], [4, 252309], [8, 252589], [16, 253729], [19, 254089], [23, 254329], [28, 254709], [32, 254929], [35, 255129], [40, 255369], [44, 255629], [50, 256129], [53, 256549], [61, 257629], [64, 257689], [69, 257949], [74, 258449], [78, 258589], [87, 259149], [90, 259309], [93, 259409], [101, 260327], [104, 260458], [107, 260598], [116, 261218], [119, 261358], [122, 261498], [129, 262078], [133, 262318], [144, 263398], [146, 264198], [149, 264438], [163, 265438], [166, 265778], [170, 265998], [176, 266318], [179, 266538]]}, {"verse": 29, "start": 267967, "end": 273432, "text": "Él da esfuerzo al cansado, y multiplica las fuerzas al que no tiene ningunas.", "words": [[0, 267967], [3, 268169], [6, 268409], [15, 268869], [18, 269329], [27, 269789], [29, 269889], [40, 270489], [44, 270649], [52, 271369], [55, 271729], [59, 271869], [62, 272029], [68, 272753]]}, {"verse": 30, "start": 273882, "end": 278654, "text": "Los jóvenes se fatigan y se cansan, los jóvenes flaquean y caen:", "words": [[0, 273882], [4, 274029], [12, 274429], [15, 274839], [23, 275249], [25, 275369], [28, 275879], [36, 276389], [40, 276789], [48, 277349], [57, 277909], [59, 278029]]}, {"verse": 31, "start": 279104, "end": 289862, "text": "Pero los que esperan a Jehová tendrán nuevas fuerzas; levantarán las alas como águilas; correrán, y no se cansarán; caminarán, y no se fatigarán.", "words": [[0, 279104], [5, 279229], [9, 279409], [13, 279589], [21, 280209], [23, 280309], [30, 280689], [38, 281269], [45, 281669], [54, 283050], [65, 283737], [69, 283957], [74, 284357], [79, 284577], [88, 285641], [98, 286125], [100, 286345], [103, 286485], [106, 286645], [116, 287769], [127, 288473], [129, 288653], [132, 288793], [135, 289356]]}]}