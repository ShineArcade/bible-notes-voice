{"book": "LUK", "chapter": 14, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 244263, "verses": [{"verse": 1, "start": 300, "end": 7757, "text": "And it came to pass, as he went into the house of one of the chief Pharisees to eat bread on the sabbath day, that they watched him.", "words": [[0, 300], [4, 436], [7, 536], [12, 776], [15, 956], [21, 1336], [24, 1776], [27, 1916], [32, 2136], [37, 2436], [41, 2596], [47, 2876], [50, 3076], [54, 3236], [57, 3356], [61, 3456], [67, 3696], [77, 4496], [80, 4636], [84, 4796], [90, 5116], [93, 5316], [97, 5476], [105, 5776], [110, 6256], [115, 6876], [120, 7036], [128, 7396]]}, {"verse": 2, "start": 8108, "end": 12546, "text": "And, behold, there was a certain man before him which had the dropsy.", "words": [[0, 8108], [5, 8266], [13, 9366], [19, 9506], [23, 9666], [25, 9806], [33, 10086], [37, 10486], [44, 10866], [48, 11246], [54, 11546], [58, 11746], [62, 11886]]}, {"verse": 3, "start": 12896, "end": 19395, "text": "And Jesus answering spoke to the lawyers and Pharisees, saying, Is it lawful to heal on the sabbath day?", "words": [[0, 12896], [4, 13016], [10, 13336], [20, 13976], [26, 14336], [29, 14576], [33, 14716], [41, 15096], [45, 15316], [56, 16176], [64, 16999], [67, 17177], [70, 17297], [77, 17717], [80, 17897], [85, 18177], [88, 18417], [92, 18537], [100, 18857]]}, {"verse": 4, "start": 19675, "end": 23822, "text": "And they kept silent. And he took him, and healed him, and let him go;", "words": [[0, 19675], [4, 19796], [9, 19916], [14, 20176], [22, 21199], [26, 21341], [29, 21481], [34, 21741], [39, 21981], [43, 22201], [50, 22481], [55, 22781], [59, 22981], [63, 23181], [67, 23301]]}, {"verse": 5, "start": 24172, "end": 32063, "text": "And answered them, saying, Which of you shall have a donkey or an ox fallen into a pit, and will not immediately pull him out on the sabbath day?", "words": [[0, 24172], [4, 24334], [13, 24674], [19, 25094], [27, 25784], [33, 25929], [36, 26129], [40, 26309], [46, 26509], [51, 26709], [53, 26789], [60, 27109], [63, 27369], [66, 27529], [69, 27789], [76, 28209], [81, 28489], [83, 28669], [88, 29289], [92, 29549], [97, 29689], [101, 29909], [113, 30249], [118, 30669], [122, 30849], [126, 31069], [129, 31229], [133, 31349], [141, 31609]]}, {"verse": 6, "start": 32343, "end": 35084, "text": "And they could not answer him again to these things.", "words": [[0, 32343], [4, 32474], [9, 32634], [15, 32814], [19, 33054], [26, 33454], [30, 33654], [36, 33974], [39, 34194], [45, 34434]]}, {"verse": 7, "start": 35434, "end": 42375, "text": "¶ And he put forth a parable to those which were bidden, when he marked how they chose out the chief rooms; saying to them,", "words": [[2, 35434], [6, 35559], [9, 35679], [13, 35899], [19, 36199], [21, 36379], [29, 36839], [32, 37059], [38, 37319], [44, 37599], [49, 37779], [57, 38199], [62, 38699], [65, 38839], [72, 39159], [76, 39399], [81, 39579], [87, 39879], [91, 40139], [95, 40279], [101, 40479], [108, 41436], [115, 41716], [118, 41956]]}, {"verse": 8, "start": 42575, "end": 49721, "text": "When you are bidden of any man to a wedding, sit not down in the highest room; lest a more honourable man than you be bidden of him;", "words": [[0, 42575], [5, 42697], [9, 42837], [13, 42937], [20, 43277], [23, 43437], [27, 43637], [31, 43957], [34, 44177], [36, 44277], [45, 44837], [49, 45057], [53, 45297], [58, 45657], [61, 45817], [65, 45937], [73, 46217], [79, 46971], [84, 47210], [86, 47330], [91, 47620], [102, 47910], [106, 48430], [111, 48670], [115, 48857], [118, 49043], [125, 49230], [128, 49410]]}, {"verse": 9, "start": 50071, "end": 56775, "text": "And he that bade you and him come and say to you, Give this man place; and you begin with shame to take the lowest room.", "words": [[0, 50071], [4, 50214], [7, 50454], [12, 50674], [17, 51094], [21, 51234], [25, 51394], [29, 51574], [34, 51894], [38, 52134], [42, 52374], [45, 52554], [50, 52874], [55, 52974], [60, 53234], [64, 53494], [71, 54364], [75, 54465], [79, 54565], [85, 54825], [90, 55065], [96, 55405], [99, 55625], [104, 55805], [108, 55945], [115, 56225]]}, {"verse": 10, "start": 57125, "end": 69433, "text": "But when you are bidden, go and sit down in the lowest room; that when he that bade you comes, he may say to you, Friend, go up higher: then shall you have worship in the presence of them that sit at the table with you.", "words": [[0, 57125], [4, 57229], [9, 57389], [13, 57509], [17, 57959], [25, 58409], [28, 58789], [32, 59029], [36, 59249], [41, 59589], [44, 59749], [48, 59829], [55, 60089], [61, 60924], [66, 61204], [71, 61324], [74, 61464], [79, 61624], [84, 61964], [88, 62064], [95, 62724], [98, 62864], [102, 63004], [106, 63224], [109, 63344], [114, 63864], [122, 64484], [125, 64564], [128, 64744], [136, 65448], [141, 65686], [147, 65946], [151, 66106], [156, 66286], [164, 66626], [167, 66846], [171, 66946], [180, 67226], [183, 67486], [188, 67686], [193, 67966], [197, 68206], [200, 68426], [204, 68526], [210, 68826], [215, 69066]]}, {"verse": 11, "start": 69783, "end": 74769, "text": "For whoever exalts himself shall be abased; and he that humbles himself shall be exalted.", "words": [[0, 69783], [4, 69881], [12, 70201], [19, 70681], [27, 71121], [33, 71381], [36, 71561], [44, 72422], [48, 72547], [51, 72707], [56, 72907], [64, 73247], [72, 73627], [78, 73887], [81, 74047]]}, {"verse": 12, "start": 75049, "end": 87407, "text": "¶ Then said he also to him that bade him, When you make a dinner or a supper, call not your friends, nor your brethren, neither your kinsmen, nor your rich neighbours; lest they also bid you again, and a recompence be made you.", "words": [[2, 75049], [7, 75282], [12, 75562], [15, 75722], [20, 76062], [23, 76302], [27, 76502], [32, 76702], [37, 77062], [42, 77636], [47, 77753], [51, 77853], [56, 78013], [58, 78113], [65, 78373], [68, 78653], [70, 78773], [78, 79413], [83, 79573], [87, 79753], [92, 79893], [101, 80613], [105, 80773], [110, 80953], [120, 81653], [128, 81813], [133, 82033], [142, 82913], [146, 83013], [151, 83173], [156, 83618], [168, 84226], [173, 84429], [178, 84589], [183, 84869], [187, 85189], [191, 85349], [198, 85969], [202, 86069], [204, 86399], [215, 86729], [218, 86889], [223, 87109]]}, {"verse": 13, "start": 87757, "end": 92113, "text": "But when you make a feast, call the poor, the maimed, the lame, the blind:", "words": [[0, 87757], [4, 87856], [9, 87996], [13, 88116], [18, 88296], [20, 88416], [27, 88976], [32, 89296], [36, 89436], [42, 90136], [46, 90296], [54, 90876], [58, 90956], [64, 91436], [68, 91496]]}, {"verse": 14, "start": 92463, "end": 98853, "text": "And you shall be blessed; for they cannot recompense you: for you shall be recompensed at the resurrection of the just.", "words": [[0, 92463], [4, 92591], [8, 92691], [14, 92891], [17, 93051], [26, 93870], [30, 93954], [35, 94074], [42, 94374], [53, 95074], [58, 95560], [62, 95703], [66, 95923], [72, 96163], [75, 96343], [87, 97183], [90, 97323], [94, 97443], [107, 97923], [110, 98323], [114, 98463]]}, {"verse": 15, "start": 99133, "end": 107116, "text": "¶ And when one of them that sat at the table with him heard these things, he said to him, Blessed is he that shall eat bread in the kingdom of God.", "words": [[2, 99133], [6, 99382], [11, 99642], [15, 99962], [18, 100122], [23, 100342], [28, 100562], [32, 100842], [35, 101002], [39, 101102], [45, 101462], [50, 101762], [54, 102002], [60, 102237], [66, 102517], [74, 103257], [77, 103417], [82, 103677], [85, 103897], [90, 104536], [98, 104682], [101, 104829], [104, 105029], [109, 105209], [115, 105409], [119, 105569], [125, 105849], [128, 106149], [132, 106249], [140, 106529], [143, 106729]]}, {"verse": 16, "start": 107396, "end": 111771, "text": "Then said he to him, A certain man made a great supper, and bade many:", "words": [[0, 107396], [5, 107599], [10, 107899], [13, 108099], [16, 108259], [21, 108803], [23, 108913], [31, 109193], [35, 109573], [40, 109853], [42, 109953], [48, 110193], [56, 110553], [60, 110993], [65, 111373]]}, {"verse": 17, "start": 112121, "end": 117284, "text": "And sent his servant at supper time to say to them that were bidden, Come; for all things are now ready.", "words": [[0, 112121], [4, 112259], [9, 112499], [13, 112679], [21, 112999], [24, 113219], [31, 113459], [36, 113759], [39, 113939], [43, 114139], [46, 114279], [51, 114439], [56, 114599], [61, 114779], [69, 115299], [75, 115862], [79, 115955], [83, 116175], [90, 116435], [94, 116675], [98, 116855]]}, {"verse": 18, "start": 117634, "end": 127017, "text": "And they all with one consent began to make excuse. The first said to him, I have bought a piece of ground, and I must needs go and see it: please have me excused.", "words": [[0, 117634], [4, 117757], [9, 117897], [13, 118217], [18, 118417], [22, 118637], [30, 119137], [36, 119517], [39, 119757], [44, 119937], [52, 120885], [56, 120969], [62, 121189], [67, 121449], [70, 121629], [75, 122109], [77, 122329], [82, 122429], [89, 122649], [91, 122749], [97, 122949], [100, 123069], [108, 123449], [112, 123709], [114, 123829], [119, 123989], [125, 124329], [128, 124609], [132, 124889], [136, 125109], [140, 125419], [147, 125759], [152, 126059], [155, 126259]]}, {"verse": 19, "start": 127367, "end": 133090, "text": "And another said, I have bought five yoke of oxen, and I go to prove them: please have me excused.", "words": [[0, 127367], [4, 127515], [12, 127755], [18, 128155], [20, 128255], [25, 128395], [32, 128615], [37, 128955], [42, 129275], [45, 129395], [51, 129835], [55, 130235], [57, 130375], [60, 130515], [63, 130615], [69, 130875], [75, 131543], [82, 131789], [87, 132109], [90, 132289]]}, {"verse": 20, "start": 133440, "end": 137048, "text": "And another said, I have married a wife, and therefore I cannot come.", "words": [[0, 133440], [4, 133579], [12, 133839], [18, 134239], [20, 134319], [25, 134459], [33, 134739], [35, 134859], [41, 135459], [45, 135539], [55, 135899], [57, 136099], [64, 136379]]}, {"verse": 21, "start": 137398, "end": 151508, "text": "So that servant came, and showed his lord these things. Then the master of the house being angry said to his servant, Go out quickly into the streets and lanes of the city, and bring in here the poor, and the maimed, and the lame, and the blind.", "words": [[0, 137398], [3, 137535], [8, 137735], [16, 138055], [22, 138455], [26, 138760], [33, 139000], [37, 139200], [42, 139500], [48, 139760], [56, 140578], [61, 140892], [65, 141272], [72, 141652], [75, 141872], [79, 141972], [85, 142192], [91, 142512], [97, 142992], [102, 143312], [105, 143532], [109, 143672], [118, 144312], [121, 144592], [125, 144792], [133, 145152], [138, 145432], [142, 145612], [150, 145892], [154, 146112], [160, 146332], [163, 146552], [167, 146652], [173, 147292], [177, 147432], [183, 147652], [186, 147852], [191, 148012], [195, 148172], [201, 148907], [205, 149057], [209, 149177], [217, 149717], [221, 149917], [225, 150037], [231, 150357], [235, 150817], [239, 150937]]}, {"verse": 22, "start": 151858, "end": 156684, "text": "And the servant said, Lord, it is done as you have commanded, and yet there is room.", "words": [[0, 151858], [4, 151986], [8, 152106], [16, 152406], [22, 153086], [28, 153646], [31, 153726], [34, 153886], [39, 154166], [42, 154386], [46, 154526], [51, 154686], [62, 155566], [66, 155646], [70, 155826], [76, 156026], [79, 156166]]}, {"verse": 23, "start": 157034, "end": 164443, "text": "And the lord said to the servant, Go out into the highways and hedges, and compel them to come in, that my house may be filled.", "words": [[0, 157034], [4, 157154], [8, 157274], [13, 157494], [18, 157794], [21, 157974], [25, 158134], [34, 158714], [37, 159034], [41, 159254], [46, 159534], [50, 159714], [59, 160054], [63, 160394], [71, 160814], [75, 161254], [82, 161714], [87, 161914], [90, 162094], [95, 162314], [99, 162514], [104, 162954], [107, 163214], [113, 163534], [117, 163794], [120, 163934]]}, {"verse": 24, "start": 164793, "end": 169682, "text": "For I say to you, That none of those men which were bidden shall taste of my supper.", "words": [[0, 164793], [4, 164942], [6, 165122], [10, 165342], [13, 165562], [18, 165802], [23, 166302], [28, 166562], [31, 166722], [37, 166922], [41, 167242], [47, 167522], [52, 167742], [59, 168102], [65, 168342], [71, 168782], [74, 168962], [77, 169162]]}, {"verse": 25, "start": 169962, "end": 173650, "text": "¶ And there went great multitudes with him: and he turned, and said to them,", "words": [[2, 169962], [6, 170092], [12, 170212], [17, 170392], [23, 170652], [34, 171232], [39, 171492], [44, 171978], [48, 172118], [51, 172218], [59, 172558], [63, 172818], [68, 173058], [71, 173258]]}, {"verse": 26, "start": 173850, "end": 184846, "text": "If any man come to me, and hate not his father, and mother, and wife, and children, and brethren, and sisters, yes, and his own life also, he cannot be my disciple.", "words": [[0, 173850], [3, 173977], [7, 174137], [11, 174377], [16, 174597], [19, 174817], [23, 175317], [27, 175417], [32, 175637], [36, 175797], [40, 175997], [48, 176797], [52, 176857], [60, 177517], [64, 177597], [70, 178277], [74, 178297], [84, 179117], [88, 179257], [98, 179977], [102, 180037], [111, 180857], [116, 181597], [120, 181697], [124, 181857], [128, 182017], [133, 182257], [139, 183197], [142, 183417], [149, 183697], [152, 183997], [155, 184177]]}, {"verse": 27, "start": 185196, "end": 189993, "text": "And whoever does not bear his cross, and come after me, cannot be my disciple.", "words": [[0, 185196], [4, 185332], [12, 185592], [17, 185952], [21, 186172], [26, 186452], [30, 186632], [37, 187052], [41, 187612], [46, 187812], [52, 188112], [56, 188372], [63, 188832], [66, 189152], [69, 189332]]}, {"verse": 28, "start": 190343, "end": 197487, "text": "For which of you, intending to build a tower, sits not down first, and counts the cost, whether he have sufficient to finish it?", "words": [[0, 190343], [4, 190451], [10, 190651], [13, 190811], [18, 191331], [28, 191731], [31, 191931], [37, 192111], [39, 192231], [46, 193011], [51, 193211], [55, 193491], [60, 193771], [67, 194571], [71, 194731], [78, 194991], [82, 195191], [88, 195891], [96, 196071], [99, 196271], [104, 196431], [115, 196811], [118, 197011], [125, 197231]]}, {"verse": 29, "start": 197837, "end": 204539, "text": "Lest perhaps, after he has laid the foundation, and is not able to finish it, all that behold it begin to mock him,", "words": [[0, 197837], [5, 198158], [14, 198538], [20, 198978], [23, 199198], [27, 199398], [32, 199638], [36, 199818], [48, 200358], [52, 200673], [55, 200813], [59, 201053], [64, 201313], [67, 201473], [74, 201753], [78, 202313], [82, 202573], [87, 202813], [94, 203193], [97, 203473], [103, 203733], [106, 203953], [111, 204193]]}, {"verse": 30, "start": 204889, "end": 208558, "text": "Saying, This man began to build, and was not able to finish.", "words": [[0, 204889], [8, 205229], [13, 205509], [17, 205809], [23, 206169], [26, 206409], [33, 206709], [37, 207249], [41, 207389], [45, 207609], [50, 207829], [53, 207989]]}, {"verse": 31, "start": 208908, "end": 218723, "text": "Or what king, going to make war against another king, sits not down first, and consults whether he be able with ten thousand to meet him that comes against him with twenty thousand?", "words": [[0, 208908], [3, 209068], [8, 209288], [14, 209588], [20, 209908], [23, 210088], [28, 210288], [32, 210588], [40, 210908], [48, 211188], [54, 211588], [59, 211968], [63, 212288], [68, 212548], [75, 213378], [79, 213723], [88, 214403], [96, 214583], [99, 214783], [102, 214923], [107, 215183], [112, 215430], [116, 215676], [125, 215923], [128, 216123], [133, 216363], [137, 216643], [142, 216848], [148, 217088], [156, 217448], [160, 217628], [165, 218011], [172, 218395]]}, {"verse": 32, "start": 219073, "end": 225030, "text": "Or else, while the other is yet a great way off, he sends an delegation, and desires conditions of peace.", "words": [[0, 219073], [3, 219229], [9, 219449], [15, 219709], [19, 219869], [25, 220049], [28, 220249], [32, 220409], [34, 220489], [40, 220709], [44, 220889], [49, 221669], [52, 221856], [58, 222042], [61, 222229], [73, 222789], [77, 223289], [85, 223689], [96, 224249], [99, 224489]]}, {"verse": 33, "start": 225380, "end": 230445, "text": "So likewise, whoever he be of you that forsakes not all that he has, he cannot be my disciple.", "words": [[0, 225380], [3, 225559], [13, 226219], [21, 226399], [24, 226639], [27, 226799], [30, 226979], [34, 227139], [39, 227319], [48, 227739], [52, 227919], [56, 228139], [61, 228239], [64, 228319], [69, 229099], [72, 229199], [79, 229439], [82, 229659], [85, 229799]]}, {"verse": 34, "start": 230795, "end": 235895, "text": "¶ Salt is good: but if the salt have lost his savour, with what shall it be seasoned?", "words": [[2, 230795], [7, 231034], [10, 231274], [16, 231934], [20, 232075], [23, 232195], [27, 232335], [32, 232655], [37, 232875], [42, 233195], [46, 233645], [54, 234095], [59, 234435], [64, 234635], [70, 234915], [73, 235075], [76, 235215]]}, {"verse": 35, "start": 236245, "end": 243863, "text": "It is neither fit for the land, nor yet for the dunghill; but men cast it out. He that has ears to hear, let him hear.", "words": [[0, 236245], [3, 236363], [6, 236503], [14, 236783], [18, 237143], [22, 237343], [26, 237463], [32, 237883], [36, 238323], [40, 238583], [44, 238803], [48, 239183], [58, 239758], [62, 239881], [66, 240161], [71, 240521], [74, 240741], [79, 241353], [82, 241483], [87, 241723], [91, 241923], [96, 242223], [99, 242463], [105, 243083], [109, 243243], [113, 243443]]}]}