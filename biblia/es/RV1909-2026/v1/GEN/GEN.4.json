{"book": "GEN", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 233973, "verses": [{"verse": 1, "start": 300, "end": 8183, "text": "Y conoció Adam a su mujer Eva, la cual concibió y parió a Caín, y dijo: He adquirido varón por Jehová.", "words": [[0, 300], [2, 401], [10, 1221], [15, 1681], [17, 1721], [20, 1881], [26, 2221], [31, 3121], [34, 3241], [39, 3441], [48, 4241], [50, 4361], [56, 4721], [58, 4841], [64, 5481], [66, 5561], [72, 6341], [75, 6481], [85, 7061], [91, 7461], [95, 7850]]}, {"verse": 2, "start": 8533, "end": 16074, "text": "Y después parió a su hermano Abel. Y fue Abel pastor de ovejas, y Caín fue labrador de la tierra.", "words": [[0, 8533], [2, 8676], [10, 8956], [16, 9396], [18, 9496], [21, 9576], [29, 10016], [35, 10789], [37, 10894], [41, 11074], [46, 11414], [53, 11774], [56, 12034], [64, 12994], [66, 13354], [71, 13894], [75, 14454], [84, 15194], [87, 15334], [90, 15454]]}, {"verse": 3, "start": 16524, "end": 23017, "text": "Y aconteció andando el tiempo, que Caín trajo del fruto de la tierra una ofrenda a Jehová.", "words": [[0, 16524], [2, 16650], [12, 17450], [20, 18130], [23, 18270], [31, 18780], [35, 19290], [40, 19650], [46, 20150], [50, 20370], [56, 20810], [59, 20930], [62, 21070], [69, 21410], [73, 21710], [81, 22310], [83, 22490]]}, {"verse": 4, "start": 23467, "end": 31765, "text": "Y Abel trajo también de los primogénitos de sus ovejas, y de su grasa. Y miró Jehová con agrado a Abel y a su ofrenda;", "words": [[0, 23467], [2, 23746], [7, 24026], [13, 24446], [21, 24806], [24, 25066], [28, 25206], [41, 26066], [44, 26206], [48, 26346], [56, 26886], [58, 27086], [61, 27206], [64, 27386], [71, 28336], [73, 28642], [78, 28986], [85, 29330], [89, 29674], [96, 30018], [98, 30198], [103, 30558], [105, 30758], [107, 30878], [110, 31038]]}, {"verse": 5, "start": 32215, "end": 40698, "text": "Pero no miró con agrado a Caín y a la ofrenda suya. Y se ensañó Caín en gran manera, y decayó su semblante.", "words": [[0, 32215], [5, 32360], [8, 32580], [13, 32900], [17, 33060], [24, 33540], [26, 33720], [31, 34180], [33, 34420], [35, 34500], [38, 34600], [46, 35120], [52, 35995], [54, 36113], [57, 36443], [64, 36773], [69, 37273], [72, 37533], [77, 37813], [85, 38373], [87, 39153], [94, 39693], [97, 39833]]}, {"verse": 6, "start": 41148, "end": 48159, "text": "Entonces Jehová dijo a Caín: ¿Por qué te has enfurecido, y por qué ha decaído tu semblante?", "words": [[0, 41148], [9, 41726], [16, 42726], [21, 42966], [23, 43166], [29, 44054], [34, 44183], [38, 44363], [41, 44523], [45, 44703], [57, 45403], [59, 46043], [63, 46243], [67, 46443], [70, 46563], [78, 46983], [81, 47143]]}, {"verse": 7, "start": 48609, "end": 59308, "text": "Si haces bien, ¿no serás enaltecido? y si no haces bien, el pecado está a la puerta: con todo esto, a ti será su deseo, y tú lo dominarás.", "words": [[0, 48609], [3, 48771], [9, 49091], [15, 49771], [19, 49911], [25, 50311], [37, 51768], [39, 51885], [42, 52025], [45, 52205], [51, 52445], [57, 53085], [60, 53185], [67, 53605], [72, 53885], [74, 54045], [77, 54085], [85, 55263], [89, 55384], [94, 55604], [100, 56064], [102, 56304], [105, 56444], [110, 56764], [113, 56984], [120, 57584], [122, 58024], [125, 58164], [128, 58304]]}, {"verse": 8, "start": 59658, "end": 68383, "text": "Y habló Caín a su hermano Abel: y aconteció que estando ellos en el campo, Caín se levantó contra su hermano Abel, y le mató.", "words": [[0, 59658], [2, 59802], [8, 60042], [13, 60562], [15, 60782], [18, 60922], [26, 61322], [32, 62175], [34, 62276], [44, 62896], [48, 63136], [56, 63496], [62, 63736], [65, 64036], [68, 64136], [75, 65116], [80, 65476], [83, 65656], [91, 66236], [98, 66516], [101, 66736], [109, 67156], [115, 67456], [117, 67696], [120, 67816]]}, {"verse": 9, "start": 68833, "end": 78743, "text": "Y Jehová dijo a Caín: ¿Dónde está Abel tu hermano? Y él respondió: No sé; ¿soy yo guarda de mi hermano?", "words": [[0, 68833], [2, 69122], [9, 69442], [14, 69742], [16, 69882], [22, 70753], [29, 71019], [34, 71325], [39, 71632], [42, 71732], [51, 74005], [53, 74187], [56, 74327], [67, 75372], [70, 75517], [74, 76141], [79, 76378], [82, 76518], [89, 76838], [92, 76958], [95, 77058]]}, {"verse": 10, "start": 79093, "end": 85343, "text": "Y él le dijo: ¿Qué has hecho? La voz de la sangre de tu hermano clama a mí desde la tierra.", "words": [[0, 79093], [2, 79260], [5, 79400], [8, 79560], [14, 80335], [19, 80462], [23, 80682], [30, 81687], [33, 81828], [37, 82028], [40, 82208], [43, 82308], [50, 82668], [53, 82828], [56, 82968], [64, 83468], [70, 83848], [72, 83968], [75, 84128], [81, 84328], [84, 84528]]}, {"verse": 11, "start": 85793, "end": 92801, "text": "Ahora pues, maldito seas tú de la tierra que abrió su boca para recibir la sangre de tu hermano de tu mano:", "words": [[0, 85793], [6, 86097], [12, 86797], [20, 87497], [25, 87777], [28, 88097], [31, 88257], [34, 88357], [41, 88737], [45, 88957], [51, 89257], [54, 89417], [59, 89757], [64, 90057], [72, 90457], [75, 90737], [82, 91097], [85, 91277], [88, 91397], [96, 91917], [99, 91957], [102, 92077]]}, {"verse": 12, "start": 93251, "end": 100540, "text": "Cuando labres la tierra, no te volverá a dar su fuerza: errante y extranjero serás en la tierra.", "words": [[0, 93251], [7, 93428], [14, 93908], [17, 94028], [25, 94828], [28, 94928], [31, 95068], [39, 95548], [41, 95588], [45, 95708], [48, 95868], [56, 97035], [64, 97567], [66, 97867], [77, 98967], [83, 99467], [86, 99647], [89, 99767]]}, {"verse": 13, "start": 100890, "end": 105535, "text": "Y dijo Caín a Jehová: Grande es mi iniquidad para ser perdonada.", "words": [[0, 100890], [2, 101017], [7, 101277], [12, 101797], [14, 102017], [22, 102815], [29, 103195], [32, 103435], [35, 103615], [45, 104195], [50, 104475], [54, 104695]]}, {"verse": 14, "start": 105985, "end": 116311, "text": "He aquí me echas hoy de la faz de la tierra, y de tu presencia me esconderé; y seré errante y extranjero en la tierra; y sucederá que cualquiera que me halle, me matará.", "words": [[0, 106025], [3, 106105], [8, 106325], [11, 106525], [17, 106865], [21, 107105], [24, 107245], [27, 107385], [31, 107625], [34, 107805], [37, 107905], [45, 108245], [47, 108785], [50, 108905], [53, 109025], [63, 109605], [66, 109785], [77, 110775], [79, 110878], [84, 111198], [92, 111618], [94, 111778], [105, 112438], [108, 112538], [111, 112638], [119, 113465], [121, 113590], [130, 114230], [134, 114350], [145, 114910], [149, 115050], [152, 115230], [159, 115590], [162, 115790]]}, {"verse": 15, "start": 116661, "end": 130828, "text": "Y le respondió Jehová: Cierto que cualquiera que mate a Caín, siete veces será castigado. Entonces Jehová puso señal en Caín, para que no lo hiriese cualquiera que le hallara.", "words": [[0, 116661], [2, 116806], [5, 116926], [15, 117606], [23, 119730], [30, 120134], [34, 120314], [45, 120854], [49, 121014], [54, 121334], [56, 121824], [62, 122314], [68, 122634], [74, 123114], [79, 123494], [90, 124926], [99, 125389], [106, 126089], [111, 126349], [117, 126889], [120, 127029], [126, 127589], [131, 128249], [135, 128409], [138, 128629], [141, 128959], [149, 129289], [160, 129909], [164, 130049], [167, 130189]]}, {"verse": 16, "start": 131278, "end": 137463, "text": "Y salió Caín de delante de Jehová, y habitó en tierra de Nod, al oriente de Edén.", "words": [[0, 131278], [2, 131379], [8, 131739], [13, 132179], [16, 132319], [24, 132759], [27, 132899], [35, 133419], [37, 133559], [44, 133979], [47, 134159], [54, 134419], [57, 134719], [62, 135419], [65, 135659], [73, 136159], [76, 136599]]}, {"verse": 17, "start": 137913, "end": 149513, "text": "Y conoció Caín a su mujer, la cual concibió y parió a Enoc: y edificó una ciudad, y llamó el nombre de la ciudad del nombre de su hijo, Enoc.", "words": [[0, 137913], [2, 138056], [10, 138676], [15, 139176], [17, 139356], [20, 139496], [27, 140416], [30, 140616], [35, 140796], [44, 141656], [46, 141876], [52, 142064], [54, 142253], [60, 143221], [62, 143841], [70, 144481], [74, 144641], [82, 145061], [84, 145801], [90, 146141], [93, 146401], [100, 146741], [103, 146941], [106, 147061], [113, 147341], [117, 147641], [124, 147961], [127, 148141], [130, 148301], [136, 148913]]}, {"verse": 18, "start": 149963, "end": 160546, "text": "Y a Enoc nació Irad, e Irad engendró a Mehujael, y Mehujael engendró a Metusael, y Metusael engendró a Lamec.", "words": [[0, 149963], [2, 150122], [4, 150322], [9, 150522], [15, 151062], [21, 152202], [23, 152322], [28, 152882], [37, 153442], [39, 154222], [49, 155002], [51, 155549], [60, 156095], [69, 156642], [71, 157322], [81, 158002], [83, 158469], [92, 158935], [101, 159402], [103, 159582]]}, {"verse": 19, "start": 160996, "end": 168333, "text": "Y tomó para sí Lamec dos mujeres; el nombre de la una fue Ada, y el nombre de la otra Zila.", "words": [[0, 160996], [2, 161104], [7, 161384], [12, 161524], [15, 161844], [21, 162164], [25, 162424], [34, 163700], [37, 163867], [44, 164287], [47, 164507], [50, 164667], [54, 164887], [58, 165207], [63, 165747], [65, 166567], [68, 166707], [75, 167067], [78, 167247], [81, 167367], [86, 167868]]}, {"verse": 20, "start": 168783, "end": 174944, "text": "Y Ada parió a Jabal, el cual fue padre de los que habitan en tiendas, y crían ganados.", "words": [[0, 168783], [2, 168928], [6, 169068], [12, 169528], [14, 169648], [21, 170548], [24, 170628], [29, 170868], [33, 171168], [39, 171648], [42, 171888], [46, 172008], [50, 172168], [58, 172588], [61, 172728], [70, 173408], [72, 173688], [78, 174088]]}, {"verse": 21, "start": 175394, "end": 182871, "text": "Y el nombre de su hermano fue Jubal, el cual fue padre de todos los que manejan arpa y órgano.", "words": [[0, 175394], [2, 175555], [5, 175715], [12, 176135], [15, 176335], [18, 176515], [26, 177015], [30, 177155], [37, 178235], [40, 178355], [45, 178555], [49, 178835], [55, 179315], [58, 179735], [64, 180115], [68, 180675], [72, 180835], [80, 181395], [85, 181995], [87, 182215]]}, {"verse": 22, "start": 183321, "end": 192116, "text": "Y Zila también parió a Tubal-caín, artífice de toda obra de bronce y de hierro: y la hermana de Tubal-caín fue Naama.", "words": [[0, 183460], [2, 183634], [7, 183807], [15, 184267], [21, 184727], [23, 184847], [35, 186087], [44, 186887], [47, 187087], [52, 187307], [57, 187607], [60, 187807], [67, 188267], [69, 188367], [72, 188427], [80, 189489], [82, 189659], [85, 189779], [93, 190179], [96, 190599], [107, 191019], [111, 191593]]}, {"verse": 23, "start": 192566, "end": 202582, "text": "Y dijo Lamec a sus mujeres: Ada y Zila, oíd mi voz; mujeres de Lamec, escuchad mi dicho: que varón mataré por mi herida, y joven por mi golpe:", "words": [[0, 192566], [2, 192695], [7, 193265], [13, 193835], [15, 193995], [19, 194135], [28, 195328], [32, 195468], [34, 195718], [40, 195968], [44, 196228], [47, 196348], [52, 197132], [60, 197511], [63, 197931], [70, 198351], [79, 198831], [82, 198951], [89, 199696], [93, 199793], [99, 200073], [106, 200433], [110, 200613], [113, 200773], [121, 201133], [123, 201433], [129, 201773], [133, 201953], [136, 202053]]}, {"verse": 24, "start": 203032, "end": 208089, "text": "Si siete veces será vengado Caín, Lamec en verdad setenta veces siete lo será.", "words": [[0, 203133], [3, 203239], [9, 203346], [15, 203746], [20, 204086], [28, 204586], [34, 205176], [40, 205766], [43, 205846], [50, 206286], [58, 206726], [64, 207076], [70, 207426], [73, 207666]]}, {"verse": 25, "start": 208439, "end": 223449, "text": "Y conoció de nuevo Adam a su mujer, la cual parió un hijo, y llamó su nombre Set: Porque Dios ( dijo ella ) me ha sustituido otra simiente en lugar de Abel, a quien mató Caín.", "words": [[0, 208439], [2, 208561], [10, 209181], [13, 209321], [19, 209421], [24, 209521], [26, 210081], [29, 210261], [36, 211201], [39, 211441], [44, 211641], [50, 212061], [53, 212301], [59, 212621], [61, 213201], [67, 213561], [70, 213741], [77, 214246], [82, 215133], [89, 215313], [94, 216486], [96, 216698], [101, 216911], [106, 217123], [108, 217582], [111, 217742], [114, 217882], [125, 218842], [130, 219142], [139, 219882], [142, 220142], [148, 220382], [151, 220662], [157, 221482], [159, 221582], [165, 221722], [170, 222122]]}, {"verse": 26, "start": 223799, "end": 233573, "text": "Y a Set también le nació un hijo, y llamó su nombre Enós. Entonces los hombres comenzaron a invocar el nombre de Jehová.", "words": [[0, 223799], [2, 223968], [4, 224174], [8, 224381], [16, 224981], [19, 225201], [25, 225601], [28, 225841], [34, 226121], [36, 226821], [42, 227161], [45, 227321], [52, 227721], [58, 228853], [67, 229962], [71, 230142], [79, 230522], [90, 231302], [92, 231582], [100, 232182], [103, 232362], [110, 232762], [113, 232962]]}]}