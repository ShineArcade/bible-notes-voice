9090], [60, 69390], [66, 69670], [69, 69970], [74, 70190], [83, 71010], [85, 71430], [87, 71530], [90, 71690], [95, 72030]]}, {"verse": 11, "start": 73459, "end": 78907, "text": "El diablo entonces le dejó: y he aquí los ángeles llegaron y le servían.", "words": [[0, 73459], [3, 73723], [10, 74123], [19, 74503], [22, 74803], [28, 75582], [30, 75834], [33, 76104], [38, 76384], [42, 76784], [50, 77364], [59, 77904], [61, 78054], [64, 78204]]}, {"verse": 12, "start": 79357, "end": 84933, "text": "Pero oyendo Jesús que Juan había sido encarcelado, se volvió a Galilea;", "words": [[0, 79357], [5, 79519], [12, 80039], [18, 80399], [22, 80719], [27, 81179], [33, 81539], [38, 81979], [51, 83319], [54, 83559], [61, 84039], [63, 84159]]}, {"verse": 13, "start": 85383, "end": 94053, "text": "Y dejando a Nazaret, vino y habitó en Capernaum, ciudad junto al mar, en los confines de Zabulón y de Neftalí:", "words": [[0, 85383], [2, 85480], [10, 85920], [12, 86040], [21, 86580], [26, 87520], [28, 87820], [35, 88220], [38, 88800], [49, 89380], [56, 89960], [62, 90280], [65, 90560], [70, 91400], [73, 91500], [77, 91620], [86, 92140], [89, 92530], [97, 92920], [99, 93140], [102, 93220]]}, {"verse": 14, "start": 94503, "end": 99543, "text": "Para que se cumpliese lo que fue dicho por el profeta Isaías, que dijo:", "words": [[0, 94503], [5, 94668], [9, 94828], [12, 95258], [22, 95688], [25, 95928], [29, 96068], [33, 96268], [39, 96568], [43, 96868], [46, 97008], [54, 97688], [62, 98828], [66, 98988]]}, {"verse": 15, "start": 99993, "end": 109174, "text": "La tierra de Zabulón, y la tierra de Neftalí, camino del mar, del otro lado del Jordán, Galilea de los Gentiles;", "words": [[0, 99993], [3, 100167], [10, 100527], [13, 100987], [22, 101447], [24, 102107], [27, 102227], [34, 102567], [37, 102807], [46, 103667], [53, 103907], [57, 104227], [62, 105027], [66, 105147], [71, 105467], [76, 105787], [80, 106087], [88, 107227], [96, 107807], [99, 107927], [103, 108067]]}, {"verse": 16, "start": 109624, "end": 120165, "text": "El pueblo asentado en tinieblas, vio gran luz; y a los sentados en región y sombra de muerte, una luz les resplandeció.", "words": [[0, 109624], [3, 110044], [10, 110384], [19, 111204], [22, 111344], [33, 112084], [37, 112544], [42, 112764], [47, 113650], [49, 113818], [51, 113918], [55, 114058], [64, 114878], [67, 115118], [74, 115558], [76, 115858], [83, 116378], [86, 116518], [94, 117418], [98, 117778], [102, 118278], [106, 118758]]}, {"verse": 17, "start": 120615, "end": 129357, "text": "Desde entonces comenzó Jesús a predicar, y a decir: Arrepentíos, que el reino de los cielos se ha acercado.", "words": [[0, 120615], [6, 120940], [15, 121580], [23, 122380], [29, 122640], [31, 122920], [41, 123560], [43, 124040], [45, 124160], [52, 124974], [65, 126014], [69, 126414], [72, 126574], [78, 126934], [81, 127054], [85, 127234], [92, 128014], [95, 128334], [98, 128494]]}, {"verse": 18, "start": 129807, "end": 142665, "text": "Y andando Jesús junto al mar de Galilea, vio a dos hermanos, Simón, que es llamado Pedro, y Andrés su hermano, que echaban la red en el mar; porque eran pescadores.", "words": [[0, 129807], [2, 129931], [10, 130351], [16, 130771], [22, 131151], [25, 131451], [29, 131651], [32, 131811], [41, 132711], [45, 133091], [47, 133291], [51, 133471], [61, 134331], [68, 135271], [72, 135361], [75, 135451], [83, 135791], [90, 136271], [92, 136831], [99, 137571], [102, 137771], [111, 138691], [115, 138791], [123, 139271], [126, 139491], [130, 139771], [133, 140191], [136, 140371], [141, 141168], [148, 141393], [153, 141613]]}, {"verse": 19, "start": 143115, "end": 148249, "text": "Y les dice: Venid en pos de mí, y os haré pescadores de hombres.", "words": [[0, 143115], [2, 143295], [6, 143415], [12, 144329], [18, 144755], [21, 144955], [25, 145155], [28, 145355], [32, 145595], [34, 145975], [37, 146355], [42, 146735], [53, 147255], [56, 147515]]}, {"verse": 20, "start": 148699, "end": 153319, "text": "Ellos entonces, dejando