{"book": "MAT", "chapter": 27, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 537596, "verses": [{"verse": 1, "start": 300, "end": 11008, "text": "Y venida la mañana, entraron en consejo todos los príncipes de los sacerdotes, y los ancianos del pueblo, contra Jesús, para entregarle a muerte.", "words": [[0, 300], [2, 423], [9, 783], [12, 903], [20, 1903], [29, 2663], [32, 2823], [40, 3423], [46, 3743], [50, 4243], [60, 4883], [63, 5023], [67, 5143], [79, 5923], [81, 6343], [85, 6483], [94, 7023], [98, 7183], [106, 7663], [113, 8263], [120, 8743], [125, 9583], [136, 10363], [138, 10423]]}, {"verse": 2, "start": 11458, "end": 16652, "text": "Y le llevaron atado, y le entregaron a Poncio Pilato gobernador.", "words": [[0, 11458], [2, 11582], [5, 11742], [14, 12302], [21, 13022], [23, 13502], [26, 13642], [37, 14362], [39, 14482], [46, 14942], [53, 15742]]}, {"verse": 3, "start": 17102, "end": 29693, "text": "Entonces Judas, el que le había entregado, viendo que era condenado, volvió arrepentido las treinta piezas de plata a los príncipes de los sacerdotes y a los ancianos,", "words": [[0, 17102], [9, 18149], [16, 19149], [19, 19329], [23, 19489], [26, 19649], [32, 19929], [43, 21149], [50, 21409], [54, 21669], [58, 21869], [69, 22989], [76, 23509], [88, 24489], [92, 24689], [100, 25289], [107, 25749], [110, 25869], [116, 26189], [118, 26449], [122, 26569], [132, 27229], [135, 27349], [139, 27469], [150, 28249], [152, 28629], [154, 28689], [158, 28829]]}, {"verse": 4, "start": 30143, "end": 37963, "text": "Diciendo: Yo he pecado entregando la sangre inocente. Pero ellos dijeron: ¿Qué nos importa a nosotros? Allá tú.", "words": [[0, 30143], [10, 31221], [13, 31380], [16, 31520], [23, 31960], [34, 32520], [37, 32660], [44, 32980], [54, 34201], [59, 34346], [65, 34606], [74, 35641], [79, 35723], [83, 35863], [91, 36303], [93, 36443], [103, 37382], [108, 37661]]}, {"verse": 5, "start": 38313, "end": 43911, "text": "Y arrojando las piezas de plata en el templo, se partió; y fue, y se ahorcó.", "words": [[0, 38313], [2, 38454], [12, 39094], [16, 39394], [23, 39694], [26, 39814], [32, 40174], [35, 40334], [38, 40494], [46, 41214], [49, 41434], [57, 42333], [59, 42472], [64, 42632], [66, 43112], [69, 43212]]}, {"verse": 6, "start": 44361, "end": 53509, "text": "Y los príncipes de los sacerdotes, tomando las piezas de plata, dijeron: No es lícito echarlas en el tesoro de los dones, porque es precio de sangre.", "words": [[0, 44361], [2, 44450], [6, 44570], [16, 45310], [19, 45430], [23, 45570], [35, 46430], [43, 47070], [47, 47250], [54, 47610], [57, 47730], [64, 48110], [73, 49009], [76, 49167], [79, 49347], [86, 49727], [95, 50387], [98, 50587], [101, 50817], [108, 51047], [111, 51187], [115, 51307], [122, 52007], [129, 52367], [132, 52547], [139, 52827], [142, 53007]]}, {"verse": 7, "start": 53859, "end": 60846, "text": "Pero habido consejo, compraron con ellas el campo del alfarero, por sepultura para los extranjeros.", "words": [[0, 53859], [5, 54147], [12, 54327], [21, 54927], [31, 55607], [35, 55807], [41, 56067], [44, 56307], [50, 56787], [54, 57047], [64, 57847], [68, 58527], [78, 59307], [83, 59587], [87, 59787]]}, {"verse": 8, "start": 61296, "end": 66053, "text": "Por lo cual fue llamado aquel campo, Campo de sangre, hasta el día de hoy.", "words": [[0, 61296], [4, 61420], [7, 61560], [12, 61760], [16, 61940], [24, 62280], [30, 62660], [37, 63480], [43, 63920], [46, 64120], [54, 64860], [60, 65140], [63, 65300], [67, 65480], [70, 65660]]}, {"verse": 9, "start": 66503, "end": 77624, "text": "Entonces se cumplió lo que fue dicho por el profeta Jeremías, que dijo: Y tomaron las treinta piezas de plata, precio del apreciado, que fue apreciado por los hijos de Israel;", "words": [[0, 66503], [9, 66999], [12, 67339], [20, 67899], [23, 68039], [27, 68179], [31, 68359], [37, 68659], [41, 68899], [44, 69039], [52, 69519], [62, 70499], [66, 70559], [72, 71374], [74, 71480], [82, 71880], [86, 72190], [94, 72500], [101, 72980], [104, 73100], [111, 73560], [118, 73880], [122, 74160], [133, 74800], [137, 75260], [141, 75440], [151, 76040], [155, 76240], [159, 76400], [165, 76700], [168, 76880]]}, {"verse": 10, "start": 78074, "end": 82048, "text": "Y las dieron para el campo del alfarero, como me ordenó el Señor.", "words": [[0, 78074], [2, 78199], [6, 78339], [13, 78719], [18, 78999], [21, 79179], [27, 79499], [31, 79759], [41, 80479], [46, 80699], [49, 80919], [56, 81339], [59, 81419]]}, {"verse": 11, "start": 82498, "end": 93066, "text": "Y Jesús estuvo delante del gobernador; y el gobernador le preguntó, diciendo: ¿Eres tú el Rey de los judíos? Y Jesús le dijo: Tú lo dices.", "words": [[0, 82498], [2, 82620], [8, 83040], [15, 83640], [23, 84206], [27, 84771], [39, 85572], [41, 85736], [44, 85836], [55, 86516], [58, 86676], [68, 87296], [78, 88234], [84, 88421], [87, 88721], [90, 88901], [94, 89121], [97, 89181], [101, 89321], [109, 90380], [111, 90504], [117, 90884], [120, 91284], [126, 92129], [129, 92252], [132, 92372]]}, {"verse": 12, "start": 93516, "end": 100013, "text": "Y siendo acusado por los príncipes de los sacerdotes, y por los ancianos, nada respondió.", "words": [[0, 93516], [2, 93641], [9, 93941], [17, 94601], [21, 94821], [25, 95001], [35, 95601], [38, 95681], [42, 95821], [54, 96581], [56, 96741], [60, 96921], [64, 97101], [74, 98021], [79, 98341]]}, {"verse": 13, "start": 100463, "end": 105308, "text": "Pilato entonces le dice: ¿No oyes cuántas cosas testifican contra ti?", "words": [[0, 100463], [7, 100951], [16, 101431], [19, 101871], [25, 102756], [29, 102932], [34, 103232], [42, 103972], [48, 103972], [59, 104652], [66, 104932]]}, {"verse": 14, "start": 105658, "end": 111862, "text": "Y no le respondió ni una palabra; de tal manera que el gobernador se maravillaba mucho.", "words": [[0, 105658], [2, 105783], [5, 105943], [8, 106123], [18, 106823], [21, 107123], [25, 107363], [34, 108464], [37, 108602], [41, 108883], [48, 109242], [52, 109523], [55, 109703], [66, 110322], [69, 110523], [81, 111203]]}, {"verse": 15, "start": 112312, "end": 119524, "text": "Y en el día de la fiesta acostumbraba el gobernador soltar al pueblo un preso, el que quisiesen.", "words": [[0, 112312], [2, 112592], [5, 112732], [8, 112872], [12, 113172], [15, 113312], [18, 113432], [25, 113992], [38, 114932], [41, 115052], [52, 115672], [59, 116332], [62, 116532], [69, 116872], [72, 117272], [79, 118312], [82, 118432], [86, 118572]]}, {"verse": 16, "start": 119974, "end": 124350, "text": "Y tenían entonces un preso famoso que se llamaba Barrabás.", "words": [[0, 119974], [2, 120220], [9, 120500], [18, 121100], [21, 121420], [27, 121920], [34, 122280], [38, 122580], [41, 122720], [49, 123200]]}, {"verse": 17, "start": 124800, "end": 132010, "text": "Y juntos ellos, les dijo Pilato: ¿Cuál queréis que os suelte? ¿a Barrabás, o a Jesús que se dice el Cristo?", "words": [[0, 124800], [2, 124926], [9, 125386], [16, 126206], [20, 126326], [25, 126666], [33, 127621], [39, 127784], [47, 128184], [51, 128344], [54, 128464], [62, 129345], [65, 129472], [75, 130052], [77, 130252], [79, 130312], [85, 130632], [89, 130892], [92, 131012], [97, 131252], [100, 131412]]}, {"verse": 18, "start": 132360, "end": 135936, "text": "Porque sabía que por envidia le habían entregado.", "words": [[0, 132360], [7, 132603], [13, 133123], [17, 133323], [21, 133623], [29, 134383], [32, 134563], [39, 134963]]}, {"verse": 19, "start": 136386, "end": 149989, "text": "Y estando él sentado en el tribunal, su mujer envió a él, diciendo: No tengas que ver con aquel justo; porque hoy he padecido muchas cosas en sueños por causa de él.", "words": [[0, 136386], [2, 136735], [10, 137175], [13, 137335], [21, 137935], [24, 138075], [27, 138175], [37, 139135], [40, 139275], [46, 139695], [52, 140295], [54, 140435], [58, 140655], [68, 142249], [71, 142439], [78, 142879], [82, 142999], [86, 143179], [90, 143399], [96, 143719], [103, 144654], [110, 144883], [114, 145243], [117, 145483], [126, 146023], [133, 146363], [139, 146743], [142, 147003], [149, 147503], [153, 147723], [159, 147963], [162, 148323]]}, {"verse": 20, "start": 150339, "end": 159529, "text": "Pero los príncipes de los sacerdotes y los ancianos, persuadieron al pueblo que pidiese a Barrabás, y a Jesús matase.", "words": [[0, 150339], [5, 150524], [9, 150724], [19, 151504], [22, 151644], [26, 151784], [37, 152484], [39, 152624], [43, 152784], [53, 153604], [66, 155304], [69, 155504], [76, 155924], [80, 156304], [88, 156924], [90, 157244], [100, 157924], [102, 158184], [104, 158284], [110, 158604]]}, {"verse": 21, "start": 159979, "end": 168035, "text": "Y respondiendo el gobernador les dijo: ¿Cuál de los dos queréis que os suelte? Y ellos dijeron: A Barrabás.", "words": [[0, 159979], [2, 160084], [15, 160804], [18, 160924], [29, 161544], [33, 161744], [39, 162502], [45, 162823], [48, 162943], [52, 163103], [56, 163343], [64, 163823], [68, 164003], [71, 164123], [79, 165116], [81, 165282], [87, 165462], [96, 166988], [98, 167512]]}, {"verse": 22, "start": 168385, "end": 178581, "text": "Pilato les dijo: ¿Qué pues haré de Jesús que se dice el Cristo? Le dicen todos: Sea crucificado.", "words": [[0, 168385], [7, 168787], [11, 168987], [17, 169874], [22, 169994], [27, 170274], [32, 170714], [35, 170774], [41, 171154], [45, 171414], [48, 171554], [53, 171834], [56, 171954], [64, 172945], [67, 173071], [73, 173331], [80, 174384], [84, 174671]]}, {"verse": 23, "start": 178931, "end": 189071, "text": "Y el gobernador les dijo: Pues ¿qué mal ha hecho? Pero ellos gritaban más, diciendo: Sea crucificado.", "words": [[0, 178931], [2, 179074], [5, 179134], [16, 179694], [20, 179894], [26, 180689], [31, 181054], [36, 181114], [40, 181274], [43, 181414], [50, 182171], [55, 182334], [61, 182574], [70, 183234], [75, 183554], [85, 184875], [89, 185161]]}, {"verse": 24, "start": 189421, "end": 203159, "text": "Y viendo Pilato que nada adelantaba, antes se hacía más alboroto, tomando agua se lavó las manos delante del pueblo, diciendo: Inocente soy yo de la sangre de este justo: allá vosotros.", "words": [[0, 189421], [2, 189549], [9, 189849], [16, 190389], [20, 190589], [25, 190869], [37, 191989], [43, 192329], [46, 192629], [52, 192989], [56, 193249], [66, 194629], [74, 195069], [79, 195409], [82, 195649], [87, 195909], [91, 196069], [97, 196309], [105, 196769], [109, 196969], [117, 197549], [127, 199068], [136, 199710], [140, 200070], [143, 200330], [146, 200430], [149, 200570], [156, 200890], [159, 201130], [164, 201370], [171, 202270], [176, 202509]]}, {"verse": 25, "start": 203509, "end": 210737, "text": "Y respondiendo todo el pueblo, dijo: Su sangre sea sobre nosotros, y sobre nuestros hijos.", "words": [[0, 203573], [2, 203673], [15, 204593], [20, 204973], [23, 205253], [31, 205653], [37, 206556], [40, 206671], [47, 207031], [51, 207431], [57, 207711], [67, 208251], [69, 208671], [75, 208891], [84, 209211]]}, {"verse": 26, "start": 211087, "end": 218227, "text": "Entonces les soltó a Barrabás: y habiendo azotado a Jesús, le entregó para ser crucificado.", "words": [[0, 211087], [9, 211631], [13, 212471], [19, 213111], [21, 213643], [31, 214426], [33, 214671], [42, 215121], [50, 215571], [52, 215651], [59, 215911], [62, 216291], [70, 216771], [75, 216931], [79, 217171]]}, {"verse": 27, "start": 218677, "end": 227661, "text": "Entonces los soldados del gobernador llevaron a Jesús al palacio del gobernador, y juntaron a él toda la compañía;", "words": [[0, 218677], [9, 219277], [13, 219917], [22, 220617], [26, 220777], [37, 221377], [46, 221877], [48, 221977], [54, 222197], [57, 222517], [65, 223077], [69, 223217], [81, 224327], [83, 224737], [92, 225377], [94, 225537], [97, 225757], [102, 226057], [105, 226337]]}, {"verse": 28, "start": 228111, "end": 232555, "text": "Y desnudándole, le echaron encima un manto escarlata;", "words": [[0, 228111], [2, 228239], [16, 229319], [19, 229579], [27, 230159], [34, 230719], [37, 231039], [43, 231797]]}, {"verse": 29, "start": 233005, "end": 246626, "text": "Y pusieron sobre su cabeza una corona tejida de espinas, y una caña en su mano derecha; y arrodillándose delante de él, se burlaban de él, diciendo: ¡Salve, Rey de los judíos!", "words": [[0, 233005], [2, 233114], [11, 233554], [17, 233874], [20, 234074], [27, 234494], [31, 234754], [38, 235194], [45, 235894], [48, 236094], [57, 236834], [59, 237294], [63, 237474], [68, 237934], [71, 238194], [74, 238374], [79, 238634], [88, 239695], [90, 239821], [105, 240841], [113, 241361], [116, 241561], [120, 242081], [123, 242301], [132, 242981], [135, 243241], [139, 243721], [149, 244899], [157, 245324], [161, 245624], [164, 245724], [168, 245844]]}, {"verse": 30, "start": 246976, "end": 251877, "text": "Y escupiendo en él, tomaron la caña, y le herían en la cabeza.", "words": [[0, 246976], [2, 247120], [13, 247780], [16, 247960], [20, 248580], [28, 249000], [31, 249180], [37, 249680], [39, 250260], [42, 250460], [49, 250900], [52, 251060], [55, 251180]]}, {"verse": 31, "start": 252327, "end": 260650, "text": "Y después que se hubieron burlado de él, le desnudaron el manto, y le vistieron de sus vestidos, y le llevaron para crucificarle.", "words": [[0, 252327], [2, 252423], [10, 252723], [14, 252903], [17, 253063], [26, 253403], [34, 253923], [37, 254143], [41, 254623], [44, 254723], [55, 255443], [58, 255643], [65, 256143], [67, 256603], [70, 256723], [80, 257283], [83, 257463], [87, 257643], [97, 258263], [99, 258533], [102, 258803], [111, 259263], [116, 259503]]}, {"verse": 32, "start": 261100, "end": 268751, "text": "Y saliendo, hallaron a un cireneo, que se llamaba Simón: a este cargaron para que llevase su cruz.", "words": [[0, 261100], [2, 261248], [12, 261808], [21, 262688], [23, 262808], [26, 263268], [35, 263728], [39, 264008], [42, 264148], [50, 264608], [57, 265874], [59, 266074], [64, 266334], [73, 267094], [78, 267374], [82, 267534], [90, 268054], [93, 268154]]}, {"verse": 33, "start": 269201, "end": 275851, "text": "Y cuando llegaron al lugar que se llama Gólgota, que es dicho, El lugar de la calavera,", "words": [[0, 269201], [2, 269306], [9, 269546], [18, 270166], [21, 270446], [27, 270886], [31, 271346], [34, 271486], [40, 271826], [49, 273106], [53, 273166], [56, 273386], [63, 274246], [66, 274426], [72, 274746], [75, 274926], [78, 275066]]}, {"verse": 34, "start": 276301, "end": 282504, "text": "Le dieron a beber vinagre mezclado con hiel; y después de probarlo, no quiso beberlo.", "words": [[0, 276301], [3, 276407], [10, 276787], [12, 276887], [18, 277127], [26, 277807], [35, 278547], [39, 278957], [45, 279656], [47, 279802], [55, 280002], [58, 280202], [68, 281182], [71, 281282], [77, 281662]]}, {"verse": 35, "start": 282954, "end": 297141, "text": "Y después que le hubieron crucificado, repartieron sus vestidos, echando suertes: para que se cumpliese lo que fue dicho por el profeta: Se repartieron mis vestidos, y sobre mi ropa echaron suertes.", "words": [[0, 282954], [2, 283060], [10, 283380], [14, 283600], [17, 283740], [26, 284140], [39, 285140], [51, 286120], [55, 286340], [65, 286960], [73, 287700], [82, 288868], [87, 289086], [91, 289226], [94, 289366], [104, 290026], [107, 290186], [111, 290306], [115, 290486], [121, 290786], [125, 291106], [128, 291266], [137, 292494], [140, 292624], [152, 293304], [156, 293544], [166, 294644], [168, 294844], [174, 295124], [177, 295384], [182, 295884], [190, 296304]]}, {"verse": 36, "start": 297591, "end": 300292, "text": "Y sentados le guardaban allí.", "words": [[0, 297591], [2, 297715], [11, 298495], [14, 299055], [24, 299735]]}, {"verse": 37, "start": 300742, "end": 308571, "text": "Y pusieron sobre su cabeza la acusación escrita contra él: ESTE ES JESÚS EL REY DE LOS JUDÍOS.", "words": [[0, 300742], [2, 300830], [11, 301330], [17, 301650], [20, 301910], [27, 302470], [30, 303070], [40, 303850], [48, 304370], [55, 304710], [59, 305505], [64, 305794], [67, 305994], [73, 306854], [76, 306934], [80, 307394], [83, 307694], [87, 307834]]}, {"verse": 38, "start": 309021, "end": 315964, "text": "Entonces crucificaron con él dos ladrones, uno a la derecha, y otro a la izquierda.", "words": [[0, 309021], [9, 309616], [22, 310656], [26, 310876], [29, 311076], [33, 311336], [43, 312616], [47, 312956], [49, 313256], [52, 313336], [61, 313976], [63, 314496], [68, 314736], [70, 315036], [73, 315136]]}, {"verse": 39, "start": 316414, "end": 320863, "text": "Y los que pasaban, lo insultaban, meneando sus cabezas,", "words": [[0, 316414], [2, 316679], [6, 316799], [10, 316939], [19, 317619], [22, 318059], [34, 319139], [43, 319719], [47, 319939]]}, {"verse": 40, "start": 321313, "end": 330384, "text": "Y diciendo: Tú, el que derribas el templo, y en tres días lo reedificas, sálvate a ti mismo: si eres Hijo de Dios, desciende de la cruz.", "words": [[0, 321313], [2, 321431], [12, 322481], [16, 322638], [19, 322758], [23, 322878], [32, 323338], [35, 323458], [43, 324278], [45, 324398], [48, 324518], [53, 324718], [58, 324958], [61, 325618], [73, 326278], [81, 326698], [83, 326878], [86, 326958], [93, 327771], [96, 327950], [101, 328110], [106, 328390], [109, 328570], [115, 329230], [125, 329610], [128, 329770], [131, 329890]]}, {"verse": 41, "start": 330734, "end": 339686, "text": "De esta manera también los príncipes de los sacerdotes, burlándose de él con los escribas y los fariseos y los ancianos, decían:", "words": [[0, 330734], [3, 330903], [8, 331083], [15, 331363], [23, 331783], [27, 332043], [37, 332803], [40, 333063], [44, 333223], [56, 334543], [67, 335303], [70, 335483], [73, 335663], [77, 335843], [81, 336003], [90, 336623], [92, 336763], [96, 336903], [105, 337583], [107, 337683], [111, 337843], [121, 338843]]}, {"verse": 42, "start": 339936, "end": 347086, "text": "A otros salvó, a sí mismo no puede salvar: si es el Rey de Israel, descienda ahora de la cruz, y creeremos en él.", "words": [[0, 339936], [2, 340076], [8, 340336], [15, 340876], [17, 340936], [20, 341076], [26, 341456], [29, 341556], [35, 341776], [43, 342707], [46, 342886], [49, 343066], [52, 343206], [56, 343486], [59, 343526], [67, 343966], [77, 344746], [83, 345006], [86, 345146], [89, 345266], [95, 345786], [97, 346146], [107, 346506], [110, 346766]]}, {"verse": 43, "start": 347536, "end": 353445, "text": "Confió en Dios: que Dios lo libre ahora, si lo quiere, porque ha dicho: Soy Hijo de Dios.", "words": [[0, 347536], [7, 347956], [10, 348076], [16, 348927], [20, 349024], [25, 349244], [28, 349484], [34, 349704], [41, 350044], [44, 350284], [47, 350424], [55, 350984], [62, 351204], [65, 351404], [72, 352166], [76, 352384], [81, 352724], [84, 352904]]}, {"verse": 44, "start": 353795, "end": 359024, "text": "Lo mismo también le insultaban los ladrones que estaban crucificados con él.", "words": [[0, 353795], [3, 353922], [9, 354182], [17, 354702], [20, 355082], [31, 356022], [35, 356262], [44, 356862], [48, 357082], [56, 357382], [69, 358402], [73, 358642]]}, {"verse": 45, "start": 359474, "end": 364699, "text": "Y desde la hora de sexta fueron tinieblas sobre toda la tierra hasta la hora de nona.", "words": [[0, 359474], [2, 359747], [8, 359947], [11, 360227], [16, 360447], [19, 360607], [25, 361107], [32, 361347], [42, 362127], [48, 362347], [53, 362687], [56, 362927], [63, 363267], [69, 363727], [72, 363887], [77, 364067], [80, 364227]]}, {"verse": 46, "start": 365149, "end": 377927, "text": "Y cerca de la hora de nona, Jesús exclamó con grande voz, diciendo: Elí, Elí, ¿lama sabachtani? Esto es: Dios mío, Dios mío, ¿por qué me has desamparado?", "words": [[0, 365149], [2, 365273], [8, 365653], [11, 366013], [14, 366133], [19, 366353], [22, 366533], [28, 367213], [34, 367533], [42, 368713], [46, 368853], [53, 369253], [58, 369593], [68, 370851], [73, 371477], [78, 372323], [84, 373169], [96, 374253], [101, 374517], [105, 375219], [110, 375405], [115, 375805], [120, 375905], [125, 376425], [130, 376505], [134, 376645], [137, 376805], [141, 376925]]}, {"verse": 47, "start": 378377, "end": 384231, "text": "Y algunos de los que estaban allí, al oírlo, decían: A Elías llama este.", "words": [[0, 378377], [2, 378502], [10, 378842], [13, 379102], [17, 379222], [21, 379362], [29, 379682], [35, 380322], [38, 380602], [45, 381722], [53, 382898], [55, 383039], [61, 383439], [67, 383759]]}, {"verse": 48, "start": 384581, "end": 394320, "text": "Y luego, corriendo uno de ellos, tomó una esponja, y la empapó en vinagre, y poniéndola en una caña, le daba de beber.", "words": [[0, 384581], [2, 384725], [9, 384965], [19, 385765], [23, 386025], [26, 386205], [33, 387105], [38, 387565], [42, 387765], [51, 388565], [53, 388925], [56, 389285], [63, 389925], [66, 390025], [75, 390645], [77, 391005], [88, 391905], [91, 392085], [95, 392245], [101, 392765], [104, 393305], [109, 393625], [112, 393765]]}, {"verse": 49, "start": 394770, "end": 399119, "text": "Y los otros decían: Deja, veamos si viene Elías a librarle.", "words": [[0, 394770], [2, 394875], [6, 395015], [12, 395355], [20, 396652], [26, 396994], [33, 397514], [36, 397754], [42, 397974], [48, 398264], [50, 398554]]}, {"verse": 50, "start": 399469, "end": 405005, "text": "Pero Jesús, habiendo otra vez exclamado con grande voz, entregó el espíritu.", "words": [[0, 399469], [5, 399596], [12, 400336], [21, 400756], [26, 400976], [30, 401296], [40, 402156], [44, 402316], [51, 402656], [56, 403556], [64, 404216], [67, 404336]]}, {"verse": 51, "start": 405455, "end": 413658, "text": "Y he aquí, el velo del templo se rompió en dos, de alto a bajo: y la tierra tembló, y las rocas se partieron;", "words": [[0, 405455], [2, 405584], [5, 405784], [11, 406144], [14, 406444], [19, 406724], [23, 406864], [30, 407404], [33, 407524], [40, 408024], [43, 408184], [48, 408864], [51, 408944], [56, 409269], [58, 409595], [64, 410163], [66, 410289], [69, 410409], [76, 410709], [84, 411769], [86, 412009], [90, 412169], [96, 412629], [99, 412829]]}, {"verse": 52, "start": 414108, "end": 420247, "text": "Y se abrieron los sepulcros, y muchos cuerpos de santos que habían dormido, se levantaron;", "words": [[0, 414108], [2, 414402], [5, 414502], [14, 414962], [18, 415142], [29, 415902], [31, 416262], [38, 416542], [46, 417162], [49, 417282], [56, 417942], [60, 418122], [67, 418362], [76, 418962], [79, 419142]]}, {"verse": 53, "start": 420697, "end": 428853, "text": "Y salidos de los sepulcros, después de su resurrección, vinieron a la santa ciudad, y aparecieron a muchos.", "words": [[0, 420697], [2, 420838], [10, 421278], [13, 421438], [17, 421558], [28, 422698], [36, 423038], [39, 423238], [42, 423378], [56, 424328], [65, 425278], [67, 425558], [70, 425658], [76, 425978], [84, 426738], [86, 427258], [98, 428078], [100, 428178]]}, {"verse": 54, "start": 429303, "end": 441960, "text": "Y el centurión, y los que estaban con él guardando a Jesús, visto el terremoto, y las cosas que habían sido hechas, temieron en gran manera, diciendo: Verdaderamente Hijo de Dios era este.", "words": [[0, 429303], [2, 429486], [5, 429666], [16, 430486], [18, 430706], [22, 430846], [26, 430986], [34, 431266], [38, 431606], [41, 431806], [51, 432406], [53, 432546], [60, 433406], [66, 433826], [69, 433986], [80, 434686], [82, 434826], [86, 435006], [92, 435346], [96, 435526], [103, 435826], [108, 436166], [116, 436846], [125, 437406], [128, 437646], [133, 437826], [141, 438346], [151, 439603], [166, 440342], [171, 440622], [174, 440782], [179, 441022], [183, 441382]]}, {"verse": 55, "start": 442310, "end": 449736, "text": "Y estaban allí muchas mujeres mirando de lejos, las cuales habían seguido de Galilea a Jesús, sirviéndole:", "words": [[0, 442310], [2, 442434], [10, 442754], [15, 443074], [22, 443374], [30, 443934], [38, 444734], [41, 444914], [48, 445674], [52, 445914], [59, 446174], [66, 446614], [74, 447154], [77, 447314], [85, 447914], [87, 448074], [94, 448754]]}, {"verse": 56, "start": 450186, "end": 458174, "text": "Entre las cuales estaban María Magdalena, y María la madre de Jacobo y de José, y la madre de los hijos de Zebedeo.", "words": [[0, 450186], [6, 450409], [10, 450629], [17, 450909], [25, 451409], [31, 451849], [42, 452789], [44, 453409], [50, 453769], [53, 453969], [59, 454269], [62, 454489], [69, 455029], [71, 455089], [74, 455189], [80, 455509], [82, 456049], [85, 456189], [91, 456489], [94, 456729], [98, 456869], [104, 457209], [107, 457719]]}, {"verse": 57, "start": 458624, "end": 467125, "text": "Y como fue la tarde del día, vino un hombre rico de Arimatea, llamado José, el cual también había sido discípulo de Jesús.", "words": [[0, 458624], [2, 458730], [7, 458970], [11, 459190], [14, 459330], [20, 459610], [24, 459890], [29, 460250], [34, 460870], [37, 461090], [44, 461350], [49, 461730], [52, 461970], [62, 462630], [70, 462910], [76, 463990], [79, 464070], [84, 464250], [92, 464630], [98, 464930], [103, 465330], [113, 466270], [116, 466430]]}, {"verse": 58, "start": 467575, "end": 475102, "text": "Este llegó a Pilato, y pidió el cuerpo de Jesús: entonces Pilato mandó que se le diese el cuerpo.", "words": [[0, 467575], [5, 467860], [11, 468220], [13, 468340], [21, 468800], [23, 469260], [29, 469620], [32, 469760], [39, 470040], [42, 470280], [49, 471207], [58, 471845], [65, 472505], [71, 473165], [75, 473625], [78, 473785], [81, 473985], [87, 474185], [90, 474445]]}, {"verse": 59, "start": 475552, "end": 479733, "text": "Y tomando José el cuerpo, lo envolvió en una sábana limpia,", "words": [[0, 475552], [2, 475649], [10, 476029], [15, 476389], [18, 476589], [26, 477009], [29, 477409], [38, 478049], [41, 478229], [45, 478409], [52, 478949]]}, {"verse": 60, "start": 480183, "end": 489703, "text": "Y lo puso en su sepulcro nuevo, que había excavado en la roca: y después de hacer rodar una gran piedra a la puerta del sepulcro, se fue.", "words": [[0, 480183], [2, 480285], [5, 480405], [10, 480765], [13, 480905], [16, 481295], [25, 481685], [32, 482145], [36, 482665], [42, 482925], [51, 483685], [54, 483825], [57, 483945], [63, 484809], [65, 484910], [73, 485170], [76, 485330], [82, 485710], [88, 486270], [92, 486410], [97, 486630], [104, 487170], [106, 487270], [109, 487370], [116, 487670], [120, 487970], [130, 489070], [133, 489270]]}, {"verse": 61, "start": 490153, "end": 496197, "text": "Y estaban allí María Magdalena, y la otra María, sentadas delante del sepulcro.", "words": [[0, 490153], [2, 490278], [10, 490618], [15, 491018], [21, 491478], [32, 492458], [34, 492878], [37, 493018], [42, 493278], [49, 493778], [58, 494758], [66, 495198], [70, 495418]]}, {"verse": 62, "start": 496647, "end": 505379, "text": "Y el siguiente día, que es después de la preparación, se juntaron los príncipes de los sacerdotes y los fariseos a Pilato,", "words": [[0, 496647], [2, 496791], [5, 496951], [15, 497371], [20, 498151], [24, 498271], [27, 498471], [35, 499011], [38, 499271], [41, 499431], [54, 500591], [57, 500751], [66, 501331], [70, 501511], [80, 502251], [83, 502371], [87, 502511], [98, 503391], [100, 503611], [104, 503771], [113, 504571], [115, 504771]]}, {"verse": 63, "start": 505829, "end": 513308, "text": "Diciendo: Señor, nos acordamos que aquel engañador dijo, viviendo aún: Después de tres días resucitaré.", "words": [[0, 505829], [10, 506906], [17, 507244], [21, 507544], [31, 508164], [35, 508384], [41, 508644], [51, 509164], [57, 509904], [66, 510424], [71, 511261], [79, 511533], [82, 511773], [87, 512033], [92, 512473]]}, {"verse": 64, "start": 513758, "end": 525746, "text": "Manda, pues, que se asegure el sepulcro hasta el día tercero; porque no vengan sus discípulos de noche, y le hurten, y digan al pueblo: Resucitó de los muertos. Y será el último error peor que el primero.", "words": [[0, 513758], [7, 514077], [13, 514337], [17, 514657], [20, 514797], [28, 515277], [31, 515377], [40, 515957], [46, 516177], [49, 516337], [53, 516517], [62, 517508], [69, 517699], [72, 517879], [79, 518159], [83, 518339], [94, 518899], [97, 519059], [104, 519339], [106, 519639], [109, 519909], [117, 520179], [119, 520399], [125, 520719], [128, 520819], [136, 521659], [145, 522258], [148, 522358], [152, 522478], [161, 523454], [163, 523560], [168, 523780], [171, 523980], [178, 524260], [184, 524600], [189, 525000], [193, 525100], [196, 525200]]}, {"verse": 65, "start": 526096, "end": 530990, "text": "Y Pilato les dijo: Tenéis una guardia: id, aseguradlo como sabéis.", "words": [[0, 526096], [2, 526221], [9, 526681], [13, 526901], [19, 527644], [26, 527947], [30, 528107], [39, 529080], [43, 529190], [54, 530170], [59, 530370]]}, {"verse": 66, "start": 531340, "end": 537196, "text": "Y yendo ellos, aseguraron el sepulcro, sellando la piedra, con la guardia.", "words": [[0, 531340], [2, 531482], [8, 531862], [15, 532262], [26, 533222], [29, 533422], [39, 534602], [48, 535082], [51, 535222], [59, 535942], [63, 536282], [66, 536482]]}]}