{"book": "LUK", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 342634, "verses": [{"verse": 1, "start": 300, "end": 8297, "text": "Y aconteció, que estando él junto al lago de Genezaret, el gentío se agolpaba sobre él para oír la palabra de Dios.", "words": [[0, 300], [2, 426], [13, 1126], [17, 1386], [25, 1806], [28, 1966], [34, 2186], [37, 2446], [42, 2746], [45, 3436], [56, 4126], [59, 4226], [66, 4846], [69, 5046], [78, 5786], [84, 6086], [87, 6426], [92, 6626], [96, 7026], [99, 7166], [107, 7606], [110, 7746]]}, {"verse": 2, "start": 8647, "end": 17200, "text": "Y vio dos barcos que estaban cerca de la orilla del lago: y los pescadores, habiendo descendido de ellos, lavaban sus redes.", "words": [[0, 8647], [2, 8775], [6, 8975], [10, 9155], [17, 9595], [21, 9755], [29, 10035], [35, 10455], [38, 10715], [41, 10855], [48, 11255], [52, 11415], [58, 12130], [60, 12233], [64, 12393], [76, 13173], [85, 13693], [96, 14513], [99, 14693], [106, 15593], [114, 16253], [118, 16473]]}, {"verse": 3, "start": 17550, "end": 28197, "text": "Y entrado en uno de estos barcos, el cual era de Simón, le rogó que lo desviase de tierra un poco; y sentándose, enseñaba desde el barco a la multitud.", "words": [[0, 17550], [2, 17825], [10, 18345], [13, 18485], [17, 18665], [20, 18805], [26, 18985], [34, 19525], [37, 19785], [42, 19985], [46, 20365], [49, 20545], [56, 21065], [59, 21685], [64, 22185], [68, 22305], [71, 22465], [80, 23025], [83, 23205], [90, 23565], [93, 23805], [99, 24572], [101, 24698], [113, 25538], [122, 26438], [128, 26618], [131, 26858], [137, 27258], [139, 27358], [142, 27438]]}, {"verse": 4, "start": 28547, "end": 35622, "text": "Y como cesó de hablar, dijo a Simón: Ve a aguas profundas, y echad vuestras redes para pescar.", "words": [[0, 28547], [2, 28802], [7, 29022], [12, 29462], [15, 29562], [23, 30402], [28, 30794], [30, 31186], [37, 31734], [40, 31800], [42, 31900], [48, 32220], [59, 33260], [61, 33480], [67, 33900], [76, 34300], [82, 34620], [87, 34980]]}, {"verse": 5, "start": 35972, "end": 43880, "text": "Y respondiendo Simón, le dijo: Maestro, habiendo trabajado toda la noche, nada hemos tomado; pero en tu palabra echaré la red.", "words": [[0, 35972], [2, 36251], [15, 37091], [22, 37471], [25, 37631], [31, 38362], [40, 38919], [49, 39139], [59, 39719], [64, 39899], [67, 40079], [74, 40819], [79, 40999], [85, 41279], [93, 42126], [98, 42290], [101, 42410], [104, 42510], [112, 42850], [119, 43370], [122, 43510]]}, {"verse": 6, "start": 44160, "end": 49969, "text": "Y habiéndolo hecho, encerraron gran multitud de pescado, que su red se rompía.", "words": [[0, 44160], [2, 44324], [13, 44844], [20, 45164], [31, 46044], [36, 46264], [45, 47044], [48, 47284], [57, 48024], [61, 48219], [64, 48439], [68, 48779], [71, 49139]]}, {"verse": 7, "start": 50319, "end": 61482, "text": "E hicieron señas a los compañeros que estaban en el otro barco, que viniesen a ayudarles; y vinieron, y llenaron ambos barcos, de tal manera que se hundían.", "words": [[0, 50319], [2, 50636], [11, 51136], [17, 51876], [19, 51956], [23, 52076], [34, 52776], [38, 52896], [46, 53196], [49, 53456], [52, 53616], [57, 53796], [64, 54576], [68, 54916], [77, 55256], [79, 55536], [90, 56714], [92, 56856], [102, 57356], [104, 57656], [113, 58216], [119, 58616], [127, 59236], [130, 59636], [134, 59956], [141, 60316], [145, 60556], [148, 60716]]}, {"verse": 8, "start": 61832, "end": 69714, "text": "Lo cual viendo Simón Pedro, se derribó de rodillas a Jesús, diciendo: Apártate de mí, Señor, porque soy hombre pecador.", "words": [[0, 61832], [3, 61958], [8, 62138], [15, 62478], [21, 62938], [28, 63398], [31, 63938], [39, 64518], [42, 64638], [51, 65138], [53, 65318], [60, 65658], [70, 66868], [79, 67426], [82, 67586], [86, 67686], [93, 68366], [100, 68566], [104, 68786], [111, 69086]]}, {"verse": 9, "start": 69994, "end": 77065, "text": "Porque temor le había rodeado, y a todos los que estaban con él, de la captura de los peces que habían tomado;", "words": [[0, 69994], [7, 70238], [13, 70758], [16, 70878], [22, 71178], [31, 71898], [33, 72103], [35, 72203], [41, 72503], [45, 72783], [49, 72963], [57, 73303], [61, 73623], [65, 73863], [68, 74523], [71, 74643], [79, 75123], [82, 75263], [86, 75383], [92, 75923], [96, 76143], [103, 76403]]}, {"verse": 10, "start": 77415, "end": 89740, "text": "Y asimismo a Jacobo y a Juan, hijos de Zebedeo, que eran compañeros de Simón. Y Jesús dijo a Simón: No temas: desde ahora pescarás hombres.", "words": [[0, 77415], [2, 77812], [11, 78242], [13, 78542], [20, 79262], [22, 79422], [24, 79502], [30, 80482], [36, 80742], [39, 81522], [48, 82302], [52, 82362], [57, 82622], [68, 83482], [71, 83642], [78, 84590], [80, 84717], [86, 85077], [91, 85597], [93, 85837], [100, 86616], [103, 86763], [110, 87622], [116, 87848], [122, 88388], [131, 88928]]}, {"verse": 11, "start": 90090, "end": 94991, "text": "Y cuando llegaron a tierra los barcos, dejándolo todo, le siguieron.", "words": [[0, 90090], [2, 90178], [9, 90378], [18, 90958], [20, 91078], [27, 91378], [31, 91638], [39, 92598], [49, 93258], [55, 94118], [58, 94218]]}, {"verse": 12, "start": 95341, "end": 108486, "text": "Y aconteció que estando en una ciudad, he aquí un hombre lleno de lepra, el cual viendo a Jesús, postrándose sobre el rostro, le rogó, diciendo: Señor, si quieres, puedes limpiarme.", "words": [[0, 95341], [2, 95462], [12, 96142], [16, 96322], [24, 96682], [27, 96802], [31, 96962], [39, 97722], [42, 98002], [47, 98262], [50, 98442], [57, 98782], [63, 99302], [66, 99422], [73, 99855], [76, 100289], [81, 100722], [88, 101082], [90, 101242], [97, 102002], [109, 102742], [115, 103142], [118, 103342], [126, 104107], [129, 104247], [135, 104827], [145, 105970], [152, 106555], [155, 106555], [164, 107255], [171, 107655]]}, {"verse": 13, "start": 108766, "end": 115856, "text": "Entonces, extendiendo la mano, le tocó diciendo: Quiero: sé limpio. Y luego la lepra se fue de él.", "words": [[0, 108766], [10, 109650], [22, 110390], [25, 110550], [31, 110950], [34, 111010], [39, 111370], [49, 112270], [57, 112930], [60, 113098], [68, 113964], [70, 114072], [76, 114292], [79, 114532], [85, 114932], [88, 115032], [92, 115301], [95, 115441]]}, {"verse": 14, "start": 116206, "end": 127771, "text": "Y él le mandó que no lo dijese a nadie: Pero ve, le dijo, muéstrate al sacerdote, y ofrece por tu limpieza, como mandó Moisés, para testimonio a ellos.", "words": [[0, 116206], [2, 116373], [5, 116513], [8, 116653], [14, 117013], [18, 117153], [21, 117313], [24, 117433], [31, 117893], [33, 118053], [40, 118778], [45, 119134], [49, 119667], [52, 119881], [58, 120628], [68, 121114], [71, 121374], [82, 122134], [84, 122494], [91, 122874], [95, 123154], [98, 123294], [108, 124034], [113, 124614], [119, 125114], [127, 125574], [132, 126049], [143, 126989], [145, 127149]]}, {"verse": 15, "start": 128121, "end": 135430, "text": "Pero tanto más se extendía su fama: y se reunía mucha gente para oír y ser sanadas de sus enfermedades.", "words": [[0, 128121], [5, 128435], [11, 128695], [15, 129055], [18, 129235], [27, 129835], [30, 130015], [36, 130833], [38, 130954], [41, 131074], [48, 131574], [54, 131814], [60, 132214], [65, 132534], [69, 132934], [71, 133134], [75, 133374], [83, 133954], [86, 134114], [90, 134254]]}, {"verse": 16, "start": 135780, "end": 138805, "text": "Pero él se apartaba a los desiertos, y oraba.", "words": [[0, 135780], [5, 135944], [8, 136124], [11, 136264], [20, 136904], [22, 137004], [26, 137124], [37, 137964], [39, 138164]]}, {"verse": 17, "start": 139155, "end": 155488, "text": "Y aconteció un día, que él estaba enseñando, y los fariseos y maestros de la ley estaban sentados, los cuales habían venido de todas las aldeas de Galilea, y de Judea y Jerusalén: y el poder del Señor estaba allí para sanarlos.", "words": [[0, 139155], [2, 139332], [12, 140032], [15, 140212], [20, 140552], [24, 140787], [27, 141147], [34, 141447], [45, 142347], [47, 142987], [51, 143127], [60, 143827], [62, 143947], [71, 144567], [74, 144687], [77, 144827], [81, 145067], [89, 145447], [99, 146747], [103, 146947], [110, 147167], [117, 147607], [124, 148067], [127, 148207], [133, 148467], [137, 148767], [144, 149247], [147, 149347], [156, 150173], [158, 150413], [161, 150453], [167, 151093], [169, 151253], [180, 152410], [182, 152570], [185, 152730], [191, 153070], [195, 153310], [201, 153650], [208, 154070], [213, 154350], [218, 154590]]}, {"verse": 18, "start": 155838, "end": 164493, "text": "Y he aquí unos hombres, que traían sobre un lecho un hombre que estaba paralítico; y buscaban meterle, y ponerle delante de él.", "words": [[0, 155838], [2, 155974], [5, 156144], [10, 156384], [15, 156584], [24, 157064], [28, 157449], [35, 157929], [41, 158209], [44, 158389], [50, 158789], [53, 159089], [60, 159409], [64, 159629], [71, 159909], [83, 161248], [85, 161374], [94, 161854], [103, 162514], [105, 162894], [113, 163474], [121, 163954], [124, 164094]]}, {"verse": 19, "start": 164843, "end": 175388, "text": "Y no hallando por donde meterle a causa de la multitud, subieron encima de la casa, y por el tejado le bajaron con el lecho en medio, delante de Jesús;", "words": [[0, 164843], [2, 164966], [5, 165086], [14, 165506], [18, 165746], [24, 165986], [32, 166686], [34, 166806], [40, 167126], [43, 167326], [46, 167446], [56, 168526], [65, 169106], [72, 169546], [75, 169726], [78, 169866], [84, 170746], [86, 170946], [90, 171106], [93, 171226], [100, 171786], [103, 171906], [111, 172406], [115, 172586], [118, 172766], [124, 173126], [127, 173266], [134, 173686], [142, 174526], [145, 174686]]}, {"verse": 20, "start": 175738, "end": 181465, "text": "El cual, viendo la fe de ellos, le dice: Hombre, tus pecados te son perdonados.", "words": [[0, 175738], [3, 175901], [9, 176541], [16, 176881], [19, 177121], [22, 177301], [25, 177461], [32, 177741], [35, 178101], [41, 178890], [49, 179559], [53, 179719], [61, 180199], [64, 180339], [68, 180519]]}, {"verse": 21, "start": 181815, "end": 191571, "text": "Entonces los escribas y los fariseos comenzaron a pensar, diciendo: ¿Quién es este que habla blasfemias? ¿Quién puede perdonar pecados sino sólo Dios?", "words": [[0, 181815], [9, 182315], [13, 182775], [22, 183455], [24, 183615], [28, 183755], [37, 184395], [48, 185035], [50, 185155], [58, 185655], [68, 186984], [75, 187178], [78, 187318], [83, 187538], [87, 187758], [93, 187978], [105, 189039], [112, 189277], [118, 189477], [127, 190017], [135, 190537], [140, 190757], [145, 191017]]}, {"verse": 22, "start": 191851, "end": 199514, "text": "Jesús entonces, conociendo los pensamientos de ellos, respondiendo les dijo: ¿Qué pensáis en vuestros corazones?", "words": [[0, 191851], [6, 192277], [16, 193457], [27, 194097], [31, 194297], [44, 194977], [47, 195217], [54, 195750], [67, 196284], [71, 196817], [77, 197600], [82, 197703], [90, 198143], [93, 198343], [102, 198683]]}, {"verse": 23, "start": 199864, "end": 206764, "text": "¿Qué es más fácil, decir: Tus pecados te son perdonados, o decir: Levántate y anda?", "words": [[0, 199864], [5, 199986], [8, 200146], [12, 200366], [19, 200806], [26, 202057], [30, 202673], [38, 203233], [41, 203393], [45, 203633], [57, 204393], [59, 204792], [66, 205411], [76, 206049], [78, 206349]]}, {"verse": 24, "start": 207114, "end": 218046, "text": "Pues para que sepáis que el Hijo del hombre tiene potestad en la tierra de perdonar pecados, (dice al paralítico): A ti digo, levántate, toma tu lecho, y vete a tu casa.", "words": [[0, 207114], [5, 207418], [10, 207803], [14, 207963], [21, 208503], [25, 208743], [28, 208903], [33, 209143], [37, 209303], [44, 209603], [50, 209903], [59, 210583], [62, 210703], [65, 210843], [72, 211163], [75, 211383], [84, 211943], [93, 212837], [99, 213225], [102, 213445], [115, 214547], [117, 214752], [120, 214832], [126, 215232], [137, 216012], [142, 216192], [145, 216422], [152, 216652], [154, 216912], [159, 217232], [161, 217372], [164, 217452]]}, {"verse": 25, "start": 218396, "end": 226774, "text": "Y luego, levantándose en presencia de ellos, y tomando aquel en que estaba echado, se fue a su casa, glorificando a Dios.", "words": [[0, 218396], [2, 218541], [9, 218801], [22, 219861], [25, 220061], [35, 220681], [38, 220901], [45, 221721], [47, 222021], [55, 222401], [61, 222761], [64, 222881], [68, 223001], [75, 223301], [83, 224221], [86, 224321], [90, 224501], [92, 224601], [95, 224681], [101, 225441], [114, 226181], [116, 226281]]}, {"verse": 26, "start": 227124, "end": 235204, "text": "Y tomó espanto a todos, y glorificaban a Dios; y fueron llenos de temor, diciendo: Hemos visto maravillas hoy.", "words": [[0, 227124], [2, 227248], [7, 227568], [15, 228188], [17, 228348], [24, 228728], [26, 229288], [39, 230088], [41, 230208], [47, 230904], [49, 231043], [56, 231283], [63, 231723], [66, 231823], [73, 232323], [83, 233571], [89, 233754], [95, 234094], [106, 234714]]}, {"verse": 27, "start": 235484, "end": 245795, "text": "Y después de estas cosas salió, y vio a un recaudador de impuestos llamado Leví, sentado a la mesa de cobro de impuestos, y le dijo: Sígueme.", "words": [[0, 235484], [2, 235606], [10, 235906], [13, 236106], [19, 236306], [25, 236746], [32, 237786], [34, 238046], [38, 238306], [40, 238526], [43, 238706], [54, 239446], [57, 239646], [67, 240226], [75, 240546], [81, 240946], [89, 242146], [91, 242266], [94, 242366], [99, 242606], [102, 242806], [108, 243186], [111, 243346], [122, 244006], [124, 244186], [127, 244286], [133, 245416]]}, {"verse": 28, "start": 246145, "end": 249885, "text": "Y dejadas todas las cosas, levantándose, le siguió.", "words": [[0, 246145], [2, 246260], [10, 246640], [16, 246900], [20, 247180], [27, 247600], [41, 248980], [44, 249280]]}, {"verse": 29, "start": 250235, "end": 259908, "text": "E hizo Leví gran banquete en su casa; y había muchos recaudadores de impuestos y otras personas, los cuales estaban a la mesa con ellos.", "words": [[0, 250235], [2, 250399], [7, 250739], [12, 251079], [17, 251319], [26, 251979], [29, 252159], [32, 252299], [38, 253165], [40, 253291], [46, 253471], [53, 253871], [66, 254791], [69, 255031], [79, 255731], [81, 256271], [87, 256471], [97, 257551], [101, 257651], [108, 257891], [116, 258431], [118, 258631], [121, 258731], [126, 258971], [130, 259231]]}, {"verse": 30, "start": 260258, "end": 269605, "text": "Y los escribas y los fariseos murmuraban contra sus discípulos, diciendo: ¿Por qué coméis y bebéis con los recaudadores de impuestos y pecadores?", "words": [[0, 260258], [2, 260384], [6, 260544], [15, 261204], [17, 261364], [21, 261524], [30, 262244], [41, 263084], [48, 263464], [52, 263764], [64, 264744], [74, 265893], [79, 266020], [83, 266180], [90, 266600], [92, 266740], [99, 267060], [103, 267240], [107, 267360], [120, 268020], [123, 268200], [133, 268660], [135, 268820]]}, {"verse": 31, "start": 269885, "end": 277228, "text": "Y respondiendo Jesús, les dijo: Los que están sanos no necesitan médico, sino los que están enfermos.", "words": [[0, 269885], [2, 270007], [15, 270747], [22, 271147], [26, 271707], [32, 272526], [36, 272799], [40, 272959], [46, 273219], [52, 273699], [55, 273899], [65, 274519], [73, 275519], [78, 275819], [82, 276039], [86, 276159], [92, 276379]]}, {"verse": 32, "start": 277578, "end": 281637, "text": "No he venido a llamar justos, sino pecadores a arrepentimiento.", "words": [[0, 277578], [3, 277748], [6, 277828], [13, 278148], [15, 278228], [22, 278538], [30, 278848], [35, 279248], [45, 280068], [47, 280328]]}, {"verse": 33, "start": 281987, "end": 292375, "text": "Entonces ellos le dijeron: ¿Por qué los discípulos de Juan ayunan muchas veces y hacen oraciones, y asimismo los de los fariseos, y tus discípulos comen y beben?", "words": [[0, 281987], [9, 282426], [15, 282966], [18, 283206], [27, 284031], [32, 284097], [36, 284164], [40, 284384], [51, 285024], [54, 285184], [59, 285524], [66, 285944], [73, 286184], [79, 286624], [81, 287044], [87, 287284], [98, 288304], [100, 288594], [109, 288884], [113, 289104], [116, 289264], [120, 289384], [130, 290244], [132, 290504], [136, 290644], [147, 291384], [153, 291744], [155, 291924]]}, {"verse": 34, "start": 292655, "end": 299758, "text": "Y él les dijo: ¿Podéis hacer que los que están de bodas ayunen, entre tanto que el esposo está con ellos?", "words": [[0, 292655], [2, 292883], [5, 293063], [9, 293263], [15, 294017], [23, 294401], [29, 294881], [33, 295321], [37, 295481], [41, 295641], [47, 295881], [50, 296021], [56, 296381], [64, 296914], [70, 297448], [76, 297981], [80, 298201], [83, 298381], [90, 298801], [95, 299001], [99, 299261]]}, {"verse": 35, "start": 300108, "end": 306496, "text": "Pero vendrán días cuando el esposo les será quitado: entonces ayunarán en aquellos días.", "words": [[0, 300108], [5, 300275], [13, 300775], [18, 301115], [25, 301575], [28, 301815], [35, 302255], [39, 302475], [44, 302715], [53, 303655], [62, 304219], [71, 305239], [74, 305399], [83, 305659]]}, {"verse": 36, "start": 306846, "end": 318225, "text": "Y les decía también una parábola: Nadie mete remiendo de paño nuevo en vestido viejo; de otra manera el nuevo rompe, y al viejo no conviene remiendo nuevo.", "words": [[0, 306846], [2, 306969], [6, 307109], [12, 307529], [20, 307909], [24, 308289], [34, 309264], [40, 309864], [45, 310144], [54, 310844], [57, 311094], [62, 311344], [68, 311644], [71, 311824], [79, 312304], [86, 313101], [89, 313247], [94, 313407], [101, 313807], [104, 314007], [110, 314167], [117, 314867], [119, 315287], [122, 315447], [128, 315987], [131, 316427], [140, 316987], [149, 317607]]}, {"verse": 37, "start": 318575, "end": 329007, "text": "Y nadie echa vino nuevo en odres viejos; de otra manera el vino nuevo romperá los odres, y el vino se derramará, y los odres se perderán.", "words": [[0, 318575], [2, 318722], [8, 319022], [13, 319582], [18, 319982], [24, 320382], [27, 320582], [33, 320962], [41, 322053], [44, 322179], [49, 322339], [56, 322739], [59, 322939], [64, 323119], [70, 323439], [78, 324099], [82, 324259], [89, 324819], [91, 325084], [94, 325204], [99, 325444], [102, 325684], [113, 326384], [115, 327064], [119, 327224], [125, 327844], [128, 328184]]}, {"verse": 38, "start": 329357, "end": 335457, "text": "Pero el vino nuevo en odres nuevos se ha de echar; y lo uno y lo otro se conserva.", "words": [[0, 329357], [5, 329522], [8, 329702], [13, 329942], [19, 330322], [22, 330582], [28, 331002], [35, 331462], [38, 331942], [41, 332102], [44, 332242], [51, 333065], [53, 333188], [56, 333328], [60, 333628], [62, 334088], [65, 334228], [70, 334468], [73, 334668]]}, {"verse": 39, "start": 335807, "end": 342234, "text": "Y ninguno que bebe del añejo, quiere enseguida el nuevo; porque dice: El añejo es mejor.", "words": [[0, 335807], [2, 335924], [10, 336384], [14, 336584], [19, 336924], [23, 337104], [30, 337664], [37, 338324], [47, 338984], [50, 339124], [57, 339871], [64, 340094], [70, 340891], [73, 341056], [79, 341536], [82, 341676]]}]}