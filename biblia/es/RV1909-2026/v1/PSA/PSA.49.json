{"book": "PSA", "chapter": 49, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 129256, "verses": [{"verse": 1, "start": 300, "end": 9299, "text": "Al Músico principal: Salmo para los hijos de Coré. Oíd esto, pueblos todos; escuchad, habitantes todos del mundo:", "words": [[0, 300], [3, 492], [10, 972], [21, 1996], [27, 2558], [32, 3038], [36, 3238], [42, 3558], [45, 3908], [51, 4425], [55, 4787], [61, 5177], [69, 5757], [76, 6602], [86, 7284], [97, 8084], [103, 8424], [107, 8724]]}, {"verse": 2, "start": 9649, "end": 14142, "text": "Así los plebeyos como los nobles, el rico y el pobre juntamente.", "words": [[0, 9649], [4, 9821], [8, 10241], [17, 10661], [22, 10901], [26, 11081], [34, 11941], [37, 12041], [42, 12421], [44, 12721], [47, 12861], [53, 13141]]}, {"verse": 3, "start": 14492, "end": 19805, "text": "Mi boca hablará sabiduría; y el pensamiento de mi corazón inteligencia.", "words": [[0, 14492], [3, 14597], [8, 14877], [16, 15537], [27, 16681], [29, 16786], [32, 16906], [44, 17726], [47, 17926], [50, 18066], [58, 18466]]}, {"verse": 4, "start": 20155, "end": 25314, "text": "Inclinaré mi oído a proverbios: declararé con el arpa mi enigma.", "words": [[0, 20155], [10, 20939], [13, 21179], [18, 21539], [20, 21699], [32, 22939], [42, 23704], [46, 23924], [49, 24104], [54, 24464], [57, 24684]]}, {"verse": 5, "start": 25664, "end": 31083, "text": "¿Por qué he de temer en los días de adversidad, cuando la iniquidad de mis opresores me rodee?", "words": [[0, 25664], [5, 25791], [9, 25991], [12, 26191], [15, 26391], [21, 26591], [24, 26791], [28, 26891], [33, 27111], [36, 27311], [48, 27991], [55, 28246], [58, 28506], [68, 29266], [71, 29446], [75, 29586], [85, 30226], [88, 30446]]}, {"verse": 6, "start": 31433, "end": 36082, "text": "Los que confían en sus bienes, y en la muchedumbre de sus riquezas se jactan,", "words": [[0, 31433], [4, 31714], [8, 32044], [16, 32374], [19, 32454], [23, 32614], [31, 33294], [33, 33434], [36, 33534], [39, 33634], [51, 34294], [54, 34434], [58, 34614], [67, 35234], [70, 35686]]}, {"verse": 7, "start": 36432, "end": 42461, "text": "Ninguno de ellos podrá en manera alguna redimir al hermano, ni dar a Dios su rescate.", "words": [[0, 36432], [8, 37061], [11, 37181], [17, 37481], [23, 38021], [26, 38081], [33, 38401], [40, 39071], [48, 39741], [51, 39841], [60, 40274], [63, 40708], [67, 41141], [69, 41241], [74, 41441], [77, 41701]]}, {"verse": 8, "start": 42811, "end": 46851, "text": "(Porque la redención de su vida es de gran precio, y no se hará jamás;)", "words": [[0, 42811], [8, 42971], [11, 43191], [21, 43851], [24, 44051], [27, 44211], [32, 44491], [35, 44591], [38, 44711], [43, 44911], [51, 45471], [53, 45711], [56, 45871], [59, 46031], [64, 46271]]}, {"verse": 9, "start": 47201, "end": 50835, "text": "Que viva adelante para siempre, y nunca vea la sepultura.", "words": [[0, 47201], [4, 47285], [9, 47605], [18, 48165], [23, 48485], [32, 48965], [34, 49230], [40, 49410], [44, 49910], [47, 50409]]}, {"verse": 10, "start": 51185, "end": 59362, "text": "Pues se ve que mueren los sabios, así como el insensato y el necio perecen, y dejan a otros sus riquezas.", "words": [[0, 51185], [5, 51326], [8, 51466], [11, 51566], [15, 51806], [22, 52046], [26, 52166], [34, 52846], [38, 53286], [43, 53566], [46, 53706], [56, 54706], [58, 54886], [61, 55006], [67, 55446], [76, 56126], [78, 56806], [84, 57266], [86, 57546], [92, 57906], [96, 58486]]}, {"verse": 11, "start": 59712, "end": 68950, "text": "En su interior tienen que sus casas serán eternas, y sus habitaciones para generación y generación: llamaron sus tierras de sus nombres.", "words": [[0, 59712], [3, 59857], [6, 60017], [15, 60517], [22, 60877], [26, 61137], [30, 61317], [36, 61837], [42, 62137], [51, 62997], [53, 63437], [57, 63597], [70, 64317], [75, 64597], [86, 65397], [88, 65537], [100, 66697], [109, 67037], [113, 67277], [121, 67857], [124, 68017], [128, 68157]]}, {"verse": 12, "start": 69300, "end": 75235, "text": "Mas el hombre no permanecerá en honra: es semejante a las bestias que perecen.", "words": [[0, 69300], [4, 69956], [7, 70036], [14, 70276], [17, 70716], [29, 71696], [32, 72130], [39, 72728], [42, 73009], [52, 73649], [54, 73769], [58, 74069], [66, 74369], [70, 74509]]}, {"verse": 13, "start": 75585, "end": 82902, "text": "Este su camino es su locura: con todo, corren sus descendientes por el dicho de ellos. (Selah.)", "words": [[0, 75585], [5, 75872], [8, 76072], [15, 76452], [18, 76872], [21, 77072], [29, 78789], [33, 78789], [39, 78789], [46, 79254], [50, 79514], [64, 80614], [68, 80934], [71, 81074], [77, 81374], [80, 81574], [87, 82666]]}, {"verse": 14, "start": 83252, "end": 96110, "text": "Como rebaños serán puestos en la sepultura; la muerte se cebará en ellos; y por la mañana los justos prevalecerán sobre ellos: y se consumirá su hermosura en el sepulcro de su morada.", "words": [[0, 83252], [5, 83777], [13, 84337], [19, 84737], [27, 85257], [30, 85397], [33, 85537], [44, 86635], [47, 86784], [54, 87104], [57, 87544], [64, 87984], [67, 88144], [74, 88992], [76, 89080], [80, 89260], [83, 89400], [90, 89720], [94, 89980], [101, 90480], [114, 91280], [120, 91580], [127, 92446], [129, 92568], [132, 92668], [142, 93368], [145, 93528], [155, 94168], [158, 94308], [161, 94448], [170, 95108], [173, 95268], [176, 95388]]}, {"verse": 15, "start": 96460, "end": 101572, "text": "Pero Dios redimirá mi vida del poder de la sepultura, cuando me tome. (Selah.)", "words": [[0, 96460], [5, 96646], [10, 97258], [19, 97870], [22, 98030], [27, 98330], [31, 98570], [37, 98910], [40, 99110], [43, 99230], [54, 99850], [61, 100110], [64, 100370], [70, 101335]]}, {"verse": 16, "start": 101922, "end": 105758, "text": "No temas cuando se enriquece alguno, cuando aumenta la gloria de su casa;", "words": [[0, 101922], [3, 102052], [9, 102392], [16, 102552], [19, 102852], [29, 103312], [37, 103752], [44, 103912], [52, 104492], [55, 104592], [62, 104932], [65, 105072], [68, 105192]]}, {"verse": 17, "start": 106108, "end": 110648, "text": "Porque al morir no llevará nada, ni descenderá tras él su gloria.", "words": [[0, 106108], [7, 106334], [10, 106494], [16, 106914], [19, 107134], [27, 107594], [33, 108394], [36, 108594], [47, 109334], [52, 109494], [55, 109774], [58, 110220]]}, {"verse": 18, "start": 110998, "end": 117496, "text": "Si bien mientras viva, dirá dichosa a su alma: y tú serás alabado cuando bien te trates.", "words": [[0, 110998], [3, 111163], [8, 111503], [17, 112163], [23, 112743], [28, 113243], [36, 113783], [38, 113983], [41, 114083], [47, 114937], [49, 115064], [52, 115184], [58, 115604], [66, 116104], [73, 116304], [78, 116604], [81, 116784]]}, {"verse": 19, "start": 117846, "end": 123105, "text": "Entrará a la generación de sus padres: no verán luz para siempre.", "words": [[0, 117846], [8, 118568], [10, 118808], [13, 118908], [24, 119628], [27, 119788], [31, 119928], [39, 121023], [42, 121170], [48, 121530], [52, 121770], [57, 122150]]}, {"verse": 20, "start": 123455, "end": 128856, "text": "El hombre en honra que no entiende, semejante es a las bestias que perecen.", "words": [[0, 123455], [3, 123620], [10, 123940], [13, 124360], [19, 124920], [23, 125220], [26, 125420], [36, 126260], [46, 126980], [49, 127220], [51, 127320], [55, 127460], [63, 127900], [67, 128060]]}]}