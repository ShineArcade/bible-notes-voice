{"book": "PSA", "chapter": 135, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 127362, "verses": [{"verse": 1, "start": 300, "end": 5991, "text": "Aleluya. ALABAD el nombre de Jehová; alabadle, siervos de Jehová;", "words": [[0, 709], [9, 1575], [16, 1775], [19, 1975], [26, 2335], [29, 2515], [37, 3704], [47, 4094], [55, 5034], [58, 5314]]}, {"verse": 2, "start": 6441, "end": 11491, "text": "Los que estáis en la casa de Jehová, en los atrios de la casa de nuestro Dios.", "words": [[0, 6441], [4, 6549], [8, 6689], [15, 7069], [18, 7209], [21, 7329], [26, 7589], [29, 7809], [37, 8589], [40, 8809], [44, 8949], [51, 9589], [54, 9929], [57, 10049], [62, 10329], [65, 10549], [73, 10729]]}, {"verse": 3, "start": 11941, "end": 18978, "text": "Alabad a JAH, porque es bueno Jehová: cantad salmos a su nombre, porque es agradable.", "words": [[0, 12244], [7, 12589], [9, 12934], [14, 13279], [21, 13499], [24, 13779], [30, 14310], [38, 15120], [45, 15725], [52, 16325], [54, 16465], [57, 16625], [65, 17045], [72, 17485], [75, 17885]]}, {"verse": 4, "start": 19428, "end": 24890, "text": "Porque JAH ha escogido a Jacob para sí, a Israel por posesión suya.", "words": [[0, 19428], [7, 19902], [11, 20412], [14, 20632], [23, 21272], [25, 21412], [31, 21712], [36, 22212], [40, 22532], [42, 22912], [49, 23372], [53, 23632], [62, 24292]]}, {"verse": 5, "start": 25340, "end": 31114, "text": "Porque yo sé que Jehová es grande, y el Señor nuestro, mayor que todos los dioses.", "words": [[0, 25340], [7, 25564], [10, 25804], [13, 26004], [17, 26164], [24, 26604], [27, 26704], [35, 27184], [37, 27884], [40, 28024], [46, 28384], [55, 28944], [61, 29444], [65, 29704], [71, 30024], [75, 30304]]}, {"verse": 6, "start": 31564, "end": 38030, "text": "Todo lo que quiso Jehová, ha hecho en los cielos y en la tierra, en las mares y en todos los abismos.", "words": [[0, 31564], [5, 31727], [8, 32007], [12, 32147], [18, 32467], [26, 33007], [29, 33127], [35, 33367], [