{"book": "ACT", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 240469, "verses": [{"verse": 1, "start": 300, "end": 9563, "text": "Y oyeron los apóstoles y los hermanos que estaban en Judea, que también los Gentiles habían recibido la palabra de Dios.", "words": [[0, 300], [2, 466], [9, 865], [13, 1046], [23, 1806], [25, 2046], [29, 2206], [38, 2866], [42, 2966], [50, 3286], [53, 3506], [60, 4586], [64, 4845], [72, 5285], [76, 5785], [85, 6645], [92, 7305], [101, 8226], [104, 8366], [112, 8766], [115, 9006]]}, {"verse": 2, "start": 9913, "end": 15994, "text": "Y como Pedro subió a Jerusalén, contendían contra él los que eran de la circuncisión,", "words": [[0, 9913], [2, 10030], [7, 10270], [13, 10670], [19, 11250], [21, 11450], [32, 12570], [43, 13310], [50, 13730], [53, 14030], [57, 14210], [61, 14410], [66, 14590], [69, 14750], [72, 14870]]}, {"verse": 3, "start": 16344, "end": 21358, "text": "Diciendo: ¿Por qué has entrado en casa de hombres incircuncisos, y has comido con ellos?", "words": [[0, 16344], [10, 17319], [15, 17439], [19, 17539], [23, 17659], [31, 18039], [34, 18119], [39, 18299], [42, 18499], [50, 19149], [65, 19799], [67, 20139], [71, 20299], [78, 20639], [82, 20859]]}, {"verse": 4, "start": 21638, "end": 26715, "text": "Entonces comenzando Pedro, les declaró por orden lo pasado, diciendo:", "words": [[0, 21638], [9, 22315], [20, 22955], [27, 23275], [31, 23515], [39, 24035], [43, 24215], [49, 24475], [52, 24775], [60, 25895]]}, {"verse": 5, "start": 26915, "end": 37969, "text": "Estaba yo en la ciudad de Jope orando, y vi en éxtasis una visión: un objeto semejante a una gran tela, que descendía, que por sus cuatro extremos era bajado del cielo, y venía hasta mí.", "words": [[0, 26915], [7, 27301], [10, 27461], [13, 27561], [16, 27661], [23, 27961], [26, 28294], [31, 28628], [39, 28961], [41, 29166], [44, 29326], [47, 29466], [55, 29946], [59, 30146], [67, 30970], [70, 31106], [77, 31486], [87, 32226], [89, 32366], [93, 32506], [98, 32746], [104, 33146], [108, 33386], [119, 34046], [123, 34211], [127, 34391], [131, 34551], [138, 34851], [147, 35551], [151, 35751], [158, 36191], [162, 36331], [169, 36751], [171, 37051], [177, 37431], [183, 37651]]}, {"verse": 6, "start": 38319, "end": 45953, "text": "En el cual como puse los ojos, consideré y vi animales terrestres de cuatro pies, y fieras, y reptiles, y aves del cielo.", "words": [[0, 38319], [3, 38440], [6, 38520], [11, 38760], [16, 39020], [21, 39380], [25, 39520], [31, 39920], [41, 40640], [43, 40800], [46, 40940], [55, 41300], [66, 42120], [69, 42220], [76, 42460], [82, 42820], [84, 43115], [92, 43675], [94, 43975], [104, 44555], [106, 45055], [111, 45315], [115, 45475]]}, {"verse": 7, "start": 46303, "end": 50820, "text": "Y oí una voz que me decía: Levántate, Pedro, mata y come.", "words": [[0, 46303], [2, 46490], [5, 46670], [9, 46870], [13, 47110], [17, 47270], [20, 47390], [27, 48190], [38, 48988], [45, 49508], [50, 49748], [52, 50068]]}, {"verse": 8, "start": 51100, "end": 56739, "text": "Y dije: Señor, no; porque ninguna cosa común o inmunda entró jamás en mi boca.", "words": [[0, 51100], [2, 51266], [8, 51958], [15, 52273], [19, 52965], [26, 53166], [34, 53486], [39, 53946], [45, 54366], [47, 54606], [55, 55126], [61, 55686], [67, 56006], [70, 56146], [73, 56246]]}, {"verse": 9, "start": 57089, "end": 63435, "text": "Entonces la voz me respondió del cielo segunda vez: Lo que Dios limpió, no lo llames tú común.", "words": [[0, 57089], [9, 57491], [12, 57771], [16, 57971], [19, 58151], [29, 58671], [33, 58811], [39, 59091], [47, 59431], [52, 60207], [55, 60322], [59, 60462], [64, 60742], [72, 61722], [75, 61902], [78, 62042], [85, 62482], [88, 62582]]}, {"verse": 10, "start": 63655, "end": 68298, "text": "Y esto fue hecho por tres veces: y volvió todo a ser tomado arriba en el cielo.", "words": [[0, 63655], [2, 63793], [7, 64033], [11, 64273], [17, 64493], [21, 64733], [26, 64953], [33, 65842], [35, 65945], [42, 66285], [47, 66485], [49, 66685], [53, 66805], [60, 67225], [67, 67445], [70, 67685], [73, 67785]]}, {"verse": 11, "start": 68648, "end": 74420, "text": "Y he aquí, de inmediato llegaron tres hombres a la casa donde yo estaba, enviados a mí de Cesarea.", "words": [[0, 68648], [2, 68794], [5, 68934], [11, 69134], [14, 69294], [24, 69834], [33, 70274], [38, 70554], [46, 70934], [48, 71154], [51, 71235], [56, 71514], [62, 71774], [65, 72054], [73, 72815], [82, 73315], [84, 73494], [87, 73654], [90, 73774]]}, {"verse": 12, "start": 74770, "end": 82215, "text": "Y el Espíritu me dijo que fuese con ellos sin dudar. Y vinieron también conmigo estos seis hermanos, y entramos en casa de un varón,", "words": [[0, 74770], [2, 74868], [5, 74948], [14, 75468], [17, 75568], [22, 75788], [26, 75968], [32, 76288], [36, 76508], [42, 76708], [46, 76968], [53, 77701], [55, 77820], [64, 78220], [72, 78580], [80, 79100], [86, 79320], [91, 79600], [101, 80440], [103, 80600], [112, 81020], [115, 81200], [120, 81380], [123, 81620], [126, 81720]]}, {"verse": 13, "start": 82565, "end": 91110, "text": "El cual nos contó cómo había visto un ángel en su casa, que se paró, y le dijo: Envía a Jope, y haz venir a un Simón que tiene por sobrenombre Pedro;", "words": [[0, 82565], [3, 82691], [8, 82891], [12, 83091], [18, 83531], [23, 83691], [29, 83891], [35, 84211], [38, 84391], [44, 84711], [47, 84811], [50, 84911], [56, 85531], [60, 85591], [63, 85751], [69, 86131], [71, 86431], [74, 86531], [80, 87199], [86, 87558], [88, 87848], [94, 88138], [96, 88345], [100, 88551], [106, 88758], [108, 88838], [111, 88878], [117, 89278], [121, 89418], [127, 89638], [131, 89898], [143, 90578]]}, {"verse": 14, "start": 91460, "end": 95816, "text": "El cual te hablará palabras por las cuales serás salvo tú, y toda tu casa.", "words": [[0, 91460], [3, 91616], [8, 91816], [11, 92036], [19, 92396], [28, 92716], [32, 93056], [36, 93236], [43, 93496], [49, 93896], [55, 94256], [59, 94436], [61, 94856], [66, 95076], [69, 95296]]}, {"verse": 15, "start": 96166, "end": 102633, "text": "Y como comencé a hablar, cayó el Espíritu Santo sobre ellos también, como sobre nosotros al principio.", "words": [[0, 96166], [2, 96284], [7, 96484], [15, 97044], [17, 97184], [25, 97964], [30, 98364], [33, 98444], [42, 98924], [48, 99164], [54, 99544], [60, 99764], [69, 100784], [74, 100924], [80, 101204], [89, 101564], [92, 101864]]}, {"verse": 16, "start": 102983, "end": 112388, "text": "Entonces me acordé del dicho del Señor, como dijo: Juan ciertamente bautizó en agua; pero vosotros seréis bautizados en Espíritu Santo.", "words": [[0, 102983], [9, 103304], [12, 103544], [19, 103964], [23, 104104], [29, 104304], [33, 104484], [40, 105044], [45, 105144], [51, 105950], [56, 106340], [68, 107580], [76, 108200], [79, 108340], [85, 109074], [90, 109218], [99, 109758], [106, 110258], [117, 111038], [120, 111238], [129, 111778]]}, {"verse": 17, "start": 112608, "end": 120656, "text": "Así que, si Dios les dio el mismo don también como a nosotros que hemos creído en el Señor Jesucristo, ¿quién era yo que pudiese estorbar a Dios?", "words": [[0, 112608], [4, 112767], [9, 112947], [12, 113087], [17, 113347], [21, 113547], [25, 113767], [28, 113887], [34, 114247], [38, 114467], [46, 114887], [51, 115207], [53, 115367], [62, 115727], [66, 116027], [72, 116187], [79, 116687], [82, 116807], [85, 116927], [91, 117167], [103, 118407], [110, 118607], [114, 118767], [117, 118947], [121, 119107], [129, 119567], [138, 120087], [140, 120187]]}, {"verse": 18, "start": 120936, "end": 131501, "text": "Entonces, oídas estas cosas, callaron, y glorificaron a Dios, diciendo: De manera que también a los Gentiles ha dado Dios arrepentimiento para vida.", "words": [[0, 120936], [10, 121804], [16, 122384], [22, 122584], [29, 123044], [39, 123849], [41, 124569], [54, 125289], [56, 125429], [62, 125669], [72, 127168], [75, 127266], [82, 127466], [86, 127726], [94, 127986], [96, 128206], [100, 128346], [109, 128926], [112, 129306], [117, 129526], [122, 129826], [138, 130826], [143, 131086]]}, {"verse": 19, "start": 131781, "end": 144981, "text": "Y los que habían sido esparcidos por causa de la tribulación que sobrevino en tiempo de Esteban, anduvieron hasta Fenicia, y Chipre, y Antioquía, no hablando a nadie la palabra, sino sólo a los judíos.", "words": [[0, 131781], [2, 131883], [6, 132003], [10, 132143], [17, 132343], [22, 132703], [33, 133303], [37, 133523], [43, 133843], [46, 134083], [49, 134203], [61, 134903], [65, 135063], [75, 135703], [78, 135863], [85, 136163], [88, 136383], [97, 137323], [108, 138043], [114, 138243], [123, 138943], [125, 139183], [133, 139763], [135, 139943], [146, 141023], [149, 141243], [158, 141703], [160, 141923], [166, 142183], [169, 142343], [178, 143247], [183, 143492], [188, 143872], [190, 144072], [194, 144172]]}, {"verse": 20, "start": 145331, "end": 155863, "text": "Y de ellos había unos varones Ciprios y Cirenenses, los cuales como entraron en Antioquía, hablaron a los griegos, anunciando el evangelio del Señor Jesús.", "words": [[0, 145331], [2, 145461], [5, 145601], [11, 145901], [17, 146281], [22, 146621], [30, 147081], [38, 147761], [40, 148461], [52, 149161], [56, 149221], [63, 149641], [68, 149841], [77, 150481], [80, 150721], [91, 151721], [100, 152301], [102, 152481], [106, 152601], [115, 153121], [126, 153921], [129, 154041], [139, 154681], [143, 154841], [149, 155101]]}, {"verse": 21, "start": 156213, "end": 162583, "text": "Y la mano del Señor era con ellos: y creyendo, gran número se convirtió al Señor.", "words": [[0, 156213], [2, 156322], [5, 156442], [10, 156682], [14, 156902], [20, 157302], [24, 157722], [28, 157981], [35, 158896], [37, 159023], [47, 160023], [52, 160303], [59, 160763], [62, 161103], [72, 161823], [75, 161983]]}, {"verse": 22, "start": 162933, "end": 172015, "text": "Y llegó la noticia de estas cosas a oídos de la iglesia que estaba en Jerusalén: y enviaron a Bernabé que fuese hasta Antioquía.", "words": [[0, 162933], [2, 163037], [8, 163297], [11, 163457], [19, 164037], [22, 164197], [28, 164357], [34, 164837], [36, 165232], [42, 165892], [45, 166072], [48, 166212], [56, 166712], [60, 166892], [67, 167192], [70, 167372], [81, 168439], [83, 168576], [92, 169156], [94, 169336], [102, 169836], [106, 169936], [112, 170416], [118, 170916]]}, {"verse": 23, "start": 172365, "end": 183796, "text": "El cual, cuando llegó, y vio la gracia de Dios, se regocijó; y exhortó a todos a que permaneciesen en el propósito del corazón en el Señor.", "words": [[0, 172365], [3, 172534], [9, 172754], [16, 173014], [23, 173874], [25, 174134], [29, 174354], [32, 174514], [39, 174974], [42, 175114], [48, 175906], [51, 176698], [61, 177662], [63, 177804], [71, 178704], [73, 178884], [79, 179284], [81, 179604], [85, 179704], [99, 180864], [102, 181064], [105, 181204], [115, 181944], [119, 182164], [127, 182684], [130, 183024], [133, 183164]]}, {"verse": 24, "start": 184146, "end": 190698, "text": "Porque era varón bueno, y lleno de Espíritu Santo y de fe: y muchas personas fueron agregadas al Señor.", "words": [[0, 184146], [7, 184390], [11, 184590], [17, 184910], [24, 185310], [26, 185555], [32, 185875], [35, 185995], [44, 186535], [50, 186915], [52, 187035], [55, 187135], [59, 187699], [61, 187899], [68, 188139], [77, 188659], [84, 188959], [94, 189779], [97, 190039]]}, {"verse": 25, "start": 191048, "end": 196651, "text": "Después fue Bernabé a Tarso a buscar a Saulo; y hallado, le trajo a Antioquía.", "words": [[0, 191048], [8, 191276], [12, 191556], [20, 192096], [22, 192236], [28, 192736], [30, 192856], [37, 193136], [39, 193356], [46, 194158], [48, 194306], [57, 194766], [60, 195166], [66, 195626], [68, 195726]]}, {"verse": 26, "start": 197001, "end": 207224, "text": "Y se reunieron allí con la iglesia durante todo un año, y enseñaron a mucha gente; y los discípulos fueron llamados Cristianos primeramente en Antioquía.", "words": [[0, 197001], [2, 197148], [5, 197288], [15, 198088], [20, 198348], [24, 198588], [27, 198748], [35, 199168], [43, 199388], [48, 199888], [51, 200168], [56, 200528], [58, 201048], [68, 201868], [70, 201968], [76, 202208], [83, 203188], [85, 203310], [89, 203450], [100, 204070], [107, 204430], [116, 204970], [127, 205510], [140, 206330], [143, 206430]]}, {"verse": 27, "start": 207574, "end": 211821, "text": "Y en aquellos días descendieron de Jerusalén profetas a Antioquía.", "words": [[0, 207574], [2, 207682], [5, 207895], [14, 208109], [19, 208322], [32, 208962], [35, 209142], [45, 209822], [54, 210622], [56, 210842]]}, {"verse": 28, "start": 212171, "end": 224755, "text": "Y levantándose uno de ellos, llamado Agabo, daba a entender por Espíritu, que había de haber una grande hambre en toda la tierra habitada: la cual hubo en tiempo de Claudio.", "words": [[0, 212171], [2, 212295], [15, 213155], [19, 213395], [22, 213595], [29, 214415], [37, 214715], [44, 215935], [49, 216355], [51, 216555], [60, 217055], [64, 217455], [74, 218595], [78, 218775], [84, 219015], [87, 219235], [93, 219375], [97, 219615], [104, 219995], [111, 220455], [114, 220675], [119, 220895], [122, 221095], [129, 221375], [139, 222590], [142, 222717], [147, 222917], [152, 223377], [155, 223477], [162, 223797], [165, 224283]]}, {"verse": 29, "start": 225105, "end": 233646, "text": "Entonces los discípulos, cada uno conforme a lo que tenía, determinaron enviar ayuda a los hermanos que habitaban en Judea:", "words": [[0, 225105], [9, 225811], [13, 225933], [25, 226553], [30, 226813], [34, 227193], [43, 227953], [45, 228033], [48, 228113], [52, 228233], [59, 228653], [72, 229953], [79, 230713], [85, 231233], [87, 231653], [91, 231753], [100, 232293], [104, 232413], [114, 232893], [117, 233073]]}, {"verse": 30, "start": 233996, "end": 240069, "text": "Lo cual asimismo hicieron, enviándolo a los ancianos por mano de Bernabé y de Saulo.", "words": [[0, 233996], [3, 234122], [8, 234572], [17, 235022], [27, 235702], [38, 236862], [40, 237082], [44, 237242], [53, 237862], [57, 238082], [62, 238382], [65, 238562], [73, 239122], [75, 239302], [78, 239462]]}]}