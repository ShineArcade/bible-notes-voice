{"book": "PSA", "chapter": 21, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 88720, "verses": [{"verse": 1, "start": 300, "end": 9058, "text": "Al Músico principal: Salmo de David. SE ALEGRARÁ el rey en tu fortaleza, oh Jehová; y en tu salvación se gozará mucho.", "words": [[0, 300], [3, 502], [10, 982], [21, 2167], [27, 2665], [30, 2825], [37, 3745], [40, 3835], [49, 4415], [52, 4615], [56, 4915], [59, 5015], [62, 5155], [73, 5653], [76, 6150], [84, 6909], [86, 7017], [89, 7117], [92, 7237], [102, 7857], [105, 8057], [112, 8437]]}, {"verse": 2, "start": 9508, "end": 16333, "text": "El deseo de su corazón le diste, y no le negaste lo que sus labios pronunciaron. (Selah.)", "words": [[0, 9508], [3, 9694], [9, 10254], [12, 10354], [15, 10534], [23, 11114], [26, 11334], [33, 11954], [35, 12374], [38, 12574], [41, 12754], [49, 13254], [52, 13434], [56, 13574], [60, 13774], [67, 14254], [81, 16012]]}, {"verse": 3, "start": 16783, "end": 24113, "text": "Pues le has salido al encuentro con bendiciones de bien: corona de oro fino has puesto sobre su cabeza.", "words": [[0, 16783], [5, 16928], [8, 17208], [12, 17488], [19, 17908], [22, 18028], [32, 18668], [36, 18828], [48, 19508], [51, 19768], [57, 20570], [64, 20916], [67, 21176], [71, 21376], [76, 21756], [80, 22336], [87, 22636], [93, 23096], [96, 23316]]}, {"verse": 4, "start": 24563, "end": 28928, "text": "Vida te pidió, y le diste largura de días por siglos y siglos.", "words": [[0, 24563], [5, 24854], [8, 25094], [15, 25574], [17, 25774], [20, 25854], [26, 26314], [34, 26814], [37, 26974], [42, 27234], [46, 27474], [53, 28094], [55, 28214]]}, {"verse": 5, "start": 29378, "end": 35043, "text": "Grande es su gloria en tu salvación: honra y majestad has puesto sobre él.", "words": [[0, 29378], [7, 29886], [10, 30206], [13, 30386], [20, 30846], [23, 30986], [26, 31126], [37, 32286], [43, 32819], [45, 33039], [54, 33739], [58, 33939], [65, 34259], [71, 34679]]}, {"verse": 6, "start": 35493, "end": 40591, "text": "Porque lo has bendecido para siempre; lo llenaste de alegría con tu rostro.", "words": [[0, 35493], [7, 35806], [10, 36026], [14, 36146], [24, 36766], [29, 36986], [38, 38048], [41, 38197], [50, 38657], [53, 38857], [61, 39377], [65, 39617], [68, 39797]]}, {"verse": 7, "start": 41041, "end": 47372, "text": "Por cuanto el rey confía en Jehová, y en la misericordia del Altísimo, no será conmovido.", "words": [[0, 41041], [4, 41183], [11, 41503], [14, 41703], [18, 42043], [25, 42543], [28, 42643], [36, 43163], [38, 43343], [41, 43463], [44, 43583], [57, 44383], [61, 44523], [71, 45783], [74, 46023], [79, 46303]]}, {"verse": 8, "start": 47822, "end": 53889, "text": "Alcanzará tu mano a todos tus enemigos; tu diestra alcanzará a los que te aborrecen.", "words": [[0, 47822], [10, 48425], [13, 48605], [18, 48965], [20, 49225], [26, 49585], [30, 49865], [40, 51047], [43, 51148], [51, 51608], [61, 52508], [63, 52688], [67, 52808], [71, 52948], [74, 53068]]}, {"verse": 9, "start": 54339, "end": 62538, "text": "Los pondrás como horno de fuego en el tiempo de tu ira: Jehová los deshará en su furor, y fuego los consumirá.", "words": [[0, 54339], [4, 54448], [12, 54948], [17, 55188], [23, 55568], [26, 55688], [32, 56028], [35, 56248], [38, 56388], [45, 56728], [48, 56948], [51, 57148], [56, 57982], [63, 58524], [67, 58894], [75, 59264], [78, 59444], [81, 59644], [88, 60264], [90, 60524], [96, 61004], [100, 61584]]}, {"verse": 10, "start": 62988, "end": 69176, "text": "Su fruto destruirás de la tierra, y su descendencia de entre los hijos de los hombres.", "words": [[0, 62988], [3, 63189], [9, 64039], [20, 64889], [23, 65009], [26, 65149], [34, 65569], [36, 66229], [39, 66389], [52, 67469], [55, 67629], [61, 67789], [65, 67889], [71, 68149], [74, 68349], [78, 68489]]}, {"verse": 11, "start": 69626, "end": 75463, "text": "Porque trazaron el mal contra ti: tramaron maquinaciones, mas no prevalecerán.", "words": [[0, 69626], [7, 69829], [16, 70489], [1