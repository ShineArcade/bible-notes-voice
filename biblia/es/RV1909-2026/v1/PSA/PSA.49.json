{"book": "PSA", "chapter": 49, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 129531, "verses": [{"verse": 1, "start": 300, "end": 9299, "text": "Al Músico principal: Salmo para los hijos de Coré. Oíd esto, pueblos todos; escuchad, habitantes todos del mundo:", "words": [[0, 300], [3, 492], [10, 972], [21, 1996], [27, 2558], [32, 3038], [36, 3238], [42, 3558], [45, 3908], [51, 4425], [55, 4787], [61, 5177], [69, 5757], [76, 6602], [86, 7284], [97, 8084], [103, 8424], [107, 8724]]}, {"verse": 2, "start": 9649, "end": 14142, "text": "Así los plebeyos como los nobles, el rico y el pobre juntamente.", "words": [[0, 9649], [4, 9821], [8, 10241], [17, 10661], [22, 10901], [26, 11081], [34, 11941], [37, 12041], [42, 12421], [44, 12721], [47, 12861], [53, 13141]]}, {"verse": 3, "start": 14492, "end": 19805, "text": "Mi boca hablará sabiduría; y el pensamiento de mi corazón inteligencia.", "words": [[0, 14492], [3, 14597], [8, 14877], [16, 15537], [27, 16681], [29, 16786], [32, 16906], [44, 17726], [47, 17926], [50, 18066], [58, 18466]]}, {"verse": 4, "start": 20155, "end": 25314, "text": "Inclinaré mi oído a proverbios: declararé con el arpa mi enigma.", "words": [[0, 20155], [10, 20939], [13, 21179], [18, 21539], [20, 21699], [32, 22939], [42, 23704], [46, 23924], [49, 24104], [54, 24464], [57, 24684]]}, {"verse": 5, "start": 25664, "end": 31083, "text": "¿Por qué he de temer en los días de adversidad, cuando la iniquidad de mis opresores me rodee?", "words": [[0, 25664], [5, 25791], [9, 25991], [12, 26191], [15, 26391], [21, 26591], [24, 26791], [28, 26891], [33, 27111], [36, 27311], [48, 27991], [55, 28246], [58, 28506], [68, 29266], [71, 29446], [75, 29586], [85, 30226], [88, 30446]]}, {"verse": 6, "start": 31433, "end": 36082, "text": "Los que confían en sus bienes, y en la muchedumbre de sus riquezas se jactan,", "words": [[0, 31433], [4, 31714], [8, 32044], [16, 32374], [19, 32454], [23, 32614], [31, 33294], [33, 33434], [36, 33534], [39, 33634], [51, 34294], [54, 34434], [58, 34614], [67, 35234], [70, 35686]]}, {"verse": 7, "start": 36432, "end": 42461, "text": "Ninguno de ellos podrá en manera alguna redimir al hermano, ni dar a Dios su rescate.", "words": [[0, 36432], [8, 37061], [11, 37181], [17, 37481], [23, 38021], [26, 38081], [33, 38401], [40, 39071], [48, 39741], [51, 39841], [60, 40274], [63, 40708], [67, 41141], [69, 41241], [74, 41441], [77, 41701]]}, {"verse": 8, "start": 42811, "end": 46851, "text": "(Porque la redención de su vida es de gran precio, y no se hará jamás;)", "words": [[0, 42811], [8, 42971], [11, 43191], [21, 43851], [24, 44051], [27, 44211], [32, 44491], [35, 44591], [38, 44711], [43, 44911], [51, 45471], [53, 45711], [56, 45871], [59, 46031], [64, 46271]]}, {"verse": 9, "start": 47201, "end": 50835, "text": "Que viva adelante para siempre, y nunca vea la sepultura.", "words": [[0, 47201], [4, 47285], [9, 47605], [18, 48165], [23, 48485], [32, 48965], [34, 49230], [40, 49410], [44, 49910], [47, 50409]]}, {"verse": 10, "start": 51185, "end": 59362, "text": "Pues se ve que mueren los sabios, así como el insensato y el necio perecen, y dejan a otros sus riquezas.", "words": [[0, 51185], [5, 51326], [8, 51466], [11, 51566], [15, 51806], [22, 52046], [26, 52166], [34, 52846], [38, 53286], [43, 53566], [46, 53706], [56, 54706], [58, 54886], [61, 55006], [67, 55446], [76, 56126], [78, 56806], [84, 57266], [86, 57546], [92, 57906], [96, 58486]]}, {"verse": 11, "start": 59712, "end": 68950, "text": "En su interior tienen que sus casas serán eternas, y sus habitaciones para generación y generación: llamaron sus tierras de sus nombres.", "words": [[0, 59712], [3, 59857], [6, 60017], [15, 60517], [22, 60877], [26, 61137], [30, 61317], [36, 61837], [42, 62137], [51, 62997], [53, 63437], [57, 63597], [70, 64317], [75, 64597], [86, 65397], [88, 65537], [100, 66697], [109, 67037], [113, 67277], [121, 67857], [124, 68017], [128, 68157]]}, {"verse": 12, "start": 69300, "end": 75235, "text": "Mas el hombre no permanecerá en honra: es semejante a las bestias que perecen.", "words": [[0, 69300], [4, 69956], [7, 70036], [14, 70276], [17, 70716], [29, 71696], [32, 72130], [39, 72728], [42, 73009], [52, 73649], [54, 73769], [58, 74069], [66, 74369], [70, 74509]]}, {"verse": 13, "start": 75585, "end": 83178, "text": "Este su camino es su locura: con todo, corren sus descendientes por el dicho de ellos. (Selah.)", "words": [[0, 75585], [5, 75872], [8, 76072], [15, 76452], [18, 76872], [21, 77072], [29, 78789], [33, 78931], [39, 79401], [46, 79871], [50, 80051], [64, 81011], [68, 81231], [71, 81391], [77, 81651], [80, 81851], [87, 82941]]}, {"verse": 14, "start": 83528, "end": 96385, "text": "Como rebaños serán puestos en la sepultura; la muerte se cebará en ellos; y por la mañana los justos prevalecerán sobre ellos: y se consumirá su hermosura en el sepulcro de su morada.", "words": [[0, 83528], [5, 84052], [13, 84612], [19, 85012], [27, 85532], [30, 85672], [33, 85812], [44, 86910], [47, 87059], [54, 87379], [57, 87819], [64, 88259], [67, 88419], [74, 89267], [76, 89355], [80, 89535], [83, 89675], [90, 89995], [94, 90255], [101, 90755], [114, 91555], [120, 91855], [127, 92721], [129, 92843], [132, 92943], [142, 93643], [145, 93803], [155, 94443], [158, 94583], [161, 94723], [170, 95383], [173, 95543], [176, 95663]]}, {"verse": 15, "start": 96735, "end": 101847, "text": "Pero Dios redimirá mi vida del poder de la sepultura, cuando me tome. (Selah.)", "words": [[0, 96735], [5, 96921], [10, 97534], [19, 98146], [22, 98306], [27, 98606], [31, 98846], [37, 99186], [40, 99386], [43, 99506], [54, 100126], [61, 100386], [64, 100646], [70, 101610]]}, {"verse": 16, "start": 102197, "end": 106033, "text": "No temas cuando se enriquece alguno, cuando aumenta la gloria de su casa;", "words": [[0, 102197], [3, 102327], [9, 102667], [16, 102827], [19, 103127], [29, 103587], [37, 104027], [44, 104187], [52, 104767], [55, 104867], [62, 105207], [65, 105347], [68, 105467]]}, {"verse": 17, "start": 106383, "end": 110923, "text": "Porque al morir no llevará nada, ni descenderá tras él su gloria.", "words": [[0, 106383], [7, 106610], [10, 106770], [16, 107190], [19, 107410], [27, 107870], [33, 108670], [36, 108870], [47, 109610], [52, 109770], [55, 110050], [58, 110496]]}, {"verse": 18, "start": 111273, "end": 117771, "text": "Si bien mientras viva, dirá dichosa a su alma: y tú serás alabado cuando bien te trates.", "words": [[0, 111273], [3, 111439], [8, 111779], [17, 112439], [23, 113019], [28, 113519], [36, 114059], [38, 114259], [41, 114359], [47, 115212], [49, 115339], [52, 115459], [58, 115879], [66, 116379], [73, 116579], [78, 116879], [81, 117059]]}, {"verse": 19, "start": 118121, "end": 123380, "text": "Entrará a la generación de sus padres: no verán luz para siempre.", "words": [[0, 118121], [8, 118843], [10, 119083], [13, 119183], [24, 119903], [27, 120063], [31, 120203], [39, 121299], [42, 121445], [48, 121805], [52, 122045], [57, 122425]]}, {"verse": 20, "start": 123730, "end": 129131, "text": "El hombre en honra que no entiende, semejante es a las bestias que perecen.", "words": [[0, 123730], [3, 123895], [10, 124215], [13, 124635], [19, 125195], [23, 125495], [26, 125695], [36, 126535], [46, 127255], [49, 127495], [51, 127595], [55, 127735], [63, 128175], [67, 128335]]}]}