{"book": "MAT", "chapter": 24, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 329528, "verses": [{"verse": 1, "start": 300, "end": 7603, "text": "And Jesus went out, and departed from the temple: and his disciples came to him to show him the buildings of the temple.", "words": [[0, 300], [4, 469], [10, 769], [15, 1149], [20, 1429], [24, 2129], [33, 2569], [38, 2889], [42, 3049], [50, 3854], [54, 3999], [58, 4139], [68, 4699], [73, 5079], [76, 5319], [80, 5519], [83, 5719], [88, 5959], [92, 6199], [96, 6339], [106, 6699], [109, 6979], [113, 7099]]}, {"verse": 2, "start": 8053, "end": 17935, "text": "And Jesus said to them, Do you not see all these things? indeed I say to you, There shall not be left here one stone upon another, that shall not be thrown down.", "words": [[0, 8053], [4, 8198], [10, 8498], [15, 8858], [18, 9058], [24, 9741], [27, 9838], [31, 9958], [35, 10118], [39, 10458], [43, 10718], [49, 10898], [57, 11904], [64, 12408], [66, 12468], [70, 12668], [73, 12868], [78, 13448], [84, 13608], [90, 13808], [94, 13988], [97, 14148], [102, 14388], [107, 14628], [111, 14908], [117, 15288], [122, 15588], [131, 16448], [136, 16648], [142, 16828], [146, 17028], [149, 17188], [156, 17388]]}, {"verse": 3, "start": 18285, "end": 29424, "text": "¶ And as he sat upon the mount of Olives, the disciples came to him privately, saying, Tell us, when shall these things be? and what shall be the sign of your coming, and of the end of the world?", "words": [[2, 18285], [6, 18431], [9, 18651], [12, 18791], [16, 19111], [21, 19391], [25, 19591], [31, 19811], [34, 20011], [42, 21031], [46, 21071], [56, 21531], [61, 21911], [64, 22151], [68, 22311], [79, 23231], [87, 24067], [92, 24202], [96, 24402], [101, 24682], [107, 25022], [113, 25262], [120, 25542], [124, 26327], [128, 26437], [133, 26577], [139, 26717], [142, 26877], [146, 26997], [151, 27297], [154, 27437], [159, 27537], [167, 27837], [171, 28217], [174, 28317], [178, 28437], [182, 28697], [185, 28817], [189, 28937]]}, {"verse": 4, "start": 29774, "end": 35622, "text": "And Jesus answered and said to them, Take heed that no man deceive you.", "words": [[0, 29774], [4, 29915], [10, 30255], [19, 30835], [23, 31035], [28, 31255], [31, 31415], [37, 33516], [42, 33675], [47, 34055], [52, 34335], [55, 34575], [59, 34835], [67, 35195]]}, {"verse": 5, "start": 36072, "end": 40892, "text": "For many shall come in my name, saying, I am Christ; and shall deceive many.", "words": [[0, 36072], [4, 36181], [9, 36421], [15, 36661], [20, 36901], [23, 37001], [26, 37201], [32, 37601], [40, 38201], [42, 38521], [45, 38641], [53, 39631], [57, 39754], [63, 39954], [71, 40354]]}, {"verse": 6, "start": 41342, "end": 49562, "text": "And you shall hear of wars and rumours of wars: see that you be not troubled: for all these things must come to pass, but the end is not yet.", "words": [[0, 41342], [4, 41448], [8, 41568], [14, 41748], [19, 41988], [22, 42128], [27, 42468], [31, 42758], [39, 43048], [42, 43268], [48, 44167], [52, 44370], [57, 44550], [61, 44710], [64, 44830], [68, 45010], [78, 45925], [82, 46025], [86, 46225], [92, 46405], [99, 46745], [104, 47005], [109, 47245], [112, 47385], [118, 47985], [122, 48265], [126, 48425], [130, 48685], [133, 48885], [137, 49085]]}, {"verse": 7, "start": 50012, "end": 59064, "text": "For nation shall rise against nation, and kingdom against kingdom: and there shall be famines, and pestilences, and earthquakes, in various places.", "words": [[0, 50012], [4, 50232], [11, 50532], [17, 50892], [22, 51232], [30, 51492], [38, 51992], [42, 52392], [50, 52792], [58, 53192], [67, 54184], [71, 54326], [77, 54486], [83, 54666], [86, 54846], [95, 55506], [99, 55826], [112, 56546], [116, 56926], [129, 57366], [132, 57866], [140, 58246]]}, {"verse": 8, "start": 59514, "end": 61551, "text": "All these are the beginning of sorrows.", "words": [[0, 59514], [4, 59734], [10, 59994], [14, 60294], [18, 60394], [28, 60674], [31, 60854]]}, {"verse": 9, "start": 62001, "end": 68332, "text": "Then shall they deliver you up to be afflicted, and shall kill you: and you shall be hated of all nations for my name’s sake.", "words": [[0, 62001], [5, 62139], [11, 62359], [16, 62519], [24, 62859], [28, 63079], [31, 63259], [34, 63399], [37, 63539], [48, 64099], [52, 64339], [58, 64539], [63, 64799], [68, 65470], [72, 65612], [76, 65752], [82, 65952], [85, 66112], [91, 66392], [94, 66612], [98, 66752], [106, 67172], [110, 67432], [113, 67612], [120, 67972]]}, {"verse": 10, "start": 68782, "end": 73174, "text": "And then shall many be offended, and shall betray one another, and shall hate one another.", "words": [[0, 68782], [4, 68921], [9, 69041], [15, 69261], [20, 69501], [23, 69721], [33, 70461], [37, 70601], [43, 70801], [50, 71161], [54, 71401], [63, 72021], [67, 72061], [73, 72261], [78, 72481], [82, 72681]]}, {"verse": 11, "start": 73624, "end": 77009, "text": "And many false prophets shall rise, and shall deceive many.", "words": [[0, 73624], [4, 73762], [9, 74002], [15, 74282], [24, 74802], [30, 75042], [36, 75462], [40, 75942], [46, 76162], [54, 76462]]}, {"verse": 12, "start": 77459, "end": 81323, "text": "And because iniquity shall abound, the love of many shall grow cold.", "words": [[0, 77459], [4, 77564], [12, 77804], [21, 78324], [27, 78564], [35, 79424], [39, 79544], [44, 79824], [47, 79944], [52, 80204], [58, 80504], [63, 80744]]}, {"verse": 13, "start": 81773, "end": 85852, "text": "But he that shall endure to the end, the same shall be saved.", "words": [[0, 81773], [4, 81895], [7, 82195], [12, 82475], [18, 82735], [25, 83135], [28, 83375], [32, 83515], [37, 84175], [41, 84415], [46, 84755], [52, 85055], [55, 85195]]}, {"verse": 14, "start": 86303, "end": 93040, "text": "And this gospel of the kingdom shall be preached in all the world for a witness to all nations; and then shall the end come.", "words": [[0, 86303], [4, 86420], [9, 86600], [16, 87040], [19, 87220], [23, 87340], [31, 87640], [37, 87960], [40, 88120], [49, 88460], [52, 88680], [56, 88940], [60, 89100], [66, 89460], [70, 89700], [72, 89800], [80, 90060], [83, 90380], [87, 90620], [96, 91666], [100, 91802], [105, 92002], [111, 92242], [115, 92402], [119, 92582]]}, {"verse": 15, "start": 93490, "end": 102235, "text": "When you therefore shall see the abomination of desolation, spoken of by Daniel the prophet, stand in the holy place, (whoever reads, let him understand:)", "words": [[0, 93490], [5, 93595], [9, 93735], [19, 94155], [25, 94455], [29, 94655], [33, 94815], [45, 95355], [48, 95675], [60, 96695], [67, 97015], [70, 97235], [73, 97455], [80, 97835], [84, 98015], [93, 98715], [99, 99035], [102, 99275], [106, 99355], [111, 99555], [118, 100195], [127, 100395], [134, 101155], [138, 101355], [142, 101515]]}, {"verse": 16, "start": 102685, "end": 105757, "text": "Then let them which be in Judaea flee into the mountains:", "words": [[0, 102685], [5, 102884], [9, 103124], [14, 103364], [20, 103584], [23, 103804], [26, 104094], [33, 104384], [38, 104684], [43, 104964], [47, 105124]]}, {"verse": 17, "start": 106207, "end": 110554, "text": "Let him which is on the housetop not come down to take any thing out of his house:", "words": [[0, 106207], [4, 106385], [8, 106825], [14, 106945], [17, 107085], [20, 107225], [24, 107345], [33, 108085], [37, 108225], [42, 108485], [47, 108745], [50, 108905], [55, 109125], [59, 109345], [65, 109565], [69, 109825], [72, 109925], [76, 110025]]}, {"verse": 18, "start": 111004, "end": 114770, "text": "Neither let him which is in the field return back to take his clothes.", "words": [[0, 111004], [8, 111251], [12, 111551], [16, 111731], [22, 112011], [25, 112171], [28, 112311], [32, 112411], [38, 112751], [45, 113171], [50, 113531], [53, 113731], [58, 113931], [62, 114071]]}, {"verse": 19, "start": 115220, "end": 119571, "text": "And woe to them that are with child, and to them that give suck in those days!", "words": [[0, 115220], [4, 115345], [8, 115685], [11, 115765], [16, 115985], [21, 116185], [25, 116305], [30, 116445], [37, 117285], [41, 117565], [44, 117705], [49, 117905], [54, 118105], [59, 118305], [64, 118565], [67, 118785], [73, 118985]]}, {"verse": 20, "start": 120021, "end": 124317, "text": "But pray that your flight be not in the winter, neither on the sabbath day:", "words": [[0, 120021], [4, 120160], [9, 120560], [14, 120820], [19, 120980], [26, 121300], [29, 121500], [33, 121700], [36, 121920], [40, 122020], [48, 122680], [56, 123040], [59, 123360], [63, 123500], [71, 123820]]}, {"verse": 21, "start": 124767, "end": 130994, "text": "For then shall be great tribulation, such as was not since the beginning of the world to this time, no, nor ever shall be.", "words": [[0, 124767], [4, 124881], [9, 125101], [15, 125321], [18, 125461], [24, 125741], [37, 126721], [42, 126961], [45, 127101], [49, 127241], [53, 127441], [59, 127681], [63, 127901], [73, 128161], [76, 128361], [80, 128441], [86, 128701], [89, 128861], [94, 129041], [100, 129561], [104, 130041], [108, 130141], [113, 130381], [119, 130661]]}, {"verse": 22, "start": 131444, "end": 138413, "text": "And except those days should be shortened, there should no flesh be saved: but for the elect’s sake those days shall be shortened.", "words": [[0, 131444], [4, 131634], [11, 131864], [17, 132144], [22, 132464], [29, 132724], [32, 132884], [43, 133804], [49, 134044], [56, 134204], [59, 134424], [65, 134724], [68, 134964], [75, 135876], [79, 135972], [83, 136132], [87, 136272], [95, 136732], [100, 136872], [106, 137112], [111, 137372], [117, 137652], [120, 137792]]}, {"verse": 23, "start": 138863, "end": 143807, "text": "Then if any man shall say to you, Lo, here is Christ, or there; believe it not.", "words": [[0, 138902], [5, 138982], [8, 139102], [12, 139322], [16, 139542], [22, 139782], [26, 140002], [29, 140162], [34, 140794], [38, 140959], [43, 141279], [46, 141519], [54, 141879], [57, 142179], [64, 143033], [72, 143259], [75, 143419]]}, {"verse": 24, "start": 144257, "end": 153236, "text": "For there shall arise false Christs, and false prophets, and shall show great signs and wonders; so that, if it were possible, they shall deceive the very elect.", "words": [[0, 144257], [4, 144344], [10, 144524], [16, 144744], [22, 145104], [28, 145444], [37, 146004], [41, 146224], [47, 146524], [57, 147344], [61, 147484], [67, 147684], [72, 147884], [78, 148184], [84, 148564], [88, 148804], [97, 149653], [100, 149795], [106, 150035], [109, 150395], [112, 150515], [117, 150595], [127, 151375], [132, 151595], [138, 151775], [146, 152135], [150, 152475], [155, 152675]]}, {"verse": 25, "start": 153686, "end": 155566, "text": "Behold, I have told you before.", "words": [[0, 153686], [8, 154293], [10, 154373], [15, 154513], [20, 154733], [24, 154913]]}, {"verse": 26, "start": 156016, "end": 164665, "text": "Therefore if they shall say to you, Behold, he is in the desert; go not forth: behold, he is in the secret chambers; believe it not.", "words": [[0, 156016], [10, 156538], [13, 156678], [18, 156778], [24, 156958], [28, 157218], [31, 157398], [36, 157858], [44, 158618], [47, 158738], [50, 158878], [53, 158998], [57, 159098], [65, 159918], [68, 160141], [72, 160341], [79, 161191], [87, 161988], [90, 162088], [93, 162228], [96, 162348], [100, 162428], [107, 162708], [117, 163757], [125, 164005], [128, 164185]]}, {"verse": 27, "start": 165115, "end": 171604, "text": "For as the lightning comes out of the east, and shines even to the west; so shall also the coming of the Son of man be.", "words": [[0, 165115], [4, 165233], [7, 165433], [11, 165593], [21, 165873], [27, 166233], [31, 166453], [34, 166573], [38, 166673], [44, 167033], [48, 167533], [55, 167833], [60, 168153], [63, 168333], [67, 168433], [73, 169244], [76, 169411], [82, 169591], [87, 169911], [91, 170091], [98, 170331], [101, 170531], [105, 170651], [109, 170851], [112, 170951], [116, 171171]]}, {"verse": 28, "start": 172054, "end": 175768, "text": "For wherever the carcass is, there will the eagles be gathered together.", "words": [[0, 172054], [4, 172221], [13, 172501], [17, 172721], [25, 173141], [29, 173641], [35, 173861], [40, 174081], [44, 174281], [51, 174621], [54, 174841], [63, 175161]]}, {"verse": 29, "start": 176218, "end": 186628, "text": "¶ Immediately after the tribulation of those days shall the sun be darkened, and the moon shall not give her light, and the stars shall fall from heaven, and the powers of the heavens shall be shaken:", "words": [[2, 176218], [14, 176625], [20, 177145], [24, 177285], [36, 177885], [39, 178045], [45, 178245], [50, 178585], [56, 178885], [60, 179045], [64, 179265], [67, 179425], [77, 180125], [81, 180405], [85, 180525], [90, 180745], [96, 180945], [100, 181145], [105, 181345], [109, 181525], [116, 182105], [120, 182365], [124, 182465], [130, 182785], [136, 183045], [141, 183285], [146, 183505], [154, 184251], [158, 184375], [162, 184495], [169, 184835], [172, 185075], [176, 185215], [184, 185515], [190, 185875], [193, 186035]]}, {"verse": 30, "start": 187078, "end": 199025, "text": "And then shall appear the sign of the Son of man in heaven: and then shall all the tribes of the earth mourn, and they shall see the Son of man coming in the clouds of heaven with power and great glory.", "words": [[0, 187078], [4, 187478], [9, 187718], [15, 187998], [22, 188298], [26, 188518], [31, 188878], [34, 189018], [38, 189158], [42, 189378], [45, 189498], [49, 189798], [52, 189978], [60, 190725], [64, 190882], [69, 191182], [75, 191742], [79, 192042], [83, 192202], [90, 192562], [93, 192782], [97, 192902], [103, 193082], [110, 194002], [114, 194282], [119, 194442], [125, 194642], [129, 194862], [133, 195022], [137, 195262], [140, 195402], [144, 195702], [151, 196042], [154, 196262], [158, 196382], [165, 196722], [168, 196902], [175, 197162], [180, 197362], [186, 197742], [190, 198162], [196, 198422]]}, {"verse": 31, "start": 199475, "end": 208094, "text": "And he shall send his angels with a great sound of a trumpet, and they shall gather together his elect from the four winds, from one end of heaven to the other.", "words": [[0, 199475], [4, 199612], [7, 199752], [13, 199952], [18, 200252], [22, 200432], [29, 200872], [34, 201092], [36, 201192], [42, 201472], [48, 201852], [51, 202012], [53, 202112], [62, 202932], [66, 203092], [71, 203232], [77, 203412], [84, 203732], [93, 204092], [97, 204412], [103, 204792], [108, 205032], [112, 205172], [117, 205432], [124, 206372], [129, 206494], [133, 206734], [137, 206934], [140, 207074], [147, 207314], [150, 207534], [154, 207734]]}, {"verse": 32, "start": 208544, "end": 215775, "text": "Now learn a parable of the fig tree; When his branch is yet tender, and puts forth leaves, you know that summer is near:", "words": [[0, 208544], [4, 208883], [10, 209263], [12, 209383], [20, 209883], [23, 210063], [27, 210183], [31, 210383], [37, 211105], [42, 211213], [46, 211393], [53, 211753], [56, 211993], [60, 212153], [68, 212513], [72, 213033], [77, 213253], [83, 213513], [91, 214393], [95, 214493], [100, 214693], [105, 214853], [112, 215133], [115, 215333]]}, {"verse": 33, "start": 216225, "end": 222245, "text": "So likewise you, when you shall see all these things, know that it is near, even at the doors.", "words": [[0, 216225], [3, 216425], [12, 217245], [17, 217385], [22, 217605], [26, 217745], [32, 217925], [36, 218185], [40, 218405], [46, 218605], [54, 219505], [59, 219805], [64, 220025], [67, 220145], [70, 220305], [76, 221065], [81, 221285], [84, 221485], [88, 221605]]}, {"verse": 34, "start": 222595, "end": 230167, "text": "Assuredly I say to you, This generation shall not pass, till all these things be fulfilled.", "words": [[0, 222595], [10, 223229], [12, 223409], [16, 223629], [19, 223829], [24, 226402], [29, 226576], [40, 227136], [46, 227436], [50, 227656], [56, 228136], [61, 228476], [65, 228796], [71, 228976], [78, 229296], [81, 229536]]}, {"verse": 35, "start": 230617, "end": 234160, "text": "Heaven and earth shall pass away, but my words shall not pass away.", "words": [[0, 230617], [7, 230843], [11, 231023], [17, 231263], [23, 231463], [28, 231723], [34, 232443], [38, 232523], [41, 232743], [47, 232963], [53, 233203], [57, 233383], [62, 233663]]}, {"verse": 36, "start": 234610, "end": 241317, "text": "¶ But of that day and hour knows no man, no, not the angels of heaven, but my Father only.", "words": [[2, 234610], [6, 234742], [9, 234842], [14, 235042], [18, 235402], [22, 235582], [27, 235922], [33, 236342], [36, 236722], [41, 237582], [45, 238382], [49, 238602], [53, 238802], [60, 239262], [63, 239482], [71, 240082], [75, 240202], [78, 240402], [85, 240682]]}, {"verse": 37, "start": 241767, "end": 246721, "text": "But as the days of Noe were, so shall also the coming of the Son of man be.", "words": [[0, 241767], [4, 241891], [7, 242191], [11, 242371], [16, 242691], [19, 242881], [23, 243071], [29, 243731], [32, 244031], [38, 244291], [43, 244711], [47, 244931], [54, 245191], [57, 245451], [61, 245571], [65, 245851], [68, 245971], [72, 246231]]}, {"verse": 38, "start": 247171, "end": 255053, "text": "For as in the days that were before the flood they were eating and drinking, marrying and giving in marriage, until the day that Noe entered into the ark,", "words": [[0, 247171], [4, 247302], [7, 247602], [10, 247762], [14, 247842], [19, 248162], [24, 248362], [29, 248482], [36, 248782], [40, 248942], [46, 249362], [51, 249442], [56, 249562], [63, 249822], [67, 250002], [77, 250922], [86, 251262], [90, 251622], [97, 251862], [100, 252062], [110, 252702], [116, 253022], [120, 253222], [124, 253462], [129, 253662], [133, 253862], [141, 254222], [146, 254502], [150, 254642]]}, {"verse": 39, "start": 255503, "end": 261454, "text": "And knew not until the flood came, and took them all away; so shall also the coming of the Son of man be.", "words": [[0, 255503], [4, 255654], [9, 255814], [13, 256074], [19, 256374], [23, 256514], [29, 256754], [35, 257154], [39, 257674], [44, 257874], [49, 258074], [53, 258294], [59, 259101], [62, 259244], [68, 259424], [73, 259724], [77, 259924], [84, 260164], [87, 260344], [91, 260464], [95, 260644], [98, 260764], [102, 260984]]}, {"verse": 40, "start": 261904, "end": 266169, "text": "Then shall two be in the field; the one shall be taken, and the other left.", "words": [[0, 261904], [5, 262222], [11, 262462], [15, 262702], [18, 262922], [21, 263042], [25, 263122], [32, 263951], [36, 264035], [40, 264215], [46, 264375], [49, 264515], [56, 264855], [60, 265315], [64, 265455], [70, 265615]]}, {"verse": 41, "start": 266619, "end": 270769, "text": "Two women shall be grinding at the mill; the one shall be taken, and the other left.", "words": [[0, 266619], [4, 266743], [10, 267023], [16, 267243], [19, 267363], [28, 267703], [31, 267903], [35, 268003], [41, 268635], [45, 268699], [49, 268879], [55, 269059], [58, 269199], [65, 269539], [69, 269999], [73, 270139], [79, 270279]]}, {"verse": 42, "start": 271219, "end": 274989, "text": "¶ Watch therefore: for you know not what hour your Lord does come.", "words": [[2, 271219], [8, 271585], [19, 272465], [23, 272605], [27, 272765], [32, 272945], [36, 273185], [41, 273445], [46, 273745], [51, 273965], [56, 274225], [61, 274485]]}, {"verse": 43, "start": 275439, "end": 283186, "text": "But know this, that if the goodman of the house had known in what watch the thief would come, he would have watched, and would not have allowed his house to be broken up.", "words": [[0, 275439], [4, 275541], [9, 275741], [15, 276181], [20, 276321], [23, 276421], [27, 276651], [35, 276881], [38, 276981], [42, 277101], [48, 277341], [52, 277541], [58, 277761], [61, 277961], [66, 278141], [72, 278401], [76, 278561], [82, 278741], [88, 278921], [94, 279621], [97, 279701], [103, 279841], [108, 279941], [117, 280789], [121, 280924], [127, 281084], [131, 281284], [136, 281484], [144, 281744], [148, 281944], [154, 282204], [157, 282384], [160, 282504], [167, 282764]]}, {"verse": 44, "start": 283636, "end": 288523, "text": "Therefore be also ready: for in such an hour as you think not the Son of man comes.", "words": [[0, 283636], [10, 284198], [13, 284278], [18, 284558], [25, 285364], [29, 285466], [32, 285626], [37, 285826], [40, 286006], [45, 286266], [48, 286546], [52, 286666], [58, 286906], [62, 287146], [66, 287346], [70, 287546], [73, 287666], [77, 287886]]}, {"verse": 45, "start": 288973, "end": 295676, "text": "Who then is a faithful and wise servant, whom his lord has made ruler over his household, to give them food in due season?", "words": [[0, 288973], [4, 289081], [9, 289261], [12, 289441], [14, 289521], [23, 289941], [27, 290221], [32, 290621], [41, 291301], [46, 291561], [50, 291741], [55, 292021], [59, 292201], [64, 292401], [70, 292761], [75, 293041], [79, 293221], [90, 293981], [93, 294141], [98, 294281], [103, 294461], [108, 294801], [111, 294961], [115, 295141]]}, {"verse": 46, "start": 296126, "end": 300615, "text": "Blessed is that servant, whom his lord when he comes shall find so doing.", "words": [[0, 296126], [8, 296348], [11, 296628], [16, 296828], [25, 297208], [30, 297748], [34, 297968], [39, 298308], [44, 298488], [47, 298608], [53, 298968], [59, 299448], [64, 299808], [67, 300068]]}, {"verse": 47, "start": 301065, "end": 305236, "text": "Assuredly I say to you, That he shall make him ruler over all his goods.", "words": [[0, 301065], [10, 301633], [12, 301773], [16, 301973], [19, 302153], [24, 302473], [29, 302793], [32, 302933], [38, 303113], [43, 303313], [47, 303493], [53, 303853], [58, 304213], [62, 304453], [66, 304673]]}, {"verse": 48, "start": 305686, "end": 310951, "text": "But and if that evil servant shall say in his heart, My lord delays his coming;", "words": [[0, 305686], [4, 306124], [8, 306364], [11, 306544], [16, 306784], [21, 307084], [29, 307604], [35, 307904], [39, 308184], [42, 308344], [46, 308524], [53, 309284], [56, 309444], [61, 309724], [68, 310144], [72, 310404]]}, {"verse": 49, "start": 311401, "end": 316102, "text": "And shall begin to strike his fellowservants, and to eat and drink with the drunken;", "words": [[0, 311401], [4, 311580], [10, 311780], [16, 312060], [19, 312300], [26, 312600], [30, 313220], [46, 313840], [50, 314180], [53, 314340], [57, 314600], [61, 314840], [67, 315140], [72, 315400], [76, 315540]]}, {"verse": 50, "start": 316552, "end": 322402, "text": "The lord of that servant shall come in a day when he looks not for him, and in an hour that he is not aware of,", "words": [[0, 316552], [4, 316652], [9, 316892], [12, 317032], [17, 317212], [25, 317652], [31, 317912], [36, 318192], [39, 318292], [41, 318412], [45, 318592], [50, 318772], [53, 318912], [59, 319152], [63, 319392], [67, 319692], [72, 320092], [76, 320412], [79, 320592], [82, 320732], [87, 321052], [92, 321312], [95, 321432], [98, 321572], [102, 321752], [108, 322012]]}, {"verse": 51, "start": 322852, "end": 329128, "text": "And shall cut him asunder, and appoint him his portion with the hypocrites: there shall be weeping and gnashing of teeth.", "words": [[0, 322852], [4, 322993], [10, 323173], [14, 323413], [18, 323593], [27, 324473], [31, 324573], [39, 324853], [43, 325113], [47, 325313], [55, 325673], [60, 325933], [64, 326053], [76, 327009], [82, 327108], [88, 327288], [91, 327448], [99, 327888], [103, 328128], [112, 328568], [115, 328728]]}]}