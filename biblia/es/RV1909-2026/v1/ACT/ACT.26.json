{"book": "ACT", "chapter": 26, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 284909, "verses": [{"verse": 1, "start": 300, "end": 11631, "text": "Entonces Agripa dijo a Pablo: Se te permite hablar por ti mismo. Pablo entonces, extendiendo la mano, comenzó a responder por sí, diciendo:", "words": [[0, 300], [9, 859], [16, 2139], [21, 2479], [23, 2719], [30, 3440], [33, 3544], [36, 3664], [44, 4004], [51, 4284], [55, 4564], [58, 4724], [65, 5532], [71, 5928], [81, 6828], [93, 7728], [96, 7888], [102, 8588], [110, 9308], [112, 9468], [122, 9968], [126, 10288], [130, 10608]]}, {"verse": 2, "start": 11881, "end": 20071, "text": "Acerca de todas las cosas de que soy acusado por los judíos, oh rey Agripa, me tengo por dichoso de que haya hoy de defenderme delante de ti;", "words": [[0, 11881], [7, 12218], [10, 12458], [16, 12638], [20, 12958], [26, 13278], [29, 13518], [33, 13638], [37, 13818], [45, 14378], [49, 14598], [53, 14738], [61, 15118], [64, 15498], [68, 15798], [76, 16658], [79, 16778], [85, 17038], [89, 17278], [97, 17698], [100, 17898], [104, 18058], [109, 18258], [113, 18518], [116, 18618], [127, 19218], [135, 19618], [138, 19758]]}, {"verse": 3, "start": 20521, "end": 27856, "text": "Especialmente sabiendo tú todas las costumbres y cuestiones que hay entre los judíos: por lo cual te ruego que me oigas con paciencia.", "words": [[0, 20521], [14, 21027], [23, 21807], [26, 22047], [32, 22287], [36, 22567], [47, 23187], [49, 23307], [60, 23807], [64, 24027], [68, 24187], [74, 24387], [78, 24547], [86, 25445], [90, 25545], [93, 25645], [98, 25865], [101, 26045], [107, 26345], [111, 26505], [114, 26645], [120, 26985], [124, 27145]]}, {"verse": 4, "start": 28306, "end": 36008, "text": "Mi vida pues desde la juventud, la cual desde el principio fue en mi nación, en Jerusalén, todos los judíos la saben:", "words": [[0, 28306], [3, 28440], [8, 28660], [13, 29300], [19, 29420], [22, 29660], [32, 30640], [35, 30780], [40, 31020], [46, 31240], [49, 31420], [59, 31920], [63, 32340], [66, 32707], [69, 33073], [77, 33440], [80, 33520], [91, 34500], [97, 34660], [101, 34860], [108, 35360], [111, 35480]]}, {"verse": 5, "start": 36458, "end": 45777, "text": "Los cuales tienen ya conocido que yo desde el principio, si quieren testificarlo, conforme a la más rigurosa secta de nuestra religión he vivido fariseo.", "words": [[0, 36643], [4, 36843], [11, 37003], [18, 37303], [21, 37503], [30, 38043], [34, 38203], [37, 38383], [43, 38603], [46, 38843], [57, 39823], [60, 39983], [68, 40223], [82, 41423], [91, 41903], [93, 41983], [96, 42063], [100, 42450], [109, 42836], [115, 43223], [118, 43323], [126, 43483], [135, 44503], [138, 44663], [145, 45063]]}, {"verse": 6, "start": 46227, "end": 51826, "text": "Y ahora, por la esperanza de la promesa que hizo Dios a nuestros padres, soy llamado en juicio;", "words": [[0, 46227], [2, 46328], [9, 46548], [13, 46788], [16, 46928], [26, 47428], [29, 47548], [32, 47668], [40, 48168], [44, 48368], [49, 48728], [54, 49048], [56, 49228], [65, 49388], [73, 50428], [77, 50708], [85, 51048], [88, 51308]]}, {"verse": 7, "start": 52276, "end": 63426, "text": "A la cual promesa nuestras doce tribus, sirviendo constantemente de día y de noche, esperan que han de llegar. Por la cual esperanza, oh rey Agripa, soy acusado de los judíos.", "words": [[0, 52276], [2, 52373], [5, 52453], [10, 52633], [18, 53213], [27, 53433], [32, 53973], [40, 54653], [50, 55273], [65, 56133], [68, 56293], [72, 56513], [74, 56613], [77, 56693], [84, 57433], [92, 57913], [96, 58060], [100, 58206], [103, 58353], [111, 59112], [115, 59216], [118, 59356], [123, 59516], [134, 59976], [137, 60436], [141, 60896], [149, 61616], [153, 61896], [161, 62496], [164, 62616], [168, 62736]]}, {"verse": 8, "start": 63876, "end": 68725, "text": "¡Qué! ¿Se juzga cosa increíble entre vosotros que Dios resucite los muertos?", "words": [[0, 63876], [6, 64654], [10, 64774], [16, 65134], [21, 65394], [31, 66214], [37, 66394], [46, 67074], [50, 67134], [55, 67354], [64, 67854], [68, 67994]]}, {"verse": 9, "start": 69175, "end": 74347, "text": "Yo ciertamente había pensado deber hacer muchas cosas contra el nombre de Jesús de Nazaret:", "words": [[0, 69175], [3, 69297], [15, 69857], [21, 70077], [29, 70497], [35, 70917], [41, 71157], [48, 71437], [54, 71877], [61, 72257], [64, 72377], [71, 72637], [74, 72797], [80, 73037], [83, 73277]]}, {"verse": 10, "start": 74797, "end": 85705, "text": "Lo cual también hice en Jerusalén, y yo encerré en cárceles a muchos de los santos, recibida potestad de los principales sacerdotes; y cuando eran matados, yo di mi voto.", "words": [[0, 74797], [3, 74925], [8, 75165], [16, 75505], [21, 75885], [24, 76045], [35, 77145], [37, 77205], [40, 77385], [48, 77865], [51, 77965], [60, 78585], [62, 78665], [69, 78925], [72, 79145], [76, 79285], [84, 80045], [93, 80545], [102, 81145], [105, 81265], [109, 81385], [121, 82105], [133, 83295], [135, 83398], [142, 83638], [147, 83978], [156, 84798], [159, 85018], [162, 85138], [165, 85278]]}, {"verse": 11, "start": 86155, "end": 96387, "text": "Y muchas veces, castigándolos por todas las sinagogas, los forcé a blasfemar; y enfurecido sobremanera contra ellos, los perseguí hasta en las ciudades extranjeras.", "words": [[0, 86155], [2, 86265], [9, 86485], [16, 86805], [30, 87785], [34, 87945], [40, 88225], [44, 88485], [55, 89585], [59, 89685], [65, 90165], [67, 90305], [78, 91425], [80, 91525], [91, 92095], [103, 92665], [110, 93085], [117, 93825], [121, 94195], [130, 94565], [136, 94745], [139, 94885], [143, 94985], [152, 95465]]}, {"verse": 12, "start": 96837, "end": 103374, "text": "En lo cual ocupado, yendo a Damasco con potestad y comisión de los principales sacerdotes,", "words": [[0, 96837], [3, 96981], [6, 97101], [11, 97581], [20, 98481], [26, 98961], [28, 99101], [36, 99601], [40, 99821], [49, 100421], [51, 100521], [60, 101001], [63, 101201], [67, 101321], [79, 102041]]}, {"verse": 13, "start": 103824, "end": 112164, "text": "En mitad del día, oh rey, vi en el camino una luz del cielo, que superaba el resplandor del sol, la cual me rodeó y a los que iban conmigo.", "words": [[0, 103824], [3, 103947], [9, 104207], [13, 104467], [18, 104717], [21, 104967], [26, 105607], [29, 105807], [32, 105927], [35, 106027], [42, 106327], [46, 106607], [50, 106827], [54, 107007], [61, 107427], [65, 107887], [74, 108407], [77, 108527], [88, 109087], [92, 109227], [97, 109847], [100, 110027], [105, 110187], [108, 110387], [114, 110827], [116, 110947], [118, 111027], [122, 111167], [126, 111287], [131, 111527]]}, {"verse": 14, "start": 112614, "end": 126548, "text": "Y habiendo caído todos nosotros en tierra, oí una voz que me hablaba, y decía en lengua hebrea: Saulo, Saulo, ¿por qué me persigues? Dura cosa te es dar coces contra los aguijones.", "words": [[0, 112614], [2, 112732], [11, 113112], [17, 113532], [23, 113792], [32, 114372], [35, 114652], [43, 115372], [46, 115772], [50, 115952], [54, 116192], [58, 116372], [61, 116492], [70, 116972], [72, 117372], [78, 117772], [81, 117992], [88, 118352], [96, 119222], [103, 119926], [110, 120886], [115, 121006], [119, 121206], [122, 121386], [133, 122706], [138, 123094], [143, 123494], [146, 123874], [149, 124054], [153, 124334], [159, 124614], [166, 125174], [170, 125454]]}, {"verse": 15, "start": 126848, "end": 134623, "text": "Yo entonces dije: ¿Quién eres, Señor? Y el Señor dijo: Yo soy Jesús, a quien tú persigues.", "words": [[0, 126848], [3, 127069], [12, 127389], [18, 128349], [25, 128573], [31, 128713], [38, 129589], [40, 129675], [43, 129775], [49, 130015], [55, 131755], [58, 131963], [62, 132243], [69, 133103], [71, 133203], [77, 133363], [80, 133683]]}, {"verse": 16, "start": 135073, "end": 147117, "text": "Pero levántate, y ponte sobre tus pies; porque para esto te he aparecido, para ponerte por ministro y testigo de las cosas que has visto, y de aquellas en que apareceré a ti:", "words": [[0, 135073], [5, 135237], [16, 135997], [18, 136177], [24, 136717], [30, 136997], [34, 137237], [40, 138098], [47, 138362], [52, 138702], [57, 139082], [60, 139422], [63, 139582], [74, 140862], [79, 141202], [87, 141722], [91, 141942], [100, 142602], [102, 142702], [110, 143222], [113, 143342], [117, 143482], [123, 143742], [127, 143962], [131, 144042], [138, 144402], [140, 145162], [143, 145302], [152, 145742], [155, 145902], [159, 146022], [169, 146682], [171, 146742]]}, {"verse": 17, "start": 147567, "end": 152239, "text": "Librándote del pueblo y de los Gentiles, a los cuales ahora te envío,", "words": [[0, 147567], [11, 148291], [15, 148511], [22, 148871], [24, 149071], [27, 149171], [31, 149291], [41, 149951], [43, 150591], [47, 150711], [54, 150931], [60, 151331], [63, 151571]]}, {"verse": 18, "start": 152689, "end": 168542, "text": "Para que abras sus ojos, para que se conviertan de las tinieblas a la luz, y de la potestad de Satanás a Dios; para que reciban, por la fe que es en mí, perdón de pecados y herencia entre los santificados.", "words": [[0, 152689], [5, 152859], [9, 153119], [15, 153379], [19, 153739], [25, 154739], [30, 155059], [34, 155199], [37, 155339], [48, 156119], [51, 156259], [55, 156459], [65, 157239], [67, 157399], [70, 157479], [75, 157759], [77, 158379], [80, 158479], [83, 158599], [92, 159379], [95, 159539], [103, 160239], [105, 160439], [111, 161320], [116, 161508], [120, 161708], [129, 162428], [133, 162728], [136, 162928], [139, 163148], [143, 163348], [146, 163588], [149, 163768], [153, 164028], [160, 165008], [163, 165128], [171, 165768], [173, 165988], [182, 166528], [188, 167068], [192, 167308]]}, {"verse": 19, "start": 168842, "end": 173217, "text": "Por lo cual, oh rey Agripa, no fui rebelde a la visión celestial:", "words": [[0, 168842], [4, 168966], [7, 169066], [13, 169526], [16, 169746], [20, 170086], [28, 170866], [31, 171086], [35, 171339], [43, 171593], [45, 171846], [48, 171966], [55, 172366]]}, {"verse": 20, "start": 173667, "end": 185377, "text": "Más bien, anuncié primeramente a los que están en Damasco, y Jerusalén, y por toda la tierra de Judea, y a los Gentiles, que se arrepintiesen y se convirtiesen a Dios, haciendo obras dignas de arrepentimiento.", "words": [[0, 173667], [4, 173845], [10, 174005], [18, 174525], [31, 175165], [33, 175245], [37, 175365], [41, 175505], [47, 175725], [50, 175845], [59, 176385], [61, 176545], [72, 177285], [74, 177505], [78, 177705], [83, 177945], [86, 178125], [93, 178345], [96, 178565], [103, 179065], [105, 179225], [107, 179285], [111, 179405], [121, 180486], [125, 180570], [128, 180730], [142, 181490], [144, 181610], [147, 181710], [160, 182310], [162, 182450], [168, 182690], [177, 183450], [183, 183830], [190, 184350], [193, 184450]]}, {"verse": 21, "start": 185827, "end": 189993, "text": "Por causa de esto los judíos, tomándome en el templo, intentaron matarme.", "words": [[0, 185827], [4, 185929], [10, 186149], [13, 186389], [18, 186629], [22, 186729], [30, 187249], [40, 187769], [43, 187869], [46, 187989], [54, 188709], [65, 189329]]}, {"verse": 22, "start": 190443, "end": 201948, "text": "Pero ayudado del auxilio de Dios, persevero hasta el día de hoy, dando testimonio a pequeños y a grandes, no diciendo nada fuera de las cosas que los profetas y Moisés dijeron que habían de venir:", "words": [[0, 190443], [5, 190582], [13, 191082], [17, 191222], [25, 191742], [28, 191842], [34, 192542], [44, 193162], [50, 193322], [53, 193462], [57, 193622], [60, 193762], [65, 194462], [71, 194702], [82, 195382], [84, 195442], [93, 195982], [95, 196102], [97, 196182], [106, 197054], [109, 197232], [118, 197572], [123, 197912], [129, 198232], [132, 198412], [136, 198552], [142, 198892], [146, 199132], [150, 199272], [159, 199832], [161, 200012], [168, 200352], [176, 200952], [180, 201092], [187, 201352], [190, 201512]]}, {"verse": 23, "start": 202398, "end": 210229, "text": "Que Cristo había de padecer, y ser el primero de la resurrección de los muertos, para anunciar luz al pueblo y a los Gentiles.", "words": [[0, 202398], [4, 202509], [11, 202869], [17, 203089], [20, 203269], [29, 203889], [31, 204129], [35, 204349], [38, 204489], [46, 204809], [49, 205029], [52, 205149], [65, 205889], [68, 206009], [72, 206109], [81, 206609], [86, 207002], [95, 207396], [99, 207789], [102, 208029], [109, 208389], [111, 208709], [113, 208789], [117, 208909]]}, {"verse": 24, "start": 210579, "end": 219842, "text": "Y diciendo él estas cosas en su defensa, Festo a gran voz dijo: Estás loco, Pablo: el mucho estudio te vuelve loco.", "words": [[0, 210579], [2, 210721], [11, 211201], [14, 211661], [20, 212121], [26, 212661], [29, 213101], [32, 213361], [41, 214381], [47, 214921], [49, 215241], [54, 215591], [58, 215941], [64, 216872], [70, 217168], [76, 217448], [83, 218192], [86, 218309], [92, 218529], [100, 218889], [103, 219089], [110, 219409]]}, {"verse": 25, "start": 220192, "end": 226041, "text": "Pero él dijo: No estoy loco, excelentísimo Festo, sino que hablo palabras de verdad y de cordura.", "words": [[0, 220192], [5, 220378], [8, 220618], [14, 221427], [17, 221553], [23, 221813], [29, 222193], [43, 222973], [50, 223853], [55, 223993], [59, 224153], [65, 224393], [74, 224633], [77, 224913], [84, 225133], [86, 225353], [89, 225453]]}, {"verse": 26, "start": 226491, "end": 235400, "text": "Pues el rey sabe estas cosas, delante del cual también hablo confiadamente. Pues no pienso que ignora nada de esto; pues no ha sido esto hecho en algún rincón.", "words": [[0, 226491], [5, 226604], [8, 226764], [12, 227024], [17, 227144], [23, 227344], [30, 228004], [38, 228324], [42, 228484], [47, 228664], [55, 228944], [61, 229344], [76, 230542], [81, 230630], [84, 230770], [91, 231090], [95, 231210], [102, 231510], [107, 231730], [110, 231930], [116, 233120], [121, 233234], [124, 233454], [127, 233594], [132, 233794], [137, 234134], [143, 234454], [146, 234594], [152, 234794]]}, {"verse": 27, "start": 235850, "end": 239223, "text": "¿Crees, rey Agripa, a los profetas? Yo sé que crees.", "words": [[0, 235951], [8, 236091], [12, 236411], [20, 236831], [22, 237011], [26, 237111], [36, 238176], [39, 238341], [42, 238501], [46, 238621]]}, {"verse": 28, "start": 239573, "end": 244764, "text": "Entonces Agripa dijo a Pablo: Por poco me persuades a ser Cristiano.", "words": [[0, 239573], [9, 240132], [16, 241412], [21, 241752], [23, 241992], [30, 242713], [34, 242837], [39, 243057], [42, 243257], [52, 243737], [54, 243897], [58, 244037]]}, {"verse": 29, "start": 245114, "end": 255896, "text": "Y Pablo dijo: ¡Quisiera Dios que por poco o por mucho, no solamente tú, sino también todos los que hoy me oyen, fueseis hechos tales cual yo soy, excepto estas cadenas!", "words": [[0, 245114], [2, 245259], [8, 245599], [14, 246397], [24, 246730], [29, 246970], [33, 247170], [37, 247410], [42, 247640], [44, 247870], [48, 248010], [55, 248870], [58, 248970], [68, 249330], [72, 250170], [77, 250350], [85, 250770], [91, 251030], [95, 251270], [99, 251470], [103, 251570], [106, 251730], [112, 252430], [120, 252890], [127, 253270], [133, 253470], [138, 253790], [141, 253970], [146, 254510], [154, 254990], [160, 255150]]}, {"verse": 30, "start": 256246, "end": 264870, "text": "Y cuando hubo dicho estas cosas, se levantó el rey, y el gobernador, y Bernice, y los que se habían sentado con ellos;", "words": [[0, 256246], [2, 256368], [9, 256628], [14, 257088], [20, 257328], [26, 257588], [33, 258588], [36, 258808], [44, 259348], [47, 259468], [52, 260048], [54, 260208], [57, 260328], [69, 261088], [71, 261548], [80, 262168], [82, 262648], [86, 262788], [90, 262928], [93, 263088], [100, 263388], [108, 264008], [112, 264248]]}, {"verse": 31, "start": 265320, "end": 278424, "text": "Y como se retiraron aparte, hablaban los unos a los otros, diciendo: Ninguna cosa digna ni de muerte, ni de prisión, hace este hombre.", "words": [[0, 265320], [2, 265421], [7, 265661], [10, 265841], [20, 266461], [28, 267581], [37, 268061], [41, 268201], [46, 268481], [48, 268701], [52, 268861], [59, 269641], [69, 270584], [77, 270984], [82, 271264], [88, 271784], [91, 271944], [94, 272084], [102, 272524], [105, 273004], [108, 273124], [117, 273784], [122, 274424], [127, 274824]]}, {"verse": 32, "start": 278774, "end": 284509, "text": "Y Agripa dijo a Festo: Podía este hombre ser suelto, si no hubiera apelado a César.", "words": [[0, 278774], [2, 278942], [9, 279442], [14, 279842], [16, 280062], [23, 280865], [29, 281133], [34, 281453], [41, 281713], [45, 281973], [53, 282753], [56, 282993], [59, 283153], [67, 283453], [75, 283893], [77, 284013]]}]}