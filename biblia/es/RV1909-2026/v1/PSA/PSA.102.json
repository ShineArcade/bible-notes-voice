{"book": "PSA", "chapter": 102, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 174764, "verses": [{"verse": 1, "start": 300, "end": 10173, "text": "Oración del pobre, cuando está angustiado, y delante de Jehová derrama su lamento. JEHOVÁ, oye mi oración, y venga mi clamor a ti.", "words": [[0, 300], [8, 808], [12, 1068], [19, 1508], [26, 2008], [31, 2508], [43, 3008], [45, 3588], [53, 4028], [56, 4168], [63, 4658], [71, 5148], [74, 5328], [83, 6667], [91, 7041], [95, 7414], [98, 7514], [107, 8074], [109, 8654], [115, 9034], [118, 9214], [125, 9674], [127, 9794]]}, {"verse": 2, "start": 10523, "end": 19986, "text": "No escondas de mí tu rostro: en el día de mi angustia inclina a mí tu oído; el día que te invoque, apresúrate a responderme.", "words": [[0, 10523], [3, 10714], [12, 11534], [15, 11674], [18, 11794], [21, 11954], [29, 12950], [32, 13095], [35, 13255], [39, 13475], [42, 13675], [45, 13795], [54, 14455], [62, 15295], [64, 15495], [67, 15615], [70, 15855], [76, 16721], [79, 16867], [83, 17087], [87, 17247], [90, 17387], [99, 18327], [110, 18907], [112, 19127]]}, {"verse": 3, "start": 20336, "end": 25628, "text": "Porque mis días se han consumido como humo; y mis huesos cual tizón están quemados.", "words": [[0, 20336], [7, 20541], [11, 20741], [16, 21061], [19, 21421], [23, 21561], [33, 22261], [38, 22521], [44, 23442], [46, 23548], [50, 23668], [57, 24048], [62, 24428], [68, 24808], [74, 25008]]}, {"verse": 4, "start": 25978, "end": 32170, "text": "Mi corazón fue herido, y se secó como la hierba; por lo cual me olvidé de comer mi pan.", "words": [[0, 25978], [3, 26122], [11, 26502], [15, 26862], [23, 27662], [25, 27902], [28, 28022], [33, 28482], [38, 28682], [41, 28862], [49, 29667], [53, 29791], [56, 29951], [61, 30171], [64, 30351], [71, 30871], [74, 30991], [80, 31271], [83, 31551]]}, {"verse": 5, "start": 32520, "end": 36412, "text": "Por la voz de mi gemido mis huesos se han pegado a mi carne.", "words": [[0, 32520], [4, 32662], [7, 32882], [11, 33122], [14, 33302], [17, 33422], [24, 34022], [28, 34102], [35, 34662], [38, 34882], [42, 35042], [49, 35582], [51, 35682], [54, 35782]]}, {"verse": 6, "start": 36762, "end": 41444, "text": "Soy semejante al pelícano del desierto; soy como el búho de las soledades.", "words": [[0, 36762], [4, 36958], [14, 37598], [17, 37738], [26, 38218], [30, 38438], [40, 39449], [44, 39613], [49, 39893], [52, 40073], [57, 40393], [60, 40493], [64, 40633]]}, {"verse": 7, "start": 41794, "end": 45274, "text": "Velo, y soy como el pájaro solitario sobre el tejado.", "words": [[0, 41794], [6, 42439], [8, 42659], [12, 42799], [17, 43059], [20, 43199], [27, 43619], [37, 44049], [43, 44480], [46, 44910]]}, {"verse": 8, "start": 45624, "end": 52473, "text": "Cada día me afrentan mis enemigos; los que se enfurecen contra mí, se han conjurado contra mí.", "words": [[0, 45624], [5, 45766], [9, 46086], [12, 46286], [21, 46866], [25, 47066], [35, 48143], [39, 48450], [43, 48710], [46, 48890], [56, 49530], [63, 49950], [67, 50610], [70, 50870], [74, 51050], [84, 51730], [91, 52090]]}, {"verse": 9, "start": 52823, "end": 58333, "text": "Por lo que como la ceniza a manera de pan, y mi bebida mezclo con lloro,", "words": [[0, 52823], [4, 52946], [7, 53146], [11, 53306], [16, 53606], [19, 53806], [26, 54886], [28, 54946], [35, 55206], [38, 55466], [43, 56126], [45, 56366], [48, 56526], [55, 56986], [62, 57606], [66, 57826]]}, {"verse": 10, "start": 58683, "end": 64229, "text": "A causa de tu enojo y de tu ira; pues me alzaste, y me has arrojado.", "words": [[0, 58683], [2, 58809], [8, 59209], [11, 59509], [14, 59669], [20, 60109], [22, 60209], [25, 60329], [28, 60549], [33, 61243], [38, 61447], [41, 62027], [50, 62727], [52, 63047], [55, 63167], [59, 63387]]}, {"verse": 11, "start": 64579, "end": 69199, "text": "Mis días son como la sombra que se va; y me he secado como la hierba.", "words": [[0, 64579], [4, 64749], [9, 64989], [13, 65289], [18, 65529], [21, 65689], [28, 66109], [32, 66229], [35, 66389], [39, 67055], [41, 67335], [44, 67475], [47, 67575], [54, 68075], [59, 68295], [62, 68475]]}, {"verse": 12, "start": 69549, "end": 76135, "text": "Mas tú, Jehová, permanecerás para siempre, y tu memoria para generación y generación.", "words": [[0, 69549], [4, 69877], [8, 70248], [16, 70620], [29, 71520], [34, 71780], [43, 72420], [45, 73040], [48, 73200], [56, 73700], [61, 73960], [72, 74820], [74, 75080]]}, {"verse": 13, "start": 76485, "end": 85960, "text": "Tú levantándote, tendrás misericordia de Sion; porque el tiempo de tener misericordia de ella, porque el plazo es llegado.", "words": [[0, 76485], [3, 76834], [17, 78214], [25, 78574], [38, 79189], [41, 79805], [47, 80594], [54, 80800], [57, 80960], [64, 81200], [67, 81400], [73, 81680], [86, 82620], [89, 82760], [95, 83420], [102, 84000], [105, 84340], [111, 84840], [114, 85060]]}, {"verse": 14, "start": 86310, "end": 91888, "text": "Porque tus siervos aman sus piedras, y del polvo de ella tienen compasión.", "words": [[0, 86310], [7, 86514], [11, 86774], [19, 87334], [24, 87694], [28, 87994], [37, 88714], [39, 89134], [43, 89314], [49, 90014], [52, 90174], [57, 90374], [64, 90774]]}, {"verse": 15, "start": 92238, "end": 98838, "text": "Entonces temerán las naciones el nombre de Jehová, y todos los reyes de la tierra tu gloria;", "words": [[0, 92238], [9, 92854], [17, 93574], [21, 93774], [30, 94334], [33, 94594], [40, 94934], [43, 95114], [51, 95794], [53, 95994], [59, 96294], [63, 96754], [69, 97214], [72, 97374], [75, 97514], [82, 98094], [85, 98154]]}, {"verse": 16, "start": 99188, "end": 103855, "text": "Por cuanto Jehová habrá edificado a Sion, y en su gloria será visto;", "words": [[0, 99188], [4, 99330], [11, 99630], [18, 100230], [24, 100590], [34, 101061], [36, 101532], [42, 102003], [44, 102125], [47, 102245], [50, 102535], [57, 102825], [62, 103165]]}, {"verse": 17, "start": 104205, "end": 109909, "text": "Habrá mirado a la oración de los solitarios, y no habrá desechado el ruego de ellos.", "words": [[0, 104205], [6, 104529], [13, 104949], [15, 105129], [18, 105229], [26, 105709], [29, 105909], [33, 106029], [45, 106949], [47, 107549], [50, 107709], [56, 108049], [66, 108669], [69, 108809], [75, 109129], [78, 109269]]}, {"verse": 18, "start": 110259, "end": 116295, "text": "Esto se escribirá para la generación venidera: y el pueblo que se criará, alabará a JAH.", "words": [[0, 110259], [5, 110616], [8, 111066], [18, 111516], [23, 111696], [26, 111876], [37, 112516], [47, 113562], [49, 113690], [52, 113830], [59, 114130], [63, 114370], [66, 114530], [74, 115070], [82, 115493], [84, 115915]]}, {"verse": 19, "start": 116645, "end": 121347, "text": "Porque miró de lo alto de su santuario; Jehová miró de los cielos a la tierra,", "words": [[0, 116645], [7, 116827], [12, 117227], [15, 117307], [18, 117447], [23, 117787], [26, 117987], [29, 118127], [40, 119220], [47, 119625], [52, 119865], [55, 119945], [59, 120085], [66, 120545], [68, 120665], [71, 120725]]}, {"verse": 20, "start": 121697, "end": 127755, "text": "Para oír el gemido de los presos, para soltar a los sentenciados a muerte;", "words": [[0, 121697], [5, 121886], [9, 122486], [12, 122726], [19, 123306], [22, 123446], [26, 123546], [34, 124606], [39, 124986], [46, 125646], [48, 125866], [52, 125986], [65, 126926], [67, 127126]]}, {"verse": 21, "start": 128105, "end": 132948, "text": "Porque cuenten en Sion el nombre de Jehová, y su alabanza en Jerusalén,", "words": [[0, 128105], [7, 128465], [15, 128825], [18, 129105], [23, 129385], [26, 129795], [33, 130205], [36, 130325], [44, 130925], [46, 131105], [49, 131285], [58, 131905], [61, 132045]]}, {"verse": 22, "start": 133298, "end": 137727, "text": "Cuando los pueblos y los reinos se congreguen en uno para servir a Jehová.", "words": [[0, 133298], [7, 133482], [11, 133722], [19, 134242], [21, 134362], [25, 134482], [32, 135002], [35, 135222], [46, 136002], [49, 136082], [53, 136342], [58, 136582], [65, 136982], [67, 137182]]}, {"verse": 23, "start": 138077, "end": 141512, "text": "El afligió mi fuerza en el camino; acortó mis días.", "words": [[0, 138139], [3, 138279], [11, 138939], [14, 139099], [21, 139459], [24, 139679], [27, 139799], [35, 140666], [42, 140736], [46, 140876]]}, {"verse": 24, "start": 141862, "end": 148854, "text": "Dije: Dios mío, no me cortes en el medio de mis días: por generación de generaciones son tus años.", "words": [[0, 141862], [6, 142747], [11, 142951], [16, 143331], [19, 143431], [22, 143591], [29, 144131], [32, 144291], [35, 144431], [41, 144731], [44, 144911], [48, 145071], [54, 145916], [58, 146078], [69, 146858], [72, 147018], [85, 147758], [89, 147998], [93, 148218]]}, {"verse": 25, "start": 149204, "end": 154277, "text": "Tú fundaste la tierra antiguamente, y los cielos son obra de tus manos.", "words": [[0, 149204], [3, 149287], [12, 149787], [15, 149967], [22, 150307], [36, 151507], [38, 151742], [42, 151882], [49, 152542], [53, 152902], [58, 153262], [61, 153462], [65, 153582]]}, {"verse": 26, "start": 154627, "end": 164556, "text": "Ellos perecerán, y tú permanecerás; y todos ellos como un vestido se envejecerán; como una ropa de vestir los mudarás, y serán mudados:", "words": [[0, 154627], [6, 155201], [17, 155811], [19, 156051], [22, 156231], [36, 157646], [38, 157765], [44, 158025], [50, 158425], [55, 158745], [58, 158945], [66, 159485], [69, 159705], [82, 160945], [87, 161128], [91, 161328], [96, 161708], [99, 161828], [106, 162288], [110, 162408], [119, 163048], [121, 163388], [127, 163748]]}, {"verse": 27, "start": 164906, "end": 168080, "text": "Pero tú eres el mismo, y tus años no se acabarán.", "words": [[0, 164906], [5, 165051], [8, 165251], [13, 165471], [16, 165671], [23, 166051], [25, 166431], [29, 166571], [34, 166891], [37, 167131], [40, 167271]]}, {"verse": 28, "start": 168430, "end": 174364, "text": "Los hijos de tus siervos habitarán, y su descendencia será afirmada delante de ti.", "words": [[0, 168430], [4, 168614], [10, 168914], [13, 169114], [17, 169274], [25, 169754], [36, 170534], [38, 170974], [41, 171214], [54, 172254], [59, 172594], [68, 173334], [76, 173834], [79, 173994]]}]}