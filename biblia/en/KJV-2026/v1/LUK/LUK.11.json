{"book": "LUK", "chapter": 11, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 420837, "verses": [{"verse": 1, "start": 300, "end": 11629, "text": "And it came to pass, that, as he was praying in a certain place, when he ceased, one of his disciples said to him, Lord, teach us to pray, as John also taught his disciples.", "words": [[0, 300], [4, 423], [7, 543], [12, 743], [15, 903], [21, 1683], [27, 2003], [30, 2583], [33, 2723], [37, 2903], [45, 3283], [48, 3503], [50, 3643], [58, 3843], [65, 4743], [70, 4963], [73, 5143], [81, 5983], [85, 6123], [88, 6243], [92, 6363], [102, 6863], [107, 7223], [110, 7423], [115, 8047], [121, 8495], [127, 8635], [130, 8895], [133, 9035], [139, 9335], [142, 9735], [147, 10015], [152, 10395], [159, 10655], [163, 10815]]}, {"verse": 2, "start": 11979, "end": 21549, "text": "And he said to them, When you pray, say, Our Father in heaven, Hallowed be your name. Your kingdom come. Your will be done, as in heaven, so in earth.", "words": [[0, 11979], [4, 12109], [7, 12229], [12, 12469], [15, 12669], [21, 13265], [26, 13382], [30, 13522], [36, 13962], [41, 14342], [45, 14762], [52, 15062], [55, 15282], [63, 15962], [72, 16382], [75, 16522], [80, 16682], [86, 17448], [91, 17551], [99, 17911], [105, 18878], [110, 18997], [115, 19197], [118, 19417], [124, 19817], [127, 20037], [130, 20197], [138, 20777], [141, 20977], [144, 21117]]}, {"verse": 3, "start": 21999, "end": 24392, "text": "Give us day by day our daily bread.", "words": [[0, 21999], [5, 22352], [8, 22512], [12, 22752], [15, 22932], [19, 23252], [23, 23512], [29, 23792]]}, {"verse": 4, "start": 24842, "end": 33339, "text": "And forgive us our sins; for we also forgive every one that is indebted to us. And lead us not into temptation; but deliver us from evil.", "words": [[0, 24842], [4, 24966], [12, 25266], [15, 25506], [19, 25686], [25, 26626], [29, 26724], [32, 26884], [37, 27164], [45, 27491], [51, 27817], [55, 28144], [60, 28444], [63, 28604], [72, 29064], [75, 29244], [79, 29905], [83, 30024], [88, 30184], [91, 30384], [95, 30604], [100, 30844], [112, 31999], [116, 32104], [124, 32384], [127, 32664], [132, 32864]]}, {"verse": 5, "start": 33689, "end": 41259, "text": "And he said to them, Which of you shall have a friend, and shall go to him at midnight, and say to him, Friend, lend me three loaves;", "words": [[0, 33689], [4, 33820], [7, 33940], [12, 34180], [15, 34380], [21, 34975], [27, 35170], [30, 35350], [34, 35510], [40, 35710], [45, 35930], [47, 36010], [55, 36690], [59, 36870], [65, 37050], [68, 37250], [71, 37410], [75, 37550], [78, 37690], [88, 38370], [92, 38470], [96, 38690], [99, 38850], [104, 39270], [112, 39910], [117, 40070], [120, 40350], [126, 40610]]}, {"verse": 6, "start": 41709, "end": 46428, "text": "For a friend of mine in his journey is come to me, and I have nothing to set before him?", "words": [[0, 41709], [4, 41880], [6, 41980], [13, 42200], [16, 42340], [21, 42560], [24, 42780], [28, 42940], [36, 43210], [39, 43480], [44, 43700], [47, 43860], [51, 44540], [55, 44640], [57, 44800], [62, 44960], [70, 45260], [73, 45480], [77, 45720], [84, 46020]]}, {"verse": 7, "start": 46878, "end": 55813, "text": "And he from within shall answer and say Trouble me not the door is now shut and my children are with me in bed I can not rise and give you", "words": [[0, 46878], [4, 47034], [7, 47254], [12, 47494], [19, 47814], [25, 48074], [32, 48494], [36, 48714], [40, 49214], [48, 49574], [51, 49754], [55, 50554], [59, 50694], [64, 50974], [67, 51174], [71, 51354], [76, 51954], [80, 52174], [83, 52334], [92, 52674], [96, 52914], [101, 53114], [104, 53334], [107, 53474], [111, 53694], [113, 54302], [117, 54428], [121, 54555], [126, 55015], [130, 55275], [135, 55475]]}, {"verse": 8, "start": 56263, "end": 65772, "text": "I say to you, Though he will not rise and give him, because he is his friend, yet because of his importunity he will rise and give him as many as he needs.", "words": [[0, 56263], [2, 56384], [6, 56644], [9, 56864], [14, 57244], [21, 57364], [24, 57544], [29, 57724], [33, 57944], [38, 58324], [42, 58524], [47, 58724], [52, 59264], [60, 59524], [63, 59824], [66, 60004], [70, 60144], [78, 61037], [82, 61161], [90, 61501], [93, 61721], [97, 61861], [109, 62601], [112, 62801], [117, 62981], [122, 63401], [126, 63921], [131, 64161], [135, 64341], [138, 64521], [143, 64781], [146, 65001], [149, 65141]]}, {"verse": 9, "start": 66222, "end": 73383, "text": "And I say to you, Ask, and it shall be given you; seek, and you shall find; knock, and it shall be opened to you.", "words": [[0, 66222], [4, 66353], [6, 66473], [10, 66693], [13, 66853], [18, 67213], [23, 67793], [27, 68073], [30, 68193], [36, 68373], [39, 68513], [45, 68753], [50, 69448], [56, 69893], [60, 70173], [64, 70293], [70, 70473], [76, 71409], [83, 71653], [87, 72033], [90, 72153], [96, 72313], [99, 72503], [106, 72693], [109, 72953]]}, {"verse": 10, "start": 73833, "end": 80313, "text": "For every one that asks receives; and he that seeks finds; and to him that knocks it shall be opened.", "words": [[0, 73833], [4, 73947], [10, 74101], [14, 74254], [19, 74594], [24, 74894], [34, 76044], [38, 76186], [41, 76446], [46, 76726], [52, 76986], [59, 78110], [63, 78249], [66, 78409], [70, 78629], [75, 78869], [82, 79189], [85, 79389], [91, 79629], [94, 79809]]}, {"verse": 11, "start": 80763, "end": 88886, "text": "If a son shall ask bread of any of you that is a father, will he give him a stone? or if he ask a fish, will he for a fish give him a serpent?", "words": [[0, 80763], [3, 80888], [5, 81028], [9, 81308], [15, 81528], [19, 81808], [25, 82108], [28, 82308], [32, 82488], [35, 82628], [39, 82768], [44, 82928], [47, 83028], [49, 83108], [57, 83888], [62, 83988], [65, 84128], [70, 84328], [74, 84448], [76, 84548], [83, 85418], [86, 85575], [89, 85735], [92, 85905], [96, 86075], [98, 86235], [104, 86955], [109, 87155], [112, 87275], [116, 87475], [118, 87595], [123, 87835], [128, 88055], [132, 88215], [134, 88335]]}, {"verse": 12, "start": 89336, "end": 92312, "text": "Or if he shall ask an egg, will he offer him a scorpion?", "words": [[0, 89336], [3, 89477], [6, 89617], [9, 89717], [15, 89877], [19, 90137], [22, 90297], [27, 90877], [32, 91017], [35, 91157], [41, 91377], [45, 91577], [47, 91657]]}, {"verse": 13, "start": 92762, "end": 101022, "text": "If you then, being evil, know how to give good gifts to your children: how much more shall your heavenly Father give the Holy Spirit to them that ask him?", "words": [[0, 92762], [3, 92905], [7, 93085], [13, 93285], [19, 93525], [25, 94265], [30, 94585], [34, 94785], [37, 94865], [42, 95125], [47, 95505], [53, 95845], [56, 96085], [61, 96185], [71, 97085], [75, 97202], [80, 97422], [85, 97662], [91, 97862], [96, 98042], [105, 98322], [112, 98742], [117, 99002], [121, 99142], [126, 99362], [133, 99782], [136, 99962], [141, 100142], [146, 100322], [150, 100602]]}, {"verse": 14, "start": 101372, "end": 109051, "text": "¶ And he was casting out a demon, and it was dumb. And it came to pass, when the demon had gone out, the dumb spoke; and the people wondered.", "words": [[2, 101372], [6, 101496], [9, 101596], [13, 101716], [21, 102136], [25, 102376], [27, 102496], [34, 103136], [38, 103236], [41, 103356], [45, 103496], [51, 104321], [55, 104440], [58, 104540], [63, 104740], [66, 104900], [72, 105220], [77, 105460], [81, 105580], [87, 105820], [91, 106020], [96, 106260], [101, 106680], [105, 106740], [110, 107000], [117, 107932], [121, 108062], [125, 108142], [132, 108382]]}, {"verse": 15, "start": 109501, "end": 113981, "text": "But some of them said, He casts out demons through Beelzebub the chief of the demons.", "words": [[0, 109501], [4, 109627], [9, 109847], [12, 110007], [17, 110147], [23, 110917], [26, 111012], [32, 111292], [36, 111432], [43, 111792], [51, 112212], [61, 112632], [65, 112832], [71, 113112], [74, 113312], [78, 113432]]}, {"verse": 16, "start": 114331, "end": 117893, "text": "And others, tempting him, sought of him a sign from heaven.", "words": [[0, 114331], [4, 114480], [12, 114820], [21, 115440], [26, 115880], [33, 116240], [36, 116440], [40, 116600], [42, 116860], [47, 117120], [52, 117380]]}, {"verse": 17, "start": 118343, "end": 127999, "text": "But he, knowing their thoughts, said to them, Every kingdom divided against itself is brought to desolation; and a house divided against a house falls.", "words": [[0, 118343], [4, 118469], [8, 118849], [16, 119069], [22, 119349], [32, 119969], [37, 120049], [40, 120209], [46, 121608], [52, 121915], [60, 122295], [68, 122775], [76, 123175], [83, 123695], [86, 124015], [94, 124275], [97, 124495], [109, 125653], [113, 125798], [115, 125898], [121, 126118], [129, 126538], [137, 126898], [139, 127098], [145, 127338]]}, {"verse": 18, "start": 128449, "end": 136184, "text": "If Satan also be divided against himself, how shall his kingdom stand? because you say that I cast out demons through Beelzebub.", "words": [[0, 128449], [3, 128585], [9, 128905], [14, 129365], [17, 129565], [25, 129905], [33, 130245], [42, 131165], [46, 131305], [52, 131485], [56, 131665], [64, 131965], [71, 132965], [79, 133203], [83, 133463], [87, 133703], [92, 133903], [94, 134023], [99, 134443], [103, 134603], [110, 135043], [118, 135383]]}, {"verse": 19, "start": 136634, "end": 143589, "text": "And if I by Beelzebub cast out demons, by whom do your sons cast them out? therefore shall they be your judges.", "words": [[0, 136634], [4, 136780], [7, 136920], [9, 137080], [12, 137320], [22, 138000], [27, 138280], [31, 138500], [39, 139220], [42, 139520], [47, 139760], [50, 139940], [55, 140100], [60, 140400], [65, 140760], [70, 141000], [75, 141696], [85, 142075], [91, 142415], [96, 142635], [99, 142835], [104, 142995]]}, {"verse": 20, "start": 144039, "end": 149709, "text": "But if I with the finger of God cast out demons, no doubt the kingdom of God is come upon you.", "words": [[0, 144039], [4, 144141], [7, 144281], [9, 144461], [14, 144641], [18, 144761], [25, 145021], [28, 145221], [32, 145521], [37, 146021], [41, 146301], [49, 147261], [52, 147421], [58, 147641], [62, 147821], [70, 148101], [73, 148321], [77, 148641], [80, 148821], [85, 149001], [90, 149321]]}, {"verse": 21, "start": 150159, "end": 154040, "text": "When a strong man armed keeps his palace, his goods are in peace:", "words": [[0, 150159], [5, 150280], [7, 150380], [14, 150680], [18, 150980], [24, 151400], [30, 151680], [34, 151920], [42, 152680], [46, 152800], [52, 153100], [56, 153300], [59, 153420]]}, {"verse": 22, "start": 154490, "end": 162511, "text": "But when a stronger than he shall come upon him, and overcome him, he takes from him all his armour in which he trusted, and divides his spoils.", "words": [[0, 154490], [4, 154608], [9, 154748], [11, 154868], [20, 155268], [25, 155488], [28, 155688], [34, 155868], [39, 156088], [44, 156348], [49, 156668], [53, 156928], [62, 157308], [67, 158068], [70, 158168], [76, 158448], [81, 158688], [85, 158928], [89, 159208], [93, 159478], [100, 159748], [103, 160048], [109, 160208], [112, 160348], [121, 160708], [125, 161208], [133, 161588], [137, 161848]]}, {"verse": 23, "start": 162961, "end": 167471, "text": "He that is not with me is against me: and he that gathers not with me scatters.", "words": [[0, 162961], [3, 163112], [8, 163352], [11, 163472], [15, 163672], [20, 163872], [23, 164132], [26, 164432], [34, 164652], [38, 165396], [42, 165500], [45, 165640], [50, 165820], [58, 166180], [62, 166440], [67, 166640], [70, 166780]]}, {"verse": 24, "start": 167921, "end": 177106, "text": "When the unclean spirit is gone out of a man, he walks through dry places, seeking rest; and finding none, he says, I will return to my house from where I came out.", "words": [[0, 167921], [5, 168019], [9, 168139], [17, 168559], [24, 168799], [27, 169039], [32, 169219], [36, 169399], [39, 169499], [41, 169559], [46, 170099], [49, 170179], [55, 170419], [63, 170679], [67, 170959], [75, 171739], [83, 171999], [89, 172912], [93, 173037], [101, 173377], [107, 173797], [110, 173897], [116, 174537], [118, 174717], [123, 174877], [130, 175277], [133, 175437], [136, 175617], [142, 175897], [147, 176137], [153, 176337], [155, 176477], [160, 176657]]}, {"verse": 25, "start": 177556, "end": 180410, "text": "And when he comes, he finds it swept and garnished.", "words": [[0, 177556], [4, 177661], [9, 177781], [12, 177921], [19, 178521], [22, 178601], [28, 178881], [31, 179061], [37, 179361], [41, 179741]]}, {"verse": 26, "start": 180860, "end": 190112, "text": "Then goes he, and takes to him seven other spirits more wicked than himself; and they enter in, and dwell there: and the last state of that man is worse than the first.", "words": [[0, 180860], [5, 181086], [10, 181326], [14, 181646], [18, 181866], [24, 182126], [27, 182326], [31, 182486], [37, 182786], [43, 183026], [51, 183406], [56, 183706], [63, 184006], [68, 184246], [77, 185101], [81, 185244], [86, 185384], [92, 185684], [96, 186024], [100, 186344], [106, 186604], [113, 187344], [117, 187624], [121, 187744], [126, 188024], [132, 188264], [135, 188384], [140, 188564], [144, 188824], [147, 189024], [153, 189284], [158, 189524], [162, 189624]]}, {"verse": 27, "start": 190462, "end": 201886, "text": "¶ And it came to pass, as he spoke these things, a certain woman of the company lifted up her voice, and said to him, Blessed is the womb that bore you, and the paps which you have sucked.", "words": [[2, 190462], [6, 190616], [9, 190736], [14, 190936], [17, 191136], [23, 191936], [26, 192156], [29, 192316], [35, 192636], [41, 192896], [49, 193776], [51, 193936], [59, 194176], [65, 194596], [68, 194796], [72, 194916], [80, 195296], [87, 195716], [90, 195956], [94, 196096], [101, 196516], [105, 196836], [110, 197096], [113, 197316], [118, 198150], [126, 198370], [129, 198570], [133, 198730], [138, 199030], [143, 199270], [148, 199570], [153, 200210], [157, 200310], [161, 200450], [166, 200830], [172, 201010], [176, 201170], [181, 201270]]}, {"verse": 28, "start": 202236, "end": 206983, "text": "But he said, Yes rather, blessed are they that hear the word of God, and keep it.", "words": [[0, 202236], [4, 202381], [7, 202501], [13, 203199], [17, 203651], [25, 203811], [33, 204151], [37, 204431], [42, 204611], [47, 204831], [52, 204991], [56, 205131], [61, 205351], [64, 205471], [69, 205811], [73, 206351], [78, 206611]]}, {"verse": 29, "start": 207333, "end": 219216, "text": "¶ And when the people were gathered thick together, he began to say, This is an evil generation: they seek a sign; and there shall no sign be given it, but the sign of Jonas the prophet.", "words": [[2, 207333], [6, 207444], [11, 207584], [15, 207704], [22, 207964], [27, 208184], [36, 208584], [42, 208904], [52, 209764], [55, 209844], [61, 210204], [64, 210384], [69, 212263], [74, 212431], [77, 212571], [80, 212691], [85, 212991], [97, 214153], [102, 214250], [107, 214490], [109, 214670], [115, 215436], [119, 215560], [125, 215680], [131, 215880], [134, 216140], [139, 216480], [142, 216660], [148, 216880], [152, 217400], [156, 217600], [160, 217720], [165, 218020], [168, 218300], [174, 218580], [178, 218680]]}, {"verse": 30, "start": 219666, "end": 225926, "text": "For as Jonas was a sign to the Ninevites, so shall also the Son of man be to this generation.", "words": [[0, 219666], [4, 219786], [7, 219986], [13, 220366], [17, 220633], [19, 220899], [24, 221166], [27, 221366], [31, 221976], [42, 222586], [45, 222886], [51, 223126], [56, 223566], [60, 223806], [64, 224046], [67, 224166], [71, 224506], [74, 224826], [77, 225006], [82, 225206]]}, {"verse": 31, "start": 226376, "end": 239032, "text": "The queen of the south shall rise up in the judgment with the men of this generation, and condemn them: for she came from the utmost parts of the earth to hear the wisdom of Solomon; and, behold, a greater than Solomon is here.", "words": [[0, 226376], [4, 226453], [10, 226713], [13, 226873], [17, 226973], [23, 227293], [29, 227573], [34, 227913], [37, 228153], [40, 228253], [44, 228353], [53, 228673], [58, 229013], [62, 229153], [66, 229333], [69, 229453], [74, 229633], [86, 230233], [90, 230793], [98, 231113], [104, 231873], [108, 231997], [112, 232197], [117, 232457], [122, 232717], [126, 232857], [133, 233097], [139, 233497], [142, 233697], [146, 233797], [152, 234037], [155, 234257], [160, 234397], [164, 234537], [171, 234857], [174, 235057], [183, 236006], [188, 236666], [196, 237346], [198, 237426], [206, 237726], [211, 237966], [219, 238346], [222, 238606]]}, {"verse": 32, "start": 239482, "end": 249894, "text": "The men of Nineve shall rise up in the judgment with this generation, and shall condemn it: for they repented at the preaching of Jonas; and, behold, a greater than Jonas is here.", "words": [[0, 239482], [4, 239567], [8, 239767], [11, 240007], [18, 240247], [24, 240627], [29, 240927], [32, 241167], [35, 241267], [39, 241347], [48, 241687], [53, 241967], [58, 242167], [70, 242707], [74, 243187], [80, 243387], [88, 243707], [92, 244316], [96, 244404], [101, 244504], [110, 245044], [113, 245224], [117, 245304], [127, 245604], [130, 245804], [137, 247364], [142, 247364], [150, 248267], [152, 248447], [160, 248667], [165, 248927], [171, 249267], [174, 249507]]}, {"verse": 33, "start": 250344, "end": 259801, "text": "No man, when he has lighted a lamp, puts it in a secret place, neither under a basket, but on a lampstand, that they which come in may see the light.", "words": [[0, 250344], [3, 250597], [8, 250977], [13, 251257], [16, 251457], [20, 251637], [28, 252037], [30, 252137], [36, 252457], [41, 253117], [44, 253337], [47, 253437], [49, 253537], [56, 253737], [63, 254277], [71, 254717], [77, 255057], [79, 255237], [87, 255597], [91, 256197], [94, 256357], [96, 256807], [107, 257512], [112, 257676], [117, 257936], [123, 258136], [128, 258416], [131, 258716], [135, 258996], [139, 259216], [143, 259376]]}, {"verse": 34, "start": 260251, "end": 271130, "text": "The light of the body is the eye: therefore when your eye is single, your whole body also is full of light; but when your eye is evil, your body also is full of darkness.", "words": [[0, 260251], [4, 260348], [10, 260608], [13, 260868], [17, 260988], [22, 261308], [25, 261608], [29, 261768], [34, 262519], [44, 263122], [49, 263242], [54, 263402], [58, 263682], [61, 263862], [69, 264702], [74, 264782], [80, 265002], [85, 265362], [90, 265742], [93, 266102], [98, 266322], [101, 266462], [108, 267209], [112, 267311], [117, 267491], [122, 267651], [126, 267991], [129, 268191], [135, 268971], [140, 269091], [145, 269391], [150, 269791], [153, 270071], [158, 270291], [161, 270411]]}, {"verse": 35, "start": 271580, "end": 275177, "text": "Take heed therefore that the light which is in you be not darkness.", "words": [[0, 271580], [5, 271737], [10, 272237], [20, 272757], [25, 272857], [29, 272997], [35, 273237], [41, 273437], [44, 273637], [47, 273837], [51, 273997], [54, 274197], [58, 274437]]}, {"verse": 36, "start": 275627, "end": 284358, "text": "If your whole body therefore be full of light, having no part dark, the whole shall be full of light, as when the bright shining of a lamp does give you light.", "words": [[0, 275627], [3, 275798], [8, 275958], [14, 276218], [19, 276638], [29, 277038], [32, 277298], [37, 277558], [40, 277678], [47, 278238], [54, 278438], [57, 278718], [62, 278958], [68, 279698], [72, 279818], [78, 280058], [84, 280298], [87, 280458], [92, 280678], [95, 280778], [102, 281477], [105, 281653], [110, 281833], [114, 281933], [121, 282173], [129, 282573], [132, 282793], [134, 282893], [139, 283173], [144, 283473], [149, 283773], [153, 283913]]}, {"verse": 37, "start": 284708, "end": 291258, "text": "¶ And as he spoke, a certain Pharisee besought him to dine with him: and he went in, and sat down to eat.", "words": [[2, 284708], [6, 284840], [9, 285040], [12, 285160], [19, 286120], [21, 286240], [29, 286540], [38, 287340], [47, 287680], [51, 287860], [54, 288040], [59, 288380], [64, 288580], [69, 289140], [73, 289265], [76, 289385], [81, 289585], [85, 289865], [89, 290125], [93, 290365], [98, 290665], [101, 290845]]}, {"verse": 38, "start": 291708, "end": 296685, "text": "And when the Pharisee saw it, he marvelled that he had not first washed before dinner.", "words": [[0, 291708], [4, 291827], [9, 292007], [13, 292437], [22, 292867], [26, 293067], [30, 293447], [33, 293807], [43, 294167], [48, 294267], [51, 294427], [55, 294607], [59, 294827], [65, 295167], [72, 295587], [79, 295907]]}, {"verse": 39, "start": 297135, "end": 306633, "text": "And the Lord said to him, Now do you Pharisees make clean the outside of the cup and the platter; but your inward part is full of ravening and wickedness.", "words": [[0, 297135], [4, 297435], [8, 297575], [13, 297775], [18, 298035], [21, 298255], [26, 298881], [30, 299485], [33, 299545], [37, 299685], [47, 300365], [52, 300565], [58, 300865], [62, 301065], [70, 301385], [73, 301705], [77, 301825], [81, 302085], [85, 302285], [89, 302385], [98, 303173], [102, 303334], [107, 303494], [114, 303854], [119, 304234], [122, 304514], [127, 304794], [130, 304974], [139, 305654], [143, 305814]]}, {"verse": 40, "start": 307083, "end": 312095, "text": "You fools, did not he that made that which is without make that which is within also?", "words": [[0, 307083], [4, 307219], [11, 307559], [15, 307819], [19, 308099], [22, 308539], [27, 308759], [32, 308999], [37, 309279], [43, 309479], [46, 309619], [54, 309979], [59, 310579], [64, 310839], [70, 311039], [73, 311139], [80, 311399]]}, {"verse": 41, "start": 312545, "end": 317701, "text": "But rather give alms of such things as you have; and, behold, all things are clean to you.", "words": [[0, 312545], [4, 312628], [11, 312848], [16, 313108], [21, 313528], [24, 313628], [29, 313828], [36, 314128], [39, 314348], [43, 314468], [49, 315198], [54, 315340], [62, 316120], [66, 316400], [73, 316720], [77, 316900], [83, 317160], [86, 317380]]}, {"verse": 42, "start": 318151, "end": 330035, "text": "But woe to you, Pharisees! for you tithe mint and rue and all manner of herbs, and pass over judgment and the love of God: these ought you to have done, and not to leave the other undone.", "words": [[0, 318151], [4, 318275], [8, 318675], [11, 318795], [16, 318975], [27, 320152], [31, 320264], [35, 320444], [41, 320844], [46, 321324], [50, 321384], [54, 321654], [58, 321924], [62, 322164], [69, 322504], [72, 322744], [79, 323444], [83, 323584], [88, 323864], [93, 324164], [102, 324604], [106, 324924], [110, 325044], [115, 325264], [118, 325404], [123, 326198], [129, 326479], [135, 326799], [139, 327039], [142, 327159], [147, 327319], [153, 328079], [157, 328179], [161, 328399], [164, 328599], [170, 328819], [174, 329039], [180, 329279]]}, {"verse": 43, "start": 330485, "end": 336672, "text": "Woe to you, Pharisees! for you love the uppermost seats in the synagogues, and greetings in the markets.", "words": [[0, 330485], [4, 330868], [7, 330948], [12, 331128], [23, 332379], [27, 332464], [31, 332664], [36, 332924], [40, 333124], [50, 333604], [56, 333924], [59, 334124], [63, 334224], [75, 334964], [79, 335244], [89, 335564], [92, 335944], [96, 336024]]}, {"verse": 44, "start": 337122, "end": 345217, "text": "Woe to you, scribes and Pharisees, hypocrites! for you are as graves which appear not, and the men that walk over them are not aware of them.", "words": [[0, 337122], [4, 337488], [7, 337568], [12, 337708], [20, 338368], [24, 338488], [35, 339188], [47, 340227], [51, 340343], [55, 340563], [59, 340723], [62, 340883], [69, 341263], [75, 341543], [82, 341803], [87, 342563], [91, 342823], [95, 342923], [99, 343103], [104, 343303], [109, 343523], [114, 343863], [119, 344063], [123, 344223], [127, 344423], [133, 344703], [136, 344903]]}, {"verse": 45, "start": 345567, "end": 350932, "text": "¶ Then answered one of the lawyers, and said to him, Master, thus saying you reproach us also.", "words": [[2, 345567], [7, 345731], [16, 346071], [20, 346311], [23, 346411], [27, 346531], [36, 346851], [40, 347331], [45, 347571], [48, 347751], [53, 348325], [61, 348657], [66, 349027], [73, 349367], [77, 349587], [86, 350087], [89, 350267]]}, {"verse": 46, "start": 351282, "end": 360974, "text": "And he said, Woe to you also, you lawyers! for you load men with burdens grievous to be borne, and you yourselves touch not the burdens with one of your fingers.", "words": [[0, 351282], [4, 351416], [7, 351556], [13, 353015], [17, 353334], [20, 353394], [24, 353594], [30, 354174], [34, 354274], [43, 355272], [47, 355381], [51, 355541], [56, 355761], [60, 356001], [65, 356221], [73, 356541], [82, 357061], [85, 357201], [88, 357631], [95, 358061], [99, 358141], [103, 358281], [114, 358681], [120, 359061], [124, 359321], [128, 359501], [136, 359741], [141, 359981], [145, 360141], [148, 360241], [153, 360341]]}, {"verse": 47, "start": 361424, "end": 366258, "text": "Woe to you! for you build the tombs of the prophets, and your fathers killed them.", "words": [[0, 361424], [4, 361748], [7, 361848], [12, 362529], [16, 362662], [20, 362822], [26, 363082], [30, 363282], [36, 363802], [39, 363902], [43, 364002], [53, 364422], [57, 365002], [62, 365102], [70, 365442], [77, 365882]]}, {"verse": 48, "start": 366708, "end": 372981, "text": "Truly you bear witness that you allow the deeds of your fathers: for they indeed killed them, and you build their tombs.", "words": [[0, 366708], [6, 367167], [10, 367247], [15, 367447], [23, 367767], [28, 368027], [32, 368147], [38, 368407], [42, 368567], [48, 368867], [51, 369067], [56, 369167], [65, 370085], [69, 370201], [74, 370361], [81, 370761], [88, 371121], [94, 371821], [98, 371921], [102, 372101], [108, 372341], [114, 372661]]}, {"verse": 49, "start": 373431, "end": 381081, "text": "Therefore also said the wisdom of God, I will send them prophets and apostles, and some of them they shall slay and persecute:", "words": [[0, 373431], [10, 374171], [15, 374731], [20, 375031], [24, 375211], [31, 375491], [34, 375711], [39, 376391], [41, 376511], [46, 376651], [51, 376891], [56, 377071], [65, 377491], [69, 377711], [79, 378471], [83, 378691], [88, 378931], [91, 379051], [96, 379251], [101, 379451], [107, 379631], [112, 380111], [116, 380291]]}, {"verse": 50, "start": 381531, "end": 387827, "text": "That the blood of all the prophets, which was shed from the foundation of the world, may be required of this generation;", "words": [[0, 381531], [5, 381647], [9, 381767], [15, 382027], [18, 382227], [22, 382507], [26, 382647], [36, 383087], [42, 383727], [46, 383887], [51, 384167], [56, 384347], [60, 384467], [71, 384967], [74, 385187], [78, 385267], [85, 385607], [89, 386107], [92, 386247], [101, 386707], [104, 386947], [109, 387107]]}, {"verse": 51, "start": 388277, "end": 397581, "text": "From the blood of Abel to the blood of Zacharias, which perished between the altar and the temple: indeed I say to you, It shall be required of this generation.", "words": [[0, 388277], [5, 388421], [9, 388541], [15, 388761], [18, 388921], [23, 389341], [26, 389521], [30, 389641], [36, 389881], [39, 390041], [50, 391161], [56, 391321], [65, 391821], [73, 392081], [77, 392301], [83, 392581], [87, 392881], [91, 392981], [99, 393804], [106, 394288], [108, 394408], [112, 394628], [115, 394828], [120, 395348], [123, 395488], [129, 395688], [132, 395848], [141, 396308], [144, 396588], [149, 396728]]}, {"verse": 52, "start": 398031, "end": 406483, "text": "Woe to you, lawyers! for you have taken away the key of knowledge: you entered not in yourselves, and them that were entering in you hindered.", "words": [[0, 398031], [4, 398513], [7, 398593], [12, 398813], [21, 399907], [25, 399967], [29, 400107], [34, 400287], [40, 400587], [45, 400887], [49, 401107], [53, 401367], [56, 401547], [67, 402495], [71, 402615], [79, 402975], [83, 403275], [86, 403455], [98, 404275], [102, 404555], [107, 404815], [112, 405015], [117, 405135], [126, 405515], [129, 405775], [133, 405935]]}, {"verse": 53, "start": 406833, "end": 415062, "text": "And as he said these things to them, the scribes and the Pharisees began to urge him vehemently, and to provoke him to speak of many things:", "words": [[0, 406833], [4, 406959], [7, 407159], [10, 407279], [15, 407539], [21, 407759], [28, 408119], [31, 408339], [37, 409059], [41, 409139], [49, 409739], [53, 409859], [57, 409959], [67, 410639], [73, 410919], [76, 411179], [81, 411479], [85, 411679], [97, 412799], [101, 412839], [104, 412979], [112, 413299], [116, 413579], [119, 413719], [125, 413959], [128, 414139], [133, 414379]]}, {"verse": 54, "start": 415512, "end": 420437, "text": "Laying wait for him, and seeking to catch something out of his mouth, that they might accuse him.", "words": [[0, 415512], [7, 415750], [12, 416030], [16, 416290], [21, 416510], [25, 416850], [33, 417170], [36, 417410], [42, 417630], [52, 418010], [56, 418230], [59, 418330], [63, 418450], [70, 418830], [75, 419370], [80, 419530], [86, 419730], [93, 420030]]}]}