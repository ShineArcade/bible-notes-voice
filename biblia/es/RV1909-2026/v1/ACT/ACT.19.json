{"book": "ACT", "chapter": 19, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 365193, "verses": [{"verse": 1, "start": 300, "end": 10994, "text": "Y aconteció que entre tanto que Apolos estaba en Corinto, Pablo, andadas las regiones superiores, vino a Éfeso, y hallando ciertos discípulos,", "words": [[0, 300], [2, 410], [12, 1090], [16, 1370], [22, 1590], [28, 2010], [32, 2430], [39, 2850], [46, 3170], [49, 3350], [58, 4050], [65, 5010], [73, 5530], [77, 5930], [86, 6550], [98, 7530], [103, 7850], [105, 8050], [112, 8570], [114, 9150], [123, 9530], [131, 10110]]}, {"verse": 2, "start": 11344, "end": 20319, "text": "Les dijo: ¿Habéis recibido el Espíritu Santo después que creísteis? Y ellos le dijeron: Ni siquiera hemos oído si hay Espíritu Santo.", "words": [[0, 11344], [4, 11530], [10, 12305], [18, 12627], [27, 13287], [30, 13387], [39, 13907], [45, 14207], [53, 14627], [57, 14887], [68, 16403], [70, 16586], [76, 16806], [79, 16986], [88, 17885], [91, 18009], [100, 18329], [106, 18529], [111, 18889], [114, 19109], [118, 19249], [127, 19789]]}, {"verse": 3, "start": 20599, "end": 26750, "text": "Entonces dijo: ¿En qué pues sois bautizados? Y ellos dijeron: En el bautismo de Juan.", "words": [[0, 20599], [9, 21043], [15, 21953], [19, 22095], [23, 22295], [28, 22595], [33, 22855], [45, 24027], [47, 24193], [53, 24373], [62, 25366], [65, 25487], [68, 25587], [77, 26147], [80, 26307]]}, {"verse": 4, "start": 27030, "end": 37917, "text": "Y dijo Pablo: Juan bautizó con bautismo de arrepentimiento, diciendo al pueblo que creyesen en el que había de venir después de él, es decir, en Jesús el Cristo.", "words": [[0, 27030], [2, 27153], [7, 27393], [14, 28273], [19, 28483], [27, 29063], [31, 29243], [40, 29743], [43, 29903], [60, 31343], [69, 31683], [72, 31983], [79, 32283], [83, 32543], [92, 33183], [95, 33283], [98, 33403], [102, 33543], [108, 33783], [111, 34003], [117, 34263], [125, 34683], [128, 34943], [132, 35703], [135, 35723], [142, 36623], [145, 36723], [151, 37063], [154, 37383]]}, {"verse": 5, "start": 38197, "end": 43410, "text": "Oído que hubieron esto, fueron bautizados en el nombre del Señor Jesús.", "words": [[0, 38197], [5, 38582], [9, 38822], [18, 39262], [24, 39642], [31, 40117], [42, 41177], [45, 41477], [48, 41617], [55, 41977], [59, 42257], [65, 42557]]}, {"verse": 6, "start": 43760, "end": 52539, "text": "Y habiéndoles impuesto Pablo las manos, vino sobre ellos el Espíritu Santo; y hablaban en lenguas, y profetizaban.", "words": [[0, 43760], [2, 44043], [14, 44603], [23, 45223], [29, 45743], [33, 45943], [40, 46663], [45, 47003], [51, 47363], [57, 47683], [60, 47903], [69, 48503], [76, 49437], [78, 49582], [87, 50102], [90, 50302], [99, 51002], [101, 51302]]}, {"verse": 7, "start": 52889, "end": 55691, "text": "Y eran en todos como unos doce hombres.", "words": [[0, 52889], [2, 53056], [7, 53276], [10, 53476], [16, 53856], [21, 54256], [26, 54516], [31, 54936]]}, {"verse": 8, "start": 56041, "end": 65662, "text": "Y entrando él dentro de la sinagoga, hablaba libremente por espacio de tres meses, razonando y persuadiendo acerca del reino de Dios.", "words": [[0, 56041], [2, 56167], [11, 56707], [14, 56987], [21, 57467], [24, 57687], [27, 57807], [37, 58587], [45, 59607], [56, 60327], [60, 60547], [68, 60987], [71, 61207], [76, 61467], [83, 62267], [93, 63067], [95, 63167], [108, 63887], [115, 64227], [119, 64607], [125, 64987], [128, 65127]]}, {"verse": 9, "start": 66012, "end": 80303, "text": "Pero endureciéndose algunos y no creyendo, maldiciendo el Camino delante de la multitud, apartándose Pablo de ellos separó a los discípulos, razonando cada día en la escuela de un cierto Tirano.", "words": [[0, 66012], [5, 66676], [20, 67936], [28, 68296], [30, 68596], [33, 68736], [43, 69456], [55, 70296], [58, 70436], [65, 70796], [73, 71376], [76, 71476], [79, 71616], [89, 72556], [101, 73536], [107, 73896], [110, 74116], [116, 74669], [123, 75221], [125, 75321], [129, 75481], [141, 77141], [151, 77621], [156, 77861], [160, 78161], [163, 78301], [166, 78401], [174, 78681], [177, 78921], [180, 79081], [187, 79381]]}, {"verse": 10, "start": 80653, "end": 90586, "text": "Y esto fue por espacio de dos años; de manera que todos los que habitaban en Asia, judíos y griegos, oyeron la palabra del Señor Jesús.", "words": [[0, 80653], [2, 80815], [7, 81035], [11, 81295], [15, 81495], [23, 82035], [26, 82275], [30, 82515], [36, 83559], [39, 83667], [46, 83887], [50, 84187], [56, 84487], [60, 84927], [64, 85087], [74, 85627], [77, 85767], [83, 86447], [90, 87147], [92, 87287], [101, 88207], [108, 88667], [111, 88787], [119, 89167], [123, 89447], [129, 89767]]}, {"verse": 11, "start": 90936, "end": 94882, "text": "Y hacía Dios milagros extraordinarios por manos de Pablo:", "words": [[0, 90936], [2, 91173], [8, 91453], [13, 91633], [22, 92393], [38, 93533], [42, 93773], [48, 94073], [51, 94293]]}, {"verse": 12, "start": 95232, "end": 106631, "text": "De tal manera que aun se llevaban sobre los enfermos los pañuelos y los delantales de su cuerpo, y las enfermedades se iban de ellos, y los malos espíritus salían de ellos.", "words": [[0, 95232], [3, 95358], [7, 95538], [14, 95898], [18, 96158], [22, 96338], [25, 96578], [34, 97098], [40, 97338], [44, 97578], [53, 98318], [57, 98398], [66, 99138], [68, 99418], [72, 99538], [83, 100218], [86, 100358], [89, 100518], [97, 100938], [99, 101538], [103, 101718], [116, 102618], [119, 102898], [124, 103198], [127, 103398], [134, 104128], [136, 104230], [140, 104350], [146, 104770], [156, 105430], [163, 105850], [166, 106050]]}, {"verse": 13, "start": 106981, "end": 119797, "text": "Y algunos de los judíos, exorcistas itinerantes, intentaron invocar el nombre del Señor Jesús sobre los que tenían espíritus malos, diciendo: Os conjuro por Jesús, el que Pablo predica.", "words": [[0, 106981], [2, 107069], [10, 107389], [13, 107549], [17, 107689], [25, 108189], [36, 109039], [49, 109889], [60, 111069], [68, 111569], [71, 111749], [78, 112089], [82, 112309], [88, 112629], [94, 113229], [100, 113869], [104, 114089], [108, 114229], [115, 114629], [125, 115249], [132, 115989], [142, 116964], [145, 117107], [153, 117587], [157, 117747], [164, 118127], [167, 118667], [171, 118807], [177, 119127]]}, {"verse": 14, "start": 120077, "end": 127371, "text": "Y había siete hijos de un tal Esceva, judío, principal de los sacerdotes, que hacían esto.", "words": [[0, 120077], [2, 120194], [8, 120374], [14, 120834], [20, 121254], [23, 121514], [26, 121674], [30, 122284], [38, 122894], [45, 123934], [55, 124414], [58, 124714], [62, 124854], [74, 126074], [78, 126314], [85, 126814]]}, {"verse": 15, "start": 127721, "end": 134885, "text": "Y respondiendo el espíritu malo, dijo: A Jesús conozco, y sé quién es Pablo: pero vosotros ¿quiénes sois?", "words": [[0, 127768], [2, 127848], [15, 128668], [18, 128748], [27, 129268], [33, 129628], [39, 130530], [41, 130654], [47, 130894], [56, 131674], [58, 131814], [61, 131954], [67, 132154], [70, 132394], [77, 133162], [82, 133306], [91, 133806], [100, 134306]]}, {"verse": 16, "start": 135165, "end": 146649, "text": "Y el hombre en quien estaba el espíritu malo, saltando sobre ellos y dominándolos, pudo más que ellos, de tal manera que huyeron de aquella casa desnudos y heridos.", "words": [[0, 135165], [2, 135308], [5, 135448], [12, 135748], [15, 135968], [21, 136108], [28, 136588], [31, 136788], [40, 137328], [46, 138288], [55, 139008], [61, 139348], [67, 139728], [69, 140068], [83, 141228], [88, 141488], [92, 141688], [96, 141848], [103, 142788], [106, 142908], [110, 143128], [117, 143428], [121, 143708], [129, 144108], [132, 144228], [140, 144528], [145, 144788], [154, 145608], [156, 145868]]}, {"verse": 17, "start": 146999, "end": 158463, "text": "Y esto fue notorio a todos, así judíos como griegos, los que habitaban en Éfeso: y cayó temor sobre todos ellos, y era magnificado el nombre del Señor Jesús.", "words": [[0, 146999], [2, 147127], [7, 147347], [11, 147567], [19, 148067], [21, 148187], [28, 149087], [32, 149307], [39, 149867], [44, 150087], [53, 150667], [57, 151107], [61, 151287], [71, 151867], [74, 152147], [81, 153053], [83, 153163], [88, 153543], [94, 153963], [100, 154263], [106, 154643], [113, 155623], [115, 155843], [119, 155983], [131, 156863], [134, 156983], [141, 157303], [145, 157543], [151, 157843]]}, {"verse": 18, "start": 158813, "end": 164180, "text": "Y muchos de los que habían creído, venían, confesando y dando cuenta de sus hechos.", "words": [[0, 158813], [2, 158936], [9, 159316], [12, 159716], [16, 159836], [20, 159976], [27, 160216], [35, 160656], [43, 161476], [54, 162276], [56, 162496], [62, 162716], [69, 163136], [72, 163376], [76, 163536]]}, {"verse": 19, "start": 164530, "end": 178172, "text": "Asimismo muchos de los que habían practicado artes mágicas, trajeron los libros, y los quemaron delante de todos; y echada la cuenta del precio de ellos, hallaron ser cincuenta mil denarios.", "words": [[0, 164870], [9, 165210], [16, 165490], [19, 165690], [23, 165770], [27, 165890], [34, 166150], [45, 166850], [51, 167330], [60, 167990], [69, 169090], [73, 169250], [81, 170030], [83, 170210], [87, 170310], [96, 170710], [104, 171150], [107, 171290], [114, 172174], [116, 172335], [123, 172715], [126, 172875], [133, 173215], [137, 173535], [144, 174015], [147, 174255], [154, 175195], [163, 175815], [167, 176308], [177, 176802], [181, 177295]]}, {"verse": 20, "start": 178522, "end": 183493, "text": "Así crecía poderosamente la palabra del Señor, y prevalecía.", "words": [[0, 178522], [4, 178882], [11, 179362], [25, 180262], [28, 180442], [36, 180842], [40, 181082], [47, 181462], [49, 182082]]}, {"verse": 21, "start": 183843, "end": 196112, "text": "Y acabadas estas cosas, se propuso Pablo en espíritu partir a Jerusalén, después de andada Macedonia y Acaya, diciendo: Después que haya estado allá, también debo ver Roma.", "words": [[0, 183843], [2, 183987], [11, 184507], [17, 184807], [24, 185747], [27, 185967], [35, 186507], [41, 186987], [44, 187207], [53, 187627], [60, 188047], [62, 188467], [73, 189542], [81, 189742], [84, 189962], [91, 190282], [101, 191042], [103, 191582], [110, 192122], [120, 192988], [128, 193312], [132, 193532], [137, 193732], [144, 194052], [150, 194952], [158, 195182], [163, 195412], [167, 195652]]}, {"verse": 22, "start": 196392, "end": 204289, "text": "Y enviando a Macedonia a dos de los que le ayudaban, Timoteo y Erasto, él se estuvo por algún tiempo en Asia.", "words": [[0, 196392], [2, 196539], [11, 197059], [13, 197179], [23, 197859], [25, 198119], [29, 198339], [32, 198619], [36, 198739], [40, 198879], [43, 198999], [53, 199919], [61, 200679], [63, 200899], [71, 201999], [74, 202159], [77, 202339], [84, 202739], [88, 202959], [94, 203239], [101, 203579], [104, 203779]]}, {"verse": 23, "start": 204639, "end": 209282, "text": "Entonces hubo un alboroto no pequeño acerca del Camino.", "words": [[0, 204639], [9, 205117], [14, 205917], [17, 206037], [26, 206657], [29, 206997], [37, 207557], [44, 207917], [48, 208337]]}, {"verse": 24, "start": 209632, "end": 218487, "text": "Porque un platero llamado Demetrio, el cual hacía de plata templecillos de Diana, daba a los artífices no poca ganancia;", "words": [[0, 209632], [7, 209813], [10, 209993], [18, 210453], [26, 210633], [36, 211653], [39, 211653], [44, 211873], [50, 212473], [53, 212673], [59, 213373], [72, 214073], [75, 214293], [82, 215113], [87, 215373], [89, 215473], [93, 215593], [103, 216433], [106, 217013], [111, 217613]]}, {"verse": 25, "start": 218837, "end": 226612, "text": "A los cuales, reunidos con los trabajadores de oficio semejante, dijo: Varones, sabéis que de este oficio tenemos ganancia;", "words": [[0, 218837], [2, 218924], [6, 219044], [14, 219744], [23, 220504], [27, 220664], [31, 220824], [44, 221504], [47, 222024], [54, 222544], [65, 223064], [71, 223975], [80, 224145], [87, 224585], [91, 224765], [94, 224925], [99, 225105], [106, 225525], [114, 225845]]}, {"verse": 26, "start": 226962, "end": 236203, "text": "Y veis y oís que este Pablo, no solo en Éfeso, sino en casi toda Asia ha apartado con persuasión a muchas gentes, diciendo, que no son dioses los que se hacen con las manos.", "words": [[0, 226962], [2, 227085], [7, 227405], [9, 227505], [13, 227725], [17, 227865], [22, 228025], [29, 228605], [32, 228705], [37, 228985], [40, 229165], [47, 229605], [52, 229705], [55, 229845], [60, 230005], [65, 230305], [70, 230925], [73, 230925], [82, 231325], [86, 231445], [97, 232065], [99, 232145], [106, 232305], [114, 232805], [124, 233773], [128, 233854], [131, 233974], [135, 234174], [142, 234554], [146, 234774], [150, 234934], [153, 235074], [159, 235314], [163, 235494], [167, 235674]]}, {"verse": 27, "start": 236553, "end": 250039, "text": "Y no solamente hay peligro de que este negocio se nos vuelva en reproche, sino también que el templo de la gran diosa Diana sea estimado en nada, y comience a ser destruida su majestad, la cual honra toda el Asia y el mundo.", "words": [[0, 236553], [2, 236676], [5, 236756], [15, 237136], [19, 237396], [27, 237856], [30, 237956], [34, 238076], [39, 238296], [47, 238736], [50, 238856], [54, 238976], [61, 239336], [64, 239436], [74, 240456], [79, 240636], [87, 240996], [91, 241216], [94, 241316], [101, 241756], [104, 241816], [107, 242096], [112, 242376], [118, 242656], [124, 242936], [128, 243241], [137, 243881], [140, 244001], [146, 244614], [148, 244706], [157, 245166], [159, 245386], [163, 245546], [173, 246206], [176, 246386], [186, 247466], [189, 247686], [194, 247906], [200, 248426], [205, 248686], [208, 248946], [213, 249246], [215, 249466], [218, 249586]]}, {"verse": 28, "start": 250319, "end": 258732, "text": "Oídas estas cosas, se llenaron de ira, y dieron alarido, diciendo: ¡Grande es Diana de los efesios!", "words": [[0, 250319], [6, 250902], [12, 251122], [19, 252062], [22, 252422], [31, 252942], [34, 253182], [39, 253622], [41, 254042], [48, 254822], [57, 255602], [67, 256711], [75, 257036], [78, 257336], [84, 257656], [87, 257836], [91, 258311]]}, {"verse": 29, "start": 259012, "end": 269352, "text": "Y la ciudad se llenó de confusión; y unánimes se arrojaron al teatro, arrebatando a Gayo y a Aristarco, macedonios, compañeros de Pablo.", "words": [[0, 259012], [2, 259136], [5, 259236], [12, 259596], [15, 260096], [21, 260496], [24, 260576], [35, 261656], [37, 262044], [46, 262464], [49, 262944], [59, 263724], [62, 263884], [70, 264764], [82, 265524], [84, 265794], [89, 266064], [91, 266184], [93, 266264], [104, 267284], [116, 268224], [127, 268744], [130, 268864]]}, {"verse": 30, "start": 269352, "end": 274013, "text": "Y queriendo Pablo salir al pueblo, los discípulos no le dejaron.", "words": [[0, 269352], [2, 269552], [12, 269972], [18, 270392], [24, 270732], [27, 271552], [35, 271952], [39, 272472], [50, 273152], [53, 273252], [56, 273372]]}, {"verse": 31, "start": 274363, "end": 281749, "text": "También algunos de los principales de Asia, que eran sus amigos, enviaron a él rogando que no se presentase en el teatro.", "words": [[0, 274363], [8, 274671], [16, 275131], [19, 275291], [23, 275411], [35, 276051], [38, 276231], [44, 276511], [48, 276791], [53, 276991], [57, 277171], [65, 277631], [74, 278611], [76, 278791], [79, 278971], [87, 279711], [91, 279911], [94, 280051], [97, 280171], [108, 280811], [111, 280991], [114, 281111]]}, {"verse": 32, "start": 282099, "end": 289909, "text": "Y otros gritaban otra cosa; porque la asamblea estaba confusa, y los más no sabían por qué se habían reunido.", "words": [[0, 282099], [2, 282285], [8, 282525], [17, 283285], [22, 283505], [28, 284304], [35, 284589], [38, 284829], [47, 285489], [54, 285729], [63, 286529], [65, 287229], [69, 287389], [73, 287689], [76, 287934], [83, 288354], [87, 288574], [91, 288734], [94, 288874], [101, 289114]]}, {"verse": 33, "start": 290259, "end": 302138, "text": "Y sacaron de entre la multitud a Alejandro, empujándole los judíos. Entonces Alejandro, habiendo hecho señal de silencio con la mano, quería dar razón al pueblo.", "words": [[0, 290259], [2, 290367], [10, 290867], [13, 291127], [19, 291427], [22, 291647], [31, 292227], [33, 292507], [44, 293627], [56, 294607], [60, 294787], [68, 295798], [77, 296833], [88, 297903], [97, 298283], [103, 298483], [109, 298963], [112, 299063], [121, 299623], [125, 299803], [128, 299943], [134, 300343], [141, 300523], [145, 300823], [151, 301223], [154, 301423]]}, {"verse": 34, "start": 302488, "end": 311179, "text": "Pero como conocieron que era judío, se oyó una sola voz de todos, que gritaron casi por dos horas: ¡Grande es Diana de los efesios!", "words": [[0, 302488], [5, 302668], [10, 302908], [21, 303508], [25, 303708], [29, 303828], [36, 304708], [39, 304848], [43, 305168], [47, 305348], [52, 305648], [56, 305908], [59, 306068], [66, 306708], [70, 306948], [79, 307488], [84, 307788], [88, 308108], [92, 308288], [99, 309158], [107, 309483], [110, 309783], [116, 310103], [119, 310283], [123, 310758]]}, {"verse": 35, "start": 311459, "end": 326603, "text": "Entonces el secretario de la ciudad, apaciguado que hubo la gente, dijo: Varones efesios, ¿y quién hay de los hombres que no sepa que la ciudad de los efesios es honradora de la gran diosa Diana, y de la imagen venida de Júpiter?", "words": [[0, 311459], [9, 312501], [12, 312781], [23, 313561], [26, 313681], [29, 313821], [37, 314801], [48, 315641], [52, 315861], [57, 316274], [60, 316688], [67, 317101], [73, 318308], [81, 318782], [90, 319255], [93, 319335], [99, 319475], [103, 319655], [106, 319735], [110, 319895], [118, 320155], [122, 320375], [125, 320495], [130, 320835], [134, 320955], [137, 321075], [144, 321335], [147, 321575], [151, 321925], [159, 322275], [162, 322575], [172, 323315], [175, 323455], [178, 323655], [183, 323855], [189, 324055], [196, 324877], [198, 324978], [201, 325058], [204, 325158], [211, 325478], [218, 325878], [221, 325998]]}, {"verse": 36, "start": 326953, "end": 333360, "text": "Así que, pues esto no puede ser contradicho, conviene que os apacigüéis, y que nada hagáis precipitadamente;", "words": [[0, 326953], [4, 327194], [9, 327394], [14, 327634], [19, 328074], [22, 328274], [28, 328494], [32, 328734], [45, 329614], [54, 330034], [58, 330194], [61, 330674], [73, 331154], [75, 331314], [79, 331434], [84, 331694], [91, 332174]]}, {"verse": 37, "start": 333710, "end": 338351, "text": "Pues habéis traído a estos hombres, sin ser sacrílegos ni blasfemadores de vuestra diosa.", "words": [[0, 333710], [5, 333811], [12, 334111], [19, 334451], [21, 334551], [27, 334731], [36, 335171], [40, 335611], [44, 335871], [55, 336591], [58, 336711], [72, 337411], [75, 337631], [83, 337931]]}, {"verse": 38, "start": 338701, "end": 347844, "text": "Que si Demetrio y los trabajadores que están con él tienen una acusación contra alguno, los tribunales están abiertos, y procónsules hay; acúsense los unos a los otros.", "words": [[0, 338701], [4, 338777], [7, 338897], [16, 339417], [18, 339497], [22, 339597], [35, 340197], [39, 340397], [45, 340617], [49, 340837], [52, 340977], [59, 341217], [63, 341517], [73, 342077], [80, 342377], [88, 343137], [92, 343237], [103, 343697], [109, 343997], [119, 344617], [121, 344757], [133, 345297], [138, 345929], [147, 346430], [151, 346650], [156, 346870], [158, 347170], [162, 347310]]}, {"verse": 39, "start": 348194, "end": 352300, "text": "Y si pedís alguna otra cosa, en legítima asamblea se pueda decidir.", "words": [[0, 348194], [2, 348283], [5, 348383], [11, 348783], [18, 349063], [23, 349303], [29, 349683], [32, 349983], [41, 350543], [50, 351163], [53, 351383], [59, 351643]]}, {"verse": 40, "start": 352650, "end": 364793, "text": "Porque peligro hay de que seamos acusados de causar disturbios por hoy, no habiendo ninguna causa por la cual podamos dar razón de esta reunión. Y habiendo dicho esto, despidió la asamblea.", "words": [[0, 352650], [7, 352850], [15, 353330], [19, 353470], [22, 353610], [26, 353690], [33, 354030], [42, 354610], [45, 354750], [52, 355190], [63, 355730], [67, 355970], [72, 356550], [75, 356710], [84, 357010], [92, 357350], [98, 357730], [102, 357990], [105, 358130], [110, 358270], [118, 358770], [122, 358970], [128, 359330], [131, 359550], [136, 359730], [145, 360673], [147, 360814], [156, 361174], [162, 361514], [168, 362614], [177, 363654], [180, 363874]]}]}