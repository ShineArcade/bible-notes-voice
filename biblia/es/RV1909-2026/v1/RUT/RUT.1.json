{"book": "RUT", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 216052, "verses": [{"verse": 1, "start": 300, "end": 13770, "text": "Y aconteció en los días que gobernaban los jueces, que hubo hambre en la tierra. Y un varón de Belén de Judá, fue a morar en los campos de Moab, él y su mujer, y dos hijos suyos.", "words": [[0, 300], [2, 482], [12, 1302], [15, 1482], [19, 1622], [24, 2002], [28, 2342], [39, 3102], [43, 3342], [51, 4522], [55, 4582], [60, 4982], [67, 5442], [70, 5742], [73, 5902], [81, 6672], [83, 6795], [86, 6935], [92, 7295], [95, 7435], [101, 7775], [104, 7875], [110, 8295], [114, 8475], [116, 8615], [122, 9015], [125, 9135], [129, 9275], [136, 9835], [139, 9935], [145, 10955], [148, 11375], [150, 11595], [153, 11755], [160, 12215], [162, 12430], [166, 12670], [172, 12890]]}, {"verse": 2, "start": 14120, "end": 29044, "text": "El nombre de aquel varón era Elimelec, y el de su mujer Noemí; y los nombres de sus dos hijos eran, Mahlón y Quelión, efrateos de Belén de Judá. Llegaron pues a los campos de Moab, y asentaron allí.", "words": [[0, 14120], [3, 14261], [10, 14621], [13, 14821], [19, 15121], [25, 15581], [29, 16261], [39, 16941], [41, 17176], [44, 17316], [47, 17516], [50, 17696], [56, 18116], [63, 19174], [65, 19261], [69, 19381], [77, 19841], [80, 20001], [84, 20181], [88, 20401], [94, 20761], [100, 21391], [107, 22021], [109, 22581], [118, 23141], [127, 23801], [130, 23941], [136, 24321], [139, 24441], [145, 25230], [154, 25697], [159, 25937], [161, 26137], [165, 26277], [172, 26797], [175, 26917], [181, 27397], [183, 27857], [193, 28537]]}, {"verse": 3, "start": 29394, "end": 33905, "text": "Y murió Elimelec, marido de Noemí, y quedó ella con sus dos hijos;", "words": [[0, 29394], [2, 29523], [8, 30173], [18, 30823], [25, 31223], [28, 31363], [35, 32063], [37, 32203], [43, 32503], [48, 32703], [52, 32923], [56, 33103], [60, 33303]]}, {"verse": 4, "start": 34255, "end": 43080, "text": "Los cuales se casaron con mujeres moabitas, el nombre de la una Orfa, y el nombre de la otra Ruth; y habitaron allí unos diez años.", "words": [[0, 34255], [4, 34362], [11, 34562], [14, 34782], [22, 35242], [26, 35422], [34, 36130], [44, 36837], [47, 36957], [54, 37297], [57, 37517], [60, 37657], [64, 37857], [70, 38537], [72, 38912], [75, 39072], [82, 39472], [85, 39672], [88, 39812], [93, 40287], [99, 40924], [101, 41000], [111, 41560], [116, 41800], [121, 42070], [126, 42340]]}, {"verse": 5, "start": 43430, "end": 51333, "text": "Y murieron también los dos, Mahlón y Quelión, quedando así la mujer desamparada de sus dos hijos y de su marido.", "words": [[0, 43430], [2, 43572], [11, 44032], [19, 44392], [23, 44732], [28, 45502], [35, 46272], [37, 46785], [46, 47297], [55, 47657], [59, 47837], [62, 47957], [68, 48277], [80, 49157], [83, 49317], [87, 49517], [91, 49777], [97, 50177], [99, 50437], [102, 50537], [105, 50697]]}, {"verse": 6, "start": 51683, "end": 62666, "text": "Entonces se levantó con sus nueras, y se volvió de los campos de Moab: porque oyó en el campo de Moab que Jehová había visitado a su pueblo para darles pan.", "words": [[0, 51683], [9, 52350], [12, 53030], [20, 53550], [24, 53710], [28, 53890], [36, 54390], [38, 54665], [41, 54805], [48, 55165], [51, 55265], [55, 55385], [62, 55865], [65, 55965], [71, 56749], [78, 57011], [82, 57511], [85, 57671], [88, 57811], [94, 58131], [97, 58411], [102, 58991], [106, 59431], [113, 59951], [119, 60231], [128, 60911], [130, 60991], [133, 61111], [140, 61431], [145, 61731], [152, 62151]]}, {"verse": 7, "start": 63016, "end": 70796, "text": "Salió pues del lugar donde había estado, y con ella sus dos nueras, y comenzaron a caminar para volverse a la tierra de Judá.", "words": [[0, 63016], [6, 63416], [11, 63656], [15, 63936], [21, 64356], [27, 64656], [33, 65016], [41, 65456], [43, 65656], [47, 65876], [52, 66036], [56, 66236], [60, 66496], [68, 67176], [70, 67616], [81, 68216], [83, 68336], [91, 68796], [96, 69016], [105, 69556], [107, 69716], [110, 69756], [117, 70076], [120, 70296]]}, {"verse": 8, "start": 71146, "end": 83180, "text": "Y Noemí dijo a sus dos nueras: Andad, volveos cada una a la casa de su madre: Jehová haga con vosotras misericordia, como la habéis hecho con los muertos y conmigo.", "words": [[0, 71325], [2, 71405], [8, 71746], [13, 72445], [15, 72845], [19, 72985], [23, 73265], [31, 74385], [38, 74909], [46, 75449], [51, 75689], [55, 76089], [57, 76289], [60, 76329], [65, 76609], [68, 76809], [71, 76949], [78, 77723], [85, 78224], [90, 78484], [94, 78724], [103, 79264], [117, 80564], [122, 80684], [125, 80934], [132, 81184], [138, 81484], [142, 81684], [146, 81844], [154, 82324], [156, 82504]]}, {"verse": 9, "start": 83530, "end": 94815, "text": "Os conceda Jehová que halléis descanso, cada una en casa de su marido: las besó luego, y ellas lloraron a voz en grito.", "words": [[0, 83600], [3, 83670], [11, 84290], [18, 84730], [22, 84930], [30, 85310], [40, 86210], [45, 86460], [49, 86710], [52, 86870], [57, 87090], [60, 87330], [63, 87450], [71, 90550], [75, 90749], [80, 91349], [87, 91849], [89, 92144], [95, 92424], [104, 93364], [106, 93584], [110, 93824], [113, 94144]]}, {"verse": 10, "start": 95165, "end": 100017, "text": "Y le dijeron: Ciertamente nosotras volveremos contigo a tu pueblo.", "words": [[0, 95165], [2, 95313], [5, 95413], [14, 96378], [26, 97264], [35, 98024], [46, 98724], [54, 99244], [56, 99364], [59, 99444]]}, {"verse": 11, "start": 100297, "end": 108274, "text": "Y Noemí respondió: Volveos, hijas mías: ¿para qué habéis de ir conmigo? ¿tengo yo más hijos en el vientre, que puedan ser vuestros maridos?", "words": [[0, 100297], [2, 100529], [8, 100799], [19, 101800], [28, 102405], [34, 102725], [40, 103385], [46, 103554], [50, 103714], [57, 104014], [60, 104134], [63, 104234], [72, 105156], [79, 105353], [82, 105513], [86, 105693], [92, 105913], [95, 106153], [98, 106273], [107, 106633], [111, 106733], [118, 106973], [122, 107213], [131, 107573]]}, {"verse": 12, "start": 108624, "end": 118650, "text": "Volveos, hijas mías, e idos; que yo ya soy vieja para tener marido. Y aunque dijese: Esperanza tengo; y esta noche fuese con varón, y aun pariese hijos;", "words": [[0, 108624], [9, 109150], [15, 109370], [21, 109777], [23, 110184], [29, 110772], [33, 110856], [36, 110996], [39, 111136], [43, 111296], [49, 111676], [54, 111856], [60, 112096], [68, 112968], [70, 113096], [77, 113256], [85, 114142], [95, 114750], [102, 115507], [104, 115633], [109, 115833], [115, 116073], [121, 116473], [125, 116693], [132, 117173], [134, 117393], [138, 117513], [146, 117993]]}, {"verse": 13, "start": 119000, "end": 132069, "text": "¿Habíais vosotras de esperarlos hasta que fuesen grandes? ¿habíais vosotras de quedaros sin casar por amor de ellos? No, hijas mías; que mayor amargura tengo yo que vosotras, pues la mano de Jehová ha salido contra mí.", "words": [[0, 119000], [9, 119384], [18, 119944], [21, 120044], [32, 120584], [38, 120824], [42, 120964], [49, 121384], [58, 122278], [67, 122662], [76, 123222], [79, 123342], [88, 123702], [92, 123902], [98, 124262], [102, 124442], [107, 124642], [110, 124862], [117, 125555], [121, 125785], [127, 126205], [133, 127051], [137, 127135], [143, 127435], [152, 127975], [158, 128255], [161, 128475], [165, 128615], [175, 129655], [180, 129735], [183, 129955], [188, 130175], [191, 130495], [198, 130815], [201, 130975], [208, 131395], [215, 131695]]}, {"verse": 14, "start": 132349, "end": 139887, "text": "Mas ellas alzando otra vez su voz, lloraron: y Orfa besó a su suegra, mas Ruth se quedó con ella.", "words": [[0, 132349], [4, 132554], [10, 133214], [18, 133754], [23, 134014], [27, 134314], [30, 134514], [35, 135234], [45, 136405], [47, 136630], [52, 136855], [57, 137080], [59, 137392], [62, 137704], [70, 138016], [74, 138328], [79, 138640], [82, 138980], [88, 139320], [92, 139520]]}, {"verse": 15, "start": 140237, "end": 146625, "text": "Y Noemí dijo: He aquí tu cuñada se ha vuelto a su pueblo y a sus dioses; vuélvete tú tras ella.", "words": [[0, 140237], [2, 140462], [8, 140722], [14, 141677], [17, 141677], [22, 142017], [25, 142217], [32, 142717], [35, 142897], [38, 142997], [45, 143297], [47, 143417], [50, 143517], [57, 143877], [59, 144117], [61, 144177], [65, 144357], [73, 145300], [82, 145729], [85, 145929], [90, 146169]]}, {"verse": 16, "start": 146905, "end": 159577, "text": "Y Ruth respondió: No me ruegues que te deje, y me aparte de ti: porque donde quiera que tú vayas, iré yo; y donde quiera que vivas, viviré. Tu pueblo será mi pueblo, y tu Dios mi Dios.", "words": [[0, 146905], [2, 147333], [7, 147799], [18, 148811], [21, 148998], [24, 149248], [32, 149498], [36, 149638], [39, 149798], [45, 150198], [47, 150418], [50, 150538], [57, 150958], [60, 151078], [64, 151650], [71, 151854], [77, 152034], [84, 152454], [88, 152594], [91, 152754], [98, 153254], [102, 153594], [106, 154199], [108, 154307], [114, 154427], [121, 154847], [125, 155007], [132, 155627], [140, 156370], [143, 156452], [150, 156812], [155, 157112], [158, 157332], [166, 157792], [168, 158372], [171, 158532], [176, 158812], [179, 159072]]}, {"verse": 17, "start": 159927, "end": 168461, "text": "Donde tú mueras, moriré yo, y allí seré sepultada: que el Señor me castigue severamente si algo que no sea la muerte me separa de ti.", "words": [[0, 159927], [6, 160132], [9, 160412], [17, 160812], [24, 161332], [28, 161952], [30, 162012], [35, 162232], [40, 162612], [51, 163675], [55, 163757], [58, 163877], [64, 164177], [67, 164437], [76, 164937], [88, 165757], [91, 165977], [96, 166237], [100, 166417], [103, 166557], [107, 166777], [110, 166977], [117, 167257], [120, 167517], [127, 167997], [130, 168117]]}, {"verse": 18, "start": 168741, "end": 173982, "text": "Y viendo Noemí que estaba tan resuelta a ir con ella, dejó de insistirle.", "words": [[0, 168741], [2, 168867], [9, 169187], [15, 169867], [19, 169927], [26, 170247], [30, 170527], [39, 171127], [41, 171227], [44, 171367], [48, 171587], [54, 172287], [59, 172707], [62, 172807]]}, {"verse": 19, "start": 174332, "end": 186608, "text": "Anduvieron pues ellas dos hasta que llegaron a Belén: y aconteció que entrando en Belén, toda la ciudad se conmovió por razón de ellas, y decían: ¿No es esta Noemí?", "words": [[0, 174332], [11, 174669], [16, 175049], [22, 175429], [26, 175809], [32, 176509], [36, 176669], [45, 177089], [47, 177169], [54, 177999], [56, 178119], [66, 178799], [70, 179059], [79, 179519], [82, 179699], [89, 180659], [94, 180839], [97, 181119], [104, 181439], [107, 181779], [116, 182499], [120, 182699], [126, 183079], [129, 183399], [136, 184119], [138, 184439], [146, 185329], [150, 185512], [153, 185772], [158, 186012]]}, {"verse": 20, "start": 186888, "end": 195042, "text": "Y ella les respondía: No me llaméis Noemí, sino llamadme Mara: porque en grande amargura me ha puesto el Todopoderoso.", "words": [[0, 186888], [2, 187071], [7, 187391], [11, 187671], [22, 188926], [25, 189112], [28, 189232], [36, 189672], [43, 190512], [48, 190962], [57, 191412], [63, 192065], [70, 192241], [73, 192421], [80, 192701], [89, 193261], [92, 193421], [95, 193561], [102, 193801], [105, 193981]]}, {"verse": 21, "start": 195392, "end": 204821, "text": "Yo me fui llena, pero vacía me ha vuelto Jehová. ¿Por qué me llamaréis Noemí, ya que Jehová ha dado testimonio contra mí, y el Todopoderoso me ha afligido?", "words": [[0, 195392], [3, 195557], [6, 195677], [10, 195837], [17, 196537], [22, 196677], [28, 197177], [31, 197317], [34, 197397], [41, 197869], [49, 198499], [54, 198599], [58, 198759], [61, 198899], [71, 199379], [78, 200219], [81, 200479], [85, 200619], [92, 201059], [95, 201119], [100, 201319], [111, 201979], [118, 202259], [122, 202499], [124, 202939], [127, 203079], [140, 203799], [143, 203999], [146, 204139]]}, {"verse": 22, "start": 205101, "end": 215652, "text": "Así volvió Noemí y Ruth moabita su nuera con ella; volvió de los campos de Moab, y llegaron a Belén en el principio de la siega de las cebadas.", "words": [[0, 205101], [4, 205421], [11, 205921], [17, 206321], [19, 206601], [24, 206881], [32, 207621], [35, 207861], [41, 208221], [45, 208501], [51, 209232], [58, 209758], [61, 209878], [65, 209998], [72, 210538], [75, 210618], [81, 211158], [83, 211618], [92, 212038], [94, 212298], [100, 212678], [103, 212878], [106, 213038], [116, 213558], [119, 213938], [122, 214188], [128, 214438], [131, 214618], [135, 214778]]}]}