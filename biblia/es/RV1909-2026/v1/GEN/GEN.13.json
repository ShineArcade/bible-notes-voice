{"book": "GEN", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 161140, "verses": [{"verse": 1, "start": 300, "end": 8106, "text": "Subió, pues, Abram de Egipto hacia el sur, él, y su mujer, con todo lo que tenía, y con él Lot.", "words": [[0, 300], [7, 678], [13, 1108], [19, 1538], [22, 1898], [29, 2438], [35, 2598], [38, 2938], [43, 3638], [47, 4098], [49, 4678], [52, 4818], [59, 5538], [63, 5698], [68, 5878], [71, 6058], [75, 6158], [82, 7018], [84, 7118], [88, 7298], [91, 7458]]}, {"verse": 2, "start": 8456, "end": 12206, "text": "Y Abram era riquísimo en ganado, en plata y oro.", "words": [[0, 8456], [2, 8645], [8, 8871], [12, 9098], [22, 9671], [25, 10245], [33, 10818], [36, 11078], [42, 11458], [44, 11798]]}, {"verse": 3, "start": 12556, "end": 21115, "text": "Y volvió por sus jornadas desde el Neguev hacia Bet-el, hasta el lugar donde había estado antes su tienda entre Bet-el y Hai;", "words": [[0, 12556], [2, 12702], [9, 13102], [13, 13282], [17, 13482], [26, 14122], [32, 14762], [35, 15312], [42, 15862], [48, 16302], [56, 17202], [62, 17522], [65, 17742], [71, 18022], [77, 18282], [83, 18542], [90, 18822], [96, 19142], [99, 19402], [106, 19782], [112, 20002], [119, 20522], [121, 20844]]}, {"verse": 4, "start": 21465, "end": 28048, "text": "Al lugar del altar que había hecho allí antes: e invocó allí Abram el nombre de Jehová.", "words": [[0, 21465], [3, 21630], [9, 21930], [13, 22190], [19, 22610], [23, 22830], [29, 23090], [35, 23400], [40, 23710], [47, 24738], [49, 24882], [56, 25702], [61, 26042], [67, 26382], [70, 26762], [77, 27162], [80, 27382]]}, {"verse": 5, "start": 28398, "end": 34631, "text": "Y asimismo Lot, que andaba con Abram, tenía ovejas, y vacas, y tiendas.", "words": [[0, 28398], [2, 28885], [11, 29415], [16, 30075], [20, 30335], [27, 30735], [31, 30975], [38, 31525], [44, 32075], [52, 32715], [54, 33075], [61, 33615], [63, 33795]]}, {"verse": 6, "start": 34981, "end": 43918, "text": "