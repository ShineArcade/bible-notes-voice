{"book": "MRK", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 432708, "verses": [{"verse": 1, "start": 300, "end": 10747, "text": "Y partiéndose de allí, vino a la región de Judea y tras el Jordán: y volvió el pueblo a juntarse a él; y de nuevo les enseñaba como solía.", "words": [[0, 300], [2, 402], [14, 1302], [17, 1522], [23, 1882], [28, 2842], [30, 3102], [33, 3182], [40, 3542], [43, 3742], [49, 4282], [51, 4402], [56, 4602], [59, 4842], [67, 5814], [69, 6182], [76, 6562], [79, 6662], [86, 6882], [88, 7122], [97, 7662], [99, 7802], [103, 8022], [105, 8262], [108, 8582], [114, 8822], [118, 9142], [127, 9822], [132, 10082]]}, {"verse": 2, "start": 11097, "end": 19333, "text": "Y llegándose los fariseos, le preguntaron, para ponerlo a prueba, si era lícito al marido divorciarse de su mujer.", "words": [[0, 11097], [2, 11218], [13, 11938], [17, 12138], [27, 12978], [30, 13678], [43, 14378], [48, 14693], [56, 15253], [58, 15353], [66, 15753], [69, 16393], [73, 16553], [80, 17073], [83, 17253], [90, 17653], [102, 18453], [105, 18673], [108, 18833]]}, {"verse": 3, "start": 19333, "end": 23177, "text": "Pero él respondiendo, les dijo: ¿Qué os mandó Moisés?", "words": [[0, 19333], [5, 19533], [8, 20093], [22, 20893], [26, 20993], [32, 21744], [37, 21845], [40, 21985], [46, 22365]]}, {"verse": 4, "start": 23527, "end": 28960, "text": "Y ellos dijeron: Moisés permitió escribir un certificado de divorcio y divorciarse.", "words": [[0, 23527], [2, 23654], [8, 23814], [17, 24677], [24, 25021], [33, 25721], [42, 26201], [45, 26321], [57, 27101], [60, 27221], [69, 27861], [71, 28081]]}, {"verse": 5, "start": 29240, "end": 35372, "text": "Y respondiendo Jesús, les dijo: Por la dureza de vuestro corazón os escribió este mandamiento;", "words": [[0, 29240], [2, 29362], [15, 30022], [22, 30402], [26, 30922], [32, 31665], [36, 31788], [39, 31988], [46, 32448], [49, 32608], [57, 32988], [65, 33468], [68, 33728], [77, 34308], [82, 34468]]}, {"verse": 6, "start": 35722, "end": 40184, "text": "Pero al principio de la creación, varón y hembra los hizo Dios.", "words": [[0, 35722], [5, 35863], [8, 36043], [18, 36583], [21, 36943], [24, 37083], [34, 37983], [40, 38543], [42, 38763], [49, 39183], [53, 39343], [58, 39603]]}, {"verse": 7, "start": 40534, "end": 45389, "text": "Por esto dejará el hombre a su padre y a su madre, y se juntará a su mujer.", "words": [[0, 40534], [4, 40636], [9, 40896], [16, 41456], [19, 41596], [26, 41856], [28, 42016], [31, 42116], [37, 42516], [39, 42776], [41, 42836], [44, 42996], [51, 43376], [53, 43936], [56, 44076], [64, 44596], [66, 44696], [69, 44816]]}, {"verse": 8, "start": 45739, "end": 52038, "text": "Y los que eran dos, serán hechos una carne: así que no son más dos, sino una carne.", "words": [[0, 45739], [2, 45824], [6, 45944], [10, 46124], [15, 46344], [20, 46664], [26, 47484], [33, 47844], [37, 48144], [44, 48989], [48, 49229], [52, 49409], [55, 49549], [59, 49849], [63, 50049], [68, 50909], [73, 51089], [77, 51329]]}, {"verse": 9, "start": 52388, "end": 55507, "text": "Pues lo que Dios juntó, no lo aparte el hombre.", "words": [[0, 52388], [5, 52550], [8, 52890], [12, 53050], [17, 53210], [24, 53590], [27, 53985], [30, 54125], [37, 54685], [40, 54905]]}, {"verse": 10, "start": 55857, "end": 60330, "text": "Y en casa volvieron los discípulos a preguntarle de lo mismo.", "words": [[0, 55857], [2, 56002], [5, 56142], [10, 56542], [20, 57522], [24, 57742], [35, 58462], [37, 58642], [49, 59442], [52, 59602], [55, 59722]]}, {"verse": 11, "start": 60680, "end": 67846, "text": "Y les dice: Cualquiera que se divorcie de su mujer y se case con otra, comete adulterio contra ella:", "words": [[0, 60861], [2, 61076], [6, 61290], [12, 61722], [23, 62224], [27, 62364], [30, 62524], [39, 63084], [42, 63224], [45, 63404], [51, 63804], [53, 64084], [56, 64224], [61, 64484], [65, 64784], [71, 65724], [78, 66084], [88, 66904], [95, 67224]]}, {"verse": 12, "start": 68196, "end": 73258, "text": "Y si la mujer se divorcia de su marido y se casa con otro, comete adulterio.", "words": [[0, 68196], [2, 68302], [5, 68422], [8, 68562], [14, 68842], [17, 69102], [26, 69682], [29, 69802], [32, 69982], [39, 70422], [41, 70522], [44, 70642], [49, 70882], [53, 71182], [59, 71842], [66, 72382]]}, {"verse": 13, "start": 73608, "end": 80863, "text": "Y le presentaban niños para que los tocase; y los discípulos reprendían a quienes los presentaban.", "words": [[0, 73608], [2, 73716], [5, 73836], [17, 74496], [23, 75036], [28, 75616], [32, 75756], [36, 75916], [44, 76959], [46, 77067], [50, 77207], [61, 78007], [72, 79147], [74, 79367], [82, 79627], [86, 79867]]}, {"verse": 14, "start": 81213, "end": 90823, "text": "Y viéndolo Jesús, se enojó, y les dijo: Dejad que los niños vengan, y no se lo impidáis; porque de los tales es el reino de Dios.", "words": [[0, 81213], [2, 81341], [11, 81781], [18, 82081], [21, 82461], [28, 83401], [30, 83551], [34, 83701], [40, 84456], [46, 85096], [50, 85236], [54, 85396], [60, 85846], [68, 86296], [70, 86676], [73, 86836], [76, 87016], [79, 87136], [89, 88330], [96, 88552], [99, 88712], [103, 88872], [109, 89112], [112, 89412], [115, 89612], [121, 90012], [124, 90172]]}, {"verse": 15, "start": 91173, "end": 97497, "text": "De cierto os digo, que el que no reciba el reino de Dios como un niño, no entrará en él.", "words": [[0, 91378], [3, 91618], [10, 91858], [13, 92118], [19, 92398], [23, 92958], [26, 93078], [30, 93218], [33, 93398], [40, 93958], [43, 94078], [49, 94438], [52, 94598], [57, 94818], [62, 95098], [65, 95318], [71, 95758], [74, 96298], [82, 96938], [85, 97138]]}, {"verse": 16, "start": 97847, "end": 103104, "text": "Y tomándolos en los brazos, poniendo las manos sobre ellos, los bendecía.", "words": [[0, 97847], [2, 97951], [13, 98631], [16, 98771], [20, 98891], [28, 99871], [37, 100371], [41, 100551], [47, 100851], [53, 101251], [60, 102171], [64, 102271]]}, {"verse": 17, "start": 103454, "end": 115313, "text": "Y saliendo él para ir su camino, vino uno corriendo, y arrodillándose delante de él, le preguntó: Maestro bueno, ¿qué haré para heredar la vida eterna?", "words": [[0, 103454], [2, 103558], [11, 104098], [14, 104398], [19, 104638], [22, 104858], [25, 105078], [33, 105578], [38, 106398], [42, 106678], [53, 107398], [55, 107878], [70, 108918], [78, 109458], [81, 109638], [85, 109838], [88, 110138], [98, 111152], [106, 111712], [113, 112512], [118, 112612], [123, 112912], [128, 113092], [136, 113572], [139, 113692], [144, 113892]]}, {"verse": 18, "start": 115593, "end": 121955, "text": "Y Jesús le dijo: ¿Por qué me dices bueno? Ninguno hay bueno, sino sólo uno, Dios.", "words": [[0, 115593], [2, 115738], [8, 116118], [11, 116478], [17, 117193], [22, 117296], [26, 117496], [29, 117636], [35, 117956], [42, 118752], [50, 119589], [54, 119849], [61, 120209], [66, 120529], [71, 120929], [76, 121309]]}, {"verse": 19, "start": 122305, "end": 132548, "text": "Los mandamientos sabes: No adulteres: No mates: No robes: No digas falso testimonio: No defraudes: Honra a tu padre y a tu madre.", "words": [[0, 122305], [4, 122413], [17, 123053], [24, 123791], [27, 123971], [38, 124980], [41, 125200], [48, 125871], [51, 126026], [58, 126801], [61, 127021], [67, 127381], [73, 127821], [85, 128835], [88, 129278], [99, 129934], [105, 130580], [107, 130780], [110, 130900], [116, 131320], [118, 131705], [120, 131785], [123, 131905]]}, {"verse": 20, "start": 132898, "end": 138578, "text": "Él entonces respondiendo, le dijo: Maestro, todo esto he guardado desde mi juventud.", "words": [[0, 132898], [3, 133080], [12, 134040], [26, 134820], [29, 134900], [35, 135603], [44, 136245], [49, 136345], [54, 136725], [57, 136905], [66, 137445], [72, 137625], [75, 137885]]}, {"verse": 21, "start": 138858, "end": 153013, "text": "Entonces Jesús mirándole, le amó, y le dijo: Una cosa te falta: ve, vende todo lo que tienes, y da a los pobres, y tendrás tesoro en el cielo; y ven, sígueme, tomando tu cruz.", "words": [[0, 138858], [9, 139345], [15, 140465], [26, 141165], [29, 141165], [34, 141825], [36, 142045], [39, 142145], [45, 142918], [49, 143104], [54, 143324], [57, 143544], [64, 144438], [68, 144825], [74, 145085], [79, 145365], [82, 145565], [86, 145705], [94, 146145], [96, 146785], [99, 146985], [101, 147125], [105, 147245], [113, 147845], [115, 148305], [123, 148705], [130, 149125], [133, 149265], [136, 149405], [143, 150297], [145, 150421], [150, 150661], [159, 151541], [167, 152201], [170, 152421]]}, {"verse": 22, "start": 153363, "end": 159473, "text": "Pero él, entristecido por esta palabra, se fue triste, porque tenía muchas posesiones.", "words": [[0, 153363], [5, 153545], [9, 153825], [22, 154985], [26, 155225], [31, 155405], [40, 155965], [43, 156330], [47, 156510], [55, 157370], [62, 157650], [68, 158030], [75, 158430]]}, {"verse": 23, "start": 159823, "end": 169473, "text": "Entonces Jesús, mirando alrededor, dice a sus discípulos: ¡Cuán difícilmente entrarán en el reino de Dios los que tienen riquezas!", "words": [[0, 159823], [9, 160567], [16, 161607], [24, 162007], [35, 163287], [40, 163547], [42, 163707], [46, 163887], [58, 165013], [64, 165220], [77, 166080], [86, 166800], [89, 166940], [92, 167100], [98, 167480], [101, 167640], [106, 167880], [110, 168080], [114, 168260], [121, 168560]]}, {"verse": 24, "start": 169823, "end": 183557, "text": "Y los discípulos se espantaron de sus palabras; pero Jesús respondiendo, les volvió a decir: ¡Hijos, cuán difícil es para los que confían en las riquezas entrar en el reino de Dios!", "words": [[0, 169823], [2, 169912], [6, 170052], [17, 170732], [20, 170932], [31, 171772], [34, 171932], [38, 172112], [48, 173173], [53, 173321], [59, 173881], [73, 175261], [77, 175381], [84, 175981], [86, 176101], [93, 176816], [101, 177218], [106, 177738], [114, 178098], [117, 178558], [122, 179198], [126, 179378], [130, 179538], [138, 180138], [141, 180318], [145, 180498], [154, 181058], [161, 181758], [164, 182178], [167, 182338], [173, 182778], [176, 182938]]}, {"verse": 25, "start": 183907, "end": 191111, "text": "Más fácil es pasar un camello por el ojo de una aguja, que el rico entrar en el reino de Dios.", "words": [[0, 183907], [4, 184255], [10, 184795], [13, 185095], [19, 185475], [22, 185755], [30, 186315], [34, 186555], [37, 186715], [41, 187035], [44, 187155], [48, 187375], [55, 188215], [59, 188495], [62, 188695], [67, 188935], [74, 189475], [77, 189715], [80, 189875], [86, 190355], [89, 190515]]}, {"verse": 26, "start": 191461, "end": 196886, "text": "Y ellos se espantaban más, diciendo dentro de sí: ¿Y quién podrá salvarse?", "words": [[0, 191461], [2, 191628], [8, 191868], [11, 192128], [22, 192968], [27, 193368], [36, 194028], [43, 194648], [46, 194928], [50, 195445], [53, 195567], [59, 195767], [65, 196127]]}, {"verse": 27, "start": 197166, "end": 206924, "text": "Entonces Jesús mirándolos, dice: Para los hombres es imposible; pero para Dios, no; porque todas las cosas son posibles para Dios.", "words": [[0, 197166], [9, 198051], [15, 198804], [27, 199584], [33, 200306], [38, 200472], [42, 200652], [50, 201032], [53, 201252], [64, 202574], [69, 202738], [74, 202978], [80, 203678], [84, 204159], [91, 204342], [97, 204662], [101, 204942], [107, 205262], [111, 205582], [120, 206122], [125, 206362]]}, {"verse": 28, "start": 207274, "end": 213857, "text": "Entonces Pedro comenzó a decirle: He aquí, nosotros hemos dejado todas las cosas, y te hemos seguido.", "words": [[0, 207274], [9, 207879], [15, 208259], [23, 208879], [25, 208999], [34, 209907], [37, 210048], [43, 210468], [52, 210728], [58, 211128], [65, 211628], [71, 211808], [75, 212108], [82, 212448], [84, 212968], [87, 213108], [93, 213288]]}, {"verse": 29, "start": 214137, "end": 228041, "text": "Y respondiendo Jesús, dijo: De cierto os digo, que no hay ninguno que haya dejado casa, o hermanos, o hermanas, o padre, o madre, o mujer, o hijos, o tierras, por causa de mí y del evangelio,", "words": [[0, 214137], [2, 214263], [15, 215023], [22, 215363], [28, 216681], [31, 216886], [38, 217091], [41, 217296], [47, 217656], [51, 217896], [54, 218116], [58, 218276], [66, 218816], [70, 218956], [75, 219276], [82, 219596], [88, 219976], [90, 220371], [100, 221111], [102, 221431], [112, 221991], [114, 222271], [121, 222651], [123, 222931], [130, 223271], [132, 223491], [139, 223831], [141, 224091], [148, 224411], [150, 224651], [159, 225607], [163, 225749], [169, 226109], [172, 226429], [175, 226649], [177, 226929], [181, 227089]]}, {"verse": 30, "start": 228391, "end": 240735, "text": "Que no reciba cien veces más ahora en este tiempo, casas, y hermanos, y hermanas, y madres, e hijos, y tierras, con persecuciones; y en el siglo venidero la vida eterna.", "words": [[0, 228391], [4, 228475], [7, 228885], [14, 229295], [19, 229575], [25, 229855], [29, 230135], [35, 230535], [38, 230675], [43, 230855], [51, 231755], [58, 232455], [60, 232655], [70, 233255], [72, 233435], [82, 233955], [84, 234295], [92, 234755], [94, 234955], [101, 235468], [103, 235982], [112, 236495], [116, 236695], [131, 238165], [133, 238289], [136, 238429], [139, 238549], [145, 238929], [154, 239609], [157, 239729], [162, 239949]]}, {"verse": 31, "start": 241085, "end": 245860, "text": "Pero muchos de los primeros serán últimos, y los últimos serán primeros.", "words": [[0, 241085], [5, 241345], [12, 241765], [15, 241965], [19, 242085], [28, 242605], [34, 242965], [43, 243485], [45, 244025], [49, 244185], [57, 244565], [63, 245045]]}, {"verse": 32, "start": 246210, "end": 262689, "text": "Y estaban en el camino subiendo a Jerusalén; y Jesús iba delante de ellos, y se espantaban, y le seguían con miedo: entonces volviendo a tomar a los doce aparte, les comenzó a decir las cosas que le habían de acontecer:", "words": [[0, 246210], [2, 246315], [10, 246655], [13, 246895], [16, 247035], [23, 247475], [32, 248355], [34, 248475], [45, 249537], [47, 249647], [53, 250007], [57, 250567], [65, 251127], [68, 251327], [75, 251647], [77, 251947], [80, 252107], [92, 253047], [94, 253727], [97, 253847], [105, 254327], [109, 254507], [116, 255283], [125, 256379], [135, 256859], [137, 256979], [143, 257299], [145, 257519], [149, 257639], [154, 258019], [162, 259019], [166, 259119], [174, 259779], [176, 259879], [182, 260159], [186, 260519], [192, 260939], [196, 261179], [199, 261339], [206, 261639], [209, 261859]]}, {"verse": 33, "start": 263039, "end": 275766, "text": "He aquí subimos a Jerusalén, y el Hijo del hombre será entregado a los principales sacerdotes, y a los escribas, y le condenarán a muerte, y le entregarán a los Gentiles:", "words": [[0, 263090], [3, 263180], [8, 263360], [16, 263960], [18, 264100], [29, 264840], [31, 265380], [34, 265500], [39, 265780], [43, 265920], [50, 266360], [55, 266600], [65, 267600], [67, 267740], [71, 267840], [83, 268660], [95, 269580], [97, 270060], [99, 270140], [103, 270260], [113, 271060], [115, 271740], [118, 271860], [129, 272560], [131, 272620], [139, 273533], [141, 273638], [144, 273778], [155, 274498], [157, 274658], [161, 274778]]}, {"verse": 34, "start": 276116, "end": 284951, "text": "Y se burlarán de él, y le golpearán con látigos, y escupirán en él, y le matarán; pero al tercer día resucitará.", "words": [[0, 276116], [2, 276236], [5, 276656], [14, 277076], [17, 277256], [21, 277556], [23, 278056], [26, 278176], [36, 278876], [40, 279036], [49, 279676], [51, 280196], [61, 280876], [64, 281016], [68, 281296], [70, 281676], [73, 281776], [82, 282758], [87, 282920], [90, 283120], [97, 283380], [101, 283800]]}, {"verse": 35, "start": 285301, "end": 294205, "text": "Entonces Jacobo y Juan, hijos de Zebedeo, se llegaron a él, diciendo: Maestro, querríamos que nos hagas lo que pidamos.", "words": [[0, 285301], [9, 285986], [16, 287046], [18, 287166], [24, 287946], [30, 288186], [33, 288736], [42, 289286], [45, 289426], [54, 289906], [56, 290026], [60, 290286], [70, 291469], [79, 292074], [90, 292514], [94, 292774], [98, 292954], [104, 293294], [107, 293414], [111, 293514]]}, {"verse": 36, "start": 294485, "end": 296991, "text": "Y él les dijo: ¿Qué queréis que os haga?", "words": [[0, 294485], [2, 294671], [5, 294811], [9, 294951], [15, 295653], [20, 295756], [28, 296136], [32, 296316], [35, 296476]]}, {"verse": 37, "start": 297341, "end": 303947, "text": "Y ellos le dijeron: Danos que en tu gloria nos sentemos el uno a tu derecha, y el otro a tu izquierda.", "words": [[0, 297341], [2, 297521], [8, 297741], [11, 297961], [20, 298886], [26, 299311], [30, 299471], [33, 299591], [36, 299711], [43, 300071], [47, 300231], [56, 300851], [59, 301151], [63, 301351], [65, 301531], [68, 301631], [77, 302491], [79, 302671], [82, 302811], [87, 303011], [89, 303191], [92, 303311]]}, {"verse": 38, "start": 304227, "end": 314001, "text": "Entonces Jesús les dijo: No sabéis lo que pedís. ¿Podéis beber del vaso que yo bebo, o ser bautizados del bautismo de que yo soy bautizado?", "words": [[0, 304227], [9, 304733], [15, 305051], [19, 305368], [25, 306652], [28, 306792], [35, 307232], [38, 307392], [42, 307512], [49, 308334], [57, 308700], [63, 309000], [67, 309320], [72, 309720], [76, 309780], [79, 309980], [85, 310360], [87, 310700], [91, 311120], [102, 311540], [106, 311840], [115, 312400], [118, 312580], [122, 312700], [125, 312880], [129, 313100]]}, {"verse": 39, "start": 314351, "end": 326430, "text": "Y ellos dijeron: Podemos. Y Jesús les dijo: A la verdad, del vaso que yo bebo, beberéis; y del bautismo de que yo soy bautizado, seréis bautizados.", "words": [[0, 314351], [2, 314478], [8, 314638], [17, 315501], [26, 316446], [28, 316570], [34, 316990], [38, 317450], [44, 318167], [46, 318337], [49, 318417], [57, 318697], [61, 319377], [66, 319797], [70, 319897], [73, 320117], [79, 320457], [89, 321778], [91, 321903], [95, 322063], [104, 322783], [107, 323203], [111, 323343], [114, 323543], [118, 323763], [129, 324863], [136, 325283]]}, {"verse": 40, "start": 326780, "end": 333231, "text": "Pero que os sentéis a mi derecha y a mi izquierda, no es mío darlo, sino a quienes está preparado.", "words": [[0, 326780], [5, 326927], [9, 327127], [12, 327307], [20, 327887], [22, 328027], [25, 328147], [33, 328667], [35, 328827], [37, 328907], [40, 329087], [51, 330007], [54, 330207], [57, 330327], [61, 330647], [68, 331387], [73, 331627], [75, 331827], [83, 331967], [88, 332427]]}, {"verse": 41, "start": 333581, "end": 338869, "text": "Y como lo oyeron los diez, comenzaron a enojarse de Jacobo y de Juan.", "words": [[0, 333581], [2, 333684], [7, 333924], [10, 334124], [17, 334744], [21, 334884], [27, 335724], [38, 336444], [40, 336624], [49, 337264], [52, 337424], [59, 338044], [61, 338164], [64, 338264]]}, {"verse": 42, "start": 339219, "end": 351274, "text": "Pero Jesús, llamándolos, les dice: Sabéis que los que son reconocidos como gobernantes entre las naciones, las dominan, y los que entre ellas son grandes, tienen sobre ellas autoridad.", "words": [[0, 339219], [5, 339362], [12, 339902], [25, 340542], [29, 341182], [35, 341915], [42, 342298], [46, 342518], [50, 342858], [54, 343058], [58, 343338], [70, 344118], [75, 344358], [87, 345038], [93, 345298], [97, 345518], [107, 346038], [111, 346498], [120, 347138], [122, 347578], [126, 347738], [130, 347878], [136, 348098], [142, 348398], [146, 348658], [155, 349058], [162, 349593], [168, 349953], [174, 350313]]}, {"verse": 43, "start": 351624, "end": 359323, "text": "Pero no será así entre vosotros, sino que el que quiera hacerse grande entre vosotros será vuestro servidor;", "words": [[0, 351624], [5, 351788], [8, 352008], [13, 352268], [17, 352688], [23, 353008], [33, 354188], [38, 354568], [42, 354868], [45, 355188], [49, 355368], [56, 355808], [64, 356488], [71, 356888], [77, 357228], [86, 357848], [91, 358128], [99, 358548]]}, {"verse": 44, "start": 359673, "end": 364223, "text": "Y el que de vosotros quiera ser el primero, será siervo de todos.", "words": [[0, 359673], [2, 359883], [5, 360043], [9, 360243], [12, 360383], [21, 360903], [28, 361303], [32, 361503], [35, 361683], [44, 362243], [49, 362738], [56, 363418], [59, 363558]]}, {"verse": 45, "start": 364573, "end": 372509, "text": "Porque el Hijo del hombre tampoco vino para ser servido, sino para servir, y dar su vida en rescate por muchos.", "words": [[0, 364573], [7, 364837], [10, 365197], [15, 365457], [19, 365597], [26, 365977], [34, 366257], [39, 366837], [44, 367157], [48, 367417], [57, 368557], [62, 368857], [67, 369097], [75, 369577], [77, 370077], [81, 370277], [84, 370497], [89, 370797], [92, 370917], [100, 371477], [104, 371737]]}, {"verse": 46, "start": 372859, "end": 386698, "text": "Entonces vienen a Jericó: y saliendo él de Jericó y sus discípulos y una gran multitud, Bartimeo el ciego, hijo de Timeo, estaba sentado junto al camino mendigando.", "words": [[0, 372859], [9, 373361], [16, 373721], [18, 373941], [26, 374730], [28, 374892], [37, 375472], [40, 375812], [43, 376012], [50, 376692], [52, 376867], [56, 377067], [67, 377907], [69, 378072], [73, 378232], [78, 378492], [88, 379712], [97, 380912], [100, 381032], [107, 382112], [112, 382312], [115, 382512], [122, 383472], [129, 383792], [137, 384552], [143, 384832], [146, 385132], [153, 385552]]}, {"verse": 47, "start": 387048, "end": 395510, "text": "Y oyendo que era Jesús el nazareno, comenzó a dar voces y decir: Jesús, Hijo de David, ten misericordia de mí.", "words": [[0, 387048], [2, 387213], [9, 387573], [13, 387833], [17, 388033], [23, 388773], [26, 388933], [36, 390073], [44, 390773], [46, 390893], [50, 390993], [56, 391513], [58, 391673], [65, 392495], [72, 393043], [77, 393263], [80, 393383], [87, 393843], [91, 394303], [104, 395083], [107, 395223]]}, {"verse": 48, "start": 395790, "end": 403808, "text": "Y muchos le reprendían, que callase: pero él daba mayores voces: Hijo de David, ten misericordia de mí.", "words": [[0, 395790], [2, 395912], [9, 396312], [12, 396712], [24, 397572], [28, 397777], [37, 398789], [42, 398976], [45, 399396], [50, 399976], [58, 400396], [65, 401360], [70, 401617], [73, 401757], [80, 402317], [84, 402437], [97, 403237], [100, 403377]]}, {"verse": 49, "start": 404088, "end": 411918, "text": "Entonces Jesús parándose, mandó llamarle: y llaman al ciego, diciéndole: Ten ánimo: levántate, te llama.", "words": [[0, 404088], [9, 404493], [15, 404953], [26, 405893], [32, 406453], [42, 407369], [44, 407497], [51, 407777], [54, 407977], [61, 408817], [73, 410120], [77, 410354], [84, 410775], [95, 411103], [98, 411473]]}, {"verse": 50, "start": 412198, "end": 416940, "text": "Él entonces, echando su capa, se levantó, y vino a Jesús.", "words": [[0, 412198], [3, 412481], [13, 413141], [21, 413781], [24, 413981], [30, 414701], [33, 414861], [42, 415521], [44, 415941], [49, 416181], [51, 416341]]}, {"verse": 51, "start": 417290, "end": 424348, "text": "Y respondiendo Jesús, le dice: ¿Qué quieres que te haga? Y el ciego le dice: Maestro, que recobre la vista.", "words": [[0, 417290], [2, 417395], [15, 418015], [22, 418335], [25, 418695], [31, 419407], [36, 419523], [44, 419843], [48, 420063], [51, 420243], [57, 420936], [59, 421061], [62, 421181], [68, 421621], [71, 421781], [77, 422509], [86, 423033], [90, 423233], [98, 423733], [101, 423853]]}, {"verse": 52, "start": 424628, "end": 432308, "text": "Y Jesús le dijo: Ve, tu fe te ha salvado. Y luego recobró la vista, y seguía a Jesús en el camino.", "words": [[0, 424628], [2, 424773], [8, 425153], [11, 425513], [17, 426386], [21, 426578], [24, 426680], [27, 426880], [30, 427080], [33, 427220], [42, 428199], [44, 428481], [50, 428721], [58, 429441], [61, 429601], [68, 429901], [70, 430161], [77, 430681], [79, 430861], [85, 431161], [88, 431501], [91, 431621]]}]}