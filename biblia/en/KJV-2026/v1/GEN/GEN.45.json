{"book": "GEN", "chapter": 45, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 213325, "verses": [{"verse": 1, "start": 300, "end": 10571, "text": "Then Joseph could not refrain himself before all them that stood by him; and he cried, Cause every man to go out from me. And there stood no man with him, while Joseph made himself known to his brethren.", "words": [[0, 300], [5, 470], [12, 830], [18, 1090], [22, 1270], [30, 1630], [38, 2050], [45, 2370], [49, 2710], [54, 2910], [59, 3110], [65, 3310], [68, 3550], [73, 4047], [77, 4173], [80, 4253], [87, 4733], [93, 4993], [99, 5373], [103, 5613], [106, 5813], [109, 5953], [113, 6113], [118, 6293], [122, 6832], [126, 6957], [132, 7097], [138, 7277], [141, 7537], [145, 7757], [150, 7977], [155, 8397], [161, 8637], [168, 8957], [173, 9257], [181, 9497], [187, 9757], [190, 9937], [194, 10037]]}, {"verse": 2, "start": 10851, "end": 14949, "text": "And he wept aloud: and the Egyptians and the house of Pharaoh heard.", "words": [[0, 10851], [4, 10982], [7, 11102], [12, 11402], [19, 12222], [23, 12348], [27, 12468], [37, 12908], [41, 13488], [45, 13628], [51, 13848], [54, 14028], [62, 14388]]}, {"verse": 3, "start": 15299, "end": 23513, "text": "And Joseph said to his brethren, I am Joseph; does my father yet live? And his brethren could not answer him; for they were troubled at his presence.", "words": [[0, 15299], [4, 15428], [11, 15728], [16, 16048], [19, 16228], [23, 16349], [33, 17193], [35, 17392], [38, 17512], [46, 18322], [51, 18468], [54, 18648], [61, 18888], [65, 19128], [71, 19870], [75, 19976], [79, 20096], [88, 20436], [94, 20716], [98, 20896], [105, 21236], [110, 21810], [114, 21890], [119, 22010], [124, 22150], [133, 22510], [136, 22770], [140, 22890]]}, {"verse": 4, "start": 23793, "end": 32575, "text": "And Joseph said to his brethren, Come near to me, please. And they came near. And he said, I am Joseph your brother, whom you sold into Egypt.", "words": [[0, 23793], [4, 23940], [11, 24280], [16, 24640], [19, 24840], [23, 24960], [33, 25820], [38, 26120], [43, 26400], [46, 26580], [50, 26720], [58, 27649], [62, 27774], [67, 27914], [72, 28174], [78, 28992], [82, 29120], [85, 29220], [91, 29580], [93, 29680], [96, 29860], [103, 30400], [108, 30480], [117, 30940], [122, 31140], [126, 31320], [131, 31600], [136, 31880]]}, {"verse": 5, "start": 32795, "end": 39822, "text": "Now therefore be not grieved, nor angry with yourselves, that you sold me here: for God did send me before you to preserve life.", "words": [[0, 32795], [4, 32996], [14, 33436], [17, 33656], [21, 33916], [30, 34416], [34, 34836], [40, 35296], [45, 35556], [57, 35976], [62, 36276], [66, 36416], [71, 36716], [74, 36916], [80, 37492], [84, 37586], [88, 37866], [92, 38106], [97, 38346], [100, 38526], [107, 38806], [111, 38966], [114, 39106], [123, 39386]]}, {"verse": 6, "start": 40172, "end": 47332, "text": "For these two years has the famine been in the land: and yet there are five years, in which there shall neither be plowing nor harvest.", "words": [[0, 40172], [4, 40296], [10, 40516], [14, 40696], [20, 41076], [24, 41336], [28, 41496], [35, 41776], [40, 42076], [43, 42256], [47, 42356], [53, 42989], [57, 43132], [61, 43312], [67, 43492], [71, 43632], [76, 43912], [83, 44232], [86, 44772], [92, 44972], [98, 45152], [104, 45332], [112, 45652], [115, 45892], [123, 46352], [127, 46672]]}, {"verse": 7, "start": 47682, "end": 53292, "text": "And God sent me before you to preserve you a posterity in the earth, and to save your lives by a great deliverance.", "words": [[0, 47682], [4, 47828], [8, 48068], [13, 48288], [16, 48488], [23, 48828], [27, 49008], [30, 49168], [39, 49341], [43, 49515], [45, 49688], [55, 50288], [58, 50408], [62, 50508], [69, 50768], [73, 51168], [76, 51308], [81, 51528], [86, 51708], [92, 51988], [95, 52268], [97, 52388], [103, 52568]]}, {"verse": 8, "start": 53642, "end": 62001, "text": "So now it was not you that sent me here, but God: and he has made me a father to Pharaoh, and lord of all his house, and a ruler throughout all the land of Egypt.", "words": [[0, 53642], [3, 53738], [7, 53878], [10, 54038], [14, 54178], [18, 54338], [22, 54558], [27, 54718], [32, 54918], [35, 55078], [41, 55558], [45, 55718], [50, 56504], [54, 56664], [57, 56764], [61, 56864], [66, 57024], [69, 57204], [71, 57284], [78, 57524], [81, 57704], [90, 58084], [94, 58564], [99, 58784], [102, 58944], [106, 59084], [110, 59224], [117, 59524], [121, 60004], [123, 60124], [129, 60364], [140, 60724], [144, 61024], [148, 61184], [153, 61384], [156, 61524]]}, {"verse": 9, "start": 62351, "end": 70682, "text": "Hurry, and go up to my father, and say to him, Thus says your son Joseph, God has made me lord of all Egypt: come down to me, do not delay:", "words": [[0, 62351], [7, 62615], [11, 62895], [14, 63075], [17, 63275], [20, 63415], [23, 63555], [31, 63855], [35, 64080], [39, 64280], [42, 64460], [47, 64920], [52, 65180], [57, 65480], [62, 65700], [66, 65980], [74, 66720], [78, 67000], [82, 67260], [87, 67460], [90, 67620], [95, 67860], [98, 68040], [102, 68180], [109, 68895], [114, 69057], [119, 69277], [122, 69457], [126, 69857], [129, 69977], [133, 70157]]}, {"verse": 10, "start": 71032, "end": 80683, "text": "And you shall dwell in the land of Goshen, and you shall be near to me, you, and your children, and your children’s children, and your flocks, and your herds, and all that you have:", "words": [[0, 71032], [4, 71190], [8, 71290], [14, 71490], [20, 71790], [23, 71970], [27, 72110], [32, 72310], [35, 72430], [43, 73270], [47, 73350], [51, 73470], [57, 73650], [60, 73790], [65, 74030], [68, 74190], [72, 74570], [77, 74830], [81, 75150], [86, 75270], [96, 76030], [100, 76210], [105, 76330], [116, 76850], [126, 77630], [130, 77690], [135, 77810], [143, 78630], [147, 78690], [152, 78830], [159, 79636], [163, 79806], [167, 80006], [172, 80206], [176, 80326]]}, {"verse": 11, "start": 81033, "end": 87793, "text": "And there will I nourish you; for yet there are five years of famine; lest you, and your household, and all that you have, come to poverty.", "words": [[0, 81033], [4, 81159], [10, 81319], [15, 81459], [17, 81599], [25, 82059], [30, 82512], [34, 82594], [38, 82754], [44, 82954], [48, 83074], [53, 83374], [59, 83614], [62, 83814], [70, 84512], [75, 84776], [80, 84996], [84, 85316], [89, 85416], [100, 85836], [104, 86156], [108, 86316], [113, 86436], [117, 86536], [123, 86796], [128, 87136], [131, 87296]]}, {"verse": 12, "start": 88143, "end": 93667, "text": "And, behold, your eyes see, and the eyes of my brother Benjamin, that it is my mouth that speaks to you.", "words": [[0, 88143], [5, 88239], [13, 88939], [18, 89129], [23, 89319], [28, 89619], [32, 89919], [36, 90019], [41, 90259], [44, 90359], [47, 90499], [55, 90759], [65, 91519], [70, 91779], [73, 91919], [76, 92059], [79, 92239], [85, 92639], [90, 92919], [97, 93179], [100, 93419]]}, {"verse": 13, "start": 94017, "end": 100838, "text": "And you shall tell my father of all my glory in Egypt, and of all that you have seen; and you shall haste and bring down my father here.", "words": [[0, 94017], [4, 94163], [8, 94283], [14, 94443], [19, 94703], [22, 94883], [29, 95203], [32, 95443], [36, 95683], [39, 95843], [45, 96143], [48, 96363], [55, 96623], [59, 97043], [62, 97183], [66, 97463], [71, 97643], [75, 97763], [80, 97883], [86, 98557], [90, 98659], [94, 98759], [100, 98919], [106, 99359], [110, 99459], [116, 99639], [121, 99879], [124, 100059], [131, 100379]]}, {"verse": 14, "start": 101118, "end": 106739, "text": "And he fell upon his brother Benjamin’s neck, and wept; and Benjamin wept upon his neck.", "words": [[0, 101118], [4, 101252], [7, 101332], [12, 101592], [17, 101812], [21, 102032], [29, 102312], [40, 103112], [46, 103372], [50, 103952], [56, 104770], [60, 104911], [69, 105351], [74, 105831], [79, 106031], [83, 106311]]}, {"verse": 15, "start": 107089, "end": 112504, "text": "Moreover he kissed all his brethren, and wept upon them: and after that his brethren talked with him.", "words": [[0, 107089], [9, 107615], [12, 107695], [19, 107955], [23, 108215], [27, 108395], [37, 108795], [41, 109275], [46, 109575], [51, 109755], [57, 110462], [61, 110588], [67, 110828], [72, 111068], [76, 111248], [85, 111608], [92, 111968], [97, 112248]]}, {"verse": 16, "start": 112854, "end": 120618, "text": "¶ And the fame of it was heard in Pharaoh’s house, saying, Joseph’s brethren are come: and it pleased Pharaoh well, and his servants.", "words": [[2, 112854], [6, 112981], [10, 113081], [15, 113361], [18, 113541], [21, 113681], [25, 113861], [31, 114101], [34, 114261], [44, 114801], [51, 115461], [59, 115981], [68, 116561], [77, 116901], [81, 117201], [87, 117893], [91, 118016], [94, 118116], [102, 118516], [110, 118916], [116, 119636], [120, 119776], [124, 119896]]}, {"verse": 17, "start": 120968, "end": 128318, "text": "And Pharaoh said to Joseph, Say to your brethren, This do you; load your beasts, and go, get you to the land of Canaan;", "words": [[0, 120968], [4, 121283], [12, 121583], [17, 121883], [20, 122083], [28, 122827], [32, 123004], [35, 123104], [40, 123244], [50, 123944], [55, 124144], [58, 124344], [63, 124976], [68, 125220], [73, 125420], [81, 125800], [85, 126080], [89, 126740], [93, 126920], [97, 127100], [100, 127240], [104, 127340], [109, 127560], [112, 127965]]}, {"verse": 18, "start": 128668, "end": 135719, "text": "And take your father and your households, and come to me: and I will give you the good of the land of Egypt, and you shall eat the fat of the land.", "words": [[0, 128668], [4, 128791], [9, 128971], [14, 129131], [21, 129431], [25, 129631], [30, 129751], [42, 130151], [46, 130451], [51, 130651], [54, 130851], [58, 131362], [62, 131509], [64, 131629], [69, 131789], [74, 132029], [78, 132169], [82, 132329], [87, 132549], [90, 132669], [94, 132809], [99, 133029], [102, 133189], [109, 133689], [113, 133969], [117, 134169], [123, 134389], [127, 134629], [131, 134789], [135, 135029], [138, 135149], [142, 135309]]}, {"verse": 19, "start": 136069, "end": 144359, "text": "Now you are commanded, this do you; take you wagons out of the land of Egypt for your little ones, and for your wives, and bring your father, and come.", "words": [[0, 136069], [4, 136370], [8, 136590], [12, 136710], [23, 137610], [28, 137790], [31, 137970], [36, 138475], [41, 138629], [45, 138809], [52, 139249], [56, 139449], [59, 139569], [63, 139669], [68, 139949], [71, 140089], [77, 140349], [81, 140589], [86, 140709], [93, 140949], [99, 141249], [103, 141669], [107, 141829], [112, 141969], [119, 142309], [123, 142769], [129, 142969], [134, 143129], [142, 143469], [146, 143909]]}, {"verse": 20, "start": 144709, "end": 148873, "text": "Also regard not your stuff; for the good of all the land of Egypt is yours.", "words": [[0, 144709], [5, 145133], [12, 145353], [16, 145633], [21, 145853], [28, 146513], [32, 146590], [36, 146730], [41, 146910], [44, 147070], [48, 147210], [52, 147350], [57, 147570], [60, 147730], [66, 147990], [69, 148310]]}, {"verse": 21, "start": 149153, "end": 157160, "text": "And the children of Israel did so: and Joseph gave them wagons, according to the commandment of Pharaoh, and gave them provision for the way.", "words": [[0, 149153], [4, 149277], [8, 149357], [17, 149697], [20, 149917], [27, 150257], [31, 150557], [35, 151229], [39, 151385], [46, 151725], [51, 152065], [56, 152285], [64, 152885], [74, 153445], [77, 153765], [81, 153885], [93, 154445], [96, 154565], [105, 155405], [109, 155485], [114, 155705], [119, 155925], [129, 156305], [133, 156625], [137, 156745]]}, {"verse": 22, "start": 157510, "end": 165212, "text": "To all of them he gave each man changes of clothing; but to Benjamin he gave three hundred pieces of silver, and five changes of clothing.", "words": [[0, 157510], [3, 157610], [7, 157890], [10, 158050], [15, 158330], [18, 158430], [23, 158610], [28, 158850], [32, 159110], [40, 159490], [43, 159750], [53, 160571], [57, 160672], [60, 160812], [69, 161392], [72, 161472], [77, 161692], [83, 161912], [91, 162132], [98, 162612], [101, 162892], [109, 163272], [113, 163712], [118, 164032], [126, 164412], [129, 164632]]}, {"verse": 23, "start": 165562, "end": 175236, "text": "And to his father he sent after this manner; ten donkeys laden with the good things of Egypt, and ten she donkeys laden with grain and bread and food for his father by the way.", "words": [[0, 165562], [4, 165673], [7, 165773], [11, 165933], [18, 166353], [21, 166433], [26, 166673], [32, 166993], [37, 167368], [45, 167963], [49, 168163], [57, 168643], [63, 169103], [68, 169243], [72, 169383], [77, 169563], [84, 169843], [87, 170043], [94, 170803], [98, 170923], [102, 171163], [106, 171343], [114, 171803], [120, 172263], [125, 172403], [131, 172723], [135, 172983], [141, 173283], [145, 173503], [150, 173803], [154, 174043], [158, 174203], [165, 174623], [168, 174763], [172, 174903]]}, {"verse": 24, "start": 175586, "end": 182257, "text": "So he sent his brethren away, and they departed: and he said to them, See that you fall not out by the way.", "words": [[0, 175586], [3, 175726], [6, 175866], [11, 176166], [15, 176306], [24, 176706], [30, 177646], [34, 177866], [39, 178046], [49, 178966], [53, 179074], [56, 179174], [61, 179414], [64, 179614], [70, 180216], [74, 180461], [79, 180661], [83, 180781], [88, 181001], [92, 181281], [96, 181561], [99, 181801], [103, 181941]]}, {"verse": 25, "start": 182537, "end": 187265, "text": "¶ And they went up out of Egypt, and came into the land of Canaan to Jacob their father,", "words": [[2, 182537], [6, 182682], [11, 182802], [16, 183042], [19, 183282], [23, 183502], [26, 183642], [33, 183962], [37, 184257], [42, 184497], [47, 184777], [51, 184937], [56, 185217], [59, 185397], [66, 185877], [69, 186037], [75, 186377], [81, 186637]]}, {"verse": 26, "start": 187615, "end": 196630, "text": "And told him, saying, Joseph is yet alive, and he is governor over all the land of Egypt. And Jacob’s heart fainted, for he believed them not.", "words": [[0, 187615], [4, 187757], [9, 187997], [14, 188197], [22, 188777], [29, 189257], [32, 189617], [36, 189817], [43, 190277], [47, 190622], [50, 190762], [53, 190902], [62, 191262], [67, 191662], [71, 192002], [75, 192182], [80, 192482], [83, 192662], [90, 193431], [94, 193591], [102, 194091], [108, 194271], [117, 195071], [121, 195311], [124, 195471], [133, 195871], [138, 196091]]}, {"verse": 27, "start": 196980, "end": 206746, "text": "And they told him all the words of Joseph, which he had said to them: and when he saw the wagons which Joseph had sent to carry him, the spirit of Jacob their father revived:", "words": [[0, 196980], [4, 197121], [9, 197221], [14, 197441], [18, 197621], [22, 197841], [26, 198001], [32, 198241], [35, 198401], [43, 199181], [49, 199381], [52, 199541], [56, 199701], [61, 199921], [64, 200081], [70, 200643], [74, 200777], [79, 200917], [82, 201077], [86, 201337], [90, 201497], [97, 201957], [103, 202177], [110, 202617], [114, 202957], [119, 203197], [122, 203377], [128, 203697], [133, 204397], [137, 204517], [144, 204877], [147, 205037], [153, 205357], [159, 205637], [166, 205957]]}, {"verse": 28, "start": 207096, "end": 212925, "text": "And Israel said, It is enough; Joseph my son is yet alive: I will go and see him before I die.", "words": [[0, 207096], [4, 207238], [11, 207578], [17, 208325], [20, 208424], [23, 208524], [31, 209174], [38, 209651], [41, 209711], [45, 210191], [48, 210271], [52, 210451], [59, 211130], [61, 211246], [66, 211406], [69, 211586], [73, 211746], [77, 211986], [81, 212146], [88, 212386], [90, 212586]]}]}