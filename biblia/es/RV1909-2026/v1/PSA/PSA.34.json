, 102694], [51, 103656], [53, 103783], [61, 104483], [63, 104683], [67, 104823], [77, 105503], [80, 105663]]}, {"verse": 19, "start": 106715, "end": 111637, "text": "Muchos son los males del justo; pero de todos ellos lo librará Jehová.", "words": [[0, 106715], [7, 107159], [11, 107359], [15, 107499], [21, 107839], [25, 108099], [32, 108910], [37, 109054], [40, 109214], [46, 109454], [52, 109854], [55, 110294], [63, 110934]]}, {"verse": 20, "start": 111987, "end": 116068, "text": "Él guarda todos sus huesos; ni uno de ellos será quebrantado.", "words": [[0, 111987], [3, 111987], [10, 112488], [16, 112708], [20, 113048], [28, 114090], [31, 114200], [35, 114460], [38, 114620], [44, 114860], [49, 115140]]}, {"verse": 21, "start": 116418, "end": 121589, "text": "Matará al malo la maldad; y los que aborrecen al justo serán asolados.", "words": [[0, 116418], [7, 116907], [10, 117187], [15, 117607], [18, 117767], [26, 118655], [28, 118758], [32, 118878], [36, 119018], [46, 119618], [49, 119798], [55, 120058], [61, 120618]]}, {"verse": 22, "start": 121939, "end": 128106, "text": "Jehová redime el alma de sus siervos; y no serán asolados cuantos en él confían.", "words": [[0, 121939], [7, 122534], [14, 123167], [17, 123367], [22, 123647], [25, 123807], [29, 123987], [38, 124989], [40, 125096], [43, 125236], [49, 125696], [58, 126416], [66, 127016], [69, 127176], [72, 127336]]}]}