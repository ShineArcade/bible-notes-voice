{"book": "GEN", "chapter": 26, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 312577, "verses": [{"verse": 1, "start": 300, "end": 10973, "text": "Y hubo hambre en la tierra, además de la primera hambre que fue en los días de Abraham: y se fue Isaac a Abimelec rey de los filisteos, en Gerar.", "words": [[0, 300], [2, 500], [7, 840], [14, 1200], [17, 1380], [20, 1480], [28, 2100], [35, 2380], [38, 2940], [41, 3060], [49, 3360], [56, 3820], [60, 3980], [64, 4200], [67, 4520], [71, 4680], [76, 5020], [79, 5200], [88, 6213], [90, 6362], [93, 6442], [97, 6682], [103, 7262], [105, 7727], [114, 8387], [118, 9047], [121, 9227], [125, 9387], [136, 10227], [139, 10627]]}, {"verse": 2, "start": 11323, "end": 18641, "text": "Y se le apareció Jehová, y le dijo: No desciendas a Egipto: habita en la tierra que yo te diré;", "words": [[0, 11323], [2, 11469], [5, 11549], [8, 11729], [17, 12349], [25, 13329], [27, 13629], [30, 13749], [36, 14463], [39, 14681], [50, 15301], [52, 15521], [60, 16778], [67, 16944], [70, 17111], [73, 17291], [80, 17671], [84, 17871], [87, 18031], [90, 18171]]}, {"verse": 3, "start": 19231, "end": 31445, "text": "Habita en esta tierra, y seré contigo, y te bendeciré; porque a ti y a tu descendencia daré todas estas tierras, y confirmaré el juramento que juré a Abraham tu padre:", "words": [[0, 19231], [7, 19670], [10, 19790], [15, 19990], [23, 20410], [25, 20930], [30, 21230], [39, 21870], [41, 22170], [44, 22330], [55, 23616], [62, 23865], [64, 24045], [67, 24285], [69, 24565], [71, 24625], [74, 24745], [87, 25525], [92, 26065], [98, 26265], [104, 26645], [113, 27245], [115, 27765], [126, 28505], [129, 28725], [139, 29305], [143, 29565], [148, 30005], [150, 30145], [158, 30605], [161, 30945]]}, {"verse": 4, "start": 32031, "end": 42372, "text": "Y multiplicaré tu descendencia como las estrellas del cielo, y daré a tu descendencia todas estas tierras; y todas las naciones de la tierra serán benditas en tu simiente:", "words": [[0, 32031], [2, 32169], [15, 33009], [18, 33169], [31, 33989], [36, 34229], [40, 34449], [50, 35009], [54, 35129], [61, 35529], [63, 35724], [68, 36064], [70, 36124], [73, 36244], [86, 37164], [92, 37349], [98, 37749], [107, 38682], [109, 38782], [115, 39022], [119, 39302], [128, 39762], [131, 39942], [134, 40042], [141, 40422], [147, 40882], [156, 41402], [159, 41562], [162, 41662]]}, {"verse": 5, "start": 42970, "end": 49754, "text": "Por cuanto oyó Abraham mi voz, y guardó mi precepto, mis mandamientos, mis estatutos y mis leyes.", "words": [[0, 42970], [4, 43134], [11, 43521], [15, 43907], [23, 44294], [26, 44454], [31, 44794], [33, 45134], [40, 45554], [43, 45674], [53, 46574], [57, 46654], [71, 47894], [75, 47974], [85, 48534], [87, 48974], [91, 49114]]}, {"verse": 6, "start": 50280, "end": 52977, "text": "Habitó, pues, Isaac en Gerar.", "words": [[0, 50280], [8, 50790], [14, 51030], [20, 51810], [23, 52411]]}, {"verse": 7, "start": 53327, "end": 71319, "text": "Y los hombres de aquel lugar le preguntaron acerca de su mujer; y él respondió: Es mi hermana; porque tuvo miedo de decir: Es mi mujer; que tal vez, dijo, los hombres del lugar me matarían por causa de Rebeca; porque era de hermoso aspecto.", "words": [[0, 53327], [2, 53436], [6, 53556], [14, 53936], [17, 54136], [23, 54436], [29, 54756], [32, 54996], [44, 55836], [51, 56336], [54, 56676], [57, 56856], [64, 57914], [66, 58200], [69, 58487], [80, 59348], [83, 59535], [86, 59735], [95, 60552], [102, 60754], [107, 61074], [113, 61514], [116, 61754], [123, 62604], [126, 62965], [129, 63165], [136, 64068], [140, 64170], [144, 64330], [149, 64990], [155, 66070], [159, 66190], [167, 66530], [171, 66690], [177, 67030], [180, 67290], [189, 67890], [193, 68130], [199, 68450], [202, 68895], [210, 69485], [217, 69630], [221, 69970], [224, 70110], [232, 70610]]}, {"verse": 8, "start": 71669, "end": 82588, "text": "Y sucedió que, después que él estuvo allí muchos días, Abimelec, rey de los filisteos, mirando por una ventana, vio a Isaac que jugaba con Rebeca su mujer.", "words": [[0, 71669], [2, 71796], [10, 72336], [15, 72516], [23, 72916], [27, 73216], [30, 73516], [37, 73916], [42, 74136], [49, 74396], [55, 75094], [65, 75793], [69, 76176], [72, 76276], [76, 76416], [87, 77456], [95, 77836], [99, 78076], [103, 78256], [112, 79216], [116, 79416], [118, 79676], [124, 80556], [128, 80636], [135, 81136], [139, 81336], [146, 81796], [149, 81996]]}, {"verse": 9, "start": 82938, "end": 96294, "text": "Y llamó Abimelec a Isaac, y dijo: He aquí ella es de cierto tu mujer: ¿cómo, pues, dijiste: Es mi hermana? E Isaac le respondió: Porque dije: Quizá moriré por causa de ella.", "words": [[0, 82938], [2, 83063], [8, 83243], [17, 83423], [19, 84223], [26, 85323], [28, 85423], [34, 86142], [37, 86222], [42, 86482], [47, 86802], [50, 87042], [53, 87142], [60, 87462], [63, 87722], [70, 88447], [77, 88675], [83, 88945], [92, 89730], [95, 89849], [98, 89989], [107, 90774], [109, 90774], [115, 91323], [118, 91883], [129, 93143], [136, 93283], [142, 93965], [148, 94304], [155, 94704], [159, 94884], [165, 95124], [168, 95384]]}, {"verse": 10, "start": 96574, "end": 105343, "text": "Y Abimelec dijo: ¿Por qué nos has hecho esto? Por poco hubiera dormido alguno del pueblo con tu mujer, y hubieras traído sobre nosotros el pecado.", "words": [[0, 96828], [2, 97114], [11, 97401], [17, 98343], [22, 98488], [26, 98628], [30, 98788], [34, 98988], [40, 99208], [46, 99987], [50, 100113], [55, 100413], [63, 100773], [71, 101173], [78, 101573], [82, 101653], [89, 101953], [93, 102193], [96, 102313], [103, 102653], [105, 103113], [114, 103473], [121, 103813], [127, 104073], [136, 104473], [139, 104733]]}, {"verse": 11, "start": 105623, "end": 113275, "text": "Entonces Abimelec mandó a todo el pueblo, diciendo: El que toque a este hombre o a su mujer, de cierto morirá.", "words": [[0, 105623], [9, 106335], [18, 107085], [24, 107785], [26, 107865], [31, 108045], [34, 108265], [42, 108625], [52, 109654], [55, 109773], [59, 109893], [65, 110233], [67, 110333], [72, 110573], [79, 110953], [81, 111153], [83, 111253], [86, 111373], [93, 112193], [96, 112253], [103, 112553]]}, {"verse": 12, "start": 113555, "end": 120215, "text": "Y sembró Isaac en aquella tierra, y halló aquel año ciento por uno: y le bendijo Jehová.", "words": [[0, 113555], [2, 113673], [9, 114233], [15, 114593], [18, 115088], [26, 115448], [34, 116008], [36, 116430], [42, 116853], [48, 117113], [52, 117393], [59, 117673], [63, 118053], [68, 118741], [70, 118868], [73, 118968], [81, 119448]]}, {"verse": 13, "start": 120565, "end": 127778, "text": "Y el varón se engrandeció, y fue adelantando y engrandeciéndose, hasta hacerse muy poderoso:", "words": [[0, 120565], [2, 120692], [5, 120792], [11, 121192], [14, 121332], [27, 122172], [29, 122732], [33, 122932], [45, 124072], [47, 124332], [65, 125612], [71, 126032], [79, 126712], [83, 126932]]}, {"verse": 14, "start": 128128, "end": 134393, "text": "Y tuvo hato de ovejas, y hato de vacas, y grande apero; y los filisteos le tuvieron envidia.", "words": [[0, 128128], [2, 128249], [7, 128569], [12, 128889], [15, 128989], [23, 129509], [25, 129781], [30, 130054], [33, 130154], [40, 130814], [42, 131114], [49, 131434], [56, 132212], [58, 132440], [62, 132560], [72, 133180], [75, 133320], [84, 133720]]}, {"verse": 15, "start": 134743, "end": 143333, "text": "Y todos los pozos que habían abierto los criados de Abraham su padre en sus días, los filisteos los habían cegado y llenado de tierra.", "words": [[0, 134743], [2, 134886], [8, 135166], [12, 135426], [18, 135986], [22, 136146], [29, 136446], [37, 136926], [41, 137106], [49, 137686], [52, 137906], [60, 138506], [63, 138586], [69, 138906], [72, 139086], [76, 139226], [82, 139926], [86, 140436], [96, 140946], [100, 141106], [107, 141426], [114, 142086], [116, 142206], [124, 142646], [127, 142786]]}, {"verse": 16, "start": 143683, "end": 149760, "text": "Y dijo Abimelec a Isaac: Apártate de nosotros, porque mucho más poderoso que nosotros te has hecho.", "words": [[0, 143683], [2, 143849], [7, 144375], [16, 144902], [18, 145428], [25, 146127], [34, 146665], [37, 146765], [47, 147165], [54, 147465], [60, 147785], [64, 147965], [73, 148485], [77, 148645], [86, 148925], [89, 149265], [93, 149405]]}, {"verse": 17, "start": 150040, "end": 156176, "text": "E Isaac se fue de allí; y asentó sus tiendas en el valle de Gerar, y habitó allí.", "words": [[0, 150040], [2, 150308], [8, 150608], [11, 151188], [15, 151388], [18, 151768], [24, 152296], [26, 152462], [33, 153002], [37, 153202], [45, 153802], [48, 153942], [51, 154082], [57, 154362], [60, 154652], [67, 154942], [69, 155322], [76, 155742]]}, {"verse": 18, "start": 156526, "end": 170387, "text": "Y volvió a abrir Isaac los pozos de agua que habían abierto en los días de Abraham su padre, y que los filisteos habían cegado, muerto Abraham; y los llamó por los nombres que su padre los había llamado.", "words": [[0, 156526], [2, 156663], [9, 157123], [11, 157283], [17, 157713], [23, 158143], [27, 158538], [33, 159038], [36, 159178], [41, 159578], [45, 159793], [52, 160033], [60, 160513], [63, 160693], [67, 160813], [72, 161073], [75, 161253], [83, 161833], [86, 161913], [93, 162813], [95, 162853], [99, 162953], [103, 163093], [113, 163793], [120, 164073], [128, 164773], [135, 165313], [144, 166324], [146, 166425], [150, 166565], [156, 167025], [160, 167225], [164, 167385], [172, 168005], [176, 168465], [179, 168625], [185, 168998], [189, 169372], [195, 169745]]}, {"verse": 19, "start": 170737, "end": 176691, "text": "Y los siervos de Isaac cavaron en el valle, y hallaron allí un pozo de aguas vivas.", "words": [[0, 170737], [2, 170823], [6, 170963], [14, 171503], [17, 171623], [23, 172163], [31, 172858], [34, 173018], [37, 173178], [44, 173498], [46, 173958], [55, 174378], [60, 174618], [63, 174858], [68, 175338], [71, 175498], [77, 175898]]}, {"verse": 20, "start": 177041, "end": 188323, "text": "Y los pastores de Gerar riñeron con los pastores de Isaac, diciendo: El agua es nuestra: por eso llamó el nombre del pozo Esek, porque habían altercado con él.", "words": [[0, 177041], [2, 177166], [6, 177286], [15, 177786], [18, 178116], [24, 178446], [32, 179281], [36, 179481], [40, 179681], [49, 180161], [52, 180321], [59, 180741], [69, 181931], [72, 182071], [77, 182371], [80, 182751], [89, 183706], [93, 183872], [97, 184052], [103, 184412], [106, 184512], [113, 184812], [117, 185032], [122, 185552], [128, 186072], [135, 186512], [142, 186872], [152, 187652], [156, 187912]]}, {"verse": 21, "start": 188673, "end": 195006, "text": "Y abrieron otro pozo, y también riñeron sobre él: y llamó su nombre Sitna.", "words": [[0, 188673], [2, 188943], [11, 189463], [16, 189663], [22, 190263], [24, 190623], [32, 191363], [40, 192103], [46, 192423], [50, 193179], [52, 193306], [58, 193626], [61, 193766], [68, 194386]]}, {"verse": 22, "start": 195356, "end": 208217, "text": "Y se apartó de allí, y abrió otro pozo, y no riñeron sobre él: y llamó su nombre Rehobot, y dijo: Porque ahora nos ha hecho ensanchar Jehová, y fructificaremos en la tierra.", "words": [[0, 195356], [2, 195543], [5, 195643], [12, 196203], [15, 196363], [21, 196663], [23, 197203], [29, 197543], [34, 197803], [40, 198423], [42, 198943], [45, 199373], [53, 199803], [59, 200123], [63, 200855], [65, 201002], [71, 201322], [74, 201482], [81, 202382], [90, 203282], [92, 203462], [98, 204176], [105, 204385], [111, 204665], [115, 204865], [118, 205045], [124, 205245], [134, 205815], [142, 206385], [144, 206585], [160, 207405], [163, 207605], [166, 207705]]}, {"verse": 23, "start": 208497, "end": 210207, "text": "Y de allí subió a Beerseba.", "words": [[0, 208497], [2, 208661], [5, 208721], [10, 208921], [16, 209381], [18, 209819]]}, {"verse": 24, "start": 210557, "end": 223716, "text": "Y se le apareció Jehová aquella noche, y dijo: Yo soy el Dios de Abraham tu padre; no temas, que yo soy contigo, y yo te bendeciré, y multiplicaré tu descendencia por amor de Abraham mi siervo.", "words": [[0, 210557], [2, 210704], [5, 210824], [8, 210984], [17, 211624], [24, 212184], [32, 212544], [39, 212884], [41, 213164], [47, 213843], [50, 214003], [54, 214303], [57, 214503], [62, 214723], [65, 214943], [73, 215583], [76, 215643], [83, 216666], [86, 216826], [93, 217206], [97, 217606], [100, 217766], [104, 217966], [113, 218706], [115, 218966], [118, 219106], [121, 219246], [132, 220046], [134, 220346], [147, 221066], [150, 221206], [163, 221966], [167, 222166], [172, 222386], [175, 222676], [183, 222966], [186, 223166]]}, {"verse": 25, "start": 224252, "end": 234589, "text": "Y edificó allí un altar, e invocó el nombre de Jehová, y tendió allí su tienda: y abrieron allí los siervos de Isaac un pozo.", "words": [[0, 224252], [2, 224412], [10, 225172], [15, 225392], [18, 225672], [25, 226692], [27, 226792], [34, 227492], [37, 227652], [44, 228032], [47, 228232], [55, 229072], [57, 229312], [64, 229852], [69, 230132], [72, 230352], [80, 231261], [82, 231366], [91, 231726], [96, 232086], [100, 232326], [108, 232906], [111, 233086], [117, 233486], [120, 233926]]}, {"verse": 26, "start": 234939, "end": 242349, "text": "Y Abimelec vino a él desde Gerar, y Ahuzat, amigo suyo, y Ficol, capitán de su ejército.", "words": [[0, 234939], [2, 235333], [11, 235763], [16, 236043], [18, 236323], [21, 236483], [27, 236923], [34, 237363], [36, 238103], [44, 238843], [50, 239163], [56, 239803], [58, 239963], [65, 240703], [73, 241263], [76, 241383], [79, 241503]]}, {"verse": 27, "start": 242699, "end": 249104, "text": "Y les dijo Isaac: ¿Por qué venís a mí, pues que me habéis aborrecido, y me echasteis de entre vosotros?", "words": [[0, 242778], [2, 242898], [6, 243018], [11, 243498], [18, 244239], [23, 244365], [27, 244485], [33, 244805], [35, 244905], [39, 245485], [44, 245565], [48, 245705], [51, 245825], [58, 246065], [70, 246805], [72, 247245], [75, 247365], [85, 247965], [88, 248065], [94, 248285]]}, {"verse": 28, "start": 249384, "end": 259839, "text": "Y ellos respondieron: Hemos visto que Jehová es contigo; y dijimos: Haya ahora juramento entre nosotros, entre nosotros y ti, y haremos pacto contigo:", "words": [[0, 249384], [2, 249567], [8, 249907], [22, 251524], [28, 251742], [34, 252142], [38, 252492], [45, 252842], [48, 252962], [57, 254152], [59, 254452], [68, 254917], [73, 255181], [79, 255441], [89, 256021], [95, 256281], [105, 257021], [111, 257221], [120, 257681], [122, 257981], [126, 258481], [128, 258561], [136, 258821], [142, 259281]]}, {"verse": 29, "start": 260189, "end": 268205, "text": "Que no nos hagas mal, como nosotros no te hemos tocado, y como solamente te hemos hecho bien, y te enviamos en paz: tú ahora, bendito de Jehová.", "words": [[0, 260189], [4, 260270], [7, 260450], [11, 260630], [17, 260950], [22, 261370], [27, 261550], [36, 261990], [39, 262210], [42, 262370], [48, 262510], [56, 263050], [58, 263270], [63, 263450], [73, 263850], [76, 264150], [82, 264310], [88, 264570], [94, 264870], [96, 265110], [99, 265270], [108, 265690], [111, 265870], [116, 266577], [119, 266693], [126, 267133], [134, 267573], [137, 267693]]}, {"verse": 30, "start": 268485, "end": 272821, "text": "Entonces él les hizo banquete, y comieron y bebieron.", "words": [[0, 268485], [9, 269089], [12, 269749], [16, 270114], [21, 270374], [31, 271074], [33, 271289], [42, 271809], [44, 272009]]}, {"verse": 31, "start": 273171, "end": 281859, "text": "Y se levantaron de madrugada, y juraron el uno al otro; e Isaac los despidió, y ellos se partieron de él en paz.", "words": [[0, 273171], [2, 273278], [5, 273398], [16, 274038], [19, 274198], [30, 274898], [32, 274998], [40, 275538], [43, 275738], [47, 275958], [50, 276158], [56, 276918], [58, 276918], [64, 277499], [68, 278159], [78, 279079], [80, 279639], [86, 279959], [89, 280179], [99, 280739], [102, 281019], [105, 281199], [108, 281339]]}, {"verse": 32, "start": 282209, "end": 292103, "text": "Y en aquel día sucedió que vinieron los criados de Isaac, y le dieron nuevas acerca del pozo que habían abierto, y le dijeron: Agua hemos hallado.", "words": [[0, 282209], [2, 282368], [5, 282488], [11, 282828], [15, 283108], [23, 283888], [27, 284048], [36, 284608], [40, 284808], [48, 285348], [51, 285488], [58, 286008], [60, 286588], [63, 286708], [70, 287048], [77, 287388], [84, 287908], [88, 288208], [93, 288668], [97, 288828], [104, 289068], [113, 289688], [115, 289923], [118, 290043], [127, 290988], [132, 291326], [138, 291466]]}, {"verse": 33, "start": 292383, "end": 298843, "text": "Y lo llamó Seba: por cuya causa el nombre de aquella ciudad es Beerseba hasta este día.", "words": [[0, 292383], [2, 292647], [5, 292947], [11, 293247], [17, 293698], [21, 293843], [26, 294203], [32, 294643], [35, 294903], [42, 295283], [45, 295503], [53, 295903], [60, 296203], [63, 296893], [72, 297583], [78, 297963], [83, 298263]]}, {"verse": 34, "start": 299193, "end": 308519, "text": "Y cuando Esaú fue de cuarenta años, tomó por mujer a Judit hija de Beeri heteo, y a Basemat hija de Elón heteo:", "words": [[0, 299193], [2, 299318], [9, 299748], [14, 300178], [18, 300438], [21, 300578], [30, 301178], [36, 302158], [41, 302638], [45, 302818], [51, 303218], [53, 303788], [59, 304358], [64, 304658], [67, 305191], [73, 305725], [80, 306258], [82, 306665], [84, 307071], [92, 307478], [97, 307798], [100, 307918], [105, 308219]]}, {"verse": 35, "start": 308869, "end": 312177, "text": "Y fueron amargura de espíritu a Isaac y a Rebeca.", "words": [[0, 309455], [2, 309547], [9, 309947], [18, 310347], [21, 310487], [30, 310927], [32, 311197], [38, 311467], [40, 311587], [42, 311627]]}]}