{"book": "RUT", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 176954, "verses": [{"verse": 1, "start": 300, "end": 7483, "text": "Y LE DIJO su suegra Noemí: Hija mía, ¿no te he de buscar hogar para ti, para que te vaya bien?", "words": [[0, 300], [2, 444], [5, 544], [10, 844], [13, 1344], [20, 2044], [27, 2922], [32, 3169], [37, 4029], [41, 4169], [44, 4369], [47, 4469], [50, 4589], [57, 4869], [63, 5349], [68, 5549], [72, 6229], [77, 6449], [81, 6589], [84, 6709], [89, 6909]]}, {"verse": 2, "start": 7933, "end": 15838, "text": "¿No es Booz nuestro pariente, con cuyas criadas tú has estado? He aquí que él avienta esta noche la parva de las cebadas.", "words": [[0, 7933], [4, 8079], [7, 8299], [12, 8519], [20, 8879], [30, 9599], [34, 9859], [40, 10359], [48, 10859], [51, 11039], [55, 11199], [63, 12182], [66, 12322], [71, 12602], [75, 12802], [78, 13022], [86, 13502], [91, 13722], [97, 14082], [100, 14422], [106, 14762], [109, 14882], [113, 15022]]}, {"verse": 3, "start": 16288, "end": 27623, "text": "Te lavarás pues, y te ungirás, y vistiéndote tus vestidos, pasarás a la era; mas no te darás a conocer al varón hasta que él haya acabado de comer y de beber.", "words": [[0, 16288], [3, 16365], [11, 16885], [17, 17145], [19, 17505], [22, 17625], [31, 18305], [33, 18725], [45, 19365], [49, 19565], [59, 20125], [67, 20845], [69, 20965], [72, 21045], [77, 21940], [81, 22100], [84, 22360], [87, 22500], [93, 22920], [95, 23020], [103, 23460], [106, 23700], [112, 24180], [118, 24760], [122, 25000], [125, 25240], [130, 25560], [138, 26140], [141, 26280], [147, 26600], [149, 26960], [152, 27120]]}, {"verse": 4, "start": 28073, "end": 39003, "text": "Y cuando él se acueste, notarás el lugar donde él se acostará, e irás, y descubrirás los pies, y te acostarás allí; y él te dirá lo que hayas de hacer.", "words": [[0, 28073], [2, 28233], [9, 28466], [12, 28700], [15, 28933], [24, 29593], [32, 30473], [35, 30633], [41, 30853], [47, 31106], [50, 31360], [53, 31613], [63, 32333], [65, 32833], [71, 33313], [73, 33653], [85, 34433], [89, 34633], [95, 34973], [97, 35493], [100, 35613], [110, 36333], [116, 37021], [118, 37151], [121, 37291], [124, 37451], [129, 37751], [132, 37871], [136, 38031], [142, 38411], [145, 38551]]}, {"verse": 5, "start": 39353, "end": 42679, "text": "Y le respondió: Haré todo lo que tú me mandes.", "words": [[0, 39353], [2, 39498], [5, 39638], [16, 40767], [21, 41027], [26, 41247], [29, 41507], [33, 41647], [36, 41807], [39, 41967]]}, {"verse": 6, "start": 43029, "end": 48405, "text": "Descendió pues a la era, e hizo todo lo que su suegra le había mandado.", "words": [[0, 43029], [10, 43733], [15, 43973], [17, 44293], [20, 44433], [25, 45413], [27, 45673], [32, 45893], [37, 46173], [40, 46413], [44, 46553], [47, 46733], [54, 47233], [57, 47393], [63, 47633]]}, {"verse": 7, "start": 48855, "end": 61848, "text": "Y como Booz hubo comido y bebido, y su corazón estuvo contento, se retiró a dormir a un lado del montón. Entonces ella vino calladamente, y descubrió los pies, y se acostó.", "words": [[0, 48855], [2, 48982], [7, 49272], [12, 49562], [17, 50122], [24, 50542], [26, 50642], [34, 51382], [36, 51602], [39, 51742], [47, 52142], [54, 52582], [64, 53642], [67, 53842], [74, 54362], [76, 54482], [83, 54702], [85, 54922], [88, 55022], [93, 55302], [97, 55542], [105, 56701], [114, 57303], [119, 57783], [124, 58043], [138, 58863], [140, 59383], [150, 59923], [154, 60063], [160, 60363], [162, 61103], [165, 61223]]}, {"verse": 8, "start": 62298, "end": 72213, "text": "Y aconteció, que a la media noche se estremeció aquel hombre, y se volvió: y he aquí, la mujer que estaba acostada a sus pies.", "words": [[0, 62298], [2, 62443], [13, 63243], [17, 63523], [19, 63623], [22, 63930], [28, 64236], [34, 64543], [37, 65023], [48, 65863], [54, 66203], [62, 66563], [64, 67103], [67, 67263], [75, 68243], [77, 68450], [80, 68590], [86, 68990], [89, 69670], [95, 69990], [99, 70190], [106, 70510], [115, 71270], [117, 71390], [121, 71530]]}, {"verse": 9, "start": 72663, "end": 84420, "text": "Entonces él dijo: ¿Quién eres? Y ella respondió: Yo soy Ruth tu sierva: extiende el borde de tu capa sobre tu sierva, por cuanto eres pariente cercano.", "words": [[0, 72663], [9, 73389], [12, 73869], [18, 74694], [25, 74958], [31, 75807], [33, 76008], [38, 76288], [49, 77556], [52, 77701], [56, 77941], [61, 78321], [64, 78461], [72, 79461], [81, 80008], [84, 80108], [90, 80428], [93, 80628], [96, 80748], [101, 81148], [107, 81368], [110, 81568], [118, 82308], [122, 82568], [129, 82828], [134, 83108], [143, 83588]]}, {"verse": 10, "start": 84770, "end": 94802, "text": "Y él dijo: Bendita seas tú de Jehová, hija mía; que has hecho mejor tu postrera bondad que la primera, no yendo tras los jóvenes, sean pobres o ricos.", "words": [[0, 84770], [2, 84956], [5, 85340], [11, 86200], [19, 86490], [24, 86650], [27, 86990], [30, 87150], [38, 87630], [43, 88030], [48, 88711], [52, 88801], [56, 88961], [62, 89121], [68, 89441], [71, 89601], [80, 90081], [87, 90541], [91, 90661], [94, 90781], [103, 91621], [106, 91741], [112, 92041], [117, 92241], [121, 92441], [130, 93261], [135, 93481], [142, 94021], [144, 94221]]}, {"verse": 11, "start": 95252, "end": 103028, "text": "Ahora pues, no temas, hija mía: yo haré contigo lo que tú digas, pues que toda la gente de mi pueblo sabe que eres mujer virtuosa.", "words": [[0, 95252], [6, 95569], [12, 95789], [15, 96009], [22, 96409], [27, 96709], [32, 97302], [35, 97453], [40, 97713], [48, 98133], [51, 98273], [55, 98393], [58, 98533], [65, 99293], [70, 99533], [74, 99713], [79, 99893], [82, 100093], [88, 100373], [91, 100573], [94, 100693], [101, 100993], [106, 101433], [110, 101653], [115, 101833], [121, 102173]]}, {"verse": 12, "start": 103478, "end": 108954, "text": "Y ahora, aunque es cierto que yo soy pariente cercano, con todo eso hay pariente más cercano que yo.", "words": [[0, 103478], [2, 103595], [9, 103955], [16, 104135], [19, 104295], [26, 104535], [30, 104715], [33, 104855], [37, 105035], [46, 105395], [55, 106355], [59, 106455], [64, 106695], [68, 106995], [72, 107275], [81, 107715], [85, 107935], [93, 108475], [97, 108615]]}, {"verse": 13, "start": 109404, "end": 121877, "text": "Reposa esta noche, y cuando sea de día, si él te redime, bien, que te redima; mas si él no te quiere redimir, yo te redimiré, vive Jehová. Descansa pues hasta la mañana.", "words": [[0, 109630], [7, 109890], [12, 110130], [19, 110470], [21, 110710], [28, 110930], [32, 111250], [35, 111410], [40, 112110], [43, 112340], [46, 112570], [49, 112690], [57, 113110], [63, 113390], [67, 113630], [70, 113750], [78, 114686], [82, 114766], [85, 114966], [88, 115126], [91, 115286], [94, 115406], [101, 115646], [110, 116546], [113, 116786], [116, 116926], [126, 117766], [131, 117946], [139, 118865], [148, 119467], [153, 119687], [159, 120107], [162, 120247]]}, {"verse": 14, "start": 122227, "end": 134753, "text": "Y después que reposó a sus pies hasta la mañana, se levantó, antes que pudieran reconocerse unos a otros. Y él dijo: No se sepa que haya venido mujer a la era.", "words": [[0, 122227], [2, 122331], [10, 122631], [14, 122871], [21, 123491], [23, 123591], [27, 123731], [32, 124031], [38, 124291], [41, 124451], [49, 125431], [52, 125531], [61, 126251], [67, 126931], [71, 127151], [80, 127671], [92, 128591], [97, 128951], [99, 129251], [106, 130106], [108, 130292], [111, 130676], [117, 131288], [120, 131413], [123, 131533], [128, 131813], [132, 131953], [137, 132113], [144, 132453], [150, 132713], [152, 132913], [155, 132993]]}, {"verse": 15, "start": 135103, "end": 147085, "text": "Después le dijo: Quítate el manto que traes sobre ti, y tenlo. Y teniéndolo ella, él midió seis medidas de cebada, y se las puso a cuestas: y se vino ella a la ciudad.", "words": [[0, 135103], [8, 135425], [11, 135625], [17, 136402], [25, 136839], [28, 137019], [34, 137339], [38, 137579], [44, 137819], [50, 137999], [54, 138299], [56, 138754], [63, 139525], [65, 139879], [76, 140269], [82, 140649], [85, 140929], [91, 141369], [96, 141789], [104, 142309], [107, 142569], [115, 143089], [117, 143669], [120, 143789], [124, 143929], [129, 144358], [131, 144786], [140, 145437], [142, 145544], [145, 145684], [150, 145924], [155, 146244], [157, 146384], [160, 146444]]}, {"verse": 16, "start": 147535, "end": 157120, "text": "Así que vino a su suegra, esta le dijo: ¿Qué pues, hija mía? Y le declaró ella todo lo que con aquel varón le había acontecido.", "words": [[0, 147535], [4, 147724], [8, 147904], [13, 148124], [15, 148284], [18, 148444], [26, 149404], [31, 149704], [34, 149884], [40, 150671], [45, 150772], [51, 151252], [56, 151512], [61, 153053], [63, 153175], [66, 153545], [74, 153915], [79, 154095], [84, 154455], [87, 154735], [91, 154895], [95, 155095], [101, 155375], [107, 155735], [110, 155875], [116, 156135]]}, {"verse": 17, "start": 157570, "end": 164682, "text": "Y dijo: Estas seis medidas de cebada me dio, diciéndome: Para que no vayas vacía a tu suegra.", "words": [[0, 157570], [2, 157710], [8, 158414], [14, 158839], [19, 159119], [27, 159659], [30, 159919], [37, 160399], [40, 160599], [45, 161159], [57, 162319], [62, 162501], [66, 162641], [69, 162881], [75, 163321], [81, 163841], [83, 163941], [86, 164041]]}, {"verse": 18, "start": 165032, "end": 176554, "text": "Entonces Noemí dijo: Reposa, hija mía, hasta que sepas cómo se resuelve el asunto: porque aquel hombre no parará hasta que hoy concluya el asunto.", "words": [[0, 165032], [9, 165858], [15, 166318], [21, 167482], [29, 168164], [34, 168944], [39, 169564], [45, 169844], [49, 170044], [55, 170444], [60, 170784], [63, 170984], [72, 171544], [75, 171644], [83, 172557], [90, 172741], [96, 173061], [103, 173281], [106, 173561], [113, 174121], [119, 174761], [123, 174981], [127, 175121], [136, 175761], [139, 175881]]}]}