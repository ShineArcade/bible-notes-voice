{"book": "PSA", "chapter": 51, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 131778, "verses": [{"verse": 1, "start": 300, "end": 16042, "text": "Al Músico principal: Salmo de David, cuando después que entró a Betsabé, vino a él Natán el profeta. TEN piedad de mí, oh Dios, conforme a tu misericordia: conforme a la multitud de tus piedades borra mis rebeliones.", "words": [[0, 300], [3, 468], [10, 948], [21, 2118], [27, 2638], [30, 2778], [37, 3378], [44, 3638], [52, 4078], [56, 4258], [62, 4658], [64, 4798], [73, 5358], [78, 5918], [80, 6118], [83, 6298], [89, 6778], [92, 6978], [101, 8128], [105, 8334], [112, 8540], [115, 8801], [119, 9088], [122, 9374], [128, 9660], [137, 10300], [139, 10381], [142, 10481], [156, 11872], [165, 12481], [167, 12541], [170, 12621], [179, 13201], [182, 13361], [186, 13501], [195, 14161], [201, 14941], [205, 15101]]}, {"verse": 2, "start": 16392, "end": 21017, "text": "Lávame más y más de mi maldad, y límpiame de mi pecado.", "words": [[0, 16638], [7, 16918], [11, 17438], [13, 17718], [17, 17978], [20, 18098], [23, 18218], [31, 18718], [33, 19438], [42, 20158], [45, 20278], [48, 20358]]}, {"verse": 3, "start": 21367, "end": 26304, "text": "Porque yo reconozco mis rebeliones; y mi pecado está siempre delante de mí.", "words": [[0, 21367], [7, 21551], [10, 21751], [20, 22371], [24, 22531], [36, 23710], [38, 23833], [41, 23973], [48, 24553], [53, 24773], [61, 25153], [69, 25753], [72, 25933]]}, {"verse": 4, "start": 26654, "end": 36936, "text": "A ti, a ti solo he pecado, y he hecho lo malo delante de tus ojos: porque seas reconocido justo en tu palabra, y tenido por puro en tu juicio.", "words": [[0, 26654], [2, 26793], [6, 27053], [8, 27133], [11, 27293], [16, 27593], [19, 27793], [27, 28293], [29, 28973], [32, 29113], [38, 29553], [41, 29913], [46, 30253], [54, 30633], [57, 30793], [61, 30973], [67, 31949], [74, 32156], [79, 32456], [90, 33196], [96, 33436], [99, 33696], [102, 33816], [111, 34316], [113, 34996], [120, 35396], [124, 35616], [129, 36016], [132, 36156], [135, 36276]]}, {"verse": 5, "start": 37286, "end": 41699, "text": "He aquí, en maldad he sido formado, y en pecado me concibió mi madre.", "words": [[0, 37286], [3, 37449], [9, 37709], [12, 37869], [19, 38409], [22, 38469], [27, 38709], [36, 39269], [38, 39449], [41, 39589], [48, 40109], [51, 40289], [60, 40929], [63, 41089]]}, {"verse": 6, "start": 42049, "end": 47877, "text": "He aquí, tú amas la verdad en lo íntimo: y en lo secreto me has hecho comprender sabiduría.", "words": [[0, 42095], [3, 42175], [9, 42395], [12, 42695], [17, 43015], [20, 43115], [27, 43355], [30, 43655], [33, 43775], [41, 44613], [43, 44740], [46, 44860], [49, 44980], [57, 45560], [60, 45720], [64, 45880], [70, 46080], [81, 46999]]}, {"verse": 7, "start": 48227, "end": 54693, "text": "Purifícame con hisopo, y seré limpio: lávame, y seré emblanquecido más que la nieve.", "words": [[0, 48227], [11, 48833], [15, 49313], [23, 49793], [25, 50033], [30, 50293], [38, 51277], [46, 51806], [48, 52226], [53, 52626], [67, 53566], [71, 53806], [75, 53966], [78, 54106]]}, {"verse": 8, "start": 55043, "end": 60820, "text": "Hazme oír gozo y alegría; y se recrearán los huesos que has abatido.", "words": [[0, 55043], [6, 55520], [10, 55960], [15, 56420], [17, 56580], [26, 57506], [28, 57635], [31, 57815], [41, 58815], [45, 58995], [52, 59635], [56, 60042], [60, 60449]]}, {"verse": 9, "start": 61170, "end": 65348, "text": "Esconde tu rostro de mis pecados, y borra todas mis maldades.", "words": [[0, 61170], [8, 61618], [11, 61818], [18, 62298], [21, 62418], [25, 62538], [34, 63118], [36, 63558], [42, 63958], [48, 64218], [52, 64538]]}, {"verse": 10, "start": 65697, "end": 72056, "text": "Crea en mí, oh Dios, un corazón limpio; y renueva un espíritu recto dentro de mí.", "words": [[0, 65878], [5, 66057], [8, 66238], [12, 66488], [15, 66738], [21, 66958], [24, 67297], [32, 67697], [40, 68751], [42, 68933], [50, 69613], [53, 69773], [62, 70593], [68, 71133], [75, 71373], [78, 71713]]}, {"verse": 11, "start": 72406, "end": 76569, "text": "No me eches de delante de ti; y no quites de mí tu santo espíritu.", "words": [[0, 72406], [3, 72533], [6, 72713], [12, 72993], [15, 73233], [23, 73653], [26, 73853], [30, 74484], [32, 74607], [35, 74707], [42, 75107], [45, 75254], [48, 75400], [51, 75547], [57, 75867]]}, {"verse": 12, "start": 76919, "end": 81385, "text": "Vuélveme el gozo de tu salvación; y el espíritu libre me sustente.", "words": [[0, 76919], [9, 77277], [12, 77667], [17, 77967], [20, 78127], [23, 78247], [34, 79327], [36, 79436], [39, 79556], [48, 80056], [54, 80476], [57, 80536]]}, {"verse": 13, "start": 81735, "end": 87725, "text": "Enseñaré a los transgresores tus caminos; y los pecadores se convertirán a ti.", "words": [[0, 81735], [9, 82460], [11, 82600], [15, 82740], [29, 83660], [33, 83880], [42, 85011], [44, 85117], [48, 85217], [58, 85877], [61, 86437], [73, 87237], [75, 87337]]}, {"verse": 14, "start": 88075, "end": 95451, "text": "Líbrame de homicidios, oh Dios, Dios de mi salvación: cantará mi lengua tu justicia.", "words": [[0, 88459], [8, 88879], [11, 89039], [23, 90159], [26, 90379], [32, 91139], [37, 91479], [40, 91979], [43, 92099], [54, 93328], [62, 93868], [65, 94048], [72, 94528], [75, 94588]]}, {"verse": 15, "start": 95801, "end": 100389, "text": "Señor, abre mis labios; y publicará mi boca tu alabanza.", "words": [[0, 95801], [7, 96206], [12, 96826], [16, 97066], [24, 98053], [26, 98198], [36, 98878], [39, 99078], [44, 99338], [47, 99578]]}, {"verse": 16, "start": 100739, "end": 105516, "text": "Porque no quieres tú sacrificio, que yo daría; no quieres holocausto.", "words": [[0, 100739], [7, 101098], [10, 101318], [18, 101638], [21, 101938], [33, 102858], [37, 102978], [40, 103138], [47, 104005], [50, 104486], [58, 105001]]}, {"verse": 17, "start": 105866, "end": 114071, "text": "Los sacrificios de Dios son el espíritu quebrantado: al corazón contrito y humillado no despreciarás tú, oh Dios.", "words": [[0, 105866], [4, 106024], [16, 106904], [19, 107064], [24, 107324], [28, 107824], [31, 108024], [40, 108724], [53, 109956], [56, 110163], [64, 110603], [73, 111343], [75, 111503], [85, 112115], [88, 112582], [101, 113048], [105, 113298], [108, 113548]]}, {"verse": 18, "start": 114421, "end": 119578, "text": "Haz bien con tu benevolencia a Sion: edifica los muros de Jerusalén.", "words": [[0, 114421], [4, 114624], [9, 114884], [13, 115184], [16, 115424], [29, 116025], [31, 116626], [37, 117447], [45, 117956], [49, 118156], [55, 118596], [58, 118696]]}, {"verse": 19, "start": 119928, "end": 131378, "text": "Entonces te agradarán los sacrificios de justicia, el holocausto u ofrenda del todo quemada: entonces ofrecerán sobre tu altar becerros.", "words": [[0, 119928], [9, 120371], [12, 120691], [22, 121311], [26, 121451], [38, 122331], [41, 122431], [51, 123611], [54, 123751], [65, 124671], [67, 125111], [75, 125851], [79, 126051], [84, 126351], [93, 127406], [102, 128127], [112, 129527], [118, 129827], [121, 130087], [127, 130427]]}]}