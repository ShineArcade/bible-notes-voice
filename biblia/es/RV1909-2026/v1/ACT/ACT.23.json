{"book": "ACT", "chapter": 23, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 314477, "verses": [{"verse": 1, "start": 300, "end": 10935, "text": "Entonces Pablo, poniendo los ojos en el Consejo, dice: Varones hermanos, yo con toda buena conciencia he vivido delante de Dios hasta el día de hoy.", "words": [[0, 300], [9, 748], [16, 1568], [25, 2108], [29, 2328], [34, 2608], [37, 2828], [40, 2948], [49, 4068], [55, 5006], [63, 5216], [73, 6116], [76, 6416], [80, 6676], [85, 6876], [91, 7196], [102, 8056], [105, 8316], [112, 8736], [120, 9136], [123, 9296], [128, 9556], [134, 10056], [137, 10216], [141, 10396], [144, 10576]]}, {"verse": 2, "start": 11215, "end": 19095, "text": "El sumo sacerdote, Ananías, mandó entonces a los que estaban delante de él, que le hiriesen en la boca.", "words": [[0, 11215], [3, 11358], [8, 11818], [19, 12498], [28, 13818], [34, 14378], [43, 14938], [45, 15338], [49, 15458], [53, 15598], [61, 15938], [69, 16518], [72, 16718], [76, 17038], [80, 17458], [83, 17808], [92, 18158], [95, 18298], [98, 18558]]}, {"verse": 3, "start": 19445, "end": 29109, "text": "Entonces Pablo le dijo: Dios te herirá, pared blanqueada: ¿y estás tú sentado para juzgarme conforme a la ley, y contra la ley me mandas herir?", "words": [[0, 19445], [9, 20003], [15, 20763], [18, 21063], [24, 21728], [29, 22028], [32, 22308], [40, 22748], [46, 23068], [58, 24191], [61, 24293], [67, 24553], [70, 24793], [78, 25313], [83, 25533], [92, 26153], [101, 26713], [103, 26813], [106, 26893], [111, 27493], [113, 27553], [120, 27833], [123, 28013], [127, 28213], [130, 28333], [137, 28713]]}, {"verse": 4, "start": 29389, "end": 33958, "text": "Y los que estaban presentes dijeron: ¿Al sumo sacerdote de Dios maldices?", "words": [[0, 29389], [2, 29502], [6, 29662], [10, 29842], [18, 30162], [28, 30962], [37, 31755], [41, 31892], [46, 32232], [56, 32812], [59, 32972], [64, 33172]]}, {"verse": 5, "start": 34238, "end": 42105, "text": "Y Pablo dijo: No sabía, hermanos, que era el sumo sacerdote; pues escrito está: Al príncipe de tu pueblo no maldecirás.", "words": [[0, 34238], [2, 34383], [8, 34723], [14, 35470], [17, 35670], [24, 36050], [34, 36610], [38, 36770], [42, 36950], [45, 37050], [50, 37390], [61, 38347], [66, 38492], [74, 38852], [80, 39627], [83, 39745], [92, 40225], [95, 40365], [98, 40505], [105, 40845], [108, 41185]]}, {"verse": 6, "start": 42385, "end": 57989, "text": "Entonces Pablo, sabiendo que una parte era de saduceos y la otra de fariseos, clamó en el Consejo: Varones hermanos, yo soy fariseo, hijo de fariseo: de la esperanza y de la resurrección de los muertos soy yo juzgado.", "words": [[0, 42385], [9, 42977], [16, 44197], [25, 44837], [29, 45037], [33, 45177], [39, 45597], [43, 45977], [46, 46157], [55, 47017], [57, 47257], [60, 47397], [65, 47637], [68, 47837], [78, 49017], [84, 49477], [87, 49657], [90, 49777], [99, 50990], [107, 51200], [117, 52080], [120, 52200], [124, 52380], [133, 53200], [138, 53360], [141, 53520], [150, 54382], [153, 54482], [156, 54582], [166, 55222], [168, 55342], [171, 55442], [174, 55562], [187, 56242], [190, 56382], [194, 56502], [202, 56962], [206, 57242], [209, 57362]]}, {"verse": 7, "start": 58269, "end": 66042, "text": "Y cuando hubo dicho esto, fue hecha división entre los fariseos y los saduceos; y la multitud fue dividida.", "words": [[0, 58269], [2, 58369], [9, 58589], [14, 58949], [20, 59149], [26, 60009], [30, 60369], [36, 60589], [45, 61189], [51, 61449], [55, 61669], [64, 62409], [66, 62549], [70, 62709], [80, 64046], [82, 64168], [85, 64248], [94, 64868], [98, 65228]]}, {"verse": 8, "start": 66392, "end": 74524, "text": "Porque los saduceos dicen que no hay resurrección, ni ángel, ni espíritu; pero los fariseos confiesan ambas cosas.", "words": [[0, 66392], [7, 66577], [11, 66757], [20, 67537], [26, 67797], [30, 68037], [33, 68257], [37, 68457], [51, 69837], [54, 70097], [61, 70977], [64, 71117], [74, 72042], [79, 72186], [83, 72386], [92, 72966], [102, 73566], [108, 73846]]}, {"verse": 9, "start": 74874, "end": 89039, "text": "Y se levantó un gran clamor: y levantándose los escribas de la parte de los fariseos, contendían diciendo: Ningún mal hallamos en este hombre; que si espíritu le ha hablado, o ángel, no resistamos a Dios.", "words": [[0, 74874], [2, 75085], [5, 75205], [13, 75805], [16, 76065], [21, 76630], [29, 77351], [31, 77478], [44, 78478], [48, 78658], [57, 79238], [60, 79358], [63, 79478], [69, 79738], [72, 79938], [76, 80058], [86, 80928], [97, 81798], [107, 82807], [114, 83189], [118, 83519], [127, 83849], [130, 84029], [135, 84249], [143, 84956], [147, 85060], [150, 85200], [159, 85840], [162, 85960], [165, 86060], [174, 86560], [176, 86800], [183, 87640], [186, 87740], [197, 88380], [199, 88560]]}, {"verse": 10, "start": 89319, "end": 102892, "text": "Y habiendo gran disputa, el comandante, teniendo temor de que Pablo fuese despedazado de ellos, mandó venir soldados, y arrebatarle de en medio de ellos, y llevarle a la fortaleza.", "words": [[0, 89319], [2, 89442], [11, 89762], [16, 90062], [25, 90452], [28, 90842], [40, 91475], [49, 92109], [55, 92742], [58, 92962], [62, 93082], [68, 93642], [74, 94082], [86, 95382], [89, 95562], [96, 96402], [102, 96842], [108, 97102], [118, 97942], [120, 98187], [132, 99167], [135, 99547], [138, 99727], [144, 99987], [147, 100207], [154, 100567], [156, 101107], [165, 101707], [167, 101887], [170, 101987]]}, {"verse": 11, "start": 103242, "end": 115513, "text": "Y la noche siguiente, presentándosele el Señor, le dijo: Confía, Pablo; que como has testificado de mí en Jerusalén, así es necesario testifiques también en Roma.", "words": [[0, 103242], [2, 103364], [5, 103484], [11, 103724], [22, 104604], [38, 105784], [41, 105964], [48, 106944], [51, 107024], [57, 107803], [65, 108343], [72, 109140], [76, 109584], [81, 109824], [85, 110044], [97, 110724], [100, 110924], [103, 111104], [106, 111244], [117, 112344], [121, 112584], [124, 112884], [134, 113604], [146, 114324], [154, 114704], [157, 114944]]}, {"verse": 12, "start": 115863, "end": 127827, "text": "Y venido el día, algunos de los judíos se juntaron, e hicieron voto bajo de maldición, diciendo que ni comerían ni beberían hasta que hubiesen muerto a Pablo.", "words": [[0, 115863], [2, 115984], [9, 116364], [12, 116524], [17, 117364], [25, 117804], [28, 118004], [32, 118144], [39, 118644], [42, 118784], [52, 119524], [54, 119924], [63, 120404], [68, 120924], [73, 121144], [76, 121404], [87, 122624], [96, 123144], [100, 123584], [103, 123944], [112, 124704], [115, 125024], [124, 125724], [130, 126064], [134, 126244], [143, 126624], [150, 127124], [152, 127264]]}, {"verse": 13, "start": 128177, "end": 131351, "text": "Y eran más de cuarenta los que habían hecho esta conspiración;", "words": [[0, 128177], [2, 128318], [7, 128498], [11, 128738], [14, 128978], [23, 129218], [27, 129518], [31, 129698], [38, 129958], [44, 130178], [49, 130398]]}, {"verse": 14, "start": 131701, "end": 143155, "text": "Los cuales se fueron a los principales sacerdotes y a los ancianos, y dijeron: Nosotros hemos hecho voto debajo de maldición, que no hemos de comer nada hasta que hayamos muerto a Pablo.", "words": [[0, 131701], [4, 131791], [11, 132011], [14, 132251], [21, 132491], [23, 132691], [27, 132811], [39, 133451], [50, 134171], [52, 134591], [54, 134651], [58, 134751], [68, 135431], [70, 135551], [79, 137081], [88, 137480], [94, 137740], [100, 138020], [105, 138460], [112, 138800], [115, 138960], [126, 139880], [130, 140120], [133, 140340], [139, 140500], [142, 140700], [148, 140900], [153, 141320], [159, 141720], [163, 141880], [171, 142220], [178, 142600], [180, 142740]]}, {"verse": 15, "start": 143505, "end": 155844, "text": "Ahora pues, vosotros, con el Consejo, requerid al comandante que le saque mañana a vosotros como que queréis entender de él alguna cosa más cierta; y nosotros, antes que él llegue, estaremos listos para matarle.", "words": [[0, 143505], [6, 143761], [12, 144001], [22, 144521], [26, 144801], [29, 144921], [38, 145651], [47, 146381], [50, 146501], [61, 147181], [65, 147321], [68, 147441], [74, 147781], [81, 148121], [83, 148341], [92, 148841], [97, 149421], [101, 149691], [109, 149961], [118, 150401], [121, 150721], [124, 150921], [131, 151201], [136, 151581], [140, 151761], [148, 152551], [150, 152655], [160, 152835], [166, 153235], [170, 153495], [173, 153615], [181, 154215], [191, 154655], [198, 155095], [203, 155255]]}, {"verse": 16, "start": 156124, "end": 164039, "text": "Entonces un hijo de la hermana de Pablo, oyendo las emboscadas, fue, y entró en la fortaleza, y dio aviso a Pablo.", "words": [[0, 156124], [9, 157021], [12, 157194], [17, 157434], [20, 157594], [23, 157734], [31, 158134], [34, 158274], [41, 158814], [48, 159194], [52, 159414], [64, 160354], [69, 160514], [71, 161134], [77, 161614], [80, 161734], [83, 161854], [94, 162554], [96, 162714], [100, 163054], [106, 163394], [108, 163514]]}, {"verse": 17, "start": 164389, "end": 172324, "text": "Y Pablo, llamando a uno de los centuriones, dice: Lleva a este joven al comandante, porque tiene cierto aviso que darle.", "words": [[0, 164389], [2, 164506], [9, 165026], [18, 165506], [20, 165706], [24, 165906], [27, 166046], [31, 166166], [44, 167266], [50, 168054], [56, 168337], [58, 168457], [63, 168677], [69, 169117], [72, 169237], [84, 170157], [91, 170517], [97, 170857], [104, 171237], [110, 171697], [114, 171857]]}, {"verse": 18, "start": 172604, "end": 182032, "text": "Él entonces tomándole, le llevó al comandante, y dijo: El preso Pablo, llamándome, me rogó que trajese a ti este joven, que tiene algo que hablarte.", "words": [[0, 172604], [3, 173041], [12, 173584], [23, 174154], [26, 174724], [32, 175044], [35, 175144], [47, 175824], [49, 175964], [55, 176660], [58, 176784], [64, 177144], [71, 177684], [83, 178544], [86, 178704], [91, 179044], [95, 179354], [103, 179664], [105, 179804], [108, 179924], [113, 180164], [120, 180704], [124, 180784], [130, 181044], [135, 181284], [139, 181444]]}, {"verse": 19, "start": 182312, "end": 189465, "text": "Y el comandante, tomándole de la mano y retirándose aparte, le preguntó: ¿Qué es lo que tienes que decirme?", "words": [[0, 182312], [2, 182476], [5, 182616], [17, 183276], [27, 184016], [30, 184136], [33, 184296], [38, 184716], [40, 184931], [52, 185731], [60, 186951], [63, 187031], [73, 187915], [78, 188055], [81, 188175], [84, 188315], [88, 188415], [95, 188675], [99, 188855]]}, {"verse": 20, "start": 189745, "end": 197721, "text": "Y él dijo: Los judíos han convenido en rogarte que mañana saques a Pablo al Consejo, como que han de inquirir de él alguna cosa más cierta.", "words": [[0, 189745], [2, 189933], [5, 190093], [11, 190812], [15, 190902], [22, 191382], [26, 191522], [36, 192082], [39, 192182], [47, 192622], [51, 192802], [58, 193082], [65, 193662], [67, 193862], [73, 194082], [76, 194302], [85, 195002], [90, 195162], [94, 195387], [98, 195612], [101, 195837], [110, 196062], [113, 196162], [116, 196342], [123, 196622], [128, 196942], [132, 197102]]}, {"verse": 21, "start": 198071, "end": 210489, "text": "Pero tú no los creas; porque más de cuarenta hombres de ellos le acechan, los cuales han hecho voto debajo de maldición, de no comer ni beber hasta que le hayan muerto; y ahora están listos esperando tu promesa.", "words": [[0, 198071], [5, 198197], [8, 198397], [11, 198517], [15, 198657], [22, 199287], [29, 199514], [33, 199814], [36, 200114], [45, 200414], [53, 200774], [56, 201014], [62, 201274], [65, 201474], [74, 202354], [78, 202434], [85, 202754], [89, 203114], [95, 203354], [100, 203794], [107, 204174], [110, 204334], [121, 205314], [124, 205374], [127, 205574], [133, 205854], [136, 206114], [142, 206414], [148, 206774], [152, 206954], [155, 207094], [161, 207434], [169, 208196], [171, 208278], [177, 208438], [183, 208698], [190, 209158], [200, 209538], [203, 209818]]}, {"verse": 22, "start": 210769, "end": 218375, "text": "Entonces el comandante despidió al joven, mandándole que a nadie dijese que le había dado aviso de esto.", "words": [[0, 210769], [9, 211266], [12, 211626], [23, 212326], [32, 213006], [35, 213106], [42, 213626], [53, 214586], [57, 214866], [59, 215246], [65, 215586], [72, 216206], [76, 216406], [79, 216566], [85, 216826], [90, 217126], [96, 217626], [99, 217826]]}, {"verse": 23, "start": 218725, "end": 231001, "text": "Y llamados dos centuriones, mandó que preparasen para la tercera hora de la noche doscientos soldados, que fuesen hasta Cesarea, y setenta de a caballo, y doscientos lanceros;", "words": [[0, 218725], [2, 218848], [11, 219228], [15, 219468], [28, 220788], [34, 221208], [38, 221668], [49, 222128], [54, 222408], [57, 222608], [65, 223048], [70, 223488], [73, 223608], [76, 223748], [82, 224068], [93, 224388], [103, 225448], [107, 225848], [114, 226308], [120, 226668], [129, 227428], [131, 227928], [139, 228428], [142, 228755], [144, 229081], [153, 229408], [155, 229720], [166, 230033]]}, {"verse": 24, "start": 231351, "end": 238833, "text": "Y que preparasen cabalgaduras en que poniendo a Pablo, le llevasen a salvo a Félix el gobernador.", "words": [[0, 231351], [2, 231473], [6, 231593], [17, 232603], [30, 233613], [33, 234013], [37, 234173], [46, 234693], [48, 234853], [55, 235366], [58, 235880], [67, 236393], [69, 236513], [75, 236913], [77, 237013], [83, 237593], [86, 237953]]}, {"verse": 25, "start": 239183, "end": 242000, "text": "Y escribió una carta en estos términos:", "words": [[0, 239183], [2, 239440], [11, 240100], [15, 240260], [21, 240680], [24, 240900], [30, 241100]]}, {"verse": 26, "start": 242200, "end": 246397, "text": "Claudio Lisias al excelentísimo gobernador Félix: Saludos.", "words": [[0, 242200], [8, 242724], [15, 243254], [18, 243334], [32, 244094], [43, 244734], [50, 245644]]}, {"verse": 27, "start": 246747, "end": 254679, "text": "A este hombre, aprehendido de los judíos, y que iban ellos a matar, libré yo acudiendo con la tropa, habiendo entendido que era Romano.", "words": [[0, 246747], [2, 246873], [7, 247073], [15, 247583], [27, 248093], [30, 248213], [34, 248333], [42, 248953], [44, 249293], [48, 249433], [53, 249693], [59, 249873], [61, 250053], [68, 250893], [74, 251293], [77, 251473], [87, 252013], [91, 252173], [94, 252333], [101, 252853], [110, 253213], [120, 253793], [124, 253973], [128, 254113]]}, {"verse": 28, "start": 255029, "end": 259641, "text": "Y queriendo saber la causa por qué le acusaban, le llevé al Consejo de ellos:", "words": [[0, 255029], [2, 255127], [12, 255547], [18, 255867], [21, 256087], [27, 256407], [31, 256707], [35, 256847], [38, 256967], [48, 257907], [51, 258127], [57, 258407], [60, 258547], [68, 259007], [71, 259127]]}, {"verse": 29, "start": 259991, "end": 266304, "text": "Y hallé que le acusaban de cuestiones de la ley de ellos, y que ningún crimen tenía digno de muerte o de prisión.", "words": [[0, 259991], [2, 260188], [8, 260388], [12, 260568], [15, 260688], [24, 261208], [27, 261348], [38, 261928], [41, 262128], [44, 262248], [48, 262448], [51, 262588], [58, 262908], [60, 263093], [64, 263213], [71, 263513], [78, 264013], [84, 264333], [90, 264813], [93, 264873], [100, 265233], [102, 265573], [105, 265693]]}, {"verse": 30, "start": 266654, "end": 278661, "text": "Pero siéndome dado aviso de emboscadas que le habían tendido los judíos, luego al punto le he enviado a ti, ordenando también a los acusadores que traten delante de ti lo que tienen contra él. Pásalo bien.", "words": [[0, 266654], [5, 266984], [14, 267314], [19, 267534], [25, 267894], [28, 268034], [39, 268594], [43, 268814], [46, 268914], [53, 269154], [61, 269654], [65, 269794], [73, 270714], [79, 270874], [82, 271074], [88, 271334], [91, 271574], [94, 271674], [102, 272054], [104, 272174], [108, 272707], [118, 273269], [126, 273589], [128, 273829], [132, 273909], [143, 274549], [147, 274829], [154, 275249], [162, 275729], [165, 275889], [168, 276109], [171, 276409], [175, 276549], [182, 276869], [189, 277229], [193, 277842], [200, 278210]]}, {"verse": 31, "start": 278941, "end": 284948, "text": "Y los soldados, tomando a Pablo como les era mandado, le llevaron de noche a Antipatris.", "words": [[0, 278941], [2, 279053], [6, 279193], [16, 279793], [24, 280353], [26, 280493], [32, 280813], [37, 281133], [41, 281353], [45, 281553], [54, 282173], [57, 282793], [66, 283193], [69, 283353], [75, 283633], [77, 283973]]}, {"verse": 32, "start": 285298, "end": 292111, "text": "Y al día siguiente, dejando a los de a caballo que fuesen con él, se volvieron a la fortaleza.", "words": [[0, 285298], [2, 285439], [5, 285559], [9, 285739], [20, 286539], [28, 287079], [30, 287279], [34, 287539], [37, 287859], [39, 288019], [47, 288459], [51, 288599], [58, 289019], [62, 289259], [66, 290059], [69, 290279], [79, 290819], [81, 291079], [84, 291179]]}, {"verse": 33, "start": 292461, "end": 299681, "text": "Y cuando llegaron a Cesarea, y dieron la carta al gobernador, presentaron también a Pablo delante de él.", "words": [[0, 292461], [2, 292548], [9, 292728], [18, 293268], [20, 293448], [29, 294028], [31, 294343], [38, 294683], [41, 294863], [47, 295263], [50, 295503], [62, 296603], [74, 297463], [82, 297843], [84, 298103], [90, 298463], [98, 299043], [101, 299389]]}, {"verse": 34, "start": 300031, "end": 306621, "text": "Y el gobernador, leída la carta, preguntó de qué provincia era; y entendiendo que de Cilicia,", "words": [[0, 300031], [2, 300273], [5, 300393], [17, 301053], [23, 301713], [26, 301853], [33, 302693], [42, 303273], [45, 303393], [49, 303513], [59, 304153], [64, 304723], [66, 304866], [78, 305486], [82, 305865], [85, 306243]]}, {"verse": 35, "start": 306821, "end": 314077, "text": "Te oiré, dijo, cuando vengan tus acusadores. Y mandó que le guardasen en el pretorio de Herodes.", "words": [[0, 306821], [3, 307097], [9, 307644], [15, 308418], [22, 308594], [29, 309054], [33, 309254], [45, 310635], [47, 310764], [53, 311164], [57, 311304], [60, 311444], [70, 312144], [73, 312284], [76, 312444], [85, 313084], [88, 313224]]}]}