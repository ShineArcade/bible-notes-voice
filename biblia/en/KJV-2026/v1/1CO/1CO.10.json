{"book": "1CO", "chapter": 10, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 199287, "verses": [{"verse": 1, "start": 300, "end": 6991, "text": "Moreover, brethren, I would not that you should be ignorant, how that all our fathers were under the cloud, and all passed through the sea;", "words": [[0, 300], [10, 788], [20, 1828], [22, 1908], [28, 2028], [32, 2188], [37, 2388], [41, 2488], [48, 2628], [51, 2768], [61, 3168], [65, 3628], [70, 3808], [74, 4028], [78, 4188], [86, 4508], [91, 4728], [97, 4948], [101, 5128], [108, 5468], [112, 5688], [116, 5928], [123, 6228], [131, 6508], [135, 6628]]}, {"verse": 2, "start": 7441, "end": 10836, "text": "And were all baptized to Moses in the cloud and in the sea;", "words": [[0, 7441], [4, 7562], [9, 7742], [13, 8022], [22, 8422], [25, 8702], [31, 9062], [34, 9422], [38, 9542], [44, 9902], [48, 10182], [51, 10302], [55, 10402]]}, {"verse": 3, "start": 11286, "end": 13385, "text": "And did all eat the same spiritual food;", "words": [[0, 11286], [4, 11440], [8, 11560], [12, 11860], [16, 12060], [20, 12220], [25, 12400], [35, 12880]]}, {"verse": 4, "start": 13835, "end": 20379, "text": "And did all drink the same spiritual drink: for they drank of that spiritual Rock that followed them: and that Rock was Christ.", "words": [[0, 13835], [4, 13978], [8, 14098], [12, 14398], [18, 14598], [22, 14778], [27, 14978], [37, 15438], [44, 16327], [48, 16449], [53, 16569], [59, 16869], [62, 17049], [67, 17229], [77, 17609], [82, 17989], [87, 18149], [96, 18449], [102, 19128], [106, 19248], [111, 19388], [116, 19628], [120, 19788]]}, {"verse": 5, "start": 20829, "end": 25381, "text": "But with many of them God was not well pleased: for they were overthrown in the wilderness.", "words": [[0, 20829], [4, 20932], [9, 21072], [14, 21352], [17, 21492], [22, 21792], [26, 22032], [30, 22252], [34, 22432], [39, 22632], [48, 23438], [52, 23546], [57, 23666], [62, 23786], [73, 24466], [76, 24606], [80, 24706]]}, {"verse": 6, "start": 25831, "end": 31735, "text": "Now these things were our examples, to the intent we should not lust after evil things, as they also lusted.", "words": [[0, 25831], [4, 26065], [10, 26305], [17, 26585], [22, 26845], [26, 27005], [36, 27985], [39, 28065], [43, 28185], [50, 28545], [53, 28705], [60, 28845], [64, 29085], [69, 29405], [75, 29705], [80, 30025], [88, 30645], [91, 30765], [96, 30925], [101, 31330]]}, {"verse": 7, "start": 32185, "end": 39016, "text": "Neither be idolaters, as were some of them; as it is written, The people sat down to eat and drink, and rose up to play.", "words": [[0, 32185], [8, 32425], [11, 32645], [22, 33245], [25, 33545], [30, 33725], [35, 33925], [38, 34065], [44, 34628], [47, 34786], [50, 34886], [53, 35006], [62, 35743], [66, 35865], [73, 36145], [77, 36405], [82, 36665], [85, 36865], [89, 37125], [93, 37345], [100, 37665], [104, 38065], [109, 38305], [112, 38525], [115, 38645]]}, {"verse": 8, "start": 39466, "end": 44721, "text": "Neither let us commit fornication, as some of them committed, and fell in one day three and twenty thousand.", "words": [[0, 39466], [8, 39725], [12, 39985], [15, 40165], [22, 40465], [35, 41425], [38, 41545], [43, 41765], [46, 41865], [51, 42025], [62, 42765], [66, 42885], [71, 43005], [74, 43125], [78, 43345], [82, 43545], [88, 43785], [92, 43905], [99, 44145]]}, {"verse": 9, "start": 45171, "end": 50048, "text": "Neither let us tempt Christ, as some of them also tempted, and were destroyed of serpents.", "words": [[0, 45171], [8, 45426], [12, 45726], [15, 45886], [21, 46126], [29, 46746], [32, 46866], [37, 47066], [40, 47166], [45, 47326], [50, 47726], [59, 48126], [63, 48606], [68, 48726], [78, 49166], [81, 49446]]}, {"verse": 10, "start": 50498, "end": 54611, "text": "Neither murmur you, as some of them also murmured, and were destroyed of the destroyer.", "words": [[0, 50498], [8, 50798], [15, 51138], [20, 51278], [23, 51498], [28, 51698], [31, 51818], [36, 51978], [41, 52378], [51, 52878], [55, 53178], [60, 53298], [70, 53658], [73, 53918], [77, 54018]]}, {"verse": 11, "start": 55061, "end": 61946, "text": "Now all these things happened to them for examples: and they are written for our admonition, upon whom the ends of the world are come.", "words": [[0, 55061], [4, 55298], [8, 55658], [14, 55858], [21, 56128], [30, 56398], [33, 56618], [38, 56838], [42, 56918], [52, 57985], [56, 58105], [61, 58225], [65, 58305], [73, 58545], [77, 58785], [81, 58985], [93, 59605], [98, 60025], [103, 60285], [107, 60445], [112, 60785], [115, 60925], [119, 61045], [125, 61285], [129, 61505]]}, {"verse": 12, "start": 62396, "end": 65940, "text": "Therefore let him that thinks he stands take heed lest he fall.", "words": [[0, 62396], [10, 62887], [14, 63007], [18, 63187], [23, 63367], [30, 63687], [33, 64047], [40, 64667], [45, 64727], [50, 65207], [55, 65407], [58, 65507]]}, {"verse": 13, "start": 66390, "end": 79196, "text": "There has no temptation taken you but such as is common to man: but God is faithful, who will not allow you to be tempted above that you are able; but will with the temptation also make a way to escape, that you may be able to bear it.", "words": [[0, 66390], [6, 66494], [10, 66654], [13, 66854], [24, 67354], [30, 67694], [34, 67934], [38, 68094], [43, 68334], [46, 68494], [49, 68614], [56, 68914], [59, 69134], [64, 69833], [68, 69949], [72, 70149], [75, 70349], [85, 71049], [89, 71309], [94, 71449], [98, 71649], [104, 71929], [108, 72109], [111, 72209], [114, 72349], [122, 72649], [128, 73049], [133, 73309], [137, 73469], [141, 73609], [147, 74250], [151, 74466], [156, 74786], [161, 74986], [165, 75126], [176, 75666], [181, 76126], [186, 76406], [188, 76526], [192, 76686], [195, 76866], [203, 77286], [208, 77746], [212, 77926], [216, 78086], [219, 78246], [224, 78466], [227, 78666], [232, 78926]]}, {"verse": 14, "start": 79646, "end": 82594, "text": "Therefore, my dearly beloved, flee from idolatry.", "words": [[0, 79646], [11, 80208], [14, 80308], [21, 80768], [30, 81128], [35, 81568], [40, 81848]]}, {"verse": 15, "start": 83044, "end": 86094, "text": "I speak as to wise men; judge what I say.", "words": [[0, 83044], [2, 83304], [8, 83644], [11, 83944], [14, 84244], [19, 84464], [24, 85244], [30, 85382], [35, 85622], [37, 85742]]}, {"verse": 16, "start": 86544, "end": 94400, "text": "The cup of blessing which we bless, is it not the communion of the blood of Christ? The bread which we break, is it not the communion of the body of Christ?", "words": [[0, 86544], [4, 86631], [8, 86891], [11, 87011], [20, 87371], [26, 87651], [29, 87811], [36, 88511], [39, 88611], [42, 88731], [46, 88891], [50, 89071], [60, 89471], [63, 89711], [67, 89811], [73, 90031], [76, 90131], [84, 91069], [88, 91203], [94, 91443], [100, 91663], [103, 91803], [110, 92243], [113, 92343], [116, 92463], [120, 92603], [124, 92783], [134, 93163], [137, 93383], [141, 93503], [146, 93723], [149, 93843]]}, {"verse": 17, "start": 94850, "end": 100051, "text": "For we being many are one bread, and one body: for we are all partakers of that one bread.", "words": [[0, 94850], [4, 94986], [7, 95146], [13, 95346], [18, 95686], [22, 95946], [26, 96166], [33, 96406], [37, 96706], [41, 96926], [47, 97692], [51, 97821], [54, 97981], [58, 98121], [62, 98361], [72, 98921], [75, 99181], [80, 99381], [84, 99641]]}, {"verse": 18, "start": 100501, "end": 106303, "text": "Behold Israel after the flesh: are not they which eat of the sacrifices partakers of the altar?", "words": [[0, 100501], [7, 100999], [14, 101499], [20, 101919], [24, 102079], [31, 102831], [35, 102991], [39, 103211], [44, 103531], [50, 103831], [54, 104071], [57, 104211], [61, 104311], [72, 104931], [82, 105551], [85, 105751], [89, 105871]]}, {"verse": 19, "start": 106753, "end": 112916, "text": "What say I then? that the idol is any thing, or that which is offered in sacrifice to idols is any thing?", "words": [[0, 106753], [5, 106893], [9, 107153], [11, 107293], [17, 107912], [22, 108028], [26, 108148], [31, 108328], [34, 108581], [38, 108835], [45, 109088], [48, 109768], [53, 109948], [59, 110168], [62, 110348], [70, 110688], [73, 110868], [83, 111248], [86, 111608], [92, 111868], [95, 112231], [99, 112595]]}, {"verse": 20, "start": 113366, "end": 121664, "text": "But I say, that the things which the Gentiles sacrifice, they sacrifice to demons, and not to God: and I would not that you should have fellowship with demons.", "words": [[0, 113366], [4, 113511], [6, 113631], [11, 113791], [16, 113951], [20, 114111], [27, 114371], [33, 114551], [37, 114711], [46, 115131], [57, 116131], [62, 116251], [72, 116701], [75, 117151], [83, 117491], [87, 118131], [91, 118371], [94, 118571], [99, 119339], [103, 119440], [105, 119520], [111, 119660], [115, 119860], [120, 120040], [124, 120140], [131, 120260], [136, 120380], [147, 120740], [152, 121020]]}, {"verse": 21, "start": 122114, "end": 129234, "text": "You cannot drink the cup of the Lord, and the cup of demons: you cannot be partakers of the Lord’s table, and of the table of demons.", "words": [[0, 122114], [4, 122235], [11, 122535], [17, 122915], [21, 123115], [25, 123315], [28, 123455], [32, 123595], [38, 123855], [42, 124075], [46, 124195], [50, 124395], [53, 124515], [61, 125438], [65, 125556], [72, 125796], [75, 126036], [85, 126536], [88, 126736], [92, 126836], [99, 127196], [106, 127496], [110, 127896], [113, 127996], [117, 128116], [123, 128436], [126, 128596]]}, {"verse": 22, "start": 129684, "end": 133049, "text": "Do we provoke the Lord to jealousy? are we stronger than he?", "words": [[0, 129684], [3, 129805], [6, 129985], [14, 130285], [18, 130505], [23, 130685], [26, 130885], [36, 131817], [40, 131958], [43, 132078], [52, 132418], [57, 132698]]}, {"verse": 23, "start": 133499, "end": 139916, "text": "All things are lawful for me, but all things are not expedient: all things are lawful for me, but all things edify not.", "words": [[0, 133499], [4, 133655], [11, 133875], [15, 134035], [22, 134375], [26, 134535], [30, 135055], [34, 135195], [38, 135415], [45, 135675], [49, 135855], [53, 136015], [64, 137087], [68, 137226], [75, 137426], [79, 137606], [86, 137906], [90, 138086], [94, 138486], [98, 138586], [102, 138806], [109, 139086], [115, 139526]]}, {"verse": 24, "start": 140366, "end": 143299, "text": "Let no man seek his own, but every man another’s wealth.", "words": [[0, 140366], [4, 140537], [7, 140757], [11, 140937], [16, 141157], [20, 141317], [25, 141877], [29, 142077], [35, 142277], [39, 142497], [49, 142957]]}, {"verse": 25, "start": 143749, "end": 148003, "text": "Whatever is sold in the food market, that eat, asking no question for conscience sake:", "words": [[0, 143749], [9, 143993], [12, 144253], [17, 144473], [20, 144653], [24, 144733], [29, 144933], [37, 145293], [42, 145573], [47, 146093], [54, 146393], [57, 146653], [66, 146953], [70, 147363], [81, 147773]]}, {"verse": 26, "start": 148453, "end": 151129, "text": "For the earth is the Lord’s, and the fulness of it.", "words": [[0, 148453], [4, 148555], [8, 148715], [14, 148975], [17, 149235], [21, 149375], [29, 149915], [33, 150135], [37, 150335], [45, 150535], [48, 150835]]}, {"verse": 27, "start": 151579, "end": 159627, "text": "If any of them that believe not bid you to a feast, and you be disposed to go; whatever is set before you, eat, asking no question for conscience sake.", "words": [[0, 151579], [3, 151719], [7, 151979], [10, 152139], [15, 152359], [20, 152539], [28, 152819], [32, 153139], [36, 153419], [40, 153539], [43, 153699], [45, 153799], [52, 154079], [56, 154359], [60, 154459], [63, 154559], [72, 155039], [75, 155179], [79, 155822], [88, 156008], [91, 156194], [95, 156381], [102, 156661], [107, 157101], [112, 157621], [119, 157941], [122, 158221], [131, 158521], [135, 158951], [146, 159381]]}, {"verse": 28, "start": 160077, "end": 169169, "text": "But if any man say to you, This is offered in sacrifice to idols, eat not for his sake that showed it, and for conscience sake: for the earth is the Lord’s, and the fulness of it:", "words": [[0, 160077], [4, 160231], [7, 160351], [11, 160491], [15, 160691], [19, 160911], [22, 161051], [27, 161311], [32, 161511], [35, 161631], [43, 161891], [46, 162031], [56, 162431], [59, 162731], [66, 163531], [70, 163631], [74, 163891], [78, 164131], [82, 164291], [87, 164471], [92, 164651], [99, 164891], [103, 165311], [107, 165431], [111, 165571], [122, 165891], [128, 166651], [132, 166752], [136, 166872], [142, 167152], [145, 167392], [149, 167532], [157, 168072], [161, 168292], [165, 168472], [173, 168652], [176, 168952]]}, {"verse": 29, "start": 169619, "end": 175442, "text": "Conscience, I say, not your own, but of the other: for why is my liberty judged of another man’s conscience?", "words": [[0, 169619], [12, 170119], [14, 170279], [19, 170819], [23, 170999], [28, 171219], [33, 171719], [37, 171859], [40, 171979], [44, 172139], [51, 172764], [55, 172865], [59, 173085], [62, 173225], [65, 173365], [73, 173625], [80, 173965], [83, 174205], [91, 174405], [97, 174805]]}, {"verse": 30, "start": 175892, "end": 181231, "text": "For if I by grace be a partaker, why am I evil spoken of for that for which I give thanks?", "words": [[0, 175892], [4, 176026], [7, 176206], [9, 176376], [12, 176546], [18, 176886], [21, 177126], [23, 177226], [33, 178086], [37, 178266], [40, 178426], [42, 178586], [47, 178906], [54, 179216], [57, 179526], [61, 179706], [66, 179926], [70, 180186], [76, 180406], [78, 180506], [83, 180666]]}, {"verse": 31, "start": 181681, "end": 186774, "text": "Whether therefore you eat, or drink, or whatever you do, do all to the glory of God.", "words": [[0, 181681], [8, 181908], [18, 182408], [22, 182588], [27, 182988], [30, 183288], [37, 183668], [40, 184008], [49, 184288], [53, 184528], [57, 185048], [60, 185268], [64, 185528], [67, 185688], [71, 185808], [77, 186088], [80, 186308]]}, {"verse": 32, "start": 187224, "end": 192127, "text": "Give none offence, neither to the Jews, nor to the Gentiles, nor to the church of God:", "words": [[0, 187224], [5, 187424], [10, 187724], [19, 188024], [27, 188364], [30, 188584], [34, 188704], [40, 189284], [44, 189564], [47, 189744], [51, 189864], [61, 190724], [65, 190944], [68, 191164], [72, 191284], [79, 191484], [82, 191664]]}, {"verse": 33, "start": 192577, "end": 198887, "text": "Even as I please all men in all things, not seeking my own profit, but the profit of many, that they may be saved.", "words": [[0, 192577], [5, 192777], [8, 192997], [10, 193097], [17, 193357], [21, 193677], [25, 193937], [28, 194077], [32, 194317], [40, 195057], [44, 195257], [52, 195557], [55, 195837], [59, 195937], [67, 196537], [71, 196757], [75, 196897], [82, 197097], [85, 197297], [91, 197537], [96, 197977], [101, 198117], [105, 198277], [108, 198417]]}]}