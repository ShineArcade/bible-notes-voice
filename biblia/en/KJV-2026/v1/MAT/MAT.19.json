{"book": "MAT", "chapter": 19, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 228290, "verses": [{"verse": 1, "start": 300, "end": 9232, "text": "And it came to pass, that when Jesus had finished these sayings, he departed from Galilee, and came into the coasts of Judaea beyond Jordan;", "words": [[0, 300], [4, 450], [7, 550], [12, 770], [15, 950], [21, 1250], [26, 1585], [31, 1785], [37, 2145], [41, 2445], [50, 2825], [56, 3205], [65, 4205], [68, 4285], [77, 4745], [82, 5085], [91, 5725], [95, 6225], [100, 6505], [105, 6745], [109, 6905], [116, 7425], [119, 7755], [126, 8085], [133, 8545]]}, {"verse": 2, "start": 9582, "end": 13046, "text": "And great multitudes followed him; and he healed them there.", "words": [[0, 9582], [4, 9720], [10, 10000], [21, 10760], [30, 11140], [35, 11820], [39, 11963], [42, 12123], [49, 12383], [54, 12623]]}, {"verse": 3, "start": 13396, "end": 20447, "text": "¶ The Pharisees also came to him, tempting him, and saying to him, Is it lawful for a man to put away his wife for every cause?", "words": [[2, 13396], [6, 13496], [16, 14196], [21, 14496], [26, 14836], [29, 15056], [34, 15396], [43, 15656], [48, 15996], [52, 16196], [59, 16556], [62, 16796], [67, 17381], [70, 17540], [73, 17660], [80, 18160], [84, 18340], [86, 18460], [90, 18640], [93, 18820], [97, 18980], [102, 19200], [106, 19360], [111, 19580], [115, 19780], [121, 19920]]}, {"verse": 4, "start": 20727, "end": 27634, "text": "And he answered and said to them, Have you not read, that he which made them at the beginning made them male and female,", "words": [[0, 20727], [4, 20863], [7, 20983], [16, 21363], [20, 21563], [25, 21803], [28, 22003], [34, 22558], [39, 22719], [43, 22839], [47, 23039], [53, 23779], [58, 24059], [61, 24339], [67, 24619], [72, 24859], [77, 25039], [80, 25159], [84, 25279], [94, 25619], [99, 26099], [104, 26339], [109, 26679], [113, 26939]]}, {"verse": 5, "start": 27984, "end": 34571, "text": "And said, For this cause shall a man leave father and mother, and shall cleave to his wife: and they two shall be one flesh?", "words": [[0, 27984], [4, 28142], [10, 28402], [14, 28602], [19, 28802], [25, 29162], [31, 29462], [33, 29642], [37, 29862], [43, 30142], [50, 30502], [54, 30722], [62, 31162], [66, 31222], [72, 31422], [79, 31842], [82, 31962], [86, 32142], [92, 32767], [96, 32867], [101, 33097], [105, 33327], [111, 33587], [114, 33767], [118, 33987]]}, {"verse": 6, "start": 34921, "end": 42037, "text": "Therefore they are no more two, but one flesh. What therefore God has joined together, let not man put asunder.", "words": [[0, 34921], [10, 35286], [15, 35566], [19, 35666], [22, 35866], [27, 36106], [32, 36886], [36, 36966], [40, 37246], [47, 38053], [52, 38242], [62, 38702], [66, 39122], [70, 39422], [77, 39702], [87, 40482], [91, 40682], [95, 40882], [99, 41182], [103, 41422]]}, {"verse": 7, "start": 42317, "end": 47844, "text": "They say to him, Why did Moses then command to give a writing of divorcement, and to put her away?", "words": [[0, 42317], [5, 42423], [9, 42663], [12, 42863], [17, 43371], [21, 43539], [25, 43739], [31, 44119], [36, 44479], [44, 44839], [47, 45099], [52, 45279], [54, 45419], [62, 45699], [65, 45859], [78, 46519], [82, 46879], [85, 47039], [89, 47239], [93, 47399]]}, {"verse": 8, "start": 48124, "end": 55623, "text": "He says to them, Moses because of the hardness of your hearts permitted you to put away your wives: but from the beginning it was not so.", "words": [[0, 48124], [3, 48214], [8, 48414], [11, 48634], [17, 49235], [23, 49814], [31, 50034], [34, 50254], [38, 50354], [47, 50694], [50, 50994], [55, 51134], [62, 51614], [72, 51854], [76, 52154], [79, 52274], [83, 52454], [88, 52674], [93, 52854], [100, 53776], [104, 53873], [109, 54033], [113, 54173], [123, 54513], [126, 54773], [130, 54913], [134, 55093]]}, {"verse": 9, "start": 55973, "end": 66766, "text": "And I say to you, Whoever shall put away his wife, unless it be for fornication, and shall marry another, commits adultery: and whoever marries her which is put away does commit adultery.", "words": [[0, 55973], [4, 56093], [6, 56253], [10, 56453], [13, 56673], [18, 57013], [26, 57213], [32, 57553], [36, 57753], [41, 57993], [45, 58233], [51, 58993], [58, 59233], [61, 59453], [64, 59613], [68, 59813], [81, 60833], [85, 60993], [91, 61213], [97, 61513], [106, 62313], [114, 62553], [124, 63536], [128, 63640], [136, 63880], [144, 64380], [148, 64540], [154, 64760], [157, 64900], [161, 65060], [166, 65360], [171, 65640], [178, 66020]]}, {"verse": 10, "start": 67046, "end": 73337, "text": "¶ His disciples say to him, If the case of the man be so with his wife, it is not good to marry.", "words": [[2, 67046], [6, 67170], [16, 67630], [20, 67930], [23, 68090], [28, 69466], [31, 69585], [35, 69705], [40, 70005], [43, 70185], [47, 70305], [51, 70545], [54, 70745], [57, 71045], [62, 71265], [66, 71385], [72, 72025], [75, 72125], [78, 72245], [82, 72465], [87, 72725], [90, 72905]]}, {"verse": 11, "start": 73617, "end": 78732, "text": "But he said to them, All men cannot receive this saying, save they to whom it is given.", "words": [[0, 73617], [4, 73745], [7, 73825], [12, 74025], [15, 74225], [21, 74743], [25, 74952], [29, 75252], [36, 75532], [44, 76092], [49, 76372], [57, 77092], [62, 77452], [67, 77672], [70, 77812], [75, 77972], [78, 78112], [81, 78252]]}, {"verse": 12, "start": 79082, "end": 94019, "text": "For there are some eunuchs, which were so born from their mother’s womb: and there are some eunuchs, which were made eunuchs of men: and there are eunuchs, which have made themselves eunuchs for the kingdom of heaven’s sake. He that is able to receive it, let him receive it.", "words": [[0, 79082], [4, 79170], [10, 79330], [14, 79470], [19, 79730], [28, 80290], [34, 80710], [39, 80870], [42, 81090], [47, 81370], [52, 81570], [58, 81710], [67, 82090], [73, 82695], [77, 82853], [83, 83033], [87, 83233], [92, 83573], [101, 84113], [107, 84473], [112, 84653], [117, 84913], [125, 85373], [128, 85533], [133, 86184], [137, 86300], [143, 86480], [147, 86720], [156, 87220], [162, 87660], [167, 87860], [172, 88080], [183, 88400], [191, 89100], [195, 89240], [199, 89360], [207, 89660], [210, 89900], [219, 90400], [225, 90957], [228, 91146], [233, 91426], [236, 91566], [241, 91806], [244, 92006], [252, 92266], [256, 92866], [260, 93086], [264, 93306], [272, 93646]]}, {"verse": 13, "start": 94299, "end": 101051, "text": "¶ Then were there brought to him little children, that he should put his hands on them, and pray: and the disciples rebuked them.", "words": [[2, 94299], [7, 94474], [12, 94654], [18, 94834], [26, 95114], [29, 95334], [33, 95494], [40, 95794], [50, 96534], [55, 96854], [58, 96994], [65, 97154], [69, 97394], [73, 97594], [79, 97874], [82, 98114], [88, 98294], [92, 98554], [98, 99398], [102, 99523], [106, 99603], [116, 100063], [124, 100743]]}, {"verse": 14, "start": 101401, "end": 108382, "text": "But Jesus said, Let the little children come to me, and do not forbid them: for of such is the kingdom of heaven.", "words": [[0, 101401], [4, 101508], [10, 101788], [16, 102550], [20, 102760], [24, 102980], [31, 103220], [40, 103680], [45, 104040], [48, 104280], [52, 104540], [56, 104900], [59, 105060], [63, 105280], [70, 105620], [76, 106200], [80, 106347], [83, 106567], [88, 106867], [91, 107147], [95, 107307], [103, 107607], [106, 107867]]}, {"verse": 15, "start": 108662, "end": 111494, "text": "And he laid his hands on them, and departed from there.", "words": [[0, 108662], [4, 108790], [7, 108910], [12, 109110], [16, 109310], [22, 109610], [25, 109810], [31, 110010], [35, 110310], [44, 110710], [49, 111010]]}, {"verse": 16, "start": 111844, "end": 117738, "text": "¶ And, behold, one came and said to him, Good Master, what good thing shall I do, that I may have eternal life?", "words": [[2, 111844], [7, 111972], [15, 112512], [19, 112692], [24, 112952], [28, 113232], [33, 113432], [36, 113632], [41, 114163], [46, 114308], [54, 115008], [59, 115108], [64, 115338], [70, 115568], [76, 115828], [78, 115948], [82, 116168], [87, 116468], [89, 116588], [93, 116728], [98, 116888], [106, 117228]]}, {"verse": 17, "start": 118018, "end": 127400, "text": "And he said to him, Why do you call me good? there is none good but one, that is, God: but if you will enter into life, keep the commandments.", "words": [[0, 118018], [4, 118144], [7, 118244], [12, 118464], [15, 118664], [20, 119266], [24, 119433], [27, 119573], [31, 119653], [36, 119893], [39, 120053], [45, 120801], [51, 120946], [54, 121146], [59, 121466], [64, 121826], [68, 122066], [73, 122766], [78, 122926], [82, 123206], [87, 124328], [91, 124434], [94, 124554], [98, 124694], [103, 124814], [109, 125114], [114, 125374], [120, 126174], [125, 126294], [129, 126514]]}, {"verse": 18, "start": 127680, "end": 136915, "text": "He says to him, Which? Jesus said, You shall do no murder, You shall not commit adultery, You shall not steal, You shall not bear false witness,", "words": [[0, 127680], [3, 127768], [8, 127968], [11, 128188], [16, 128791], [23, 129522], [29, 129758], [35, 130544], [39, 130682], [45, 130902], [48, 131102], [51, 131322], [59, 132122], [63, 132302], [69, 132522], [73, 132702], [80, 132982], [90, 133862], [94, 133962], [100, 134182], [104, 134382], [111, 135122], [115, 135362], [121, 135562], [125, 135742], [130, 135962], [136, 136262]]}, {"verse": 19, "start": 137265, "end": 141486, "text": "Honour your father and your mother: and, You shall love your neighbour as yourself.", "words": [[0, 137382], [7, 137512], [12, 137712], [19, 138032], [23, 138372], [28, 138512], [36, 139156], [41, 139518], [45, 139858], [51, 140038], [56, 140278], [61, 140488], [71, 140698], [74, 140978]]}, {"verse": 20, "start": 141766, "end": 146713, "text": "The young man says to him, All these things have I kept from my youth up: what lack I yet?", "words": [[0, 141766], [4, 141885], [10, 142085], [14, 142345], [19, 142625], [22, 142865], [27, 143412], [31, 143572], [37, 143792], [44, 144092], [49, 144292], [51, 144412], [56, 144612], [61, 144792], [64, 144992], [70, 145152], [74, 145719], [79, 145940], [84, 146220], [86, 146400]]}, {"verse": 21, "start": 146993, "end": 156692, "text": "Jesus said to him, If you will be perfect, go and sell that you have, and give to the poor, and you shall have treasure in heaven: and come and follow me.", "words": [[0, 146993], [6, 147333], [11, 147653], [14, 147853], [19, 148968], [22, 149107], [26, 149227], [31, 149347], [34, 149487], [43, 150347], [46, 150687], [50, 150967], [55, 151267], [60, 151447], [64, 151607], [70, 152187], [74, 152287], [79, 152487], [82, 152667], [86, 152767], [92, 153487], [96, 153607], [100, 153707], [106, 153887], [111, 154047], [120, 154347], [123, 154687], [131, 155369], [135, 155506], [140, 155766], [144, 156066], [151, 156346]]}, {"verse": 22, "start": 156972, "end": 162540, "text": "But when the young man heard that saying, he went away sorrowful: for he had great possessions.", "words": [[0, 156972], [4, 157099], [9, 157279], [13, 157419], [19, 157619], [23, 157899], [29, 158219], [34, 158479], [42, 159159], [45, 159459], [50, 159719], [55, 159939], [66, 160988], [70, 161116], [73, 161256], [77, 161436], [83, 161696]]}, {"verse": 23, "start": 162890, "end": 170070, "text": "¶ Then said Jesus to his disciples, Assuredly I say to you, That a rich man shall hardly enter into the kingdom of heaven.", "words": [[2, 162890], [7, 163099], [12, 163319], [18, 163659], [21, 163959], [25, 164099], [36, 165153], [46, 165733], [48, 165853], [52, 166053], [55, 166213], [60, 166773], [65, 167033], [67, 167153], [72, 167353], [76, 167673], [82, 167953], [89, 168333], [95, 168713], [100, 168973], [104, 169133], [112, 169413], [115, 169633]]}, {"verse": 24, "start": 170420, "end": 177913, "text": "And again I say to you, It is easier for a camel to go through the eye of a needle, than for a rich man to enter into the kingdom of God.", "words": [[0, 170420], [4, 170571], [10, 170771], [12, 170971], [16, 171171], [19, 171371], [24, 171831], [27, 171951], [30, 172091], [37, 172491], [41, 172771], [43, 172911], [49, 173191], [52, 173411], [55, 173571], [63, 173731], [67, 173891], [71, 174131], [74, 174231], [76, 174291], [84, 175016], [89, 175121], [93, 175321], [95, 175441], [100, 175641], [104, 175981], [107, 176221], [113, 176461], [118, 176741], [122, 176901], [130, 177181], [133, 177421]]}, {"verse": 25, "start": 178193, "end": 183365, "text": "When his disciples heard it, they were exceedingly amazed, saying, Who then can be saved?", "words": [[0, 178193], [5, 178344], [9, 178504], [19, 179024], [25, 179364], [29, 179804], [34, 179924], [39, 180084], [51, 180744], [59, 181424], [67, 182119], [71, 182257], [76, 182417], [80, 182637], [83, 182777]]}, {"verse": 26, "start": 183645, "end": 190679, "text": "But Jesus beheld them, and said to them, With men this is impossible; but with God all things are possible.", "words": [[0, 183645], [4, 183740], [10, 184100], [17, 184780], [23, 185020], [27, 185460], [32, 185720], [35, 185920], [41, 186436], [46, 186580], [50, 187020], [55, 187140], [58, 187260], [70, 188367], [74, 188467], [79, 188587], [83, 189087], [87, 189287], [94, 189747], [98, 190007]]}, {"verse": 27, "start": 190959, "end": 197081, "text": "¶ Then answered Peter and said to him, Behold, we have forsaken all, and followed you; what shall we have therefore?", "words": [[2, 190959], [7, 191131], [16, 191491], [22, 191771], [26, 191991], [31, 192151], [34, 192331], [39, 192835], [47, 193369], [50, 193449], [55, 193589], [64, 194009], [69, 194369], [73, 194729], [82, 195049], [87, 195630], [92, 195835], [98, 196075], [101, 196255], [106, 196615]]}, {"verse": 28, "start": 197361, "end": 211116, "text": "And Jesus said to them, Assuredly I say to you, That you which have followed me, in the regeneration when the Son of man shall sit in the throne of his glory, you also shall sit upon twelve thrones, judging the twelve tribes of Israel.", "words": [[0, 197361], [4, 197486], [10, 197826], [15, 198226], [18, 198406], [24, 198951], [34, 199556], [36, 199696], [40, 199896], [43, 200076], [48, 200696], [53, 200936], [57, 201236], [63, 201456], [68, 201616], [77, 201936], [81, 202236], [84, 202421], [88, 202561], [101, 203061], [106, 203521], [110, 203661], [114, 203881], [117, 203981], [121, 204301], [127, 204601], [131, 204821], [134, 204981], [138, 205081], [145, 205301], [148, 205481], [152, 205601], [159, 206386], [163, 206528], [168, 206828], [174, 207148], [178, 207388], [183, 207688], [190, 208088], [199, 209028], [207, 209448], [211, 209668], [218, 209948], [225, 210348], [228, 210568]]}, {"verse": 29, "start": 211466, "end": 223611, "text": "And every one that has forsaken houses, or brethren, or sisters, or father, or mother, or wife, or children, or lands, for my name’s sake, shall receive a hundredfold, and shall inherit everlasting life.", "words": [[0, 211466], [4, 211591], [10, 211757], [14, 211924], [19, 212304], [23, 212464], [32, 212964], [40, 213824], [43, 213904], [53, 214684], [56, 214764], [65, 215564], [68, 215604], [76, 216264], [79, 216304], [87, 216864], [90, 216924], [96, 217484], [99, 217584], [109, 218244], [112, 218324], [119, 219164], [123, 219264], [126, 219444], [133, 219784], [139, 220244], [145, 220444], [153, 220784], [155, 220944], [168, 221854], [172, 221981], [178, 222161], [186, 222541], [198, 222961]]}, {"verse": 30, "start": 223961, "end": 227890, "text": "But many that are first shall be last; and the last shall be first.", "words": [[0, 223961], [4, 224064], [9, 224344], [14, 224544], [18, 224644], [24, 225004], [30, 225364], [33, 225504], [39, 226360], [43, 226480], [47, 226580], [52, 226880], [58, 227180], [61, 227340]]}]}