{"book": "PSA", "chapter": 65, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 104335, "verses": [{"verse": 1, "start": 300, "end": 9408, "text": "Al Músico principal: Salmo: Cántico de David. A TI es plácida la alabanza en Sion, oh Dios: y a ti se pagarán los votos.", "words": [[0, 300], [3, 479], [10, 959], [21, 2025], [28, 2831], [36, 3276], [39, 3416], [46, 4070], [48, 4390], [51, 4510], [54, 4630], [62, 5270], [65, 5490], [74, 5865], [77, 6240], [83, 6615], [86, 6990], [92, 7716], [94, 7842], [96, 7902], [99, 8042], [102, 8182], [110, 8702], [114, 8842]]}, {"verse": 2, "start": 9758, "end": 13412, "text": "Tú oyes la oración: a ti vendrá toda carne.", "words": [[0, 9758], [3, 10120], [8, 10520], [11, 10740], [20, 11690], [22, 11910], [25, 12050], [32, 12490], [37, 12710]]}, {"verse": 3, "start": 13762, "end": 20155, "text": "Palabras de iniquidades me sobrepujaron: mas nuestras rebeliones tú las perdonarás.", "words": [[0, 13762], [9, 14103], [12, 14363], [24, 15103], [27, 15503], [41, 16965], [45, 17174], [54, 17854], [65, 19014], [68, 19074], [72, 19234]]}, {"verse": 4, "start": 20505, "end": 30350, "text": "Dichoso el que tú escoges, y haces llegar a ti, para que habite en tus atrios: seremos saciados del bien de tu casa, de tu santo templo.", "words": [[0, 20505], [8, 21113], [11, 21313], [15, 21453], [18, 21923], [27, 22393], [29, 22653], [35, 22973], [42, 23313], [44, 23553], [48, 23713], [53, 24293], [57, 24493], [64, 24693], [67, 24893], [71, 25113], [79, 26073], [87, 26535], [96, 27395], [100, 27735], [105, 28015], [108, 28235], [111, 28375], [117, 28915], [120, 28975], [123, 29115], [129, 29535]]}, {"verse": 5, "start": 30700, "end": 42751, "text": "Con tremendas cosas, en justicia, nos responderás tú, oh Dios de nuestra salvación, esperanza de todos los términos de la tierra, y de los más remotos confines del mar.", "words": [[0, 30700], [4, 30884], [14, 31484], [21, 31824], [24, 32124], [34, 33064], [38, 33264], [50, 34044], [54, 34474], [57, 34904], [62, 35244], [65, 35804], [73, 35984], [84, 37104], [94, 37764], [97, 37944], [103, 38284], [107, 38584], [116, 39164], [119, 39244], [122, 39364], [130, 39724], [132, 40244], [135, 40344], [139, 40484], [143, 40764], [151, 41564], [160, 42104], [164, 42324]]}, {"verse": 6, "start": 43101, "end": 47544, "text": "Tú, el que afirma los montes con su poder, ceñido de valentía:", "words": [[0, 43101], [4, 43665], [7, 43745], [11, 43865], [18, 44285], [22, 44405], [29, 44865], [33, 45025], [36, 45245], [43, 46025], [50, 46565], [53, 46685]]}, {"verse": 7, "start": 47894, "end": 54799, "text": "El que amansa el estruendo de los mares, el estruendo de sus ondas, y el alboroto de las naciones.", "words": [[0, 47894], [3, 48015], [7, 48325], [14, 48635], [17, 48935], [27, 49535], [30, 49675], [34, 49795], [41, 50655], [44, 50975], [54, 51555], [57, 51735], [61, 51875], [68, 52455], [70, 52715], [73, 52875], [82, 53615], [85, 53795], [89, 53955]]}, {"verse": 8, "start": 55149, "end": 64085, "text": "Por tanto los habitantes de los fines de la tierra temen de tus maravillas. Tú haces alegrar las salidas de la mañana y de la tarde.", "words": [[0, 55149], [4, 55271], [10, 56043], [14, 56146], [25, 56806], [28, 56986], [32, 57086], [38, 57406], [41, 57586], [44, 57726], [51, 58166], [57, 59166], [60, 59386], [64, 59606], [76, 60917], [79, 61042], [85, 61302], [93, 61882], [97, 62022], [105, 62482], [108, 62642], [111, 62742], [118, 63102], [120, 63282], [123, 63382], [126, 63502]]}, {"verse": 9, "start": 64435, "end": 75508, "text": "Visitas la tierra, y la riegas: en gran manera la enriqueces con el río de Dios, lleno de aguas: preparas el grano de ellos, cuando así la dispones.", "words": [[0, 64435], [8, 65095], [11, 65435], [19, 65835], [21, 66075], [24, 66175], [32, 67172], [35, 67356], [40, 67576], [47, 68076], [50, 68296], [61, 69056], [65, 69316], [68, 69496], [72, 69796], [75, 69916], [81, 70816], [87, 71336], [90, 71496], [97, 72643], [106, 72913], [109, 73113], [115, 73473], [118, 73653], [125, 73993], [132, 74348], [136, 74568], [139, 74788]]}, {"verse": 10, "start": 75858, "end": 85093, "text": "Haces se empapen sus surcos, haces descender sus canales: la ablandas con lluvias, bendices sus renuevos.", "words": [[0, 75928], [6, 76612], [9, 76852], [17, 77412], [21, 77632], [29, 78612], [35, 78992], [45, 79792], [49, 79992], [58, 81091], [61, 81483], [70, 81913], [74, 82133], [83, 82973], [92, 83813], [96, 84173]]}, {"verse": 11, "start": 85443, "end": 90453, "text": "Tú coronas el año de tus bienes; y tus nubes destilan abundancia.", "words": [[0, 85443], [3, 85547], [11, 86067], [14, 86207], [18, 86367], [21, 86547], [25, 86687], [33, 87572], [35, 87679], [39, 87799], [45, 88519], [54, 89239]]}, {"verse": 12, "start": 90803, "end": 96592, "text": "Destilan sobre las estancias del desierto; y los collados se ciñen de alegría.", "words": [[0, 90803], [9, 91409], [15, 91729], [19, 91969], [29, 92629], [33, 92849], [43, 94041], [45, 94150], [49, 94250], [58, 94830], [61, 95270], [67, 95750], [70, 95870]]}, {"verse": 13, "start": 96942, "end": 103935, "text": "Se visten los llanos de manadas, y los valles se cubren de grano: dan voces de júbilo, y aun cantan.", "words": [[0, 96942], [3, 97100], [10, 97460], [14, 97680], [21, 98140], [24, 98300], [33, 98820], [35, 99165], [39, 99325], [46, 99665], [49, 99865], [56, 100285], [59, 100425], [66, 101205], [70, 101395], [76, 101835], [79, 101995], [87, 102515], [89, 103115], [93, 103295]]}]}