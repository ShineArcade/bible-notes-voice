{"book": "ISA", "chapter": 58, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 175621, "verses": [{"verse": 1, "start": 300, "end": 9959, "text": "Clama a voz en cuello, no te detengas; alza tu voz como trompeta, y anuncia a mi pueblo su rebelión, y a la casa de Jacob su pecado.", "words": [[0, 300], [6, 659], [8, 779], [12, 959], [15, 1119], [23, 1859], [26, 2119], [29, 2299], [39, 3799], [44, 3959], [47, 4199], [51, 4439], [56, 4679], [66, 5539], [68, 5799], [76, 6259], [78, 6359], [81, 6459], [88, 6739], [91, 7019], [101, 7599], [103, 8039], [105, 8119], [108, 8199], [113, 8479], [116, 8719], [122, 9059], [125, 9319]]}, {"verse": 2, "start": 10648, "end": 23979, "text": "Que me buscan cada día, y quieren saber mis caminos, como gente que hubiese hecho justicia, y que no hubiese dejado el derecho de su Dios: pregúntanme derechos de justicia, y quieren acercarse a Dios.", "words": [[0, 10648], [4, 10745], [7, 10885], [14, 11285], [19, 11505], [24, 11845], [26, 12485], [34, 12805], [40, 13145], [44, 13385], [53, 13945], [58, 14485], [64, 14825], [68, 15045], [76, 15325], [82, 15585], [92, 16245], [94, 16805], [98, 16925], [101, 17065], [109, 17365], [116, 17885], [119, 17985], [127, 18325], [130, 18505], [133, 18645], [139, 20049], [151, 20409], [160, 20889], [163, 21149], [173, 21849], [175, 22329], [183, 22609], [193, 23309], [195, 23429]]}, {"verse": 3, "start": 24523, "end": 37703, "text": "¿Por qué, dicen, ayunamos, y no hiciste caso; humillamos nuestras almas, y no te diste por entendido? He aquí que en el día de vuestro ayuno halláis lo que queréis, y oprimís a todos vuestros trabajadores.", "words": [[0, 24523], [5, 24665], [10, 25762], [17, 26344], [27, 26883], [29, 27203], [32, 27343], [40, 27743], [46, 28580], [57, 29119], [66, 29499], [73, 29979], [75, 30259], [78, 30379], [81, 30519], [87, 30879], [91, 30999], [102, 32053], [105, 32133], [110, 32433], [114, 32593], [117, 32673], [120, 32773], [124, 32953], [127, 33073], [135, 33393], [141, 33833], [149, 34453], [152, 34573], [156, 34673], [165, 35133], [167, 35553], [175, 35993], [177, 36073], [183, 36293], [192, 36733]]}, {"verse": 4, "start": 38423, "end": 49296, "text": "He aquí que para contiendas y debates ayunáis, y para herir con el puño inicuamente; no ayunéis como hoy, para que vuestra voz sea oída en lo alto.", "words": [[0, 38423], [3, 38566], [8, 39186], [12, 39286], [17, 39486], [28, 40246], [30, 40366], [38, 41026], [47, 41686], [49, 41746], [54, 41946], [60, 42226], [64, 42346], [67, 42486], [72, 43451], [85, 44938], [88, 45056], [96, 45476], [101, 45736], [106, 46016], [111, 46676], [115, 46836], [123, 47216], [127, 47436], [131, 47976], [136, 48456], [139, 48676], [142, 48796]]}, {"verse": 5, "start": 50009, "end": 63049, "text": "¿Es tal el ayuno que yo escogí, que de día aflija el hombre su alma, que encorve su cabeza como junco, y haga cama de saco y de ceniza? ¿Llamaréis esto ayuno, y día agradable a Jehová?", "words": [[0, 50009], [4, 50236], [8, 50556], [11, 50756], [17, 51196], [21, 51376], [24, 51576], [32, 52496], [36, 52696], [39, 52856], [43, 53136], [50, 53696], [53, 53856], [60, 54096], [63, 54376], [69, 55176], [73, 55426], [81, 55676], [84, 55836], [91, 56276], [96, 56576], [103, 57136], [105, 57616], [110, 57796], [115, 58096], [118, 58296], [123, 58716], [125, 58776], [128, 58876], [136, 60389], [147, 60659], [152, 60959], [159, 61359], [161, 61499], [165, 61719], [175, 62379], [177, 62499]]}, {"verse": 6, "start": 63723, "end": 75160, "text": "¿No es antes el ayuno que yo escogí, desatar las ligaduras de impiedad, deshacer los haces de opresión, y dejar ir libres a los quebrantados, y que rompáis todo yugo?", "words": [[0, 63723], [4, 63920], [7, 64160], [13, 64480], [16, 64700], [22, 65000], [26, 65160], [29, 65320], [37, 66240], [45, 66800], [49, 67060], [59, 67620], [62, 67780], [72, 68920], [81, 69400], [85, 69580], [91, 70020], [94, 70180], [104, 70800], [106, 71300], [112, 71600], [115, 71780], [122, 72180], [124, 72300], [128, 72400], [142, 73180], [144, 73680], [148, 73820], [156, 74320], [161, 74500]]}, {"verse": 7, "start": 75838, "end": 86848, "text": "¿No es que partas tu pan con el hambriento, y recibas en tu casa a los pobres vagabundos; que cuando veas al desnudo, lo cubras, y no le des la espalda a los tuyos?", "words": [[0, 75838], [4, 76039], [7, 76239], [11, 76379], [18, 76819], [21, 76959], [25, 77219], [29, 77419], [32, 77559], [44, 78199], [46, 78679], [54, 79199], [57, 79359], [60, 79479], [65, 79639], [67, 79799], [71, 80059], [78, 80499], [90, 82001], [94, 82098], [101, 82338], [106, 82838], [109, 82958], [118, 83518], [121, 83918], [129, 84458], [131, 84838], [134, 84978], [137, 85118], [141, 85338], [144, 85478], [152, 85978], [154, 86058], [158, 86198]]}, {"verse": 8, "start": 87529, "end": 98161, "text": "Entonces nacerá tu luz como el alba, y tu salvación se dejará ver pronto; e irá tu justicia delante de ti, y la gloria de Jehová será tu retaguardia.", "words": [[0, 87529], [9, 87952], [16, 88672], [19, 88812], [23, 89092], [28, 89352], [31, 89512], [37, 89852], [39, 90332], [42, 90452], [52, 91052], [55, 91272], [62, 91692], [66, 91812], [74, 92962], [76, 93061], [80, 93281], [83, 93401], [92, 94061], [100, 94501], [103, 94641], [107, 94881], [109, 95321], [112, 95441], [119, 95801], [122, 95921], [129, 96341], [134, 96541], [137, 96781]]}, {"verse": 9, "start": 98880, "end": 110169, "text": "Entonces invocarás, y te oirá Jehová; clamarás, y dirá él: Heme aquí. Si quitas de en medio de ti el yugo, el dedo acusador y la lengua maliciosa;", "words": [[0, 98880], [9, 99424], [20, 100344], [22, 100644], [25, 100784], [30, 101104], [38, 102156], [48, 102798], [50, 103118], [55, 103418], [59, 104328], [64, 104438], [70, 105440], [73, 105609], [80, 105819], [83, 106029], [86, 106169], [92, 106429], [95, 106629], [98, 106809], [101, 106969], [107, 107789], [110, 107809], [115, 108129], [124, 108689], [126, 108969], [129, 109069], [136, 109389]]}, {"verse": 10, "start": 110889, "end": 120032, "text": "Y si dieres tu pan al hambriento, y sacias el alma afligida, en las tinieblas nacerá tu luz, y tu oscuridad será como el medio día;", "words": [[0, 110889], [2, 111012], [5, 111192], [12, 111632], [15, 111772], [19, 112032], [22, 112192], [34, 112872], [36, 113412], [43, 114012], [46, 114172], [51, 114372], [61, 115432], [64, 115552], [68, 115692], [78, 116372], [85, 116812], [88, 116952], [93, 117712], [95, 117792], [98, 117932], [108, 118552], [113, 118852], [118, 119132], [121, 119432], [127, 119732]]}, {"verse": 11, "start": 120722, "end": 132800, "text": "Y Jehová te pastoreará siempre, y en las sequías saciará tu alma, y engordará tus huesos; y serás como huerta de riego, y como manantial de aguas, cuyas aguas nunca faltan.", "words": [[0, 120722], [2, 120860], [9, 121320], [12, 121710], [23, 122100], [32, 123160], [34, 123200], [37, 123300], [41, 123400], [49, 123980], [57, 124460], [60, 124620], [66, 124940], [68, 125460], [78, 126020], [82, 126260], [90, 127469], [92, 127570], [98, 127910], [103, 128130], [110, 128490], [113, 128650], [120, 129110], [122, 129530], [127, 129940], [137, 130350], [140, 130490], [147, 130970], [153, 131490], [159, 131910], [165, 132070]]}, {"verse": 12, "start": 133488, "end": 146690, "text": "Y edificarán los de ti los desiertos antiguos; los cimientos de generación y generación levantarás: y serás llamado reparador de portillos, restaurador de calzadas para habitar.", "words": [[0, 133488], [2, 133608], [13, 134288], [17, 134448], [20, 134588], [23, 134848], [27, 135148], [37, 135908], [47, 137325], [51, 137455], [61, 138055], [64, 138215], [75, 139034], [77, 139295], [88, 140015], [100, 141631], [102, 141750], [108, 142050], [116, 142510], [126, 143330], [129, 143530], [140, 144450], [152, 145150], [155, 145350], [164, 145870], [169, 146280]]}, {"verse": 13, "start": 147411, "end": 162790, "text": "Si retiras del sábado tu pie, de hacer tu voluntad en mi día santo, y al sábado llamas delicias, santo, glorioso de Jehová; y lo veneras, no haciendo tus caminos, ni buscando tu voluntad, ni hablando tus palabras:", "words": [[0, 147411], [3, 147575], [11, 148215], [15, 148355], [22, 148875], [25, 149035], [30, 149335], [33, 149935], [39, 150215], [42, 150455], [51, 151035], [54, 151155], [57, 151295], [61, 151475], [68, 152015], [70, 152555], [73, 152695], [80, 153155], [87, 153575], [97, 154135], [104, 154995], [113, 155735], [116, 155935], [124, 157011], [126, 157110], [129, 157210], [138, 157670], [141, 157930], [150, 158290], [154, 158610], [163, 159410], [166, 159670], [175, 160030], [178, 160350], [188, 161330], [191, 161410], [200, 161690], [204, 162030]]}, {"verse": 14, "start": 163474, "end": 175221, "text": "Entonces te deleitarás en Jehová; y yo te haré subir sobre las alturas de la tierra, y te daré a comer la heredad de Jacob tu padre: porque la boca de Jehová lo ha hablado.", "words": [[0, 163474], [9, 163897], [12, 164277], [23, 164977], [26, 165117], [34, 166179], [36, 166317], [39, 166517], [42, 166717], [47, 166977], [53, 167297], [59, 167717], [63, 167937], [71, 168477], [74, 168617], [77, 168717], [85, 169477], [87, 169697], [90, 169837], [95, 170197], [97, 170257], [103, 170517], [106, 170797], [114, 171177], [117, 171297], [123, 171857], [126, 171957], [133, 173131], [140, 173335], [143, 173535], [148, 173795], [151, 174048], [158, 174302], [161, 174555], [164, 174675]]}]}