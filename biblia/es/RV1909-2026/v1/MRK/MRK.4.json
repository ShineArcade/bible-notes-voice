{"book": "MRK", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 313859, "verses": [{"verse": 1, "start": 300, "end": 12240, "text": "Y otra vez comenzó a enseñar junto al mar, y se juntó a él mucha gente; tanto, que entrando él en un barco, se sentó en el mar: y toda la gente estaba en tierra junto al mar.", "words": [[0, 300], [2, 467], [7, 607], [11, 967], [19, 1587], [21, 1667], [29, 2187], [35, 2387], [38, 2647], [43, 2887], [45, 3347], [48, 3507], [54, 3967], [56, 4067], [59, 4167], [65, 4427], [72, 5320], [79, 5657], [83, 6117], [92, 6697], [95, 6957], [98, 7097], [101, 7217], [108, 7677], [111, 8037], [117, 8677], [120, 8817], [123, 8957], [128, 9559], [130, 9687], [135, 9887], [138, 10107], [144, 10347], [151, 10687], [154, 10907], [161, 11207], [167, 11547], [170, 11807]]}, {"verse": 2, "start": 12590, "end": 17864, "text": "Y les enseñaba por parábolas muchas cosas, y les decía en su enseñanza:", "words": [[0, 12590], [2, 12695], [6, 12855], [15, 13615], [19, 13855], [29, 14395], [36, 14695], [43, 15815], [45, 15895], [49, 16015], [55, 16455], [58, 16675], [61, 16775]]}, {"verse": 3, "start": 18214, "end": 21483, "text": "Oíd: He aquí, el sembrador salió a sembrar.", "words": [[0, 18262], [5, 19047], [8, 19141], [14, 19610], [17, 19790], [27, 20350], [33, 20770], [35, 20870]]}, {"verse": 4, "start": 21833, "end": 29432, "text": "Y aconteció sembrando, que una parte cayó junto al camino; y vinieron las aves del cielo y se la comieron.", "words": [[0, 21833], [2, 22012], [12, 22752], [23, 23372], [27, 23552], [31, 23712], [37, 24092], [42, 24632], [48, 24872], [51, 25112], [59, 26000], [61, 26190], [70, 26650], [74, 26890], [79, 27350], [83, 27610], [89, 28070], [91, 28310], [94, 28430], [97, 28550]]}, {"verse": 5, "start": 29782, "end": 38195, "text": "Y otra parte cayó en terreno pedregoso, donde no tenía mucha tierra; y luego salió, porque no tenía la tierra profunda:", "words": [[0, 29782], [2, 29929], [7, 30109], [13, 30429], [18, 30869], [21, 30969], [29, 31429], [40, 32389], [46, 33029], [49, 33439], [55, 33849], [61, 34129], [69, 35139], [71, 35260], [77, 35460], [84, 36020], [91, 36360], [94, 36560], [100, 36920], [103, 37100], [110, 37340]]}, {"verse": 6, "start": 38545, "end": 43866, "text": "Pero salido el sol, se quemó; y por cuanto no tenía raíz, se secó.", "words": [[0, 38545], [5, 38712], [12, 39192], [15, 39332], [20, 39672], [23, 40332], [30, 41085], [32, 41209], [36, 41349], [43, 41609], [46, 41959], [52, 42309], [58, 43109], [61, 43329]]}, {"verse": 7, "start": 44216, "end": 51141, "text": "Y otra parte cayó en espinas; y subieron las espinas, y la ahogaron, y no dio fruto.", "words": [[0, 44216], [2, 44484], [7, 44664], [13, 45024], [18, 45504], [21, 45584], [30, 46533], [32, 46655], [41, 47115], [45, 47355], [54, 48075], [56, 48675], [59, 48835], [69, 49575], [71, 50115], [74, 50295], [78, 50455]]}, {"verse": 8, "start": 51491, "end": 60526, "text": "Y otra parte cayó en buena tierra, y dio fruto, que subió y creció: y produjo a treinta, a sesenta y a ciento por uno.", "words": [[0, 51491], [2, 51637], [7, 51777], [13, 52197], [18, 52737], [21, 52897], [27, 53097], [35, 53537], [37, 54157], [41, 54337], [48, 54797], [52, 54997], [58, 55577], [60, 55732], [68, 56653], [70, 56774], [78, 57294], [80, 57594], [89, 57894], [91, 58434], [99, 58974], [101, 59227], [103, 59481], [110, 59734], [114, 60054]]}, {"verse": 9, "start": 60876, "end": 65180, "text": "Entonces les dijo: El que tiene oídos para oír, oiga.", "words": [[0, 60876], [9, 61924], [13, 62124], [19, 62916], [22, 63044], [26, 63164], [32, 63464], [38, 63964], [43, 64164], [48, 64484]]}, {"verse": 10, "start": 65530, "end": 71747, "text": "Y cuando estuvo solo, le preguntaron los que estaban cerca de él con los doce, sobre la parábola.", "words": [[0, 65530], [2, 65649], [9, 65829], [16, 66229], [22, 66689], [25, 66914], [37, 67674], [41, 67854], [45, 67994], [53, 68314], [59, 68714], [62, 69014], [65, 69194], [69, 69374], [73, 69574], [79, 70094], [85, 70814], [88, 71034]]}, {"verse": 11, "start": 72097, "end": 80445, "text": "Y les dijo: A vosotros es dado saber el misterio del reino de Dios; pero a los que están fuera, por parábolas todas las cosas;", "words": [[0, 72097], [2, 72195], [6, 72315], [12, 73048], [14, 73285], [23, 73635], [26, 73985], [31, 74265], [37, 74625], [40, 74865], [49, 75465], [53, 75645], [59, 76065], [62, 76205], [68, 76946], [73, 77108], [75, 77208], [79, 77308], [83, 77428], [89, 77648], [96, 78048], [100, 78393], [110, 79013], [116, 79353], [120, 79673]]}, {"verse": 12, "start": 80795, "end": 90828, "text": "Para que viendo, vean y no perciban; y oyendo, oigan y no entiendan: no sea que se conviertan, y les sean perdonados los pecados.", "words": [[0, 80795], [5, 80939], [9, 81119], [17, 81459], [22, 82059], [24, 82239], [27, 82379], [37, 83529], [39, 83855], [47, 84182], [53, 84582], [55, 84942], [58, 85102], [69, 86304], [72, 86472], [76, 86692], [80, 86852], [83, 86992], [95, 88232], [97, 88422], [101, 88612], [106, 88952], [117, 89772], [121, 89992]]}, {"verse": 13, "start": 91178, "end": 97523, "text": "Y les dijo: ¿No sabéis esta parábola? ¿Cómo, pues, entenderéis todas las parábolas?", "words": [[0, 91178], [2, 91276], [6, 91396], [12, 92128], [16, 92419], [23, 93019], [28, 93519], [38, 94595], [45, 94783], [51, 95123], [63, 96023], [69, 96463], [73, 96723]]}, {"verse": 14, "start": 97873, "end": 100648, "text": "El que siembra es el que siembra la palabra.", "words": [[0, 97873], [3, 97995], [7, 98115], [15, 98675], [18, 98955], [21, 99115], [25, 99235], [33, 99735], [36, 99975]]}, {"verse": 15, "start": 100998, "end": 111496, "text": "Y estos son los de junto al camino: en los que la palabra es sembrada: pero después que la oyeron, luego viene Satanás, y quita la palabra que fue sembrada en sus corazones.", "words": [[0, 100998], [2, 101162], [8, 101402], [12, 101802], [16, 102049], [19, 102295], [25, 102542], [28, 102642], [36, 103435], [39, 103563], [43, 103643], [47, 103783], [50, 103903], [58, 104203], [61, 104403], [71, 105350], [76, 105494], [84, 105774], [88, 106154], [91, 106534], [99, 106914], [105, 107094], [111, 107414], [120, 108114], [122, 108554], [128, 108854], [131, 108994], [139, 109294], [143, 109494], [147, 109654], [156, 110274], [159, 110354], [163, 110494]]}, {"verse": 16, "start": 111846, "end": 120263, "text": "Y asimismo estos son los que son sembrados en pedregales: los que cuando han oído la palabra, luego la reciben con alegría;", "words": [[0, 111846], [2, 112172], [11, 112532], [17, 112812], [21, 113272], [25, 113432], [29, 113552], [33, 113752], [43, 114352], [46, 114592], [58, 115974], [62, 116100], [66, 116340], [73, 116480], [77, 116720], [82, 117040], [85, 117220], [94, 118180], [100, 118360], [103, 118620], [111, 119180], [115, 119360]]}, {"verse": 17, "start": 120613, "end": 130700, "text": "Pero no tienen raíz en sí, sino que duran poco tiempo; cuando surge la tribulación o la persecución por causa de la palabra, enseguida se apartan.", "words": [[0, 120613], [5, 120738], [8, 120898], [15, 121218], [20, 121718], [23, 121878], [27, 122518], [32, 122738], [36, 122918], [42, 123218], [47, 123398], [55, 124361], [62, 124545], [68, 124965], [71, 125245], [83, 126065], [85, 126265], [88, 126405], [100, 127205], [104, 127405], [110, 127725], [113, 128025], [116, 128125], [125, 128965], [135, 129685], [138, 129865]]}, {"verse": 18, "start": 131050, "end": 135994, "text": "Y estos son los que son sembrados entre espinas: los que oyen la palabra;", "words": [[0, 131050], [2, 131050], [8, 131050], [12, 131682], [16, 131922], [20, 132082], [24, 132322], [34, 133022], [40, 133422], [49, 134546], [53, 134675], [57, 134855], [62, 135195], [65, 135315]]}, {"verse": 19, "start": 136344, "end": 146194, "text": "Pero las preocupaciones de este mundo, y el engaño de las riquezas, y los deseos de otras cosas, entrando, ahogan la palabra, y se hace infructuosa.", "words": [[0, 136344], [5, 136508], [9, 136688], [24, 137548], [27, 137748], [32, 137888], [39, 138228], [41, 138428], [44, 138528], [51, 139008], [54, 139148], [58, 139308], [68, 139928], [70, 140388], [74, 140548], [81, 141028], [84, 141128], [90, 141308], [97, 141748], [107, 142628], [114, 143448], [117, 143708], [126, 144248], [128, 144503], [131, 144663], [136, 144923]]}, {"verse": 20, "start": 146544, "end": 157866, "text": "Y estos son los que fueron sembrados en buena tierra: los que oyen la palabra, y la reciben, y dan fruto, uno a treinta, otro a sesenta y otro a ciento por uno.", "words": [[0, 146544], [2, 146728], [8, 146988], [12, 147428], [16, 147568], [20, 147748], [27, 148028], [37, 148708], [40, 148908], [46, 149128], [54, 150014], [58, 150139], [62, 150339], [67, 150639], [70, 150759], [79, 151279], [81, 151599], [84, 151739], [93, 152919], [95, 152999], [99, 153179], [106, 153779], [110, 154379], [112, 154599], [121, 155219], [126, 155419], [128, 155619], [136, 156139], [138, 156379], [143, 156559], [145, 156779], [152, 156999], [156, 157419]]}, {"verse": 21, "start": 158216, "end": 168399, "text": "También les dijo: ¿Se trae la lámpara para ser puesta debajo de una canasta, o debajo de la cama? ¿No es para ser puesta en el soporte para lámpara?", "words": [[0, 158216], [8, 158521], [12, 158741], [18, 159502], [22, 159644], [27, 159944], [30, 160064], [38, 160564], [43, 160764], [47, 161004], [54, 161424], [61, 161824], [64, 161984], [68, 162104], [77, 162684], [79, 163184], [86, 163564], [89, 163684], [92, 163804], [98, 164552], [102, 164738], [105, 165078], [110, 165578], [114, 165798], [121, 166318], [124, 166458], [127, 166598], [135, 167218], [140, 167833]]}, {"verse": 22, "start": 168749, "end": 175600, "text": "Porque no hay nada oculto que no haya de ser manifestado, ni secreto que no haya de descubrirse.", "words": [[0, 168749], [7, 168973], [10, 169253], [14, 169433], [19, 169753], [26, 170473], [30, 170593], [33, 170813], [38, 171033], [41, 171253], [45, 171473], [58, 172283], [61, 173093], [69, 173713], [73, 173893], [76, 174113], [81, 174353], [84, 174553]]}, {"verse": 23, "start": 175950, "end": 178370, "text": "Si alguno tiene oídos para oír, oiga.", "words": [[0, 175950], [3, 176215], [10, 176635], [16, 176835], [22, 177275], [27, 177475], [32, 177955]]}, {"verse": 24, "start": 178720, "end": 188280, "text": "Les dijo también: Mirad lo que oís: con la medida que medís, os medirán otros, y se os añadirá a vosotros los que oís.", "words": [[0, 178727], [4, 178867], [9, 179107], [18, 179976], [24, 180549], [27, 180729], [31, 181110], [36, 181650], [40, 181794], [43, 181954], [50, 182274], [54, 182854], [61, 183434], [64, 183634], [72, 184254], [79, 184694], [81, 185179], [84, 185359], [87, 185559], [95, 186319], [97, 186459], [106, 187039], [110, 187479], [114, 187719]]}, {"verse": 25, "start": 188630, "end": 195482, "text": "Porque al que tiene, le será dado; y al que no tiene, aun lo que tiene le será quitado.", "words": [[0, 188630], [7, 188854], [10, 189194], [14, 189394], [21, 189854], [24, 190354], [29, 190614], [35, 191421], [37, 191545], [40, 191685], [44, 191865], [47, 192085], [54, 192985], [58, 193345], [61, 193645], [65, 193805], [71, 194225], [74, 194425], [79, 194725]]}, {"verse": 26, "start": 195832, "end": 201864, "text": "Decía más: Así es el reino de Dios, como si un hombre echa semilla en la tierra;", "words": [[0, 195832], [6, 196340], [11, 197264], [15, 197474], [18, 197754], [21, 197934], [27, 198354], [30, 198494], [36, 198794], [41, 199454], [44, 199654], [47, 199814], [54, 200054], [59, 200434], [67, 200994], [70, 201114], [73, 201234]]}, {"verse": 27, "start": 202214, "end": 208481, "text": "Y duerme, y se levanta de noche y de día, y la semilla brota y crece como él no sabe.", "words": [[0, 202214], [2, 202320], [10, 202780], [12, 203180], [15, 203280], [23, 203800], [26, 203880], [32, 204180], [34, 204360], [37, 204480], [42, 205320], [44, 205620], [47, 205740], [55, 206140], [61, 206580], [63, 206760], [69, 207220], [74, 207500], [77, 207760], [80, 207940]]}, {"verse": 28, "start": 208831, "end": 216135, "text": "Porque por sí sola fructifica la tierra, primero hierba, luego espiga, después grano lleno en la espiga;", "words": [[0, 208831], [7, 209073], [11, 209333], [14, 209533], [19, 209913], [30, 210813], [33, 210973], [41, 211813], [49, 212173], [57, 213133], [63, 213413], [71, 214493], [79, 214933], [85, 215333], [91, 215813], [94, 215921], [97, 216028]]}, {"verse": 29, "start": 216485, "end": 222193, "text": "Y cuando el fruto está maduro, enseguida se usa la hoz, porque ha llegado la cosecha.", "words": [[0, 216485], [2, 216963], [9, 217196], [12, 217436], [18, 217776], [23, 217976], [31, 218456], [41, 219456], [44, 219636], [48, 219836], [51, 220056], [56, 220276], [63, 220816], [66, 220976], [74, 221356], [77, 221476]]}, {"verse": 30, "start": 222543, "end": 228732, "text": "Y decía: ¿A qué asemejaremos el reino de Dios? ¿o con qué parábola le compararemos?", "words": [[0, 222543], [2, 222687], [9, 223499], [12, 223663], [16, 223763], [29, 224523], [32, 224763], [38, 225103], [41, 225243], [47, 226005], [50, 226150], [54, 226410], [58, 226690], [67, 227350], [70, 227610]]}, {"verse": 31, "start": 229082, "end": 236790, "text": "Es como el grano de mostaza, que, cuando se siembra en tierra, es la más pequeña de todas las semillas que hay en la tierra;", "words": [[0, 229082], [3, 229227], [8, 229427], [11, 229607], [17, 229987], [20, 230107], [29, 230787], [34, 231287], [41, 231867], [44, 232087], [52, 232507], [55, 232627], [63, 233047], [66, 233627], [69, 233747], [73, 233887], [81, 234207], [84, 234487], [90, 234727], [94, 234967], [103, 235407], [107, 235607], [111, 235827], [114, 235967], [117, 236087]]}, {"verse": 32, "start": 237140, "end": 249081, "text": "Pero después de sembrado, sube, y se hace la mayor de todas las plantas del huerto, y echa grandes ramas, de tal manera que las aves del cielo puedan refugiarse bajo su sombra.", "words": [[0, 237140], [5, 237285], [13, 237545], [16, 237745], [26, 238385], [32, 239305], [34, 239905], [37, 240105], [42, 240385], [45, 240605], [51, 240965], [54, 241225], [60, 241485], [64, 241785], [72, 242065], [76, 242345], [84, 242765], [86, 243305], [91, 243545], [99, 243925], [106, 244889], [109, 244993], [113, 245113], [120, 245433], [124, 245653], [128, 245813], [133, 246193], [137, 246353], [143, 246673], [150, 247153], [161, 248053], [166, 248213], [169, 248493]]}, {"verse": 33, "start": 249431, "end": 254883, "text": "Y con muchas tales parábolas les hablaba la palabra, conforme a lo que podían oír.", "words": [[0, 249431], [2, 249535], [6, 249715], [13, 250055], [19, 250435], [29, 251135], [33, 251655], [41, 252155], [44, 252275], [53, 252775], [62, 253235], [64, 253695], [67, 253835], [71, 253955], [78, 254355]]}, {"verse": 34, "start": 255233, "end": 261267, "text": "Y sin parábola no les hablaba; pero a sus discípulos en particular explicaba todo.", "words": [[0, 255233], [2, 255337], [6, 255537], [15, 256217], [18, 256397], [22, 256597], [31, 257488], [36, 257632], [38, 257752], [42, 257892], [53, 258932], [56, 259152], [67, 259812], [77, 260672]]}, {"verse": 35, "start": 261617, "end": 266103, "text": "Y les dijo aquel día cuando fue tarde: Pasemos de la otra parte.", "words": [[0, 261617], [2, 261743], [6, 261923], [11, 262343], [17, 262783], [21, 263023], [28, 263303], [32, 263603], [39, 264465], [47, 264831], [50, 264991], [53, 265131], [58, 265351]]}, {"verse": 36, "start": 266453, "end": 273136, "text": "Y despidiendo a la multitud, le tomaron como estaba, en el barco; y había también con él otras barcas.", "words": [[0, 266453], [2, 266572], [14, 266912], [16, 267252], [19, 267412], [29, 268412], [32, 268572], [40, 268972], [45, 269212], [53, 269512], [56, 269712], [59, 269812], [66, 270607], [68, 270893], [74, 271073], [82, 271493], [86, 271773], [89, 271953], [95, 272273]]}, {"verse": 37, "start": 273486, "end": 281604, "text": "Y se levantó una grande tempestad de viento, y echaba las olas en el barco, de tal manera que ya se llenaba.", "words": [[0, 273486], [2, 273604], [5, 273724], [13, 274224], [17, 274404], [24, 274804], [34, 275824], [37, 276024], [45, 276584], [47, 277144], [54, 277604], [58, 277824], [63, 278284], [66, 278444], [69, 278604], [76, 279584], [79, 279744], [83, 279964], [90, 280304], [94, 280604], [97, 280824], [100, 281004]]}, {"verse": 38, "start": 281954, "end": 291195, "text": "Y él estaba en la popa, durmiendo sobre una almohada, y le despertaron, y le dicen: ¿Maestro, no tienes cuidado que perecemos?", "words": [[0, 281954], [2, 282118], [5, 282298], [12, 282678], [15, 282878], [18, 283018], [24, 283898], [34, 284538], [40, 284858], [44, 285138], [54, 286578], [56, 286598], [59, 286718], [72, 287578], [74, 287918], [77, 288018], [84, 288847], [94, 289449], [97, 289529], [104, 289809], [112, 290209], [116, 290409]]}, {"verse": 39, "start": 291475, "end": 299896, "text": "Y levantándose, reprendió al viento, y dijo al mar: Calla, enmudece. Y cesó el viento, y fue hecha gran calma.", "words": [[0, 291475], [2, 291597], [16, 292677], [26, 293177], [29, 293317], [37, 293757], [39, 294417], [44, 294697], [47, 294877], [52, 295482], [59, 296348], [69, 297410], [71, 297616], [76, 297856], [79, 298096], [87, 298336], [89, 298496], [93, 298656], [99, 298916], [104, 299176]]}, {"verse": 40, "start": 300246, "end": 305577, "text": "Y a ellos dijo: ¿Por qué estáis así atemorizados? ¿Cómo no tenéis fe?", "words": [[0, 300246], [2, 300246], [4, 300560], [10, 300910], [16, 301801], [21, 302105], [25, 302265], [32, 302605], [36, 302925], [50, 304348], [56, 304513], [59, 304713], [66, 305133]]}, {"verse": 41, "start": 305927, "end": 313459, "text": "Y temieron con gran temor, y decían el uno al otro. ¿Quién es este, que aun el viento y el mar le obedecen?", "words": [[0, 305927], [2, 306109], [11, 306589], [15, 306809], [20, 307109], [27, 307649], [29, 308089], [36, 308729], [39, 309049], [43, 309309], [46, 309629], [52, 310354], [59, 310596], [62, 310736], [68, 311096], [72, 311296], [76, 311516], [79, 311716], [86, 312096], [88, 312236], [91, 312356], [95, 312536], [98, 312696]]}]}