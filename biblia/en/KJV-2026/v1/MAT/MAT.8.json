193], [34, 241573], [39, 241753], [45, 241973], [50, 242273], [55, 242553], [59, 242713], [65, 243473], [69, 243533], [74, 243966], [80, 244400], [87, 244833], [91, 244973], [96, 245153], [100, 245313], [109, 245873], [112, 246133], [116, 246253], [126, 246653], [129, 246893], [133, 247033]]}, {"verse": 34, "start": 248167, "end": 255701, "text": "And, behold, the whole city came out to meet Jesus: and when they saw him, they besought him that he would depart out of their coasts.", "words": [[0, 248167], [5, 248314], [13, 249134], [17, 249354], [23, 249554], [28, 249854], [33, 250114], [37, 250314], [40, 250494], [45, 250634], [52, 251594], [56, 251701], [61, 251841], [66, 252001], [70, 252281], [75, 252941], [80, 253041], [89, 253461], [93, 253661], [98, 253841], [101, 253941], [107, 254081], [114, 254421], [118, 254721], [121, 254821], [127, 254961]]}]}