{"book": "PSA", "chapter": 105, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 245679, "verses": [{"verse": 1, "start": 300, "end": 7091, "text": "Alabad a Jehová, invocad su nombre: haced notorias sus obras en los pueblos.", "words": [[0, 300], [7, 823], [9, 1003], [17, 2203], [25, 2823], [28, 3023], [36, 3999], [42, 4552], [51, 5142], [55, 5402], [61, 5842], [64, 6102], [68, 6242]]}, {"verse": 2, "start": 7441, "end": 12336, "text": "Cantadle, cantadle salmos: hablad de todas sus maravillas.", "words": [[0, 7441], [10, 8641], [19, 9381], [27, 10440], [34, 10570], [37, 10910], [43, 11090], [47, 11370]]}, {"verse": 3, "start": 12686, "end": 19086, "text": "Gloriaos en su santo nombre: alégrese el corazón de los que buscan a Jehová.", "words": [[0, 13014], [9, 13374], [12, 13654], [15, 13834], [21, 14274], [29, 15498], [38, 15958], [41, 16298], [49, 16858], [52, 17218], [56, 17338], [60, 17498], [67, 17918], [69, 18038]]}, {"verse": 4, "start": 19436, "end": 24124, "text": "Buscad a Jehová, y su fortaleza: buscad siempre su rostro.", "words": [[0, 19436], [7, 19436], [9, 19704], [17, 20344], [19, 20464], [22, 20604], [33, 21999], [40, 22179], [48, 22779], [51, 23239]]}, {"verse": 5, "start": 24474, "end": 30068, "text": "Acordaos de sus maravillas que hizo, de sus prodigios y de los juicios de su boca,", "words": [[0, 24758], [9, 25078], [12, 25238], [16, 25378], [27, 25998], [31, 26548], [37, 27098], [40, 27178], [44, 27338], [54, 28198], [56, 28598], [59, 28718], [63, 28858], [71, 29238], [74, 29418], [77, 29578]]}, {"verse": 6, "start": 30418, "end": 36802, "text": "Oh vosotros, descendencia de Abraham su siervo, hijos de Jacob, sus escogidos.", "words": [[0, 30503], [3, 30608], [13, 31528], [26, 32568], [29, 32768], [37, 33488], [40, 33568], [48, 34508], [54, 34808], [57, 35028], [64, 35788], [68, 35868]]}, {"verse": 7, "start": 37152, "end": 41681, "text": "Él es Jehová nuestro Dios; en toda la tierra son sus juicios.", "words": [[0, 37349], [3, 37584], [6, 37819], [13, 38054], [21, 38354], [27, 39164], [30, 39318], [35, 39558], [38, 39778], [45, 40098], [49, 40538], [53, 40798]]}, {"verse": 8, "start": 42031, "end": 47086, "text": "Se acordó para siempre de su pacto; de la palabra que mandó para mil generaciones,", "words": [[0, 42031], [3, 42156], [10, 42616], [15, 42796], [23, 43216], [26, 43416], [29, 43556], [36, 44231], [39, 44538], [42, 44658], [50, 44998], [54, 45218], [60, 45618], [65, 45798], [69, 46058]]}, {"verse": 9, "start": 47436, "end": 51664, "text": "La cual concertó con Abraham; y de su juramento a Isaac.", "words": [[0, 47436], [3, 47561], [8, 47761], [17, 48521], [21, 48701], [30, 49769], [32, 49878], [35, 49998], [38, 50158], [48, 50818], [50, 51038]]}, {"verse": 10, "start": 52014, "end": 57255, "text": "Y la estableció a Jacob por decreto, a Israel por pacto sempiterno,", "words": [[0, 52014], [2, 52105], [5, 52235], [16, 52855], [18, 53015], [24, 53355], [28, 53795], [37, 54720], [39, 54820], [46, 55220], [50, 55915], [56, 56611]]}, {"verse": 11, "start": 57605, "end": 62447, "text": "Diciendo: A ti daré la tierra de Canaán por cordel de vuestra heredad.", "words": [[0, 57605], [10, 58689], [12, 58850], [15, 59050], [20, 59470], [23, 59530], [30, 59830], [33, 60030], [40, 60470], [44, 60790], [51, 61250], [54, 61410], [62, 61750]]}, {"verse": 12, "start": 62727, "end": 67492, "text": "Esto siendo ellos pocos hombres en número, y extranjeros en ella.", "words": [[0, 62727], [5, 63533], [12, 63813], [18, 64093], [24, 64593], [32, 64873], [35, 65133], [43, 65553], [45, 66013], [57, 66853], [60, 67033]]}, {"verse": 13, "start": 67842, "end": 72135, "text": "Y anduvieron de nación en nación, de un reino a otro pueblo.", "words": [[0, 67842], [2, 68179], [13, 68549], [16, 68689], [23, 69089], [26, 69289], [34, 69809], [37, 70429], [40, 70609], [46, 71049], [48, 71169], [53, 71369]]}, {"verse": 14, "start": 72485, "end": 78430, "text": "No consintió que hombre los agraviase; y por causa de ellos castigó los reyes.", "words": [[0, 72485], [3, 72614], [13, 73314], [17, 73514], [24, 73854], [28, 74114], [39, 75332], [41, 75455], [45, 75655], [51, 76195], [54, 76455], [60, 76735], [68, 77475], [72, 77635]]}, {"verse": 15, "start": 78650, "end": 84135, "text": "No toquéis, dijo, a mis ungidos, ni hagáis mal a mis profetas.", "words": [[0, 78650], [3, 78827], [12, 80141], [18, 80915], [20, 81036], [24, 81176], [33, 81756], [36, 82036], [43, 82356], [47, 82636], [49, 82896], [53, 83016]]}, {"verse": 16, "start": 84415, "end": 89275, "text": "Y llamó al hambre sobre la tierra, y quebrantó todo mantenimiento de pan.", "words": [[0, 84415], [2, 84536], [8, 84876], [11, 85016], [18, 85376], [24, 85616], [27, 85876], [35, 86376], [37, 86791], [47, 87451], [52, 87671], [66, 88551], [69, 88751]]}, {"verse": 17, "start": 89625, "end": 93944, "text": "Envió un varón delante de ellos, a José, que fue vendido por siervo.", "words": [[0, 89625], [6, 89952], [9, 90112], [15, 90492], [23, 90892], [26, 91072], [33, 91352], [35, 91552], [41, 92152], [45, 92372], [49, 92572], [57, 93052], [61, 93212]]}, {"verse": 18, "start": 94294, "end": 99123, "text": "Afligieron sus pies con grillos; en hierro fue puesta su persona.", "words": [[0, 94294], [11, 95094], [15, 95314], [20, 95614], [24, 95914], [33, 96962], [36, 97159], [43, 97599], [47, 97779], [54, 98239], [57, 98339]]}, {"verse": 19, "start": 99473, "end": 103231, "text": "Hasta la hora que llegó su palabra, el dicho de Jehová le probó.", "words": [[0, 99473], [6, 99679], [9, 99879], [14, 100039], [18, 100219], [24, 100479], [27, 100679], [36, 101499], [39, 101599], [45, 101859], [48, 102059], [55, 102499], [58, 102559]]}, {"verse": 20, "start": 103581, "end": 108616, "text": "Envió el rey, y le soltó; el señor de los pueblos, y le desató.", "words": [[0, 103581], [6, 103824], [9, 104104], [14, 104784], [16, 104944], [19, 105381], [26, 105979], [29, 106104], [35, 106464], [38, 106724], [42, 106864], [51, 107544], [53, 107744], [56, 107844]]}, {"verse": 21, "start": 108966, "end": 114375, "text": "Lo puso por señor de su casa, y por gobernador de todas sus posesiones;", "words": [[0, 108966], [3, 109106], [8, 109526], [12, 109746], [18, 110066], [21, 110326], [24, 110486], [30, 110866], [32, 111486], [36, 111726], [47, 112486], [50, 112706], [56, 112986], [60, 113326]]}, {"verse": 22, "start": 114725, "end": 121968, "text": "Para que reprimiera a sus grandes como él quisiese, y a sus ancianos enseñara sabiduría.", "words": [[0, 114725], [5, 114911], [9, 115131], [20, 116131], [22, 116371], [26, 116531], [34, 117011], [39, 117411], [42, 117651], [52, 118311], [54, 119051], [56, 119151], [60, 119291], [69, 120171], [78, 121051]]}, {"verse": 23, "start": 122318, "end": 127967, "text": "Después entró Israel en Egipto, y Jacob fue extranjero en la tierra de Cam.", "words": [[0, 122318], [8, 122637], [14, 123177], [21, 123557], [24, 123897], [32, 124577], [34, 125037], [40, 125357], [44, 125837], [55, 126657], [58, 126757], [61, 126877], [68, 127237], [71, 127457]]}, {"verse": 24, "start": 128317, "end": 132924, "text": "Y multiplicó su pueblo en gran manera, y lo hizo fuerte más que sus enemigos.", "words": [[0, 128317], [2, 128442], [13, 129122], [16, 129262], [23, 129702], [26, 129882], [31, 130102], [39, 130622], [41, 130802], [44, 130962], [49, 131162], [56, 131562], [60, 131822], [64, 131982], [68, 132162]]}, {"verse": 25, "start": 133274, "end": 139961, "text": "Volvió el corazón de ellos para que aborreciesen a su pueblo, para que contra sus siervos pensasen mal.", "words": [[0, 133274], [7, 133761], [10, 133861], [18, 134281], [21, 134581], [27, 134801], [32, 135101], [36, 135261], [49, 135981], [51, 136121], [54, 136261], [62, 136821], [67, 137221], [71, 137381], [78, 137721], [82, 137941], [90, 138791], [99, 139641]]}, {"verse": 26, "start": 140311, "end": 144454, "text": "Envió a su siervo Moisés, y a Aarón al cual escogió.", "words": [[0, 140311], [6, 140773], [8, 140993], [11, 141153], [18, 141573], [26, 142113], [28, 142493], [30, 142823], [36, 143153], [39, 143273], [44, 143533]]}, {"verse": 27, "start": 144804, "end": 150495, "text": "Pusieron en ellos las palabras de sus señales, y sus prodigios en la tierra de Cam.", "words": [[0, 144804], [9, 145288], [12, 145468], [18, 145728], [22, 145968], [31, 146388], [34, 146628], [38, 146788], [47, 147828], [49, 147988], [53, 148148], [63, 148908], [66, 149108], [69, 149288], [76, 149608], [79, 149868]]}, {"verse": 28, "start": 150845, "end": 156346, "text": "Echó tinieblas, e hizo oscuridad; y no fueron rebeldes a su palabra.", "words": [[0, 151041], [5, 151261], [16, 152101], [18, 152301], [23, 152641], [34, 153984], [36, 154108], [39, 154228], [46, 154548], [55, 155328], [57, 155468], [60, 155588]]}, {"verse": 29, "start": 156696, "end": 160319, "text": "Volvió sus aguas en sangre, y mató sus pescados.", "words": [[0, 156696], [7, 157139], [11, 157279], [17, 157739], [20, 157899], [28, 158359], [30, 158839], [35, 159179], [39, 159359]]}, {"verse": 30, "start": 160669, "end": 164931, "text": "Produjo su tierra ranas, aun en las cámaras de sus reyes.", "words": [[0, 160669], [8, 161093], [11, 161293], [18, 161653], [25, 162753], [29, 163173], [32, 163393], [36, 163553], [44, 164073], [47, 164173], [51, 164333]]}, {"verse": 31, "start": 165281, "end": 170438, "text": "Dijo, y vinieron enjambres de moscas, y piojos en todo su término.", "words": [[0, 165281], [6, 165607], [8, 166107], [17, 166707], [27, 167307], [30, 167447], [38, 168067], [40, 168327], [47, 168787], [50, 169047], [55, 169367], [58, 169627]]}, {"verse": 32, "start": 170788, "end": 175414, "text": "Volvió en su tierra sus lluvias en granizo, y en fuego de llamaradas.", "words": [[0, 170788], [7, 171274], [10, 171374], [13, 171534], [20, 171894], [24, 172194], [32, 172734], [35, 172914], [44, 173454], [46, 173934], [49, 174074], [55, 174334], [58, 174594]]}, {"verse": 33, "start": 175764, "end": 181360, "text": "E hirió sus viñas y sus higueras, y quebró los árboles de su término.", "words": [[0, 175764], [2, 175911], [8, 176391], [12, 176611], [18, 177291], [20, 177571], [24, 177751], [34, 178331], [36, 178851], [43, 179251], [47, 179431], [55, 180071], [58, 180431], [61, 180611]]}, {"verse": 34, "start": 181710, "end": 186144, "text": "Dijo, y vinieron langostas, y pulgón sin número;", "words": [[0, 181710], [6, 182615], [8, 182835], [17, 183295], [28, 184355], [30, 184675], [37, 185235], [41, 185495]]}, {"verse": 35, "start": 186494, "end": 191325, "text": "Y comieron toda la hierba de su país, y devoraron el fruto de su tierra.", "words": [[0, 186494], [2, 186740], [11, 187160], [16, 187440], [19, 187680], [26, 188100], [29, 188240], [32, 188400], [38, 188780], [40, 189240], [50, 189800], [53, 190020], [59, 190420], [62, 190540], [65, 190680]]}, {"verse": 36, "start": 191675, "end": 197357, "text": "Hirió además a todos los primogénitos en su tierra, el principio de toda su fuerza.", "words": [[0, 191839], [6, 192039], [13, 192439], [15, 192639], [21, 192859], [25, 193079], [38, 193839], [41, 194019], [44, 194159], [52, 194579], [55, 195179], [65, 195919], [68, 196219], [73, 196419], [76, 196699]]}, {"verse": 37, "start": 197707, "end": 202469, "text": "Y los sacó con plata y oro; y no hubo en sus tribus enfermo.", "words": [[0, 197707], [2, 197800], [6, 197920], [11, 198440], [15, 198680], [21, 198980], [23, 199340], [28, 200090], [30, 200350], [33, 200510], [38, 200970], [41, 201090], [45, 201290], [52, 201710]]}, {"verse": 38, "start": 202819, "end": 208360, "text": "Egipto se alegró de que salieran; porque su terror había caído sobre ellos.", "words": [[0, 202819], [7, 203405], [10, 203565], [17, 204025], [20, 204105], [24, 204687], [34, 205429], [41, 205634], [44, 205834], [51, 206354], [57, 206714], [63, 207254], [69, 207574]]}, {"verse": 39, "start": 208710, "end": 214438, "text": "Extendió una nube por cubierta, y fuego para alumbrar la noche.", "words": [[0, 208710], [9, 209495], [13, 209875], [18, 210315], [22, 210595], [32, 211515], [34, 212035], [40, 212475], [45, 212855], [54, 213515], [57, 213775]]}, {"verse": 40, "start": 214788, "end": 219773, "text": "Pidieron, e hizo venir codornices; y los sació de pan del cielo.", "words": [[0, 214788], [10, 215272], [12, 215612], [17, 215892], [23, 216232], [35, 217776], [37, 217898], [41, 218058], [47, 218478], [50, 218618], [54, 218898], [58, 219118]]}, {"verse": 41, "start": 220123, "end": 225276, "text": "Abrió la peña, y fluyeron aguas; corrieron por los lugares secos como un río.", "words": [[0, 220123], [6, 220432], [9, 220592], [15, 220992], [17, 221152], [26, 221712], [33, 222618], [43, 223080], [47, 223200], [51, 223380], [59, 223720], [65, 224300], [70, 224480], [73, 224700]]}, {"verse": 42, "start": 225626, "end": 230207, "text": "Porque se acordó de su santa palabra, dada a Abraham su siervo.", "words": [[0, 225626], [7, 225789], [10, 226009], [17, 226489], [20, 226589], [23, 226729], [29, 227129], [38, 228069], [43, 228569], [45, 228809], [53, 229049], [56, 229489]]}, {"verse": 43, "start": 230557, "end": 234870, "text": "Y sacó a su pueblo con gozo; con júbilo a sus escogidos.", "words": [[0, 230557], [2, 230679], [7, 231079], [9, 231179], [12, 231299], [19, 231679], [23, 231959], [29, 232876], [33, 233041], [40, 233641], [42, 233801], [46, 233921]]}, {"verse": 44, "start": 235220, "end": 239897, "text": "Y les dio las tierras de las naciones; y heredaron las labores de los pueblos:", "words": [[0, 235220], [2, 235347], [6, 235507], [10, 235687], [14, 235867], [22, 236427], [25, 236567], [29, 236707], [39, 237663], [41, 237810], [51, 238370], [55, 238550], [63, 239010], [66, 239150], [70, 239250]]}, {"verse": 45, "start": 240247, "end": 245279, "text": "Para que guardasen sus estatutos, y observasen sus leyes. Aleluya.", "words": [[0, 240247], [5, 240390], [9, 240830], [19, 241270], [23, 241450], [34, 242150], [36, 242750], [47, 243350], [51, 243530], [58, 244874]]}]}