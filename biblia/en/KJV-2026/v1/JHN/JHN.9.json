{"book": "JHN", "chapter": 9, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 276553, "verses": [{"verse": 1, "start": 300, "end": 4982, "text": "And as Jesus passed by, he saw a man which was blind from his birth.", "words": [[0, 300], [4, 446], [7, 626], [13, 906], [20, 1326], [24, 2286], [27, 2346], [31, 2626], [33, 2846], [37, 3126], [43, 3426], [47, 3626], [53, 4026], [58, 4306], [62, 4486]]}, {"verse": 2, "start": 5332, "end": 12032, "text": "And his disciples asked him, saying, Master, who did sin, this man, or his parents, that he was born blind?", "words": [[0, 5332], [4, 5455], [8, 5595], [18, 6155], [24, 6615], [29, 6815], [37, 7732], [45, 8052], [49, 8252], [53, 8452], [58, 9072], [63, 9212], [68, 9752], [71, 9972], [75, 10132], [84, 10832], [89, 10972], [92, 11092], [96, 11232], [101, 11472]]}, {"verse": 3, "start": 12312, "end": 20098, "text": "Jesus answered, Neither has this man sinned, nor his parents: but that the works of God should be made manifest in him.", "words": [[0, 12312], [6, 12590], [16, 13561], [24, 13905], [28, 14285], [33, 14505], [37, 14805], [45, 15545], [49, 15865], [53, 16125], [62, 17046], [66, 17130], [71, 17290], [75, 17430], [81, 17670], [84, 17870], [88, 18210], [95, 18490], [98, 18670], [103, 18930], [112, 19430], [115, 19770]]}, {"verse": 4, "start": 20448, "end": 26065, "text": "I must work the works of him that sent me, while it is day: the night comes, when no man can work.", "words": [[0, 20448], [2, 20688], [7, 20868], [12, 21148], [16, 21328], [22, 21548], [25, 21768], [29, 21948], [34, 22168], [39, 22448], [43, 22668], [49, 23068], [52, 23248], [55, 23368], [60, 24034], [64, 24118], [70, 24298], [77, 24658], [82, 24898], [85, 25098], [89, 25338], [93, 25578]]}, {"verse": 5, "start": 26415, "end": 29639, "text": "As long as I am in the world, I am the light of the world.", "words": [[0, 26415], [3, 26555], [8, 26775], [11, 26995], [13, 27155], [16, 27235], [19, 27355], [23, 27455], [30, 28155], [32, 28335], [35, 28455], [39, 28595], [45, 28855], [48, 28995], [52, 29115]]}, {"verse": 6, "start": 29919, "end": 38282, "text": "When he had thus spoken, he spat on the ground, and made clay of the spittle, and he anointed the eyes of the blind man with the clay,", "words": [[0, 29919], [5, 30088], [8, 30268], [12, 30448], [17, 30628], [25, 31608], [28, 31688], [33, 31988], [36, 32248], [40, 32368], [48, 32708], [52, 33308], [57, 33528], [62, 33908], [65, 34108], [69, 34288], [78, 35068], [82, 35268], [85, 35408], [94, 35788], [98, 36028], [103, 36368], [106, 36568], [110, 36688], [116, 36988], [120, 37368], [125, 37568], [129, 37728]]}, {"verse": 7, "start": 38632, "end": 48325, "text": "And said to him, Go, wash in the pool of Siloam, (which is by interpretation, Sent.) He went his way therefore, and washed, and came seeing.", "words": [[0, 38632], [4, 38912], [9, 39112], [12, 39332], [17, 40335], [21, 40507], [26, 40947], [29, 41167], [33, 41287], [38, 41587], [41, 41767], [49, 42644], [56, 42847], [59, 43007], [62, 43187], [78, 43827], [85, 44847], [88, 45007], [93, 45227], [97, 45407], [101, 45627], [112, 46127], [116, 46587], [124, 47367], [128, 47427], [133, 47647]]}, {"verse": 8, "start": 48675, "end": 55058, "text": "¶ The neighbours therefore, and they which before had seen him that he was blind, said, Is not this he that sat and begged?", "words": [[2, 48675], [6, 48850], [17, 49060], [28, 49800], [32, 49920], [37, 50120], [43, 50360], [50, 50720], [54, 50960], [59, 51200], [63, 51520], [68, 51600], [71, 51700], [75, 51860], [82, 52460], [88, 53138], [91, 53273], [95, 53453], [100, 53753], [103, 53986], [108, 54220], [112, 54453], [116, 54593]]}, {"verse": 9, "start": 55338, "end": 60928, "text": "Some said, This is he: others said, He is like him: but he said, I am he.", "words": [[0, 55338], [5, 55512], [11, 56202], [16, 56368], [19, 56508], [23, 57168], [30, 57397], [36, 58145], [39, 58306], [42, 58426], [47, 58606], [52, 59326], [56, 59471], [59, 59591], [65, 60239], [67, 60379], [70, 60499]]}, {"verse": 10, "start": 61208, "end": 64510, "text": "Therefore said they to him, How were your eyes opened?", "words": [[0, 61208], [10, 61515], [15, 61855], [20, 62075], [23, 62275], [28, 62801], [32, 63037], [37, 63237], [42, 63437], [47, 63817]]}, {"verse": 11, "start": 64790, "end": 75239, "text": "He answered and said, A man that is called Jesus made clay, and anointed my eyes, and said to me, Go to the pool of Siloam, and wash: and I went and washed, and I received sight.", "words": [[0, 64790], [3, 64904], [12, 65204], [16, 65424], [22, 66080], [24, 66205], [28, 66385], [33, 66525], [36, 66665], [43, 66845], [49, 67225], [54, 67585], [60, 67965], [64, 68465], [73, 68825], [76, 69065], [82, 69365], [86, 69585], [91, 69805], [94, 69985], [98, 70285], [101, 70645], [104, 70845], [108, 70965], [113, 71225], [116, 71365], [124, 71845], [128, 72065], [134, 72854], [138, 72973], [140, 73093], [145, 73293], [149, 73513], [157, 73813], [161, 74113], [163, 74213], [172, 74613]]}, {"verse": 12, "start": 75519, "end": 79722, "text": "Then said they to him, Where is he? He said, I know not.", "words": [[0, 75519], [5, 75760], [10, 76080], [15, 76300], [18, 76500], [23, 77050], [29, 77249], [32, 77489], [36, 77997], [39, 78079], [45, 78768], [47, 78965], [52, 79165]]}, {"verse": 13, "start": 80002, "end": 83301, "text": "¶ They brought to the Pharisees him that before was blind.", "words": [[2, 80002], [7, 80128], [15, 80368], [18, 80588], [22, 80728], [32, 81408], [36, 81648], [41, 81948], [48, 82308], [52, 82648]]}, {"verse": 14, "start": 83651, "end": 88017, "text": "And it was the sabbath day when Jesus made the clay, and opened his eyes.", "words": [[0, 83651], [4, 83772], [7, 83852], [11, 83992], [15, 84132], [23, 84472], [27, 84912], [32, 85172], [38, 85452], [43, 85832], [47, 86012], [53, 86312], [57, 86852], [64, 87132], [68, 87392]]}, {"verse": 15, "start": 88367, "end": 97360, "text": "Then again the Pharisees also asked him how he had received his sight. He said to them, He put clay upon my eyes, and I washed, and do see.", "words": [[0, 88367], [5, 88589], [11, 89089], [15, 89149], [25, 89869], [30, 90169], [36, 90629], [40, 90809], [44, 91069], [47, 91289], [51, 91469], [60, 91889], [64, 92149], [71, 92893], [74, 93023], [79, 93283], [82, 93483], [88, 94141], [91, 94255], [95, 94368], [100, 94648], [105, 94828], [108, 95088], [114, 95408], [118, 95768], [120, 95888], [128, 96308], [132, 96768], [135, 96948]]}, {"verse": 16, "start": 97640, "end": 109301, "text": "Therefore said some of the Pharisees, This man is not of God, because he keeps not the sabbath day. Others said, How can a man that is a sinner do such miracles? And there was a division among them.", "words": [[0, 97640], [10, 97994], [15, 98354], [20, 98614], [23, 98794], [27, 98894], [38, 99984], [43, 100121], [47, 100341], [50, 100461], [54, 100621], [57, 100761], [62, 101001], [70, 101461], [73, 101701], [79, 101921], [83, 102221], [87, 102441], [95, 102701], [100, 103461], [107, 103690], [113, 104438], [117, 104618], [121, 104838], [123, 104938], [127, 105118], [132, 105298], [135, 105418], [137, 105498], [144, 105798], [147, 106138], [152, 106418], [162, 107460], [166, 107605], [172, 107765], [176, 107985], [178, 108145], [187, 108525], [193, 108825]]}, {"verse": 17, "start": 109651, "end": 116716, "text": "They say to the blind man again, What do you say of him, that he has opened your eyes? He said, He is a prophet.", "words": [[0, 109651], [5, 109774], [9, 109974], [12, 110154], [16, 110274], [22, 110594], [26, 110894], [33, 111790], [38, 111950], [41, 112070], [45, 112190], [49, 112390], [52, 112550], [57, 112810], [62, 113250], [65, 113410], [69, 113610], [76, 113930], [81, 114130], [87, 114884], [90, 114966], [96, 115655], [99, 115847], [102, 116027], [104, 116127]]}, {"verse": 18, "start": 116996, "end": 125421, "text": "But the Jews did not believe concerning him, that he had been blind, and received his sight, until they called the parents of him that had received his sight.", "words": [[0, 116996], [4, 117156], [8, 117276], [13, 117556], [17, 117856], [21, 118016], [29, 118396], [40, 118936], [45, 119336], [50, 119836], [53, 119996], [57, 120136], [62, 120316], [69, 120696], [73, 120956], [82, 121336], [86, 121556], [93, 121876], [99, 122476], [104, 122736], [111, 122976], [115, 123196], [123, 123536], [126, 123776], [130, 123956], [135, 124156], [139, 124316], [148, 124696], [152, 124956]]}, {"verse": 19, "start": 125771, "end": 131856, "text": "And they asked them, saying, Is this your son, who you say was born blind? how then does he now see?", "words": [[0, 125771], [4, 125888], [9, 126048], [15, 126348], [21, 126588], [29, 127378], [32, 127538], [37, 127718], [42, 127938], [47, 128318], [51, 128798], [55, 128958], [59, 129218], [63, 129418], [68, 129698], [75, 130538], [79, 130684], [84, 130904], [89, 131104], [92, 131264], [96, 131424]]}, {"verse": 20, "start": 132136, "end": 137359, "text": "His parents answered them and said, We know that this is our son, and that he was born blind:", "words": [[0, 132136], [4, 132240], [12, 132640], [21, 133120], [26, 133380], [30, 133560], [36, 134521], [39, 134625], [44, 134765], [49, 134905], [54, 135085], [57, 135205], [61, 135365], [66, 135705], [70, 136085], [75, 136225], [78, 136345], [82, 136505], [87, 136765]]}, {"verse": 21, "start": 137709, "end": 145840, "text": "But by what means he now sees, we know not; or who has opened his eyes, we know not: he is of age; ask him: he shall speak for himself.", "words": [[0, 137709], [4, 137809], [7, 137949], [12, 138129], [18, 138389], [21, 138549], [25, 138729], [31, 139369], [34, 139549], [39, 139729], [44, 140402], [47, 140523], [51, 140683], [55, 140883], [62, 141183], [66, 141423], [72, 141823], [75, 141883], [80, 142083], [85, 142721], [88, 142942], [91, 143062], [94, 143202], [99, 143816], [103, 144038], [108, 144512], [111, 144620], [117, 144800], [123, 145060], [127, 145280]]}, {"verse": 22, "start": 146120, "end": 156221, "text": "These words spoke his parents, because they feared the Jews: for the Jews had agreed already, that if any man did confess that he was Christ, he should be put out of the synagogue.", "words": [[0, 146120], [6, 146273], [12, 146613], [18, 146903], [22, 147193], [31, 147653], [39, 147998], [44, 148258], [51, 148578], [55, 148778], [61, 149686], [65, 149779], [69, 149919], [74, 150179], [78, 150399], [85, 150719], [94, 151239], [99, 151759], [102, 151899], [106, 152079], [110, 152359], [114, 152579], [122, 153039], [127, 153299], [130, 153439], [134, 153599], [142, 154499], [145, 154539], [152, 154699], [155, 154839], [159, 155039], [163, 155219], [166, 155339], [170, 155439]]}, {"verse": 23, "start": 156571, "end": 159878, "text": "Therefore said his parents, He is of age; ask him.", "words": [[0, 156571], [10, 156916], [15, 157236], [19, 157416], [28, 158258], [31, 158420], [34, 158620], [37, 158780], [42, 159419], [46, 159605]]}, {"verse": 24, "start": 160158, "end": 167477, "text": "Then again called they the man that was blind, and said to him, Give God the praise: we know that this man is a sinner.", "words": [[0, 160158], [5, 160337], [11, 160617], [18, 161159], [23, 161642], [27, 161762], [31, 162002], [36, 162202], [40, 162382], [47, 163182], [51, 163342], [56, 163582], [59, 163802], [64, 164348], [69, 164533], [73, 164813], [77, 164993], [85, 165778], [88, 165880], [93, 166080], [98, 166240], [103, 166400], [107, 166720], [110, 166920], [112, 167020]]}, {"verse": 25, "start": 167757, "end": 174940, "text": "He answered and said, Whether he be a sinner or no, I know not: one thing I know, that, whereas I was blind, now I see.", "words": [[0, 167757], [3, 167870], [12, 168170], [16, 168390], [22, 169046], [30, 169228], [33, 169428], [36, 169548], [38, 169688], [45, 169928], [48, 170168], [52, 170608], [54, 170708], [59, 170868], [64, 171488], [68, 171650], [74, 171850], [76, 172010], [82, 172250], [88, 172670], [96, 173270], [98, 173510], [102, 173610], [109, 173970], [113, 174410], [115, 174570]]}, {"verse": 26, "start": 175220, "end": 179839, "text": "Then said they to him again, What did he to you? how opened he your eyes?", "words": [[0, 175220], [5, 175442], [10, 175762], [15, 175982], [18, 176142], [22, 176362], [29, 177205], [34, 177325], [38, 177485], [41, 177865], [44, 177865], [49, 178422], [53, 178567], [60, 178927], [63, 179127], [68, 179347]]}, {"verse": 27, "start": 180119, "end": 187565, "text": "He answered them, I have told you already, and you did not hear: why would you hear it again? will you also be his disciples?", "words": [[0, 180119], [3, 180230], [12, 180530], [18, 181166], [20, 181326], [25, 181466], [30, 181706], [34, 181926], [43, 182306], [47, 182826], [51, 182946], [55, 183106], [59, 183326], [65, 184048], [69, 184329], [75, 184569], [79, 184689], [84, 184929], [87, 185049], [94, 185776], [99, 185866], [103, 185986], [108, 186346], [111, 186586], [115, 186746]]}, {"verse": 28, "start": 187845, "end": 193112, "text": "Then they reviled him, and said, You are his disciple; but we are Moses’ disciples.", "words": [[0, 187845], [5, 188111], [10, 188311], [18, 188851], [23, 189011], [27, 189231], [33, 189837], [37, 190014], [41, 190194], [45, 190334], [55, 191197], [59, 191323], [62, 191523], [66, 191783], [73, 192443]]}, {"verse": 29, "start": 193462, "end": 198521, "text": "We know that God spoke to Moses: as for this fellow, we know not from where he is.", "words": [[0, 193462], [3, 193605], [8, 193885], [13, 194105], [17, 194345], [23, 194645], [26, 194845], [33, 195626], [36, 195799], [40, 195979], [45, 196199], [53, 196859], [56, 196959], [61, 197139], [65, 197419], [70, 197639], [76, 197859], [79, 198059]]}, {"verse": 30, "start": 198801, "end": 206336, "text": "The man answered and said to them, Why herein is a marvellous thing, that you know not from where he is, and yet he has opened my eyes.", "words": [[0, 198801], [4, 198898], [8, 199138], [17, 199598], [21, 199818], [26, 199998], [29, 200198], [35, 200725], [39, 201021], [46, 201351], [49, 201491], [51, 201691], [62, 201891], [69, 202571], [74, 202751], [78, 202891], [83, 203051], [87, 203291], [92, 203511], [98, 203731], [101, 203891], [105, 204371], [109, 204551], [113, 204731], [116, 204911], [120, 205111], [127, 205491], [130, 205751]]}, {"verse": 31, "start": 206686, "end": 213498, "text": "Now we know that God hears not sinners: but if any man be a worshipper of God, and does his will, him he hears.", "words": [[0, 206686], [4, 206870], [7, 207090], [12, 207270], [17, 207470], [21, 207710], [27, 208290], [31, 208370], [40, 209279], [44, 209398], [47, 209518], [51, 209778], [55, 210038], [58, 210238], [60, 210318], [71, 210698], [74, 210858], [79, 211138], [83, 211578], [88, 211778], [92, 211938], [98, 212558], [102, 212698], [105, 212938]]}, {"verse": 32, "start": 213848, "end": 219319, "text": "Since the world began was it not heard that any man opened the eyes of one that was born blind.", "words": [[0, 213848], [6, 214052], [10, 214272], [16, 214552], [22, 215332], [26, 215452], [29, 215592], [33, 215772], [39, 216132], [44, 216332], [48, 216612], [52, 216892], [59, 217232], [63, 217452], [68, 217732], [71, 217892], [75, 218112], [80, 218292], [84, 218472], [89, 218712]]}, {"verse": 33, "start": 219669, "end": 222028, "text": "If this man were not of God, he could do nothing.", "words": [[0, 219669], [3, 219792], [8, 219992], [12, 220232], [17, 220392], [21, 220532], [24, 220672], [29, 221192], [32, 221292], [38, 221432], [41, 221572]]}, {"verse": 34, "start": 222308, "end": 228367, "text": "They answered and said to him, You were altogether born in sins, and do you teach us? And they cast him out.", "words": [[0, 222308], [5, 222417], [14, 222817], [18, 223037], [23, 223237], [26, 223417], [31, 223869], [35, 224013], [40, 224383], [51, 224753], [56, 225153], [59, 225313], [65, 225573], [69, 226013], [72, 226153], [76, 226233], [82, 226453], [86, 227165], [90, 227316], [95, 227436], [100, 227756], [104, 227976]]}, {"verse": 35, "start": 228717, "end": 235915, "text": "Jesus heard that they had cast him out; and when he had found him, he said to him, Do you believe on the Son of God?", "words": [[0, 228717], [6, 229041], [12, 229521], [17, 229761], [22, 229921], [26, 230061], [31, 230381], [35, 230601], [40, 231240], [44, 231365], [49, 231545], [52, 231745], [56, 231865], [62, 232165], [67, 232725], [70, 232865], [75, 233125], [78, 233305], [83, 233892], [86, 233989], [90, 234249], [98, 234609], [101, 234849], [105, 234969], [109, 235229], [112, 235369]]}, {"verse": 36, "start": 236195, "end": 240239, "text": "He answered and said, Who is he, Lord, that I might believe on him?", "words": [[0, 236195], [3, 236308], [12, 236608], [16, 236828], [22, 237484], [26, 237628], [29, 238008], [33, 238368], [39, 238968], [44, 239128], [46, 239248], [52, 239448], [60, 239728], [63, 239908]]}, {"verse": 37, "start": 240519, "end": 245670, "text": "And Jesus said to him, You have both seen him, and it is he that talks with you.", "words": [[0, 240519], [4, 240669], [10, 240969], [15, 241369], [18, 241569], [23, 242071], [27, 242206], [32, 242406], [37, 242686], [42, 243026], [47, 243686], [51, 243826], [54, 243946], [57, 244126], [60, 244386], [65, 244666], [71, 244986], [76, 245306]]}, {"verse": 38, "start": 245950, "end": 250443, "text": "And he said, Lord, I believe. And he worshipped him.", "words": [[0, 245950], [4, 246085], [7, 246225], [13, 247633], [19, 248157], [21, 248257], [30, 249237], [34, 249409], [37, 249569], [48, 250129]]}, {"verse": 39, "start": 250793, "end": 259650, "text": "¶ And Jesus said, For judgment I am come into this world, that they which see not might see; and that they which see might be made blind.", "words": [[2, 250793], [6, 250959], [12, 251239], [18, 252069], [22, 252199], [31, 252599], [33, 252979], [36, 253119], [41, 253379], [46, 253639], [51, 253899], [58, 254319], [63, 254859], [68, 255139], [74, 255339], [78, 255659], [82, 255999], [88, 256399], [93, 257194], [97, 257335], [102, 257515], [107, 257735], [113, 257955], [117, 258235], [123, 258475], [126, 258695], [131, 258975]]}, {"verse": 40, "start": 259930, "end": 266243, "text": "And some of the Pharisees which were with him heard these words, and said to him, Are we blind also?", "words": [[0, 259930], [4, 260045], [9, 260265], [12, 260405], [16, 260525], [26, 261225], [32, 261365], [37, 261545], [42, 261765], [46, 261925], [52, 262205], [58, 262445], [65, 262845], [69, 263200], [74, 263460], [77, 263660], [82, 265003], [86, 265126], [89, 265266], [95, 265546]]}, {"verse": 41, "start": 266523, "end": 276153, "text": "Jesus said to them, If you were blind, you should have no sin: but now you say, We see; therefore your sin remains.", "words": [[0, 266523], [6, 266782], [11, 267122], [14, 267302], [20, 269529], [23, 269716], [27, 269916], [32, 270036], [39, 270896], [43, 271016], [50, 271196], [55, 271456], [58, 271676], [63, 272356], [67, 272457], [71, 272637], [75, 272837], [80, 273377], [83, 273677], [88, 274450], [98, 274993], [103, 275073], [107, 275353]]}]}