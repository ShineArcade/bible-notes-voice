{"book": "ACT", "chapter": 27, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 380839, "verses": [{"verse": 1, "start": 300, "end": 12251, "text": "Pero como fue determinado que habíamos de navegar para Italia, entregaron a Pablo y a algunos otros presos a un centurión, llamado Julio, de la unidad militar Augusta.", "words": [[0, 300], [5, 466], [10, 726], [14, 1026], [26, 1826], [30, 2006], [39, 2406], [42, 2606], [50, 3126], [55, 3326], [63, 4466], [74, 5306], [76, 5426], [82, 5806], [84, 6066], [86, 6206], [94, 6646], [100, 7086], [107, 7786], [109, 7966], [112, 8106], [123, 8766], [131, 9266], [138, 10126], [141, 10406], [144, 10526], [151, 10946], [159, 11466]]}, {"verse": 2, "start": 12701, "end": 24083, "text": "Así que, embarcándonos en una nave Adramitio, partimos, estando con nosotros Aristarco, macedonio de Tesalónica, para navegar hacia los puertos de Asia.", "words": [[0, 12701], [4, 12952], [9, 13172], [23, 14312], [26, 14552], [30, 14732], [35, 15462], [46, 16192], [56, 16992], [64, 17872], [68, 18072], [77, 18512], [88, 19482], [98, 20452], [101, 20632], [113, 21612], [118, 21832], [126, 22372], [132, 22592], [136, 22792], [144, 23352], [147, 23552]]}, {"verse": 3, "start": 24533, "end": 35007, "text": "Y otro día llegamos a Sidón; y Julio, tratando a Pablo con humanidad, le permitió que fuese a los amigos, para ser de ellos asistido.", "words": [[0, 24533], [2, 24699], [7, 24879], [11, 25259], [20, 26079], [22, 26259], [29, 27083], [31, 27227], [38, 28227], [47, 28887], [49, 29047], [55, 29387], [59, 29707], [70, 30767], [73, 30847], [82, 31387], [86, 31507], [92, 31847], [94, 31967], [98, 32047], [106, 32487], [111, 33007], [115, 33527], [118, 33727], [124, 34007]]}, {"verse": 4, "start": 35457, "end": 42458, "text": "Y haciéndonos a la vela desde allí, navegamos al abrigo de Chipre, porque los vientos eran contrarios.", "words": [[0, 35457], [2, 35601], [14, 36201], [16, 36401], [19, 36521], [24, 36841], [30, 37021], [36, 37421], [46, 38461], [49, 38681], [56, 39141], [59, 39221], [67, 39801], [74, 40401], [78, 40661], [86, 41061], [91, 41321]]}, {"verse": 5, "start": 42908, "end": 48652, "text": "Y habiendo pasado el mar de Cilicia y Panfilia, arribamos a Mira, ciudad de Licia.", "words": [[0, 42908], [2, 43012], [11, 43312], [18, 43652], [21, 43892], [25, 44092], [28, 44482], [36, 44872], [38, 44972], [48, 45952], [58, 46872], [60, 47122], [66, 47372], [73, 47652], [76, 47992]]}, {"verse": 6, "start": 49102, "end": 55458, "text": "Y hallando allí el centurión una nave alejandrina que navegaba a Italia, nos puso en ella.", "words": [[0, 49102], [2, 49323], [11, 49663], [16, 49923], [19, 50083], [29, 50943], [33, 51143], [38, 51443], [50, 52163], [54, 52343], [63, 52923], [65, 53183], [73, 53763], [77, 54323], [82, 54763], [85, 54943]]}, {"verse": 7, "start": 55908, "end": 66723, "text": "Y navegando muchos días despacio, y habiendo apenas llegado delante de Gnido, no dejándonos el viento, navegamos al abrigo de Creta, junto a Salmón.", "words": [[0, 55908], [2, 56057], [12, 56637], [19, 56937], [24, 57357], [34, 58677], [36, 58917], [45, 59277], [52, 59537], [60, 60317], [68, 60737], [71, 61027], [78, 61317], [81, 61817], [92, 62557], [95, 62777], [103, 63757], [113, 64357], [116, 64557], [123, 64957], [126, 65057], [133, 65497], [139, 65777], [141, 66037]]}, {"verse": 8, "start": 67173, "end": 75827, "text": "Y costeándola difícilmente, llegamos a un lugar que llaman Buenos Puertos, cerca del cual estaba la ciudad de Lasea.", "words": [[0, 67173], [2, 67593], [14, 68053], [28, 69093], [37, 69493], [39, 69673], [42, 69813], [48, 70113], [52, 70333], [59, 70733], [66, 71433], [75, 72653], [81, 73123], [85, 73593], [90, 73713], [97, 74093], [100, 74313], [107, 74693], [110, 75274]]}, {"verse": 9, "start": 76277, "end": 84995, "text": "Y pasado mucho tiempo, y siendo ya peligrosa la navegación, porque ya era pasado el ayuno, Pablo amonestaba,", "words": [[0, 76277], [2, 76398], [9, 76678], [15, 77078], [23, 78078], [25, 78338], [32, 78638], [35, 78818], [45, 79538], [48, 79638], [60, 80978], [67, 81278], [70, 81538], [74, 81698], [81, 82038], [84, 82358], [91, 83398], [97, 83878]]}, {"verse": 10, "start": 85445, "end": 95816, "text": "Diciéndoles: Varones, veo que con trabajo y mucho daño, no sólo de la carga y de la nave, pero aun de nuestras personas, habrá de ser la navegación.", "words": [[0, 85445], [13, 86777], [22, 87116], [26, 87376], [30, 87556], [34, 87736], [42, 88136], [44, 88296], [50, 88536], [56, 89236], [59, 89416], [64, 89676], [67, 89836], [70, 89936], [76, 90196], [78, 90376], [81, 90456], [84, 90596], [90, 91216], [95, 91416], [99, 91696], [102, 91876], [111, 92056], [121, 92756], [127, 93396], [130, 93516], [134, 93736], [137, 93876]]}, {"verse": 11, "start": 96166, "end": 102482, "text": "Pero el centurión creía más al piloto y al patrón de la nave, que a lo que Pablo decía.", "words": [[0, 96166], [5, 96348], [8, 96488], [18, 97108], [24, 97588], [28, 97808], [31, 98048], [38, 98788], [40, 98888], [43, 99008], [50, 99488], [53, 99588], [56, 99708], [62, 100108], [66, 100788], [68, 100868], [71, 100988], [75, 101108], [81, 101628]]}, {"verse": 12, "start": 102932, "end": 115915, "text": "Y no habiendo puerto cómodo para invernar, muchos acordaron pasar aún de allí, por si pudiesen arribar a Fenice e invernar allí, que es un puerto de Creta que mira al Nordeste y Sudeste.", "words": [[0, 102932], [2, 103055], [5, 103155], [14, 103515], [21, 103955], [28, 104555], [33, 104795], [43, 106015], [50, 106275], [60, 106975], [66, 107295], [70, 107595], [73, 107775], [79, 108055], [83, 108515], [86, 108715], [95, 109275], [103, 109835], [105, 109915], [112, 110475], [114, 110775], [123, 111515], [129, 112231], [133, 112336], [136, 112516], [139, 112676], [146, 113043], [149, 113409], [155, 113776], [159, 113936], [164, 114176], [167, 114376], [176, 115016], [178, 115216]]}, {"verse": 13, "start": 116365, "end": 125155, "text": "Y soplando el viento del sur, pareciéndoles que ya tenían lo que deseaban, alzando velas, iban cerca de la costa de Creta.", "words": [[0, 116365], [2, 116492], [11, 116952], [14, 117092], [21, 117472], [25, 117672], [30, 118092], [44, 119252], [48, 119432], [51, 119732], [58, 120032], [61, 120232], [65, 120372], [75, 121512], [83, 121972], [90, 122712], [95, 123152], [101, 123512], [104, 123812], [107, 123912], [113, 124372], [116, 124797]]}, {"verse": 14, "start": 125605, "end": 131313, "text": "Pero no mucho después dio en ella un viento repentino, que se llama Euroclidón.", "words": [[0, 125605], [5, 125768], [8, 125988], [14, 126288], [22, 126788], [26, 127208], [29, 127508], [34, 127708], [37, 127888], [44, 128268], [55, 129088], [59, 129448], [62, 129628], [68, 129948]]}, {"verse": 15, "start": 131763, "end": 137927, "text": "Y siendo arrebatada la nave, y no pudiendo resistir contra el viento, la dejamos, y éramos llevados.", "words": [[0, 131763], [2, 131870], [9, 132230], [20, 132910], [23, 133070], [29, 133410], [31, 133670], [34, 133790], [43, 134230], [52, 134870], [59, 135190], [62, 135370], [70, 135730], [73, 135910], [82, 136470], [84, 136910], [91, 137190]]}, {"verse": 16, "start": 138377, "end": 145749, "text": "Y habiendo corrido a sotavento de una pequeña isla que se llama Clauda, apenas pudimos asegurar el bote:", "words": [[0, 138377], [2, 138521], [11, 138841], [19, 139281], [21, 139421], [31, 139881], [34, 140041], [38, 140161], [46, 140461], [51, 140981], [55, 141101], [58, 141241], [64, 141461], [72, 142461], [79, 142761], [87, 143321], [96, 143881], [99, 144081]]}, {"verse": 17, "start": 146199, "end": 156327, "text": "El cual tomado, usaban cuerdas de refuerzo, rodeando la nave; y teniendo temor de que diesen en la Sirte, bajadas las velas, eran así llevados.", "words": [[0, 146199], [3, 146199], [8, 146199], [16, 146199], [23, 146606], [31, 147166], [34, 147306], [44, 147986], [53, 148886], [56, 149106], [62, 149888], [64, 150192], [73, 150532], [79, 150872], [82, 151052], [86, 151272], [93, 151492], [96, 151965], [99, 152439], [106, 152912], [114, 153652], [118, 153852], [125, 154652], [130, 155192], [134, 155512]]}, {"verse": 18, "start": 156777, "end": 163953, "text": "Pero siendo atormentados de una vehemente tempestad, al siguiente día arrojaron carga al mar;", "words": [[0, 156777], [5, 156918], [12, 157298], [25, 158178], [28, 158338], [32, 158478], [42, 159358], [53, 160498], [56, 160598], [66, 160898], [70, 161498], [80, 162678], [86, 163078], [89, 163518]]}, {"verse": 19, "start": 164403, "end": 169812, "text": "Y al tercer día nosotros con nuestras manos arrojamos los aparejos de la nave.", "words": [[0, 164403], [2, 164530], [5, 164650], [12, 165070], [16, 165450], [25, 165970], [29, 166350], [38, 166770], [44, 167310], [54, 168270], [58, 168430], [67, 169070], [70, 169190], [73, 169310]]}, {"verse": 20, "start": 170262, "end": 180619, "text": "Y no pareciendo sol ni estrellas por muchos días, y viniendo una tempestad no pequeña, ya era perdida toda la esperanza de salvarnos.", "words": [[0, 170262], [2, 170389], [5, 170529], [16, 171109], [20, 171469], [23, 171729], [33, 172389], [37, 172609], [44, 172909], [50, 173309], [52, 173949], [61, 174469], [65, 174669], [75, 175489], [78, 175769], [87, 176969], [90, 177209], [94, 177409], [102, 178229], [107, 178529], [110, 178789], [120, 179469], [123, 179629]]}, {"verse": 21, "start": 181069, "end": 195330, "text": "Entonces Pablo, habiendo ya mucho que no comíamos, puesto en pie en medio de ellos, dijo: Convenía, pues, oh varones, haberme oído, y no partir de Creta, y evitar este inconveniente y daño.", "words": [[0, 181069], [9, 181925], [16, 182532], [25, 183138], [28, 183745], [34, 184005], [38, 184245], [41, 184425], [51, 185805], [58, 186165], [61, 186545], [65, 186785], [68, 187105], [74, 187445], [77, 187725], [84, 188405], [90, 189167], [100, 189760], [106, 190070], [109, 190380], [118, 191040], [126, 191380], [132, 191680], [134, 191940], [137, 192080], [144, 192427], [147, 192773], [154, 193120], [156, 193300], [163, 193620], [168, 193880], [182, 194700], [184, 194840]]}, {"verse": 22, "start": 195780, "end": 203066, "text": "Pero ahora os amonesto que tengáis buen ánimo; porque ninguna pérdida habrá de persona de vosotros, sino solamente de la nave.", "words": [[0, 195780], [5, 195948], [11, 196308], [14, 196628], [23, 197148], [27, 197328], [35, 197728], [40, 197968], [47, 198807], [54, 198987], [62, 199287], [70, 199867], [76, 200147], [79, 200227], [87, 200527], [90, 200727], [100, 201287], [105, 201727], [115, 202207], [118, 202527], [121, 202647]]}, {"verse": 23, "start": 203516, "end": 208133, "text": "Porque esta noche ha estado conmigo el ángel del Dios del cual yo soy, y al cual sirvo,", "words": [[0, 203516], [7, 203703], [12, 203883], [18, 204083], [21, 204243], [28, 204483], [36, 204983], [39, 205103], [45, 205423], [49, 205603], [54, 205843], [58, 206123], [63, 206383], [66, 206583], [71, 206903], [73, 207223], [76, 207343], [81, 207503]]}, {"verse": 24, "start": 208583, "end": 217283, "text": "Diciendo: Pablo, no temas; es necesario que comparezcas ante César; y he aquí, Dios te ha dado todos los que navegan contigo.", "words": [[0, 208583], [10, 209539], [17, 209907], [20, 210283], [27, 210959], [30, 211139], [40, 211719], [44, 211919], [56, 212599], [61, 212879], [68, 213787], [70, 213974], [73, 214034], [79, 214734], [84, 214974], [87, 215214], [90, 215314], [95, 215494], [101, 215754], [105, 216034], [109, 216194], [117, 216594]]}, {"verse": 25, "start": 217733, "end": 223561, "text": "Por tanto, oh varones, tened buen ánimo; porque yo confío en Dios que será así como me ha dicho;", "words": [[0, 217733], [4, 217852], [11, 218092], [14, 218332], [23, 219132], [29, 219372], [34, 219552], [41, 220432], [48, 220632], [51, 220792], [58, 221332], [61, 221492], [66, 221712], [70, 221952], [75, 222232], [79, 222532], [84, 222772], [87, 223012], [90, 223092]]}, {"verse": 26, "start": 224011, "end": 226439, "text": "Si bien es necesario que demos en una isla.", "words": [[0, 224011], [3, 224149], [8, 224409], [11, 224529], [21, 224889], [25, 225249], [31, 225609], [34, 225809], [38, 225929]]}, {"verse": 27, "start": 226789, "end": 236750, "text": "Y venida la decimocuarta noche, y siendo llevados por el mar Adriático, los marineros a la media noche sospecharon que estaban cerca de alguna tierra;", "words": [[0, 226789], [2, 226935], [9, 227315], [12, 227435], [25, 228175], [32, 229075], [34, 229335], [41, 229615], [50, 230095], [54, 230335], [57, 230515], [61, 230695], [72, 232195], [76, 232295], [86, 233035], [88, 233115], [91, 233355], [97, 233595], [103, 233835], [115, 234555], [119, 234735], [127, 235095], [133, 235535], [136, 235795], [143, 236035]]}, {"verse": 28, "start": 237200, "end": 246465, "text": "Y echando la sonda, hallaron veinte brazas; y pasando un poco más adelante, volviendo a echar la sonda, hallaron quince brazas.", "words": [[0, 237200], [2, 237424], [10, 237864], [13, 238044], [20, 238724], [29, 239295], [36, 239865], [44, 240690], [46, 240795], [54, 241175], [57, 241415], [62, 241635], [66, 241895], [76, 242875], [86, 243355], [88, 243515], [94, 243655], [97, 243855], [104, 244735], [113, 245155], [120, 245655]]}, {"verse": 29, "start": 246915, "end": 253728, "text": "Y temiendo chocar contra los escollos, echaron cuatro anclas por la popa y ansiaban que se hiciese de día.", "words": [[0, 246915], [2, 247041], [11, 247441], [18, 247901], [25, 248181], [29, 248441], [39, 249421], [47, 249941], [54, 250221], [61, 250721], [65, 250901], [68, 251061], [73, 251401], [75, 251501], [84, 252061], [88, 252281], [91, 252441], [99, 252901], [102, 253161]]}, {"verse": 30, "start": 254178, "end": 264559, "text": "Entonces procurando los marineros huir de la nave, echado que hubieron el bote al mar, aparentando como que querían largar las anclas de proa,", "words": [[0, 254178], [9, 255400], [20, 256180], [24, 256380], [34, 257120], [39, 257560], [42, 257680], [45, 257840], [51, 258680], [58, 259180], [62, 259380], [71, 259700], [74, 259900], [79, 260260], [82, 260440], [87, 261060], [99, 261980], [104, 262220], [108, 262400], [116, 262800], [123, 263280], [127, 263460], [134, 263940], [137, 264060]]}, {"verse": 31, "start": 265009, "end": 272661, "text": "Pablo dijo al centurión y a los soldados: Si estos no quedan en la nave, vosotros no podéis salvaros.", "words": [[0, 265009], [6, 265380], [11, 266100], [14, 266320], [24, 267060], [26, 267240], [28, 267320], [32, 267440], [42, 268551], [45, 268696], [51, 268956], [54, 269176], [61, 269516], [64, 269616], [67, 269716], [73, 270396], [82, 270836], [85, 271016], [92, 271316]]}, {"verse": 32, "start": 273011, "end": 278719, "text": "Entonces los soldados cortaron las cuerdas del bote, y lo dejaron perder.", "words": [[0, 273011], [9, 274075], [13, 274415], [22, 275055], [31, 275755], [35, 275935], [43, 276435], [47, 276615], [53, 277015], [55, 277395], [58, 277535], [66, 277975]]}, {"verse": 33, "start": 279169, "end": 290798, "text": "Y como comenzó a ser de día, Pablo exhortaba a todos que comiesen, diciendo: Este es el decimocuarto día que esperáis y permanecéis ayunos, no comiendo nada.", "words": [[0, 279169], [2, 279416], [7, 279656], [15, 280256], [17, 280376], [21, 280596], [24, 280776], [29, 281516], [35, 282016], [45, 282836], [47, 282996], [53, 283256], [57, 283536], [67, 284616], [77, 285583], [82, 285901], [85, 286101], [88, 286201], [101, 286881], [105, 287201], [109, 287401], [118, 288001], [120, 288281], [132, 289021], [140, 289841], [143, 289941], [152, 290361]]}, {"verse": 34, "start": 291248, "end": 298036, "text": "Por tanto, os ruego que comáis por vuestra salud: que ni aun un cabello de la cabeza de ninguno de vosotros perecerá.", "words": [[0, 291248], [4, 291355], [11, 291855], [14, 291935], [20, 292195], [24, 292335], [31, 292755], [35, 292955], [43, 293315], [50, 294082], [54, 294184], [57, 294324], [61, 294564], [64, 294744], [72, 295224], [75, 295344], [78, 295464], [85, 295924], [88, 296144], [96, 296624], [99, 296704], [108, 297184]]}, {"verse": 35, "start": 298386, "end": 307010, "text": "Y habiendo dicho esto, tomando el pan, dio gracias a Dios en presencia de todos, y partiendo, comenzó a comer.", "words": [[0, 298386], [2, 298529], [11, 298869], [17, 299189], [23, 300049], [31, 300429], [34, 300569], [39, 301329], [43, 301689], [51, 302129], [53, 302449], [58, 302709], [61, 303129], [71, 303709], [74, 303909], [81, 304589], [83, 305009], [94, 306049], [102, 306449], [104, 306529]]}, {"verse": 36, "start": 307460, "end": 311216, "text": "Entonces todos teniendo ya mejor ánimo, comieron ellos también.", "words": [[0, 307460], [9, 308009], [15, 308249], [24, 308829], [27, 308989], [33, 309329], [40, 309849], [49, 310289], [55, 310549]]}, {"verse": 37, "start": 311666, "end": 316207, "text": "Y éramos todas las personas en la nave doscientas setenta y seis.", "words": [[0, 311666], [2, 311832], [9, 312112], [15, 312512], [19, 312812], [28, 313272], [31, 313532], [34, 313672], [39, 314193], [50, 314714], [58, 315234], [60, 315755]]}, {"verse": 38, "start": 316657, "end": 321693, "text": "Y satisfechos de comida, aliviaban la nave, echando el grano al mar.", "words": [[0, 316657], [2, 316801], [14, 317461], [17, 317601], [25, 318061], [35, 319101], [38, 319381], [44, 319701], [52, 320521], [55, 320791], [61, 321061], [64, 321201]]}, {"verse": 39, "start": 322143, "end": 332113, "text": "Y como se hizo de día, no conocían la tierra: pero veían una bahía que tenía playa, a la cual acordaron echar, si pudiesen, la nave.", "words": [[0, 322143], [2, 322251], [7, 322431], [10, 322611], [15, 322871], [18, 323051], [23, 323691], [26, 323891], [35, 324451], [38, 324631], [46, 325561], [51, 325763], [57, 326243], [61, 326523], [67, 326983], [71, 327123], [77, 327483], [84, 328083], [86, 328223], [89, 328283], [94, 328543], [104, 329403], [111, 330043], [114, 330583], [124, 331203], [127, 331583]]}, {"verse": 40, "start": 332563, "end": 343352, "text": "Cortando pues las anclas, las dejaron en el mar, largando también las ataduras de los timones; y alzada la vela mayor al viento, se iban a la orilla.", "words": [[0, 332563], [9, 333187], [14, 333807], [18, 334337], [26, 334867], [30, 335007], [38, 335527], [41, 335707], [44, 335847], [49, 336467], [58, 337087], [66, 337467], [70, 337747], [79, 338347], [82, 338487], [86, 338607], [95, 339691], [97, 339811], [104, 340311], [107, 340471], [112, 340771], [118, 341051], [121, 341251], [129, 341671], [132, 342231], [137, 342571], [139, 342671], [142, 342771]]}, {"verse": 41, "start": 343802, "end": 354070, "text": "Pero dando en un lugar de dos aguas, hicieron encallar la nave; y la proa, hincada, estaba sin moverse, y la popa se abría con la fuerza del mar.", "words": [[0, 343802], [5, 343945], [11, 344305], [14, 344505], [17, 344665], [23, 344965], [26, 345185], [30, 345405], [37, 346265], [46, 346805], [55, 347445], [58, 347565], [64, 348372], [66, 348498], [69, 348618], [75, 349058], [84, 349778], [91, 350378], [95, 350678], [104, 351258], [106, 351698], [109, 351838], [114, 352198], [117, 352338], [123, 352658], [127, 352858], [130, 352998], [137, 353318], [141, 353598]]}, {"verse": 42, "start": 354520, "end": 361217, "text": "Entonces el acuerdo de los soldados era que matasen los presos, porque ninguno se fugase nadando.", "words": [[0, 354520], [9, 355502], [12, 355662], [20, 356022], [23, 356262], [27, 356402], [36, 357022], [40, 357262], [44, 357442], [52, 358002], [56, 358202], [64, 358862], [71, 359362], [79, 359922], [82, 360082], [89, 360671]]}, {"verse": 43, "start": 361667, "end": 372084, "text": "Pero el centurión, queriendo salvar a Pablo, impidió este plan, y mandó que los que pudiesen nadar, se echasen los primeros, y saliesen a tierra;", "words": [[0, 361667], [5, 361852], [8, 362012], [19, 362592], [29, 363052], [36, 363452], [38, 363672], [45, 364132], [53, 365452], [58, 365712], [64, 366132], [66, 366712], [72, 367112], [76, 367232], [80, 367372], [84, 367512], [93, 368092], [100, 368792], [103, 369092], [111, 369552], [115, 369712], [125, 370592], [127, 370792], [136, 371272], [138, 371472]]}, {"verse": 44, "start": 372534, "end": 380439, "text": "Y los demás, parte en tablas, parte en cosas de la nave. Y así aconteció que todos se salvaron saliendo a tierra.", "words": [[0, 372534], [2, 372655], [6, 372795], [13, 373068], [19, 373342], [22, 373615], [30, 374168], [36, 374722], [39, 375275], [45, 375635], [48, 375915], [51, 376015], [57, 376832], [59, 376976], [63, 377196], [73, 377896], [77, 378056], [83, 378396], [86, 378756], [95, 379296], [104, 379776], [106, 379856]]}]}