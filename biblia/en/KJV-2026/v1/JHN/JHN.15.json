{"book": "JHN", "chapter": 15, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 185388, "verses": [{"verse": 1, "start": 300, "end": 3762, "text": "I am the true vine, and my Father is the vinedresser.", "words": [[0, 300], [2, 524], [5, 704], [9, 824], [14, 1104], [20, 1864], [24, 1964], [27, 2124], [34, 2504], [37, 2804], [41, 3304]]}, {"verse": 2, "start": 4212, "end": 12101, "text": "Every branch in me that bears not fruit he takes away: and every branch that bears fruit, he purges it, that it may bring forth more fruit.", "words": [[0, 4212], [6, 4454], [13, 4814], [16, 5034], [19, 5214], [24, 5414], [30, 5714], [34, 5954], [40, 6234], [43, 6414], [49, 6654], [55, 7454], [59, 7577], [65, 7817], [72, 8177], [77, 8417], [83, 8697], [90, 9077], [93, 9317], [100, 9737], [104, 10257], [109, 10477], [112, 10577], [116, 10697], [122, 10977], [128, 11297], [133, 11617]]}, {"verse": 3, "start": 12551, "end": 15404, "text": "Now you are clean through the word which I have spoken to you.", "words": [[0, 12551], [4, 12909], [8, 13149], [12, 13249], [18, 13529], [26, 13749], [30, 13869], [35, 14109], [41, 14329], [43, 14489], [48, 14569], [55, 14849], [58, 15109]]}, {"verse": 4, "start": 15854, "end": 26417, "text": "Abide in me, and I in you. As the branch cannot bear fruit of itself, unless it abide in the vine; no more can you, unless you abide in me.", "words": [[0, 15854], [6, 16342], [9, 16582], [13, 16822], [17, 17122], [19, 17522], [22, 17822], [27, 18599], [30, 18764], [34, 18904], [41, 19224], [48, 19564], [53, 19964], [59, 20264], [62, 20424], [70, 20904], [77, 21624], [80, 21864], [86, 22164], [89, 22384], [93, 22484], [99, 23365], [102, 23570], [107, 23850], [111, 24110], [116, 24430], [123, 25030], [127, 25310], [133, 25710], [136, 25990]]}, {"verse": 5, "start": 26867, "end": 35753, "text": "I am the vine, you are the branches: He that abides in me, and I in him, the same brings forth much fruit: for without me you can do nothing.", "words": [[0, 26867], [2, 27070], [5, 27210], [9, 27350], [15, 28110], [19, 28230], [23, 28370], [27, 28470], [37, 29491], [40, 29667], [45, 29867], [52, 30267], [55, 30407], [59, 30887], [63, 30987], [65, 31287], [68, 31487], [73, 32067], [77, 32187], [82, 32447], [89, 32727], [95, 33027], [100, 33307], [107, 34095], [111, 34198], [119, 34458], [122, 34718], [126, 34878], [130, 35038], [133, 35178]]}, {"verse": 6, "start": 36203, "end": 45443, "text": "If a man abide not in me, he is cast forth as a branch, and is withered; and men gather them, and cast them into the fire, and they are burned.", "words": [[0, 36203], [3, 36342], [5, 36462], [9, 36762], [15, 37082], [19, 37462], [22, 37742], [26, 38442], [29, 38582], [32, 38722], [37, 39042], [43, 39362], [46, 39602], [48, 39702], [56, 40062], [60, 40562], [63, 40702], [73, 41514], [77, 41694], [81, 41934], [88, 42274], [94, 42554], [98, 42934], [103, 43234], [108, 43494], [113, 43734], [117, 43894], [123, 44594], [127, 44654], [132, 44794], [136, 44914]]}, {"verse": 7, "start": 45893, "end": 52119, "text": "If you abide in me, and my words abide in you, you shall ask what you will, and it shall be done to you.", "words": [[0, 45893], [3, 46051], [7, 46191], [13, 46511], [16, 46771], [20, 47311], [24, 47451], [27, 47631], [33, 47951], [39, 48251], [42, 48511], [47, 49251], [51, 49371], [57, 49551], [61, 49871], [66, 50031], [70, 50231], [76, 50811], [80, 50971], [83, 51091], [89, 51251], [92, 51411], [97, 51631], [100, 51831]]}, {"verse": 8, "start": 52569, "end": 58212, "text": "Herein is my Father glorified, that you bear much fruit; so shall you be my disciples.", "words": [[0, 52569], [7, 53041], [10, 53261], [13, 53441], [20, 53681], [31, 54461], [36, 54901], [40, 55041], [45, 55281], [50, 55521], [57, 56408], [60, 56594], [66, 56814], [70, 57014], [73, 57174], [76, 57374]]}, {"verse": 9, "start": 58662, "end": 62990, "text": "As the Father has loved me, so have I loved you: continue in my love.", "words": [[0, 58662], [3, 58782], [7, 58902], [14, 59222], [18, 59482], [24, 59742], [28, 60262], [31, 60442], [36, 60622], [38, 60762], [44, 61002], [49, 61765], [58, 62089], [61, 62369], [64, 62509]]}, {"verse": 10, "start": 63440, "end": 71240, "text": "If you keep my commandments, you shall abide in my love; even as I have kept my Father’s commandments, and abide in his love.", "words": [[0, 63440], [3, 63562], [7, 63662], [12, 63842], [15, 64022], [29, 64862], [33, 65102], [39, 65302], [45, 65682], [48, 65862], [51, 66022], [57, 67472], [62, 67710], [65, 67910], [67, 68070], [72, 68170], [77, 68390], [80, 68590], [89, 69010], [103, 69450], [107, 70150], [113, 70430], [116, 70690], [120, 70830]]}, {"verse": 11, "start": 71690, "end": 76520, "text": "These things have I spoken to you, that my joy might remain in you, and that your joy might be full.", "words": [[0, 71690], [6, 71814], [13, 72134], [18, 72314], [20, 72414], [27, 72734], [30, 72994], [35, 73434], [40, 73534], [43, 73654], [47, 73914], [53, 74134], [60, 74394], [63, 74634], [68, 75014], [72, 75254], [77, 75374], [82, 75474], [86, 75754], [92, 75934], [95, 76094]]}, {"verse": 12, "start": 76970, "end": 80595, "text": "This is my commandment, That you love one another, as I have loved you.", "words": [[0, 76970], [5, 77161], [8, 77281], [11, 77441], [24, 78341], [29, 78501], [33, 78641], [38, 78881], [42, 79041], [51, 79581], [54, 79701], [56, 79901], [61, 80041], [67, 80221]]}, {"verse": 13, "start": 81045, "end": 85204, "text": "Greater love has no man than this, that a man lay down his life for his friends.", "words": [[0, 81045], [8, 81270], [13, 81530], [17, 81750], [20, 81970], [24, 82210], [29, 82390], [35, 82910], [40, 83130], [42, 83210], [46, 83430], [50, 83670], [55, 83890], [59, 84090], [64, 84350], [68, 84550], [72, 84670]]}, {"verse": 14, "start": 85654, "end": 88521, "text": "You are my friends, if you do whatever I command you.", "words": [[0, 85654], [4, 85796], [8, 85896], [11, 86056], [20, 86796], [23, 86956], [27, 87076], [30, 87236], [39, 87536], [41, 87816], [49, 88076]]}, {"verse": 15, "start": 88971, "end": 99862, "text": "From now on I call you not servants; for the servant knows not what his lord does: but I have called you friends; for all things that I have heard of my Father I have made known to you.", "words": [[0, 88971], [5, 89100], [9, 89360], [12, 89760], [14, 89760], [19, 89980], [23, 90120], [27, 90300], [37, 91375], [41, 91432], [45, 91552], [53, 91852], [59, 92132], [63, 92392], [68, 92572], [72, 92692], [77, 92912], [83, 93822], [87, 93928], [89, 94048], [94, 94188], [101, 94428], [105, 94588], [114, 95521], [118, 95662], [122, 95982], [129, 96442], [134, 96742], [136, 96902], [141, 97082], [147, 97342], [150, 97522], [153, 97702], [160, 98102], [162, 98622], [167, 98782], [172, 99022], [178, 99282], [181, 99542]]}, {"verse": 16, "start": 100312, "end": 112303, "text": "You have not chosen me, but I have chosen you, and ordained you, that you should go and bring forth fruit, and that your fruit should remain: that whatever you shall ask of the Father in my name, he may give it you.", "words": [[0, 100312], [4, 100462], [9, 100602], [13, 100782], [20, 101122], [24, 101862], [28, 102122], [30, 102322], [35, 102462], [42, 102822], [47, 103482], [51, 103582], [60, 104082], [65, 104722], [70, 104842], [74, 105042], [81, 105202], [84, 105462], [88, 105642], [94, 105862], [100, 106182], [107, 106922], [111, 107082], [116, 107222], [121, 107342], [127, 107682], [134, 107902], [142, 108839], [147, 108941], [156, 109241], [160, 109441], [166, 109621], [170, 109921], [173, 110041], [177, 110161], [184, 110481], [187, 110661], [190, 110881], [196, 111361], [199, 111441], [203, 111601], [208, 111821], [211, 111921]]}, {"verse": 17, "start": 112753, "end": 115770, "text": "These things I command you, that you love one another.", "words": [[0, 112753], [6, 112936], [13, 113276], [15, 113496], [23, 113816], [28, 114436], [33, 114616], [37, 114776], [42, 115056], [46, 115256]]}, {"verse": 18, "start": 116220, "end": 119648, "text": "If the world hate you, you know that it hated me before it hated you.", "words": [[0, 116220], [3, 116319], [7, 116459], [13, 116679], [18, 116939], [23, 117539], [27, 117659], [32, 117839], [37, 117999], [40, 118079], [46, 118319], [49, 118559], [56, 118839], [59, 119059], [65, 119279]]}, {"verse": 19, "start": 120098, "end": 128727, "text": "If you were of the world, the world would love his own: but because you are not of the world, but I have chosen you out of the world, therefore the world hates you.", "words": [[0, 120098], [3, 120236], [7, 120396], [12, 120536], [15, 120636], [19, 120756], [26, 121376], [30, 121496], [36, 121756], [42, 121896], [47, 122076], [51, 122256], [56, 122974], [60, 123070], [68, 123370], [72, 123630], [76, 123730], [80, 123910], [83, 124070], [87, 124190], [94, 124830], [98, 125010], [100, 125170], [105, 125290], [112, 125630], [116, 125870], [120, 126130], [123, 126250], [127, 126370], [134, 127030], [144, 127390], [148, 127710], [154, 127990], [160, 128270]]}, {"verse": 20, "start": 129177, "end": 140398, "text": "Remember the word that I said to you, The servant is not greater than his lord. If they have persecuted me, they will also persecute you; if they have kept my saying, they will keep yours also.", "words": [[0, 129177], [9, 129421], [13, 129661], [18, 129921], [23, 130121], [25, 130281], [30, 130521], [33, 130741], [38, 131261], [42, 131381], [50, 131721], [53, 131961], [57, 132161], [65, 132521], [70, 132801], [74, 132981], [80, 133806], [83, 133910], [88, 134090], [93, 134190], [104, 134570], [108, 135330], [113, 135470], [118, 135610], [123, 135870], [133, 136570], [138, 137190], [141, 137310], [146, 137490], [151, 137630], [156, 137830], [159, 138030], [167, 138690], [172, 139050], [177, 139190], [182, 139410], [188, 139710]]}, {"verse": 21, "start": 140848, "end": 145846, "text": "But all these things will they do to you for my name’s sake, because they know not him that sent me.", "words": [[0, 140848], [4, 140946], [8, 141146], [14, 141326], [21, 141706], [26, 141986], [31, 142126], [34, 142326], [37, 142486], [41, 142686], [45, 142846], [48, 143006], [55, 143386], [61, 143786], [69, 144126], [74, 144346], [79, 144566], [83, 144806], [87, 145046], [92, 145286], [97, 145526]]}, {"verse": 22, "start": 146296, "end": 152367, "text": "If I had not come and spoken to them, they had not had sin: but now they have no cloak for their sin.", "words": [[0, 146296], [3, 146436], [5, 146596], [9, 146756], [13, 146916], [18, 147196], [22, 147356], [29, 147676], [32, 147936], [38, 148536], [43, 148716], [47, 148876], [51, 149076], [55, 149296], [60, 150173], [64, 150275], [68, 150555], [73, 150775], [78, 150995], [81, 151175], [87, 151475], [91, 151715], [97, 151875]]}, {"verse": 23, "start": 152817, "end": 155437, "text": "He that hates me hates my Father also.", "words": [[0, 152817], [3, 152998], [8, 153318], [14, 153598], [17, 154038], [23, 154258], [26, 154458], [33, 154758]]}, {"verse": 24, "start": 155887, "end": 164588, "text": "If I had not done among them the works which none other man did, they had not had sin: but now have they both seen and hated both me and my Father.", "words": [[0, 155887], [3, 156005], [5, 156185], [9, 156345], [13, 156525], [18, 156825], [24, 157085], [29, 157405], [33, 157605], [39, 157905], [45, 158205], [50, 158485], [56, 158725], [60, 158985], [65, 159725], [70, 159865], [74, 160025], [78, 160205], [82, 160405], [87, 161249], [91, 161349], [95, 161569], [100, 161769], [105, 161909], [110, 162129], [115, 162489], [119, 162789], [125, 163069], [130, 163329], [133, 163649], [137, 163909], [140, 164089]]}, {"verse": 25, "start": 165038, "end": 171379, "text": "But this comes to pass, that the word might be fulfilled that is written in their law, They hated me without a cause.", "words": [[0, 165038], [4, 165139], [9, 165339], [15, 165599], [18, 165799], [24, 166439], [29, 166879], [33, 166999], [38, 167239], [44, 167439], [47, 167599], [57, 168039], [62, 168359], [65, 168519], [73, 168739], [76, 168919], [82, 169079], [87, 169779], [92, 169939], [98, 170239], [101, 170439], [109, 170719], [111, 170839]]}, {"verse": 26, "start": 171829, "end": 179941, "text": "But when the Comforter is come, whom I will send to you from the Father, even the Spirit of truth, which proceeds from the Father, he shall testify of me:", "words": [[0, 171829], [4, 171954], [9, 172154], [13, 172294], [23, 172794], [26, 172914], [32, 173554], [37, 173754], [39, 173974], [44, 174094], [49, 174354], [52, 174514], [56, 174654], [61, 174854], [65, 174974], [73, 175674], [78, 175874], [82, 176094], [89, 176314], [92, 176474], [99, 177034], [105, 177214], [114, 177574], [119, 177834], [123, 177974], [131, 178654], [134, 178754], [140, 178934], [148, 179314], [151, 179654]]}, {"verse": 27, "start": 180391, "end": 184988, "text": "And you also shall bear witness, because you have been with me from the beginning.", "words": [[0, 180391], [4, 180528], [8, 180668], [13, 181048], [19, 181388], [24, 181648], [33, 182388], [41, 182928], [45, 183188], [50, 183348], [55, 183588], [60, 183768], [63, 184008], [68, 184248], [72, 184388]]}]}