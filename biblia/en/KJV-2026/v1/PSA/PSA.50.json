{"book": "PSA", "chapter": 50, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 134680, "verses": [{"verse": 1, "start": 300, "end": 6370, "text": "The mighty God, even the LORD, has spoken, and called the earth from the rising of the sun to the going down of it.", "words": [[0, 300], [4, 403], [11, 603], [16, 1063], [21, 1283], [25, 1483], [31, 1963], [35, 2043], [43, 2443], [47, 3103], [54, 3363], [58, 3563], [64, 3743], [69, 3983], [73, 4123], [80, 4443], [83, 4663], [87, 4803], [91, 5083], [94, 5283], [98, 5423], [104, 5643], [109, 5943], [112, 6163]]}, {"verse": 2, "start": 6820, "end": 9828, "text": "Out of Zion, the perfection of beauty, God has shined.", "words": [[0, 6820], [4, 6962], [7, 7082], [13, 7542], [17, 7582], [28, 7902], [31, 8242], [39, 8522], [43, 8902], [47, 9162]]}, {"verse": 3, "start": 10278, "end": 18424, "text": "Our God shall come, and shall not keep silence: a fire shall devour before him, and it shall be very tempestuous round about him.", "words": [[0, 10278], [4, 10402], [8, 10702], [14, 10942], [20, 11682], [24, 11742], [30, 11942], [34, 12162], [39, 12422], [48, 13557], [50, 13664], [55, 13984], [61, 14244], [68, 14764], [75, 15084], [80, 15844], [84, 15984], [87, 16104], [93, 16264], [96, 16424], [101, 16704], [113, 17444], [119, 17744], [125, 18044]]}, {"verse": 4, "start": 18874, "end": 23755, "text": "He shall call to the heavens from above, and to the earth, that he may judge his people.", "words": [[0, 18874], [3, 18981], [9, 19181], [14, 19461], [17, 19681], [21, 19821], [29, 20141], [34, 20441], [41, 20881], [45, 21501], [48, 21661], [52, 21781], [59, 22101], [64, 22401], [67, 22521], [71, 22661], [77, 22981], [81, 23181]]}, {"verse": 5, "start": 24055, "end": 29736, "text": "Gather my saints together to me; those that have made a covenant with me by sacrifice.", "words": [[0, 24055], [7, 24314], [10, 24574], [17, 24894], [26, 25394], [29, 25614], [33, 26516], [39, 26775], [44, 27035], [49, 