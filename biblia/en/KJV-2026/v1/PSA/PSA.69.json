{"book": "PSA", "chapter": 69, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 222793, "verses": [{"verse": 1, "start": 300, "end": 3970, "text": "Save me, O God; for the waters are come in to my soul.", "words": [[0, 300], [5, 500], [9, 880], [11, 960], [16, 1868], [20, 1976], [24, 2116], [31, 2476], [35, 2696], [40, 2862], [43, 3028], [46, 3196], [49, 3416]]}, {"verse": 2, "start": 4420, "end": 11218, "text": "I sink in deep mire, where there is no standing: I am come into deep waters, where the floods overflow me.", "words": [[0, 4420], [2, 4561], [7, 4881], [10, 5101], [15, 5341], [21, 5841], [27, 6241], [33, 6441], [36, 6601], [39, 6781], [49, 7806], [51, 7936], [54, 8056], [59, 8276], [64, 8496], [69, 8796], [77, 9276], [83, 9736], [87, 9896], [94, 10256], [103, 10696]]}, {"verse": 3, "start": 11668, "end": 18042, "text": "I am weary of my crying: my throat is dried: my eyes fail while I wait for my God.", "words": [[0, 11668], [2, 11868], [5, 11988], [11, 12308], [14, 12548], [17, 12708], [25, 13684], [28, 14024], [35, 14264], [38, 14484], [45, 15447], [48, 15728], [53, 15988], [58, 16408], [64, 16688], [66, 16868], [71, 17068], [75, 17268], [78, 17448]]}, {"verse": 4, "start": 18492, "end": 28406, "text": "They that hate me without a cause are more than the hairs of my head: they that would destroy me, being my enemies wrongfully, are mighty: then I restored that which I took not away.", "words": [[0, 18492], [5, 18619], [10, 18819], [15, 19099], [18, 19339], [26, 19619], [28, 19759], [34, 20119], [38, 20339], [43, 20559], [48, 20759], [52, 20879], [58, 21099], [61, 21299], [64, 21479], [70, 22277], [75, 22371], [80, 22551], [86, 22711], [94, 23191], [98, 23631], [104, 23791], [107, 24031], [115, 24311], [127, 25171], [131, 25251], [139, 26049], [144, 26177], [146, 26317], [155, 26717], [160, 27017], [166, 27237], [168, 27377], [173, 27577], [177, 27797]]}, {"verse": 5, "start": 28856, "end": 33237, "text": "O God, you know my foolishness; and my sins are not hid from you.", "words": [[0, 28911], [2, 29001], [7, 29501], [11, 29501], [16, 29701], [19, 29881], [32, 31136], [36, 31396], [39, 31576], [44, 31956], [48, 32216], [52, 32396], [56, 32656], [61, 32956]]}, {"verse": 6, "start": 33687, "end": 43691, "text": "Let not them that wait on you, O Lord GOD of hosts, be ashamed for my sake: let not those that seek you be confounded for my sake, O God of Israel.", "words": [[0, 33687], [4, 33834], [8, 34074], [13, 34394], [18, 34674], [23, 34894], [26, 35134], [31, 35474], [33, 35634], [38, 35894], [42, 36234], [45, 36414], [52, 37234], [55, 37414], [63, 37834], [67, 38114], [70, 38334], [76, 39178], [80, 39308], [84, 39528], [90, 39828], [95, 40108], [100, 40348], [104, 40568], [107, 40728], [118, 41408], [122, 41608], [125, 41808], [131, 42548], [133, 42628], [137, 42908], [140, 43068]]}, {"verse": 7, "start": 44141, "end": 48799, "text": "Because for your sake I have borne reproach; shame has covered my face.", "words": [[0, 44220], [8, 44300], [12, 44480], [17, 44700], [22, 45080], [24, 45320], [29, 45500], [35, 45920], [45, 46992], [51, 47294], [55, 47534], [63, 47874], [66, 48134]]}, {"verse": 8, "start": 49249, "end": 54172, "text": "I am become a stranger to my brethren, and an alien to my mother’s children.", "words": [[0, 49249], [2, 49453], [5, 49593], [12, 49873], [14, 50053], [23, 50473], [26, 50753], [29, 50933], [39, 51373], [43, 52033], [46, 52193], [52, 52553], [55, 52873], [58, 53053], [67, 53493]]}, {"verse": 9, "start": 54622, "end": 60650, "text": "For the zeal of your house has eaten me up; and the reproaches of them that reproached you are fallen upon me.", "words": [[0, 54622], [4, 54708], [8, 54828], [13, 55228], [16, 55348], [21, 55468], [27, 55848], [31, 56048], [37, 56228], [40, 56488], [44, 57065], [48, 57193], [52, 57313], [63, 57853], [66, 58093], [71, 58273], [76, 58453], [87, 59053], [91, 59253], [95, 59493], [102, 59833], [107, 60113]]}, {"verse": 10, "start": 61100, "end": 65900, "text": "When I wept, and chastened my soul with fasting, that was to my reproach.", "words": [[0, 61100], [5, 61227], [7, 61367], [13, 61747], [17, 61927], [27, 62427], [30, 62627], [35, 62947], [40, 63167], [49, 64387], [54, 64647], [58, 64867], [61, 65007], [64, 65167]]}, {"verse": 11, "start": 66350, "end": 70553, "text": "I made sackcloth also my garment; and I became a proverb to them.", "words": [[0, 66350], [2, 66474], [7, 66654], [17, 67414], [22, 67734], [25, 67954], [34, 68875], [38, 69013], [40, 69113], [47, 69373], [49, 69573], [57, 69913], [60, 70213]]}, {"verse": 12, "start": 71003, "end": 75267, "text": "They that sit in the gate speak against me; and I was the song of the drunkards.", "words": [[0, 71003], [5, 71119], [10, 71279], [14, 71519], [17, 71679], [21, 71799], [26, 71979], [32, 72279], [40, 72619], [44, 73420], [48, 73563], [50, 73743], [54, 73903], [58, 74043], [63, 74323], [66, 74483], [70, 74583]]}, {"verse": 13, "start": 75717, "end": 85104, "text": "But as for me, my prayer is to you, O LORD, in an acceptable time: O God, in the multitude of your mercy hear me, in the truth of your salvation.", "words": [[0, 75717], [4, 75842], [7, 76022], [11, 76202], [15, 76842], [18, 77002], [25, 77322], [28, 77562], [31, 77742], [36, 78102], [38, 78222], [44, 78782], [47, 78902], [50, 79022], [61, 79482], [67, 80545], [69, 80695], [74, 81215], [77, 81275], [81, 81355], [91, 81715], [94, 82035], [99, 82155], [105, 82515], [110, 82875], [114, 83415], [117, 83535], [121, 83635], [127, 83935], [130, 84155], [135, 84255]]}, {"verse": 14, "start": 85554, "end": 92417, "text": "Deliver me out of the mire, and let me not sink: let me be delivered from them that hate me, and out of the deep waters.", "words": [[0, 85554], [8, 85875], [11, 86035], [15, 86235], [18, 86315], [22, 86435], [28, 86895], [32, 87135], [36, 87295], [39, 87455], [43, 87675], [49, 88597], [53, 88727], [56, 88887], [59, 89027], [69, 89407], [74, 89707], [79, 89907], [84, 90107], [89, 90327], [93, 90607], [97, 91087], [101, 91327], [104, 91447], [108, 91547], [113, 91747]]}, {"verse": 15, "start": 92867, "end": 99824, "text": "Let not the waterflood overflow me, neither let the deep swallow me up, and let not the pit shut her mouth upon me.", "words": [[0, 92867], [4, 93034], [8, 93334], [12, 93754], [23, 94174], [32, 94554], [36, 95414], [44, 95614], [48, 95894], [52, 96034], [57, 96234], [65, 96534], [68, 96894], [72, 97334], [76, 97614], [80, 97794], [84, 98054], [88, 98234], [92, 98434], [97, 98714], [101, 98854], [107, 99114], [112, 99394]]}, {"verse": 16, "start": 100274, "end": 107494, "text": "Hear me, O LORD; for your lovingkindness is good: turn to me according to the multitude of your tender mercies.", "words": [[0, 100274], [5, 100485], [9, 100765], [11, 100945], [17, 101745], [21, 102045], [26, 102605], [41, 103165], [44, 103325], [50, 104123], [55, 104323], [58, 104523], [61, 104703], [71, 105103], [74, 105363], [78, 105483], [88, 105963], [91, 106263], [96, 106403], [103, 106683]]}, {"verse": 17, "start": 107944, "end": 113149, "text": "And hide not your face from your servant; for I am in trouble: hear me speedily.", "words": [[0, 107944], [4, 108091], [9, 108351], [13, 108631], [18, 108831], [23, 109151], [28, 109391], [33, 109551], [42, 110495], [46, 110623], [48, 110923], [51, 111063], [54, 111183], [63, 112053], [68, 112216], [71, 112396]]}, {"verse": 18, "start": 113599, "end": 117688, "text": "Draw near to my soul, and redeem it: deliver me because of my enemies.", "words": [[0, 113599], [5, 113759], [10, 113979], [13, 114159], [16, 114319], [22, 114699], [26, 114939], [33, 115259], [37, 115882], [45, 116223], [48, 116383], [56, 116663], [59, 116863], [62, 117023]]}, {"verse": 19, "start": 118138, "end": 124362, "text": "You have known my reproach, and my shame, and my dishonour: my adversaries are all before you.", "words": [[0, 118138], [4, 118266], [9, 118426], [15, 118606], [18, 118846], [28, 119686], [32, 119726], [35, 119906], [42, 120566], [46, 120586], [49, 121016], [60, 121698], [63, 121978], [75, 122718], [79, 122898], [83, 123078], [90, 123378]]}, {"verse": 20, "start": 124812, "end": 134182, "text": "Reproach has broken my heart; and I am full of heaviness: and I looked for some to take pity, but there was none; and for comforters, but I found none.", "words": [[0, 124812], [9, 125322], [13, 125442], [20, 125742], [23, 126042], [30, 126825], [34, 126946], [36, 127106], [39, 127226], [44, 127486], [47, 127646], [58, 128708], [62, 129028], [64, 129148], [71, 129348], [75, 129528], [80, 129768], [83, 129948], [88, 130168], [94, 130628], [98, 130708], [104, 130908], [108, 131148], [114, 131950], [118, 132110], [122, 132270], [134, 133170], [138, 133330], [140, 133490], [146, 133750]]}, {"verse": 21, "start": 134632, "end": 139269, "text": "They gave me also gall for my food; and in my thirst they gave me vinegar to drink.", "words": [[0, 134632], [5, 134729], [10, 134928], [13, 135128], [18, 135349], [23, 135729], [27, 135949], [30, 136148], [36, 136978], [40, 137101], [43, 137221], [46, 137401], [53, 137841], [58, 137981], [63, 138141], [66, 138301], [74, 138601], [77, 138821]]}, {"verse": 22, "start": 139719, "end": 146056, "text": "Let their table become a snare before them: and that which should have been for their welfare, let it become a trap.", "words": [[0, 139719], [4, 139846], [10, 139986], [16, 140286], [23, 140586], [25, 140786], [31, 141046], [38, 141386], [44, 142143], [48, 142288], [53, 142528], [59, 142768], [66, 143028], [71, 143168], [76, 143388], [80, 143568], [86, 143728], [95, 144688], [99, 144968], [102, 145088], [109, 145348], [111, 145548]]}, {"verse": 23, "start": 146506, "end": 151963, "text": "Let their eyes be darkened, that they see not; and make their loins continually to shake.", "words": [[0, 146506], [4, 146632], [10, 146832], [15, 147132], [18, 147372], [28, 147972], [33, 148252], [38, 148412], [42, 148632], [47, 149461], [51, 149607], [56, 149807], [62, 150027], [68, 150467], [80, 151167], [83, 151447]]}, {"verse": 24, "start": 152413, "end": 157355, "text": "Pour out your indignation upon them, and let your wrathful anger take hold of them.", "words": [[0, 152413], [5, 152581], [9, 152841], [14, 153001], [26, 153741], [31, 154021], [37, 154741], [41, 154941], [45, 155121], [50, 155301], [59, 155861], [65, 156221], [70, 156541], [75, 156821], [78, 157021]]}, {"verse": 25, "start": 157805, "end": 162263, "text": "Let their habitation be desolate; and let none dwell in their tents.", "words": [[0, 157805], [4, 157952], [10, 158172], [21, 158772], [24, 159032], [34, 160052], [38, 160352], [42, 160532], [47, 160792], [53, 161172], [56, 161472], [62, 161612]]}, {"verse": 26, "start": 162713, "end": 168038, "text": "For they persecute him whom you have struck; and they talk to the grief of those whom you have wounded.", "words": [[0, 162713], [4, 162813], [9, 162993], [19, 163753], [23, 163893], [28, 164113], [32, 164333], [37, 164513], [45, 165372], [49, 165514], [54, 165634], [59, 165874], [62, 166074], [66, 166194], [72, 166434], [75, 166654], [81, 166894], [86, 167134], [90, 167314], [95, 167494]]}, {"verse": 27, "start": 168488, "end": 172845, "text": "Add iniquity to their iniquity: and let them not come into your righteousness.", "words": [[0, 168488], [4, 168713], [13, 169233], [16, 169413], [22, 169593], [32, 170541], [36, 170669], [40, 170829], [45, 171029], [49, 171229], [54, 171509], [59, 171769], [64, 171969]]}, {"verse": 28, "start": 173295, "end": 177677, "text": "Let them be blotted out of the book of the living, and not be written with the righteous.", "words": [[0, 173295], [4, 173422], [9, 173622], [12, 173802], [20, 174242], [24, 174482], [27, 174602], [31, 174722], [36, 174922], [39, 175062], [43, 175202], [51, 175442], [55, 176002], [59, 176202], [62, 176402], [70, 176702], [75, 176862], [79, 177022]]}, {"verse": 29, "start": 178127, "end": 183533, "text": "But I am poor and sorrowful: let your salvation, O God, set me up on high.", "words": [[0, 178127], [4, 178243], [6, 178443], [9, 178603], [14, 178923], [18, 179203], [29, 180262], [33, 180388], [38, 180568], [49, 181328], [51, 181608], [56, 182288], [60, 182468], [63, 182648], [66, 182868], [69, 183028]]}, {"verse": 30, "start": 183983, "end": 189217, "text": "I will praise the name of God with a song, and will magnify him with thanksgiving.", "words": [[0, 183983], [2, 184148], [7, 184288], [14, 184668], [18, 184928], [23, 185188], [26, 185388], [30, 185748], [35, 185988], [37, 186108], [43, 186968], [47, 187068], [52, 187208], [60, 187868], [64, 188148], [69, 188368]]}, {"verse": 31, "start": 189667, "end": 195692, "text": "This also shall please the LORD better than an ox or bullock that has horns and hoofs.", "words": [[0, 189667], [5, 189832], [10, 190212], [16, 190492], [23, 190812], [27, 191092], [32, 191352], [39, 191712], [44, 191972], [47, 192092], [50, 192432], [53, 192592], [61, 193032], [66, 193232], [70, 193452], [76, 193812], [80, 194052]]}, {"verse": 32, "start": 196142, "end": 200703, "text": "The humble shall see this, and be glad: and your heart shall live that seek God.", "words": [[0, 196142], [4, 196256], [11, 196496], [17, 196816], [21, 197096], [27, 197316], [31, 197556], [34, 197716], [40, 198572], [44, 198719], [49, 198839], [55, 199079], [61, 199359], [66, 199619], [71, 199939], [76, 200259]]}, {"verse": 33, "start": 201153, "end": 204554, "text": "For the LORD hears the poor, and despises not his prisoners.", "words": [[0, 201153], [4, 201241], [8, 201361], [13, 201621], [19, 201901], [23, 202181], [29, 202501], [33, 202761], [42, 203361], [46, 203601], [50, 203781]]}, {"verse": 34, "start": 205004, "end": 208894, "text": "Let the heaven and earth praise him, the seas, and every thing that moves in it.", "words": [[0, 205004], [4, 205149], [8, 205309], [15, 205589], [19, 205789], [25, 206029], [32, 206369], [37, 206949], [41, 206989], [47, 207549], [51, 207656], [57, 207762], [63, 207869], [68, 208209], [74, 208429], [77, 208689]]}, {"verse": 35, "start": 209344, "end": 216093, "text": "For God will save Zion, and will build the cities of Judah: that they may dwell there, and have it in possession.", "words": [[0, 209344], [4, 209447], [8, 209687], [13, 209907], [18, 210187], [24, 210547], [28, 211067], [33, 211207], [39, 211507], [43, 211687], [50, 211967], [53, 212167], [60, 212912], [65, 213049], [70, 213209], [74, 213449], [80, 213789], [87, 214229], [91, 214769], [96, 215029], [99, 215169], [102, 215309]]}, {"verse": 36, "start": 216543, "end": 222393, "text": "The seed also of his servants shall inherit it: and they that love his name shall dwell in it.", "words": [[0, 216543], [4, 216650], [9, 216930], [14, 217310], [17, 217630], [21, 217770], [30, 218150], [36, 218490], [44, 218890], [48, 219763], [52, 219911], [57, 220131], [62, 220411], [67, 220671], [71, 220911], [76, 221191], [82, 221491], [88, 221791], [91, 222071]]}]}