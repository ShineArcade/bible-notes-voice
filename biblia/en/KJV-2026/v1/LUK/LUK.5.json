{"book": "LUK", "chapter": 5, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 299384, "verses": [{"verse": 1, "start": 300, "end": 7844, "text": "And it came to pass, that, as the people pressed upon him to hear the word of God, he stood by the lake of Gennesaret,", "words": [[0, 300], [4, 432], [7, 532], [12, 772], [15, 992], [21, 1332], [27, 2212], [30, 2512], [34, 2652], [41, 2932], [49, 3272], [54, 3632], [58, 3892], [61, 4052], [66, 4232], [70, 4392], [75, 4632], [78, 4772], [83, 5792], [86, 5932], [92, 6172], [95, 6452], [99, 6612], [104, 6832], [107, 7343]]}, {"verse": 2, "start": 8194, "end": 14289, "text": "And saw two ships standing by the lake: but the fishermen were gone out of them, and were washing their nets.", "words": [[0, 8194], [4, 8338], [8, 8618], [12, 8878], [18, 9278], [27, 9858], [30, 10198], [34, 10338], [40, 11037], [44, 11160], [48, 11300], [58, 11620], [63, 11960], [68, 12160], [72, 12440], [75, 12580], [81, 12760], [85, 13000], [90, 13140], [98, 13480], [104, 13740]]}, {"verse": 3, "start": 14639, "end": 23150, "text": "And he entered into one of the ships, which was Simon’s, and prayed him that he would thrust out a little from the land. And he sat down, and taught the people out of the ship.", "words": [[0, 14639], [4, 14778], [7, 14878], [15, 15158], [20, 15478], [24, 15638], [27, 15738], [31, 15858], [38, 16418], [44, 16578], [48, 16778], [57, 17518], [61, 17758], [68, 17998], [72, 18198], [77, 18358], [80, 18478], [86, 18598], [93, 18878], [97, 19158], [99, 19278], [106, 19438], [111, 19658], [115, 19818], [121, 20537], [125, 20672], [128, 20772], [132, 20992], [138, 21372], [142, 21732], [149, 21932], [153, 22092], [160, 22352], [164, 22572], [167, 22672], [171, 22772]]}, {"verse": 4, "start": 23501, "end": 30167, "text": "Now when he had left speaking, he said to Simon, Launch out into the deep, and let down your nets for a draught.", "words": [[0, 23501], [4, 23726], [9, 23906], [12, 24026], [16, 24146], [21, 24286], [31, 24986], [34, 25066], [39, 25266], [42, 25446], [49, 26166], [56, 26429], [60, 26749], [65, 27049], [69, 27229], [75, 28009], [79, 28209], [83, 28409], [88, 28689], [93, 28889], [98, 29169], [102, 29489], [104, 29854]]}, {"verse": 5, "start": 30447, "end": 38298, "text": "And Simon answering said to him, Master, we have toiled all the night, and have taken nothing: nevertheless at your word I will let down the net.", "words": [[0, 30447], [4, 30570], [10, 30930], [20, 31510], [25, 31690], [28, 31910], [33, 32435], [41, 32733], [44, 32933], [49, 33033], [56, 33453], [60, 33753], [64, 33913], [71, 34213], [75, 34573], [80, 34693], [86, 34953], [95, 35741], [108, 36345], [111, 36425], [116, 36545], [121, 37005], [123, 37105], [128, 37265], [132, 37445], [137, 37745], [141, 37885]]}, {"verse": 6, "start": 38578, "end": 43947, "text": "And when they had this done, they inclosed a great multitude of fishes: and their net broke.", "words": [[0, 38578], [4, 38710], [9, 38850], [14, 39030], [18, 39230], [23, 39410], [29, 40150], [34, 40430], [43, 40710], [45, 40950], [51, 41190], [61, 41750], [64, 41970], [72, 42860], [76, 43002], [82, 43122], [86, 43342]]}, {"verse": 7, "start": 44297, "end": 52817, "text": "And they beckoned to their partners, which were in the other ship, that they should come and help them. And they came, and filled both the ships, so that they began to sink.", "words": [[0, 44297], [4, 44445], [9, 44545], [18, 44945], [21, 45125], [27, 45265], [37, 46025], [43, 46285], [48, 46505], [51, 46645], [55, 46765], [61, 46945], [67, 47505], [72, 47745], [77, 47905], [84, 48085], [89, 48325], [93, 48505], [98, 48665], [104, 49307], [108, 49446], [113, 49566], [119, 49826], [123, 50006], [130, 50226], [135, 50546], [139, 50826], [146, 51086], [149, 51546], [154, 51706], [159, 51826], [165, 52146], [168, 52306]]}, {"verse": 8, "start": 53167, "end": 60115, "text": "When Simon Peter saw it, he fell down at Jesus’ knees, saying, Depart from me; for I am a sinful man, O Lord.", "words": [[0, 53167], [5, 53294], [11, 53594], [17, 53914], [21, 54374], [25, 54634], [28, 54674], [33, 54934], [38, 55214], [41, 55334], [48, 55814], [55, 56294], [63, 56923], [70, 57320], [75, 57520], [79, 58094], [83, 58213], [85, 58533], [88, 58673], [90, 58773], [97, 59053], [102, 59573], [104, 59673]]}, {"verse": 9, "start": 60395, "end": 66037, "text": "For he was astonished, and all that were with him, at the draught of the fishes which they had taken:", "words": [[0, 60395], [4, 60541], [7, 60721], [11, 60921], [23, 61941], [27, 62141], [31, 62341], [36, 62561], [41, 62741], [46, 63021], [51, 63221], [54, 63701], [58, 63951], [66, 64201], [69, 64401], [73, 64541], [80, 64841], [86, 65141], [91, 65321], [95, 65481]]}, {"verse": 10, "start": 66387, "end": 77607, "text": "And so was also James, and John, the sons of Zebedee, which were partners with Simon. And Jesus said to Simon, Fear not; from now on you shall catch men.", "words": [[0, 66387], [4, 66521], [7, 66741], [11, 66961], [16, 67321], [23, 67821], [27, 68401], [33, 69221], [37, 69281], [42, 69521], [45, 69701], [54, 70561], [60, 70761], [65, 70941], [74, 71341], [79, 71661], [86, 72545], [90, 72870], [96, 73190], [101, 73530], [104, 73690], [111, 74538], [116, 74806], [121, 75587], [126, 75907], [130, 76187], [133, 76607], [137, 76667], [143, 76867], [149, 77187]]}, {"verse": 11, "start": 77887, "end": 82063, "text": "And when they had brought their ships to land, they forsook all, and followed him.", "words": [[0, 77887], [4, 78012], [9, 78172], [14, 78352], [18, 78472], [26, 78692], [32, 78932], [38, 79192], [41, 79412], [47, 79892], [52, 79952], [60, 80572], [65, 80852], [69, 81232], [78, 81592]]}, {"verse": 12, "start": 82413, "end": 92943, "text": "¶ And it came to pass, when he was in a certain city, behold a man full of leprosy: who seeing Jesus fell on his face, and besought him, saying, Lord, if you will, you can make me clean.", "words": [[2, 82413], [6, 82534], [9, 82634], [14, 82874], [17, 83054], [23, 83414], [28, 83694], [31, 83834], [35, 84014], [38, 84134], [40, 84254], [48, 84454], [54, 85234], [61, 85434], [63, 85694], [67, 85914], [72, 86134], [75, 86314], [84, 87217], [88, 87350], [95, 87670], [101, 88030], [106, 88390], [109, 88570], [113, 88730], [119, 89050], [123, 89310], [132, 89710], [137, 90090], [145, 90838], [151, 91079], [154, 91279], [158, 91399], [164, 91939], [168, 92019], [172, 92199], [177, 92379], [180, 92519]]}, {"verse": 13, "start": 93223, "end": 100531, "text": "And he put forth his hand, and touched him, saying, I will: be clean. And immediately the leprosy departed from him.", "words": [[0, 93223], [4, 93350], [7, 93450], [11, 93650], [17, 93970], [21, 94170], [27, 94530], [31, 94970], [39, 95290], [44, 95670], [52, 96383], [54, 96585], [60, 97272], [63, 97361], [70, 98215], [74, 98341], [86, 98661], [90, 99081], [98, 99561], [107, 99921], [112, 100201]]}, {"verse": 14, "start": 100811, "end": 110279, "text": "And he charged him to tell no man: but go, and show yourself to the priest, and offer for your cleansing, according as Moses commanded, for a testimony to them.", "words": [[0, 100811], [4, 100944], [7, 101064], [15, 101344], [19, 101703], [22, 102227], [27, 102406], [30, 102606], [35, 103324], [39, 103482], [43, 103822], [47, 104067], [52, 104287], [61, 104667], [64, 104847], [68, 104947], [76, 105287], [80, 105847], [86, 106147], [90, 106347], [95, 106447], [106, 106907], [116, 107407], [119, 107687], [125, 107967], [136, 108527], [140, 109067], [142, 109227], [152, 109567], [155, 109887]]}, {"verse": 15, "start": 110559, "end": 119552, "text": "But so much the more went there a fame abroad of him: and great multitudes came together to hear, and to be healed by him of their infirmities.", "words": [[0, 110559], [4, 110741], [7, 111021], [12, 111301], [16, 111481], [21, 111801], [26, 112141], [32, 112361], [34, 112581], [39, 112921], [46, 113381], [49, 113641], [54, 114254], [58, 114396], [64, 114656], [75, 115396], [80, 115656], [89, 116116], [92, 116336], [98, 116696], [102, 117011], [105, 117171], [108, 117311], [115, 117651], [118, 117951], [122, 118191], [125, 118411], [131, 118591]]}, {"verse": 16, "start": 119902, "end": 122936, "text": "¶ And he withdrew himself into the wilderness, and prayed.", "words": [[2, 119902], [6, 120033], [9, 120153], [18, 120593], [26, 121013], [31, 121353], [35, 121513], [47, 121953], [51, 122313]]}, {"verse": 17, "start": 123286, "end": 136785, "text": "And it came to pass on a certain day, as he was teaching, that there were Pharisees and doctors of the law sitting by, which were come out of every town of Galilee, and Judæa, and Jerusalem: and the power of the Lord was present to heal them.", "words": [[0, 123286], [4, 123408], [7, 123508], [12, 123728], [15, 123908], [20, 124148], [23, 124428], [25, 124528], [33, 124788], [38, 125168], [41, 125468], [44, 125608], [48, 125768], [58, 126128], [63, 126453], [69, 126613], [74, 126773], [84, 127493], [88, 127613], [96, 127953], [99, 128293], [103, 128393], [107, 128693], [115, 129013], [119, 129879], [125, 130026], [130, 130166], [135, 130366], [139, 130546], [142, 130666], [148, 130946], [153, 131246], [156, 131426], [165, 132006], [169, 132426], [176, 132846], [180, 133046], [191, 134042], [195, 134166], [199, 134246], [205, 134546], [208, 134746], [212, 134886], [217, 135186], [221, 135406], [229, 135806], [232, 136146], [237, 136366]]}, {"verse": 18, "start": 137135, "end": 145865, "text": "¶ And, behold, men brought in a bed a man which was paralyzed: and they sought means to bring him in, and to lay him before him.", "words": [[2, 137135], [7, 137304], [15, 138184], [19, 138584], [27, 138904], [30, 139124], [32, 139224], [36, 139664], [38, 139744], [42, 140004], [48, 140244], [52, 140424], [63, 141679], [67, 142040], [72, 142180], [79, 142460], [85, 142820], [88, 143100], [94, 143360], [98, 143560], [102, 144100], [106, 144460], [109, 144620], [113, 144840], [117, 145060], [124, 145340]]}, {"verse": 19, "start": 146215, "end": 157293, "text": "And when they could not find by what way they might bring him in because of the multitude, they went upon the housetop, and let him down through the tiling with his couch into the midst before Jesus.", "words": [[0, 146215], [4, 146361], [9, 146481], [14, 146661], [20, 146801], [24, 147041], [29, 147461], [32, 147781], [37, 148041], [41, 148381], [46, 148581], [52, 148781], [58, 149081], [62, 149281], [65, 149521], [73, 149881], [76, 150101], [80, 150221], [91, 151261], [96, 151421], [101, 151601], [106, 151921], [110, 152161], [120, 153083], [124, 153210], [128, 153370], [132, 153530], [137, 153790], [145, 154030], [149, 154170], [156, 154630], [161, 154870], [165, 154990], [171, 155310], [176, 155670], [180, 155830], [186, 156090], [193, 156510]]}, {"verse": 20, "start": 157643, "end": 162592, "text": "And when he saw their faith, he said to him, Man, your sins are forgiven you.", "words": [[0, 157643], [4, 157973], [9, 158113], [12, 158253], [16, 158493], [22, 158713], [29, 159253], [32, 159373], [37, 159593], [40, 159773], [45, 160213], [50, 160854], [55, 160998], [60, 161398], [64, 161678], [73, 162038]]}, {"verse": 21, "start": 162872, "end": 171141, "text": "And the scribes and the Pharisees began to reason, saying, Who is this which speaks blasphemies? Who can forgive sins, but God alone?", "words": [[0, 162872], [4, 162999], [8, 163139], [16, 163719], [20, 163839], [24, 163939], [34, 164559], [40, 164839], [43, 165079], [51, 165859], [59, 166679], [63, 166809], [66, 166909], [71, 167129], [77, 167389], [84, 167729], [97, 169152], [101, 169292], [105, 169452], [113, 169732], [119, 170132], [123, 170412], [127, 170632]]}, {"verse": 22, "start": 171421, "end": 177061, "text": "But when Jesus perceived their thoughts, he answering said to them, What do you reason in your hearts?", "words": [[0, 171421], [4, 171526], [9, 171726], [15, 172066], [25, 172686], [31, 172946], [41, 173946], [44, 174106], [54, 174466], [59, 174826], [62, 175026], [68, 175636], [73, 175740], [76, 175880], [80, 175960], [87, 176220], [90, 176400], [95, 176500]]}, {"verse": 23, "start": 177411, "end": 181991, "text": "Whether is easier, to say, Your sins be forgiven you; or to say, Rise up and walk?", "words": [[0, 177411], [8, 177576], [11, 177776], [19, 177996], [22, 178156], [27, 178656], [32, 178756], [37, 179056], [40, 179256], [49, 179596], [54, 180252], [57, 180351], [60, 180451], [65, 180831], [70, 181091], [73, 181351], [77, 181471]]}, {"verse": 24, "start": 182341, "end": 193289, "text": "But that you may know that the Son of man has power upon earth to forgive sins, (he said to the paralytic,) I say to you, Arise, and take up your couch, and go into your house.", "words": [[0, 182341], [4, 182444], [9, 182584], [13, 182744], [17, 182924], [22, 183204], [27, 183404], [31, 183544], [35, 183784], [38, 183904], [42, 184204], [46, 184444], [52, 184844], [57, 185104], [63, 185484], [66, 185704], [74, 185984], [80, 186982], [84, 187077], [89, 187257], [92, 187417], [96, 187537], [108, 188440], [110, 188605], [114, 188865], [117, 189045], [122, 189585], [129, 189965], [133, 190705], [138, 190905], [141, 191105], [146, 191205], [153, 191565], [157, 192105], [160, 192305], [165, 192525], [170, 192705]]}, {"verse": 25, "start": 193569, "end": 200651, "text": "And immediately he rose up before them, and took up that on which he lay, and departed to his own house, glorifying God.", "words": [[0, 193569], [4, 193718], [16, 194038], [19, 194498], [24, 194718], [27, 194978], [34, 195278], [40, 195618], [44, 196078], [49, 196258], [52, 196458], [57, 196638], [60, 196818], [66, 197038], [69, 197178], [74, 197418], [78, 197778], [87, 198118], [90, 198378], [94, 198578], [98, 198738], [105, 199498], [116, 200038]]}, {"verse": 26, "start": 201001, "end": 208345, "text": "And they were all amazed, and they glorified God, and were filled with fear, saying, We have seen strange things today.", "words": [[0, 201001], [4, 201165], [9, 201305], [14, 201485], [18, 201745], [26, 202745], [30, 202925], [35, 203045], [45, 203745], [50, 204685], [54, 204825], [59, 204985], [66, 205285], [71, 205577], [77, 206010], [85, 206791], [88, 206914], [93, 207014], [98, 207214], [106, 207574], [113, 207854]]}, {"verse": 27, "start": 208625, "end": 217171, "text": "¶ And after these things he went forth, and saw a tax collector, named Levi, sitting at the tax office: and he said to him, Follow me.", "words": [[2, 208625], [6, 208759], [12, 209019], [18, 209239], [25, 209639], [28, 209819], [33, 210059], [40, 210459], [44, 210744], [48, 211004], [50, 211144], [54, 211444], [65, 211964], [71, 212424], [77, 212864], [85, 213544], [88, 213744], [92, 213844], [96, 214124], [104, 215034], [108, 215334], [111, 215454], [116, 215714], [119, 215934], [124, 216610], [131, 216861]]}, {"verse": 28, "start": 217451, "end": 220606, "text": "And he left all, rose up, and followed him.", "words": [[0, 217451], [4, 217581], [7, 217681], [12, 217941], [17, 218821], [22, 218961], [26, 219761], [30, 219841], [39, 220181]]}, {"verse": 29, "start": 220956, "end": 228633, "text": "And Levi made him a great feast in his own house: and there was a great company of tax collectors and of others that sat down with them.", "words": [[0, 220956], [4, 221099], [9, 221359], [14, 221779], [18, 221919], [20, 222019], [26, 222279], [32, 222599], [35, 222879], [39, 223039], [43, 223199], [50, 224017], [54, 224142], [60, 224262], [64, 224482], [66, 224682], [72, 224922], [80, 225342], [83, 225542], [87, 225842], [98, 226402], [102, 226762], [105, 226902], [112, 227202], [117, 227482], [121, 227742], [126, 228082], [131, 228362]]}, {"verse": 30, "start": 228983, "end": 236381, "text": "But their scribes and Pharisees murmured against his disciples, saying, Why do you eat and drink with tax collectors and sinners?", "words": [[0, 228983], [4, 229085], [10, 229245], [18, 229805], [22, 229905], [32, 230585], [41, 231045], [49, 231285], [53, 231545], [64, 232425], [72, 233253], [76, 233388], [79, 233488], [83, 233628], [87, 233868], [91, 234068], [97, 234368], [102, 234588], [106, 234828], [117, 235328], [121, 235648]]}, {"verse": 31, "start": 236661, "end": 242372, "text": "And Jesus answering said to them, They that are whole need not a physician; but they that are sick.", "words": [[0, 236661], [4, 236809], [10, 237129], [20, 237729], [25, 238009], [28, 238209], [34, 238789], [39, 238971], [44, 239161], [48, 239351], [54, 239631], [59, 240131], [63, 240271], [65, 240391], [76, 241286], [80, 241406], [85, 241566], [90, 241786], [94, 241886]]}, {"verse": 32, "start": 242722, "end": 246237, "text": "I came not to call the righteous, but sinners to repentance.", "words": [[0, 242722], [2, 242837], [7, 243037], [11, 243277], [14, 243457], [19, 243697], [23, 243837], [34, 244557], [38, 244797], [46, 245157], [49, 245457]]}, {"verse": 33, "start": 246517, "end": 255392, "text": "¶ And they said to him, Why do the disciples of John fast often, and make prayers, and likewise the disciples of the Pharisees; but your eat and drink?", "words": [[2, 246517], [6, 246659], [11, 246779], [16, 247019], [19, 247239], [24, 247792], [28, 248033], [31, 248253], [35, 248413], [45, 248853], [48, 249073], [53, 249373], [58, 249753], [65, 250233], [69, 250793], [74, 250993], [83, 251393], [87, 251793], [96, 252153], [100, 252453], [110, 252873], [113, 253073], [117, 253173], [128, 254064], [132, 254191], [137, 254391], [141, 254671], [145, 254911]]}, {"verse": 34, "start": 255672, "end": 261012, "text": "And he said to them, Can you make the children of the bridechamber fast, while the bridegroom is with them?", "words": [[0, 255672], [4, 255802], [7, 255922], [12, 256162], [15, 256362], [21, 256908], [25, 257021], [29, 257141], [34, 257341], [38, 257501], [47, 257881], [50, 258081], [54, 258421], [67, 258761], [73, 259341], [79, 259596], [83, 259756], [94, 260256], [97, 260436], [102, 260616]]}, {"verse": 35, "start": 261362, "end": 267541, "text": "But the days will come, when the bridegroom shall be taken away from them, and then shall they fast in those days.", "words": [[0, 261362], [4, 261444], [8, 261584], [13, 261884], [18, 262104], [24, 262504], [29, 262984], [33, 263124], [44, 263624], [50, 263864], [53, 264004], [59, 264264], [64, 264564], [69, 264784], [75, 265344], [79, 265544], [84, 265784], [90, 266024], [95, 266164], [100, 266504], [103, 266804], [109, 266984]]}, {"verse": 36, "start": 267821, "end": 279647, "text": "¶ And he spoke also a parable to them; No man puts a piece of a new garment upon an old; if otherwise, then both the new makes a tear, and the piece that was taken out of the new agrees not with the old.", "words": [[2, 267821], [6, 267943], [9, 268063], [15, 268363], [20, 268783], [22, 269023], [30, 269403], [33, 269583], [39, 270130], [42, 270349], [46, 270729], [51, 271049], [53, 271249], [59, 271449], [62, 271649], [64, 271789], [68, 271909], [76, 272309], [81, 272649], [84, 272949], [89, 273689], [92, 273831], [103, 274251], [108, 274651], [113, 274911], [117, 275131], [121, 275311], [127, 275611], [129, 275751], [135, 276031], [139, 276511], [143, 276611], [149, 276871], [154, 277031], [158, 277171], [164, 277411], [168, 277631], [171, 277731], [175, 277831], [179, 278071], [186, 278451], [190, 278831], [195, 279031], [199, 279191]]}, {"verse": 37, "start": 279997, "end": 287895, "text": "And no man puts new wine into old wineskins; else the new wine will burst the bottles, and be spilled, and the bottles shall perish.", "words": [[0, 279997], [4, 280141], [7, 280341], [11, 280581], [16, 280861], [20, 281121], [25, 281501], [30, 281741], [34, 282061], [45, 283257], [50, 283418], [54, 283618], [58, 283798], [63, 284058], [68, 284238], [74, 284538], [78, 284718], [87, 285418], [91, 285578], [94, 285758], [103, 286558], [107, 286638], [111, 286758], [119, 287078], [125, 287298]]}, {"verse": 38, "start": 288245, "end": 292152, "text": "But new wine must be put into new wineskins; and both are preserved.", "words": [[0, 288245], [4, 288331], [8, 288571], [13, 288871], [18, 289111], [21, 289291], [25, 289491], [30, 289751], [34, 290011], [45, 290841], [49, 291081], [54, 291301], [58, 291501]]}, {"verse": 39, "start": 292502, "end": 298984, "text": "No man also having drunk old wine immediately desires new: for he says, The old is better.", "words": [[0, 292502], [3, 292729], [7, 293029], [12, 293469], [19, 293829], [25, 294169], [29, 294469], [34, 294829], [46, 295409], [54, 295949], [59, 296913], [63, 297032], [66, 297192], [72, 297872], [76, 298012], [80, 298312], [83, 298512]]}]}