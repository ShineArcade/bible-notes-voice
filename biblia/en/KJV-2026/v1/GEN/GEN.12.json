{"book": "GEN", "chapter": 12, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 166119, "verses": [{"verse": 1, "start": 300, "end": 8905, "text": "Now the LORD had said to Abram, Get out of your country, and from your kindred, and from your father’s house, to a land that I will show you:", "words": [[0, 300], [4, 527], [8, 767], [13, 987], [17, 1147], [22, 1347], [25, 1527], [32, 2883], [36, 2987], [40, 3147], [43, 3247], [48, 3327], [57, 3707], [61, 4127], [66, 4327], [71, 4467], [80, 4987], [84, 5447], [89, 5627], [94, 5767], [103, 6267], [110, 6507], [113, 7107], [115, 7267], [120, 7547], [125, 7727], [127, 7867], [132, 8007], [137, 8267]]}, {"verse": 2, "start": 9355, "end": 15913, "text": "And I will make of you a great nation, and I will bless you, and make your name great; and you shall be a blessing:", "words": [[0, 9355], [4, 9454], [6, 9554], [11, 9674], [16, 9914], [19, 10074], [23, 10194], [25, 10294], [31, 10514], [39, 11294], [43, 11534], [45, 11654], [50, 11774], [56, 12014], [61, 12354], [65, 12734], [70, 12934], [75, 13094], [80, 13294], [87, 14378], [91, 14499], [95, 14599], [101, 14759], [104, 14919], [106, 15019]]}, {"verse": 3, "start": 16363, "end": 24583, "text": "And I will bless them that bless you, and curse him that curses you: and in you shall all families of the earth be blessed.", "words": [[0, 16363], [4, 16513], [6, 16633], [11, 16773], [17, 17073], [22, 17373], [27, 17973], [33, 18273], [38, 18673], [42, 19093], [48, 19453], [52, 19713], [57, 20053], [64, 20513], [69, 21523], [73, 21662], [76, 21822], [80, 21982], [86, 22182], [90, 22442], [99, 22902], [102, 23142], [106, 23262], [112, 23462], [115, 23682]]}, {"verse": 4, "start": 24933, "end": 34635, "text": "So Abram departed, as the LORD had spoken to him; and Lot went with him: and Abram was seventy and five years old when he departed out of Haran.", "words": [[0, 24933], [3, 25463], [9, 25993], [19, 26413], [22, 26753], [26, 26933], [31, 27173], [35, 27373], [42, 27713], [45, 27993], [50, 28606], [54, 28832], [58, 29112], [63, 29392], [68, 29692], [73, 30289], [77, 30642], [83, 31032], [87, 31212], [95, 31392], [99, 31572], [104, 31752], [110, 32472], [114, 32812], [119, 33092], [122, 33232], [131, 33632], [135, 33912], [138, 34308]]}, {"verse": 5, "start": 35085, "end": 48476, "text": "And Abram took Sarai his wife, and Lot his brother’s son, and all their substance that they had gathered, and the souls that they had gotten in Haran; and they went forth to go into the land of Canaan; and into the land of Canaan they came.", "words": [[0, 35085], [4, 35235], [10, 35755], [15, 35975], [21, 36435], [25, 36615], [31, 36895], [35, 37195], [39, 37395], [43, 37575], [53, 38075], [58, 38295], [62, 38755], [66, 38935], [72, 39075], [82, 39535], [87, 39855], [92, 40015], [96, 40155], [106, 40515], [110, 41035], [114, 41175], [120, 41495], [125, 41755], [130, 41915], [134, 42075], [141, 42375], [144, 42535], [151, 43431], [155, 43556], [160, 43676], [165, 43876], [171, 44236], [174, 44516], [177, 44696], [182, 44896], [186, 45076], [191, 45316], [194, 45456], [202, 46401], [206, 46549], [211, 46789], [215, 46949], [220, 47169], [223, 47289], [230, 47709], [235, 47929]]}, {"verse": 6, "start": 48926, "end": 55919, "text": "¶ And Abram passed through the land to the place of Sichem, to the plain of Moreh. And the Canaanite was then in the land.", "words": [[2, 48926], [6, 49292], [12, 49692], [19, 49972], [27, 50252], [31, 50412], [36, 50712], [39, 50872], [43, 50932], [49, 51172], [52, 51632], [60, 52092], [63, 52292], [67, 52432], [73, 52692], [76, 53132], [83, 53811], [87, 53950], [91, 54090], [101, 54650], [105, 54850], [110, 55090], [113, 55270], [117, 55370]]}, {"verse": 7, "start": 56369, "end": 65170, "text": "And the LORD appeared to Abram, and said, To your seed will I give this land: and there built he an altar to the LORD, who appeared to him.", "words": [[0, 56369], [4, 56488], [8, 56608], [13, 56828], [