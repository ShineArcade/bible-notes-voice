94], [18, 91294], [22, 91454], [33, 93264], [36, 93419], [41, 93579], [46, 94320], [50, 94416], [53, 94596], [57, 94736], [62, 94816], [72, 95536], [75, 95636], [78, 95816], [81, 95936], [86, 96096], [89, 96296], [94, 96975], [98, 97101], [102, 97241], [110, 97581], [114, 97841], [121, 98161], [124, 98441], [128, 98751], [137, 99061]]}, {"verse": 14, "start": 99950, "end": 106087, "text": "¶ And when Jesus was come into Peter’s house, he saw his wife’s mother laid, and sick of a fever.", "words": [[2, 99950], [6, 100080], [11, 100200], [17, 100520], [21, 100773], [26, 101027], [31, 101280], [39, 101700], [46, 102340], [49, 102460], [53, 102720], [57, 102920], [64, 103300], [71, 103540], [77, 103960], [81, 104260], [86, 104480], [89, 104640], [91, 104720]]}, {"verse": 15, "start": 106537, "end": 111849, "text": "And he touched her hand, and the fever left her: and she arose, and ministered to them.", "words": [[0, 106537], [4, 106657], [7, 106757], [15, 107017], [19, 107217], [25, 107597], [29, 107997], [33, 108117], [39, 108397], [44, 108737], [49, 109420], [53, 109564], [57, 109724], [64, 110144], [68, 110704], [79, 111304], [82, 111424]]}, {"verse": 16, "start": 112299, "end": 120742, "text": "¶ When the even was come, they brought to him many that were demon-possessed: and he cast out the spirits with his word, and healed all that were sick:", "words": [[2, 112299], [7, 112422], [11, 112602], [16, 112842], [20, 113102], [26, 113802], [31, 113962], [39, 114202], [42, 114422], [46, 114582], [51, 114842], [56, 115102], [61, 115776], [78, 116678], [82, 116827], [85, 116887], [90, 117227], [94, 117407], [98, 117587], [106, 117987], [111, 118267], [115, 118427], [121, 119067], [125, 119327], [132, 119567], [136, 119887], [141, 120067], [146, 120227]]}, {"verse": 17, "start": 121192, "end": 129047, "text": "That it might be fulfilled which was spoken by Esaias the prophet, saying, Himself took our infirmities, and bore our sicknesses.", "words": [[0, 121192], [5, 121321