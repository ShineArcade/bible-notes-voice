{"book": "MAT", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 248965, "verses": [{"verse": 1, "start": 300, "end": 7862, "text": "Y llegándose los fariseos y los saduceos para tentarle, le pedían que les mostrase señal del cielo.", "words": [[0, 300], [2, 427], [13, 1167], [17, 1347], [26, 2127], [28, 2247], [32, 2387], [41, 3187], [46, 3930], [56, 4672], [59, 4892], [66, 5412], [70, 5612], [74, 5772], [83, 6452], [89, 7052], [93, 7192]]}, {"verse": 2, "start": 8212, "end": 16819, "text": "Pero él respondiendo, les dijo: Cuando es la tarde del día, decís: Sereno; porque el cielo está rojizo.", "words": [[0, 8212], [5, 8556], [8, 9296], [22, 10316], [26, 10416], [32, 11262], [39, 11427], [42, 11667], [45, 11827], [51, 12107], [55, 12407], [60, 12955], [67, 13724], [75, 14804], [82, 15086], [85, 15286], [91, 15666], [96, 15966]]}, {"verse": 3, "start": 17169, "end": 29164, "text": "Y a la mañana: Hoy tempestad; porque el cielo está rojizo y sombrío. Hipócritas, que sabéis hacer diferencia en el aspecto del cielo; ¿y en las señales de los tiempos no podéis?", "words": [[0, 17169], [2, 17337], [4, 17417], [7, 17477], [15, 18289], [19, 18479], [30, 19545], [37, 19770], [40, 19950], [46, 20350], [51, 20610], [58, 21170], [60, 21310], [69, 22225], [81, 23325], [85, 23465], [92, 23925], [98, 24205], [109, 24945], [112, 25145], [115, 25245], [123, 25725], [127, 25885], [134, 26637], [137, 26753], [140, 26873], [144, 26993], [152, 27573], [155, 27673], [159, 27813], [167, 28293], [170, 28433]]}, {"verse": 4, "start": 29514, "end": 39117, "text": "La generación mala y adúltera demanda señal; pero señal no le será dada, sino la señal de Jonás profeta. Y dejándolos, se fue.", "words": [[0, 29514], [3, 29621], [14, 30261], [19, 30661], [21, 31051], [30, 31441], [38, 31941], [45, 32816], [50, 33116], [56, 33756], [59, 34056], [62, 34356], [67, 34576], [73, 34976], [78, 35256], [81, 35516], [87, 35976], [90, 36096], [96, 36336], [105, 37475], [107, 37602], [119, 38422], [122, 38722]]}, {"verse": 5, "start": 39467, "end": 45134, "text": "Y viniendo sus discípulos del otro lado del lago, se habían olvidado de tomar pan.", "words": [[0, 39467], [2, 39595], [11, 40135], [15, 40315], [26, 41055], [30, 41275], [35, 41495], [40, 41795], [44, 42055], [50, 42795], [53, 43275], [60, 43495], [69, 44095], [72, 44255], [78, 44475]]}, {"verse": 6, "start": 45484, "end": 51962, "text": "Y Jesús les dijo: Mirad, y guardaos de la levadura de los fariseos y de los saduceos.", "words": [[0, 45484], [2, 45608], [8, 45948], [12, 46268], [18, 47724], [25, 47724], [27, 48052], [36, 48412], [39, 48672], [42, 48832], [51, 49352], [54, 49552], [58, 49712], [67, 50612], [69, 50832], [72, 50932], [76, 51092]]}, {"verse": 7, "start": 52312, "end": 57319, "text": "Y ellos pensaban dentro de sí, diciendo: Esto dice porque no tomamos pan.", "words": [[0, 52312], [2, 52438], [8, 52638], [17, 53258], [24, 53578], [27, 53838], [31, 54538], [41, 55429], [46, 55667], [51, 55987], [58, 56327], [61, 56527], [69, 56907]]}, {"verse": 8, "start": 57599, "end": 64985, "text": "Y entendiéndolo Jesús, les dijo: ¿Por qué pensáis dentro de vosotros, hombres de poca fe, que no tomasteis pan?", "words": [[0, 57599], [2, 58053], [16, 58543], [23, 58983], [27, 59403], [33, 60141], [38, 60266], [42, 60406], [50, 61026], [57, 61366], [60, 61706], [70, 62426], [78, 62706], [81, 62906], [86, 63186], [90, 63766], [94, 63826], [97, 64235], [107, 64644]]}, {"verse": 9, "start": 65335, "end": 72595, "text": "¿No entendéis aún, ni os acordáis de los cinco panes entre cinco mil hombres, y cuántos cestos recogisteis?", "words": [[0, 65335], [4, 65522], [14, 66102], [19, 66602], [22, 67102], [25, 67262], [34, 67862], [37, 68042], [41, 68202], [47, 68522], [53, 69062], [59, 69322], [65, 69722], [69, 70002], [78, 70382], [80, 70637], [88, 70997], [95, 71357]]}, {"verse": 10, "start": 72945, "end": 77123, "text": "¿Ni de los siete panes entre cuatro mil, y cuántas canastas tomasteis?", "words": [[0, 72945], [4, 73069], [7, 73169], [11, 73349], [17, 73529], [23, 74069], [29, 74322], [36, 74576], [41, 74829], [43, 75209], [51, 75609], [60, 76269]]}, {"verse": 11, "start": 77473, "end": 85968, "text": "¿Cómo es que no entendéis que no por el pan os dije, que os guardaseis de la levadura de los fariseos y de los saduceos?", "words": [[0, 77473], [6, 77703], [9, 77903], [13, 78043], [16, 78203], [26, 79203], [30, 79303], [33, 79463], [37, 79703], [40, 79823], [44, 80103], [47, 80263], [53, 81183], [57, 81303], [60, 81443], [71, 82323], [74, 82703], [77, 82843], [86, 83343], [89, 83483], [93, 83603], [102, 84383], [104, 84583], [107, 84703], [111, 84843]]}, {"verse": 12, "start": 86318, "end": 95520, "text": "Entonces entendieron que no les había dicho que se guardasen de la levadura de pan, sino de la doctrina de los fariseos y de los saduceos.", "words": [[0, 86318], [9, 87122], [21, 87722], [25, 87922], [28, 88062], [32, 88222], [38, 88482], [44, 88862], [48, 89062], [51, 89202], [61, 89942], [64, 90062], [67, 90222], [76, 90682], [79, 90842], [84, 91242], [89, 91582], [92, 91782], [95, 91922], [104, 92522], [107, 92682], [111, 93182], [120, 93682], [122, 94062], [125, 94182], [129, 94322]]}, {"verse": 13, "start": 95870, "end": 104841, "text": "Y viniendo Jesús a las partes de Cesarea de Filipo, preguntó a sus discípulos, diciendo: ¿Quién dicen los hombres que es el Hijo del hombre?", "words": [[0, 95870], [2, 95974], [11, 96494], [17, 96754], [19, 96994], [23, 97094], [30, 97474], [33, 97864], [41, 98254], [44, 98734], [52, 99214], [61, 99914], [63, 99994], [67, 100174], [79, 100834], [89, 101797], [96, 102121], [102, 102521], [106, 102781], [114, 103221], [118, 103441], [121, 103661], [124, 103801], [129, 104041], [133, 104241]]}, {"verse": 14, "start": 105191, "end": 112932, "text": "Y ellos dijeron: Unos, Juan el Bautista; y otros, Elías; y otros, Jeremías, o alguno de los profetas.", "words": [[0, 105191], [2, 105461], [8, 105731], [17, 106778], [23, 107081], [28, 107401], [31, 107561], [41, 108531], [43, 108710], [50, 108970], [57, 110146], [59, 110290], [66, 110530], [76, 111350], [78, 111590], [85, 111990], [88, 112030], [92, 112150]]}, {"verse": 15, "start": 113212, "end": 116647, "text": "Él les dice: Y vosotros, ¿quién decís que soy?", "words": [[0, 113212], [3, 113421], [7, 113601], [13, 114458], [15, 114564], [25, 115124], [32, 115584], [38, 116084], [42, 116164]]}, {"verse": 16, "start": 116997, "end": 122637, "text": "Y respondiendo Simón Pedro, dijo: Tú eres el Cristo, el Hijo del Dios viviente.", "words": [[0, 116997], [2, 116997], [15, 118085], [21, 118425], [28, 118865], [34, 119962], [37, 120118], [42, 120298], [45, 120478], [53, 121258], [56, 121358], [61, 121578], [65, 121718], [70, 121918]]}, {"verse": 17, "start": 122917, "end": 134895, "text": "Entonces, respondiendo Jesús, le dijo: Bienaventurado eres, Simón, hijo de Jonás; porque no te lo reveló carne ni sangre, sino mi Padre que está en los cielos.", "words": [[0, 122917], [10, 123436], [23, 124556], [30, 125376], [33, 125516], [39, 126953], [54, 127533], [60, 127753], [67, 128593], [72, 128753], [75, 128913], [82, 129787], [89, 129971], [92, 130191], [95, 130311], [98, 130606], [105, 130901], [111, 131196], [114, 131491], [122, 132211], [127, 132531], [130, 132791], [136, 133391], [140, 133671], [145, 133891], [148, 134051], [152, 134151]]}, {"verse": 18, "start": 135245, "end": 145660, "text": "Pero yo también te digo, que tú eres Pedro, y sobre esta piedra edificaré mi iglesia; y las puertas del infierno no prevalecerán contra ella.", "words": [[0, 135245], [5, 135386], [8, 135566], [16, 135886], [19, 136226], [25, 136646], [29, 137126], [32, 137286], [37, 137466], [44, 138026], [46, 138331], [52, 138632], [57, 139011], [64, 139812], [74, 140611], [77, 141164], [86, 141900], [88, 142008], [92, 142108], [100, 142468], [104, 142668], [113, 143328], [116, 143868], [129, 144728], [136, 145108]]}, {"verse": 19, "start": 146010, "end": 158215, "text": "Y a ti daré las llaves del reino de los cielos; y todo lo que ligues en la tierra será ligado en los cielos; y todo lo que desates en la tierra será desatado en los cielos.", "words": [[0, 146010], [2, 146189], [4, 146309], [7, 146489], [12, 146869], [16, 147029], [23, 147589], [27, 147909], [33, 148409], [36, 148529], [40, 148649], [48, 149683], [50, 149934], [55, 150114], [58, 150334], [62, 150454], [69, 150814], [72, 150914], [75, 151054], [82, 151354], [87, 151804], [94, 152254], [97, 152374], [101, 152494], [109, 153441], [111, 153562], [116, 153882], [119, 154202], [123, 154362], [131, 154942], [134, 155222], [137, 155362], [144, 155802], [149, 156202], [158, 157142], [161, 157262], [165, 157422]]}, {"verse": 20, "start": 158565, "end": 163656, "text": "Entonces mandó a sus discípulos que a nadie dijesen que él era Jesús el Cristo.", "words": [[0, 158565], [9, 159045], [15, 159625], [17, 159725], [21, 159865], [32, 160525], [36, 160745], [38, 160865], [44, 161345], [52, 161825], [56, 162025], [59, 162205], [63, 162345], [69, 162803], [72, 163261]]}, {"verse": 21, "start": 164006, "end": 181329, "text": "Desde aquel tiempo comenzó Jesús a declarar a sus discípulos que le convenía ir a Jerusalén, y padecer mucho de los ancianos, y de los príncipes de los sacerdotes, y de los escribas; y ser muerto, y resucitar al tercer día.", "words": [[0, 164006], [6, 164192], [12, 164572], [19, 164892], [27, 165592], [33, 165912], [35, 166192], [44, 166832], [46, 166912], [50, 167092], [61, 168012], [65, 168572], [68, 168712], [77, 169392], [80, 169732], [82, 169832], [93, 171092], [95, 171412], [103, 171932], [109, 172392], [112, 172572], [116, 172732], [126, 173492], [128, 173752], [131, 173852], [135, 174362], [145, 174872], [148, 175052], [152, 175172], [164, 176376], [166, 176523], [169, 176563], [173, 176723], [183, 177873], [185, 178015], [189, 178175], [197, 178835], [199, 179215], [209, 180055], [212, 180335], [219, 180655]]}, {"verse": 22, "start": 181679, "end": 190690, "text": "Y Pedro, tomándolo aparte, comenzó a reprenderle, diciendo: Señor, ten compasión de ti: en ninguna manera esto te acontezca.", "words": [[0, 181679], [2, 181958], [9, 182438], [19, 182998], [27, 184038], [35, 184498], [37, 184598], [50, 185378], [60, 186545], [67, 187186], [71, 187266], [81, 187826], [84, 187966], [88, 188467], [91, 188605], [99, 188865], [106, 189365], [111, 189745], [114, 190240]]}, {"verse": 23, "start": 190970, "end": 202868, "text": "Entonces él, volviéndose, dijo a Pedro: Quítate de delante de mí, Satanás; me eres tropiezo; porque no entiendes lo que es de Dios sino lo que es de los hombres.", "words": [[0, 190970], [9, 191609], [13, 192279], [26, 192979], [31, 193379], [33, 193539], [40, 194285], [48, 194709], [51, 194929], [59, 195369], [62, 195549], [66, 196029], [75, 197228], [78, 197638], [83, 198083], [93, 198683], [100, 198867], [103, 199087], [113, 199767], [116, 199907], [120, 200047], [123, 200187], [126, 200267], [131, 200587], [136, 201047], [139, 201587], [143, 201767], [146, 201927], [149, 202047], [153, 202187]]}, {"verse": 24, "start": 203218, "end": 212613, "text": "Entonces Jesús dijo a sus discípulos: Si alguno quiere venir en pos de mí, niéguese a sí mismo, y tome su cruz, y sígame.", "words": [[0, 203218], [9, 203636], [15, 204236], [20, 204856], [22, 205096], [26, 205296], [38, 206550], [41, 206694], [48, 207134], [55, 207314], [61, 207654], [64, 207894], [68, 208134], [71, 208334], [75, 208954], [84, 209394], [86, 209514], [89, 209614], [96, 209994], [98, 210454], [103, 210734], [106, 210874], [112, 211474], [114, 212076]]}, {"verse": 25, "start": 212963, "end": 220672, "text": "Porque todo el que quiera salvar su vida, la perderá, y todo el que pierda su vida por causa de mí, la hallará.", "words": [[0, 212963], [7, 213187], [12, 213527], [15, 213767], [19, 213907], [26, 214247], [33, 214607], [36, 214887], [42, 215247], [45, 215452], [54, 216072], [56, 216532], [61, 216792], [64, 217012], [68, 217112], [75, 217492], [78, 217652], [83, 217912], [87, 218152], [93, 218372], [96, 218732], [100, 218892], [103, 219392]]}, {"verse": 26, "start": 221022, "end": 229159, "text": "Porque ¿de qué aprovecha al hombre, si gana todo el mundo y pierde su alma? O ¿qué recompensa dará el hombre por su alma?", "words": [[0, 221022], [7, 221303], [11, 221843], [15, 222003], [25, 222363], [28, 222723], [36, 222983], [39, 223443], [44, 223723], [49, 223983], [52, 224203], [58, 224483], [60, 224643], [67, 225043], [70, 225183], [76, 226255], [78, 226255], [83, 226358], [94, 227278], [99, 227678], [102, 227798], [109, 228098], [113, 228378], [116, 228558]]}, {"verse": 27, "start": 229509, "end": 239779, "text": "Porque el Hijo del hombre vendrá en la gloria de su Padre con sus ángeles, y entonces recompensará a cada uno conforme a sus obras.", "words": [[0, 229509], [7, 229786], [10, 230006], [15, 230286], [19, 230486], [26, 230906], [33, 231726], [36, 232026], [39, 232206], [46, 232606], [49, 232766], [52, 232946], [58, 233306], [62, 233606], [66, 233826], [75, 234406], [77, 234946], [86, 235486], [99, 237286], [101, 237526], [106, 237746], [110, 238046], [119, 238826], [121, 238926], [125, 239066]]}, {"verse": 28, "start": 240129, "end": 248565, "text": "De cierto os digo: hay algunos de los que están aquí, que no probarán la muerte, hasta que hayan visto al Hijo del hombre viniendo en su reino.", "words": [[0, 240129], [3, 240253], [10, 240533], [13, 240873], [19, 241532], [23, 241710], [31, 242110], [34, 242290], [38, 242390], [42, 242530], [48, 242730], [54, 243070], [58, 243295], [61, 243495], [70, 244035], [73, 244195], [81, 244675], [87, 245355], [91, 245575], [97, 245915], [103, 246235], [106, 246475], [111, 246655], [115, 246875], [122, 247155], [131, 247755], [134, 247895], [137, 248055]]}]}