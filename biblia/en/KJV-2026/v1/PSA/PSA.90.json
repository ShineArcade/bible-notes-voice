{"book": "PSA", "chapter": 90, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 105303, "verses": [{"verse": 1, "start": 300, "end": 3629, "text": "Lord, you have been our dwelling place in all generations.", "words": [[0, 300], [6, 734], [10, 834], [15, 994], [20, 1174], [24, 1314], [33, 1634], [39, 2014], [42, 2294], [46, 2574]]}, {"verse": 2, "start": 4079, "end": 11664, "text": "Before the mountains were brought forth, or ever you had formed the earth and the world, even from everlasting to everlasting, you are God.", "words": [[0, 4079], [7, 4285], [11, 4545], [21, 4885], [26, 5105], [34, 5405], [41, 6245], [44, 6425], [49, 6625], [53, 6805], [57, 6945], [64, 7245], [68, 7485], [74, 7765], [78, 7945], [82, 8065], [89, 8445], [94, 8765], [99, 9025], [111, 9585], [114, 9965], [127, 10745], [131, 10905], [135, 11085]]}, {"verse": 3, "start": 12114, "end": 16820, "text": "You turn man to destruction; and say, Return, you children of men.", "words": [[0, 12114], [4, 12206], [9, 12466], [13, 12766], [16, 12946], [29, 14045], [33, 14193], [38, 14983], [46, 15331], [50, 15531], [59, 15831], [62, 16071]]}, {"verse": 4, "start": 17170, "end": 22517, "text": "For a thousand years in your sight are but as yesterday when it is past, and as a watch in the night.", "words": [[0, 17170], [4, 17278], [6, 17458], [15, 17758], [21, 18118], [24, 18358], [29, 18498], [35, 18858], [39, 18998], [43, 19178], [46, 19358], [56, 19778], [61, 20078], [64, 20198], [67, 20298], [73, 20638], [77, 21238], [80, 21418], [82, 21518], [88, 21818], [91, 21998], [95, 22098]]}, {"verse": 5, "start": 22967, "end": 29485, "text": "You carry them away as with a flood; they are as a sleep: in the morning they are like grass which grows up.", "words": [[0, 22967], [4, 23090], [10, 23390], [15, 23610], [20, 23950], [23, 24190], [28, 24370], [30, 24470], [37, 25315], [42, 25449], [46, 25609], [49, 25915], [51, 26221], [58, 26786], [61, 26914], [65, 26994], [73, 27334], [78, 27594], [82, 27694], [87, 27894], [93, 28334], [99, 28714], [105, 29014]]}, {"verse": 6, "start": 29935, "end": 35279, "text": "In the morning it flourishes, and grows up; in the evening it is cut down, and withers.", "words": [[0, 29935], [3, 30059], [7, 30159], [15, 30439], [18, 30679], [30, 31339], [34, 31739], [40, 32039], [44, 32795], [47, 32922], [51, 33042], [59, 33382], [62, 33642], [65, 33782], [69, 34002], [75, 34402], [79, 34642]]}, {"verse": 7, "start": 35729, "end": 39945, "text": "For we are consumed by your anger, and by your wrath are we troubled.", "words": [[0, 35729], [4, 35844], [7, 36064], [11, 36184], [20, 36684], [23, 37044], [28, 37224], [35, 37844], [39, 38244], [42, 38445], [47, 38625], [53, 38985], [57, 39144], [60, 39305]]}, {"verse": 8, "start": 40395, "end": 44948, "text": "You have set our iniquities before you, our secret sins in the light of your countenance.", "words": [[0, 40395], [4, 40542], [9, 40702], [13, 40962], [17, 41182], [28, 41722], [35, 42082], [40, 42542], [44, 42622], [51, 42962], [56, 43282], [59, 43542], [63, 43662], [69, 43902], [72, 44042], [77, 44182]]}, {"verse": 9, "start": 45398, "end": 50937, "text": "For all our days are passed away in your wrath: we spend our years as a tale that is told.", "words": [[0, 45398], [4, 45504], [8, 45784], [12, 46044], [17, 46384], [21, 46604], [28, 46884], [33, 47284], [36, 47484], [41, 47624], [48, 48497], [51, 48586], [57, 48826], [61, 49066], [67, 49366], [70, 49586], [72, 49726], [77, 50006], [82, 50226], [85, 50366]]}, {"verse": 10, "start": 51387, "end": 63248, "text": "The days of our years are threescore years and ten; and if by reason of strength they be fourscore years, yet is their strength labour and sorrow; for it is soon cut off, and we fly away.", "words": [[0, 51387], [4, 51675], [9, 51975], [12, 52155], [16, 52295], [22, 52615], [26, 53035], [37, 53455], [43, 53795], [47, 54055], [52, 54896], [56, 55039], [59, 55159], [62, 55359], [69, 55679], [72, 55839], [81, 56259], [86, 56459], [89, 56859], [99, 57259], [106, 58119], [110, 58339], [113, 58579], [119, 58759], [128, 59099], [135, 59439], [139, 59699], [147, 60691], [151, 60825], [154, 60945], [157, 61045], [162, 61245], [166, 61505], [171, 61825], [175, 62245], [178, 62405], [182, 62665]]}, {"verse": 11, "start": 63698, "end": 68633, "text": "Who knows the power of your anger? even according to your fear, so is your wrath.", "words": [[0, 63698], [4, 63853], [10, 64113], [14, 64313], [20, 64633], [23, 64853], [28, 64973], [35, 65871], [40, 66079], [50, 66419], [53, 66679], [58, 66819], [64, 67539], [67, 67799], [70, 67979], [75, 68119]]}, {"verse": 12, "start": 69083, "end": 73050, "text": "So teach us to number our days, that we may apply our hearts to wisdom.", "words": [[0, 69083], [3, 69226], [9, 69446], [12, 69646], [15, 69806], [22, 70066], [26, 70306], [32, 70646], [37, 71126], [40, 71286], [44, 71466], [50, 71826], [54, 72026], [61, 72306], [64, 72506]]}, {"verse": 13, "start": 73500, "end": 78343, "text": "Return, O LORD, how long? and let it repent you concerning your servants.", "words": [[0, 73500], [8, 73985], [10, 74045], [16, 74445], [20, 74565], [26, 75979], [30, 76111], [34, 76271], [37, 76371], [44, 76731], [48, 76971], [59, 77431], [64, 77691]]}, {"verse": 14, "start": 78793, "end": 84338, "text": "O satisfy us early with your mercy; that we may rejoice and be glad all our days.", "words": [[0, 79008], [2, 79258], [10, 79538], [13, 79938], [19, 80238], [24, 80518], [29, 80638], [36, 81512], [41, 81832], [44, 81992], [48, 82172], [56, 82592], [60, 82912], [63, 83052], [68, 83352], [72, 83592], [76, 83752]]}, {"verse": 15, "start": 84788, "end": 90628, "text": "Make us glad according to the days in which you have afflicted us, and the years in which we have seen evil.", "words": [[0, 84788], [5, 84936], [8, 85136], [13, 85496], [23, 85876], [26, 86156], [30, 86276], [35, 86576], [38, 86796], [44, 86976], [48, 87176], [53, 87356], [63, 87856], [67, 88476], [71, 88616], [75, 88736], [81, 88996], [84, 89216], [90, 89416], [93, 89616], [98, 89776], [103, 90036]]}, {"verse": 16, "start": 91078, "end": 95088, "text": "Let your work appear to your servants, and your glory to their children.", "words": [[0, 91078], [4, 91267], [9, 91507], [14, 91847], [21, 92187], [24, 92447], [29, 92647], [39, 93087], [43, 93487], [48, 93627], [54, 94027], [57, 94247], [63, 94407]]}, {"verse": 17, "start": 95538, "end": 104903, "text": "And let the beauty of the LORD our God be upon us: and establish the work of our hands upon us; yes, the work of our hands establish you it.", "words": [[0, 95538], [4, 95657], [8, 95797], [12, 95977], [19, 96237], [22, 96477], [26, 96597], [31, 96917], [35, 97197], [39, 97597], [42, 97857], [47, 98157], [51, 98998], [55, 99140], [65, 99600], [69, 99840], [74, 100060], [77, 100220], [81, 100380], [87, 100740], [92, 101020], [96, 101845], [101, 102717], [105, 102897], [110, 103157], [113, 103337], [117, 103457], [123, 103797], [133, 104277], [137, 104617]]}]}