{"book": "ISA", "chapter": 30, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 385080, "verses": [{"verse": 1, "start": 300, "end": 11883, "text": "¡Ay de los hijos que se apartan, dice Jehová, para tomar consejo, y no de mí; para cobijarse con cubierta, y no de mi espíritu, añadiendo pecado a pecado!", "words": [[0, 401], [4, 541], [7, 681], [11, 821], [17, 1161], [21, 1421], [24, 1561], [33, 2421], [38, 3061], [46, 3701], [51, 3821], [57, 4161], [66, 4961], [68, 5301], [71, 5441], [74, 5601], [78, 6459], [83, 6603], [93, 7343], [97, 7543], [107, 8263], [109, 8623], [112, 8763], [115, 8923], [118, 9043], [128, 9943], [138, 10623], [145, 11163], [147, 11283]]}, {"verse": 2, "start": 12572, "end": 23061, "text": "Pártense para descender a Egipto, y no han preguntado mi boca; para fortalecerse con la fuerza de Faraón, y poner su esperanza en la sombra de Egipto.", "words": [[0, 12572], [9, 12997], [14, 13457], [24, 14017], [26, 14157], [34, 14717], [36, 15297], [39, 15477], [43, 15637], [54, 16237], [57, 16377], [63, 17459], [68, 17621], [81, 18561], [85, 18721], [88, 18861], [95, 19161], [98, 19361], [106, 19921], [108, 20361], [114, 20661], [117, 20901], [127, 21561], [130, 21801], [133, 21881], [140, 22301], [143, 22421]]}, {"verse": 3, "start": 23764, "end": 30492, "text": "Pero la fortaleza de Faraón se os tornará en vergüenza, y el amparo en la sombra de Egipto en confusión.", "words": [[0, 23764], [5, 23902], [8, 24042], [18, 24722], [21, 25072], [28, 25422], [31, 25922], [34, 26082], [42, 26602], [45, 26722], [56, 27342], [58, 27682], [61, 27802], [68, 28342], [71, 28462], [74, 28562], [81, 29002], [84, 29142], [91, 29622], [94, 29722]]}, {"verse": 4, "start": 31179, "end": 35950, "text": "Cuando estarán sus príncipes en Zoán, y sus embajadores habrán llegado a Hanes,", "words": [[0, 31179], [7, 31340], [15, 31840], [19, 32020], [29, 32640], [32, 32960], [38, 33280], [40, 33540], [44, 33680], [56, 34360], [63, 34920], [71, 35300], [73, 35625]]}, {"verse": 5, "start": 36636, "end": 46507, "text": "Se avergonzarán todos del pueblo que no les aprovechará, ni los socorrerá, ni les traerá provecho; antes les será para vergüenza, y aun para deshonra.", "words": [[0, 36636], [3, 36802], [16, 37542], [22, 37782], [26, 38102], [33, 38442], [37, 38702], [40, 38882], [44, 39022], [57, 39982], [60, 40162], [64, 40702], [75, 41242], [78, 41362], [82, 41562], [89, 41962], [99, 43155], [105, 43537], [109, 43857], [114, 44137], [119, 44337], [130, 44957], [132, 45357], [136, 45557], [141, 45857]]}, {"verse": 6, "start": 47134, "end": 67148, "text": "Carga de las bestias del sur: Por tierra de tribulación y de angustia, de donde salen la leona y el león, la víbora y la serpiente que vuela, llevan sobre lomos de asnos sus riquezas, y sus tesoros sobre jorobas de camellos, a un pueblo que no les será de provecho.", "words": [[0, 47134], [6, 47401], [9, 47641], [13, 47801], [21, 48281], [25, 48421], [30, 49271], [34, 49415], [41, 49875], [44, 50235], [56, 51035], [58, 51195], [61, 51295], [71, 52335], [74, 52435], [80, 52635], [86, 53215], [89, 53455], [95, 53975], [97, 54175], [100, 54335], [106, 55315], [109, 55455], [116, 55975], [118, 56335], [121, 56455], [131, 57175], [135, 57355], [142, 58155], [149, 58635], [155, 58995], [161, 59555], [164, 59835], [170, 60295], [174, 60555], [184, 61836], [186, 61959], [190, 62119], [198, 62759], [204, 62979], [212, 63519], [215, 63639], [225, 64539], [227, 64819], [230, 64959], [237, 65279], [241, 65579], [244, 65789], [248, 65999], [253, 66259], [256, 66459]]}, {"verse": 7, "start": 67598, "end": 77485, "text": "Ciertamente Egipto en vano e inútilmente dará ayuda; por tanto yo le di voces, que su fortaleza sería estarse quietos.", "words": [[0, 67598], [12, 68323], [19, 68803], [22, 68963], [27, 69683], [29, 69823], [41, 70923], [46, 71583], [53, 72606], [57, 72730], [63, 73170], [66, 73510], [69, 73670], [72, 73850], [79, 74430], [83, 74930], [86, 75110], [96, 75850], [102, 76110], [110, 76690]]}, {"verse": 8, "start": 77785, "end": 88920, "text": "Ve pues ahora, y escribe esta visión en una tabla delante de ellos, y asiéntala en un libro, para que quede hasta el postrero día, para siempre por todos los siglos.", "words": [[0, 77785], [3, 77989], [8, 78269], [15, 78609], [17, 78869], [25, 79309], [30, 79629], [37, 80149], [40, 80349], [44, 80509], [50, 80929], [58, 81349], [61, 81489], [68, 81789], [70, 82449], [80, 83009], [83, 83289], [86, 83409], [93, 83749], [98, 84409], [102, 84569], [108, 84889], [114, 85169], [117, 85269], [126, 85769], [131, 86810], [136, 87010], [144, 87430], [148, 87730], [154, 87990], [158, 88270]]}, {"verse": 9, "start": 89613, "end": 95261, "text": "Que este pueblo es rebelde, hijos mentirosos, hijos que no quisieron oír la ley de Jehová;", "words": [[0, 89613], [4, 89731], [9, 89991], [16, 90371], [19, 90591], [28, 91391], [34, 91631], [46, 92851], [52, 93111], [56, 93371], [59, 93491], [69, 93951], [73, 94271], [76, 94411], [80, 94611], [83, 94751]]}, {"verse": 10, "start": 95948, "end": 106462, "text": "Que dicen a los videntes: No veáis; y a los profetas: No nos profeticéis lo recto, decidnos cosas halagüeñas, profetizad mentiras;", "words": [[0, 95948], [4, 96047], [10, 96367], [12, 96567], [16, 96687], [26, 97971], [29, 98173], [36, 99372], [38, 99475], [40, 99555], [44, 99655], [54, 101006], [57, 101192], [61, 101372], [73, 102072], [76, 102232], [83, 103052], [92, 103512], [98, 104312], [110, 105112], [121, 105652]]}, {"verse": 11, "start": 107138, "end": 113052, "text": "Dejad el camino, apartaos de la senda, haced cesar de nuestra presencia al Santo de Israel.", "words": [[0, 107138], [6, 107482], [9, 107582], [17, 108422], [26, 109022], [29, 109142], [32, 109242], [39, 110082], [45, 110422], [51, 110942], [54, 111042], [62, 111182], [72, 111882], [75, 112042], [81, 112342], [84, 112522]]}, {"verse": 12, "start": 113686, "end": 123850, "text": "Por tanto el Santo de Israel dice así: Porque desechasteis esta palabra, y confiasteis en violencia y en iniquidad, y en ello os habéis apoyado;", "words": [[0, 113686], [4, 113830], [10, 114140], [13, 114450], [19, 114790], [22, 115030], [29, 115470], [34, 115790], [39, 116538], [46, 116760], [59, 117740], [64, 117980], [73, 118460], [75, 118940], [87, 119760], [90, 119880], [100, 120560], [102, 120880], [105, 121020], [116, 121560], [118, 122100], [121, 122260], [126, 122500], [129, 122840], [136, 123140]]}, {"verse": 13, "start": 124544, "end": 134138, "text": "Por tanto os será este pecado como pared abierta que se va a caer, y como corcova en alto muro, cuya caída viene súbita y repentinamente.", "words": [[0, 124544], [4, 124688], [10, 124858], [13, 125028], [18, 125508], [23, 125868], [30, 126408], [35, 126688], [41, 127068], [49, 127628], [53, 127768], [56, 127928], [59, 128128], [61, 128228], [67, 129048], [69, 129128], [74, 129348], [82, 129968], [85, 130108], [90, 130328], [96, 131268], [101, 131448], [107, 131848], [113, 132188], [120, 132808], [122, 133028]]}, {"verse": 14, "start": 134842, "end": 147389, "text": "Y lo quebrará como se quiebra un vaso de alfarero, que sin misericordia lo hacen pedazos; tanto, que entre los pedazos no se halla tiesto para traer fuego del hogar, o para coger agua de la poza.", "words": [[0, 134842], [2, 134943], [5, 135063], [14, 135643], [19, 136203], [22, 136403], [30, 136823], [33, 136943], [38, 137283], [41, 137363], [51, 138203], [55, 138413], [59, 138623], [72, 139423], [75, 139583], [81, 139843], [90, 141199], [97, 141439], [101, 141679], [107, 141859], [111, 142079], [119, 142699], [122, 142919], [125, 143109], [131, 143299], [138, 143839], [143, 144039], [149, 144399], [155, 144639], [159, 144919], [166, 145779], [168, 145899], [173, 146079], [179, 146479], [184, 146659], [187, 146799], [190, 146899]]}, {"verse": 15, "start": 147970, "end": 161180, "text": "Porque así dijo el Señor Jehová, el Santo de Israel: En descanso y en reposo seréis salvos; en quietud y en confianza será vuestra fortaleza. Y no quisisteis,", "words": [[0, 147970], [7, 148174], [11, 148434], [16, 148834], [19, 148994], [25, 149254], [33, 150054], [36, 150154], [42, 150494], [45, 150754], [53, 151726], [56, 151888], [65, 152708], [67, 152948], [70, 153088], [77, 153568], [84, 154188], [92, 155407], [95, 155549], [103, 156109], [105, 156249], [108, 156369], [118, 157049], [123, 157409], [131, 157829], [142, 160013], [144, 160134], [147, 160254]]}, {"verse": 16, "start": 161630, "end": 173590, "text": "Sino que dijisteis: No, antes huiremos en caballos: por tanto vosotros huiréis. Sobre ligeros cabalgaremos: por tanto serán ligeros vuestros perseguidores.", "words": [[0, 161630], [5, 161911], [9, 162131], [20, 163360], [24, 163524], [30, 163844], [39, 164364], [42, 164504], [52, 165517], [56, 165663], [62, 166023], [71, 166723], [80, 167926], [86, 168191], [94, 168731], [108, 169987], [112, 170111], [118, 170491], [124, 171011], [132, 171671], [141, 172231]]}, {"verse": 17, "start": 174040, "end": 187486, "text": "Un millar huirá a la amenaza de uno; a la amenaza de cinco huiréis vosotros todos; hasta que quedéis como mástil en la cumbre de un monte, y como bandera sobre cabezo.", "words": [[0, 174040], [3, 174287], [10, 175007], [16, 175687], [18, 175887], [21, 176027], [29, 176607], [32, 176827], [37, 177610], [39, 177919], [42, 178019], [50, 178559], [53, 178739], [59, 179179], [67, 179959], [76, 180659], [83, 181761], [89, 181966], [93, 182146], [101, 182566], [106, 182806], [113, 183546], [116, 183786], [119, 183946], [126, 184406], [129, 184566], [132, 184706], [139, 185206], [141, 185646], [146, 185906], [154, 186446], [160, 186706]]}, {"verse": 18, "start": 187936, "end": 201889, "text": "Pero Jehová esperará para tener piedad de vosotros, y por tanto será exaltado teniendo de vosotros misericordia: porque Jehová es Dios de juicio: bienaventurados todos los que le esperan.", "words": [[0, 187936], [5, 188078], [12, 188618], [21, 189318], [26, 189558], [32, 189878], [39, 190458], [42, 190618], [52, 191198], [54, 191638], [58, 191798], [64, 192318], [69, 193038], [78, 194038], [87, 194558], [90, 194678], [99, 195198], [113, 196593], [120, 196914], [127, 197274], [130, 197454], [135, 197814], [138, 198054], [146, 199644], [162, 200204], [168, 200564], [172, 200844], [176, 201044], [179, 201184]]}, {"verse": 19, "start": 202339, "end": 215248, "text": "Ciertamente el pueblo morará en Sion, en Jerusalén: nunca más llorarás; el que tiene misericordia se apiadará de ti; al oír la voz de tu clamor te responderá.", "words": [[0, 202339], [12, 203123], [15, 203283], [22, 203603], [29, 204183], [32, 204363], [38, 205063], [41, 205123], [52, 206307], [58, 206947], [62, 207327], [72, 208788], [75, 209049], [79, 209169], [85, 209429], [98, 210389], [101, 210909], [110, 211429], [113, 211629], [117, 212545], [120, 212728], [124, 213068], [127, 213228], [131, 213468], [134, 213628], [137, 213868], [144, 214108], [147, 214348]]}, {"verse": 20, "start": 215698, "end": 226543, "text": "Bien que os dará el Señor pan de congoja y agua de angustia, con todo, tus maestros nunca más te serán quitados, sino que tus ojos verán tus maestros.", "words": [[0, 215698], [5, 215963], [9, 216163], [12, 216283], [17, 216583], [20, 216663], [26, 216903], [30, 217403], [33, 217503], [41, 218123], [43, 218263], [48, 218523], [51, 218683], [61, 219403], [65, 219523], [71, 220023], [75, 220603], [84, 221743], [90, 222083], [94, 222543], [97, 222723], [103, 223083], [113, 224103], [118, 224363], [122, 224563], [126, 224763], [131, 225023], [137, 225443], [141, 225623]]}, {"verse": 21, "start": 226993, "end": 237210, "text": "Entonces tus oídos oirán a tus espaldas palabra que diga: Este es el camino, andad por él; y no echéis a la mano derecha, ni tampoco torzáis a la mano izquierda.", "words": [[0, 226993], [9, 227393], [13, 227713], [19, 228293], [25, 228853], [27, 229033], [31, 229153], [40, 229953], [48, 230213], [52, 230493], [58, 231233], [63, 231455], [66, 231595], [69, 231695], [77, 232455], [83, 232715], [87, 232915], [91, 233535], [93, 233637], [96, 233757], [103, 234077], [105, 234217], [108, 234277], [113, 234457], [122, 235177], [125, 235297], [133, 235727], [141, 236157], [143, 236317], [146, 236397], [151, 236577]]}, {"verse": 22, "start": 237560, "end": 251765, "text": "Entonces profanarás la cobertura de tus esculturas de plata, y la vestidura de tu vaciadizo de oro: las apartarás como trapo de menstruo: ¡Sal fuera! les dirás.", "words": [[0, 237560], [9, 238208], [20, 239568], [23, 239708], [33, 240348], [36, 240528], [40, 240708], [51, 241428], [54, 241548], [61, 241868], [63, 242308], [66, 242448], [76, 243048], [79, 243208], [82, 243368], [92, 244068], [95, 244288], [100, 244991], [104, 245102], [114, 245822], [119, 246022], [125, 246562], [128, 246642], [138, 247633], [143, 247881], [150, 250781], [154, 250988]]}, {"verse": 23, "start": 252215, "end": 267663, "text": "Entonces dará el Señor lluvia a tu sementera, cuando siembres la tierra; y pan del fruto de la tierra; y será abundante y sustancioso; tus ganados en aquel tiempo serán apacentados en amplias praderas.", "words": [[0, 252215], [9, 252736], [14, 253596], [17, 253776], [23, 254116], [30, 254856], [32, 255056], [35, 255446], [46, 255836], [53, 256326], [62, 256816], [65, 256956], [73, 257796], [75, 257921], [79, 258241], [83, 258501], [89, 258981], [92, 259101], [95, 259201], [103, 260094], [105, 260354], [110, 260574], [120, 261474], [122, 261594], [135, 262931], [139, 263057], [147, 263517], [150, 263697], [156, 263997], [163, 264257], [169, 264797], [181, 265637], [184, 265897], [192, 266457]]}, {"verse": 24, "start": 268113, "end": 275922, "text": "Tus bueyes y tus asnos que labran la tierra, comerán grano limpio, el cual será aventado con pala y criba.", "words": [[0, 268261], [4, 268441], [11, 268621], [13, 268801], [17, 268941], [23, 269361], [27, 269601], [34, 270001], [37, 270121], [45, 270541], [53, 271621], [59, 272121], [67, 272781], [70, 272961], [75, 273161], [80, 273521], [89, 274301], [93, 274521], [98, 275201], [100, 275597]]}, {"verse": 25, "start": 276372, "end": 286916, "text": "Y sobre todo monte alto, y sobre todo collado subido, habrá ríos y corrientes de aguas el día de la gran matanza, cuando caerán las torres.", "words": [[0, 276372], [2, 276490], [8, 276690], [13, 277070], [19, 277510], [25, 278130], [27, 278870], [33, 279110], [38, 279470], [46, 279990], [54, 280730], [60, 281350], [65, 281750], [67, 281890], [78, 282450], [81, 282690], [87, 283050], [90, 283210], [94, 283450], [97, 283590], [100, 283730], [105, 283970], [114, 284730], [121, 285370], [128, 285910], [132, 286439]]}, {"verse": 26, "start": 287366, "end": 301660, "text": "Y la luz de la luna será como la luz del sol, y la luz del sol siete veces mayor, como la luz de siete días, el día que soldará Jehová la quebradura de su pueblo, y curará la llaga de su herida.", "words": [[0, 287366], [2, 287489], [5, 287629], [9, 287869], [12, 288090], [15, 288230], [20, 288609], [25, 288910], [30, 289249], [33, 289429], [37, 289689], [41, 289889], [46, 290350], [48, 291129], [51, 291269], [55, 291489], [59, 291670], [63, 292189], [69, 292809], [75, 293189], [82, 293730], [87, 294369], [90, 294569], [94, 294889], [97, 295189], [103, 295509], [109, 296592], [112, 296757], [116, 297057], [120, 297277], [128, 297757], [135, 298257], [138, 298357], [149, 298917], [152, 299137], [155, 299297], [163, 299637], [165, 299817], [172, 300277], [175, 300527], [181, 300777], [184, 300957], [187, 301137]]}, {"verse": 27, "start": 302110, "end": 313312, "text": "He aquí que el nombre de Jehová viene de lejos: su rostro encendido, y grave de sufrir; sus labios llenos de ira, y su lengua como fuego que consume;", "words": [[0, 302110], [3, 302238], [8, 302518], [12, 302678], [15, 302838], [22, 303158], [25, 303358], [32, 303818], [38, 303998], [41, 304178], [48, 305100], [51, 305302], [58, 305902], [69, 306762], [71, 307162], [77, 307522], [80, 307742], [88, 308747], [92, 308911], [99, 309391], [106, 309811], [109, 309951], [114, 310791], [116, 311051], [119, 311191], [126, 311651], [131, 311871], [137, 312211], [141, 312491]]}, {"verse": 28, "start": 313762, "end": 327245, "text": "Y su aliento, cual torrente que inunda: llegará hasta el cuello, para zarandear a las naciones con criba de destrucción; y el freno estará en las quijadas de los pueblos, haciéndoles errar.", "words": [[0, 313762], [2, 313868], [5, 313988], [14, 314928], [19, 315208], [28, 315708], [32, 315948], [40, 317195], [48, 317435], [54, 317695], [57, 317835], [65, 318435], [70, 318895], [80, 319675], [82, 319735], [86, 319915], [95, 320455], [99, 320855], [105, 321255], [108, 321415], [121, 322946], [123, 323051], [126, 323171], [132, 323651], [139, 324111], [142, 324211], [146, 324331], [155, 324931], [158, 325071], [162, 325191], [171, 325771], [183, 326471]]}, {"verse": 29, "start": 327695, "end": 340091, "text": "Vosotros tendréis canción, como en noche en que se celebra pascua; y alegría de corazón, como el que va con flauta para venir al monte de Jehová, al Fuerte de Israel.", "words": [[0, 327695], [9, 328200], [18, 328880], [27, 329400], [32, 329630], [35, 329860], [41, 330300], [44, 330720], [48, 330860], [51, 331020], [59, 331580], [67, 332618], [69, 332774], [77, 333294], [80, 333434], [89, 334574], [94, 335014], [97, 335234], [101, 335414], [104, 335574], [108, 335794], [115, 336394], [120, 336654], [126, 336954], [129, 337174], [135, 337534], [138, 337714], [146, 338254], [149, 338454], [156, 338894], [159, 339234]]}, {"verse": 30, "start": 340541, "end": 352907, "text": "Y Jehová hará oír su voz potente, y hará ver el descender de su brazo, con furor de rostro, y llama de fuego consumidor; con dispersión, con avenida, y piedra de granizo.", "words": [[0, 340541], [2, 340657], [9, 341137], [14, 341437], [18, 341777], [21, 341997], [25, 342217], [34, 342857], [36, 343117], [41, 343377], [45, 343477], [48, 343657], [58, 344257], [61, 344417], [64, 344597], [71, 345157], [75, 345667], [81, 346177], [84, 346297], [92, 346937], [94, 347257], [100, 347497], [103, 347697], [109, 347997], [121, 349429], [125, 349551], [137, 350691], [141, 350811], [150, 351351], [152, 351631], [159, 352071], [162, 352211]]}, {"verse": 31, "start": 353357, "end": 358987, "text": "Porque Assur que hirió con palo, con la voz de Jehová será quebrantado.", "words": [[0, 353357], [7, 354013], [13, 354703], [17, 354943], [23, 355183], [27, 355383], [33, 356243], [37, 356523], [40, 356703], [44, 356943], [47, 357303], [54, 357723], [59, 357943]]}, {"verse": 32, "start": 359437, "end": 370716, "text": "Y en todo paso habrá madero fundado, que Jehová hará hincar sobre él con tamboriles y vihuelas, cuando con batallas de altura peleará contra ellos.", "words": [[0, 359437], [2, 359575], [5, 359715], [10, 359995], [15, 360495], [21, 361375], [28, 361735], [37, 362395], [41, 363135], [48, 363655], [53, 364035], [60, 364415], [66, 364775], [69, 365055], [73, 365255], [84, 366035], [86, 366355], [96, 367195], [103, 367675], [107, 367995], [116, 368495], [119, 368675], [126, 368995], [134, 369655], [141, 369955]]}, {"verse": 33, "start": 371166, "end": 384680, "text": "Porque Tofet ya de tiempo está destinada y preparada para el rey, profunda y ancha; cuyo foco es de fuego, y mucha leña; el soplo de Jehová, como torrente de azufre, la enciende.", "words": [[0, 371166], [7, 371429], [13, 371989], [16, 372349], [19, 372509], [26, 372849], [31, 373129], [41, 373729], [43, 373849], [53, 374449], [58, 374689], [61, 374909], [66, 375789], [75, 376469], [77, 376809], [84, 377690], [89, 377956], [94, 378296], [97, 378416], [100, 378516], [107, 378876], [109, 379396], [115, 379696], [121, 380639], [124, 380806], [130, 381246], [133, 381406], [141, 381867], [146, 382026], [155, 382566], [158, 382766], [166, 383326], [169, 383806]]}]}