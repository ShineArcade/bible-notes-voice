{"book": "ISA", "chapter": 29, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 255484, "verses": [{"verse": 1, "start": 300, "end": 7211, "text": "¡Ay de Ariel, ciudad donde habitó David! Añadid un año a otro, mátense víctimas.", "words": [[0, 516], [4, 756], [7, 1016], [14, 1376], [21, 2116], [27, 2356], [34, 2936], [41, 3738], [48, 4278], [51, 4558], [55, 4818], [57, 4978], [63, 5938], [71, 6378]]}, {"verse": 2, "start": 7511, "end": 14118, "text": "Mas yo pondré a Ariel en apretura, y será desconsolada y triste; y será a mí como Ariel.", "words": [[0, 7511], [4, 7717], [7, 7897], [14, 8377], [16, 8517], [22, 8777], [25, 9077], [35, 9657], [37, 10117], [42, 10377], [55, 11337], [57, 11477], [65, 12645], [67, 12768], [72, 12988], [74, 13188], [77, 13328], [82, 13568]]}, {"verse": 3, "start": 14815, "end": 21949, "text": "Porque asentaré campo contra ti en derredor, y te combatiré con ingenios, y levantaré contra ti baluartes.", "words": [[0, 14815], [7, 15039], [16, 15579], [22, 15979], [29, 16399], [32, 16659], [35, 16779], [45, 17379], [47, 17819], [50, 17939], [60, 18639], [64, 18779], [74, 19519], [76, 19879], [86, 20439], [93, 20779], [96, 21364]]}, {"verse": 4, "start": 22534, "end": 35123, "text": "Entonces serás humillada, hablarás desde la tierra, y tu habla saldrá del polvo; y será tu voz de la tierra como de pythón, y tu habla susurrará desde el polvo.", "words": [[0, 22534], [9, 23242], [15, 23742], [26, 24722], [35, 25342], [41, 25702], [44, 25942], [52, 26302], [54, 26822], [57, 27002], [63, 27282], [70, 27822], [74, 28002], [81, 29130], [83, 29240], [88, 29420], [91, 29640], [95, 29980], [98, 30220], [101, 30340], [108, 30660], [113, 31020], [116, 31460], [124, 31900], [126, 32180], [129, 32360], [135, 32660], [145, 33540], [151, 34000], [154, 34420]]}, {"verse": 5, "start": 35573, "end": 46906, "text": "Y la muchedumbre de tus extranjeros será como polvo menudo, y la multitud de los fuertes como tamo que pasa; y será repentinamente, en un momento.", "words": [[0, 35573], [2, 35696], [5, 35816], [17, 36536], [20, 36676], [24, 36876], [36, 37916], [41, 38296], [46, 38596], [52, 39176], [60, 39736], [62, 40376], [65, 40536], [74, 41176], [77, 41376], [81, 41496], [89, 42096], [94, 42336], [99, 42836], [103, 42956], [109, 43994], [111, 44119], [116, 44379], [132, 45539], [135, 45999], [138, 46159]]}, {"verse": 6, "start": 47356, "end": 57722, "text": "De Jehová de los ejércitos serás visitada con truenos y con terremotos y con gran ruido, con torbellino y tempestad, y llama de fuego consumidor.", "words": [[0, 47356], [3, 47564], [10, 48064], [13, 48165], [17, 48344], [27, 49104], [33, 49524], [42, 50104], [46, 50344], [54, 50884], [56, 51024], [60, 51244], [71, 52004], [73, 52144], [77, 52344], [82, 52584], [89, 53144], [93, 53384], [104, 54044], [106, 54144], [117, 55004], [119, 55524], [125, 55864], [128, 56225], [134, 56585]]}, {"verse": 7, "start": 58172, "end": 72517, "text": "Y será como sueño de visión nocturna la multitud de todas las naciones que pelearán contra Ariel, y todos los que pelearán contra ella y sus ingenios, y los que la pondrán en apretura.", "words": [[0, 58172], [2, 58290], [7, 58530], [12, 58810], [18, 59270], [21, 59390], [28, 59790], [37, 60550], [40, 61130], [49, 61870], [52, 62070], [58, 62370], [62, 62890], [71, 63570], [75, 63810], [84, 64470], [91, 64810], [98, 65430], [100, 66090], [106, 66510], [110, 67170], [114, 67330], [123, 67950], [130, 68290], [135, 68710], [137, 68930], [141, 69159], [151, 70169], [153, 70549], [157, 70689], [161, 70829], [164, 70949], [172, 71529], [175, 72036]]}, {"verse": 8, "start": 72967, "end": 93433, "text": "Y será como el que tiene hambre y sueña, y parece que come; pero cuando despierta, su alma está vacía; o como el que tiene sed y sueña, y parece que bebe; pero cuando se despierta, hállase cansado, y su alma sedienta: así será la multitud de todas las naciones que pelearán contra el monte de Sion.", "words": [[0, 72967], [2, 73088], [7, 73348], [12, 73688], [15, 73868], [19, 73988], [25, 74348], [32, 74868], [34, 75008], [41, 75828], [43, 76068], [50, 76408], [54, 76608], [60, 77522], [65, 77666], [72, 77906], [83, 78746], [86, 78926], [91, 79206], [96, 79426], [103, 80432], [105, 80575], [110, 80775], [113, 80935], [117, 81075], [123, 81375], [127, 81775], [129, 81995], [136, 82635], [138, 82855], [145, 83195], [149, 83495], [155, 84380], [160, 84523], [167, 84783], [170, 85063], [181, 85733], [189, 86403], [198, 87103], [200, 87243], [203, 87383], [208, 87985], [218, 88855], [222, 89033], [227, 89333], [230, 89473], [239, 89993], [242, 90193], [248, 90473], [252, 90753], [261, 91193], [265, 91393], [274, 91993], [281, 92273], [284, 92580], [290, 92888], [293, 93195]]}, {"verse": 9, "start": 93883, "end": 102024, "text": "Deteneos y maravillaos; ofuscaos y cegad; embriagaos, y no de vino; titubead, y no de sidra.", "words": [[0, 93883], [9, 94780], [11, 95361], [24, 96189], [33, 96925], [35, 97339], [42, 97986], [54, 98950], [56, 99330], [59, 99450], [62, 99610], [68, 100388], [78, 101011], [80, 101211], [83, 101506], [86, 101800]]}, {"verse": 10, "start": 102474, "end": 112649, "text": "Porque Jehová extendió sobre vosotros espíritu de sueño, y cerró vuestros ojos: cubrió vuestros profetas, y vuestros principales videntes.", "words": [[0, 102474], [7, 102679], [14, 103139], [23, 103819], [29, 104139], [38, 104739], [47, 105539], [50, 105639], [57, 106359], [59, 106579], [65, 106999], [74, 107479], [80, 108412], [87, 108731], [96, 109111], [106, 109751], [108, 110271], [117, 110611], [129, 111251]]}, {"verse": 11, "start": 113099, "end": 124658, "text": "Y os será toda visión como palabras de libro sellado, el cual si dan al que sabe leer, y le dicen: Lee ahora esto; él dirá: No puedo, porque está sellado.", "words": [[0, 113160], [2, 113260], [5, 113360], [10, 113800], [15, 114100], [22, 114660], [27, 114940], [36, 115340], [39, 115580], [45, 115860], [54, 116940], [57, 117060], [62, 117450], [65, 117840], [69, 118120], [72, 118400], [76, 118540], [81, 118820], [87, 119340], [89, 119800], [92, 119900], [99, 120960], [103, 121130], [109, 121290], [115, 122126], [118, 122308], [124, 123095], [127, 123251], [134, 123491], [141, 123811], [146, 124091]]}, {"verse": 12, "start": 125008, "end": 133108, "text": "Y si se da el libro al que no sabe leer, diciéndole: Lee ahora esto; él dirá: No sé leer.", "words": [[0, 125008], [2, 125211], [5, 125411], [8, 125651], [11, 125931], [14, 126131], [20, 126551], [23, 126971], [27, 127151], [30, 127311], [35, 127591], [41, 128511], [53, 129972], [57, 130142], [63, 130302], [69, 131138], [72, 131320], [78, 132107], [81, 132313], [84, 132513]]}, {"verse": 13, "start": 133457, "end": 146356, "text": "Dice pues el Señor: Porque este pueblo se me acerca con su boca, y con sus labios me honra, pero su corazón alejó de mí, y su temor para conmigo fue enseñado por mandamiento de hombres:", "words": [[0, 133457], [5, 133746], [10, 134006], [13, 134286], [20, 135093], [27, 135317], [32, 135537], [39, 135937], [42, 136177], [45, 136317], [52, 136757], [56, 137057], [59, 137257], [65, 137597], [67, 138197], [71, 138377], [75, 138557], [82, 138997], [85, 139197], [92, 139977], [97, 140117], [100, 140317], [108, 140757], [114, 141357], [117, 141477], [121, 142343], [123, 142446], [126, 142566], [132, 142966], [137, 143146], [145, 143746], [149, 144146], [158, 144786], [162, 144966], [174, 145546], [177, 145766]]}, {"verse": 14, "start": 147041, "end": 159042, "text": "Por tanto, he aquí que nuevamente excitaré yo la admiración de este pueblo con un prodigio grande y espantoso; porque perecerá la sabiduría de sus sabios, y se desvanecerá la prudencia de sus prudentes.", "words": [[0, 147041], [4, 147140], [11, 147760], [14, 147840], [19, 148080], [23, 148240], [34, 148780], [43, 149320], [46, 149460], [49, 149600], [60, 150180], [63, 150340], [68, 150500], [75, 150900], [79, 151200], [82, 151320], [91, 151820], [98, 152120], [100, 152340], [111, 153721], [118, 153932], [127, 154472], [130, 154572], [140, 155172], [143, 155272], [147, 155432], [155, 155972], [157, 156372], [160, 156512], [172, 157272], [175, 157372], [185, 157912], [188, 158052], [192, 158192]]}, {"verse": 15, "start": 159638, "end": 169988, "text": "¡Ay de los que se esconden de Jehová, encubriendo el consejo, y sus obras son en tinieblas, y dicen: ¿Quién nos ve, y quién nos conoce?", "words": [[0, 159763], [4, 159923], [7, 160103], [11, 160223], [15, 160383], [18, 160543], [27, 161103], [30, 161323], [38, 162183], [50, 163223], [53, 163343], [62, 164583], [64, 164763], [68, 164903], [74, 165343], [78, 165823], [81, 166003], [92, 166803], [94, 167223], [101, 168098], [108, 168240], [112, 168460], [116, 168700], [118, 168980], [124, 169220], [128, 169380]]}, {"verse": 16, "start": 170338, "end": 182739, "text": "Vuestra subversión ciertamente será reputada como el barro del alfarero. ¿La obra dirá de su hacedor, No me hizo; y dirá el vaso de aquel que lo ha formado, No entendió?", "words": [[0, 170338], [8, 170826], [19, 171846], [31, 172766], [36, 173046], [45, 173766], [50, 174046], [53, 174246], [59, 174686], [63, 174806], [73, 176167], [77, 176276], [82, 176576], [87, 176936], [90, 177036], [93, 177256], [102, 178156], [105, 178376], [108, 178556], [114, 179370], [116, 179473], [121, 179773], [124, 179913], [129, 180333], [132, 180453], [138, 180853], [142, 180973], [145, 181113], [148, 181213], [157, 181893], [160, 181953]]}, {"verse": 17, "start": 183189, "end": 190284, "text": "¿No será tornado de aquí a muy poco tiempo el Líbano en Carmelo, y el Carmelo será estimado por bosque?", "words": [[0, 183189], [4, 183414], [9, 183674], [17, 184394], [20, 184554], [25, 184834], [27, 184994], [31, 185174], [36, 185474], [43, 185834], [46, 186134], [53, 186434], [56, 186554], [65, 187054], [67, 187614], [70, 187814], [78, 188434], [83, 188714], [92, 189354], [96, 189614]]}, {"verse": 18, "start": 190734, "end": 199878, "text": "Y en aquel tiempo los sordos oirán las palabras del libro, y los ojos de los ciegos verán en medio de la oscuridad y de las tinieblas.", "words": [[0, 190734], [2, 190836], [5, 190956], [11, 191256], [18, 191616], [22, 191916], [29, 192696], [35, 193276], [39, 193436], [48, 193796], [52, 194096], [59, 194536], [61, 195116], [65, 195296], [70, 195576], [73, 195736], [77, 195856], [84, 196376], [90, 196976], [93, 197096], [99, 197456], [102, 197676], [105, 197816], [115, 198536], [117, 198776], [120, 198876], [124, 199016]]}, {"verse": 19, "start": 200328, "end": 208685, "text": "Entonces los humildes crecerán en alegría en Jehová, y los pobres de los hombres se gozarán en el Santo de Israel.", "words": [[0, 200328], [9, 200870], [13, 201530], [22, 202210], [31, 202810], [34, 202930], [42, 203450], [45, 203570], [53, 204370], [55, 204530], [59, 204670], [66, 205230], [69, 205410], [73, 205570], [81, 205990], [84, 206490], [92, 207070], [95, 207210], [98, 207330], [104, 207670], [107, 207970]]}, {"verse": 20, "start": 209135, "end": 217561, "text": "Porque el violento será acabado, y el burlador será consumido: serán destruidos todos los que madrugaban a la iniquidad.", "words": [[0, 209135], [7, 209357], [10, 209517], [19, 210097], [24, 210337], [33, 211077], [35, 211417], [38, 211557], [47, 212017], [52, 212337], [63, 213569], [69, 213933], [80, 214633], [86, 215073], [90, 215613], [94, 215813], [105, 216493], [107, 216633], [110, 216713]]}, {"verse": 21, "start": 218011, "end": 227088, "text": "Los que hacían pecar al hombre en palabra; los que armaban lazo al que reprendía en la puerta, y torcieron lo justo en vanidad.", "words": [[0, 218011], [4, 218331], [8, 218511], [15, 218871], [21, 219311], [24, 219471], [31, 219751], [34, 219971], [43, 221008], [47, 221135], [51, 221315], [59, 221855], [64, 222475], [67, 222955], [71, 223115], [81, 223855], [84, 223955], [87, 224075], [95, 224495], [97, 225115], [107, 225795], [110, 225975], [116, 226235], [119, 226475]]}, {"verse": 22, "start": 227538, "end": 237851, "text": "Por tanto, Jehová que redimió a Abraham, dice así a la casa de Jacob: No será ahora confundido Jacob, ni su rostro se pondrá pálido;", "words": [[0, 227538], [4, 227662], [11, 228162], [18, 228575], [22, 228989], [30, 229402], [32, 229642], [41, 230942], [46, 231202], [50, 231642], [52, 231862], [55, 231962], [60, 232282], [63, 232502], [70, 233489], [73, 233671], [78, 233951], [84, 234311], [95, 234931], [102, 235791], [105, 235991], [108, 236171], [115, 236671], [118, 236811], [125, 237231]]}, {"verse": 23, "start": 238531, "end": 248507, "text": "Porque verá a sus hijos, obra de mis manos en medio de sí, que santificarán mi nombre; y santificarán al Santo de Jacob, y temerán al Dios de Israel.", "words": [[0, 238531], [7, 238715], [12, 239075], [14, 239135], [18, 239295], [25, 239655], [30, 240395], [33, 240575], [37, 240695], [43, 241055], [46, 241275], [52, 241555], [55, 241755], [59, 241995], [63, 242375], [76, 243155], [79, 243275], [87, 244324], [89, 244427], [102, 245307], [105, 245527], [111, 245867], [114, 246067], [121, 246387], [123, 246807], [131, 247327], [134, 247527], [139, 247747], [142, 247947]]}, {"verse": 24, "start": 249184, "end": 254832, "text": "Y los errados de espíritu aprenderán inteligencia, y los murmuradores aprenderán doctrina.", "words": [[0, 249184], [2, 249262], [6, 249552], [14, 249842], [17, 250002], [26, 250642], [37, 251182], [51, 252282], [53, 252562], [57, 252682], [70, 253362], [81, 254142]]}]}