{"book": "MRK", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 325116, "verses": [{"verse": 1, "start": 300, "end": 12400, "text": "Y otra vez comenzó a enseñar junto al mar, y se juntó a él mucha gente; tanto, que entrando él en un barco, se sentó en el mar: y toda la gente estaba en tierra junto al mar.", "words": [[0, 300], [2, 467], [7, 607], [11, 967], [19, 1587], [21, 1667], [29, 2187], [35, 2387], [38, 2647], [43, 2887], [45, 3347], [48, 3507], [54, 3967], [56, 4067], [59, 4167], [65, 4427], [72, 5400], [79, 5737], [83, 6197], [92, 6777], [95, 7037], [98, 7177], [101, 7297], [108, 7757], [111, 8117], [117, 8757], [120, 8897], [123, 9037], [128, 9719], [130, 9847], [135, 10047], [138, 10267], [144, 10507], [151, 10847], [154, 11067], [161, 11367], [167, 11707], [170, 11967]]}, {"verse": 2, "start": 12850, "end": 18956, "text": "Y les enseñaba por parábolas muchas cosas, y les decía en su enseñanza:", "words": [[0, 12850], [2, 12955], [6, 13115], [15, 13875], [19, 14115], [29, 14655], [36, 14955], [43, 16075], [45, 16155], [49, 16275], [55, 16715], [58, 16935], [61, 17035]]}, {"verse": 3, "start": 19406, "end": 22149, "text": "Oíd: He aquí, el sembrador salió a sembrar.", "words": [[0, 19699], [5, 20290], [8, 20290], [14, 20290], [17, 20438], [27, 20998], [33, 21418], [35, 21518]]}, {"verse": 4, "start": 22599, "end": 30399, "text": "Y aconteció sembrando, que una parte cayó junto al camino; y vinieron las aves del cielo y se la comieron.", "words": [[0, 22599], [2, 22778], [12, 23518], [23, 24138], [27, 24318], [31, 24478], [37, 24858], [42, 25398], [48, 25638], [51, 25878], [59, 26846], [61, 27158], [70, 27618], [74, 27858], [79, 28318], [83, 28578], [89, 29038], [91, 29278], [94, 29398], [97, 29518]]}, {"verse": 5, "start": 30849, "end": 39343, "text": "Y otra parte cayó en terreno pedregoso, donde no tenía mucha tierra; y luego salió, porque no tenía la tierra profunda:", "words": [[0, 30849], [2, 30997], [7, 31177], [13, 31497], [18, 31937], [21, 32037], [29, 32497], [40, 33457], [46, 34097], [49, 34507], [55, 34917], [61, 35197], [69, 36286], [71, 36407], [77, 36607], [84, 37167], [91, 37507], [94, 37707], [100, 38067], [103, 38247], [110, 38487]]}, {"verse": 6, "start": 39793, "end": 45194, "text": "Pero salido el sol, se quemó; y por cuanto no tenía raíz, se secó.", "words": [[0, 39793], [5, 39959], [12, 40439], [15, 40579], [20, 40919], [23, 41579], [30, 42412], [32, 42536], [36, 42676], [43, 42936], [46, 43286], [52, 43636], [58, 44436], [61, 44656]]}, {"verse": 7, "start": 45644, "end": 52649, "text": "Y otra parte cayó en espinas; y subieron las espinas, y la ahogaron, y no dio fruto.", "words": [[0, 45644], [2, 45911], [7, 46091], [13, 46451], [18, 46931], [21, 47011], [30, 48040], [32, 48163], [41, 48623], [45, 48863], [54, 49583], [56, 50183], [59, 50343], [69, 51083], [71, 51623], [74, 51803], [78, 51963]]}, {"verse": 8, "start": 53099, "end": 62598, "text": "Y otra parte cayó en buena tierra, y dio fruto, que subió y creció: y produjo a treinta, a sesenta y a ciento por uno.", "words": [[0, 53099], [2, 53244], [7, 53384], [13, 53804], [18, 54344], [21, 54504], [27, 54704], [35, 55144], [37, 55764], [41, 55944], [48, 56404], [52, 56604], [58, 57184], [60, 57724], [68, 58725], [70, 58847], [78, 59367], [80, 59667], [89, 59967], [91, 60507], [99, 61047], [101, 61300], [103, 61554], [110, 61807], [114, 62127]]}, {"verse": 9, "start": 63048, "end": 67433, "text": "Entonces les dijo: El que tiene oídos para oír, oiga.", "words": [[0, 63048], [9, 64096], [13, 64296], [19, 65169], [22, 65296], [26, 65416], [32, 65716], [38, 66216], [43, 66416], [48, 66736]]}, {"verse": 10, "start": 67883, "end": 74575, "text": "Y cuando estuvo solo, le preguntaron los que estaban cerca de él con los doce, sobre la parábola.", "words": [[0, 67883], [2, 68002], [9, 68181], [16, 68581], [22, 69041], [25, 69741], [37, 70502], [41, 70681], [45, 70821], [53, 71142], [59, 71541], [62, 71841], [65, 72021], [69, 72201], [73, 72401], [79, 72921], [85, 73642], [88, 73861]]}, {"verse": 11, "start": 75025, "end": 84048, "text": "Y les dijo: A vosotros es dado saber el misterio del reino de Dios; pero a los que están fuera, por parábolas todas las cosas;", "words": [[0, 75025], [2, 75123], [6, 75243], [12, 76055], [14, 76293], [23, 76643], [26, 76993], [31, 77273], [37, 77633], [40, 77873], [49, 78473], [53, 78653], [59, 79073], [62, 79213], [68, 80034], [73, 80195], [75, 80295], [79, 80395], [83, 80515], [89, 80735], [96, 81135], [100, 81995], [110, 82615], [116, 82955], [120, 83275]]}, {"verse": 12, "start": 84498, "end": 94866, "text": "Para que viendo, vean y no perciban; y oyendo, oigan y no entiendan: no sea que se conviertan, y les sean perdonados los pecados.", "words": [[0, 84498], [5, 84641], [9, 84821], [17, 85161], [22, 85761], [24, 85941], [27, 86081], [37, 87488], [39, 87814], [47, 88141], [53, 88541], [55, 88901], [58, 89061], [69, 90342], [72, 90511], [76, 90731], [80, 90891], [83, 91031], [95, 92271], [97, 92461], [101, 92651], [106, 92991], [117, 93811], [121, 94031]]}, {"verse": 13, "start": 95316, "end": 101821, "text": "Y les dijo: ¿No sabéis esta parábola? ¿Cómo, pues, entenderéis todas las parábolas?", "words": [[0, 95316], [2, 95414], [6, 95534], [12, 96347], [16, 96637], [23, 97237], [28, 97737], [38, 98893], [45, 99081], [51, 99421], [63, 100321], [69, 100761], [73, 101021]]}, {"verse": 14, "start": 102271, "end": 105046, "text": "El que siembra es el que siembra la palabra.", "words": [[0, 102271], [3, 102394], [7, 102514], [15, 103074], [18, 103354], [21, 103514], [25, 103634], [33, 104134], [36, 104374]]}, {"verse": 15, "start": 105496, "end": 116155, "text": "Y estos son los de junto al camino: en los que la palabra es sembrada: pero después que la oyeron, luego viene Satanás, y quita la palabra que fue sembrada en sus corazones.", "words": [[0, 105496], [2, 105660], [8, 105900], [12, 106300], [16, 106547], [19, 106793], [25, 107040], [28, 107140], [36, 108013], [39, 108141], [43, 108221], [47, 108361], [50, 108481], [58, 108781], [61, 108981], [71, 110009], [76, 110153], [84, 110433], [88, 110813], [91, 111193], [99, 111573], [105, 111753], [111, 112073], [120, 112773], [122, 113213], [128, 113513], [131, 113653], [139, 113953], [143, 114153], [147, 114313], [156, 114933], [159, 115013], [163, 115153]]}, {"verse": 16, "start": 116605, "end": 125101, "text": "Y asimismo estos son los que son sembrados en pedregales: los que cuando han oído la palabra, luego la reciben con alegría;", "words": [[0, 116605], [2, 116930], [11, 117290], [17, 117570], [21, 118030], [25, 118190], [29, 118310], [33, 118510], [43, 119110], [46, 119350], [58, 120812], [62, 120938], [66, 121178], [73, 121318], [77, 121558], [82, 121878], [85, 122058], [94, 123018], [100, 123198], [103, 123458], [111, 124018], [115, 124198]]}, {"verse": 17, "start": 125551, "end": 136381, "text": "Pero no tienen raíz en sí, sino que duran poco tiempo; cuando surge la tribulación o la persecución por causa de la palabra, enseguida se apartan.", "words": [[0, 125551], [5, 125677], [8, 125837], [15, 126157], [20, 126657], [23, 126817], [27, 127457], [32, 127677], [36, 127857], [42, 128157], [47, 128337], [55, 129379], [62, 129564], [68, 129984], [71, 130264], [83, 131084], [85, 131284], [88, 131424], [100, 132224], [104, 132424], [110, 132744], [113, 133044], [116, 133144], [125, 133984], [135, 134704], [138, 134884]]}, {"verse": 18, "start": 136831, "end": 141854, "text": "Y estos son los que son sembrados entre espinas: los que oyen la palabra;", "words": [[0, 136831], [2, 136831], [8, 136831], [12, 137463], [16, 137703], [20, 137863], [24, 138103], [34, 138803], [40, 139203], [49, 140407], [53, 140536], [57, 140716], [62, 141056], [65, 141176]]}, {"verse": 19, "start": 142304, "end": 152500, "text": "Pero las preocupaciones de este mundo, y el engaño de las riquezas, y los deseos de otras cosas, entrando, ahogan la palabra, y se hace infructuosa.", "words": [[0, 142304], [5, 142468], [9, 142648], [24, 143508], [27, 143708], [32, 143848], [39, 144188], [41, 144388], [44, 144488], [51, 144968], [54, 145108], [58, 145268], [68, 145888], [70, 146348], [74, 146508], [81, 146988], [84, 147088], [90, 147268], [97, 147708], [107, 148588], [114, 149408], [117, 149668], [126, 150208], [128, 150808], [131, 150968], [136, 151228]]}, {"verse": 20, "start": 152950, "end": 164351, "text": "Y estos son los que fueron sembrados en buena tierra: los que oyen la palabra, y la reciben, y dan fruto, uno a treinta, otro a sesenta y otro a ciento por uno.", "words": [[0, 152950], [2, 153134], [8, 153394], [12, 153834], [16, 153974], [20, 154154], [27, 154434], [37, 155114], [40, 155314], [46, 155534], [54, 156500], [58, 156625], [62, 156825], [67, 157125], [70, 157245], [79, 157765], [81, 158085], [84, 158225], [93, 159405], [95, 159485], [99, 159665], [106, 160265], [110, 160865], [112, 161085], [121, 161705], [126, 161905], [128, 162105], [136, 162625], [138, 162865], [143, 163045], [145, 163265], [152, 163485], [156, 163905]]}, {"verse": 21, "start": 164801, "end": 175144, "text": "También les dijo: ¿Se trae la lámpara para ser puesta debajo de una canasta, o debajo de la cama? ¿No es para ser puesta en el soporte para lámpara?", "words": [[0, 164801], [8, 165107], [12, 165327], [18, 166168], [22, 166309], [27, 166609], [30, 166729], [38, 167229], [43, 167429], [47, 167669], [54, 168089], [61, 168489], [64, 168649], [68, 168769], [77, 169349], [79, 169849], [86, 170229], [89, 170349], [92, 170469], [98, 171298], [102, 171484], [105, 171824], [110, 172324], [114, 172544], [121, 173064], [124, 173204], [127, 173344], [135, 173964], [140, 174579]]}, {"verse": 22, "start": 175594, "end": 182445, "text": "Porque no hay nada oculto que no haya de ser manifestado, ni secreto que no haya de descubrirse.", "words": [[0, 175594], [7, 175818], [10, 176098], [14, 176278], [19, 176598], [26, 177318], [30, 177438], [33, 177658], [38, 177878], [41, 178098], [45, 178318], [58, 179128], [61, 179938], [69, 180558], [73, 180738], [76, 180958], [81, 181198], [84, 181398]]}, {"verse": 23, "start": 182895, "end": 186512, "text": "Si alguno tiene oídos para oír, oiga.", "words": [[0, 182895], [3, 183160], [10, 183580], [16, 183780], [22, 184220], [27, 184420], [32, 184900]]}, {"verse": 24, "start": 186962, "end": 195993, "text": "Les dijo también: Mirad lo que oís: con la medida que medís, os medirán otros, y se os añadirá a vosotros los que oís.", "words": [[0, 187080], [4, 187231], [9, 187383], [18, 187808], [24, 187808], [27, 187955], [31, 188336], [36, 188988], [40, 189132], [43, 189292], [50, 189612], [54, 190192], [61, 190772], [64, 190972], [72, 191592], [79, 192032], [81, 192892], [84, 193072], [87, 193272], [95, 194032], [97, 194172], [106, 194752], [110, 195192], [114, 195432]]}, {"verse": 25, "start": 196443, "end": 203375, "text": "Porque al que tiene, le será dado; y al que no tiene, aun lo que tiene le será quitado.", "words": [[0, 196443], [7, 196668], [10, 197008], [14, 197208], [21, 197668], [24, 198168], [29, 198428], [35, 199314], [37, 199438], [40, 199578], [44, 199758], [47, 199978], [54, 200878], [58, 201238], [61, 201538], [65, 201698], [71, 202118], [74, 202318], [79, 202618]]}, {"verse": 26, "start": 203825, "end": 209937, "text": "Decía más: Así es el reino de Dios, como si un hombre echa semilla en la tierra;", "words": [[0, 203825], [6, 204333], [11, 205337], [15, 205548], [18, 205828], [21, 206008], [27, 206428], [30, 206568], [36, 206868], [41, 207528], [44, 207728], [47, 207888], [54, 208128], [59, 208508], [67, 209068], [70, 209188], [73, 209308]]}, {"verse": 27, "start": 210387, "end": 216654, "text": "Y duerme, y se levanta de noche y de día, y la semilla brota y crece como él no sabe.", "words": [[0, 210387], [2, 210494], [10, 210954], [12, 211354], [15, 211454], [23, 211974], [26, 212054], [32, 212354], [34, 212534], [37, 212654], [42, 213494], [44, 213794], [47, 213914], [55, 214314], [61, 214754], [63, 214934], [69, 215394], [74, 215674], [77, 215934], [80, 216114]]}, {"verse": 28, "start": 217104, "end": 224408, "text": "Porque por sí sola fructifica la tierra, primero hierba, luego espiga, después grano lleno en la espiga;", "words": [[0, 217104], [7, 217346], [11, 217606], [14, 217806], [19, 218186], [30, 219086], [33, 219246], [41, 220086], [49, 220446], [57, 221406], [63, 221686], [71, 222766], [79, 223206], [85, 223606], [91, 224086], [94, 224194], [97, 224301]]}, {"verse": 29, "start": 224858, "end": 230921, "text": "Y cuando el fruto está maduro, enseguida se usa la hoz, porque ha llegado la cosecha.", "words": [[0, 224858], [2, 225424], [9, 225924], [12, 226164], [18, 226504], [23, 226704], [31, 227184], [41, 228184], [44, 228364], [48, 228564], [51, 228784], [56, 229004], [63, 229544], [66, 229704], [74, 230084], [77, 230204]]}, {"verse": 30, "start": 231371, "end": 237721, "text": "Y decía: ¿A qué asemejaremos el reino de Dios? ¿o con qué parábola le compararemos?", "words": [[0, 231371], [2, 231515], [9, 232407], [12, 232572], [16, 232672], [29, 233432], [32, 233672], [38, 234012], [41, 234152], [47, 234993], [50, 235138], [54, 235398], [58, 235678], [67, 236338], [70, 236598]]}, {"verse": 31, "start": 238171, "end": 245879, "text": "Es como el grano de mostaza, que, cuando se siembra en tierra, es la más pequeña de todas las semillas que hay en la tierra;", "words": [[0, 238171], [3, 238316], [8, 238516], [11, 238696], [17, 239076], [20, 239196], [29, 239876], [34, 240376], [41, 240956], [44, 241176], [52, 241596], [55, 241716], [63, 242136], [66, 242716], [69, 242836], [73, 242976], [81, 243296], [84, 243576], [90, 243816], [94, 244056], [103, 244496], [107, 244696], [111, 244916], [114, 245056], [117, 245176]]}, {"verse": 32, "start": 246329, "end": 258349, "text": "Pero después de sembrado, sube, y se hace la mayor de todas las plantas del huerto, y echa grandes ramas, de tal manera que las aves del cielo puedan refugiarse bajo su sombra.", "words": [[0, 246329], [5, 246473], [13, 246733], [16, 246933], [26, 247573], [32, 248493], [34, 249093], [37, 249293], [42, 249573], [45, 249793], [51, 250153], [54, 250413], [60, 250673], [64, 250973], [72, 251253], [76, 251533], [84, 251953], [86, 252493], [91, 252733], [99, 253113], [106, 254157], [109, 254261], [113, 254381], [120, 254701], [124, 254921], [128, 255081], [133, 255461], [137, 255621], [143, 255941], [150, 256421], [161, 257321], [166, 257481], [169, 257761]]}, {"verse": 33, "start": 258799, "end": 264251, "text": "Y con muchas tales parábolas les hablaba la palabra, conforme a lo que podían oír.", "words": [[0, 258799], [2, 258903], [6, 259083], [13, 259423], [19, 259803], [29, 260503], [33, 261023], [41, 261523], [44, 261643], [53, 262143], [62, 262603], [64, 263063], [67, 263203], [71, 263323], [78, 263723]]}, {"verse": 34, "start": 264701, "end": 270815, "text": "Y sin parábola no les hablaba; pero a sus discípulos en particular explicaba todo.", "words": [[0, 264701], [2, 264806], [6, 265006], [15, 265686], [18, 265866], [22, 266066], [31, 267036], [36, 267180], [38, 267300], [42, 267440], [53, 268480], [56, 268700], [67, 269360], [77, 270220]]}, {"verse": 35, "start": 271265, "end": 275831, "text": "Y les dijo aquel día cuando fue tarde: Pasemos de la otra parte.", "words": [[0, 271265], [2, 271392], [6, 271572], [11, 271992], [17, 272432], [21, 272672], [28, 272952], [32, 273252], [39, 274194], [47, 274560], [50, 274720], [53, 274860], [58, 275080]]}, {"verse": 36, "start": 276281, "end": 283044, "text": "Y despidiendo a la multitud, le tomaron como estaba, en el barco; y había también con él otras barcas.", "words": [[0, 276281], [2, 276400], [14, 276740], [16, 277080], [19, 277240], [29, 278240], [32, 278400], [40, 278800], [45, 279040], [53, 279340], [56, 279540], [59, 279640], [66, 280516], [68, 280801], [74, 280981], [82, 281401], [86, 281681], [89, 281861], [95, 282181]]}, {"verse": 37, "start": 283494, "end": 292041, "text": "Y se levantó una grande tempestad de viento, y echaba las olas en el barco, de tal manera que ya se llenaba.", "words": [[0, 283494], [2, 283613], [5, 283733], [13, 284233], [17, 284413], [24, 284813], [34, 285833], [37, 286033], [45, 286593], [47, 287473], [54, 287933], [58, 288153], [63, 288613], [66, 288773], [69, 288933], [76, 289913], [79, 290073], [83, 290293], [90, 290633], [94, 290933], [97, 291153], [100, 291333]]}, {"verse": 38, "start": 292491, "end": 301782, "text": "Y él estaba en la popa, durmiendo sobre una almohada, y le despertaron, y le dicen: ¿Maestro, no tienes cuidado que perecemos?", "words": [[0, 292491], [2, 292655], [5, 292835], [12, 293215], [15, 293415], [18, 293555], [24, 294435], [34, 295075], [40, 295395], [44, 295675], [54, 297115], [56, 297135], [59, 297255], [72, 298115], [74, 298455], [77, 298555], [84, 299434], [94, 300035], [97, 300115], [104, 300395], [112, 300795], [116, 300995]]}, {"verse": 39, "start": 302132, "end": 310713, "text": "Y levantándose, reprendió al viento, y dijo al mar: Calla, enmudece. Y cesó el viento, y fue hecha gran calma.", "words": [[0, 302132], [2, 302254], [16, 303334], [26, 303834], [29, 303974], [37, 304414], [39, 305074], [44, 305354], [47, 305534], [52, 306219], [59, 307085], [69, 308226], [71, 308433], [76, 308673], [79, 308913], [87, 309153], [89, 309313], [93, 309473], [99, 309733], [104, 309993]]}, {"verse": 40, "start": 311163, "end": 316654, "text": "Y a ellos dijo: ¿Por qué estáis así atemorizados? ¿Cómo no tenéis fe?", "words": [[0, 311163], [2, 311163], [4, 311477], [10, 311827], [16, 312798], [21, 313102], [25, 313262], [32, 313602], [36, 313922], [50, 315424], [56, 315590], [59, 315790], [66, 316210]]}, {"verse": 41, "start": 317104, "end": 324716, "text": "Y temieron con gran temor, y decían el uno al otro. ¿Quién es este, que aun el viento y el mar le obedecen?", "words": [[0, 317104], [2, 317286], [11, 317766], [15, 317986], [20, 318286], [27, 318826], [29, 319266], [36, 319906], [39, 320226], [43, 320486], [46, 320806], [52, 321611], [59, 321853], [62, 321993], [68, 322353], [72, 322553], [76, 322773], [79, 322973], [86, 323353], [88, 323493], [91, 323613], [95, 323793], [98, 323953]]}]}