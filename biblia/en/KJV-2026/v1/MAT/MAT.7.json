], [40, 79880], [43, 80100], [47, 80240], [53, 80880], [57, 80940], [63, 81300], [66, 81520], [70, 81660], [75, 82260], [80, 82460], [86, 82720], [89, 82980], [102, 83840], [106, 84100], [111, 84320], [117, 84540], [121, 84800], [127, 85100], [130, 85320], [133, 85520], [136, 85780]]}, {"verse": 14, "start": 86462, "end": 93238, "text": "Because narrow is the gate, and narrow is the way, which leads to life, and few there are that find it.", "words": [[0, 86462], [8, 86744], [15, 87224], [18, 87504], [22, 87664], [28, 87964], [32, 88484], [39, 88844], [42, 89084], [46, 89244], [51, 89524], [57, 90064], [63, 90404], [66, 90664], [72, 90964], [76, 91504], [80, 91844], [86, 92104], [90, 92364], [95, 92584], [100, 92904]]}, {"verse": 15, "start": 93688, "end": 99720, "text": "¶ Beware of false prophets, which come to you in sheep’s clothing, but inwardly they are ravening wolves.", "words": [[2, 93688], [9, 94030], [12, 94190], [18, 94430], [28, 95390], [34, 95570], [39, 95830], [42, 96030], [46, 96230], [49, 96370], [57, 96710], [67, 97450], [71, 97630], [80, 98250], [85, 98530], [89, 98670], [98, 99130]]}, {"verse": 16, "start": 100170, "end": 105254, "text": "You shall know them by their fruits. Do men gather grapes of thorns, or figs of thistles?", "words": [[0, 100170], [4, 100291], [10, 100491], [15, 100751], [20, 100931], [23, 101131], [29, 101291], [37, 102190], [40, 102311], [44, 102551], [51, 102911], [58, 103231], [61, 103431], [69, 103891], [72, 104191], [77, 104571], [80, 104651]]}, {"verse": 17, "start": 105704, "end": 111325, "text": "Even so every good tree brings forth good fruit; but a corrupt tree brings forth evil fruit.", "words": [[0, 105704], [5, 105922], [8, 106462], [14, 106662], [19, 106862], [24, 107162], [31, 107462], [37, 107822], [42, 108082], [49, 108879], [53, 108984], [55, 109064], [63, 109384], [68, 109744], [75, 110084], [81, 110404], [86, 110784]]}, {"verse": 18, "start": 111775, "end": 116598, "text": "A good tree cannot bring forth 