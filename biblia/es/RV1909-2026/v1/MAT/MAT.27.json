{"book": "MAT", "chapter": 27, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 517791, "verses": [{"verse": 1, "start": 300, "end": 11008, "text": "Y venida la mañana, entraron en consejo todos los príncipes de los sacerdotes, y los ancianos del pueblo, contra Jesús, para entregarle a muerte.", "words": [[0, 300], [2, 423], [9, 783], [12, 903], [20, 1903], [29, 2663], [32, 2823], [40, 3423], [46, 3743], [50, 4243], [60, 4883], [63, 5023], [67, 5143], [79, 5923], [81, 6343], [85, 6483], [94, 7023], [98, 7183], [106, 7663], [113, 8263], [120, 8743], [125, 9583], [136, 10363], [138, 10423]]}, {"verse": 2, "start": 11358, "end": 16277, "text": "Y le llevaron atado, y le entregaron a Poncio Pilato gobernador.", "words": [[0, 11358], [2, 11482], [5, 11642], [14, 12202], [21, 12922], [23, 13402], [26, 13542], [37, 14262], [39, 14382], [46, 14842], [53, 15367]]}, {"verse": 3, "start": 16627, "end": 28903, "text": "Entonces Judas, el que le había entregado, viendo que era condenado, volvió arrepentido las treinta piezas de plata a los príncipes de los sacerdotes y a los ancianos,", "words": [[0, 16627], [9, 17516], [16, 18359], [19, 18539], [23, 18699], [26, 18859], [32, 19139], [43, 20359], [50, 20619], [54, 20879], [58, 21079], [69, 22199], [76, 22719], [88, 23699], [92, 23899], [100, 24499], [107, 24959], [110, 25079], [116, 25399], [118, 25659], [122, 25779], [132, 26439], [135, 26559], [139, 26679], [150, 27459], [152, 27839], [154, 27899], [158, 28039]]}, {"verse": 4, "start": 29253, "end": 36823, "text": "Diciendo: Yo he pecado entregando la sangre inocente. Pero ellos dijeron: ¿Qué nos importa a nosotros? Allá tú.", "words": [[0, 29253], [10, 30281], [13, 30440], [16, 30580], [23, 31020], [34, 31580], [37, 31720], [44, 32040], [54, 33191], [59, 33336], [65, 33596], [74, 34581], [79, 34663], [83, 34803], [91, 35243], [93, 35383], [103, 36242], [108, 36521]]}, {"verse": 5, "start": 37103, "end": 42621, "text": "Y arrojando las piezas de plata en el templo, se partió; y fue, y se ahorcó.", "words": [[0, 37103], [2, 37244], [12, 37884], [16, 38184], [23, 38484], [26, 38604], [32, 38964], [35, 39124], [38, 39284], [46, 40004], [49, 40224], [57, 41043], [59, 41182], [64, 41342], [66, 41822], [69, 41922]]}, {"verse": 6, "start": 42971, "end": 52069, "text": "Y los príncipes de los sacerdotes, tomando las piezas de plata, dijeron: No es lícito echarlas en el tesoro de los dones, porque es precio de sangre.", "words": [[0, 42971], [2, 43060], [6, 43180], [16, 43920], [19, 44040], [23, 44180], [35, 45040], [43, 45680], [47, 45860], [54, 46220], [57, 46340], [64, 46720], [73, 47569], [76, 47727], [79, 47907], [86, 48287], [95, 48947], [98, 49147], [101, 49377], [108, 49607], [111, 49747], [115, 49867], [122, 50567], [129, 50927], [132, 51107], [139, 51387], [142, 51567]]}, {"verse": 7, "start": 52349, "end": 59336, "text": "Pero habido consejo, compraron con ellas el campo del alfarero, por sepultura para los extranjeros.", "words": [[0, 52349], [5, 52637], [12, 52817], [21, 53417], [31, 54097], [35, 54297], [41, 54557], [44, 54797], [50, 55277], [54, 55537], [64, 56337], [68, 57017], [78, 57797], [83, 58077], [87, 58277]]}, {"verse": 8, "start": 59686, "end": 64443, "text": "Por lo cual fue llamado aquel campo, Campo de sangre, hasta el día de hoy.", "words": [[0, 59686], [4, 59810], [7, 59950], [12, 60150], [16, 60330], [24, 60670], [30, 61050], [37, 61870], [43, 62310], [46, 62510], [54, 63250], [60, 63530], [63, 63690], [67, 63870], [70, 64050]]}, {"verse": 9, "start": 64793, "end": 75834, "text": "Entonces se cumplió lo que fue dicho por el profeta Jeremías, que dijo: Y tomaron las treinta piezas de plata, precio del apreciado, que fue apreciado por los hijos de Israel;", "words": [[0, 64793], [9, 65289], [12, 65629], [20, 66189], [23, 66329], [27, 66469], [31, 66649], [37, 66949], [41, 67189], [44, 67329], [52, 67809], [62, 68789], [66, 68849], [72, 69584], [74, 69690], [82, 70090], [86, 70400], [94, 70710], [101, 71190], [104, 71310], [111, 71770], [118, 72090], [122, 72370], [133, 73010], [137, 73470], [141, 73650], [151, 74250], [155, 74450], [159, 74610], [165, 74910], [168, 75090]]}, {"verse": 10, "start": 76184, "end": 80158, "text": "Y las dieron para el campo del alfarero, como me ordenó el Señor.", "words": [[0, 76184], [2, 76309], [6, 76449], [13, 76829], [18, 77109], [21, 77289], [27, 77609], [31, 77869], [41, 78589], [46, 78809], [49, 79029], [56, 79449], [59, 79529]]}, {"verse": 11, "start": 80508, "end": 90796, "text": "Y Jesús estuvo delante del gobernador; y el gobernador le preguntó, diciendo: ¿Eres tú el Rey de los judíos? Y Jesús le dijo: Tú lo dices.", "words": [[0, 80508], [2, 80630], [8, 81050], [15, 81650], [23, 82216], [27, 82781], [39, 83502], [41, 83666], [44, 83766], [55, 84446], [58, 84606], [68, 85226], [78, 86114], [84, 86301], [87, 86601], [90, 86781], [94, 87001], [97, 87061], [101, 87201], [109, 88190], [111, 88314], [117, 88694], [120, 89094], [126, 89859], [129, 89982], [132, 90102]]}, {"verse": 12, "start": 91146, "end": 97511, "text": "Y siendo acusado por los príncipes de los sacerdotes, y por los ancianos, nada respondió.", "words": [[0, 91146], [2, 91271], [9, 91571], [17, 92231], [21, 92451], [25, 92631], [35, 93231], [38, 93311], [42, 93451], [54, 94211], [56, 94371], [60, 94551], [64, 94731], [74, 95651], [79, 95971]]}, {"verse": 13, "start": 97861, "end": 102657, "text": "Pilato entonces le dice: ¿No oyes cuántas cosas testifican contra ti?", "words": [[0, 97861], [7, 98350], [16, 98830], [19, 99270], [25, 100105], [29, 100281], [34, 100581], [42, 101321], [48, 101321], [59, 102001], [66, 102281]]}, {"verse": 14, "start": 102937, "end": 109061, "text": "Y no le respondió ni una palabra; de tal manera que el gobernador se maravillaba mucho.", "words": [[0, 102937], [2, 103062], [5, 103222], [8, 103402], [18, 104102], [21, 104402], [25, 104642], [34, 105662], [37, 105801], [41, 106081], [48, 106441], [52, 106721], [55, 106901], [66, 107521], [69, 107721], [81, 108401]]}, {"verse": 15, "start": 109411, "end": 116480, "text": "Y en el día de la fiesta acostumbraba el gobernador soltar al pueblo un preso, el que quisiesen.", "words": [[0, 109411], [2, 109690], [5, 109830], [8, 109970], [12, 110270], [15, 110410], [18, 110530], [25, 111090], [38, 112030], [41, 112150], [52, 112770], [59, 113430], [62, 113630], [69, 113970], [72, 114370], [79, 115410], [82, 115530], [86, 115670]]}, {"verse": 16, "start": 116830, "end": 121207, "text": "Y tenían entonces un preso famoso que se llamaba Barrabás.", "words": [[0, 116830], [2, 117076], [9, 117356], [18, 117956], [21, 118276], [27, 118776], [34, 119136], [38, 119436], [41, 119576], [49, 120056]]}, {"verse": 17, "start": 121557, "end": 128636, "text": "Y juntos ellos, les dijo Pilato: ¿Cuál queréis que os suelte? ¿a Barrabás, o a Jesús que se dice el Cristo?", "words": [[0, 121557], [2, 121683], [9, 122143], [16, 122963], [20, 123083], [25, 123423], [33, 124327], [39, 124490], [47, 124890], [51, 125050], [54, 125170], [62, 125971], [65, 126098], [75, 126678], [77, 126878], [79, 126938], [85, 127258], [89, 127518], [92, 127638], [97, 127878], [100, 128038]]}, {"verse": 18, "start": 128916, "end": 132492, "text": "Porque sabía que por envidia le habían entregado.", "words": [[0, 128916], [7, 129159], [13, 129679], [17, 129879], [21, 130179], [29, 130939], [32, 131119], [39, 131519]]}, {"verse": 19, "start": 132842, "end": 144991, "text": "Y estando él sentado en el tribunal, su mujer envió a él, diciendo: No tengas que ver con aquel justo; porque hoy he padecido muchas cosas en sueños por causa de él.", "words": [[0, 132842], [2, 133191], [10, 133631], [13, 133791], [21, 134391], [24, 134531], [27, 134631], [37, 135591], [40, 135731], [46, 136151], [52, 136751], [54, 136891], [58, 137111], [68, 138655], [71, 138845], [78, 139285], [82, 139405], [86, 139585], [90, 139805], [96, 140125], [103, 140980], [110, 141209], [114, 141569], [117, 141809], [126, 142349], [133, 142689], [139, 143069], [142, 143329], [149, 143829], [153, 144049], [159, 144289], [162, 144649]]}, {"verse": 20, "start": 145271, "end": 154461, "text": "Pero los príncipes de los sacerdotes y los ancianos, persuadieron al pueblo que pidiese a Barrabás, y a Jesús matase.", "words": [[0, 145271], [5, 145455], [9, 145655], [19, 146435], [22, 146575], [26, 146715], [37, 147415], [39, 147555], [43, 147715], [53, 148535], [66, 150235], [69, 150435], [76, 150855], [80, 151235], [88, 151855], [90, 152175], [100, 152855], [102, 153115], [104, 153215], [110, 153535]]}, {"verse": 21, "start": 154811, "end": 162696, "text": "Y respondiendo el gobernador les dijo: ¿Cuál de los dos queréis que os suelte? Y ellos dijeron: A Barrabás.", "words": [[0, 154811], [2, 154916], [15, 155636], [18, 155756], [29, 156376], [33, 156576], [39, 157284], [45, 157605], [48, 157725], [52, 157885], [56, 158125], [64, 158605], [68, 158785], [71, 158905], [79, 159827], [81, 159994], [87, 160174], [96, 161649], [98, 162173]]}, {"verse": 22, "start": 162976, "end": 170046, "text": "Pilato les dijo: ¿Qué pues haré de Jesús que se dice el Cristo? Le dicen todos: Sea crucificado.", "words": [[0, 162976], [7, 163379], [11, 163579], [17, 164416], [22, 164536], [27, 164816], [32, 165256], [35, 165316], [41, 165696], [45, 165956], [48, 166096], [53, 166376], [56, 166496], [64, 167417], [67, 167543], [73, 167803], [80, 168806], [84, 169092]]}, {"verse": 23, "start": 170326, "end": 177340, "text": "Y el gobernador les dijo: Pues ¿qué mal ha hecho? Pero ellos gritaban más, diciendo: Sea crucificado.", "words": [[0, 170326], [2, 170470], [5, 170530], [16, 171090], [20, 171290], [26, 172034], [31, 172400], [36, 172460], [40, 172620], [43, 172760], [50, 173447], [55, 173609], [61, 173849], [70, 174509], [75, 174829], [85, 176101], [89, 176387]]}, {"verse": 24, "start": 177620, "end": 191148, "text": "Y viendo Pilato que nada adelantaba, antes se hacía más alboroto, tomando agua se lavó las manos delante del pueblo, diciendo: Inocente soy yo de la sangre de este justo: allá vosotros.", "words": [[0, 177620], [2, 177748], [9, 178048], [16, 178588], [20, 178788], [25, 179068], [37, 180188], [43, 180528], [46, 180828], [52, 181188], [56, 181448], [66, 182828], [74, 183268], [79, 183608], [82, 183848], [87, 184108], [91, 184268], [97, 184508], [105, 184968], [109, 185168], [117, 185748], [127, 187217], [136, 187859], [140, 188219], [143, 188479], [146, 188579], [149, 188719], [156, 189039], [159, 189279], [164, 189519], [171, 190339], [176, 190578]]}, {"verse": 25, "start": 191428, "end": 198606, "text": "Y respondiendo todo el pueblo, dijo: Su sangre sea sobre nosotros, y sobre nuestros hijos.", "words": [[0, 191492], [2, 191592], [15, 192512], [20, 192892], [23, 193172], [31, 193572], [37, 194425], [40, 194540], [47, 194900], [51, 195300], [57, 195580], [67, 196120], [69, 196540], [75, 196760], [84, 197080]]}, {"verse": 26, "start": 198886, "end": 205571, "text": "Entonces les soltó a Barrabás: y habiendo azotado a Jesús, le entregó para ser crucificado.", "words": [[0, 198886], [9, 199430], [13, 199895], [19, 200535], [21, 201067], [31, 201770], [33, 202015], [42, 202465], [50, 202915], [52, 202995], [59, 203255], [62, 203635], [70, 204115], [75, 204275], [79, 204515]]}, {"verse": 27, "start": 205921, "end": 214388, "text": "Entonces los soldados del gobernador llevaron a Jesús al palacio del gobernador, y juntaron a él toda la compañía;", "words": [[0, 205921], [9, 206521], [13, 207161], [22, 207861], [26, 208021], [37, 208621], [46, 209121], [48, 209221], [54, 209441], [57, 209761], [65, 210321], [69, 210461], [81, 211571], [83, 211981], [92, 212621], [94, 212781], [97, 213001], [102, 213301], [105, 213581]]}, {"verse": 28, "start": 214738, "end": 219086, "text": "Y desnudándole, le echaron encima un manto escarlata;", "words": [[0, 214738], [2, 214866], [16, 215946], [19, 216206], [27, 216786], [34, 217346], [37, 217666], [43, 218376]]}, {"verse": 29, "start": 219436, "end": 232927, "text": "Y pusieron sobre su cabeza una corona tejida de espinas, y una caña en su mano derecha; y arrodillándose delante de él, se burlaban de él, diciendo: ¡Salve, Rey de los judíos!", "words": [[0, 219436], [2, 219545], [11, 219985], [17, 220305], [20, 220505], [27, 220925], [31, 221185], [38, 221625], [45, 222325], [48, 222525], [57, 223265], [59, 223725], [63, 223905], [68, 224365], [71, 224625], [74, 224805], [79, 225065], [88, 226046], [90, 226172], [105, 227192], [113, 227712], [116, 227912], [120, 228432], [123, 228652], [132, 229332], [135, 229592], [139, 230072], [149, 231200], [157, 231625], [161, 231925], [164, 232025], [168, 232145]]}, {"verse": 30, "start": 233207, "end": 237783, "text": "Y escupiendo en él, tomaron la caña, y le herían en la cabeza.", "words": [[0, 233207], [2, 233350], [13, 234010], [16, 234190], [20, 234810], [28, 235230], [31, 235410], [37, 235910], [39, 236165], [42, 236365], [49, 236805], [52, 236965], [55, 237085]]}, {"verse": 31, "start": 238133, "end": 246456, "text": "Y después que se hubieron burlado de él, le desnudaron el manto, y le vistieron de sus vestidos, y le llevaron para crucificarle.", "words": [[0, 238133], [2, 238228], [10, 238528], [14, 238708], [17, 238868], [26, 239208], [34, 239728], [37, 239948], [41, 240428], [44, 240528], [55, 241248], [58, 241448], [65, 241948], [67, 242408], [70, 242528], [80, 243088], [83, 243268], [87, 243448], [97, 244068], [99, 244338], [102, 244608], [111, 245068], [116, 245308]]}, {"verse": 32, "start": 246806, "end": 254377, "text": "Y saliendo, hallaron a un cireneo, que se llamaba Simón: a este cargaron para que llevase su cruz.", "words": [[0, 246806], [2, 246954], [12, 247514], [21, 248394], [23, 248514], [26, 248974], [35, 249434], [39, 249714], [42, 249854], [50, 250314], [57, 251500], [59, 251700], [64, 251960], [73, 252720], [78, 253000], [82, 253160], [90, 253680], [93, 253780]]}, {"verse": 33, "start": 254727, "end": 261377, "text": "Y cuando llegaron al lugar que se llama Gólgota, que es dicho, El lugar de la calavera,", "words": [[0, 254727], [2, 254832], [9, 255072], [18, 255692], [21, 255972], [27, 256412], [31, 256872], [34, 257012], [40, 257352], [49, 258632], [53, 258692], [56, 258912], [63, 259772], [66, 259952], [72, 260272], [75, 260452], [78, 260592]]}, {"verse": 34, "start": 261727, "end": 267850, "text": "Le dieron a beber vinagre mezclado con hiel; y después de probarlo, no quiso beberlo.", "words": [[0, 261727], [3, 261833], [10, 262213], [12, 262313], [18, 262553], [26, 263233], [35, 263973], [39, 264383], [45, 265002], [47, 265147], [55, 265347], [58, 265547], [68, 266527], [71, 266627], [77, 267007]]}, {"verse": 35, "start": 268200, "end": 282227, "text": "Y después que le hubieron crucificado, repartieron sus vestidos, echando suertes: para que se cumpliese lo que fue dicho por el profeta: Se repartieron mis vestidos, y sobre mi ropa echaron suertes.", "words": [[0, 268200], [2, 268306], [10, 268626], [14, 268846], [17, 268986], [26, 269386], [39, 270386], [51, 271366], [55, 271586], [65, 272206], [73, 272946], [82, 274034], [87, 274252], [91, 274392], [94, 274532], [104, 275192], [107, 275352], [111, 275472], [115, 275652], [121, 275952], [125, 276272], [128, 276432], [137, 277580], [140, 277710], [152, 278390], [156, 278630], [166, 279730], [168, 279930], [174, 280210], [177, 280470], [182, 280970], [190, 281390]]}, {"verse": 36, "start": 282577, "end": 285278, "text": "Y sentados le guardaban allí.", "words": [[0, 282577], [2, 282701], [11, 283481], [14, 284041], [24, 284721]]}, {"verse": 37, "start": 285628, "end": 293200, "text": "Y pusieron sobre su cabeza la acusación escrita contra él: ESTE ES JESÚS EL REY DE LOS JUDÍOS.", "words": [[0, 285628], [2, 285716], [11, 286216], [17, 286536], [20, 286796], [27, 287356], [30, 287956], [40, 288736], [48, 289256], [55, 289596], [59, 290311], [64, 290600], [67, 290800], [73, 291660], [76, 291740], [80, 292200], [83, 292500], [87, 292640]]}, {"verse": 38, "start": 293550, "end": 300493, "text": "Entonces crucificaron con él dos ladrones, uno a la derecha, y otro a la izquierda.", "words": [[0, 293550], [9, 294146], [22, 295186], [26, 295406], [29, 295606], [33, 295866], [43, 297146], [47, 297486], [49, 297786], [52, 297866], [61, 298506], [63, 299026], [68, 299266], [70, 299566], [73, 299666]]}, {"verse": 39, "start": 300843, "end": 305292, "text": "Y los que pasaban, lo insultaban, meneando sus cabezas,", "words": [[0, 300843], [2, 301109], [6, 301229], [10, 301369], [19, 302049], [22, 302489], [34, 303569], [43, 304149], [47, 304369]]}, {"verse": 40, "start": 305642, "end": 314584, "text": "Y diciendo: Tú, el que derribas el templo, y en tres días lo reedificas, sálvate a ti mismo: si eres Hijo de Dios, desciende de la cruz.", "words": [[0, 305642], [2, 305760], [12, 306760], [16, 306917], [19, 307037], [23, 307157], [32, 307617], [35, 307737], [43, 308557], [45, 308677], [48, 308797], [53, 308997], [58, 309237], [61, 309897], [73, 310557], [81, 310977], [83, 311157], [86, 311237], [93, 311970], [96, 312149], [101, 312309], [106, 312589], [109, 312769], [115, 313429], [125, 313809], [128, 313969], [131, 314089]]}, {"verse": 41, "start": 314864, "end": 323815, "text": "De esta manera también los príncipes de los sacerdotes, burlándose de él con los escribas y los fariseos y los ancianos, decían:", "words": [[0, 314864], [3, 315032], [8, 315212], [15, 315492], [23, 315912], [27, 316172], [37, 316932], [40, 317192], [44, 317352], [56, 318672], [67, 319432], [70, 319612], [73, 319792], [77, 319972], [81, 320132], [90, 320752], [92, 320892], [96, 321032], [105, 321712], [107, 321812], [111, 321972], [121, 322972]]}, {"verse": 42, "start": 324015, "end": 331086, "text": "A otros salvó, a sí mismo no puede salvar: si es el Rey de Israel, descienda ahora de la cruz, y creeremos en él.", "words": [[0, 324015], [2, 324156], [8, 324416], [15, 324956], [17, 325016], [20, 325156], [26, 325536], [29, 325636], [35, 325856], [43, 326706], [46, 326886], [49, 327066], [52, 327206], [56, 327486], [59, 327526], [67, 327966], [77, 328746], [83, 329006], [86, 329146], [89, 329266], [95, 329786], [97, 330146], [107, 330506], [110, 330766]]}, {"verse": 43, "start": 331436, "end": 337184, "text": "Confió en Dios: que Dios lo libre ahora, si lo quiere, porque ha dicho: Soy Hijo de Dios.", "words": [[0, 331436], [7, 331855], [10, 331975], [16, 332747], [20, 332843], [25, 333063], [28, 333303], [34, 333523], [41, 333863], [44, 334103], [47, 334243], [55, 334803], [62, 335023], [65, 335223], [72, 335905], [76, 336124], [81, 336464], [84, 336644]]}, {"verse": 44, "start": 337464, "end": 342694, "text": "Lo mismo también le insultaban los ladrones que estaban crucificados con él.", "words": [[0, 337464], [3, 337591], [9, 337851], [17, 338371], [20, 338751], [31, 339691], [35, 339931], [44, 340531], [48, 340751], [56, 341051], [69, 342071], [73, 342311]]}, {"verse": 45, "start": 343044, "end": 348269, "text": "Y desde la hora de sexta fueron tinieblas sobre toda la tierra hasta la hora de nona.", "words": [[0, 343044], [2, 343317], [8, 343517], [11, 343797], [16, 344017], [19, 344177], [25, 344677], [32, 344917], [42, 345697], [48, 345917], [53, 346257], [56, 346497], [63, 346837], [69, 347297], [72, 347457], [77, 347637], [80, 347797]]}, {"verse": 46, "start": 348619, "end": 361157, "text": "Y cerca de la hora de nona, Jesús exclamó con grande voz, diciendo: Elí, Elí, ¿lama sabachtani? Esto es: Dios mío, Dios mío, ¿por qué me has desamparado?", "words": [[0, 348619], [2, 348743], [8, 349123], [11, 349483], [14, 349603], [19, 349823], [22, 350003], [28, 350683], [34, 351003], [42, 352183], [46, 352323], [53, 352723], [58, 353063], [68, 354241], [73, 354867], [78, 355713], [84, 356559], [96, 357562], [101, 357827], [105, 358449], [110, 358634], [115, 359034], [120, 359134], [125, 359654], [130, 359734], [134, 359874], [137, 360034], [141, 360154]]}, {"verse": 47, "start": 361507, "end": 367311, "text": "Y algunos de los que estaban allí, al oírlo, decían: A Elías llama este.", "words": [[0, 361507], [2, 361631], [10, 361971], [13, 362231], [17, 362351], [21, 362491], [29, 362811], [35, 363451], [38, 363731], [45, 364851], [53, 365977], [55, 366119], [61, 366519], [67, 366839]]}, {"verse": 48, "start": 367591, "end": 377329, "text": "Y luego, corriendo uno de ellos, tomó una esponja, y la empapó en vinagre, y poniéndola en una caña, le daba de beber.", "words": [[0, 367591], [2, 367734], [9, 367974], [19, 368774], [23, 369034], [26, 369214], [33, 370114], [38, 370574], [42, 370774], [51, 371574], [53, 371934], [56, 372294], [63, 372934], [66, 373034], [75, 373654], [77, 374014], [88, 374914], [91, 375094], [95, 375254], [101, 375774], [104, 376314], [109, 376634], [112, 376774]]}, {"verse": 49, "start": 377679, "end": 381978, "text": "Y los otros decían: Deja, veamos si viene Elías a librarle.", "words": [[0, 377679], [2, 377784], [6, 377924], [12, 378264], [20, 379511], [26, 379853], [33, 380373], [36, 380613], [42, 380833], [48, 381123], [50, 381413]]}, {"verse": 50, "start": 382258, "end": 387795, "text": "Pero Jesús, habiendo otra vez exclamado con grande voz, entregó el espíritu.", "words": [[0, 382258], [5, 382386], [12, 383126], [21, 383546], [26, 383766], [30, 384086], [40, 384946], [44, 385106], [51, 385446], [56, 386346], [64, 387006], [67, 387126]]}, {"verse": 51, "start": 388145, "end": 396268, "text": "Y he aquí, el velo del templo se rompió en dos, de alto a bajo: y la tierra tembló, y las rocas se partieron;", "words": [[0, 388145], [2, 388273], [5, 388473], [11, 388833], [14, 389133], [19, 389413], [23, 389553], [30, 390093], [33, 390213], [40, 390713], [43, 390873], [48, 391553], [51, 391633], [56, 391958], [58, 392284], [64, 392772], [66, 392898], [69, 393018], [76, 393318], [84, 394378], [86, 394618], [90, 394778], [96, 395238], [99, 395438]]}, {"verse": 52, "start": 396618, "end": 402756, "text": "Y se abrieron los sepulcros, y muchos cuerpos de santos que habían dormido, se levantaron;", "words": [[0, 396618], [2, 396912], [5, 397012], [14, 397472], [18, 397652], [29, 398412], [31, 398772], [38, 399052], [46, 399672], [49, 399792], [56, 400452], [60, 400632], [67, 400872], [76, 401472], [79, 401652]]}, {"verse": 53, "start": 403106, "end": 411262, "text": "Y salidos de los sepulcros, después de su resurrección, vinieron a la santa ciudad, y aparecieron a muchos.", "words": [[0, 403106], [2, 403247], [10, 403687], [13, 403847], [17, 403967], [28, 405107], [36, 405447], [39, 405647], [42, 405787], [56, 406737], [65, 407687], [67, 407967], [70, 408067], [76, 408387], [84, 409147], [86, 409667], [98, 410487], [100, 410587]]}, {"verse": 54, "start": 411612, "end": 424220, "text": "Y el centurión, y los que estaban con él guardando a Jesús, visto el terremoto, y las cosas que habían sido hechas, temieron en gran manera, diciendo: Verdaderamente Hijo de Dios era este.", "words": [[0, 411612], [2, 411795], [5, 411975], [16, 412795], [18, 413015], [22, 413155], [26, 413295], [34, 413575], [38, 413915], [41, 414115], [51, 414715], [53, 414855], [60, 415715], [66, 416135], [69, 416295], [80, 416995], [82, 417135], [86, 417315], [92, 417655], [96, 417835], [103, 418135], [108, 418475], [116, 419155], [125, 419715], [128, 419955], [133, 420135], [141, 420655], [151, 421862], [166, 422602], [171, 422882], [174, 423042], [179, 423282], [183, 423642]]}, {"verse": 55, "start": 424500, "end": 431925, "text": "Y estaban allí muchas mujeres mirando de lejos, las cuales habían seguido de Galilea a Jesús, sirviéndole:", "words": [[0, 424500], [2, 424624], [10, 424944], [15, 425264], [22, 425564], [30, 426124], [38, 426924], [41, 427104], [48, 427864], [52, 428104], [59, 428364], [66, 428804], [74, 429344], [77, 429504], [85, 430104], [87, 430264], [94, 430944]]}, {"verse": 56, "start": 432275, "end": 440264, "text": "Entre las cuales estaban María Magdalena, y María la madre de Jacobo y de José, y la madre de los hijos de Zebedeo.", "words": [[0, 432275], [6, 432499], [10, 432719], [17, 432999], [25, 433499], [31, 433939], [42, 434879], [44, 435499], [50, 435859], [53, 436059], [59, 436359], [62, 436579], [69, 437119], [71, 437179], [74, 437279], [80, 437599], [82, 438139], [85, 438279], [91, 438579], [94, 438819], [98, 438959], [104, 439299], [107, 439809]]}, {"verse": 57, "start": 440614, "end": 449115, "text": "Y como fue la tarde del día, vino un hombre rico de Arimatea, llamado José, el cual también había sido discípulo de Jesús.", "words": [[0, 440614], [2, 440720], [7, 440960], [11, 441180], [14, 441320], [20, 441600], [24, 441880], [29, 442240], [34, 442860], [37, 443080], [44, 443340], [49, 443720], [52, 443960], [62, 444620], [70, 444900], [76, 445980], [79, 446060], [84, 446240], [92, 446620], [98, 446920], [103, 447320], [113, 448260], [116, 448420]]}, {"verse": 58, "start": 449465, "end": 456617, "text": "Este llegó a Pilato, y pidió el cuerpo de Jesús: entonces Pilato mandó que se le diese el cuerpo.", "words": [[0, 449465], [5, 449750], [11, 450110], [13, 450230], [21, 450690], [23, 451150], [29, 451510], [32, 451650], [39, 451930], [42, 452170], [49, 453016], [58, 453557], [65, 454118], [71, 454680], [75, 455140], [78, 455300], [81, 455500], [87, 455700], [90, 455960]]}, {"verse": 59, "start": 456967, "end": 461147, "text": "Y tomando José el cuerpo, lo envolvió en una sábana limpia,", "words": [[0, 456967], [2, 457063], [10, 457443], [15, 457803], [18, 458003], [26, 458423], [29, 458823], [38, 459463], [41, 459643], [45, 459823], [52, 460363]]}, {"verse": 60, "start": 461497, "end": 470938, "text": "Y lo puso en su sepulcro nuevo, que había excavado en la roca: y después de hacer rodar una gran piedra a la puerta del sepulcro, se fue.", "words": [[0, 461497], [2, 461599], [5, 461719], [10, 462079], [13, 462219], [16, 462609], [25, 462999], [32, 463459], [36, 463979], [42, 464239], [51, 464999], [54, 465139], [57, 465259], [63, 466044], [65, 466145], [73, 466405], [76, 466565], [82, 466945], [88, 467505], [92, 467645], [97, 467865], [104, 468405], [106, 468505], [109, 468605], [116, 468905], [120, 469205], [130, 470305], [133, 470505]]}, {"verse": 61, "start": 471288, "end": 477332, "text": "Y estaban allí María Magdalena, y la otra María, sentadas delante del sepulcro.", "words": [[0, 471288], [2, 471412], [10, 471752], [15, 472152], [21, 472612], [32, 473592], [34, 474012], [37, 474152], [42, 474412], [49, 474912], [58, 475892], [66, 476332], [70, 476552]]}, {"verse": 62, "start": 477682, "end": 486413, "text": "Y el siguiente día, que es después de la preparación, se juntaron los príncipes de los sacerdotes y los fariseos a Pilato,", "words": [[0, 477682], [2, 477826], [5, 477986], [15, 478406], [20, 479186], [24, 479306], [27, 479506], [35, 480046], [38, 480306], [41, 480466], [54, 481626], [57, 481786], [66, 482366], [70, 482546], [80, 483286], [83, 483406], [87, 483546], [98, 484426], [100, 484646], [104, 484806], [113, 485606], [115, 485806]]}, {"verse": 63, "start": 486763, "end": 494112, "text": "Diciendo: Señor, nos acordamos que aquel engañador dijo, viviendo aún: Después de tres días resucitaré.", "words": [[0, 486763], [10, 487790], [17, 488129], [21, 488429], [31, 489049], [35, 489269], [41, 489529], [51, 490049], [57, 490789], [66, 491309], [71, 492065], [79, 492338], [82, 492578], [87, 492838], [92, 493278]]}, {"verse": 64, "start": 494462, "end": 506210, "text": "Manda, pues, que se asegure el sepulcro hasta el día tercero; porque no vengan sus discípulos de noche, y le hurten, y digan al pueblo: Resucitó de los muertos. Y será el último error peor que el primero.", "words": [[0, 494462], [7, 494782], [13, 495042], [17, 495362], [20, 495502], [28, 495982], [31, 496082], [40, 496662], [46, 496882], [49, 497042], [53, 497222], [62, 498133], [69, 498323], [72, 498503], [79, 498783], [83, 498963], [94, 499523], [97, 499683], [104, 499963], [106, 500263], [109, 500533], [117, 500803], [119, 501023], [125, 501343], [128, 501443], [136, 502204], [145, 502803], [148, 502903], [152, 503023], [161, 503919], [163, 504025], [168, 504245], [171, 504445], [178, 504725], [184, 505065], [189, 505465], [193, 505565], [196, 505665]]}, {"verse": 65, "start": 506490, "end": 511255, "text": "Y Pilato les dijo: Tenéis una guardia: id, aseguradlo como sabéis.", "words": [[0, 506490], [2, 506615], [9, 507075], [13, 507295], [19, 507989], [26, 508292], [30, 508452], [39, 509345], [43, 509455], [54, 510435], [59, 510635]]}, {"verse": 66, "start": 511535, "end": 517391, "text": "Y yendo ellos, aseguraron el sepulcro, sellando la piedra, con la guardia.", "words": [[0, 511535], [2, 511676], [8, 512056], [15, 512456], [26, 513416], [29, 513616], [39, 514796], [48, 515276], [51, 515416], [59, 516136], [63, 516476], [66, 516676]]}]}