{"book": "MAT", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 219196, "verses": [{"verse": 1, "start": 300, "end": 3022, "text": "No juzguéis, para que no seáis juzgados.", "words": [[0, 300], [3, 489], [13, 1109], [18, 1409], [22, 1569], [25, 1749], [31, 2169]]}, {"verse": 2, "start": 3372, "end": 10448, "text": "Porque con el juicio con que juzgáis, seréis juzgados; y con la medida con que medís, os volverán a medir.", "words": [[0, 3372], [7, 3554], [11, 3814], [14, 3934], [21, 4314], [25, 4534], [29, 4714], [38, 5294], [45, 6094], [55, 7164], [57, 7272], [61, 7432], [64, 7592], [71, 7912], [75, 8172], [79, 8672], [86, 9172], [89, 9312], [98, 9872], [100, 9932]]}, {"verse": 3, "start": 10798, "end": 16369, "text": "Y ¿por qué miras la paja que está en el ojo de tu hermano, y no notas la viga que está en tu ojo?", "words": [[0, 10798], [2, 10942], [7, 11142], [11, 11382], [17, 11842], [20, 11962], [25, 12322], [29, 12502], [34, 12682], [37, 12822], [40, 12922], [44, 13162], [47, 13282], [50, 13402], [59, 14222], [61, 14422], [64, 14562], [70, 14942], [73, 15092], [78, 15242], [82, 15462], [87, 15622], [90, 15742], [93, 15902]]}, {"verse": 4, "start": 16719, "end": 23741, "text": "O ¿cómo dirás a tu hermano: Espera, echaré de tu ojo la mota, y he aquí la viga en tu ojo?", "words": [[0, 16719], [2, 16822], [8, 17082], [14, 17562], [16, 17662], [19, 17762], [28, 18634], [36, 19658], [43, 20118], [46, 20238], [49, 20458], [53, 20778], [56, 20958], [62, 21778], [64, 22018], [67, 22178], [72, 22478], [75, 22678], [80, 22878], [83, 23038], [86, 23238]]}, {"verse": 5, "start": 24091, "end": 31829, "text": "¡Hipócrita! echa primero la viga de tu ojo, y entonces verás bien para sacar la paja del ojo de tu hermano.", "words": [[0, 24091], [12, 25266], [17, 25474], [25, 25834], [28, 26084], [33, 26334], [36, 26534], [39, 26694], [44, 27154], [46, 27814], [55, 28274], [61, 29154], [66, 29394], [71, 29714], [77, 29994], [80, 30274], [85, 30534], [89, 30734], [93, 31014], [96, 31134], [99, 31254]]}, {"verse": 6, "start": 32179, "end": 41994, "text": "No deis lo santo a los perros, ni echéis vuestras perlas delante de los cerdos; porque no las pisoteen con sus pies, y vuelvan y os despedacen.", "words": [[0, 32179], [3, 32364], [8, 32637], [11, 32911], [17, 33184], [19, 33304], [23, 33424], [31, 34104], [34, 34404], [41, 34824], [50, 35284], [57, 35764], [65, 36224], [68, 36384], [72, 36524], [80, 37489], [87, 37713], [90, 37973], [94, 38173], [103, 38973], [107, 39153], [111, 39413], [117, 39693], [119, 40173], [127, 40753], [129, 40943], [132, 41133]]}, {"verse": 7, "start": 42344, "end": 47899, "text": "Pedid, y se os dará; buscad, y hallaréis; llamad, y se os abrirá.", "words": [[0, 42344], [7, 42710], [9, 42930], [12, 43090], [15, 43230], [21, 44190], [29, 44470], [31, 45080], [42, 45849], [50, 46436], [52, 46896], [55, 47036], [58, 47495]]}, {"verse": 8, "start": 48249, "end": 54459, "text": "Porque cualquiera que pide, recibe; y el que busca, halla; y al que llama, se abrirá.", "words": [[0, 48249], [7, 48452], [18, 49032], [22, 49172], [28, 49512], [36, 50486], [38, 50613], [41, 50713], [45, 50853], [52, 51607], [59, 52540], [61, 52648], [64, 52788], [68, 53108], [75, 53428], [78, 53959]]}, {"verse": 9, "start": 54809, "end": 59804, "text": "¿Qué hombre hay de vosotros, a quien si su hijo le pide pan, le dará una piedra?", "words": [[0, 54809], [5, 54931], [12, 55251], [16, 55491], [19, 55631], [29, 56231], [31, 56511], [37, 56671], [40, 56911], [43, 57091], [48, 57311], [51, 57511], [56, 57771], [61, 58131], [64, 58671], [69, 58951], [73, 59071]]}, {"verse": 10, "start": 60154, "end": 63524, "text": "¿Y si le pide un pez, le dará una serpiente?", "words": [[0, 60154], [3, 60260], [6, 60360], [9, 60500], [14, 60760], [17, 60900], [22, 61500], [25, 61980], [30, 62280], [34, 62380]]}, {"verse": 11, "start": 63874, "end": 74851, "text": "Pues si vosotros, siendo malos, sabéis dar buenas dádivas a vuestros hijos, ¿cuánto más vuestro Padre que está en los cielos, dará buenas cosas a los que le piden?", "words": [[0, 63874], [5, 64041], [8, 64201], [18, 64681], [25, 64941], [32, 65821], [39, 66581], [43, 66841], [50, 67181], [58, 67801], [60, 68001], [69, 68401], [76, 69261], [84, 69741], [88, 69961], [96, 70361], [102, 70701], [106, 70941], [111, 71161], [114, 71281], [118, 71401], [126, 71981], [131, 72741], [138, 73181], [144, 73681], [146, 73941], [150, 74041], [154, 74181], [157, 74321]]}, {"verse": 12, "start": 75201, "end": 85714, "text": "Así que, todas las cosas que quisierais que los hombres hiciesen con vosotros, así también haced vosotros con ellos; porque esta es la ley y los profetas.", "words": [[0, 75201], [4, 75496], [9, 75716], [15, 75996], [19, 76296], [25, 76696], [29, 76956], [40, 77596], [44, 77796], [48, 77976], [56, 78376], [65, 79216], [69, 79436], [79, 80436], [83, 80636], [91, 81076], [97, 81576], [106, 82156], [110, 82416], [117, 83147], [124, 83371], [129, 83731], [132, 83931], [135, 84071], [139, 84371], [141, 84791], [145, 84911]]}, {"verse": 13, "start": 86064, "end": 95293, "text": "Entrad por la puerta estrecha: porque ancha es la puerta, y espacioso el camino que lleva a perdición, y muchos son los que entran por ella.", "words": [[0, 86282], [7, 86542], [11, 86887], [14, 87067], [21, 87387], [31, 88423], [38, 88708], [44, 89028], [47, 89388], [50, 89508], [58, 89928], [60, 90410], [70, 90893], [73, 91133], [80, 91453], [84, 91733], [90, 92013], [92, 92173], [103, 92813], [105, 93118], [112, 93418], [116, 93818], [120, 94018], [124, 94218], [131, 94618], [135, 94838]]}, {"verse": 14, "start": 95643, "end": 102860, "text": "Porque estrecha es la puerta, y angosto el camino que lleva a la vida, y pocos son los que la hallan.", "words": [[0, 95643], [7, 95865], [16, 96385], [19, 96545], [22, 96685], [30, 97705], [32, 97965], [40, 98565], [43, 98645], [50, 98965], [54, 99205], [60, 99345], [62, 99485], [65, 99685], [71, 100445], [73, 100685], [79, 101365], [83, 101585], [87, 101765], [91, 101965], [94, 102145]]}, {"verse": 15, "start": 103210, "end": 111937, "text": "Y guardaos de los falsos profetas, que vienen a vosotros con vestidos de ovejas, pero de dentro son lobos rapaces.", "words": [[0, 103210], [2, 103562], [11, 103952], [14, 104172], [18, 104292], [25, 104812], [35, 105312], [39, 105532], [46, 105872], [48, 106072], [57, 106632], [61, 107097], [70, 107577], [73, 107717], [81, 108657], [86, 108757], [89, 108957], [96, 109417], [100, 110017], [106, 111007]]}, {"verse": 16, "start": 112287, "end": 118695, "text": "Por sus frutos los conoceréis. ¿Se cogen uvas de los espinos, o higos de los cardos?", "words": [[0, 112287], [4, 112554], [8, 112754], [15, 113694], [19, 113894], [31, 115108], [35, 115250], [41, 115650], [46, 116090], [49, 116230], [53, 116350], [62, 116970], [64, 117350], [70, 117750], [73, 117870], [77, 117970]]}, {"verse": 17, "start": 119045, "end": 124639, "text": "Así, todo buen árbol lleva buenos frutos; pero el árbol malo lleva malos frutos.", "words": [[0, 119045], [5, 119223], [10, 119523], [15, 119823], [21, 120203], [27, 120463], [34, 120903], [42, 121923], [47, 122209], [50, 122409], [56, 122769], [61, 123309], [67, 123529], [73, 124029]]}, {"verse": 18, "start": 124989, "end": 130800, "text": "No puede el buen árbol llevar malos frutos, ni el árbol malo llevar frutos buenos.", "words": [[0, 124989], [3, 125139], [9, 125479], [12, 125719], [17, 125899], [23, 126359], [30, 126639], [36, 127219], [44, 128239], [47, 128339], [50, 128519], [56, 128879], [61, 129319], [68, 129519], [75, 130159]]}, {"verse": 19, "start": 131150, "end": 135557, "text": "Todo árbol que no lleva buen fruto, se corta y se echa en el fuego.", "words": [[0, 131150], [5, 131312], [11, 131852], [15, 132052], [18, 132232], [24, 132492], [29, 132792], [36, 133392], [39, 133552], [45, 134152], [47, 134272], [50, 134412], [55, 134692], [58, 134832], [61, 134972]]}, {"verse": 20, "start": 135907, "end": 138945, "text": "Así que, por sus frutos los conoceréis.", "words": [[0, 135907], [4, 136149], [9, 136329], [13, 136569], [17, 136769], [24, 137369], [28, 137909]]}, {"verse": 21, "start": 139295, "end": 149318, "text": "No todo el que me dice: Señor, Señor, entrará en el reino de los cielos: sino el que hace la voluntad de mi Padre que está en los cielos.", "words": [[0, 139295], [3, 139441], [8, 139781], [11, 140001], [15, 140121], [18, 140261], [24, 140964], [31, 141904], [38, 142724], [46, 143424], [49, 143644], [52, 143784], [58, 144224], [61, 144344], [65, 144484], [73, 145365], [78, 145670], [81, 145850], [85, 145990], [90, 146370], [93, 146590], [102, 147170], [105, 147290], [108, 147430], [114, 147950], [118, 148070], [123, 148270], [126, 148410], [130, 148530]]}, {"verse": 22, "start": 149668, "end": 160640, "text": "Muchos me dirán en aquel día: Señor, Señor, ¿no profetizamos en tu nombre, y en tu nombre lanzamos demonios, y en tu nombre hicimos muchos milagros?", "words": [[0, 149668], [7, 150016], [10, 150296], [16, 150636], [19, 150756], [25, 151116], [30, 151825], [37, 152408], [44, 153308], [48, 153468], [61, 154468], [64, 154708], [67, 154888], [75, 155368], [77, 155868], [80, 156008], [83, 156188], [90, 156548], [99, 157208], [109, 158108], [111, 158348], [114, 158468], [117, 158628], [124, 158928], [132, 159408], [139, 159728]]}, {"verse": 23, "start": 160990, "end": 167704, "text": "Y entonces les declararé: Nunca os conocí; apartaos de mí, hacedores de maldad.", "words": [[0, 160990], [2, 161175], [11, 161735], [15, 162355], [26, 163545], [32, 164012], [35, 164132], [43, 165386], [52, 165706], [55, 165906], [59, 166406], [69, 166906], [72, 167126]]}, {"verse": 24, "start": 168054, "end": 177047, "text": "Cualquiera, pues, que me oye estas palabras, y las hace, le compararé a un hombre prudente, que edificó su casa sobre la roca;", "words": [[0, 168054], [12, 168679], [18, 169319], [22, 169419], [25, 169599], [29, 169939], [35, 170179], [45, 170719], [47, 171114], [51, 171294], [57, 172214], [60, 172334], [70, 172994], [72, 173094], [75, 173254], [82, 173534], [92, 174254], [96, 174649], [104, 175369], [107, 175509], [112, 175849], [118, 176249], [121, 176449]]}, {"verse": 25, "start": 177397, "end": 187688, "text": "Y descendió lluvia, y vinieron ríos, y soplaron vientos, y golpearon aquella casa; y no cayó: porque estaba fundada sobre la roca.", "words": [[0, 177397], [2, 177501], [12, 178021], [20, 178561], [22, 179081], [31, 179501], [37, 180221], [39, 180741], [48, 181261], [57, 181821], [59, 182341], [69, 182961], [77, 183321], [83, 184338], [85, 184558], [88, 184778], [94, 185198], [101, 185400], [108, 185760], [116, 186440], [122, 186760], [125, 187020]]}, {"verse": 26, "start": 188038, "end": 197618, "text": "Y cualquiera que me oye estas palabras, y no las hace, le compararé a un hombre insensato, que edificó su casa sobre la arena;", "words": [[0, 188038], [2, 188161], [13, 188741], [17, 188941], [20, 189141], [24, 189461], [30, 189741], [40, 190301], [42, 190881], [45, 191021], [49, 191241], [55, 192021], [58, 192141], [68, 192881], [70, 193021], [73, 193181], [80, 193481], [91, 194761], [95, 195261], [103, 195841], [106, 195981], [111, 196321], [117, 196721], [120, 196981]]}, {"verse": 27, "start": 197968, "end": 207443, "text": "Y descendió lluvia, y vinieron ríos, y soplaron vientos, y golpearon aquella casa; y cayó, y fue grande su ruina.", "words": [[0, 197968], [2, 198072], [12, 198592], [20, 199132], [22, 199652], [31, 200072], [37, 200792], [39, 201312], [48, 201832], [57, 202392], [59, 202912], [69, 203532], [77, 203892], [83, 204726], [85, 205084], [91, 205604], [93, 206124], [97, 206264], [104, 206584], [107, 206864]]}, {"verse": 28, "start": 207793, "end": 213603, "text": "Y aconteció que, como Jesús acabó estas palabras, la gente se admiraba de su enseñanza;", "words": [[0, 207793], [2, 207972], [12, 208692], [17, 208872], [22, 209132], [28, 209452], [34, 210032], [40, 210192], [50, 211152], [53, 211372], [59, 211652], [62, 211912], [71, 212452], [74, 212592], [77, 212732]]}, {"verse": 29, "start": 213953, "end": 218796, "text": "Porque les enseñaba como quien tiene autoridad, y no como los escribas.", "words": [[0, 213953], [7, 214253], [11, 214433], [20, 215093], [25, 215333], [31, 215613], [37, 215993], [48, 216753], [50, 217313], [53, 217453], [58, 217733], [62, 217953]]}]}