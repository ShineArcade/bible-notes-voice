{"book": "GEN", "chapter": 36, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 352566, "verses": [{"verse": 1, "start": 300, "end": 4346, "text": "Y estas son las generaciones de Esaú, el cual es Edom.", "words": [[0, 300], [2, 470], [8, 710], [12, 1070], [16, 1250], [29, 2110], [32, 2533], [38, 2955], [41, 3055], [46, 3295], [49, 3675]]}, {"verse": 2, "start": 4696, "end": 14989, "text": "Esaú tomó sus mujeres de las hijas de Canaán: a Ada, hija de Elón heteo, y a Aholibama, hija de Ana, hija de Zibeón el heveo;", "words": [[0, 4910], [5, 5160], [10, 5480], [14, 5600], [22, 6060], [25, 6320], [29, 6480], [35, 6820], [38, 6940], [46, 8000], [48, 8174], [53, 8347], [58, 8847], [61, 8987], [66, 9537], [73, 10087], [75, 10507], [77, 10937], [88, 11367], [93, 11787], [96, 11887], [101, 12127], [106, 12547], [109, 13173], [116, 13800], [119, 14426]]}, {"verse": 3, "start": 15339, "end": 18533, "text": "Y a Basemat, hija de Ismael, hermana de Nebaiot.", "words": [[0, 15339], [2, 15339], [4, 15339], [13, 15339], [18, 15686], [21, 15746], [29, 16686], [37, 17626], [40, 18113]]}, {"verse": 4, "start": 18883, "end": 23855, "text": "Y Ada parió a Esaú a Elifaz; y Basemat parió a Reuel.", "words": [[0, 18883], [2, 19175], [6, 19501], [12, 19828], [14, 20238], [19, 20648], [21, 21224], [29, 22139], [31, 22353], [39, 22566], [45, 22986], [47, 23442]]}, {"verse": 5, "start": 24205, "end": 33617, "text": "Y Aholibama parió a Jeús, y a Jaalam, y a Coré: estos son los hijos de Esaú, que le nacieron en la tierra de Canaán.", "words": [[0, 24205], [2, 24589], [12, 25009], [18, 25529], [20, 25729], [26, 26729], [28, 26789], [30, 27279], [38, 27769], [40, 28009], [42, 28089], [48, 28704], [54, 29302], [58, 29542], [62, 29722], [68, 30022], [71, 30302], [77, 31062], [81, 31262], [84, 31382], [93, 31902], [96, 32202], [99, 32322], [106, 32682], [109, 33176]]}, {"verse": 6, "start": 33967, "end": 53174, "text": "Y Esaú tomó sus mujeres, y sus hijos, y sus hijas, y todas las personas de su casa, y sus ganados, y todas sus bestias, y todo cuanto había adquirido en la tierra de Canaán, y se fue a otra tierra, separándose de Jacob su hermano:", "words": [[0, 33967], [2, 34113], [7, 34633], [12, 35093], [16, 35193], [25, 35753], [27, 36178], [31, 36418], [38, 36858], [40, 37458], [44, 37658], [51, 38598], [53, 38818], [59, 39118], [63, 39438], [72, 39998], [75, 40178], [78, 40358], [84, 40718], [86, 41378], [90, 41818], [99, 42258], [101, 42838], [107, 43038], [111, 43318], [120, 44253], [122, 44377], [127, 44577], [134, 44997], [140, 45517], [150, 46457], [153, 46577], [156, 46737], [163, 47117], [166, 47337], [174, 48417], [176, 48517], [179, 48677], [183, 48977], [185, 49217], [190, 49457], [198, 50497], [210, 51437], [213, 51597], [219, 52017], [222, 52377]]}, {"verse": 7, "start": 53524, "end": 62741, "text": "Porque los bienes de ellos eran muchos, y no podían habitar juntos, ni la tierra donde vivían los podía sostener a causa de sus ganados.", "words": [[0, 53524], [7, 53751], [11, 53951], [18, 54351], [21, 54491], [27, 54691], [32, 54971], [40, 55511], [42, 55876], [45, 56036], [52, 56396], [60, 56796], [68, 57316], [71, 58036], [74, 58216], [81, 58516], [87, 58876], [94, 59536], [98, 59696], [104, 60116], [113, 60876], [115, 61116], [121, 61516], [124, 61736], [128, 61916]]}, {"verse": 8, "start": 63091, "end": 67773, "text": "Y Esaú habitó en el monte de Seir: Esaú es Edom.", "words": [[0, 63406], [2, 63740], [7, 64073], [14, 64753], [17, 65013], [20, 65153], [26, 65513], [29, 65793], [35, 66668], [40, 66668], [43, 67244]]}, {"verse": 9, "start": 68123, "end": 72971, "text": "Estos son los linajes de Esaú, padre de Edom, en el monte de Seir.", "words": [[0, 68123], [6, 68523], [10, 68763], [14, 68943], [22, 69503], [25, 69863], [31, 70223], [37, 70443], [40, 70723], [46, 71423], [49, 71543], [52, 71683], [58, 71983], [61, 72203]]}, {"verse": 10, "start": 73321, "end": 82925, "text": "Estos son los nombres de los hijos de Esaú: Elifaz, hijo de Ada, mujer de Esaú; Reuel, hijo de Basemat, mujer de Esaú.", "words": [[0, 73321], [6, 73670], [10, 73851], [14, 73991], [22, 74530], [25, 74931], [29, 75051], [35, 75331], [38, 75752], [44, 76690], [52, 77085], [57, 77479], [60, 77874], [65, 78269], [71, 78664], [74, 79059], [80, 80057], [87, 80517], [92, 80697], [95, 80877], [104, 81717], [110, 82117], [113, 82549]]}, {"verse": 11, "start": 83275, "end": 87981, "text": "Y los hijos de Elifaz fueron Temán, Omar, Zefo, Gatam, y Cenaz.", "words": [[0, 83275], [2, 83360], [6, 83480], [12, 83780], [15, 84120], [22, 84460], [29, 84720], [36, 85264], [42, 85807], [48, 86351], [55, 86894], [57, 87438]]}, {"verse": 12, "start": 88331, "end": 97889, "text": "Y Timna fue concubina de Elifaz, hijo de Esaú, la cual le parió a Amalec: estos son los hijos de Ada, mujer de Esaú.", "words": [[0, 88331], [2, 89117], [8, 89937], [12, 90507], [22, 91077], [25, 91667], [33, 92257], [38, 92437], [41, 92847], [47, 93257], [50, 93397], [55, 93577], [58, 93757], [64, 94157], [66, 94632], [74, 95271], [80, 95582], [84, 95722], [88, 95882], [94, 96122], [97, 96382], [102, 96882], [108, 97082], [111, 97519]]}, {"verse": 13, "start": 98239, "end": 106119, "text": "Y los hijos de Reuel fueron Nahat, Zera, Sama, y Miza: estos son los hijos de Basemat, mujer de Esaú.", "words": [[0, 98239], [2, 98326], [6, 98446], [12, 98746], [15, 99106], [21, 99586], [28, 100361], [35, 101136], [41, 101911], [47, 102211], [49, 102559], [55, 103071], [61, 103513], [65, 103693], [69, 103853], [75, 104133], [78, 104393], [87, 105153], [93, 105413], [96, 105790]]}, {"verse": 14, "start": 106469, "end": 117745, "text": "Estos fueron los hijos de Aholibama, mujer de Esaú, hija de Ana, que fue hija de Zibeón: ella parió a Esaú a Jeús, Jaalam, y Coré.", "words": [[0, 106469], [6, 106734], [13, 106994], [17, 107254], [23, 107614], [26, 107994], [37, 109314], [43, 109694], [46, 109934], [52, 110934], [57, 111294], [60, 111414], [65, 112194], [69, 112214], [73, 112454], [78, 113034], [81, 113517], [89, 114372], [94, 114606], [100, 114839], [102, 115267], [107, 115695], [109, 116123], [115, 116551], [123, 116979], [125, 117390]]}, {"verse": 15, "start": 118095, "end": 130103, "text": "Estos son los jefes de los hijos de Esaú. Hijos de Elifaz, primogénito de Esaú: el jefe Temán, el jefe Omar, el jefe Zefo, el jefe Cenaz,", "words": [[0, 118095], [6, 118562], [10, 118882], [14, 119142], [20, 119802], [23, 120002], [27, 120142], [33, 120482], [36, 120950], [42, 121574], [48, 121919], [51, 122379], [59, 122839], [71, 123759], [74, 124164], [80, 124731], [83, 125147], [88, 125593], [95, 126040], [98, 126493], [103, 126947], [109, 127400], [112, 127867], [117, 128333], [123, 128800], [126, 129252], [131, 129704]]}, {"verse": 16, "start": 130453, "end": 140937, "text": "El jefe Coré, el jefe Gatam, y el jefe Amalec: estos son los jefes de Elifaz en la tierra de Edom; estos fueron los hijos de Ada.", "words": [[0, 130453], [3, 130621], [8, 130961], [14, 131681], [17, 131901], [22, 132241], [29, 133141], [31, 133401], [34, 133521], [39, 134163], [47, 134963], [53, 135323], [57, 135523], [61, 135703], [67, 136223], [70, 136533], [77, 136843], [80, 136983], [83, 137123], [90, 137483], [93, 137723], [99, 138654], [105, 139134], [112, 139354], [116, 139594], [122, 139894], [125, 140214]]}, {"verse": 17, "start": 141287, "end": 158866, "text": "Y estos son los hijos de Reuel, hijo de Esaú: el jefe Nahat, el jefe Zera, el jefe Sama, y el jefe Miza: estos son los jefes de la línea de Reuel en la tierra de Edom; estos hijos vienen de Basemat, mujer de Esaú.", "words": [[0, 141287], [2, 141463], [8, 141723], [12, 142123], [16, 142303], [22, 142583], [25, 143243], [32, 143903], [37, 144263], [40, 144503], [46, 145456], [49, 145582], [54, 146212], [61, 146842], [64, 146882], [69, 147462], [75, 148042], [78, 148062], [83, 148362], [89, 148762], [91, 149282], [94, 149362], [99, 149908], [105, 150651], [111, 151040], [115, 151260], [119, 151460], [125, 152080], [128, 152180], [131, 152320], [137, 152660], [140, 153020], [146, 153380], [149, 153760], [152, 153920], [159, 154300], [162, 154580], [168, 155428], [174, 155920], [180, 156140], [187, 156480], [190, 156760], [199, 157780], [205, 158100], [208, 158510]]}, {"verse": 18, "start": 159216, "end": 172108, "text": "Y estos son los hijos de Aholibama, mujer de Esaú: el jefe Jeús, el jefe Jaalam, y el jefe Coré: estos fueron los jefes que salieron de Aholibama, mujer de Esaú, hija de Ana.", "words": [[0, 159216], [2, 159512], [8, 159712], [12, 160032], [16, 160292], [22, 160612], [25, 161222], [36, 161832], [42, 162092], [45, 162511], [51, 163093], [54, 163217], [59, 163807], [65, 164397], [68, 164477], [73, 164977], [81, 165477], [83, 166017], [86, 166137], [91, 166497], [97, 167241], [103, 167509], [110, 167769], [114, 167989], [120, 168449], [124, 168509], [133, 168969], [136, 169559], [147, 170149], [153, 170349], [156, 170819], [162, 171289], [167, 171589], [170, 171689]]}, {"verse": 19, "start": 172458, "end": 177146, "text": "Estos, pues, son los hijos de Esaú, y sus jefes: él es Edom.", "words": [[0, 172458], [7, 172722], [13, 172922], [17, 173382], [21, 173542], [27, 173842], [30, 174182], [36, 174522], [38, 175002], [42, 175182], [49, 176185], [52, 176386], [55, 176766]]}, {"verse": 20, "start": 177496, "end": 185135, "text": "Y estos son los hijos de Seir horeo, moradores de aquella tierra: Lotán, Sobal, Zibeón, Ana,", "words": [[0, 177496], [2, 177615], [8, 177875], [12, 178275], [16, 178455], [22, 178775], [25, 179215], [30, 179655], [37, 180095], [47, 180915], [50, 181155], [58, 181455], [66, 182922], [73, 183487], [80, 184052], [88, 184617]]}, {"verse": 21, "start": 185485, "end": 192651, "text": "Disón, Ezer, y Disán: estos son los jefes de los horeos, hijos de Seir en la tierra de Edom.", "words": [[0, 185485], [7, 185961], [13, 186471], [15, 186731], [22, 187586], [28, 187992], [32, 188192], [36, 188412], [42, 188932], [45, 189032], [49, 189642], [57, 190252], [63, 190432], [66, 190742], [71, 191052], [74, 191372], [77, 191532], [84, 191872], [87, 192132]]}, {"verse": 22, "start": 193001, "end": 198123, "text": "Los hijos de Lotán fueron Hori y Hemán; y Timna fue hermana de Lotán.", "words": [[0, 193001], [4, 193127], [10, 193447], [13, 193767], [19, 194087], [26, 194537], [31, 194987], [33, 195428], [40, 196049], [42, 196195], [48, 196695], [52, 196935], [60, 197355], [63, 197765]]}, {"verse": 23, "start": 198473, "end": 204216, "text": "Y los hijos de Sobal fueron Alván, Manahat, Ebal, Sefo, y Onán.", "words": [[0, 198473], [2, 198595], [6, 198735], [12, 199035], [15, 199315], [21, 199595], [28, 200395], [35, 201195], [44, 201995], [50, 202795], [56, 203235], [58, 203635]]}, {"verse": 24, "start": 204566, "end": 215534, "text": "Y los hijos de Zibeón fueron Aja, y Ana. Este Ana es el que descubrió los mulos en el desierto, cuando apacentaba los asnos de Zibeón su padre.", "words": [[0, 204566], [2, 204672], [6, 204812], [12, 205092], [15, 205442], [22, 205792], [29, 206296], [34, 206800], [36, 207304], [41, 207966], [46, 208251], [50, 208631], [53, 209171], [56, 209331], [60, 209491], [70, 210051], [74, 210191], [80, 210651], [83, 210811], [86, 210951], [96, 211571], [103, 212151], [114, 213011], [118, 213251], [124, 213811], [127, 214291], [134, 214771], [137, 214871]]}, {"verse": 25, "start": 215884, "end": 219925, "text": "Los hijos de Ana fueron Disón, y Aholibama, hija de Ana.", "words": [[0, 215884], [4, 215988], [10, 216288], [13, 216528], [17, 216688], [24, 216968], [31, 217628], [33, 218355], [44, 219083], [49, 219363], [52, 219483]]}, {"verse": 26, "start": 220275, "end": 225412, "text": "Y estos fueron los hijos de Disón: Hemdán, Eshbán, Itrán, y Querán.", "words": [[0, 220275], [2, 220432], [8, 220692], [15, 221052], [19, 221292], [25, 221592], [28, 221832], [35, 223026], [43, 223321], [51, 223616], [58, 223911], [60, 224661]]}, {"verse": 27, "start": 225762, "end": 229883, "text": "Y estos fueron los hijos de Ezer: Bilhán, Zaaván, y Acán.", "words": [[0, 225762], [2, 225871], [8, 226051], [15, 226311], [19, 226511], [25, 226811], [28, 227187], [34, 228046], [42, 228392], [50, 228739], [52, 229039]]}, {"verse": 28, "start": 230233, "end": 233381, "text": "Estos fueron los hijos de Disán: Huz, y Arán.", "words": [[0, 230233], [6, 230233], [13, 230407], [17, 230627], [23, 230907], [26, 231227], [33, 232706], [38, 232953], [40, 233199]]}, {"verse": 29, "start": 233731, "end": 241917, "text": "Y estos fueron los jefes de los horeos: el jefe Lotán, el jefe Sobal, el jefe Zibeón, el jefe Ana,", "words": [[0, 233731], [2, 233893], [8, 234153], [15, 234573], [19, 234813], [25, 235253], [28, 235353], [32, 235844], [40, 236505], [43, 236651], [48, 236931], [55, 237991], [58, 238071], [63, 238751], [70, 239431], [73, 239451], [78, 240201], [86, 240951], [89, 241031], [94, 241351]]}, {"verse": 30, "start": 242267, "end": 251672, "text": "El jefe Disón, el jefe Ezer, el jefe Disán: estos fueron los jefes de los horeos: por sus ducados en la tierra de Seir.", "words": [[0, 242267], [3, 242397], [8, 243007], [15, 243617], [18, 243857], [23, 244440], [29, 245022], [32, 245082], [37, 245835], [44, 246754], [50, 247102], [57, 247362], [61, 247602], [67, 248042], [70, 248142], [74, 248614], [82, 249223], [86, 249348], [90, 249548], [98, 250108], [101, 250328], [104, 250448], [111, 250788], [114, 251008]]}, {"verse": 31, "start": 252022, "end": 259225, "text": "Y los reyes que reinaron en la tierra de Edom, antes que reinase rey sobre los hijos de Israel, fueron estos:", "words": [[0, 252022], [2, 252145], [6, 252285], [12, 252685], [16, 252885], [25, 253505], [28, 253705], [31, 253825], [38, 254165], [41, 254405], [47, 255265], [53, 255725], [57, 255945], [65, 256565], [69, 256885], [75, 257085], [79, 257325], [85, 257605], [88, 257805], [96, 258365], [103, 258565]]}, {"verse": 32, "start": 259575, "end": 265699, "text": "Bela, hijo de Beor, reinó en Edom: y el nombre de su ciudad fue Dinaba.", "words": [[0, 259658], [6, 260234], [11, 260554], [14, 261034], [20, 261514], [26, 261994], [29, 262314], [35, 263083], [37, 263248], [40, 263428], [47, 263848], [50, 264068], [53, 264268], [60, 264708], [64, 264968]]}, {"verse": 33, "start": 266049, "end": 271965, "text": "Y murió Bela, y reinó en su lugar Jobab, hijo de Zera, de Bosra.", "words": [[0, 266049], [2, 266175], [8, 266775], [14, 267375], [16, 267655], [22, 268315], [25, 268435], [28, 268595], [34, 269365], [41, 270135], [46, 270435], [49, 270875], [55, 271315], [58, 271667]]}, {"verse": 34, "start": 272315, "end": 278104, "text": "Y murió Jobab, y en su lugar reinó Husam, de tierra de Temán.", "words": [[0, 272315], [2, 272436], [8, 273126], [15, 273816], [17, 274116], [20, 274296], [23, 274556], [29, 275209], [35, 275863], [42, 276516], [45, 276736], [52, 277216], [55, 277456]]}, {"verse": 35, "start": 278454, "end": 288726, "text": "Y murió Husam, y reinó en su lugar Adad, hijo de Badad, el que hirió a Madián en el campo de Moab: y el nombre de su ciudad fue Avit.", "words": [[0, 278454], [2, 278618], [8, 279088], [15, 279558], [17, 280218], [23, 280658], [26, 280858], [29, 281038], [35, 281378], [41, 282158], [46, 282378], [49, 282598], [56, 283118], [59, 283258], [63, 283588], [69, 283918], [71, 284208], [78, 284498], [81, 284698], [84, 284818], [90, 285098], [93, 285378], [99, 286194], [101, 286340], [104, 286460], [111, 286860], [114, 287060], [117, 287240], [124, 287660], [128, 288220]]}, {"verse": 36, "start": 289076, "end": 294087, "text": "Y murió Adad, y en su lugar reinó Samla, de Masreca.", "words": [[0, 289076], [2, 289237], [8, 289769], [14, 290302], [16, 290582], [19, 290782], [22, 291022], [28, 291362], [34, 291842], [41, 292482], [44, 293316]]}, {"verse": 37, "start": 294437, "end": 300001, "text": "Y murió Samla, y reinó en su lugar Saúl, de Rehobot del Río.", "words": [[0, 294437], [2, 294584], [8, 295054], [15, 295524], [17, 295984], [23, 296504], [26, 296624], [29, 296804], [35, 297124], [41, 297944], [44, 298474], [52, 299004], [56, 299324]]}, {"verse": 38, "start": 300351, "end": 305970, "text": "Y murió Saúl, y en lugar suyo reinó Baal-hanán, hijo de Acbor.", "words": [[0, 300351], [2, 300477], [8, 300777], [14, 301697], [16, 301957], [19, 302097], [25, 302377], [30, 303184], [36, 303990], [48, 304797], [53, 305157], [56, 305593]]}, {"verse": 39, "start": 306320, "end": 319760, "text": "Y murió Baal-hanán, hijo de Acbor, y reinó Adar en lugar suyo: y el nombre de su ciudad fue Pau; y el nombre de su mujer Mehetabel, hija de Matred, hija de Mezaab.", "words": [[0, 306320], [2, 306580], [8, 307310], [20, 308040], [25, 308380], [28, 308940], [35, 309500], [37, 309600], [43, 310050], [48, 310500], [51, 310720], [57, 311000], [63, 312035], [65, 312162], [68, 312262], [75, 312642], [78, 312842], [81, 313062], [88, 313542], [92, 313727], [97, 314660], [99, 314792], [102, 314912], [109, 315252], [112, 315452], [115, 315652], [121, 316452], [132, 317252], [137, 317612], [140, 317692], [148, 318572], [153, 318892], [156, 319360]]}, {"verse": 40, "start": 320110, "end": 331325, "text": "Estos, pues, son los nombres de los jefes de Esaú por sus linajes, por sus lugares, y sus nombres: el jefe Timna, el jefe Alva, el jefe Jetet,", "words": [[0, 320286], [7, 320496], [13, 321116], [17, 321456], [21, 321636], [29, 322116], [32, 322296], [36, 322416], [42, 322816], [45, 323136], [50, 323456], [54, 323556], [58, 323776], [67, 324836], [71, 324956], [75, 325386], [84, 325816], [86, 326036], [90, 326196], [99, 327120], [102, 327337], [107, 327577], [114, 328697], [117, 329210], [122, 329724], [128, 330237], [131, 330600], [136, 330962]]}, {"verse": 41, "start": 331675, "end": 335667, "text": "El duque Aholibama, el duque Ela, el duque Pinón,", "words": [[0, 331675], [3, 331881], [9, 332641], [20, 333401], [23, 333721], [29, 334101], [34, 334621], [37, 334641], [43, 334941]]}, {"verse": 42, "start": 336017, "end": 339834, "text": "El duque Cenaz, el duque Temán, el duque Mibzar,", "words": [[0, 336017], [3, 336158], [9, 336798], [16, 337438], [19, 337518], [25, 337818], [32, 338638], [35, 338718], [41, 339276]]}, {"verse": 43, "start": 340184, "end": 352166, "text": "El jefe Magdiel, y el jefe Hiram. Estos fueron los jefes de Edom por sus habitaciones en la tierra de su posesión. Edom es el mismo Esaú, padre de los edomitas.", "words": [[0, 340184], [3, 340631], [8, 341077], [17, 341524], [19, 341784], [22, 342172], [27, 342560], [34, 343144], [40, 343489], [47, 343749], [51, 343969], [57, 344429], [60, 344699], [65, 344969], [69, 345149], [73, 345329], [86, 346069], [89, 346289], [92, 346429], [99, 346769], [102, 346949], [105, 347129], [115, 348144], [120, 348571], [123, 349031], [126, 349331], [132, 349879], [138, 350426], [144, 350946], [147, 351086], [151, 351226]]}]}