{"book": "GEN", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 237419, "verses": [{"verse": 1, "start": 300, "end": 12280, "text": "Y aconteció en los días de Amrafel, rey de Sinar, Arioc, rey de Elasar, Quedorlaomer, rey de Elá, y Tidal, rey de naciones,", "words": [[0, 300], [2, 466], [12, 1266], [15, 1466], [19, 1566], [24, 1786], [27, 1946], [36, 3066], [40, 3426], [43, 3546], [50, 4346], [57, 5266], [61, 5806], [64, 6505], [72, 7204], [86, 7904], [90, 8446], [93, 8606], [98, 9166], [100, 9706], [107, 10566], [111, 11146], [114, 11306]]}, {"verse": 2, "start": 12630, "end": 29743, "text": "Que estos hicieron guerra contra Bera, rey de Sodoma, y contra Birsa, rey de Gomorra, y contra Sinab, rey de Adma, y contra Semeber, rey de Zeboim, y contra el rey de Bela, la cual es Zoar.", "words": [[0, 12630], [4, 12754], [10, 13114], [19, 13834], [26, 14254], [33, 15134], [39, 16014], [43, 16274], [46, 16354], [54, 17514], [56, 17534], [63, 18184], [70, 18834], [74, 19134], [77, 19234], [86, 20474], [88, 20494], [95, 20814], [102, 21734], [106, 22274], [109, 22394], [115, 23189], [117, 23209], [124, 24029], [133, 24849], [137, 25509], [140, 26098], [148, 26908], [150, 27032], [157, 27332], [160, 27572], [164, 27892], [167, 28212], [173, 28532], [176, 28772], [181, 29012], [184, 29408]]}, {"verse": 3, "start": 30093, "end": 34980, "text": "Todos estos se juntaron en el valle de Siddim, que es el mar salado.", "words": [[0, 30093], [6, 30336], [12, 30736], [15, 31036], [24, 31656], [27, 31836], [30, 32016], [36, 32276], [39, 32796], [47, 33316], [51, 33536], [54, 33736], [57, 33896], [61, 34196]]}, {"verse": 4, "start": 35330, "end": 41791, "text": "Doce años habían servido a Quedorlaomer, y al décimotercio año se rebelaron.", "words": [[0, 35477], [5, 35657], [10, 36177], [17, 36657], [25, 37357], [27, 37927], [41, 38497], [43, 38852], [46, 39512], [59, 40172], [63, 40492], [66, 41174]]}, {"verse": 5, "start": 42141, "end": 56369, "text": "Y en el año decimocuarto vino Quedorlaomer, y los reyes que estaban de su parte, y derrotaron a los refaítas en Astarot Karnaim, a los zuzitas en Ham, y a los emitas en Save-quiriataim.", "words": [[0, 42141], [2, 42266], [5, 42406], [8, 42526], [12, 43006], [25, 43486], [30, 44462], [44, 45439], [46, 45551], [50, 45871], [56, 46191], [60, 46271], [68, 46610], [71, 46811], [74, 46931], [81, 47311], [83, 47811], [94, 48610], [96, 48851], [100, 49320], [109, 49791], [112, 50418], [120, 51044], [129, 51671], [131, 51691], [135, 52041], [143, 52390], [146, 52930], [151, 53688], [153, 53815], [155, 53895], [159, 54035], [166, 54575], [169, 55498]]}, {"verse": 6, "start": 56719, "end": 63133, "text": "Y a los horeos en el monte de Seir, hasta la llanura de Parán, que está junto al desierto.", "words": [[0, 56719], [2, 56841], [4, 56921], [8, 57271], [15, 57621], [18, 57841], [21, 57981], [27, 58281], [30, 58521], [36, 59301], [42, 59741], [45, 59921], [53, 60301], [56, 60461], [63, 61421], [67, 61501], [72, 61721], [78, 62061], [81, 62321]]}, {"verse": 7, "start": 63483, "end": 74903, "text": "Y volvieron, y vinieron a En-mispat, que es Cades, y devastaron todo el territorio de los amalecitas, y también al amorreo, que habitaba en Hazezón-tamar.", "words": [[0, 63483], [2, 63609], [13, 64069], [15, 64309], [24, 64769], [26, 65459], [37, 66149], [41, 66229], [44, 66409], [51, 67369], [53, 67449], [64, 68129], [69, 68389], [72, 68629], [83, 69269], [86, 69369], [90, 69489], [102, 70789], [104, 70849], [112, 71169], [115, 71529], [124, 72769], [128, 72889], [137, 73429], [140, 74187]]}, {"verse": 8, "start": 75253, "end": 88565, "text": "Y salió el rey de Sodoma, y el rey de Gomorra, y el rey de Adma, y el rey de Zeboim, y el rey de Bela, que es Zoar, y ordenaron contra ellos batalla en el valle de Siddim;", "words": [[0, 75253], [2, 75397], [8, 75797], [11, 75997], [15, 76277], [18, 76357], [26, 77157], [28, 77677], [31, 77817], [35, 78077], [38, 78157], [47, 79057], [49, 79357], [52, 79517], [56, 79837], [59, 79917], [65, 80797], [67, 81057], [70, 81197], [74, 81497], [77, 82047], [85, 82597], [87, 82857], [90, 83017], [94, 83317], [97, 83417], [103, 84097], [107, 84197], [110, 84597], [116, 85162], [118, 85342], [128, 86002], [135, 86342], [141, 86682], [149, 87262], [152, 87422], [155, 87612], [161, 87802], [164, 88212]]}, {"verse": 9, "start": 88915, "end": 102013, "text": "Es decir, contra Quedorlaomer, rey de Elam, y Tidal, rey de naciones, y Amrafel, rey de Sinar, y Arioc, rey de Elasar; cuatro reyes contra cinco.", "words": [[0, 88915], [3, 89253], [10, 89986], [17, 90720], [31, 91453], [35, 91893], [38, 91993], [44, 92453], [46, 92833], [53, 93653], [57, 94093], [60, 94153], [70, 94713], [72, 95323], [81, 95933], [85, 96353], [88, 96473], [95, 96893], [97, 97193], [104, 98153], [108, 98713], [111, 98913], [119, 100127], [126, 100297], [132, 100897], [139, 101483]]}, {"verse": 10, "start": 102363, "end": 113273, "text": "Y el valle de Siddim estaba lleno de pozos de asfalto: y huyeron el rey de Sodoma y el de Gomorra, y cayeron allí; y los demás huyeron al monte.", "words": [[0, 102363], [2, 102508], [5, 102648], [11, 102928], [14, 103328], [21, 103728], [28, 104148], [34, 104588], [37, 104688], [43, 105168], [46, 105288], [55, 106307], [57, 106436], [65, 106976], [68, 107196], [72, 107576], [75, 107636], [82, 108216], [84, 108416], [87, 108536], [90, 108656], [99, 109336], [101, 109791], [109, 110246], [115, 110864], [117, 111146], [121, 111306], [127, 111646], [135, 112446], [138, 112586]]}, {"verse": 11, "start": 113623, "end": 119616, "text": "Y tomaron toda la riqueza de Sodoma y de Gomorra, y todas sus provisiones, y se fueron.", "words": [[0, 113623], [2, 113727], [10, 114167], [15, 114487], [18, 114747], [26, 115287], [29, 115427], [36, 115967], [38, 116087], [41, 116187], [50, 116787], [52, 117207], [58, 117467], [62, 117767], [75, 118692], [77, 118832], [80, 118972]]}, {"verse": 12, "start": 119966, "end": 127329, "text": "Tomaron también a Lot, hijo del hermano de Abram, que moraba en Sodoma, y sus bienes, y se fueron.", "words": [[0, 119966], [8, 120349], [16, 120709], [18, 121029], [23, 121749], [28, 122129], [32, 122389], [40, 122929], [43, 123029], [50, 123909], [54, 123989], [61, 124449], [64, 124629], [72, 125269], [74, 125629], [78, 125789], [86, 126469], [88, 126709], [91, 126829]]}, {"verse": 13, "start": 127679, "end": 142260, "text": "Y vino uno de los que escaparon, y se lo comunicó a Abram el hebreo, que habitaba en el valle de Mamre amorreo, hermano de Escol y hermano de Aner, los cuales estaban confederados con Abram.", "words": [[0, 127679], [2, 127820], [7, 128080], [11, 128500], [14, 128700], [18, 128820], [22, 129000], [33, 130200], [35, 130420], [38, 130520], [41, 130660], [50, 131380], [52, 131700], [58, 132020], [61, 132380], [69, 133480], [73, 133540], [82, 134080], [85, 134240], [88, 134360], [94, 134640], [97, 134970], [103, 135300], [112, 136440], [120, 136960], [123, 137340], [129, 137720], [131, 138120], [139, 138580], [142, 138700], [148, 139579], [152, 139720], [159, 139980], [167, 140480], [180, 141500], [184, 141880]]}, {"verse": 14, "start": 142610, "end": 152973, "text": "Y oyó Abram que su hermano estaba prisionero, y armó sus criados, los criados de su casa, trescientos dieciocho, y los siguió hasta Dan.", "words": [[0, 142610], [2, 142924], [6, 143404], [12, 143704], [16, 143844], [19, 144024], [27, 144504], [34, 144724], [46, 145624], [48, 146044], [53, 146384], [57, 146524], [66, 147584], [70, 147724], [78, 148164], [81, 148324], [84, 148484], [90, 149397], [102, 150311], [113, 151224], [115, 151424], [119, 151584], [126, 152062], [132, 152539]]}, {"verse": 15, "start": 153323, "end": 162503, "text": "Y cayó sobre ellos de noche él y sus siervos, y los hirió, y los fue siguiendo hasta Hobah, que está a la izquierda de Damasco.", "words": [[0, 153323], [2, 153453], [7, 153853], [13, 154113], [19, 154413], [22, 154593], [28, 154913], [31, 155333], [33, 155553], [37, 155713], [46, 156333], [48, 156786], [52, 157240], [59, 157693], [61, 157833], [65, 157973], [69, 158193], [79, 158753], [85, 159383], [92, 160013], [96, 160073], [101, 160413], [103, 160733], [106, 160833], [116, 161513], [119, 161653]]}, {"verse": 16, "start": 162853, "end": 170034, "text": "Y recobró todos los bienes, y también a Lot su hermano y sus bienes, y también las mujeres y gente.", "words": [[0, 162853], [2, 163021], [10, 163721], [16, 163981], [20, 164341], [28, 165241], [30, 165301], [38, 165641], [40, 165921], [44, 166261], [47, 166441], [55, 167021], [57, 167121], [61, 167301], [69, 168181], [71, 168201], [79, 168501], [83, 168681], [91, 169041], [93, 169341]]}, {"verse": 17, "start": 170384, "end": 181582, "text": "Y salió el rey de Sodoma a recibirlo, cuando volvía de la derrota de Quedorlaomer y de los reyes que con él estaban, al valle de Save, que es el valle del Rey.", "words": [[0, 170384], [2, 170528], [8, 170928], [11, 171168], [15, 171568], [18, 171648], [25, 172208], [27, 172368], [38, 173448], [45, 173908], [52, 174548], [55, 174688], [58, 174828], [66, 175308], [69, 175868], [82, 176428], [84, 176608], [87, 176708], [91, 176868], [97, 177268], [101, 177448], [105, 177708], [108, 177828], [117, 178828], [120, 178948], [126, 179188], [129, 179603], [135, 180176], [139, 180321], [142, 180481], [145, 180601], [151, 180881], [155, 181081]]}, {"verse": 18, "start": 181932, "end": 189665, "text": "Entonces Melquisedec, rey de Salem, sacó pan y vino; el cual era sacerdote del Dios alto;", "words": [[0, 181932], [9, 182877], [22, 183857], [26, 184337], [29, 184437], [36, 184817], [41, 185577], [45, 185877], [47, 186097], [53, 186817], [56, 186963], [61, 187403], [65, 187843], [75, 188283], [79, 188623], [84, 188883]]}, {"verse": 19, "start": 190015, "end": 196686, "text": "Y le bendijo, y dijo: Bendito sea Abram del Dios alto, poseedor de los cielos y de la tierra;", "words": [[0, 190015], [2, 190141], [5, 190241], [14, 190861], [16, 191481], [22, 192201], [30, 192708], [34, 192948], [40, 193368], [44, 193508], [49, 193728], [55, 194568], [64, 195108], [67, 195268], [71, 195388], [78, 195828], [80, 195928], [83, 196008], [86, 196108]]}, {"verse": 20, "start": 197036, "end": 203825, "text": "Y bendito sea el Dios alto, que entregó tus enemigos en tu mano. Y le dio Abram los diezmos de todo.", "words": [[0, 197036], [2, 197134], [10, 197614], [14, 197894], [17, 198014], [22, 198274], [28, 198594], [32, 199054], [40, 199514], [44, 199674], [53, 200154], [56, 200354], [59, 200454], [65, 201185], [67, 201332], [70, 201472], [74, 201912], [80, 202352], [84, 202512], [92, 203052], [95, 203252]]}, {"verse": 21, "start": 204175, "end": 210647, "text": "Entonces el rey de Sodoma dijo a Abram: Dame las personas, y toma para ti los bienes.", "words": [[0, 204175], [9, 204745], [12, 205305], [16, 205645], [19, 205705], [26, 206185], [31, 206505], [33, 206825], [40, 207683], [45, 207907], [49, 208127], [59, 208647], [61, 209027], [66, 209287], [71, 209527], [74, 209767], [78, 209947]]}, {"verse": 22, "start": 210927, "end": 218477, "text": "Y respondió Abram al rey de Sodoma: He alzado mi mano a Jehová Dios alto, poseedor de los cielos y de la tierra,", "words": [[0, 210927], [2, 211050], [12, 211590], [18, 212130], [21, 212770], [25, 213190], [28, 213290], [36, 214211], [39, 214337], [46, 214757], [49, 214897], [54, 215157], [56, 215463], [63, 215768], [68, 216074], [74, 216380], [83, 216902], [86, 217062], [90, 217182], [97, 217662], [99, 217762], [102, 217862], [105, 217942]]}, {"verse": 23, "start": 218827, "end": 226879, "text": "Que desde un hilo hasta la correa de un calzado, nada tomaré de todo lo que es tuyo, para que no digas: Yo enriquecí a Abram:", "words": [[0, 218827], [4, 218925], [10, 219085], [13, 219365], [18, 219605], [24, 219845], [27, 220145], [34, 220445], [37, 220525], [40, 220625], [49, 221645], [54, 221925], [61, 222425], [64, 222545], [69, 222785], [72, 223005], [76, 223125], [79, 223345], [85, 223885], [90, 224185], [94, 224345], [97, 224465], [104, 225259], [107, 225420], [117, 226080], [119, 226360]]}, {"verse": 24, "start": 227229, "end": 237019, "text": "Sacando solamente lo que comieron los jóvenes, y la porción de los varones que fueron conmigo, Aner, Escol, y Mamre; los cuales tomarán su parte.", "words": [[0, 227229], [8, 227662], [18, 228042], [21, 228322], [25, 228442], [34, 228782], [38, 229002], [47, 229422], [49, 229802], [52, 229922], [60, 230282], [63, 230442], [67, 230562], [75, 230942], [79, 231122], [86, 231662], [95, 232202], [101, 232872], [108, 233542], [110, 233987], [117, 234611], [121, 234711], [128, 235221], [136, 235621], [139, 235781]]}]}