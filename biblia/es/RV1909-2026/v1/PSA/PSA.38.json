{"book": "PSA", "chapter": 38, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 136056, "verses": [{"verse": 1, "start": 300, "end": 7518, "text": "Salmo de David, para recordar. JEHOVÁ, no me reprendas en tu furor, ni me castigues en tu ira.", "words": [[0, 300], [6, 743], [9, 903], [16, 1203], [21, 1563], [31, 2869], [39, 3371], [42, 3451], [45, 3631], [55, 4431], [58, 4631], [61, 4831], [68, 5361], [71, 5891], [74, 6071], [84, 6691], [87, 6851], [90, 7051]]}, {"verse": 2, "start": 7968, "end": 12735, "text": "Porque tus flechas descendieron a mí, y sobre mí ha caído tu mano.", "words": [[0, 7968], [7, 8431], [11, 8651], [19, 9091], [32, 9831], [34, 10011], [38, 10211], [40, 10731], [46, 10991], [49, 11311], [52, 11571], [58, 11971], [61, 12171]]}, {"verse": 3, "start": 13185, "end": 20378, "text": "No hay sanidad en mi carne a causa de tu ira; ni hay paz en mis huesos a causa de mi pecado.", "words": [[0, 13185], [3, 13453], [7, 13693], [15, 14353], [18, 14593], [21, 14953], [27, 15313], [29, 15473], [35, 15773], [38, 16053], [41, 16253], [46, 17109], [49, 17389], [53, 17549], [57, 17829], [60, 18169], [64, 18349], [71, 18889], [73, 19029], [79, 19329], [82, 19589], [85, 19729]]}, {"verse": 4, "start": 20828, "end": 27539, "text": "Porque mis iniquidades han pasado mi cabeza: como carga pesada se han agravado sobre mí.", "words": [[0, 20828], [7, 21052], [11, 21292], [23, 22332], [27, 22732], [34, 23212], [37, 23492], [45, 24512], [50, 24695], [56, 25095], [63, 25755], [66, 25975], [70, 26135], [79, 26855], [85, 27095]]}, {"verse": 5, "start": 27989, "end": 32505, "text": "Se pudrieron, se corrompieron mis llagas, a causa de mi locura.", "words": [[0, 27989], [3, 28130], [14, 28970], [17, 29050], [30, 29850], [34, 30340], [42, 30830], [44, 31250], [50, 31510], [53, 31790], [56, 31890]]}, {"verse": 6, "start": 32955, "end": 37995, "text": "Estoy encorvado, estoy humillado en gran manera, ando enlutado todo el día.", "words": [[0, 32955], [6, 33182], [17, 34322], [23, 34442], [33, 35022], [36, 35182], [41, 35322], [49, 36002], [54, 36422], [63, 37002], [68, 37222], [71, 37482]]}, {"verse": 7, "start": 38445, "end": 43026, "text": "Porque mis lomos están llenos de irritación, y no hay sanidad en mi carne.", "words": [[0, 38445], [7, 38686], [11, 38866], [17, 39246], [23, 39586], [30, 40006], [33, 40146], [45, 40866], [47, 41406], [50, 41546], [54, 41666], [62, 42106], [65, 42306], [68, 42446]]}, {"verse": 8, "start": 43476, "end": 49345, "text": "Estoy debilitado y molido en gran manera; bramo a causa de la conmoción de mi corazón.", "words": [[0, 43476], [6, 43869], [17, 44589], [19, 44729], [26, 45129], [29, 45269], [34, 45449], [42, 46415], [48, 46845], [50, 47045], [56, 47345], [59, 47585], [62, 47685], [72, 48305], [75, 48505], [78, 48605]]}, {"verse": 9, "start": 49795, "end": 56286, "text": "Señor, delante de ti están todos mis deseos; y mi suspiro no te es oculto.", "words": [[0, 49795], [7, 50966], [15, 51386], [18, 51546], [21, 51786], [27, 52086], [33, 52486], [37, 52806], [45, 53985], [47, 54113], [50, 54253], [58, 54993], [61, 55153], [64, 55550], [67, 55948]]}, {"verse": 10, "start": 56736, "end": 63586, "text": "Mi corazón está acongojado, me ha dejado mi vigor; y aun la misma luz de mis ojos no está conmigo.", "words": [[0, 56736], [3, 56859], [11, 57299], [16, 57679], [28, 58899], [31, 59019], [34, 59099], [41, 59519], [44, 59679], [51, 60459], [53, 60604], [57, 60784], [60, 60984], [66, 61204], [70, 61604], [73, 62004], [77, 62144], [82, 62424], [85, 62644], [90, 62784]]}, {"verse": 11, "start": 64036, "end": 70580, "text": "Mis amigos y mis compañeros se quitaron de delante de mi plaga; y mis cercanos se pusieron lejos.", "words": [[0, 64036], [4, 64144], [11, 64504], [13, 64684], [17, 64824], [28, 65544], [31, 65924], [40, 66404], [43, 66544], [51, 66984], [54, 67144], [57, 67304], [64, 68295], [66, 68394], [70, 68514], [79, 69134], [82, 69374], [91, 69834]]}, {"verse": 12, "start": 71030, "end": 79955, "text": "Y los que buscaban mi alma armaron lazos; y los que procuraban mi mal hablaban iniquidades, y meditaban fraudes todo el día.", "words": [[0, 71030], [2, 71137], [6, 71257], [10, 71417], [19, 71977], [22, 72217], [27, 72517], [35, 73137], [42, 74199], [44, 74284], [48, 74384], [52, 74524], [63, 75144], [66, 75384], [70, 75664], [79, 76384], [92, 77284], [94, 77824], [104, 78404], [112, 78964], [117, 79284], [120, 79524]]}, {"verse": 13, "start": 80405, "end": 86624, "text": "Mas yo, como si fuera sordo, no oía; y estaba como un mudo, que no abre su boca.", "words": [[0, 80405], [4, 80595], [8, 80755], [13, 80975], [16, 81175], [22, 81435], [29, 82355], [32, 82515], [37, 83472], [39, 83597], [46, 83977], [51, 84357], [54, 84577], [60, 85097], [64, 85317], [67, 85537], [72, 85777], [75, 86017]]}, {"verse": 14, "start": 87074, "end": 92119, "text": "fui pues como un hombre que no oye, y que en su boca no tiene reprensiones.", "words": [[0, 87074], [4, 87345], [9, 87525], [14, 87845], [17, 88085], [24, 88405], [28, 88605], [31, 88805], [36, 89205], [38, 89645], [42, 89785], [45, 89905], [48, 90085], [53, 90445], [56, 90645], [62, 90965]]}, {"verse": 15, "start": 92569, "end": 97945, "text": "Porque a ti, oh Jehová, esperé yo: tú responderás, Jehová Dios mío.", "words": [[0, 92569], [7, 92812], [9, 92992], [13, 93319], [16, 93645], [24, 93972], [31, 94292], [35, 95030], [38, 95234], [51, 96774], [58, 97154], [63, 97314]]}, {"verse": 16, "start": 98395, "end": 105076, "text": "Porque dije: Que no se alegren de mí: cuando mi pie resbalaba, sobre mí se engrandecían.", "words": [[0, 98522], [7, 98682], [13, 99620], [17, 99840], [20, 100000], [23, 100160], [31, 100680], [34, 100840], [38, 101511], [45, 101695], [48, 102115], [52, 102535], [63, 102955], [69, 103415], [72, 103675], [75, 103895]]}, {"verse": 17, "start": 105526, "end": 110217, "text": "Pero yo estoy a punto de caer, y mi dolor está delante de mí continuamente.", "words": [[0, 105526], [5, 105670], [8, 105870], [14, 106090], [16, 106210], [22, 106470], [25, 106730], [31, 107230], [33, 107710], [36, 107850], [42, 108130], [47, 108430], [55, 108910], [58, 109070], [61, 109190]]}, {"verse": 18, "start": 110667, "end": 115116, "text": "Por tanto confesaré mi maldad; me angustiaré por mi pecado.", "words": [[0, 110667], [4, 110927], [10, 111387], [20, 112227], [23, 112327], [31, 113345], [34, 113693], [45, 114073], [49, 114273], [52, 114433]]}, {"verse": 19, "start": 115566, "end": 121772, "text": "Porque mis enemigos están vivos y fuertes: y se han aumentado los que me aborrecen sin causa:", "words": [[0, 115566], [7, 115748], [11, 115948], [20, 116528], [26, 116768], [32, 117388], [34, 117508], [43, 118576], [45, 118704], [48, 118844], [52, 119004], [62, 119744], [66, 119904], [70, 120064], [73, 120204], [83, 120724], [87, 120964]]}, {"verse": 20, "start": 122222, "end": 126959, "text": "Y pagando mal por bien me son contrarios, por seguir yo lo bueno.", "words": [[0, 122222], [2, 122470], [10, 122950], [14, 123230], [18, 123490], [23, 123710], [26, 123930], [30, 124170], [42, 125390], [46, 125690], [53, 125990], [56, 126310], [59, 126450]]}, {"verse": 21, "start": 127409, "end": 131531, "text": "No me desampares, oh Jehová: Dios mío, no te alejes de mí.", "words": [[0, 127409], [3, 127647], [6, 127787], [18, 128397], [21, 129007], [29, 129967], [34, 130138], [39, 130458], [42, 130538], [45, 130718], [52, 131058], [55, 131218]]}, {"verse": 22, "start": 131981, "end": 135656, "text": "Apresúrate a ayudarme, oh Señor, mi salvación.", "words": [[0, 131981], [11, 132800], [13, 133020], [23, 133720], [26, 133840], [33, 134640], [36, 134800]]}]}