65], [39, 63560], [46, 63861], [48, 64101], [53, 64261], [62, 64641], [67, 64881], [75, 65201], [78, 65481]]}, {"verse": 12, "start": 66440, "end": 70391, "text": "I will meditate also of all your work, and talk of your doings.", "words": [[0, 66440], [2, 66599], [7, 66759], [16, 67219], [21, 67719], [24, 67999], [28, 68159], [33, 68339], [39, 68719], [43, 68999], [48, 69339], [51, 69539], [56, 69679]]}, {"verse": 13, "start": 70841, "end": 76648, "text": "Your way, O God, is in the sanctuary: who is so great a God as our God?", "words": [[0, 70841], [5, 71030], [10, 71470], [12, 71490], [17, 72150], [20, 72290], [23, 72450], [27, 72570], [38, 73663], [42, 73788], [45, 73988], [48, 74248], [54, 74588], [56, 74728], [60, 75048], [63, 75388], [67, 75608]]}, {"verse": 14, "start": 77098, "end": 81898, "text": "You are the God that do wonders: you have declared your strength among the people.", "words": [[0, 77098], [4, 77243], [8, 77363], [12, 77483], [16, 77843], [21, 78103], [24, 78303], [33, 79426], [37, 79552], [42, 79712], [51, 80112], [56, 80352], [65, 80792], [71, 81092], [75, 81332]]}, {"verse": 15, "start": 82348, "end": 87628, "text": "You have with your arm redeemed your people, the sons of Jacob and Joseph. Selah.", "words": [[0, 82348], [4, 82471], [9, 82671], [14, 82871], [19, 83051], [23, 83391], [32, 83991], [37, 84151], [45, 84911], [49, 84971], [54, 85271], [57, 85491], [63, 85831], [67, 86031], [75, 87311]]}, {"verse": 16, "start": 88078, "end": 94620, "text": "The waters saw you, O God, the waters saw you; they were afraid: the depths also were troubled.", "words": [[0, 88078], [4, 88280], [11, 88500], [15, 88940], [20, 89360], [22, 89480], [27, 90020], [31, 90230], [38, 90440], [42, 90880], [47, 91589], [52, 91711], [57, 91911], [65, 92911], [69, 92994], [76, 93294], [81, 93794], [86, 94054]]}, {"verse": 17, "start": 95070, "end": 101681, "text": "The clouds poured out water: the skies sent out a sound: your arrows also went abroad.", "words": [[0,