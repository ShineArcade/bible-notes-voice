{"book": "ACT", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 337406, "verses": [{"verse": 1, "start": 300, "end": 9766, "text": "Entonces algunos que venían de Judea enseñaban a los hermanos: Que si no os circuncidáis conforme al rito de Moisés, no podéis ser salvos.", "words": [[0, 300], [9, 1027], [17, 1427], [21, 1667], [28, 2047], [31, 2187], [37, 2727], [47, 3627], [49, 3747], [53, 3847], [63, 4758], [67, 5261], [70, 5433], [73, 5503], [76, 5573], [89, 6513], [98, 7073], [101, 7153], [106, 7413], [109, 7513], [117, 8353], [120, 8553], [127, 8873], [131, 9113]]}, {"verse": 2, "start": 10046, "end": 25820, "text": "Así que, al surgir una fuerte discusión y controversia entre ellos y Pablo y Bernabé, determinaron que subiesen Pablo y Bernabé a Jerusalén, y algunos otros de ellos, a los apóstoles y a los ancianos, sobre esta cuestión.", "words": [[0, 10046], [4, 10279], [9, 10499], [12, 10759], [19, 11239], [23, 11419], [30, 11679], [40, 12439], [42, 12519], [55, 13219], [61, 13499], [67, 13839], [69, 14039], [75, 14399], [77, 14559], [86, 15339], [99, 16299], [103, 16479], [112, 16979], [118, 17499], [120, 17699], [128, 18259], [130, 18399], [141, 19139], [143, 19839], [151, 20159], [157, 20579], [160, 20819], [167, 21618], [169, 21741], [173, 21881], [183, 22601], [185, 23221], [187, 23301], [191, 23461], [201, 24221], [207, 24781], [212, 25061]]}, {"verse": 3, "start": 26170, "end": 37835, "text": "Ellos, pues, habiendo sido acompañados de la iglesia, pasaron por la Fenicia y Samaria, contando la conversión de los Gentiles; y daban gran gozo a todos los hermanos.", "words": [[0, 26170], [7, 26460], [13, 27320], [22, 27640], [27, 27920], [39, 28720], [42, 28880], [45, 28980], [54, 29920], [62, 30340], [66, 30560], [69, 30740], [77, 31260], [79, 31380], [88, 31920], [97, 32780], [100, 32900], [111, 33480], [114, 33600], [118, 33720], [128, 34789], [130, 34913], [136, 35273], [141, 35573], [146, 36173], [148, 36433], [154, 36733], [158, 37013]]}, {"verse": 4, "start": 38185, "end": 47621, "text": "Y llegados a Jerusalén, fueron recibidos de la iglesia y de los apóstoles y de los ancianos: y refirieron todas las cosas que Dios había hecho con ellos.", "words": [[0, 38185], [2, 38288], [11, 38768], [13, 38948], [24, 39648], [31, 40128], [41, 40948], [44, 41088], [47, 41188], [55, 41668], [57, 41788], [60, 41868], [64, 41988], [74, 42608], [76, 42808], [79, 42868], [83, 43008], [93, 43986], [95, 44354], [106, 44754], [112, 45054], [116, 45354], [122, 45694], [126, 45954], [131, 46174], [137, 46534], [143, 46854], [147, 47094]]}, {"verse": 5, "start": 47971, "end": 58094, "text": "Pero algunos de la secta de los fariseos, que habían creído, se levantaron, diciendo: Que es necesario circuncidarlos, y mandarles que guarden la ley de Moisés.", "words": [[0, 47971], [5, 48135], [13, 48575], [16, 48795], [19, 48915], [25, 49395], [28, 49475], [32, 49615], [42, 50295], [46, 50615], [53, 50855], [61, 51395], [64, 51755], [76, 52555], [86, 53827], [90, 53941], [93, 54021], [103, 54601], [119, 55641], [121, 55876], [131, 56416], [135, 56596], [143, 56976], [146, 57096], [150, 57276], [153, 57396]]}, {"verse": 6, "start": 58374, "end": 62732, "text": "Y se juntaron los apóstoles y los ancianos para conocer de este asunto.", "words": [[0, 58374], [2, 58524], [5, 58644], [14, 59244], [18, 59404], [28, 60104], [30, 60264], [34, 60424], [43, 60944], [48, 61144], [56, 61604], [59, 61804], [64, 62044]]}, {"verse": 7, "start": 63082, "end": 76220, "text": "Y habiendo habido grande contienda, levantándose Pedro, les dijo: Varones hermanos, vosotros sabéis cómo ya hace algún tiempo que Dios escogió que los Gentiles oyesen por mi boca la palabra del evangelio, y creyesen.", "words": [[0, 63082], [2, 63207], [11, 63587], [18, 63887], [25, 64187], [36, 64967], [49, 65867], [56, 66807], [60, 66907], [66, 67796], [74, 67996], [84, 68516], [93, 68996], [100, 69496], [105, 69776], [108, 70096], [113, 70356], [119, 70616], [126, 70956], [130, 71216], [135, 71436], [143, 72016], [147, 72156], [151, 72276], [160, 72836], [167, 73336], [171, 73476], [174, 73636], [179, 73876], [182, 74056], [190, 74376], [194, 74576], [205, 75256], [207, 75436]]}, {"verse": 8, "start": 76570, "end": 83043, "text": "Y Dios, que conoce los corazones, les dio testimonio, dándoles el Espíritu Santo también como a nosotros;", "words": [[0, 76570], [2, 76693], [8, 76913], [12, 77113], [19, 77573], [23, 77713], [34, 78813], [38, 78973], [42, 79213], [54, 80153], [63, 80533], [66, 80733], [75, 81293], [81, 81573], [89, 82053], [94, 82353], [96, 82493]]}, {"verse": 9, "start": 83393, "end": 88923, "text": "Y ninguna diferencia hizo entre nosotros y ellos, purificando con la fe sus corazones.", "words": [[0, 83393], [2, 83493], [10, 83813], [21, 84473], [26, 84953], [32, 85233], [41, 85753], [43, 86073], [50, 86733], [62, 87473], [66, 87673], [69, 87833], [72, 88013], [76, 88213]]}, {"verse": 10, "start": 89273, "end": 97579, "text": "Ahora pues, ¿por qué tentáis a Dios, poniendo sobre el cuello de los discípulos yugo, que ni nuestros padres ni nosotros hemos podido llevar?", "words": [[0, 89273], [6, 89529], [12, 90169], [17, 90249], [21, 90429], [29, 90889], [31, 91029], [37, 91709], [46, 92109], [52, 92389], [55, 92569], [62, 92869], [65, 92949], [69, 93109], [80, 93689], [86, 94369], [90, 94629], [93, 94749], [102, 95049], [109, 95589], [112, 95829], [121, 96209], [127, 96569], [134, 97049]]}, {"verse": 11, "start": 97929, "end": 102668, "text": "Más bien, por la gracia del Señor Jesús creemos que seremos salvos, como también ellos.", "words": [[0, 97929], [4, 98108], [10, 98248], [14, 98448], [17, 98588], [24, 98988], [28, 99088], [34, 99348], [40, 100028], [48, 100368], [52, 100568], [60, 100928], [68, 101488], [73, 101768], [81, 102168]]}, {"verse": 12, "start": 102948, "end": 115124, "text": "Entonces toda la multitud calló, y oyeron a Bernabé y a Pablo, que contaban cuán grandes maravillas y señales Dios había hecho por ellos entre los Gentiles.", "words": [[0, 102948], [9, 103532], [14, 104232], [17, 104492], [26, 105342], [33, 106192], [35, 106252], [42, 106732], [44, 106832], [52, 107472], [54, 107652], [56, 107772], [63, 108252], [67, 108752], [76, 109312], [81, 109652], [89, 110052], [100, 110692], [102, 110912], [110, 111592], [115, 112052], [121, 112592], [127, 113012], [131, 113252], [137, 113492], [143, 113852], [147, 114072]]}, {"verse": 13, "start": 115474, "end": 121659, "text": "Y después que hubieron callado, Jacobo respondió, diciendo: Varones hermanos, oídme:", "words": [[0, 115474], [2, 115594], [10, 115874], [14, 116074], [23, 116394], [32, 117514], [39, 118174], [50, 118894], [60, 120363], [68, 120563], [78, 121123]]}, {"verse": 14, "start": 122009, "end": 127600, "text": "Simón ha contado cómo Dios primero visitó a los Gentiles, para tomar de ellos pueblo para su nombre;", "words": [[0, 122009], [6, 122454], [9, 122554], [17, 123014], [22, 123314], [27, 123554], [35, 123954], [42, 124514], [44, 124594], [48, 124694], [58, 125254], [63, 125539], [69, 125819], [72, 126059], [78, 126259], [85, 126639], [90, 126939], [93, 127119]]}, {"verse": 15, "start": 127950, "end": 131769, "text": "Y con esto concuerdan las palabras de los profetas, como está escrito:", "words": [[0, 127950], [2, 128054], [6, 128234], [11, 128474], [22, 129114], [26, 129254], [35, 129654], [38, 129854], [42, 129974], [52, 130594], [57, 130894], [62, 131114]]}, {"verse": 16, "start": 132119, "end": 140042, "text": "Después de esto volveré y restauraré la habitación de David, que estaba caída; y repararé sus ruinas, y la volveré a levantar;", "words": [[0, 132119], [8, 132458], [11, 132698], [16, 132958], [24, 133598], [26, 133718], [37, 134338], [40, 134478], [51, 135038], [54, 135178], [61, 135458], [65, 135918], [72, 136238], [79, 137118], [81, 137207], [90, 137707], [94, 137887], [102, 138567], [104, 138887], [107, 138987], [115, 139387], [117, 139407]]}, {"verse": 17, "start": 140392, "end": 149108, "text": "Para que el resto de los hombres busque al Señor, y todos los Gentiles, sobre los cuales es llamado mi nombre, dice el Señor, que hace todas estas cosas.", "words": [[0, 140392], [5, 140521], [9, 140721], [12, 140841], [18, 141081], [21, 141241], [25, 141361], [33, 141681], [40, 142101], [43, 142221], [50, 142501], [52, 142881], [58, 143081], [62, 143321], [72, 144201], [78, 144421], [82, 144601], [89, 144861], [92, 145121], [100, 145441], [103, 145641], [111, 146401], [116, 146621], [119, 146801], [126, 147501], [130, 147601], [135, 147821], [141, 148101], [147, 148421]]}, {"verse": 18, "start": 149458, "end": 153072, "text": "Conocidas son a Dios desde el principio del mundo todas sus obras.", "words": [[0, 149458], [10, 149934], [14, 150154], [16, 150274], [21, 150454], [27, 150714], [30, 150914], [40, 151314], [44, 151554], [50, 151834], [56, 152154], [60, 152414]]}, {"verse": 19, "start": 153422, "end": 158688, "text": "Por lo cual yo juzgo, que los que de los Gentiles se convierten a Dios, no han de ser inquietados;", "words": [[0, 153422], [4, 153548], [7, 153668], [12, 153968], [15, 154148], [22, 154628], [26, 154828], [30, 154968], [34, 155128], [37, 155248], [41, 155368], [50, 155868], [53, 156028], [64, 156508], [66, 156668], [72, 156908], [75, 157448], [79, 157608], [82, 157728], [86, 157908]]}, {"verse": 20, "start": 159038, "end": 166620, "text": "Sino escribirles que se aparten de las contaminaciones de los ídolos, y de inmoralidad sexual, y de animales estrangulados, y de sangre.", "words": [[0, 159038], [5, 159221], [17, 159861], [21, 160021], [24, 160161], [32, 160661], [35, 160741], [39, 160861], [55, 161661], [58, 161841], [62, 161961], [70, 162541], [72, 162861], [75, 162961], [87, 163561], [95, 164021], [97, 164316], [100, 164436], [109, 164756], [124, 165716], [126, 165956], [129, 166056]]}, {"verse": 21, "start": 166970, "end": 174249, "text": "Porque Moisés desde los tiempos antiguos tiene en cada ciudad quien le predique en las sinagogas, donde es leído cada sábado.", "words": [[0, 166970], [7, 167169], [14, 167569], [20, 167829], [24, 168109], [32, 168609], [41, 168916], [47, 169222], [50, 169529], [55, 169869], [62, 170269], [68, 170569], [71, 170899], [80, 171229], [83, 171369], [87, 171509], [98, 172649], [104, 172809], [107, 173069], [113, 173449], [118, 173749]]}, {"verse": 22, "start": 174529, "end": 193080, "text": "Entonces pareció bien a los apóstoles y a los ancianos, con toda la iglesia, elegir varones de ellos, y enviarlos a Antioquía con Pablo y Bernabé: a Judas que tenía por sobrenombre Barsabas, y a Silas, varones principales entre los hermanos;", "words": [[0, 174529], [9, 175092], [17, 175932], [22, 176212], [24, 176452], [28, 176592], [38, 177312], [40, 177632], [42, 177712], [46, 177852], [56, 178492], [60, 178932], [65, 179172], [68, 179392], [77, 179832], [84, 180472], [92, 180872], [95, 181092], [102, 181412], [104, 181972], [114, 182692], [116, 183072], [126, 183912], [130, 184172], [136, 184732], [138, 184912], [147, 185831], [149, 185995], [155, 186175], [159, 186505], [165, 186835], [169, 187095], [181, 187985], [191, 188875], [193, 189282], [195, 189688], [202, 190095], [210, 190875], [222, 191835], [228, 192155], [232, 192355]]}, {"verse": 23, "start": 193430, "end": 204150, "text": "Y escribir por mano de ellos: Los apóstoles y los ancianos y los hermanos, a los hermanos de los Gentiles que están en Antioquía, y en Siria, y en Cilicia, saludos:", "words": [[0, 193430], [2, 193841], [11, 194401], [15, 194621], [20, 195021], [23, 195281], [30, 196045], [34, 196150], [44, 196790], [46, 196950], [50, 197050], [59, 197650], [61, 197790], [65, 197930], [75, 198910], [77, 198990], [81, 199110], [90, 199610], [93, 199690], [97, 199810], [106, 200370], [110, 200610], [116, 200870], [119, 201050], [130, 201770], [132, 201930], [135, 202030], [142, 202530], [144, 202690], [147, 203170], [156, 203650]]}, {"verse": 24, "start": 204500, "end": 216588, "text": "Por cuanto hemos oído que algunos que han salido de nosotros, os han inquietado con palabras, trastornando vuestras almas, mandando circuncidaros y guardar la ley, a los cuales no mandamos;", "words": [[0, 204500], [4, 204646], [11, 204946], [17, 205286], [22, 205746], [26, 205966], [34, 206306], [38, 206606], [42, 206726], [49, 207146], [52, 207266], [62, 207786], [65, 208426], [69, 208646], [80, 209226], [84, 209406], [94, 210286], [107, 211006], [116, 211366], [123, 212186], [132, 212726], [146, 213666], [148, 213766], [156, 214186], [159, 214326], [164, 214606], [166, 215126], [170, 215266], [177, 215546], [180, 215806]]}, {"verse": 25, "start": 216938, "end": 224165, "text": "Nos ha parecido, congregados en uno, elegir varones, y enviarlos a vosotros con nuestros amados Bernabé y Pablo,", "words": [[0, 216938], [4, 217047], [7, 217227], [17, 217687], [29, 218347], [32, 218527], [37, 219347], [44, 219707], [53, 220207], [55, 220667], [65, 221147], [67, 221347], [76, 221807], [80, 222047], [89, 222307], [96, 222847], [104, 223507], [106, 223667]]}, {"verse": 26, "start": 224515, "end": 228298, "text": "Hombres que han expuesto sus vidas por el nombre de nuestro Señor Jesucristo.", "words": [[0, 224515], [8, 224757], [12, 224977], [16, 225057], [25, 225477], [29, 225677], [35, 226137], [39, 226337], [42, 226437], [49, 226677], [52, 226857], [60, 227017], [66, 227437]]}, {"verse": 27, "start": 228648, "end": 234508, "text": "Así que, enviamos a Judas y a Silas, los cuales también de viva voz os harán saber lo mismo.", "words": [[0, 228648], [4, 228889], [9, 229069], [18, 229569], [20, 229849], [26, 230109], [28, 230489], [30, 230609], [37, 231449], [41, 231529], [48, 231829], [56, 232229], [59, 232489], [64, 232749], [68, 233169], [71, 233309], [77, 233609], [83, 233849], [86, 234049]]}, {"verse": 28, "start": 234858, "end": 241675, "text": "Que ha parecido bien al Espíritu Santo, y a nosotros, no imponeros ninguna carga más que estas cosas necesarias:", "words": [[0, 234858], [4, 234948], [7, 235268], [16, 235588], [21, 235828], [24, 236028], [33, 236588], [40, 236928], [42, 237468], [44, 237548], [54, 237908], [57, 238268], [67, 238808], [75, 239148], [81, 239568], [85, 239868], [89, 240108], [95, 240328], [101, 240708]]}, {"verse": 29, "start": 242025, "end": 252961, "text": "Que os abstengáis de cosas sacrificadas a ídolos, y de sangre, y de animales estrangulados, y de inmoralidad sexual; de las cuales cosas si os guardáis, bien haréis. Pasadlo bien.", "words": [[0, 242025], [4, 242102], [7, 242182], [18, 242762], [21, 242922], [27, 243162], [40, 244022], [42, 244202], [50, 244702], [52, 245082], [55, 245202], [63, 245562], [65, 245842], [68, 245942], [77, 246222], [92, 247182], [94, 247442], [97, 247522], [109, 248102], [117, 249027], [120, 249299], [124, 249439], [131, 249639], [137, 250059], [140, 250339], [143, 250439], [153, 250939], [158, 251299], [166, 252087], [174, 252550]]}, {"verse": 30, "start": 253241, "end": 260240, "text": "Ellos entonces enviados, descendieron a Antioquía; y juntando la multitud, dieron la carta.", "words": [[0, 253241], [6, 253529], [15, 254049], [25, 254949], [38, 256129], [40, 256349], [51, 257498], [53, 257604], [62, 258204], [65, 258384], [75, 258924], [82, 259364], [85, 259584]]}, {"verse": 31, "start": 260590, "end": 264934, "text": "La cual, como leyeron, fueron gozosos de la consolación.", "words": [[0, 260590], [3, 260736], [9, 261056], [14, 261646], [23, 262236], [30, 262476], [38, 263456], [41, 263736], [44, 263876]]}, {"verse": 32, "start": 265284, "end": 274348, "text": "Judas también y Silas, como ellos también eran profetas, animaron y fortalecieron a los hermanos con abundancia de palabra.", "words": [[0, 265284], [6, 265593], [14, 266408], [16, 266488], [23, 267468], [28, 267648], [34, 267868], [42, 268268], [47, 268588], [57, 269848], [66, 270508], [68, 270848], [82, 271788], [84, 271908], [88, 272048], [97, 272648], [101, 272808], [112, 273508], [115, 273628]]}, {"verse": 33, "start": 274698, "end": 280636, "text": "Y pasando allí algún tiempo, fueron enviados de los hermanos a los apóstoles en paz.", "words": [[0, 274698], [2, 274959], [10, 275359], [15, 275659], [21, 275999], [29, 276519], [36, 277104], [45, 277784], [48, 277944], [52, 278104], [61, 278844], [63, 278984], [67, 279104], [77, 279764], [80, 280064]]}, {"verse": 34, "start": 280986, "end": 283939, "text": "Pero a Silas pareció bien el quedarse allí.", "words": [[0, 280986], [5, 281277], [7, 281603], [13, 281930], [21, 282510], [26, 282750], [29, 282910], [38, 283370]]}, {"verse": 35, "start": 284289, "end": 293309, "text": "Y Pablo y Bernabé se estaban en Antioquía, enseñando la palabra del Señor y anunciando el evangelio con otros muchos.", "words": [[0, 284289], [2, 284435], [8, 284835], [10, 285075], [18, 285615], [21, 285835], [29, 286315], [32, 286635], [43, 287615], [53, 288615], [56, 288775], [64, 289115], [68, 289415], [74, 289795], [76, 290355], [87, 291175], [90, 291315], [100, 292055], [104, 292275], [110, 292515]]}, {"verse": 36, "start": 293659, "end": 303095, "text": "Y después de algunos días, Pablo dijo a Bernabé: Volvamos a visitar a los hermanos por todas las ciudades en las cuales hemos anunciado la palabra del Señor, cómo están.", "words": [[0, 293659], [2, 293763], [10, 294063], [13, 294243], [21, 294483], [27, 294823], [33, 295238], [38, 295578], [40, 295971], [49, 296503], [58, 296942], [60, 297082], [68, 297542], [70, 297582], [74, 297702], [83, 298222], [87, 298382], [93, 298582], [97, 298822], [106, 299484], [109, 299587], [113, 299707], [120, 299947], [126, 300267], [136, 300947], [139, 301067], [147, 301347], [151, 301587], [158, 302367], [163, 302547]]}, {"verse": 37, "start": 303375, "end": 309195, "text": "Y Bernabé quería que tomasen consigo a Juan, el que tenía por sobrenombre Marcos;", "words": [[0, 303375], [2, 303520], [10, 304120], [17, 304420], [21, 304720], [29, 305240], [37, 305620], [39, 305820], [45, 306520], [48, 306740], [52, 306880], [58, 307220], [62, 307500], [74, 308360]]}, {"verse": 38, "start": 309545, "end": 318285, "text": "Pero a Pablo no le parecía bien llevar consigo al que se había apartado de ellos desde Panfilia, y no había ido con ellos a la obra.", "words": [[0, 309545], [5, 309709], [7, 309849], [13, 310209], [16, 310594], [19, 310754], [27, 311274], [32, 311514], [39, 311854], [47, 312394], [50, 312694], [54, 312834], [57, 313014], [63, 313274], [72, 314034], [75, 314234], [81, 314514], [87, 315074], [97, 315634], [99, 316074], [102, 316254], [108, 316614], [112, 316974], [116, 317234], [122, 317434], [124, 317654], [127, 317754]]}, {"verse": 39, "start": 318635, "end": 326408, "text": "Y hubo tal desacuerdo entre ellos, que se apartaron el uno del otro; y Bernabé tomando a Marcos, navegó a Chipre.", "words": [[0, 318635], [2, 318830], [7, 319170], [11, 319370], [22, 320050], [28, 320350], [35, 320810], [39, 321015], [42, 321155], [52, 321815], [55, 322035], [59, 322235], [63, 322455], [69, 323148], [71, 323274], [79, 323794], [87, 324194], [89, 324314], [97, 324854], [104, 325694], [106, 325794]]}, {"verse": 40, "start": 326758, "end": 332431, "text": "Y Pablo escogiendo a Silas, salió encomendado de los hermanos a la gracia del Señor.", "words": [[0, 326758], [2, 326885], [8, 327548], [19, 328046], [21, 328544], [28, 329042], [34, 329415], [46, 330215], [49, 330355], [53, 330475], [62, 331055], [64, 331175], [67, 331275], [74, 331735], [78, 331875]]}, {"verse": 41, "start": 332781, "end": 337006, "text": "Y anduvo la Siria y la Cilicia, fortaleciendo a las iglesias.", "words": [[0, 332781], [2, 332925], [9, 333265], [12, 333635], [18, 334005], [20, 334145], [23, 334245], [32, 334885], [46, 335885], [48, 336045], [52, 336205]]}]}