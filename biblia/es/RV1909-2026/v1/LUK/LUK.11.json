{"book": "LUK", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 479624, "verses": [{"verse": 1, "start": 300, "end": 11331, "text": "Y aconteció que estando él orando en un lugar, cuando acabó, uno de sus discípulos le dijo: Señor, enséñanos a orar, como también Juan enseñó a sus discípulos.", "words": [[0, 300], [2, 419], [12, 1179], [16, 1439], [24, 1939], [27, 2179], [34, 2599], [37, 2759], [40, 2899], [47, 3799], [54, 4019], [61, 5099], [65, 5259], [68, 5439], [72, 5619], [83, 6299], [86, 6499], [92, 7225], [99, 7620], [109, 8100], [111, 8320], [117, 8860], [122, 9000], [130, 9420], [135, 9760], [142, 10320], [144, 10401], [148, 10540]]}, {"verse": 2, "start": 11611, "end": 25268, "text": "Y les dijo: Cuando oréis, decid: Padre nuestro que estás en los cielos; sea tu nombre santificado. Venga tu reino. Sea hecha tu voluntad, como en el cielo, así también en la tierra.", "words": [[0, 11611], [2, 11740], [6, 11900], [12, 12643], [19, 12907], [26, 13861], [33, 14782], [39, 15142], [47, 15342], [51, 15802], [57, 16042], [60, 16282], [64, 16422], [72, 17521], [76, 17757], [79, 17997], [86, 18317], [99, 19739], [105, 20066], [108, 20246], [115, 21176], [119, 21516], [125, 21916], [128, 22096], [138, 22776], [143, 22996], [146, 23156], [149, 23276], [156, 23796], [160, 23976], [168, 24356], [171, 24536], [174, 24656]]}, {"verse": 3, "start": 25618, "end": 28925, "text": "El pan nuestro de cada día, dánoslo hoy.", "words": [[0, 25618], [3, 25775], [7, 26055], [15, 26615], [18, 26855], [23, 27075], [28, 27975], [36, 28495]]}, {"verse": 4, "start": 29275, "end": 39353, "text": "Y perdónanos nuestros pecados, porque también nosotros perdonamos a todos los que nos deben. Y no nos metas en tentación, sino líbranos del malo.", "words": [[0, 29320], [2, 29400], [13, 30120], [22, 30480], [31, 31180], [38, 31700], [46, 32160], [55, 32580], [66, 33500], [68, 33680], [74, 34040], [78, 34360], [82, 34540], [86, 34660], [93, 35534], [95, 35660], [98, 35760], [102, 35940], [108, 36400], [111, 36540], [122, 37160], [127, 37660], [136, 38560], [140, 38820]]}, {"verse": 5, "start": 39703, "end": 48283, "text": "Les dijo también: ¿Quién de vosotros tendrá un amigo, e irá a él a media noche, y le dirá: Amigo, préstame tres panes,", "words": [[0, 39703], [4, 39838], [9, 40118], [18, 40965], [25, 41267], [28, 41367], [37, 41887], [44, 42327], [47, 42487], [54, 43467], [56, 43567], [60, 43907], [62, 44087], [65, 44287], [67, 44554], [73, 44820], [80, 45087], [82, 45327], [85, 45658], [91, 46165], [98, 46708], [107, 47168], [112, 47508]]}, {"verse": 6, "start": 48633, "end": 53055, "text": "Porque un amigo mío ha venido a mí de camino, y no tengo qué ponerle delante;", "words": [[0, 48633], [7, 48835], [10, 49015], [16, 49275], [20, 49695], [23, 49795], [30, 50195], [32, 50315], [35, 50415], [38, 50555], [46, 50975], [48, 51215], [51, 51355], [57, 51675], [61, 51915], [69, 52455]]}, {"verse": 7, "start": 53405, "end": 65346, "text": "Y aquel, respondiendo desde adentro, le dice: No me molestes; la puerta ya está cerrada, y mis niños están conmigo en cama; no puedo levantarme y dártelos?", "words": [[0, 53475], [2, 53515], [9, 54235], [22, 54915], [28, 55135], [37, 56195], [40, 56295], [46, 57131], [49, 57398], [52, 57538], [62, 58763], [65, 58909], [72, 59209], [75, 59569], [80, 59789], [89, 60389], [91, 60509], [95, 60669], [101, 60989], [107, 61389], [115, 61949], [118, 62109], [124, 63232], [127, 63232], [133, 63418], [144, 64318], [146, 64518]]}, {"verse": 8, "start": 65696, "end": 74830, "text": "Os digo, que aunque no se levante a darle por ser su amigo, cierto por su insistencia se levantará, y le dará todo lo que necesite.", "words": [[0, 65696], [3, 65812], [9, 66092], [13, 66492], [20, 66692], [23, 66972], [26, 67132], [34, 67592], [36, 67732], [42, 68012], [46, 68252], [50, 68512], [53, 68752], [60, 69612], [67, 69932], [71, 70292], [74, 70472], [86, 71632], [89, 71772], [100, 72452], [102, 72892], [105, 73032], [110, 73372], [115, 73672], [118, 73952], [122, 74072]]}, {"verse": 9, "start": 75180, "end": 81766, "text": "Y yo os digo: Pedid, y se os dará; buscad, y hallaréis; llamad, y os será abierto.", "words": [[0, 75180], [2, 75328], [5, 75528], [8, 75668], [14, 76524], [21, 76714], [23, 76974], [26, 77114], [29, 77274], [35, 77988], [43, 78553], [45, 79146], [56, 79900], [64, 80461], [66, 80881], [69, 81001], [74, 81241]]}, {"verse": 10, "start": 82116, "end": 88609, "text": "Porque todo aquel que pide, recibe; y el que busca, halla; y al que llama, se abre.", "words": [[0, 82116], [7, 82703], [12, 83063], [18, 83503], [22, 83603], [28, 84203], [36, 85221], [38, 85335], [41, 85455], [45, 85803], [52, 86151], [59, 86719], [61, 86868], [64, 86968], [68, 87148], [75, 87808], [78, 88088]]}, {"verse": 11, "start": 88959, "end": 98312, "text": "¿Y cuál padre de vosotros, si su hijo le pide pan, le dará una piedra? o, si pescado, ¿en lugar de pescado, le dará una serpiente?", "words": [[0, 88959], [3, 89076], [8, 89276], [14, 89626], [17, 89976], [27, 90676], [30, 91216], [33, 91436], [38, 91696], [41, 91876], [46, 92196], [51, 92496], [54, 93096], [59, 93436], [63, 93576], [71, 94526], [74, 94748], [77, 94908], [86, 95508], [90, 95728], [96, 95968], [99, 96208], [108, 96768], [111, 96948], [116, 97228], [120, 97328]]}, {"verse": 12, "start": 98662, "end": 102148, "text": "O, si le pide un huevo, ¿le dará un escorpión?", "words": [[0, 98662], [3, 98788], [6, 98908], [9, 99048], [14, 99368], [17, 99508], [24, 100328], [28, 100588], [33, 101008], [36, 101188]]}, {"verse": 13, "start": 102498, "end": 112729, "text": "Pues si vosotros, siendo malos, sabéis dar buenos regalos a vuestros hijos, ¿cuánto más vuestro Padre celestial dará el Espíritu Santo a los que se lo pidan?", "words": [[0, 102498], [5, 102865], [8, 103057], [18, 103817], [25, 104057], [32, 104937], [39, 105357], [43, 105537], [50, 105877], [58, 106457], [60, 106597], [69, 106957], [76, 107777], [84, 108277], [88, 108497], [96, 108897], [102, 109237], [112, 109757], [117, 110197], [120, 110397], [129, 110937], [135, 111317], [137, 111722], [141, 111842], [145, 111962], [148, 112102], [151, 112242]]}, {"verse": 14, "start": 113079, "end": 121728, "text": "Y estaba él lanzando un demonio, el cual era mudo: y aconteció que salido fuera el demonio, el mudo habló, y la gente se maravilló.", "words": [[0, 113079], [2, 113203], [9, 113503], [12, 113743], [21, 114323], [24, 114463], [33, 115083], [36, 115143], [41, 115323], [45, 115643], [51, 116402], [53, 116492], [63, 117112], [67, 117252], [74, 117712], [80, 117952], [83, 118172], [92, 119112], [95, 119232], [100, 119572], [107, 119912], [109, 120352], [112, 120472], [118, 120752], [121, 120972]]}, {"verse": 15, "start": 122078, "end": 127896, "text": "Pero algunos de ellos decían: En Beelzebú, príncipe de los demonios, echa fuera los demonios.", "words": [[0, 122078], [5, 122280], [13, 122520], [16, 122923], [22, 123327], [30, 123930], [33, 124321], [43, 124751], [52, 125191], [55, 125351], [59, 125491], [69, 126111], [74, 126731], [80, 126931], [84, 127191]]}, {"verse": 16, "start": 128176, "end": 131296, "text": "Y otros, tentando, pedían de él señal del cielo.", "words": [[0, 128176], [2, 128338], [9, 128518], [19, 129198], [26, 129718], [29, 129878], [32, 130038], [38, 130538], [42, 130658]]}, {"verse": 17, "start": 131646, "end": 141475, "text": "Pero él, conociendo los pensamientos de ellos, les dijo: Todo reino dividido contra sí mismo, es asolado; y una casa dividida contra sí misma, cae.", "words": [[0, 131646], [5, 131900], [9, 132190], [20, 132650], [24, 132830], [37, 133510], [40, 133710], [47, 134370], [51, 134510], [57, 135198], [62, 135359], [68, 135919], [77, 136519], [84, 136819], [87, 137079], [94, 137439], [97, 137619], [106, 138768], [108, 138871], [112, 139031], [117, 139351], [126, 140011], [133, 140291], [136, 140511], [143, 140931]]}, {"verse": 18, "start": 141825, "end": 151098, "text": "Y si también Satanás está dividido contra sí mismo, ¿cómo estará en pie su reino? porque decís que en Beelzebú echo yo fuera los demonios.", "words": [[0, 141825], [2, 141930], [5, 142070], [13, 142410], [21, 143210], [26, 143470], [35, 143960], [42, 144450], [45, 144940], [52, 145430], [58, 145670], [65, 146170], [68, 146330], [72, 146490], [75, 146690], [82, 147721], [89, 147861], [95, 148301], [99, 148381], [102, 148734], [111, 149088], [116, 149441], [119, 149701], [125, 150001], [129, 150261]]}, {"verse": 19, "start": 151448, "end": 160821, "text": "Pues si yo echo fuera los demonios en Beelzebú, ¿vuestros hijos en quién los echan fuera? Por tanto, ellos serán vuestros jueces.", "words": [[0, 151448], [5, 151609], [8, 151889], [11, 152199], [16, 152509], [22, 152829], [26, 153069], [35, 153749], [38, 154469], [48, 155189], [58, 155829], [64, 156189], [67, 156709], [73, 156989], [77, 157289], [83, 157589], [90, 158415], [94, 158519], [101, 158879], [107, 159199], [113, 159679], [122, 160099]]}, {"verse": 20, "start": 161171, "end": 168045, "text": "Pero si por el dedo de Dios echo yo fuera los demonios, cierto el reino de Dios ha llegado a vosotros.", "words": [[0, 161171], [5, 161335], [8, 161555], [12, 161835], [15, 161995], [20, 162395], [23, 162495], [28, 162845], [33, 163195], [36, 163335], [42, 163615], [46, 163855], [56, 164915], [63, 165275], [66, 165615], [72, 166075], [75, 166235], [80, 166595], [83, 166835], [91, 167315], [93, 167435]]}, {"verse": 21, "start": 168395, "end": 174010, "text": "Cuando el hombre fuerte y armado guarda su atrio, en paz está lo que posee.", "words": [[0, 168395], [7, 168621], [10, 168841], [17, 169101], [24, 169621], [26, 169861], [33, 170361], [40, 170841], [43, 171021], [50, 172081], [53, 172381], [57, 172661], [62, 173021], [65, 173221], [69, 173361]]}, {"verse": 22, "start": 174360, "end": 182685, "text": "Pero si sobreviniendo otro más fuerte que él, le vence, le quita todas sus armas en que confiaba, y reparte el botín.", "words": [[0, 174360], [5, 174527], [8, 175047], [22, 175567], [27, 175947], [31, 176207], [38, 176587], [42, 176847], [46, 177267], [49, 177527], [56, 178327], [59, 178447], [65, 178767], [71, 179007], [75, 179347], [81, 179727], [84, 180007], [88, 180147], [98, 180867], [100, 181347], [108, 181887], [111, 182309]]}, {"verse": 23, "start": 183035, "end": 188514, "text": "El que no es conmigo, contra mí es; y el que conmigo no recoge, desparrama.", "words": [[0, 183035], [3, 183176], [7, 183316], [10, 183536], [13, 183696], [22, 184236], [29, 184596], [32, 184896], [36, 185555], [38, 185680], [41, 185800], [45, 185940], [53, 186540], [56, 187218], [64, 187895]]}, {"verse": 24, "start": 188864, "end": 200049, "text": "Cuando el espíritu inmundo sale del hombre, anda por lugares secos, buscando reposo; y no hallándolo, dice: Volveré a mi casa, de donde salí.", "words": [[0, 188864], [7, 189050], [10, 189250], [19, 189870], [27, 190350], [32, 190690], [36, 190930], [44, 191290], [49, 191850], [53, 192150], [61, 192550], [68, 193330], [77, 193810], [85, 195054], [87, 195261], [90, 195943], [102, 196626], [108, 197428], [116, 197954], [118, 198054], [121, 198174], [127, 198594], [130, 199194], [136, 199434]]}, {"verse": 25, "start": 200399, "end": 203132, "text": "Y viniendo, la halla barrida y adornada.", "words": [[0, 200399], [2, 200521], [12, 201041], [15, 201261], [21, 201581], [29, 202121], [31, 202301]]}, {"verse": 26, "start": 203482, "end": 213378, "text": "Entonces va, y toma otros siete espíritus peores que él; y entrados, habitan allí: y lo postrero del tal hombre es peor que lo primero.", "words": [[0, 203482], [9, 204031], [13, 204571], [15, 204811], [20, 205091], [26, 205431], [32, 205871], [42, 206571], [49, 207031], [53, 207271], [57, 207890], [59, 208051], [69, 208751], [77, 209531], [83, 210145], [85, 210250], [88, 210370], [97, 210950], [101, 211150], [105, 211350], [112, 211730], [115, 212090], [120, 212510], [124, 212650], [127, 212770]]}, {"verse": 27, "start": 213728, "end": 225347, "text": "Y aconteció que diciendo estas cosas, una mujer de la multitud, levantando la voz, le dijo: Bienaventurado el vientre que te trajo, y los pechos que mamaste.", "words": [[0, 213728], [2, 213891], [12, 214631], [16, 214971], [25, 215291], [31, 215631], [38, 216871], [42, 217051], [48, 217471], [51, 217631], [54, 217731], [64, 218611], [75, 219211], [78, 219351], [83, 219991], [86, 220111], [92, 220943], [107, 221782], [110, 221922], [118, 222422], [122, 222502], [125, 222642], [132, 223242], [134, 223682], [138, 223862], [145, 224282], [149, 224502]]}, {"verse": 28, "start": 225627, "end": 231962, "text": "Y él dijo: Más bien, bienaventurados los que oyen la palabra de Dios, y la guardan.", "words": [[0, 225627], [2, 225787], [5, 226121], [11, 226613], [15, 226760], [21, 227578], [37, 228395], [41, 228895], [45, 229115], [50, 229515], [53, 229675], [61, 230035], [64, 230255], [70, 230575], [72, 231135], [75, 231275]]}, {"verse": 29, "start": 232312, "end": 244725, "text": "Y apiñándose las multitudes en torno a él, comenzó a decir: Esta generación mala es: señal busca, pero señal no le será dada, sino la señal de Jonás.", "words": [[0, 232312], [2, 232437], [13, 233257], [17, 233457], [28, 234157], [31, 234437], [37, 234857], [39, 234977], [43, 235157], [51, 235997], [53, 236097], [60, 236832], [65, 237293], [76, 238113], [81, 238513], [85, 239257], [91, 239721], [98, 240281], [103, 240441], [109, 241041], [112, 241341], [115, 241521], [120, 241781], [126, 242741], [131, 243081], [134, 243301], [140, 243801], [143, 243941]]}, {"verse": 30, "start": 245075, "end": 252019, "text": "Porque como Jonás fue señal a los ninivitas, así también será el Hijo del hombre a esta generación.", "words": [[0, 245075], [7, 245276], [12, 245536], [18, 245916], [22, 246196], [28, 246816], [30, 246976], [34, 247766], [45, 248556], [49, 248736], [57, 249156], [62, 249496], [65, 249796], [70, 250056], [74, 250216], [81, 250536], [83, 250776], [88, 251036]]}, {"verse": 31, "start": 252369, "end": 266938, "text": "La reina del Sur se levantará en juicio con los hombres de esta generación, y los condenará; porque vino de los fines de la tierra a oír la sabiduría de Salomón; y he aquí más que Salomón en este lugar.", "words": [[0, 252369], [3, 252493], [9, 252893], [13, 253073], [17, 253533], [20, 253808], [30, 254448], [33, 254628], [40, 255088], [44, 255388], [48, 255548], [56, 255968], [59, 256248], [64, 256448], [76, 257348], [78, 257683], [82, 257883], [93, 259117], [100, 259302], [105, 259642], [108, 259822], [112, 259982], [118, 260322], [121, 260522], [124, 260662], [131, 261062], [133, 261782], [137, 262242], [140, 262402], [150, 263122], [153, 263262], [162, 264274], [164, 264390], [167, 264540], [172, 264840], [176, 265140], [180, 265340], [188, 266080], [191, 266200], [196, 266420]]}, {"verse": 32, "start": 267288, "end": 279675, "text": "Los hombres de Nínive se levantarán en juicio con esta generación, y la condenarán; porque a la predicación de Jonás se arrepintieron; y he aquí más que Jonás en este lugar.", "words": [[0, 267288], [4, 267413], [12, 267793], [15, 268143], [22, 268493], [25, 268953], [36, 269693], [39, 269813], [46, 270293], [50, 270553], [55, 270753], [67, 271533], [69, 271953], [72, 272093], [84, 273277], [91, 273581], [93, 273861], [96, 273961], [108, 274701], [111, 274881], [117, 275441], [120, 276269], [135, 277253], [137, 277390], [140, 277570], [145, 277850], [149, 278090], [153, 278290], [159, 278790], [162, 278930], [167, 279110]]}, {"verse": 33, "start": 280025, "end": 289881, "text": "Nadie pone en oculto la lámpara encendida, ni debajo de un recipiente para medir grano, sino en el candelero, para que los que entran vean la luz.", "words": [[0, 280025], [6, 280386], [11, 280706], [14, 280966], [21, 281526], [24, 281666], [32, 282146], [43, 283426], [46, 283626], [53, 284046], [56, 284246], [59, 284346], [70, 284966], [75, 285166], [81, 285526], [88, 285926], [93, 286166], [96, 286606], [99, 286746], [110, 287446], [115, 287926], [119, 288066], [123, 288226], [127, 288406], [134, 288806], [139, 289166], [142, 289326]]}, {"verse": 34, "start": 290231, "end": 302049, "text": "La lámpara del cuerpo es el ojo: cuando tu ojo es bueno, también todo tu cuerpo está lleno de luz; pero cuando tu ojo es maligno, también tu cuerpo está en tinieblas.", "words": [[0, 290231], [3, 290336], [11, 290736], [15, 290916], [22, 291336], [25, 291796], [28, 292076], [33, 292715], [40, 292916], [43, 293176], [47, 293416], [50, 293556], [57, 294536], [65, 295016], [70, 295436], [73, 295716], [80, 296036], [85, 296296], [91, 296696], [94, 296796], [99, 297558], [104, 297702], [111, 298002], [114, 298282], [118, 298542], [121, 298662], [130, 299662], [138, 300042], [141, 300322], [148, 300642], [153, 300942], [156, 301122]]}, {"verse": 35, "start": 302399, "end": 306152, "text": "Mira pues, si la luz que en ti hay, es tinieblas.", "words": [[0, 302399], [5, 302597], [11, 302817], [14, 303477], [17, 303657], [21, 303817], [25, 303997], [28, 304157], [31, 304297], [36, 304597], [39, 305237]]}, {"verse": 36, "start": 306502, "end": 317862, "text": "Así que, siendo todo tu cuerpo resplandeciente, no teniendo alguna parte de tinieblas, será todo luminoso, como cuando una lámpara te alumbra con su resplandor.", "words": [[0, 306502], [4, 306744], [9, 307044], [16, 307384], [21, 307804], [24, 308104], [31, 308504], [48, 310264], [51, 310364], [60, 310904], [67, 311164], [73, 311604], [76, 312204], [87, 312804], [92, 313064], [97, 313404], [107, 314524], [112, 314724], [119, 315084], [123, 315384], [131, 315924], [134, 316144], [142, 316624], [146, 316824], [149, 317004]]}, {"verse": 37, "start": 318212, "end": 325064, "text": "Y luego que hubo hablado, le rogó un fariseo que comiese con él: y entrado Jesús, se sentó a la mesa.", "words": [[0, 318212], [2, 318333], [8, 318533], [12, 318813], [17, 319193], [26, 319633], [29, 319913], [34, 320373], [37, 320513], [45, 321193], [49, 321313], [57, 321813], [61, 322113], [65, 322657], [67, 322756], [75, 323176], [82, 323636], [85, 324056], [91, 324436], [93, 324496], [96, 324576]]}, {"verse": 38, "start": 325414, "end": 330623, "text": "Y el fariseo, como lo vio, se maravilló de que no se lavó antes de comer.", "words": [[0, 325414], [2, 325537], [5, 325657], [14, 326337], [19, 326497], [22, 326677], [27, 327537], [30, 327737], [40, 328457], [43, 328657], [47, 328777], [50, 328957], [53, 329117], [58, 329557], [64, 329937], [67, 330117]]}, {"verse": 39, "start": 330973, "end": 341463, "text": "Y el Señor le dijo: Ahora vosotros los fariseos lo de fuera del vaso y del plato limpiáis; pero lo interior de vosotros está lleno de robo y de maldad.", "words": [[0, 330973], [2, 331079], [5, 331199], [11, 331519], [14, 331719], [20, 332458], [26, 332878], [35, 333998], [39, 334098], [48, 334998], [51, 335198], [54, 335338], [60, 335538], [64, 335838], [69, 336258], [71, 336338], [75, 336478], [81, 336818], [91, 338025], [96, 338169], [99, 338329], [108, 338749], [111, 338949], [120, 339409], [125, 339689], [131, 340049], [134, 340149], [139, 340589], [141, 340669], [144, 340809]]}, {"verse": 40, "start": 341813, "end": 345887, "text": "Necios, ¿el que hizo lo de fuera, no hizo también lo de dentro?", "words": [[0, 341813], [8, 342831], [12, 343031], [16, 343211], [21, 343451], [24, 343631], [27, 343771], [34, 344051], [37, 344311], [42, 344491], [50, 344911], [53, 345151], [56, 345291]]}, {"verse": 41, "start": 346237, "end": 351036, "text": "Pero de lo que os resta, dad limosna; y he aquí todo os será limpio.", "words": [[0, 346237], [5, 346381], [8, 346541], [11, 346701], [15, 346821], [18, 346941], [25, 347861], [29, 348081], [38, 349211], [40, 349276], [43, 349376], [48, 349696], [53, 349876], [56, 350056], [61, 350516]]}, {"verse": 42, "start": 351386, "end": 365891, "text": "Pero ¡ay de vosotros, fariseos! que diezmáis la menta, y la ruda, y toda hortaliza; y pasáis por alto la justicia y el amor de Dios. Pues estas cosas era necesario hacer, y no dejar las otras.", "words": [[0, 351398], [5, 351755], [9, 352111], [12, 352311], [22, 352851], [32, 354142], [36, 354416], [45, 354726], [48, 355036], [55, 355346], [57, 355446], [60, 355606], [66, 356166], [68, 356386], [73, 356646], [84, 357824], [86, 357929], [93, 358409], [97, 358729], [102, 359089], [105, 359329], [114, 360069], [116, 360269], [119, 360389], [124, 360589], [127, 360829], [133, 361566], [138, 361710], [144, 361990], [150, 362450], [154, 362910], [164, 363450], [171, 363890], [173, 364450], [176, 364697], [182, 364943], [186, 365190]]}, {"verse": 43, "start": 366241, "end": 373623, "text": "¡Ay de vosotros, fariseos! que amáis los asientos de honor en las sinagogas, y los saludos en las plazas.", "words": [[0, 366406], [4, 366606], [7, 367166], [17, 367586], [27, 368810], [31, 368894], [37, 369254], [41, 369414], [50, 369954], [53, 370174], [59, 370394], [62, 370654], [66, 370794], [77, 371694], [79, 371974], [83, 372114], [91, 372674], [94, 372814], [98, 372934]]}, {"verse": 44, "start": 373973, "end": 384003, "text": "¡Ay de vosotros, escribas y fariseos, hipócritas! que sois como sepulcros que no se ven, y los hombres que andan encima no lo saben.", "words": [[0, 374128], [4, 374318], [7, 374818], [17, 375278], [26, 375978], [28, 376118], [38, 376798], [50, 378270], [54, 378352], [59, 378752], [64, 379012], [74, 379752], [78, 379952], [81, 380112], [84, 380272], [89, 380492], [91, 380972], [95, 381132], [103, 381512], [107, 381772], [113, 382172], [120, 382852], [123, 383192], [126, 383332]]}, {"verse": 45, "start": 384353, "end": 392767, "text": "Y respondiendo uno de los intérpretes de la ley, le dice: Maestro, cuando dices esto, también nos afrentas a nosotros.", "words": [[0, 384455], [2, 384595], [15, 385475], [19, 385835], [22, 385995], [26, 386545], [38, 387095], [41, 387175], [44, 387315], [49, 387895], [52, 388075], [58, 388846], [67, 389572], [74, 389632], [80, 390052], [86, 391072], [94, 391172], [98, 391412], [107, 391972], [109, 392072]]}, {"verse": 46, "start": 393047, "end": 404784, "text": "Y él dijo: ¡Ay de vosotros también, intérpretes de la ley! que cargáis a los hombres con cargas que no pueden llevar; pero vosotros ni aun con un dedo tocáis las cargas.", "words": [[0, 393047], [2, 393207], [5, 393541], [11, 394213], [15, 394393], [18, 394553], [27, 395053], [36, 395433], [48, 396608], [51, 396768], [54, 396888], [59, 397594], [63, 397678], [71, 398158], [73, 398278], [77, 398398], [85, 398738], [89, 398998], [96, 399518], [100, 399658], [103, 399818], [110, 400138], [118, 400968], [123, 401208], [132, 401808], [135, 402408], [139, 402608], [143, 402848], [146, 403008], [151, 403408], [158, 403828], [162, 403988]]}, {"verse": 47, "start": 405134, "end": 411901, "text": "¡Ay de vosotros! que edificáis los sepulcros de los profetas, y los mataron vuestros padres.", "words": [[0, 405305], [4, 405511], [7, 405718], [17, 406858], [21, 406942], [31, 407882], [35, 408182], [45, 408882], [48, 409062], [52, 409162], [62, 409762], [64, 410262], [68, 410402], [76, 410882], [85, 411242]]}, {"verse": 48, "start": 412251, "end": 423010, "text": "De cierto dais testimonio que consentís en los hechos de vuestros padres; porque a la verdad ellos los mataron, pero vosotros edificáis sus sepulcros.", "words": [[0, 412627], [3, 413037], [10, 413447], [15, 413857], [26, 414537], [30, 414877], [40, 415217], [43, 415557], [47, 415737], [54, 416077], [57, 416237], [66, 416577], [74, 417487], [81, 417733], [83, 417853], [86, 417933], [93, 418213], [99, 418633], [103, 418853], [112, 419473], [117, 419673], [126, 420393], [136, 421473], [140, 422272]]}, {"verse": 49, "start": 423360, "end": 433630, "text": "Por tanto, la sabiduría de Dios también dijo: Enviaré a ellos profetas y apóstoles; y de ellos a unos matarán y a otros perseguirán;", "words": [[0, 423360], [4, 423464], [11, 424184], [14, 424744], [24, 425304], [27, 425424], [32, 425664], [40, 425964], [46, 426837], [54, 427402], [56, 427482], [62, 427682], [71, 428282], [73, 428462], [84, 429525], [86, 429663], [89, 429803], [95, 430090], [97, 430376], [102, 430663], [110, 431363], [112, 431743], [114, 431863], [120, 432203]]}, {"verse": 50, "start": 433980, "end": 441762, "text": "Para que de esta generación sea demandada la sangre de todos los profetas, que ha sido derramada desde la fundación del mundo;", "words": [[0, 433980], [5, 434221], [9, 434401], [12, 434561], [17, 434801], [28, 435641], [32, 435901], [42, 436601], [45, 436741], [52, 437161], [55, 437361], [61, 437621], [65, 437901], [75, 438501], [79, 438881], [82, 439001], [87, 439241], [97, 439961], [103, 440181], [106, 440441], [116, 440981], [120, 441181]]}, {"verse": 51, "start": 442112, "end": 452454, "text": "Desde la sangre de Abel, hasta la sangre de Zacarías, que murió entre el altar y el templo: así os digo, será demandada de esta generación.", "words": [[0, 442112], [6, 442349], [9, 442609], [16, 442969], [19, 443169], [25, 443569], [31, 444369], [34, 444549], [41, 444989], [44, 445209], [54, 445869], [58, 446329], [64, 446769], [70, 447129], [73, 447369], [79, 447729], [81, 448069], [84, 448209], [92, 449080], [96, 449264], [99, 449424], [105, 450164], [110, 450444], [120, 451124], [123, 451304], [128, 451504]]}, {"verse": 52, "start": 452804, "end": 463548, "text": "¡Ay de vosotros, intérpretes de la ley! que habéis quitado la llave del conocimiento; vosotros mismos no entrasteis, y a los que entraban impedisteis.", "words": [[0, 453001], [4, 453231], [7, 453431], [17, 453871], [29, 454851], [32, 454951], [35, 455071], [40, 455994], [44, 456098], [51, 456398], [59, 456878], [62, 457018], [68, 457338], [72, 457478], [86, 458794], [95, 459193], [102, 459493], [105, 459753], [117, 460713], [119, 461153], [121, 461213], [125, 461313], [129, 461453], [138, 462053]]}, {"verse": 53, "start": 463898, "end": 474045, "text": "Y diciéndoles estas cosas, los escribas y los fariseos comenzaron a presionarle en gran manera, y a provocarle a que hablase de muchas cosas;", "words": [[0, 463898], [2, 464043], [14, 464703], [20, 465043], [27, 466263], [31, 466363], [40, 467003], [42, 467183], [46, 467283], [55, 468003], [66, 468923], [68, 469023], [80, 469843], [83, 470003], [88, 470203], [96, 470723], [98, 471343], [100, 471423], [111, 472223], [113, 472363], [117, 472483], [125, 472883], [128, 473003], [135, 473223]]}, {"verse": 54, "start": 474395, "end": 479224, "text": "Acechándole, y procurando cazar algo de su boca para acusarle.", "words": [[0, 474395], [13, 475336], [15, 475716], [26, 476306], [32, 476896], [37, 477256], [40, 477476], [43, 477656], [48, 478016], [53, 478296]]}]}