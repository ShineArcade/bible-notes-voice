{"book": "ACT", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 245502, "verses": [{"verse": 1, "start": 300, "end": 4386, "text": "Varones hermanos y padres, oíd la defensa que ahora os presento.", "words": [[0, 493], [8, 723], [17, 1303], [19, 1383], [27, 2043], [31, 2463], [34, 2603], [42, 3103], [46, 3263], [52, 3483], [55, 3663]]}, {"verse": 2, "start": 4666, "end": 10740, "text": "(Y cuando oyeron que les hablaba en lengua hebrea, guardaron más silencio.) Y dijo:", "words": [[0, 4666], [3, 4769], [10, 5029], [17, 5569], [21, 5689], [25, 5849], [33, 6449], [36, 6589], [43, 7029], [51, 7929], [61, 8649], [65, 8889], [76, 10149], [78, 10229]]}, {"verse": 3, "start": 10940, "end": 24831, "text": "Yo de cierto soy judío, nacido en Tarso de Cilicia, pero criado en esta ciudad a los pies de Gamaliel, enseñado conforme a la verdad de la ley de la patria, celoso de Dios, como todos vosotros sois hoy.", "words": [[0, 10940], [3, 11203], [6, 11263], [13, 11883], [17, 12043], [24, 12943], [31, 13463], [34, 13643], [40, 13983], [43, 14513], [52, 15043], [57, 15263], [64, 15683], [67, 15823], [72, 16043], [79, 16383], [81, 16623], [85, 16743], [90, 16963], [93, 17123], [103, 17982], [112, 18646], [121, 19246], [123, 19326], [126, 19386], [133, 19766], [136, 20026], [139, 20146], [143, 20346], [146, 20466], [149, 20606], [157, 21606], [164, 21986], [167, 22206], [173, 23006], [178, 23166], [184, 23486], [193, 24086], [198, 24486]]}, {"verse": 4, "start": 25181, "end": 30623, "text": "Que he perseguido este camino hasta la muerte, prendiendo y entregando en cárceles hombres y mujeres:", "words": [[0, 25181], [4, 25281], [7, 25361], [18, 26001], [23, 26201], [30, 26621], [36, 26861], [39, 27021], [47, 27681], [58, 28261], [60, 28381], [71, 28881], [74, 28981], [83, 29521], [91, 29801], [93, 30021]]}, {"verse": 5, "start": 30973, "end": 44222, "text": "Como también el sumo sacerdote me es testigo, y todos los ancianos; de los cuales también tomando cartas a los hermanos, iba a Damasco para traer presos a Jerusalén aun a los que estuviesen allí, para que fuesen castigados.", "words": [[0, 30973], [5, 31137], [13, 31537], [16, 31717], [21, 32037], [31, 32290], [34, 32544], [37, 32797], [46, 33417], [48, 33657], [54, 33837], [58, 34057], [68, 34979], [71, 35097], [75, 35217], [82, 35477], [90, 35877], [98, 36457], [105, 36937], [107, 37037], [111, 37117], [121, 38017], [125, 38317], [127, 38537], [135, 38917], [140, 39137], [146, 39497], [153, 39957], [155, 40057], [165, 40837], [169, 41057], [171, 41217], [175, 41357], [179, 41517], [190, 42017], [196, 42717], [201, 42857], [205, 42997], [212, 43337]]}, {"verse": 6, "start": 44572, "end": 51851, "text": "Pero aconteció que yendo yo, y llegando cerca de Damasco, como a medio día, de repente me rodeó mucha luz del cielo:", "words": [[0, 44572], [5, 44731], [15, 45371], [19, 45531], [25, 45871], [29, 46691], [31, 46731], [40, 47131], [46, 47431], [49, 47671], [58, 48251], [63, 48491], [65, 48631], [71, 48831], [76, 49551], [79, 49631], [87, 50011], [90, 50291], [96, 50691], [102, 50931], [106, 51151], [110, 51351]]}, {"verse": 7, "start": 52201, "end": 58194, "text": "Y caí en el suelo, y oí una voz que me decía: Saulo, Saulo, ¿por qué me persigues?", "words": [[0, 52201], [2, 52303], [6, 52603], [9, 52723], [12, 52823], [19, 53203], [21, 53543], [24, 53743], [28, 53903], [32, 54143], [36, 54303], [39, 54423], [46, 55474], [53, 55814], [60, 56774], [65, 56874], [69, 57034], [72, 57174]]}, {"verse": 8, "start": 58414, "end": 66192, "text": "Yo entonces respondí: ¿Quién eres, Señor? Y me dijo: Yo soy Jesús de Nazaret, a quien tú persigues.", "words": [[0, 58414], [3, 58631], [12, 58971], [22, 60011], [29, 60270], [35, 60590], [42, 61260], [44, 61365], [47, 61465], [53, 62193], [56, 62398], [60, 62698], [66, 63138], [69, 63438], [78, 64438], [80, 64698], [86, 64878], [89, 65178]]}, {"verse": 9, "start": 66412, "end": 73126, "text": "Y los que estaban conmigo vieron a la verdad la luz, y se espantaron; pero no oyeron la voz del que hablaba conmigo.", "words": [[0, 66412], [2, 66516], [6, 66636], [10, 66796], [18, 67096], [26, 67696], [33, 68016], [35, 68176], [38, 68256], [45, 68536], [48, 68776], [53, 69096], [55, 69536], [58, 69636], [70, 70621], [75, 70760], [78, 70980], [85, 71400], [88, 71520], [92, 71740], [96, 71940], [100, 72120], [108, 72500]]}, {"verse": 10, "start": 73476, "end": 82979, "text": "Y dije: ¿Qué haré, Señor? Y el Señor me dijo: Levántate, y ve a Damasco, y allí te será dicho todo lo que te está señalado hacer.", "words": [[0, 73476], [2, 73619], [8, 74291], [13, 74411], [19, 74671], [26, 75390], [28, 75490], [31, 75590], [37, 75830], [40, 76050], [46, 76783], [57, 77502], [59, 77762], [62, 77922], [64, 78042], [73, 78722], [75, 79112], [80, 79502], [83, 79742], [88, 80062], [94, 80362], [99, 80862], [102, 81162], [106, 81302], [109, 81462], [114, 81742], [123, 82602]]}, {"verse": 11, "start": 83199, "end": 89609, "text": "Y como yo no viese por causa de la claridad de la luz, llevado de la mano por los que estaban conmigo, vine a Damasco.", "words": [[0, 83199], [2, 83287], [7, 83467], [10, 83647], [13, 83787], [19, 84087], [23, 84287], [29, 84547], [32, 84767], [35, 84867], [44, 85287], [47, 85407], [50, 85527], [55, 86127], [63, 86567], [66, 86687], [69, 86787], [74, 87027], [78, 87227], [82, 87367], [86, 87487], [94, 87727], [103, 88687], [108, 88867], [110, 89027]]}, {"verse": 12, "start": 89959, "end": 96061, "text": "Entonces un Ananías, hombre piadoso conforme a la ley, que tenía buen testimonio de todos los judíos que allí moraban,", "words": [[0, 89959], [9, 90281], [12, 90741], [21, 91201], [28, 91541], [36, 92101], [45, 92581], [47, 92641], [50, 92701], [55, 92941], [59, 93201], [65, 93461], [70, 93661], [81, 94321], [84, 94421], [90, 94601], [94, 94841], [101, 95241], [105, 95361], [110, 95521]]}, {"verse": 13, "start": 96411, "end": 102194, "text": "Viniendo a mí, y acercándose, me dijo: Hermano Saulo, recibe la vista. Y yo en aquella hora le miré.", "words": [[0, 96581], [9, 96751], [11, 96851], [15, 97151], [17, 97291], [30, 97891], [33, 98031], [39, 98657], [47, 98977], [54, 99497], [61, 99917], [64, 100017], [71, 100684], [73, 100806], [76, 100966], [79, 101086], [87, 101386], [92, 101606], [95, 101766]]}, {"verse": 14, "start": 102544, "end": 110990, "text": "Y él dijo: El Dios de nuestros padres te ha predestinado para que conocieses su voluntad, y vieses a aquel Justo, y oyeses la voz de su boca.", "words": [[0, 102544], [2, 102668], [5, 102788], [11, 103458], [14, 103578], [19, 103778], [22, 103938], [31, 104098], [38, 104618], [41, 104898], [44, 105018], [57, 105678], [62, 105898], [66, 106038], [77, 106678], [80, 106798], [90, 107618], [92, 107838], [99, 108198], [101, 108338], [107, 108578], [114, 109338], [116, 109438], [123, 109878], [126, 110018], [130, 110238], [133, 110378], [136, 110518]]}, {"verse": 15, "start": 111340, "end": 115418, "text": "Porque has de ser testigo suyo a todos los hombres, de lo que has visto y oído.", "words": [[0, 111340], [7, 111527], [11, 111727], [14, 111847], [18, 112007], [26, 112527], [31, 112927], [33, 113027], [39, 113207], [43, 113407], [52, 113787], [55, 114062], [58, 114182], [62, 114322], [66, 114462], [72, 114722], [74, 114962]]}, {"verse": 16, "start": 115768, "end": 122257, "text": "Ahora pues, ¿por qué te detienes? Levántate, y bautízate, y lava tus pecados, invocando su nombre.", "words": [[0, 115768], [6, 116010], [12, 116810], [17, 116910], [21, 117050], [24, 117170], [34, 118083], [45, 118668], [47, 118828], [58, 119428], [60, 119688], [65, 119828], [69, 120068], [78, 120788], [88, 121268], [91, 121448]]}, {"verse": 17, "start": 122607, "end": 127676, "text": "Y me aconteció, vuelto a Jerusalén, que orando en el templo, entré en éxtasis.", "words": [[0, 122607], [2, 122709], [5, 122789], [16, 123429], [23, 123789], [25, 123869], [36, 124849], [40, 125109], [47, 125369], [50, 125529], [53, 125649], [61, 126449], [67, 126809], [70, 126909]]}, {"verse": 18, "start": 128026, "end": 135996, "text": "Y le vi que me decía: Date prisa, y sal rápidamente fuera de Jerusalén; porque no recibirán tu testimonio de mí.", "words": [[0, 128026], [2, 128110], [5, 128230], [8, 128350], [12, 128470], [15, 128610], [22, 129474], [27, 129721], [34, 130281], [36, 130361], [40, 130621], [52, 131441], [58, 131761], [61, 132358], [72, 133128], [79, 133527], [82, 133767], [92, 134547], [95, 134747], [106, 135527], [109, 135627]]}, {"verse": 19, "start": 136216, "end": 142440, "text": "Y yo dije: Señor, ellos saben que yo encerraba en cárcel, y hería por las sinagogas a los que creían en ti;", "words": [[0, 136216], [2, 136326], [5, 136446], [11, 137130], [18, 137916], [24, 138096], [30, 138376], [34, 138556], [37, 138716], [47, 139196], [50, 139296], [58, 139776], [60, 140116], [66, 140376], [70, 140516], [74, 140676], [84, 141256], [86, 141376], [90, 141476], [94, 141576], [101, 141956], [104, 142116]]}, {"verse": 20, "start": 142790, "end": 152059, "text": "Y cuando se derramaba la sangre de Esteban tu testigo, yo también estaba presente, y consentía a su muerte, y guardaba las ropas de los que le mataban.", "words": [[0, 142790], [2, 142896], [9, 143116], [12, 143376], [22, 143896], [25, 144036], [32, 144416], [35, 144616], [43, 145116], [46, 145296], [55, 146356], [58, 146496], [66, 146776], [73, 147116], [83, 148136], [85, 148176], [95, 148816], [97, 148936], [100, 149036], [108, 149876], [110, 149916], [119, 150336], [123, 150516], [129, 150876], [132, 151036], [136, 151156], [140, 151336], [143, 151436]]}, {"verse": 21, "start": 152409, "end": 156334, "text": "Y me dijo: Ve, porque yo te tengo que enviar lejos a los Gentiles.", "words": [[0, 152409], [2, 152516], [5, 152596], [11, 153331], [15, 153480], [22, 153720], [25, 153920], [28, 154060], [34, 154340], [38, 154520], [45, 154920], [51, 155300], [53, 155460], [57, 155580]]}, {"verse": 22, "start": 156684, "end": 165231, "text": "Y le oyeron hasta esta palabra: entonces alzaron la voz, diciendo: Quita de la tierra a un tal hombre, porque no conviene que viva.", "words": [[0, 156684], [2, 156808], [5, 156928], [12, 157488], [18, 157788], [23, 158008], [32, 158738], [41, 159245], [49, 160125], [52, 160325], [57, 160685], [67, 161819], [73, 162075], [76, 162215], [79, 162315], [86, 162635], [88, 162895], [91, 163035], [95, 163175], [103, 163735], [110, 164055], [113, 164235], [122, 164655], [126, 164815]]}, {"verse": 23, "start": 165511, "end": 170601, "text": "Y dando ellos voces, y arrojando sus ropas y echando polvo al aire,", "words": [[0, 165511], [2, 165655], [8, 165875], [14, 166135], [21, 166795], [23, 167135], [33, 167715], [37, 167915], [43, 168515], [45, 168955], [53, 169375], [59, 169935], [62, 170095]]}, {"verse": 24, "start": 170951, "end": 180638, "text": "Mandó el comandante que le llevasen a la fortaleza, y ordenó que fuese interrogado con azotes, para saber por qué causa clamaban así contra él.", "words": [[0, 170951], [6, 171238], [9, 171318], [20, 171918], [24, 172118], [27, 172318], [36, 172518], [38, 172718], [41, 172858], [52, 173658], [54, 174518], [61, 174998], [65, 175138], [71, 175478], [83, 176218], [87, 176438], [95, 176938], [100, 177698], [106, 178038], [110, 178338], [114, 178538], [120, 179098], [129, 179658], [133, 179898], [140, 180258]]}, {"verse": 25, "start": 180988, "end": 190037, "text": "Y como le ataron con correas, Pablo dijo al centurión que estaba presente: ¿Os es lícito azotar a un hombre Romano sin ser condenado?", "words": [[0, 180988], [2, 181114], [7, 181354], [10, 181574], [17, 182034], [21, 182274], [30, 183574], [36, 184054], [41, 184394], [44, 184634], [54, 185254], [58, 185394], [65, 185634], [75, 186622], [79, 186788], [82, 186948], [89, 187328], [96, 187828], [98, 187888], [101, 188048], [108, 188308], [115, 188788], [119, 189008], [123, 189268]]}, {"verse": 26, "start": 190317, "end": 199300, "text": "Y como el centurión oyó esto, fue y dio aviso al comandante, diciendo: ¿Qué vas a hacer? porque este hombre es Romano.", "words": [[0, 190317], [2, 190443], [7, 190703], [10, 190863], [20, 191583], [24, 192003], [30, 192863], [34, 193303], [36, 193623], [40, 193983], [46, 194343], [49, 194543], [61, 195823], [71, 196903], [76, 197007], [80, 197167], [82, 197307], [89, 198100], [96, 198240], [101, 198400], [108, 198600], [111, 198760]]}, {"verse": 27, "start": 199580, "end": 207327, "text": "Y viniendo el comandante, le dijo: Dime, ¿eres tú Romano? Y él dijo: Sí.", "words": [[0, 199580], [2, 199687], [11, 200187], [14, 200287], [26, 201247], [29, 201507], [35, 202245], [41, 202850], [47, 203030], [50, 203250], [58, 205885], [60, 206073], [63, 206233], [69, 207166]]}, {"verse": 28, "start": 207607, "end": 216042, "text": "Y respondió el comandante: Yo con grande suma alcancé esta ciudadanía. Entonces Pablo dijo: Pero yo lo soy de nacimiento.", "words": [[0, 207607], [2, 207731], [12, 208371], [15, 208451], [27, 209619], [30, 209761], [34, 209921], [41, 210201], [46, 210681], [54, 211161], [59, 211381], [71, 212473], [80, 212917], [86, 213537], [92, 214377], [97, 214518], [100, 214738], [103, 214858], [107, 215098], [110, 215218]]}, {"verse": 29, "start": 216322, "end": 227639, "text": "Así que, luego se apartaron de él los que le habían de atormentar: y aun el comandante también tuvo temor, entendido que era Romano, por haberle atado.", "words": [[0, 216322], [4, 216602], [9, 216782], [15, 217062], [18, 217322], [28, 217962], [31, 218202], [34, 218422], [38, 218862], [42, 219022], [45, 219202], [52, 219462], [55, 219682], [67, 220808], [69, 220971], [73, 221171], [76, 221351], [87, 222171], [95, 222591], [100, 223011], [107, 223811], [117, 224711], [121, 224931], [125, 225111], [133, 226311], [137, 226471], [145, 226971]]}, {"verse": 30, "start": 227989, "end": 245102, "text": "Y al día siguiente, queriendo saber de cierto la causa por qué era acusado de los judíos, le soltó de las ataduras, y mandó venir a los principales sacerdotes, y a todo su Consejo: y sacando a Pablo, le presentó delante de ellos.", "words": [[0, 227989], [2, 228112], [5, 228232], [9, 228372], [20, 229432], [30, 229832], [36, 230152], [39, 230392], [46, 230772], [49, 231332], [55, 231712], [59, 232112], [63, 232312], [67, 232692], [75, 233432], [78, 233592], [82, 233732], [90, 234672], [93, 234752], [99, 235292], [102, 235432], [106, 235612], [116, 236292], [118, 236832], [124, 237212], [130, 237532], [132, 237692], [136, 237812], [148, 238512], [160, 239714], [162, 239839], [164, 239939], [169, 240159], [172, 240419], [181, 241518], [183, 241644], [191, 242124], [193, 242244], [200, 242684], [203, 243324], [212, 243924], [220, 244344], [223, 244524]]}]}