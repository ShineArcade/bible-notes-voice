{"book": "ROM", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 296908, "verses": [{"verse": 1, "start": 300, "end": 8977, "text": "Ahora pues, ninguna condenación hay para los que están en Cristo Jesús, los que no andan conforme a la carne, sino conforme al espíritu.", "words": [[0, 300], [6, 538], [12, 1258], [20, 1618], [32, 2518], [36, 2858], [41, 3098], [45, 3298], [49, 3438], [55, 3698], [58, 3838], [65, 4138], [72, 5138], [76, 5318], [80, 5478], [83, 5658], [89, 5938], [98, 6478], [100, 6538], [103, 6618], [110, 7358], [115, 7538], [124, 8218], [127, 8318]]}, {"verse": 2, "start": 9327, "end": 14394, "text": "Porque la ley del Espíritu de vida en Cristo Jesús me ha librado de la ley del pecado y de la muerte.", "words": [[0, 9327], [7, 9506], [10, 9646], [14, 9826], [18, 9966], [27, 10506], [30, 10606], [35, 10806], [38, 10946], [45, 11246], [51, 11846], [54, 12011], [57, 12091], [65, 12491], [68, 12631], [71, 12731], [75, 12911], [79, 13051], [86, 13531], [88, 13651], [91, 13751], [94, 13851]]}, {"verse": 3, "start": 14744, "end": 25908, "text": "Porque lo que era imposible a la ley, por cuanto era débil por la carne, Dios enviando a su Hijo en semejanza de carne de pecado, y a causa del pecado, condenó al pecado en la carne;", "words": [[0, 14744], [7, 14970], [10, 15170], [14, 15310], [18, 15490], [28, 16110], [30, 16230], [33, 16310], [38, 16950], [42, 17190], [49, 17490], [53, 17750], [59, 18110], [63, 18310], [66, 18470], [73, 19250], [78, 19630], [87, 20150], [89, 20270], [92, 20470], [97, 20690], [100, 20810], [110, 21470], [113, 21590], [119, 21870], [122, 22030], [130, 22860], [132, 22982], [134, 23062], [140, 23282], [144, 23502], [152, 24262], [160, 24742], [163, 24842], [170, 25242], [173, 25342], [176, 25442]]}, {"verse": 4, "start": 26258, "end": 32557, "text": "Para que la justicia de la ley fuese cumplida en nosotros, que no andamos conforme a la carne, sino conforme al espíritu.", "words": [[0, 26258], [5, 26380], [9, 26500], [12, 26580], [21, 27080], [24, 27220], [27, 27340], [31, 27540], [37, 27840], [46, 28340], [49, 28440], [59, 28860], [63, 29380], [66, 29540], [74, 29900], [83, 30400], [85, 30460], [88, 30520], [95, 30880], [100, 31320], [109, 31880], [112, 31960]]}, {"verse": 5, "start": 32907, "end": 41578, "text": "Porque los que viven conforme a la carne, de las cosas que son de la carne se ocupan; pero los que conforme al espíritu, de las cosas del espíritu.", "words": [[0, 32907], [7, 33091], [11, 33291], [15, 33451], [21, 33751], [30, 33991], [32, 34231], [35, 34351], [42, 35091], [45, 35271], [49, 35411], [55, 35691], [59, 35911], [63, 36131], [66, 36251], [69, 36351], [75, 36651], [78, 36831], [86, 37633], [91, 37755], [95, 37935], [99, 38075], [108, 38595], [111, 38655], [121, 39315], [124, 39595], [128, 39735], [134, 39995], [138, 40235]]}, {"verse": 6, "start": 41928, "end": 47295, "text": "Porque la mente puesta en la carne es muerte; pero la mente puesta en el espíritu, vida y paz:", "words": [[0, 41928], [7, 42107], [10, 42267], [16, 42467], [23, 42947], [26, 43047], [29, 43167], [35, 43507], [38, 43667], [46, 44483], [51, 44625], [54, 44805], [60, 45045], [67, 45545], [70, 45645], [73, 45745], [83, 46465], [88, 46765], [90, 46945]]}, {"verse": 7, "start": 47645, "end": 54304, "text": "Por cuanto la intención de la carne es enemistad contra Dios; porque no se sujeta a la ley de Dios, ni tampoco puede.", "words": [[0, 47645], [4, 47771], [11, 47951], [14, 48211], [24, 48711], [27, 48831], [30, 48971], [36, 49311], [39, 49571], [49, 50231], [56, 50531], [62, 51410], [69, 51510], [72, 51650], [75, 51770], [82, 52020], [84, 52270], [87, 52350], [91, 52570], [94, 52710], [100, 53250], [103, 53390], [111, 53710]]}, {"verse": 8, "start": 54654, "end": 57679, "text": "Así que, los que están en la carne no pueden agradar a Dios.", "words": [[0, 54654], [4, 54876], [9, 55056], [13, 55196], [17, 55356], [23, 55616], [26, 55756], [29, 55856], [35, 56176], [38, 56376], [45, 56636], [53, 57096], [55, 57176]]}, {"verse": 9, "start": 58029, "end": 67772, "text": "Pero vosotros no estáis en la carne, sino en el espíritu, si es que el Espíritu de Dios mora en vosotros. Y si alguno no tiene el Espíritu de Cristo, el tal no es de él.", "words": [[0, 58029], [5, 58188], [14, 58608], [17, 58848], [24, 59248], [27, 59348], [30, 59468], [37, 59788], [42, 60128], [45, 60288], [48, 60408], [58, 61408], [61, 61548], [64, 61708], [68, 61828], [71, 61928], [80, 62468], [83, 62548], [88, 62788], [93, 63228], [96, 63288], [106, 64048], [108, 64158], [111, 64258], [118, 64658], [121, 64758], [127, 64998], [130, 65178], [139, 65698], [142, 65778], [150, 66718], [153, 66818], [157, 67018], [160, 67218], [163, 67358], [166, 67538]]}, {"verse": 10, "start": 68122, "end": 75900, "text": "Pero si Cristo está en vosotros, el cuerpo a la verdad está muerto a causa del pecado; pero el espíritu vive a causa de la justicia.", "words": [[0, 68122], [5, 68247], [8, 68407], [15, 68767], [20, 69047], [23, 69207], [33, 70087], [36, 70207], [43, 70547], [45, 70687], [48, 70747], [55, 71047], [60, 71407], [67, 71807], [69, 71947], [75, 72167], [79, 72407], [87, 73183], [92, 73343], [95, 73503], [104, 74103], [109, 74303], [111, 74523], [117, 74763], [120, 75023], [123, 75123]]}, {"verse": 11, "start": 76250, "end": 87753, "text": "Y si el Espíritu de aquel que levantó de los muertos a Jesús mora en vosotros, el que levantó a Cristo Jesús de los muertos, vivificará también vuestros cuerpos mortales por su Espíritu que mora en vosotros.", "words": [[0, 76250], [2, 76358], [5, 76478], [8, 76578], [17, 77098], [20, 77198], [26, 77478], [30, 77558], [38, 78078], [41, 78158], [45, 78258], [53, 78718], [55, 78878], [61, 79138], [66, 79718], [69, 79798], [79, 80698], [82, 80798], [86, 80918], [94, 81418], [96, 81538], [103, 81738], [109, 82218], [112, 82378], [116, 82498], [125, 83401], [136, 84064], [144, 84344], [153, 84784], [161, 85184], [170, 85684], [174, 85884], [177, 86044], [186, 86564], [190, 86684], [195, 86984], [198, 87064]]}, {"verse": 12, "start": 88103, "end": 93310, "text": "Así que, hermanos, deudores somos, no a la carne, para que vivamos conforme a la carne:", "words": [[0, 88103], [4, 88267], [9, 88447], [19, 89167], [28, 89627], [35, 90427], [38, 90547], [40, 90667], [43, 90747], [50, 91407], [55, 91587], [59, 91747], [67, 92167], [76, 92707], [78, 92727], [81, 92827]]}, {"verse": 13, "start": 93660, "end": 100625, "text": "Porque si vivís conforme a la carne, moriréis; pero si por el espíritu hacéis morir las obras de la carne, viviréis.", "words": [[0, 93660], [7, 93840], [10, 94040], [16, 94400], [25, 94940], [27, 95000], [30, 95080], [37, 95340], [47, 96411], [52, 96555], [55, 96715], [59, 96915], [62, 97035], [71, 97595], [78, 98015], [84, 98355], [88, 98495], [94, 98755], [97, 98935], [100, 99055], [107, 99375]]}, {"verse": 14, "start": 100975, "end": 105877, "text": "Porque todos los que son guiados por el Espíritu de Dios, los tales son hijos de Dios.", "words": [[0, 100975], [7, 101155], [13, 101455], [17, 101715], [21, 101855], [25, 102035], [33, 102495], [37, 102735], [40, 102835], [49, 103335], [52, 103435], [58, 104255], [62, 104335], [68, 104615], [72, 104935], [78, 105155], [81, 105375]]}, {"verse": 15, "start": 106227, "end": 115395, "text": "Porque no habéis recibido el espíritu de esclavitud para estar otra vez en temor; sino que habéis recibido el espíritu de adopción, por el cual clamamos, Abba, Padre.", "words": [[0, 106227], [7, 106386], [10, 106606], [17, 106886], [26, 107426], [29, 107526], [38, 108026], [41, 108106], [52, 108646], [57, 109086], [63, 109306], [68, 109526], [72, 109806], [75, 109966], [82, 110717], [87, 110912], [91, 111112], [98, 111412], [107, 112012], [110, 112112], [119, 112672], [122, 112752], [132, 113232], [136, 113512], [139, 113632], [144, 113772], [154, 114452], [160, 114892]]}, {"verse": 16, "start": 115745, "end": 119681, "text": "Porque el mismo Espíritu da testimonio a nuestro espíritu que somos hijos de Dios.", "words": [[0, 115745], [7, 115946], [10, 116106], [16, 116306], [25, 116886], [28, 116986], [39, 117606], [41, 117646], [49, 117786], [58, 118406], [62, 118486], [68, 118726], [74, 119046], [77, 119286]]}, {"verse": 17, "start": 120031, "end": 130574, "text": "Y si hijos, también herederos; herederos de Dios, y coherederos de Cristo; si en verdad padecemos juntamente con él, para que juntamente con él seamos glorificados.", "words": [[0, 120031], [2, 120129], [5, 120229], [12, 120489], [20, 120749], [31, 121768], [41, 122288], [44, 122428], [50, 122668], [52, 123088], [64, 123788], [67, 123888], [75, 124858], [78, 125025], [81, 125125], [88, 125365], [98, 125945], [109, 126585], [113, 126885], [117, 127085], [122, 127565], [126, 127725], [137, 128305], [141, 128585], [144, 128745], [151, 129145]]}, {"verse": 18, "start": 130924, "end": 137977, "text": "Porque tengo por cierto que lo que en este tiempo se padece, no es de comparar con la gloria venidera que en nosotros ha de ser manifestada.", "words": [[0, 130924], [7, 131103], [13, 131343], [17, 131563], [24, 131863], [28, 132123], [31, 132263], [35, 132403], [38, 132523], [43, 132723], [50, 133103], [53, 133283], [61, 133723], [64, 134048], [67, 134188], [70, 134308], [79, 134868], [83, 134968], [86, 135128], [93, 135428], [102, 135988], [106, 136068], [109, 136148], [118, 136468], [121, 136908], [124, 136988], [128, 137148]]}, {"verse": 19, "start": 138327, "end": 143311, "text": "Porque el continuo anhelar de la creación espera la manifestación de los hijos de Dios.", "words": [[0, 138327], [7, 138534], [10, 138674], [19, 139254], [27, 139714], [30, 139814], [33, 139934], [42, 140614], [49, 141114], [52, 141314], [66, 142094], [69, 142254], [73, 142394], [79, 142614], [82, 142834]]}, {"verse": 20, "start": 143661, "end": 149953, "text": "Porque la creación fue sujetada a frustración, no voluntariamente, sino por causa del que la sujetó con esperanza,", "words": [[0, 143661], [7, 143829], [10, 144009], [19, 144509], [23, 144709], [32, 145329], [34, 145409], [47, 146049], [50, 146329], [67, 147409], [72, 147589], [76, 147829], [82, 148109], [86, 148349], [90, 148489], [93, 148629], [100, 149089], [104, 149229]]}, {"verse": 21, "start": 150303, "end": 156677, "text": "Que también la creación misma será librada de la servidumbre de corrupción en la libertad gloriosa de los hijos de Dios.", "words": [[0, 150303], [4, 150384], [12, 150704], [15, 150884], [24, 151324], [30, 151584], [35, 151904], [43, 152384], [46, 152524], [49, 152624], [61, 153264], [64, 153384], [75, 154004], [78, 154244], [81, 154324], [90, 154844], [99, 155344], [102, 155524], [106, 155644], [112, 155904], [115, 156144]]}, {"verse": 22, "start": 157027, "end": 161281, "text": "Porque sabemos que toda la creación gime y está de parto juntamente hasta ahora.", "words": [[0, 157027], [7, 157205], [15, 157545], [19, 157785], [24, 157965], [27, 158165], [36, 158635], [41, 159105], [43, 159305], [48, 159485], [51, 159625], [57, 159985], [68, 160605], [74, 160825]]}, {"verse": 23, "start": 161631, "end": 172854, "text": "Y no solo ella, sino también nosotros mismos, que tenemos las primicias del Espíritu, nosotros también gemimos dentro de nosotros mismos, esperando la adopción, es decir, la redención de nuestro cuerpo.", "words": [[0, 161631], [2, 161735], [5, 161835], [10, 162055], [16, 162395], [21, 162695], [29, 163095], [38, 163315], [46, 163875], [50, 164170], [58, 164510], [62, 164710], [72, 165130], [76, 165330], [86, 165990], [95, 166390], [103, 166910], [111, 167490], [118, 167730], [121, 167950], [130, 168150], [138, 168770], [148, 169510], [151, 169830], [161, 170350], [164, 170550], [171, 171300], [174, 171397], [184, 171917], [187, 172057], [195, 172237]]}, {"verse": 24, "start": 173204, "end": 179934, "text": "Porque en esperanza somos salvos; pero la esperanza que se ve, no es esperanza; porque lo que alguno ve, ¿a qué esperarlo?", "words": [[0, 173204], [7, 173404], [10, 173484], [20, 174004], [26, 174244], [34, 175175], [39, 175312], [42, 175472], [52, 175932], [56, 176072], [59, 176212], [63, 176412], [66, 176712], [69, 176852], [80, 177852], [87, 178001], [90, 178161], [94, 178281], [101, 178621], [105, 178741], [108, 179041], [112, 179181]]}, {"verse": 25, "start": 180284, "end": 183232, "text": "Pero si lo que no vemos esperamos, por paciencia esperamos.", "words": [[0, 180284], [5, 180502], [8, 180662], [11, 180782], [15, 180902], [18, 181022], [24, 181282], [35, 181862], [39, 182082], [49, 182582]]}, {"verse": 26, "start": 183582, "end": 193979, "text": "Y asimismo también el Espíritu ayuda nuestra debilidad: porque qué hemos de pedir como conviene, no lo sabemos; sino que el mismo Espíritu pide por nosotros con gemidos indecibles.", "words": [[0, 183582], [2, 183691], [11, 184251], [19, 184551], [22, 184811], [31, 185451], [37, 185771], [45, 186011], [56, 187112], [63, 187262], [67, 187456], [73, 187649], [76, 187889], [82, 188109], [87, 188389], [97, 189049], [100, 189149], [103, 189269], [112, 190156], [117, 190359], [121, 190559], [124, 190659], [130, 190879], [139, 191519], [144, 191799], [148, 191999], [157, 192359], [161, 192759], [169, 193159]]}, {"verse": 27, "start": 194329, "end": 203360, "text": "Pero el que escudriña los corazones, sabe cuál es la intención del Espíritu, porque conforme a la voluntad de Dios, intercede por los santos.", "words": [[0, 194329], [5, 194466], [8, 194606], [12, 194726], [22, 195366], [26, 195506], [37, 196306], [42, 196926], [47, 197226], [50, 197466], [53, 197606], [63, 198126], [67, 198286], [77, 199026], [84, 199506], [93, 200206], [95, 200286], [98, 200346], [107, 200906], [110, 201026], [116, 201326], [126, 202206], [130, 202466], [134, 202626]]}, {"verse": 28, "start": 203710, "end": 211467, "text": "Y sabemos que a los que a Dios aman, todas las cosas les ayudan a bien, es decir, a los que conforme al propósito son llamados.", "words": [[0, 203710], [2, 203841], [10, 204061], [14, 204501], [16, 204601], [20, 204721], [24, 204888], [26, 205054], [31, 205221], [37, 206021], [43, 206101], [47, 206381], [53, 206721], [57, 206981], [64, 207461], [66, 207501], [72, 208261], [75, 208301], [82, 209121], [84, 209201], [88, 209321], [92, 209568], [101, 209814], [104, 210061], [114, 210581], [118, 210801]]}, {"verse": 29, "start": 211817, "end": 220631, "text": "Porque a los que antes conoció, también predestinó para que fuesen hechos conformes a la imagen de su Hijo, para que él sea el primogénito entre muchos hermanos;", "words": [[0, 211817], [7, 212047], [9, 212147], [13, 212287], [17, 212447], [23, 212707], [32, 213747], [40, 213807], [51, 214587], [56, 214767], [60, 214927], [67, 215347], [74, 215607], [84, 216287], [86, 216407], [89, 216487], [96, 216787], [99, 216967], [102, 217147], [108, 217747], [113, 218027], [117, 218227], [120, 218367], [124, 218567], [127, 218727], [139, 219387], [145, 219587], [152, 219867]]}, {"verse": 30, "start": 220981, "end": 230575, "text": "Y a los que predestinó, a estos también llamó; y a los que llamó, a estos también justificó; y a los que justificó, a estos también glorificó.", "words": [[0, 220981], [2, 221104], [4, 221164], [8, 221304], [12, 221444], [24, 222624], [26, 222744], [32, 223044], [40, 223484], [47, 224254], [49, 224377], [51, 224457], [55, 224597], [59, 224757], [66, 225417], [68, 225657], [74, 225937], [82, 226297], [93, 227430], [95, 227554], [97, 227634], [101, 227774], [105, 227914], [116, 228974], [118, 229094], [124, 229314], [132, 229674]]}, {"verse": 31, "start": 230925, "end": 235874, "text": "¿Pues qué diremos a esto? Si Dios por nosotros, ¿quién contra nosotros?", "words": [[0, 230925], [6, 231126], [10, 231306], [18, 231786], [20, 231906], [26, 233180], [29, 233334], [34, 233514], [38, 233774], [48, 234654], [55, 234814], [62, 235054]]}, {"verse": 32, "start": 236224, "end": 243187, "text": "El que no escatimó ni a su propio Hijo, antes le entregó por todos nosotros, ¿cómo no nos dará también con él todas las cosas?", "words": [[0, 236224], [3, 236329], [7, 236449], [10, 236722], [19, 236996], [22, 237269], [24, 237389], [27, 237509], [34, 237729], [40, 238409], [46, 238709], [49, 238909], [57, 239309], [61, 239449], [67, 239649], [77, 240689], [83, 240869], [86, 241049], [90, 241229], [95, 241489], [103, 241749], [107, 241989], [110, 242109], [116, 242289], [120, 242569]]}, {"verse": 33, "start": 243537, "end": 247610, "text": "¿Quién acusará a los escogidos de Dios? Dios es el que justifica.", "words": [[0, 243761], [7, 244001], [15, 244241], [17, 244341], [21, 244441], [31, 245041], [34, 245201], [40, 245965], [45, 246222], [48, 246542], [51, 246662], [55, 246802]]}, {"verse": 34, "start": 247960, "end": 257333, "text": "¿Quién es el que condenará? Cristo es el que murió; más aún, el que también resucitó, quien además está a la diestra de Dios, el que también intercede por nosotros.", "words": [[0, 247960], [7, 248182], [10, 248282], [13, 248402], [17, 248502], [28, 249476], [35, 249758], [38, 249918], [41, 250038], [45, 250158], [52, 250854], [56, 251032], [61, 251372], [64, 251532], [68, 251672], [76, 252012], [86, 253072], [92, 253152], [99, 253532], [104, 253872], [106, 253992], [109, 254052], [117, 254432], [120, 254612], [126, 255252], [129, 255372], [133, 255492], [141, 255792], [151, 256392], [155, 256652]]}, {"verse": 35, "start": 257683, "end": 267108, "text": "¿Quién nos apartará del amor de Cristo? tribulación? o angustia? o persecución? o hambre? o desnudez? o peligro? o espada?", "words": [[0, 257683], [7, 257880], [11, 258000], [20, 258540], [24, 258700], [29, 258920], [32, 259100], [40, 259878], [53, 261047], [55, 261211], [65, 262181], [67, 262323], [80, 263393], [82, 263573], [90, 264287], [92, 264707], [102, 265384], [104, 265482], [113, 266352], [115, 266469]]}, {"verse": 36, "start": 267458, "end": 273917, "text": "Como está escrito: Por causa de ti somos muertos todo el tiempo: somos estimados como ovejas de matadero.", "words": [[0, 267458], [5, 267621], [10, 267841], [19, 268712], [23, 268833], [29, 269093], [32, 269333], [35, 269493], [41, 269773], [49, 270253], [54, 270493], [57, 270693], [65, 271523], [71, 271723], [81, 272443], [86, 272723], [93, 273083], [96, 273223]]}, {"verse": 37, "start": 274267, "end": 279261, "text": "Antes, en todas estas cosas hacemos más que vencer por medio de aquel que nos amó.", "words": [[0, 274267], [7, 274570], [10, 274790], [16, 274970], [22, 275330], [28, 275810], [36, 276410], [40, 276810], [44, 277010], [51, 277510], [55, 277770], [61, 278030], [64, 278250], [70, 278550], [74, 278650], [78, 278810]]}, {"verse": 38, "start": 279611, "end": 287726, "text": "Por lo cual estoy cierto que ni la muerte, ni la vida, ni ángeles, ni principados, ni potestades, ni lo presente, ni lo por venir,", "words": [[0, 279611], [4, 279717], [7, 279837], [12, 280097], [18, 280357], [25, 280737], [29, 280957], [32, 281097], [35, 281217], [43, 281817], [46, 281917], [49, 282057], [55, 282537], [58, 282677], [67, 283357], [70, 283437], [83, 284557], [86, 284637], [98, 285637], [101, 285817], [104, 285917], [114, 286857], [117, 286937], [120, 287210], [124, 287484]]}, {"verse": 39, "start": 288076, "end": 296508, "text": "Ni lo alto, ni lo bajo, ni ninguna criatura nos podrá apartar del amor de Dios, que es en Cristo Jesús Señor nuestro.", "words": [[0, 288076], [3, 288218], [6, 288358], [12, 288638], [15, 288878], [18, 288998], [24, 289318], [27, 289738], [35, 290118], [44, 290718], [48, 290878], [54, 291358], [62, 291878], [66, 292038], [71, 292298], [74, 292498], [80, 293218], [84, 293478], [87, 293718], [90, 293858], [97, 294178], [103, 294918], [109, 295158]]}]}