{"book": "PSA", "chapter": 95, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 68951, "verses": [{"verse": 1, "start": 300, "end": 6769, "text": "Venid, celebremos alegremente a Jehová: cantemos con júbilo a la roca de nuestra salvación.", "words": [[0, 300], [7, 845], [18, 1465], [30, 2265], [32, 2465], [40, 3279], [49, 3785], [53, 4025], [60, 4645], [62, 4885], [65, 5005], [70, 5425], [73, 5565], [81, 5725]]}, {"verse": 2, "start": 7219, "end": 12398, "text": "Lleguemos ante su presencia con alabanza; aclamémosle con cánticos.", "words": [[0, 7219], [10, 7739], [15, 8019], [18, 8259], [28, 8919], [32, 9159], [42, 10402], [54, 11226], [58, 11426]]}, {"verse": 3, "start": 12848, "end": 17723, "text": "Porque Jehová es Dios grande; y Rey grande sobre todos los dioses.", "words": [[0, 12848], [7, 13055], [14, 13615], [17, 13815], [22, 14015], [30, 14963], [32, 15128], [36, 15488], [43, 15848], [49, 16268], [55, 16668], [59, 16988]]}, {"verse": 4, "start": 18173, "end": 24573, "text": "Porque en su mano están las profundidades de la tierra, y las alturas de los montes son suyas.", "words": [[0, 18173], [7, 18398], [10, 18558], [13, 18738], [18, 19038], [24, 19358], [28, 19558], [42, 20498], [45, 20678], [48, 20778], [56, 21238], [58, 21718], [62, 21918], [70, 22478], [73, 22618], [77, 22758], [84, 23318], [88, 23798]]}, {"verse": 5, "start": 25023, "end": 30472, "text": "Suya también el mar, pues él la hizo; y sus manos formaron la tierra seca.", "words": [[0, 25023], [5, 25399], [13, 25739], [16, 25959], [21, 26559], [26, 26739], [29, 26959], [32, 27159], [38, 27904], [40, 28011], [44, 28151], [50, 28571], [59, 29231], [62, 29411], [69, 29651]]}, {"verse": 6, "start": 30922, "end": 37271, "text": "Venid, adoremos y postrémonos; arrodillémonos delante de Jehová nuestro hacedor.", "words": [[0, 30922], [7, 31827], [16, 32347], [18, 32567], [31, 34475], [46, 35055], [54, 35515], [57, 35915], [64, 36315], [72, 36495]]}, {"verse": 7, "start": 37721, "end": 45446, "text": "Porque él es nuestro Dios; nosotros el pueblo de su prado, y ovejas de su mano. Si hoy oís su voz,", "words": [[0, 37721], [7, 37969], [10, 38309], [13, 38469], [21, 38829], [27, 39779], [36, 40726], [39, 40806], [46, 41186], [49, 41406], [52, 41566], [59, 42026], [61, 42406], [68, 42826], [71, 43026], [74, 43186], [80, 44258], [83, 44510], [87, 44762], [91, 45015], [94, 45267]]}, {"verse": 8, "start": 45696, "end": 51137, "text": "No endurezcáis vuestro corazón como en Meriba, como el día de Masa en el desierto;", "words": [[0, 45696], [3, 45882], [15, 46702], [23, 47102], [31, 47542], [36, 47842], [39, 48382], [47, 48922], [52, 49042], [55, 49202], [59, 49402], [62, 49542], [67, 49862], [70, 50042], [73, 50142]]}, {"verse": 9, "start": 51587, "end": 56200, "text": "Donde me tentaron vuestros padres, me probaron, y vieron mi obra.", "words": [[0, 51587], [6, 51767], [9, 51947], [18, 52407], [27, 52747], [35, 53147], [38, 53507], [48, 54007], [50, 54447], [57, 54707], [60, 54887]]}, {"verse": 10, "start": 56650, "end": 64592, "text": "Cuarenta años estuve disgustado con la nación, y dije: Pueblo es que divaga de corazón, y no han conocido mis caminos.", "words": [[0, 56650], [9, 57168], [14, 57388], [21, 57828], [32, 58508], [36, 58668], [39, 58808], [47, 59268], [49, 59628], [55, 60695], [62, 60981], [65, 61141], [69, 61281], [76, 61661], [79, 61801], [88, 62281], [90, 62721], [93, 62861], [97, 62981], [106, 63481], [110, 63641]]}, {"verse": 11, "start": 65042, "end": 68551, "text": "Por tanto juré en mi furor que no entrarían en mi reposo.", "words": [[0, 65042], [4, 65143], [10, 65563], [15, 65923], [18, 66023], [21, 66143], [27, 66543], [31, 66703], [34, 66843], [44, 67383], [47, 67483], [50, 67623]]}]}