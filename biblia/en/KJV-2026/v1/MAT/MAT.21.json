{"book": "MAT", "chapter": 21, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 368126, "verses": [{"verse": 1, "start": 300, "end": 7807, "text": "And when they drew near to Jerusalem, and were come to Bethphage, to the mount of Olives, then sent Jesus two disciples,", "words": [[0, 300], [4, 458], [9, 618], [14, 818], [19, 1078], [24, 1338], [27, 1518], [38, 2138], [42, 2538], [47, 2678], [52, 2918], [55, 3118], [66, 4158], [69, 4298], [73, 4418], [79, 4678], [82, 4838], [90, 5818], [95, 5938], [100, 6198], [106, 6578], [110, 6958]]}, {"verse": 2, "start": 8257, "end": 16874, "text": "Saying to them, Go into the village over against you, and immediately you shall find a donkey tied, and a colt with her: loose them, and bring them to me.", "words": [[0, 8257], [7, 8561], [10, 8782], [16, 9386], [19, 9645], [24, 9985], [28, 10205], [36, 10525], [41, 10785], [49, 11185], [54, 11705], [58, 11905], [70, 12285], [74, 12685], [80, 12825], [85, 13085], [87, 13245], [94, 13565], [100, 13925], [104, 14285], [106, 14435], [111, 14585], [116, 14805], [121, 15311], [127, 15630], [133, 15790], [137, 16050], [143, 16290], [148, 16450], [151, 16630]]}, {"verse": 3, "start": 17324, "end": 23750, "text": "And if anyone says anything to you, you shall say, The Lord has need of them; and immediately he will send them.", "words": [[0, 17324], [4, 17430], [7, 17550], [14, 17830], [19, 18070], [28, 18390], [31, 18710], [36, 19410], [40, 19570], [46, 19770], [51, 20450], [55, 20590], [60, 20810], [64, 21010], [69, 21230], [72, 21430], [78, 22066], [82, 22192], [94, 22512], [97, 22992], [102, 23132], [107, 23372]]}, {"verse": 4, "start": 24100, "end": 29253, "text": "All this was done, that it might be fulfilled which was spoken by the prophet, saying,", "words": [[0, 24100], [4, 24307], [9, 24527], [13, 24707], [19, 25367], [24, 25587], [27, 25707], [33, 25907], [36, 26107], [46, 26767], [52, 26927], [56, 27107], [63, 27527], [66, 27827], [70, 27947], [79, 28707]]}, {"verse": 5, "start": 29703, "end": 36431, "text": "Tell the daughter of Sion, Behold, your King comes to you, meek, and sitting upon a donkey, and a colt the foal of a donkey.", "words": [[0, 29703], [5, 29843], [9, 30023], [18, 30303], [21, 30483], [27, 31143], [35, 31723], [40, 31783], [45, 32003], [51, 32283], [54, 32483], [59, 32683], [65, 33263], [69, 33343], [77, 33583], [82, 33903], [84, 34083], [92, 34383], [96, 34623], [98, 34763], [103, 35183], [107, 35303], [112, 35703], [115, 35823], [117, 35923]]}, {"verse": 6, "start": 36881, "end": 40213, "text": "And the disciples went, and did as Jesus commanded them,", "words": [[0, 36881], [4, 37031], [8, 37131], [18, 37611], [24, 38011], [28, 38451], [32, 38671], [35, 38851], [41, 39191], [51, 39731]]}, {"verse": 7, "start": 40663, "end": 45897, "text": "And brought the donkey, and the colt, and put on them their clothes, and they set him on it.", "words": [[0, 40663], [4, 40807], [12, 41007], [16, 41207], [24, 41587], [28, 41927], [32, 42047], [38, 42487], [42, 42867], [46, 43087], [49, 43267], [54, 43447], [60, 43627], [69, 44627], [73, 44807], [78, 44947], [82, 45207], [86, 45367], [89, 45587]]}, {"verse": 8, "start": 46347, "end": 53489, "text": "And a very great multitude spread their garments in the way; others cut down branches from the trees, and scattered them in the way.", "words": [[0, 46347], [4, 46483], [6, 46563], [11, 46783], [17, 47103], [27, 47643], [34, 48103], [40, 48343], [49, 48703], [52, 49003], [56, 49103], [61, 49826], [68, 50048], [72, 50368], [77, 50628], [86, 51128], [91, 51428], [95, 51568], [102, 51908], [106, 52148], [116, 52528], [121, 52808], [124, 52928], [128, 53028]]}, {"verse": 9, "start": 53939, "end": 64658, "text": "And the multitudes that went before, and that followed, cried, saying, Hosanna to the Son of David: Blessed is he that comes in the name of the Lord; Hosanna in the highest.", "words": [[0, 53939], [4, 54083], [8, 54163], [19, 54743], [24, 54963], [29, 55163], [37, 55963], [41, 56243], [46, 56383], [56, 57003], [63, 57866], [71, 59167], [79, 59357], [82, 59597], [86, 59737], [90, 59957], [93, 60077], [100, 60834], [108, 61013], [111, 61333], [114, 61533], [119, 61773], [125, 62013], [128, 62193], [132, 62273], [137, 62433], [140, 62553], [144, 62653], [150, 63333], [158, 63760], [161, 64000], [165, 64120]]}, {"verse": 10, "start": 65008, "end": 70760, "text": "And when he was come into Jerusalem, all the city was moved, saying, Who is this?", "words": [[0, 65008], [4, 65133], [9, 65313], [12, 65493], [16, 65673], [21, 65913], [26, 66133], [37, 67233], [41, 67693], [45, 67873], [50, 68113], [54, 68373], [61, 69033], [69, 69954], [73, 70110], [76, 70230]]}, {"verse": 11, "start": 71110, "end": 76137, "text": "And the multitude said, This is Jesus the prophet of Nazareth of Galilee.", "words": [[0, 71110], [4, 71238], [8, 71338], [18, 71798], [24, 72732], [29, 72974], [32, 73134], [38, 74034], [42, 74114], [50, 74434], [53, 74694], [62, 75214], [65, 75554]]}, {"verse": 12, "start": 76487, "end": 87731, "text": "¶ And Jesus went into the temple of God, and cast out all them that sold and bought in the temple, and overthrew the tables of the moneychangers, and the seats of them that sold doves,", "words": [[2, 76487], [6, 76629], [12, 76929], [17, 77309], [22, 77549], [26, 77709], [33, 78049], [36, 78249], [41, 78569], [45, 79149], [50, 79489], [54, 79769], [58, 80089], [63, 80349], [68, 80549], [73, 80949], [77, 81229], [84, 81549], [87, 81709], [91, 81829], [99, 82189], [103, 82749], [113, 83349], [117, 83529], [124, 83909], [127, 84109], [131, 84684], [146, 85493], [150, 85629], [154, 85809], [160, 85989], [163, 86249], [168, 86449], [173, 86699], [178, 86949]]}, {"verse": 13, "start": 88181, "end": 94273, "text": "And said to them, It is written, My house shall be called the house of prayer; but you have made it a den of thieves.", "words": [[0, 88181], [4, 88286], [9, 88546], [12, 88766], [18, 89446], [21, 89548], [24, 89688], [33, 89908], [36, 90128], [42, 90368], [48, 90588], [51, 90708], [58, 90968], [62, 91188], [68, 91388], [71, 91568], [79, 92379], [83, 92461], [87, 92621], [92, 92741], [97, 92941], [100, 93101], [102, 93221], [106, 93441], [109, 93601]]}, {"verse": 14, "start": 94623, "end": 98667, "text": "And the blind and the lame came to him in the temple; and he healed them.", "words": [[0, 94623], [4, 94776], [8, 94876], [14, 95276], [18, 95556], [22, 95716], [27, 95956], [32, 96276], [35, 96496], [39, 96656], [42, 96756], [46, 96856], [54, 97650], [58, 97808], [61, 97968], [68, 98268]]}, {"verse": 15, "start": 99117, "end": 110160, "text": "And when the chief priests and scribes saw the wonderful things that he did, and the children crying in the temple, and saying, Hosanna to the Son of David; they were greatly displeased,", "words": [[0, 99117], [4, 99253], [9, 99413], [13, 99553], [19, 99813], [27, 100253], [31, 100473], [39, 101113], [43, 101373], [47, 101533], [57, 101933], [64, 102393], [69, 102633], [72, 102753], [77, 103133], [81, 103673], [85, 103793], [94, 104093], [101, 104593], [104, 104833], [108, 104933], [116, 105293], [120, 105853], [128, 106927], [136, 107177], [139, 107357], [143, 107457], [147, 107697], [150, 107817], [157, 108581], [162, 108708], [167, 108828], [175, 109188]]}, {"verse": 16, "start": 110610, "end": 120533, "text": "And said to him, Do you hear what these say? And Jesus says to them, Yes; have you never read, Out of the mouth of babes and sucklings you have perfected praise?", "words": [[0, 110610], [4, 110755], [9, 110975], [12, 111195], [17, 111767], [20, 111915], [24, 112035], [29, 112155], [34, 112295], [40, 112495], [45, 113227], [49, 113365], [55, 113685], [60, 114025], [63, 114245], [69, 114923], [74, 115802], [79, 115964], [83, 116064], [89, 116304], [95, 117064], [99, 117224], [102, 117364], [106, 117464], [112, 117704], [115, 117924], [121, 118424], [125, 118544], [135, 119164], [139, 119254], [144, 119344], [154, 119944]]}, {"verse": 17, "start": 120883, "end": 125401, "text": "¶ And he left them, and went out of the city into Bethany; and he lodged there.", "words": [[2, 120883], [6, 121009], [9, 121109], [14, 121389], [20, 121649], [24, 122189], [29, 122389], [33, 122589], [36, 122729], [40, 122829], [45, 123089], [50, 123349], [59, 124303], [63, 124430], [66, 124570], [73, 125010]]}, {"verse": 18, "start": 125851, "end": 129268, "text": "Now in the morning as he returned into the city, he was hungry.", "words": [[0, 125851], [4, 126291], [7, 126491], [11, 126591], [19, 127011], [22, 127111], [25, 127231], [34, 127551], [39, 127891], [43, 128051], [49, 128471], [52, 128551], [56, 128731]]}, {"verse": 19, "start": 129718, "end": 142498, "text": "And when he saw a fig tree in the way, he came to it, and found nothing on it, but leaves only, and said to it, Let no fruit grow on you from now on for ever. And immediately the fig tree withered away.", "words": [[0, 129718], [4, 129849], [9, 129989], [12, 130149], [16, 130449], [18, 130589], [22, 130769], [27, 131089], [30, 131269], [34, 131369], [39, 132069], [42, 132149], [47, 132489], [50, 132749], [54, 133229], [58, 133469], [64, 133749], [72, 134109], [75, 134409], [79, 134709], [83, 134849], [90, 135129], [96, 135949], [100, 136149], [105, 136409], [108, 136649], [112, 137162], [116, 137310], [119, 137530], [125, 137850], [130, 138130], [133, 138350], [137, 138490], [142, 138690], [146, 138950], [149, 139263], [153, 139577], [159, 140195], [163, 140332], [175, 140692], [179, 141112], [183, 141352], [188, 141632], [197, 141992]]}, {"verse": 20, "start": 142948, "end": 147815, "text": "And when the disciples saw it, they marvelled, saying, How soon is the fig tree withered away!", "words": [[0, 142948], [4, 143073], [9, 143193], [13, 143313], [23, 143753], [27, 144133], [31, 144413], [36, 144763], [47, 145113], [55, 145848], [59, 145988], [64, 146268], [67, 146408], [71, 146528], [75, 146768], [80, 146968], [89, 147348]]}, {"verse": 21, "start": 148165, "end": 163552, "text": "Jesus answered and said to them, Assuredly I say to you, If you have faith, and doubt not, you shall not only do this which is done to the fig tree, but also if you shall say to this mountain, Be removed, and be cast into the sea; it shall be done.", "words": [[0, 148165], [6, 148429], [15, 148949], [19, 149169], [24, 149369], [27, 149549], [33, 150268], [43, 150861], [45, 151021], [49, 151221], [52, 151401], [57, 151981], [60, 152101], [64, 152241], [69, 152421], [76, 153241], [80, 153401], [86, 153621], [91, 154361], [95, 154481], [101, 154641], [105, 154841], [110, 155081], [113, 155301], [118, 155581], [124, 155821], [127, 155961], [132, 156181], [135, 156361], [139, 156461], [143, 156701], [149, 157499], [153, 157603], [158, 158123], [161, 158323], [165, 158443], [171, 158623], [175, 158863], [178, 158983], [183, 159143], [193, 159903], [196, 160083], [205, 160563], [209, 160943], [212, 161103], [217, 161403], [222, 161723], [226, 161883], [231, 162598], [234, 162714], [240, 162934], [243, 163094]]}, {"verse": 22, "start": 164002, "end": 168294, "text": "And all things, whatever you shall ask in prayer, believing, you shall receive.", "words": [[0, 164002], [4, 164124], [8, 164304], [16, 164604], [25, 164944], [29, 165164], [35, 165344], [39, 165684], [42, 165864], [50, 166504], [61, 166984], [65, 167464], [71, 167644]]}, {"verse": 23, "start": 168644, "end": 180186, "text": "¶ And when he was come into the temple, the chief priests and the elders of the people came to him as he was teaching, and said, By what authority are you doing these things? and who gave you this authority?", "words": [[2, 168644], [6, 168778], [11, 168938], [14, 169098], [18, 169258], [23, 169478], [28, 169698], [32, 169878], [40, 170738], [44, 170838], [50, 171098], [58, 171538], [62, 171878], [66, 172018], [73, 172298], [76, 172538], [80, 172638], [87, 172938], [92, 173278], [95, 173518], [99, 173718], [102, 173958], [105, 174098], [109, 174258], [119, 174638], [123, 175278], [129, 175979], [132, 176104], [137, 176364], [147, 176844], [151, 177184], [155, 177344], [161, 177664], [167, 177884], [175, 178762], [179, 178899], [183, 179079], [188, 179279], [192, 179439], [197, 179619]]}, {"verse": 24, "start": 180536, "end": 191289, "text": "And Jesus answered and said to them, I also will ask you one thing, which if you tell me, I in like wise will tell you by what authority I do these things.", "words": [[0, 180536], [4, 180678], [10, 181018], [19, 181598], [23, 181798], [28, 182018], [31, 182178], [37, 184278], [39, 184405], [44, 184745], [49, 184985], [53, 185265], [57, 185445], [61, 185685], [68, 186325], [74, 186805], [77, 186905], [81, 187025], [86, 187245], [90, 187885], [92, 188045], [95, 188218], [100, 188392], [105, 188565], [110, 188965], [115, 189165], [119, 189365], [122, 189525], [127, 189725], [137, 190105], [139, 190345], [142, 190505], [148, 190705]]}, {"verse": 25, "start": 191739, "end": 206994, "text": "The baptism of John, from where was it? from heaven, or of men? And they reasoned with themselves, saying, If we shall say, From heaven; he will say to us, Why did you not then believe him?", "words": [[0, 191739], [4, 191819], [12, 192179], [15, 192479], [21, 192839], [26, 193219], [32, 193439], [36, 193739], [40, 194357], [45, 194522], [53, 194922], [56, 195422], [59, 195582], [62, 197578], [64, 199119], [68, 199263], [73, 199403], [82, 199923], [87, 199983], [99, 200683], [107, 202127], [110, 202271], [113, 202391], [119, 202551], [124, 202831], [129, 203271], [137, 204129], [140, 204213], [145, 204333], [149, 204513], [152, 204693], [156, 205213], [160, 205513], [164, 205713], [168, 205873], [172, 206033], [177, 206233], [185, 206533]]}, {"verse": 26, "start": 207444, "end": 212692, "text": "But if we shall say, Of men; we fear the people; for all hold John as a prophet.", "words": [[0, 207444], [4, 207522], [7, 207662], [10, 207762], [16, 207942], [21, 208402], [24, 208702], [29, 209471], [32, 209572], [37, 209812], [41, 209972], [49, 210804], [53, 210933], [57, 211143], [62, 211353], [67, 211773], [70, 212193], [72, 212273]]}, {"verse": 27, "start": 213042, "end": 220695, "text": "And they answered Jesus, and said, We cannot tell. And he said to them, Neither tell I you by what authority I do these things.", "words": [[0, 213042], [4, 213186], [9, 213286], [18, 213606], [25, 214046], [29, 214426], [35, 215088], [38, 215208], [45, 215508], [51, 216344], [55, 216474], [58, 216594], [63, 216834], [66, 217034], [72, 217630], [80, 217869], [85, 218209], [87, 218409], [91, 218609], [94, 218789], [99, 218969], [109, 219369], [111, 219609], [114, 219829], [120, 220069]]}, {"verse": 28, "start": 221145, "end": 228668, "text": "¶ But what do you think? A certain man had two sons; and he came to the first, and said, Son, go work today in my vineyard.", "words": [[2, 221145], [6, 221247], [11, 221427], [14, 221607], [18, 221707], [25, 222537], [27, 222655], [35, 222915], [39, 223275], [43, 223555], [47, 223815], [53, 224816], [57, 224918], [60, 225018], [65, 225218], [68, 225398], [72, 225518], [79, 225818], [83, 226058], [89, 226458], [94, 226938], [97, 227298], [102, 227538], [108, 227778], [111, 227978], [114, 228138]]}, {"verse": 29, "start": 229118, "end": 233331, "text": "He answered and said, I will not: but afterward he repented, and went.", "words": [[0, 229118], [3, 229230], [12, 229550], [16, 229770], [22, 230290], [24, 230470], [29, 230630], [34, 231416], [38, 231519], [48, 231879], [51, 232099], [61, 232619], [65, 232879]]}, {"verse": 30, "start": 233781, "end": 240415, "text": "And he came to the second, and said likewise. And he answered and said, I go, sir: and went not.", "words": [[0, 233781], [4, 233900], [7, 234020], [12, 234240], [15, 234420], [19, 234540], [27, 234880], [31, 235420], [36, 235760], [46, 236844], [50, 236960], [53, 237100], [62, 237520], [66, 237720], [72, 238340], [74, 238520], [78, 238900], [83, 239544], [87, 239682], [92, 239862]]}, {"verse": 31, "start": 240865, "end": 257112, "text": "Whether of them two did the will of his father? They say to him, The first. Jesus says to them, Assuredly I say to you, That the tax collectors and the harlots go into the kingdom of God before you.", "words": [[0, 240865], [8, 241089], [11, 241309], [16, 241469], [20, 241749], [24, 241929], [28, 242069], [33, 242229], [36, 242369], [40, 242489], [46, 244575], [48, 246116], [53, 246246], [57, 246486], [60, 246686], [65, 247379], [69, 247540], [76, 248353], [82, 248637], [87, 248977], [90, 249217], [96, 251558], [106, 252160], [108, 252280], [112, 252480], [115, 252700], [120, 253260], [125, 253520], [129, 253660], [133, 253940], [144, 254460], [148, 254660], [152, 254760], [160, 255220], [163, 255400], [168, 255520], [172, 255660], [180, 255900], [183, 256100], [187, 256320], [194, 256660]]}, {"verse": 32, "start": 257562, "end": 268516, "text": "For John came to you in the way of righteousness, and you believed him not: but the tax collectors and the harlots believed him: and you, when you had seen it, repented not afterward, that you might believe him.", "words": [[0, 257562], [4, 257675], [9, 257955], [14, 258235], [17, 258435], [21, 258595], [24, 258735], [28, 258815], [32, 258995], [35, 259095], [50, 260095], [54, 260235], [58, 260355], [67, 260655], [71, 260895], [76, 261684], [80, 261781], [84, 261901], [88, 262181], [99, 262641], [103, 262900], [107, 263020], [115, 263381], [124, 263701], [129, 264385], [133, 264529], [138, 264889], [143, 265029], [147, 265149], [151, 265289], [156, 265509], [160, 265929], [169, 266409], [173, 266609], [184, 267369], [189, 267529], [193, 267629], [199, 267789], [207, 268129]]}, {"verse": 33, "start": 268966, "end": 280505, "text": "¶ Hear another parable: There was a certain householder, which planted a vineyard, and hedged it round about, and dug a winepress in it, and built a tower, and let it out to vinedressers, and went into a far country:", "words": [[2, 268966], [7, 269094], [15, 269374], [24, 270314], [30, 270421], [34, 270561], [36, 270701], [44, 270901], [57, 271601], [63, 271941], [71, 272341], [73, 272481], [83, 272861], [87, 273241], [94, 273581], [97, 273788], [103, 273994], [110, 274201], [114, 274641], [118, 274841], [120, 275131], [130, 275421], [133, 275621], [137, 275741], [141, 276021], [147, 276201], [149, 276341], [156, 276641], [160, 276901], [164, 277161], [167, 277301], [171, 277401], [174, 277921], [188, 278688], [192, 278830], [197, 279030], [202, 279390], [204, 279530], [208, 279850]]}, {"verse": 34, "start": 280955, "end": 287248, "text": "And when the time of the fruit drew near, he sent his servants to the vinedressers, that they might receive the fruits of it.", "words": [[0, 280955], [4, 281099], [9, 281239], [13, 281379], [18, 281679], [21, 281779], [25, 281879], [31, 282099], [36, 282339], [42, 283079], [45, 283179], [50, 283459], [54, 283639], [63, 284019], [66, 284299], [70, 284699], [84, 285099], [89, 285519], [94, 285699], [100, 285919], [108, 286359], [112, 286559], [119, 286779], [122, 286999]]}, {"verse": 35, "start": 287698, "end": 293046, "text": "And the vinedressers took his servants, and beat one, and killed another, and stoned another.", "words": [[0, 287698], [4, 287840], [8, 288250], [21, 288660], [26, 288860], [30, 289060], [40, 289440], [44, 290020], [49, 290280], [54, 290540], [58, 290980], [65, 291220], [74, 291600], [78, 292120], [85, 292580]]}, {"verse": 36, "start": 293496, "end": 297995, "text": "Again, he sent other servants more than the first: and they did to them likewise.", "words": [[0, 293496], [7, 293960], [10, 294040], [15, 294280], [21, 294540], [30, 294960], [35, 295260], [40, 295440], [44, 295580], [51, 296353], [55, 296513], [60, 296633], [64, 296833], [67, 296993], [72, 297193]]}, {"verse": 37, "start": 298445, "end": 303066, "text": "But last of all he sent to them his son, saying, They will reverence my son.", "words": [[0, 298445], [4, 298549], [9, 298849], [12, 299049], [16, 299349], [19, 299489], [24, 299749], [27, 299889], [32, 300049], [36, 300209], [41, 300829], [49, 301549], [54, 301809], [59, 301949], [69, 302449], [72, 302629]]}, {"verse": 38, "start": 303516, "end": 311186, "text": "But when the vinedressers saw the son, they said among themselves, This is the heir; come, let us kill him, and let us seize on his inheritance.", "words": [[0, 303516], [4, 303597], [9, 303717], [13, 304067], [26, 304417], [30, 304697], [34, 305037], [39, 305377], [44, 305477], [49, 305697], [55, 305897], [67, 306757], [72, 306897], [75, 307017], [79, 307317], [85, 307899], [91, 308055], [95, 308295], [98, 308475], [103, 308735], [108, 308975], [112, 309375], [116, 309575], [119, 309715], [125, 310015], [128, 310255], [132, 310415]]}, {"verse": 39, "start": 311636, "end": 315037, "text": "And they caught him, and cast him out of the vineyard, and killed him.", "words": [[0, 311636], [4, 311774], [9, 311934], [16, 312234], [21, 312474], [25, 312814], [30, 313134], [34, 313354], [38, 313494], [41, 313594], [45, 313694], [55, 314114], [59, 314394], [66, 314694]]}, {"verse": 40, "start": 315487, "end": 320096, "text": "When the lord therefore of the vineyard comes, what will he do to those vinedressers?", "words": [[0, 315487], [5, 315609], [9, 315729], [14, 315989], [24, 316389], [27, 316649], [31, 316749], [40, 317109], [47, 317949], [52, 318149], [57, 318329], [60, 318469], [63, 318769], [66, 318969], [72, 319539]]}, {"verse": 41, "start": 320446, "end": 328326, "text": "They say to him, He will miserably destroy those wicked men, and will let out his vineyard to other vinedressers, which shall render him the fruits in their seasons.", "words": [[0, 320446], [5, 320551], [9, 320791], [12, 320991], [17, 321549], [20, 321673], [25, 321833], [35, 322333], [43, 322713], [49, 322953], [56, 323213], [61, 323773], [65, 323973], [70, 324093], [74, 324273], [78, 324393], [82, 324533], [91, 324893], [94, 325053], [100, 325573], [114, 326093], [120, 326253], [126, 326453], [133, 326713], [137, 326933], [141, 327053], [148, 327313], [151, 327533], [157, 327653]]}, {"verse": 42, "start": 328676, "end": 341547, "text": "Jesus says to them, Did you never read in the scriptures, The stone which the builders rejected, the same is become the head of the corner: this is the Lord’s doing, and it is marvellous in our eyes?", "words": [[0, 328676], [6, 328960], [11, 329300], [14, 329540], [20, 331881], [24, 332000], [28, 332140], [34, 332360], [39, 332700], [42, 332860], [46, 332960], [58, 333360], [62, 333740], [68, 334080], [74, 334320], [78, 334480], [87, 334740], [97, 335320], [101, 335860], [106, 336110], [109, 336360], [116, 336660], [120, 336860], [125, 337000], [128, 337100], [132, 337180], [140, 338270], [145, 338507], [148, 338767], [152, 338907], [159, 339267], [166, 339867], [170, 339947], [173, 340067], [176, 340337], [187, 340607], [190, 340867], [194, 341027]]}, {"verse": 43, "start": 341997, "end": 349157, "text": "Therefore say I to you, The kingdom of God shall be taken from you, and given to a nation bringing forth the fruits of it.", "words": [[0, 341997], [10, 342387], [14, 342767], [16, 342947], [19, 343127], [24, 343367], [28, 344027], [36, 344327], [39, 344587], [43, 344907], [49, 345167], [52, 345307], [58, 345607], [63, 345887], [68, 346167], [72, 346607], [78, 346847], [81, 347067], [83, 347187], [90, 347507], [99, 347927], [105, 348327], [109, 348567], [116, 348747], [119, 348987]]}, {"verse": 44, "start": 349607, "end": 355859, "text": "And whoever shall fall on this stone shall be broken: but on whomsoever it shall fall, it will grind him to powder.", "words": [[0, 349607], [4, 349729], [12, 349969], [18, 350309], [23, 350569], [26, 350709], [31, 350869], [37, 351189], [43, 351429], [46, 351569], [54, 352427], [58, 352523], [61, 352923], [72, 353323], [75, 353543], [81, 353683], [87, 354423], [90, 354643], [95, 354783], [101, 355063], [105, 355283], [108, 355423]]}, {"verse": 45, "start": 356209, "end": 361583, "text": "And when the chief priests and Pharisees had heard his parables, they perceived that he spoke of them.", "words": [[0, 356209], [4, 356335], [9, 356495], [13, 356635], [19, 356875], [27, 357275], [31, 357555], [41, 358255], [45, 358395], [51, 358615], [55, 358795], [65, 359755], [70, 359895], [80, 360295], [85, 360615], [88, 360715], [94, 360935], [97, 361215]]}, {"verse": 46, "start": 362033, "end": 367726, "text": "But when they sought to lay hands on him, they feared the multitude, because they took him for a prophet.", "words": [[0, 362033], [4, 362137], [9, 362297], [14, 362477], [21, 362737], [24, 362957], [28, 363097], [34, 363437], [37, 363697], [42, 364337], [47, 364537], [54, 364857], [58, 365037], [69, 365557], [77, 366237], [82, 366457], [87, 366697], [91, 366857], [95, 367037], [97, 367424]]}]}