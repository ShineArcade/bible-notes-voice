{"book": "1CO", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 155487, "verses": [{"verse": 1, "start": 300, "end": 7609, "text": "De manera que yo, hermanos, no pude hablaros como a espirituales, sino como a carnales, como a niños en Cristo.", "words": [[0, 300], [3, 425], [10, 665], [14, 985], [18, 1385], [28, 2465], [31, 2585], [36, 2825], [45, 3325], [50, 3425], [52, 3525], [66, 4705], [71, 5045], [76, 5305], [78, 5465], [88, 6405], [93, 6485], [95, 6625], [101, 6805], [104, 7105]]}, {"verse": 2, "start": 8059, "end": 13753, "text": "Os di a beber leche, y no alimento sólido: porque aún no podíais, ni aun podéis ahora;", "words": [[0, 8059], [3, 8200], [6, 8380], [8, 8460], [14, 8700], [21, 9120], [23, 9480], [26, 9600], [35, 10020], [43, 11003], [50, 11182], [54, 11382], [57, 11562], [66, 12362], [69, 12582], [73, 12782], [80, 13202]]}, {"verse": 3, "start": 14203, "end": 22189, "text": "Porque todavía sois carnales: pues habiendo entre vosotros celos, y contiendas, y divisiones, ¿no sois carnales, y andáis como hombres?", "words": [[0, 14203], [7, 14392], [15, 14792], [20, 15192], [30, 16227], [35, 16354], [44, 16754], [50, 16994], [59, 17494], [66, 17934], [68, 18294], [80, 18654], [82, 18754], [94, 19534], [98, 19954], [103, 20214], [113, 20874], [115, 20994], [122, 21294], [127, 21554]]}, {"verse": 4, "start": 22639, "end": 28903, "text": "Porque diciendo el uno: Yo cierto soy de Pablo; y el otro: Yo de Apolos; ¿no sois carnales?", "words": [[0, 22639], [7, 22833], [16, 23273], [19, 23568], [24, 24107], [27, 24326], [34, 24706], [38, 24826], [41, 24946], [48, 25716], [50, 25836], [53, 25936], [59, 26664], [62, 26807], [65, 27167], [73, 27816], [77, 27955], [82, 28195]]}, {"verse": 5, "start": 29353, "end": 37527, "text": "¿Qué pues es Pablo? ¿y qué es Apolos? Ministros por los cuales habéis creído; y eso según que a cada uno ha concedido el Señor.", "words": [[0, 29353], [5, 29451], [10, 29671], [13, 29931], [20, 30690], [23, 30826], [27, 30946], [30, 31066], [38, 32006], [48, 32525], [52, 32685], [56, 32825], [63, 33045], [70, 33465], [78, 34311], [80, 34460], [84, 34740], [90, 35100], [94, 35360], [96, 35460], [101, 35640], [105, 35940], [108, 36180], [118, 36820], [121, 36960]]}, {"verse": 6, "start": 37977, "end": 41544, "text": "Yo planté, Apolos regó: pero Dios ha dado el crecimiento.", "words": [[0, 38266], [3, 38596], [11, 38926], [18, 39256], [24, 39825], [29, 39962], [34, 40182], [37, 40402], [42, 40582], [45, 40702]]}, {"verse": 7, "start": 41994, "end": 46751, "text": "Así que, ni el que planta es algo, ni el que riega; sino Dios, que da el crecimiento.", "words": [[0, 41994], [4, 42180], [9, 42340], [12, 42480], [15, 42580], [19, 42680], [26, 43060], [29, 43180], [35, 43480], [38, 43760], [41, 43860], [45, 44000], [52, 44897], [57, 45072], [63, 45352], [67, 45592], [70, 45752], [73, 45852]]}, {"verse": 8, "start": 47201, "end": 53636, "text": "Y el que planta y el que riega son una misma cosa; aunque cada uno recibirá su recompensa conforme a su labor.", "words": [[0, 47201], [2, 47325], [5, 47405], [9, 47525], [16, 48065], [18, 48185], [21, 48285], [25, 48405], [31, 48845], [35, 49025], [39, 49225], [45, 49465], [51, 50404], [58, 50590], [63, 50850], [67, 51090], [76, 51650], [79, 51770], [90, 52470], [99, 53030], [101, 53090], [104, 53210]]}, {"verse": 9, "start": 54086, "end": 60235, "text": "Porque nosotros, colaboradores somos de Dios; y vosotros labranza de Dios sois, edificio de Dios sois.", "words": [[0, 54086], [7, 54265], [17, 54545], [31, 55445], [37, 55725], [40, 55985], [46, 56997], [48, 57100], [57, 57500], [66, 58040], [69, 58340], [74, 58640], [80, 58940], [89, 59440], [92, 59723], [97, 60007]]}, {"verse": 10, "start": 60685, "end": 69576, "text": "Conforme a la gracia de Dios que me ha sido dada, yo como perito arquitecto puse el fundamento, y otro edifica encima: pero cada uno vea cómo edifica encima.", "words": [[0, 60685], [9, 61067], [11, 61227], [14, 61287], [21, 61647], [24, 61747], [29, 61927], [33, 62127], [36, 62247], [39, 62327], [44, 62487], [50, 63287], [53, 63387], [58, 63587], [65, 63967], [76, 64567], [81, 64807], [84, 64887], [96, 65687], [98, 65827], [103, 66047], [111, 66447], [119, 67302], [124, 67439], [129, 67699], [133, 67999], [137, 68339], [142, 68579], [150, 69019]]}, {"verse": 11, "start": 70026, "end": 74819, "text": "Porque nadie puede poner otro fundamento que el que está puesto, el cual es Jesucristo.", "words": [[0, 70026], [7, 70227], [13, 70467], [19, 70787], [25, 71127], [30, 71367], [41, 72127], [45, 72227], [48, 72347], [52, 72427], [57, 72627], [65, 73467], [68, 73567], [73, 73787], [76, 74047]]}, {"verse": 12, "start": 75269, "end": 80895, "text": "Y si alguno edifica sobre este fundamento oro, plata, piedras preciosas, madera, heno, hojarasca;", "words": [[0, 75269], [2, 75375], [5, 75495], [12, 75875], [20, 76315], [26, 76595], [31, 76835], [42, 77515], [47, 77875], [54, 78295], [62, 78655], [73, 79335], [81, 79855], [87, 80375]]}, {"verse": 13, "start": 81345, "end": 90953, "text": "La obra de cada uno será manifestada: porque el día la declarará; porque por el fuego será manifestada; y la obra de cada uno cuál sea, el fuego hará la prueba.", "words": [[0, 81345], [3, 81469], [8, 81709], [11, 81849], [16, 82049], [20, 82329], [25, 82549], [38, 83705], [45, 83869], [48, 84049], [52, 84249], [55, 84389], [66, 85383], [73, 85543], [77, 85743], [80, 85863], [86, 86083], [91, 86363], [104, 87484], [106, 87603], [109, 87723], [114, 87963], [117, 88143], [122, 88363], [126, 88703], [131, 88923], [136, 89683], [139, 89763], [145, 90023], [150, 90363], [153, 90443]]}, {"verse": 14, "start": 91403, "end": 95946, "text": "Si permanece la obra de alguno que edificó encima, recibirá recompensa.", "words": [[0, 91403], [3, 91546], [13, 92146], [16, 92306], [21, 92526], [24, 92686], [31, 93106], [35, 93226], [43, 93766], [51, 94626], [60, 95126]]}, {"verse": 15, "start": 