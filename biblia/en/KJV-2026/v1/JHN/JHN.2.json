{"book": "JHN", "chapter": 2, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 169083, "verses": [{"verse": 1, "start": 300, "end": 6000, "text": "And the third day there was a marriage in Cana of Galilee; and the mother of Jesus was there:", "words": [[0, 300], [4, 449], [8, 569], [14, 829], [18, 1229], [24, 1489], [28, 1709], [30, 1829], [39, 2209], [42, 2449], [47, 2949], [50, 3069], [59, 4137], [63, 4267], [67, 4367], [74, 4627], [77, 4847], [83, 5187], [87, 5547]]}, {"verse": 2, "start": 6450, "end": 10155, "text": "And both Jesus was called, and his disciples, to the marriage.", "words": [[0, 6450], [4, 6594], [9, 6854], [15, 7254], [19, 7574], [27, 7994], [31, 8474], [35, 8614], [46, 9134], [49, 9454], [53, 9574]]}, {"verse": 3, "start": 10605, "end": 16168, "text": "And when they wanted wine, the mother of Jesus says to him, They have no wine.", "words": [[0, 10605], [4, 10713], [9, 10853], [14, 11013], [21, 11353], [27, 12293], [31, 12473], [38, 12713], [41, 12933], [47, 13253], [52, 13613], [55, 13853], [60, 14467], [65, 14627], [70, 14867], [73, 15107]]}, {"verse": 4, "start": 16518, "end": 22173, "text": "Jesus says to her, Woman, what have I to do with you? my hour is not yet come.", "words": [[0, 16518], [6, 16758], [11, 17098], [14, 17318], [19, 17922], [26, 18713], [31, 19013], [36, 19213], [38, 19333], [41, 19473], [44, 19633], [49, 19873], [54, 20446], [57, 20589], [62, 20949], [65, 21249], [69, 21449], [73, 21649]]}, {"verse": 5, "start": 22523, "end": 27490, "text": "His mother says to the servants, Whatever he says to you, do it.", "words": [[0, 22523], [4, 22645], [11, 22925], [16, 23305], [19, 23545], [23, 23685], [33, 25344], [42, 25672], [45, 25952], [50, 26152], [53, 26412], [58, 26932], [61, 27112]]}, {"verse": 6, "start": 27840, "end": 36568, "text": "And there were set there six waterpots of stone, after the manner of the purifying of the Jews, containing two or three firkins apiece.", "words": [[0, 2784