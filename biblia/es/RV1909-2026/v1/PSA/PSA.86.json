{"book": "PSA", "chapter": 86, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 117638, "verses": [{"verse": 1, "start": 300, "end": 7233, "text": "Oración de David. INCLINA, oh Jehová, tu oído, y óyeme; porque estoy afligido y necesitado.", "words": [[0, 300], [8, 745], [11, 1005], [18, 1815], [27, 2315], [30, 2815], [38, 3315], [41, 3535], [47, 3995], [49, 4235], [56, 4979], [63, 5227], [69, 5476], [78, 6076], [80, 6236]]}, {"verse": 2, "start": 7233, "end": 13511, "text": "Guarda mi alma, porque soy piadoso: salva tú, oh Dios mío, a tu siervo que en ti, confía.", "words": [[0, 7233], [7, 7693], [10, 7853], [16, 8133], [23, 8453], [27, 8733], [36, 9552], [42, 9972], [46, 10400], [49, 10580], [54, 10760], [59, 11280], [61, 11340], [64, 11480], [71, 11960], [75, 12160], [78, 12340], [82, 12620]]}, {"verse": 3, "start": 13861, "end": 18098, "text": "Ten misericordia de mí, oh Jehová: porque a ti clamo todo el día.", "words": [[0, 13861], [4, 14006], [17, 14826], [20, 14966], [24, 15348], [27, 15731], [35, 16269], [42, 16452], [44, 16732], [47, 16912], [53, 17092], [58, 17372], [61, 17632]]}, {"verse": 4, "start": 18448, "end": 23111, "text": "Alegra el alma de tu siervo: porque a ti, oh Señor, levanto mi alma.", "words": [[0, 18672], [7, 18922], [10, 19062], [15, 19262], [18, 19442], [21, 19562], [29, 20396], [36, 20601], [38, 20761], [42, 20951], [45, 21141], [52, 21521], [60, 22421], [63, 22561]]}, {"verse": 5, "start": 23461, "end": 31493, "text": "Porque tú, Señor, eres bueno y perdonador, y grande en misericordia para con todos los que te invocan.", "words": [[0, 23461], [7, 23685], [11, 23945], [18, 24465], [23, 25205], [29, 25665], [31, 26145], [43, 26905], [45, 27585], [52, 28005], [55, 28185], [68, 29045], [73, 29285], [77, 29565], [83, 29985], [87, 30365], [91, 30525], [94, 30665]]}, {"verse": 6, "start": 31843, "end": 36035, "text": "Escucha, oh Jehová, mi oración, y está atento a la voz de mis ruegos.", "words": [[0, 3