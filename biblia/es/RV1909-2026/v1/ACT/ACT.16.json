{"book": "ACT", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 354041, "verses": [{"verse": 1, "start": 300, "end": 10977, "text": "Después llegó a Derbe, y a Listra: y he aquí, estaba allí un discípulo llamado Timoteo, hijo de una mujer judía fiel, pero de padre griego.", "words": [[0, 300], [8, 729], [14, 1289], [16, 1529], [23, 1989], [25, 2425], [27, 2861], [35, 3472], [37, 3607], [40, 3777], [46, 4177], [53, 4757], [58, 5077], [61, 5237], [71, 5837], [79, 6117], [88, 7437], [93, 7757], [96, 7957], [100, 8097], [106, 8437], [112, 8937], [118, 9717], [123, 9857], [126, 10017], [132, 10277]]}, {"verse": 2, "start": 11327, "end": 16102, "text": "De este daban buen testimonio los hermanos que estaban en Listra y en Iconio.", "words": [[0, 11327], [3, 11512], [8, 11892], [14, 12412], [19, 12652], [30, 13372], [34, 13432], [43, 14052], [47, 14152], [55, 14412], [58, 14632], [65, 15172], [67, 15312], [70, 15452]]}, {"verse": 3, "start": 16452, "end": 28243, "text": "Este quiso Pablo que fuese con él; y tomándole, le circuncidó por causa de los judíos que estaban en aquellos lugares; porque todos sabían que su padre era griego.", "words": [[0, 16572], [5, 16692], [11, 17052], [17, 17632], [21, 17752], [27, 18092], [31, 18352], [35, 19414], [37, 19519], [48, 20259], [51, 20799], [62, 21679], [66, 21939], [72, 22219], [75, 22539], [79, 22659], [86, 23219], [90, 23359], [98, 23719], [101, 23939], [110, 24219], [119, 25430], [126, 25775], [132, 26095], [139, 26635], [143, 26795], [146, 26955], [152, 27275], [156, 27535]]}, {"verse": 4, "start": 28593, "end": 38548, "text": "Y como pasaban por las ciudades, les daban que guardasen los decretos que habían sido determinados por los apóstoles y los ancianos que estaban en Jerusalén.", "words": [[0, 28593], [2, 28713], [7, 28953], [15, 29553], [19, 29773], [23, 29933], [33, 30953], [37, 31373], [43, 31733], [47, 31913], [57, 32573], [61, 32753], [70, 33353], [74, 33473], [81, 33733], [86, 34113], [99, 34913], [103, 35133], [107, 35293], [117, 35953], [119, 36373], [123, 36533], [132, 37113], [136, 37233], [144, 37533], [147, 37693]]}, {"verse": 5, "start": 38898, "end": 45337, "text": "Así que, las iglesias eran fortalecidas en la fe, y eran aumentadas en número cada día.", "words": [[0, 38898], [4, 39091], [9, 39311], [13, 39491], [22, 40071], [27, 40291], [40, 41351], [43, 41571], [46, 41711], [50, 41991], [52, 42471], [57, 42751], [68, 43751], [71, 44051], [78, 44431], [83, 44751]]}, {"verse": 6, "start": 45687, "end": 53611, "text": "Y pasando a Frigia y la provincia de Galacia, les fue prohibido por el Espíritu Santo hablar la palabra en Asia.", "words": [[0, 45687], [2, 45810], [10, 46190], [12, 46530], [19, 47150], [21, 47270], [24, 47410], [34, 48010], [37, 48150], [46, 48910], [50, 49410], [54, 49630], [64, 50390], [68, 50590], [71, 50730], [80, 51330], [86, 51630], [93, 52070], [96, 52430], [104, 52810], [107, 53050]]}, {"verse": 7, "start": 53961, "end": 59592, "text": "Y cuando vinieron a Misia, intentaron ir a Bitinia; pero el Espíritu no les dejó.", "words": [[0, 53961], [2, 54069], [9, 54269], [18, 54829], [20, 55189], [27, 55549], [38, 56709], [41, 56909], [43, 57352], [52, 57953], [57, 58116], [60, 58236], [69, 58796], [72, 58916], [76, 59096]]}, {"verse": 8, "start": 59942, "end": 63089, "text": "Y pasando a Misia, descendieron a Troas.", "words": [[0, 59942], [2, 60047], [10, 60367], [12, 60967], [19, 61567], [32, 62187], [34, 62347]]}, {"verse": 9, "start": 63439, "end": 73406, "text": "Y fue mostrada a Pablo de noche una visión: Un varón macedonio se puso delante, rogándole, y diciendo: Pasa a Macedonia, y ayúdanos.", "words": [[0, 63439], [2, 63545], [6, 63705], [15, 64285], [17, 64565], [23, 64965], [26, 65145], [32, 65425], [36, 65685], [44, 66659], [47, 66804], [53, 67204], [63, 67924], [66, 68104], [71, 68444], [80, 69344], [91, 70204], [93, 70444], [103, 71384], [108, 71627], [110, 71787], [121, 72387], [123, 72647]]}, {"verse": 10, "start": 73686, "end": 84021, "text": "Y cuando vio la visión, luego procuramos partir a Macedonia, dando por cierto que Dios nos llamaba para que les anunciásemos el evangelio.", "words": [[0, 73686], [2, 73792], [9, 73992], [13, 74292], [16, 74412], [24, 75412], [30, 75852], [41, 76632], [48, 77092], [50, 77272], [61, 78472], [67, 78772], [71, 79032], [78, 79332], [82, 79652], [87, 79912], [91, 80312], [99, 80912], [104, 81472], [108, 81652], [112, 81872], [125, 83012], [128, 83172]]}, {"verse": 11, "start": 84370, "end": 91435, "text": "Habiendo partido, pues, de Troas, vinimos camino derecho a Samotracia, y el día siguiente a Neápolis;", "words": [[0, 84370], [9, 84717], [18, 85157], [24, 85537], [27, 86057], [34, 86657], [42, 87397], [49, 87677], [57, 88137], [59, 88667], [71, 89197], [73, 89557], [76, 89717], [80, 89837], [90, 90217], [92, 90577]]}, {"verse": 12, "start": 91785, "end": 101256, "text": "Y de allí a Filipos, que es la primera ciudad de la parte de Macedonia, y una colonia; y estuvimos en aquella ciudad algunos días.", "words": [[0, 91785], [2, 91931], [5, 92011], [10, 92271], [12, 92531], [21, 93571], [25, 93771], [28, 93951], [31, 94191], [39, 94491], [46, 94991], [49, 95311], [52, 95411], [58, 95731], [61, 95931], [72, 96691], [74, 97091], [78, 97291], [87, 98317], [89, 98453], [99, 98993], [102, 99253], [110, 99633], [117, 99993], [125, 100353]]}, {"verse": 13, "start": 101606, "end": 111644, "text": "Y un día de sábado salimos de la puerta junto al río, donde solía hacerse la oración; y sentándonos, hablamos a las mujeres que se habían reunido.", "words": [[0, 101606], [2, 101702], [5, 101822], [9, 102062], [12, 102222], [19, 102722], [27, 103202], [30, 103362], [33, 103482], [40, 103822], [46, 104122], [49, 104462], [54, 104842], [60, 105362], [66, 105962], [74, 106502], [77, 106682], [86, 107711], [88, 108013], [101, 108773], [110, 109493], [112, 109653], [116, 109753], [124, 110093], [128, 110333], [131, 110493], [138, 110773]]}, {"verse": 14, "start": 111994, "end": 126308, "text": "Entonces una mujer llamada Lidia, que vendía púrpura en la ciudad de Tiatira, temerosa de Dios, estaba oyendo; el corazón de la cual abrió el Señor para que estuviese atenta a lo que Pablo decía.", "words": [[0, 111994], [9, 112512], [13, 113192], [19, 113532], [27, 114292], [34, 115052], [38, 115092], [45, 115512], [53, 116372], [56, 116512], [59, 116652], [66, 116992], [69, 117492], [78, 117992], [87, 118672], [90, 118872], [96, 119712], [103, 120032], [111, 121069], [114, 121211], [122, 121651], [125, 121891], [128, 122011], [133, 122191], [139, 122651], [142, 122791], [148, 123091], [153, 123431], [157, 123781], [167, 124131], [174, 124754], [176, 124876], [179, 124996], [183, 125136], [189, 125496]]}, {"verse": 15, "start": 126658, "end": 138053, "text": "Y cuando fue bautizada, y su familia, nos rogó, diciendo: Si habéis juzgado que yo sea fiel al Señor, entrad en mi casa, y alojaos: y nos insistió.", "words": [[0, 126658], [2, 126932], [9, 127152], [13, 127432], [24, 128212], [26, 128412], [29, 128552], [38, 129072], [42, 129592], [48, 130152], [58, 131288], [61, 131527], [68, 131927], [76, 132467], [80, 132707], [83, 132907], [87, 133127], [92, 133507], [95, 133627], [102, 134080], [109, 134534], [112, 134987], [115, 135147], [121, 135527], [123, 135987], [132, 137027], [134, 137154], [138, 137254]]}, {"verse": 16, "start": 138333, "end": 150758, "text": "Y aconteció, que yendo nosotros a la oración, una muchacha que tenía espíritu de adivinación, nos salió al encuentro, la cual daba grande ganancia a sus amos adivinando.", "words": [[0, 138333], [2, 138439], [13, 139219], [17, 139599], [23, 139919], [32, 140319], [34, 140719], [37, 140779], [46, 141879], [50, 142059], [59, 142659], [63, 142839], [69, 143199], [78, 143879], [81, 143979], [94, 144839], [98, 145319], [104, 145899], [107, 146199], [118, 147299], [121, 147399], [126, 147599], [131, 147959], [138, 148339], [147, 149019], [149, 149279], [153, 149379], [158, 149819]]}, {"verse": 17, "start": 151108, "end": 162186, "text": "Esta, siguiendo a Pablo y a nosotros, daba voces, diciendo: Estos hombres son siervos del Dios Alto, los cuales os anuncian el camino de salvación.", "words": [[0, 151108], [6, 151517], [16, 152497], [18, 152677], [24, 153077], [26, 153317], [28, 153397], [38, 154217], [43, 154657], [50, 155257], [60, 156501], [66, 156881], [74, 157261], [78, 157561], [86, 158001], [90, 158221], [95, 158501], [101, 159401], [105, 159501], [112, 159901], [115, 160101], [124, 160761], [127, 160881], [134, 161141], [137, 161341]]}, {"verse": 18, "start": 162466, "end": 174055, "text": "Y esto hacía por muchos días; pero desagradando a Pablo, se volvió y dijo al espíritu: Te mando en el nombre de Jesucristo, que salgas de ella. Y salió en la misma hora.", "words": [[0, 162466], [2, 162622], [7, 162902], [13, 163262], [17, 163502], [24, 163762], [30, 164741], [35, 164907], [48, 165807], [50, 165947], [57, 166827], [60, 166927], [67, 167327], [69, 167407], [74, 167707], [77, 167807], [87, 168719], [90, 168820], [96, 169160], [99, 169260], [102, 169360], [109, 169640], [112, 169780], [124, 170560], [128, 170840], [135, 171280], [138, 171460], [144, 172147], [146, 172298], [152, 172698], [155, 172978], [158, 173118], [164, 173398]]}, {"verse": 19, "start": 174405, "end": 182738, "text": "Y viendo sus amos que se había ido la esperanza de su ganancia, prendieron a Pablo y a Silas, y los trajeron al foro, al magistrado;", "words": [[0, 174405], [2, 174510], [9, 174770], [13, 174990], [18, 175430], [22, 175530], [25, 175670], [31, 175850], [35, 176130], [38, 176310], [48, 176970], [51, 177130], [54, 177310], [64, 177970], [75, 178470], [77, 178650], [83, 178950], [85, 179130], [87, 179250], [94, 179690], [96, 180170], [100, 180290], [109, 180870], [112, 180990], [118, 181770], [121, 181850]]}, {"verse": 20, "start": 183088, "end": 190330, "text": "Y presentándolos a los magistrados, dijeron: Estos hombres, siendo judíos, alborotan nuestra ciudad,", "words": [[0, 183088], [2, 183232], [17, 184572], [19, 184672], [23, 184812], [36, 185952], [45, 186893], [51, 187240], [60, 187600], [67, 187880], [75, 188820], [85, 189400], [93, 189560]]}, {"verse": 21, "start": 190680, "end": 196125, "text": "Y predican ritos, los cuales no nos es lícito recibir ni hacer, pues somos Romanos.", "words": [[0, 190680], [2, 190955], [11, 191265], [18, 192085], [22, 192205], [29, 192485], [32, 192805], [36, 193005], [39, 193165], [46, 193585], [54, 194025], [57, 194345], [64, 195085], [69, 195225], [75, 195525]]}, {"verse": 22, "start": 196405, "end": 204968, "text": "Y se agolpó el pueblo contra ellos: y los magistrados rompiéndoles sus ropas, les mandaron azotar con varas.", "words": [[0, 196405], [2, 196545], [5, 196685], [12, 197365], [15, 197465], [22, 197805], [29, 198285], [36, 199055], [38, 199279], [42, 199399], [54, 200179], [67, 201419], [71, 201659], [78, 202739], [82, 202839], [91, 203459], [98, 204079], [102, 204239]]}, {"verse": 23, "start": 205318, "end": 213872, "text": "Y después que los hubieron herido de muchos azotes, los echaron en la cárcel, mandando al carcelero que los guardase con diligencia:", "words": [[0, 205318], [2, 205423], [10, 205743], [14, 205943], [18, 206063], [27, 206513], [34, 206963], [37, 207103], [44, 207323], [52, 208383], [56, 208783], [64, 209303], [67, 209463], [70, 209603], [78, 210043], [87, 210603], [90, 211163], [100, 211803], [104, 211953], [108, 212103], [117, 212623], [121, 212803]]}, {"verse": 24, "start": 214222, "end": 222370, "text": "El cual, recibido este mandamiento, los metió en la cárcel de más adentro; y les aseguró los pies en el cepo.", "words": [[0, 214222], [3, 214372], [9, 215052], [18, 215752], [23, 215952], [36, 217152], [40, 217372], [46, 217812], [49, 217932], [52, 218052], [59, 218512], [62, 218692], [66, 218872], [75, 219827], [77, 219990], [81, 220210], [89, 220975], [93, 221135], [98, 221375], [101, 221635], [104, 221755]]}, {"verse": 25, "start": 222720, "end": 230139, "text": "Pero a media noche, orando Pablo y Silas, cantaban himnos a Dios: y los que estaban presos los oían.", "words": [[0, 222720], [5, 222884], [7, 223224], [13, 223564], [20, 223904], [27, 224444], [33, 224884], [35, 225124], [42, 225804], [51, 226324], [58, 226764], [60, 226884], [66, 227657], [68, 227767], [72, 227907], [76, 228067], [84, 228367], [91, 229127], [95, 229387]]}, {"verse": 26, "start": 230489, "end": 243124, "text": "Entonces fue hecho de repente un gran terremoto, de tal manera que los cimientos de la cárcel se movían; y luego todas las puertas se abrieron, y las ataduras de todos se soltaron.", "words": [[0, 230489], [9, 231096], [13, 231696], [19, 231996], [22, 232296], [30, 232736], [33, 232916], [38, 233176], [49, 234316], [52, 234436], [56, 234676], [63, 235036], [67, 235276], [71, 235436], [81, 236076], [84, 236236], [87, 236376], [94, 236916], [97, 237336], [105, 238333], [107, 238455], [113, 238695], [119, 239015], [123, 239275], [131, 239715], [134, 239915], [144, 240455], [146, 240855], [150, 241015], [159, 241615], [162, 241755], [168, 242055], [171, 242395]]}, {"verse": 27, "start": 243474, "end": 252704, "text": "Y despertado el carcelero, cuando vio abiertas las puertas de la cárcel, sacando la espada se quería matar, pensando que los presos se habían huido.", "words": [[0, 243474], [2, 243593], [13, 244293], [16, 244413], [27, 245093], [34, 245413], [38, 245833], [47, 246473], [51, 246613], [59, 247053], [62, 247173], [65, 247273], [73, 247993], [81, 248533], [84, 248673], [91, 249073], [94, 249273], [101, 249553], [108, 250253], [117, 250593], [121, 250873], [125, 251013], [132, 251433], [135, 251633], [142, 251933]]}, {"verse": 28, "start": 253054, "end": 259172, "text": "Pero Pablo clamó a gran voz, diciendo: No te hagas ningún mal; que todos estamos aquí.", "words": [[0, 253054], [5, 253358], [11, 253988], [17, 254618], [19, 254718], [24, 254898], [29, 255218], [39, 256317], [42, 256524], [45, 256684], [51, 256964], [58, 257204], [63, 257897], [67, 257997], [73, 258217], [81, 258637]]}, {"verse": 29, "start": 259452, "end": 267943, "text": "Él entonces pidiendo luz, entró dentro, y temblando, se postró a los pies de Pablo y de Silas;", "words": [[0, 259452], [3, 259698], [12, 261058], [21, 261458], [26, 262438], [32, 262898], [40, 263318], [42, 264058], [53, 265118], [56, 265258], [63, 265798], [65, 265998], [69, 266138], [74, 266378], [77, 266538], [83, 266938], [85, 267118], [88, 267298]]}, {"verse": 30, "start": 268293, "end": 272714, "text": "Y sacándolos fuera, les dice: Señores, ¿qué debo hacer para ser salvo?", "words": [[0, 268293], [2, 268582], [13, 268912], [20, 269292], [24, 269632], [30, 270414], [39, 271217], [44, 271277], [49, 271517], [55, 271777], [60, 271987], [64, 272197]]}, {"verse": 31, "start": 272994, "end": 278154, "text": "Y ellos dijeron: Cree en el Señor Jesucristo, y serás salvo tú, y tu casa.", "words": [[0, 272994], [2, 273160], [8, 273340], [17, 274420], [22, 274546], [25, 274673], [28, 274773], [34, 275013], [46, 275773], [48, 276113], [54, 276453], [60, 276953], [64, 277173], [66, 277533], [69, 277633]]}, {"verse": 32, "start": 278434, "end": 282906, "text": "Y le hablaron la palabra del Señor, y a todos los que estaban en su casa.", "words": [[0, 278434], [2, 278595], [5, 278675], [14, 279235], [17, 279395], [25, 279775], [29, 280035], [36, 280415], [38, 280900], [40, 281020], [46, 281220], [50, 281440], [54, 281600], [62, 281900], [65, 282160], [68, 282320]]}, {"verse": 33, "start": 283256, "end": 293097, "text": "Y tomándolos en aquella misma hora de la noche, les lavó las heridas de los azotes; y se bautizó luego él, y todos los suyos.", "words": [[0, 283256], [2, 283567], [13, 284307], [16, 284467], [24, 284887], [30, 285167], [35, 285547], [38, 285707], [41, 285827], [48, 286687], [52, 286947], [57, 287607], [61, 287907], [69, 288467], [72, 288647], [76, 288787], [84, 289921], [86, 290067], [89, 290437], [97, 290807], [103, 290967], [107, 291447], [109, 291987], [115, 292287], [119, 292547]]}, {"verse": 34, "start": 293447, "end": 299754, "text": "Y llevándolos a su casa, les puso la mesa: y se gozó de que con toda su casa había creído a Dios.", "words": [[0, 293447], [2, 293549], [14, 294189], [16, 294289], [19, 294429], [25, 294732], [29, 295034], [34, 295354], [37, 295494], [43, 296209], [45, 296353], [48, 296493], [53, 296953], [56, 297173], [60, 297313], [64, 297553], [69, 297833], [72, 298073], [77, 298393], [83, 298653], [90, 299153], [92, 299313]]}, {"verse": 35, "start": 300104, "end": 307493, "text": "Y como fue de día, los magistrados enviaron los alguaciles, diciendo: Deja ir a aquellos hombres.", "words": [[0, 300104], [2, 300226], [7, 300486], [11, 300786], [14, 300946], [19, 301986], [23, 302206], [35, 303026], [44, 303766], [48, 304266], [60, 304766], [70, 305842], [75, 306127], [78, 306367], [80, 306507], [89, 306747]]}, {"verse": 36, "start": 307773, "end": 316797, "text": "Y el carcelero hizo saber estas palabras a Pablo: Los magistrados han enviado a decir que seáis sueltos: así que ahora salid, e id en paz.", "words": [[0, 307773], [2, 307918], [5, 308078], [15, 308818], [20, 309298], [26, 309793], [32, 310073], [41, 310553], [43, 310833], [50, 311606], [54, 311713], [66, 312393], [70, 312613], [78, 313073], [80, 313173], [86, 313433], [90, 313673], [96, 313993], [105, 314895], [109, 315115], [113, 315295], [119, 315575], [126, 315855], [128, 316055], [131, 316255], [134, 316375]]}, {"verse": 37, "start": 317077, "end": 330371, "text": "Entonces Pablo les dijo: Azotados públicamente sin ser condenados, siendo hombres Romanos, nos echaron en la cárcel; y ¿ahora nos echan encubiertamente? No, de cierto, sino vengan ellos y sáquennos.", "words": [[0, 317077], [9, 317517], [15, 318197], [19, 318537], [25, 319328], [34, 319870], [47, 320610], [51, 320870], [55, 321050], [67, 322070], [74, 322430], [82, 322870], [91, 323770], [95, 323870], [103, 324350], [106, 324490], [109, 324590], [117, 325441], [119, 325561], [126, 325741], [130, 325961], [136, 326261], [153, 327542], [157, 327851], [160, 328197], [168, 328544], [173, 328804], [180, 329224], [186, 329464], [188, 329664]]}, {"verse": 38, "start": 330651, "end": 337650, "text": "Y los alguaciles volvieron a decir a los magistrados estas palabras: y tuvieron miedo, oído que eran Romanos.", "words": [[0, 330651], [2, 330752], [6, 331192], [17, 331632], [27, 332337], [29, 332457], [35, 332757], [37, 332937], [41, 333077], [53, 333837], [59, 334137], [69, 335202], [71, 335307], [80, 335687], [87, 336087], [92, 336507], [96, 336707], [101, 336867]]}, {"verse": 39, "start": 338000, "end": 343950, "text": "Y viniendo, les rogaron; y sacándolos, les pidieron que se saliesen de la ciudad.", "words": [[0, 338000], [2, 338143], [12, 338703], [16, 339203], [25, 340398], [27, 340484], [39, 341144], [43, 341804], [52, 342264], [56, 342404], [59, 342544], [68, 343044], [71, 343204], [74, 343324]]}, {"verse": 40, "start": 344300, "end": 353641, "text": "Entonces salidos de la cárcel, entraron en casa de Lidia; y habiendo visto a los hermanos, los animaron, y se salieron.", "words": [[0, 344300], [9, 345146], [17, 345686], [20, 345846], [23, 345946], [31, 346806], [40, 347666], [43, 347786], [48, 348026], [51, 348266], [58, 349191], [60, 349495], [69, 349835], [75, 350135], [77, 350315], [81, 350435], [91, 351095], [95, 351415], [105, 352115], [107, 352695], [110, 352795]]}]}