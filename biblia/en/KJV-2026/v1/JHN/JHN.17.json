{"book": "JHN", "chapter": 17, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 187638, "verses": [{"verse": 1, "start": 300, "end": 10350, "text": "These words spoke Jesus, and lifted up his eyes to heaven, and said, Father, the hour is come; glorify your Son, that your Son also may glorify you:", "words": [[0, 300], [6, 450], [12, 810], [18, 1230], [25, 1730], [29, 2450], [36, 2750], [39, 2970], [43, 3130], [48, 3410], [51, 3650], [59, 3970], [63, 4410], [69, 5155], [77, 5455], [81, 5635], [86, 5935], [89, 6195], [95, 7004], [103, 7500], [108, 7720], [113, 8120], [118, 8400], [123, 8540], [127, 8860], [132, 9240], [136, 9460], [144, 10000]]}, {"verse": 2, "start": 10800, "end": 17450, "text": "As you have given him power over all flesh, that he should give eternal life to as many as you have given him.", "words": [[0, 10800], [3, 10985], [7, 11125], [12, 11285], [18, 11545], [22, 11745], [28, 12185], [33, 12545], [37, 12825], [44, 13525], [49, 13865], [52, 14005], [59, 14205], [64, 14485], [72, 15025], [77, 15445], [80, 15665], [83, 15865], [88, 16125], [91, 16465], [95, 16625], [100, 16785], [106, 17045]]}, {"verse": 3, "start": 17900, "end": 24423, "text": "And this is life eternal, that they might know you the only true God, and Jesus Christ, whom you have sent.", "words": [[0, 17900], [4, 18058], [9, 18298], [12, 18458], [17, 18758], [26, 19758], [31, 19938], [36, 20118], [42, 20338], [47, 20578], [51, 20798], [55, 20978], [60, 21298], [65, 21618], [70, 22018], [74, 22338], [80, 22658], [88, 23098], [93, 23618], [97, 23818], [102, 23978]]}, {"verse": 4, "start": 24873, "end": 29401, "text": "I have glorified you on the earth: I have finished the work which you gave me to do.", "words": [[0, 24873], [2, 25077], [7, 25197], [17, 25797], [21, 25957], [24, 26117], [28, 26237], [35, 26943], [37, 27106], [42, 27266], [51, 27586], [55, 27826], [60, 28066], [66, 28326], [70, 28486], [75, 28666], [78, 28866], [81, 29006]]}, {"verse": 5, "start": 29851, "end": 36362, "text": "And now, O Father, glorify you me with your own self with the glory which I had with you before the world was.", "words": [[0, 29851], [4, 29972], [9, 30312], [11, 30412], [19, 31192], [27, 31772], [31, 31952], [34, 32092], [39, 32292], [44, 32392], [48, 32632], [53, 33532], [58, 33632], [62, 33752], [68, 34052], [74, 34332], [76, 34472], [80, 34732], [85, 34912], [89, 35092], [96, 35392], [100, 35612], [106, 35872]]}, {"verse": 6, "start": 36812, "end": 45054, "text": "I have manifested your name to the men which you gave me out of the world: yours they were, and you gave them me; and they have kept your word.", "words": [[0, 36812], [2, 36995], [7, 37175], [18, 37655], [23, 37975], [28, 38255], [31, 38455], [35, 38575], [39, 38835], [45, 39095], [49, 39235], [54, 39415], [57, 39695], [61, 39895], [64, 39995], [68, 40115], [75, 40951], [81, 41237], [86, 41497], [92, 42057], [96, 42357], [100, 42497], [105, 42737], [110, 42957], [114, 43717], [118, 43842], [123, 43962], [128, 44102], [133, 44342], [138, 44522]]}, {"verse": 7, "start": 45504, "end": 49576, "text": "Now they have known that all things whatever you have given me are of you.", "words": [[0, 45504], [4, 45847], [9, 46147], [14, 46327], [20, 46587], [25, 46827], [29, 47087], [36, 47487], [45, 47847], [49, 48147], [54, 48267], [60, 48507], [63, 48747], [67, 48967], [70, 49127]]}, {"verse": 8, "start": 50026, "end": 59239, "text": "For I have given to them the words which you gave me; and they have received them, and have known surely that I came out from you, and they have believed that you did send me.", "words": [[0, 50026], [4, 50132], [6, 50292], [11, 50432], [17, 50672], [20, 50892], [25, 51112], [29, 51332], [35, 51672], [41, 51912], [45, 52072], [50, 52272], [54, 53015], [58, 53159], [63, 53319], [68, 53479], [77, 53839], [83, 54519], [87, 54739], [92, 54879], [98, 55079], [105, 55459], [110, 55779], [112, 55899], [117, 56119], [121, 56339], [126, 56559], [131, 57119], [135, 57299], [140, 57479], [145, 57599], [154, 57959], [159, 58259], [163, 58439], [167, 58659], [172, 58919]]}, {"verse": 9, "start": 59689, "end": 65485, "text": "I pray for them: I pray not for the world, but for them which you have given me; for they are yours.", "words": [[0, 59689], [2, 59814], [7, 60034], [11, 60274], [17, 60854], [19, 61017], [24, 61277], [28, 61537], [32, 61777], [36, 61877], [43, 62197], [47, 62457], [51, 62677], [56, 62877], [62, 63117], [66, 63277], [71, 63437], [77, 63677], [81, 64354], [85, 64456], [90, 64656], [94, 64836]]}, {"verse": 10, "start": 65935, "end": 70779, "text": "And all mine are yours, and yours are mine; and I am glorified in them.", "words": [[0, 65935], [4, 66060], [8, 66320], [13, 66660], [17, 66940], [24, 67600], [28, 67700], [34, 68000], [38, 68300], [44, 69211], [48, 69356], [50, 69556], [53, 69676], [63, 70196], [66, 70436]]}, {"verse": 11, "start": 71229, "end": 81845, "text": "And now I am no more in the world, but these are in the world, and I come to you. Holy Father, keep through your own name those whom you have given me, that they may be one, as we are.", "words": [[0, 71229], [4, 71376], [8, 71636], [10, 71936], [13, 72056], [16, 72256], [21, 72556], [24, 72696], [28, 72796], [35, 73396], [39, 73576], [45, 73856], [49, 74096], [52, 74236], [56, 74316], [63, 74876], [67, 74976], [69, 75116], [74, 75356], [77, 75576], [82, 76129], [87, 76385], [95, 76805], [100, 77085], [108, 77345], [113, 77525], [117, 77805], [122, 78165], [128, 78485], [133, 78745], [137, 78885], [142, 79025], [148, 79245], [152, 79785], [157, 79985], [162, 80185], [166, 80385], [169, 80565], [174, 80865], [177, 81245], [180, 81465]]}, {"verse": 12, "start": 82295, "end": 93004, "text": "While I was with them in the world, I kept them in your name: those that you gave me I have kept, and none of them is lost, but the son of perdition; that the scripture might be fulfilled.", "words": [[0, 82295], [6, 82456], [8, 82656], [12, 82816], [17, 83076], [22, 83216], [25, 83336], [29, 83436], [36, 84096], [38, 84276], [43, 84536], [48, 84776], [51, 84916], [56, 85056], [62, 85868], [68, 86110], [73, 86370], [77, 86550], [82, 86790], [85, 87030], [87, 87209], [92, 87370], [98, 88050], [102, 88130], [107, 88330], [110, 88489], [115, 88630], [118, 88810], [124, 89430], [128, 89670], [132, 89810], [136, 90130], [139, 90410], [150, 91420], [155, 91517], [159, 91657], [169, 91937], [175, 92217], [178, 92397]]}, {"verse": 13, "start": 93454, "end": 99377, "text": "And now come I to you; and these things I speak in the world, that they might have my joy fulfilled in themselves.", "words": [[0, 93454], [4, 93573], [8, 93753], [13, 94013], [15, 94193], [18, 94393], [23, 94998], [27, 95121], [33, 95341], [40, 95601], [42, 95781], [48, 96021], [51, 96201], [55, 96301], [62, 96641], [67, 97081], [72, 97221], [78, 97401], [83, 97581], [86, 97741], [90, 97961], [100, 98401], [103, 98621]]}, {"verse": 14, "start": 99827, "end": 107438, "text": "I have given them your word; and the world has hated them, because they are not of the world, even as I am not of the world.", "words": [[0, 99827], [2, 99994], [7, 100154], [13, 100434], [18, 100674], [23, 100834], [29, 101716], [33, 101824], [37, 101944], [43, 102244], [47, 102464], [53, 102824], [59, 103124], [67, 103664], [72, 103964], [76, 104084], [80, 104324], [83, 104484], [87, 104604], [94, 105164], [99, 105524], [102, 105784], [104, 106204], [107, 106444], [111, 106704], [114, 106844], [118, 106984]]}, {"verse": 15, "start": 107888, "end": 112661, "text": "I pray not that you should take them out of the world, but that you should keep them from the evil.", "words": [[0, 107888], [2, 108049], [7, 108369], [11, 108689], [16, 108909], [20, 109069], [27, 109249], [32, 109489], [37, 109689], [41, 109849], [44, 109949], [48, 110049], [55, 110609], [59, 110969], [64, 111109], [68, 111269], [75, 111429], [80, 111649], [85, 111849], [90, 112049], [94, 112209]]}, {"verse": 16, "start": 113111, "end": 116358, "text": "They are not of the world, even as I am not of the world.", "words": [[0, 113111], [5, 113311], [9, 113451], [13, 113711], [16, 113911], [20, 114031], [27, 114511], [32, 114811], [35, 115031], [37, 115271], [40, 115411], [44, 115631], [47, 115811], [51, 115911]]}, {"verse": 17, "start": 116808, "end": 119871, "text": "Sanctify them through your truth: your word is truth.", "words": [[0, 116808], [9, 117393], [14, 117613], [22, 117833], [27, 117993], [34, 118797], [39, 118941], [44, 119221], [47, 119401]]}, {"verse": 18, "start": 120321, "end": 124175, "text": "As you have sent me into the world, even so have I also sent them into the world.", "words": [[0, 120321], [3, 120485], [7, 120605], [12, 120725], [17, 120925], [20, 121105], [25, 121245], [29, 121365], [36, 121865], [41, 122025], [44, 122325], [49, 122505], [51, 122625], [56, 122945], [61, 123265], [66, 123445], [71, 123605], [75, 123725]]}, {"verse": 19, "start": 124625, "end": 129120, "text": "And for their sakes I sanctify myself, that they also might be sanctified through the truth.", "words": [[0, 124625], [4, 124730], [8, 124850], [14, 124990], [20, 125350], [22, 125490], [31, 125990], [39, 126750], [44, 126890], [49, 127010], [54, 127370], [60, 127590], [63, 127730], [74, 128350], [82, 128550], [86, 128670]]}, {"verse": 20, "start": 129570, "end": 134357, "text": "Neither pray I for these alone, but for them also which shall believe on me through their word;", "words": [[0, 129570], [8, 129773], [13, 130093], [15, 130313], [19, 130473], [25, 130633], [32, 131413], [36, 131533], [40, 131693], [45, 131813], [50, 132173], [56, 132453], [62, 132693], [70, 132993], [73, 133193], [76, 133413], [84, 133653], [90, 133853]]}, {"verse": 21, "start": 134807, "end": 144659, "text": "That they all may be one; as you, Father, are in me, and I in you, that they also may be one in us: that the world may believe that you have sent me.", "words": [[0, 134807], [5, 134914], [10, 135074], [14, 135334], [18, 135574], [21, 135734], [26, 136513], [29, 136711], [34, 136931], [42, 137671], [46, 137851], [49, 138071], [53, 138291], [57, 138751], [59, 139131], [62, 139431], [67, 140091], [72, 140331], [77, 140471], [82, 140771], [86, 141011], [89, 141151], [93, 141411], [96, 141691], [100, 142461], [105, 142561], [109, 142661], [115, 142921], [119, 143101], [127, 143561], [132, 143781], [136, 143941], [141, 144081], [146, 144341]]}, {"verse": 22, "start": 145109, "end": 150846, "text": "And the glory which you gave me I have given them; that they may be one, even as we are one:", "words": [[0, 145109], [4, 145216], [8, 145336], [14, 145656], [20, 145916], [24, 146076], [29, 146296], [32, 146876], [34, 147056], [39, 147236], [45, 147496], [51, 148246], [56, 148346], [61, 148506], [65, 148686], [68, 148846], [73, 149546], [78, 149746], [81, 149986], [84, 150186], [88, 150366]]}, {"verse": 23, "start": 151296, "end": 160762, "text": "I in them, and you in me, that they may be made perfect in one; and that the world may know that you have sent me, and have loved them, as you have loved me.", "words": [[0, 151296], [2, 151622], [5, 151922], [11, 152222], [15, 152642], [19, 152962], [22, 153282], [26, 153882], [31, 154142], [36, 154322], [40, 154482], [43, 154622], [48, 154842], [56, 155222], [59, 155482], [64, 156234], [68, 156356], [73, 156496], [77, 156636], [83, 156916], [87, 157136], [92, 157416], [97, 157636], [101, 157796], [106, 157956], [111, 158216], [115, 158436], [119, 158796], [124, 158956], [130, 159196], [136, 159456], [139, 159796], [143, 160016], [148, 160176], [154, 160376]]}, {"verse": 24, "start": 161212, "end": 172362, "text": "Father, I will that they also, whom you have given me, be with me where I am; that they may behold my glory, which you have given me: for you loved me before the foundation of the world.", "words": [[0, 161212], [8, 161466], [10, 161806], [15, 162066], [20, 162366], [25, 162526], [31, 163486], [36, 163646], [40, 163886], [45, 164046], [51, 164306], [55, 164926], [58, 165026], [63, 165266], [66, 165466], [72, 165726], [74, 166006], [78, 166678], [83, 166780], [88, 166940], [92, 167120], [99, 167440], [102, 167720], [109, 168160], [115, 168600], [119, 168780], [124, 168940], [130, 169180], [134, 169891], [138, 169951], [142, 170071], [148, 170331], [151, 170571], [158, 170871], [162, 171031], [173, 171531], [176, 171751], [180, 171831]]}, {"verse": 25, "start": 172812, "end": 178853, "text": "O righteous Father, the world has not known you: but I have known you, and these have known that you have sent me.", "words": [[0, 172812], [2, 172936], [12, 173236], [20, 174036], [24, 174136], [30, 174396], [34, 174596], [38, 174816], [44, 175036], [49, 175727], [53, 175888], [55, 176028], [60, 176268], [66, 176488], [71, 177088], [75, 177208], [81, 177368], [86, 177568], [92, 177788], [97, 178028], [101, 178188], [106, 178288], [111, 178508]]}, {"verse": 26, "start": 179303, "end": 187238, "text": "And I have declared to them your name, and will declare it: that the love with which you have loved me may be in them, and I in them.", "words": [[0, 179303], [4, 179428], [6, 179628], [11, 179788], [20, 180168], [23, 180428], [28, 180608], [33, 180788], [39, 181148], [43, 181648], [48, 181868], [56, 182268], [60, 182987], [65, 183090], [69, 183230], [74, 183550], [79, 183750], [85, 183990], [89, 184170], [94, 184310], [100, 184590], [103, 184870], [107, 185170], [110, 185370], [113, 185650], [119, 186130], [123, 186370], [125, 186630], [128, 186870]]}]}