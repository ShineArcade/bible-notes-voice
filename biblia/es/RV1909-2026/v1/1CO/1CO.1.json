{"book": "1CO", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 209535, "verses": [{"verse": 1, "start": 300, "end": 5303, "text": "Pablo, llamado a ser apóstol de Jesucristo por la voluntad de Dios, y Sóstenes el hermano,", "words": [[0, 300], [7, 560], [15, 860], [17, 1100], [21, 1240], [29, 1800], [32, 1900], [43, 2560], [47, 2780], [50, 2900], [59, 3420], [62, 3520], [68, 3820], [70, 4035], [79, 4655], [82, 4755]]}, {"verse": 2, "start": 5653, "end": 16868, "text": "A la iglesia de Dios que está en Corinto, santificados en Cristo Jesús, llamados santos, y a todos los que invocan el nombre de nuestro Señor Jesucristo en cualquier lugar, Señor de ellos y nuestro:", "words": [[0, 5653], [2, 5753], [5, 5813], [13, 6153], [16, 6273], [21, 6513], [25, 6693], [30, 6873], [33, 6993], [42, 7833], [55, 8593], [58, 8773], [65, 8993], [72, 9513], [81, 10033], [89, 10973], [91, 11133], [93, 11213], [99, 11353], [103, 11573], [107, 11713], [115, 12193], [118, 12293], [125, 12593], [128, 12773], [136, 12953], [142, 13313], [153, 14093], [156, 14213], [166, 14413], [173, 15260], [179, 15599], [182, 15839], [188, 16059], [190, 16259]]}, {"verse": 3, "start": 17218, "end": 20831, "text": "Gracia y paz de Dios nuestro Padre, y del Señor Jesucristo.", "words": [[0, 17218], [7, 17657], [9, 17757], [13, 17957], [16, 18157], [21, 18317], [29, 18577], [36, 19397], [38, 19517], [42, 19677], [48, 19917]]}, {"verse": 4, "start": 21181, "end": 26639, "text": "Gracias doy a mi Dios siempre por vosotros, por la gracia de Dios que os es dada en Cristo Jesús;", "words": [[0, 21181], [8, 21539], [12, 21919], [14, 21979], [17, 22059], [22, 22279], [30, 22639], [34, 22899], [44, 23819], [48, 23919], [51, 24059], [58, 24479], [61, 24599], [66, 24839], [70, 25099], [73, 25259], [76, 25399], [81, 25639], [84, 25779], [91, 26079]]}, {"verse": 5, "start": 26989, "end": 32449, "text": "Que en todas las cosas sois enriquecidos en él, en toda lengua y en todo conocimiento;", "words": [[0, 26989], [4, 27104], [7, 27224], [13, 27404], [17, 27744], [23, 28144], [28, 28584], [41, 29244], [44, 29504], [48, 30184], [51, 30304], [56, 30504], [63, 31044], [65, 31164], [68, 31284], [73, 31504]]}, {"verse": 6, "start": 32799, "end": 36483, "text": "Así como el testimonio de Cristo ha sido confirmado en vosotros:", "words": [[0, 32799], [4, 33061], [9, 33321], [12, 33481], [23, 34141], [26, 34241], [33, 34661], [36, 34921], [41, 35101], [52, 35721], [55, 35821]]}, {"verse": 7, "start": 36833, "end": 42847, "text": "De tal manera que nada os falte en ningún don, esperando la manifestación de nuestro Señor Jesucristo:", "words": [[0, 36833], [3, 36972], [7, 37132], [14, 37452], [18, 37692], [23, 37912], [26, 38152], [32, 38362], [35, 38572], [42, 38852], [47, 39732], [57, 40152], [60, 40432], [74, 41192], [77, 41332], [85, 41512], [91, 41932]]}, {"verse": 8, "start": 43197, "end": 49156, "text": "El cual también os confirmará hasta el fin, para que seáis sin falta en el día de nuestro Señor Jesucristo.", "words": [[0, 43197], [3, 43316], [8, 43536], [16, 43916], [19, 44196], [30, 44816], [36, 45056], [39, 45196], [44, 45456], [49, 45896], [53, 46036], [59, 46416], [63, 46616], [69, 46956], [72, 47176], [75, 47296], [79, 47516], [82, 47656], [90, 47816], [96, 48236]]}, {"verse": 9, "start": 49506, "end": 55065, "text": "Fiel es Dios, por el cual sois llamados a la participación de su Hijo Jesucristo nuestro Señor.", "words": [[0, 49506], [5, 49787], [8, 49907], [14, 50147], [18, 50447], [21, 50567], [26, 50787], [31, 51167], [40, 51667], [42, 51807], [45, 51887], [59, 52847], [62, 53007], [65, 53207], [70, 53447], [81, 54147], [89, 54307]]}, {"verse": 10, "start": 55415, "end": 68337, "text": "Os ruego pues, hermanos, por el nombre de nuestro Señor Jesucristo, que habléis todos una misma cosa, y que no haya entre vosotros divisiones, antes seáis perfectamente unidos en una misma mente y en un mismo parecer.", "words": [[0, 55415], [3, 55570], [9, 55970], [15, 56390], [25, 57170], [29, 57290], [32, 57390], [39, 57650], [42, 57810], [50, 58030], [56, 58390], [68, 59610], [72, 59690], [80, 60070], [86, 60250], [90, 60590], [96, 60790], [102, 61250], [104, 61425], [108, 61545], [111, 61725], [116, 61945], [122, 62165], [131, 62645], [143, 63812], [149, 64078], [155, 64558], [169, 65338], [176, 65778], [179, 66098], [183, 66238], [189, 66498], [195, 66938], [197, 67118], [200, 67218], [203, 67318], [209, 67598]]}, {"verse": 11, "start": 68687, "end": 74906, "text": "Porque me ha sido declarado de vosotros, hermanos míos, por los que son de Cloé, que hay entre vosotros contiendas;", "words": [[0, 68687], [7, 68852], [10, 69012], [13, 69092], [18, 69312], [28, 69912], [31, 70052], [41, 70732], [50, 71212], [56, 71932], [60, 72032], [64, 72152], [68, 72252], [72, 72412], [75, 72782], [81, 73152], [85, 73272], [89, 73412], [95, 73632], [104, 74297]]}, {"verse": 12, "start": 75256, "end": 83107, "text": "Quiero decir, que cada uno de vosotros dice: Yo cierto soy de Pablo; pues yo de Apolos; y yo de Cefas; y yo de Cristo.", "words": [[0, 75256], [7, 75465], [14, 75865], [18, 76125], [23, 76365], [27, 76645], [30, 76805], [39, 77245], [45, 78046], [48, 78313], [55, 78793], [59, 78933], [62, 79093], [69, 79828], [74, 79934], [77, 80174], [80, 80314], [88, 81159], [90, 81300], [93, 81420], [96, 81785], [103, 82370], [105, 82517], [108, 82637], [111, 82757]]}, {"verse": 13, "start": 83457, "end": 90477, "text": "¿Está dividido Cristo? ¿fue crucificado Pablo por vosotros? ¿o habéis sido bautizados en el nombre de Pablo?", "words": [[0, 83457], [6, 84098], [15, 84598], [23, 85429], [28, 85556], [40, 86316], [46, 86636], [50, 86896], [60, 87776], [63, 87878], [70, 88198], [75, 88418], [86, 89138], [89, 89338], [92, 89438], [99, 89718], [102, 89898]]}, {"verse": 14, "start": 90827, "end": 95557, "text": "Doy gracias a Dios, que a ninguno de vosotros he bautizado, sino a Crispo y a Gayo;", "words": [[0, 90827], [4, 91047], [12, 91267], [14, 91547], [20, 91747], [24, 92047], [26, 92127], [34, 92567], [37, 92647], [46, 93107], [49, 93307], [60, 94267], [65, 94407], [67, 94567], [74, 94947], [76, 95087], [78, 95187]]}, {"verse": 15, "start": 95907, "end": 98955, "text": "Para que ninguno diga que habéis sido bautizados en mi nombre.", "words": [[0, 95907], [5, 96047], [9, 96187], [17, 96607], [22, 96947], [26, 97047], [33, 97387], [38, 97567], [49, 98147], [52, 98367], [55, 98487]]}, {"verse": 16, "start": 99305, "end": 103905, "text": "Y también bauticé la familia de Estéfanas: pero no sé si he bautizado algún otro.", "words": [[0, 99305], [2, 99412], [10, 99672], [18, 100192], [21, 100332], [29, 100692], [32, 100852], [43, 101863], [48, 102005], [51, 102165], [54, 102385], [57, 102585], [60, 102665], [70, 103105], [76, 103445]]}, {"verse": 17, "start": 104255, "end": 112787, "text": "Porque no me envió Cristo a bautizar, sino a predicar el evangelio: no en sabiduría de palabras, porque no sea hecha vana la cruz de Cristo.", "words": [[0, 104255], [7, 104475], [10, 104635], [13, 104775], [19, 105095], [26, 105455], [28, 105865], [38, 106275], [43, 106775], [45, 106915], [54, 107395], [57, 107575], [68, 108510], [71, 108671], [74, 108811], [84, 109451], [87, 109571], [97, 110291], [104, 110491], [107, 110796], [111, 111101], [117, 111406], [122, 111711], [125, 111811], [130, 112131], [133, 112231]]}, {"verse": 18, "start": 113137, "end": 120740, "text": "Porque la palabra de la cruz es locura a los que se pierden; pero a los que se salvan, es decir, a nosotros, es poder de Dios.", "words": [[0, 113137], [7, 113297], [10, 113457], [18, 113837], [21, 114017], [24, 114137], [29, 114597], [32, 114757], [39, 115317], [41, 115477], [45, 115597], [49, 115717], [52, 115857], [61, 116751], [66, 116870], [68, 116990], [72, 117110], [76, 117230], [79, 117350], [87, 117870], [90, 118070], [97, 118470], [99, 118770], [109, 119590], [112, 119730], [118, 120010], [121, 120250]]}, {"verse": 19, "start": 121090, "end": 127307, "text": "Porque está escrito: Destruiré la sabiduría de los sabios, y desecharé la inteligencia de los entendidos.", "words": [[0, 121090], [7, 121266], [12, 121486], [21, 122368], [31, 122950], [34, 123030], [44, 123670], [47, 123770], [51, 123910], [59, 124530], [61, 124750], [71, 125310], [74, 125450], [87, 126170], [90, 126290], [94, 126410]]}, {"verse": 20, "start": 127657, "end": 135859, "text": "¿Dónde está el sabio? ¿Dónde está el escriba? ¿Dónde está el que debate en esta época? ¿No ha enloquecido Dios la sabiduría del mundo?", "words": [[0, 127657], [7, 127974], [12, 128214], [15, 128334], [22, 129143], [29, 129442], [34, 129702], [37, 129862], [46, 130705], [53, 131023], [58, 131243], [61, 131363], [65, 131503], [72, 131843], [75, 132043], [80, 132283], [87, 133131], [91, 133293], [94, 133473], [106, 134173], [111, 134433], [114, 134653], [124, 135233], [128, 135353]]}, {"verse": 21, "start": 136209, "end": 145690, "text": "Porque, en la sabiduría de Dios, el mundo no conoció a Dios mediante la sabiduría, agradó a Dios salvar a los creyentes por la locura de la predicación.", "words": [[0, 136209], [8, 136469], [11, 136649], [14, 136709], [24, 137349], [27, 137469], [33, 138209], [36, 138309], [42, 138589], [45, 138829], [53, 139309], [55, 139449], [60, 139649], [69, 140209], [72, 140329], [83, 141369], [90, 141849], [92, 142049], [97, 142229], [104, 142709], [106, 142869], [110, 143029], [120, 143609], [124, 143909], [127, 144049], [134, 144469], [137, 144589], [140, 144709]]}, {"verse": 22, "start": 146040, "end": 149601, "text": "Porque los judíos piden señales, y los griegos buscan sabiduría:", "words": [[0, 146040], [7, 146200], [11, 146380], [18, 146780], [24, 147100], [33, 147780], [35, 147900], [39, 148040], [47, 148420], [54, 148820]]}, {"verse": 23, "start": 149951, "end": 156263, "text": "Pero nosotros predicamos a Cristo crucificado, a los judíos ciertamente tropezadero, y a los Gentiles locura;", "words": [[0, 149951], [5, 150094], [14, 150474], [25, 151174], [27, 151354], [34, 151554], [47, 152774], [49, 152834], [53, 152954], [60, 153374], [72, 153974], [85, 154734], [87, 155094], [89, 155174], [93, 155274], [102, 155694]]}, {"verse": 24, "start": 156613, "end": 162612, "text": "Pero a los llamados, así judíos como griegos, Cristo poder de Dios, y sabiduría de Dios.", "words": [[0, 156613], [5, 156750], [7, 156910], [11, 157010], [21, 157850], [25, 158130], [32, 158650], [37, 158870], [46, 159750], [53, 160070], [59, 160430], [62, 160650], [68, 160950], [70, 161390], [80, 161970], [83, 162090]]}, {"verse": 25, "start": 162962, "end": 169245, "text": "Porque lo loco de Dios es más sabio que los hombres; y la debilidad de Dios es más fuerte que los hombres.", "words": [[0, 162962], [7, 163162], [10, 163322], [15, 163602], [18, 163762], [23, 164002], [26, 164382], [30, 164582], [36, 164982], [40, 165102], [44, 165262], [53, 166150], [55, 166272], [58, 166372], [68, 166912], [71, 167092], [76, 167372], [79, 167712], [83, 167852], [90, 168252], [94, 168452], [98, 168592]]}, {"verse": 26, "start": 169595, "end": 177272, "text": "Porque mirad, hermanos, vuestro llamamiento, que no sois muchos sabios según la carne, no muchos poderosos, no muchos nobles;", "words": [[0, 169595], [7, 169802], [14, 170162], [24, 170822], [32, 171442], [45, 172562], [49, 172642], [52, 172802], [57, 173122], [64, 173362], [71, 173902], [77, 174122], [80, 174322], [87, 175022], [90, 175102], [97, 175402], [108, 176382], [111, 176462], [118, 176782]]}, {"verse": 27, "start": 177622, "end": 185425, "text": "Antes lo necio del mundo escogió Dios, para avergonzar a los sabios; y lo débil del mundo escogió Dios, para avergonzar lo fuerte;", "words": [[0, 177622], [6, 178027], [9, 178127], [15, 178467], [19, 178587], [25, 178887], [33, 179427], [39, 179667], [44, 180052], [55, 180652], [57, 180752], [61, 180892], [69, 181794], [71, 181897], [74, 182017], [80, 182337], [84, 182497], [90, 182757], [98, 183277], [104, 183557], [109, 183984], [120, 184410], [123, 184837]]}, {"verse": 28, "start": 185775, "end": 191735, "text": "Y lo de origen humilde del mundo y lo menospreciado escogió Dios, y lo que no es, para deshacer lo que es:", "words": [[0, 185775], [2, 185895], [5, 186015], [8, 186135], [15, 186495], [23, 186815], [27, 187015], [33, 187295], [35, 187435], [38, 187555], [52, 188315], [60, 188815], [66, 189595], [68, 189675], [71, 189815], [75, 189935], [78, 190135], [82, 190395], [87, 190675], [96, 191255], [99, 191415], [103, 191555]]}, {"verse": 29, "start": 192085, "end": 195188, "text": "Para que ninguna carne se jacte en su presencia.", "words": [[0, 192085], [5, 192228], [9, 192388], [17, 192688], [23, 193088], [26, 193378], [32, 193668], [35, 193708], [38, 193848]]}, {"verse": 30, "start": 195538, "end": 204311, "text": "Pero de él sois vosotros en Cristo Jesús, el cual nos ha sido hecho por Dios sabiduría, y justificación, y santificación, y redención:", "words": [[0, 195538], [5, 195695], [8, 195855], [11, 196055], [16, 196375], [25, 196875], [28, 197115], [35, 197435], [42, 198355], [45, 198415], [50, 198635], [54, 198875], [57, 199035], [62, 199295], [68, 199575], [72, 199795], [77, 200015], [88, 200815], [90, 201155], [105, 202095], [107, 202455], [122, 203275], [124, 203575]]}, {"verse": 31, "start": 204661, "end": 209135, "text": "Para que, como está escrito: El que se gloría, gloríese en el Señor.", "words": [[0, 204661], [5, 204844], [10, 205184], [15, 205344], [20, 205584], [29, 206437], [32, 206577], [36, 206717], [39, 206857], [47, 207637], [56, 208257], [59, 208477], [62, 208617]]}]}