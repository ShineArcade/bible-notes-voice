{"book": "PSA", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 118597, "verses": [{"verse": 1, "start": 300, "end": 12652, "text": "Sigaión de David, que cantó a Jehová sobre las palabras de Cus, hijo de Benjamín. JEHOVÁ Dios mío, en ti he confiado: sálvame de todos los que me persiguen, y líbrame;", "words": [[0, 594], [8, 924], [11, 1064], [18, 1564], [22, 1664], [28, 2204], [30, 2324], [37, 2764], [43, 3024], [47, 3224], [56, 3604], [59, 3844], [64, 4724], [69, 4944], [72, 5124], [82, 5984], [89, 6782], [94, 6942], [99, 7622], [102, 7682], [105, 7922], [108, 8142], [118, 9244], [126, 9790], [129, 9970], [135, 10250], [139, 10510], [143, 10690], [146, 10830], [157, 11490], [159, 11970]]}, {"verse": 2, "start": 13002, "end": 18449, "text": "No sea que arrebate mi alma, cual león que despedaza, sin que haya quien libre.", "words": [[0, 13002], [3, 13130], [7, 13350], [11, 13710], [20, 14070], [23, 14310], [29, 14830], [34, 14930], [39, 15530], [43, 15690], [54, 16810], [58, 17070], [62, 17310], [67, 17530], [73, 17770]]}, {"verse": 3, "start": 18799, "end": 23896, "text": "Jehová Dios mío, si yo he hecho esto, si hay en mis manos iniquidad;", "words": [[0, 19015], [7, 19275], [12, 19535], [17, 20235], [20, 20395], [23, 20675], [26, 20795], [32, 21015], [38, 21715], [41, 21875], [45, 22075], [48, 22255], [52, 22395], [58, 22755]]}, {"verse": 4, "start": 24246, "end": 30572, "text": "Si di mal pago al pacífico conmigo, (hasta he libertado al que sin causa era mi enemigo;)", "words": [[0, 24246], [3, 24437], [6, 24597], [10, 24837], [15, 25297], [18, 25417], [27, 26057], [36, 27197], [43, 27537], [46, 27877], [56, 28437], [59, 28557], [63, 28677], [67, 28877], [73, 29237], [77, 29557], [80, 29777]]}, {"verse": 5, "start": 30922, "end": 39127, "text": "Persiga el enemigo mi alma, y la alcance; y pise en tierra mi vida, y mi honra ponga en el polvo. (Selah.)", "words": [[0, 30922], [8, 31467], [11, 31647], [19, 32127],