344], [70, 359704], [74, 360204], [79, 361423], [86, 362103], [90, 362183], [94, 362443], [97, 362543], [104, 363103], [109, 363203], [115, 363523], [118, 363723]]}, {"verse": 48, "start": 364312, "end": 371335, "text": "And many charged him that he should keep silent: but he cried the more a great deal, You Son of David, have mercy on me.", "words": [[0, 364312], [4, 364471], [9, 364691], [17, 365051], [21, 365371], [26, 365591], [29, 365711], [36, 365851], [41, 366051], [49, 367052], [53, 367367], [56, 367487], [62, 367807], [66, 368007], [71, 368227], [73, 368387], [79, 368607], [85, 369347], [89, 369447], [93, 369727], [96, 369847], [103, 370427], [108, 370507], [114, 370887], [117, 371107]]}, {"verse": 49, "start": 371685, "end": 380890, "text": "And Jesus stood still, and commanded him to be called. And they call the blind man, saying to him, Be of good comfort, rise; he calls you.", "words": [[0, 371685], [4, 371815], [10, 372055], [16, 372495], [23, 372955], [27, 373555], [37, 374035], [41, 374315], [44, 374455], [47, 374595], [55, 375436], [59, 375561], [64, 375681], [69, 375941], [73, 376101], [79, 376461], [84, 377141], [91, 377361], [94, 377581], [99, 378211], [102, 378347], [105, 378567], [110, 378787], [119, 379367], [125, 380150], [128, 380232], [134, 380492]]}, {"verse": 50, "start": 381240, "end": 385482, "text": "And he, casting away his garment, rose, and came to Jesus.", "words": [[0, 381240], [4, 381387], [8, 381507], [16, 381947], [21, 382267], [25, 382587], [34, 383007], [40, 383827], [44, 384347], [49, 384627], [52, 384827]]}, {"verse": 51, "start": 385932, "end": 395782, "text": "And Jesus answered and said to him, What will you that I should do to you? The blind man said to him, Lord, that I might receive my sight.", "words": [[0, 385932], [4, 386242], [10, 386602], [19, 387202], [23, 387582], [28, 387862], [31, 388062], [36, 388618], [41, 388763], [46, 388923], [50, 389163], [55, 389403], [57, 389523], [64, 389703], [67, 389903], [70, 3900