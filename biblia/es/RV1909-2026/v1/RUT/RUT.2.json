{"book": "RUT", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 247458, "verses": [{"verse": 1, "start": 300, "end": 8729, "text": "Y tenía Noemí un pariente de su marido, hombre rico, de la familia de Elimelec, el cual se llamaba Booz.", "words": [[0, 300], [2, 565], [8, 865], [14, 1545], [17, 1805], [26, 2405], [29, 2625], [32, 2805], [40, 3325], [47, 3805], [53, 4685], [56, 4965], [59, 5085], [67, 5525], [70, 6265], [80, 7005], [83, 7105], [88, 7285], [91, 7525], [99, 8154]]}, {"verse": 2, "start": 9079, "end": 21434, "text": "Y Ruth la moabita dijo a Noemí: Te ruego que me dejes ir al campo, y recogeré espigas en pos de aquel a cuyos ojos halle gracia. Y ella le respondió: Ve, hija mía.", "words": [[0, 9079], [2, 9208], [7, 9828], [10, 10268], [18, 10708], [23, 11013], [25, 11318], [32, 11783], [35, 11883], [41, 12203], [45, 12403], [48, 12543], [54, 12883], [57, 13103], [60, 13243], [67, 13723], [69, 13918], [78, 14538], [86, 15018], [89, 15158], [93, 15418], [96, 15658], [102, 16078], [104, 16218], [110, 16598], [115, 16898], [121, 17198], [129, 18223], [131, 18413], [136, 18713], [139, 18913], [150, 20433], [154, 20793], [159, 21152]]}, {"verse": 3, "start": 21714, "end": 33545, "text": "fue pues, y llegando, espigó en el campo en pos de los segadores: y aconteció que aquella parte del campo era de Booz, el cual era de la familia de Elimelec.", "words": [[0, 21714], [4, 21954], [10, 22254], [12, 22694], [22, 23694], [29, 24234], [32, 24334], [35, 24434], [41, 24874], [44, 25134], [48, 25454], [51, 26014], [55, 26559], [66, 27268], [68, 27366], [78, 28006], [82, 28186], [90, 28486], [96, 28806], [100, 29106], [106, 29446], [110, 29786], [113, 30346], [119, 30906], [122, 31026], [127, 31326], [131, 31746], [134, 31906], [137, 32006], [145, 32486], [148, 33046]]}, {"verse": 4, "start": 33895, "end": 45604, "text": "Y he aquí que Booz vino de Belén, y dijo a los segadores: Jehová sea con vosotros. Y ellos respondieron: Jehová te bendiga.", "words": [[0, 33895], [2, 34060], [5, 34180], [10, 34440], [14, 34660], [19, 34880], [24, 35280], [27, 35480], [34, 35880], [36, 36360], [41, 36660], [43, 36780], [47, 37352], [58, 38054], [65, 38550], [69, 38690], [73, 38990], [83, 42321], [85, 42504], [91, 42844], [105, 44460], [112, 44913], [115, 44993]]}, {"verse": 5, "start": 45884, "end": 51344, "text": "Y Booz dijo a su criado el mayordomo de los segadores: ¿De quién es esta moza?", "words": [[0, 45884], [2, 46043], [7, 46233], [12, 46853], [14, 47073], [17, 47193], [24, 47713], [27, 48153], [37, 48593], [40, 48673], [44, 49285], [55, 50030], [59, 50149], [65, 50369], [68, 50569], [73, 50789]]}, {"verse": 6, "start": 51624, "end": 59966, "text": "Y el criado, mayordomo de los segadores, respondió y dijo: Es la moza de Moab, que volvió con Noemí de los campos de Moab;", "words": [[0, 51624], [2, 51745], [5, 51845], [13, 52425], [23, 53005], [26, 53105], [30, 53775], [41, 54445], [51, 55245], [53, 55685], [59, 56403], [62, 56547], [65, 56667], [70, 56947], [73, 57067], [79, 57627], [83, 57787], [90, 58187], [94, 58347], [100, 58647], [103, 58827], [107, 58947], [114, 59387], [117, 59467]]}, {"verse": 7, "start": 60316, "end": 70584, "text": "Y ha dicho: Te ruego que me dejes recoger y juntar tras los segadores entre las gavillas: entró pues, y está desde por la mañana hasta ahora, menos un poco que se detuvo en casa.", "words": [[0, 60316], [2, 60397], [5, 60517], [12, 61135], [15, 61319], [21, 61539], [25, 61659], [28, 61779], [34, 62039], [42, 62579], [44, 62759], [51, 63199], [56, 63339], [60, 63659], [70, 63979], [76, 64259], [80, 64419], [90, 65179], [96, 65559], [102, 65839], [104, 66179], [109, 66479], [115, 66699], [119, 66999], [122, 67139], [129, 67459], [135, 67859], [142, 68139], [148, 68719], [151, 69019], [156, 69259], [160, 69479], [163, 69599], [170, 69979], [173, 70119]]}, {"verse": 8, "start": 70864, "end": 79408, "text": "Entonces Booz dijo a Ruth: Oye, hija mía, no vayas a espigar a otro campo, ni pases de aquí: y aquí estarás con mis criadas.", "words": [[0, 70864], [9, 71340], [14, 71854], [19, 72368], [21, 72882], [27, 73545], [32, 73808], [37, 74088], [42, 74608], [45, 74688], [51, 75048], [53, 75128], [61, 75508], [63, 75588], [68, 75788], [75, 76568], [78, 76728], [84, 77108], [87, 77228], [93, 77828], [95, 77931], [100, 78051], [108, 78471], [112, 78591], [116, 78731]]}, {"verse": 9, "start": 79758, "end": 90060, "text": "Mira bien al campo que sieguen, y síguelas: porque yo he mandado a los criados que no te molesten. Y cuando tengas sed, ve a las vasijas, y bebe del agua que sacan los criados.", "words": [[0, 79758], [5, 80055], [10, 80235], [13, 80415], [19, 80655], [23, 80965], [32, 81275], [34, 81475], [44, 82294], [51, 82501], [54, 82761], [57, 82861], [65, 83321], [67, 83421], [71, 83521], [79, 84021], [83, 84201], [86, 84341], [89, 84481], [99, 85429], [101, 85530], [108, 85730], [115, 86250], [120, 86830], [123, 86930], [125, 87010], [129, 87340], [138, 87670], [140, 88050], [145, 88310], [149, 88510], [154, 88690], [158, 88850], [164, 89210], [168, 89330]]}, {"verse": 10, "start": 90340, "end": 101771, "text": "Ella entonces bajando su rostro se inclinó a tierra, y le dijo: ¿Por qué he hallado gracia en tus ojos para que me trates con bondad, siendo yo extranjera?", "words": [[0, 90340], [5, 90849], [14, 91632], [22, 92074], [25, 92274], [32, 92894], [35, 92994], [43, 93674], [45, 93794], [53, 94194], [55, 94529], [58, 94649], [64, 95415], [69, 95566], [73, 95926], [76, 96286], [84, 96806], [91, 97326], [94, 97426], [98, 97566], [103, 97946], [108, 98366], [112, 98506], [115, 98646], [122, 99006], [126, 99206], [134, 100186], [141, 100546], [144, 100826]]}, {"verse": 11, "start": 102051, "end": 116696, "text": "Y respondiendo Booz, le dijo: Por cierto se me ha declarado todo lo que has hecho con tu suegra después de la muerte de tu marido, y que dejando a tu padre y a tu madre y la tierra donde naciste, has venido a pueblo que no conociste antes.", "words": [[0, 102051], [2, 102178], [15, 102938], [21, 103698], [24, 103858], [30, 104542], [34, 104650], [41, 105150], [44, 105270], [47, 105410], [50, 105470], [60, 106030], [65, 106270], [68, 106490], [72, 106610], [76, 106790], [82, 107010], [86, 107230], [89, 107390], [96, 107870], [104, 108370], [107, 108630], [110, 108730], [117, 108970], [120, 109170], [123, 109290], [131, 110053], [133, 110140], [137, 110260], [145, 110760], [147, 110860], [150, 110980], [156, 111360], [158, 111560], [160, 111620], [163, 111760], [169, 112100], [171, 112380], [174, 112500], [181, 112800], [187, 113080], [196, 113780], [200, 114320], [207, 114700], [209, 114800], [216, 115040], [220, 115320], [223, 115460], [233, 116040]]}, {"verse": 12, "start": 117046, "end": 124681, "text": "Jehová recompense tu obra, y tu remuneración sea llena por Jehová Dios de Israel, que has venido para cubrirte debajo de sus alas.", "words": [[0, 117046], [7, 117463], [18, 118103], [21, 118303], [27, 118603], [29, 118808], [32, 118928], [45, 119628], [49, 119908], [55, 120288], [59, 120468], [66, 120908], [71, 121048], [74, 121248], [82, 122028], [86, 122148], [90, 122288], [97, 122648], [102, 122848], [111, 123428], [118, 123788], [121, 123928], [125, 124333]]}, {"verse": 13, "start": 124961, "end": 136097, "text": "Y ella dijo: Señor mío, halle yo gracia delante de tus ojos; porque me has consolado, y porque has hablado al corazón de tu sierva, no siendo yo como una de tus criadas.", "words": [[0, 124961], [2, 125122], [7, 125322], [13, 126113], [19, 126371], [24, 127091], [30, 127431], [33, 127701], [40, 127971], [48, 128511], [51, 128701], [55, 128891], [61, 129301], [68, 129719], [71, 129939], [75, 130099], [86, 130899], [88, 131339], [95, 131579], [99, 131779], [107, 132029], [110, 132279], [118, 132619], [121, 132819], [124, 132939], [132, 133439], [135, 133879], [142, 134179], [145, 134499], [150, 134739], [154, 134979], [157, 135099], [161, 135239]]}, {"verse": 14, "start": 136377, "end": 150172, "text": "Y Booz le dijo a la hora de comer: Ven aquí, y come del pan, y moja tu bocado en el vinagre. Y se sentó ella junto a los segadores, y él le dio del potaje, y comió hasta que se hartó y le sobró.", "words": [[0, 136377], [2, 136540], [7, 136740], [10, 137320], [15, 137660], [17, 137780], [20, 137900], [25, 138100], [28, 138300], [35, 138987], [39, 139129], [45, 139409], [47, 139669], [52, 139889], [56, 140089], [61, 140369], [63, 140629], [68, 140909], [71, 141049], [78, 141429], [81, 141549], [84, 141649], [93, 142539], [95, 142680], [98, 142780], [104, 143300], [109, 143520], [115, 143860], [117, 144100], [121, 144780], [132, 145460], [134, 145520], [137, 145720], [140, 145960], [144, 146140], [148, 146280], [156, 146900], [158, 147320], [164, 147780], [170, 148260], [174, 148440], [177, 148620], [183, 149180], [185, 149540], [188, 149640]]}, {"verse": 15, "start": 150522, "end": 160128, "text": "Se levantó luego para espigar. Y Booz mandó a sus criados, diciendo: Coja también espigas entre las gavillas, y no la avergoncéis;", "words": [[0, 150522], [3, 150680], [11, 151280], [17, 151600], [22, 152145], [31, 152898], [33, 153063], [38, 153263], [44, 153968], [46, 154108], [50, 154248], [59, 154968], [69, 156440], [74, 156580], [82, 156900], [90, 157500], [96, 157740], [100, 157960], [110, 158440], [112, 158900], [115, 159040], [118, 159615]]}, {"verse": 16, "start": 160478, "end": 166123, "text": "Y dejaréis también caer para ella algo de los manojos, y la dejaréis que coja, y no la reprendáis.", "words": [[0, 160478], [2, 160586], [11, 160986], [19, 161266], [24, 161746], [29, 161926], [34, 162206], [39, 162486], [42, 162626], [46, 162986], [55, 163346], [57, 163666], [60, 163766], [69, 164226], [73, 164346], [79, 164806], [81, 165066], [84, 165186], [87, 165306]]}, {"verse": 17, "start": 166403, "end": 173656, "text": "Y espigó en el campo hasta la tarde, y desgranó lo que había recogido, y fue como un efa de cebada.", "words": [[0, 166403], [2, 166523], [9, 167023], [12, 167143], [15, 167263], [21, 167623], [27, 167843], [30, 168003], [37, 168363], [39, 168973], [48, 169583], [51, 170023], [55, 170183], [61, 170443], [71, 171283], [73, 171623], [77, 171803], [82, 172103], [85, 172343], [89, 172799], [92, 173256]]}, {"verse": 18, "start": 174006, "end": 184277, "text": "Y lo tomó, y se vino a la ciudad; y su suegra vio lo que había recogido. Sacó también luego lo que le había sobrado después de harta, y se lo dio.", "words": [[0, 174006], [2, 174134], [5, 174234], [11, 174674], [13, 175254], [16, 175414], [21, 175634], [23, 175794], [26, 175874], [34, 176776], [36, 176892], [39, 177012], [46, 177552], [50, 177952], [53, 178092], [57, 178252], [63, 178472], [73, 179607], [78, 180032], [86, 180332], [92, 180812], [95, 181112], [99, 181272], [102, 181432], [108, 181652], [116, 182232], [124, 182532], [127, 182942], [134, 183352], [136, 183577], [139, 183757], [142, 183897]]}, {"verse": 19, "start": 184627, "end": 201379, "text": "Y le dijo su suegra: ¿Dónde has espigado hoy? ¿y dónde has trabajado? bendito sea el que te ha favorecido. Y ella declaró a su suegra lo que le había acontecido con aquel, y dijo: El nombre del varón con quien hoy he trabajado es Booz.", "words": [[0, 184627], [2, 184754], [5, 184944], [10, 185134], [13, 185334], [21, 186247], [28, 186487], [32, 186897], [41, 187307], [46, 187998], [49, 188124], [55, 188304], [59, 188584], [70, 189714], [78, 190221], [82, 190481], [85, 190701], [89, 190841], [92, 191001], [95, 191121], [107, 192254], [109, 192423], [114, 192743], [122, 193363], [124, 193463], [127, 193603], [134, 194043], [137, 194203], [141, 194343], [144, 194483], [150, 194763], [161, 195563], [165, 195763], [172, 196223], [174, 196843], [180, 197528], [183, 197675], [190, 198015], [194, 198295], [200, 198735], [204, 199015], [210, 199275], [214, 199465], [217, 199655], [227, 200395], [230, 200918]]}, {"verse": 20, "start": 201659, "end": 218853, "text": "Y dijo Noemí a su nuera: Sea él bendito de Jehová, pues que no ha rehusado a los vivos la benevolencia que tuvo para con los que han muerto. Le dijo después Noemí: Nuestro pariente es aquel varón, y uno de los que pueden redimirnos.", "words": [[0, 201659], [2, 201785], [7, 202105], [13, 202605], [15, 203085], [18, 203265], [25, 204119], [29, 204459], [32, 204859], [40, 205559], [43, 205719], [51, 206599], [56, 206779], [60, 206999], [63, 207259], [66, 207459], [75, 208079], [77, 208199], [81, 208319], [87, 208739], [90, 208879], [103, 209639], [107, 209819], [112, 210119], [117, 210399], [121, 210639], [125, 210799], [129, 210959], [133, 211099], [141, 211979], [144, 212088], [149, 212368], [157, 213194], [164, 214164], [172, 214670], [181, 215210], [184, 215530], [190, 215870], [197, 216310], [199, 216810], [203, 217010], [206, 217150], [210, 217290], [214, 217470], [221, 217810]]}, {"verse": 21, "start": 219133, "end": 227330, "text": "Y Ruth moabita dijo: A más de esto me ha dicho: Júntate con mis criadas, hasta que hayan acabado toda mi siega.", "words": [[0, 219133], [2, 219340], [7, 219880], [15, 220655], [21, 221440], [23, 221547], [27, 221727], [30, 221967], [35, 222247], [38, 222467], [41, 222587], [48, 223361], [56, 223782], [60, 224042], [64, 224202], [73, 224902], [79, 225242], [83, 225422], [89, 225742], [97, 226222], [102, 226462], [105, 226927]]}, {"verse": 22, "start": 227610, "end": 236330, "text": "Y Noemí respondió a Ruth su nuera: Mejor es, hija mía, que salgas con sus criadas, y que no te encuentren en otro campo.", "words": [[0, 227610], [2, 227735], [8, 228175], [18, 229135], [20, 229355], [25, 229655], [28, 230115], [35, 230838], [41, 231198], [45, 231458], [50, 231838], [55, 232358], [59, 232558], [66, 232998], [70, 233178], [74, 233358], [83, 233918], [85, 234418], [89, 234538], [92, 234698], [95, 234818], [106, 235358], [109, 235478], [114, 235678]]}, {"verse": 23, "start": 236610, "end": 247058, "text": "Estuvo pues junta con las criadas de Booz espigando, hasta que la siega de las cebadas y la de los trigos fue acabada; mas con su suegra habitó.", "words": [[0, 236610], [7, 236971], [12, 237191], [18, 237631], [22, 237831], [26, 238031], [34, 238631], [37, 239331], [42, 240031], [53, 240731], [59, 241451], [63, 241631], [66, 241941], [72, 242251], [75, 242351], [79, 242511], [87, 243031], [89, 243211], [92, 243311], [95, 243411], [99, 243641], [106, 243871], [110, 244031], [119, 244990], [123, 245118], [127, 245338], [130, 245768], [137, 246198]]}]}