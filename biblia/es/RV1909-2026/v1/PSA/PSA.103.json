{"book": "PSA", "chapter": 103, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 143034, "verses": [{"verse": 1, "start": 300, "end": 7423, "text": "Salmo de David. BENDICE, alma mía, a Jehová; y bendigan todas mis entrañas su santo nombre.", "words": [[0, 300], [6, 804], [9, 964], [16, 1653], [25, 2258], [30, 2578], [35, 3058], [37, 3278], [45, 4017], [47, 4361], [56, 4741], [62, 5061], [66, 5381], [75, 6061], [78, 6281], [84, 6781]]}, {"verse": 2, "start": 7773, "end": 12919, "text": "Bendice, alma mía a Jehová, y no olvides ninguno de sus beneficios.", "words": [[0, 7773], [9, 8251], [14, 8765], [18, 9278], [20, 9498], [28, 10098], [30, 10438], [33, 10658], [41, 11098], [49, 11678], [52, 11798], [56, 11958]]}, {"verse": 3, "start": 13269, "end": 18934, "text": "Él es quien perdona todas tus iniquidades, el que sana todas tus dolencias;", "words": [[0, 13269], [3, 13477], [6, 13637], [12, 13797], [20, 14457], [26, 14797], [30, 15177], [43, 16217], [46, 16577], [50, 16737], [55, 17017], [61, 17377], [65, 17797]]}, {"verse": 4, "start": 19284, "end": 24339, "text": "El que rescata del hoyo tu vida, el que te corona de favores y misericordias;", "words": [[0, 19284], [3, 19423], [7, 19763], [15, 20103], [19, 20303], [24, 20643], [27, 20763], [33, 21403], [36, 21683], [40, 21803], [43, 21943], [50, 22283], [53, 22503], [61, 23023], [63, 23183]]}, {"verse": 5, "start": 24689, "end": 29353, "text": "El que sacia de bien tu boca de modo que te rejuvenezcas como el águila.", "words": [[0, 24689], [3, 24830], [7, 25160], [13, 25490], [16, 25670], [21, 25870], [24, 26130], [29, 26410], [32, 26590], [37, 26830], [41, 27030], [44, 27190], [57, 28190], [62, 28530], [65, 28750]]}, {"verse": 6, "start": 29703, "end": 35191, "text": "Jehová el que hace justicia y derecho a todos los que padecen violencia.", "words": [[0, 29703], [7, 30152], [10, 30622], [14, 30922], [19, 31222], [28, 32042], [30, 32142], [38, 32542], [40, 32742], [46, 32962], [50, 33262], [54, 33482], [62, 34062]]}, {"verse": 7, "start": 35541, "end": 39699, "text": "Sus caminos notificó a Moisés, y a los hijos de Israel sus obras.", "words": [[0, 35541], [4, 35668], [12, 36108], [21, 36788], [23, 36888], [31, 37308], [33, 37702], [35, 37782], [39, 37902], [45, 38183], [48, 38363], [55, 38782], [59, 39022]]}, {"verse": 8, "start": 40049, "end": 46683, "text": "Misericordioso y clemente es Jehová; lento para la ira, y grande en misericordia.", "words": [[0, 40455], [15, 40895], [17, 41215], [26, 41535], [29, 41795], [37, 42682], [43, 43130], [48, 43370], [51, 43570], [56, 44330], [58, 44610], [65, 45090], [68, 45530]]}, {"verse": 9, "start": 47033, "end": 51332, "text": "No contenderá para siempre, ni para siempre guardará el enojo.", "words": [[0, 47033], [3, 47242], [14, 48002], [19, 48162], [28, 48692], [31, 49222], [36, 49462], [44, 49862], [53, 50542], [56, 50742]]}, {"verse": 10, "start": 51682, "end": 58916, "text": "No ha hecho con nosotros conforme a nuestras iniquidades; ni nos ha pagado conforme a nuestros pecados.", "words": [[0, 51682], [3, 51962], [6, 52142], [12, 52362], [16, 52622], [25, 53022], [34, 53882], [36, 54002], [45, 54222], [58, 55782], [61, 55992], [65, 56212], [68, 56452], [75, 56992], [84, 57732], [86, 57792], [95, 58012]]}, {"verse": 11, "start": 59266, "end": 66875, "text": "Porque como la altura de los cielos sobre la tierra, engrandeció su misericordia sobre los que le temen.", "words": [[0, 59266], [7, 59511], [12, 59871], [15, 60131], [22, 60771], [25, 61111], [29, 61251], [36, 61911], [42, 62211], [45, 62431], [53, 62871], [65, 64331], [68, 64551], [81, 65471], [87, 65751], [91, 65991], [95, 66131], [98, 66251]]}, {"verse": 12, "start": 67225, "end": 73864, "text": "Cuanto está lejos el oriente del occidente, hizo alejar de nosotros nuestras rebeliones.", "words": [[0, 67225], [7, 67389], [12, 67649], [18, 68109], [21, 68309], [29, 68809], [33, 69069], [44, 69849], [49, 70499], [56, 71149], [59, 71289], [68, 71789], [77, 72429]]}, {"verse": 13, "start": 74214, "end": 79394, "text": "Como el padre se compadece de los hijos, se compadece Jehová de los que le temen.", "words": [[0, 74214], [5, 74398], [8, 74558], [14, 74978], [17, 75258], [27, 75958], [30, 76178], [34, 76318], [41, 77058], [44, 77318], [54, 77878], [61, 78378], [64, 78498], [68, 78598], [72, 78718], [75, 78838]]}, {"verse": 14, "start": 79744, "end": 84663, "text": "Porque él conoce nuestra condición; se acuerda de que somos polvo.", "words": [[0, 79744], [7, 80008], [10, 80408], [17, 80988], [25, 81168], [36, 82517], [39, 82767], [47, 83247], [50, 83407], [54, 83487], [60, 83747]]}, {"verse": 15, "start": 85013, "end": 89596, "text": "El hombre, como la hierba son sus días: florece como la flor del campo.", "words": [[0, 85013], [3, 85132], [11, 85392], [16, 85672], [19, 85852], [26, 86252], [30, 86472], [34, 86692], [40, 87608], [48, 88054], [53, 88294], [56, 88454], [61, 88654], [65, 88854]]}, {"verse": 16, "start": 89946, "end": 94662, "text": "Que pasó el viento por ella, y pereció: y su lugar no la conoce más.", "words": [[0, 89946], [4, 90030], [9, 90270], [12, 90510], [19, 90830], [23, 91090], [29, 91310], [31, 91655], [40, 92583], [42, 92702], [45, 92802], [51, 93182], [54, 93542], [57, 93662], [64, 94122]]}, {"verse": 17, "start": 95012, "end": 103579, "text": "Mas la misericordia de Jehová desde el siglo y hasta el siglo sobre los que le temen, y su justicia sobre los hijos de los hijos;", "words": [[0, 95012], [4, 95199], [7, 95299], [20, 96119], [23, 96259], [30, 96699], [36, 96899], [39, 97179], [45, 97559], [47, 97814], [53, 98034], [56, 98274], [62, 98774], [68, 99554], [72, 99754], [76, 99894], [79, 100034], [86, 100714], [88, 101014], [91, 101174], [100, 101774], [106, 102074], [110, 102294], [116, 102614], [119, 102774], [123, 102934]]}, {"verse": 18, "start": 103929, "end": 110431, "text": "Sobre los que guardan su pacto, y los que se acuerdan de sus mandamientos para ponerlos por