{"book": "GEN", "chapter": 30, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 351279, "verses": [{"verse": 1, "start": 300, "end": 9840, "text": "Y viendo Raquel que no daba hijos a Jacob, tuvo envidia de su hermana, y decía a Jacob: Dame hijos, o si no, me muero.", "words": [[0, 300], [2, 428], [9, 748], [16, 1488], [20, 1548], [23, 1748], [28, 2068], [34, 2388], [36, 2648], [43, 3448], [48, 3788], [56, 4708], [59, 4848], [62, 5028], [71, 5568], [73, 5788], [79, 6148], [81, 6588], [88, 7409], [93, 7629], [100, 8369], [102, 8469], [105, 8609], [109, 9129], [112, 9309]]}, {"verse": 2, "start": 10120, "end": 17910, "text": "Y Jacob se enojaba contra Raquel, y decía: ¿Soy yo en lugar de Dios, que te impidió el fruto de tu vientre?", "words": [[0, 10120], [2, 10307], [8, 10587], [11, 11247], [19, 11927], [26, 12287], [34, 12867], [36, 13287], [43, 14168], [48, 14411], [51, 14711], [54, 14851], [60, 15051], [63, 15271], [69, 15831], [73, 16031], [76, 16171], [84, 16651], [87, 16751], [93, 17091], [96, 17211], [99, 17351]]}, {"verse": 3, "start": 18190, "end": 26466, "text": "Y ella dijo: He aquí mi sierva Bilha; entra a ella, y parirá sobre mis rodillas, y yo también tendré hijos de ella.", "words": [[0, 18190], [2, 18352], [7, 18552], [13, 19416], [16, 19526], [21, 19806], [24, 20306], [31, 20798], [38, 21482], [44, 21612], [46, 21772], [52, 22192], [54, 22652], [61, 23072], [67, 23312], [71, 23512], [81, 24492], [83, 24572], [86, 24732], [94, 24992], [101, 25512], [107, 25812], [110, 26052]]}, {"verse": 4, "start": 26746, "end": 31604, "text": "Así le dio a Bilha su sierva por mujer; y Jacob entró a ella.", "words": [[0, 26746], [4, 27110], [7, 27370], [11, 27610], [13, 27850], [19, 28090], [22, 28290], [29, 28810], [33, 29110], [40, 29972], [42, 30136], [48, 30376], [54, 30996], [56, 31116]]}, {"verse": 5, "start": 31954, "end": 35043, "text": "Y concibió Bilha, y parió a Jacob un hijo.", "words": [[0, 31954], [2, 32051], [11, 32561], [18, 33071], [20, 33451], [26, 33871], [28, 33991], [34, 34271], [37, 34531]]}, {"verse": 6, "start": 35393, "end": 42976, "text": "Y dijo Raquel: Me juzgó Dios, y también oyó mi voz, y me dio un hijo. Por tanto llamó su nombre Dan.", "words": [[0, 35393], [2, 35515], [7, 35735], [15, 36576], [18, 36696], [24, 37076], [30, 37336], [32, 37876], [40, 38176], [44, 38596], [47, 38716], [52, 39056], [54, 39396], [57, 39516], [61, 39716], [64, 39896], [70, 40605], [74, 40728], [80, 41288], [86, 41648], [89, 41788], [96, 42148]]}, {"verse": 7, "start": 43326, "end": 49363, "text": "Y concibió otra vez Bilha, la sierva de Raquel, y parió el hijo segundo a Jacob.", "words": [[0, 43326], [2, 43429], [11, 44049], [16, 44309], [20, 44919], [27, 45529], [30, 45629], [37, 46089], [40, 46229], [48, 46729], [50, 47309], [56, 47749], [59, 47909], [64, 48089], [72, 48549], [74, 48789]]}, {"verse": 8, "start": 49713, "end": 56687, "text": "Y dijo Raquel: Con luchas de Dios he contendido con mi hermana, y he vencido. Y llamó su nombre Neftalí.", "words": [[0, 49713], [2, 49835], [7, 50055], [15, 50895], [19, 51035], [26, 51475], [29, 51595], [34, 51855], [37, 52155], [48, 52795], [52, 52935], [55, 53075], [64, 53515], [66, 53935], [69, 54035], [78, 54979], [80, 55183], [86, 55423], [89, 55663], [96, 55903]]}, {"verse": 9, "start": 57037, "end": 63722, "text": "Y viendo Lea que había dejado de parir, tomó a Zilpa su sierva, y la dio a Jacob por mujer.", "words": [[0, 57037], [2, 57302], [9, 57608], [13, 57915], [17, 58095], [23, 58335], [30, 58855], [33, 59035], [40, 59455], [45, 60015], [47, 60295], [53, 60575], [56, 60715], [64, 61235], [66, 61615], [69, 61995], [73, 62235], [75, 62435], [81, 62775], [85, 63080]]}, {"verse": 10, "start": 64072, "end": 68256, "text": "Y Zilpa, sierva de Lea, parió a Jacob un hijo.", "words": [[0, 64295], [2, 64555], [9, 64815], [16, 65075], [19, 65435], [24, 65895], [30, 66835], [32, 67035], [38, 67395], [41, 67775]]}, {"verse": 11, "start": 68606, "end": 72662, "text": "Y dijo Lea: Vino la ventura. Y llamó su nombre Gad.", "words": [[0, 68606], [2, 68904], [7, 69124], [12, 69880], [17, 70183], [20, 70585], [29, 71208], [31, 71332], [37, 71652], [40, 71752], [47, 72207]]}, {"verse": 12, "start": 73012, "end": 76862, "text": "Y Zilpa, la sierva de Lea, parió otro hijo a Jacob.", "words": [[0, 73012], [2, 73268], [9, 73558], [12, 73678], [19, 74098], [22, 74218], [27, 74658], [33, 75258], [38, 75678], [43, 75938], [45, 76158]]}, {"verse": 13, "start": 77212, "end": 83980, "text": "Y dijo Lea: Para dicha mía; porque las mujeres me dirán dichosa: y llamó su nombre Aser.", "words": [[0, 77212], [2, 77511], [7, 77731], [12, 78486], [17, 78697], [23, 79117], [28, 79776], [35, 79959], [39, 80179], [47, 80559], [50, 80849], [56, 81139], [65, 82350], [67, 82476], [73, 82796], [76, 82936], [83, 83485]]}, {"verse": 14, "start": 84330, "end": 98815, "text": "Y fue Rubén en tiempo de la siega de los trigos, y halló mandrágoras en el campo, y las trajo a Lea su madre: y dijo Raquel a Lea: Te ruego que me des de las mandrágoras de tu hijo.", "words": [[0, 84330], [2, 84586], [6, 84746], [12, 85226], [15, 85506], [22, 85946], [25, 86166], [28, 86406], [34, 86646], [37, 86726], [41, 86866], [49, 87806], [51, 88106], [57, 88466], [69, 89466], [72, 89786], [75, 89946], [82, 90786], [84, 91006], [88, 91166], [94, 91473], [96, 91779], [100, 92086], [103, 92246], [110, 93062], [112, 93291], [117, 93611], [124, 94085], [126, 94558], [131, 95171], [134, 95271], [140, 95651], [144, 95811], [147, 95971], [151, 96211], [154, 96371], [158, 96511], [170, 97211], [173, 97411], [176, 97591]]}, {"verse": 15, "start": 99095, "end": 111467, "text": "Y ella respondió: ¿Es poco que hayas tomado mi marido, sino que también te has de llevar las mandrágoras de mi hijo? y dijo Raquel: Pues dormirá contigo esta noche por las mandrágoras de tu hijo.", "words": [[0, 99095], [2, 99296], [7, 99576], [18, 100794], [22, 100974], [27, 101214], [31, 101474], [37, 101834], [44, 102194], [47, 102354], [55, 103054], [60, 103234], [64, 103454], [72, 103754], [75, 104014], [79, 104154], [82, 104294], [89, 104494], [93, 104774], [105, 105414], [108, 105634], [111, 105794], [117, 106589], [119, 106711], [124, 106951], [132, 107767], [137, 107987], [145, 108587], [153, 109047], [158, 109227], [164, 109567], [168, 109827], [172, 110217], [184, 110607], [187, 110787], [190, 110967]]}, {"verse": 16, "start": 111747, "end": 125333, "text": "Y cuando Jacob volvía del campo a la tarde, salió Lea a él, y le dijo: A mí has de entrar, porque a la verdad te he alquilado por las mandrágoras de mi hijo. Y durmió con ella aquella noche.", "words": [[0, 111747], [2, 111829], [9, 112049], [15, 112449], [22, 112942], [26, 113436], [32, 113929], [34, 114009], [37, 114069], [44, 114709], [50, 115329], [54, 115949], [56, 116209], [60, 116509], [62, 116694], [65, 116834], [71, 117551], [73, 117755], [76, 117928], [80, 118102], [83, 118275], [91, 119275], [98, 119455], [100, 119595], [103, 119695], [110, 120035], [113, 120355], [116, 120495], [126, 121055], [130, 121275], [134, 121455], [146, 122115], [149, 122335], [152, 122495], [158, 123250], [160, 123376], [167, 123896], [171, 124056], [176, 124316], [184, 124696]]}, {"verse": 17, "start": 125683, "end": 130949, "text": "Y oyó Dios a Lea: y concibió, y parió a Jacob el quinto hijo.", "words": [[0, 125683], [2, 125820], [6, 125990], [11, 126393], [13, 126796], [18, 127349], [20, 127468], [30, 128308], [32, 128628], [38, 129108], [40, 129375], [46, 129641], [49, 129908], [56, 130368]]}, {"verse": 18, "start": 131299, "end": 139358, "text": "Y dijo Lea: Dios me ha dado mi recompensa, por cuanto di mi sierva a mi marido: por eso llamó su nombre Isacar.", "words": [[0, 131299], [2, 131598], [7, 131818], [12, 132573], [17, 132812], [20, 133012], [23, 133152], [28, 133332], [31, 133512], [43, 134732], [47, 134992], [54, 135252], [57, 135532], [60, 135652], [67, 136132], [69, 136252], [72, 136332], [80, 137209], [84, 137334], [88, 137534], [94, 137934], [97, 138074], [104, 138747]]}, {"verse": 19, "start": 139708, "end": 143494, "text": "Y concibió Lea otra vez, y parió el sexto hijo a Jacob.", "words": [[0, 139708], [2, 139815], [11, 140415], [15, 140735], [20, 140915], [25, 141315], [27, 141715], [33, 142055], [36, 142175], [42, 142615], [47, 142795], [49, 142955]]}, {"verse": 20, "start": 143844, "end": 154081, "text": "Y dijo Lea: Dios me ha dado una buena dote: ahora morará conmigo mi marido, porque le he parido seis hijos: y llamó su nombre Zabulón.", "words": [[0, 143844], [2, 144142], [7, 144362], [12, 145118], [17, 145442], [20, 145762], [23, 145962], [28, 146202], [32, 146422], [38, 146742], [44, 147563], [50, 147934], [57, 148434], [65, 149094], [68, 149174], [76, 150114], [83, 150314], [86, 150514], [89, 150714], [96, 151134], [101, 151434], [108, 152304], [110, 152407], [116, 152727], [119, 152887], [126, 153518]]}, {"verse": 21, "start": 154431, "end": 158523, "text": "Y después parió una hija, y llamó su nombre Dina.", "words": [[0, 154431], [2, 154751], [10, 155051], [16, 155551], [20, 155771], [26, 156531], [28, 156691], [34, 157051], [37, 157211], [44, 157591]]}, {"verse": 22, "start": 158873, "end": 163944, "text": "Y se acordó Dios de Raquel, y la oyó Dios, y abrió su matriz.", "words": [[0, 158873], [2, 159174], [5, 159314], [12, 159814], [17, 160054], [20, 160254], [28, 160694], [30, 160917], [33, 161139], [37, 161459], [43, 162259], [45, 162579], [51, 162899], [54, 163099]]}, {"verse": 23, "start": 164294, "end": 169443, "text": "Y concibió, y parió un hijo: y dijo: Quitado ha Dios mi afrenta:", "words": [[0, 164294], [2, 164415], [12, 165195], [14, 165415], [20, 165855], [23, 166135], [29, 166958], [31, 167126], [37, 167855], [45, 168125], [48, 168395], [53, 168595], [56, 168795]]}, {"verse": 24, "start": 169723, "end": 173545, "text": "Y llamó su nombre José, diciendo: Añádame Jehová otro hijo.", "words": [[0, 169723], [2, 169852], [8, 170192], [11, 170392], [18, 170772], [24, 171252], [34, 171675], [42, 172221], [49, 172741], [54, 173061]]}, {"verse": 25, "start": 173825, "end": 182199, "text": "Y aconteció, cuando Raquel hubo parido a José, que Jacob dijo a Labán: Envíame, e iré a mi lugar, y a mi tierra.", "words": [[0, 173825], [2, 173955], [13, 174635], [20, 175035], [27, 175435], [32, 175735], [39, 176135], [41, 176235], [47, 177115], [51, 177335], [57, 177695], [62, 178235], [64, 178395], [71, 179173], [80, 179760], [82, 180120], [86, 180420], [88, 180500], [91, 180620], [98, 181000], [100, 181360], [102, 181420], [105, 181540]]}, {"verse": 26, "start": 182549, "end": 190307, "text": "Dame mis mujeres y mis hijos, por las cuales he servido contigo, y déjame ir; pues tú sabes los servicios que te he hecho.", "words": [[0, 182549], [5, 182787], [9, 183047], [17, 183487], [19, 183747], [23, 183947], [30, 184547], [34, 184767], [38, 184927], [45, 185227], [48, 185587], [56, 185987], [65, 186627], [67, 186947], [74, 187367], [78, 187974], [83, 188078], [86, 188298], [92, 188598], [96, 188838], [106, 189338], [110, 189618], [113, 189778], [116, 189878]]}, {"verse": 27, "start": 190587, "end": 198373, "text": "Y Labán le respondió: Halle yo ahora gracia en tus ojos, y quédate; experimentado he que Jehová me ha bendecido por tu causa.", "words": [[0, 190587], [2, 190799], [8, 191049], [11, 191429], [22, 192533], [28, 192667], [31, 192800], [37, 193100], [44, 193400], [47, 193620], [51, 193760], [57, 194060], [59, 194460], [68, 195856], [82, 196126], [85, 196396], [89, 196416], [96, 196796], [99, 196896], [102, 196976], [112, 197456], [116, 197656], [119, 197796]]}, {"verse": 28, "start": 198653, "end": 201509, "text": "Y dijo: Señálame tu salario, que yo lo daré.", "words": [[0, 198653], [2, 198782], [8, 199504], [17, 200024], [20, 200184], [29, 200644], [33, 200804], [36, 200964], [39, 201084]]}, {"verse": 29, "start": 201789, "end": 207044, "text": "Y él respondió: Tú sabes cómo te he servido, y cómo ha estado tu ganado conmigo;", "words": [[0, 201789], [2, 201971], [5, 202111], [16, 203106], [19, 203202], [25, 203542], [30, 203882], [33, 204082], [36, 204202], [45, 204742], [47, 204962], [52, 205242], [55, 205402], [62, 205722], [65, 205962], [72, 206382]]}, {"verse": 30, "start": 207394, "end": 218228, "text": "Porque poco tenías antes de mi venida, y ha crecido en gran número; y Jehová te ha bendecido con mi llegada: y ahora ¿cuándo voy a hacer yo también por mi propia casa?", "words": [[0, 207394], [7, 207623], [12, 207883], [19, 208363], [25, 208763], [28, 208983], [31, 209083], [39, 209563], [41, 209963], [44, 210063], [52, 210483], [55, 210643], [60, 210823], [68, 211588], [70, 211708], [77, 212108], [80, 212208], [83, 212328], [93, 212868], [97, 213048], [100, 213228], [109, 214744], [111, 214880], [117, 215460], [125, 215860], [129, 216020], [131, 216200], [137, 216440], [140, 216640], [148, 216980], [152, 217240], [155, 217380], [162, 217580]]}, {"verse": 31, "start": 218508, "end": 226286, "text": "Y él dijo: ¿Qué te daré? Y respondió Jacob: No me des nada: si haces por mí esto, volveré a apacentar tus ovejas.", "words": [[0, 218508], [2, 218697], [5, 218857], [11, 219575], [16, 219679], [19, 219819], [25, 220516], [27, 220640], [37, 221220], [44, 222001], [47, 222141], [50, 222281], [54, 222401], [60, 223126], [63, 223310], [69, 223590], [73, 223830], [76, 224010], [82, 224590], [90, 224970], [92, 225050], [102, 225450], [106, 225630]]}, {"verse": 32, "start": 226636, "end": 240894, "text": "Yo pasaré hoy por todas tus ovejas, poniendo aparte todas las ovejas manchadas y salpicadas de color, y todas las reses de color oscuro entre las ovejas, y las manchadas y moteadas entre las cabras; y esto será mi salario.", "words": [[0, 226636], [3, 226725], [10, 227125], [14, 227345], [18, 227545], [24, 227805], [28, 228065], [36, 229165], [45, 229565], [52, 230065], [58, 230265], [62, 230525], [69, 230985], [79, 231565], [81, 231745], [92, 232345], [95, 232505], [102, 233405], [104, 233485], [110, 233725], [114, 234015], [120, 234305], [123, 234485], [129, 234725], [136, 235245], [142, 235425], [146, 235625], [154, 236506], [156, 236607], [160, 236727], [170, 237367], [172, 237587], [181, 238107], [187, 238407], [191, 238627], [199, 239454], [201, 239595], [206, 239835], [211, 240115], [214, 240275]]}, {"verse": 33, "start": 241244, "end": 252931, "text": "Así responderá por mí mi honradez mañana, cuando venga mi salario delante de ti: toda la que no sea pintada ni manchada en las cabras y de color oscuro en las ovejas mías, se me tendrá por robada.", "words": [[0, 241244], [4, 241491], [15, 242171], [19, 242371], [22, 242711], [25, 242981], [34, 243251], [42, 244111], [49, 244211], [55, 244591], [58, 244731], [66, 245171], [74, 245531], [77, 245711], [81, 246481], [86, 246697], [89, 246757], [93, 246897], [96, 247037], [100, 247237], [108, 247837], [111, 247957], [120, 248457], [123, 248517], [127, 248657], [134, 249137], [136, 249237], [139, 249377], [145, 249577], [152, 250117], [155, 250217], [159, 250317], [166, 250717], [172, 251397], [175, 251657], [178, 251797], [185, 252190], [189, 252584]]}, {"verse": 34, "start": 253211, "end": 256406, "text": "Y dijo Labán: Mira, ojalá fuese como tú dices.", "words": [[0, 253211], [2, 253331], [7, 253631], [14, 254441], [20, 254621], [26, 255061], [32, 255421], [37, 255641], [40, 255821]]}, {"verse": 35, "start": 256686, "end": 272950, "text": "Y apartó aquel día los machos cabríos rayados y manchados; y todas las cabras manchadas y de color vario, y toda res que tenía en sí algo de blanco, y todas las de color oscuro entre las ovejas, y las puso en manos de sus hijos;", "words": [[0, 256686], [2, 256803], [9, 257263], [15, 257603], [19, 257863], [23, 258098], [30, 258565], [38, 259031], [46, 259498], [48, 259678], [59, 260732], [61, 260880], [67, 261140], [71, 261400], [78, 261860], [88, 262560], [90, 262905], [93, 263045], [99, 263555], [106, 264065], [108, 264445], [113, 264665], [117, 264985], [121, 265475], [127, 265965], [130, 266085], [133, 266305], [138, 266705], [141, 266885], [149, 267425], [151, 267770], [157, 268110], [161, 268650], [164, 268810], [170, 269010], [177, 269510], [183, 269690], [187, 269910], [195, 270939], [197, 271060], [201, 271160], [206, 271560], [209, 271700], [215, 271920], [218, 272140], [222, 272320]]}, {"verse": 36, "start": 273300, "end": 279851, "text": "Y puso tres días de camino entre sí y Jacob: y Jacob apacentaba las otras ovejas de Labán.", "words": [[0, 273300], [2, 273612], [7, 273932], [12, 274192], [17, 274492], [20, 274632], [27, 275012], [33, 275292], [36, 275592], [38, 275832], [45, 276627], [47, 276893], [53, 277493], [64, 278093], [68, 278313], [74, 278593], [81, 279113], [84, 279503]]}, {"verse": 37, "start": 280201, "end": 291148, "text": "Y Jacob tomó varas de álamo verdes, y de avellano, y de castaño, y les quitó parte de la corteza para formar franjas blancas, descubriendo así lo blanco de las varas.", "words": [[0, 280201], [2, 280327], [8, 280667], [13, 281232], [19, 281652], [22, 282012], [28, 282372], [36, 282732], [38, 282992], [41, 283092], [51, 283612], [53, 283692], [56, 283812], [65, 284472], [67, 284932], [71, 285072], [77, 285372], [83, 285632], [86, 285832], [89, 285932], [97, 286492], [102, 286712], [109, 287152], [117, 287632], [126, 288581], [139, 289364], [143, 289604], [146, 289784], [153, 290224], [156, 290364], [160, 290484]]}, {"verse": 38, "start": 291498, "end": 302860, "text": "Y puso las varas que había pelado en las pilas, delante del ganado, en los abrevaderos del agua donde venían a beber las ovejas, las cuales entraban en celo viniendo a beber.", "words": [[0, 291498], [2, 291604], [7, 292004], [11, 292204], [17, 292624], [21, 292764], [27, 293024], [34, 293504], [37, 293624], [41, 293744], [48, 294404], [56, 294864], [60, 295324], [68, 295784], [71, 296324], [75, 296484], [87, 297404], [91, 297564], [96, 297824], [102, 298064], [109, 298564], [111, 298684], [117, 298884], [121, 299104], [129, 300105], [133, 300229], [140, 300449], [149, 301129], [152, 301289], [157, 301769], [166, 302249], [168, 302369]]}, {"verse": 39, "start": 303210, "end": 312078, "text": "Y concebían las ovejas delante de las varas, y parían borregos listados, pintados y salpicados de diversos colores.", "words": [[0, 303210], [2, 303337], [12, 303937], [16, 304137], [23, 304577], [31, 305137], [34, 305277], [38, 305377], [45, 305877], [47, 306237], [54, 306737], [63, 307597], [73, 308597], [82, 309597], [84, 309897], [95, 310597], [98, 310817], [107, 311337]]}, {"verse": 40, "start": 312428, "end": 324736, "text": "Y apartaba Jacob los corderos, y los ponía con su rebaño, los listados, y todo lo que era oscuro en el hato de Labán. Y ponía su hato aparte, y no lo ponía con las ovejas de Labán.", "words": [[0, 312428], [2, 312546], [11, 313066], [17, 313466], [21, 314006], [31, 314546], [33, 314806], [37, 314926], [43, 315306], [47, 315486], [50, 315686], [58, 316506], [62, 316646], [72, 317306], [74, 317551], [79, 317811], [82, 318051], [86, 318231], [90, 318391], [97, 318991], [100, 319151], [103, 319351], [108, 319551], [111, 319651], [118, 320472], [120, 320575], [126, 320955], [129, 321235], [134, 321515], [142, 322475], [144, 322595], [147, 322735], [150, 322855], [156, 323235], [160, 323395], [164, 323555], [171, 323975], [174, 324135]]}, {"verse": 41, "start": 325086, "end": 336321, "text": "Y sucedía que cuantas veces entraban en celo las tempranas, Jacob ponía las varas delante de las ovejas en las pilas, para que concibiesen a la vista de las varas.", "words": [[0, 325086], [2, 325211], [10, 325791], [14, 326011], [22, 326411], [28, 326851], [37, 327631], [40, 327818], [45, 328004], [49, 328191], [60, 329831], [66, 330111], [72, 330751], [76, 330931], [82, 331251], [90, 331691], [93, 331851], [97, 332011], [104, 332431], [107, 332611], [111, 332771], [118, 333511], [123, 333731], [127, 333911], [139, 334731], [141, 334971], [144, 335071], [150, 335311], [153, 335551], [157, 335691]]}, {"verse": 42, "start": 336671, "end": 344350, "text": "Y cuando venían las ovejas tardías, no las ponía: así eran las tardías para Labán, y las tempranas para Jacob.", "words": [[0, 336671], [2, 336773], [9, 337013], [16, 337493], [20, 337673], [27, 338093], [36, 339113], [39, 339373], [43, 339533], [50, 340330], [54, 340598], [59, 340918], [63, 341118], [71, 341618], [76, 341948], [83, 342278], [85, 342758], [89, 342898], [99, 343518], [104, 343718]]}, {"verse": 43, "start": 344700, "end": 350879, "text": "Y el varón prosperó muchísimo, y tuvo muchas ovejas, y siervas y siervos, y camellos y asnos.", "words": [[0, 344700], [2, 344861], [5, 345041], [11, 345461], [20, 346081], [31, 346661], [33, 346976], [38, 347196], [45, 347596], [53, 348176], [55, 348316], [63, 348736], [65, 348936], [74, 349356], [76, 349536], [85, 350076], [87, 350236]]}]}