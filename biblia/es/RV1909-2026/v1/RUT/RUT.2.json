{"book": "RUT", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 261801, "verses": [{"verse": 1, "start": 300, "end": 8729, "text": "Y tenía Noemí un pariente de su marido, hombre rico, de la familia de Elimelec, el cual se llamaba Booz.", "words": [[0, 300], [2, 565], [8, 865], [14, 1545], [17, 1805], [26, 2405], [29, 2625], [32, 2805], [40, 3325], [47, 3805], [53, 4685], [56, 4965], [59, 5085], [67, 5525], [70, 6265], [80, 7005], [83, 7105], [88, 7285], [91, 7525], [99, 8154]]}, {"verse": 2, "start": 9179, "end": 22604, "text": "Y Ruth la moabita dijo a Noemí: Te ruego que me dejes ir al campo, y recogeré espigas en pos de aquel a cuyos ojos halle gracia. Y ella le respondió: Ve, hija mía.", "words": [[0, 9179], [2, 9308], [7, 9928], [10, 10368], [18, 10808], [23, 11113], [25, 11418], [32, 11933], [35, 12033], [41, 12353], [45, 12553], [48, 12693], [54, 13033], [57, 13253], [60, 13393], [67, 13873], [69, 14453], [78, 15073], [86, 15553], [89, 15693], [93, 15953], [96, 16193], [102, 16613], [104, 16753], [110, 17133], [115, 17433], [121, 17733], [129, 18828], [131, 19018], [136, 19318], [139, 19518], [150, 21217], [154, 21705], [159, 22194]]}, {"verse": 3, "start": 22954, "end": 34865, "text": "fue pues, y llegando, espigó en el campo en pos de los segadores: y aconteció que aquella parte del campo era de Booz, el cual era de la familia de Elimelec.", "words": [[0, 22954], [4, 23194], [10, 23494], [12, 23934], [22, 24934], [29, 25474], [32, 25574], [35, 25674], [41, 26114], [44, 26374], [48, 26694], [51, 27254], [55, 27799], [66, 28588], [68, 28686], [78, 29326], [82, 29506], [90, 29806], [96, 30126], [100, 30426], [106, 30766], [110, 31106], [113, 31666], [119, 32226], [122, 32346], [127, 32646], [131, 33066], [134, 33226], [137, 33326], [145, 33806], [148, 34366]]}, {"verse": 4, "start": 35315, "end": 49633, "text": "Y he aquí que Booz vino de Belén, y dijo a los segadores: Jehová sea con vosotros. Y ellos respondieron: Jehová te bendiga.", "words": [[0, 35315], [2, 35480], [5, 35600], [10, 35860], [14, 36080], [19, 36300], [24, 36700], [27, 36900], [34, 37300], [36, 37780], [41, 38080], [43, 38200], [47, 38772], [58, 39524], [65, 40020], [69, 40160], [73, 40460], [83, 43861], [85, 44044], [91, 44384], [105, 46050], [112, 46503], [115, 46583]]}, {"verse": 5, "start": 49983, "end": 55493, "text": "Y Booz dijo a su criado el mayordomo de los segadores: ¿De quién es esta moza?", "words": [[0, 49983], [2, 50141], [7, 50331], [12, 50951], [14, 51171], [17, 51291], [24, 51811], [27, 52251], [37, 52691], [40, 52771], [44, 53383], [55, 54178], [59, 54298], [65, 54518], [68, 54718], [73, 54938]]}, {"verse": 6, "start": 55843, "end": 64234, "text": "Y el criado, mayordomo de los segadores, respondió y dijo: Es la moza de Moab, que volvió con Noemí de los campos de Moab;", "words": [[0, 55843], [2, 55964], [5, 56064], [13, 56644], [23, 57224], [26, 57324], [30, 57994], [41, 58664], [51, 59464], [53, 59904], [59, 60671], [62, 60815], [65, 60935], [70, 61215], [73, 61335], [79, 61895], [83, 62055], [90, 62455], [94, 62615], [100, 62915], [103, 63095], [107, 63215], [114, 63655], [117, 63735]]}, {"verse": 7, "start": 64684, "end": 75301, "text": "Y ha dicho: Te ruego que me dejes recoger y juntar tras los segadores entre las gavillas: entró pues, y está desde por la mañana hasta ahora, menos un poco que se detuvo en casa.", "words": [[0, 64684], [2, 64765], [5, 64885], [12, 65583], [15, 65768], [21, 65988], [25, 66108], [28, 66228], [34, 66488], [42, 67028], [44, 67208], [51, 67648], [56, 67788], [60, 68108], [70, 68428], [76, 68708], [80, 68868], [90, 69896], [96, 70275], [102, 70555], [104, 70895], [109, 71195], [115, 71415], [119, 71715], [122, 71855], [129, 72175], [135, 72575], [142, 72855], [148, 73435], [151, 73735], [156, 73975], [160, 74195], [163, 74315], [170, 74695], [173, 74835]]}, {"verse": 8, "start": 75651, "end": 84325, "text": "Entonces Booz dijo a Ruth: Oye, hija mía, no vayas a espigar a otro campo, ni pases de aquí: y aquí estarás con mis criadas.", "words": [[0, 75651], [9, 76127], [14, 76641], [19, 77155], [21, 77669], [27, 78382], [32, 78645], [37, 78925], [42, 79445], [45, 79525], [51, 79885], [53, 79965], [61, 80345], [63, 80425], [68, 80625], [75, 81405], [78, 81565], [84, 81945], [87, 82065], [93, 82744], [95, 82847], [100, 82967], [108, 83387], [112, 83507], [116, 83647]]}, {"verse": 9, "start": 84775, "end": 95737, "text": "Mira bien al campo que sieguen, y síguelas: porque yo he mandado a los criados que no te molesten. Y cuando tengas sed, ve a las vasijas, y bebe del agua que sacan los criados.", "words": [[0, 84775], [5, 85072], [10, 85252], [13, 85432], [19, 85672], [23, 85982], [32, 86292], [34, 86492], [44, 87892], [51, 88098], [54, 88358], [57, 88458], [65, 88918], [67, 89018], [71, 89118], [79, 89618], [83, 89798], [86, 89938], [89, 90078], [99, 91106], [101, 91207], [108, 91407], [115, 91927], [120, 92507], [123, 92607], [125, 92687], [129, 93017], [138, 93347], [140, 93727], [145, 93987], [149, 94187], [154, 94367], [158, 94527], [164, 94887], [168, 95007]]}, {"verse": 10, "start": 96087, "end": 108268, "text": "Ella entonces bajando su rostro se inclinó a tierra, y le dijo: ¿Por qué he hallado gracia en tus ojos para que me trates con bondad, siendo yo extranjera?", "words": [[0, 96087], [5, 96597], [14, 97617], [22, 98117], [25, 98317], [32, 98937], [35, 99037], [43, 99717], [45, 99837], [53, 100237], [55, 100977], [58, 101097], [64, 101913], [69, 102063], [73, 102423], [76, 102783], [84, 103303], [91, 103823], [94, 103923], [98, 104063], [103, 104443], [108, 104863], [112, 105003], [115, 105143], [122, 105503], [126, 105703], [134, 106683], [141, 107043], [144, 107323]]}, {"verse": 11, "start": 108618, "end": 123394, "text": "Y respondiendo Booz, le dijo: Por cierto se me ha declarado todo lo que has hecho con tu suegra después de la muerte de tu marido, y que dejando a tu padre y a tu madre y la tierra donde naciste, has venido a pueblo que no conociste antes.", "words": [[0, 108618], [2, 108746], [15, 109506], [21, 110266], [24, 110426], [30, 111160], [34, 111267], [41, 111767], [44, 111887], [47, 112027], [50, 112087], [60, 112647], [65, 112887], [68, 113107], [72, 113227], [76, 113407], [82, 113627], [86, 113847], [89, 114007], [96, 114487], [104, 114987], [107, 115247], [110, 115347], [117, 115587], [120, 115787], [123, 115907], [131, 116750], [133, 116837], [137, 116957], [145, 117457], [147, 117557], [150, 117677], [156, 118057], [158, 118257], [160, 118317], [163, 118457], [169, 118797], [171, 119077], [174, 119197], [181, 119497], [187, 119777], [196, 120477], [200, 121017], [207, 121397], [209, 121497], [216, 121737], [220, 122017], [223, 122157], [233, 122737]]}, {"verse": 12, "start": 123844, "end": 131773, "text": "Jehová recompense tu obra, y tu remuneración sea llena por Jehová Dios de Israel, que has venido para cubrirte debajo de sus alas.", "words": [[0, 123844], [7, 124260], [18, 124900], [21, 125100], [27, 125400], [29, 125900], [32, 126020], [45, 126720], [49, 127000], [55, 127380], [59, 127560], [66, 128000], [71, 128140], [74, 128340], [82, 129120], [86, 129240], [90, 129380], [97, 129740], [102, 129940], [111, 130520], [118, 130880], [121, 131020], [125, 131425]]}, {"verse": 13, "start": 132123, "end": 143714, "text": "Y ella dijo: Señor mío, halle yo gracia delante de tus ojos; porque me has consolado, y porque has hablado al corazón de tu sierva, no siendo yo como una de tus criadas.", "words": [[0, 132123], [2, 132285], [7, 132485], [13, 133325], [19, 133584], [24, 134304], [30, 134644], [33, 134914], [40, 135184], [48, 135724], [51, 135914], [55, 136104], [61, 136594], [68, 137336], [71, 137556], [75, 137716], [86, 138516], [88, 138956], [95, 139196], [99, 139396], [107, 139646], [110, 139896], [118, 140236], [121, 140436], [124, 140556], [132, 141056], [135, 141496], [142, 141796], [145, 142116], [150, 142356], [154, 142596], [157, 142716], [161, 142856]]}, {"verse": 14, "start": 144064, "end": 158574, "text": "Y Booz le dijo a la hora de comer: Ven aquí, y come del pan, y moja tu bocado en el vinagre. Y se sentó ella junto a los segadores, y él le dio del potaje, y comió hasta que se hartó y le sobró.", "words": [[0, 144064], [2, 144228], [7, 144428], [10, 145008], [15, 145348], [17, 145468], [20, 145588], [25, 145788], [28, 145988], [35, 146725], [39, 146866], [45, 147146], [47, 147406], [52, 147626], [56, 147826], [61, 148106], [63, 148366], [68, 148646], [71, 148786], [78, 149166], [81, 149286], [84, 149386], [93, 150941], [95, 151083], [98, 151183], [104, 151703], [109, 151923], [115, 152263], [117, 152503], [121, 153183], [132, 153863], [134, 153923], [137, 154123], [140, 154363], [144, 154543], [148, 154683], [156, 155303], [158, 155723], [164, 156183], [170, 156663], [174, 156843], [177, 157023], [183, 157583], [185, 157943], [188, 158043]]}, {"verse": 15, "start": 159024, "end": 169055, "text": "Se levantó luego para espigar. Y Booz mandó a sus criados, diciendo: Coja también espigas entre las gavillas, y no la avergoncéis;", "words": [[0, 159024], [3, 159182], [11, 159782], [17, 160102], [22, 160647], [31, 161480], [33, 161645], [38, 161845], [44, 162845], [46, 162985], [50, 163125], [59, 163845], [69, 165368], [74, 165508], [82, 165828], [90, 166428], [96, 166668], [100, 166888], [110, 167368], [112, 167828], [115, 167968], [118, 168543]]}, {"verse": 16, "start": 169505, "end": 175150, "text": "Y dejaréis también caer para ella algo de los manojos, y la dejaréis que coja, y no la reprendáis.", "words": [[0, 169505], [2, 169613], [11, 170013], [19, 170293], [24, 170773], [29, 170953], [34, 171233], [39, 171513], [42, 171653], [46, 172013], [55, 172373], [57, 172693], [60, 172793], [69, 173253], [73, 173373], [79, 173833], [81, 174093], [84, 174213], [87, 174333]]}, {"verse": 17, "start": 175500, "end": 182753, "text": "Y espigó en el campo hasta la tarde, y desgranó lo que había recogido, y fue como un efa de cebada.", "words": [[0, 175500], [2, 175620], [9, 176120], [12, 176240], [15, 176360], [21, 176720], [27, 176940], [30, 177100], [37, 177460], [39, 178070], [48, 178680], [51, 179120], [55, 179280], [61, 179540], [71, 180380], [73, 180720], [77, 180900], [82, 181200], [85, 181440], [89, 181896], [92, 182353]]}, {"verse": 18, "start": 183203, "end": 193909, "text": "Y lo tomó, y se vino a la ciudad; y su suegra vio lo que había recogido. Sacó también luego lo que le había sobrado después de harta, y se lo dio.", "words": [[0, 183203], [2, 183331], [5, 183431], [11, 183871], [13, 184451], [16, 184611], [21, 184831], [23, 184991], [26, 185071], [34, 186053], [36, 186170], [39, 186290], [46, 186830], [50, 187230], [53, 187370], [57, 187530], [63, 187750], [73, 188964], [78, 189390], [86, 189690], [92, 190170], [95, 190470], [99, 190630], [102, 190790], [108, 191010], [116, 191590], [124, 191890], [127, 192300], [134, 192710], [136, 193210], [139, 193390], [142, 193530]]}, {"verse": 19, "start": 194359, "end": 211442, "text": "Y le dijo su suegra: ¿Dónde has espigado hoy? ¿y dónde has trabajado? bendito sea el que te ha favorecido. Y ella declaró a su suegra lo que le había acontecido con aquel, y dijo: El nombre del varón con quien hoy he trabajado es Booz.", "words": [[0, 194359], [2, 194486], [5, 194676], [10, 194866], [13, 195066], [21, 196029], [28, 196269], [32, 196679], [41, 197089], [46, 197861], [49, 197986], [55, 198166], [59, 198446], [70, 199656], [78, 200163], [82, 200423], [85, 200643], [89, 200783], [92, 200943], [95, 201063], [107, 202266], [109, 202435], [114, 202755], [122, 203375], [124, 203475], [127, 203615], [134, 204055], [137, 204215], [141, 204355], [144, 204495], [150, 204775], [161, 205575], [165, 205775], [172, 206235], [174, 206855], [180, 207591], [183, 207738], [190, 208078], [194, 208358], [200, 208798], [204, 209078], [210, 209338], [214, 209528], [217, 209718], [227, 210458], [230, 210981]]}, {"verse": 20, "start": 211792, "end": 230257, "text": "Y dijo Noemí a su nuera: Sea él bendito de Jehová, pues que no ha rehusado a los vivos la benevolencia que tuvo para con los que han muerto. Le dijo después Noemí: Nuestro pariente es aquel varón, y uno de los que pueden redimirnos.", "words": [[0, 211792], [2, 211917], [7, 212237], [13, 212737], [15, 213217], [18, 213397], [25, 214301], [29, 214641], [32, 215041], [40, 215741], [43, 215901], [51, 216781], [56, 216961], [60, 217181], [63, 217441], [66, 217641], [75, 218261], [77, 218381], [81, 218501], [87, 218921], [90, 219061], [103, 219821], [107, 220001], [112, 220301], [117, 220581], [121, 220821], [125, 220981], [129, 221141], [133, 221281], [141, 223332], [144, 223442], [149, 223722], [157, 224547], [164, 225568], [172, 226073], [181, 226613], [184, 226933], [190, 227273], [197, 227713], [199, 228213], [203, 228413], [206, 228553], [210, 228693], [214, 228873], [221, 229213]]}, {"verse": 21, "start": 230607, "end": 240713, "text": "Y Ruth moabita dijo: A más de esto me ha dicho: Júntate con mis criadas, hasta que hayan acabado toda mi siega.", "words": [[0, 230607], [2, 230814], [7, 231354], [15, 232434], [21, 233269], [23, 233376], [27, 233556], [30, 233796], [35, 234076], [38, 234296], [41, 234416], [48, 235270], [56, 235690], [60, 235950], [64, 236110], [73, 236810], [79, 237150], [83, 237330], [89, 237650], [97, 238130], [102, 238370], [105, 239542]]}, {"verse": 22, "start": 241063, "end": 250522, "text": "Y Noemí respondió a Ruth su nuera: Mejor es, hija mía, que salgas con sus criadas, y que no te encuentren en otro campo.", "words": [[0, 241063], [2, 241188], [8, 241628], [18, 242588], [20, 242808], [25, 243108], [28, 243568], [35, 244341], [41, 244701], [45, 244961], [50, 245341], [55, 245861], [59, 246061], [66, 246501], [70, 246681], [74, 246861], [83, 247421], [85, 247921], [89, 248041], [92, 248201], [95, 248321], [106, 248861], [109, 248981], [114, 249181]]}, {"verse": 23, "start": 250872, "end": 261401, "text": "Estuvo pues junta con las criadas de Booz espigando, hasta que la siega de las cebadas y la de los trigos fue acabada; mas con su suegra habitó.", "words": [[0, 250872], [7, 251234], [12, 251454], [18, 251894], [22, 252094], [26, 252294], [34, 252894], [37, 253594], [42, 254294], [53, 254994], [59, 255714], [63, 255894], [66, 256204], [72, 256514], [75, 256614], [79, 256774], [87, 257294], [89, 257474], [92, 257574], [95, 257674], [99, 257904], [106, 258134], [110, 258294], [119, 259332], [123, 259460], [127, 259680], [130, 260110], [137, 260540]]}]}