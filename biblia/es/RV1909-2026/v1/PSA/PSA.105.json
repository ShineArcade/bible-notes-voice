{"book": "PSA", "chapter": 105, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 244750, "verses": [{"verse": 1, "start": 300, "end": 7091, "text": "Alabad a Jehová, invocad su nombre: haced notorias sus obras en los pueblos.", "words": [[0, 300], [7, 823], [9, 1003], [17, 2203], [25, 2823], [28, 3023], [36, 3999], [42, 4552], [51, 5142], [55, 5402], [61, 5842], [64, 6102], [68, 6242]]}, {"verse": 2, "start": 7091, "end": 11964, "text": "Cantadle, cantadle salmos: hablad de todas sus maravillas.", "words": [[0, 7091], [10, 8291], [19, 9031], [27, 10069], [34, 10199], [37, 10539], [43, 10719], [47, 10999]]}, {"verse": 3, "start": 12314, "end": 18714, "text": "Gloriaos en su santo nombre: alégrese el corazón de los que buscan a Jehová.", "words": [[0, 12643], [9, 13003], [12, 13282], [15, 13463], [21, 13903], [29, 15126], [38, 15586], [41, 15926], [49, 16486], [52, 16846], [56, 16966], [60, 17126], [67, 17546], [69, 17666]]}, {"verse": 4, "start": 19065, "end": 23752, "text": "Buscad a Jehová, y su fortaleza: buscad siempre su rostro.", "words": [[0, 19065], [7, 19065], [9, 19332], [17, 19972], [19, 20092], [22, 20232], [33, 21627], [40, 21807], [48, 22407], [51, 22867]]}, {"verse": 5, "start": 24102, "end": 29696, "text": "Acordaos de sus maravillas que hizo, de sus prodigios y de los juicios de su boca,", "words": [[0, 24386], [9, 24706], [12, 24866], [16, 25006], [27, 25626], [31, 26176], [37, 26726], [40, 26806], [44, 26966], [54, 27826], [56, 28226], [59, 28346], [63, 28486], [71, 28866], [74, 29046], [77, 29206]]}, {"verse": 6, "start": 29696, "end": 36097, "text": "Oh vosotros, descendencia de Abraham su siervo, hijos de Jacob, sus escogidos.", "words": [[0, 29801], [3, 29906], [13, 30826], [26, 31866], [29, 32066], [37, 32786], [40, 32866], [48, 33806], [54, 34106], [57, 34326], [64, 35086], [68, 35166]]}, {"verse": 7, "start": 36447, "end": 40976, "text": "Él es Jehová nuestro Dios; en toda la tierra son sus juicios.", "words": [[0, 36644], [3, 36879], [6, 37114], [13, 37349], [21, 37649], [27, 38459], [30, 38614], [35, 38854], [38, 39074], [45, 39394], [49, 39834], [53, 40094]]}, {"verse": 8, "start": 41326, "end": 46381, "text": "Se acordó para siempre de su pacto; de la palabra que mandó para mil generaciones,", "words": [[0, 41326], [3, 41451], [10, 41911], [15, 42091], [23, 42511], [26, 42711], [29, 42851], [36, 43526], [39, 43833], [42, 43953], [50, 44293], [54, 44513], [60, 44913], [65, 45093], [69, 45353]]}, {"verse": 9, "start": 46731, "end": 50959, "text": "La cual concertó con Abraham; y de su juramento a Isaac.", "words": [[0, 46731], [3, 46856], [8, 47056], [17, 47816], [21, 47996], [30, 49065], [32, 49173], [35, 49293], [38, 49453], [48, 50113], [50, 50333]]}, {"verse": 10, "start": 51309, "end": 56550, "text": "Y la estableció a Jacob por decreto, a Israel por pacto sempiterno,", "words": [[0, 51309], [2, 51400], [5, 51530], [16, 52150], [18, 52310], [24, 52650], [28, 53090], [37, 54015], [39, 54115], [46, 54515], [50, 55210], [56, 55906]]}, {"verse": 11, "start": 56900, "end": 61495, "text": "Diciendo: A ti daré la tierra de Canaán por cordel de vuestra heredad.", "words": [[0, 56900], [10, 57984], [12, 58145], [15, 58345], [20, 58765], [23, 58825], [30, 59125], [33, 59325], [40, 59765], [44, 60085], [51, 60545], [54, 60705], [62, 61045]]}, {"verse": 12, "start": 62022, "end": 66787, "text": "Esto siendo ellos pocos hombres en número, y extranjeros en ella.", "words": [[0, 62022], [5, 62828], [12, 63108], [18, 63388], [24, 63888], [32, 64168], [35, 64428], [43, 64848], [45, 65308], [57, 66148], [60, 66328]]}, {"verse": 13, "start": 67137, "end": 71430, "text": "Y anduvieron de nación en nación, de un reino a otro pueblo.", "words": [[0, 67137], [2, 67474], [13, 67844], [16, 67984], [23, 68384], [26, 68584], [34, 69104], [37, 69724], [40, 69904], [46, 70344], [48, 70464], [53, 70664]]}, {"verse": 14, "start": 71780, "end": 77726, "text": "No consintió que hombre los agraviase; y por causa de ellos castigó los reyes.", "words": [[0, 71780], [3, 71909], [13, 72609], [17, 72809], [24, 73149], [28, 73409], [39, 74627], [41, 74750], [45, 74950], [51, 75490], [54, 75750], [60, 76030], [68, 76770], [72, 76930]]}, {"verse": 15, "start": 77946, "end": 83181, "text": "No toquéis, dijo, a mis ungidos, ni hagáis mal a mis profetas.", "words": [[0, 77946], [3, 78122], [12, 79436], [18, 80210], [20, 80331], [24, 80471], [33, 81051], [36, 81331], [43, 81651], [47, 81931], [49, 82191], [53, 82311]]}, {"verse": 16, "start": 83710, "end": 88571, "text": "Y llamó al hambre sobre la tierra, y quebrantó todo mantenimiento de pan.", "words": [[0, 83710], [2, 83831], [8, 84171], [11, 84311], [18, 84671], [24, 84911], [27, 85171], [35, 85671], [37, 86086], [47, 86746], [52, 86966], [66, 87846], [69, 88046]]}, {"verse": 17, "start": 88921, "end": 93240, "text": "Envió un varón delante de ellos, a José, que fue vendido por siervo.", "words": [[0, 88921], [6, 89247], [9, 89407], [15, 89787], [23, 90187], [26, 90367], [33, 90647], [35, 90847], [41, 91447], [45, 91667], [49, 91867], [57, 92347], [61, 92507]]}, {"verse": 18, "start": 93590, "end": 98418, "text": "Afligieron sus pies con grillos; en hierro fue puesta su persona.", "words": [[0, 93590], [11, 94390], [15, 94610], [20, 94910], [24, 95210], [33, 96257], [36, 96455], [43, 96895], [47, 97075], [54, 97535], [57, 97635]]}, {"verse": 19, "start": 98768, "end": 102526, "text": "Hasta la hora que llegó su palabra, el dicho de Jehová le probó.", "words": [[0, 98768], [6, 98974], [9, 99174], [14, 99334], [18, 99514], [24, 99774], [27, 99974], [36, 100794], [39, 100894], [45, 101154], [48, 101354], [55, 101794], [58, 101854]]}, {"verse": 20, "start": 102876, "end": 107911, "text": "Envió el rey, y le soltó; el señor de los pueblos, y le desató.", "words": [[0, 102876], [6, 103119], [9, 103399], [14, 104079], [16, 104239], [19, 104676], [26, 105274], [29, 105399], [35, 105759], [38, 106019], [42, 106159], [51, 106839], [53, 107039], [56, 107139]]}, {"verse": 21, "start": 108261, "end": 113670, "text": "Lo puso por señor de su casa, y por gobernador de todas sus posesiones;", "words": [[0, 108261], [3, 108401], [8, 108821], [12, 109041], [18, 109361], [21, 109621], [24, 109781], [30, 110161], [32, 110781], [36, 111021], [47, 111781], [50, 112001], [56, 112281], [60, 112621]]}, {"verse": 22, "start": 114020, "end": 121263, "text": "Para que reprimiera a sus grandes como él quisiese, y a sus ancianos enseñara sabiduría.", "words": [[0, 114020], [5, 114206], [9, 114426], [20, 115426], [22, 115666], [26, 115826], [34, 116306], [39, 116706], [42, 116946], [52, 117606], [54, 118346], [56, 118446], [60, 118586], [69, 119466], [78, 120346]]}, {"verse": 23, "start": 121613, "end": 127262, "text": "Después entró Israel en Egipto, y Jacob fue extranjero en la tierra de Cam.", "words": [[0, 121613], [8, 121932], [14, 122472], [21, 122852], [24, 123192], [32, 123872], [34, 124332], [40, 124652], [44, 125132], [55, 125952], [58, 126052], [61, 126172], [68, 126532], [71, 126752]]}, {"verse": 24, "start": 127612, "end": 132219, "text": "Y multiplicó su pueblo en gran manera, y lo hizo fuerte más que sus enemigos.", "words": [[0, 127612], [2, 127737], [13, 128417], [16, 128557], [23, 128997], [26, 129177], [31, 129397], [39, 129917], [41, 130097], [44, 130257], [49, 130457], [56, 130857], [60, 131117], [64, 131277], [68, 131457]]}, {"verse": 25, "start": 132569, "end": 139256, "text": "Volvió el corazón de ellos para que aborreciesen a su pueblo, para que contra sus siervos pensasen mal.", "words": [[0, 132569], [7, 133056], [10, 133156], [18, 133576], [21, 133876], [27, 134096], [32, 134396], [36, 134556], [49, 135276], [51, 135416], [54, 135556], [62, 136116], [67, 136516], [71, 136676], [78, 137016], [82, 137236], [90, 138086], [99, 138936]]}, {"verse": 26, "start": 139606, "end": 143749, "text": "Envió a su siervo Moisés, y a Aarón al cual escogió.", "words": [[0, 139606], [6, 140068], [8, 140288], [11, 140448], [18, 140868], [26, 141408], [28, 141788], [30, 142118], [36, 142448], [39, 142568], [44, 142828]]}, {"verse": 27, "start": 144099, "end": 149790, "text": "Pusieron en ellos las palabras de sus señales, y sus prodigios en la tierra de Cam.", "words": [[0, 144099], [9, 144583], [12, 144763], [18, 145023], [22, 145263], [31, 145683], [34, 145923], [38, 146083], [47, 147123], [49, 147283], [53, 147443], [63, 148203], [66, 148403], [69, 148583], [76, 148903], [79, 149163]]}, {"verse": 28, "start": 150140, "end": 155641, "text": "Echó tinieblas, e hizo oscuridad; y no fueron rebeldes a su palabra.", "words": [[0, 150336], [5, 150556], [16, 151396], [18, 151596], [23, 151936], [34, 153279], [36, 153403], [39, 153523], [46, 153843], [55, 154623], [57, 154763], [60, 154883]]}, {"verse": 29, "start": 155991, "end": 159614, "text": "Volvió sus aguas en sangre, y mató sus pescados.", "words": [[0, 155991], [7, 156434], [11, 156574], [17, 157034], [20, 157194], [28, 157654], [30, 158134], [35, 158474], [39, 158654]]}, {"verse": 30, "start": 159964, "end": 164226, "text": "Produjo su tierra ranas, aun en las cámaras de sus reyes.", "words": [[0, 159964], [8, 160388], [11, 160588], [18, 160948], [25, 162048], [29, 162468], [32, 162688], [36, 162848], [44, 163368], [47, 163468], [51, 163628]]}, {"verse": 31, "start": 164576, "end": 169733, "text": "Dijo, y vinieron enjambres de moscas, y piojos en todo su término.", "words": [[0, 164576], [6, 164902], [8, 165402], [17, 166002], [27, 166602], [30, 166742], [38, 167362], [40, 167622], [47, 168082], [50, 168342], [55, 168662], [58, 168922]]}, {"verse": 32, "start": 170083, "end": 174709, "text": "Volvió en su tierra sus lluvias en granizo, y en fuego de llamaradas.", "words": [[0, 170083], [7, 170569], [10, 170669], [13, 170829], [20, 171189], [24, 171489], [32, 172029], [35, 172209], [44, 172749], [46, 173229], [49, 173369], [55, 173629], [58, 173889]]}, {"verse": 33, "start": 175059, "end": 180655, "text": "E hirió sus viñas y sus higueras, y quebró los árboles de su término.", "words": [[0, 175059], [2, 175206], [8, 175686], [12, 175906], [18, 176586], [20, 176866], [24, 177046], [34, 177626], [36, 178146], [43, 178546], [47, 178726], [55, 179366], [58, 179726], [61, 179906]]}, {"verse": 34, "start": 181005, "end": 185440, "text": "Dijo, y vinieron langostas, y pulgón sin número;", "words": [[0, 181005], [6, 181910], [8, 182130], [17, 182590], [28, 183650], [30, 183970], [37, 184530], [41, 184790]]}, {"verse": 35, "start": 185790, "end": 190620, "text": "Y comieron toda la hierba de su país, y devoraron el fruto de su tierra.", "words": [[0, 185790], [2, 186035], [11, 186455], [16, 186735], [19, 186975], [26, 187395], [29, 187535], [32, 187695], [38, 188075], [40, 188535], [50, 189095], [53, 189315], [59, 189715], [62, 189835], [65, 189975]]}, {"verse": 36, "start": 190970, "end": 196652, "text": "Hirió además a todos los primogénitos en su tierra, el principio de toda su fuerza.", "words": [[0, 191134], [6, 191334], [13, 191734], [15, 191934], [21, 192154], [25, 192374], [38, 193134], [41, 193314], [44, 193454], [52, 193874], [55, 194474], [65, 195214], [68, 195514], [73, 195714], [76, 195994]]}, {"verse": 37, "start": 197002, "end": 201540, "text": "Y los sacó con plata y oro; y no hubo en sus tribus enfermo.", "words": [[0, 197002], [2, 197095], [6, 197215], [11, 197735], [15, 197975], [21, 198275], [23, 198635], [28, 199165], [30, 199425], [33, 199585], [38, 200045], [41, 200165], [45, 200365], [52, 200785]]}, {"verse": 38, "start": 201890, "end": 207431, "text": "Egipto se alegró de que salieran; porque su terror había caído sobre ellos.", "words": [[0, 201890], [7, 202476], [10, 202636], [17, 203096], [20, 203176], [24, 203758], [34, 204500], [41, 204705], [44, 204905], [51, 205425], [57, 205785], [63, 206325], [69, 206645]]}, {"verse": 39, "start": 207781, "end": 213510, "text": "Extendió una nube por cubierta, y fuego para alumbrar la noche.", "words": [[0, 207781], [9, 208566], [13, 208946], [18, 209386], [22, 209666], [32, 210586], [34, 211106], [40, 211546], [45, 211926], [54, 212586], [57, 212846]]}, {"verse": 40, "start": 213860, "end": 218845, "text": "Pidieron, e hizo venir codornices; y los sació de pan del cielo.", "words": [[0, 213860], [10, 214344], [12, 214684], [17, 214964], [23, 215304], [35, 216848], [37, 216969], [41, 217129], [47, 217549], [50, 217689], [54, 217969], [58, 218189]]}, {"verse": 41, "start": 219195, "end": 224347, "text": "Abrió la peña, y fluyeron aguas; corrieron por los lugares secos como un río.", "words": [[0, 219195], [6, 219504], [9, 219664], [15, 220064], [17, 220224], [26, 220784], [33, 221689], [43, 222151], [47, 222271], [51, 222451], [59, 222791], [65, 223371], [70, 223551], [73, 223771]]}, {"verse": 42, "start": 224697, "end": 229279, "text": "Porque se acordó de su santa palabra, dada a Abraham su siervo.", "words": [[0, 224697], [7, 224860], [10, 225080], [17, 225560], [20, 225660], [23, 225800], [29, 226200], [38, 227140], [43, 227640], [45, 227880], [53, 228120], [56, 228560]]}, {"verse": 43, "start": 229629, "end": 233942, "text": "Y sacó a su pueblo con gozo; con júbilo a sus escogidos.", "words": [[0, 229629], [2, 229750], [7, 230150], [9, 230250], [12, 230370], [19, 230750], [23, 231030], [29, 231947], [33, 232112], [40, 232712], [42, 232872], [46, 232992]]}, {"verse": 44, "start": 234292, "end": 238968, "text": "Y les dio las tierras de las naciones; y heredaron las labores de los pueblos:", "words": [[0, 234292], [2, 234419], [6, 234579], [10, 234759], [14, 234939], [22, 235499], [25, 235639], [29, 235779], [39, 236734], [41, 236881], [51, 237441], [55, 237621], [63, 238081], [66, 238221], [70, 238321]]}, {"verse": 45, "start": 239318, "end": 244350, "text": "Para que guardasen sus estatutos, y observasen sus leyes. Aleluya.", "words": [[0, 239318], [5, 239462], [9, 239902], [19, 240342], [23, 240522], [34, 241222], [36, 241822], [47, 242422], [51, 242602], [58, 243945]]}]}