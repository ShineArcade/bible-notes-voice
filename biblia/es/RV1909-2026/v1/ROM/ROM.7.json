{"book": "ROM", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 171155, "verses": [{"verse": 1, "start": 300, "end": 6966, "text": "¿Ignoráis, hermanos, (porque hablo con los que saben la ley) que la ley tiene autoridad sobre una persona mientras vive?", "words": [[0, 300], [11, 845], [21, 1805], [29, 2145], [35, 2525], [39, 2665], [43, 2785], [47, 2905], [53, 3165], [56, 3345], [61, 3678], [65, 3820], [68, 3980], [72, 4180], [78, 4500], [88, 5120], [94, 5400], [98, 5600], [106, 6040], [115, 6340]]}, {"verse": 2, "start": 7316, "end": 15564, "text": "Porque la mujer que está sujeta a marido, mientras el marido vive está obligada a la ley; pero muerto el marido, libre es de la ley del marido.", "words": [[0, 7316], [7, 7505], [10, 7705], [16, 7985], [20, 8245], [25, 8505], [32, 9125], [34, 9125], [42, 9545], [51, 9805], [54, 10145], [61, 10525], [66, 10785], [71, 11145], [80, 11725], [82, 11825], [85, 11905], [90, 12528], [95, 12652], [102, 13132], [105, 13272], [113, 13912], [119, 14232], [122, 14472], [125, 14592], [128, 14712], [132, 14892], [136, 15032]]}, {"verse": 3, "start": 15914, "end": 26045, "text": "Así que, viviendo el marido, se llamará adúltera si es de otro varón; pero si su marido muere, es libre de la ley; de tal manera que no será adúltera si es de otro marido.", "words": [[0, 15914], [4, 16084], [9, 16264], [18, 16684], [21, 16824], [29, 17284], [32, 17624], [40, 18024], [49, 18564], [52, 18924], [55, 19064], [58, 19204], [63, 19404], [70, 20133], [75, 20255], [78, 20415], [81, 20575], [88, 20935], [95, 21475], [98, 21635], [104, 21895], [107, 22095], [110, 22215], [115, 22752], [118, 22872], [122, 23052], [129, 23412], [133, 23652], [136, 23812], [141, 24052], [150, 24652], [153, 24932], [156, 25112], [159, 25232], [164, 25452]]}, {"verse": 4, "start": 26395, "end": 38065, "text": "Así también vosotros, hermanos míos, estáis muertos a la ley por el cuerpo de Cristo, para que seáis de otro, a saber, del que resucitó de los muertos, a fin de que fructifiquemos a Dios.", "words": [[0, 26395], [4, 26611], [12, 27051], [22, 27611], [31, 28031], [37, 28731], [44, 29131], [52, 29551], [54, 29731], [57, 29811], [61, 30031], [65, 30211], [68, 30311], [75, 30571], [78, 30791], [86, 31191], [91, 31751], [95, 31891], [101, 32271], [104, 32431], [110, 33051], [112, 33131], [119, 33531], [123, 34071], [127, 34211], [136, 34911], [139, 34991], [143, 35111], [152, 36033], [154, 36133], [158, 36333], [161, 36513], [165, 36633], [180, 37473], [182, 37613]]}, {"verse": 5, "start": 38415, "end": 46103, "text": "Porque mientras estábamos en la carne, las pasiones pecaminosas que eran por la ley, obraban en nuestros miembros fructificando para muerte.", "words": [[0, 38415], [7, 38559], [16, 38899], [26, 39579], [29, 39759], [32, 39859], [39, 40739], [43, 40839], [52, 41279], [64, 42039], [68, 42299], [73, 42499], [77, 42699], [80, 42839], [85, 43119], [93, 43779], [96, 43879], [105, 44079], [114, 44699], [128, 45519], [133, 45719]]}, {"verse": 6, "start": 46453, "end": 55319, "text": "Pero ahora estamos libres de la ley, habiendo muerto a aquella en la cual estábamos detenidos, para que sirvamos en novedad de espíritu, y no en vejez de letra.", "words": [[0, 46453], [5, 46582], [11, 46842], [19, 47182], [26, 47642], [29, 47742], [32, 47862], [37, 48422], [46, 48742], [53, 48932], [55, 49122], [63, 49582], [66, 49702], [69, 49782], [74, 49962], [84, 50542], [95, 51182], [100, 51682], [104, 51822], [113, 52342], [116, 52522], [124, 52962], [127, 53082], [137, 53862], [139, 54022], [142, 54249], [145, 54475], [151, 54702], [154, 54862]]}, {"verse": 7, "start": 55669, "end": 66156, "text": "¿Qué pues diremos? ¿La ley es pecado? En ninguna manera. Pero yo no conocí el pecado sino por la ley: porque tampoco conociera la codicia, si la ley no dijera: No codiciarás.", "words": [[0, 55669], [5, 55771], [10, 55951], [19, 56784], [23, 56908], [27, 57068], [30, 57268], [38, 58107], [41, 58247], [49, 58547], [57, 59415], [62, 59539], [65, 59679], [68, 59799], [75, 60219], [78, 60319], [85, 60699], [90, 60919], [94, 61179], [97, 61299], [102, 61913], [109, 62067], [117, 62387], [127, 63027], [130, 63147], [139, 63687], [142, 63847], [145, 63987], [149, 64167], [152, 64267], [160, 65087], [163, 65210]]}, {"verse": 8, "start": 66506, "end": 74050, "text": "Pero el pecado, tomando ocasión, obró en mí por el mandamiento toda clase de codicia: porque sin la ley el pecado está muerto.", "words": [[0, 66506], [5, 66646], [8, 66786], [16, 67226], [24, 67666], [33, 68506], [38, 69026], [41, 69166], [44, 69286], [48, 69506], [51, 69606], [63, 70186], [68, 70506], [74, 70906], [77, 71046], [86, 71938], [93, 72118], [97, 72318], [100, 72498], [104, 72698], [107, 72858], [114, 73298], [119, 73498]]}, {"verse": 9, "start": 74400, "end": 80516, "text": "Así que, yo sin la ley vivía por algún tiempo: pero venido el mandamiento, el pecado revivió, y yo morí.", "words": [[0, 74400], [4, 74645], [9, 74825], [12, 75025], [16, 75225], [19, 75385], [23, 75605], [29, 75965], [33, 76125], [39, 76345], [47, 77133], [52, 77290], [59, 77650], [62, 77750], [75, 78570], [78, 78690], [85, 79070], [94, 79670], [96, 79970], [99, 80090]]}, {"verse": 10, "start": 80866, "end": 84845, "text": "Y hallé que el mandamiento, destinado a dar vida, para mí era mortal:", "words": [[0, 80866], [2, 80969], [8, 81209], [12, 81309], [15, 81409], [28, 82029], [38, 82949], [40, 83049], [44, 83149], [50, 83449], [55, 83789], [58, 84009], [62, 84269]]}, {"verse": 11, "start": 85195, "end": 90143, "text": "Porque el pecado, tomando ocasión, me engañó por el mandamiento, y por él me mató.", "words": [[0, 85195], [7, 85426], [10, 85566], [18, 85986], [26, 86446], [35, 87106], [38, 87486], [45, 87986], [49, 88166], [52, 88286], [65, 88966], [67, 89286], [71, 89486], [74, 89606], [77, 89726]]}, {"verse": 12, "start": 90493, "end": 95255, "text": "De manera que la ley a la verdad es santa, y el mandamiento santo, y justo, y bueno.", "words": [[0, 90493], [3, 90594], [10, 90794], [14, 91054], [17, 91214], [21, 91434], [23, 91534], [26, 91614], [33, 91894], [36, 92154], [43, 92614], [45, 92914], [48, 93014], [60, 93534], [67, 94114], [69, 94314], [76, 94614], [78, 94814]]}, {"verse": 13, "start": 95605, "end": 105946, "text": "¿Luego lo que es bueno, a mí me es hecho muerte? No; sino que el pecado, para mostrarse pecado, por lo bueno me obró la muerte, haciéndose pecado sumamente pecaminoso por el mandamiento.", "words": [[0, 95605], [7, 95825], [10, 96005], [14, 96125], [17, 96265], [24, 96785], [26, 96805], [29, 96945], [32, 97045], [35, 97145], [41, 97365], [49, 98226], [53, 98810], [58, 99012], [62, 99232], [65, 99372], [73, 99752], [78, 99972], [88, 100532], [96, 100952], [100, 101152], [103, 101312], [109, 101532], [112, 101712], [117, 101912], [120, 102012], [128, 102752], [139, 103252], [146, 103672], [156, 104212], [167, 104872], [171, 105072], [174, 105172]]}, {"verse": 14, "start": 106296, "end": 111765, "text": "Porque sabemos que la ley es espiritual; pero yo soy carnal, vendido a sujeción del pecado.", "words": [[0, 106296], [7, 106491], [15, 106851], [19, 107131], [22, 107251], [26, 107451], [29, 107651], [41, 108722], [46, 108860], [49, 109060], [53, 109280], [61, 109940], [69, 110340], [71, 110420], [80, 111000], [84, 111140]]}, {"verse": 15, "start": 112115, "end": 117813, "text": "Porque lo que hago, no lo entiendo; ni lo que quiero, hago; antes lo que aborrezco, aquello hago.", "words": [[0, 112115], [7, 112314], [10, 112454], [14, 112614], [20, 112874], [23, 113154], [26, 113274], [36, 114145], [39, 114288], [42, 114428], [46, 114548], [54, 115068], [60, 115677], [66, 115941], [69, 116161], [73, 116281], [84, 116921], [92, 117421]]}, {"verse": 16, "start": 118163, "end": 121580, "text": "Y si lo que no quiero, esto hago, apruebo que la ley es buena.", "words": [[0, 118163], [2, 118270], [5, 118350], [8, 118470], [12, 118590], [15, 118710], [23, 119290], [28, 119510], [34, 120130], [42, 120530], [46, 120650], [49, 120770], [53, 120990], [56, 121130]]}, {"verse": 17, "start": 121930, "end": 125333, "text": "De manera que ya no obro aquello, sino el pecado que mora en mí.", "words": [[0, 121930], [3, 122054], [10, 122274], [14, 122554], [17, 122734], [20, 122874], [25, 123134], [34, 123634], [39, 123954], [42, 124134], [49, 124554], [53, 124714], [58, 124994], [61, 125074]]}, {"verse": 18, "start": 125683, "end": 132752, "text": "Y yo sé que en mí (es decir, en mi carne) no mora el bien: porque tengo el querer, pero efectuar el bien no lo alcanzo.", "words": [[0, 125683], [2, 125828], [5, 125968], [8, 126148], [12, 126328], [15, 126488], [18, 126968], [22, 127048], [29, 127648], [32, 127748], [35, 127868], [42, 128188], [45, 128468], [50, 128768], [53, 128828], [59, 129475], [66, 129661], [72, 129961], [75, 130121], [83, 130761], [88, 130921], [97, 131421], [100, 131561], [105, 131761], [108, 131981], [111, 132101]]}, {"verse": 19, "start": 133102, "end": 137062, "text": "Porque no hago el bien que quiero; pero el mal que no quiero, este hago.", "words": [[0, 133102], [7, 133286], [10, 133506], [15, 133706], [18, 133846], [23, 133986], [27, 134166], [35, 134875], [40, 135015], [43, 135175], [47, 135335], [51, 135535], [54, 135675], [62, 136375], [67, 136635]]}, {"verse": 20, "start": 137412, "end": 141424, "text": "Y si hago lo que no quiero, ya no lo hago yo, sino el pecado que mora en mí.", "words": [[0, 137412], [2, 137537], [5, 137657], [10, 137877], [13, 138017], [17, 138137], [20, 138277], [28, 138897], [31, 139077], [34, 139217], [37, 139357], [42, 139497], [46, 139877], [51, 140057], [54, 140217], [61, 140577], [65, 140737], [70, 141037], [73, 141137]]}, {"verse": 21, "start": 141774, "end": 146208, "text": "Así que, queriendo yo hacer el bien, hallo esta ley: Que el mal está en mí.", "words": [[0, 141774], [4, 142011], [9, 142211], [19, 142691], [22, 142871], [28, 143131], [31, 143351], [37, 143801], [43, 144251], [48, 144451], [53, 145056], [57, 145198], [60, 145278], [64, 145498], [69, 145778], [72, 145918]]}, {"verse": 22, "start": 146558, "end": 149910, "text": "Porque según el hombre interior, me deleito en la ley de Dios:", "words": [[0, 146558], [7, 146719], [13, 147079], [16, 147259], [23, 147439], [33, 147979], [36, 148379], [44, 148859], [47, 148979], [50, 149079], [54, 149239], [57, 149379]]}, {"verse": 23, "start": 150260, "end": 157684, "text": "Pero veo otra ley en mis miembros, que se rebela contra la ley de mi espíritu, y que me lleva cautivo a la ley del pecado que está en mis miembros.", "words": [[0, 150260], [5, 150420], [9, 150640], [14, 150940], [18, 151180], [21, 151340], [25, 151460], [35, 152000], [39, 152155], [42, 152435], [49, 152715], [56, 152975], [59, 153155], [63, 153315], [66, 153455], [69, 153555], [79, 154416], [81, 154495], [85, 154595], [88, 154715], [94, 154915], [102, 155415], [104, 155535], [107, 155595], [111, 155795], [115, 155955], [122, 156415], [126, 156555], [131, 156775], [134, 156895], [138, 157015]]}, {"verse": 24, "start": 158034, "end": 161866, "text": "¡Miserable hombre de mí! ¿quién me librará del cuerpo de esta muerte?", "words": [[0, 158034], [11, 158536], [18, 158916], [21, 159136], [25, 159637], [32, 159855], [35, 159955], [43, 160355], [47, 160535], [54, 160815], [57, 161095], [62, 161275]]}, {"verse": 25, "start": 162216, "end": 170755, "text": "Gracias doy a Dios, por Jesucristo Señor nuestro. Así que, yo mismo con la mente sirvo a la ley de Dios, pero con la carne a la ley del pecado.", "words": [[0, 162216], [8, 162555], [12, 162935], [14, 162995], [20, 163615], [24, 163735], [35, 164475], [41, 164655], [50, 165579], [54, 165731], [59, 165931], [62, 166091], [68, 166351], [72, 166611], [75, 166751], [81, 167011], [87, 167471], [89, 167571], [92, 167631], [96, 167831], [99, 167971], [105, 168651], [110, 168831], [114, 169031], [117, 169191], [123, 169511], [125, 169691], [128, 169791], [132, 169991], [136, 170151]]}]}