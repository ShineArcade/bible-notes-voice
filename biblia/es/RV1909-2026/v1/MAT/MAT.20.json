{"book": "MAT", "chapter": 20, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 290427, "verses": [{"verse": 1, "start": 300, "end": 8791, "text": "Porque el reino de los cielos es semejante a un propietario, que salió por la mañana a contratar trabajadores para su viña.", "words": [[0, 300], [7, 522], [10, 702], [16, 1082], [19, 1202], [23, 1362], [30, 1882], [33, 2082], [43, 2862], [45, 2982], [48, 3122], [61, 4082], [65, 4622], [71, 5042], [75, 5262], [78, 5462], [85, 5862], [87, 6202], [97, 6922], [110, 7702], [115, 8002], [118, 8182]]}, {"verse": 2, "start": 9241, "end": 15162, "text": "Y habiendo acordado con los obreros en un denario al día, los envió a su viña.", "words": [[0, 9241], [2, 9382], [11, 9762], [20, 10442], [24, 10642], [28, 11062], [36, 11482], [39, 11702], [42, 11843], [50, 12362], [53, 12582], [58, 13502], [62, 13762], [68, 14242], [70, 14382], [73, 14502]]}, {"verse": 3, "start": 15612, "end": 22384, "text": "Y saliendo cerca de la tercera hora del día, vio otros que estaban en la plaza ociosos;", "words": [[0, 15612], [2, 16036], [11, 16516], [17, 16856], [20, 17136], [23, 17256], [31, 17836], [36, 18116], [40, 18356], [45, 19216], [49, 19576], [55, 20036], [59, 20436], [67, 20796], [70, 20996], [73, 21116], [79, 21416]]}, {"verse": 4, "start": 22834, "end": 28977, "text": "Y les dijo: Id también vosotros a mi viña, y os daré lo que sea justo. Y ellos fueron.", "words": [[0, 22834], [2, 23103], [6, 23407], [12, 23993], [15, 24073], [23, 24373], [32, 25013], [34, 25213], [37, 25333], [43, 25753], [45, 26153], [48, 26293], [53, 26553], [56, 26633], [60, 26773], [64, 26933], [71, 27908], [73, 28074], [79, 28234]]}, {"verse": 5, "start": 29427, "end": 34115, "text": "Salió otra vez cerca de las horas sexta y novena, e hizo lo mismo.", "words": [[0, 29427], [6, 29849], [11, 30169], [15, 30429], [21, 30849], [24, 31089], [28, 31249], [34, 31449], [40, 32089], [42, 32189], [50, 32749], [52, 33029], [57, 33389], [60, 33589]]}, {"verse": 6, "start": 34565, "end": 44045, "text": "Y saliendo cerca de la hora undécima, halló otros que estaban ociosos; y les dice: ¿Por qué estáis aquí todo el día ociosos?", "words": [[0, 34565], [2, 34687], [11, 35167], [17, 35527], [20, 35807], [23, 35987], [28, 36577], [38, 37167], [44, 37687], [50, 38107], [54, 38387], [62, 38787], [71, 41353], [73, 41458], [77, 41563], [83, 41968], [88, 41968], [92, 41968], [99, 42216], [104, 42476], [109, 42695], [112, 42956], [116, 43116]]}, {"verse": 7, "start": 44495, "end": 53219, "text": "Le dicen: Porque nadie nos ha contratado. Les dice: Id también vosotros a la viña, y recibiréis lo que sea justo.", "words": [[0, 44495], [3, 44646], [10, 45531], [17, 45828], [23, 46188], [27, 46508], [30, 46688], [42, 48022], [46, 48112], [52, 49075], [55, 49175], [63, 49435], [72, 50095], [74, 50295], [77, 50375], [83, 50895], [85, 51335], [96, 52115], [99, 52275], [103, 52395], [107, 52575]]}, {"verse": 8, "start": 53669, "end": 64588, "text": "Y cuando fue la tarde del día, el señor de la viña dijo a su encargado: Llama a los obreros y págales el salario, comenzando desde los últimos hasta los primeros.", "words": [[0, 53669], [2, 53959], [9, 54119], [13, 54339], [16, 54479], [22, 54799], [26, 55119], [31, 55839], [34, 55959], [40, 56279], [43, 56459], [46, 56579], [51, 57039], [56, 57639], [58, 57859], [61, 57979], [72, 59138], [78, 59444], [80, 59664], [84, 59994], [92, 60324], [94, 60484], [102, 61064], [105, 61224], [114, 61944], [125, 62664], [131, 62844], [135, 63064], [143, 63424], [149, 63724], [153, 63904]]}, {"verse": 9, "start": 65038, "end": 71213, "text": "Y viniendo los que habían ido cerca de la hora undécima, recibieron cada uno un denario.", "words": [[0, 65038], [2, 65135], [11, 65615], [15, 65815], [19, 65975], [26, 66275], [30, 66515], [36, 66955], [39, 67235], [42, 67375], [47, 68035], [57, 68695], [68, 69395], [73, 69675], [77, 70055], [80, 70375]]}, {"verse": 10, "start": 71663, "end": 80557, "text": "Y viniendo también los primeros, pensaron que habían de recibir más; pero también ellos recibieron cada uno un denario.", "words": [[0, 71663], [2, 71910], [11, 72190], [19, 72550], [23, 72790], [33, 73750], [42, 74590], [46, 74830], [53, 75150], [56, 75370], [64, 75790], [69, 76857], [74, 77193], [82, 77613], [88, 77973], [99, 78993], [104, 79253], [108, 79553], [111, 79753]]}, {"verse": 11, "start": 81007, "end": 84673, "text": "Y tomándolo, murmuraban contra el padre de la familia,", "words": [[0, 81007], [2, 81084], [13, 81684], [24, 82504], [31, 82904], [34, 83124], [40, 83464], [43, 83724], [46, 83844]]}, {"verse": 12, "start": 85123, "end": 94955, "text": "Diciendo: Estos últimos sólo han trabajado una hora, y los has hecho iguales a nosotros, que hemos llevado la carga y el calor del día.", "words": [[0, 85123], [10, 86407], [16, 86829], [24, 87209], [29, 87609], [33, 87829], [43, 88489], [47, 88769], [53, 89109], [55, 89629], [59, 89789], [63, 90009], [69, 90469], [77, 91209], [79, 91329], [89, 91749], [93, 92289], [99, 92449], [107, 92889], [110, 93069], [116, 93449], [118, 93669], [121, 93789], [127, 94109], [131, 94389]]}, {"verse": 13, "start": 95405, "end": 104023, "text": "Y él respondiendo, dijo a uno de ellos: Amigo, no cometo injusticia contigo; ¿no te concertaste conmigo por un denario?", "words": [[0, 95405], [2, 95665], [5, 95805], [19, 96565], [24, 96845], [26, 97065], [30, 97245], [33, 97405], [40, 98916], [47, 99326], [50, 99426], [57, 99946], [68, 100606], [77, 101694], [81, 101780], [84, 101900], [96, 102520], [104, 102960], [108, 103200], [111, 103340]]}, {"verse": 14, "start": 104473, "end": 108742, "text": "Toma lo que es tuyo, y vete; pero quiero dar a este último, como a ti.", "words": [[0, 104473], [5, 104678], [8, 104818], [12, 104938], [15, 105098], [21, 105438], [23, 105638], [29, 106408], [34, 106532], [41, 106812], [45, 107092], [47, 107252], [52, 107652], [60, 108052], [65, 108252], [67, 108432]]}, {"verse": 15, "start": 109192, "end": 115905, "text": "¿No me es lícito a mí hacer lo que quiero con lo mío? o ¿es malo tu ojo, porque yo soy bueno?", "words": [[0, 109192], [4, 109356], [7, 109536], [10, 109716], [17, 110276], [19, 110476], [22, 110596], [28, 110896], [31, 111136], [35, 111276], [42, 111556], [46, 111756], [49, 111916], [54, 112711], [56, 112965], [60, 113085], [65, 113565], [68, 113725], [73, 114525], [80, 114865], [83, 115085], [87, 115285]]}, {"verse": 16, "start": 116355, "end": 125048, "text": "Así los primeros serán últimos, y los últimos primeros: porque muchos son llamados, pero pocos escogidos.", "words": [[0, 116355], [4, 116554], [8, 116754], [17, 117454], [23, 118074], [32, 118634], [34, 119274], [38, 119454], [46, 119874], [56, 121111], [63, 121354], [70, 121814], [74, 122294], [84, 123014], [89, 123274], [95, 124074]]}, {"verse": 17, "start": 125498, "end": 131428, "text": "Y subiendo Jesús a Jerusalén, tomó sus doce discípulos aparte en el camino, y les dijo:", "words": [[0, 125498], [2, 125603], [11, 126063], [17, 126423], [19, 126683], [30, 127763], [35, 128043], [39, 128243], [44, 128743], [55, 129463], [62, 130063], [65, 130163], [68, 130283], [76, 130643], [78, 130803], [82, 130923]]}, {"verse": 18, "start": 131878, "end": 141903, "text": "He aquí subimos a Jerusalén, y el Hijo del hombre será entregado a los príncipes de los sacerdotes y a los escribas, y le condenarán a muerte;", "words": [[0, 131930], [3, 132020], [8, 132240], [16, 132800], [18, 132940], [29, 133940], [31, 134220], [34, 134340], [39, 134620], [43, 134760], [50, 135200], [55, 135440], [65, 136180], [67, 136260], [71, 136380], [81, 137160], [84, 137280], [88, 137420], [99, 138260], [101, 138640], [103, 138700], [107, 138820], [117, 140100], [119, 140200], [122, 140320], [133, 141120], [135, 141260]]}, {"verse": 19, "start": 142353, "end": 151899, "text": "Y le entregarán a los Gentiles para que se burlen de él, lo azoten y lo crucifiquen; pero al tercer día resucitará.", "words": [[0, 142353], [2, 142477], [5, 142597], [16, 143297], [18, 143377], [22, 143497], [31, 144117], [36, 144657], [40, 144817], [43, 144997], [50, 145457], [53, 145657], [57, 146497], [60, 146847], [67, 147197], [69, 147897], [72, 148520], [85, 149371], [90, 149671], [93, 149871], [100, 150171], [104, 150611]]}, {"verse": 20, "start": 152349, "end": 159942, "text": "Entonces se llegó a él la madre de los hijos de Zebedeo con sus hijos, adorándole, y pidiéndole algo.", "words": [[0, 152349], [9, 152791], [12, 153111], [18, 153431], [20, 153711], [23, 154191], [26, 154271], [32, 154631], [35, 154831], [39, 154971], [45, 155291], [48, 155771], [56, 156251], [60, 156351], [64, 156591], [71, 157391], [83, 158211], [85, 158651], [96, 159351]]}, {"verse": 21, "start": 160392, "end": 170642, "text": "Y él le dijo: ¿Qué quieres? Ella le dijo: Di que se sienten estos dos hijos míos, el uno a tu mano derecha, y el otro a tu izquierda, en tu reino.", "words": [[0, 160392], [2, 160561], [5, 160681], [8, 160821], [14, 161556], [19, 161680], [28, 162559], [33, 162784], [36, 162984], [42, 164408], [45, 164458], [49, 164558], [52, 164698], [60, 165218], [66, 165478], [70, 165758], [76, 165998], [82, 166778], [85, 166918], [89, 167138], [91, 167278], [94, 167358], [99, 167558], [108, 168218], [110, 168538], [113, 168658], [118, 168858], [120, 168998], [123, 169098], [134, 169918], [137, 169998], [140, 170138]]}, {"verse": 22, "start": 170992, "end": 186917, "text": "Entonces Jesús respondiendo, dijo: No sabéis lo que pedís: ¿podéis beber la copa que yo he de beber, y ser bautizados del bautismo de que yo soy bautizado? Y ellos le dicen: Podemos.", "words": [[0, 170992], [9, 171501], [15, 172601], [29, 173421], [35, 174146], [38, 174335], [45, 174855], [48, 175035], [52, 175175], [59, 176089], [67, 176393], [73, 176673], [76, 176933], [81, 177313], [85, 177413], [88, 177613], [91, 177733], [94, 177853], [101, 178133], [103, 178533], [107, 178733], [118, 179473], [122, 179673], [131, 180273], [134, 180433], [138, 180553], [141, 180713], [145, 180913], [156, 182128], [158, 182237], [164, 182437], [167, 182657], [174, 183526]]}, {"verse": 23, "start": 187267, "end": 205000, "text": "Y él les dice: A la verdad mi copa beberéis, y del bautismo de que yo soy bautizado, seréis bautizados; pero el sentaros a mi mano derecha y a mi izquierda, no es mío darlo, sino a aquellos para quienes está preparado por mi Padre.", "words": [[0, 187267], [2, 187472], [5, 187652], [9, 187952], [15, 188894], [17, 188998], [20, 189078], [27, 189818], [30, 190158], [35, 190498], [45, 191078], [47, 191598], [51, 191758], [60, 192378], [63, 192558], [67, 192678], [70, 192858], [74, 193078], [85, 194178], [92, 194598], [104, 196113], [109, 196279], [112, 196439], [121, 197019], [123, 197199], [126, 197319], [131, 197539], [139, 198119], [141, 198299], [143, 198359], [146, 198479], [157, 199239], [160, 199859], [163, 199979], [167, 200259], [174, 201179], [179, 201499], [181, 201859], [190, 202239], [195, 202659], [203, 202939], [208, 203339], [218, 203979], [222, 204179], [225, 204359]]}, {"verse": 24, "start": 205450, "end": 210110, "text": "Y como los diez oyeron esto, se enojaron de los dos hermanos.", "words": [[0, 205450], [2, 205552], [7, 205752], [11, 205932], [16, 206192], [23, 206972], [29, 207692], [32, 207992], [41, 208672], [44, 208812], [48, 208972], [52, 209172]]}, {"verse": 25, "start": 210560, "end": 221152, "text": "Entonces Jesús llamándolos, dijo: Sabéis que los príncipes de los Gentiles los dominan, y los que son grandes ejercen autoridad sobre ellos.", "words": [[0, 210560], [9, 211101], [15, 212181], [28, 212841], [34, 213711], [41, 214221], [45, 214401], [49, 214561], [59, 215281], [62, 215441], [66, 215541], [75, 216081], [79, 216301], [88, 216961], [90, 217321], [94, 217461], [98, 217581], [102, 217781], [110, 218221], [118, 219061], [128, 219881], [134, 220341]]}, {"verse": 26, "start": 221602, "end": 229550, "text": "Pero entre vosotros no será así; sino que el que quiera hacerse grande entre vosotros será vuestro servidor;", "words": [[0, 221602], [5, 221765], [11, 222025], [20, 222745], [23, 223365], [28, 223645], [33, 224479], [38, 224718], [42, 225018], [45, 225278], [49, 225458], [56, 225778], [64, 226258], [71, 226678], [77, 226978], [86, 227658], [91, 228178], [99, 228698]]}, {"verse": 27, "start": 230000, "end": 234263, "text": "Y el que quiera ser el primero entre vosotros, será vuestro siervo:", "words": [[0, 230000], [2, 230125], [5, 230225], [9, 230345], [16, 230645], [20, 230945], [23, 231085], [31, 231465], [37, 231705], [47, 232365], [52, 232965], [60, 233625]]}, {"verse": 28, "start": 234713, "end": 242464, "text": "Como el Hijo del hombre no vino para ser servido, sino para servir, y para dar su vida en rescate por muchos.", "words": [[0, 234713], [5, 234877], [8, 235037], [13, 235297], [17, 235457], [24, 236017], [27, 236297], [32, 236537], [37, 236817], [41, 237097], [50, 238017], [55, 238297], [60, 238617], [68, 239097], [70, 239657], [75, 239897], [79, 240137], [82, 240417], [87, 240737], [90, 240897], [98, 241477], [102, 241697]]}, {"verse": 29, "start": 242914, "end": 248370, "text": "Entonces saliendo ellos de Jericó, le seguía una gran multitud.", "words": [[0, 242914], [9, 243977], [18, 244617], [24, 244917], [27, 245217], [35, 246157], [38, 246237], [45, 246777], [49, 247037], [54, 247337]]}, {"verse": 30, "start": 248820, "end": 260446, "text": "Y he aquí dos ciegos sentados junto al camino, cuando oyeron que Jesús pasaba, clamaron, diciendo: Señor, Hijo de David, ten misericordia de nosotros.", "words": [[0, 248820], [2, 249006], [5, 249146], [10, 249426], [14, 249646], [21, 250226], [30, 251006], [36, 251326], [39, 251606], [47, 252706], [54, 253026], [61, 253566], [65, 253726], [71, 253986], [79, 255186], [89, 255846], [99, 257305], [106, 257559], [111, 257879], [114, 257979], [121, 258759], [125, 258879], [138, 259659], [141, 259759]]}, {"verse": 31, "start": 260796, "end": 269841, "text": "Y la gente les reñía para que callasen; pero ellos clamaban más, diciendo: Señor, Hijo de David, ten misericordia de nosotros.", "words": [[0, 260796], [2, 260900], [5, 261020], [11, 261360], [15, 261720], [21, 262580], [26, 262780], [30, 263310], [40, 264140], [45, 264285], [51, 264485], [60, 265125], [65, 265525], [75, 266700], [82, 266955], [87, 267275], [90, 267374], [97, 268155], [101, 268275], [114, 269054], [117, 269155]]}, {"verse": 32, "start": 270191, "end": 275737, "text": "Y parándose Jesús, los llamó, y dijo: ¿Qué queréis que haga por vosotros?", "words": [[0, 270191], [2, 270313], [12, 271013], [19, 271473], [23, 272013], [30, 272573], [32, 272953], [38, 273721], [43, 273846], [51, 274226], [55, 274386], [60, 274606], [64, 274866]]}, {"verse": 33, "start": 276187, "end": 279826, "text": "Ellos le dicen: Señor, que sean abiertos nuestros ojos.", "words": [[0, 276187], [6, 276590], [9, 276710], [16, 277567], [23, 278066], [27, 278146], [32, 278346], [41, 278926], [50, 279106]]}, {"verse": 34, "start": 280176, "end": 290027, "text": "Entonces Jesús, teniendo misericordia de ellos, les tocó los ojos, y luego sus ojos recibieron la vista; y le siguieron.", "words": [[0, 280176], [9, 281176], [16, 281946], [25, 282716], [38, 283616], [41, 283756], [48, 284476], [52, 284616], [57, 285176], [61, 285416], [67, 285756], [69, 286456], [75, 286656], [79, 286916], [84, 287236], [95, 287956], [98, 288156], [105, 289042], [107, 289165], [110, 289245]]}]}