{"book": "MRK", "chapter": 10, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 404716, "verses": [{"verse": 1, "start": 300, "end": 10872, "text": "And he arose from there, and comes into the coasts of Judæa by the farther side of Jordan: and the people resort to him again; and, as he was accustomed, he taught them again.", "words": [[0, 300], [4, 446], [7, 586], [13, 826], [18, 1206], [25, 1546], [29, 2106], [35, 2346], [40, 2606], [44, 2766], [51, 3306], [54, 3616], [60, 3926], [63, 4126], [67, 4266], [75, 4566], [80, 4906], [83, 5046], [91, 5867], [95, 6158], [99, 6278], [106, 6518], [113, 6918], [116, 7158], [120, 7338], [127, 8149], [132, 8448], [135, 8728], [138, 8868], [142, 9008], [154, 9788], [157, 9868], [164, 10088], [169, 10328]]}, {"verse": 2, "start": 11322, "end": 18162, "text": "¶ And the Pharisees came to him, and asked him, Is it lawful for a man to put away his wife? tempting him.", "words": [[2, 11322], [6, 11472], [10, 11592], [20, 12292], [25, 12552], [28, 12812], [33, 13032], [37, 13552], [43, 13892], [48, 14542], [51, 14700], [54, 14820], [61, 15280], [65, 15500], [67, 15620], [71, 15820], [74, 16000], [78, 16180], [83, 16420], [87, 16620], [93, 17401], [102, 17701]]}, {"verse": 3, "start": 18612, "end": 22398, "text": "And he answered and said to them, What did Moses command you?", "words": [[0, 18612], [4, 18737], [7, 18877], [16, 19277], [20, 19477], [25, 19777], [28, 19977], [34, 20704], [39, 20887], [43, 21147], [49, 21487], [57, 21927]]}, {"verse": 4, "start": 22748, "end": 27654, "text": "And they said, Moses permitted a man to write a bill of divorcement, and to put her away.", "words": [[0, 22748], [4, 22897], [9, 23017], [15, 23756], [21, 24055], [31, 24515], [33, 24795], [37, 24935], [40, 25135], [46, 25335], [48, 25475], [53, 25655], [56, 25755], [69, 26375], [73, 26735], [76, 26875], [80, 27075], [84, 27235]]}, {"verse": 5, "start": 28004, "end": 34578, "text": "And Jesus answered and said to them, For the hardness of your heart he wrote you this precept.", "words": [[0, 28004], [4, 28145], [10, 28485], [19, 29065], [23, 29265], [28, 29485], [31, 29645], [37, 31746], [41, 31836], [45, 31956], [54, 32256], [57, 32516], [62, 32636], [68, 32876], [71, 33076], [77, 33336], [81, 33616], [86, 33856]]}, {"verse": 6, "start": 35028, "end": 38964, "text": "But from the beginning of the creation God made them male and female.", "words": [[0, 35028], [4, 35309], [9, 35469], [13, 35589], [23, 35909], [26, 36129], [30, 36229], [39, 36689], [43, 37029], [48, 37329], [53, 37549], [58, 37909], [62, 38249]]}, {"verse": 7, "start": 39414, "end": 43439, "text": "For this cause shall a man leave his father and mother, and cleave to his wife;", "words": [[0, 39414], [4, 39499], [9, 39699], [15, 40019], [21, 40259], [23, 40379], [27, 40579], [33, 40859], [37, 41099], [44, 41399], [48, 41639], [56, 42339], [60, 42399], [67, 42799], [70, 42919], [74, 43059]]}, {"verse": 8, "start": 43889, "end": 48543, "text": "And they two shall be one flesh: so then they are no more two, but one flesh.", "words": [[0, 43889], [4, 44031], [9, 44231], [13, 44431], [19, 44671], [22, 44851], [26, 45091], [33, 46007], [36, 46114], [41, 46314], [46, 46474], [50, 46554], [53, 46754], [58, 46974], [63, 47634], [67, 47714], [71, 47954]]}, {"verse": 9, "start": 48993, "end": 52978, "text": "What therefore God has joined together, let not man put asunder.", "words": [[0, 48993], [5, 49183], [15, 49643], [19, 50063], [23, 50363], [30, 50643], [40, 51423], [44, 51623], [48, 51823], [52, 52123], [56, 52363]]}, {"verse": 10, "start": 53328, "end": 56784, "text": "And in the house his disciples asked him again of the same matter.", "words": [[0, 53328], [4, 53463], [7, 53583], [11, 53743], [17, 54023], [21, 54223], [31, 54703], [37, 55123], [41, 55283], [47, 55583], [50, 55763], [54, 55903], [59, 56143]]}, {"verse": 11, "start": 57234, "end": 62989, "text": "And he says to them, Whoever shall put away his wife, and marry another, commits adultery against her.", "words": [[0, 57234], [4, 57358], [7, 57498], [12, 57758], [15, 57998], [21, 58650], [29, 58879], [35, 59139], [39, 59339], [44, 59539], [48, 59719], [54, 60039], [58, 60559], [64, 60819], [73, 61199], [81, 61699], [90, 62279], [98, 62599]]}, {"verse": 12, "start": 63439, "end": 67992, "text": "And if a woman shall put away her husband, and be married to another, she commits adultery.", "words": [[0, 63439], [4, 63555], [7, 63655], [9, 63755], [15, 63975], [21, 64215], [25, 64415], [30, 64615], [34, 64775], [43, 65095], [47, 65575], [50, 65695], [58, 65975], [61, 66155], [70, 66895], [74, 66975], [82, 67255]]}, {"verse": 13, "start": 68342, "end": 75034, "text": "¶ And they brought young children to him, that he should touch them: and his disciples rebuked those that brought them.", "words": [[2, 68342], [6, 68491], [11, 68591], [19, 68871], [25, 69191], [34, 69651], [37, 69931], [42, 70231], [47, 70771], [50, 70891], [57, 71091], [63, 71431], [69, 72142], [73, 72286], [77, 72426], [87, 72986], [95, 73726], [101, 73986], [106, 74306], [114, 74566]]}, {"verse": 14, "start": 75484, "end": 86417, "text": "But when Jesus saw it, he was much displeased, and said to them, Let the little children come to me, and forbid them not: for of such is the kingdom of God.", "words": [[0, 75484], [4, 75582], [9, 75742], [15, 76022], [19, 76522], [23, 77042], [26, 77122], [30, 77322], [35, 77622], [47, 78522], [51, 78702], [56, 78922], [59, 79142], [65, 80400], [69, 80597], [73, 80837], [80, 81057], [89, 81517], [94, 81837], [97, 82057], [101, 82537], [105, 82757], [112, 83077], [117, 83357], [122, 84212], [126, 84335], [129, 84575], [134, 84835], [137, 85215], [141, 85375], [149, 85675], [152, 85915]]}, {"verse": 15, "start": 86867, "end": 92542, "text": "Assuredly I say to you Whoever shall not receive the kingdom of God as a little child he shall not enter there in", "words": [[0, 86867], [10, 87512], [12, 87592], [16, 87792], [19, 87952], [23, 88212], [31, 88472], [37, 88752], [41, 88972], [49, 89332], [53, 89492], [61, 89772], [64, 89972], [68, 90212], [71, 90392], [73, 90492], [80, 90652], [86, 91172], [89, 91252], [95, 91412], [99, 91632], [105, 91955], [111, 92279]]}, {"verse": 16, "start": 92892, "end": 97166, "text": "And he took them up in his arms, put his hands upon them, and blessed them.", "words": [[0, 92892], [4, 93001], [7, 93081], [12, 93281], [17, 93481], [20, 93641], [23, 93781], [27, 93941], [33, 94621], [37, 94861], [41, 95021], [47, 95301], [52, 95561], [58, 95861], [62, 96061], [70, 96321]]}, {"verse": 17, "start": 97616, "end": 107631, "text": "¶ And when he was gone forth into the way, there came one running, and kneeled to him, and asked him, Good Master, what shall I do that I may inherit eternal life?", "words": [[2, 97616], [6, 97740], [11, 97900], [14, 98060], [18, 98220], [23, 98500], [29, 98900], [34, 99180], [38, 99360], [43, 100160], [49, 100240], [54, 100480], [58, 100780], [67, 101160], [71, 101560], [79, 101900], [82, 102060], [87, 102280], [91, 102520], [97, 102800], [102, 104328], [107, 104449], [115, 105009], [120, 105129], [126, 105389], [128, 105529], [131, 105789], [136, 106009], [138, 106129], [142, 106289], [150, 106709], [158, 107169]]}, {"verse": 18, "start": 107980, "end": 114446, "text": "And Jesus said to him, Why do you call me good? there is none good but one, that is, God.", "words": [[0, 107980], [4, 108131], [10, 108431], [15, 108831], [18, 109031], [23, 109583], [27, 109839], [30, 110099], [34, 110219], [39, 110439], [42, 110599], [48, 111392], [54, 111536], [57, 111736], [62, 111976], [67, 112296], [71, 112536], [76, 113236], [81, 113336], [85, 113836]]}, {"verse": 19, "start": 114896, "end": 124202, "text": "You know the commandments, Do not commit adultery, Do not kill, Do not steal, Do not bear false witness, Defraud not, Honour your father and mother.", "words": [[0, 114896], [4, 115061], [9, 115201], [13, 115321], [27, 116241], [30, 116441], [34, 116621], [41, 116901], [51, 117821], [54, 117881], [58, 118081], [64, 118781], [67, 118861], [71, 119041], [78, 119901], [81, 120001], [85, 120181], [90, 120421], [96, 120741], [105, 121621], [113, 122081], [118, 122541], [125, 123001], [130, 123201], [137, 123501], [141, 123741]]}, {"verse": 20, "start": 124552, "end": 129134, "text": "And he answered and said to him, Master, all these have I observed from my youth.", "words": [[0, 124552], [4, 124697], [7, 124797], [16, 125177], [20, 125397], [25, 125657], [28, 125857], [33, 126461], [41, 126822], [45, 127202], [51, 127442], [56, 127702], [58, 127842], [67, 128182], [72, 128462], [75, 128682]]}, {"verse": 21, "start": 129484, "end": 143046, "text": "Then Jesus beholding him loved him, and said to him, One thing you lack: go your way, sell whatever you have, and give to the poor, and you shall have treasure in heaven: and come, take up the cross, and follow me.", "words": [[0, 129484], [5, 129758], [11, 130119], [21, 130818], [25, 131139], [31, 131299], [36, 131938], [40, 131978], [45, 132218], [48, 132378], [53, 132938], [57, 133164], [63, 133464], [67, 133664], [73, 134469], [76, 134608], [81, 134828], [86, 135508], [91, 135808], [100, 136088], [104, 136328], [110, 137108], [114, 137188], [119, 137388], [122, 137568], [126, 137668], [132, 138408], [136, 138528], [140, 138668], [146, 138828], [151, 139008], [160, 139308], [163, 139548], [171, 140319], [175, 140456], [181, 141276], [186, 141416], [189, 141616], [193, 141736], [200, 142016], [204, 142436], [211, 142736]]}, {"verse": 22, "start": 143396, "end": 148879, "text": "And he was sad at that saying, and went away grieved: for he had great possessions.", "words": [[0, 143396], [4, 143528], [7, 143628], [11, 143788], [15, 144148], [18, 144348], [23, 144548], [31, 145448], [35, 145648], [40, 145848], [45, 146088], [54, 147143], [58, 147242], [61, 147402], [65, 147622], [71, 147882]]}, {"verse": 23, "start": 149329, "end": 157017, "text": "¶ And Jesus looked round about, and says to his disciples, How hardly shall they that have riches enter into the kingdom of God!", "words": [[2, 149329], [6, 149453], [12, 149793], [19, 150193], [25, 150513], [32, 150893], [36, 151233], [41, 151493], [44, 151713], [48, 151873], [59, 152980], [63, 153179], [70, 153599], [76, 153919], [81, 154119], [86, 154339], [91, 154559], [98, 154939], [104, 155319], [109, 155639], [113, 155819], [121, 156179], [124, 156439]]}, {"verse": 24, "start": 157367, "end": 168398, "text": "And the disciples were astonished at his words. But Jesus answers again, and says to them, Children, how hard is it for them that trust in riches to enter into the kingdom of God!", "words": [[0, 157367], [4, 157489], [8, 157589], [18, 158029], [23, 158329], [34, 158889], [37, 159009], [41, 159129], [48, 160060], [52, 160184], [58, 160484], [66, 160964], [73, 161424], [77, 161904], [82, 162124], [85, 162344], [91, 162939], [101, 163595], [105, 163775], [110, 164175], [113, 164455], [116, 164575], [120, 164755], [125, 164995], [130, 165275], [136, 165595], [139, 165795], [146, 166135], [149, 166455], [155, 166735], [160, 167075], [164, 167275], [172, 167575], [175, 167835]]}, {"verse": 25, "start": 168848, "end": 175070, "text": "It is easier for a camel to go through the eye of a needle, than for a rich man to enter into the kingdom of God.", "words": [[0, 168848], [3, 168954], [6, 169094], [13, 169534], [17, 169774], [19, 169914], [25, 170214], [28, 170414], [31, 170574], [39, 170794], [43, 170954], [47, 171254], [50, 171394], [52, 171454], [60, 171754], [65, 172314], [69, 172534], [71, 172634], [76, 172834], [80, 173154], [83, 173354], [89, 173634], [94, 173894], [98, 174074], [106, 174334], [109, 174554]]}, {"verse": 26, "start": 175420, "end": 181201, "text": "And they were astonished out of measure, saying among themselves, Who then can be saved?", "words": [[0, 175420], [4, 175564], [9, 175704], [14, 175924], [25, 176604], [29, 176744], [32, 176864], [41, 177484], [48, 177944], [54, 178264], [66, 179955], [70, 180093], [75, 180253], [79, 180473], [82, 180613]]}, {"verse": 27, "start": 181551, "end": 189327, "text": "And Jesus looking upon them says, With men it is impossible, but not with God: for with God all things are possible.", "words": [[0, 181551], [4, 181672], [10, 182172], [18, 182392], [23, 182732], [28, 183132], [34, 183844], [39, 184004], [43, 184284], [46, 184464], [49, 184604], [61, 185664], [65, 185884], [69, 186104], [74, 186304], [79, 187181], [83, 187294], [88, 187494], [92, 187934], [96, 188114], [103, 188414], [107, 188654]]}, {"verse": 28, "start": 189677, "end": 196650, "text": "¶ Then Peter began to say to him, Lo, we have left all, and have followed you.", "words": [[2, 189677], [7, 189837], [13, 190117], [19, 190457], [22, 190677], [26, 190837], [29, 190977], [34, 194120], [38, 194210], [41, 194350], [46, 194510], [51, 194690], [56, 194990], [60, 195430], [65, 195570], [74, 195790]]}, {"verse": 29, "start": 197000, "end": 210572, "text": "And Jesus answered and said, Assuredly I say to you, There is no man that has left house, or brethren, or sisters, or father, or mother, or wife, or children, or lands, for my sake, and the gospel’s,", "words": [[0, 197000], [4, 197150], [10, 197470], [19, 198030], [23, 198250], [29, 199438], [39, 200040], [41, 200160], [45, 200380], [48, 200520], [53, 201080], [59, 201280], [62, 201420], [65, 201640], [69, 201920], [74, 202120], [78, 202300], [83, 202500], [90, 203200], [93, 203340], [103, 204080], [106, 204200], [115, 204960], [118, 205060], [126, 205700], [129, 205800], [137, 206400], [140, 206480], [146, 207140], [149, 207240], [159, 207980], [162, 208060], [169, 208640], [173, 208720], [176, 208880], [182, 209621], [186, 209742], [190, 209842]]}, {"verse": 30, "start": 211022, "end": 221662, "text": "But he shall receive a hundredfold now in this time, houses, and brethren, and sisters, and mothers, and children, and lands, with persecutions; and in the world to come eternal life.", "words": [[0, 211022], [4, 211119], [7, 211279], [13, 211459], [21, 211779], [23, 211959], [35, 212459], [39, 212739], [42, 213019], [47, 213199], [53, 213979], [61, 214399], [65, 214819], [75, 215139], [79, 215579], [88, 215939], [92, 216379], [101, 216639], [105, 216979], [115, 217319], [119, 217719], [126, 217952], [131, 218186], [145, 219584], [149, 220044], [152, 220164], [156, 220284], [162, 220564], [165, 220744], [170, 220904], [178, 221204]]}, {"verse": 31, "start": 222112, "end": 225619, "text": "But many that are first shall be last; and the last first.", "words": [[0, 222112], [4, 222216], [9, 222476], [14, 222696], [18, 222796], [24, 223136], [30, 223516], [33, 223656], [39, 224522], [43, 224648], [47, 224748], [52, 225028]]}, {"verse": 32, "start": 225969, "end": 240532, "text": "¶ And they were in the way going up to Jerusalem; and Jesus went before them: and they were amazed; and as they followed, they were afraid. And he took again the twelve, and began to tell them what things should happen to him,", "words": [[2, 225969], [6, 226113], [11, 226253], [16, 226433], [19, 226613], [23, 226753], [27, 226913], [33, 227193], [36, 227453], [39, 227613], [50, 228724], [54, 228868], [60, 229228], [65, 229588], [72, 229948], [78, 230760], [82, 230901], [87, 231061], [92, 231241], [100, 232330], [104, 232478], [107, 232678], [112, 232838], [122, 233678], [127, 233778], [132, 233998], [140, 234999], [144, 235125], [147, 235245], [152, 235445], [158, 235825], [162, 235985], [170, 236345], [174, 237125], [180, 237485], [183, 237725], [188, 237965], [193, 238225], [198, 238445], [205, 238785], [212, 239045], [219, 239385], [222, 239645]]}, {"verse": 33, "start": 240982, "end": 252044, "text": "Saying, Behold, we go up to Jerusalem; and the Son of man shall be delivered to the chief priests, and to the scribes; and they shall condemn him to death, and shall deliver him to the Gentiles:", "words": [[0, 241089], [8, 241482], [16, 241985], [19, 242065], [22, 242225], [25, 242465], [28, 242645], [39, 243721], [43, 243824], [47, 243944], [51, 244164], [54, 244284], [58, 244584], [64, 244844], [67, 244984], [77, 245304], [80, 245524], [84, 245644], [90, 245864], [99, 246324], [103, 246764], [106, 246924], [110, 247024], [119, 248047], [123, 248167], [128, 248307], [134, 248527], [142, 249007], [146, 249287], [149, 249487], [156, 249967], [160, 250147], [166, 250327], [174, 250667], [178, 250967], [181, 251127], [185, 251247]]}, {"verse": 34, "start": 252494, "end": 259845, "text": "And they shall mock him, and shall scourge him, and shall spit upon him, and shall kill him: and the third day he shall rise again.", "words": [[0, 252494], [4, 252618], [9, 252778], [15, 252978], [20, 253378], [25, 253798], [29, 253878], [35, 254078], [43, 254638], [48, 255158], [52, 255218], [58, 255418], [63, 255718], [68, 255958], [73, 256598], [77, 256678], [83, 256878], [88, 257138], [93, 257831], [97, 257929], [101, 258049], [107, 258309], [111, 258609], [114, 258789], [120, 258969], [125, 259269]]}, {"verse": 35, "start": 260195, "end": 269916, "text": "¶ And James and John, the sons of Zebedee, come to him, saying, Master, we would that you should do for us whatever we shall desire.", "words": [[2, 260195], [6, 260340], [12, 260680], [16, 260920], [22, 261640], [26, 261720], [31, 262020], [34, 262200], [43, 262940], [48, 263100], [51, 263300], [56, 263520], [64, 264878], [72, 265396], [75, 265476], [81, 265656], [86, 265876], [90, 266036], [97, 266196], [100, 266376], [104, 266576], [107, 266776], [116, 266996], [119, 267276], [125, 267436]]}, {"verse": 36, "start": 270266, "end": 273246, "text": "And he said to them, What would you that I should do for you?", "words": [[0, 270266], [4, 270397], [7, 270517], [12, 270757], [15, 270957], [21, 271552], [26, 271690], [32, 271870], [36, 272030], [41, 272210], [43, 272370], [50, 272530], [53, 272710], [57, 272890]]}, {"verse": 37, "start": 273596, "end": 284179, "text": "They said to him, Grant to us that we may sit, one on your right hand, and the other on your left hand, in your glory.", "words": [[0, 273596], [5, 273773], [10, 274053], [13, 274213], [18, 277282], [24, 277621], [27, 277881], [30, 278101], [35, 278301], [38, 278461], [42, 278641], [47, 279001], [51, 279561], [54, 279741], [59, 279861], [65, 280121], [71, 280441], [75, 280941], [79, 281121], [85, 281321], [88, 281561], [93, 281681], [98, 281901], [104, 282281], [107, 282641], [112, 282801]]}, {"verse": 38, "start": 284529, "end": 293456, "text": "But Jesus said to them, You know not what you ask: can you drink of the cup that I drink of? and be baptized with the baptism that I am baptized with?", "words": [[0, 284529], [4, 284639], [10, 284959], [15, 285279], [18, 285459], [24, 286047], [28, 286185], [33, 286365], [37, 286585], [42, 286805], [46, 286985], [51, 287966], [55, 288090], [59, 288230], [65, 288470], [68, 288630], [72, 288750], [76, 288990], [81, 289190], [83, 289390], [89, 289630], [93, 290378], [97, 290517], [100, 290657], [109, 291057], [114, 291437], [118, 291557], [126, 291997], [131, 292277], [133, 292417], [136, 292517], [145, 292877]]}, {"verse": 39, "start": 293806, "end": 304614, "text": "And they said to him, We can. And Jesus said to them, You shall indeed drink of the cup that I drink of; and with the baptism that I am baptized with shall you be baptized:", "words": [[0, 293806], [4, 293948], [9, 294068], [14, 294308], [17, 294528], [22, 295131], [25, 295252], [30, 296152], [34, 296277], [40, 296617], [45, 297017], [48, 297197], [54, 297791], [58, 297953], [64, 298173], [71, 298533], [77, 298913], [80, 299073], [84, 299213], [88, 299473], [93, 299673], [95, 299813], [101, 300053], [105, 300834], [109, 300953], [114, 301073], [118, 301213], [126, 301593], [131, 301953], [133, 302093], [136, 302193], [145, 302533], [150, 303213], [156, 303453], [160, 303693], [163, 303813]]}, {"verse": 40, "start": 305064, "end": 311362, "text": "But to sit on my right hand and on my left hand is not mine to give; but it shall be given to them for whom it is prepared.", "words": [[0, 305064], [4, 305186], [7, 305326], [11, 305526], [14, 305686], [17, 305846], [23, 306046], [28, 306446], [32, 306586], [35, 306726], [38, 306866], [43, 307086], [48, 307386], [51, 307526], [55, 307726], [60, 307966], [63, 308166], [69, 308819], [73, 308917], [76, 309037], [82, 309217], [85, 309397], [91, 309617], [94, 309817], [99, 310037], [103, 310237], [108, 310457], [111, 310597], [114, 310717]]}, {"verse": 41, "start": 311712, "end": 316323, "text": "And when the ten heard it, they began to be much displeased with James and John.", "words": [[0, 311712], [4, 311844], [9, 311984], [13, 312144], [17, 312384], [23, 312664], [27, 313204], [32, 313324], [38, 313664], [41, 313824], [44, 313944], [49, 314184], [60, 314964], [65, 315144], [71, 315484], [75, 315744]]}, {"verse": 42, "start": 316773, "end": 328439, "text": "But Jesus called them to him, and says to them, You know that they which are accounted to rule over the Gentiles exercise lordship over them; and their great ones exercise authority upon them.", "words": [[0, 316773], [4, 317091], [10, 317411], [17, 317871], [22, 318111], [25, 318311], [30, 318551], [34, 318871], [39, 319111], [42, 319331], [48, 320229], [52, 320390], [57, 320630], [62, 320850], [67, 321110], [73, 321370], [77, 321570], [87, 321990], [90, 322210], [95, 322530], [100, 322770], [104, 322910], [113, 323510], [122, 323990], [131, 324750], [136, 325010], [142, 325671], [146, 325796], [152, 325916], [158, 326176], [163, 326536], [172, 327036], [182, 327716], [187, 328016]]}, {"verse": 43, "start": 328889, "end": 333814, "text": "But so shall it not be among you: but whoever will be great among you, shall be your minister:", "words": [[0, 328889], [4, 329028], [7, 329268], [13, 329528], [16, 329648], [20, 329808], [23, 330028], [29, 330288], [34, 330932], [38, 331038], [46, 331278], [51, 331558], [54, 331718], [6