{"book": "1CO", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 273002, "verses": [{"verse": 1, "start": 300, "end": 6114, "text": "SEGUID el amor; y procurad los dones espirituales, pero sobre todo que profeticéis.", "words": [[0, 464], [7, 630], [10, 797], [16, 1477], [18, 1787], [27, 2137], [31, 2317], [37, 2717], [51, 3897], [56, 4217], [62, 4517], [67, 4857], [71, 5077]]}, {"verse": 2, "start": 6464, "end": 13909, "text": "Porque el que habla en lenguas, no habla a los hombres, sino a Dios; porque nadie le entiende, aunque en espíritu hable misterios.", "words": [[0, 6464], [7, 6666], [10, 6846], [14, 6986], [20, 7246], [23, 7406], [32, 7906], [35, 8186], [41, 8446], [43, 8586], [47, 8686], [56, 9366], [61, 9506], [63, 9666], [69, 10335], [76, 10515], [82, 10775], [85, 11015], [95, 11815], [102, 11995], [105, 12155], [114, 12815], [120, 13115]]}, {"verse": 3, "start": 14259, "end": 19617, "text": "Pero el que profetiza, habla a los hombres para edificación, y exhortación, y consolación.", "words": [[0, 14259], [5, 14378], [8, 14538], [12, 14638], [23, 15358], [29, 15958], [31, 16138], [35, 16238], [43, 16558], [48, 16838], [61, 17458], [63, 17898], [76, 18578], [78, 18798]]}, {"verse": 4, "start": 19967, "end": 26570, "text": "El que habla lengua extraña, a sí mismo se edifica; pero el que profetiza, edifica a la iglesia.", "words": [[0, 19967], [3, 20248], [7, 20368], [13, 20588], [20, 20988], [29, 21328], [31, 21668], [34, 22008], [40, 22348], [43, 22488], [52, 24069], [57, 24208], [60, 24328], [64, 24428], [75, 25128], [83, 25458], [85, 25788], [88, 25988]]}, {"verse": 5, "start": 26920, "end": 38575, "text": "Así que, quisiera que todos vosotros hablaseis lenguas, pero más que profetizaseis: porque mayor es el que profetiza que el que habla lenguas, si también no interpreta, para que la iglesia tome edificación.", "words": [[0, 26920], [4, 27085], [9, 27225], [18, 27605], [22, 27765], [28, 28005], [37, 28525], [47, 29085], [56, 29665], [61, 29845], [65, 30145], [69, 30325], [84, 31590], [91, 31790], [97, 32170], [100, 32430], [103, 32550], [107, 32670], [117, 33390], [121, 33550], [124, 33670], [128, 33790], [134, 34010], [143, 34730], [146, 34970], [154, 35310], [157, 35510], [169, 36210], [174, 36630], [178, 36810], [181, 36930], [189, 37290], [194, 37710]]}, {"verse": 6, "start": 38925, "end": 48624, "text": "Ahora pues, hermanos, si yo voy a vosotros hablando en lenguas, ¿qué os aprovecharé, si no os hablo, o con revelación, o con conocimiento, o con profecía, o con doctrina?", "words": [[0, 38925], [6, 39181], [12, 39421], [22, 40421], [25, 40541], [28, 40681], [32, 40801], [34, 40921], [43, 41321], [52, 41681], [55, 41921], [64, 42801], [69, 42861], [72, 43021], [85, 43641], [88, 43781], [91, 43961], [94, 44141], [101, 44521], [103, 44681], [107, 44841], [119, 45481], [121, 45781], [125, 45921], [139, 46661], [141, 46861], [145, 47001], [155, 47621], [157, 47801], [161, 47961]]}, {"verse": 7, "start": 48974, "end": 58087, "text": "Ciertamente las cosas inanimadas que hacen sonidos, como la flauta o el arpa, si no dan distinción de voces, ¿cómo se sabrá lo que se toca con la flauta o con el arpa?", "words": [[0, 48974], [12, 49548], [16, 49728], [22, 50068], [33, 50788], [37, 51008], [43, 51248], [52, 52048], [57, 52208], [60, 52348], [67, 52788], [69, 52928], [72, 53048], [78, 53240], [81, 53431], [84, 53623], [88, 53843], [99, 54383], [102, 54543], [109, 55289], [115, 55471], [118, 55611], [124, 55931], [127, 56051], [131, 56171], [134, 56291], [139, 56531], [143, 56771], [146, 56891], [153, 57271], [155, 57391], [159, 57551], [162, 57671]]}, {"verse": 8, "start": 58437, "end": 62932, "text": "Y si la trompeta da sonido incierto, ¿quién se preparará para la batalla?", "words": [[0, 58437], [2, 58535], [5, 58635], [8, 58755], [17, 59295], [20, 59395], [27, 59795], [37, 60815], [44, 61095], [47, 61335], [57, 61935], [62, 62115], [65, 62255]]}, {"verse": 9, "start": 63282, "end": 70627, "text": "Así también vosotros, si por la lengua no dais palabra comprensible, ¿cómo se entenderá lo que se dice? porque hablaréis al aire.", "words": [[0, 63282], [4, 63481], [12, 63841], [22, 64501], [25, 64621], [29, 64821], [32, 64921], [39, 65301], [42, 65461], [47, 65721], [55, 66001], [69, 67381], [75, 67581], [78, 67741], [88, 68241], [91, 68341], [95, 68441], [98, 68561], [104, 69298], [111, 69514], [121, 69994], [124, 70174]]}, {"verse": 10, "start": 70977, "end": 77025, "text": "Tantos géneros de voces, por ejemplo, hay en el mundo, y ninguna de esas voces carece de significado;", "words": [[0, 70977], [7, 71341], [15, 71781], [18, 71881], [25, 72441], [29, 72541], [38, 73221], [42, 73361], [45, 73521], [48, 73621], [55, 74341], [57, 74441], [65, 74761], [68, 74981], [73, 75181], [79, 75621], [86, 76041], [89, 76161]]}, {"verse": 11, "start": 77375, "end": 83112, "text": "Pero si yo ignoro el valor de la voz, seré extranjero para el que habla, y el que habla será extranjero para mí.", "words": [[0, 77375], [5, 77511], [8, 77691], [11, 77871], [18, 78231], [21, 78331], [27, 78531], [30, 78711], [33, 78811], [38, 79391], [43, 79771], [54, 80311], [59, 80491], [62, 80611], [66, 80711], [73, 81031], [75, 81371], [78, 81471], [82, 81571], [88, 81821], [93, 82071], [104, 82651], [109, 82811]]}, {"verse": 12, "start": 83462, "end": 90415, "text": "Así también vosotros; pues que anheláis espirituales dones, procurad ser excelentes para la edificación de la iglesia.", "words": [[0, 83462], [4, 83648], [12, 83928], [22, 84875], [27, 85015], [31, 85175], [40, 85655], [53, 86455], [60, 86935], [69, 87615], [73, 87815], [84, 88555], [89, 88835], [92, 88975], [104, 89495], [107, 89735], [110, 89815]]}, {"verse": 13, "start": 90765, "end": 95303, "text": "Por lo cual, el que habla lengua extraña, pida que la interprete.", "words": [[0, 90765], [4, 90953], [7, 91073], [13, 91353], [16, 91553], [20, 91693], [26, 91893], [33, 92253], [42, 92793], [47, 93333], [51, 93533], [54, 93633]]}, {"verse": 14, "start": 95653, "end": 101347, "text": "Porque si yo orare en lengua desconocida, mi espíritu ora; pero mi entendimiento queda sin fruto.", "words": [[0, 95653], [7, 95859], [10, 96079], [13, 96319], [19, 96679], [22, 96819], [29, 97179], [42, 97979], [45, 98099], [54, 98679], [59, 99289], [64, 99415], [67, 99535], [81, 100095], [87, 100655], [91, 100815]]}, {"verse": 15, "start": 101697, "end": 110016, "text": "¿Qué pues? Oraré con el espíritu, pero oraré también con entendimiento; cantaré con el espíritu, pero cantaré también con entendimiento.", "words": [[0, 101697], [5, 101815], [11, 102505], [17, 102807], [21, 102987], [24, 103107], [34, 104007], [39, 104147], [45, 104487], [53, 104747], [57, 105027], [72, 106248], [80, 106649], [84, 106809], [87, 106929], [97, 107729], [102, 107989], [110, 108469], [118, 108729], [122, 109009]]}, {"verse": 16, "start": 110366, "end": 117992, "text": "Porque si bendices con el espíritu, ¿cómo dirá «Amén» a tu acción de gracias quien no está instruido? Pues no sabe lo que has dicho.", "words": [[0, 110366], [7, 110571], [10, 110771], [19, 111271], [23, 111491], [26, 111611], [36, 112571], [42, 112711], [47, 113111], [54, 113371], [56, 113731], [59, 113831], [66, 114231], [69, 114371], [77, 114691], [83, 115051], [86, 115271], [91, 115451], [102, 116481], [107, 116585], [110, 116745], [115, 117065], [118, 117225], [122, 117365], [126, 117485]]}, {"verse": 17, "start": 118342, "end": 122440, "text": "Porque tú, a la verdad, das gracias bien; pero el otro no es edificado.", "words": [[0, 118342], [7, 118551], [11, 118811], [13, 118931], [16, 119011], [24, 119311], [28, 119591], [36, 119971], [42, 120760], [47, 120902], [50, 121062], [55, 121282], [58, 121502], [61, 121682]]}, {"verse": 18, "start": 122790, "end": 125976, "text": "Doy gracias a Dios que hablo lenguas más que todos vosotros:", "words": [[0, 122790], [4, 123008], [12, 123288], [14, 123528], [19, 123688], [23, 123948], [29, 124208], [37, 124608], [41, 124788], [45, 124988], [51, 125208]]}, {"verse": 19, "start": 126326, "end": 134797, "text": "Pero en la iglesia más quiero hablar cinco palabras con mi entendimiento, para que enseñe también a los otros, que diez mil palabras en lengua desconocida.", "words": [[0, 126326], [5, 126463], [8, 126583], [11, 126663], [19, 127103], [23, 127383], [30, 127643], [37, 128003], [43, 128323], [52, 128803], [56, 129063], [59, 129203], [74, 129943], [79, 130483], [83, 130643], [90, 131063], [98, 131303], [100, 131523], [104, 131683], [111, 132023], [115, 132363], [120, 132703], [124, 132943], [133, 133403], [136, 133663], [143, 133963]]}, {"verse": 20, "start": 135147, "end": 141236, "text": "Hermanos, no seáis niños en el entendimiento, sino sed niños en la malicia: pero maduros en el entendimiento.", "words": [[0, 135147], [10, 135724], [13, 135784], [19, 136124], [25, 136384], [28, 136604], [31, 136704], [46, 137564], [51, 137704], [55, 138004], [61, 138284], [64, 138504], [67, 138604], [76, 139445], [81, 139586], [89, 140006], [92, 140226], [95, 140326]]}, {"verse": 21, "start": 141586, "end": 150556, "text": "En la ley está escrito: En otras lenguas y en otros labios hablaré a este pueblo; y ni aun así me oirán, dice el Señor.", "words": [[0, 141586], [3, 141704], [6, 141804], [10, 142024], [15, 142244], [24, 143134], [27, 143299], [33, 143559], [41, 144259], [43, 144439], [46, 144559], [52, 144799], [59, 145339], [67, 146059], [69, 146239], [74, 146479], [82, 147527], [84, 147692], [87, 147792], [91, 148032], [95, 148412], [98, 148592], [105, 149686], [110, 149907], [113, 150047]]}, {"verse": 22, "start": 150906, "end": 160105, "text": "Así que, las lenguas por señal son, no a los creyentes, sino a los no creyentes: pero la profecía, no a los no creyentes, sino a los creyentes.", "words": [[0, 150906], [4, 151097], [9, 151277], [13, 151417], [21, 151857], [25, 152037], [31, 152497], [36, 152737], [39, 153317], [41, 153477], [45, 153577], [56, 154177], [61, 154517], [63, 154717], [67, 154897], [70, 155057], [81, 156147], [86, 156424], [89, 156584], [99, 157204], [102, 157564], [104, 157764], [108, 157924], [111, 158064], [122, 158844], [127, 158964], [129, 159084], [133, 159224]]}, {"verse": 23, "start": 160455, "end": 170760, "text": "De manera que, si toda la iglesia se reúne en un solo lugar, y todos hablan en lenguas, y entran personas no instruidas o no creyentes, ¿no dirán que estáis locos?", "words": [[0, 160455], [3, 160579], [10, 160799], [15, 161079], [18, 161239], [23, 161459], [26, 161679], [34, 162059], [37, 162259], [43, 162739], [46, 162839], [49, 162959], [54, 163239], [61, 163679], [63, 164079], [69, 164319], [76, 164919], [79, 165059], [88, 165559], [90, 165999], [97, 166319], [106, 166839], [109, 167079], [120, 167719], [122, 167959], [125, 168039], [136, 169131], [140, 169271], [146, 169591], [150, 169751], [157, 170151]]}, {"verse": 24, "start": 171110, "end": 178592, "text": "Pero si todos profetizan, y entra algún no creyente o alguien no instruido, por todos es convencido, por todos es juzgado;", "words": [[0, 171110], [5, 171248], [8, 171408], [14, 171668], [26, 172588], [28, 172788], [34, 173048], [40, 173348], [43, 173528], [52, 174068], [54, 174248], [62, 174508], [65, 174768], [76, 175628], [80, 175788], [86, 176068], [89, 176308], [101, 177368], [105, 177488], [111, 177748], [114, 177948]]}, {"verse": 25, "start": 178942, "end": 188259, "text": "Lo oculto de su corazón se hace manifiesto: y así, postrándose sobre el rostro, adorará a Dios, declarando que verdaderamente Dios está en vosotros.", "words": [[0, 178942], [3, 179107], [10, 179527], [13, 179587], [16, 179707], [24, 180147], [27, 180407], [32, 180587], [44, 181627], [46, 181748], [51, 181927], [63, 182728], [69, 183027], [72, 183188], [80, 183968], [88, 184587], [90, 184707], [96, 185307], [107, 185767], [111, 185908], [126, 186647], [131, 187008], [136, 187388], [139, 187547]]}, {"verse": 26, "start": 188609, "end": 200161, "text": "¿Qué hay pues, hermanos? Cuando os juntáis, cada uno de vosotros tiene salmo, tiene doctrina, tiene lengua, tiene revelación, tiene interpretación: hágase todo para edificación.", "words": [[0, 188609], [5, 188710], [9, 188950], [15, 189210], [25, 189923], [32, 190113], [35, 190273], [44, 190673], [49, 190913], [53, 191173], [56, 191293], [65, 191733], [71, 192033], [78, 193053], [84, 193273], [94, 194433], [100, 194533], [108, 195533], [114, 195613], [126, 196913], [132, 197033], [148, 198316], [155, 198638], [160, 198898], [165, 199158]]}, {"verse": 27, "start": 200511, "end": 207003, "text": "Si habla alguno en lengua extraña, sea esto por dos, o a lo más tres, y por turno; pero uno interprete.", "words": [[0, 200511], [3, 200625], [9, 200865], [16, 201425], [19, 201505], [26, 201845], [35, 202405], [39, 202745], [44, 203065], [48, 203315], [53, 203565], [55, 203905], [57, 203985], [60, 204085], [64, 204315], [70, 204545], [72, 204885], [76, 205045], [83, 205820], [88, 205980], [92, 206200]]}, {"verse": 28, "start": 207353, "end": 212297, "text": "Y si no hay intérprete, calle en la iglesia, y hable para sí mismo y para Dios.", "words": [[0, 207353], [2, 207482], [5, 207582], [8, 207742], [12, 207902], [24, 208982], [30, 209422], [33, 209502], [36, 209642], [45, 210142], [47, 210388], [53, 210687], [58, 210888], [61, 211087], [67, 211448], [69, 211527], [74, 211747]]}, {"verse": 29, "start": 212647, "end": 216225, "text": "Asimismo, los profetas hablen dos o tres, y los demás juzguen.", "words": [[0, 212647], [10, 213224], [14, 213344], [23, 213884], [30, 214264], [34, 214444], [36, 214584], [42, 214844], [44, 215164], [48, 215284], [54, 215504]]}, {"verse": 30, "start": 216575, "end": 220311, "text": "Y si a otro que está sentado, es revelado, el primero debe callar.", "words": [[0, 216575], [2, 216704], [5, 216844], [7, 216944], [12, 217164], [16, 217384], [21, 217624], [30, 218224], [33, 218424], [43, 218984], [46, 219144], [54, 219464], [59, 219724]]}, {"verse": 31, "start": 220661, "end": 226053, "text": "Porque podéis todos profetizar uno por uno, para que todos aprendan, y todos sean exhortados.", "words": [[0, 220661], [7, 220863], [14, 221283], [20, 221503], [31, 222303], [35, 222583], [39, 222803], [44, 223043], [49, 223543], [53, 223723], [59, 223943], [69, 224663], [71, 224843], [77, 225023], [82, 225383]]}, {"verse": 32, "start": 226403, "end": 230248, "text": "Y los espíritus de los que profetizan, sujétense a los profetas;", "words": [[0, 226403], [2, 226487], [6, 226607], [16, 227287], [19, 227387], [23, 227487], [27, 227647], [39, 228687], [49, 229207], [51, 229367], [55, 229487]]}, {"verse": 33, "start": 230598, "end": 236053, "text": "Porque Dios no es Dios de desorden, sino de paz; como en todas las iglesias de los santos.", "words": [[0, 230598], [7, 230782], [12, 231082], [15, 231402], [18, 231562], [23, 231822], [26, 232002], [36, 232742], [41, 232962], [44, 233142], [49, 233870], [54, 234051], [57, 234231], [63, 234371], [67, 234691], [76, 235151], [79, 235251], [83, 235371]]}, {"verse": 34, "start": 236403, "end": 243388, "text": "Vuestras mujeres callen en las congregaciones; porque no les es permitido hablar, sino que estén sujetas, como también la ley dice.", "words": [[0, 236403], [9, 236727], [17, 237027], [24, 237567], [27, 237647], [31, 237767], [47, 239024], [54, 239189], [57, 239369], [61, 239529], [64, 239649], [74, 240189], [82, 240809], [87, 240969], [91, 241149], [97, 241429], [106, 242029], [111, 242249], [119, 242609], [122, 242749], [126, 242929]]}, {"verse": 35, "start": 243738, "end": 251170, "text": "Y si quieren aprender alguna cosa, pregunten en casa a sus maridos; porque cosa vergonzosa es hablar una mujer en la congregación.", "words": [[0, 243738], [2, 243841], [5, 243941], [13, 244201], [22, 244581], [29, 244901], [35, 245641], [45, 246081], [48, 246241], [53, 246461], [55, 246661], [59, 246741], [68, 247603], [75, 247831], [80, 248151], [91, 248851], [94, 249031], [101, 249311], [105, 249531], [111, 249891], [114, 250071], [117, 250171]]}, {"verse": 36, "start": 251520, "end": 255907, "text": "Qué, ¿ha salido de vosotros la palabra de Dios? ¿o a vosotros solos ha llegado?", "words": [[0, 251520], [5, 251641], [9, 251781], [16, 252181], [19, 252301], [28, 252761], [31, 252941], [39, 253241], [42, 253421], [48, 254150], [51, 254287], [53, 254387], [62, 254807], [68, 255247], [71, 255347]]}, {"verse": 37, "start": 256257, "end": 263511, "text": "Si alguno a su parecer, es profeta, o espiritual, reconozca lo que os escribo, porque son mandamientos del Señor.", "words": [[0, 256257], [3, 256391], [10, 256911], [12, 256991], [15, 257131], [24, 257591], [27, 257931], [36, 258531], [38, 258651], [50, 259771], [60, 260411], [63, 260551], [67, 260691], [70, 260811], [79, 261671], [86, 261891], [90, 262131], [103, 262771], [107, 263011]]}, {"verse": 38, "start": 263861, "end": 265340, "text": "Pero el que ignora, ignore.", "words": [[0, 263861], [5, 263980], [8, 264140], [12, 264240], [20, 264880]]}, {"verse": 39, "start": 265690, "end": 269966, "text": "Así que, hermanos, procurad profetizar; y no impidáis el hablar lenguas.", "words": [[0, 265690], [4, 265878], [9, 266058], [19, 266678], [28, 267278], [40, 268315], [42, 268417], [45, 268517], [54, 268997], [57, 269117], [64, 269317]]}, {"verse": 40, "start": 270316, "end": 272602, "text": "Pero hágase todo decentemente y con orden.", "words": [[0, 270316], [5, 270460], [12, 270840], [17, 271120], [30, 271880], [32, 272020], [36, 272160]]}]}