{"book": "LUK", "chapter": 24, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 388674, "verses": [{"verse": 1, "start": 300, "end": 10989, "text": "Y el primer día de la semana, muy de mañana, vinieron al sepulcro, trayendo las especias aromáticas que habían preparado, y algunas otras mujeres con ellas.", "words": [[0, 300], [2, 444], [5, 564], [12, 864], [16, 1164], [19, 1304], [22, 1444], [30, 1924], [34, 2104], [37, 2264], [45, 2824], [54, 3284], [57, 3544], [67, 4784], [76, 5424], [80, 5964], [89, 6504], [100, 7264], [104, 7524], [111, 7784], [122, 8504], [124, 8884], [132, 9264], [138, 9624], [146, 10084], [150, 10424]]}, {"verse": 2, "start": 11339, "end": 15260, "text": "Y hallaron la piedra rodada a un lado del sepulcro.", "words": [[0, 11339], [2, 11483], [11, 11963], [14, 12143], [21, 12723], [28, 13423], [30, 13683], [33, 13803], [38, 14103], [42, 14363]]}, {"verse": 3, "start": 15610, "end": 19304, "text": "Y entrando, no hallaron el cuerpo del Señor Jesús.", "words": [[0, 15610], [2, 15735], [12, 16335], [15, 16835], [24, 17355], [27, 17535], [34, 17895], [38, 18195], [44, 18495]]}, {"verse": 4, "start": 19654, "end": 28203, "text": "Y aconteció, que estando ellas espantadas de esto, he aquí se pararon junto a ellas dos varones con vestiduras resplandecientes;", "words": [[0, 19654], [2, 20028], [13, 20438], [17, 20618], [25, 21078], [31, 21379], [42, 22199], [45, 22418], [51, 22751], [54, 23084], [59, 23304], [62, 23524], [70, 24024], [76, 24284], [78, 24524], [84, 24724], [88, 25044], [96, 25624], [100, 26144], [111, 26844]]}, {"verse": 5, "start": 28553, "end": 35702, "text": "Y como tuviesen ellas temor, y bajasen el rostro a tierra, les dijeron: ¿Por qué buscáis entre los muertos al que vive?", "words": [[0, 28553], [2, 28813], [7, 29033], [16, 29573], [22, 29913], [29, 30453], [31, 30633], [39, 31173], [42, 31293], [49, 31693], [51, 31813], [59, 32273], [63, 32353], [72, 33306], [77, 33414], [81, 33554], [89, 34034], [95, 34334], [99, 34514], [107, 34934], [110, 35134], [114, 35274]]}, {"verse": 6, "start": 36052, "end": 41246, "text": "No está aquí, pero ha resucitado: acordaos de lo que os habló, cuando aún estaba en Galilea,", "words": [[0, 36052], [3, 36171], [8, 36391], [14, 36771], [19, 36891], [22, 37051], [34, 38071], [43, 38716], [46, 38856], [49, 38976], [53, 39096], [56, 39216], [63, 39576], [70, 39836], [74, 40136], [81, 40436], [84, 40616]]}, {"verse": 7, "start": 41596, "end": 50328, "text": "Diciendo: Es necesario que el Hijo del hombre sea entregado en manos de hombres pecadores, y que sea crucificado, y resucite al tercer día.", "words": [[0, 41596], [10, 42528], [13, 42712], [23, 43312], [27, 43592], [30, 43712], [35, 43912], [39, 44052], [46, 44392], [50, 44612], [60, 45292], [63, 45392], [69, 45612], [72, 45892], [80, 46112], [91, 46772], [93, 47292], [97, 47392], [101, 47592], [114, 48452], [116, 48772], [125, 49372], [128, 49552], [135, 49792]]}, {"verse": 8, "start": 50608, "end": 53727, "text": "Entonces ellas se acordaron de sus palabras,", "words": [[0, 50608], [9, 51352], [15, 51672], [18, 51912], [28, 52512], [31, 52712], [35, 52852]]}, {"verse": 9, "start": 54077, "end": 60290, "text": "Y volviendo del sepulcro, contaron todas estas cosas a los once, y a todos los demás.", "words": [[0, 54077], [2, 54185], [12, 54665], [16, 54884], [26, 55745], [35, 56245], [41, 56825], [47, 57245], [53, 57645], [55, 57905], [59, 58005], [65, 58405], [67, 58745], [69, 58844], [75, 59145], [79, 59585]]}, {"verse": 10, "start": 60640, "end": 70433, "text": "Y eran María Magdalena, y Juana, y María madre de Jacobo, y las demás con ellas, las que dijeron estas cosas a los apóstoles.", "words": [[0, 60640], [2, 60801], [7, 61001], [13, 61421], [24, 62401], [26, 63001], [33, 63501], [35, 63681], [41, 63941], [47, 64481], [50, 64641], [58, 65761], [60, 66001], [64, 66141], [70, 66341], [74, 66681], [81, 66981], [85, 67501], [89, 67681], [97, 68221], [103, 68421], [109, 68901], [111, 69321], [115, 69441]]}, {"verse": 11, "start": 70783, "end": 75411, "text": "Pero a ellos les parecían como locura las palabras de ellas, y no las creyeron.", "words": [[0, 70783], [5, 70927], [7, 71087], [13, 71327], [17, 71527], [26, 72107], [31, 72387], [38, 72967], [42, 73107], [51, 73527], [54, 73807], [61, 74027], [63, 74267], [66, 74367], [70, 74527]]}, {"verse": 12, "start": 75761, "end": 86139, "text": "Pero levantándose Pedro, corrió al sepulcro: y como miró dentro, vio solos los lienzos echados; y se fue maravillándose de lo que había sucedido.", "words": [[0, 75761], [5, 76166], [18, 76946], [25, 77326], [32, 77846], [35, 77966], [45, 79056], [47, 79162], [52, 79402], [57, 79762], [65, 80402], [69, 80602], [75, 81142], [79, 81442], [87, 81962], [96, 83014], [98, 83140], [101, 83260], [105, 83460], [120, 84480], [123, 84760], [126, 84900], [130, 85040], [136, 85300]]}, {"verse": 13, "start": 86489, "end": 94817, "text": "Y he aquí, dos de ellos iban el mismo día a una aldea que estaba de Jerusalén sesenta estadios, llamada Emaús.", "words": [[0, 86489], [2, 86823], [5, 86943], [11, 87243], [15, 87483], [18, 87683], [24, 87983], [29, 88283], [32, 88423], [38, 88703], [42, 89003], [44, 89283], [48, 89463], [54, 90103], [58, 90263], [65, 90623], [68, 90843], [78, 91503], [86, 92163], [96, 93523], [104, 94065]]}, {"verse": 14, "start": 95167, "end": 100006, "text": "E iban hablando entre sí de todas aquellas cosas que habían acontecido.", "words": [[0, 95167], [2, 95316], [7, 95616], [16, 95916], [22, 96316], [25, 96656], [28, 96816], [34, 97096], [43, 97716], [49, 98056], [53, 98636], [60, 98976]]}, {"verse": 15, "start": 100356, "end": 109410, "text": "Y aconteció que yendo hablando entre sí, y preguntándose el uno al otro, el mismo Jesús se llegó, e iba con ellos juntamente.", "words": [[0, 100356], [2, 100521], [12, 101361], [16, 101601], [22, 102001], [31, 102341], [37, 102841], [41, 103161], [43, 103421], [57, 104421], [60, 104701], [64, 104901], [67, 105121], [73, 106081], [76, 106201], [82, 106461], [88, 106721], [91, 107061], [98, 107636], [100, 107736], [104, 107916], [108, 108176], [114, 108356]]}, {"verse": 16, "start": 109760, "end": 113146, "text": "Pero los ojos de ellos estaban impedidos de reconocerlo.", "words": [[0, 109760], [5, 109883], [9, 110043], [14, 110363], [17, 110583], [23, 110783], [31, 111183], [41, 111943], [44, 112103]]}, {"verse": 17, "start": 113496, "end": 119137, "text": "Y les dijo: ¿De qué conversáis entre vosotros mientras camináis, y estáis tristes?", "words": [[0, 113496], [2, 113763], [6, 114067], [12, 114528], [16, 114655], [20, 115085], [31, 115515], [37, 115835], [46, 116475], [55, 116755], [65, 117555], [67, 117975], [74, 118395]]}, {"verse": 18, "start": 119487, "end": 129689, "text": "Y respondiendo el uno, que se llamaba Cleofas, le dijo: ¿Eres tú el único visitante en Jerusalén que no se ha enterado de las cosas que en ella han acontecido estos días?", "words": [[0, 119487], [2, 119645], [15, 120525], [18, 120705], [23, 120965], [27, 121465], [30, 121605], [38, 122155], [47, 122705], [50, 122945], [56, 123673], [62, 123901], [65, 124081], [68, 124241], [74, 124441], [84, 125061], [87, 125201], [97, 125761], [101, 125981], [104, 126181], [107, 126361], [110, 126461], [119, 126921], [122, 127041], [126, 127181], [132, 127501], [136, 127781], [139, 127921], [144, 128101], [148, 128241], [159, 128881], [165, 129061]]}, {"verse": 19, "start": 129969, "end": 141877, "text": "Entonces él les dijo: ¿Qué cosas? Y ellos le dijeron: De Jesús nazareno, el cual fue varón profeta, poderoso en obra y en palabra delante de Dios y de todo el pueblo;", "words": [[0, 129969], [9, 130606], [12, 131366], [16, 131606], [22, 132695], [27, 133012], [34, 133490], [36, 133676], [42, 133896], [45, 134076], [54, 135053], [57, 135170], [63, 135430], [73, 136450], [76, 136470], [81, 136670], [85, 136930], [91, 137230], [100, 138210], [109, 138770], [112, 138930], [117, 139170], [119, 139330], [122, 139450], [130, 139730], [138, 140330], [141, 140450], [146, 140690], [148, 140910], [151, 141030], [156, 141170], [159, 141370]]}, {"verse": 20, "start": 142227, "end": 148489, "text": "Y cómo le entregaron los principales sacerdotes y nuestros dirigentes a condenación de muerte, y le crucificaron.", "words": [[0, 142227], [2, 142331], [7, 142571], [10, 142731], [21, 143271], [25, 143411], [37, 144091], [48, 144691], [50, 144871], [59, 145051], [70, 145851], [72, 146071], [84, 146651], [87, 146851], [95, 147171], [97, 147511], [100, 147611]]}, {"verse": 21, "start": 148839, "end": 157389, "text": "Pero nosotros esperábamos que él era el que había de redimir a Israel: y ahora sobre todo esto, hoy es el tercer día que esto ha acontecido.", "words": [[0, 148839], [5, 148985], [14, 149405], [26, 150245], [30, 150505], [33, 150685], [37, 150885], [40, 151045], [44, 151185], [50, 151425], [53, 151605], [61, 151985], [63, 152105], [71, 152863], [73, 153012], [79, 153452], [85, 153612], [90, 153892], [96, 154712], [100, 154872], [103, 155052], [106, 155172], [113, 155452], [117, 155872], [121, 156112], [126, 156352], [129, 156572]]}, {"verse": 22, "start": 157739, "end": 163397, "text": "Aunque también unas mujeres de los nuestros nos han asombrado, las cuales antes del día fueron al sepulcro:", "words": [[0, 157739], [7, 157925], [15, 158285], [20, 158525], [28, 158905], [31, 159085], [35, 159225], [44, 159585], [48, 159865], [52, 160025], [63, 160945], [67, 161025], [74, 161325], [80, 161765], [84, 161985], [88, 162245], [95, 162545], [98, 162765]]}, {"verse": 23, "start": 163747, "end": 171058, "text": "Y no hallando su cuerpo, vinieron diciendo que también habían visto visión de ángeles, los cuales dijeron que él vive.", "words": [[0, 163747], [2, 163869], [5, 164009], [14, 164429], [17, 164629], [25, 165449], [34, 165969], [43, 166289], [47, 166629], [55, 166989], [62, 167229], [68, 167689], [75, 168189], [78, 168309], [87, 169229], [91, 169349], [98, 169649], [106, 170209], [110, 170349], [113, 170529]]}, {"verse": 24, "start": 171408, "end": 177794, "text": "Y fueron algunos de los nuestros al sepulcro, y hallaron así como las mujeres habían dicho; pero a él no le vieron.", "words": [[0, 171408], [2, 171532], [9, 171732], [17, 172192], [20, 172352], [24, 172492], [33, 172872], [36, 173132], [46, 173672], [48, 174092], [57, 174492], [61, 174732], [66, 174952], [70, 175132], [78, 175472], [85, 175832], [92, 176564], [97, 176726], [99, 176886], [102, 177046], [105, 177186], [108, 177306]]}, {"verse": 25, "start": 178074, "end": 185816, "text": "Entonces él les dijo: ¡Oh insensatos, y tardos de corazón para creer todo lo que los profetas han dicho!", "words": [[0, 178074], [9, 178710], [12, 179470], [16, 179710], [22, 180941], [26, 181401], [38, 181861], [40, 182001], [47, 182421], [50, 182541], [58, 183021], [63, 183381], [69, 183861], [74, 184101], [77, 184381], [81, 184501], [85, 184621], [94, 185121], [98, 185321]]}, {"verse": 26, "start": 186166, "end": 191303, "text": "¿No era necesario que el Cristo padeciera estas cosas, y que entrara en su gloria?", "words": [[0, 186166], [4, 186354], [8, 186554], [18, 187154], [22, 187374], [25, 187514], [32, 187894], [42, 188594], [48, 188774], [55, 189234], [57, 189814], [61, 190054], [69, 190294], [72, 190494], [75, 190694]]}, {"verse": 27, "start": 191653, "end": 199754, "text": "Y comenzando desde Moisés, y de todos los profetas, les explicaba en todas las Escrituras lo que de él decían.", "words": [[0, 191653], [2, 191759], [13, 192639], [19, 192819], [27, 193459], [29, 194059], [32, 194179], [38, 194439], [42, 194659], [52, 195499], [56, 195759], [66, 196659], [69, 196859], [75, 197179], [79, 197499], [90, 198219], [93, 198619], [97, 198759], [100, 198899], [103, 199340]]}, {"verse": 28, "start": 200104, "end": 205516, "text": "Y llegaron a la aldea a donde iban: y él hizo como que iba más lejos.", "words": [[0, 200104], [2, 200264], [11, 200724], [13, 200964], [16, 201044], [22, 201644], [24, 201844], [30, 202024], [36, 202957], [38, 203146], [41, 203266], [46, 203726], [51, 204046], [55, 204266], [59, 204526], [63, 204786]]}, {"verse": 29, "start": 205866, "end": 216023, "text": "Pero ellos le rogaron con insistencia, diciendo: Quédate con nosotros, porque se hace tarde, y el día ya ha declinado. Entró pues a quedarse con ellos.", "words": [[0, 205866], [5, 206028], [11, 206308], [14, 206588], [22, 207328], [26, 207488], [39, 208648], [49, 209902], [57, 210220], [61, 210420], [71, 210760], [78, 211100], [81, 211340], [86, 211520], [93, 211920], [95, 212165], [98, 212305], [102, 212505], [105, 212765], [108, 212885], [119, 213845], [125, 214336], [130, 214536], [132, 214756], [141, 215196], [145, 215476]]}, {"verse": 30, "start": 216373, "end": 222679, "text": "Y aconteció, que estando sentado con ellos a la mesa, tomando el pan, bendijo, y partió, y les dio.", "words": [[0, 216373], [2, 216474], [13, 217034], [17, 217354], [25, 217674], [33, 218274], [37, 218514], [43, 218714], [45, 218934], [48, 219034], [54, 219294], [62, 219794], [65, 219934], [70, 220434], [79, 221034], [81, 221254], [89, 221774], [91, 222054], [95, 222194]]}, {"verse": 31, "start": 223029, "end": 231271, "text": "Entonces fueron abiertos los ojos de ellos, y le reconocieron; pero él se desapareció de los ojos de ellos.", "words": [[0, 223029], [9, 223614], [16, 224074], [25, 224934], [29, 225154], [34, 225514], [37, 225754], [44, 226114], [46, 226554], [49, 226714], [63, 228091], [68, 228291], [71, 228671], [74, 229011], [86, 229891], [89, 230031], [93, 230171], [98, 230431], [101, 230711]]}, {"verse": 32, "start": 231621, "end": 239744, "text": "Y decían el uno al otro: ¿No ardía nuestro corazón en nosotros, mientras nos hablaba en el camino, y cuando nos abría las Escrituras?", "words": [[0, 231621], [2, 231743], [9, 232343], [12, 232623], [16, 232863], [19, 233063], [25, 233792], [29, 233978], [35, 234278], [43, 234458], [51, 234998], [54, 235198], [64, 235658], [73, 236178], [77, 236478], [85, 236878], [88, 236978], [91, 237078], [99, 237498], [101, 237938], [108, 238138], [112, 238358], [118, 238678], [122, 238818]]}, {"verse": 33, "start": 240024, "end": 248814, "text": "Y levantándose en la misma hora, se volvieron a Jerusalén, y hallaron a los once reunidos, y a los que estaban con ellos.", "words": [[0, 240024], [2, 240145], [15, 241025], [18, 241185], [21, 241285], [27, 241525], [33, 242185], [36, 242385], [46, 242985], [48, 243145], [59, 243945], [61, 244405], [70, 244925], [72, 245085], [76, 245265], [81, 245825], [91, 246665], [93, 247145], [95, 247205], [99, 247325], [103, 247465], [111, 247825], [115, 248225]]}, {"verse": 34, "start": 249164, "end": 254332, "text": "Que decían: Ha resucitado el Señor verdaderamente, y ha aparecido a Simón.", "words": [[0, 249164], [4, 249621], [12, 250265], [15, 250405], [26, 251045], [29, 251125], [35, 251345], [51, 252225], [53, 252885], [56, 252985], [66, 253645], [68, 253825]]}, {"verse": 35, "start": 254612, "end": 263405, "text": "Entonces ellos contaban las cosas que les habían acontecido en el camino, y cómo había sido reconocido por ellos al partir el pan.", "words": [[0, 254612], [9, 255134], [15, 255634], [24, 256394], [28, 256594], [34, 256994], [38, 257234], [42, 257374], [49, 257694], [60, 258434], [63, 258554], [66, 258694], [74, 259434], [76, 259754], [81, 260034], [87, 260314], [92, 260654], [103, 261434], [107, 261674], [113, 261914], [116, 262274], [123, 262664], [126, 263053]]}, {"verse": 36, "start": 263755, "end": 270684, "text": "Y entre tanto que ellos hablaban estas cosas, él se puso en medio de ellos, y les dijo: Paz a vosotros.", "words": [[0, 263755], [2, 263884], [8, 264144], [14, 264544], [18, 264764], [24, 265004], [33, 265524], [39, 265744], [46, 266744], [49, 266884], [52, 267084], [57, 267464], [60, 267624], [66, 267884], [69, 268124], [76, 268484], [78, 268849], [82, 268969], [88, 269778], [92, 269898], [94, 269998]]}, {"verse": 37, "start": 271034, "end": 276163, "text": "Entonces ellos espantados y asombrados, pensaban que veían espíritu.", "words": [[0, 271034], [9, 271971], [15, 272471], [26, 273311], [28, 273431], [40, 274091], [49, 274831], [53, 275011], [59, 275431]]}, {"verse": 38, "start": 276513, "end": 282476, "text": "Pero él les dice: ¿Por qué estáis turbados, y suben pensamientos a vuestros corazones?", "words": [[0, 276513], [5, 276677], [8, 277007], [12, 277337], [18, 278115], [23, 278239], [27, 278586], [34, 278932], [44, 279279], [46, 279539], [52, 280019], [65, 280839], [67, 281079], [76, 281459]]}, {"verse": 39, "start": 282826, "end": 291973, "text": "Mirad mis manos y mis pies, que yo mismo soy: palpad, y ved; que el espíritu ni tiene carne ni huesos, como veis que yo tengo.", "words": [[0, 282826], [6, 283154], [10, 283314], [16, 283674], [18, 283894], [22, 284034], [28, 284694], [32, 284814], [35, 284994], [41, 285274], [46, 286369], [54, 286669], [56, 286986], [61, 287483], [65, 287610], [68, 287790], [77, 288410], [80, 288530], [86, 288870], [92, 289330], [95, 289610], [103, 290510], [108, 290670], [113, 291070], [117, 291190], [120, 291330]]}, {"verse": 40, "start": 292323, "end": 295840, "text": "Y al decir esto, les mostró las manos y los pies.", "words": [[0, 292323], [2, 292450], [5, 292550], [11, 292890], [17, 293490], [21, 293865], [28, 294345], [32, 294505], [38, 294865], [40, 295085], [44, 295225]]}, {"verse": 41, "start": 296190, "end": 303342, "text": "Y no creyéndolo aún ellos de gozo, y maravillados, les dijo: ¿Tenéis aquí algo de comer?", "words": [[0, 296190], [2, 296333], [5, 296473], [16, 297293], [20, 297693], [26, 298073], [29, 298353], [35, 299173], [37, 299413], [51, 300513], [55, 300753], [61, 301542], [69, 301887], [74, 302207], [79, 302567], [82, 302767]]}, {"verse": 42, "start": 303692, "end": 309393, "text": "Entonces ellos le presentaron parte de un pez asado, y un panal de miel.", "words": [[0, 303692], [9, 304773], [15, 305073], [18, 305313], [30, 306033], [36, 306373], [39, 306653], [42, 306966], [46, 307280], [53, 307593], [55, 308013], [58, 308303], [64, 308593], [67, 308813]]}, {"verse": 43, "start": 309743, "end": 312605, "text": "Y él tomó, y comió delante de ellos.", "words": [[0, 309743], [2, 309932], [5, 310092], [11, 310872], [13, 311012], [19, 311412], [27, 311872], [30, 312012]]}, {"verse": 44, "start": 312955, "end": 326878, "text": "Y él les dijo: Estas son las palabras que os hablé, estando aún con vosotros: que era necesario que se cumpliesen todas las cosas que están escritas de mí en la ley de Moisés, y en los profetas, y en los salmos.", "words": [[0, 312955], [2, 313118], [5, 313258], [9, 313398], [15, 314167], [21, 314591], [25, 314751], [29, 314891], [38, 315231], [42, 315491], [45, 315611], [52, 316191], [60, 316531], [64, 316731], [68, 316951], [78, 317981], [82, 318124], [86, 318344], [96, 319004], [100, 319244], [103, 319384], [114, 320064], [120, 320504], [124, 320804], [130, 321204], [134, 321424], [140, 321644], [149, 322244], [152, 322384], [155, 322624], [158, 323244], [161, 323384], [165, 323604], [168, 323744], [176, 324184], [178, 324784], [181, 324904], [185, 325024], [195, 325684], [197, 325909], [200, 326009], [204, 326149]]}, {"verse": 45, "start": 327228, "end": 332633, "text": "Entonces les abrió el entendimiento, para que entendiesen las Escrituras;", "words": [[0, 327228], [9, 327755], [13, 328235], [19, 328655], [22, 328815], [37, 329775], [42, 330315], [46, 330475], [58, 331235], [62, 331515]]}, {"verse": 46, "start": 332983, "end": 341533, "text": "Y les dijo: Así está escrito, y así fue necesario que el Cristo padeciese, y resucitase de los muertos al tercer día;", "words": [[0, 332983], [2, 333249], [6, 333553], [12, 334015], [16, 334315], [21, 334575], [30, 335035], [32, 335615], [36, 335795], [40, 336055], [50, 336675], [54, 336915], [57, 337075], [64, 337395], [75, 338415], [77, 338595], [88, 339495], [91, 339675], [95, 339815], [103, 340295], [106, 340555], [113, 340835]]}, {"verse": 47, "start": 341883, "end": 351032, "text": "Y que se predicase en su nombre el arrepentimiento y el perdón de pecados en todas las naciones, comenzando de Jerusalén.", "words": [[0, 341883], [2, 341990], [6, 342130], [9, 342470], [19, 342810], [22, 343150], [25, 343430], [32, 343850], [35, 344230], [51, 345250], [53, 345430], [56, 345590], [63, 346070], [66, 346190], [74, 346850], [77, 347330], [83, 347690], [87, 348110], [97, 349090], [108, 349970], [111, 350150]]}, {"verse": 48, "start": 351382, "end": 354522, "text": "Y vosotros sois testigos de estas cosas.", "words": [[0, 351382], [2, 351488], [11, 351988], [16, 352668], [25, 353268], [28, 353488], [34, 353668]]}, {"verse": 49, "start": 354872, "end": 366562, "text": "Y he aquí, yo enviaré la promesa de mi Padre sobre vosotros: pero vosotros permaneced en la ciudad de Jerusalén, hasta que seáis revestidos de poder de lo alto.", "words": [[0, 354872], [2, 354938], [5, 355038], [11, 355478], [14, 355778], [22, 356278], [25, 356398], [33, 356878], [36, 357058], [39, 357178], [45, 357658], [51, 357918], [61, 359024], [66, 359224], [75, 359804], [86, 360964], [89, 361284], [92, 361404], [99, 361784], [102, 362064], [113, 363164], [119, 363604], [123, 363804], [129, 364244], [140, 365104], [143, 365264], [149, 365584], [152, 365804], [155, 365944]]}, {"verse": 50, "start": 366912, "end": 371790, "text": "Y los sacó fuera hasta Betania, y alzando sus manos, los bendijo.", "words": [[0, 366912], [2, 367017], [6, 367157], [11, 367597], [17, 367877], [23, 368077], [32, 369197], [34, 369477], [42, 369957], [46, 370137], [53, 370497], [57, 371057]]}, {"verse": 51, "start": 372140, "end": 377843, "text": "Y aconteció que bendiciéndolos, se fue de ellos; y era llevado arriba al cielo.", "words": [[0, 372140], [2, 372429], [12, 373089], [16, 373289], [32, 374609], [35, 374729], [39, 374889], [42, 375069], [49, 375891], [51, 376048], [55, 376208], [63, 376648], [70, 376908], [73, 377228]]}, {"verse": 52, "start": 378193, "end": 382532, "text": "Y ellos, después de haberle adorado, se volvieron a Jerusalén con gran gozo;", "words": [[0, 378193], [2, 378368], [9, 378608], [17, 378948], [20, 379128], [28, 379528], [37, 380128], [40, 380208], [50, 380688], [52, 380808], [62, 381428], [66, 381608], [71, 381868]]}, {"verse": 53, "start": 382882, "end": 388274, "text": "Y estaban siempre en el templo, alabando y bendiciendo a Dios. Amén.", "words": [[0, 382882], [2, 382989], [10, 383269], [18, 383909], [21, 384169], [24, 384329], [32, 385389], [41, 385889], [43, 386009], [55, 386789], [57, 386929], [63, 387682]]}]}