{"book": "PSA", "chapter": 55, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 160242, "verses": [{"verse": 1, "start": 300, "end": 8816, "text": "Al Músico principal: en Neginoth: Masquil de David. ESCUCHA, oh Dios, mi oración, y no te escondas de mi súplica.", "words": [[0, 300], [3, 485], [10, 985], [21, 2151], [24, 2628], [34, 3326], [42, 3853], [45, 3953], [52, 4735], [61, 5066], [64, 5432], [70, 5799], [73, 6059], [82, 6579], [84, 7079], [87, 7219], [90, 7379], [99, 7939], [102, 8059], [105, 8139]]}, {"verse": 2, "start": 9166, "end": 14810, "text": "Préstame atención, y respóndeme: clamo en mi oración, y levanto el grito,", "words": [[0, 9421], [9, 9711], [19, 10311], [21, 11041], [33, 12064], [39, 12234], [42, 12374], [45, 12534], [54, 13074], [56, 13614], [64, 13934], [67, 14254]]}, {"verse": 3, "start": 15160, "end": 24449, "text": "A causa de la voz del enemigo, por la opresión del impío; porque echaron sobre mí iniquidad, y con furor me han amenazado.", "words": [[0, 15160], [2, 15302], [8, 15642], [11, 15902], [14, 16022], [18, 16242], [22, 16402], [31, 17022], [35, 17702], [38, 17862], [47, 18422], [51, 18602], [58, 19663], [65, 19927], [73, 20587], [79, 20847], [82, 21147], [93, 21907], [95, 22367], [99, 22647], [105, 23127], [108, 23287], [112, 23507]]}, {"verse": 4, "start": 24799, "end": 30571, "text": "Mi corazón está doloroso dentro de mí, y terrores de muerte sobre mí han caído.", "words": [[0, 24799], [3, 24962], [11, 25422], [16, 25802], [25, 26422], [32, 26682], [35, 26982], [39, 27162], [41, 27582], [50, 28202], [53, 28322], [60, 28702], [66, 29102], [69, 29442], [73, 29802]]}, {"verse": 5, "start": 30921, "end": 35486, "text": "Temor y temblor vinieron sobre mí, y terror me ha cubierto.", "words": [[0, 30921], [6, 31382], [8, 31642], [16, 32222], [25, 32722], [31, 33082], [35, 33802], [37, 33902], [44, 34222], [47, 34522], [50, 34662]]}, {"verse": 6, "start": 35836, "end": 41344, "text": "Y dije: ¡Quién me diese alas como de paloma! volaría yo, y descansaría.", "words": [[0, 36038], [2, 36284], [8, 36735], [15, 37019], [18, 37229], [24, 37439], [29, 38099], [34, 38339], [37, 38519], [45, 39441], [53, 39904], [57, 40164], [59, 40284]]}, {"verse": 7, "start": 41694, "end": 46742, "text": "Ciertamente huiría lejos: moraría en el desierto. (Selah.)", "words": [[0, 41694], [12, 42562], [19, 43222], [26, 44178], [34, 44726], [37, 44886], [40, 45026], [50, 46446]]}, {"verse": 8, "start": 47092, "end": 52106, "text": "Me apresuraría a escapar del viento tempestuoso, de la tempestad.", "words": [[0, 47092], [3, 47240], [15, 48240], [17, 48440], [25, 49120], [29, 49300], [36, 49820], [49, 50900], [52, 51100], [55, 51220]]}, {"verse": 9, "start": 52456, "end": 59269, "text": "Deshace, oh Señor, divide la lengua de ellos; porque he visto violencia y rencilla en la ciudad.", "words": [[0, 52456], [9, 53343], [12, 53363], [19, 53943], [26, 54103], [29, 54383], [36, 54743], [39, 54863], [46, 55475], [53, 55835], [56, 56095], [62, 56355], [72, 57095], [74, 57235], [83, 57995], [86, 58335], [89, 58515]]}, {"verse": 10, "start": 59619, "end": 65396, "text": "Día y noche la rodean sobre sus muros; e iniquidad y trabajo hay en medio de ella.", "words": [[0, 59619], [4, 59944], [6, 60044], [12, 60244], [15, 60484], [22, 61024], [28, 61324], [32, 61564], [39, 62406], [41, 62553], [51, 63253], [53, 63413], [61, 63893], [65, 64153], [68, 64333], [74, 64633], [77, 64873]]}, {"verse": 11, "start": 65746, "end": 71461, "text": "Agravios hay en medio de ella, y el fraude y engaño no se apartan de sus plazas.", "words": [[0, 65746], [9, 66412], [13, 66692], [16, 66892], [22, 67152], [25, 67392], [31, 67752], [33, 68007], [36, 68167], [43, 68687], [45, 68947], [52, 69507], [55, 69807], [58, 69967], [66, 70507], [69, 70693], [73, 70879]]}, {"verse": 12, "start": 71811, "end": 80982, "text": "Porque no me afrentó un enemigo, lo cual habría soportado; ni se alzó contra mí el que me aborrecía, porque me hubiera ocultado de él:", "words": [[0, 71814], [7, 72014], [10, 72214], [13, 72374], [21, 72874], [24, 73014], [33, 73494], [36, 73614], [41, 73834], [48, 74174], [59, 75312], [62, 75457], [65, 75637], [70, 76017], [77, 76377], [80, 76677], [83, 76957], [87, 77097], [90, 77277], [101, 78357], [108, 78897], [111, 79117], [119, 79497], [128, 80337], [131, 80557]]}, {"verse": 13, "start": 81332, "end": 86299, "text": "Mas tú, hombre, al parecer íntimo mío, mi guía, y mi familiar:", "words": [[0, 81332], [4, 81579], [8, 82039], [16, 82779], [19, 82899], [27, 83469], [34, 84039], [39, 84459], [42, 84559], [48, 85059], [50, 85319], [53, 85479]]}, {"verse": 14, "start": 86649, "end": 93100, "text": "Que juntos comunicábamos dulcemente los secretos, a la casa de Dios andábamos en compañía.", "words": [[0, 86649], [4, 86733], [11, 87093], [25, 88053], [36, 88773], [40, 88933], [50, 90073], [52, 90333], [55, 90433], [60, 90673], [63, 90913], [68, 91193], [78, 92093], [81, 92253]]}, {"verse": 15, "start": 93450, "end": 100958, "text": "Condenados sean a muerte, desciendan vivos al infierno: porque maldades hay en su compañía, entre ellos.", "words": [[0, 93450], [11, 94200], [16, 94420], [18, 94580], [26, 95480], [37, 96060], [43, 96620], [46, 96780], [56, 97849], [63, 98033], [72, 98673], [76, 98993], [79, 99173], [82, 99293], [92, 99993], [98, 100213]]}, {"verse": 16, "start": 101308, "end": 104389, "text": "Yo a Dios clamaré; y Jehová me salvará.", "words": [[0, 101308], [3, 101662], [5, 102049], [10, 102435], [19, 102978], [21, 103219], [28, 103499], [31, 103639]]}, {"verse": 17, "start": 104739, "end": 110175, "text": "Tarde y mañana y a medio día oraré y clamaré; y él oirá mi voz.", "words": [[0, 104739], [6, 105023], [8, 105263], [15, 105943], [17, 106003], [19, 106223], [25, 106443], [29, 106663], [35, 107243], [37, 107503], [46, 108459], [48, 108619], [51, 109015], [56, 109412], [59, 109532]]}, {"verse": 18, "start": 110525, "end": 116382, "text": "Él ha redimido en paz mi alma de la guerra contra mí; pues fueron contra mí muchos.", "words": [[0, 110525], [3, 110966], [6, 111206], [15, 111906], [18, 112066], [22, 112366], [25, 112706], [30, 112966], [33, 113186], [36, 113306], [43, 113586], [50, 114006], [54, 114584], [59, 114690], [66, 114970], [73, 115390], [76, 115610]]}, {"verse": 19, "start": 116732, "end": 126130, "text": "Dios oirá, y los quebrantará luego, el que desde la antigüedad permanece (Selah); por cuanto no se mudan, ni temen a Dios.", "words": [[0, 116732], [5, 117056], [11, 117896], [13, 118336], [17, 118516], [29, 119296], [36, 120076], [39, 120416], [43, 120556], [49, 120776], [52, 121016], [63, 121616], [73, 122450], [82, 123463], [86, 123743], [93, 123963], [96, 124243], [99, 124383], [106, 124823], [109, 125123], [115, 125483], [117, 125603]]}, {"verse": 20, "start": 126480, "end": 131060, "text": "Extendió sus manos contra sus pacíficos: violó su pacto.", "words": [[0, 126480], [9, 127400], [13, 127600], [19, 127980], [26, 128320], [30, 128540], [41, 129790], [47, 130235], [50, 130335]]}, {"verse": 21, "start": 131410, "end": 140437, "text": "Ablandan más que manteca su boca, pero guerra hay en su corazón: suavizan sus palabras más que el aceite, mas ellas son cuchillos.", "words": [[0, 131780], [9, 132150], [13, 132390], [17, 132590], [25, 133130], [28, 133310], [34, 133730], [39, 133970], [46, 134330], [50, 134750], [53, 134910], [56, 135090], [65, 136258], [74, 136628], [78, 136828], [87, 137208], [91, 137608], [95, 137808], [98, 137988], [106, 138328], [110, 138668], [116, 139288], [120, 139568]]}, {"verse": 22, "start": 140787, "end": 146529, "text": "Echa sobre Jehová tu carga, y él te sustentará; no dejará para siempre caído al justo.", "words": [[0, 140939], [5, 141129], [11, 141489], [18, 142009], [21, 142109], [28, 142509], [30, 143069], [33, 143229], [36, 143349], [48, 144498], [51, 144626], [58, 145106], [63, 145226], [71, 145666], [77, 146106], [80, 146226]]}, {"verse": 23, "start": 146879, "end": 159842, "text": "Mas tú, oh Dios, harás descender aquellos al pozo de la sepultura: los hombres sanguinarios y engañadores no llegarán a la mitad de sus días: pero yo confiaré en ti.", "words": [[0, 146879], [4, 147392], [8, 147733], [11, 148075], [17, 148315], [23, 149255], [33, 150055], [42, 150515], [45, 150975], [50, 151435], [53, 151515], [56, 151635], [67, 152693], [71, 152819], [79, 153239], [92, 154439], [94, 154559], [106, 155319], [109, 155819], [118, 156399], [120, 156479], [123, 156559], [129, 156799], [132, 157139], [136, 157299], [142, 158149], [147, 158294], [150, 158474], [159, 159214], [162, 159474]]}]}