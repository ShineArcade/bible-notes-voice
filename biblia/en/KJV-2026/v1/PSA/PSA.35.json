{"book": "PSA", "chapter": 35, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 195094, "verses": [{"verse": 1, "start": 300, "end": 6514, "text": "Plead my cause, O LORD, with them that strive with me: fight against them that fight against me.", "words": [[0, 300], [6, 576], [9, 736], [16, 1276], [18, 1336], [24, 2156], [29, 2376], [34, 2636], [39, 2876], [46, 3256], [51, 3516], [55, 4303], [61, 4449], [69, 4849], [74, 5169], [79, 5389], [85, 5629], [93, 6029]]}, {"verse": 2, "start": 6964, "end": 10361, "text": "Take hold of shield and buckler, and stand up for my help.", "words": [[0, 6964], [5, 7106], [10, 7406], [13, 7586], [20, 7886], [24, 8146], [33, 8606], [37, 9046], [43, 9326], [46, 9566], [50, 9746], [53, 9926]]}, {"verse": 3, "start": 10811, "end": 18094, "text": "Draw out also the spear, and stop the way against them that persecute me: say to my soul, I am your salvation.", "words": [[0, 10811], [5, 10991], [9, 11251], [14, 11651], [18, 11851], [25, 12191], [29, 12531], [34, 12831], [38, 13071], [42, 13231], [50, 13611], [55, 13891], [60, 14071], [70, 14751], [74, 15309], [78, 15514], [81, 15634], [84, 15794], [90, 16654], [92, 16914], [95, 17134], [100, 17274]]}, {"verse": 4, "start": 18544, "end": 26399, "text": "Let them be confounded and put to shame that seek after my soul: let them be turned back and brought to confusion that devise my hurt.", "words": [[0, 18544], [4, 18704], [9, 18904], [12, 19084], [23, 19764], [27, 19944], [31, 20124], [34, 20284], [40, 20624], [45, 20904], [50, 21164], [56, 21504], [59, 21704], [65, 22557], [69, 22687], [74, 22887], [77, 23067], [84, 23367], [89, 23747], [93, 24067], [101, 24287], [104, 24467], [114, 24967], [119, 25227], [126, 25707], [129, 25887]]}, {"verse": 5, "start": 26849, "end": 31486, "text": "Let them be as chaff before the wind: and let the angel of the LORD chase them.", "words": [[0, 26849], [4, 26979], [9, 27199], [12, 27379], [15, 27539], [21, 27919], [28, 28279], [32, 28519], [38, 29291], [42, 29398], [46, 29558], [50, 29738], [56, 30138], [59, 30318], [63, 30458], [68, 30698], [74, 31038]]}, {"verse": 6, "start": 31936, "end": 36946, "text": "Let their way be dark and slippery: and let the angel of the LORD persecute them.", "words": [[0, 31936], [4, 32294], [10, 32514], [14, 32714], [17, 32874], [22, 33174], [26, 33414], [36, 34413], [40, 34573], [44, 34733], [48, 34913], [54, 35293], [57, 35473], [61, 35593], [66, 35833], [76, 36613]]}, {"verse": 7, "start": 37396, "end": 43486, "text": "For without cause have they hid for me their net in a pit, which without cause they have dug for my soul.", "words": [[0, 37396], [4, 37523], [12, 37863], [18, 38383], [23, 38683], [28, 38863], [32, 39063], [36, 39263], [39, 39443], [45, 39603], [49, 39863], [52, 40103], [54, 40203], [59, 40903], [65, 41103], [73, 41443], [79, 41843], [84, 42043], [89, 42223], [93, 42483], [97, 42723], [100, 42923]]}, {"verse": 8, "start": 43936, "end": 53102, "text": "Let destruction come upon him at unawares; and let his net that he has hid catch himself: into that very destruction let him fall.", "words": [[0, 43936], [4, 44103], [16, 44663], [21, 45003], [26, 45323], [30, 45623], [33, 45783], [43, 46996], [47, 47122], [51, 47282], [55, 47482], [59, 47802], [64, 48082], [67, 48242], [71, 48442], [75, 48742], [81, 49122], [90, 50299], [95, 50505], [100, 50745], [105, 51085], [117, 51765], [121, 52185], [125, 52405]]}, {"verse": 9, "start": 53552, "end": 58570, "text": "And my soul shall be joyful in the LORD: it shall rejoice in his salvation.", "words": [[0, 53552], [4, 53700], [7, 53900], [12, 54300], [18, 54640], [21, 54800], [28, 55240], [31, 55540], [35, 55660], [41, 56444], [44, 56548], [50, 56748], [58, 57248], [61, 57608], [65, 57748]]}, {"verse": 10, "start": 59020, "end": 69159, "text": "All my bones shall say, LORD, who is like to you, which deliver the poor from him that is too strong for him, yes, the poor and the needy from him that spoils him?", "words": [[0, 59020], [4, 59172], [7, 59392], [13, 59732], [19, 60052], [24, 60432], [30, 60952], [34, 61072], [37, 61232], [42, 61452], [45, 61732], [50, 62132], [56, 62252], [64, 62632], [68, 62872], [73, 63172], [78, 63452], [82, 63692], [87, 63932], [90, 64092], [94, 64312], [101, 64732], [105, 65072], [110, 65290], [115, 66315], [119, 66395], [124, 66755], [128, 67055], [132, 67175], [138, 67535], [143, 67775], [147, 68015], [152, 68235], [159, 68835]]}, {"verse": 11, "start": 69609, "end": 74019, "text": "False witnesses did rise up; they laid to my charge things that I knew not.", "words": [[0, 69609], [6, 69817], [16, 70237], [20, 70557], [25, 70857], [29, 71596], [34, 71694], [39, 71934], [42, 72114], [45, 72274], [52, 72614], [59, 72974], [64, 73254], [66, 73374], [71, 73574]]}, {"verse": 12, "start": 74469, "end": 77909, "text": "They rewarded me evil for good to the spoiling of my soul.", "words": [[0, 74469], [5, 74573], [14, 74993], [17, 75313], [22, 75673], [26, 75913], [31, 76133], [34, 76333], [38, 76453], [47, 76993], [50, 77133], [53, 77313]]}, {"verse": 13, "start": 78359, "end": 87655, "text": "But as for me, when they were sick, my clothing was sackcloth: I humbled my soul with fasting; and my prayer returned into my own bosom.", "words": [[0, 78359], [4, 78546], [7, 78746], [11, 78966], [15, 79766], [20, 79946], [25, 80126], [30, 80266], [36, 81066], [39, 81226], [48, 81586], [52, 82174], [63, 83017], [65, 83142], [73, 83402], [76, 83702], [81, 84042], [86, 84262], [95, 85304], [99, 85432], [102, 85592], [109, 85912], [118, 86392], [123, 86632], [126, 86872], [130, 87012]]}, {"verse": 14, "start": 88105, "end": 95112, "text": "I behaved myself as though he had been my friend or brother: I bowed down heavily, as one that mourns for his mother.", "words": [[0, 88105], [2, 88245], [10, 88545], [17, 89085], [20, 89385], [27, 89605], [30, 89805], [34, 89965], [39, 90125], [42, 90305], [49, 90665], [52, 90965], [61, 91816], [63, 91938], [69, 92398], [74, 92558], [83, 93018], [86, 93458], [90, 93698], [95, 93878], [102, 94298], [106, 94458], [110, 94618]]}, {"verse": 15, "start": 95562, "end": 106480, "text": "But in my adversity they rejoiced, and gathered themselves together: yes, the abjects gathered themselves together against me, and I knew it not; they did tear me, and ceased not:", "words": [[0, 95562], [4, 95650], [7, 95790], [10, 95990], [20, 96430], [25, 96710], [35, 97350], [39, 97650], [48, 97990], [59, 98410], [69, 99426], [74, 99918], [78, 100018], [86, 100578], [95, 100878], [106, 101398], [115, 101858], [123, 102318], [127, 102978], [131, 103158], [133, 103278], [138, 103478], [141, 103598], [146, 104351], [151, 104449], [155, 104789], [160, 105109], [164, 105309], [168, 105629], [175, 106091]]}, {"verse": 16, "start": 106930, "end": 111125, "text": "With hypocritical mockers in feasts, they gnashed upon me with their teeth.", "words": [[0, 106930], [5, 107210], [18, 107890], [26, 108230], [29, 108570], [37, 109270], [42, 109350], [50, 109750], [55, 109950], [58, 110270], [63, 110470], [69, 110610]]}, {"verse": 17, "start": 111575, "end": 118052, "text": "Lord, how long will you look on? rescue my soul from their destructions, my darling from the lions.", "words": [[0, 111575], [6, 112121], [10, 112261], [15, 112581], [20, 112861], [24, 113021], [29, 113241], [33, 114072], [40, 114378], [43, 114698], [48, 115038], [53, 115278], [59, 115478], [73, 116378], [76, 116478], [84, 116878], [89, 117178], [93, 117338]]}, {"verse": 18, "start": 118502, "end": 123604, "text": "I will give you thanks in the great congregation: I will praise you among much people.", "words": [[0, 118502], [2, 118647], [7, 118787], [12, 118987], [16, 119187], [23, 119497], [26, 119807], [30, 119927], [36, 120147], [50, 121500], [52, 121643], [57, 121823], [64, 122123], [68, 122443], [74, 122663], [79, 123023]]}, {"verse": 19, "start": 124054, "end": 130964, "text": "Let not them that are my enemies wrongfully rejoice over me: neither let them wink with the eye that hate me without a cause.", "words": [[0, 124054], [4, 124196], [8, 124436], [13, 124816], [18, 125136], [22, 125256], [25, 125396], [33, 125776], [44, 126476], [52, 126796], [57, 127176], [61, 127785], [69, 128029], [73, 128309], [78, 128509], [83, 128729], [88, 128949], [92, 129069], [96, 129349], [101, 129549], [106, 129749], [109, 129929], [117, 130229], [119, 130349]]}, {"verse": 20, "start": 131414, "end": 137379, "text": "For they speak not peace: but they devise deceitful matters against them that are quiet in the land.", "words": [[0, 131414], [4, 131510], [9, 131630], [15, 131950], [19, 132210], [26, 133160], [30, 133268], [35, 133408], [42, 133948], [52, 134628], [60, 134988], [68, 135388], [73, 135748], [78, 135928], [82, 136068], [88, 136468], [91, 136748], [95, 136848]]}, {"verse": 21, "start": 137829, "end": 143625, "text": "Yes, they opened their mouth wide against me, and said, Aha, aha, our eye has seen it.", "words": [[0, 137829], [5, 138229], [10, 138329], [17, 138569], [23, 138789], [29, 139029], [34, 139369], [42, 139709], [46, 140029], [50, 140249], [56, 141082], [61, 141258], [66, 141435], [70, 141612], [74, 141788], [78, 141965], [83, 142225]]}, {"verse": 22, "start": 143975, "end": 148936, "text": "This you have seen, O LORD: keep not silence: O Lord, be not far from me.", "words": [[0, 143975], [5, 144166], [9, 144326], [14, 144466], [20, 144826], [22, 144886], [28, 145632], [33, 145796], [37, 146036], [46, 147149], [48, 147292], [54, 147732], [57, 147812], [61, 148012], [65, 148332], [70, 148592]]}, {"verse": 23, "start": 149386, "end": 154841, "text": "Stir up yourself, and awake to my judgment, even to my cause, my God and my Lord.", "words": [[0, 149386], [5, 149609], [8, 149829], [18, 150209], [22, 150469], [28, 150709], [31, 150929], [34, 151069], [44, 151709], [49, 151969], [52, 152169], [55, 152329], [62, 152909], [65, 153009], [69, 153309], [73, 153509], [76, 153689]]}, {"verse": 24, "start": 155291, "end": 161089, "text": "Judge me, O LORD my God, according to your righteousness; and let them not rejoice over me.", "words": [[0, 155291], [6, 155502], [10, 155822], [12, 155902], [17, 156162], [20, 156382], [25, 157122], [35, 157582], [38, 157862], [43, 158042], [58, 159257], [62, 159397], [66, 159537], [71, 159757], [75, 159957], [83, 160297], [88, 160717]]}, {"verse": 25, "start": 161539, "end": 167681, "text": "Let them not say in their hearts, Ah, so would we have it: let them not say, We have swallowed him up.", "words": [[0, 161539], [4, 161666], [9, 161906], [13, 162106], [17, 162366], [20, 162526], [26, 162666], [34, 163326], [38, 163906], [41, 164126], [47, 164346], [50, 164546], [55, 164806], [59, 165371], [63, 165503], [68, 165723], [72, 165923], [77, 166263], [80, 166523], [85, 166643], [95, 167063], [99, 167303]]}, {"verse": 26, "start": 168131, "end": 177588, "text": "Let them be ashamed and brought to confusion together that rejoice at my hurt: let them be clothed with shame and dishonour that magnify themselves against me.", "words": [[0, 168131], [4, 168259], [9, 168499], [12, 168679], [20, 169159], [24, 169439], [32, 169679], [35, 169859], [45, 170319], [54, 170779], [59, 171119], [67, 171519], [70, 171859], [73, 172059], [79, 172869], [83, 172997], [88, 173197], [91, 173377], [99, 173977], [104, 174097], [110, 174517], [114, 174927], [124, 175337], [129, 175497], [137, 176177], [148, 176457], [156, 177097]]}, {"verse": 27, "start": 178038, "end": 189840, "text": "Let them shout for joy, and be glad, that favour my righteous cause: yes, let them say continually, Let the LORD be magnified, which has pleasure in the prosperity of his servant.", "words": [[0, 178038], [4, 178388], [9, 178648], [15, 178928], [19, 179188], [24, 179808], [28, 179948], [31, 180108], [37, 180808], [42, 181078], [49, 181348], [52, 181568], [62, 181968], [69, 183001], [74, 183373], [78, 183473], [83, 183673], [87, 183933], [100, 185213], [104, 185433], [108, 185593], [113, 185853], [116, 186053], [127, 187133], [133, 187393], [137, 187593], [146, 187953], [149, 188193], [153, 188273], [164, 188713], [167, 189113], [171, 189233]]}, {"verse": 28, "start": 190290, "end": 194694, "text": "And my tongue shall speak of your righteousness and of your praise all the day long.", "words": [[0, 190290], [4, 190420], [7, 190580], [14, 190900], [20, 191220], [26, 191520], [29, 191760], [34, 191860], [48, 192340], [52, 192720], [55, 192860], [60, 192980], [67, 193380], [71, 193760], [75, 193920], [79, 194120]]}]}