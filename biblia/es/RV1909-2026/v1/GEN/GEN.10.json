{"book": "GEN", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 211076, "verses": [{"verse": 1, "start": 300, "end": 9121, "text": "Estas son las generaciones de los hijos de Noé: Sem, Cam y Jafet, a los cuales nacieron hijos después del diluvio.", "words": [[0, 300], [6, 758], [10, 978], [14, 1178], [27, 1998], [30, 2198], [34, 2338], [40, 2638], [43, 2838], [48, 3569], [53, 4126], [57, 4716], [59, 5196], [66, 6096], [68, 6176], [72, 6296], [79, 6476], [88, 7136], [94, 7576], [102, 8136], [106, 8376]]}, {"verse": 2, "start": 9571, "end": 15917, "text": "Los hijos de Jafet: Gomer, y Magog, y Madai, y Javán, y Tubal, y Mesec, y Tiras.", "words": [[0, 9571], [4, 9680], [10, 9920], [13, 10329], [20, 10990], [27, 11455], [29, 11715], [36, 12215], [38, 12585], [45, 12955], [47, 13335], [54, 13715], [56, 13935], [63, 14415], [65, 14765], [72, 15115], [74, 15315]]}, {"verse": 3, "start": 16367, "end": 20356, "text": "Y los hijos de Gomer: Askenaz, y Rifat, y Togarma.", "words": [[0, 16367], [2, 16476], [6, 16616], [12, 16916], [15, 17156], [22, 18327], [31, 18697], [33, 19077], [40, 19457], [42, 19657]]}, {"verse": 4, "start": 20806, "end": 25827, "text": "Y los hijos de Javán: Elisa, y Tarsis, Quitim, y Dodanim.", "words": [[0, 20806], [2, 20909], [6, 21029], [12, 21349], [15, 21800], [22, 22534], [29, 23174], [31, 23414], [39, 23974], [47, 24534], [49, 25014]]}, {"verse": 5, "start": 26277, "end": 32745, "text": "Por estos se poblaron las costas, cada cual según su lengua, conforme a sus familias en sus naciones.", "words": [[0, 26277], [4, 26441], [10, 26641], [13, 26861], [22, 27361], [26, 27521], [34, 28501], [39, 28901], [44, 29221], [50, 29561], [53, 29841], [61, 30301], [70, 30881], [72, 30941], [76, 31061], [85, 31641], [88, 31761], [92, 31901]]}, {"verse": 6, "start": 33195, "end": 37369, "text": "Los hijos de Cam: Cus, y Mizraim, y Fut, y Canaán.", "words": [[0, 33195], [4, 33300], [10, 33580], [13, 34062], [18, 34845], [23, 34845], [25, 35380], [34, 35920], [36, 36240], [41, 36560], [43, 36964]]}, {"verse": 7, "start": 37819, "end": 47430, "text": "Y los hijos de Cus: Seba, Havila, y Sabta, y Raama, y Sabteca. Y los hijos de Raama: Sheba y Dedán.", "words": [[0, 37819], [2, 37956], [6, 38076], [12, 38316], [15, 38641], [20, 39754], [26, 40278], [34, 40802], [36, 41326], [43, 41850], [45, 42373], [52, 42897], [54, 43421], [63, 44186], [65, 44314], [69, 44454], [75, 44734], [78, 45247], [85, 46230], [91, 46480], [93, 46955]]}, {"verse": 8, "start": 47880, "end": 53827, "text": "Y Cus engendró a Nimrod: este comenzó a ser poderoso en la tierra.", "words": [[0, 47880], [2, 48098], [6, 48358], [15, 48978], [17, 49198], [25, 50569], [30, 51027], [38, 51767], [40, 51867], [44, 52107], [53, 52827], [56, 52987], [59, 53107]]}, {"verse": 9, "start": 54277, "end": 64336, "text": "Este fue vigoroso cazador delante de Jehová; por lo cual se dice: Así como Nimrod, vigoroso cazador delante de Jehová.", "words": [[0, 54277], [5, 54664], [9, 55004], [18, 55684], [26, 56344], [34, 56864], [37, 57024], [45, 58066], [49, 58193], [52, 58313], [57, 58573], [60, 58793], [66, 59706], [70, 60066], [75, 60386], [83, 61646], [92, 62346], [100, 62986], [108, 63486], [111, 63646]]}, {"verse": 10, "start": 64786, "end": 71072, "text": "Y fue la cabecera de su reino Babel, y Erec, y Accad, y Calne, en la tierra de Sinar.", "words": [[0, 64786], [2, 64911], [6, 65071], [9, 65231], [18, 65791], [21, 65911], [24, 66091], [30, 66551], [37, 67011], [39, 67411], [45, 67811], [47, 68251], [54, 68691], [56, 69111], [63, 69531], [66, 69871], [69, 69971], [76, 70355], [79, 70738]]}, {"verse": 11, "start": 71522, "end": 77088, "text": "De esta tierra salió Assur, y edificó a Nínive, y a Rehobot, y a Cala,", "words": [[0, 71522], [3, 71647], [8, 71807], [15, 72167], [21, 72607], [28, 73047], [30, 73577], [38, 74107], [40, 74287], [48, 74867], [50, 75347], [52, 75757], [61, 76167], [63, 76527], [65, 76627]]}, {"verse": 12, "start": 77538, "end": 82636, "text": "Y a Resén entre Nínive y Cala; la cual es ciudad grande.", "words": [[0, 77538], [2, 77741], [4, 77967], [10, 78194], [16, 78864], [23, 79534], [25, 80007], [31, 80728], [34, 80851], [39, 81051], [42, 81292], [49, 81892]]}, {"verse": 13, "start": 83086, "end": 88783, "text": "Y Mizraim engendró a Ludim, y a Anamim, y a Lehabim, y a naftuhim,", "words": [[0, 83086], [2, 83431], [10, 83807], [19, 84183], [21, 84559], [28, 84935], [30, 85311], [32, 85687], [40, 86063], [42, 86439], [44, 86815], [53, 87188], [55, 87562], [57, 87935]]}, {"verse": 14, "start": 89233, "end": 95192, "text": "Y a patrusim, y a Casluhim, de donde salieron los filisteos, y a caftoreos.", "words": [[0, 89233], [2, 89377], [4, 89827], [14, 90277], [16, 90577], [18, 91257], [28, 91937], [31, 92057], [37, 92237], [46, 92837], [50, 93037], [61, 93897], [63, 94137], [65, 94694]]}, {"verse": 15, "start": 95642, "end": 100511, "text": "Y Canaán engendró a Sidón, su primogénito, y a Het,", "words": [[0, 95642], [2, 95959], [9, 96309], [18, 96981], [20, 97653], [27, 98325], [30, 98997], [43, 99669], [45, 99969], [47, 100269]]}, {"verse": 16, "start": 100961, "end": 104983, "text": "Y al jebuseo, y al amorreo, y al gergeseo,", "words": [[0, 100961], [2, 101124], [5, 101614], [14, 102104], [16, 102484], [19, 102604], [28, 103404], [30, 103764], [33, 104374]]}, {"verse": 17, "start": 105433, "end": 108677, "text": "Y al heveo, y al araceo, y al sineo,", "words": [[0, 105433], [2, 105612], [5, 105922], [12, 106232], [14, 106472], [17, 106962], [25, 107452], [27, 107872], [30, 108308]]}, {"verse": 18, "start": 109127, "end": 116472, "text": "Y al arvadeo, y al zemareo, y al amateo: y después se derramaron las familias de los cananeos.", "words": [[0, 109127], [2, 109256], [5, 109356], [14, 110576], [16, 110616], [19, 111176], [28, 111736], [30, 111736], [33, 111856], [41, 112883], [43, 112985], [51, 113345], [54, 113965], [65, 114625], [69, 114805], [78, 115385], [81, 115445], [85, 115565]]}, {"verse": 19, "start": 116922, "end": 126364, "text": "Y fue el término de los cananeos desde Sidón, viniendo a Gerar hasta Gaza, hasta entrar en Sodoma y Gomorra, Adma, y Zeboim hasta Lasa.", "words": [[0, 116922], [2, 117040], [6, 117220], [9, 117400], [17, 117940], [20, 118000], [24, 118140], [33, 118720], [39, 118900], [46, 119480], [55, 120220], [57, 120320], [63, 120570], [69, 120820], [75, 121220], [81, 121640], [88, 122040], [91, 122220], [98, 122720], [100, 122840], [109, 123470], [115, 124100], [117, 124700], [124, 125300], [130, 125865]]}, {"verse": 20, "start": 126814, "end": 133130, "text": "Estos son los hijos de Cam por sus familias, por sus lenguas, en sus tierras, en sus naciones.", "words": [[0, 126814], [6, 127119], [10, 127339], [14, 127479], [20, 127779], [23, 127999], [27, 128239], [31, 128559], [35, 128719], [45, 129719], [49, 129799], [53, 129979], [62, 130859], [65, 130979], [69, 131139], [78, 131919], [81, 131979], [85, 132199]]}, {"verse": 21, "start": 133580, "end": 140101, "text": "También le nacieron hijos a Sem, padre de todos los hijos de Heber, y hermano mayor de Jafet.", "words": [[0, 133580], [8, 133824], [11, 134044], [20, 134544], [26, 134824], [28, 135104], [33, 135724], [39, 136084], [42, 136304], [48, 136564], [52, 136884], [58, 137184], [61, 137554], [68, 137924], [70, 138464], [78, 138984], [84, 139244], [87, 139464]]}, {"verse": 22, "start": 140551, "end": 146622, "text": "Y los hijos de Sem: Elam, y Assur, y Arfaxad, y Lud, y Aram.", "words": [[0, 140551], [2, 140783], [6, 140943], [12, 141223], [15, 141483], [20, 143111], [26, 143111], [28, 143546], [35, 144016], [37, 144576], [46, 145136], [48, 145566], [53, 145996], [55, 146096]]}, {"verse": 23, "start": 147072, "end": 151480, "text": "Y los hijos de Aram: Uz, y Hul, y Geter, y Mas.", "words": [[0, 147072], [2, 147202], [6, 147322], [12, 147622], [15, 147902], [21, 149222], [25, 149592], [27, 150152], [32, 150712], [34, 150912], [41, 151112], [43, 151312]]}, {"verse": 24, "start": 151930, "end": 157139, "text": "Y Arfaxad engendró a Sala, y Sala engendró a Heber.", "words": [[0, 152750], [2, 153010], [10, 153810], [19, 154530], [21, 154670], [27, 155030], [29, 155470], [34, 155810], [43, 156450], [45, 156824]]}, {"verse": 25, "start": 157589, "end": 168315, "text": "Y a Heber nacieron dos hijos: el nombre del uno fue Peleg, porque en sus días fue repartida la tierra; y el nombre de su hermano, Joctán.", "words": [[0, 157589], [2, 157854], [4, 158004], [10, 158154], [19, 158714], [23, 159014], [30, 160022], [33, 160185], [40, 160545], [44, 160765], [48, 161005], [52, 161265], [59, 162005], [66, 162685], [69, 163005], [73, 163185], [78, 163465], [82, 163745], [92, 164525], [95, 164685], [103, 165687], [105, 165996], [108, 166116], [115, 166476], [118, 166716], [121, 166856], [130, 167586]]}, {"verse": 26, "start": 168765, "end": 174639, "text": "Y Joctán engendró a Almodad, y a Selef, y Hazarmaveth, y a Jera,", "words": [[0, 169030], [2, 169330], [9, 169630], [18, 170410], [20, 170630], [29, 171490], [31, 171670], [33, 172020], [40, 172370], [42, 173020], [55, 173670], [57, 174030], [59, 174130]]}, {"verse": 27, "start": 175089, "end": 177986, "text": "Y a Adoram, y a Uzal, y a Dicla,", "words": [[0, 175089], [2, 175232], [4, 175492], [12, 176092], [14, 176352], [16, 176652], [22, 176952], [24, 177332], [26, 177432]]}, {"verse": 28, "start": 178436, "end": 181639, "text": "Y a Obal, y a Abimael, y a Seba,", "words": [[0, 178436], [2, 178619], [4, 178679], [10, 179219], [12, 179739], [14, 179819], [23, 180579], [25, 180999], [27, 181319]]}, {"verse": 29, "start": 182089, "end": 187443, "text": "Y a Ofir, y a Havila, y a Jobab: todos estos fueron hijos de Joctán.", "words": [[0, 182202], [2, 182316], [4, 182429], [10, 182808], [12, 183188], [14, 183567], [22, 183947], [24, 184326], [26, 184706], [33, 185324], [39, 185547], [45, 185867], [52, 186207], [58, 186547], [61, 187030]]}, {"verse": 30, "start": 187893, "end": 194205, "text": "Y fue su habitación desde Mesa viniendo de Sefar, monte a la parte del oriente.", "words": [[0, 187893], [2, 188015], [6, 188175], [9, 188415], [20, 189095], [26, 189375], [31, 189855], [40, 190335], [43, 190515], [50, 191455], [56, 191715], [58, 191975], [61, 192195], [67, 192475], [71, 192735]]}, {"verse": 31, "start": 194655, "end": 200860, "text": "Estos fueron los hijos de Sem por sus familias, por sus lenguas, en sus tierras, en sus naciones.", "words": [[0, 194655], [6, 194655], [13, 194915], [17, 195195], [23, 195575], [26, 195815], [30, 195975], [34, 196255], [38, 196455], [48, 197155], [52, 197195], [56, 197395], [65, 198195], [68, 198435], [72, 198595], [81, 199795], [84, 199875], [88, 200035]]}, {"verse": 32, "start": 201310, "end": 210676, "text": "Estas son las familias de Noé por sus descendencias, en sus naciones; y de estos se esparcieron las naciones en la tierra después del diluvio.", "words": [[0, 201310], [6, 201715], [10, 201855], [14, 202015], [23, 202535], [26, 202655], [30, 202955], [34, 203115], [38, 203295], [53, 204175], [56, 204375], [60, 204575], [70, 205739], [72, 206051], [75, 206191], [81, 206471], [84, 206771], [96, 207591], [100, 207771], [109, 208231], [112, 208451], [115, 208571], [122, 208911], [130, 209631], [134, 209931]]}]}