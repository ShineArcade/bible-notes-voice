{"book": "GEN", "chapter": 40, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 205585, "verses": [{"verse": 1, "start": 300, "end": 9746, "text": "Y aconteció después de estas cosas, que el copero del rey de Egipto y el panadero delinquieron contra su señor el rey de Egipto.", "words": [[0, 300], [2, 445], [12, 1225], [20, 1545], [23, 1785], [29, 1985], [36, 3025], [40, 3145], [43, 3265], [50, 3865], [54, 4105], [58, 4405], [61, 4505], [68, 5065], [70, 5185], [73, 5345], [82, 5885], [95, 6745], [102, 7125], [105, 7405], [111, 7845], [114, 8485], [118, 8905], [121, 9005]]}, {"verse": 2, "start": 10196, "end": 18485, "text": "Y se enojó Faraón contra sus dos eunucos, contra el principal de los coperos, y contra el principal de los panaderos:", "words": [[0, 10196], [2, 10340], [5, 10540], [11, 11080], [18, 11680], [25, 12060], [29, 12400], [33, 12660], [42, 13880], [49, 14340], [52, 14520], [62, 14940], [65, 15280], [69, 15400], [78, 15880], [80, 16300], [87, 16660], [90, 16820], [100, 17260], [103, 17560], [107, 17680]]}, {"verse": 3, "start": 18935, "end": 26348, "text": "Y los puso en prisión en la casa del capitán de los de la guardia, en la casa de la cárcel donde José estaba preso.", "words": [[0, 18935], [2, 19059], [6, 19159], [11, 19559], [14, 19699], [22, 20159], [25, 20379], [28, 20499], [33, 20739], [37, 20959], [45, 21499], [48, 21639], [52, 21779], [55, 22039], [58, 22179], [67, 23139], [70, 23239], [73, 23359], [78, 23619], [81, 23799], [84, 23919], [91, 24379], [97, 24939], [102, 25299], [109, 25699]]}, {"verse": 4, "start": 26798, "end": 34547, "text": "Y el capitán de los de la guardia dio cargo de ellos a José, y él les servía: y estuvieron días en la prisión.", "words": [[0, 26798], [2, 26921], [5, 27001], [13, 27521], [16, 27641], [20, 27781], [23, 27881], [26, 28001], [34, 28401], [38, 28621], [44, 28961], [47, 29201], [53, 29421], [55, 29661], [61, 30021], [63, 30681], [66, 30931], [70, 31181], [78, 32204], [80, 32428], [91, 32888], [96, 33268], [99, 33728], [102, 33868]]}, {"verse": 5, "start": 34997, "end": 48781, "text": "Y ambos, el copero y el panadero del rey de Egipto, que estaban arrestados en la prisión, vieron un sueño, cada uno su sueño en una misma noche, cada uno conforme a la interpretación de su sueño.", "words": [[0, 34997], [2, 35156], [9, 35436], [12, 35656], [19, 36116], [21, 36256], [24, 36396], [33, 36936], [37, 37096], [41, 37436], [44, 37536], [52, 38136], [56, 38216], [64, 38496], [75, 39616], [78, 39836], [81, 39976], [90, 40916], [97, 41336], [100, 41536], [107, 42296], [112, 42576], [116, 42896], [119, 43136], [125, 43696], [128, 43976], [132, 44136], [138, 44376], [145, 45253], [150, 45437], [154, 45717], [163, 46497], [165, 46597], [168, 46677], [183, 47777], [186, 47997], [189, 48157]]}, {"verse": 6, "start": 49231, "end": 54586, "text": "Y vino a ellos José por la mañana, y los miró, y he aquí que estaban tristes.", "words": [[0, 49231], [2, 49354], [7, 49614], [9, 49794], [15, 50054], [20, 50454], [24, 50714], [27, 50854], [35, 51274], [37, 51734], [41, 51894], [47, 52694], [49, 52914], [52, 53054], [57, 53314], [61, 53454], [69, 53734]]}, {"verse": 7, "start": 55036, "end": 65196, "text": "Y él preguntó a aquellos oficiales de Faraón, que estaban con él en la prisión de la casa de su señor, diciendo: ¿Por qué tenéis hoy tan mala cara?", "words": [[0, 55036], [2, 55262], [5, 55502], [14, 56322], [16, 56542], [25, 56882], [35, 57802], [38, 58172], [46, 58542], [50, 59082], [58, 59362], [62, 59662], [65, 59842], [68, 60082], [71, 60372], [79, 60662], [82, 60802], [85, 60922], [90, 61162], [93, 61382], [96, 61542], [103, 61962], [113, 63246], [118, 63388], [122, 63588], [129, 64028], [133, 64228], [137, 64428], [142, 64688]]}, {"verse": 8, "start": 65546, "end": 76647, "text": "Y ellos le dijeron: Hemos tenido un sueño, y no hay quien lo interprete. Entonces les dijo José: ¿No son de Dios las interpretaciones? Contádmelo ahora.", "words": [[0, 65546], [2, 65729], [8, 65929], [11, 66109], [20, 67096], [26, 67289], [33, 67589], [36, 67829], [43, 68629], [45, 68809], [48, 69009], [52, 69229], [58, 69529], [61, 69749], [73, 70966], [82, 71533], [86, 71933], [91, 72253], [97, 72971], [101, 73152], [105, 73412], [108, 73572], [113, 73772], [117, 73972], [135, 75548], [146, 76126]]}, {"verse": 9, "start": 76997, "end": 84556, "text": "Entonces el principal de los coperos contó su sueño a José, y le dijo: Yo soñaba que veía una vid delante de mí,", "words": [[0, 76997], [9, 78080], [12, 78180], [22, 78720], [25, 79020], [29, 79120], [37, 79580], [43, 80080], [46, 80240], [52, 80620], [54, 80740], [60, 81020], [62, 81280], [65, 81400], [71, 82191], [74, 82296], [81, 82716], [85, 82876], [90, 83216], [94, 83376], [98, 83576], [106, 84036], [109, 84216]]}, {"verse": 10, "start": 85006, "end": 91895, "text": "Y en la vid tres ramas; y ella como que brotaba, y arrojaba su flor, viniendo a madurar sus racimos de uvas:", "words": [[0, 85006], [2, 85124], [5, 85224], [8, 85394], [12, 85564], [17, 85924], [24, 86879], [26, 87041], [31, 87241], [36, 87561], [40, 87881], [49, 88201], [51, 88341], [60, 88781], [63, 88941], [69, 89281], [78, 90001], [80, 90061], [88, 90441], [92, 90681], [100, 91181], [103, 91381]]}, {"verse": 11, "start": 92345, "end": 102023, "text": "Y que la copa de Faraón estaba en mi mano, y tomaba yo las uvas, y las exprimía en la copa de Faraón, y daba yo la copa en mano de Faraón.", "words": [[0, 92345], [2, 92450], [6, 92550], [9, 92690], [14, 93010], [17, 93090], [24, 93550], [31, 93850], [34, 94050], [37, 94170], [43, 94470], [45, 95090], [52, 95450], [55, 95630], [59, 95770], [65, 96250], [67, 96510], [71, 96670], [80, 97330], [83, 97430], [86, 97530], [91, 97830], [94, 97910], [102, 98880], [104, 98987], [109, 99227], [112, 99347], [115, 99487], [120, 99847], [123, 99947], [128, 100167], [131, 101112]]}, {"verse": 12, "start": 102373, "end": 107500, "text": "Y le dijo José: Esta es su interpretación: Los tres sarmientos son tres días:", "words": [[0, 102373], [2, 102534], [5, 102704], [10, 102874], [16, 103708], [21, 104008], [24, 104208], [27, 104348], [43, 105640], [47, 105741], [52, 106111], [63, 106481], [67, 106701], [72, 106921]]}, {"verse": 13, "start": 107950, "end": 119212, "text": "Al cabo de tres días Faraón te hará levantar cabeza, y te restituirá a tu puesto: y darás la copa a Faraón en su mano, como solías cuando eras su copero.", "words": [[0, 107950], [3, 108092], [8, 108292], [11, 108472], [16, 108692], [21, 109092], [28, 109492], [31, 109612], [36, 109772], [45, 110252], [53, 110672], [55, 111092], [58, 111232], [69, 111912], [71, 111972], [74, 112092], [82, 112937], [84, 113042], [90, 113322], [93, 113442], [98, 113602], [100, 113762], [107, 114142], [110, 114262], [113, 114382], [119, 115082], [124, 115242], [131, 115682], [138, 115922], [143, 116282], [146, 116422]]}, {"verse": 14, "start": 119662, "end": 128092, "text": "Acuérdate de mí cuando te vaya bien, y te ruego que uses conmigo de misericordia, y hagas mención de mí a Faraón, y me saques de esta casa:", "words": [[0, 119662], [10, 120120], [13, 120380], [16, 120500], [23, 120740], [26, 121000], [31, 121220], [37, 121560], [39, 122040], [42, 122230], [48, 122420], [52, 122640], [57, 122900], [65, 123440], [68, 123580], [82, 124420], [84, 124720], [90, 125020], [98, 125420], [101, 125580], [104, 125760], [106, 126070], [114, 126380], [116, 126720], [119, 126860], [126, 127200], [129, 127400], [134, 127580]]}, {"verse": 15, "start": 128542, "end": 134672, "text": "Porque fui secuestrado de la tierra de los hebreos; y tampoco he hecho aquí motivo para que me pusieran en la cárcel.", "words": [[0, 128542], [7, 128722], [11, 128922], [23, 129642], [26, 129762], [29, 129862], [36, 130142], [39, 130322], [43, 130422], [52, 131448], [54, 131552], [62, 131812], [65, 132112], [71, 132312], [76, 132472], [83, 132912], [88, 133212], [92, 133332], [95, 133452], [104, 133872], [107, 134012], [110, 134132]]}, {"verse": 16, "start": 135022, "end": 144972, "text": "Y viendo el principal de los panaderos que había interpretado para bien, dijo a José: También yo soñaba que veía tres canastillos blancos sobre mi cabeza;", "words": [[0, 135022], [2, 135127], [9, 135427], [12, 135587], [22, 136167], [25, 136447], [29, 136547], [39, 137147], [43, 137247], [49, 137507], [62, 138407], [67, 138627], [73, 139667], [78, 140047], [80, 140267], [86, 140965], [94, 141264], [97, 141464], [104, 141924], [108, 142124], [113, 142544], [118, 142764], [130, 143444], [138, 144004], [144, 144204], [147, 144384]]}, {"verse": 17, "start": 145422, "end": 153773, "text": "En la canasta más alta había toda clase de panes y pasteles para Faraón, y las aves los comían de la canasta que estaba sobre mi cabeza.", "words": [[0, 145422], [3, 145533], [6, 145613], [14, 146013], [18, 146193], [23, 146513], [29, 146753], [34, 147013], [40, 147373], [43, 147533], [49, 147933], [51, 148013], [60, 148453], [65, 148693], [73, 149233], [75, 149513], [79, 149673], [84, 149993], [88, 150093], [95, 150513], [98, 150653], [101, 150773], [109, 151193], [113, 151393], [120, 151673], [126, 151953], [129, 152113]]}, {"verse": 18, "start": 154123, "end": 161080, "text": "Entonces respondió José, y dijo: Esta es su interpretación: Los tres canastillos tres días son;", "words": [[0, 154123], [9, 155043], [19, 155563], [25, 155963], [27, 156323], [33, 157095], [38, 157395], [41, 157595], [44, 157735], [60, 159026], [64, 159148], [69, 159388], [81, 160048], [86, 160328], [91, 160628]]}, {"verse": 19, "start": 161530, "end": 169248, "text": "Al cabo de tres días quitará Faraón tu cabeza de sobre ti, y te hará colgar en la horca, y las aves comerán tu carne de sobre ti.", "words": [[0, 161530], [3, 161688], [8, 161908], [11, 162108], [16, 162368], [21, 162628], [29, 163148], [36, 163608], [39, 163768], [46, 164128], [49, 164368], [55, 164608], [59, 164888], [61, 165428], [64, 165588], [69, 165788], [76, 166128], [79, 166268], [82, 166528], [89, 166788], [91, 166975], [95, 167161], [100, 167348], [108, 167828], [111, 167988], [117, 168248], [120, 168448], [126, 168668]]}, {"verse": 20, "start": 169598, "end": 185779, "text": "Y fue el tercero día el día del nacimiento de Faraón, e hizo banquete a todos sus sirvientes: y alzó la cabeza del principal de los coperos, y la cabeza del principal de los panaderos, entre sus servidores.", "words": [[0, 169598], [2, 169739], [6, 169959], [9, 170259], [17, 170899], [21, 171419], [24, 171419], [28, 171659], [32, 171899], [43, 172539], [46, 172846], [54, 173152], [56, 173459], [61, 174279], [70, 175239], [72, 175539], [78, 175819], [82, 176279], [94, 177692], [96, 177842], [101, 178262], [104, 178382], [111, 178762], [115, 179062], [125, 179682], [128, 179962], [132, 180062], [141, 180602], [143, 181122], [146, 181242], [153, 181642], [157, 181902], [167, 182642], [170, 182902], [174, 183022], [185, 183742], [191, 184342], [195, 184682]]}, {"verse": 21, "start": 186229, "end": 193412, "text": "E hizo volver a su oficio al principal de los coperos; y dio él la copa en mano de Faraón.", "words": [[0, 186229], [2, 186649], [7, 186929], [14, 187309], [16, 187469], [19, 187669], [26, 188189], [29, 188489], [39, 189169], [42, 189549], [46, 189669], [55, 190696], [57, 190890], [61, 191120], [64, 191380], [67, 191560], [72, 192040], [75, 192160], [80, 192420], [83, 192940]]}, {"verse": 22, "start": 193862, "end": 199635, "text": "Mas hizo ahorcar al principal de los panaderos, como le había interpretado José.", "words": [[0, 193862], [4, 194028], [9, 194388], [17, 195168], [20, 195448], [30, 196008], [33, 196348], [37, 196468], [48, 197468], [53, 197748], [56, 197908], [62, 198188], [75, 199028]]}, {"verse": 23, "start": 200085, "end": 205185, "text": "Y el principal de los coperos no se acordó de José, sino que le olvidó.", "words": [[0, 200085], [2, 200248], [5, 200388], [15, 201008], [18, 201288], [22, 201468], [30, 202008], [33, 202548], [36, 202748], [43, 203288], [46, 203388], [52, 203648], [57, 204108], [61, 204328], [64, 204488]]}]}