{"book": "MAT", "chapter": 26, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 591848, "verses": [{"verse": 1, "start": 300, "end": 6872, "text": "Y aconteció que, cuando hubo acabado Jesús todas estas palabras, dijo a sus discípulos:", "words": [[0, 300], [2, 442], [12, 1242], [17, 1522], [24, 1782], [29, 2202], [37, 2762], [43, 3122], [49, 3862], [55, 4262], [65, 5482], [70, 5822], [72, 5982], [76, 6142]]}, {"verse": 2, "start": 7222, "end": 14240, "text": "Sabéis que dentro de dos días se hace la pascua, y el Hijo del hombre es entregado para ser crucificado.", "words": [[0, 7222], [7, 7823], [11, 7983], [18, 8243], [21, 8523], [25, 8723], [30, 9043], [33, 9363], [38, 9583], [41, 9783], [49, 10643], [51, 10823], [54, 10943], [59, 11223], [63, 11383], [70, 11803], [73, 12023], [83, 12743], [88, 12943], [92, 13183]]}, {"verse": 3, "start": 14590, "end": 24846, "text": "Entonces los príncipes de los sacerdotes, y los escribas, y los ancianos del pueblo se juntaron al patio del sumo sacerdote, el cual se llamaba Caifás;", "words": [[0, 14590], [9, 15074], [13, 15754], [23, 16374], [26, 16494], [30, 16614], [42, 17414], [44, 17554], [48, 17694], [58, 18374], [60, 18619], [64, 18779], [73, 19259], [77, 19379], [84, 19739], [87, 19939], [96, 20479], [99, 20679], [105, 21059], [109, 21279], [114, 21719], [125, 22779], [128, 22859], [133, 23059], [136, 23299], [144, 24104]]}, {"verse": 4, "start": 25196, "end": 29347, "text": "Y tuvieron consejo para prender por engaño a Jesús, y matarle.", "words": [[0, 25196], [2, 25293], [11, 25673], [19, 26353], [24, 26663], [32, 26973], [36, 27313], [43, 27833], [45, 27933], [52, 28273], [54, 28578]]}, {"verse": 5, "start": 29697, "end": 34646, "text": "Y decían: No en el día de la fiesta, porque no se haga alboroto en el pueblo.", "words": [[0, 29697], [2, 29821], [10, 30762], [13, 30967], [16, 31127], [19, 31227], [23, 31447], [26, 31567], [29, 31687], [37, 32427], [44, 32787], [47, 32967], [50, 33167], [55, 33367], [64, 33887], [67, 34007], [70, 34127]]}, {"verse": 6, "start": 34926, "end": 39722, "text": "Y estando Jesús en Betania, en casa de Simón el leproso,", "words": [[0, 34926], [2, 35090], [10, 35470], [16, 35850], [19, 36150], [28, 37310], [31, 37370], [36, 37670], [39, 37930], [45, 38690], [48, 38810]]}, {"verse": 7, "start": 40072, "end": 50551, "text": "Vino a él una mujer, teniendo un frasco de alabastro con perfume muy costoso, y lo derramó sobre la cabeza de él, estando sentado a la mesa.", "words": [[0, 40072], [5, 40378], [7, 40638], [10, 40818], [14, 41078], [21, 41998], [30, 42598], [33, 42758], [40, 43198], [43, 43338], [53, 43918], [57, 44118], [65, 44578], [69, 44998], [78, 45718], [80, 46198], [83, 46338], [91, 46958], [97, 47218], [100, 47418], [107, 47838], [110, 48058], [114, 48858], [122, 49318], [130, 49838], [132, 49918], [135, 49998]]}, {"verse": 8, "start": 50901, "end": 56896, "text": "Lo cual viendo sus discípulos, se enojaron, diciendo: ¿Por qué se pierde esto?", "words": [[0, 50901], [3, 51027], [8, 51287], [15, 51627], [19, 51927], [31, 53027], [34, 53327], [44, 54587], [54, 55661], [59, 55777], [63, 55917], [66, 56037], [73, 56457]]}, {"verse": 9, "start": 57246, "end": 60808, "text": "Porque esto se podía vender por gran precio, y darse a los pobres.", "words": [[0, 57246], [7, 57442], [12, 57762], [15, 57942], [21, 58222], [28, 58562], [32, 58802], [37, 59022], [45, 59422], [47, 59722], [53, 60042], [55, 60082], [59, 60202]]}, {"verse": 10, "start": 61088, "end": 67823, "text": "Y entendiéndolo Jesús, les dijo: ¿Por qué molestáis a esta mujer? pues ha hecho conmigo buena obra.", "words": [[0, 61088], [2, 61580], [16, 62110], [23, 62550], [27, 62990], [33, 63721], [38, 63846], [42, 64106], [52, 64786], [54, 64966], [59, 65106], [66, 65970], [71, 66094], [74, 66254], [80, 66454], [88, 66954], [94, 67214]]}, {"verse": 11, "start": 68173, "end": 72582, "text": "Porque siempre tendréis pobres con vosotros, pero a mí no siempre me tendréis.", "words": [[0, 68173], [7, 68357], [15, 68677], [24, 69277], [31, 69737], [35, 69977], [45, 70677], [50, 70817], [52, 70937], [55, 71077], [58, 71197], [66, 71557], [69, 71797]]}, {"verse": 12, "start": 72932, "end": 78257, "text": "Porque echando este perfume sobre mi cuerpo, para sepultarme lo ha hecho.", "words": [[0, 72932], [7, 73194], [15, 73774], [20, 73994], [28, 74534], [34, 74934], [37, 75174], [45, 75674], [50, 76494], [61, 77294], [64, 77554], [67, 77734]]}, {"verse": 13, "start": 78607, "end": 88692, "text": "De cierto os digo que dondequiera que se predique este evangelio en todo el mundo, también se contará, en memoria de esta mujer, lo que ella ha hecho.", "words": [[0, 78607], [3, 78851], [10, 79131], [13, 79411], [18, 79731], [22, 79991], [34, 80691], [38, 80911], [41, 81071], [50, 81631], [55, 82011], [65, 82771], [68, 82891], [73, 83091], [76, 83291], [83, 83631], [91, 84331], [94, 84651], [103, 85251], [106, 85831], [114, 86291], [117, 86471], [122, 86651], [129, 87091], [132, 87571], [136, 87731], [141, 88011], [144, 88271]]}, {"verse": 14, "start": 89042, "end": 95432, "text": "Entonces uno de los doce, que se llamaba Judas Iscariote, fue a los príncipes de los sacerdotes,", "words": [[0, 89042], [9, 89866], [13, 90068], [16, 90228], [20, 90388], [26, 90788], [30, 90928], [33, 91068], [41, 91468], [47, 91768], [58, 92668], [62, 93228], [64, 93388], [68, 93488], [78, 94088], [81, 94188], [85, 94328]]}, {"verse": 15, "start": 95782, "end": 102641, "text": "Y les dijo: ¿Qué me queréis dar, y yo os lo entregaré? Y ellos le señalaron treinta piezas de plata.", "words": [[0, 95782], [2, 95906], [6, 96026], [12, 96774], [17, 96874], [20, 96974], [28, 97274], [33, 97574], [35, 97954], [38, 98194], [41, 98294], [44, 98374], [55, 99287], [57, 99474], [63, 99804], [66, 100134], [76, 100734], [84, 101334], [91, 101994], [94, 102094]]}, {"verse": 16, "start": 102991, "end": 107214, "text": "Y desde entonces buscaba oportunidad para entregarle.", "words": [[0, 102991], [2, 103114], [8, 103294], [17, 103974], [25, 104894], [37, 105674], [42, 106134]]}, {"verse": 17, "start": 107564, "end": 117840, "text": "Y el primer día de la fiesta de los panes sin levadura, vinieron los discípulos a Jesús, diciéndole: ¿Dónde quieres que preparemos para ti para comer la pascua?", "words": [[0, 107564], [2, 107689], [5, 107809], [12, 108129], [16, 108449], [19, 108629], [22, 108749], [29, 109129], [32, 109269], [36, 109389], [42, 109829], [46, 110129], [56, 110769], [65, 111629], [69, 111849], [80, 112549], [82, 112729], [89, 113069], [101, 114606], [108, 114890], [116, 115190], [120, 115390], [131, 115930], [136, 116150], [139, 116410], [144, 116710], [150, 117030], [153, 117460]]}, {"verse": 18, "start": 118120, "end": 128610, "text": "Y él dijo: Id a la ciudad a cierto hombre, y decidle: El Maestro dice: Mi tiempo está cerca; en tu casa haré la pascua con mis discípulos.", "words": [[0, 118120], [2, 118310], [5, 118450], [11, 119256], [14, 119356], [16, 119436], [19, 119536], [26, 119856], [28, 120136], [35, 120416], [43, 121056], [45, 121615], [54, 122333], [57, 122543], [65, 123123], [71, 124045], [74, 124164], [81, 124424], [86, 124664], [93, 125619], [96, 125745], [99, 125905], [104, 126225], [109, 126645], [112, 126765], [119, 127245], [123, 127425], [127, 127625]]}, {"verse": 19, "start": 128960, "end": 134453, "text": "Y los discípulos hicieron como Jesús les mandó, y prepararon la pascua.", "words": [[0, 128960], [2, 129066], [6, 129206], [17, 129846], [26, 130566], [31, 130826], [37, 131206], [41, 131706], [48, 132346], [50, 132846], [61, 133586], [64, 133746]]}, {"verse": 20, "start": 134803, "end": 138983, "text": "Y como fue la tarde del día, se sentó a la mesa con los doce.", "words": [[0, 134803], [2, 135083], [7, 135343], [11, 135603], [14, 135763], [20, 136103], [24, 136403], [29, 137043], [32, 137163], [38, 137583], [40, 137643], [43, 137723], [48, 137963], [52, 138203], [56, 138383]]}, {"verse": 21, "start": 139333, "end": 144472, "text": "Y comiendo ellos, dijo: De cierto os digo, que uno de vosotros me ha de entregar.", "words": [[0, 139333], [2, 139457], [11, 139917], [18, 140217], [24, 141205], [27, 141372], [34, 141652], [37, 141932], [43, 142172], [47, 142412], [51, 142612], [54, 142792], [63, 143312], [66, 143552], [69, 143652], [72, 143752]]}, {"verse": 22, "start": 144822, "end": 151989, "text": "Y entristecidos ellos en gran manera, comenzó cada uno de ellos a decirle: ¿Soy yo, Señor?", "words": [[0, 144822], [2, 145493], [16, 146183], [22, 146483], [25, 146763], [30, 146983], [38, 147523], [46, 148443], [51, 148663], [55, 149103], [58, 149323], [64, 149623], [66, 149823], [75, 150851], [80, 151210], [84, 151430]]}, {"verse": 23, "start": 152269, "end": 159501, "text": "Entonces él respondiendo, dijo: El que mete la mano conmigo en el plato, ese me ha de entregar.", "words": [[0, 152269], [9, 152745], [12, 153325], [26, 154485], [32, 155282], [35, 155642], [39, 155822], [44, 156102], [47, 156342], [52, 156622], [60, 157242], [63, 157362], [66, 157482], [73, 158102], [77, 158322], [80, 158582], [83, 158702], [86, 158802]]}, {"verse": 24, "start": 159851, "end": 171950, "text": "A la verdad el Hijo del hombre va, como está escrito de él; pero ¡ay de aquel hombre por quien el Hijo del hombre es entregado! bueno le fuera al tal hombre no haber nacido.", "words": [[0, 159851], [2, 159943], [5, 160043], [12, 160423], [15, 160903], [20, 161203], [24, 161343], [31, 161763], [35, 162003], [40, 162503], [45, 162683], [53, 163003], [56, 163343], [60, 164188], [65, 164522], [69, 164892], [72, 165112], [78, 165472], [85, 165752], [89, 166032], [95, 166372], [98, 166732], [103, 167052], [107, 167212], [114, 167552], [117, 167952], [128, 169021], [134, 169407], [137, 169507], [143, 169727], [146, 170127], [150, 170307], [157, 170667], [160, 170947], [166, 171127]]}, {"verse": 25, "start": 172300, "end": 179563, "text": "Entonces respondiendo Judas, que le entregaba, dijo: ¿Soy yo, Maestro? Le dice: Tú lo has dicho.", "words": [[0, 172300], [9, 173362], [22, 174302], [29, 174702], [33, 175062], [36, 175222], [47, 175962], [53, 176591], [58, 176790], [62, 176930], [71, 177860], [74, 178026], [80, 178712], [83, 178838], [86, 178958], [90, 179078]]}, {"verse": 26, "start": 179913, "end": 188226, "text": "Y comiendo ellos, tomó Jesús el pan, y bendijo, y lo partió, y dio a sus discípulos, y dijo: Tomad, comed: esto es mi cuerpo.", "words": [[0, 179913], [2, 180011], [11, 180471], [18, 180731], [23, 181151], [29, 181391], [32, 181731], [37, 181971], [39, 182191], [48, 182891], [50, 182931], [53, 183051], [61, 183711], [63, 183771], [67, 183971], [69, 184131], [73, 184291], [85, 185311], [87, 185391], [93, 186029], [100, 186637], [107, 187459], [112, 187704], [115, 187784], [118, 188005]]}, {"verse": 27, "start": 188576, "end": 195049, "text": "Y tomando la copa, y hechas gracias, les dio, diciendo: Bebed de ella todos;", "words": [[0, 188721], [2, 189087], [10, 189492], [13, 189632], [19, 190092], [21, 190192], [28, 190472], [37, 191412], [41, 191592], [46, 191912], [56, 193441], [62, 193731], [65, 194021], [70, 194311]]}, {"verse": 28, "start": 195399, "end": 202004, "text": "Porque esto es mi sangre del nuevo pacto, la cual es derramada por muchos para perdón de los pecados.", "words": [[0, 195399], [7, 195646], [12, 196086], [15, 196266], [18, 196446], [25, 196866], [29, 197146], [35, 197406], [42, 198366], [45, 198426], [50, 198606], [53, 198786], [63, 199446], [67, 199686], [74, 200086], [79, 200386], [86, 200906], [89, 201046], [93, 201166]]}, {"verse": 29, "start": 202354, "end": 211904, "text": "Y os digo, que desde ahora no beberé más de este fruto de la vid, hasta aquel día, cuando lo beba nuevo con vosotros en el reino de mi Padre.", "words": [[0, 202354], [2, 202480], [5, 202600], [11, 202880], [15, 203120], [21, 203500], [27, 203960], [30, 204340], [37, 204820], [41, 205200], [44, 205580], [49, 205800], [55, 206260], [58, 206420], [61, 206790], [66, 207160], [72, 207440], [78, 207780], [83, 208380], [90, 208540], [93, 208760], [98, 209040], [104, 209300], [108, 209580], [117, 210220], [120, 210500], [123, 210640], [129, 211080], [132, 211220], [135, 211340]]}, {"verse": 30, "start": 212254, "end": 216804, "text": "Y habiendo cantado el himno, salieron al monte de los Olivos.", "words": [[0, 212254], [2, 212382], [11, 212702], [19, 213302], [22, 213462], [29, 214302], [38, 215082], [41, 215322], [47, 215622], [50, 215862], [54, 216002]]}, {"verse": 31, "start": 217154, "end": 228166, "text": "Entonces Jesús les dice: Todos vosotros me abandonaréis esta noche; porque escrito está: Heriré al Pastor, y las ovejas de la manada serán dispersas.", "words": [[0, 217154], [9, 218021], [15, 218561], [19, 218961], [25, 219748], [31, 219911], [40, 220531], [43, 220771], [56, 221611], [61, 221891], [68, 222650], [75, 223113], [83, 223613], [89, 224255], [96, 224730], [99, 224870], [107, 225310], [109, 225615], [113, 225775], [120, 226215], [123, 226335], [126, 226435], [133, 226815], [139, 227195]]}, {"verse": 32, "start": 228516, "end": 233199, "text": "Pero después que haya resucitado, iré delante de vosotros a Galilea.", "words": [[0, 228516], [5, 228657], [13, 228997], [17, 229177], [22, 229377], [34, 230357], [38, 231057], [46, 231477], [49, 231657], [58, 232177], [60, 232437]]}, {"verse": 33, "start": 233549, "end": 239011, "text": "Y respondiendo Pedro, le dijo: Aunque todos te abandonen, yo nunca te abandonaré.", "words": [[0, 233549], [2, 233830], [15, 234770], [22, 235070], [25, 235290], [31, 236055], [38, 236272], [44, 236592], [47, 236792], [58, 237592], [61, 237852], [67, 238112], [70, 238332]]}, {"verse": 34, "start": 239291, "end": 247571, "text": "Jesús le dice: De cierto te digo que esta noche, antes que el gallo cante, me negarás tres veces.", "words": [[0, 239291], [6, 239662], [9, 240182], [15, 240973], [18, 241141], [25, 241441], [28, 241841], [33, 242161], [37, 242361], [42, 242641], [49, 243361], [55, 243961], [59, 244181], [62, 244401], [68, 244761], [75, 245441], [78, 245641], [86, 246181], [91, 246561]]}, {"verse": 35, "start": 247921, "end": 255061, "text": "Le dice Pedro: Aunque me sea necesario morir contigo, no te negaré. Y todos los discípulos dijeron lo mismo.", "words": [[0, 247921], [3, 248026], [8, 248286], [15, 249078], [22, 249280], [25, 249480], [29, 249680], [39, 250220], [45, 250620], [54, 251400], [57, 251600], [60, 251760], [68, 252586], [70, 252710], [76, 252990], [80, 253270], [91, 253910], [99, 254490], [102, 254590]]}, {"verse": 36, "start": 255411, "end": 264280, "text": "Entonces llegó Jesús con ellos al lugar llamado Getsemaní, y dice a sus discípulos: Sentaos aquí, hasta que vaya allí y ore.", "words": [[0, 255411], [9, 255860], [15, 256280], [21, 256640], [25, 256920], [31, 257120], [34, 257380], [40, 257700], [48, 258160], [59, 259520], [61, 259820], [66, 260060], [68, 260220], [72, 260360], [84, 261612], [92, 261912], [98, 262272], [104, 262772], [108, 262972], [113, 263192], [118, 263592], [120, 263852]]}, {"verse": 37, "start": 264630, "end": 271904, "text": "Y tomando a Pedro, y a los dos hijos de Zebedeo, comenzó a entristecerse y a angustiarse en gran manera.", "words": [[0, 264630], [2, 264773], [10, 265153], [12, 265273], [19, 265693], [21, 265928], [23, 265988], [27, 266148], [31, 266308], [37, 266688], [40, 267108], [49, 267528], [57, 268448], [59, 268608], [73, 269728], [75, 269988], [77, 270108], [89, 270868], [92, 270988], [97, 271168]]}, {"verse": 38, "start": 272254, "end": 279381, "text": "Entonces Jesús les dice: Mi alma está muy triste hasta la muerte; quedaos aquí, y velad conmigo.", "words": [[0, 272254], [9, 272826], [15, 273426], [19, 274026], [25, 274855], [28, 274966], [33, 275186], [38, 275466], [42, 275666], [49, 276066], [55, 276286], [58, 276446], [66, 277288], [74, 277770], [80, 278070], [82, 278330], [88, 278650]]}, {"verse": 39, "start": 279731, "end": 291880, "text": "Y yéndose un poco más adelante, se postró sobre su rostro, orando, y diciendo: Padre mío, si es posible, pase de mí esta copa; pero no como yo quiero, sino como tú.", "words": [[0, 279898], [2, 280098], [10, 280298], [13, 280438], [18, 280658], [22, 280898], [32, 281438], [35, 281678], [42, 282238], [48, 282498], [51, 282718], [59, 283358], [67, 284158], [69, 284458], [79, 285423], [85, 285768], [90, 286468], [93, 286588], [96, 286728], [105, 287648], [110, 288128], [113, 288368], [116, 288588], [121, 288828], [127, 289649], [132, 289817], [135, 290037], [140, 290257], [143, 290437], [151, 290797], [156, 291097], [161, 291397]]}, {"verse": 40, "start": 292230, "end": 299360, "text": "Y vino a sus discípulos, y los halló durmiendo, y dijo a Pedro: ¿Así no habéis podido velar conmigo una hora?", "words": [[0, 292230], [2, 292553], [7, 292773], [9, 292933], [13, 293113], [25, 293793], [27, 294273], [31, 294413], [37, 294753], [48, 295333], [50, 295433], [55, 295633], [57, 295773], [64, 296430], [69, 296770], [72, 296990], [79, 297290], [86, 297690], [92, 298050], [100, 298630], [104, 298810]]}, {"verse": 41, "start": 299710, "end": 306823, "text": "Velad y orad, para que no entréis en tentación: el espíritu está dispuesto, pero la carne es débil.", "words": [[0, 299710], [6, 300178], [8, 300398], [14, 300718], [19, 300998], [23, 301158], [26, 301358], [34, 301818], [37, 302018], [48, 303109], [51, 303429], [60, 304009], [65, 304189], [76, 305079], [81, 305359], [84, 305539], [90, 305899], [93, 306159]]}, {"verse": 42, "start": 307173, "end": 316774, "text": "Otra vez fue, segunda vez, y oró diciendo: Padre mío, si no puede esta copa pasar de mí sin que yo la beba, hágase tu voluntad.", "words": [[0, 307173], [5, 307423], [9, 307763], [14, 307963], [22, 308383], [27, 308843], [29, 309303], [33, 309763], [43, 310977], [49, 311262], [54, 311702], [57, 311802], [60, 312022], [66, 312242], [71, 312522], [76, 312942], [82, 313242], [85, 313462], [88, 313622], [92, 313842], [96, 314062], [99, 314242], [102, 314402], [108, 315242], [115, 315662], [118, 315862]]}, {"verse": 43, "start": 317124, "end": 322623, "text": "Y vino, y los halló otra vez durmiendo; porque tenían los ojos pesados de sueño.", "words": [[0, 317124], [2, 317249], [8, 317589], [10, 317824], [14, 318004], [20, 318444], [25, 318704], [29, 318964], [40, 320050], [47, 320354], [54, 320694], [58, 320874], [63, 321194], [71, 321774], [74, 321974]]}, {"verse": 44, "start": 322973, "end": 329455, "text": "Y dejándolos se fue de nuevo y oró por tercera vez, diciendo las mismas palabras.", "words": [[0, 322973], [2, 323121], [13, 324181], [16, 324421], [20, 324621], [23, 324781], [29, 325101], [31, 325461], [35, 325781], [39, 326001], [47, 326621], [52, 327381], [61, 327761], [65, 328161], [72, 328641]]}, {"verse": 45, "start": 329805, "end": 341777, "text": "Entonces vino a sus discípulos y les dice: Dormid ya, y descansad: he aquí ha llegado la hora, y el Hijo del hombre es entregado en manos de pecadores.", "words": [[0, 329805], [9, 330687], [14, 331427], [16, 331647], [20, 331827], [31, 332627], [33, 332807], [37, 332927], [43, 333827], [50, 333997], [54, 334437], [56, 335092], [67, 335908], [70, 336075], [75, 336495], [78, 336735], [86, 337215], [89, 337395], [95, 337975], [97, 338375], [100, 338515], [105, 338795], [109, 338955], [116, 339375], [119, 339495], [129, 340175], [132, 340295], [138, 340575], [141, 340795]]}, {"verse": 46, "start": 342127, "end": 346504, "text": "Levantaos, vamos: he aquí ha llegado el que me ha entregado.", "words": [[0, 342127], [11, 343235], [18, 344118], [21, 344263], [26, 344483], [29, 344623], [37, 345063], [40, 345223], [44, 345403], [47, 345583], [50, 345683]]}, {"verse": 47, "start": 346854, "end": 360552, "text": "Y hablando aún él, he aquí Judas, uno de los doce, vino, y con él mucha gente con espadas y con palos, de parte de los príncipes de los sacerdotes, y de los ancianos del pueblo.", "words": [[0, 346854], [2, 346991], [11, 347251], [15, 347691], [19, 348191], [22, 348606], [27, 348846], [34, 350006], [38, 350326], [41, 350506], [45, 350646], [51, 351726], [57, 352046], [59, 352666], [63, 352906], [66, 353066], [72, 353306], [78, 353726], [82, 353966], [90, 354506], [92, 354706], [96, 354906], [103, 355566], [106, 355946], [112, 356206], [115, 356446], [119, 356586], [129, 357326], [132, 357446], [136, 357586], [148, 358793], [150, 358916], [153, 359016], [157, 359136], [166, 359736], [170, 359896]]}, {"verse": 48, "start": 360902, "end": 368603, "text": "Y el que le entregaba les había dado señal, diciendo: Al que yo bese, aquel es: prendedle.", "words": [[0, 360902], [2, 361045], [5, 361185], [9, 361365], [12, 361565], [22, 362345], [26, 362705], [32, 363125], [37, 363385], [44, 364605], [54, 365679], [57, 365862], [61, 365962], [64, 366342], [70, 366722], [76, 367242], [80, 367897]]}, {"verse": 49, "start": 368883, "end": 373729, "text": "Y luego que llegó a Jesús, dijo: Salve, Maestro. Y le besó.", "words": [[0, 368883], [2, 369027], [8, 369207], [12, 369487], [18, 369767], [20, 369927], [27, 370787], [33, 371597], [40, 371996], [49, 372890], [51, 373032], [54, 373152]]}, {"verse": 50, "start": 374079, "end": 381955, "text": "Y Jesús le dijo: Amigo, ¿a qué vienes? Entonces llegaron, y echaron mano a Jesús, y le prendieron.", "words": [[0, 374079], [2, 374226], [8, 374626], [11, 374966], [17, 375723], [24, 376308], [27, 376408], [31, 376508], [39, 377401], [48, 377889], [58, 378889], [60, 379209], [68, 379689], [73, 380029], [75, 380229], [82, 380569], [84, 380904], [87, 381024]]}, {"verse": 51, "start": 382305, "end": 392590, "text": "Y he aquí, uno de los que estaban con Jesús, extendiendo la mano, sacó su espada, e hiriendo a un siervo del sumo sacerdote, le quitó la oreja.", "words": [[0, 382305], [2, 382483], [5, 382583], [11, 382843], [15, 383143], [18, 383303], [22, 383423], [26, 383563], [34, 383863], [38, 384123], [45, 385003], [57, 385763], [60, 385923], [66, 386823], [71, 387163], [74, 387303], [82, 387843], [84, 388263], [93, 388823], [95, 389023], [98, 389143], [105, 389703], [109, 389863], [114, 390383], [125, 391423], [128, 391523], [134, 391883], [137, 392003]]}, {"verse": 52, "start": 392940, "end": 402075, "text": "Entonces Jesús le dice: Vuelve tu espada a su lugar; porque todos los que tomen espada, a espada perecerán.", "words": [[0, 392940], [9, 393529], [15, 394209], [18, 394709], [24, 395465], [31, 395851], [34, 396011], [41, 396571], [43, 396811], [46, 396991], [53, 397791], [60, 397973], [66, 398413], [70, 398713], [74, 398853], [80, 399233], [88, 400093], [90, 400333], [97, 400953]]}, {"verse": 53, "start": 402425, "end": 408979, "text": "¿Acaso piensas que no puedo ahora orar a mi Padre, y él me daría más de doce legiones de ángeles?", "words": [[0, 402425], [7, 402935], [15, 403355], [19, 403495], [22, 403675], [28, 404035], [34, 404425], [39, 404815], [41, 404895], [44, 405035], [51, 405455], [53, 406035], [56, 406255], [59, 406435], [65, 406835], [69, 407015], [72, 407342], [77, 407668], [86, 407995], [89, 408215]]}, {"verse": 54, "start": 409329, "end": 413884, "text": "¿Cómo, pues, se cumplirían las Escrituras, que así conviene que sea hecho?", "words": [[0, 409329], [7, 409743], [13, 410183], [16, 410703], [27, 411343], [31, 411523], [43, 412183], [47, 412343], [51, 412503], [60, 412963], [64, 413083], [68, 413323]]}, {"verse": 55, "start": 414234, "end": 425864, "text": "En aquella hora dijo Jesús a la gente: ¿Como a ladrón habéis salido con espadas y con palos a prenderme? Cada día me sentaba con vosotros enseñando en el templo, y no me prendisteis.", "words": [[0, 414234], [3, 414375], [11, 414755], [16, 414975], [21, 415275], [27, 415615], [29, 415895], [32, 415955], [39, 416710], [45, 416854], [47, 417034], [54, 417394], [61, 417694], [68, 418134], [72, 418334], [80, 418794], [82, 418974], [86, 419174], [92, 419654], [94, 419794], [105, 420697], [110, 420840], [114, 421140], [117, 421300], [125, 421760], [129, 421960], [138, 422500], [148, 423360], [151, 423460], [154, 423620], [162, 424380], [164, 424540], [167, 424660], [170, 424800]]}, {"verse": 56, "start": 426214, "end": 435368, "text": "Pero todo esto se hace, para que se cumplan las Escrituras de los profetas. Entonces todos los discípulos huyeron, dejándole.", "words": [[0, 426214], [5, 426356], [10, 426656], [15, 426976], [18, 427256], [24, 427636], [29, 427991], [33, 428171], [36, 428331], [44, 428951], [48, 429211], [59, 429911], [62, 430031], [66, 430151], [76, 431173], [85, 431776], [91, 432516], [95, 432796], [106, 433516], [115, 434416]]}, {"verse": 57, "start": 435718, "end": 444292, "text": "Y ellos, prendido Jesús, le llevaron al sumo sacerdote Caifás, donde los escribas y los ancianos estaban juntos.", "words": [[0, 435718], [2, 435899], [9, 436449], [18, 436999], [25, 437589], [28, 438179], [37, 438659], [40, 438799], [45, 439399], [55, 440139], [63, 441059], [69, 441299], [73, 441579], [82, 442199], [84, 442359], [88, 442519], [97, 443099], [105, 443439]]}, {"verse": 58, "start": 444642, "end": 453959, "text": "Pero Pedro le seguía de lejos hasta el patio del sumo sacerdote; y entrando dentro, se estaba sentado con los criados, para ver el fin.", "words": [[0, 444642], [5, 444882], [11, 445182], [14, 445402], [21, 445802], [24, 445902], [30, 446222], [36, 446482], [39, 446662], [45, 447022], [49, 447222], [54, 447742], [65, 448844], [67, 448987], [76, 449547], [84, 449887], [87, 450207], [94, 450547], [102, 451187], [106, 451367], [110, 451547], [119, 452667], [124, 452947], [128, 453147], [131, 453307]]}, {"verse": 59, "start": 454309, "end": 464150, "text": "Y los príncipes de los sacerdotes, y los ancianos, y todo el consejo, buscaban falso testimonio contra Jesús, para entregarle a la muerte;", "words": [[0, 454309], [2, 454436], [6, 454556], [16, 455396], [19, 455516], [23, 455676], [35, 456556], [37, 456956], [41, 457136], [51, 457856], [53, 458236], [58, 458476], [61, 458656], [70, 459376], [79, 460156], [85, 460656], [96, 461456], [103, 461816], [110, 462276], [115, 462641], [126, 463401], [128, 463481], [131, 463561]]}, {"verse": 60, "start": 464500, "end": 471165, "text": "Y no lo hallaron, aunque muchos testigos falsos se llegaban; pero al fin vinieron dos testigos falsos,", "words": [[0, 464500], [2, 464622], [5, 464782], [8, 464922], [18, 465662], [25, 465842], [32, 466202], [41, 466742], [48, 467282], [51, 467422], [61, 468412], [66, 468575], [69, 468695], [73, 468895], [82, 469415], [86, 469695], [95, 470295]]}, {"verse": 61, "start": 471515, "end": 476618, "text": "Que dijeron: Este dijo: Puedo derribar el templo de Dios, y en tres días reedificarlo.", "words": [[0, 471515], [4, 471619], [13, 472523], [18, 472743], [24, 473416], [30, 473605], [39, 474085], [42, 474185], [49, 474565], [52, 474605], [58, 474845], [60, 475125], [63, 475245], [68, 475445], [73, 476055]]}, {"verse": 62, "start": 476898, "end": 483726, "text": "Y levantándose el sumo sacerdote, le dijo: ¿No respondes nada? ¿qué testifican estos contra ti?", "words": [[0, 476898], [2, 477023], [15, 477983], [18, 478203], [23, 478683], [34, 479723], [37, 479903], [43, 480588], [47, 480734], [57, 481294], [63, 481997], [68, 482094], [79, 482734], [85, 482934], [92, 483334]]}, {"verse": 63, "start": 484006, "end": 493194, "text": "Pero Jesús callaba. Respondiendo el sumo sacerdote, le dijo: Te conjuro por el Dios viviente, que nos digas si eres tú el Cristo, Hijo de Dios.", "words": [[0, 484006], [5, 484173], [11, 484493], [20, 485985], [33, 486345], [36, 486485], [41, 486905], [52, 487705], [55, 487765], [61, 488522], [64, 488622], [72, 489122], [76, 489302], [79, 489422], [84, 489602], [94, 490122], [98, 490302], [102, 490572], [108, 490842], [111, 491022], [116, 491262], [119, 491502], [122, 491662], [130, 492342], [135, 492482], [138, 492642]]}, {"verse": 64, "start": 493474, "end": 506481, "text": "Jesús le dijo: Tú lo has dicho: y aun os digo, que desde ahora habéis de ver al Hijo del hombre sentado a la diestra del poder de Dios, y que viene en las nubes del cielo.", "words": [[0, 493474], [6, 493946], [9, 494386], [15, 495159], [18, 495283], [21, 495423], [25, 495563], [32, 496289], [34, 496410], [38, 496610], [41, 496830], [47, 497690], [51, 497910], [57, 498170], [63, 498610], [70, 499150], [73, 499330], [77, 499510], [80, 499670], [85, 499950], [89, 500150], [96, 500510], [104, 501190], [106, 501330], [109, 501410], [117, 501870], [121, 502110], [127, 502510], [130, 502810], [136, 503210], [138, 503705], [142, 503865], [148, 504225], [151, 504565], [155, 504745], [161, 505485], [165, 505765]]}, {"verse": 65, "start": 506831, "end": 517846, "text": "Entonces el sumo sacerdote rasgó sus vestidos, diciendo: Ha blasfemado: ¿qué más necesidad tenemos de testigos? He aquí, ahora habéis oído su blasfemia.", "words": [[0, 506831], [9, 508070], [12, 508190], [17, 508570], [27, 509250], [33, 510150], [37, 510350], [47, 511030], [57, 512488], [60, 512842], [72, 513367], [77, 513471], [81, 513651], [91, 514271], [99, 514591], [102, 514791], [112, 515761], [115, 515831], [121, 516051], [127, 516351], [134, 516691], [139, 516951], [142, 517111]]}, {"verse": 66, "start": 518196, "end": 522614, "text": "¿Qué os parece? Y respondiendo ellos, dijeron: Culpado es de muerte.", "words": [[0, 518196], [5, 518293], [8, 518393], [16, 519233], [18, 519628], [31, 520058], [38, 520598], [47, 521288], [55, 521771], [58, 521891], [61, 522031]]}, {"verse": 67, "start": 522894, "end": 530243, "text": "Entonces le escupieron en el rostro, y le dieron de bofetadas; y otros le herían con puñetazos,", "words": [[0, 522894], [9, 523435], [12, 523830], [23, 524510], [26, 524710], [29, 524870], [37, 525450], [39, 525830], [42, 525950], [49, 526460], [52, 526970], [63, 527642], [65, 527787], [71, 528087], [74, 528587], [81, 528927], [85, 529147]]}, {"verse": 68, "start": 530593, "end": 534620, "text": "Diciendo: Profetízanos tú, Cristo, quién es el que te ha herido.", "words": [[0, 530593], [10, 532156], [23, 532476], [27, 532636], [35, 533416], [41, 533576], [44, 533736], [47, 533856], [51, 533976], [54, 534116], [57, 534196]]}, {"verse": 69, "start": 534900, "end": 543795, "text": "Y Pedro estaba sentado fuera en el patio: y se llegó a él una criada, diciendo: Y tú con Jesús el galileo estabas.", "words": [[0, 534900], [2, 535026], [8, 535366], [15, 535766], [23, 536426], [29, 536706], [32, 536966], [35, 537106], [42, 538065], [44, 538318], [47, 538438], [53, 538778], [55, 538958], [58, 539118], [62, 539398], [70, 540058], [80, 541142], [82, 541293], [85, 541453], [89, 541693], [95, 542153], [98, 542573], [106, 543093]]}, {"verse": 70, "start": 544075, "end": 548552, "text": "Pero él negó delante de todos, diciendo: No sé lo que dices.", "words": [[0, 544075], [5, 544237], [8, 544477], [13, 544877], [21, 545297], [24, 545477], [31, 546377], [41, 547478], [44, 547662], [47, 547902], [50, 548042], [54, 548162]]}, {"verse": 71, "start": 548832, "end": 555522, "text": "Y saliendo él a la puerta, le vio otra, y dijo a los que estaban allí: También este estaba con Jesús nazareno.", "words": [[0, 548832], [2, 548937], [11, 549397], [14, 549597], [16, 549677], [19, 549797], [27, 550297], [30, 550592], [34, 550832], [40, 551292], [42, 551547], [47, 551847], [49, 552007], [53, 552127], [57, 552267], [65, 552607], [71, 553331], [79, 553631], [84, 553911], [91, 554211], [95, 554451], [101, 554731]]}, {"verse": 72, "start": 555802, "end": 562406, "text": "Y negó otra vez con juramento: No conozco al hombre.", "words": [[0, 555802], [2, 555927], [7, 556267], [12, 556747], [16, 557247], [20, 557667], [31, 558928], [34, 559083], [42, 559523], [45, 559643]]}, {"verse": 73, "start": 562686, "end": 571599, "text": "Y un poco después llegaron los que estaban por allí, y dijeron a Pedro: Verdaderamente también tú eres de ellos, porque aun tu habla te hace manifiesto.", "words": [[0, 562686], [2, 562805], [5, 562925], [10, 563145], [18, 563738], [27, 564240], [31, 564400], [35, 564520], [43, 564800], [47, 565080], [53, 565380], [55, 565940], [63, 566360], [65, 566440], [72, 567215], [87, 567899], [95, 568199], [98, 568539], [103, 568759], [106, 568919], [113, 569479], [120, 569879], [124, 570099], [127, 570299], [133, 570519], [136, 570759], [141, 570919]]}, {"verse": 74, "start": 571879, "end": 581045, "text": "Entonces comenzó a maldecir, y a jurar, diciendo: No conozco al hombre. Y el gallo cantó luego.", "words": [[0, 571879], [9, 572309], [17, 573049], [19, 573109], [29, 573649], [31, 573849], [33, 573969], [40, 574409], [50, 575586], [53, 575742], [61, 576182], [64, 576302], [72, 579344], [74, 579470], [77, 579680], [83, 579890], [89, 580450]]}, {"verse": 75, "start": 581395, "end": 591448, "text": "Y se acordó Pedro de las palabras de Jesús, que le dijo: Antes que cante el gallo, me negarás tres veces. Y saliendo fuera, lloró amargamente.", "words": [[0, 581395], [2, 581534], [5, 581654], [12, 582134], [18, 582634], [21, 582854], [25, 582994], [34, 583354], [37, 583574], [44, 583934], [48, 584234], [51, 584374], [57, 585070], [63, 585530], [67, 585730], [73, 586150], [76, 586210], [83, 586710], [86, 587030], [94, 587350], [99, 587590], [106, 588395], [108, 588502], [117, 588962], [124, 589342], [130, 590182]]}]}