{"book": "PSA", "chapter": 139, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 155943, "verses": [{"verse": 1, "start": 300, "end": 6848, "text": "Al Músico principal: Salmo de David. OH Jehová, tú me has examinado y conocido.", "words": [[0, 300], [3, 461], [10, 941], [21, 2081], [27, 2644], [30, 2804], [37, 3950], [40, 4264], [48, 4579], [51, 4681], [54, 4881], [58, 5061], [68, 5841], [70, 5981]]}, {"verse": 2, "start": 7198, "end": 13686, "text": "Tú has conocido mi sentarme y mi levantarme, has entendido desde lejos mis pensamientos.", "words": [[0, 7198], [3, 7302], [7, 7502], [16, 8162], [19, 8322], [28, 9062], [30, 9302], [33, 9422], [45, 10562], [49, 10722], [59, 11482], [65, 11702], [71, 12262], [75, 12542]]}, {"verse": 3, "start": 14036, "end": 19042, "text": "Mi senda y mi acostarme has rodeado, y conoces todos mis caminos.", "words": [[0, 14036], [3, 14196], [9, 14696], [11, 14796], [14, 14896], [24, 15516], [28, 15756], [37, 16596], [39, 17356], [47, 17836], [53, 18056], [57, 18316]]}, {"verse": 4, "start": 19392, "end": 25364, "text": "Pues aún no está la palabra en mi lengua, y he aquí, oh Jehová, tú la sabes toda.", "words": [[0, 19392], [5, 19668], [9, 19928], [12, 20168], [17, 20368], [20, 20508], [28, 20888], [31, 21088], [34, 21248], [42, 21928], [44, 22168], [47, 22308], [53, 22855], [56, 23401], [64, 23948], [67, 24188], [70, 24348], [76, 24668]]}, {"verse": 5, "start": 25714, "end": 30454, "text": "Detrás y delante me rodeaste, y sobre mí pusiste tu mano.", "words": [[0, 25714], [7, 26398], [9, 26663], [17, 27103], [20, 27303], [30, 27983], [32, 28418], [38, 28678], [41, 28958], [49, 29558], [52, 29798]]}, {"verse": 6, "start": 30804, "end": 37474, "text": "Más maravilloso es el conocimiento que mi capacidad; alta es, no puedo comprenderla.", "words": [[0, 30804], [4, 31112], [16, 31992], [19, 32152], [22, 32292], [35, 33072], [39, 33232], [42, 33392], [53, 34624], [58, 35244], [62, 35724], [65, 35904], [71, 36204]]}, {"verse": 7, "start": 37824, "end": 42204, "text": "¿Adónde me iré de tu espíritu? ¿y adónde huiré de tu presencia?", "words": [[0, 37958], [8, 38128], [11, 38428], [15, 38728], [18, 38828], [21, 38968], [31, 39870], [34, 40209], [41, 40583], [47, 40956], [50, 41156], [53, 41316]]}, {"verse": 8, "start": 42554, "end": 49107, "text": "Si subo a los cielos, allí estás tú: y si en abismo hago mi estrado, he aquí allí tú estás.", "words": [[0, 42554], [3, 42754], [8, 43194], [10, 43274], [14, 43374], [22, 44214], [27, 44434], [33, 44694], [37, 45298], [39, 45422], [42, 45582], [45, 45702], [52, 46102], [57, 46342], [60, 46542], [69, 47362], [72, 47802], [77, 48052], [82, 48302], [85, 48522]]}, {"verse": 9, "start": 49457, "end": 53589, "text": "Si tomo las alas del alba, y habito en el extremo del mar,", "words": [[0, 49457], [3, 49621], [8, 50001], [12, 50141], [17, 50541], [21, 50721], [27, 51341], [29, 51741], [36, 52081], [39, 52221], [42, 52341], [50, 52961], [54, 53101]]}, {"verse": 10, "start": 53939, "end": 58234, "text": "Aun allí me guiará tu mano, y me asirá tu diestra.", "words": [[0, 53939], [4, 54286], [9, 54666], [12, 55126], [19, 55646], [22, 55786], [28, 56186], [30, 56646], [33, 56966], [39, 57286], [42, 57386]]}, {"verse": 11, "start": 58584, "end": 65656, "text": "Si digo: Ciertamente las tinieblas me encubrirán; aun la noche resplandecerá tocante a mí.", "words": [[0, 58584], [3, 58976], [9, 59625], [21, 60428], [25, 60588], [35, 61308], [38, 61488], [50, 62656], [54, 62858], [57, 63098], [63, 63418], [77, 64278], [85, 65138], [87, 65358]]}, {"verse": 12, "start": 66006, "end": 74051, "text": "Aun las tinieblas no encubren de ti, y la noche resplandece como el día: lo mismo te son las tinieblas que la luz.", "words": [[0, 66006], [4, 66331], [8, 66571], [18, 67291], [21, 67471], [30, 68011], [33, 68191], [37, 68471], [39, 68636], [42, 68776], [48, 69076], [60, 70076], [65, 70316], [68, 70516], [73, 71125], [76, 71253], [82, 71533], [85, 71773], [89, 72073], [93, 72633], [103, 73193], [107, 73393], [110, 73553]]}, {"verse": 13, "start": 74401, "end": 79973, "text": "Porque tú formaste mis riñones; me cubriste en el vientre de mi madre.", "words": [[0, 74401], [7, 74627], [10, 74907], [19, 75527], [23, 76306], [32, 77241], [35, 77715], [44, 78225], [47, 78445], [50, 78585], [58, 79105], [61, 79225], [64, 79365]]}, {"verse": 14, "start": 80323, "end": 88560, "text": "Te alabaré; porque formidables, maravillosas son tus obras: estoy maravillado, y mi alma lo conoce mucho.", "words": [[0, 80562], [3, 80838], [12, 81113], [19, 81533], [32, 82753], [45, 83493], [49, 83773], [53, 83973], [60, 84966], [66, 85206], [79, 86026], [81, 86426], [84, 86606], [89, 87006], [92, 87486], [99, 87966]]}, {"verse": 15, "start": 88910, "end": 97282, "text": "No fue encubierto de ti mi cuerpo, bien que en oculto fui formado, y entretejido en lo más bajo de la tierra.", "words": [[0, 88910], [3, 89096], [7, 89376], [18, 90156], [21, 90316], [24, 90576], [27, 90716], [35, 91716], [40, 92036], [44, 92296], [47, 92576], [54, 93176], [58, 93356], [67, 94036], [69, 94216], [81, 95136], [84, 95276], [87, 95396], [91, 95716], [96, 96196], [99, 96436], [102, 96556]]}, {"verse": 16, "start": 97632, "end": 105919, "text": "Mi embrión vieron tus ojos, y en tu libro estaban escritas todas aquellas cosas que fueron luego formadas, sin faltar una de ellas.", "words": [[0, 97632], [3, 97918], [11, 98238], [18, 98518], [22, 98718], [28, 99118], [30, 99458], [33, 99618], [36, 99758], [42, 100138], [50, 100698], [59, 101338], [65, 101578], [74, 102158], [80, 102358], [84, 102598], [91, 102838], [97, 103178], [107, 103878], [111, 104418], [118, 104938], [122, 105098], [125, 105298]]}, {"verse": 17, "start": 106269, "end": 113137, "text": "Así que ¡cuán preciosos me son, oh Dios, tus pensamientos! ¡cuán grande es la suma de ellos!", "words": [[0, 106269], [4, 106485], [8, 106930], [14, 107210], [24, 107850], [27, 107950], [32, 108250], [35, 108550], [41, 109110], [45, 109310], [59, 110666], [65, 111030], [72, 111470], [75, 111850], [78, 112030], [83, 112410], [86, 112570]]}, {"verse": 18, "start": 113487, "end": 120426, "text": "Si los cuento, se multiplican más que la arena: despierto, y aún estoy contigo.", "words": [[0, 113487], [3, 113664], [7, 114054], [15, 114444], [18, 114584], [30, 115464], [34, 115664], [38, 115864], [41, 116024], [48, 116851], [59, 117738], [61, 117918], [65, 118098], [71, 118498]]}, {"verse": 19, "start": 120776, "end": 127197, "text": "De cierto, oh Dios, matarás al impío; apartaos pues de mí, hombres sanguinarios.", "words": [[0, 121124], [3, 121497], [11, 121870], [14, 122242], [20, 122615], [28, 122988], [31, 123361], [38, 124117], [47, 124307], [52, 124527], [55, 124747], [59, 125227], [67, 125707]]}, {"verse": 20, "start": 127547, "end": 132676, "text": "Porque blasfemias dicen ellos contra ti: tus enemigos toman en vano tu nombre.", "words": [[0, 127547], [7, 127789], [18, 128649], [24, 129069], [30, 129489], [37, 129889], [41, 130540], [45, 130700], [54, 131220], [60, 131540], [63, 131660], [68, 131940], [71, 132040]]}, {"verse": 21, "start": 133026, "end": 138467, "text": "¿No tengo en odio, oh Jehová, a los que te aborrecen, y me conmuevo contra tus enemigos?", "words": [[0, 133026], [4, 133154], [10, 133379], [13, 133604], [19, 133829], [22, 134054], [30, 134774], [32, 134854], [36, 134974], [40, 135114], [43, 135274], [54, 135894], [56, 136314], [59, 136454], [68, 137134], [75, 137374], [79, 137634]]}, {"verse": 22, "start": 138817, "end": 142895, "text": "Los aborrezco con perfecto odio; los tengo por enemigos.", "words": [[0, 138817], [4, 139234], [14, 139684], [18, 139924], [27, 140744], [33, 141326], [37, 141586], [43, 141886], [47, 142126]]}, {"verse": 23, "start": 143245, "end": 149544, "text": "Examíname, oh Dios, y conoce mi corazón: pruébame y reconoce mis pensamientos:", "words": [[0, 143245], [11, 144051], [14, 144151], [20, 145031], [22, 145131], [29, 145611], [32, 145751], [41, 146800], [50, 147324], [52, 147804], [61, 148424], [65, 148604]]}, {"verse": 24, "start": 149894, "end": 155543, "text": "Y ve si hay en mí camino de perversidad, y guíame en el camino eterno.", "words": [[0, 149894], [2, 150055], [5, 150155], [8, 150395], [12, 150675], [15, 150875], [18, 151035], [25, 151355], [28, 151695], [41, 152675], [43, 153255], [50, 153715], [53, 154115], [56, 154235], [63, 154635]]}]}