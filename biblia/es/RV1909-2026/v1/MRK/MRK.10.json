{"book": "MRK", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 433905, "verses": [{"verse": 1, "start": 300, "end": 10968, "text": "Y partiéndose de allí, vino a la región de Judea y tras el Jordán: y volvió el pueblo a juntarse a él; y de nuevo les enseñaba como solía.", "words": [[0, 300], [2, 402], [14, 1302], [17, 1522], [23, 1882], [28, 2842], [30, 3102], [33, 3182], [40, 3542], [43, 3742], [49, 4282], [51, 4402], [56, 4602], [59, 4842], [67, 5814], [69, 6182], [76, 6562], [79, 6662], [86, 6882], [88, 7122], [97, 7662], [99, 7802], [103, 8242], [105, 8482], [108, 8802], [114, 9042], [118, 9362], [127, 10042], [132, 10302]]}, {"verse": 2, "start": 11318, "end": 19555, "text": "Y llegándose los fariseos, le preguntaron, para ponerlo a prueba, si era lícito al marido divorciarse de su mujer.", "words": [[0, 11318], [2, 11440], [13, 12160], [17, 12360], [27, 13200], [30, 13900], [43, 14600], [48, 14915], [56, 15475], [58, 15575], [66, 15975], [69, 16615], [73, 16775], [80, 17295], [83, 17475], [90, 17875], [102, 18675], [105, 18895], [108, 19055]]}, {"verse": 3, "start": 19905, "end": 24064, "text": "Pero él respondiendo, les dijo: ¿Qué os mandó Moisés?", "words": [[0, 20082], [5, 20282], [8, 20662], [22, 21702], [26, 21882], [32, 22630], [37, 22732], [40, 22872], [46, 23252]]}, {"verse": 4, "start": 24414, "end": 29847, "text": "Y ellos dijeron: Moisés permitió escribir un certificado de divorcio y divorciarse.", "words": [[0, 24414], [2, 24541], [8, 24701], [17, 25564], [24, 25908], [33, 26608], [42, 27088], [45, 27208], [57, 27988], [60, 28108], [69, 28748], [71, 28968]]}, {"verse": 5, "start": 30127, "end": 36259, "text": "Y respondiendo Jesús, les dijo: Por la dureza de vuestro corazón os escribió este mandamiento;", "words": [[0, 30127], [2, 30249], [15, 30909], [22, 31289], [26, 31809], [32, 32552], [36, 32675], [39, 32875], [46, 33335], [49, 33495], [57, 33875], [65, 34355], [68, 34615], [77, 35195], [82, 35355]]}, {"verse": 6, "start": 36609, "end": 41071, "text": "Pero al principio de la creación, varón y hembra los hizo Dios.", "words": [[0, 36609], [5, 36750], [8, 36930], [18, 37470], [21, 37830], [24, 37970], [34, 38870], [40, 39430], [42, 39650], [49, 40070], [53, 40230], [58, 40490]]}, {"verse": 7, "start": 41421, "end": 46276, "text": "Por esto dejará el hombre a su padre y a su madre, y se juntará a su mujer.", "words": [[0, 41421], [4, 41523], [9, 41783], [16, 42343], [19, 42483], [26, 42743], [28, 42903], [31, 43003], [37, 43403], [39, 43663], [41, 43723], [44, 43883], [51, 44263], [53, 44823], [56, 44963], [64, 45483], [66, 45583], [69, 45703]]}, {"verse": 8, "start": 46626, "end": 52925, "text": "Y los que eran dos, serán hechos una carne: así que no son más dos, sino una carne.", "words": [[0, 46626], [2, 46711], [6, 46831], [10, 47011], [15, 47231], [20, 47551], [26, 48371], [33, 48731], [37, 49031], [44, 49875], [48, 50115], [52, 50295], [55, 50435], [59, 50735], [63, 50935], [68, 51795], [73, 51975], [77, 52215]]}, {"verse": 9, "start": 53275, "end": 56393, "text": "Pues lo que Dios juntó, no lo aparte el hombre.", "words": [[0, 53275], [5, 53437], [8, 53777], [12, 53937], [17, 54097], [24, 54477], [27, 54872], [30, 55012], [37, 55572], [40, 55792]]}, {"verse": 10, "start": 56743, "end": 61217, "text": "Y en casa volvieron los discípulos a preguntarle de lo mismo.", "words": [[0, 56743], [2, 56889], [5, 57029], [10, 57429], [20, 58409], [24, 58629], [35, 59349], [37, 59529], [49, 60329], [52, 60489], [55, 60609]]}, {"verse": 11, "start": 61567, "end": 68733, "text": "Y les dice: Cualquiera que se divorcie de su mujer y se case con otra, comete adulterio contra ella:", "words": [[0, 61748], [2, 61963], [6, 62177], [12, 62609], [23, 63110], [27, 63250], [30, 63410], [39, 63970], [42, 64110], [45, 64290], [51, 64690], [53, 64970], [56, 65110], [61, 65370], [65, 65670], [71, 66610], [78, 66970], [88, 67790], [95, 68110]]}, {"verse": 12, "start": 69083, "end": 74145, "text": "Y si la mujer se divorcia de su marido y se casa con otro, comete adulterio.", "words": [[0, 69083], [2, 69189], [5, 69309], [8, 69449], [14, 69729], [17, 69989], [26, 70569], [29, 70689], [32, 70869], [39, 71309], [41, 71409], [44, 71529], [49, 71769], [53, 72069], [59, 72729], [66, 73269]]}, {"verse": 13, "start": 74495, "end": 81749, "text": "Y le presentaban niños para que los tocase; y los discípulos reprendían a quienes los presentaban.", "words": [[0, 74495], [2, 74603], [5, 74723], [17, 75383], [23, 75923], [28, 76503], [32, 76643], [36, 76803], [44, 77846], [46, 77954], [50, 78094], [61, 78894], [72, 80034], [74, 80254], [82, 80514], [86, 80754]]}, {"verse": 14, "start": 82099, "end": 91710, "text": "Y viéndolo Jesús, se enojó, y les dijo: Dejad que los niños vengan, y no se lo impidáis; porque de los tales es el reino de Dios.", "words": [[0, 82099], [2, 82228], [11, 82668], [18, 82968], [21, 83348], [28, 84288], [30, 84438], [34, 84588], [40, 85342], [46, 85982], [50, 86122], [54, 86282], [60, 86732], [68, 87182], [70, 87562], [73, 87722], [76, 87902], [79, 88022], [89, 89216], [96, 89438], [99, 89598], [103, 89759], [109, 89998], [112, 90298], [115, 90498], [121, 90899], [124, 91059]]}, {"verse": 15, "start": 92060, "end": 98384, "text": "De cierto os digo, que el que no reciba el reino de Dios como un niño, no entrará en él.", "words": [[0, 92265], [3, 92505], [10, 92745], [13, 93005], [19, 93285], [23, 93845], [26, 93965], [30, 94105], [33, 94285], [40, 94845], [43, 94965], [49, 95325], [52, 95485], [57, 95705], [62, 95985], [65, 96205], [71, 96645], [74, 97185], [82, 97825], [85, 98025]]}, {"verse": 16, "start": 98733, "end": 103991, "text": "Y tomándolos en los brazos, poniendo las manos sobre ellos, los bendecía.", "words": [[0, 98733], [2, 98837], [13, 99517], [16, 99657], [20, 99777], [28, 100757], [37, 101257], [41, 101437], [47, 101737], [53, 102137], [60, 103057], [64, 103157]]}, {"verse": 17, "start": 104341, "end": 116200, "text": "Y saliendo él para ir su camino, vino uno corriendo, y arrodillándose delante de él, le preguntó: Maestro bueno, ¿qué haré para heredar la vida eterna?", "words": [[0, 104341], [2, 104445], [11, 104985], [14, 105285], [19, 105525], [22, 105745], [25, 105965], [33, 106465], [38, 107285], [42, 107565], [53, 108285], [55, 108765], [70, 109805], [78, 110345], [81, 110525], [85, 110725], [88, 111025], [98, 112038], [106, 112598], [113, 113398], [118, 113498], [123, 113798], [128, 113978], [136, 114458], [139, 114578], [144, 114778]]}, {"verse": 18, "start": 116480, "end": 122842, "text": "Y Jesús le dijo: ¿Por qué me dices bueno? Ninguno hay bueno, sino sólo uno, Dios.", "words": [[0, 116480], [2, 116625], [8, 117005], [11, 117365], [17, 118080], [22, 118183], [26, 118383], [29, 118523], [35, 118843], [42, 119639], [50, 120476], [54, 120736], [61, 121096], [66, 121416], [71, 121816], [76, 122196]]}, {"verse": 19, "start": 123192, "end": 133745, "text": "Los mandamientos sabes: No adulteres: No mates: No robes: No digas falso testimonio: No defraudes: Honra a tu padre y a tu madre.", "words": [[0, 123192], [4, 123426], [17, 124066], [24, 125024], [27, 125169], [38, 126177], [41, 126397], [48, 127069], [51, 127223], [58, 127998], [61, 128218], [67, 128578], [73, 129018], [85, 130033], [88, 130475], [99, 131132], [105, 131777], [107, 131977], [110, 132097], [116, 132517], [118, 132902], [120, 132982], [123, 133102]]}, {"verse": 20, "start": 134095, "end": 139775, "text": "Él entonces respondiendo, le dijo: Maestro, todo esto he guardado desde mi juventud.", "words": [[0, 134095], [3, 134277], [12, 135237], [26, 136017], [29, 136097], [35, 136801], [44, 137443], [49, 137543], [54, 137923], [57, 138103], [66, 138643], [72, 138823], [75, 139083]]}, {"verse": 21, "start": 140055, "end": 154210, "text": "Entonces Jesús mirándole, le amó, y le dijo: Una cosa te falta: ve, vende todo lo que tienes, y da a los pobres, y tendrás tesoro en el cielo; y ven, sígueme, tomando tu cruz.", "words": [[0, 140055], [9, 140542], [15, 141662], [26, 142362], [29, 142362], [34, 143022], [36, 143242], [39, 143342], [45, 144116], [49, 144301], [54, 144521], [57, 144741], [64, 145636], [68, 146022], [74, 146282], [79, 146562], [82, 146762], [86, 146902], [94, 147342], [96, 147982], [99, 148182], [101, 148322], [105, 148442], [113, 149042], [115, 149502], [123, 149902], [130, 150322], [133, 150462], [136, 150602], [143, 151494], [145, 151618], [150, 151858], [159, 152738], [167, 153398], [170, 153618]]}, {"verse": 22, "start": 154560, "end": 160670, "text": "Pero él, entristecido por esta palabra, se fue triste, porque tenía muchas posesiones.", "words": [[0, 154560], [5, 154742], [9, 155022], [22, 156182], [26, 156422], [31, 156602], [40, 157162], [43, 157527], [47, 157707], [55, 158567], [62, 158847], [68, 159227], [75, 159627]]}, {"verse": 23, "start": 161020, "end": 170670, "text": "Entonces Jesús, mirando alrededor, dice a sus discípulos: ¡Cuán difícilmente entrarán en el reino de Dios los que tienen riquezas!", "words": [[0, 161020], [9, 161764], [16, 162804], [24, 163204], [35, 164484], [40, 164744], [42, 164904], [46, 165084], [58, 166210], [64, 166417], [77, 167277], [86, 167997], [89, 168137], [92, 168297], [98, 168677], [101, 168837], [106, 169077], [110, 169277], [114, 169457], [121, 169757]]}, {"verse": 24, "start": 171020, "end": 184754, "text": "Y los discípulos se espantaron de sus palabras; pero Jesús respondiendo, les volvió a decir: ¡Hijos, cuán difícil es para los que confían en las riquezas entrar en el reino de Dios!", "words": [[0, 171020], [2, 171109], [6, 171249], [17, 171929], [20, 172129], [31, 172969], [34, 173129], [38, 173309], [48, 174371], [53, 174518], [59, 175078], [73, 176458], [77, 176578], [84, 177178], [86, 177298], [93, 178014], [101, 178415], [106, 178935], [114, 179295], [117, 179755], [122, 180395], [126, 180575], [130, 180735], [138, 181335], [141, 181515], [145, 181695], [154, 182255], [161, 182955], [164, 183375], [167, 183535], [173, 183975], [176, 184135]]}, {"verse": 25, "start": 185104, "end": 192308, "text": "Más fácil es pasar un camello por el ojo de una aguja, que el rico entrar en el reino de Dios.", "words": [[0, 185104], [4, 185453], [10, 185993], [13, 186293], [19, 186673], [22, 186953], [30, 187513], [34, 187753], [37, 187913], [41, 188233], [44, 188353], [48, 188573], [55, 189413], [59, 189693], [62, 189893], [67, 190133], [74, 190673], [77, 190913], [80, 191073], [86, 191553], [89, 191713]]}, {"verse": 26, "start": 192658, "end": 198083, "text": "Y ellos se espantaban más, diciendo dentro de sí: ¿Y quién podrá salvarse?", "words": [[0, 192658], [2, 192825], [8, 193065], [11, 193325], [22, 194165], [27, 194565], [36, 195225], [43, 195845], [46, 196125], [50, 196643], [53, 196764], [59, 196964], [65, 197324]]}, {"verse": 27, "start": 198363, "end": 208121, "text": "Entonces Jesús mirándolos, dice: Para los hombres es imposible; pero para Dios, no; porque todas las cosas son posibles para Dios.", "words": [[0, 198363], [9, 199249], [15, 200002], [27, 200782], [33, 201503], [38, 201670], [42, 201850], [50, 202230], [53, 202450], [64, 203771], [69, 203935], [74, 204175], [80, 204875], [84, 205356], [91, 205539], [97, 205859], [101, 206139], [107, 206459], [111, 206779], [120, 207319], [125, 207559]]}, {"verse": 28, "start": 208471, "end": 215055, "text": "Entonces Pedro comenzó a decirle: He aquí, nosotros hemos dejado todas las cosas, y te hemos seguido.", "words": [[0, 208471], [9, 209076], [15, 209456], [23, 210076], [25, 210196], [34, 211105], [37, 211245], [43, 211665], [52, 211925], [58, 212325], [65, 212825], [71, 213005], [75, 213305], [82, 213645], [84, 214165], [87, 214305], [93, 214485]]}, {"verse": 29, "start": 215335, "end": 229239, "text": "Y respondiendo Jesús, dijo: De cierto os digo, que no hay ninguno que haya dejado casa, o hermanos, o hermanas, o padre, o madre, o mujer, o hijos, o tierras, por causa de mí y del evangelio,", "words": [[0, 215335], [2, 215461], [15, 216221], [22, 216561], [28, 217878], [31, 218083], [38, 218288], [41, 218493], [47, 218853], [51, 219093], [54, 219313], [58, 219473], [66, 220013], [70, 220153], [75, 220473], [82, 220793], [88, 221173], [90, 221568], [100, 222308], [102, 222628], [112, 223188], [114, 223468], [121, 223848], [123, 224128], [130, 224468], [132, 224688], [139, 225028], [141, 225288], [148, 225608], [150, 225848], [159, 226804], [163, 226946], [169, 227306], [172, 227626], [175, 227846], [177, 228126], [181, 228286]]}, {"verse": 30, "start": 229589, "end": 241932, "text": "Que no reciba cien veces más ahora en este tiempo, casas, y hermanos, y hermanas, y madres, e hijos, y tierras, con persecuciones; y en el siglo venidero la vida eterna.", "words": [[0, 229589], [4, 229673], [7, 230083], [14, 230493], [19, 230773], [25, 231053], [29, 231333], [35, 231733], [38, 231873], [43, 232053], [51, 232953], [58, 233653], [60, 233853], [70, 234453], [72, 234633], [82, 235153], [84, 235493], [92, 235953], [94, 236153], [101, 236666], [103, 237180], [112, 237693], [116, 237893], [131, 239362], [133, 239486], [136, 239626], [139, 239746], [145, 240126], [154, 240806], [157, 240926], [162, 241146]]}, {"verse": 31, "start": 242282, "end": 247057, "text": "Pero muchos de los primeros serán últimos, y los últimos serán primeros.", "words": [[0, 242282], [5, 242542], [12, 242962], [15, 243162], [19, 243282], [28, 243802], [34, 244162], [43, 244682], [45, 245222], [49, 245382], [57, 245762], [63, 246242]]}, {"verse": 32, "start": 247407, "end": 263887, "text": "Y estaban en el camino subiendo a Jerusalén; y Jesús iba delante de ellos, y se espantaban, y le seguían con miedo: entonces volviendo a tomar a los doce aparte, les comenzó a decir las cosas que le habían de acontecer:", "words": [[0, 247407], [2, 247512], [10, 247852], [13, 248092], [16, 248232], [23, 248672], [32, 249552], [34, 249672], [45, 250734], [47, 250844], [53, 251204], [57, 251764], [65, 252324], [68, 252524], [75, 252844], [77, 253144], [80, 253304], [92, 254244], [94, 254924], [97, 255044], [105, 255524], [109, 255704], [116, 256481], [125, 257577], [135, 258057], [137, 258177], [143, 258497], [145, 258717], [149, 258837], [154, 259217], [162, 260217], [166, 260317], [174, 260977], [176, 261077], [182, 261357], [186, 261717], [192, 262137], [196, 262377], [199, 262537], [206, 262837], [209, 263057]]}, {"verse": 33, "start": 264237, "end": 276964, "text": "He aquí subimos a Jerusalén, y el Hijo del hombre será entregado a los principales sacerdotes, y a los escribas, y le condenarán a muerte, y le entregarán a los Gentiles:", "words": [[0, 264288], [3, 264378], [8, 264558], [16, 265158], [18, 265298], [29, 266038], [31, 266578], [34, 266698], [39, 266978], [43, 267118], [50, 267558], [55, 267798], [65, 268798], [67, 268938], [71, 269038], [83, 269858], [95, 270778], [97, 271258], [99, 271338], [103, 271458], [113, 272258], [115, 272938], [118, 273058], [129, 273758], [131, 273818], [139, 274730], [141, 274835], [144, 274975], [155, 275695], [157, 275855], [161, 275975]]}, {"verse": 34, "start": 277314, "end": 286149, "text": "Y se burlarán de él, y le golpearán con látigos, y escupirán en él, y le matarán; pero al tercer día resucitará.", "words": [[0, 277314], [2, 277433], [5, 277853], [14, 278273], [17, 278453], [21, 278753], [23, 279253], [26, 279373], [36, 280073], [40, 280233], [49, 280873], [51, 281393], [61, 282073], [64, 282213], [68, 282493], [70, 282873], [73, 282973], [82, 283955], [87, 284117], [90, 284317], [97, 284577], [101, 284997]]}, {"verse": 35, "start": 286499, "end": 295402, "text": "Entonces Jacobo y Juan, hijos de Zebedeo, se llegaron a él, diciendo: Maestro, querríamos que nos hagas lo que pidamos.", "words": [[0, 286499], [9, 287184], [16, 288244], [18, 288364], [24, 289144], [30, 289384], [33, 289934], [42, 290484], [45, 290624], [54, 291104], [56, 291224], [60, 291484], [70, 292666], [79, 293271], [90, 293711], [94, 293971], [98, 294151], [104, 294491], [107, 294611], [111, 294711]]}, {"verse": 36, "start": 295682, "end": 298188, "text": "Y él les dijo: ¿Qué queréis que os haga?", "words": [[0, 295682], [2, 295869], [5, 296009], [9, 296149], [15, 296850], [20, 296953], [28, 297333], [32, 297513], [35, 297673]]}, {"verse": 37, "start": 298538, "end": 305144, "text": "Y ellos le dijeron: Danos que en tu gloria nos sentemos el uno a tu derecha, y el otro a tu izquierda.", "words": [[0, 298538], [2, 298718], [8, 298938], [11, 299158], [20, 300083], [26, 300508], [30, 300668], [33, 300788], [36, 300908], [43, 301268], [47, 301428], [56, 302048], [59, 302348], [63, 302548], [65, 302728], [68, 302828], [77, 303688], [79, 303868], [82, 304008], [87, 304208], [89, 304388], [92, 304508]]}, {"verse": 38, "start": 305424, "end": 315198, "text": "Entonces Jesús les dijo: No sabéis lo que pedís. ¿Podéis beber del vaso que yo bebo, o ser bautizados del bautismo de que yo soy bautizado?", "words": [[0, 305424], [9, 305930], [15, 306248], [19, 306565], [25, 307850], [28, 307990], [35, 308430], [38, 308590], [42, 308710], [49, 309532], [57, 309898], [63, 310198], [67, 310518], [72, 310918], [76, 310978], [79, 311178], [85, 311558], [87, 311898], [91, 312318], [102, 312738], [106, 313038], [115, 313598], [118, 313778], [122, 313898], [125, 314078], [129, 314298]]}, {"verse": 39, "start": 315548, "end": 327628, "text": "Y ellos dijeron: Podemos. Y Jesús les dijo: A la verdad, del vaso que yo bebo, beberéis; y del bautismo de que yo soy bautizado, seréis bautizados.", "words": [[0, 315548], [2, 315676], [8, 315836], [17, 316699], [26, 317643], [28, 317767], [34, 318187], [38, 318647], [44, 319364], [46, 319534], [49, 319614], [57, 319894], [61, 320574], [66, 320994], [70, 321094], [73, 321314], [79, 321654], [89, 322975], [91, 323100], [95, 323260], [104, 323980], [107, 324400], [111, 324540], [114, 324740], [118, 324960], [129, 326060], [136, 326480]]}, {"verse": 40, "start": 327978, "end": 334428, "text": "Pero que os sentéis a mi derecha y a mi izquierda, no es mío darlo, sino a quienes está preparado.", "words": [[0, 327978], [5, 328124], [9, 328324], [12, 328504], [20, 329084], [22, 329224], [25, 329344], [33, 329864], [35, 330024], [37, 330104], [40, 330284], [51, 331204], [54, 331404], [57, 331524], [61, 331844], [68, 332584], [73, 332824], [75, 333024], [83, 333164], [88, 333624]]}, {"verse": 41, "start": 334778, "end": 340066, "text": "Y como lo oyeron los diez, comenzaron a enojarse de Jacobo y de Juan.", "words": [[0, 334778], [2, 334882], [7, 335122], [10, 335322], [17, 335942], [21, 336082], [27, 336922], [38, 337642], [40, 337822], [49, 338462], [52, 338622], [59, 339242], [61, 339362], [64, 339462]]}, {"verse": 42, "start": 340416, "end": 352472, "text": "Pero Jesús, llamándolos, les dice: Sabéis que los que son reconocidos como gobernantes entre las naciones, las dominan, y los que entre ellas son grandes, tienen sobre ellas autoridad.", "words": [[0, 340416], [5, 340560], [12, 341100], [25, 341740], [29, 342380], [35, 343113], [42, 343495], [46, 343715], [50, 344055], [54, 344255], [58, 344535], [70, 345315], [75, 345555], [87, 346235], [93, 346495], [97, 346715], [107, 347235], [111, 347695], [120, 348335], [122, 348775], [126, 348935], [130, 349075], [136, 349295], [142, 349595], [146, 349855], [155, 350255], [162, 350790], [168, 351150], [174, 351510]]}, {"verse": 43, "start": 352822, "end": 360521, "text": "Pero no será así entre vosotros, sino que el que quiera hacerse grande entre vosotros será vuestro servidor;", "words": [[0, 352822], [5, 352985], [8, 353205], [13, 353465], [17, 353885], [23, 354205], [33, 355385], [38, 355765], [42, 356065], [45, 356385], [49, 356565], [56, 357005], [64, 357685], [71, 358085], [77, 358425], [86, 359045], [91, 359325], [99, 359745]]}, {"verse": 44, "start": 360871, "end": 365420, "text": "Y el que de vosotros quiera ser el primero, será siervo de todos.", "words": [[0, 360871], [2, 361081], [5, 361241], [9, 361441], [12, 361581], [21, 362101], [28, 362501], [32, 362701], [35, 362881], [44, 363441], [49, 363936], [56, 364616], [59, 364756]]}, {"verse": 45, "start": 365770, "end": 373707, "text": "Porque el Hijo del hombre tampoco vino para ser servido, sino para servir, y dar su vida en rescate por muchos.", "words": [[0, 365770], [7, 366034], [10, 366394], [15, 366654], [19, 366794], [26, 367174], [34, 367454], [39, 368034], [44, 368354], [48, 368614], [57, 369754], [62, 370054], [67, 370294], [75, 370774], [77, 371274], [81, 371474], [84, 371694], [89, 371994], [92, 372114], [100, 372674], [104, 372934]]}, {"verse": 46, "start": 374057, "end": 387895, "text": "Entonces vienen a Jericó: y saliendo él de Jericó y sus discípulos y una gran multitud, Bartimeo el ciego, hijo de Timeo, estaba sentado junto al camino mendigando.", "words": [[0, 374057], [9, 374559], [16, 374919], [18, 375139], [26, 375928], [28, 376089], [37, 376669], [40, 377009], [43, 377209], [50, 377889], [52, 378064], [56, 378264], [67, 379104], [69, 379269], [73, 379429], [78, 379689], [88, 380909], [97, 382109], [100, 382229], [107, 383309], [112, 383509], [115, 383709], [122, 384669], [129, 384989], [137, 385749], [143, 386029], [146, 386329], [153, 386749]]}, {"verse": 47, "start": 388245, "end": 396708, "text": "Y oyendo que era Jesús el nazareno, comenzó a dar voces y decir: Jesús, Hijo de David, ten misericordia de mí.", "words": [[0, 388245], [2, 388410], [9, 388770], [13, 389030], [17, 389230], [23, 389970], [26, 390130], [36, 391270], [44, 391970], [46, 392090], [50, 392190], [56, 392710], [58, 392870], [65, 393692], [72, 394241], [77, 394461], [80, 394581], [87, 395041], [91, 395501], [104, 396281], [107, 396421]]}, {"verse": 48, "start": 396988, "end": 405006, "text": "Y muchos le reprendían, que callase: pero él daba mayores voces: Hijo de David, ten misericordia de mí.", "words": [[0, 396988], [2, 397110], [9, 397510], [12, 397910], [24, 398770], [28, 398975], [37, 399986], [42, 400173], [45, 400593], [50, 401173], [58, 401593], [65, 402557], [70, 402815], [73, 402955], [80, 403515], [84, 403635], [97, 404435], [100, 404575]]}, {"verse": 49, "start": 405286, "end": 413115, "text": "Entonces Jesús parándose, mandó llamarle: y llaman al ciego, diciéndole: Ten ánimo: levántate, te llama.", "words": [[0, 405286], [9, 405690], [15, 406150], [26, 407090], [32, 407650], [42, 408566], [44, 408694], [51, 408974], [54, 409174], [61, 410014], [73, 411318], [77, 411552], [84, 411973], [95, 412301], [98, 412671]]}, {"verse": 50, "start": 413395, "end": 418137, "text": "Él entonces, echando su capa, se levantó, y vino a Jesús.", "words": [[0, 413395], [3, 413678], [13, 414338], [21, 414978], [24, 415178], [30, 415898], [33, 416058], [42, 416718], [44, 417138], [49, 417378], [51, 417538]]}, {"verse": 51, "start": 418487, "end": 425546, "text": "Y respondiendo Jesús, le dice: ¿Qué quieres que te haga? Y el ciego le dice: Maestro, que recobre la vista.", "words": [[0, 418487], [2, 418593], [15, 419213], [22, 419533], [25, 419893], [31, 420605], [36, 420720], [44, 421040], [48, 421260], [51, 421440], [57, 422134], [59, 422259], [62, 422379], [68, 422819], [71, 422979], [77, 423706], [86, 424231], [90, 424431], [98, 424931], [101, 425051]]}, {"verse": 52, "start": 425826, "end": 433505, "text": "Y Jesús le dijo: Ve, tu fe te ha salvado. Y luego recobró la vista, y seguía a Jesús en el camino.", "words": [[0, 425826], [2, 425970], [8, 426350], [11, 426710], [17, 427583], [21, 427775], [24, 427877], [27, 428077], [30, 428277], [33, 428417], [42, 429396], [44, 429678], [50, 429918], [58, 430638], [61, 430798], [68, 431098], [70, 431358], [77, 431878], [79, 432058], [85, 432358], [88, 432698], [91, 432818]]}]}