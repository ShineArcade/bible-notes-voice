{"book": "MAT", "chapter": 28, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 134180, "verses": [{"verse": 1, "start": 300, "end": 7652, "text": "In the end of the sabbath, as it began to dawn toward the first day of the week, came Mary Magdalene and the other Mary to see the tomb.", "words": [[0, 300], [3, 442], [7, 562], [11, 722], [14, 842], [18, 922], [27, 1742], [30, 1862], [33, 1982], [39, 2282], [42, 2462], [47, 2782], [54, 3042], [58, 3242], [64, 3482], [68, 3722], [71, 3822], [75, 3922], [81, 4742], [86, 4922], [91, 5202], [101, 5862], [105, 6042], [109, 6182], [115, 6322], [120, 6622], [123, 6782], [127, 7002], [131, 7142]]}, {"verse": 2, "start": 8102, "end": 17562, "text": "And, behold, there was a great earthquake: for the angel of the Lord descended from heaven, and came and rolled back the stone from the door, and sat upon it.", "words": [[0, 8102], [5, 8243], [13, 9203], [19, 9463], [23, 9643], [25, 9763], [31, 10003], [43, 11050], [47, 11152], [51, 11312], [57, 11712], [60, 11912], [64, 12052], [69, 12292], [79, 12732], [84, 13052], [92, 13392], [96, 13772], [101, 14092], [105, 14392], [112, 14672], [117, 14992], [121, 15232], [127, 15552], [132, 15812], [136, 15932], [142, 16232], [146, 16692], [150, 16992], [155, 17252]]}, {"verse": 3, "start": 18012, "end": 21583, "text": "His countenance was like lightning, and his clothing white as snow:", "words": [[0, 18012], [4, 18139], [16, 18659], [20, 18819], [25, 19039], [36, 19839], [40, 19919], [44, 20059], [53, 20399], [59, 20779], [62, 20959]]}, {"verse": 4, "start": 22033, "end": 25726, "text": "And for fear of him the keepers did shake, and became as dead men.", "words": [[0, 22033], [4, 22158], [8, 22338], [13, 22578], [16, 22798], [20, 23018], [24, 23098], [32, 23518], [36, 23738], [43, 24118], [47, 24358], [54, 24608], [57, 24858], [62, 25118]]}, {"verse": 5, "start": 26176, "end": 32431, "text": "And the angel answered and said to the women, Fear not you: for