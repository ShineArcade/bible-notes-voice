{"book": "PSA", "chapter": 42, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 106847, "verses": [{"verse": 1, "start": 300, "end": 11131, "text": "Al Músico principal: Masquil a los hijos de Coré. COMO el ciervo brama por las corrientes de las aguas, así clama por ti, oh Dios, el alma mía.", "words": [[0, 300], [3, 489], [10, 1009], [21, 2334], [29, 3139], [31, 3359], [35, 3519], [41, 3799], [44, 4019], [50, 4776], [55, 4945], [58, 5295], [65, 5645], [71, 6045], [75, 6305], [79, 6465], [90, 7085], [93, 7265], [97, 7425], [104, 8185], [108, 8365], [114, 8785], [118, 8985], [122, 9365], [125, 9745], [131, 10265], [134, 10365], [139, 10585]]}, {"verse": 2, "start": 11581, "end": 18080, "text": "Mi alma tiene sed de Dios, del Dios vivo: ¡cuándo vendré, y me presentaré delante de Dios!", "words": [[0, 11581], [3, 11728], [8, 12028], [14, 12388], [18, 12748], [21, 13008], [27, 13848], [31, 13988], [36, 14188], [42, 15078], [50, 15239], [58, 15899], [60, 16139], [63, 16259], [74, 16979], [82, 17439], [85, 17599]]}, {"verse": 3, "start": 18530, "end": 25823, "text": "Fueron mis lágrimas mi pan de día y de noche, mientras me dicen todos los días: ¿Dónde está tu Dios?", "words": [[0, 18530], [7, 18735], [11, 19015], [20, 20035], [23, 20135], [27, 20455], [30, 20615], [34, 20895], [36, 21115], [39, 21215], [46, 21855], [55, 22295], [58, 22615], [64, 22875], [70, 23295], [74, 23635], [80, 24576], [87, 24863], [92, 25063], [95, 25243]]}, {"verse": 4, "start": 26173, "end": 39975, "text": "Me acordaré de estas cosas, y derramaré sobre mí mi alma: cuando pasaré en el número, iré con ellos hasta la casa de Dios, con voz de alegría y de alabanza, haciendo fiesta la multitud.", "words": [[0, 26173], [3, 26337], [12, 26997], [15, 27157], [21, 27377], [28, 27957], [30, 28607], [40, 29257], [46, 29577], [49, 29877], [52, 30037], [58, 30996], [65, 31157], [72, 31797], [75, 31917], [78, 32077], [86, 32657], [90, 33237], [94, 33437], [100, 33737], [106, 34137], [109, 34297], [114, 34557], [117, 34777], [123, 35437], [127, 35717], [131, 35957], [134, 36157], [142, 36757], [144, 36897], [147, 37017], [157, 38037], [166, 38477], [173, 39037], [176, 39197]]}, {"verse": 5, "start": 40425, "end": 49873, "text": "¿Por qué te abates, oh alma mía, y te conturbas en mí? Espera a Dios; porque aún le he de alabar por las saludes de su presencia.", "words": [[0, 40478], [5, 40564], [9, 40651], [12, 40871], [20, 41331], [23, 41791], [28, 42051], [33, 42831], [35, 43111], [38, 43251], [48, 43991], [51, 44191], [55, 44875], [62, 45100], [64, 45360], [70, 46222], [77, 46425], [81, 46592], [84, 46758], [87, 46925], [90, 47165], [97, 47605], [101, 47785], [105, 47965], [113, 48605], [116, 48725], [119, 48885]]}, {"verse": 6, "start": 50323, "end": 61688, "text": "Dios mío, mi alma está en mí abatida: me acordaré por tanto de ti desde tierra del Jordán, y de los hermonitas, desde el monte de Mizar.", "words": [[0, 50323], [5, 50569], [10, 51829], [13, 51929], [18, 52189], [23, 52529], [26, 52789], [29, 52989], [38, 54343], [41, 54431], [50, 54951], [54, 55151], [60, 55471], [63, 55711], [66, 56251], [72, 56511], [79, 56971], [83, 57231], [91, 58051], [93, 58471], [96, 58591], [100, 58711], [112, 59831], [118, 60171], [121, 60551], [127, 60911], [130, 61300]]}, {"verse": 7, "start": 62138, "end": 68708, "text": "Un abismo llama a otro a la voz de tus canales: todas tus ondas y tus olas han pasado sobre mí.", "words": [[0, 62276], [3, 62450], [10, 62623], [16, 63003], [18, 63363], [23, 63703], [25, 64043], [28, 64143], [32, 64383], [35, 64563], [39, 64743], [48, 65905], [54, 66190], [58, 66370], [64, 66770], [66, 66910], [70, 67050], [75, 67430], [79, 67550], [86, 67970], [92, 68310]]}, {"verse": 8, "start": 69158, "end": 76862, "text": "De día mandará Jehová su misericordia, y de noche su canción será conmigo, y oración al Dios de mi vida.", "words": [[0, 69158], [3, 69305], [7, 69585], [15, 70065], [22, 70525], [25, 70665], [39, 71625], [41, 72085], [44, 72225], [50, 72465], [53, 72785], [61, 73205], [66, 73605], [75, 74425], [77, 74825], [85, 75285], [88, 75705], [93, 75925], [96, 76245], [99, 76385]]}, {"verse": 9, "start": 77312, "end": 85744, "text": "Diré a Dios: Roca mía, ¿por qué te has olvidado de mí? ¿Por qué andaré yo enlutado por la opresión del enemigo?", "words": [[0, 77312], [5, 77743], [7, 78196], [13, 78901], [18, 79244], [23, 80004], [28, 80104], [32, 80324], [35, 80484], [39, 80644], [48, 81284], [51, 81484], [55, 82145], [60, 82288], [64, 82508], [71, 83008], [74, 83188], [83, 83968], [87, 84228], [90, 84388], [99, 84948], [103, 85148]]}, {"verse": 10, "start": 86194, "end": 94703, "text": "Mientras se están quebrantando mis huesos, mis enemigos me afrentan, diciéndome cada día: ¿Dónde está tu Dios?", "words": [[0, 86194], [9, 86494], [12, 86794], [18, 87294], [31, 88194], [35, 88354], [43, 89474], [47, 89554], [56, 90174], [59, 90374], [69, 91554], [80, 92354], [85, 92594], [90, 93456], [97, 93743], [102, 93943], [105, 94123]]}, {"verse": 11, "start": 95053, "end": 106447, "text": "¿Por qué te abates, oh alma mía, y por qué te conturbas en mí? Espera a Dios; porque aún le he de alabar; es él salvamento delante de mí, y el Dios mío.", "words": [[0, 95053], [5, 95175], [9, 95375], [12, 95535], [20, 95965], [23, 96395], [28, 96695], [33, 97675], [35, 97775], [39, 97955], [43, 98115], [46, 98255], [56, 98975], [59, 99175], [63, 99843], [70, 100068], [72, 100328], [78, 101189], [85, 101411], [89, 101638], [92, 101864], [95, 102091], [98, 102291], [106, 103243], [109, 103393], [112, 103613], [123, 104313], [131, 104773], [134, 104933], [138, 105173], [140, 105673], [143, 105813], [148, 105953]]}]}