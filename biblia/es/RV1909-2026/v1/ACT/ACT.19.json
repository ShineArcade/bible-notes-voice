{"book": "ACT", "chapter": 19, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 374150, "verses": [{"verse": 1, "start": 300, "end": 10994, "text": "Y aconteció que entre tanto que Apolos estaba en Corinto, Pablo, andadas las regiones superiores, vino a Éfeso, y hallando ciertos discípulos,", "words": [[0, 300], [2, 410], [12, 1090], [16, 1370], [22, 1590], [28, 2010], [32, 2430], [39, 2850], [46, 3170], [49, 3350], [58, 4050], [65, 5010], [73, 5530], [77, 5930], [86, 6550], [98, 7530], [103, 7850], [105, 8050], [112, 8570], [114, 9150], [123, 9530], [131, 10110]]}, {"verse": 2, "start": 11444, "end": 20589, "text": "Les dijo: ¿Habéis recibido el Espíritu Santo después que creísteis? Y ellos le dijeron: Ni siquiera hemos oído si hay Espíritu Santo.", "words": [[0, 11444], [4, 11630], [10, 12455], [18, 12777], [27, 13437], [30, 13537], [39, 14057], [45, 14357], [53, 14777], [57, 15037], [68, 16623], [70, 16806], [76, 17026], [79, 17206], [88, 18155], [91, 18279], [100, 18599], [106, 18799], [111, 19159], [114, 19379], [118, 19519], [127, 20059]]}, {"verse": 3, "start": 20939, "end": 27260, "text": "Entonces dijo: ¿En qué pues sois bautizados? Y ellos dijeron: En el bautismo de Juan.", "words": [[0, 20939], [9, 21383], [15, 22343], [19, 22485], [23, 22685], [28, 22985], [33, 23245], [45, 24487], [47, 24653], [53, 24833], [62, 25876], [65, 25997], [68, 26097], [77, 26657], [80, 26817]]}, {"verse": 4, "start": 27610, "end": 38547, "text": "Y dijo Pablo: Juan bautizó con bautismo de arrepentimiento, diciendo al pueblo que creyesen en el que había de venir después de él, es decir, en Jesús el Cristo.", "words": [[0, 27610], [2, 27733], [7, 27973], [14, 28903], [19, 29113], [27, 29693], [31, 29873], [40, 30373], [43, 30533], [60, 31973], [69, 32313], [72, 32613], [79, 32913], [83, 33173], [92, 33813], [95, 33913], [98, 34033], [102, 34173], [108, 34413], [111, 34633], [117, 34893], [125, 35313], [128, 35573], [132, 36333], [135, 36353], [142, 37253], [145, 37353], [151, 37693], [154, 38013]]}, {"verse": 5, "start": 38897, "end": 44595, "text": "Oído que hubieron esto, fueron bautizados en el nombre del Señor Jesús.", "words": [[0, 38897], [5, 39282], [9, 39522], [18, 39962], [24, 40342], [31, 41302], [42, 42362], [45, 42662], [48, 42802], [55, 43162], [59, 43442], [65, 43742]]}, {"verse": 6, "start": 45045, "end": 53904, "text": "Y habiéndoles impuesto Pablo las manos, vino sobre ellos el Espíritu Santo; y hablaban en lenguas, y profetizaban.", "words": [[0, 45045], [2, 45328], [14, 45888], [23, 46508], [29, 47028], [33, 47228], [40, 47948], [45, 48288], [51, 48648], [57, 48968], [60, 49188], [69, 49788], [76, 50802], [78, 50947], [87, 51467], [90, 51667], [99, 52367], [101, 52667]]}, {"verse": 7, "start": 54354, "end": 57156, "text": "Y eran en todos como unos doce hombres.", "words": [[0, 54354], [2, 54521], [7, 54741], [10, 54941], [16, 55321], [21, 55721], [26, 55981], [31, 56401]]}, {"verse": 8, "start": 57606, "end": 67227, "text": "Y entrando él dentro de la sinagoga, hablaba libremente por espacio de tres meses, razonando y persuadiendo acerca del reino de Dios.", "words": [[0, 57606], [2, 57732], [11, 58272], [14, 58552], [21, 59032], [24, 59252], [27, 59372], [37, 60152], [45, 61172], [56, 61892], [60, 62112], [68, 62552], [71, 62772], [76, 63032], [83, 63832], [93, 64632], [95, 64732], [108, 65452], [115, 65792], [119, 66172], [125, 66552], [128, 66692]]}, {"verse": 9, "start": 67677, "end": 82443, "text": "Pero endureciéndose algunos y no creyendo, maldiciendo el Camino delante de la multitud, apartándose Pablo de ellos separó a los discípulos, razonando cada día en la escuela de un cierto Tirano.", "words": [[0, 67677], [5, 68341], [20, 69601], [28, 69961], [30, 70261], [33, 70401], [43, 71121], [55, 71961], [58, 72101], [65, 72461], [73, 73041], [76, 73141], [79, 73281], [89, 74221], [101, 75201], [107, 75561], [110, 75781], [116, 76681], [123, 77281], [125, 77381], [129, 77541], [141, 79281], [151, 79761], [156, 80001], [160, 80301], [163, 80441], [166, 80541], [174, 80821], [177, 81061], [180, 81221], [187, 81521]]}, {"verse": 10, "start": 82893, "end": 92906, "text": "Y esto fue por espacio de dos años; de manera que todos los que habitaban en Asia, judíos y griegos, oyeron la palabra del Señor Jesús.", "words": [[0, 82893], [2, 83055], [7, 83275], [11, 83535], [15, 83735], [23, 84275], [26, 84515], [30, 84755], [36, 85879], [39, 85987], [46, 86207], [50, 86507], [56, 86807], [60, 87247], [64, 87407], [74, 87947], [77, 88087], [83, 88767], [90, 89467], [92, 89607], [101, 90527], [108, 90987], [111, 91107], [119, 91487], [123, 91767], [129, 92087]]}, {"verse": 11, "start": 93356, "end": 97302, "text": "Y hacía Dios milagros extraordinarios por manos de Pablo:", "words": [[0, 93356], [2, 93593], [8, 93873], [13, 94053], [22, 94813], [38, 95953], [42, 96193], [48, 96493], [51, 96713]]}, {"verse": 12, "start": 97752, "end": 109231, "text": "De tal manera que aun se llevaban sobre los enfermos los pañuelos y los delantales de su cuerpo, y las enfermedades se iban de ellos, y los malos espíritus salían de ellos.", "words": [[0, 97752], [3, 97878], [7, 98058], [14, 98418], [18, 98678], [22, 98858], [25, 99098], [34, 99618], [40, 99858], [44, 100098], [53, 100838], [57, 100918], [66, 101658], [68, 101938], [72, 102058], [83, 102738], [86, 102878], [89, 103038], [97, 103458], [99, 104058], [103, 104238], [116, 105138], [119, 105418], [124, 105718], [127, 105918], [134, 106728], [136, 106830], [140, 106950], [146, 107370], [156, 108030], [163, 108450], [166, 108650]]}, {"verse": 13, "start": 109681, "end": 122547, "text": "Y algunos de los judíos, exorcistas itinerantes, intentaron invocar el nombre del Señor Jesús sobre los que tenían espíritus malos, diciendo: Os conjuro por Jesús, el que Pablo predica.", "words": [[0, 109681], [2, 109769], [10, 110089], [13, 110249], [17, 110389], [25, 110889], [36, 111739], [49, 112589], [60, 113769], [68, 114269], [71, 114449], [78, 114789], [82, 115009], [88, 115329], [94, 115929], [100, 116569], [104, 116789], [108, 116929], [115, 117329], [125, 117949], [132, 118689], [142, 119714], [145, 119857], [153, 120337], [157, 120497], [164, 120877], [167, 121417], [171, 121557], [177, 121877]]}, {"verse": 14, "start": 122897, "end": 130191, "text": "Y había siete hijos de un tal Esceva, judío, principal de los sacerdotes, que hacían esto.", "words": [[0, 122897], [2, 123014], [8, 123194], [14, 123654], [20, 124074], [23, 124334], [26, 124494], [30, 125104], [38, 125714], [45, 126754], [55, 127234], [58, 127534], [62, 127674], [74, 128894], [78, 129134], [85, 129634]]}, {"verse": 15, "start": 130641, "end": 137935, "text": "Y respondiendo el espíritu malo, dijo: A Jesús conozco, y sé quién es Pablo: pero vosotros ¿quiénes sois?", "words": [[0, 130688], [2, 130768], [15, 131588], [18, 131668], [27, 132188], [33, 132548], [39, 133500], [41, 133624], [47, 133864], [56, 134644], [58, 134784], [61, 134924], [67, 135124], [70, 135364], [77, 136212], [82, 136356], [91, 136856], [100, 137356]]}, {"verse": 16, "start": 138285, "end": 149769, "text": "Y el hombre en quien estaba el espíritu malo, saltando sobre ellos y dominándolos, pudo más que ellos, de tal manera que huyeron de aquella casa desnudos y heridos.", "words": [[0, 138285], [2, 138428], [5, 138568], [12, 138868], [15, 139088], [21, 139228], [28, 139708], [31, 139908], [40, 140448], [46, 141408], [55, 142128], [61, 142468], [67, 142848], [69, 143188], [83, 144348], [88, 144608], [92, 144808], [96, 144968], [103, 145908], [106, 146028], [110, 146248], [117, 146548], [121, 146828], [129, 147228], [132, 147348], [140, 147648], [145, 147908], [154, 148728], [156, 148988]]}, {"verse": 17, "start": 150219, "end": 161938, "text": "Y esto fue notorio a todos, así judíos como griegos, los que habitaban en Éfeso: y cayó temor sobre todos ellos, y era magnificado el nombre del Señor Jesús.", "words": [[0, 150219], [2, 150347], [7, 150567], [11, 150787], [19, 151287], [21, 151407], [28, 152307], [32, 152527], [39, 153087], [44, 153307], [53, 153887], [57, 154327], [61, 154507], [71, 155087], [74, 155367], [81, 156353], [83, 156463], [88, 156843], [94, 157263], [100, 157563], [106, 157943], [113, 158923], [115, 159143], [119, 159283], [131, 160163], [134, 160283], [141, 160603], [145, 160843], [151, 161143]]}, {"verse": 18, "start": 162388, "end": 167755, "text": "Y muchos de los que habían creído, venían, confesando y dando cuenta de sus hechos.", "words": [[0, 162388], [2, 162511], [9, 162891], [12, 163291], [16, 163411], [20, 163551], [27, 163791], [35, 164231], [43, 165051], [54, 165851], [56, 166071], [62, 166291], [69, 166711], [72, 166951], [76, 167111]]}, {"verse": 19, "start": 168205, "end": 181927, "text": "Asimismo muchos de los que habían practicado artes mágicas, trajeron los libros, y los quemaron delante de todos; y echada la cuenta del precio de ellos, hallaron ser cincuenta mil denarios.", "words": [[0, 168545], [9, 168885], [16, 169165], [19, 169365], [23, 169445], [27, 169565], [34, 169825], [45, 170525], [51, 171005], [60, 171665], [69, 172765], [73, 172925], [81, 173705], [83, 173885], [87, 173985], [96, 174385], [104, 174825], [107, 174965], [114, 175929], [116, 176090], [123, 176470], [126, 176630], [133, 176970], [137, 177290], [144, 177770], [147, 178010], [154, 178950], [163, 179570], [167, 180063], [177, 180557], [181, 181050]]}, {"verse": 20, "start": 182377, "end": 187348, "text": "Así crecía poderosamente la palabra del Señor, y prevalecía.", "words": [[0, 182377], [4, 182737], [11, 183217], [25, 184117], [28, 184297], [36, 184697], [40, 184937], [47, 185317], [49, 185937]]}, {"verse": 21, "start": 187798, "end": 200442, "text": "Y acabadas estas cosas, se propuso Pablo en espíritu partir a Jerusalén, después de andada Macedonia y Acaya, diciendo: Después que haya estado allá, también debo ver Roma.", "words": [[0, 187798], [2, 187942], [11, 188462], [17, 188762], [24, 189702], [27, 189922], [35, 190462], [41, 190942], [44, 191162], [53, 191582], [60, 192002], [62, 192422], [73, 193822], [81, 194022], [84, 194242], [91, 194562], [101, 195322], [103, 195862], [110, 196402], [120, 197318], [128, 197642], [132, 197862], [137, 198062], [144, 198382], [150, 199282], [158, 199512], [163, 199742], [167, 199982]]}, {"verse": 22, "start": 200792, "end": 208689, "text": "Y enviando a Macedonia a dos de los que le ayudaban, Timoteo y Erasto, él se estuvo por algún tiempo en Asia.", "words": [[0, 200792], [2, 200938], [11, 201458], [13, 201578], [23, 202258], [25, 202518], [29, 202738], [32, 203018], [36, 203138], [40, 203278], [43, 203398], [53, 204318], [61, 205078], [63, 205298], [71, 206398], [74, 206558], [77, 206738], [84, 207138], [88, 207358], [94, 207638], [101, 207978], [104, 208178]]}, {"verse": 23, "start": 209139, "end": 213781, "text": "Entonces hubo un alboroto no pequeño acerca del Camino.", "words": [[0, 209139], [9, 209617], [14, 210417], [17, 210537], [26, 211157], [29, 211497], [37, 212057], [44, 212417], [48, 212837]]}, {"verse": 24, "start": 214231, "end": 223087, "text": "Porque un platero llamado Demetrio, el cual hacía de plata templecillos de Diana, daba a los artífices no poca ganancia;", "words": [[0, 214231], [7, 214413], [10, 214593], [18, 215053], [26, 215233], [36, 216253], [39, 216253], [44, 216473], [50, 217073], [53, 217273], [59, 217973], [72, 218673], [75, 218893], [82, 219713], [87, 219973], [89, 220073], [93, 220193], [103, 221033], [106, 221613], [111, 222213]]}, {"verse": 25, "start": 223537, "end": 231361, "text": "A los cuales, reunidos con los trabajadores de oficio semejante, dijo: Varones, sabéis que de este oficio tenemos ganancia;", "words": [[0, 223537], [2, 223624], [6, 223744], [14, 224444], [23, 225204], [27, 225364], [31, 225524], [44, 226204], [47, 226724], [54, 227244], [65, 227764], [71, 228725], [80, 228895], [87, 229335], [91, 229515], [94, 229675], [99, 229855], [106, 230275], [114, 230595]]}, {"verse": 26, "start": 231811, "end": 241133, "text": "Y veis y oís que este Pablo, no solo en Éfeso, sino en casi toda Asia ha apartado con persuasión a muchas gentes, diciendo, que no son dioses los que se hacen con las manos.", "words": [[0, 231811], [2, 231935], [7, 232255], [9, 232355], [13, 232575], [17, 232715], [22, 232875], [29, 233455], [32, 233555], [37, 233835], [40, 234015], [47, 234455], [52, 234555], [55, 234695], [60, 234855], [65, 235155], [70, 235775], [73, 235775], [82, 236175], [86, 236295], [97, 236915], [99, 236995], [106, 237155], [114, 237655], [124, 238703], [128, 238783], [131, 238903], [135, 239103], [142, 239483], [146, 239703], [150, 239863], [153, 240003], [159, 240243], [163, 240423], [167, 240603]]}, {"verse": 27, "start": 241583, "end": 255443, "text": "Y no solamente hay peligro de que este negocio se nos vuelva en reproche, sino también que el templo de la gran diosa Diana sea estimado en nada, y comience a ser destruida su majestad, la cual honra toda el Asia y el mundo.", "words": [[0, 241583], [2, 241706], [5, 241786], [15, 242166], [19, 242426], [27, 242886], [30, 242986], [34, 243106], [39, 243326], [47, 243766], [50, 243886], [54, 244006], [61, 244366], [64, 244466], [74, 245486], [79, 245666], [87, 246026], [91, 246246], [94, 246346], [101, 246786], [104, 246846], [107, 247126], [112, 247406], [118, 247686], [124, 247966], [128, 248566], [137, 249206], [140, 249326], [146, 250019], [148, 250110], [157, 250570], [159, 250790], [163, 250950], [173, 251610], [176, 251790], [186, 252870], [189, 253090], [194, 253310], [200, 253830], [205, 254090], [208, 254350], [213, 254650], [215, 254870], [218, 254990]]}, {"verse": 28, "start": 255793, "end": 264257, "text": "Oídas estas cosas, se llenaron de ira, y dieron alarido, diciendo: ¡Grande es Diana de los efesios!", "words": [[0, 255793], [6, 256377], [12, 256597], [19, 257537], [22, 257897], [31, 258417], [34, 258657], [39, 259097], [41, 259517], [48, 260297], [57, 261077], [67, 262236], [75, 262561], [78, 262861], [84, 263181], [87, 263361], [91, 263836]]}, {"verse": 29, "start": 264607, "end": 275027, "text": "Y la ciudad se llenó de confusión; y unánimes se arrojaron al teatro, arrebatando a Gayo y a Aristarco, macedonios, compañeros de Pablo.", "words": [[0, 264607], [2, 264730], [5, 264830], [12, 265190], [15, 265690], [21, 266090], [24, 266170], [35, 267330], [37, 267719], [46, 268139], [49, 268619], [59, 269399], [62, 269559], [70, 270439], [82, 271199], [84, 271469], [89, 271739], [91, 271859], [93, 271939], [104, 272959], [116, 273899], [127, 274419], [130, 274539]]}, {"verse": 30, "start": 275477, "end": 280138, "text": "Y queriendo Pablo salir al pueblo, los discípulos no le dejaron.", "words": [[0, 275477], [2, 275677], [12, 276097], [18, 276517], [24, 276857], [27, 277677], [35, 278077], [39, 278597], [50, 279277], [53, 279377], [56, 279497]]}, {"verse": 31, "start": 280588, "end": 287974, "text": "También algunos de los principales de Asia, que eran sus amigos, enviaron a él rogando que no se presentase en el teatro.", "words": [[0, 280588], [8, 280896], [16, 281356], [19, 281516], [23, 281636], [35, 282276], [38, 282456], [44, 282736], [48, 283016], [53, 283216], [57, 283396], [65, 283856], [74, 284836], [76, 285016], [79, 285196], [87, 285936], [91, 286136], [94, 286276], [97, 286396], [108, 287036], [111, 287216], [114, 287336]]}, {"verse": 32, "start": 288424, "end": 296629, "text": "Y otros gritaban otra cosa; porque la asamblea estaba confusa, y los más no sabían por qué se habían reunido.", "words": [[0, 288424], [2, 288610], [8, 288850], [17, 289610], [22, 289830], [28, 290710], [35, 290994], [38, 291234], [47, 291894], [54, 292134], [63, 292934], [65, 293634], [69, 293794], [73, 294094], [76, 294654], [83, 295074], [87, 295294], [91, 295454], [94, 295594], [101, 295834]]}, {"verse": 33, "start": 297079, "end": 309038, "text": "Y sacaron de entre la multitud a Alejandro, empujándole los judíos. Entonces Alejandro, habiendo hecho señal de silencio con la mano, quería dar razón al pueblo.", "words": [[0, 297079], [2, 297187], [10, 297687], [13, 297947], [19, 298247], [22, 298467], [31, 299047], [33, 299327], [44, 300447], [56, 301427], [60, 301607], [68, 302698], [77, 303733], [88, 304803], [97, 305183], [103, 305383], [109, 305863], [112, 305963], [121, 306523], [125, 306703], [128, 306843], [134, 307243], [141, 307423], [145, 307723], [151, 308123], [154, 308323]]}, {"verse": 34, "start": 309488, "end": 318229, "text": "Pero como conocieron que era judío, se oyó una sola voz de todos, que gritaron casi por dos horas: ¡Grande es Diana de los efesios!", "words": [[0, 309488], [5, 309668], [10, 309908], [21, 310508], [25, 310708], [29, 310828], [36, 311708], [39, 311848], [43, 312168], [47, 312348], [52, 312648], [56, 312908], [59, 313068], [66, 313708], [70, 313948], [79, 314488], [84, 314788], [88, 315108], [92, 315288], [99, 316208], [107, 316533], [110, 316833], [116, 317153], [119, 317333], [123, 317808]]}, {"verse": 35, "start": 318579, "end": 333853, "text": "Entonces el secretario de la ciudad, apaciguado que hubo la gente, dijo: Varones efesios, ¿y quién hay de los hombres que no sepa que la ciudad de los efesios es honradora de la gran diosa Diana, y de la imagen venida de Júpiter?", "words": [[0, 318579], [9, 319621], [12, 319901], [23, 320681], [26, 320801], [29, 320941], [37, 321921], [48, 322761], [52, 322981], [57, 323394], [60, 323808], [67, 324221], [73, 325478], [81, 325952], [90, 326425], [93, 326505], [99, 326645], [103, 326825], [106, 326905], [110, 327065], [118, 327325], [122, 327545], [125, 327665], [130, 328005], [134, 328125], [137, 328245], [144, 328505], [147, 328745], [151, 329095], [159, 329445], [162, 329745], [172, 330485], [175, 330625], [178, 330825], [183, 331025], [189, 331225], [196, 332127], [198, 332228], [201, 332308], [204, 332408], [211, 332728], [218, 333128], [221, 333248]]}, {"verse": 36, "start": 334303, "end": 340710, "text": "Así que, pues esto no puede ser contradicho, conviene que os apacigüéis, y que nada hagáis precipitadamente;", "words": [[0, 334303], [4, 334544], [9, 334744], [14, 334984], [19, 335424], [22, 335624], [28, 335844], [32, 336084], [45, 336964], [54, 337384], [58, 337544], [61, 338024], [73, 338504], [75, 338664], [79, 338784], [84, 339044], [91, 339524]]}, {"verse": 37, "start": 341160, "end": 345801, "text": "Pues habéis traído a estos hombres, sin ser sacrílegos ni blasfemadores de vuestra diosa.", "words": [[0, 341160], [5, 341261], [12, 341561], [19, 341901], [21, 342001], [27, 342182], [36, 342621], [40, 343061], [44, 343321], [55, 344042], [58, 344161], [72, 344862], [75, 345081], [83, 345381]]}, {"verse": 38, "start": 346251, "end": 355474, "text": "Que si Demetrio y los trabajadores que están con él tienen una acusación contra alguno, los tribunales están abiertos, y procónsules hay; acúsense los unos a los otros.", "words": [[0, 346251], [4, 346327], [7, 346447], [16, 346967], [18, 347047], [22, 347147], [35, 347747], [39, 347947], [45, 348167], [49, 348387], [52, 348527], [59, 348767], [63, 349067], [73, 349627], [80, 349927], [88, 350687], [92, 350787], [103, 351247], [109, 351547], [119, 352167], [121, 352307], [133, 352847], [138, 353559], [147, 354060], [151, 354280], [156, 354500], [158, 354800], [162, 354940]]}, {"verse": 39, "start": 355924, "end": 360030, "text": "Y si pedís alguna otra cosa, en legítima asamblea se pueda decidir.", "words": [[0, 355924], [2, 356013], [5, 356113], [11, 356513], [18, 356793], [23, 357033], [29, 357413], [32, 357713], [41, 358273], [50, 358893], [53, 359113], [59, 359373]]}, {"verse": 40, "start": 360480, "end": 373750, "text": "Porque peligro hay de que seamos acusados de causar disturbios por hoy, no habiendo ninguna causa por la cual podamos dar razón de esta reunión. Y habiendo dicho esto, despidió la asamblea.", "words": [[0, 360480], [7, 360680], [15, 361160], [19, 361300], [22, 361440], [26, 361520], [33, 361860], [42, 362440], [45, 362580], [52, 363020], [63, 363560], [67, 363800], [72, 364380], [75, 364540], [84, 364840], [92, 365180], [98, 365560], [102, 365820], [105, 365960], [110, 366100], [118, 366600], [122, 366800], [128, 367160], [131, 367380], [136, 367560], [145, 369630], [147, 369772], [156, 370132], [162, 370472], [168, 371572], [177, 372612], [180, 372832]]}]}