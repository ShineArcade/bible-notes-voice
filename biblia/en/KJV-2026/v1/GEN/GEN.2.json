{"book": "GEN", "chapter": 2, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 183659, "verses": [{"verse": 1, "start": 300, "end": 4188, "text": "Thus the heavens and the earth were finished, and all the host of them.", "words": [[0, 300], [5, 537], [9, 817], [17, 1117], [21, 1457], [25, 1617], [31, 1857], [36, 2057], [46, 2897], [50, 3017], [54, 3297], [58, 3477], [63, 3677], [66, 3877]]}, {"verse": 2, "start": 4538, "end": 11842, "text": "And on the seventh day God ended his work which he had made; and he rested on the seventh day from all his work which he had made.", "words": [[0, 4538], [4, 4679], [7, 4859], [11, 4999], [19, 5319], [23, 5779], [27, 6019], [33, 6439], [37, 6659], [42, 6939], [48, 7179], [51, 7319], [55, 7499], [61, 8227], [65, 8355], [68, 8475], [75, 8795], [78, 9035], [82, 9175], [90, 9515], [94, 9915], [99, 10175], [103, 10415], [107, 10635], [112, 10895], [118, 11115], [121, 11275], [125, 11395]]}, {"verse": 3, "start": 12192, "end": 19302, "text": "And God blessed the seventh day, and sanctified it: because that in it he had rested from all his work which God created and made.", "words": [[0, 12192], [4, 12337], [8, 12617], [16, 12937], [20, 13237], [28, 13537], [33, 13917], [37, 14177], [48, 14757], [52, 15360], [60, 15515], [65, 15775], [68, 15975], [71, 16095], [74, 16255], [78, 16375], [85, 16695], [90, 16975], [94, 17175], [98, 17395], [103, 17655], [109, 17875], [113, 18155], [121, 18675], [125, 18875]]}, {"verse": 4, "start": 19652, "end": 27757, "text": "¶ These are the generations of the heavens and of the earth when they were created, in the day that the LORD God made the earth and the heavens,", "words": [[2, 19652], [8, 19868], [12, 20088], [16, 20208], [28, 20808], [31, 21148], [35, 21308], [43, 21608], [47, 22008], [50, 22188], [54, 22348], [60, 22608], [65, 22868], [70, 23068], [75, 23188], [84, 24168], [87, 24488], [91, 24608], [95, 24848], [100, 25028], [104, 25188], [109, 25448], [113, 257