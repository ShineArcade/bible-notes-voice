{"book": "JHN", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 212926, "verses": [{"verse": 1, "start": 300, "end": 3950, "text": "Yo soy la vid verdadera, y mi Padre es el labrador.", "words": [[0, 300], [3, 486], [7, 726], [10, 926], [14, 1126], [25, 1846], [27, 2166], [30, 2306], [36, 2646], [39, 3006], [42, 3186]]}, {"verse": 2, "start": 4300, "end": 14191, "text": "Toda rama que en mí no lleva fruto, la quitará: y toda aquella que lleva fruto, la limpiará mediante la poda, para que lleve más fruto.", "words": [[0, 4300], [5, 4565], [10, 4965], [14, 5160], [17, 5355], [20, 5550], [23, 5745], [29, 5945], [36, 6525], [39, 7105], [48, 8094], [50, 8258], [55, 8458], [63, 8958], [67, 9078], [73, 9358], [80, 10258], [83, 10598], [92, 11218], [101, 11658], [104, 11838], [110, 12298], [115, 12558], [119, 12718], [125, 13098], [129, 13338]]}, {"verse": 3, "start": 14191, "end": 18079, "text": "Ya vosotros sois limpios por la palabra que os he hablado.", "words": [[0, 14191], [3, 14511], [12, 15071], [17, 15531], [25, 16251], [29, 16471], [32, 16631], [40, 17011], [44, 17251], [47, 17411], [50, 17551]]}, {"verse": 4, "start": 18429, "end": 28988, "text": "Estad en mí, y yo en vosotros. Como la rama no puede llevar fruto de sí misma, si no está en la vid; así ni vosotros, si no permanecéis en mí.", "words": [[0, 18429], [6, 18812], [9, 18992], [13, 19232], [15, 19632], [18, 19872], [21, 20172], [31, 21232], [36, 21378], [39, 21558], [44, 21938], [47, 22138], [53, 22398], [60, 22758], [66, 23278], [69, 23438], [72, 23618], [79, 24058], [82, 24638], [85, 24778], [90, 24998], [93, 25138], [96, 25465], [101, 25941], [105, 26126], [108, 26306], [118, 27206], [121, 27366], [124, 27486], [136, 28366], [139, 28486]]}, {"verse": 5, "start": 29338, "end": 38588, "text": "Yo soy la vid, vosotros las ramas: el que está en mí, y yo en él, este lleva mucho fruto; porque sin mí nada podéis hacer.", "words": [[0, 29338], [3, 29506], [7, 29826], [10, 30146], [15, 30466], [24, 31046], [28, 31146], [35, 32081], [38, 32226], [42, 32366], [47, 32586], [50, 32806], [54, 33466], [56, 33686], [59, 33866], [62, 34006], [66, 34566], [71, 34826], [77, 35126], [83, 35466], [90, 36352], [97, 36577], [101, 36837], [104, 37137], [109, 37477], [116, 37897]]}, {"verse": 6, "start": 38938, "end": 46969, "text": "El que en mí no esté, será echado fuera como rama mala, y se secará; y las recogen, y las echan en el fuego, y arden.", "words": [[0, 38938], [3, 39278], [7, 39458], [10, 39598], [13, 39738], [16, 39878], [22, 40118], [27, 40558], [34, 40998], [40, 41298], [45, 41618], [50, 41998], [56, 42318], [58, 42658], [61, 42778], [69, 43720], [71, 43864], [75, 44024], [84, 44664], [86, 44964], [90, 45144], [96, 45484], [99, 45684], [102, 45824], [109, 46164], [111, 46567]]}, {"verse": 7, "start": 47319, "end": 54415, "text": "Si estáis en mí, y mis palabras están en vosotros, pedid todo lo que queráis, y os será hecho.", "words": [[0, 47319], [3, 47464], [10, 47924], [13, 48124], [17, 48364], [19, 48784], [23, 48944], [32, 49404], [38, 49784], [41, 50004], [51, 50864], [57, 51424], [62, 51884], [65, 52164], [69, 52324], [78, 52864], [80, 53264], [83, 53404], [88, 53804]]}, {"verse": 8, "start": 54765, "end": 62192, "text": "En esto es glorificado mi Padre, en que llevéis mucho fruto, y seáis así mis discípulos.", "words": [[0, 54765], [3, 54928], [8, 55188], [11, 55488], [23, 56308], [26, 56468], [33, 57248], [36, 57428], [40, 57568], [48, 58108], [54, 58748], [61, 59388], [63, 59848], [69, 60348], [73, 60728], [77, 61108]]}, {"verse": 9, "start": 62542, "end": 67320, "text": "Como el Padre me amó, también yo os he amado: estad en mi amor.", "words": [[0, 62542], [5, 62725], [8, 62865], [14, 63365], [17, 63525], [22, 64085], [30, 64285], [33, 64705], [36, 65005], [39, 65285], [46, 66203], [52, 66610], [55, 66750], [58, 66890]]}, {"verse": 10, "start": 67670, "end": 77561, "text": "Si guardáis mis mandamientos, estaréis en mi amor; como yo también he guardado los mandamientos de mi Padre, y estoy en su amor.", "words": [[0, 67670], [3, 67833], [12, 68453], [16, 68793], [30, 69693], [39, 70518], [42, 70818], [45, 71018], [51, 71723], [56, 72014], [59, 72194], [67, 72534], [70, 72894], [79, 73434], [83, 73574], [96, 74314], [99, 74494], [102, 74634], [109, 74994], [111, 75514], [117, 75954], [120, 76554], [123, 76814]]}, {"verse": 11, "start": 77911, "end": 83911, "text": "Estas cosas os he hablado, para que mi gozo esté en vosotros, y vuestro gozo sea cumplido.", "words": [[0, 77911], [6, 78246], [12, 78526], [15, 78766], [18, 78946], [27, 79426], [32, 79626], [36, 79766], [39, 79966], [44, 80266], [49, 80486], [52, 80666], [62, 81306], [64, 81731], [72, 82091], [77, 82461], [81, 82831]]}, {"verse": 12, "start": 84261, "end": 90489, "text": "Este es mi mandamiento: Que os améis los unos a los otros, como yo os he amado.", "words": [[0, 84325], [5, 84425], [8, 84685], [11, 85005], [24, 86155], [28, 86238], [31, 86399], [37, 86779], [41, 87179], [46, 87679], [48, 87998], [52, 88158], [59, 88878], [64, 89078], [67, 89358], [70, 89658], [73, 89818]]}, {"verse": 13, "start": 90839, "end": 95334, "text": "Nadie tiene mayor amor que este, que ponga alguno su vida por sus amigos.", "words": [[0, 90839], [6, 91225], [12, 91525], [18, 91865], [23, 92205], [27, 92445], [33, 92725], [37, 92905], [43, 93365], [50, 93785], [53, 93905], [58, 94145], [62, 94385], [66, 94605]]}, {"verse": 14, "start": 95684, "end": 100406, "text": "Vosotros sois mis amigos, si hacéis lo que yo os mando.", "words": [[0, 95684], [9, 96205], [14, 96830], [18, 97050], [26, 97950], [29, 98210], [36, 98870], [39, 99150], [43, 99290], [46, 99530], [49, 99810]]}, {"verse": 15, "start": 100756, "end": 112886, "text": "Ya no os llamaré siervos, porque el siervo no sabe lo que hace su señor: pero os he llamado amigos, porque todas las cosas que oí de mi Padre, os he dado a conocer.", "words": [[0, 100756], [3, 100975], [6, 101235], [9, 101435], [17, 101855], [26, 102775], [33, 103155], [36, 103355], [43, 103955], [46, 104395], [51, 104855], [54, 105275], [58, 105455], [63, 105735], [66, 105975], [73, 106767], [78, 106929], [81, 107189], [84, 107309], [92, 107629], [100, 108169], [107, 108889], [113, 109149], [117, 109429], [123, 109729], [127, 110029], [130, 110269], [133, 110369], [136, 110509], [143, 110869], [146, 111549], [149, 111829], [154, 112089], [156, 112249]]}, {"verse": 16, "start": 113236, "end": 127932, "text": "No me elegisteis vosotros a mí, sino que yo os elegí a vosotros; y os he puesto para que vayáis y llevéis fruto, y vuestro fruto permanezca: para que todo lo que pidáis del Padre en mi nombre, él os lo dé.", "words": [[0, 113236], [3, 113402], [6, 113562], [17, 114522], [26, 115122], [28, 115302], [32, 115862], [37, 116222], [41, 116442], [44, 116722], [47, 116982], [53, 117582], [55, 117682], [65, 118784], [67, 118869], [70, 118954], [73, 119039], [80, 119419], [85, 119819], [89, 119999], [96, 120599], [98, 120919], [106, 121299], [113, 122319], [115, 122399], [123, 122739], [129, 123079], [141, 124196], [146, 124336], [150, 124476], [155, 124756], [158, 124956], [162, 125096], [169, 125496], [173, 125656], [179, 126116], [182, 126216], [185, 126376], [193, 126776], [196, 127256], [199, 127416], [202, 127596]]}, {"verse": 17, "start": 128282, "end": 131922, "text": "Esto os mando: Que os améis los unos a los otros.", "words": [[0, 128501], [5, 128755], [8, 129009], [15, 129416], [19, 129686], [22, 129846], [28, 130246], [32, 130466], [37, 130786], [39, 131086], [43, 131226]]}, {"verse": 18, "start": 132272, "end": 138273, "text": "Si el mundo os aborrece, sabed que a mí me aborreció antes que a vosotros.", "words": [[0, 132272], [3, 132474], [6, 132654], [12, 133034], [15, 133394], [25, 134634], [31, 135154], [35, 135354], [37, 135514], [40, 135694], [43, 135894], [53, 136674], [59, 137094], [63, 137354], [65, 137494]]}, {"verse": 19, "start": 138623, "end": 149861, "text": "Si fuerais del mundo, el mundo amaría lo suyo; pero porque no sois del mundo, antes yo os elegí del mundo, por eso os aborrece el mundo.", "words": [[0, 138623], [3, 138761], [11, 139181], [15, 139361], [22, 140221], [25, 140361], [31, 140701], [38, 141161], [41, 141341], [47, 142184], [52, 142348], [59, 142708], [62, 142908], [67, 143308], [71, 143468], [78, 144308], [84, 144848], [87, 145328], [90, 145668], [96, 146308], [100, 146428], [107, 147528], [111, 147748], [115, 147968], [118, 148328], [127, 149028], [130, 149268]]}, {"verse": 20, "start": 150211, "end": 162636, "text": "Acordaos de la palabra que yo os he dicho: No es el siervo mayor que su señor. Si a mí me han perseguido, también a vosotros perseguirán: si han guardado mi palabra, también guardarán la vuestra.", "words": [[0, 150211], [9, 150902], [12, 151042], [15, 151162], [23, 151562], [27, 151802], [30, 152082], [33, 152262], [36, 152362], [43, 153150], [46, 153316], [49, 153496], [52, 153636], [59, 154096], [65, 154376], [69, 154636], [72, 154796], [79, 155683], [82, 155859], [84, 155999], [87, 156159], [90, 156319], [94, 156499], [106, 157259], [114, 157559], [116, 157839], [125, 158319], [138, 159584], [141, 159730], [145, 159850], [154, 160330], [157, 160490], [166, 161070], [174, 161250], [184, 161930], [187, 162050]]}, {"verse": 21, "start": 162986, "end": 169016, "text": "Mas todo esto os harán por causa de mi nombre, porque no conocen al que me ha enviado.", "words": [[0, 162986], [4, 163212], [9, 163432], [14, 163852], [17, 164232], [23, 164632], [27, 164832], [33, 165172], [36, 165452], [39, 165552], [47, 166172], [54, 166612], [57, 166872], [65, 167532], [68, 167732], [72, 167932], [75, 168112], [78, 168232]]}, {"verse": 22, "start": 169366, "end": 176480, "text": "Si no hubiera venido, ni les hubiera hablado, no tendrían pecado, pero ahora no tienen excusa de su pecado.", "words": [[0, 169366], [3, 169530], [6, 169690], [14, 170050], [22, 170570], [25, 170890], [29, 171150], [37, 171570], [46, 172570], [49, 172750], [58, 173230], [66, 173910], [71, 174070], [77, 174470], [80, 174730], [87, 174990], [94, 175710], [97, 175830], [100, 175970]]}, {"verse": 23, "start": 176830, "end": 180186, "text": "El que me aborrece, también a mi Padre aborrece.", "words": [[0, 176830], [3, 177161], [7, 177301], [10, 177441], [20, 178541], [28, 178701], [30, 178921], [33, 179001], [39, 179401]]}, {"verse": 24, "start": 180536, "end": 192052, "text": "Si no hubiese hecho entre ellos obras cuales ningún otro ha hecho, no tendrían pecado; pero ahora, y las han visto, y me aborrecen a mí y a mi Padre.", "words": [[0, 180536], [3, 180859], [6, 181019], [14, 181359], [20, 181679], [26, 181919], [32, 182259], [38, 182699], [45, 183019], [52, 183779], [57, 184359], [60, 184719], [67, 185679], [70, 185899], [79, 186419], [87, 187377], [92, 187801], [99, 188501], [101, 188621], [105, 188741], [109, 188921], [116, 189781], [118, 189861], [121, 189981], [131, 190621], [133, 190781], [136, 190921], [138, 191301], [140, 191381], [143, 191481]]}, {"verse": 25, "start": 192402, "end": 198230, "text": "Pero para que se cumpla la palabra que está escrita en su ley: Que sin causa me aborrecieron.", "words": [[0, 192402], [5, 192567], [10, 192847], [14, 192987], [17, 193127], [24, 193687], [27, 193847], [35, 194287], [39, 194507], [44, 194727], [52, 195267], [55, 195387], [58, 195547], [63, 196336], [67, 196420], [71, 196620], [77, 197100], [80, 197380]]}, {"verse": 26, "start": 198580, "end": 207518, "text": "Pero cuando venga el Consolador, el cual yo os enviaré del Padre, el Espíritu de verdad, el cual procede del Padre, él dará testimonio de mí.", "words": [[0, 198580], [5, 198722], [12, 198982], [18, 199362], [21, 199482], [33, 200622], [36, 200742], [41, 200922], [44, 201202], [47, 201382], [55, 201882], [59, 201982], [66, 202862], [69, 202922], [78, 203442], [81, 203562], [89, 204322], [92, 204462], [97, 204662], [105, 205282], [109, 205422], [116, 206162], [119, 206182], [124, 206502], [135, 207102], [138, 207222]]}, {"verse": 27, "start": 207868, "end": 212526, "text": "Y vosotros daréis testimonio, porque estáis conmigo desde el principio.", "words": [[0, 207868], [2, 207989], [11, 208589], [18, 208949], [30, 209809], [37, 210029], [44, 210489], [52, 211049], [58, 211289], [61, 211529]]}]}