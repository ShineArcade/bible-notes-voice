{"book": "PSA", "chapter": 88, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 121130, "verses": [{"verse": 1, "start": 300, "end": 14602, "text": "Canción: Salmo para los hijos de Coré: al Músico principal: para cantar sobre Mahalat: Masquil de Hemán ezraíta. OH Jehová, Dios de mi salvación, día y noche clamo delante de ti.", "words": [[0, 300], [9, 1544], [15, 2065], [20, 2285], [24, 2505], [30, 2765], [33, 2985], [39, 3743], [42, 3907], [49, 4347], [60, 5486], [65, 5651], [72, 6251], [78, 6511], [87, 7991], [95, 8455], [98, 8920], [104, 9384], [113, 10419], [116, 10725], [124, 11032], [129, 11212], [132, 11392], [135, 11492], [146, 12572], [150, 12732], [152, 12952], [158, 13212], [164, 13692], [172, 14112], [175, 14312]]}, {"verse": 2, "start": 15052, "end": 19987, "text": "Entre mi oración en tu presencia: inclina tu oído a mi clamor.", "words": [[0, 15052], [6, 15349], [9, 15609], [17, 16069], [20, 16289], [23, 16409], [34, 18059], [42, 18439], [45, 18679], [50, 19099], [52, 19279], [55, 19399]]}, {"verse": 3, "start": 20437, "end": 25503, "text": "Porque mi alma está harta de males, y mi vida cercana al sepulcro.", "words": [[0, 20437], [7, 20600], [10, 20840], [15, 21140], [20, 21460], [26, 21940], [29, 22140], [36, 22560], [38, 23300], [41, 23460], [46, 23740], [54, 24360], [57, 24560]]}, {"verse": 4, "start": 25953, "end": 31085, "text": "Soy contado con los que descienden al hoyo, soy como hombre sin fuerza:", "words": [[0, 25953], [4, 26198], [12, 26918], [16, 27158], [20, 27318], [24, 27458], [35, 28038], [38, 28278], [44, 29078], [48, 29478], [53, 29798], [60, 30138], [64, 30378]]}, {"verse": 5, "start": 31535, "end": 40609, "text": "Libre entre los muertos, como los matados que yacen en el sepulcro, que no te acuerdas más de ellos, y que son cortados de tu mano.", "words": [[0, 31535], [6, 31979], [12, 32359], [16, 32559], [25, 33539], [30, 33859], [34, 34019], [42, 34599], [46, 34799], [52, 35299], [55, 35439], [58, 35579], [68, 36679], [72, 36779], [75, 36919], [78, 37039], [87, 37459], [91, 37619], [94, 37819], [101, 38119], [103, 38739], [107, 38859], [111, 39039], [120, 39759], [123, 39919], [126, 40059]]}, {"verse": 6, "start": 41059, "end": 44827, "text": "Me has puesto en el hoyo profundo, en tinieblas, en honduras.", "words": [[0, 41059], [3, 41205], [7, 41345], [14, 41605], [17, 41905], [20, 42025], [25, 42325], [35, 42925], [38, 43105], [49, 43805], [52, 43965]]}, {"verse": 7, "start": 45277, "end": 52126, "text": "Sobre mí se ha acostado tu ira, y me has afligido con todas tus ondas. (Selah.)", "words": [[0, 45277], [6, 45617], [9, 45817], [12, 46017], [15, 46177], [24, 46717], [27, 46937], [32, 47697], [34, 47897], [37, 48017], [41, 48197], [50, 48797], [54, 49017], [60, 49297], [64, 49517], [71, 51872]]}, {"verse": 8, "start": 52576, "end": 59276, "text": "Has alejado de mí mis conocidos: me has puesto por abominación a ellos: encerrado estoy, y no puedo salir.", "words": [[0, 52576], [4, 52576], [12, 52576], [15, 52576], [18, 52576], [22, 52576], [33, 53714], [36, 53898], [40, 54058], [47, 54478], [51, 54898], [63, 55738], [65, 55958], [72, 56823], [82, 57430], [89, 57730], [91, 58270], [94, 58390], [100, 58650]]}, {"verse": 9, "start": 59726, "end": 67770, "text": "Mis ojos enfermaron a causa de mi aflicción: te he llamado, oh Jehová, cada día; he extendido a ti mis manos.", "words": [[0, 59726], [4, 59906], [9, 60186], [20, 61106], [22, 61166], [28, 61466], [31, 61686], [34, 61806], [45, 62923], [48, 63067], [51, 63147], [60, 63514], [63, 63880], [71, 64247], [76, 64467], [81, 65399], [84, 65740], [94, 66680], [96, 66860], [99, 66960], [103, 67120]]}, {"verse": 10, "start": 68220, "end": 73909, "text": "¿Harás tú milagro a los muertos? ¿se levantarán los muertos para alabarte? (Selah.)", "words": [[0, 68220], [7, 68567], [10, 68767], [18, 69327], [20, 69407], [24, 69507], [33, 70527], [37, 70670], [48, 71390], [52, 71490], [60, 71930], [65, 72520], [75, 73654]]}, {"verse": 11, "start": 74359, "end": 79156, "text": "¿Será contada en el sepulcro tu misericordia, o tu verdad en la perdición?", "words": [[0, 74359], [6, 74564], [14, 75184], [17, 75324], [20, 75444], [29, 76144], [32, 76204], [46, 77184], [48, 77404], [51, 77524], [58, 77824], [61, 78084], [64, 78224]]}, {"verse": 12, "start": 79606, "end": 85153, "text": "¿Será conocida en las tinieblas tu maravilla, ni tu justicia en la tierra del olvido?", "words": [[0, 79606], [6, 79928], [15, 80508], [18, 80628], [22, 80788], [32, 81428], [35, 81548], [46, 82388], [49, 82708], [52, 82868], [61, 83568], [64, 83728], [67, 83848], [74, 84228], [78, 84488]]}, {"verse": 13, "start": 85603, "end": 91101, "text": "Mas yo a ti he clamado, oh Jehová; y de mañana mi oración llegó antes a ti.", "words": [[0, 85763], [4, 85943], [7, 86123], [9, 86363], [12, 86523], [15, 86969], [24, 87415], [27, 87861], [35, 88543], [37, 88660], [40, 88780], [47, 89100], [50, 89380], [58, 89800], [64, 90120], [70, 90460], [72, 90760]]}, {"verse": 14, "start": 91551, "end": 96770, "text": "¿Por qué, oh Jehová, desechas mi alma? ¿por qué escondes de mí tu rostro?", "words": [[0, 91551], [5, 91654], [10, 92174], [13, 92694], [21, 93214], [30, 93734], [33, 93974], [39, 95040], [44, 95164], [48, 95344], [57, 95904], [60, 96044], [63, 96204], [66, 96364]]}, {"verse": 15, "start": 97220, "end": 104661, "text": "Yo soy afligido y necesitado: desde la juventud he llevado tus terrores, he estado temeroso.", "words": [[0, 97220], [3, 97985], [7, 98205], [16, 98905], [18, 99005], [30, 100367], [36, 100534], [39, 100734], [48, 101434], [51, 101634], [59, 102074], [63, 102254], [73, 103314], [76, 103414], [83, 103754]]}, {"verse": 16, "start": 105111, "end": 109469, "text": "Sobre mí han pasado tus iras; tus espantos me han cortado.", "words": [[0, 105111], [6, 105369], [9, 105689], [13, 105969], [20, 106389], [24, 106649], [30, 107624], [34, 107747], [43, 108367], [46, 108527], [50, 108627]]}, {"verse": 17, "start": 109919, "end": 114308, "text": "Me han rodeado como aguas de continuo; me han cercado a una.", "words": [[0, 109919], [3, 110066], [7, 110206], [15, 110786], [20, 111189], [26, 111593], [29, 111996], [39, 112645], [42, 112885], [46, 112965], [54, 113545], [56, 113765]]}, {"verse": 18, "start": 114758, "end": 120730, "text": "Has alejado de mí el amigo y el compañero; y mis conocidos se esconden en la tiniebla.", "words": [[0, 114859], [4, 114989], [12, 115449], [15, 115609], [18, 115829], [21, 116089], [27, 116449], [29, 116669], [32, 116809], [43, 117952], [45, 118049], [49, 118189], [59, 118909], [62, 119129], [71, 119689], [74, 119889], [77, 120332]]}]}