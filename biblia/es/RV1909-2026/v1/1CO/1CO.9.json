{"book": "1CO", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 202900, "verses": [{"verse": 1, "start": 300, "end": 6853, "text": "¿No soy apóstol? ¿no soy libre? ¿no he visto a Jesús el Señor nuestro? ¿no sois vosotros mi obra en el Señor?", "words": [[0, 300], [4, 444], [8, 644], [17, 1620], [21, 1764], [25, 1964], [32, 2776], [36, 2915], [39, 2955], [45, 3195], [47, 3335], [53, 3495], [56, 3735], [62, 3975], [71, 4949], [75, 5087], [80, 5327], [89, 5707], [92, 5927], [97, 6107], [100, 6247], [103, 6347]]}, {"verse": 2, "start": 7303, "end": 15387, "text": "Si a los otros no soy apóstol, a vosotros ciertamente lo soy: porque el sello de mi apostolado sois vosotros en el Señor.", "words": [[0, 7303], [3, 7441], [5, 7521], [9, 7621], [15, 7841], [18, 8061], [22, 8241], [31, 9041], [33, 9121], [42, 9561], [54, 9961], [57, 10361], [62, 12371], [69, 12551], [72, 12711], [78, 12951], [81, 13071], [84, 13191], [95, 13831], [100, 14131], [109, 14571], [112, 14771], [115, 14891]]}, {"verse": 3, "start": 15837, "end": 18328, "text": "Esta es mi respuesta a los que me preguntan.", "words": [[0, 15837], [5, 16096], [8, 16236], [11, 16356], [21, 16896], [23, 17276], [27, 17396], [31, 17536], [34, 17656]]}, {"verse": 4, "start": 18778, "end": 21072, "text": "Qué, ¿no tenemos derecho a comer y a beber?", "words": [[0, 18778], [5, 18836], [9, 18956], [17, 19296], [25, 19636], [27, 19876], [33, 20156], [35, 20556], [37, 20636]]}, {"verse": 5, "start": 21522, "end": 29056, "text": "¿No tenemos derecho a traer con nosotros una esposa creyente también como los otros apóstoles, y los hermanos del Señor, y Cefas?", "words": [[0, 21522], [4, 21701], [12, 22021], [20, 22361], [22, 22621], [28, 22902], [32, 23001], [41, 23441], [45, 23722], [52, 24101], [61, 24641], [69, 24941], [74, 25261], [78, 25441], [84, 25701], [95, 26362], [97, 26821], [101, 26961], [110, 27422], [114, 27521], [121, 27902], [123, 28501]]}, {"verse": 6, "start": 29505, "end": 32363, "text": "¿O sólo yo y Bernabé no tenemos derecho a no trabajar?", "words": [[0, 29505], [3, 29610], [8, 29850], [11, 30050], [13, 30150], [21, 30570], [24, 30690], [32, 31030], [40, 31390], [42, 31610], [45, 31690]]}, {"verse": 7, "start": 32813, "end": 40718, "text": "¿Quién jamás peleó a sus expensas? ¿quién planta viña, y no come de su fruto? ¿o quién apacienta el ganado, y no come de la leche del ganado?", "words": [[0, 32813], [7, 33068], [13, 33378], [19, 33688], [21, 33848], [25, 33928], [35, 35160], [42, 35357], [49, 35717], [55, 36017], [57, 36077], [60, 36177], [65, 36377], [68, 36517], [71, 36657], [78, 37485], [81, 37582], [87, 37932], [97, 38282], [100, 38422], [108, 38882], [110, 39142], [113, 39262], [118, 39482], [121, 39622], [124, 39722], [130, 39942], [134, 40102]]}, {"verse": 8, "start": 41168, "end": 44569, "text": "¿Digo esto según los hombres? ¿no dice esto también la ley?", "words": [[0, 41168], [6, 41412], [11, 41692], [17, 42012], [21, 42212], [30, 43142], [34, 43244], [39, 43484], [44, 43764], [52, 44064], [55, 44284]]}, {"verse": 9, "start": 45019, "end": 51794, "text": "Porque en la ley de Moisés está escrito: No pondrás bozal al buey que trilla. ¿Tiene Dios cuidado de los bueyes?", "words": [[0, 45019], [7, 45235], [10, 45375], [13, 45475], [17, 45675], [20, 45795], [27, 46155], [32, 46495], [41, 47394], [44, 47482], [52, 47922], [58, 48362], [61, 48502], [66, 48822], [70, 48922], [78, 49766], [85, 50115], [90, 50489], [98, 50862], [101, 50982], [105, 51412]]}, {"verse": 10, "start": 52244, "end": 62741, "text": "¿O lo dice enteramente por nosotros? Pues por nosotros está escrito; porque con esperanza ha de arar el que ara; y el que trilla, con esperanza de recibir el fruto.", "words": [[0, 52244], [3, 52347], [6, 52427], [11, 52687], [23, 53287], [27, 53567], [37, 54628], [42, 54768], [46, 55008], [55, 55368], [60, 55748], [69, 56667], [76, 56851], [80, 57051], [90, 57751], [93, 57951], [96, 58051], [101, 58371], [104, 58531], [108, 58841], [113, 59418], [115, 59521], [118, 59621], [122, 59741], [130, 60161], [134, 60561], [144, 61101], [147, 61221], [155, 61581], [158, 61761]]}, {"verse": 11, "start": 63191, "end": 68922, "text": "Si nosotros os sembramos lo espiritual, ¿es gran cosa si cosechamos de vuestros bienes materiales?", "words": [[0, 63191], [3, 63332], [12, 63672], [15, 63932], [25, 64412], [28, 64592], [40, 65612], [44, 65912], [49, 66112], [54, 66432], [57, 66672], [68, 67232], [71, 67412], [80, 67752], [87, 68072]]}, {"verse": 12, "start": 69372, "end": 81172, "text": "Si otros tienen en vosotros este derecho, ¿no más bien nosotros? Pero no hemos usado de este derecho: antes lo sufrimos todo, por no poner ningún obstáculo al evangelio de Cristo.", "words": [[0, 69372], [3, 69499], [9, 69739], [16, 70079], [19, 70279], [28, 70679], [33, 70959], [42, 71679], [46, 71779], [50, 71939], [55, 72079], [65, 73081], [70, 73239], [73, 73419], [79, 73599], [85, 74039], [88, 74199], [93, 74339], [102, 76599], [108, 76884], [111, 77104], [120, 77664], [126, 78244], [130, 78504], [133, 78644], [139, 78904], [146, 79224], [156, 79824], [159, 80004], [169, 80544], [172, 80644]]}, {"verse": 13, "start": 81622, "end": 88459, "text": "¿No sabéis que los que trabajan en el santuario, comen del santuario; y que los que sirven al altar, del altar participan?", "words": [[0, 81622], [4, 81739], [11, 82079], [15, 82239], [19, 82339], [23, 82479], [32, 82979], [35, 83059], [38, 83179], [49, 83699], [55, 84359], [59, 84599], [70, 85630], [72, 85716], [76, 85816], [80, 85956], [84, 86136], [91, 86496], [94, 86616], [101, 86976], [105, 87296], [111, 87576]]}, {"verse": 14, "start": 88909, "end": 92902, "text": "Así también ordenó el Señor a los que anuncian el evangelio, que vivan del evangelio.", "words": [[0, 88909], [4, 89089], [12, 89329], [19, 89789], [22, 89869], [28, 90109], [30, 90309], [34, 90449], [38, 90549], [47, 90929], [50, 91009], [61, 91769], [65, 91809], [71, 92089], [75, 92229]]}, {"verse": 15, "start": 93352, "end": 103957, "text": "Pero yo de nada de esto me aproveché: ni tampoco he escrito esto para que se haga así conmigo; porque tengo por mejor morir, antes que nadie haga vana esta mi gloria.", "words": [[0, 93352], [5, 93471], [8, 93651], [11, 93731], [16, 93951], [19, 94131], [24, 94311], [27, 94451], [38, 95410], [41, 95531], [49, 95851], [52, 96131], [60, 96391], [65, 96831], [70, 97131], [74, 97291], [77, 97471], [82, 97671], [86, 97891], [95, 98833], [102, 98996], [108, 99316], [112, 99516], [118, 99796], [125, 100416], [131, 100796], [135, 101036], [141, 101276], [146, 101626], [151, 101976], [156, 102216], [159, 102376]]}, {"verse": 16, "start": 104407, "end": 113011, "text": "Pues bien que anuncio el evangelio, no tengo por qué gloriarme; porque me es impuesta necesidad; y ¡ay de mí si no anuncio el evangelio!", "words": [[0, 104407], [5, 104574], [10, 104834], [14, 105054], [22, 105514], [25, 105654], [36, 106714], [39, 106814], [45, 107154], [49, 107414], [53, 107574], [64, 108583], [71, 108765], [74, 109045], [77, 109325], [86, 109605], [97, 110746], [99, 110875], [103, 111045], [106, 111205], [109, 111365], [112, 111585], [115, 111705], [123, 112145], [126, 112265]]}, {"verse": 17, "start": 113461, "end": 120684, "text": "Por lo cual, si lo hago de voluntad, premio tendré; pero si por fuerza, se me ha encargado esta responsabilidad.", "words": [[0, 113461], [4, 113561], [7, 113661], [13, 113901], [16, 114101], [19, 114281], [24, 114461], [27, 114601], [37, 115201], [44, 115641], [52, 116446], [57, 116584], [60, 116764], [64, 116964], [72, 117384], [75, 117724], [78, 117864], [81, 117984], [91, 118544], [96, 118744]]}, {"verse": 18, "start": 121134, "end": 130058, "text": "¿Cuál, pues, es mi recompensa? Que predicando el evangelio, ponga el evangelio de Cristo gratuitamente, para no usar mal de mi potestad en el evangelio.", "words": [[0, 121134], [7, 121134], [13, 121134], [16, 121292], [19, 121432], [31, 122951], [35, 123044], [46, 123604], [49, 123724], [60, 124804], [66, 125124], [69, 125184], [79, 125724], [82, 125804], [89, 126164], [104, 127104], [109, 127604], [112, 127784], [117, 128004], [121, 128264], [124, 128424], [127, 128524], [136, 129164], [139, 129284], [142, 129384]]}, {"verse": 19, "start": 130508, "end": 135865, "text": "Por lo cual, siendo libre para con todos, me he hecho siervo de todos por ganar a más.", "words": [[0, 130508], [4, 130617], [7, 130757], [13, 131177], [20, 131517], [26, 131917], [31, 132177], [35, 132417], [42, 133237], [45, 133497], [48, 133597], [54, 133777], [61, 134257], [64, 134397], [70, 134677], [74, 135017], [80, 135377], [82, 135437]]}, {"verse": 20, "start": 136315, "end": 148077, "text": "Me he hecho a los judíos como judío, por ganar a los judíos; a los que están sujetos a la ley (aunque yo no sea sujeto a la ley) como sujeto a la ley, por ganar a los que están sujetos a la ley;", "words": [[0, 136315], [3, 136497], [6, 136637], [12, 136857], [14, 136977], [18, 137097], [25, 137617], [30, 137837], [37, 138517], [41, 138797], [47, 139177], [49, 139197], [53, 139377], [61, 140368], [63, 140484], [67, 140564], [71, 140704], [77, 140944], [85, 141504], [87, 141624], [90, 141724], [94, 142284], [102, 142524], [105, 142784], [108, 142904], [112, 143124], [119, 143704], [121, 143784], [124, 143904], [129, 144344], [134, 144524], [141, 145024], [143, 145104], [146, 145184], [151, 145842], [155, 145971], [161, 146391], [163, 146451], [167, 146611], [171, 146731], [177, 146991], [185, 147551], [187, 147671], [190, 147751]]}, {"verse": 21, "start": 148527, "end": 157050, "text": "A los que son sin ley, como si yo fuera sin ley, (no estando yo sin ley de Dios, sino bajo la ley de Cristo) por ganar a los que estaban sin ley.", "words": [[0, 148527], [2, 148625], [6, 148725], [10, 148845], [14, 149065], [18, 149285], [23, 149905], [28, 150105], [31, 150265], [34, 150405], [40, 150685], [44, 150925], [49, 151545], [53, 151665], [61, 152045], [64, 152185], [68, 152405], [72, 152605], [75, 152765], [81, 153539], [86, 153740], [91, 153960], [94, 154160], [98, 154340], [101, 154500], [109, 155240], [113, 155360], [119, 155740], [121, 155800], [125, 155960], [129, 156080], [137, 156380], [141, 156660]]}, {"verse": 22, "start": 157500, "end": 165638, "text": "Me he hecho a los débiles, débil, por ganar a los débiles: a todos me he hecho todo, para que de todo punto salve a algunos.", "words": [[0, 157500], [3, 157680], [6, 157880], [12, 158140], [14, 158260], [18, 158400], [27, 159180], [34, 159880], [38, 159980], [44, 160340], [46, 160380], [50, 160560], [59, 161584], [61, 161784], [67, 162004], [70, 162284], [73, 162404], [79, 162584], [85, 162924], [90, 163424], [94, 163604], [97, 163744], [102, 163944], [108, 164304], [114, 164864], [116, 164904]]}, {"verse": 23, "start": 166088, "end": 170799, "text": "Y esto hago por causa del evangelio, por hacerme juntamente participante de él.", "words": [[0, 166088], [2, 166211], [7, 166471], [12, 166711], [16, 166931], [22, 167171], [26, 167431], [37, 168471], [41, 168571], [49, 168991], [60, 169531], [73, 170311], [76, 170491]]}, {"verse": 24, "start": 171249, "end": 178910, "text": "¿No sabéis que los que corren en el estadio, todos a la verdad corren, pero uno lleva el premio? Corred de tal manera que lo obtengáis.", "words": [[0, 171249], [4, 171387], [11, 171767], [15, 171927], [19, 172067], [23, 172227], [30, 172587], [33, 172687], [36, 172807], [45, 173407], [51, 173867], [53, 174107], [56, 174167], [63, 174387], [71, 174927], [76, 175307], [80, 175507], [86, 175707], [89, 175827], [97, 176612], [104, 176997], [107, 177137], [111, 177377], [118, 177697], [122, 177937], [125, 178097]]}, {"verse": 25, "start": 179360, "end": 187832, "text": "Y todo aquel que lucha, de todo se abstiene: y ellos, a la verdad, para recibir una corona corruptible; pero nosotros, incorruptible.", "words": [[0, 179360], [2, 179484], [7, 179664], [13, 180084], [17, 180184], [24, 180664], [27, 180984], [32, 181184], [35, 181404], [45, 182360], [47, 182502], [54, 182802], [56, 183022], [59, 183082], [67, 183402], [72, 183682], [80, 184102], [84, 184422], [91, 184742], [104, 185932], [109, 186062], [119, 186502]]}, {"verse": 26, "start": 188282, "end": 195053, "text": "Así que, yo de esta manera corro, no como a cosa incierta; de esta manera peleo, no como quien golpea el aire:", "words": [[0, 188282], [4, 188480], [9, 188660], [12, 188880], [15, 189020], [20, 189220], [27, 189500], [34, 190380], [37, 190480], [42, 190700], [44, 190840], [49, 190960], [59, 191994], [62, 192134], [67, 192294], [74, 192614], [81, 193494], [84, 193594], [89, 193814], [95, 194034], [102, 194554], [105, 194674]]}, {"verse": 27, "start": 195503, "end": 202500, "text": "Antes hiero mi cuerpo, y lo pongo en servidumbre; no sea que, habiendo predicado a otros, yo mismo venga a ser reprobado.", "words": [[0, 195503], [6, 195758], [12, 196038], [15, 196178], [23, 196538], [25, 196838], [28, 196938], [34, 197238], [37, 197318], [50, 198335], [53, 198519], [57, 198759], [62, 198959], [71, 199299], [81, 199899], [83, 200019], [90, 200779], [93, 200879], [99, 201159], [105, 201539], [107, 201659], [111, 201799]]}]}