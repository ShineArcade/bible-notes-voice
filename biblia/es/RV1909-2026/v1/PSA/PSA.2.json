{"book": "PSA", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 76255, "verses": [{"verse": 1, "start": 300, "end": 4873, "text": "¿Por qué se amotinan las gentes, y los pueblos piensan cosas vanas?", "words": [[0, 300], [5, 417], [9, 677], [12, 897], [21, 1517], [25, 1677], [33, 2257], [35, 2797], [39, 2937], [47, 3337], [55, 3817], [61, 4057]]}, {"verse": 2, "start": 5323, "end": 13825, "text": "Estarán los reyes de la tierra, y príncipes consultarán unidos contra Jehová, y contra su ungido, diciendo:", "words": [[0, 5323], [8, 5773], [12, 5933], [18, 6353], [21, 6493], [24, 6613], [32, 7573], [34, 7633], [44, 8573], [56, 9453], [63, 9933], [70, 10273], [78, 11073], [80, 11253], [87, 11613], [90, 11893], [98, 12873]]}, {"verse": 3, "start": 14075, "end": 17781, "text": "Rompamos sus ataduras, y echemos de nosotros sus cuerdas.", "words": [[0, 14075], [9, 14554], [13, 14734], [23, 15194], [25, 15374], [33, 15674], [36, 15814], [45, 16094], [49, 16394]]}, {"verse": 4, "start": 18131, "end": 22985, "text": "El que mora en los cielos se reirá; el Señor se burlará de ellos.", "words": [[0, 18131], [3, 18258], [7, 18438], [12, 18798], [15, 18878], [19, 18998], [26, 19558], [29, 20025], [36, 20959], [39, 21199], [45, 21439], [48, 21599], [56, 22179], [59, 22319]]}, {"verse": 5, "start": 23435, "end": 28612, "text": "Entonces hablará a ellos en su furor, y los turbará con su ira.", "words": [[0, 23435], [9, 23998], [17, 24938], [19, 25118], [25, 25398], [28, 25678], [31, 25878], [38, 26478], [40, 26778], [44, 26958], [52, 27618], [56, 27878], [59, 28118]]}, {"verse": 6, "start": 28912, "end": 33442, "text": "Pero yo he puesto mi rey sobre Sion, monte de mi santidad.", "words": [[0, 28912], [5, 29082], [8, 29322], [11, 29462], [18, 29762], [21, 30042], [25, 30462], [31, 30762], [37, 31782], [43, 32182], [46, 32422], [49, 32522]]}, {"verse": 7, "start": 33792, "end": 40751, "text": "Yo publicaré el decreto: Jehová me ha di