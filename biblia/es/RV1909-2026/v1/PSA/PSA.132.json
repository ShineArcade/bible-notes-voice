{"book": "PSA", "chapter": 132, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 95176, "verses": [{"verse": 1, "start": 300, "end": 6004, "text": "Cántico gradual. ACUÉRDATE, oh Jehová, de David, y de toda su aflicción;", "words": [[0, 300], [8, 789], [17, 1779], [28, 2260], [31, 2780], [39, 3360], [42, 3500], [49, 3900], [51, 4360], [54, 4520], [59, 4720], [62, 5060]]}, {"verse": 2, "start": 6354, "end": 9611, "text": "Que juró él a Jehová, prometió al Fuerte de Jacob:", "words": [[0, 6354], [4, 6435], [9, 6915], [12, 7175], [14, 7335], [22, 7815], [31, 8335], [34, 8455], [41, 8835], [44, 9055]]}, {"verse": 3, "start": 9811, "end": 14243, "text": "No entraré en la morada de mi casa, ni subiré sobre el lecho de mi estrado;", "words": [[0, 9811], [3, 9956], [11, 10456], [14, 10536], [17, 10636], [24, 10996], [27, 11136], [30, 11236], [36, 11896], [39, 12216], [46, 12736], [52, 13016], [55, 13256], [61, 13456], [64, 13596], [67, 13716]]}, {"verse": 4, "start": 14593, "end": 17907, "text": "No daré sueño a mis ojos, ni a mis párpados adormecimiento,", "words": [[0, 14593], [3, 14715], [8, 14975], [14, 15335], [16, 15435], [20, 15575], [26, 16015], [29, 16175], [31, 16235], [35, 16355], [44, 17160]]}, {"verse": 5, "start": 18257, "end": 22074, "text": "Hasta que halle lugar para Jehová, moradas para el Fuerte de Jacob.", "words": [[0, 18257], [6, 18499], [10, 18679], [16, 18859], [22, 19099], [27, 19439], [35, 20219], [43, 20719], [48, 20979], [51, 21079], [58, 21339], [61, 21559]]}, {"verse": 6, "start": 22354, "end": 27179, "text": "He aquí, en Efrata oímos de ella: la hallamos en los campos del bosque.", "words": [[0, 22405], [3, 22495], [9, 22795], [12, 22975], [19, 23835], [25, 24215], [28, 24395], [34, 25079], [37, 25246], [46, 25686], [49, 25886], [53, 26026], [60, 26486], [64, 26606]]}, {"verse": 7, "start": 27529, "end": 31903, "text": "Entraremos en sus tiendas; nos postraremos al estrado de sus pies.", "words": [[0, 27529], [11, 28149], [14, 28349], [18, 28469], [27, 29449], [31, 29576], [43, 30236], [46, 30496], [54, 30976], [57, 31136], [61, 31276]]}, {"verse": 8, "start": 32253, "end": 36790, "text": "Levántate, oh Jehová, a tu reposo; tú y el arca de tu fortaleza.", "words": [[0, 32253], [11, 32697], [14, 33151], [22, 33604], [24, 33844], [27, 33944], [35, 34812], [38, 34977], [40, 35162], [43, 35322], [48, 35622], [51, 35742], [54, 35882]]}, {"verse": 9, "start": 37140, "end": 41170, "text": "Tus sacerdotes se vistan de justicia, y regocíjense tus santos.", "words": [[0, 37140], [4, 37244], [15, 38044], [18, 38264], [25, 38644], [28, 38764], [38, 39304], [40, 39444], [52, 40204], [56, 40484]]}, {"verse": 10, "start": 41520, "end": 45935, "text": "Por amor de David tu siervo no vuelvas de tu ungido el rostro.", "words": [[0, 41520], [4, 41645], [9, 41945], [12, 42205], [18, 42737], [21, 42830], [28, 43270], [31, 43590], [39, 44070], [42, 44210], [45, 44510], [52, 44810], [55, 44970]]}, {"verse": 11, "start": 46285, "end": 53518, "text": "En verdad juró Jehová a David, no se apartará de ellos: Del fruto de tu vientre pondré sobre tu trono.", "words": [[0, 46285], [3, 46423], [10, 46843], [15, 47263], [22, 47683], [24, 47763], [31, 48523], [34, 48843], [37, 49023], [46, 49543], [49, 49703], [56, 50510], [60, 50647], [66, 51067], [69, 51207], [72, 51347], [80, 51827], [87, 52287], [93, 52567], [96, 52767]]}, {"verse": 12, "start": 53868, "end": 62749, "text": "Si tus hijos guardan mi alianza, y mi testimonio que yo les enseñaré, sus hijos también se sentarán sobre tu trono para siempre.", "words": [[0, 53868], [3, 54027], [7, 54247], [13, 54607], [21, 55227], [24, 55387], [33, 55987], [35, 56367], [38, 56487], [49, 57247], [53, 57367], [56, 57547], [60, 57707], [70, 58747], [74, 58927], [80, 59367], [88, 59707], [91, 60007], [100, 60607], [106, 60867], [109, 61067], [115, 61427], [120, 61647]]}, {"verse": 13, "start": 63029, "end": 67774, "text": "Porque Jehová ha elegido a Sion; la deseó por habitación para sí.", "words": [[0, 63029], [7, 63291], [14, 63991], [17, 64231], [25, 64659], [27, 65087], [33, 65686], [36, 65886], [42, 66346], [46, 66546], [57, 67086], [62, 67346]]}, {"verse": 14, "start": 67994, "end": 73324, "text": "Este es mi reposo para siempre: aquí habitaré, porque la he deseado.", "words": [[0, 67994], [5, 68294], [8, 68514], [11, 68654], [18, 69134], [23, 69374], [32, 70517], [37, 70800], [47, 71600], [54, 72000], [57, 72200], [60, 72380]]}, {"verse": 15, "start": 73674, "end": 78260, "text": "A su mantenimiento daré bendición: sus pobres saciaré de pan.", "words": [[0, 73674], [2, 73797], [5, 73917], [19, 74657], [24, 75017], [35, 76192], [39, 76344], [46, 76844], [54, 77484], [57, 77584]]}, {"verse": 16, "start": 78610, "end": 83788, "text": "Asimismo vestiré a sus sacerdotes de salvación, y sus santos darán voces de júbilo.", "words": [[0, 78610], [9, 79232], [17, 79752], [19, 79812], [23, 79972], [34, 80612], [37, 80972], [48, 81332], [50, 81517], [54, 81697], [61, 82197], [67, 82497], [73, 82817], [76, 82957]]}, {"verse": 17, "start": 84138, "end": 88980, "text": "Allí haré reverdecer el cuerno de David: he preparado lámpara a mi ungido.", "words": [[0, 84138], [5, 84478], [10, 84718], [21, 85338], [24, 85518], [31, 85918], [34, 85978], [41, 86892], [44, 87017], [54, 87497], [62, 87937], [64, 88037], [67, 88157]]}, {"verse": 18, "start": 89330, "end": 94776, "text": "A sus enemigos vestiré de confusión: mas sobre él florecerá su corona.", "words": [[0, 89330], [2, 89490], [6, 89610], [15, 90150], [23, 90730], [26, 90770], [37, 92066], [41, 92146], [47, 92466], [50, 92826], [60, 93766], [63, 93906]]}]}