{"book": "GEN", "chapter": 45, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 238143, "verses": [{"verse": 1, "start": 300, "end": 10666, "text": "No podía ya José contenerse delante de todos los que estaban al lado suyo, y clamó: Haced salir de conmigo a todos. Y no quedó nadie con él, al darse a conocer José a sus hermanos.", "words": [[0, 300], [3, 438], [9, 738], [12, 958], [17, 1238], [28, 1938], [36, 2318], [39, 2458], [45, 2678], [49, 2878], [53, 3018], [61, 3258], [64, 3458], [69, 3578], [75, 4138], [77, 4358], [84, 5157], [90, 5307], [96, 5547], [99, 5727], [107, 6107], [109, 6227], [116, 6926], [118, 7026], [121, 7126], [127, 7446], [133, 7786], [137, 8086], [141, 8306], [144, 8626], [150, 8966], [152, 9026], [160, 9326], [165, 9706], [167, 9906], [171, 10006]]}, {"verse": 2, "start": 10946, "end": 18769, "text": "Entonces se dio a llorar a voz en grito; y oyeron los egipcios, y oyó también la casa de Faraón.", "words": [[0, 10946], [9, 11573], [12, 12013], [16, 12273], [18, 12453], [25, 12853], [27, 13003], [31, 13153], [34, 13493], [41, 14351], [43, 14515], [50, 14855], [54, 15095], [64, 16235], [66, 16595], [70, 16895], [78, 17195], [81, 17495], [86, 17755], [89, 17955]]}, {"verse": 3, "start": 18989, "end": 27683, "text": "Y dijo José a sus hermanos: Yo soy José: ¿vive aún mi padre? Y sus hermanos no pudieron responderle, porque estaban turbados delante de él.", "words": [[0, 18989], [2, 19095], [7, 19395], [12, 19755], [14, 19975], [18, 20075], [28, 21047], [31, 21225], [35, 21425], [41, 22196], [47, 22417], [51, 22597], [54, 22797], [61, 23557], [63, 23660], [67, 23780], [76, 24320], [79, 24420], [88, 24800], [101, 25640], [108, 25860], [116, 26220], [125, 26780], [133, 27220], [136, 27400]]}, {"verse": 4, "start": 27963, "end": 38909, "text": "Entonces dijo José a sus hermanos: Acercaos ahora a mí. Y ellos se llegaron. Y él dijo: Yo soy José vuestro hermano el que vendisteis para Egipto.", "words": [[0, 27963], [9, 28570], [14, 29290], [19, 29650], [21, 29950], [25, 30110], [35, 31438], [44, 31758], [50, 32018], [52, 32258], [56, 32767], [58, 32972], [64, 33292], [67, 33612], [77, 34656], [79, 34821], [82, 34981], [88, 35756], [91, 35919], [95, 36099], [100, 36559], [108, 36839], [116, 37339], [119, 37439], [123, 37559], [134, 38159], [139, 38339]]}, {"verse": 5, "start": 39259, "end": 46753, "text": "Ahora pues, no os entristezcáis, ni os pese de haberme vendido acá; que para preservación de vida me envió Dios delante de vosotros:", "words": [[0, 39259], [6, 39537], [12, 39737], [15, 40017], [18, 40487], [33, 40957], [36, 41477], [39, 41617], [44, 41877], [47, 42017], [55, 42337], [63, 42737], [68, 43360], [72, 43461], [77, 43641], [90, 44341], [93, 44501], [98, 44721], [101, 44901], [107, 45221], [112, 45441], [120, 45881], [123, 46021]]}, {"verse": 6, "start": 47103, "end": 53001, "text": "Que ya ha habido dos años de hambre en medio de la tierra, y aún quedan cinco años en que no habrá siembra ni cosecha.", "words": [[0, 47103], [4, 47196], [7, 47376], [10, 47556], [17, 47736], [21, 47936], [26, 48236], [29, 48496], [36, 48776], [39, 48876], [45, 49076], [48, 49236], [51, 49336], [59, 49616], [61, 49881], [65, 50041], [72, 50421], [78, 50741], [83, 51081], [86, 51301], [90, 51421], [93, 51601], [99, 51841], [107, 52261], [110, 52381]]}, {"verse": 7, "start": 53351, "end": 59325, "text": "Y Dios me envió delante de vosotros, para que vosotros quedaseis en la tierra, y para daros vida por medio de gran liberación.", "words": [[0, 53351], [2, 53472], [7, 53632], [10, 53832], [16, 54112], [24, 54432], [27, 54552], [37, 54992], [42, 55232], [46, 55352], [55, 55692], [65, 56312], [68, 56412], [71, 56532], [79, 56832], [81, 57067], [86, 57287], [92, 57587], [97, 57807], [101, 58027], [107, 58267], [110, 58427], [115, 58587]]}, {"verse": 8, "start": 59675, "end": 69545, "text": "Así pues, no me enviasteis vosotros acá, sino Dios, que me ha puesto por padre de Faraón, y por señor de toda su casa, y por gobernador en toda la tierra de Egipto.", "words": [[0, 59675], [4, 59890], [10, 60150], [13, 60390], [16, 60530], [27, 61130], [36, 61570], [41, 62390], [46, 62530], [52, 63290], [56, 63350], [59, 63490], [62, 63590], [69, 63850], [73, 64130], [79, 64410], [82, 64590], [90, 65090], [92, 65370], [96, 65510], [102, 65790], [105, 65990], [110, 66150], [113, 66390], [119, 67147], [121, 67250], [125, 67390], [136, 68010], [139, 68270], [144, 68390], [147, 68590], [154, 68830], [157, 69010]]}, {"verse": 9, "start": 69895, "end": 78941, "text": "Daos prisa, id a mi padre y decidle: Así dice tu hijo José: Dios me ha puesto por señor de todo Egipto; ven a mí, no te detengas:", "words": [[0, 69895], [5, 70255], [12, 70635], [15, 71015], [17, 71115], [20, 71215], [26, 71555], [28, 71995], [37, 72600], [41, 72800], [46, 73100], [49, 73320], [54, 73560], [60, 74376], [65, 74613], [68, 74833], [71, 74933], [78, 75213], [82, 75493], [88, 75793], [91, 76093], [96, 76273], [104, 77178], [108, 77383], [110, 77503], [114, 77963], [117, 78083], [120, 78203]]}, {"verse": 10, "start": 79291, "end": 89316, "text": "Y habitarás en la tierra de Gosén, y estarás cerca de mí, tú y tus hijos, y los hijos de tus hijos, tus ganados y tus vacas, y todo lo que tienes.", "words": [[0, 79291], [2, 79409], [12, 79989], [15, 80089], [18, 80169], [25, 80449], [28, 80809], [35, 81169], [37, 81569], [45, 82009], [51, 82309], [54, 82589], [58, 83249], [61, 83509], [63, 83789], [67, 83969], [74, 84769], [76, 84829], [80, 84989], [86, 85289], [89, 85489], [93, 85669], [100, 86289], [104, 86369], [112, 86889], [114, 87109], [118, 87249], [125, 88093], [127, 88209], [132, 88369], [135, 88569], [139, 88669]]}, {"verse": 11, "start": 89666, "end": 97611, "text": "Y allí te alimentaré, pues aún quedan cinco años de hambre, para que no perezcas de pobreza tú y tu casa, y todo lo que tienes:", "words": [[0, 89666], [2, 89771], [7, 89971], [10, 90191], [22, 91211], [27, 91331], [31, 91631], [38, 92091], [44, 92391], [49, 92691], [52, 92911], [60, 93291], [65, 93751], [69, 93911], [72, 94071], [81, 94591], [84, 94751], [92, 95251], [95, 95531], [97, 95711], [100, 95831], [106, 96151], [108, 96651], [113, 96871], [116, 97071], [120, 97191]]}, {"verse": 12, "start": 97961, "end": 103111, "text": "Y he aquí, vuestros ojos ven, y los ojos de mi hermano Benjamín, que mi boca os habla.", "words": [[0, 97961], [2, 98082], [5, 98222], [11, 98462], [20, 98902], [25, 99142], [30, 99522], [32, 99882], [36, 100042], [41, 100282], [44, 100522], [47, 100662], [55, 101082], [65, 101922], [69, 102042], [72, 102182], [77, 102422], [80, 102662]]}, {"verse": 13, "start": 103461, "end": 110624, "text": "Haréis pues saber a mi padre toda mi gloria en Egipto, y todo lo que habéis visto: y daos prisa, y traed a mi padre acá.", "words": [[0, 103461], [7, 103784], [12, 103964], [18, 104264], [20, 104384], [23, 104504], [29, 104844], [34, 105184], [37, 105404], [44, 105764], [47, 105864], [55, 106424], [57, 106764], [62, 106944], [65, 107124], [69, 107244], [76, 107464], [83, 108216], [85, 108353], [90, 108573], [97, 109053], [99, 109280], [105, 109506], [107, 109733], [110, 109893], [116, 110133]]}, {"verse": 14, "start": 110904, "end": 117511, "text": "Y se echó sobre el cuello de Benjamín su hermano, y lloró; y también Benjamín lloró sobre su cuello.", "words": [[0, 110904], [2, 111068], [5, 111168], [10, 111508], [16, 111788], [19, 111988], [26, 112308], [29, 112448], [38, 112888], [41, 113168], [50, 113908], [52, 114108], [59, 114818], [61, 114978], [69, 115278], [78, 115818], [84, 116558], [90, 116778], [93, 116998]]}, {"verse": 15, "start": 117861, "end": 123765, "text": "Y besó a todos sus hermanos, y lloró sobre ellos: y después sus hermanos hablaron con él.", "words": [[0, 117861], [2, 118119], [7, 118499], [9, 118599], [15, 118839], [19, 119179], [29, 119879], [31, 120059], [37, 120439], [43, 120679], [50, 121479], [52, 121612], [60, 121852], [64, 122152], [73, 122772], [82, 123232], [86, 123529]]}, {"verse": 16, "start": 124115, "end": 134150, "text": "Y se oyó la noticia en la casa de Faraón, diciendo: Los hermanos de José han venido. Y agradó a los ojos de Faraón y de sus siervos.", "words": [[0, 124115], [2, 124301], [5, 124441], [9, 124801], [12, 124941], [20, 125621], [23, 125801], [26, 125961], [31, 126261], [34, 126671], [42, 127081], [52, 128375], [56, 128481], [65, 129061], [68, 129141], [73, 129441], [77, 129861], [85, 130766], [87, 130928], [94, 131428], [96, 131528], [100, 131668], [105, 131988], [108, 132188], [115, 132768], [117, 132968], [120, 133088], [124, 133228]]}, {"verse": 17, "start": 134500, "end": 142177, "text": "Y dijo Faraón a José: Di a tus hermanos: Haced esto: cargad vuestras bestias, e id, volved a la tierra de Canaán;", "words": [[0, 134500], [2, 134604], [7, 134924], [14, 135244], [16, 135564], [22, 136429], [25, 136579], [27, 136639], [31, 136719], [41, 137904], [47, 138164], [53, 138930], [60, 139110], [69, 139490], [78, 139990], [80, 140343], [84, 140697], [91, 141050], [93, 141190], [96, 141210], [103, 141410], [106, 141810]]}, {"verse": 18, "start": 142527, "end": 149550, "text": "Y tomad a vuestro padre y vuestras familias, y venid a mí, que yo os daré lo bueno de la tierra de Egipto y comeréis lo mejor de la tierra.", "words": [[0, 142527], [2, 142661], [8, 142835], [10, 143008], [18, 143368], [24, 143688], [26, 143868], [35, 144228], [45, 144888], [47, 145188], [53, 145488], [55, 145588], [59, 145708], [63, 145863], [66, 146063], [69, 146183], [74, 146443], [77, 146523], [83, 146803], [86, 146963], [89, 147063], [96, 147343], [99, 147543], [106, 147963], [108, 148043], [117, 148423], [120, 148563], [126, 148783], [129, 148943], [132, 149043]]}, {"verse": 19, "start": 149900, "end": 158069, "text": "Y tú manda: Haced esto: tomad de la tierra de Egipto carros para vuestros niños y vuestras mujeres; y tomad a vuestro padre, y venid.", "words": [[0, 149900], [2, 150016], [5, 150136], [12, 151090], [18, 151350], [24, 151975], [30, 152297], [33, 152417], [36, 152517], [43, 152817], [46, 153017], [53, 153477], [60, 153817], [65, 154037], [74, 154437], [80, 154737], [82, 154997], [91, 155337], [100, 156203], [102, 156310], [108, 156650], [110, 156710], [118, 157010], [125, 157310], [127, 157670]]}, {"verse": 20, "start": 158419, "end": 163516, "text": "Y no se os dé nada de vuestras pertenencias, porque el bien de la tierra de Egipto será vuestro.", "words": [[0, 158419], [2, 158536], [5, 158636], [8, 158816], [11, 158976], [14, 159136], [19, 159296], [22, 159456], [31, 159776], [45, 160856], [52, 161216], [55, 161376], [60, 161536], [63, 161696], [66, 161796], [73, 162116], [76, 162256], [83, 162676], [88, 162896]]}, {"verse": 21, "start": 163796, "end": 174822, "text": "Y lo hicieron así los hijos de Israel: y les dio José carros conforme a la orden de Faraón, y les suministró víveres para el camino.", "words": [[0, 163796], [2, 163940], [5, 164080], [14, 164640], [18, 164980], [22, 165480], [28, 165860], [31, 166451], [39, 167201], [41, 167444], [45, 167604], [49, 167824], [54, 168294], [61, 168764], [70, 169584], [72, 169684], [75, 169764], [81, 170104], [84, 170564], [92, 171024], [94, 171464], [98, 171664], [109, 172804], [117, 173604], [122, 173984], [125, 174144]]}, {"verse": 22, "start": 175172, "end": 182729, "text": "A cada uno de todos ellos dio cambios de ropa, y a Benjamín dio trescientas piezas de plata, y cinco cambios de ropa.", "words": [[0, 175172], [2, 175297], [7, 175497], [11, 175817], [14, 175997], [20, 176237], [26, 176637], [30, 176917], [38, 177497], [41, 177597], [47, 178057], [49, 178697], [51, 178797], [60, 179177], [64, 179537], [76, 180217], [83, 180577], [86, 180697], [93, 180997], [95, 181177], [101, 181497], [109, 182037], [112, 182137]]}, {"verse": 23, "start": 183079, "end": 194791, "text": "Y a su padre envió esto: diez asnos cargados de lo mejor de Egipto, y diez asnas cargadas de trigo, y pan y comida, para su padre en el camino.", "words": [[0, 183079], [2, 183236], [4, 183336], [7, 183496], [13, 183956], [19, 184616], [25, 185417], [30, 185645], [36, 186305], [45, 187145], [48, 187325], [51, 187445], [57, 187745], [60, 187965], [68, 188665], [70, 189085], [75, 189305], [81, 189845], [90, 190465], [93, 190645], [100, 191125], [102, 191645], [106, 191945], [108, 192265], [116, 192705], [121, 193265], [124, 193445], [130, 193805], [133, 194025], [136, 194125]]}, {"verse": 24, "start": 195141, "end": 201438, "text": "Y despidió a sus hermanos, y se fueron. Y él les dijo: No riñáis por el camino.", "words": [[0, 195141], [2, 195505], [11, 196025], [13, 196145], [17, 196265], [27, 197085], [29, 197525], [32, 197645], [40, 198491], [42, 198697], [45, 198877], [49, 199177], [55, 199973], [58, 200130], [65, 200570], [69, 200810], [72, 200930]]}, {"verse": 25, "start": 201718, "end": 207135, "text": "Y subieron de Egipto, y llegaron a la tierra de Canaán a Jacob su padre.", "words": [[0, 201718], [2, 201816], [11, 202316], [14, 202556], [22, 203296], [24, 203696], [33, 204256], [35, 204376], [38, 204456], [45, 204776], [48, 205076], [55, 205516], [57, 205756], [63, 206376], [66, 206476]]}, {"verse": 26, "start": 207485, "end": 217542, "text": "Y le dieron las nuevas, diciendo: José vive aún; y él es señor en toda la tierra de Egipto. Y su corazón se desmayó; pues no los creía.", "words": [[0, 207485], [2, 207595], [5, 207695], [12, 208035], [16, 208195], [24, 208535], [34, 209878], [39, 210268], [44, 210693], [49, 211279], [51, 211445], [54, 211605], [57, 211785], [63, 212125], [66, 212485], [71, 212685], [74, 212925], [81, 213205], [84, 213445], [92, 214288], [94, 214433], [97, 214573], [105, 214973], [108, 215313], [117, 216331], [122, 216453], [125, 216653], [129, 216793]]}, {"verse": 27, "start": 217892, "end": 230605, "text": "Y ellos le contaron todas las palabras de José, que él les había hablado; y viendo él los carros que José enviaba para llevarlo, el espíritu de Jacob su padre revivió.", "words": [[0, 217892], [2, 218122], [8, 218382], [11, 218562], [20, 219162], [26, 219462], [30, 219762], [39, 220142], [42, 220382], [48, 220682], [52, 221222], [55, 221442], [59, 221782], [65, 222142], [74, 223089], [76, 223213], [83, 223533], [86, 223753], [90, 223933], [97, 224533], [101, 224913], [106, 225233], [114, 226073], [119, 226333], [129, 227333], [132, 227453], [141, 228113], [144, 228193], [150, 228873], [153, 229073], [159, 229893]]}, {"verse": 28, "start": 230955, "end": 237743, "text": "Entonces dijo Israel: Basta; José mi hijo vive todavía: iré, y le veré antes que yo muera.", "words": [[0, 230955], [9, 231627], [14, 232227], [22, 233267], [29, 233961], [34, 234126], [37, 234386], [42, 234586], [47, 234766], [56, 235671], [61, 236008], [63, 236388], [66, 236528], [71, 236768], [77, 236968], [81, 237188], [84, 237308]]}]}