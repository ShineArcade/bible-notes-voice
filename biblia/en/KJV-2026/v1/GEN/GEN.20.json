{"book": "GEN", "chapter": 20, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 155008, "verses": [{"verse": 1, "start": 300, "end": 7986, "text": "And Abraham journeyed from there toward the south country, and dwelled between Kadesh and Shur, and sojourned in Gerar.", "words": [[0, 300], [4, 448], [12, 868], [22, 1528], [27, 1708], [33, 2008], [40, 2328], [44, 2568], [50, 2808], [59, 3868], [63, 3948], [71, 4268], [79, 4568], [86, 5088], [90, 5388], [96, 6248], [100, 6468], [110, 7248], [113, 7655]]}, {"verse": 2, "start": 8336, "end": 15596, "text": "And Abraham said of Sarah his wife, She is my sister: and Abimelech king of Gerar sent, and took Sarah.", "words": [[0, 8336], [4, 8459], [12, 8879], [17, 9279], [20, 9439], [26, 9740], [30, 9980], [36, 10742], [40, 10906], [43, 11066], [46, 11206], [54, 12002], [58, 12474], [68, 12974], [73, 13274], [76, 13684], [82, 14094], [88, 14314], [92, 14754], [97, 14954]]}, {"verse": 3, "start": 15946, "end": 25830, "text": "But God came to Abimelech in a dream by night, and said to him, Behold, you are but a dead man, for the woman which you have taken; for she is a man’s wife.", "words": [[0, 15946], [4, 16069], [8, 16349], [13, 16649], [16, 16849], [26, 17509], [29, 17589], [31, 17709], [37, 18009], [40, 18289], [47, 18929], [51, 18989], [56, 19249], [59, 19489], [64, 19909], [72, 20220], [76, 20520], [80, 20720], [84, 20900], [86, 21020], [91, 21200], [96, 22040], [100, 22320], [104, 22420], [110, 22660], [116, 22900], [120, 23060], [125, 23200], [132, 24268], [136, 24366], [140, 24566], [143, 24686], [145, 24786], [151, 25126]]}, {"verse": 4, "start": 26110, "end": 31508, "text": "But Abimelech had not come near her: and he said, Lord, will you slay also a righteous nation?", "words": [[0, 26110], [4, 26527], [14, 26977], [18, 27077], [22, 27237], [27, 27477], [32, 27737], [37, 28277], [41, 28423], [44, 28503], [50, 29146], [56, 29545], [61, 29625], [65, 29745], [70, 30105], [75, 30255], [77, 30405], [87, 30825]]}, {"verse": 5, "start": 31858, "end": 39865, "text": "Said he not to me, She is my sister? and she, even she herself said, He is my brother: in the integrity of my heart and innocency of my hands have I done this.", "words": [[0, 31858], [5, 32058], [8, 32198], [12, 32358], [15, 32518], [19, 32798], [23, 32918], [26, 33058], [29, 33198], [37, 33941], [41, 34066], [46, 34226], [51, 34506], [55, 34706], [63, 35066], [69, 35526], [72, 35686], [75, 35806], [78, 35966], [87, 36577], [90, 36694], [94, 36774], [104, 37174], [107, 37434], [110, 37554], [116, 37814], [120, 38174], [130, 38534], [133, 38634], [136, 38734], [142, 39014], [147, 39154], [149, 39234], [154, 39434]]}, {"verse": 6, "start": 40145, "end": 49975, "text": "And God said to him in a dream, Yes, I know that you did this in the integrity of your heart; for I also withheld you from sinning against me: therefore I did not let you touch her.", "words": [[0, 40145], [4, 40279], [8, 40539], [13, 40859], [16, 41099], [20, 41279], [23, 41459], [25, 41579], [32, 42463], [37, 42769], [39, 42809], [44, 42969], [49, 43109], [53, 43249], [57, 43389], [62, 43589], [65, 43729], [69, 43809], [79, 44169], [82, 44409], [87, 44509], [94, 45441], [98, 45537], [100, 45677], [105, 45937], [114, 46317], [118, 46437], [123, 46598], [131, 46997], [139, 47257], [143, 48176], [153, 48577], [155, 48657], [159, 48757], [163, 48897], [167, 49077], [171, 49157], [177, 49397]]}, {"verse": 7, "start": 50325, "end": 62300, "text": "Now therefore restore the man his wife; for he is a prophet, and he shall pray for you, and you shall live: and if you restore her not, know that you shall surely die, you, and all that are yours.", "words": [[0, 50325], [4, 50479], [14, 50939], [22, 51339], [26, 51619], [30, 51839], [34, 52059], [40, 52994], [44, 53097], [47, 53237], [50, 53377], [52, 53457], [61, 54097], [65, 54237], [68, 54317], [74, 54477], [79, 54737], [83, 54937], [88, 55277], [92, 55377], [96, 55497], [102, 55