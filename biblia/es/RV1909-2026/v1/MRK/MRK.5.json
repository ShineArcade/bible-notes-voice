{"book": "MRK", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 322781, "verses": [{"verse": 1, "start": 300, "end": 3897, "text": "Y vinieron de la otra parte del mar a la provincia de los gadarenos.", "words": [[0, 300], [2, 427], [11, 807], [14, 987], [17, 1107], [22, 1267], [28, 1627], [32, 1867], [36, 2107], [38, 2347], [41, 2447], [51, 3047], [54, 3167], [58, 3287]]}, {"verse": 2, "start": 3897, "end": 11680, "text": "Y salido él del barco, luego le salió al encuentro, de los sepulcros, un hombre con un espíritu inmundo,", "words": [[0, 3907], [2, 4142], [9, 4642], [12, 4862], [16, 5042], [23, 5813], [29, 6073], [32, 6333], [38, 6753], [41, 6893], [52, 7833], [55, 8053], [59, 8213], [70, 9473], [73, 9613], [80, 9953], [84, 10213], [87, 10353], [96, 10893]]}, {"verse": 3, "start": 12030, "end": 17642, "text": "Que vivía entre los sepulcros, y ni aun con cadenas le podía alguien atar;", "words": [[0, 12030], [4, 12134], [10, 12634], [16, 12914], [20, 13134], [31, 13994], [33, 14514], [36, 14714], [40, 14994], [44, 15294], [52, 15954], [55, 16154], [61, 16665], [69, 17177]]}, {"verse": 4, "start": 17992, "end": 29349, "text": "Porque muchas veces había sido atado con grilletes y cadenas, pero las cadenas habían sido hechas pedazos por él, y los grilletes rotos; y nadie le podía domar.", "words": [[0, 17992], [7, 18239], [14, 18559], [20, 18999], [26, 19339], [31, 19739], [37, 20199], [41, 20619], [51, 21039], [53, 21239], [62, 22119], [67, 22219], [71, 22399], [79, 22879], [86, 23219], [91, 23719], [98, 24059], [106, 24599], [110, 24819], [114, 24999], [116, 25599], [120, 25959], [130, 26319], [137, 27387], [139, 27517], [145, 27877], [148, 28417], [154, 28777]]}, {"verse": 5, "start": 29699, "end": 37378, "text": "Y siempre, de día y de noche, andaba dando voces en los montes y en los sepulcros, e hiriéndose con las piedras.", "words": [[0, 29699], [2, 29821], [11, 30181], [14, 30441], [18, 30721], [20, 30841], [23, 30961], [30, 31281], [37, 32101], [43, 32401], [49, 32841], [52, 33021], [56, 33141], [63, 33781], [65, 33961], [68, 34081], [72, 34241], [83, 35061], [85, 35621], [96, 36301], [100, 36481], [104, 36641]]}, {"verse": 6, "start": 37728, "end": 40890, "text": "Y cuando vio a Jesús de lejos, corrió, y le adoró.", "words": [[0, 37728], [2, 37817], [9, 37977], [13, 38317], [15, 38417], [21, 38677], [24, 38877], [31, 39277], [39, 39957], [41, 40192], [44, 40332]]}, {"verse": 7, "start": 41240, "end": 49604, "text": "Y clamando a gran voz, dijo: ¿Qué tienes conmigo, Jesús, Hijo del Dios Altísimo? Te suplico en nombre de Dios que no me atormentes.", "words": [[0, 41240], [2, 41382], [11, 41962], [13, 42082], [18, 42242], [23, 43022], [29, 43781], [34, 43862], [41, 44142], [50, 44602], [57, 45302], [62, 45462], [66, 45662], [71, 45862], [81, 46853], [84, 46931], [92, 47431], [95, 47551], [102, 47831], [105, 48031], [110, 48271], [114, 48471], [117, 48591], [120, 48711]]}, {"verse": 8, "start": 49884, "end": 54226, "text": "Porque le decía: Sal de este hombre, espíritu inmundo.", "words": [[0, 49884], [7, 50108], [10, 50288], [17, 51312], [21, 51486], [24, 51659], [29, 51919], [37, 52339], [46, 53308]]}, {"verse": 9, "start": 54576, "end": 61181, "text": "Y le preguntó: ¿Cómo te llamas? Y respondió diciendo: Legión me llamo; porque somos muchos.", "words": [[0, 54576], [2, 54677], [5, 54777], [15, 55699], [21, 55983], [24, 56143], [32, 57073], [34, 57178], [44, 57718], [54, 58693], [61, 59120], [64, 59340], [71, 59963], [78, 60163], [84, 60443]]}, {"verse": 10, "start": 61461, "end": 65443, "text": "Y le rogaba mucho que no le enviase fuera de aquella provincia.", "words": [[0, 61547], [2, 61667], [5, 61787], [12, 62307], [18, 62627], [22, 62827], [25, 63007], [28, 63127], [36, 63607], [42, 63947], [45, 64187], [53, 64447]]}, {"verse": 11, "start": 65793, "end": 70470, "text": "Y estaba allí cerca del monte una grande manada de cerdos paciendo.", "words": [[0, 65793], [2, 66080], [9, 66400], [14, 66700], [20, 67040], [24, 67340], [30, 67720], [34, 67980], [41, 68380], [48, 68960], [51, 69140], [58, 69836]]}, {"verse": 12, "start": 70820, "end": 76966, "text": "Y le rogaron todos los demonios, diciendo: Envíanos a los cerdos para que entremos en ellos.", "words": [[0, 70820], [2, 70926], [5, 71066], [13, 71626], [19, 71986], [23, 72366], [33, 73066], [43, 74178], [52, 74801], [54, 74921], [58, 75021], [65, 75501], [70, 75721], [74, 75861], [83, 76301], [86, 76441]]}, {"verse": 13, "start": 77246, "end": 90956, "text": "Y luego Jesús se lo permitió. Y saliendo aquellos espíritus inmundos, entraron en los cerdos, y la manada cayó por un despeñadero en el mar; los cuales eran como dos mil; y en el mar se ahogaron.", "words": [[0, 77246], [2, 77387], [8, 77527], [14, 77947], [17, 78287], [20, 78387], [30, 79339], [32, 79443], [41, 80003], [50, 80163], [60, 80903], [70, 81683], [79, 82463], [82, 82583], [86, 82723], [94, 83483], [96, 83923], [99, 84083], [106, 84423], [111, 84883], [115, 85123], [118, 85263], [130, 86023], [133, 86163], [136, 86283], [141, 86908], [145, 87032], [152, 87192], [157, 87572], [162, 87998], [166, 88424], [171, 89038], [173, 89192], [176, 89332], [179, 89452], [183, 89692], [186, 89932]]}, {"verse": 14, "start": 91306, "end": 101166, "text": "Y los que apacentaban los cerdos huyeron, y dieron aviso en la ciudad y en los campos. Y salieron para ver qué era aquello que había acontecido.", "words": [[0, 91306], [2, 91428], [6, 91548], [10, 92018], [22, 92488], [26, 92648], [33, 93248], [42, 94008], [44, 94488], [51, 94768], [57, 95168], [60, 95328], [63, 95448], [70, 95768], [72, 96028], [75, 96128], [79, 96248], [87, 97352], [89, 97614], [98, 98094], [103, 98354], [107, 98574], [111, 98774], [115, 99134], [123, 99654], [127, 99794], [133, 100094]]}, {"verse": 15, "start": 101516, "end": 113074, "text": "Y vienen a Jesús, y ven al que había sido atormentado del demonio, y que había tenido la legión, sentado y vestido, y en su juicio cabal; y tuvieron miedo.", "words": [[0, 101516], [2, 101617], [9, 101877], [11, 102057], [18, 103117], [20, 103377], [24, 103577], [27, 103837], [31, 104037], [37, 104237], [42, 104597], [54, 105477], [58, 105697], [67, 106697], [69, 106857], [73, 106997], [79, 107197], [86, 107517], [89, 107757], [97, 108577], [105, 109137], [107, 109237], [116, 109897], [118, 110257], [121, 110397], [124, 110557], [131, 110957], [138, 111876], [140, 112080], [149, 112440]]}, {"verse": 16, "start": 113424, "end": 121102, "text": "Y les contaron los que lo habían visto, cómo había acontecido al que había tenido el demonio, y lo de los cerdos.", "words": [[0, 113424], [2, 113548], [6, 113668], [15, 114368], [19, 114588], [23, 114748], [26, 114908], [33, 115168], [40, 116168], [45, 116428], [51, 116848], [62, 117828], [65, 117948], [69, 118088], [75, 118328], [82, 118628], [85, 118868], [94, 119728], [96, 119888], [99, 120048], [102, 120148], [106, 120288]]}, {"verse": 17, "start": 121452, "end": 124634, "text": "Y comenzaron a rogarle que se fuese de su región.", "words": [[0, 121452], [2, 121538], [13, 122238], [15, 122628], [23, 123018], [27, 123178], [30, 123318], [36, 123638], [39, 123778], [42, 123938]]}, {"verse": 18, "start": 124984, "end": 132023, "text": "Y entrando él en el barco, le rogaba el que había estado poseído por el demonio, para estar con él.", "words": [[0, 124984], [2, 125128], [11, 125628], [14, 125968], [17, 126268], [20, 126428], [27, 127408], [30, 127908], [37, 128408], [40, 128648], [44, 128808], [50, 129008], [57, 129348], [65, 130048], [69, 130288], [72, 130428], [81, 130968], [86, 131168], [92, 131428], [96, 131728]]}, {"verse": 19, "start": 132373, "end": 143752, "text": "Pero Jesús no le permitió, sino le dijo: Vete a tu casa, a los tuyos, y cuéntales cuán grandes cosas el Señor ha hecho contigo, y cómo ha tenido misericordia de ti.", "words": [[0, 132373], [5, 132517], [11, 132917], [14, 133417], [17, 133577], [27, 134107], [32, 134637], [35, 134777], [41, 135584], [46, 135890], [48, 136010], [51, 136090], [57, 136470], [59, 136870], [63, 136970], [70, 137510], [72, 137670], [82, 138090], [87, 138390], [95, 138730], [101, 139130], [104, 139390], [110, 139730], [113, 140070], [119, 140330], [128, 140950], [130, 141330], [135, 141670], [138, 141850], [145, 142170], [158, 143230], [161, 143350]]}, {"verse": 20, "start": 144102, "end": 152754, "text": "Y se fue, y comenzó a publicar en Decápolis cuán grandes cosas Jesús había hecho con él: y todos se maravillaban.", "words": [[0, 144102], [2, 144269], [5, 144349], [10, 144854], [12, 144954], [20, 145534], [22, 145634], [31, 146174], [34, 146274], [44, 146914], [49, 147474], [57, 147894], [63, 148254], [69, 148774], [75, 149334], [81, 149694], [85, 149954], [89, 150560], [91, 150862], [97, 151242], [100, 151702]]}, {"verse": 21, "start": 153104, "end": 160867, "text": "Y pasando otra vez Jesús en un barco a la otra parte, se juntó a él una gran multitud; y estaba junto al mar.", "words": [[0, 153104], [2, 153207], [10, 153607], [15, 153947], [19, 154267], [25, 154667], [28, 155047], [31, 155187], [37, 155567], [39, 155667], [42, 155727], [47, 155887], [54, 156747], [57, 157047], [63, 157547], [65, 157667], [68, 157787], [72, 157967], [77, 158247], [87, 159461], [89, 159570], [96, 159870], [102, 160190], [105, 160430]]}, {"verse": 22, "start": 161217, "end": 168611, "text": "Y vino uno de los dirigentes de la sinagoga, llamado Jairo; y luego que le vio, se postró a sus pies,", "words": [[0, 161217], [2, 161341], [7, 161621], [11, 162041], [14, 162261], [18, 162381], [29, 163081], [32, 163241], [35, 163361], [45, 164081], [53, 164481], [60, 165644], [62, 165792], [68, 165972], [72, 166252], [75, 166392], [80, 166712], [83, 167252], [90, 167752], [92, 167872], [96, 167972]]}, {"verse": 23, "start": 168961, "end": 176917, "text": "Y le rogaba mucho, diciendo: Mi hija está a punto de morir: ven y pondrás las manos sobre ella para que sane, y vivirá.", "words": [[0, 168961], [2, 169085], [5, 169435], [12, 169785], [19, 170645], [29, 171597], [32, 171735], [37, 172055], [42, 172275], [44, 172415], [50, 172615], [53, 172855], [60, 173565], [64, 173792], [66, 173972], [74, 174352], [78, 174492], [84, 174732], [90, 175092], [95, 175332], [100, 175592], [104, 175752], [110, 176052], [112, 176372]]}, {"verse": 24, "start": 177197, "end": 181574, "text": "Y fue con él, y le seguía gran multitud, y le apretaban.", "words": [[0, 177197], [2, 177338], [6, 177498], [10, 177778], [14, 178038], [16, 178578], [19, 178718], [26, 179158], [31, 179458], [41, 180238], [43, 180473], [46, 180593]]}, {"verse": 25, "start": 181924, "end": 186551, "text": "Y una mujer que padecía hemorragias desde hacía doce años,", "words": [[0, 181924], [2, 182181], [6, 182341], [12, 182661], [16, 182861], [24, 183481], [36, 184501], [42, 184841], [48, 185301], [53, 185761]]}, {"verse": 26, "start": 186901, "end": 196087, "text": "Y había sufrido mucho de muchos médicos, y había gastado todo lo que tenía, y no había mejorado, antes le iba peor,", "words": [[0, 186901], [2, 187045], [8, 187265], [16, 187925], [22, 188445], [25, 188705], [32, 188945], [41, 189805], [43, 190230], [49, 190470], [57, 191130], [62, 191530], [65, 191790], [69, 191930], [76, 192390], [78, 192735], [81, 192875], [87, 193135], [97, 194195], [103, 194695], [106, 195235], [110, 195475]]}, {"verse": 27, "start": 196437, "end": 202482, "text": "Cuando oyó hablar de Jesús, llegó por detrás entre la multitud, y tocó su vestido.", "words": [[0, 196437], [7, 196639], [11, 197099], [18, 197379], [21, 197619], [28, 198559], [34, 198999], [38, 199359], [45, 199919], [51, 200199], [54, 200399], [64, 201039], [66, 201274], [71, 201634], [74, 201774]]}, {"verse": 28, "start": 202832, "end": 207101, "text": "Porque decía: Si toco tan solamente su vestido, seré salva.", "words": [[0, 202832], [7, 203054], [14, 203920], [17, 204100], [22, 204460], [26, 204680], [36, 205100], [39, 205440], [48, 206280], [53, 206600]]}, {"verse": 29, "start": 207381, "end": 213901, "text": "Y luego se detuvo la hemorragia; y sintió en el cuerpo que estaba sana de aquella enfermedad.", "words": [[0, 207381], [2, 207506], [8, 207766], [11, 208006], [18, 208486], [21, 208686], [33, 209937], [35, 210185], [42, 210745], [45, 210965], [48, 211105], [55, 211485], [59, 211705], [66, 211965], [71, 212385], [74, 212605], [82, 212985]]}, {"verse": 30, "start": 214251, "end": 223478, "text": "Y luego Jesús, conociendo en sí mismo el poder que había salido de él, volviéndose a la multitud, dijo: ¿Quién ha tocado mis vestidos?", "words": [[0, 214251], [2, 214377], [8, 214597], [15, 215677], [26, 216257], [29, 216477], [32, 216617], [38, 217017], [41, 217137], [47, 217397], [51, 217657], [57, 217857], [64, 218357], [67, 218577], [71, 219082], [83, 219822], [85, 219922], [88, 220022], [98, 221042], [104, 221707], [111, 221971], [114, 222071], [121, 222511], [125, 222671]]}, {"verse": 31, "start": 223828, "end": 229199, "text": "Y le dijeron sus discípulos: Ves que la multitud te aprieta, y dices: ¿Quién me ha tocado?", "words": [[0, 223828], [2, 223973], [5, 224033], [13, 224493], [17, 224653], [29, 225724], [33, 225906], [37, 226106], [40, 226206], [49, 226706], [52, 226846], [61, 227306], [63, 227486], [70, 228265], [77, 228484], [80, 228564], [83, 228664]]}, {"verse": 32, "start": 229479, "end": 233378, "text": "Y él miraba alrededor para ver a la que había hecho esto.", "words": [[0, 229479], [2, 229663], [5, 229783], [12, 230263], [22, 230763], [27, 231323], [31, 231643], [33, 231863], [36, 231963], [40, 232143], [46, 232463], [52, 232763]]}, {"verse": 33, "start": 233728, "end": 243883, "text": "Entonces la mujer, temiendo y temblando, sabiendo lo que en sí había sido hecho, vino y se postró delante de él, y le dijo toda la verdad.", "words": [[0, 233728], [9, 234528], [12, 234640], [19, 234920], [28, 235580], [30, 235700], [41, 236360], [50, 237080], [53, 237280], [57, 237440], [60, 237760], [63, 238060], [69, 238420], [74, 238880], [81, 239640], [86, 240040], [88, 240540], [91, 240680], [98, 241120], [106, 241500], [109, 241680], [113, 241900], [115, 242360], [118, 242460], [123, 242780], [128, 243040], [131, 243260]]}, {"verse": 34, "start": 244233, "end": 250363, "text": "Y él le dijo: Hija, tu fe te ha hecho salva: ve en paz, y queda sana de tu enfermedad.", "words": [[0, 244233], [2, 244377], [5, 244517], [8, 244677], [14, 245434], [20, 245758], [23, 245898], [26, 246138], [29, 246358], [32, 246458], [38, 246638], [45, 247568], [48, 247662], [51, 247755], [56, 248115], [58, 248715], [64, 248935], [69, 249255], [72, 249455], [75, 249595]]}, {"verse": 35, "start": 250713, "end": 258193, "text": "Hablando aún él, vinieron de casa del dirigente de la sinagoga, diciendo: Tu hija ha muerto; ¿para qué molestas más al Maestro?", "words": [[0, 250713], [9, 251122], [13, 251522], [17, 251582], [26, 252082], [29, 252282], [34, 252522], [38, 252722], [48, 253362], [51, 253482], [54, 253582], [64, 254162], [74, 255140], [77, 255245], [82, 255545], [85, 255545], [93, 256326], [99, 256470], [103, 256610], [112, 257150], [116, 257350], [119, 257550]]}, {"verse": 36, "start": 258473, "end": 266747, "text": "Pero luego Jesús, oyendo esta razón que se decía, dijo al dirigente de la sinagoga: No temas, cree solamente.", "words": [[0, 258473], [5, 258636], [11, 258936], [18, 259636], [25, 260056], [30, 260316], [36, 260756], [40, 260976], [43, 261136], [50, 262196], [55, 262496], [58, 262716], [68, 263336], [71, 263496], [74, 263636], [84, 264667], [87, 264795], [94, 265575], [99, 265775]]}, {"verse": 37, "start": 267097, "end": 273587, "text": "Y no permitió que alguno viniese tras él sino Pedro, y Jacobo, y Juan hermano de Jacobo.", "words": [[0, 267097], [2, 267223], [5, 267343], [14, 267943], [18, 268103], [25, 268543], [33, 268983], [38, 269263], [41, 269723], [46, 269803], [53, 270343], [55, 270588], [63, 271648], [65, 271768], [70, 272288], [78, 272768], [81, 272848]]}, {"verse": 38, "start": 273937, "end": 280075, "text": "Y vino a casa del dirigente de la sinagoga, y vio la conmoción, los que lloraban y gemían mucho.", "words": [[0, 273937], [2, 274063], [7, 274303], [9, 274503], [14, 274763], [18, 275063], [28, 275683], [31, 275803], [34, 275923], [44, 276583], [46, 276723], [50, 276923], [53, 277023], [64, 277803], [68, 278263], [72, 278443], [81, 278963], [83, 279123], [90, 279503]]}, {"verse": 39, "start": 280425, "end": 287864, "text": "Y entrando, les dice: ¿Por qué alborotáis y lloráis? La muchacha no es muerta, sino que duerme.", "words": [[0, 280425], [2, 280697], [12, 281197], [16, 281437], [22, 282305], [27, 282410], [31, 282690], [42, 283710], [44, 284010], [53, 284995], [56, 285131], [65, 285591], [68, 285791], [71, 285891], [79, 286611], [84, 286971], [88, 287211]]}, {"verse": 40, "start": 288214, "end": 300652, "text": "Y se burlaban de él: pero él, después de hacer salir a todos, toma al padre y a la madre de la muchacha, y a los que estaban con él, y entra donde la muchacha estaba.", "words": [[0, 288214], [2, 288381], [5, 288521], [14, 289081], [17, 289361], [21, 289974], [26, 290161], [30, 291021], [38, 291461], [41, 291661], [47, 292001], [53, 292401], [55, 292581], [62, 293641], [67, 294021], [70, 294261], [76, 294701], [78, 295061], [80, 295141], [83, 295261], [89, 295621], [92, 295821], [95, 295941], [105, 296541], [107, 297021], [109, 297121], [113, 297241], [117, 297401], [125, 297701], [129, 298041], [133, 298643], [135, 298805], [141, 299105], [147, 299345], [150, 299565], [159, 300005]]}, {"verse": 41, "start": 301002, "end": 309075, "text": "Y tomando la mano de la muchacha, le dice: Talitha cumi; que traducido significa: Muchacha, a ti digo, levántate.", "words": [[0, 301002], [2, 301144], [10, 301624], [13, 301804], [18, 302084], [21, 302244], [24, 302364], [34, 302984], [37, 303084], [43, 304206], [51, 304531], [57, 305077], [61, 305179], [71, 305899], [82, 307079], [92, 307803], [94, 307803], [97, 307923], [103, 308343]]}, {"verse": 42, "start": 309425, "end": 316581, "text": "Y luego la muchacha se levantó, y andaba; porque tenía doce años. Y quedaron sumamente asombrados.", "words": [[0, 309425], [2, 309528], [8, 309728], [11, 309928], [20, 310408], [23, 310568], [32, 311288], [34, 311528], [42, 312402], [49, 312587], [55, 312917], [60, 313247], [66, 314247], [68, 314372], [77, 314872], [87, 315532]]}, {"verse": 43, "start": 316931, "end": 322381, "text": "Pero él les mandó mucho que nadie lo supiese, y dijo que le diesen de comer.", "words": [[0, 316931], [5, 317095], [8, 317495], [12, 317815], [18, 318295], [24, 318635], [28, 318855], [34, 319155], [37, 319375], [46, 319995], [48, 320595], [53, 320935], [57, 321095], [60, 321255], [67, 321615], [70, 321835]]}]}