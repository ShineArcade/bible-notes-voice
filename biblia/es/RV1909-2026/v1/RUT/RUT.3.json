{"book": "RUT", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 169503, "verses": [{"verse": 1, "start": 300, "end": 7433, "text": "Y LE DIJO su suegra Noemí: Hija mía, ¿no te he de buscar hogar para ti, para que te vaya bien?", "words": [[0, 300], [2, 444], [5, 544], [10, 844], [13, 1344], [20, 2044], [27, 2872], [32, 3119], [37, 3979], [41, 4119], [44, 4319], [47, 4419], [50, 4539], [57, 4819], [63, 5299], [68, 5499], [72, 6179], [77, 6399], [81, 6539], [84, 6659], [89, 6859]]}, {"verse": 2, "start": 7783, "end": 15608, "text": "¿No es Booz nuestro pariente, con cuyas criadas tú has estado? He aquí que él avienta esta noche la parva de las cebadas.", "words": [[0, 7783], [4, 7929], [7, 8149], [12, 8369], [20, 8729], [30, 9449], [34, 9709], [40, 10209], [48, 10709], [51, 10889], [55, 11049], [63, 11952], [66, 12092], [71, 12372], [75, 12572], [78, 12792], [86, 13272], [91, 13492], [97, 13852], [100, 14192], [106, 14532], [109, 14652], [113, 14792]]}, {"verse": 3, "start": 15958, "end": 26888, "text": "Te lavarás pues, y te ungirás, y vistiéndote tus vestidos, pasarás a la era; mas no te darás a conocer al varón hasta que él haya acabado de comer y de beber.", "words": [[0, 15958], [3, 16035], [11, 16555], [17, 16815], [19, 17175], [22, 17295], [31, 17975], [33, 18395], [45, 19035], [49, 19235], [59, 19795], [67, 20515], [69, 20635], [72, 20715], [77, 21530], [81, 21690], [84, 21950], [87, 22090], [93, 22510], [95, 22610], [103, 23050], [106, 23290], [112, 23770], [118, 24025], [122, 24265], [125, 24505], [130, 24825], [138, 25405], [141, 25545], [147, 25865], [149, 26225], [152, 26385]]}, {"verse": 4, "start": 27238, "end": 38088, "text": "Y cuando él se acueste, notarás el lugar donde él se acostará, e irás, y descubrirás los pies, y te acostarás allí; y él te dirá lo que hayas de hacer.", "words": [[0, 27238], [2, 27398], [9, 27631], [12, 27865], [15, 28098], [24, 28758], [32, 29638], [35, 29798], [41, 30018], [47, 30271], [50, 30525], [53, 30778], [63, 31498], [65, 31998], [71, 32478], [73, 32818], [85, 33598], [89, 33798], [95, 34138], [97, 34658], [100, 34778], [110, 35498], [116, 36106], [118, 36236], [121, 36376], [124, 36536], [129, 36836], [132, 36956], [136, 37116], [142, 37496], [145, 37636]]}, {"verse": 5, "start": 38368, "end": 41462, "text": "Y le respondió: Haré todo lo que tú me mandes.", "words": [[0, 38368], [2, 38513], [5, 38653], [16, 39732], [21, 39992], [26, 40212], [29, 40472], [33, 40612], [36, 40772], [39, 40932]]}, {"verse": 6, "start": 41742, "end": 47118, "text": "Descendió pues a la era, e hizo todo lo que su suegra le había mandado.", "words": [[0, 41742], [10, 42446], [15, 42686], [17, 43006], [20, 43146], [25, 44126], [27, 44386], [32, 44606], [37, 44886], [40, 45126], [44, 45266], [47, 45446], [54, 45946], [57, 46106], [63, 46346]]}, {"verse": 7, "start": 47468, "end": 60262, "text": "Y como Booz hubo comido y bebido, y su corazón estuvo contento, se retiró a dormir a un lado del montón. Entonces ella vino calladamente, y descubrió los pies, y se acostó.", "words": [[0, 47468], [2, 47595], [7, 47885], [12, 48175], [17, 48735], [24, 49155], [26, 49255], [34, 49995], [36, 50215], [39, 50355], [47, 50755], [54, 51195], [64, 52255], [67, 52455], [74, 52975], [76, 53095], [83, 53315], [85, 53535], [88, 53635], [93, 53915], [97, 54155], [105, 55115], [114, 55717], [119, 56197], [124, 56457], [138, 57277], [140, 57797], [150, 58337], [154, 58477], [160, 58777], [162, 59517], [165, 59637]]}, {"verse": 8, "start": 60612, "end": 70021, "text": "Y aconteció, que a la media noche se estremeció aquel hombre, y se volvió: y he aquí, la mujer que estaba acostada a sus pies.", "words": [[0, 60612], [2, 60757], [13, 61557], [17, 61837], [19, 61937], [22, 62244], [28, 62550], [34, 62857], [37, 63337], [48, 64177], [54, 64517], [62, 64877], [64, 65417], [67, 65577], [75, 66476], [77, 66683], [80, 66823], [86, 67223], [89, 67478], [95, 67798], [99, 67998], [106, 68318], [115, 69078], [117, 69198], [121, 69338]]}, {"verse": 9, "start": 70371, "end": 81879, "text": "Entonces él dijo: ¿Quién eres? Y ella respondió: Yo soy Ruth tu sierva: extiende el borde de tu capa sobre tu sierva, por cuanto eres pariente cercano.", "words": [[0, 70371], [9, 71097], [12, 71577], [18, 72352], [25, 72616], [31, 73395], [33, 73596], [38, 73876], [49, 75094], [52, 75239], [56, 75480], [61, 75860], [64, 76000], [72, 76920], [81, 77466], [84, 77566], [90, 77886], [93, 78086], [96, 78206], [101, 78606], [107, 78826], [110, 79026], [118, 79766], [122, 80026], [129, 80286], [134, 80566], [143, 81046]]}, {"verse": 10, "start": 82159, "end": 92060, "text": "Y él dijo: Bendita seas tú de Jehová, hija mía; que has hecho mejor tu postrera bondad que la primera, no yendo tras los jóvenes, sean pobres o ricos.", "words": [[0, 82159], [2, 82345], [5, 82729], [11, 83539], [19, 83829], [24, 83989], [27, 84329], [30, 84489], [38, 84969], [43, 85369], [48, 85970], [52, 86060], [56, 86220], [62, 86380], [68, 86700], [71, 86860], [80, 87340], [87, 87800], [91, 87920], [94, 88040], [103, 88880], [106, 89000], [112, 89300], [117, 89500], [121, 89700], [130, 90520], [135, 90740], [142, 91280], [144, 91480]]}, {"verse": 11, "start": 92410, "end": 100107, "text": "Ahora pues, no temas, hija mía: yo haré contigo lo que tú digas, pues que toda la gente de mi pueblo sabe que eres mujer virtuosa.", "words": [[0, 92410], [6, 92727], [12, 92947], [15, 93167], [22, 93567], [27, 93867], [32, 94381], [35, 94531], [40, 94791], [48, 95211], [51, 95351], [55, 95471], [58, 95611], [65, 96371], [70, 96611], [74, 96791], [79, 96971], [82, 97171], [88, 97451], [91, 97651], [94, 97771], [101, 98071], [106, 98511], [110, 98731], [115, 98911], [121, 99251]]}, {"verse": 12, "start": 100457, "end": 105932, "text": "Y ahora, aunque es cierto que yo soy pariente cercano, con todo eso hay pariente más cercano que yo.", "words": [[0, 100457], [2, 100574], [9, 100934], [16, 101114], [19, 101274], [26, 101514], [30, 101694], [33, 101834], [37, 102014], [46, 102374], [55, 103334], [59, 103434], [64, 103674], [68, 103974], [72, 104254], [81, 104694], [85, 104914], [93, 105454], [97, 105594]]}, {"verse": 13, "start": 106282, "end": 117562, "text": "Reposa esta noche, y cuando sea de día, si él te redime, bien, que te redima; mas si él no te quiere redimir, yo te redimiré, vive Jehová. Descansa pues hasta la mañana.", "words": [[0, 106508], [7, 106768], [12, 107008], [19, 107348], [21, 107588], [28, 107808], [32, 108128], [35, 108288], [40, 108988], [43, 109218], [46, 109448], [49, 109568], [57, 109988], [63, 110268], [67, 110508], [70, 110628], [78, 111485], [82, 111565], [85, 111765], [88, 111925], [91, 112085], [94, 112205], [101, 112445], [110, 113345], [113, 113585], [116, 113725], [126, 114565], [131, 114745], [139, 115584], [148, 116186], [153, 116406], [159, 116826], [162, 116966]]}, {"verse": 14, "start": 117842, "end": 128851, "text": "Y después que reposó a sus pies hasta la mañana, se levantó, antes que pudieran reconocerse unos a otros. Y él dijo: No se sepa que haya venido mujer a la era.", "words": [[0, 117842], [2, 117945], [10, 118245], [14, 118485], [21, 119105], [23, 119205], [27, 119345], [32, 119645], [38, 119905], [41, 120065], [49, 121045], [52, 121145], [61, 121865], [67, 122545], [71, 122765], [80, 123285], [92, 124205], [97, 124565], [99, 124865], [106, 125640], [108, 125826], [111, 126210], [117, 126772], [120, 126897], [123, 127017], [128, 127297], [132, 127437], [137, 127597], [144, 127937], [150, 128197], [152, 128397], [155, 128477]]}, {"verse": 15, "start": 129131, "end": 140913, "text": "Después le dijo: Quítate el manto que traes sobre ti, y tenlo. Y teniéndolo ella, él midió seis medidas de cebada, y se las puso a cuestas: y se vino ella a la ciudad.", "words": [[0, 129131], [8, 129453], [11, 129653], [17, 130380], [25, 130817], [28, 130997], [34, 131317], [38, 131557], [44, 131797], [50, 131977], [54, 132277], [56, 132732], [63, 133433], [65, 133787], [76, 134177], [82, 134557], [85, 134837], [91, 135277], [96, 135697], [104, 136217], [107, 136477], [115, 136997], [117, 137577], [120, 137697], [124, 137837], [129, 138266], [131, 138694], [140, 139265], [142, 139372], [145, 139512], [150, 139752], [155, 140072], [157, 140212], [160, 140272]]}, {"verse": 16, "start": 141263, "end": 150383, "text": "Así que vino a su suegra, esta le dijo: ¿Qué pues, hija mía? Y le declaró ella todo lo que con aquel varón le había acontecido.", "words": [[0, 141263], [4, 141452], [8, 141632], [13, 141852], [15, 142012], [18, 142172], [26, 143132], [31, 143432], [34, 143612], [40, 144349], [45, 144450], [51, 144930], [56, 145190], [61, 146317], [63, 146438], [66, 146808], [74, 147178], [79, 147358], [84, 147718], [87, 147998], [91, 148158], [95, 148358], [101, 148638], [107, 148998], [110, 149138], [116, 149398]]}, {"verse": 17, "start": 150733, "end": 157715, "text": "Y dijo: Estas seis medidas de cebada me dio, diciéndome: Para que no vayas vacía a tu suegra.", "words": [[0, 150733], [2, 150873], [8, 151527], [14, 151952], [19, 152232], [27, 152772], [30, 153032], [37, 153512], [40, 153712], [45, 154272], [57, 155352], [62, 155534], [66, 155674], [69, 155914], [75, 156354], [81, 156874], [83, 156974], [86, 157074]]}, {"verse": 18, "start": 157995, "end": 169103, "text": "Entonces Noemí dijo: Reposa, hija mía, hasta que sepas cómo se resuelve el asunto: porque aquel hombre no parará hasta que hoy concluya el asunto.", "words": [[0, 157995], [9, 158821], [15, 159281], [21, 160395], [29, 161077], [34, 161857], [39, 162477], [45, 162757], [49, 162957], [55, 163357], [60, 163697], [63, 163897], [72, 164457], [75, 164557], [83, 165390], [90, 165574], [96, 165894], [103, 166114], [106, 166394], [113, 166954], [119, 167309], [123, 167529], [127, 167669], [136, 168309], [139, 168429]]}]}