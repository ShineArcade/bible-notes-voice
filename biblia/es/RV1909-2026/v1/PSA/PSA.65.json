{"book": "PSA", "chapter": 65, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 107823, "verses": [{"verse": 1, "start": 300, "end": 9728, "text": "Al Músico principal: Salmo: Cántico de David. A TI es plácida la alabanza en Sion, oh Dios: y a ti se pagarán los votos.", "words": [[0, 300], [3, 479], [10, 959], [21, 2105], [28, 2990], [36, 3436], [39, 3576], [46, 4310], [48, 4630], [51, 4750], [54, 4870], [62, 5510], [65, 5730], [74, 6105], [77, 6480], [83, 6855], [86, 7230], [92, 8036], [94, 8162], [96, 8222], [99, 8362], [102, 8502], [110, 9022], [114, 9162]]}, {"verse": 2, "start": 10178, "end": 13912, "text": "Tú oyes la oración: a ti vendrá toda carne.", "words": [[0, 10178], [3, 10540], [8, 10940], [11, 11160], [20, 12190], [22, 12410], [25, 12550], [32, 12990], [37, 13210]]}, {"verse": 3, "start": 14362, "end": 20835, "text": "Palabras de iniquidades me sobrepujaron: mas nuestras rebeliones tú las perdonarás.", "words": [[0, 14362], [9, 14703], [12, 14963], [24, 15703], [27, 16103], [41, 17645], [45, 17854], [54, 18534], [65, 19694], [68, 19754], [72, 19914]]}, {"verse": 4, "start": 21285, "end": 31210, "text": "Dichoso el que tú escoges, y haces llegar a ti, para que habite en tus atrios: seremos saciados del bien de tu casa, de tu santo templo.", "words": [[0, 21285], [8, 21893], [11, 22093], [15, 22233], [18, 22703], [27, 23173], [29, 23433], [35, 23753], [42, 24093], [44, 24333], [48, 24493], [53, 25073], [57, 25273], [64, 25473], [67, 25673], [71, 25893], [79, 26933], [87, 27395], [96, 28255], [100, 28595], [105, 28875], [108, 29095], [111, 29235], [117, 29775], [120, 29835], [123, 29975], [129, 30395]]}, {"verse": 5, "start": 31660, "end": 43711, "text": "Con tremendas cosas, en justicia, nos responderás tú, oh Dios de nuestra salvación, esperanza de todos los términos de la tierra, y de los más remotos confines del mar.", "words": [[0, 31660], [4, 31844], [14, 32444], [21, 32784], [24, 33084], [34, 34024], [38, 34224], [50, 35004], [54, 35434], [57, 35864], [62, 36204], [65, 36764], [73, 36944], [84, 38064], [94, 38724], [97, 38904], [103, 39244], [107, 39544], [116, 40124], [119, 40204], [122, 40324], [130, 40684], [132, 41204], [135, 41304], [139, 41444], [143, 41724], [151, 42524], [160, 43064], [164, 43284]]}, {"verse": 6, "start": 44161, "end": 48604, "text": "Tú, el que afirma los montes con su poder, ceñido de valentía:", "words": [[0, 44161], [4, 44725], [7, 44805], [11, 44925], [18, 45345], [22, 45465], [29, 45925], [33, 46085], [36, 46305], [43, 47085], [50, 47625], [53, 47745]]}, {"verse": 7, "start": 49054, "end": 55959, "text": "El que amansa el estruendo de los mares, el estruendo de sus ondas, y el alboroto de las naciones.", "words": [[0, 49054], [3, 49175], [7, 49485], [14, 49795], [17, 50095], [27, 50695], [30, 50835], [34, 50955], [41, 51815], [44, 52135], [54, 52715], [57, 52895], [61, 53035], [68, 53615], [70, 53875], [73, 54035], [82, 54775], [85, 54955], [89, 55115]]}, {"verse": 8, "start": 56409, "end": 65790, "text": "Por tanto los habitantes de los fines de la tierra temen de tus maravillas. Tú haces alegrar las salidas de la mañana y de la tarde.", "words": [[0, 56409], [4, 56531], [10, 57411], [14, 57771], [25, 58431], [28, 58611], [32, 58711], [38, 59031], [41, 59211], [44, 59351], [51, 59791], [57, 60791], [60, 61011], [64, 61231], [76, 62622], [79, 62747], [85, 63006], [93, 63587], [97, 63727], [105, 64187], [108, 64347], [111, 64446], [118, 64806], [120, 64987], [123, 65086], [126, 65207]]}, {"verse": 9, "start": 66240, "end": 78572, "text": "Visitas la tierra, y la riegas: en gran manera la enriqueces con el río de Dios, lleno de aguas: preparas el grano de ellos, cuando así la dispones.", "words": [[0, 66240], [8, 67000], [11, 67340], [19, 67740], [21, 67980], [24, 68080], [32, 69157], [35, 69341], [40, 69561], [47, 70061], [50, 70281], [61, 71041], [65, 71301], [68, 71481], [72, 71781], [75, 71901], [81, 72801], [87, 73321], [90, 73481], [97, 74708], [106, 74978], [109, 75178], [115, 75538], [118, 75718], [125, 76058], [132, 76698], [136, 76918], [139, 77138]]}, {"verse": 10, "start": 79022, "end": 87544, "text": "Haces se empapen sus surcos, haces descender sus canales: la ablandas con lluvias, bendices sus renuevos.", "words": [[0, 79022], [6, 79022], [9, 79224], [17, 79784], [21, 80004], [29, 80984], [35, 81364], [45, 82164], [49, 82364], [58, 83542], [61, 83934], [70, 84364], [74, 84584], [83, 85424], [92, 86264], [96, 86624]]}, {"verse": 11, "start": 87994, "end": 93084, "text": "Tú coronas el año de tus bienes; y tus nubes destilan abundancia.", "words": [[0, 87994], [3, 88098], [11, 88618], [14, 88758], [18, 88918], [21, 89098], [25, 89238], [33, 90203], [35, 90310], [39, 90430], [45, 91150], [54, 91870]]}, {"verse": 12, "start": 93534, "end": 99403, "text": "Destilan sobre las estancias del desierto; y los collados se ciñen de alegría.", "words": [[0, 93534], [9, 94140], [15, 94460], [19, 94700], [29, 95360], [33, 95580], [43, 96852], [45, 96961], [49, 97061], [58, 97641], [61, 98081], [67, 98561], [70, 98681]]}, {"verse": 13, "start": 99853, "end": 107423, "text": "Se visten los llanos de manadas, y los valles se cubren de grano: dan voces de júbilo, y aun cantan.", "words": [[0, 99853], [3, 100011], [10, 100371], [14, 100591], [21, 101051], [24, 101211], [33, 101731], [35, 102351], [39, 102511], [46, 102851], [49, 103051], [56, 103471], [59, 103611], [66, 104471], [70, 104661], [76, 105101], [79, 105261], [87, 105781], [89, 106381], [93, 106561]]}]}