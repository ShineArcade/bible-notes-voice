{"book": "PSA", "chapter": 66, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 120640, "verses": [{"verse": 1, "start": 300, "end": 6638, "text": "Al Músico principal: Cántico: Salmo. ACLAMAD a Dios con alegría, toda la tierra:", "words": [[0, 300], [3, 491], [10, 1051], [21, 2172], [30, 3032], [37, 4228], [45, 4558], [47, 4658], [52, 4758], [56, 5148], [65, 5538], [70, 5778], [73, 5978]]}, {"verse": 2, "start": 6988, "end": 11946, "text": "Cantad la gloria de su nombre: poned gloria en su alabanza.", "words": [[0, 6988], [7, 7548], [10, 7768], [17, 8188], [20, 8308], [23, 8468], [31, 9636], [37, 9942], [44, 10249], [47, 10349], [50, 10509]]}, {"verse": 3, "start": 12296, "end": 19292, "text": "Decid a Dios: ¡Cuán terribles tus obras! Por lo grande de tu fortaleza se someterán a ti tus enemigos.", "words": [[0, 12475], [6, 12660], [8, 12845], [14, 13250], [20, 13554], [30, 14134], [34, 14274], [41, 15225], [45, 15369], [48, 15569], [55, 15929], [58, 16149], [61, 16309], [71, 17129], [74, 17289], [84, 18009], [86, 18069], [89, 18129], [93, 18249]]}, {"verse": 4, "start": 19642, "end": 25769, "text": "Toda la tierra te adorará, y cantará a ti; cantarán a tu nombre. (Selah.)", "words": [[0, 19642], [5, 20254], [8, 20354], [15, 20774], [18, 21014], [27, 21674], [29, 22114], [37, 22734], [39, 22914], [43, 23410], [52, 24075], [54, 24235], [57, 24355], [65, 25491]]}, {"verse": 5, "start": 26119, "end": 32435, "text": "Venid, y ved las obras de Dios, temible en hechos sobre los hijos de los hombres.", "words": [[0, 26119], [7, 26684], [9, 26964], [13, 27204], [17, 27684], [23, 28164], [26, 28444], [32, 29264], [40, 29904], [43, 30144], [50, 30384], [56, 30844], [60, 31084], [66, 31404], [69, 31604], [73, 31724]]}, {"verse": 6, "start": 32785, "end": 38975, "text": "Volvió el mar en seco; por el río pasaron a pie; allí en él nos alegramos.", "words": [[0, 32785], [7, 33251], [10, 33391], [14, 33631], [17, 33971], [23, 34850], [27, 34995], [30, 35155], [34, 35495], [42, 35975], [44, 36095], [49, 36686], [54, 37166], [57, 37506], [60, 37766], [64, 38006]]}, {"verse": 7, "start": 39325, "end": 47749, "text": "Él gobierna para siempre con su poder: sus ojos atalayan sobre las naciones: los rebeldes no serán ensalzados. (Selah.)", "words": [[0, 39325], [3, 39572], [12, 39852], [17, 40412], [25, 40852], [29, 41212], [32, 41412], [39, 42155], [43, 42311], [48, 42821], [57, 43331], [63, 43551], [67, 43831], [77, 44685], [81, 44865], [90, 45425], [93, 45605], [99, 45985], [111, 47471]]}, {"verse": 8, "start": 48099, "end": 52922, "text": "Bendecid, pueblos, a nuestro Dios, y haced oír la voz de su alabanza.", "words": [[0, 48099], [10, 48805], [19, 49385], [21, 49665], [29, 49825], [35, 50245], [37, 50525], [43, 50825], [47, 51285], [50, 51545], [54, 51805], [57, 51985], [60, 52185]]}, {"verse": 9, "start": 53272, "end": 58785, "text": "Él es el que puso nuestra alma en vida, y no permitió que nuestros pies resbalasen.", "words": [[0, 53272], [3, 53579], [6, 53959], [9, 54119], [13, 54259], [18, 54719], [26, 54899], [31, 55359], [34, 55579], [40, 55879], [42, 56059], [45, 56219], [54, 56799], [58, 56939], [67, 57119], [72, 57579]]}, {"verse": 10, "start": 59135, "end": 63355, "text": "Porque tú nos probaste, oh Dios: nos ensayaste como se afina la plata.", "words": [[0, 59135], [7, 59299], [10, 59539], [14, 59659], [24, 60019], [27, 60379], [33, 61015], [37, 61161], [47, 61921], [52, 62181], [55, 62361], [61, 62661], [64, 62801]]}, {"verse": 11, "start": 63705, "end": 68119, "text": "Nos metiste en la red; pusiste pesada carga en nuestros lomos.", "words": [[0, 63705], [4, 63855], [12, 64355], [15, 64515], [18, 64840], [23, 65385], [31, 65830], [38, 66310], [44, 66790], [47, 66990], [56, 67210]]}, {"verse": 12, "start": 68469, "end": 75799, "text": "Hombres hiciste subir sobre nuestra cabeza; entramos en fuego y en aguas, y nos sacaste a abundancia.", "words": [[0, 68469], [8, 68913], [16, 69593], [22, 69953], [28, 70313], [36, 70593], [44, 71619], [53, 72116], [56, 72376], [62, 72656], [64, 72916], [67, 73076], [74, 73656], [76, 74056], [80, 74216], [88, 74506], [90, 74796]]}, {"verse": 13, "start": 76149, "end": 80139, "text": "Entraré en tu casa con holocaustos: te pagaré mis votos,", "words": [[0, 76149], [8, 76924], [11, 77144], [14, 77324], [19, 77624], [23, 78169], [36, 78934], [39, 79179], [46, 79559], [50, 79719]]}, {"verse": 14, "start": 80489, "end": 84969, "text": "Que pronunciaron mis labios, y habló mi boca, cuando angustiado estaba.", "words": [[0, 80489], [4, 80573], [17, 81333], [21, 81533], [29, 82093], [31, 82353], [37, 82713], [40, 82833], [46, 83153], [53, 83533], [64, 84333]]}, {"verse": 15, "start": 85319, "end": 93132, "text": "Holocaustos de cebados te ofreceré, con perfume de carneros: sacrificaré bueyes y machos cabríos. (Selah.)", "words": [[0, 85319], [12, 86167], [15, 86287], [23, 86747], [26, 86907], [36, 87527], [40, 87907], [48, 88427], [51, 88944], [61, 89646], [73, 90389], [80, 91169], [82, 91309], [89, 91862], [98, 92855]]}, {"verse": 16, "start": 93482, "end": 98803, "text": "Venid, oíd todos los que teméis a Dios, y contaré lo que ha hecho a mi alma.", "words": [[0, 93482], [7, 93957], [11, 94467], [17, 94807], [21, 95147], [25, 95327], [32, 95787], [34, 95967], [40, 96207], [42, 96687], [50, 97207], [53, 97347], [57, 97507], [60, 97667], [66, 97927], [68, 98067], [71, 98227]]}, {"verse": 17, "start": 99153, "end": 103657, "text": "A él clamé con mi boca, y ensalzado fue con mi lengua.", "words": [[0, 99153], [2, 99467], [5, 99707], [11, 100107], [15, 100327], [18, 100507], [24, 100867], [26, 101367], [36, 102307], [40, 102547], [44, 102787], [47, 103007]]}, {"verse": 18, "start": 104007, "end": 109278, "text": "Si en mi corazón hubiese yo mirado a la iniquidad, el Señor no me oyera.", "words": [[0, 104007], [3, 104191], [6, 104331], [9, 104491], [17, 104991], [25, 105611], [28, 105851], [35, 106331], [37, 106451], [40, 106571], [51, 107551], [54, 107631], [60, 107991], [63, 108571], [66, 108711]]}, {"verse": 19, "start": 109628, "end": 114219, "text": "Mas ciertamente me oyó Dios; atendió a la voz de mi súplica.", "words": [[0, 109628], [4, 110111], [16, 110971], [19, 111171], [23, 111451], [29, 112229], [37, 112756], [39, 112896], [42, 112996], [46, 113216], [49, 113376], [52, 113476]]}, {"verse": 20, "start": 114569, "end": 120239, "text": "Bendito Dios, que no echó de sí mi oración, ni de mí su misericordia.", "words": [[0, 114569], [8, 115194], [14, 115474], [18, 115754], [21, 116074], [26, 116394], [29, 116594], [32, 116854], [35, 117194], [44, 118214], [47, 118494], [50, 118654], [53, 118854], [56, 119074]]}]}