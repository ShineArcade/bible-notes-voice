{"book": "PSA", "chapter": 77, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 128691, "verses": [{"verse": 1, "start": 300, "end": 8907, "text": "Al Músico principal: para Jedutún: Salmo de Asaf. CON mi voz clamé a Dios, a Dios clamé, y él me escuchará.", "words": [[0, 300], [3, 468], [10, 968], [21, 2052], [26, 2520], [35, 3183], [41, 3684], [44, 3864], [50, 4484], [54, 4607], [57, 4807], [61, 5507], [67, 5807], [69, 5947], [75, 6447], [77, 6507], [82, 6687], [89, 7647], [91, 7747], [94, 7927], [97, 8087]]}, {"verse": 2, "start": 9257, "end": 17623, "text": "Al Señor busqué en el día de mi angustia: mi mal corría de noche, y no cesaba: mi alma rehusaba consuelo.", "words": [[0, 9257], [3, 9404], [9, 9704], [16, 10284], [19, 10564], [22, 10704], [26, 10924], [29, 11104], [32, 11224], [42, 12239], [45, 12406], [49, 12706], [56, 13286], [59, 13426], [66, 13846], [68, 14246], [71, 14386], [79, 15422], [82, 15589], [87, 15889], [96, 16689]]}, {"verse": 3, "start": 17973, "end": 23512, "text": "Me acordaba de Dios, y gritaba: me quejaba, y desmayaba mi espíritu. (Selah.)", "words": [[0, 17973], [3, 18081], [12, 18581], [15, 18741], [21, 19061], [23, 19406], [32, 20381], [35, 20489], [44, 21049], [46, 21229], [56, 21809], [59, 22009], [69, 23230]]}, {"verse": 4, "start": 23862, "end": 28600, "text": "Tenías los párpados de mis ojos: estaba yo quebrantado, y no hablaba.", "words": [[0, 23862], [7, 24351], [11, 24511], [20, 25091], [23, 25251], [27, 25371], [33, 26308], [40, 26675], [43, 26855], [56, 27655], [58, 27775], [61, 27915]]}, {"verse": 5, "start": 28950, "end": 33683, "text": "Consideraba los días desde el principio, los años de los siglos.", "words": [[0, 28950], [12, 29847], [16, 30047], [21, 30347], [27, 30767], [30, 31027], [41, 32087], [45, 32287], [50, 32587], [53, 32767], [57, 33247]]}, {"verse": 6, "start": 34033, "end": 40436, "text": "Me acordaba de mis canciones de noche; meditaba con mi corazón, y mi espíritu inquiría.", "words": [[0, 34033], [3, 34139], [12, 34699], [15, 34839], [19, 34959], [29, 35499], [32, 35659], [39, 36451], [48, 37153], [52, 37373], [55, 37613], [64, 38113], [66, 38693], [69, 38853], [78, 39593]]}, {"verse": 7, "start": 40786, "end": 44593, "text": "¿Desechará el Señor para siempre, y no volverá más a amar?", "words": [[0, 40786], [11, 41412], [14, 41572], [20, 41872], [25, 42232], [34, 42812], [36, 43097], [39, 43237], [47, 43717], [51, 43957], [53, 44077]]}, {"verse": 8, "start": 44943, "end": 51666, "text": "¿Se ha acabado para siempre su misericordia? ¿se ha acabado la palabra suya para generación y generación?", "words": [[0, 44943], [4, 45106], [7, 45226], [15, 45666], [20, 45886], [28, 46266], [31, 46486], [45, 47780], [49, 47940], [52, 48100], [60, 48600], [63, 48720], [71, 49020], [76, 49600], [81, 49820], [92, 50620], [94, 50800]]}, {"verse": 9, "start": 52016, "end": 58684, "text": "¿Ha olvidado Dios el tener misericordia? ¿ha encerrado con ira sus piedades? (Selah.)", "words": [[0, 52016], [4, 52276], [13, 52856], [18, 53156], [21, 53676], [27, 53956], [41, 55372], [45, 55540], [55, 56180], [59, 56450], [63, 56720], [67, 56920], [77, 58423]]}, {"verse": 10, "start": 59034, "end": 65746, "text": "Y dije: Enfermedad mía es esta; traeré pues a la memoria los años de la diestra del Altísimo.", "words": [[0, 59034], [2, 59181], [8, 59914], [19, 60763], [23, 61123], [26, 61303], [32, 62088], [39, 62590], [44, 62690], [46, 62890], [49, 62970], [57, 63430], [61, 63610], [66, 63930], [69, 64110], [72, 64230], [80, 64670], [84, 64850]]}, {"verse": 11, "start": 66096, "end": 71384, "text": "Me acordaré de las obras de JAH: sí, haré yo memoria de tus maravillas antiguas.", "words": [[0, 66096], [3, 66183], [12, 66743], [15, 66863], [19, 67023], [25, 67283], [28, 67645], [33, 68177], [37, 68681], [42, 68901], [45, 69081], [53, 69581], [56, 69761], [60, 69921], [71, 70521]]}, {"verse": 12, "start": 71734, "end": 75864, "text": "Y meditaré en todas tus obras, y hablaré de tus hechos.", "words": [[0, 71734], [2, 71994], [11, 72674], [14, 72894], [20, 73174], [24, 73534], [31, 73954], [33, 74474], [41, 74934], [44, 75054], [48, 75274]]}, {"verse": 13, "start": 76214, "end": 81365, "text": "Oh Dios, en santidad es tu camino: ¿qué Dios grande como el Dios nuestro?", "words": [[0, 76214], [3, 76646], [9, 77086], [12, 77226], [21, 77906], [24, 78246], [27, 78366], [35, 79206], [40, 79313], [45, 79533], [52, 79993], [57, 80293], [60, 80453], [65, 80633]]}, {"verse": 14, "start": 81715, "end": 87786, "text": "Tú eres el Dios que hace maravillas: tú hiciste notoria en los pueblos tu fortaleza.", "words": [[0, 81715], [3, 81837], [8, 82077], [11, 82277], [16, 82537], [20, 82817], [25, 83017], [37, 84216], [40, 84597], [48, 85317], [56, 85937], [59, 86117], [63, 86237], [71, 86717], [74, 86837]]}, {"verse": 15, "start": 88136, "end": 93606, "text": "Con tu brazo redimiste a tu pueblo, a los hijos de Jacob y de José. (Selah.)", "words": [[0, 88136], [4, 88278], [7, 88438], [13, 89158], [23, 89878], [25, 90018], [28, 90098], [36, 90838], [38, 90898], [42, 91018], [48, 91298], [51, 91618], [57, 91938], [59, 92118], [62, 92218], [68, 93291]]}, {"verse": 16, "start": 93956, "end": 100460, "text": "Te vieron las aguas, oh Dios; te vieron las aguas, temieron; y temblaron los abismos.", "words": [[0, 93956], [3, 94058], [10, 94318], [14, 94538], [21, 95278], [24, 95678], [30, 96421], [33, 96522], [40, 96802], [44, 97022], [51, 97707], [61, 98552], [63, 98677], [73, 99437], [77, 99577]]}, {"verse": 17, "start": 100810, "end": 107287, "text": "Las nubes echaron inundaciones de aguas; tronaron los cielos, y corrieron tus rayos.", "words": [[0, 100810], [4, 100921], [10, 101521], [18, 102221], [31, 103061], [34, 103361], [41, 104194], [50, 104874], [54, 105094], [62, 105754], [64, 105874], [74, 106374], [78, 106831]]}, {"verse": 18, "start": 107637, "end": 116060, "text": "Anduvo en derredor el sonido de tus truenos; los relámpagos alumbraron el mundo; se estremeció y tembló la tierra.", "words": [[0, 107637], [7, 108124], [10, 108304], [19, 108904], [22, 109124], [29, 109684], [32, 109844], [36, 110024], [45, 111111], [49, 111216], [60, 111916], [71, 112576], [74, 112776], [81, 113544], [84, 113721], [95, 114541], [97, 114801], [104, 115301], [107, 115421]]}, {"verse": 19, "start": 116410, "end": 123281, "text": "En el mar fue tu camino, y tus sendas en las muchas aguas; y tus pisadas no fueron conocidas.", "words": [[0, 116410], [3, 116532], [6, 116672], [10, 116912], [14, 117132], [17, 117332], [25, 117812], [27, 118312], [31, 118472], [38, 119092], [41, 119252], [45, 119412], [52, 119692], [59, 120707], [61, 120834], [65, 121014], [73, 121634], [76, 121954], [83, 122214]]}, {"verse": 20, "start": 123631, "end": 128291, "text": "Condujiste a tu pueblo como ovejas, por mano de Moisés y de Aarón.", "words": [[0, 123631], [11, 124193], [13, 124333], [16, 124393], [23, 124773], [28, 125133], [36, 126133], [40, 126413], [45, 126653], [48, 126853], [55, 127273], [57, 127533], [60, 127924]]}]}