{"book": "JHN", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 366136, "verses": [{"verse": 1, "start": 300, "end": 7120, "text": "Después de estas cosas, era un día de fiesta de los judíos, y subió Jesús a Jerusalén.", "words": [[0, 300], [8, 604], [11, 864], [17, 1084], [24, 2184], [28, 2504], [31, 2684], [35, 2844], [38, 3024], [45, 3484], [48, 3624], [52, 3804], [60, 4484], [62, 5004], [68, 5404], [74, 5784], [76, 6164]]}, {"verse": 2, "start": 7470, "end": 16694, "text": "Y hay en Jerusalén a la puerta del ganado un estanque, que en hebreo es llamado Betesda, el cual tiene cinco portales.", "words": [[0, 7470], [2, 7596], [6, 7736], [9, 7916], [19, 8696], [21, 8856], [24, 8976], [31, 9256], [35, 9556], [42, 10156], [45, 10416], [55, 11116], [59, 11796], [62, 12076], [69, 12536], [72, 12716], [80, 13376], [89, 14036], [92, 14216], [97, 14436], [103, 14856], [109, 15516]]}, {"verse": 3, "start": 17044, "end": 25769, "text": "En estos yacía multitud de enfermos, ciegos, cojos, con miembros atrofiados, que estaban esperando el movimiento del agua.", "words": [[0, 17044], [3, 17216], [9, 17796], [15, 18296], [24, 18976], [27, 19216], [37, 20356], [45, 21096], [52, 22076], [56, 22176], [65, 22676], [77, 23416], [81, 23616], [89, 23896], [99, 24276], [102, 24556], [113, 24956], [117, 25336]]}, {"verse": 4, "start": 26119, "end": 39982, "text": "Porque un ángel descendía a cierto tiempo al estanque, y revolvía el agua; y el que primero descendía en el estanque después del movimiento del agua, era sano de cualquier enfermedad que tuviese.", "words": [[0, 26119], [7, 26439], [10, 26659], [16, 27159], [26, 27859], [28, 28099], [35, 28359], [42, 29039], [45, 29339], [55, 30019], [57, 30609], [66, 31199], [69, 31399], [75, 32194], [77, 32340], [80, 32480], [84, 32640], [92, 33160], [102, 34040], [105, 34280], [108, 34420], [117, 35040], [125, 35360], [129, 35640], [140, 36160], [144, 36560], [150, 36920], [154, 37480], [159, 37840], [162, 38020], [172, 38320], [183, 39160], [187, 39280]]}, {"verse": 5, "start": 40332, "end": 44557, "text": "Y estaba allí un hombre que había treinta y ocho años que estaba enfermo.", "words": [[0, 40332], [2, 40440], [9, 40740], [14, 41060], [17, 41240], [24, 41560], [28, 41780], [34, 41980], [42, 42180], [44, 42380], [49, 42580], [54, 43320], [58, 43540], [65, 43800]]}, {"verse": 6, "start": 44907, "end": 51981, "text": "Como Jesús vio a este echado, y entendió que ya había mucho tiempo, le dice: ¿Quieres ser sano?", "words": [[0, 44907], [5, 45071], [11, 45411], [15, 46091], [17, 46311], [22, 46631], [30, 47311], [32, 47931], [41, 48571], [45, 48751], [48, 49011], [54, 49191], [60, 49491], [68, 50051], [71, 50131], [77, 50839], [86, 51183], [90, 51343]]}, {"verse": 7, "start": 52201, "end": 60647, "text": "Señor, le respondió el enfermo, no tengo quien me meta en el estanque cuando el agua sea revuelta; y mientras voy, otro desciende antes que yo.", "words": [[0, 52201], [7, 52966], [10, 53088], [20, 53668], [23, 53788], [32, 54748], [35, 54895], [41, 55215], [47, 55415], [50, 55575], [55, 55835], [58, 55955], [61, 56055], [70, 56535], [77, 56755], [80, 56935], [85, 57135], [89, 57335], [99, 58232], [101, 58334], [110, 58634], [115, 58974], [120, 59414], [130, 59914], [136, 60114], [140, 60334]]}, {"verse": 8, "start": 60927, "end": 64360, "text": "Le dice Jesús: Levántate, toma tu lecho, y anda.", "words": [[0, 60927], [3, 61075], [8, 61315], [15, 62243], [26, 62948], [31, 63168], [34, 63358], [41, 63548], [43, 63888]]}, {"verse": 9, "start": 64710, "end": 71874, "text": "Y de inmediato aquel hombre fue sanado, y tomó su lecho, e iba andando. Y era sábado aquel día.", "words": [[0, 64710], [2, 64838], [5, 64938], [15, 65538], [21, 65818], [28, 66018], [32, 66258], [40, 66818], [42, 67358], [47, 67658], [50, 67758], [57, 68198], [59, 68618], [63, 68838], [72, 69820], [74, 70100], [78, 70300], [85, 70920], [91, 71440]]}, {"verse": 10, "start": 72224, "end": 79888, "text": "Entonces los judíos decían a aquel que había sido sanado: Sábado es: no te es lícito llevar tu lecho.", "words": [[0, 72224], [9, 72977], [13, 73100], [20, 73740], [27, 74580], [29, 74800], [35, 75140], [39, 75280], [45, 75520], [50, 75940], [58, 77216], [65, 77542], [69, 78028], [72, 78192], [75, 78445], [78, 78699], [85, 78952], [92, 79172], [95, 79412]]}, {"verse": 11, "start": 80168, "end": 84758, "text": "Les respondió: El que me sanó, él mismo me dijo: Toma tu lecho y anda.", "words": [[0, 80168], [4, 80321], [15, 81365], [18, 81488], [22, 81588], [25, 81728], [31, 82328], [34, 82468], [40, 82748], [43, 82928], [49, 83586], [54, 83807], [57, 83907], [63, 84207], [65, 84387]]}, {"verse": 12, "start": 85038, "end": 89756, "text": "Le preguntaron entonces: ¿Quién es el que te dijo: Toma tu lecho y anda?", "words": [[0, 85038], [3, 85163], [15, 85903], [25, 87221], [32, 87427], [35, 87527], [38, 87647], [42, 87747], [45, 87887], [51, 88533], [56, 88789], [59, 88889], [65, 89209], [67, 89389]]}, {"verse": 13, "start": 90036, "end": 98267, "text": "Y el que había sido sanado, no sabía quién fuese; porque Jesús se había apartado de la gente que estaba en aquel lugar.", "words": [[0, 90036], [2, 90203], [5, 90323], [9, 90503], [15, 90703], [20, 91103], [28, 92063], [31, 92403], [37, 92863], [43, 93163], [50, 94149], [57, 94373], [63, 94813], [66, 95073], [72, 95313], [81, 96053], [84, 96213], [87, 96333], [93, 96653], [97, 96853], [104, 97153], [107, 97313], [113, 97613]]}, {"verse": 14, "start": 98616, "end": 108493, "text": "Después le halló Jesús en el templo, y le dijo: He aquí, has sido sanado; no peques más, porque no te venga alguna cosa peor.", "words": [[0, 98712], [8, 99336], [11, 99576], [17, 100036], [23, 100496], [26, 100976], [29, 101116], [37, 101756], [39, 101856], [42, 101996], [48, 102810], [51, 102900], [57, 103250], [61, 103600], [66, 103960], [74, 104882], [77, 105068], [84, 105408], [89, 106168], [96, 106568], [99, 106768], [102, 106908], [108, 107208], [115, 107488], [120, 107848]]}, {"verse": 15, "start": 108843, "end": 113742, "text": "Él se fue, y dio aviso a los judíos, que Jesús era el que le había sanado.", "words": [[0, 108843], [3, 108990], [6, 109170], [11, 109450], [13, 109730], [17, 109950], [23, 110290], [25, 110430], [29, 110530], [37, 111330], [41, 111550], [47, 111850], [51, 112310], [54, 112470], [58, 112610], [61, 112770], [67, 113010]]}, {"verse": 16, "start": 114092, "end": 121830, "text": "Y por esta causa los judíos perseguían a Jesús, y procuraban matarle, porque hacía estas cosas en sábado.", "words": [[0, 114092], [2, 114233], [6, 114453], [11, 114713], [17, 115173], [21, 115453], [28, 115953], [39, 116653], [41, 116753], [48, 117093], [50, 117673], [61, 118373], [70, 119533], [77, 119933], [83, 120313], [89, 120573], [95, 120913], [98, 121193]]}, {"verse": 17, "start": 122180, "end": 128043, "text": "Y Jesús les respondió: Mi Padre hasta ahora trabaja, y yo trabajo.", "words": [[0, 122180], [2, 122530], [8, 122940], [12, 123350], [23, 124364], [26, 124509], [32, 124769], [38, 125149], [44, 125429], [53, 126294], [55, 126494], [58, 126634]]}, {"verse": 18, "start": 128393, "end": 139998, "text": "Entonces, por tanto, más procuraban los judíos matarle, porque no sólo quebrantaba el sábado, sino que también a su Padre llamaba Dios, haciéndose igual a Dios.", "words": [[0, 128393], [10, 129119], [14, 129200], [21, 129851], [25, 130502], [36, 131154], [40, 131314], [47, 131834], [56, 132594], [63, 133134], [66, 133394], [71, 133674], [83, 134454], [86, 134614], [94, 135474], [99, 135654], [103, 135854], [111, 136194], [113, 136334], [116, 136454], [122, 136714], [130, 137194], [136, 137914], [147, 138594], [153, 139074], [155, 139434]]}, {"verse": 19, "start": 140348, "end": 155110, "text": "Respondió entonces Jesús, y les dijo: De cierto, de cierto os digo: No puede el Hijo hacer nada de sí mismo, sino lo que ve hacer al Padre: porque todo lo que él hace, esto también hace el Hijo juntamente.", "words": [[0, 140508], [10, 141008], [19, 141268], [26, 141908], [28, 142268], [32, 142388], [38, 143416], [41, 143672], [49, 143928], [52, 144184], [59, 144440], [62, 144640], [68, 145413], [71, 145604], [77, 145964], [80, 146324], [85, 146604], [91, 146904], [96, 147384], [99, 147644], [102, 147844], [109, 148584], [114, 148824], [117, 149004], [121, 149124], [124, 149364], [130, 149484], [133, 149664], [140, 150419], [147, 150623], [152, 151063], [155, 151343], [159, 151523], [162, 151703], [168, 152263], [173, 152563], [181, 152963], [186, 153403], [189, 153783], [194, 154063]]}, {"verse": 20, "start": 155460, "end": 166084, "text": "Porque el Padre ama al Hijo, y le muestra todas las cosas que él hace; y mayores obras que estas le mostrará, de suerte que vosotros os maravilléis.", "words": [[0, 155460], [7, 155702], [10, 155862], [16, 156362], [20, 156642], [23, 156962], [29, 157282], [31, 157942], [34, 158062], [42, 158562], [48, 158822], [52, 159142], [58, 159482], [62, 159782], [65, 159982], [71, 160853], [73, 160962], [81, 161422], [87, 161722], [91, 161962], [97, 162202], [100, 162442], [110, 163102], [113, 163602], [120, 164082], [124, 164282], [133, 164802], [136, 165042]]}, {"verse": 21, "start": 166434, "end": 173060, "text": "Porque como el Padre levanta los muertos, y les da vida, así también el Hijo a los que quiere da vida.", "words": [[0, 166434], [7, 166678], [12, 166958], [15, 167138], [21, 167698], [29, 168218], [33, 168338], [42, 168958], [44, 169558], [48, 169678], [51, 169898], [57, 170523], [61, 170783], [69, 171070], [72, 171356], [77, 171643], [79, 171823], [83, 171923], [87, 172063], [94, 172313], [97, 172563]]}, {"verse": 22, "start": 173410, "end": 178139, "text": "Porque el Padre a nadie juzga, sino que todo el juicio dio al Hijo;", "words": [[0, 173410], [7, 173632], [10, 173812], [16, 174332], [18, 174452], [24, 174772], [31, 175672], [36, 175992], [40, 176192], [45, 176432], [48, 176692], [55, 177132], [59, 177432], [62, 177712]]}, {"verse": 23, "start": 178489, "end": 187413, "text": "Para que todos honren al Hijo como honran al Padre. El que no honra al Hijo, no honra al Padre que le envió.", "words": [[0, 178489], [5, 178631], [9, 178791], [15, 179071], [22, 179851], [25, 180191], [30, 180531], [35, 180851], [42, 181491], [45, 181691], [52, 182535], [55, 182656], [59, 182816], [62, 182996], [68, 183536], [71, 183776], [77, 184716], [80, 184876], [86, 185536], [89, 185756], [95, 186356], [99, 186496], [102, 186676]]}, {"verse": 24, "start": 187763, "end": 199699, "text": "De cierto, de cierto os digo: El que oye mi palabra, y cree al que me ha enviado, tiene vida eterna; y no vendrá a condenación, sino que pasó de muerte a vida.", "words": [[0, 187981], [3, 188237], [11, 188493], [14, 188749], [21, 189005], [24, 189205], [30, 189979], [33, 190138], [37, 190338], [41, 190718], [44, 190878], [53, 191438], [55, 191778], [60, 192078], [63, 192358], [67, 192538], [70, 192698], [73, 192818], [82, 193418], [88, 194038], [93, 194458], [101, 195664], [103, 195785], [106, 195905], [113, 196265], [115, 196365], [128, 197605], [133, 197965], [137, 198145], [142, 198445], [145, 198625], [152, 198945], [154, 199165]]}, {"verse": 25, "start": 200049, "end": 209560, "text": "De cierto, de cierto os digo: Vendrá hora, y ahora es, cuando los muertos oirán la voz del Hijo de Dios: y los que oyen vivirán.", "words": [[0, 200268], [3, 200524], [11, 200780], [14, 201036], [21, 201292], [24, 201492], [30, 202265], [37, 202711], [43, 203111], [45, 203591], [51, 203851], [55, 204191], [62, 204611], [66, 204851], [74, 205291], [80, 205951], [83, 206151], [87, 206431], [91, 206751], [96, 207031], [99, 207171], [105, 208044], [107, 208166], [111, 208306], [115, 208486], [120, 209055]]}, {"verse": 26, "start": 209910, "end": 215968, "text": "Porque como el Padre tiene vida en sí mismo, así dio también al Hijo que tuviese vida en sí mismo:", "words": [[0, 209910], [7, 210094], [12, 210374], [15, 210534], [21, 210954], [27, 211174], [32, 211494], [35, 211674], [38, 211854], [45, 212694], [49, 213034], [53, 213254], [61, 213614], [64, 213854], [69, 214154], [73, 214334], [81, 214774], [86, 215094], [89, 215294], [92, 215454]]}, {"verse": 27, "start": 216318, "end": 221067, "text": "Y también le dio poder de hacer juicio, en cuanto es el Hijo del hombre.", "words": [[0, 216318], [2, 216423], [10, 216763], [13, 217003], [17, 217183], [23, 217543], [26, 217783], [32, 217983], [40, 218683], [43, 219283], [50, 219503], [53, 219843], [56, 220003], [61, 220243], [65, 220503]]}, {"verse": 28, "start": 221417, "end": 229246, "text": "No os maravilléis de esto; porque vendrá hora, cuando todos los que están en los sepulcros oirán su voz;", "words": [[0, 221417], [3, 221827], [6, 222277], [18, 222727], [21, 222947], [27, 223737], [34, 223941], [41, 224421], [47, 225181], [54, 225541], [60, 225941], [64, 226241], [68, 226421], [74, 226661], [77, 226821], [81, 226961], [91, 227721], [97, 228441], [100, 228681]]}, {"verse": 29, "start": 229596, "end": 237863, "text": "Y los que hicieron bien, saldrán a resurrección de vida; pero los que hicieron mal, a resurrección de condenación.", "words": [[0, 229596], [2, 229718], [6, 229838], [10, 230018], [19, 230498], [25, 230838], [33, 232078], [35, 232238], [48, 233038], [51, 233218], [57, 233936], [62, 234161], [66, 234381], [70, 234561], [79, 235021], [84, 235421], [86, 235881], [99, 236681], [102, 236821]]}, {"verse": 30, "start": 238213, "end": 249563, "text": "No puedo yo de mí mismo hacer nada: como oigo, juzgo: y mi juicio es justo; porque no busco mi voluntad, sino la voluntad del que me envió, del Padre.", "words": [[0, 238213], [3, 238341], [9, 238581], [12, 238861], [15, 239021], [18, 239181], [24, 239501], [30, 239781], [36, 240736], [41, 240941], [47, 241541], [54, 242752], [56, 242876], [59, 242976], [66, 243416], [69, 243696], [76, 244520], [83, 244721], [86, 244921], [92, 245241], [95, 245401], [105, 246321], [110, 246541], [113, 246761], [122, 247481], [126, 247721], [130, 247901], [133, 248081], [140, 248701], [144, 248921]]}, {"verse": 31, "start": 249913, "end": 254384, "text": "Si yo doy testimonio de mí mismo, mi testimonio no es verdadero.", "words": [[0, 249913], [3, 250095], [6, 250295], [10, 250535], [21, 251175], [24, 251295], [27, 251435], [34, 252095], [37, 252235], [48, 253035], [51, 253295], [54, 253515]]}, {"verse": 32, "start": 254734, "end": 261049, "text": "Otro es el que da testimonio de mí; y sé que el testimonio que da de mí, es verdadero.", "words": [[0, 254734], [5, 255097], [8, 255277], [11, 255417], [15, 255577], [18, 255797], [29, 256597], [32, 256737], [36, 257310], [38, 257437], [41, 257657], [45, 257857], [48, 258057], [59, 258877], [63, 258997], [66, 259157], [69, 259317], [73, 259497], [76, 260117]]}, {"verse": 33, "start": 261399, "end": 265472, "text": "Vosotros enviasteis a Juan, y él dio testimonio a la verdad.", "words": [[0, 261399], [9, 261845], [20, 262725], [22, 262845], [28, 263165], [30, 263520], [33, 263740], [37, 263940], [48, 264700], [50, 264800], [53, 264880]]}, {"verse": 34, "start": 265822, "end": 272106, "text": "Pero yo no tomo el testimonio de hombre; pero digo esto, para que vosotros seáis salvos.", "words": [[0, 265822], [5, 265966], [8, 266146], [11, 266326], [16, 266706], [19, 266786], [30, 267406], [33, 267526], [41, 268285], [46, 268451], [51, 268751], [57, 269418], [62, 269618], [66, 269778], [75, 270398], [81, 271078]]}, {"verse": 35, "start": 272456, "end": 279546, "text": "Él era antorcha que ardía y alumbraba: y vosotros quisisteis alegraros por un tiempo en su luz.", "words": [[0, 272456], [3, 272828], [7, 273068], [16, 273888], [20, 274088], [26, 274568], [28, 274728], [39, 275775], [41, 275902], [50, 276402], [61, 277222], [71, 277902], [75, 278142], [78, 278302], [85, 278682], [88, 278902], [91, 279062]]}, {"verse": 36, "start": 279896, "end": 292707, "text": "Pero yo tengo mayor testimonio que el de Juan: porque las obras que el Padre me dio que cumpliese, las mismas obras que yo hago, dan testimonio de mí, que el Padre me haya enviado.", "words": [[0, 279896], [5, 280040], [8, 280200], [14, 280500], [20, 280840], [31, 281700], [35, 281880], [38, 282320], [41, 282480], [47, 283329], [54, 283553], [58, 283753], [64, 284113], [68, 284393], [71, 284573], [77, 285173], [80, 285333], [84, 285553], [88, 285713], [99, 286833], [103, 286933], [110, 287353], [116, 287653], [120, 287853], [123, 288093], [129, 288433], [133, 288973], [144, 289673], [147, 289813], [151, 290033], [155, 290553], [158, 290713], [164, 291433], [167, 291613], [172, 291893]]}, {"verse": 37, "start": 293057, "end": 301758, "text": "Y el que me envió, el Padre, él ha dado testimonio de mí. Ni nunca habéis oído su voz, ni habéis visto su aspecto.", "words": [[0, 293057], [2, 293218], [5, 293338], [9, 293538], [12, 293718], [19, 294138], [22, 294438], [29, 295358], [32, 295551], [35, 295745], [40, 295938], [51, 296698], [54, 296798], [58, 297426], [61, 297614], [67, 298114], [74, 298714], [79, 299054], [82, 299254], [87, 300034], [90, 300214], [97, 300554], [103, 300994], [106, 301294]]}, {"verse": 38, "start": 302108, "end": 309240, "text": "Ni tenéis su palabra permanente en vosotros; porque al que él envió, a este vosotros no creéis.", "words": [[0, 302382], [3, 302692], [10, 303112], [13, 303432], [21, 303792], [32, 304512], [35, 304652], [45, 305620], [52, 305822], [55, 306022], [59, 306162], [62, 306342], [69, 307062], [71, 307422], [76, 307602], [85, 308162], [88, 308382]]}, {"verse": 39, "start": 309590, "end": 319667, "text": "Examinad cuidadosamente las Escrituras, porque a vosotros os parece que en ellas tenéis la vida eterna; y ellas son las que dan testimonio de mí.", "words": [[0, 309590], [9, 310460], [24, 311380], [28, 311660], [40, 312640], [47, 313000], [49, 313160], [58, 313780], [61, 314220], [68, 314560], [72, 314840], [75, 314980], [81, 315200], [88, 315740], [91, 315920], [96, 316140], [104, 317130], [106, 317288], [112, 317528], [116, 317848], [120, 318068], [124, 318248], [128, 318428], [139, 319208], [142, 319328]]}, {"verse": 40, "start": 320017, "end": 322450, "text": "Y no queréis venir a mí, para que tengáis vida.", "words": [[0, 320017], [2, 320120], [5, 320240], [13, 320620], [19, 320840], [21, 321080], [25, 321200], [30, 321380], [34, 321540], [42, 321940]]}, {"verse": 41, "start": 322800, "end": 324710, "text": "Gloria de los hombres no recibo.", "words": [[0, 322800], [7, 323245], [10, 323365], [14, 323505], [22, 323825], [25, 324065]]}, {"verse": 42, "start": 325060, "end": 328528, "text": "Pero yo os conozco, que no tenéis amor de Dios en vosotros.", "words": [[0, 325060], [5, 325182], [8, 325422], [11, 325562], [20, 326062], [24, 326202], [27, 326342], [34, 326782], [39, 327062], [42, 327282], [47, 327522], [50, 327762]]}, {"verse": 43, "start": 328878, "end": 336310, "text": "Yo he venido en nombre de mi Padre, y no me recibís: si otro viene en su propio nombre, a aquel recibiréis.", "words": [[0, 328878], [3, 329218], [6, 329338], [13, 329698], [16, 329818], [23, 330118], [26, 330318], [29, 330458], [36, 330818], [38, 331093], [41, 331253], [44, 331353], [53, 332368], [56, 332529], [61, 332769], [67, 333109], [70, 333309], [73, 333489], [80, 333769], [88, 334229], [90, 334629], [96, 335089]]}, {"verse": 44, "start": 336660, "end": 345627, "text": "¿Cómo podéis vosotros creer, pues tomáis la gloria los unos de los otros, y no buscáis la gloria que de sólo Dios viene?", "words": [[0, 336660], [6, 336882], [13, 337422], [22, 338062], [29, 338662], [34, 338862], [41, 339502], [44, 339782], [51, 340402], [55, 340562], [60, 340802], [63, 340982], [67, 341122], [74, 341462], [76, 342022], [79, 342222], [87, 342802], [90, 343082], [97, 343582], [101, 344182], [104, 344322], [109, 344622], [114, 344942]]}, {"verse": 45, "start": 345977, "end": 353567, "text": "No penséis que yo os voy a acusar delante del Padre; hay quien os acusa, Moisés, en quien vosotros esperáis.", "words": [[0, 345977], [3, 346107], [11, 346547], [15, 346727], [18, 346967], [21, 347207], [25, 347447], [27, 347627], [34, 348107], [42, 348547], [46, 348767], [53, 349622], [57, 349851], [63, 350151], [66, 350451], [73, 350911], [81, 351411], [84, 351811], [90, 352051], [99, 352671]]}, {"verse": 46, "start": 353917, "end": 360513, "text": "Porque si vosotros creyeseis a Moisés, creeríais a mí; porque de mí escribió él.", "words": [[0, 353917], [7, 354102], [10, 354282], [19, 354932], [29, 355582], [31, 355722], [39, 356742], [49, 357522], [51, 357642], [55, 358162], [62, 358427], [65, 358667], [68, 358967], [77, 359947]]}, {"verse": 47, "start": 360863, "end": 365737, "text": "Y si a sus escritos no creéis, ¿cómo creeréis a mis palabras?", "words": [[0, 360863], [2, 361003], [5, 361163], [7, 361343], [11, 361563], [20, 362163], [23, 362483], [31, 363583], [37, 363923], [46, 364623], [48, 364723], [52, 364863]]}]}