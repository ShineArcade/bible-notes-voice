{"book": "JHN", "chapter": 20, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 275843, "verses": [{"verse": 1, "start": 300, "end": 11179, "text": "Y el primer día de la semana, María Magdalena vino de mañana, siendo aún oscuro, al sepulcro; y vio la piedra quitada del sepulcro.", "words": [[0, 300], [2, 441], [5, 601], [12, 1001], [16, 1401], [19, 1541], [22, 1681], [30, 2781], [36, 3221], [46, 4061], [51, 4281], [54, 4501], [62, 4961], [69, 5421], [73, 5801], [81, 6861], [84, 7361], [94, 8560], [96, 8682], [100, 8902], [103, 9042], [110, 9582], [118, 10082], [122, 10342]]}, {"verse": 2, "start": 11629, "end": 23667, "text": "Entonces corrió, y vino a Simón Pedro, y al otro discípulo, al cual amaba Jesús, y les dice: Han llevado al Señor del sepulcro, y no sabemos dónde le han puesto.", "words": [[0, 11629], [9, 12493], [17, 13153], [19, 13473], [24, 13753], [26, 13953], [32, 14293], [39, 14733], [41, 15413], [44, 15533], [49, 15773], [60, 16453], [63, 17133], [68, 17213], [74, 17613], [81, 18513], [83, 18573], [87, 18713], [93, 19501], [97, 19641], [105, 20061], [108, 20201], [114, 20481], [118, 20681], [128, 21361], [130, 21821], [133, 21961], [141, 22321], [147, 22641], [150, 22881], [154, 23001]]}, {"verse": 3, "start": 24017, "end": 28522, "text": "Y salió Pedro, y el otro discípulo, y vinieron al sepulcro.", "words": [[0, 24017], [2, 24161], [8, 24481], [15, 24881], [17, 25121], [20, 25241], [25, 25441], [36, 26201], [38, 26751], [47, 27301], [50, 27601]]}, {"verse": 4, "start": 28972, "end": 36023, "text": "Y corrían los dos juntos; pero el otro discípulo corrió más aprisa que Pedro, y llegó primero al sepulcro.", "words": [[0, 28972], [2, 29079], [10, 29539], [14, 29739], [18, 29899], [26, 30803], [31, 31227], [34, 31387], [39, 31547], [49, 32167], [56, 32567], [60, 32907], [67, 33247], [71, 33407], [78, 33787], [80, 34387], [86, 34627], [94, 35067], [97, 35287]]}, {"verse": 5, "start": 36473, "end": 41623, "text": "Y bajándose a mirar, vio las telas de lino allí puestas; pero no entró.", "words": [[0, 36473], [2, 36660], [12, 37240], [14, 37360], [21, 38140], [25, 38420], [29, 38600], [35, 39000], [38, 39120], [43, 39440], [48, 39600], [57, 40715], [62, 40879], [65, 41079]]}, {"verse": 6, "start": 42073, "end": 49452, "text": "Llegó luego Simón Pedro siguiéndole, y entró en el sepulcro, y vio las telas de lino allí puestas,", "words": [[0, 42073], [6, 42460], [12, 42720], [18, 43340], [24, 43740], [37, 44600], [39, 45040], [45, 45540], [48, 45680], [51, 45800], [61, 46520], [63, 47020], [67, 47200], [71, 47400], [77, 47840], [80, 47960], [85, 48280], [90, 48480]]}, {"verse": 7, "start": 49902, "end": 57656, "text": "Y el paño que había estado sobre su cabeza, no puesto con las telas de lino, sino enrollado en un lugar aparte.", "words": [[0, 49902], [2, 50028], [5, 50148], [10, 50728], [14, 50928], [20, 51148], [27, 51548], [33, 51988], [36, 52208], [44, 52668], [47, 53208], [54, 53568], [58, 53888], [62, 54048], [68, 54388], [71, 54488], [77, 54888], [82, 55328], [92, 56288], [95, 56448], [98, 56568], [104, 56908]]}, {"verse": 8, "start": 58106, "end": 64800, "text": "Y entonces entró también el otro discípulo, que había venido primero al sepulcro, y vio, y creyó.", "words": [[0, 58106], [2, 58228], [11, 58608], [17, 59228], [25, 59468], [28, 59728], [33, 59928], [44, 60588], [48, 60768], [54, 60968], [61, 61368], [69, 61748], [72, 61988], [82, 62708], [84, 63328], [89, 63628], [91, 64208]]}, {"verse": 9, "start": 65250, "end": 71905, "text": "Porque aún no sabían la Escritura, que era necesario que él resucitase de los muertos.", "words": [[0, 65250], [7, 65515], [11, 65855], [14, 66075], [21, 66495], [24, 66655], [35, 67535], [39, 67775], [43, 67955], [53, 68755], [57, 69355], [60, 69675], [71, 70775], [74, 70935], [78, 71075]]}, {"verse": 10, "start": 72355, "end": 74718, "text": "Y volvieron los discípulos a los suyos.", "words": [[0, 72355], [2, 72475], [12, 72935], [16, 73095], [27, 73715], [29, 73875], [33, 74015]]}, {"verse": 11, "start": 75168, "end": 82137, "text": "Pero María estaba fuera llorando junto al sepulcro: y estando llorando, se inclinó para mirar el sepulcro;", "words": [[0, 75168], [5, 75289], [11, 75549], [18, 75869], [24, 76189], [33, 76769], [39, 77049], [42, 77389], [52, 78486], [54, 78591], [62, 78951], [72, 79831], [75, 80071], [83, 80611], [88, 80811], [94, 81211], [97, 81351]]}, {"verse": 12, "start": 82587, "end": 92307, "text": "Y vio dos ángeles en ropas blancas que estaban sentados, el uno a la cabecera, y el otro a los pies, donde el cuerpo de Jesús había sido puesto.", "words": [[0, 82587], [2, 82723], [6, 82943], [10, 83143], [18, 83723], [21, 83963], [27, 84343], [35, 84883], [39, 85003], [47, 85303], [57, 86403], [60, 86543], [64, 86763], [66, 86903], [69, 86983], [79, 87603], [81, 88043], [84, 88163], [89, 88383], [91, 88523], [95, 88643], [101, 89223], [107, 89503], [110, 89823], [117, 90203], [120, 90443], [126, 90803], [132, 91223], [137, 91583]]}, {"verse": 13, "start": 92757, "end": 100101, "text": "Y le dijeron: Mujer, ¿por qué lloras? Les dice: Porque se han llevado a mi Señor, y no sé dónde le han puesto.", "words": [[0, 92757], [2, 92923], [5, 93003], [14, 94009], [21, 94574], [26, 94694], [30, 94874], [38, 95807], [42, 95907], [48, 96677], [55, 96871], [58, 97051], [62, 97191], [70, 97591], [72, 97611], [75, 97751], [82, 98191], [84, 98671], [87, 98811], [90, 98991], [96, 99171], [99, 99391], [103, 99491]]}, {"verse": 14, "start": 100451, "end": 109536, "text": "Y cuando hubo dicho esto, se volvió atrás, y vio a Jesús que estaba allí; pero no sabía que era Jesús.", "words": [[0, 100451], [2, 100556], [9, 100776], [14, 101336], [20, 101536], [26, 101816], [29, 102036], [36, 102536], [43, 102936], [45, 103716], [49, 104016], [51, 104196], [57, 104536], [61, 104956], [68, 105256], [74, 106580], [79, 106580], [82, 106727], [88, 107167], [92, 107347], [96, 107587]]}, {"verse": 15, "start": 109986, "end": 122952, "text": "Le dice Jesús: Mujer, ¿por qué lloras? ¿a quién buscas? Ella, pensando que era el jardinero, le dice: Señor, si tú lo has llevado, dime dónde lo has puesto, y yo lo llevaré.", "words": [[0, 110091], [3, 110229], [8, 110367], [15, 110798], [22, 110798], [27, 110942], [31, 111062], [39, 111994], [42, 112100], [48, 112260], [56, 113332], [62, 113556], [71, 114156], [75, 114496], [79, 114696], [82, 115316], [93, 115936], [96, 116436], [102, 117212], [109, 117931], [112, 117971], [115, 118151], [118, 118331], [122, 118491], [131, 119631], [136, 119811], [142, 120091], [145, 120331], [149, 120451], [157, 120851], [159, 121311], [162, 121491], [165, 121611]]}, {"verse": 16, "start": 123302, "end": 131685, "text": "Le dice Jesús: ¡María! Volviéndose ella, le dice: ¡Raboni! que quiere decir, Maestro.", "words": [[0, 123302], [3, 123430], [8, 123670], [15, 124684], [23, 125628], [35, 126334], [41, 126754], [44, 127214], [50, 128837], [59, 129939], [63, 130043], [70, 130363], [77, 130723]]}, {"verse": 17, "start": 132135, "end": 144776, "text": "Le dice Jesús: No me toques: porque aún no he subido a mi Padre: pero ve a mis hermanos, y diles: Subo a mi Padre y a vuestro Padre, a mi Dios y a vuestro Dios.", "words": [[0, 132135], [3, 132262], [8, 132522], [15, 133612], [18, 133740], [21, 133860], [29, 134799], [36, 135003], [40, 135263], [43, 135503], [46, 135603], [53, 136043], [55, 136143], [58, 136263], [65, 137159], [70, 137320], [73, 137500], [75, 137580], [79, 137720], [89, 138340], [91, 138540], [98, 139554], [103, 140057], [105, 140177], [108, 140257], [114, 140917], [116, 141077], [118, 141177], [126, 141457], [133, 142377], [135, 142457], [138, 142577], [143, 142877], [145, 143557], [147, 143677], [155, 144137]]}, {"verse": 18, "start": 145226, "end": 154025, "text": "fue María Magdalena dando la noticia a los discípulos de que había visto al Señor, y que él le había dicho estas cosas.", "words": [[0, 145226], [4, 145434], [10, 145774], [20, 146534], [26, 146854], [29, 147094], [37, 147794], [39, 148054], [43, 148214], [54, 149274], [57, 149794], [61, 149934], [67, 150174], [73, 150554], [76, 150754], [83, 151094], [85, 151634], [89, 151814], [92, 152054], [95, 152454], [101, 152694], [107, 153034], [113, 153274]]}, {"verse": 19, "start": 154475, "end": 170238, "text": "Y como fue tarde aquel día, el primero de la semana, y estando las puertas cerradas donde los discípulos estaban juntos por miedo de los judíos, vino Jesús, y se puso en medio, y les dijo: Paz a vosotros.", "words": [[0, 154475], [2, 154619], [7, 154899], [11, 155179], [17, 155619], [23, 156259], [28, 157119], [31, 157279], [39, 157699], [42, 157879], [45, 157999], [53, 158479], [55, 158739], [63, 159179], [67, 159319], [75, 159719], [84, 160459], [90, 161259], [94, 161519], [105, 162199], [113, 162559], [120, 163099], [124, 163459], [130, 163839], [133, 164059], [137, 164179], [145, 164819], [150, 165439], [157, 166584], [159, 166727], [162, 166827], [167, 167207], [170, 167347], [177, 167727], [179, 168027], [183, 168187], [189, 169172], [193, 169272], [195, 169372]]}, {"verse": 20, "start": 170688, "end": 177465, "text": "Y cuando hubo dicho esto, les mostró las manos y el costado. Y los discípulos se gozaron viendo al Señor.", "words": [[0, 170688], [2, 170789], [9, 171009], [14, 171449], [20, 171669], [26, 172049], [30, 172409], [37, 172889], [41, 173029], [47, 173429], [49, 173649], [52, 173769], [61, 174811], [63, 174916], [67, 175056], [78, 175716], [81, 175896], [89, 176336], [96, 176636], [99, 176876]]}, {"verse": 21, "start": 177915, "end": 185751, "text": "Entonces les dijo Jesús otra vez: Paz a vosotros; como me envió el Padre, así también yo os envío.", "words": [[0, 177915], [9, 178443], [13, 179203], [18, 179543], [24, 179843], [29, 180283], [34, 181335], [38, 181515], [40, 181675], [50, 182558], [55, 182727], [58, 182927], [64, 183187], [67, 183307], [74, 184007], [78, 184187], [86, 184607], [89, 184907], [92, 185087]]}, {"verse": 22, "start": 186201, "end": 191219, "text": "Y cuando hubo dicho esto, sopló, y les dijo: Recibid el Espíritu Santo:", "words": [[0, 186201], [2, 186305], [9, 186525], [14, 186905], [20, 187125], [26, 187525], [33, 188065], [35, 188365], [39, 188485], [45, 189496], [53, 189756], [56, 190096], [65, 190636]]}, {"verse": 23, "start": 191669, "end": 198336, "text": "A los que perdonáis los pecados, les son perdonados: a quienes los retenéis, serán retenidos.", "words": [[0, 191669], [2, 191790], [6, 191910], [10, 192010], [20, 192570], [24, 192730], [33, 193730], [37, 193990], [41, 194250], [53, 195530], [55, 195710], [63, 195850], [67, 196110], [77, 196670], [83, 197390]]}, {"verse": 24, "start": 198786, "end": 204756, "text": "Pero Tomás, uno de los doce, que se dice el Dídimo, no estaba con ellos cuando Jesús vino.", "words": [[0, 198786], [5, 198927], [12, 199347], [16, 199627], [19, 199787], [23, 199927], [29, 200767], [33, 200847], [36, 201007], [41, 201307], [44, 201507], [52, 202347], [55, 202467], [62, 202767], [66, 203047], [72, 203227], [79, 203547], [85, 203927]]}, {"verse": 25, "start": 205206, "end": 218728, "text": "Le dijeron pues los otros discípulos: Al Señor hemos visto. Y él les dijo: Si no veo en sus manos la señal de los clavos, y meto mi dedo en el lugar de los clavos, y meto mi mano en su costado, no creeré.", "words": [[0, 205206], [3, 205328], [11, 205808], [16, 205968], [20, 206148], [26, 206488], [38, 207706], [41, 207851], [47, 208131], [53, 208371], [60, 209326], [62, 209532], [65, 209712], [69, 210012], [75, 210858], [78, 210955], [81, 211095], [85, 211315], [88, 211495], [92, 211635], [98, 211975], [101, 212215], [107, 212635], [110, 212695], [114, 212835], [122, 213375], [124, 213775], [129, 214135], [132, 214295], [137, 214575], [140, 214655], [143, 214755], [149, 214995], [152, 215195], [156, 215315], [164, 215895], [166, 216315], [171, 216675], [174, 216815], [179, 217015], [182, 217175], [185, 217295], [194, 217795], [197, 218115]]}, {"verse": 26, "start": 219078, "end": 231535, "text": "Y ocho días después, estaban otra vez sus discípulos dentro, y con ellos Tomás. Vino Jesús, las puertas cerradas, y se puso en medio, y dijo: Paz a vosotros.", "words": [[0, 219078], [2, 219243], [7, 219583], [12, 219783], [21, 220863], [29, 221363], [34, 221723], [38, 222083], [42, 222503], [53, 223163], [61, 223543], [63, 223883], [67, 224063], [73, 224283], [80, 225394], [85, 225640], [92, 226020], [96, 226500], [104, 226900], [114, 227500], [116, 228000], [119, 228120], [124, 228460], [127, 228620], [134, 228980], [136, 229520], [142, 230475], [146, 230655], [148, 230755]]}, {"verse": 27, "start": 231985, "end": 242367, "text": "Luego dice a Tomás: Mete tu dedo aquí, y ve mis manos: y alarga acá tu mano, y métela en mi costado: y no seas incrédulo, sino creyente.", "words": [[0, 231985], [6, 232272], [11, 232452], [13, 232632], [20, 233631], [25, 233917], [28, 234177], [33, 234477], [39, 234657], [41, 234897], [44, 235017], [48, 235157], [55, 236058], [57, 236298], [64, 236758], [68, 237038], [71, 237198], [77, 237518], [79, 237918], [86, 238398], [89, 238558], [92, 238698], [101, 239741], [103, 239848], [106, 239948], [111, 240228], [122, 241348], [127, 241528]]}, {"verse": 28, "start": 242817, "end": 249384, "text": "Entonces Tomás respondió, y le dijo: ¡Señor mío, y Dios mío!", "words": [[0, 242817], [9, 243245], [15, 243785], [26, 244685], [28, 245245], [31, 245345], [37, 246080], [44, 246364], [49, 246824], [51, 246924], [56, 247104]]}, {"verse": 29, "start": 249734, "end": 257772, "text": "Le dice Jesús: Porque me has visto, Tomás, creíste: bienaventurados los que no vieron y creyeron.", "words": [[0, 249734], [3, 249880], [8, 250180], [15, 251390], [22, 251540], [25, 251680], [29, 251840], [36, 252760], [43, 253055], [52, 254596], [68, 255586], [72, 255846], [76, 256006], [79, 256206], [86, 256586], [88, 257207]]}, {"verse": 30, "start": 258222, "end": 265626, "text": "Y también hizo Jesús muchas otras señales en presencia de sus discípulos, que no están escritas en este libro.", "words": [[0, 258222], [2, 258330], [10, 258630], [15, 258910], [21, 259410], [28, 260030], [34, 260370], [42, 261030], [45, 261210], [55, 261850], [58, 262030], [62, 262230], [74, 262990], [78, 263610], [81, 263770], [87, 264010], [96, 264630], [99, 264790], [104, 265237]]}, {"verse": 31, "start": 266076, "end": 275443, "text": "Pero estas han sido escritas, para que creáis que Jesús es el Cristo, el Hijo de Dios; y para que creyendo, tengáis vida en su nombre.", "words": [[0, 266076], [5, 266240], [11, 266740], [15, 266900], [20, 267200], [30, 268000], [35, 268460], [39, 268640], [46, 269120], [50, 269320], [56, 269660], [59, 269980], [62, 270180], [70, 270800], [73, 270880], [78, 271140], [81, 271300], [87, 272110], [89, 272235], [94, 272415], [98, 272595], [108, 273255], [116, 274155], [121, 274475], [124, 274695], [127, 274855]]}]}