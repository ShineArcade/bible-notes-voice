{"book": "PSA", "chapter": 71, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 172620, "verses": [{"verse": 1, "start": 300, "end": 4809, "text": "En ti, oh Jehová, he esperado; no sea yo confuso para siempre.", "words": [[0, 300], [3, 504], [7, 764], [10, 1024], [18, 1564], [21, 1724], [31, 2825], [34, 2950], [38, 3170], [41, 3370], [49, 3890], [54, 4090]]}, {"verse": 2, "start": 5259, "end": 10690, "text": "Hazme escapar, y líbrame en tu justicia: inclina tu oído y sálvame.", "words": [[0, 5259], [6, 5604], [15, 6224], [17, 6484], [25, 7064], [28, 7224], [31, 7344], [41, 8877], [49, 9227], [52, 9467], [57, 9827], [59, 9967]]}, {"verse": 3, "start": 11140, "end": 20904, "text": "Sé para mí roca de refugio, adonde recurra yo continuamente: has mandado que yo sea salvo; porque tú eres mi roca, y mi fortaleza.", "words": [[0, 11140], [3, 11344], [8, 11524], [11, 11724], [16, 12104], [19, 12224], [28, 12904], [35, 13584], [43, 14304], [46, 14484], [61, 15942], [65, 16242], [73, 16742], [77, 16902], [80, 17082], [84, 17302], [91, 18314], [98, 18498], [101, 18818], [106, 18998], [109, 19218], [115, 19678], [117, 19798], [120, 19938]]}, {"verse": 4, "start": 21354, "end": 26651, "text": "Dios mío, líbrame de la mano del impío, de la mano del perverso y violento.", "words": [[0, 21354], [5, 21719], [10, 22279], [18, 22659], [21, 22859], [24, 22979], [29, 23259], [33, 23439], [40, 24379], [43, 24739], [46, 24839], [51, 25039], [55, 25239], [64, 25799], [66, 25899]]}, {"verse": 5, "start": 27101, "end": 33366, "text": "Porque tú, oh Señor Jehová, eres mi esperanza: seguridad mía desde mi juventud.", "words": [[0, 27101], [7, 27345], [11, 27645], [14, 27945], [20, 28305], [28, 29165], [33, 29525], [36, 29945], [47, 31097], [57, 31660], [61, 32160], [67, 32320], [70, 32540]]}, {"verse": 6, "start": 33816, "end": 43205, "text": "Por ti he sido sustentado desde el vientre: de las entrañas de mi madre tú fuiste el que me sacaste: de ti será siempre mi alabanza.", "words": [[0, 33816], [4, 33940], [7, 34220], [10, 34580], [15, 34840], [26, 35660], [32, 35920], [35, 36380], [44, 37437], [47, 37544], [51, 37684], [60, 38284], [63, 38444], [66, 38564], [72, 38844], [75, 39084], [82, 39564], [85, 39804], [89, 39944], [92, 40084], [101, 41120], [104, 41267], [107, 41507], [112, 41787], [120, 42187], [123, 42447]]}, {"verse": 7, "start": 43655, "end": 47764, "text": "Como prodigio he sido a muchos; y tú mi refugio fuerte.", "words": [[0, 43655], [5, 43859], [14, 44639], [17, 44779], [22, 45019], [24, 45199], [32, 46103], [34, 46230], [37, 46370], [40, 46510], [48, 47090]]}, {"verse": 8, "start": 48214, "end": 52288, "text": "Sea llena mi boca de tu alabanza, de tu gloria todo el día.", "words": [[0, 48456], [4, 48722], [10, 48989], [13, 49169], [18, 49429], [21, 49609], [24, 50079], [34, 50549], [37, 50789], [40, 50929], [47, 51349], [52, 51529], [55, 51789]]}, {"verse": 9, "start": 52738, "end": 58808, "text": "No me deseches en el tiempo de la vejez; cuando mi fuerza se acabe, no me desampares.", "words": [[0, 52738], [3, 52922], [6, 53082], [15, 53722], [18, 53882], [21, 54022], [28, 54382], [31, 54582], [34, 54722], [41, 55711], [48, 55855], [51, 56075], [58, 56415], [61, 56655], [68, 57375], [71, 57675], [74, 58241]]}, {"verse": 10, "start": 59258, "end": 66025, "text": "Porque mis enemigos han tratado de mí; y los que acechan mi alma, consultaron juntamente,", "words": [[0, 59258], [7, 59443], [11, 59683], [20, 60303], [24, 60563], [32, 61223], [35, 61383], [39, 61988], [41, 62092], [45, 62232], [49, 62432], [57, 62932], [60, 63172], [66, 63852], [78, 64932]]}, {"verse": 11, "start": 66475, "end": 71957, "text": "Diciendo: Dios lo ha dejado: perseguid y tomadle, porque no hay quien le libre.", "words": [[0, 66475], [10, 67532], [15, 67794], [18, 68034], [21, 68154], [29, 68985], [39, 69574], [41, 70004], [50, 70434], [57, 70774], [60, 70994], [64, 71154], [70, 71334], [73, 71474]]}, {"verse": 12, "start": 72307, "end": 77313, "text": "Oh Dios, no te alejes de mí: Dios mío, acude pronto a mi socorro.", "words": [[0, 72307], [3, 72494], [9, 72854], [12, 72954], [15, 73114], [22, 73534], [25, 73714], [29, 74330], [34, 74554], [39, 75454], [45, 75834], [52, 76274], [54, 76534], [57, 76614]]}, {"verse": 13, "start": 77763, "end": 86380, "text": "Sean avergonzados, fallezcan los adversarios de mi alma; sean cubiertos de vergüenza y de confusión los que mi mal buscan.", "words": [[0, 77763], [5, 78064], [19, 79444], [29, 80044], [33, 80224], [45, 81024], [48, 81184], [51, 81324], [57, 82138], [62, 82382], [72, 83142], [75, 83322], [85, 83922], [87, 84042], [90, 84142], [100, 84802], [104, 85182], [108, 85342], [111, 85482], [115, 85682]]}, {"verse": 14, "start": 86830, "end": 91521, "text": "Mas yo siempre esperaré, y añadiré sobre toda tu alabanza.", "words": [[0, 86900], [4, 87000], [7, 87180], [15, 87600], [25, 88420], [27, 89080], [35, 89740], [41, 90150], [46, 90560], [49, 90700]]}, {"verse": 15, "start": 91971, "end": 98558, "text": "Mi boca publicará tu justicia y tu salud todo el día, aunque no sé el número de ellas.", "words": [[0, 91971], [3, 92271], [8, 92571], [18, 93311], [21, 93511], [30, 94271], [32, 94491], [35, 94631], [41, 95431], [46, 95751], [49, 96011], [54, 96391], [61, 96571], [64, 96771], [67, 96991], [70, 97311], [77, 97651], [80, 97891]]}, {"verse": 16, "start": 99008, "end": 104633, "text": "Vendré a las valentías del Señor Jehová: haré memoria de sola tu justicia.", "words": [[0, 99008], [7, 99516], [9, 99716], [13, 99856], [23, 100576], [27, 100756], [33, 101056], [41, 102049], [46, 102469], [54, 102929], [57, 103279], [62, 103629], [65, 103769]]}, {"verse": 17, "start": 105083, "end": 111541, "text": "Oh Dios, me enseñaste desde mi juventud; y hasta ahora he manifestado tus maravillas.", "words": [[0, 105141], [3, 105231], [9, 105451], [12, 105711], [22, 106451], [28, 106751], [31, 107011], [41, 108210], [43, 108501], [49, 108721], [55, 109141], [58, 109481], [70, 110421], [74, 110581]]}, {"verse": 18, "start": 111991, "end": 123177, "text": "Y aun hasta la vejez y las canas; oh Dios, no me desampares, hasta que denuncie tu brazo a la posteridad, tus valentías a todos los que han de venir.", "words": [[0, 111991], [2, 112116], [6, 112296], [12, 112576], [15, 112783], [21, 112989], [23, 113196], [27, 113376], [34, 114318], [37, 114486], [43, 115306], [46, 115446], [49, 115586], [61, 116146], [67, 116706], [71, 117266], [80, 117826], [83, 118026], [89, 118446], [91, 118546], [94, 118626], [106, 119526], [110, 119646], [120, 121246], [122, 121326], [128, 121646], [132, 122206], [136, 122386], [140, 122526], [143, 122646]]}, {"verse": 19, "start": 123627, "end": 131616, "text": "Y tu justicia, oh Dios, hasta lo excelso; porque has hecho grandes cosas: oh Dios, ¿quién como tú?", "words": [[0, 123627], [2, 123746], [5, 123866], [15, 124496], [18, 125126], [24, 125926], [30, 126146], [33, 126366], [42, 127611], [49, 127751], [53, 127931], [59, 128111], [67, 128491], [74, 129617], [77, 129782], [83, 130562], [90, 130902], [95, 131142]]}, {"verse": 20, "start": 132066, "end": 140477, "text": "Tú, que me has hecho ver muchas angustias y males, volverás a darme vida, y de nuevo me levantarás de los abismos de la tierra.", "words": [[0, 132066], [4, 132151], [8, 132331], [11, 132491], [15, 132711], [21, 133151], [25, 133411], [32, 133771], [42, 134551], [44, 134711], [51, 135511], [60, 136091], [62, 136211], [68, 136571], [74, 136871], [76, 137431], [79, 137551], [85, 137851], [88, 138091], [99, 138831], [102, 138931], [106, 139051], [114, 139651], [117, 139731], [120, 139851]]}, {"verse": 21, "start": 140927, "end": 144446, "text": "Aumentarás mi grandeza, y volverás a consolarme.", "words": [[0, 140927], [11, 141555], [14, 141695], [24, 142435], [26, 142875], [35, 143375], [37, 143495]]}, {"verse": 22, "start": 144896, "end": 154098, "text": "Asimismo yo te alabaré con instrumento de salterio, oh Dios mío: tu verdad cantaré yo a ti en el arpa, oh Santo de Israel.", "words": [[0, 145214], [9, 145554], [12, 145834], [15, 146014], [23, 146454], [27, 146674], [39, 147494], [42, 147574], [52, 148081], [55, 148587], [60, 149094], [65, 149842], [68, 150110], [75, 150410], [83, 151090], [86, 151350], [88, 151510], [91, 151650], [94, 151850], [97, 151990], [103, 152330], [106, 152670], [112, 153150], [115, 153330]]}, {"verse": 23, "start": 154548, "end": 160747, "text": "Mis labios cantarán cuando a ti cante salmos, y mi alma, a la cual redimiste.", "words": [[0, 154548], [4, 154694], [11, 155154], [20, 155834], [27, 156054], [29, 156374], [32, 156494], [38, 156934], [46, 157634], [48, 158214], [51, 158394], [57, 158694], [59, 159014], [62, 159074], [67, 159394]]}, {"verse": 24, "start": 161197, "end": 172220, "text": "Mi lengua hablará también de tu justicia todo el día: por cuanto fueron avergonzados, porque fueron confusos los que mi mal procuraban.", "words": [[0, 161197], [3, 161822], [10, 162382], [18, 162962], [26, 163262], [29, 163522], [32, 163662], [41, 164302], [46, 164582], [49, 164862], [54, 165607], [58, 165751], [65, 166071], [72, 166471], [86, 168331], [93, 168731], [100, 169031], [109, 170111], [113, 170531], [117, 170691], [120, 170851], [124, 171111]]}]}