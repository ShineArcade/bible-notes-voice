{"book": "ISA", "chapter": 51, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 266073, "verses": [{"verse": 1, "start": 300, "end": 10250, "text": "Oidme, los que seguís justicia, los que buscáis a Jehová: mirad a la piedra de donde fuisteis cortados, y a la caverna de la fosa de donde fuisteis arrancados.", "words": [[0, 501], [7, 741], [11, 901], [15, 1061], [22, 1441], [32, 2481], [36, 2761], [40, 2901], [48, 3361], [50, 3481], [58, 4660], [64, 4800], [66, 4940], [69, 5060], [76, 5520], [79, 5640], [85, 5800], [94, 6320], [104, 6960], [106, 7360], [108, 7420], [111, 7500], [119, 8000], [122, 8100], [125, 8220], [130, 8560], [133, 8720], [139, 8880], [148, 9400]]}, {"verse": 2, "start": 10969, "end": 18430, "text": "Mirad a Abraham vuestro padre, y a Sara que os parió; porque solo lo llamé, y lo bendije, y lo multipliqué.", "words": [[0, 10969], [6, 11368], [8, 11468], [16, 11928], [24, 12388], [31, 12728], [33, 13388], [35, 13568], [40, 13748], [44, 13968], [47, 14108], [54, 15206], [61, 15390], [66, 15710], [69, 15890], [76, 16370], [78, 16570], [81, 16670], [90, 17210], [92, 17430], [95, 17530]]}, {"verse": 3, "start": 19011, "end": 35093, "text": "Ciertamente consolará Jehová a Sion: consolará todas sus soledades, y tornará su desierto como paraíso, y su soledad como huerto de Jehová: se hallará en ella alegría y gozo, alabanza y voz de cantar.", "words": [[0, 19011], [12, 19650], [22, 20324], [29, 20997], [31, 21351], [37, 22004], [47, 22686], [53, 22846], [57, 23206], [68, 23986], [70, 24446], [78, 24986], [81, 25206], [90, 25806], [95, 26166], [104, 27026], [106, 27406], [109, 27566], [117, 28206], [122, 28426], [129, 28906], [132, 29106], [140, 30044], [143, 30144], [151, 30624], [154, 30864], [159, 31164], [167, 32184], [169, 32364], [175, 33044], [184, 33764], [186, 34004], [190, 34204], [193, 34364]]}, {"verse": 4, "start": 35393, "end": 44772, "text": "Estad atentos a mí, pueblo mío, y oídme, nación mía; porque de mí saldrá la ley, y mi juicio descubriré para luz de pueblos.", "words": [[0, 35393], [6, 35917], [14, 36477], [16, 36597], [20, 37177], [27, 37477], [32, 38377], [34, 38437], [41, 38877], [48, 39417], [53, 40472], [60, 40652], [63, 40852], [66, 41012], [73, 41512], [76, 41552], [81, 41872], [83, 42312], [86, 42412], [93, 42852], [104, 43592], [109, 43742], [113, 43892], [116, 44072]]}, {"verse": 5, "start": 45484, "end": 56239, "text": "Cercana está mi justicia, salido ha mi salvación, y mis brazos juzgarán a los pueblos: a mí esperarán las islas, y en mi brazo pondrán su esperanza.", "words": [[0, 45484], [8, 46067], [13, 46327], [16, 46507], [26, 47547], [33, 47827], [36, 48107], [39, 48227], [50, 49167], [52, 49367], [56, 49527], [63, 50007], [72, 50627], [74, 50667], [78, 50827], [87, 52121], [89, 52239], [92, 52439], [102, 53079], [106, 53239], [113, 53719], [115, 54059], [118, 54179], [121, 54299], [127, 54759], [135, 55259], [138, 55379]]}, {"verse": 6, "start": 56924, "end": 74967, "text": "Alzad a los cielos vuestros ojos, y mirad abajo a la tierra: porque los cielos serán deshechos como humo, y la tierra se envejecerá como ropa de vestir, y de la misma manera perecerán sus habitantes: pero mi salvación será para siempre, mi justicia no perecerá.", "words": [[0, 56924], [6, 57463], [8, 57663], [12, 57803], [19, 58363], [28, 58783], [34, 59163], [36, 59823], [42, 60223], [48, 60643], [50, 60843], [53, 60903], [61, 62101], [68, 62284], [72, 62484], [79, 62944], [85, 63384], [95, 63824], [100, 64024], [106, 64564], [108, 65024], [111, 65144], [118, 65504], [121, 65784], [132, 66444], [137, 66604], [142, 66944], [145, 67044], [153, 67544], [155, 68004], [158, 68104], [161, 68204], [167, 68424], [174, 68884], [184, 69584], [188, 69704], [200, 71103], [205, 71227], [208, 71367], [218, 71907], [223, 72147], [228, 72387], [237, 73127], [240, 73207], [249, 73867], [252, 74227]]}, {"verse": 7, "start": 75646, "end": 84182, "text": "Oídme, los que conocéis justicia, pueblo en cuyo corazón está mi ley. No temáis afrenta de hombre, ni desmayéis por sus ultrajes.", "words": [[0, 75646], [7, 76087], [11, 76267], [15, 76407], [24, 76907], [34, 77987], [41, 78247], [44, 78447], [49, 78727], [57, 79147], [62, 79547], [65, 79727], [70, 80653], [73, 80852], [80, 81082], [88, 81662], [91, 81782], [99, 82042], [102, 82502], [112, 83022], [116, 83222], [120, 83382]]}, {"verse": 8, "start": 84916, "end": 95537, "text": "Porque como a vestidura los comerá polilla, como a lana los comerá gusano; pero mi justicia permanecerá perpetuamente, y mi salvación por siglos de siglos.", "words": [[0, 84916], [7, 85173], [12, 85433], [14, 85533], [24, 86113], [28, 86293], [35, 86733], [44, 87573], [49, 87893], [51, 88033], [56, 88293], [60, 88453], [67, 88873], [75, 90021], [80, 90167], [83, 90287], [92, 90967], [104, 91707], [119, 92527], [121, 92967], [124, 93087], [134, 93767], [138, 94247], [145, 94667], [148, 94827]]}, {"verse": 9, "start": 96123, "end": 110833, "text": "Despiértate, despiértate, vístete de fortaleza, oh brazo de Jehová; despiértate como en el tiempo antiguo, en los siglos pasados. ¿No eres tú el que cortó a Rahab, y el que hirió al dragón?", "words": [[0, 96123], [13, 96985], [26, 98205], [34, 98905], [37, 99045], [48, 99735], [51, 100425], [57, 100845], [60, 100985], [68, 101842], [80, 102648], [85, 102908], [88, 103048], [91, 103188], [98, 103488], [107, 104628], [110, 104788], [114, 104948], [121, 105528], [130, 106812], [134, 107111], [139, 107251], [142, 107511], [145, 107631], [149, 107771], [155, 108251], [157, 108551], [164, 108851], [166, 109351], [169, 109491], [173, 109751], [179, 110011], [182, 110151]]}, {"verse": 10, "start": 111283, "end": 122394, "text": "¿No eres tú el que secó el mar, las aguas del grande abismo; el que al profundo del mar tornó en camino, para que pasasen los redimidos?", "words": [[0, 111283], [4, 111468], [9, 111628], [12, 111968], [15, 112148], [19, 112308], [24, 112768], [27, 112908], [32, 113728], [36, 114068], [42, 114438], [46, 114808], [53, 115128], [61, 116359], [64, 116479], [68, 116699], [71, 116859], [80, 117519], [84, 117739], [88, 118039], [94, 118839], [97, 118999], [105, 119559], [110, 120299], [114, 120479], [122, 121059], [126, 121259]]}, {"verse": 11, "start": 122844, "end": 136672, "text": "Cierto, volverán los redimidos de Jehová, volverán a Sion cantando, y gozo perpetuo será sobre sus cabezas: poseerán gozo y alegría, y el dolor y el gemido huirán.", "words": [[0, 122844], [8, 123280], [17, 124040], [21, 124320], [31, 125240], [34, 125380], [42, 126260], [51, 126760], [53, 127000], [58, 127220], [68, 128260], [70, 128740], [75, 129080], [84, 129920], [89, 130200], [95, 130560], [99, 130820], [108, 132070], [117, 132594], [122, 133034], [124, 133174], [133, 133874], [135, 134194], [138, 134374], [144, 134754], [146, 135094], [149, 135214], [156, 135774]]}, {"verse": 12, "start": 136972, "end": 147056, "text": "Yo, yo soy vuestro consolador. ¿Quién eres tú para que tengas temor del hombre, que es mortal, del hijo del hombre, que por heno será contado?", "words": [[0, 136972], [4, 137796], [7, 138096], [11, 138416], [19, 138856], [31, 140215], [38, 140476], [43, 140636], [46, 140916], [51, 141136], [55, 141276], [62, 141676], [68, 141996], [72, 142156], [80, 142896], [84, 142996], [87, 143116], [95, 144076], [99, 144196], [104, 144416], [108, 144616], [116, 145376], [120, 145456], [124, 145746], [129, 146036], [134, 146216]]}, {"verse": 13, "start": 147733, "end": 163129, "text": "Y te has ya olvidado de Jehová tu Hacedor, que extendió los cielos y fundó la tierra; y todo el día temiste continuamente del furor del que aflige, cuando se disponía para destruir: pero ¿en dónde está el furor del que aflige?", "words": [[0, 147733], [2, 147871], [5, 147991], [9, 148211], [12, 148391], [21, 148951], [24, 149131], [31, 149591], [34, 149711], [43, 150611], [47, 150811], [56, 151331], [60, 151491], [67, 152071], [69, 152211], [75, 152571], [78, 152651], [86, 153787], [88, 153911], [93, 154111], [96, 154351], [100, 154531], [108, 155051], [122, 155931], [126, 156191], [132, 156611], [136, 156751], [140, 156931], [148, 157391], [155, 158011], [158, 158251], [167, 158871], [172, 159091], [182, 160357], [187, 160599], [191, 161119], [197, 161359], [202, 161739], [205, 161879], [211, 162259], [215, 162379], [219, 162559]]}, {"verse": 14, "start": 163817, "end": 169285, "text": "El preso se da prisa para ser suelto, por no morir en la mazmorra, ni que le falte su pan.", "words": [[0, 163817], [3, 163945], [9, 164385], [12, 164505], [15, 164645], [21, 165065], [26, 165285], [30, 165485], [38, 166305], [42, 166505], [45, 166685], [51, 167005], [54, 167125], [57, 167575], [67, 168025], [70, 168165], [74, 168285], [77, 168385], [83, 168745], [86, 168865]]}, {"verse": 15, "start": 169958, "end": 177829, "text": "Pero yo Jehová, que parto el mar, y suenan sus ondas, soy tu Dios, cuyo nombre es Jehová de los ejércitos.", "words": [[0, 169958], [5, 170129], [8, 170429], [16, 171029], [20, 171209], [26, 171689], [29, 171809], [34, 172289], [36, 172669], [43, 173049], [47, 173229], [54, 173789], [58, 174229], [61, 174429], [67, 175289], [72, 175589], [79, 175949], [82, 176329], [89, 176809], [92, 176869], [96, 177009]]}, {"verse": 16, "start": 178563, "end": 190556, "text": "Y en tu boca he puesto mis palabras, y con la sombra de mi mano te cubrí, para que plantase los cielos y fundase la tierra, y que dijese a Sion: Pueblo mío eres tú.", "words": [[0, 178563], [2, 178683], [5, 178803], [8, 178943], [13, 179263], [16, 179403], [23, 179703], [27, 179943], [37, 180403], [39, 181103], [43, 181263], [46, 181403], [53, 181863], [56, 181983], [59, 182103], [64, 182343], [67, 182523], [74, 183023], [79, 183563], [83, 183683], [92, 184243], [96, 184403], [103, 185043], [105, 185223], [113, 185723], [116, 185883], [124, 187041], [126, 187142], [130, 187457], [137, 187772], [139, 188087], [145, 188944], [152, 189166], [156, 189726], [161, 190046]]}, {"verse": 17, "start": 191150, "end": 202769, "text": "Despierta, despierta, levántate, oh Jerusalén, que bebiste de la mano de Jehová el cáliz de su furor; las heces del cáliz de aturdimiento bebiste, y chupaste.", "words": [[0, 191150], [11, 191975], [22, 193155], [33, 193895], [36, 194035], [47, 195335], [51, 195395], [59, 195895], [62, 196055], [65, 196155], [70, 196375], [73, 196535], [80, 197015], [83, 197365], [89, 197715], [92, 197855], [95, 198015], [102, 198885], [106, 199194], [112, 199534], [116, 199854], [122, 200174], [125, 200314], [138, 201054], [147, 201734], [149, 201974]]}, {"verse": 18, "start": 203219, "end": 211672, "text": "De todos los hijos que parió, no hay quien la gobierne; ni quien la tome de la mano, de todos los hijos que crio.", "words": [[0, 203219], [3, 203367], [9, 203707], [13, 204027], [19, 204327], [23, 204567], [30, 205367], [33, 205727], [37, 206007], [43, 206247], [46, 206507], [56, 207669], [59, 207813], [65, 208093], [68, 208273], [73, 208613], [76, 208713], [79, 208853], [85, 209393], [88, 209673], [94, 210073], [98, 210533], [104, 210873], [108, 211133]]}, {"verse": 19, "start": 212122, "end": 222089, "text": "Estas dos cosas te han acontecido; ¿quién se dolerá de ti? asolamiento y quebrantamiento, hambre y espada. ¿Quién te consolará?", "words": [[0, 212122], [6, 212526], [10, 212706], [16, 213186], [19, 213706], [23, 213806], [35, 214991], [42, 215175], [45, 215435], [52, 215915], [55, 216035], [59, 216716], [71, 217499], [73, 217739], [90, 218919], [97, 219359], [99, 219819], [107, 220811], [114, 221053], [117, 221133]]}, {"verse": 20, "start": 222539, "end": 234379, "text": "Tus hijos desmayaron, estuvieron tendidos en las encrucijadas de todos los caminos, como buey montaraz en la red, llenos del furor de Jehová, de la ira del Dios tuyo.", "words": [[0, 222539], [4, 222624], [10, 222964], [22, 224104], [33, 224504], [42, 225184], [45, 225384], [49, 225924], [62, 226464], [65, 226664], [71, 226864], [75, 227084], [84, 227964], [89, 228471], [94, 228977], [103, 229484], [106, 229704], [109, 229864], [114, 230544], [121, 231084], [125, 231304], [131, 231764], [134, 231904], [142, 232664], [145, 232864], [148, 233024], [152, 233344], [156, 233504], [161, 233704]]}, {"verse": 21, "start": 234829, "end": 238989, "text": "Oye pues ahora esto, miserable, ebria, y no de vino:", "words": [[0, 234829], [4, 235128], [9, 235388], [15, 235828], [21, 236228], [32, 237078], [39, 237928], [41, 238288], [44, 238408], [47, 238568]]}, {"verse": 22, "start": 239439, "end": 252814, "text": "Así dijo tu Señor Jehová, y tu Dios, el cual pleitea por su pueblo: He aquí he quitado de tu mano el cáliz de aturdimiento, la hez del cáliz de mi furor; nunca más lo beberás:", "words": [[0, 239439], [4, 239680], [9, 240020], [12, 240200], [18, 240500], [26, 241400], [28, 241580], [31, 241720], [37, 242620], [40, 242800], [45, 243020], [53, 243940], [57, 244120], [60, 244320], [68, 245105], [71, 245249], [76, 245569], [79, 246009], [87, 246449], [90, 246589], [93, 246749], [98, 247029], [101, 247319], [107, 247609], [110, 247749], [124, 248449], [127, 248919], [131, 249389], [135, 249679], [141, 249969], [144, 250069], [147, 250209], [154, 251322], [160, 251684], [164, 251944], [167, 252064]]}, {"verse": 23, "start": 253494, "end": 265438, "text": "Y lo pondré en mano de tus angustiadores, que dijeron a tu alma: Encórvate, y pasaremos. Y tú pusiste tu cuerpo como tierra, y como camino, a los que pasan.", "words": [[0, 253494], [2, 253597], [5, 253717], [12, 254137], [15, 254357], [20, 254597], [23, 254777], [27, 254917], [42, 256317], [46, 256457], [54, 256957], [56, 257057], [59, 257177], [65, 258213], [76, 258855], [78, 259255], [89, 260691], [91, 260798], [94, 260938], [102, 261398], [105, 261558], [112, 261858], [117, 262138], [125, 262538], [127, 262858], [132, 263018], [140, 263478], [142, 263958], [146, 264098], [150, 264238]]}]}