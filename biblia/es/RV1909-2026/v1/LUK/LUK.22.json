{"book": "LUK", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 523993, "verses": [{"verse": 1, "start": 300, "end": 5579, "text": "Y estaba cerca el día de la fiesta de los panes sin levadura, que se llama la Pascua.", "words": [[0, 300], [2, 385], [9, 665], [15, 1025], [18, 1305], [22, 1465], [25, 1625], [28, 1745], [35, 2125], [38, 2265], [42, 2385], [48, 2825], [52, 3185], [62, 4265], [66, 4385], [69, 4505], [75, 4765], [78, 4925]]}, {"verse": 2, "start": 6029, "end": 13104, "text": "Y los principales sacerdotes y los escribas buscaban cómo le matarían; pero tenían miedo del pueblo.", "words": [[0, 6029], [2, 6094], [6, 6234], [18, 6894], [29, 7694], [31, 7874], [35, 7994], [44, 8614], [53, 9434], [58, 9754], [61, 9894], [71, 11008], [76, 11372], [83, 11712], [89, 12152], [93, 12372]]}, {"verse": 3, "start": 13554, "end": 20782, "text": "Y entró Satanás en Judas, por sobrenombre Iscariote, el cual era uno del número de los doce;", "words": [[0, 13554], [2, 13716], [8, 14136], [16, 14696], [19, 14836], [26, 15896], [30, 16016], [42, 16976], [53, 18296], [56, 18396], [61, 18616], [65, 18876], [69, 19136], [73, 19336], [80, 19736], [83, 19956], [87, 20116]]}, {"verse": 4, "start": 21232, "end": 28096, "text": "Y fue, y habló con los principales sacerdotes, y con los jefes de la guardia, de cómo se lo entregaría.", "words": [[0, 21232], [2, 21396], [7, 21576], [9, 21856], [15, 22216], [19, 22336], [23, 22456], [35, 23256], [47, 24196], [49, 24676], [53, 24836], [57, 24976], [63, 25376], [66, 25456], [69, 25556], [78, 26456], [81, 26536], [86, 26776], [89, 27036], [92, 27156]]}, {"verse": 5, "start": 28546, "end": 32066, "text": "Los cuales se alegraron, y acordaron darle dinero.", "words": [[0, 28546], [4, 28655], [11, 28915], [14, 29215], [25, 29935], [27, 30435], [37, 31035], [43, 31275]]}, {"verse": 6, "start": 32516, "end": 39646, "text": "Y prometió, y buscaba oportunidad para entregarle a ellos sin la multitud presente.", "words": [[0, 32516], [2, 32680], [12, 33800], [14, 34020], [22, 34500], [34, 35380], [39, 35880], [50, 36740], [52, 36860], [58, 37220], [62, 37800], [65, 38080], [74, 38640]]}, {"verse": 7, "start": 40096, "end": 46716, "text": "Y vino el día de los panes sin levadura, en el cual era necesario sacrificar el cordero de la Pascua.", "words": [[0, 40096], [2, 40201], [7, 40421], [10, 40601], [14, 40781], [17, 40921], [21, 41061], [27, 41501], [31, 41741], [41, 42761], [44, 42921], [47, 43041], [52, 43261], [56, 43641], [66, 44281], [77, 45121], [80, 45241], [88, 45781], [91, 45921], [94, 46021]]}, {"verse": 8, "start": 47166, "end": 53430, "text": "Y envió a Pedro y a Juan, diciendo: Id, preparadnos la pascua para que comamos.", "words": [[0, 47166], [2, 47326], [8, 47746], [10, 47866], [16, 48206], [18, 48446], [20, 48546], [26, 48906], [36, 50582], [40, 50692], [52, 51672], [55, 52032], [62, 52392], [67, 52532], [71, 52692]]}, {"verse": 9, "start": 53880, "end": 57199, "text": "Y ellos le dijeron: ¿Dónde quieres que preparemos?", "words": [[0, 53880], [2, 54027], [8, 54327], [11, 54667], [20, 55618], [27, 55905], [35, 56205], [39, 56385]]}, {"verse": 10, "start": 57549, "end": 67057, "text": "Y él les dijo: He aquí cuando entréis en la ciudad, os encontrará un hombre que lleva un cántaro de agua: seguidle hasta la casa donde entre,", "words": [[0, 57549], [2, 57745], [5, 57885], [9, 58085], [15, 58986], [18, 59066], [23, 59286], [30, 59566], [38, 60166], [41, 60326], [44, 60466], [52, 60826], [55, 61206], [66, 61926], [69, 62106], [76, 62346], [80, 62526], [86, 62786], [89, 63006], [97, 63566], [100, 63766], [106, 64543], [115, 65182], [121, 65522], [124, 65722], [129, 65962], [135, 66282]]}, {"verse": 11, "start": 67507, "end": 75848, "text": "Y decid al dueño de la casa: El Maestro te dice: ¿Dónde está el aposento donde tengo de comer la pascua con mis discípulos?", "words": [[0, 67507], [2, 67628], [8, 67948], [11, 68368], [17, 68768], [20, 68868], [23, 68988], [29, 69944], [32, 70094], [40, 70634], [43, 70814], [49, 71645], [56, 72033], [61, 72233], [64, 72393], [73, 72873], [79, 73113], [85, 73493], [88, 73653], [94, 73913], [97, 74243], [104, 74573], [108, 74713], [112, 74913]]}, {"verse": 12, "start": 76298, "end": 82797, "text": "Entonces él os mostrará una gran sala amueblada en el piso de arriba; preparad allí.", "words": [[0, 76298], [9, 76985], [12, 77385], [15, 77925], [24, 78545], [28, 78705], [33, 78925], [38, 79445], [48, 79965], [51, 80125], [54, 80265], [59, 80765], [62, 80905], [70, 81831], [79, 82318]]}, {"verse": 13, "start": 83247, "end": 88310, "text": "Fueron pues, y hallaron como les había dicho; y prepararon la pascua.", "words": [[0, 83247], [7, 83533], [13, 83973], [15, 84733], [24, 85153], [29, 85513], [33, 85733], [39, 86073], [46, 87022], [48, 87132], [59, 87812], [62, 88061]]}, {"verse": 14, "start": 88760, "end": 93242, "text": "Y como fue hora, se sentó a la mesa, y con él los apóstoles.", "words": [[0, 88760], [2, 89083], [7, 89303], [11, 89713], [17, 90123], [20, 90223], [26, 90643], [28, 90723], [31, 90803], [37, 91083], [39, 91523], [43, 91763], [46, 91963], [50, 92223]]}, {"verse": 15, "start": 93692, "end": 100067, "text": "Y les dijo: En gran manera he deseado comer con vosotros esta pascua antes que padezca;", "words": [[0, 93692], [2, 93816], [6, 93956], [12, 94767], [15, 94934], [20, 95174], [27, 95654], [30, 95854], [38, 96394], [44, 96734], [48, 96994], [57, 97694], [62, 98074], [69, 98594], [75, 99034], [79, 99294]]}, {"verse": 16, "start": 100517, "end": 106107, "text": "Porque os digo que no comeré más de ella, hasta que se cumpla en el reino de Dios.", "words": [[0, 100517], [7, 100910], [10, 101070], [15, 101290], [19, 101470], [22, 101630], [29, 102070], [33, 102330], [36, 102550], [42, 102870], [48, 103350], [52, 103530], [55, 103670], [62, 104310], [65, 104790], [68, 104950], [74, 105350], [77, 105510]]}, {"verse": 17, "start": 106557, "end": 113532, "text": "Y tomando la copa, habiendo dado gracias, dijo: Tomad esto, y repartidlo entre vosotros;", "words": [[0, 106557], [2, 106702], [10, 107182], [13, 107362], [19, 107962], [28, 108302], [33, 108562], [42, 109402], [48, 110283], [54, 110667], [60, 111047], [62, 111687], [73, 112327], [79, 112747]]}, {"verse": 18, "start": 113982, "end": 119491, "text": "Porque os digo, que no beberé más del fruto de la vid, hasta que el reino de Dios venga.", "words": [[0, 113982], [7, 114203], [10, 114343], [16, 114563], [20, 114943], [23, 115143], [30, 115623], [34, 115843], [38, 116233], [44, 116623], [47, 116743], [50, 116903], [55, 117063], [61, 117583], [65, 117763], [68, 117903], [74, 118283], [77, 118443], [82, 118683]]}, {"verse": 19, "start": 119941, "end": 131066, "text": "Y tomando el pan, habiendo dado gracias, partió, y les dio, diciendo: Esto es mi cuerpo, que por vosotros es dado: haced esto en memoria de mí.", "words": [[0, 119941], [2, 120059], [10, 120479], [13, 120639], [18, 121179], [27, 121719], [32, 121979], [41, 123019], [49, 123699], [51, 124179], [55, 124359], [60, 124590], [70, 125969], [75, 126289], [78, 126429], [81, 126529], [89, 126889], [93, 127149], [97, 127369], [106, 127929], [109, 128129], [115, 129116], [121, 129316], [126, 129876], [129, 130056], [137, 130536], [140, 130716]]}, {"verse": 20, "start": 131516, "end": 142269, "text": "Asimismo también la copa, después que hubo cenado, diciendo: Esta copa es el nuevo pacto en mi sangre, que por vosotros se derrama.", "words": [[0, 131777], [9, 132067], [17, 133146], [20, 133310], [26, 133750], [34, 134030], [38, 134230], [43, 134630], [51, 135030], [61, 136613], [66, 136875], [71, 137415], [74, 137555], [77, 137735], [83, 138075], [89, 138775], [92, 138875], [95, 139035], [103, 139455], [107, 139935], [111, 140695], [120, 141235], [123, 141495]]}, {"verse": 21, "start": 142719, "end": 146881, "text": "Con todo eso, he aquí la mano del que me entrega, conmigo en la mesa.", "words": [[0, 142719], [4, 142861], [9, 143141], [14, 143481], [17, 143801], [22, 144081], [25, 144241], [30, 144421], [34, 144601], [38, 144781], [41, 144961], [50, 145641], [58, 146101], [61, 146201], [64, 146321]]}, {"verse": 22, "start": 147331, "end": 155245, "text": "Y a la verdad el Hijo del hombre va, según lo que está determinado; pero ¡ay de aquel hombre por el cual es entregado!", "words": [[0, 147331], [2, 147428], [4, 147468], [7, 147588], [14, 148028], [17, 148568], [22, 148868], [26, 149028], [33, 149408], [37, 149608], [43, 150068], [46, 150368], [50, 150508], [55, 150728], [68, 152018], [73, 152306], [77, 152626], [80, 152846], [86, 153126], [93, 153366], [97, 153666], [100, 153806], [105, 154046], [108, 154306]]}, {"verse": 23, "start": 155695, "end": 162366, "text": "Ellos entonces comenzaron a preguntar entre sí, cuál de ellos sería el que había de hacer esto.", "words": [[0, 155695], [6, 156127], [15, 156787], [26, 157747], [28, 157827], [38, 158447], [44, 158707], [48, 159067], [53, 159827], [56, 160087], [62, 160327], [68, 160637], [71, 160947], [75, 161067], [81, 161287], [84, 161507], [90, 161747]]}, {"verse": 24, "start": 162816, "end": 167071, "text": "Y hubo entre ellos una disputa, quién de ellos parecía ser el mayor.", "words": [[0, 162816], [2, 162976], [7, 163316], [13, 163536], [19, 163856], [23, 164096], [32, 164856], [38, 165116], [41, 165216], [47, 165496], [55, 166076], [59, 166356], [62, 166476]]}, {"verse": 25, "start": 167521, "end": 177957, "text": "Entonces él les dijo: Los reyes de las naciones dominan sobre ellas; y los que sobre ellas tienen autoridad, son llamados bienhechores:", "words": [[0, 167521], [9, 168346], [12, 168486], [16, 168706], [22, 169524], [26, 169670], [32, 170070], [35, 170190], [39, 170350], [48, 170870], [56, 171730], [62, 172030], [69, 173098], [71, 173225], [75, 173365], [79, 173545], [85, 173865], [91, 174125], [98, 174625], [109, 175565], [113, 176125], [122, 176705]]}, {"verse": 26, "start": 178407, "end": 187439, "text": "Pero vosotros, no así: antes el que es mayor entre vosotros, sea como el más joven; y el que dirige, como el que sirve.", "words": [[0, 178407], [5, 178574], [15, 179614], [18, 179694], [23, 180479], [29, 180979], [32, 181359], [36, 181519], [39, 181679], [45, 182039], [51, 182339], [61, 182979], [65, 183679], [70, 183979], [73, 184119], [77, 184259], [84, 185158], [86, 185282], [89, 185432], [93, 185592], [101, 186172], [106, 186462], [109, 186752], [113, 186832]]}, {"verse": 27, "start": 187889, "end": 198299, "text": "Porque, ¿cuál es mayor, el que se sienta a la mesa, o el que sirve? ¿No es el que se sienta a la mesa? Y yo soy entre vosotros como el que sirve.", "words": [[0, 188051], [8, 188251], [14, 188871], [17, 189031], [24, 189451], [27, 189771], [31, 189951], [34, 190111], [41, 190671], [43, 190751], [46, 190871], [52, 191211], [54, 191851], [57, 191971], [61, 192091], [68, 193076], [72, 193265], [75, 193585], [78, 193865], [82, 194005], [85, 194145], [92, 194665], [94, 194765], [97, 194845], [103, 195709], [105, 195837], [108, 196017], [112, 196317], [118, 196577], [127, 197197], [132, 197457], [135, 197637], [139, 197737]]}, {"verse": 28, "start": 198749, "end": 204038, "text": "Pero vosotros sois los que habéis permanecido conmigo en mis tentaciones:", "words": [[0, 198749], [5, 198913], [14, 199473], [19, 200553], [23, 201053], [27, 201213], [34, 201453], [46, 202193], [54, 202673], [57, 202813], [61, 202953]]}, {"verse": 29, "start": 204488, "end": 209909, "text": "Yo pues os concedo un reino, como mi Padre me lo concedió a mí,", "words": [[0, 204488], [3, 204929], [8, 205249], [11, 205689], [19, 206229], [22, 206329], [29, 207069], [34, 207589], [37, 207789], [43, 208209], [46, 208629], [49, 208749], [58, 209409], [60, 209529]]}, {"verse": 30, "start": 210359, "end": 219457, "text": "Para que comáis y bebáis en mi mesa en mi reino, y os sentéis sobre tronos juzgando a las doce tribus de Israel.", "words": [[0, 210359], [5, 210520], [9, 210700], [16, 211440], [18, 211800], [25, 212240], [28, 212460], [31, 212620], [36, 212900], [39, 213100], [42, 213240], [49, 213720], [51, 214200], [54, 214680], [62, 215160], [68, 215500], [75, 216320], [84, 217040], [86, 217200], [90, 217340], [95, 217760], [102, 218400], [105, 218540]]}, {"verse": 31, "start": 219907, "end": 227376, "text": "Dijo también el Señor: Simón, Simón, he aquí Satanás os ha pedido para zarandaros como a trigo;", "words": [[0, 219907], [5, 220393], [13, 220713], [16, 220993], [23, 221830], [30, 222234], [37, 222884], [40, 223534], [45, 223914], [53, 224854], [56, 224954], [59, 225074], [66, 225474], [71, 225714], [82, 226494], [87, 226808], [89, 227122]]}, {"verse": 32, "start": 227826, "end": 234766, "text": "Pero yo he rogado por ti que tu fe no falte: y tú, una vez vuelto, fortalece a tus hermanos.", "words": [[0, 227826], [5, 228167], [8, 228367], [11, 228647], [18, 228927], [22, 229187], [25, 229467], [29, 229607], [32, 229787], [35, 230047], [38, 230147], [45, 231179], [47, 231318], [51, 231558], [55, 231958], [59, 232298], [67, 232858], [77, 233658], [79, 233738], [83, 233878]]}, {"verse": 33, "start": 235216, "end": 240064, "text": "Y él le dijo: Señor, estoy dispuesto a ir contigo aun a cárcel y a muerte.", "words": [[0, 235216], [2, 235423], [5, 235563], [8, 235683], [14, 236451], [21, 237147], [27, 237347], [37, 237847], [39, 238007], [42, 238087], [50, 238347], [54, 238607], [56, 238867], [63, 239347], [65, 239507], [67, 239527]]}, {"verse": 34, "start": 240414, "end": 247205, "text": "Y él dijo: Pedro, te digo que el gallo no cantará hoy antes que tú niegues tres veces que me conoces.", "words": [[0, 240414], [2, 240559], [5, 240679], [11, 241420], [18, 242265], [21, 242445], [26, 242705], [30, 242885], [33, 242985], [39, 243265], [42, 243405], [50, 243945], [54, 244225], [60, 244585], [64, 244805], [67, 245005], [75, 245445], [80, 245665], [86, 246045], [90, 246245], [93, 246385]]}, {"verse": 35, "start": 247655, "end": 257240, "text": "Y a ellos dijo: Cuando os envié sin bolsa, y sin bolsa de viaje, y sin zapatos, ¿os faltó algo? Y ellos dijeron: Nada.", "words": [[0, 247655], [2, 247803], [4, 247883], [10, 248043], [16, 248943], [23, 249248], [26, 249588], [32, 249928], [36, 250068], [43, 250588], [45, 250708], [49, 250888], [55, 251328], [58, 251428], [65, 251728], [67, 252008], [71, 252168], [80, 253208], [84, 253368], [90, 253828], [96, 254662], [98, 254804], [104, 254984], [113, 256035]]}, {"verse": 36, "start": 257590, "end": 266730, "text": "Y les dijo: Pues ahora, el que tiene bolsa, tómela, y también la bolsa de viaje, y el que no tiene, venda su capa y compre espada.", "words": [[0, 257590], [2, 257714], [6, 257854], [12, 258665], [17, 258810], [24, 259210], [27, 259770], [31, 259910], [37, 260130], [44, 261130], [52, 261510], [54, 261890], [62, 262170], [65, 262350], [71, 262670], [74, 262790], [81, 263130], [83, 263610], [86, 263710], [90, 263830], [93, 263990], [100, 264710], [106, 264970], [109, 265150], [114, 265570], [116, 265650], [123, 266050]]}, {"verse": 37, "start": 267180, "end": 276719, "text": "Porque os digo, que es necesario que se cumpla todavía en mí aquello que está escrito: Y con los malos fue contado: porque lo que está escrito de mí, cumplimiento tiene.", "words": [[0, 267180], [7, 267403], [10, 267563], [16, 267763], [20, 268003], [23, 268183], [33, 268903], [37, 269103], [40, 269243], [47, 269703], [55, 270023], [58, 270323], [61, 270463], [69, 271083], [73, 271203], [78, 271343], [87, 272206], [89, 272284], [93, 272444], [97, 272604], [103, 272924], [107, 273084], [116, 274050], [123, 274234], [126, 274414], [130, 274534], [135, 274674], [143, 274994], [146, 275254], [150, 275414], [163, 276074]]}, {"verse": 38, "start": 277169, "end": 283222, "text": "Entonces ellos dijeron: Señor, he aquí dos espadas. Y él les dijo: Basta.", "words": [[0, 277169], [9, 277685], [15, 278085], [24, 279149], [31, 279667], [34, 279747], [39, 279987], [43, 280167], [52, 281280], [54, 281477], [57, 281617], [61, 281817], [67, 282672]]}, {"verse": 39, "start": 283672, "end": 289982, "text": "Y saliendo, se fue, como solía, al monte de los Olivos; y sus discípulos también le siguieron.", "words": [[0, 283672], [2, 283971], [12, 284511], [15, 284711], [20, 284991], [25, 285311], [32, 285811], [35, 286071], [41, 286351], [44, 286611], [48, 286751], [56, 287753], [58, 287860], [62, 288000], [73, 288620], [81, 288900], [84, 289120]]}, {"verse": 40, "start": 290432, "end": 296448, "text": "Y cuando llegó a aquel lugar, les dijo: Orad que no entréis en tentación.", "words": [[0, 290642], [2, 290852], [9, 291132], [15, 291552], [17, 291872], [23, 292232], [30, 292832], [34, 293032], [40, 293857], [45, 294260], [49, 294740], [52, 294920], [60, 295400], [63, 295580]]}, {"verse": 41, "start": 296898, "end": 303138, "text": "Y él se apartó de ellos como un tiro de piedra; y puesto de rodillas oró,", "words": [[0, 296898], [2, 297049], [5, 297189], [8, 297349], [15, 297889], [18, 298029], [24, 298309], [29, 298629], [32, 298849], [37, 299129], [40, 299329], [48, 300249], [50, 300485], [57, 300745], [60, 301005], [69, 301505]]}, {"verse": 42, "start": 303588, "end": 309918, "text": "Diciendo: Padre, si quieres, aparta esta copa de mí; pero no se haga mi voluntad, sino la tuya.", "words": [[0, 303859], [10, 304445], [17, 304445], [20, 304628], [29, 305338], [36, 306048], [41, 306228], [46, 306648], [49, 306768], [53, 307336], [58, 307502], [61, 307682], [64, 307862], [69, 308042], [72, 308222], [82, 308842], [87, 309142], [90, 309382]]}, {"verse": 43, "start": 310368, "end": 313660, "text": "Y le apareció un ángel del cielo confortándole.", "words": [[0, 310368], [2, 310493], [5, 310593], [14, 311193], [17, 311473], [23, 311913], [27, 312073], [33, 312473]]}, {"verse": 44, "start": 314110, "end": 323065, "text": "Y estando en agonía, oraba más intensamente: y fue su sudor como grandes gotas de sangre que caían hasta la tierra.", "words": [[0, 314110], [2, 314392], [10, 314832], [13, 314992], [21, 316052], [27, 316612], [31, 316912], [45, 318395], [47, 318516], [51, 318696], [54, 318916], [60, 319356], [65, 319596], [73, 320076], [79, 320696], [82, 320836], [89, 321276], [93, 321496], [99, 321956], [105, 322236], [108, 322416]]}, {"verse": 45, "start": 323515, "end": 329522, "text": "Y como se levantó de la oración, y vino a sus discípulos, los halló durmiendo de tristeza;", "words": [[0, 323515], [2, 323753], [7, 323953], [10, 324133], [18, 324613], [21, 324866], [24, 325120], [33, 325373], [35, 325773], [40, 326013], [42, 326173], [46, 326353], [58, 327373], [62, 327533], [68, 327953], [78, 328513], [81, 328673]]}, {"verse": 46, "start": 329972, "end": 335607, "text": "Y les dijo: ¿Por qué dormís? Levantaos, y orad que no entréis en tentación.", "words": [[0, 329972], [2, 330096], [6, 330236], [12, 331047], [17, 331171], [21, 331371], [29, 332440], [40, 333211], [42, 333431], [47, 333751], [51, 333951], [54, 334131], [62, 334671], [65, 334811]]}, {"verse": 47, "start": 336057, "end": 346921, "text": "Estando él aún hablando, he aquí una turba; y el que se llamaba Judas, uno de los doce, iba delante de ellos; y se acercó hasta Jesús para besarlo.", "words": [[0, 336057], [8, 336504], [11, 336804], [15, 337104], [25, 337404], [28, 337704], [33, 337904], [37, 338144], [44, 339103], [46, 339325], [49, 339445], [53, 339565], [56, 339725], [64, 340105], [71, 340945], [75, 341345], [78, 341505], [82, 341645], [88, 342445], [92, 342725], [100, 343185], [103, 343365], [110, 344266], [112, 344389], [115, 344529], [122, 345129], [128, 345369], [134, 345749], [139, 346363]]}, {"verse": 48, "start": 347371, "end": 352943, "text": "Entonces Jesús le dijo: Judas, ¿con beso entregas al Hijo del hombre?", "words": [[0, 347371], [9, 347778], [15, 348318], [18, 348658], [24, 349488], [31, 350428], [36, 350848], [41, 351268], [50, 351828], [53, 351988], [58, 352228], [62, 352428]]}, {"verse": 49, "start": 353393, "end": 359739, "text": "Y viendo los que estaban con él lo que había de ser, le dijeron: Señor, ¿heriremos con la espada?", "words": [[0, 353393], [2, 353540], [9, 353880], [13, 354080], [17, 354220], [25, 354540], [29, 354840], [32, 355080], [35, 355400], [39, 355540], [45, 355760], [48, 355960], [53, 356540], [56, 356700], [65, 357730], [72, 358448], [83, 358948], [87, 359108], [90, 359208]]}, {"verse": 50, "start": 360089, "end": 366190, "text": "Y uno de ellos hirió a un siervo del sumo sacerdote, y le quitó la oreja derecha.", "words": [[0, 360089], [2, 360269], [6, 360509], [9, 360669], [15, 361009], [21, 361549], [23, 361769], [26, 361929], [33, 362469], [37, 362589], [42, 363109], [53, 363849], [55, 364269], [58, 364409], [64, 364929], [67, 365129], [73, 365529]]}, {"verse": 51, "start": 366640, "end": 373317, "text": "Entonces respondiendo Jesús, dijo: Dejad hasta aquí. Y tocando su oreja, le sanó.", "words": [[0, 366640], [9, 367352], [22, 368172], [29, 368352], [35, 369331], [41, 369827], [47, 370147], [53, 371083], [55, 371189], [63, 371609], [66, 371869], [73, 372749], [76, 372849]]}, {"verse": 52, "start": 373767, "end": 386984, "text": "Y Jesús dijo a los que habían venido a él, los principales sacerdotes, y los jefes de la guardia del templo, y los ancianos: ¿Como a ladrón habéis salido con espadas y con palos?", "words": [[0, 373767], [2, 373894], [8, 374294], [13, 374794], [15, 375114], [19, 375254], [23, 375414], [30, 375734], [37, 376214], [39, 376374], [43, 377154], [47, 377314], [59, 378014], [71, 378814], [73, 379314], [77, 379454], [83, 379834], [86, 379914], [89, 380014], [97, 380354], [101, 380514], [109, 381074], [111, 381554], [115, 381694], [125, 382889], [131, 383056], [133, 383256], [140, 383756], [147, 384416], [154, 385056], [158, 385276], [166, 385756], [168, 385956], [172, 386136]]}, {"verse": 53, "start": 387434, "end": 397999, "text": "Habiendo estado con vosotros cada día en el templo, no extendisteis las manos contra mí; pero esta es vuestra hora, y la potestad de las tinieblas.", "words": [[0, 387434], [9, 387760], [16, 388060], [20, 388400], [29, 388900], [34, 389120], [38, 389440], [41, 389600], [44, 389740], [52, 390760], [55, 390900], [68, 392280], [72, 392600], [78, 392980], [85, 393320], [89, 393980], [94, 394127], [99, 394387], [102, 394527], [110, 394907], [116, 395227], [118, 395867], [121, 396007], [130, 396607], [133, 396727], [137, 396867]]}, {"verse": 54, "start": 398449, "end": 406384, "text": "Y prendiéndole le trajeron, y le metieron en casa del sumo sacerdote. Y Pedro le seguía de lejos.", "words": [[0, 398449], [2, 398574], [15, 399594], [18, 399894], [28, 400734], [30, 401414], [33, 401514], [42, 401974], [45, 402174], [50, 402474], [54, 402714], [59, 403194], [70, 404379], [72, 404648], [78, 404968], [81, 405188], [88, 405588], [91, 405688]]}, {"verse": 55, "start": 406834, "end": 415277, "text": "Y habiendo encendido fuego en medio del patio, y sentándose todos alrededor, se sentó también Pedro entre ellos.", "words": [[0, 406834], [2, 406939], [11, 407339], [21, 408019], [27, 408379], [30, 408759], [36, 409039], [40, 409259], [47, 410279], [49, 410359], [60, 411159], [66, 411539], [77, 412919], [80, 413059], [86, 413479], [94, 413759], [100, 414239], [106, 414559]]}, {"verse": 56, "start": 415727, "end": 423684, "text": "Y como una criada le vio que estaba sentado al fuego, se fijó en él, y dijo: Y este con él estaba.", "words": [[0, 415727], [2, 415852], [7, 416092], [11, 416332], [18, 416892], [21, 417072], [25, 417332], [29, 417452], [36, 417902], [44, 418352], [47, 418492], [54, 419452], [57, 419692], [62, 420132], [65, 420312], [69, 420592], [71, 421172], [77, 421994], [79, 422142], [84, 422442], [88, 422722], [91, 422922]]}, {"verse": 57, "start": 424034, "end": 428528, "text": "Entonces él lo negó, diciendo: Mujer, no le conozco.", "words": [[0, 424034], [9, 424479], [12, 424979], [15, 425279], [21, 425739], [31, 427163], [38, 427504], [41, 427804], [44, 427924]]}, {"verse": 58, "start": 428878, "end": 435994, "text": "Y un poco después, viéndole otro, dijo: Y tú de ellos eras. Y Pedro dijo: Hombre, no soy.", "words": [[0, 428878], [2, 428980], [5, 429100], [10, 429320], [19, 430220], [28, 430640], [34, 431360], [40, 432052], [42, 432174], [45, 432394], [48, 432594], [54, 432814], [60, 433765], [62, 433889], [68, 434229], [74, 435181], [82, 435383], [85, 435583]]}, {"verse": 59, "start": 436344, "end": 443857, "text": "Y como una hora pasada otro afirmaba, diciendo: Verdaderamente también este estaba con él, porque es galileo.", "words": [[0, 436344], [2, 436473], [7, 436733], [11, 436973], [16, 437373], [23, 437773], [28, 437993], [38, 439253], [48, 440361], [63, 441097], [71, 441357], [76, 441717], [83, 442017], [87, 442297], [91, 442917], [98, 443157], [101, 443277]]}, {"verse": 60, "start": 444207, "end": 451112, "text": "Y Pedro dijo: Hombre, no sé qué dices. Y enseguida, estando él aún hablando, el gallo cantó.", "words": [[0, 444207], [2, 444331], [8, 444671], [14, 445623], [22, 446005], [25, 446065], [28, 446245], [32, 446345], [39, 447332], [41, 447459], [52, 448019], [60, 448459], [63, 448659], [67, 448839], [77, 449959], [80, 450099], [86, 450519]]}, {"verse": 61, "start": 451562, "end": 462953, "text": "Entonces, vuelto el Señor, miró a Pedro: y Pedro se acordó de la palabra del Señor como le había dicho: Antes que el gallo cante, me negarás tres veces.", "words": [[0, 451562], [10, 452164], [17, 452944], [20, 453104], [27, 453384], [32, 453664], [34, 453944], [41, 455212], [43, 455432], [49, 455792], [52, 456192], [59, 456672], [62, 456772], [65, 456872], [73, 457172], [77, 457432], [83, 457732], [88, 458352], [91, 458512], [97, 458732], [104, 459610], [110, 459953], [114, 460153], [117, 460293], [123, 460723], [130, 461153], [133, 461493], [141, 461833], [146, 462093]]}, {"verse": 62, "start": 463403, "end": 466659, "text": "Y saliendo fuera Pedro, lloró amargamente.", "words": [[0, 463403], [2, 463508], [11, 463968], [17, 464208], [24, 465168], [30, 465548]]}, {"verse": 63, "start": 467109, "end": 471508, "text": "Y los hombres que tenían a Jesús, se burlaban de él hiriéndole;", "words": [[0, 467109], [2, 467214], [6, 467374], [14, 467714], [18, 467894], [25, 468234], [27, 468454], [34, 468834], [37, 469394], [46, 469994], [49, 470254], [52, 470909]]}, {"verse": 64, "start": 471958, "end": 479323, "text": "Y cubriéndole, herían su rostro, y le preguntaban, diciendo: Profetiza quién es el que te hirió.", "words": [[0, 471958], [2, 472122], [15, 472842], [22, 473562], [25, 473722], [33, 474762], [35, 474842], [38, 474962], [51, 475722], [61, 477391], [71, 477975], [77, 478215], [80, 478435], [83, 478535], [87, 478675], [90, 479020]]}, {"verse": 65, "start": 479673, "end": 482573, "text": "Y decían otras muchas cosas injuriándole.", "words": [[0, 479673], [2, 479782], [9, 480262], [15, 480542], [22, 480922], [28, 481775]]}, {"verse": 66, "start": 483023, "end": 491226, "text": "Al amanecer, se juntaron los ancianos del pueblo, y los principales sacerdotes, y los escribas, y le trajeron a su Consejo,", "words": [[0, 483023], [3, 483223], [13, 483843], [16, 484043], [25, 484603], [29, 484783], [38, 485303], [42, 485443], [50, 485943], [52, 486403], [56, 486543], [68, 487243], [80, 488123], [82, 488343], [86, 488463], [96, 489163], [98, 489503], [101, 489623], [110, 490203], [112, 490283], [115, 490423]]}, {"verse": 67, "start": 491676, "end": 498853, "text": "Y le preguntaron: ¿Eres tú el Cristo? dínoslo. Y les dijo: Si os lo digo, no creeréis;", "words": [[0, 491676], [2, 491776], [5, 491896], [18, 493127], [24, 493307], [27, 493607], [30, 493747], [38, 494647], [47, 495586], [49, 495709], [53, 495849], [59, 496660], [62, 497010], [65, 497170], [68, 497330], [74, 497690], [77, 497830]]}, {"verse": 68, "start": 499303, "end": 504014, "text": "Y también si os pregunto, no me responderíais ni me soltaríais.", "words": [[0, 499303], [2, 499410], [10, 499690], [13, 499950], [16, 500030], [26, 500810], [29, 501110], [32, 501290], [46, 502350], [49, 502790], [52, 503427]]}, {"verse": 69, "start": 504464, "end": 509326, "text": "Pero desde ahora el Hijo del hombre se sentará a la diestra del poder de Dios.", "words": [[0, 504464], [5, 504609], [11, 504889], [17, 505269], [20, 505489], [25, 505769], [29, 505909], [36, 506309], [39, 506429], [47, 507009], [49, 507249], [52, 507329], [60, 507829], [64, 508069], [70, 508429], [73, 508669]]}, {"verse": 70, "start": 509776, "end": 517076, "text": "Y dijeron todos: ¿Entonces tú eres Hijo de Dios? Y él les dijo: Vosotros decís que yo soy.", "words": [[0, 509776], [2, 509943], [10, 510463], [17, 511703], [27, 512225], [30, 512485], [35, 512645], [40, 512925], [43, 513085], [49, 513968], [51, 514164], [54, 514304], [58, 514504], [64, 515359], [73, 515825], [79, 516305], [83, 516405], [86, 516585]]}, {"verse": 71, "start": 517526, "end": 523593, "text": "Entonces ellos dijeron: ¿Qué más testimonio deseamos? porque nosotros lo hemos oído de su boca.", "words": [[0, 517526], [9, 518042], [15, 518442], [24, 519506], [29, 519610], [33, 519790], [44, 520390], [54, 521473], [61, 521637], [70, 521977], [73, 522297], [79, 522437], [84, 522817], [87, 522977], [90, 523117]]}]}