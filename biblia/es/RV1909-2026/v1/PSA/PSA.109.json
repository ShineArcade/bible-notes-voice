{"book": "PSA", "chapter": 109, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 193485, "verses": [{"verse": 1, "start": 300, "end": 5818, "text": "Al Músico principal: Salmo de David. OH Dios de mi alabanza, no calles;", "words": [[0, 300], [3, 479], [10, 979], [21, 2149], [27, 2696], [30, 2856], [37, 3674], [40, 3822], [45, 4137], [48, 4452], [51, 4767], [61, 5082], [64, 5182]]}, {"verse": 2, "start": 6268, "end": 14086, "text": "Porque boca de impío y boca de engañador se han abierto sobre mí: han hablado de mí con lengua mentirosa,", "words": [[0, 6268], [7, 6492], [12, 6812], [15, 7052], [21, 7692], [23, 7932], [28, 8172], [31, 8392], [41, 9132], [44, 9572], [48, 9732], [56, 10352], [62, 10672], [66, 11450], [70, 11710], [78, 12310], [81, 12450], [84, 12610], [88, 12770], [95, 13190]]}, {"verse": 3, "start": 14536, "end": 20219, "text": "Y con palabras de odio me rodearon; y pelearon contra mí sin causa.", "words": [[0, 14536], [2, 14663], [6, 14923], [15, 15343], [18, 15643], [23, 16022], [26, 16202], [36, 17681], [38, 17806], [47, 18426], [54, 18826], [57, 19126], [61, 19366]]}, {"verse": 4, "start": 20669, "end": 24611, "text": "En pago de mi amor me han sido adversarios: mas yo oraba.", "words": [[0, 20669], [3, 20853], [8, 21313], [11, 21453], [14, 21613], [19, 21873], [22, 22053], [26, 22173], [31, 22433], [44, 23914], [48, 24161], [51, 24407]]}, {"verse": 5, "start": 25061, "end": 28505, "text": "Y pusieron contra mí mal por bien, y odio por amor.", "words": [[0, 25061], [2, 25184], [11, 25644], [18, 26064], [21, 26344], [25, 26624], [29, 26844], [35, 27104], [37, 27404], [42, 27764], [46, 27964]]}, {"verse": 6, "start": 28955, "end": 33344, "text": "Pon sobre él al impío: y Satán esté a su diestra.", "words": [[0, 28955], [4, 29141], [10, 29441], [13, 29805], [16, 30168], [23, 30832], [25, 31192], [31, 31572], [36, 32212], [38, 32412], [41, 32532]]}, {"verse": 7, "start": 33794, "end": 38735, "text": "Cuando sea juzgado, salga culpable; y su oración sea para pecado.", "words": [[0, 33794], [7, 34094], [11, 34414], [20, 34934], [26, 35414], [36, 36609], [38, 36735], [41, 36915], [49, 37383], [53, 37850], [58, 38318]]}, {"verse": 8, "start": 39185, "end": 42631, "text": "Sean sus días pocos: tome otro su oficio.", "words": [[0, 39348], [5, 39548], [9, 39748], [14, 39948], [21, 41018], [26, 41263], [31, 41483], [34, 41743]]}, {"verse": 9, "start": 43081, "end": 46307, "text": "Sean sus hijos huérfanos, y su mujer viuda.", "words": [[0, 43081], [5, 43386], [9, 43606], [15, 43946], [26, 44826], [28, 45126], [31, 45286], [37, 45626]]}, {"verse": 10, "start": 46757, "end": 54229, "text": "Y anden sus hijos vagabundos, y mendiguen; y procuren su pan lejos de sus desolados hogares.", "words": [[0, 46757], [2, 46886], [8, 47206], [12, 47426], [18, 47746], [30, 48466], [32, 48686], [43, 49950], [45, 50296], [54, 50686], [57, 50846], [61, 51206], [67, 51986], [70, 52146], [74, 52306], [84, 53186]]}, {"verse": 11, "start": 54679, "end": 60277, "text": "Se apodere el acreedor de todo lo que tiene, y extraños saqueen su trabajo.", "words": [[0, 54679], [3, 54866], [11, 55466], [14, 55686], [23, 56326], [26, 56546], [31, 56826], [34, 57046], [38, 57146], [45, 57546], [47, 57826], [56, 58596], [64, 59366], [67, 59546]]}, {"verse": 12, "start": 60727, "end": 67097, "text": "No tenga quien le haga misericordia; ni haya quien tenga compasión de sus huérfanos.", "words": [[0, 60727], [3, 60874], [9, 61294], [15, 61574], [18, 61854], [23, 62054], [37, 63752], [40, 64012], [45, 64272], [51, 64372], [57, 64892], [67, 65652], [70, 65832], [74, 66012]]}, {"verse": 13, "start": 67547, "end": 73409, "text": "Su posteridad sea talada; en segunda generación sea borrado su nombre.", "words": [[0, 67547], [3, 67691], [14, 68378], [18, 69066], [26, 70018], [29, 70165], [37, 70565], [48, 71325], [52, 71685], [60, 72465], [63, 72705]]}, {"verse": 14, "start": 73859, "end": 81234, "text": "Venga en memoria cerca de Jehová la maldad de sus padres, y el pecado de su madre no sea borrado.", "words": [[0, 73859], [6, 74264], [9, 74384], [17, 74804], [23, 75124], [26, 75404], [33, 75844], [36, 75924], [43, 76404], [46, 76584], [50, 76724], [58, 77584], [60, 77924], [63, 78084], [70, 78784], [73, 78984], [76, 79164], [82, 79584], [85, 80158], [89, 80733]]}, {"verse": 15, "start": 81684, "end": 86332, "text": "Estén siempre delante de Jehová, y él corte de la tierra su memoria.", "words": [[0, 81684], [6, 82066], [14, 82546], [22, 83086], [25, 83246], [33, 83726], [35, 83886], [38, 84046], [44, 84686], [47, 84766], [50, 84926], [57, 85206], [60, 85546]]}, {"verse": 16, "start": 86782, "end": 96762, "text": "Por cuanto no se acordó de hacer misericordia, y persiguió al hombre afligido y necesitado y quebrantado de corazón, para matarlo.", "words": [[0, 86782], [4, 86927], [11, 87247], [14, 87687], [17, 87887], [24, 88447], [27, 88567], [33, 89277], [47, 89987], [49, 90427], [59, 91447], [62, 91687], [69, 92007], [78, 92867], [80, 92967], [91, 93787], [93, 93927], [105, 94807], [108, 94947], [117, 95447], [122, 96007]]}, {"verse": 17, "start": 97212, "end": 103368, "text": "Y amó la maldición, y le vino; y no quiso la bendición, y ella se alejó de él.", "words": [[0, 97317], [2, 97457], [6, 97597], [9, 97697], [20, 98317], [22, 99057], [25, 99197], [31, 100028], [33, 100135], [36, 100255], [42, 100595], [45, 100755], [56, 101395], [58, 101855], [63, 102155], [66, 102355], [72, 102835], [75, 102955]]}, {"verse": 18, "start": 103818, "end": 111545, "text": "Y se vistió de maldición como de su vestido, y entró como agua en sus entrañas, y como aceite en sus huesos.", "words": [[0, 103818], [2, 103942], [5, 104082], [12, 104522], [15, 104622], [25, 105222], [30, 105522], [33, 105702], [36, 105842], [45, 106482], [47, 106862], [53, 107322], [58, 107522], [63, 107882], [66, 108062], [70, 108202], [80, 108922], [82, 109702], [87, 109942], [94, 110362], [97, 110662], [101, 110862]]}, {"verse": 19, "start": 111995, "end": 118156, "text": "Le sea como vestido con que se cubra, y en lugar de cinto con que se ciña siempre.", "words": [[0, 111995], [3, 112122], [7, 112442], [12, 112742], [20, 113362], [24, 113602], [28, 113782], [31, 113942], [38, 114502], [40, 115222], [43, 115382], [49, 115702], [52, 115982], [58, 116422], [62, 116702], [66, 116862], [69, 117002], [74, 117402]]}, {"verse": 20, "start": 118606, "end": 124920, "text": "Este sea el pago de parte de Jehová de los que me calumnian, y de los que hablan mal contra mi alma.", "words": [[0, 118606], [5, 118899], [9, 119219], [12, 119379], [17, 119879], [20, 120019], [26, 120419], [29, 120659], [36, 121179], [39, 121259], [43, 121379], [47, 121539], [50, 121679], [61, 122399], [63, 122859], [66, 122979], [70, 123119], [74, 123279], [81, 123579], [85, 123839], [92, 124179], [95, 124439]]}, {"verse": 21, "start": 125370, "end": 132361, "text": "Y tú, Jehová Señor, haz conmigo por amor de tu nombre: líbrame, porque tu misericordia es buena.", "words": [[0, 125370], [2, 125675], [6, 126115], [13, 126435], [20, 127415], [24, 127595], [32, 128155], [36, 128435], [41, 128675], [44, 128915], [47, 129055], [55, 130009], [64, 130634], [71, 130854], [74, 131074], [87, 131874], [90, 131994]]}, {"verse": 22, "start": 132811, "end": 137418, "text": "Porque yo estoy afligido y necesitado; y mi corazón está herido dentro de mí.", "words": [[0, 132811], [7, 132975], [10, 133175], [16, 133355], [25, 133995], [27, 134095], [39, 135357], [41, 135466], [44, 135586], [52, 135966], [57, 136286], [64, 136626], [71, 136846], [74, 137146]]}, {"verse": 23, "start": 137868, "end": 142490, "text": "Me voy como la sombra cuando declina; soy sacudido como langosta.", "words": [[0, 137868], [3, 137993], [7, 138153], [12, 138393], [15, 138553], [22, 139133], [29, 139705], [38, 140576], [42, 140776], [51, 141476], [56, 142002]]}, {"verse": 24, "start": 142940, "end": 149538, "text": "Mis rodillas están debilitadas a causa del ayuno, y mi carne desfallecida por falta de grasa.", "words": [[0, 142940], [4, 143084], [13, 143604], [19, 143964], [31, 144744], [33, 144924], [39, 145204], [43, 145504], [50, 145944], [52, 146604], [55, 146764], [61, 147164], [74, 148124], [78, 148344], [84, 148704], [87, 148944]]}, {"verse": 25, "start": 149988, "end": 156242, "text": "Yo he sido para ellos objeto de deshonra; me miraban, y meneaban su cabeza.", "words": [[0, 149988], [3, 150253], [6, 150513], [11, 150793], [16, 151073], [22, 151353], [29, 151853], [32, 152428], [42, 153288], [45, 153414], [54, 153994], [56, 154604], [65, 155214], [68, 155434]]}, {"verse": 26, "start": 156692, "end": 161431, "text": "Ayúdame, Jehová Dios mío: sálvame conforme a tu misericordia.", "words": [[0, 157072], [9, 157478], [16, 157885], [21, 157965], [26, 158919], [34, 159516], [43, 160216], [45, 160276], [48, 160376]]}, {"verse": 27, "start": 161881, "end": 166424, "text": "Y entiendan que esta es tu mano; que tú, Jehová, has hecho esto.", "words": [[0, 161881], [2, 162231], [12, 162951], [16, 163131], [21, 163311], [24, 163471], [27, 163591], [33, 164862], [37, 165004], [41, 165184], [49, 165364], [53, 165544], [59, 165724]]}, {"verse": 28, "start": 166874, "end": 174221, "text": "Maldigan ellos, y bendice tú: levántense, mas sean avergonzados, y regocíjese tu siervo.", "words": [[0, 166874], [9, 167695], [16, 168015], [18, 168255], [26, 168675], [30, 169372], [42, 170440], [46, 170600], [51, 171060], [65, 172120], [67, 172770], [78, 173420], [81, 173620]]}, {"verse": 29, "start": 174671, "end": 181067, "text": "Sean vestidos de deshonra los que me calumnian; y sean cubiertos de su confusión como con manto.", "words": [[0, 174671], [5, 174955], [14, 175495], [17, 175875], [26, 176255], [30, 176375], [34, 176515], [37, 177046], [48, 177818], [50, 178094], [55, 178274], [65, 178954], [68, 179074], [71, 179214], [81, 179874], [86, 180094], [90, 180314]]}, {"verse": 30, "start": 181517, "end": 186976, "text": "Yo alabaré a Jehová en gran manera con mi boca, y le alabaré en medio de muchos.", "words": [[0, 181517], [3, 181695], [11, 182215], [13, 182335], [20, 182755], [23, 182915], [28, 183115], [35, 183555], [39, 183795], [42, 183975], [48, 184315], [50, 184895], [53, 185035], [61, 185595], [64, 185735], [70, 186015], [73, 186235]]}, {"verse": 31, "start": 187426, "end": 193085, "text": "Porque él se pondrá a la diestra del pobre, para librar su alma de los que le juzgan.", "words": [[0, 187426], [7, 187651], [10, 187891], [13, 188051], [20, 188551], [22, 188811], [25, 188891], [33, 189391], [37, 189611], [44, 190011], [49, 190651], [56, 191191], [59, 191451], [64, 191771], [67, 192031], [71, 192151], [75, 192311], [78, 192411]]}]}