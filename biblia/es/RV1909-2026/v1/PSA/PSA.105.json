{"book": "PSA", "chapter": 105, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 244735, "verses": [{"verse": 1, "start": 300, "end": 7091, "text": "Alabad a Jehová, invocad su nombre: haced notorias sus obras en los pueblos.", "words": [[0, 300], [7, 823], [9, 1003], [17, 2203], [25, 2823], [28, 3023], [36, 3999], [42, 4552], [51, 5142], [55, 5402], [61, 5842], [64, 6102], [68, 6242]]}, {"verse": 2, "start": 7091, "end": 11964, "text": "Cantadle, cantadle salmos: hablad de todas sus maravillas.", "words": [[0, 7091], [10, 8291], [19, 9031], [27, 10069], [34, 10199], [37, 10539], [43, 10719], [47, 10999]]}, {"verse": 3, "start": 12314, "end": 18714, "text": "Gloriaos en su santo nombre: alégrese el corazón de los que buscan a Jehová.", "words": [[0, 12643], [9, 13003], [12, 13282], [15, 13463], [21, 13903], [29, 15126], [38, 15586], [41, 15926], [49, 16486], [52, 16846], [56, 16966], [60, 17126], [67, 17546], [69, 17666]]}, {"verse": 4, "start": 19065, "end": 23736, "text": "Buscad a Jehová, y su fortaleza: buscad siempre su rostro.", "words": [[0, 19206], [7, 19380], [9, 19553], [17, 20093], [19, 20113], [22, 20253], [33, 21612], [40, 21792], [48, 22392], [51, 22852]]}, {"verse": 5, "start": 24086, "end": 29681, "text": "Acordaos de sus maravillas que hizo, de sus prodigios y de los juicios de su boca,", "words": [[0, 24371], [9, 24691], [12, 24851], [16, 24991], [27, 25611], [31, 26161], [37, 26711], [40, 26791], [44, 26951], [54, 27811], [56, 28211], [59, 28331], [63, 28471], [71, 28851], [74, 29031], [77, 29191]]}, {"verse": 6, "start": 29681, "end": 36082, "text": "Oh vosotros, descendencia de Abraham su siervo, hijos de Jacob, sus escogidos.", "words": [[0, 29786], [3, 29891], [13, 30811], [26, 31851], [29, 32051], [37, 32771], [40, 32851], [48, 33791], [54, 34091], [57, 34311], [64, 35071], [68, 35151]]}, {"verse": 7, "start": 36432, "end": 40961, "text": "Él es Jehová nuestro Dios; en toda la tierra son sus juicios.", "words": [[0, 36629], [3, 36864], [6, 37099], [13, 37334], [21, 37634], [27, 38443], [30, 38598], [35, 38838], [38, 39058], [45, 39378], [49, 39818], [53, 40078]]}, {"verse": 8, "start": 41311, "end": 46366, "text": "Se acordó para siempre de su pacto; de la palabra que mandó para mil generaciones,", "words": [[0, 41311], [3, 41436], [10, 41896], [15, 42076], [23, 42496], [26, 42696], [29, 42836], [36, 43510], [39, 43818], [42, 43938], [50, 44278], [54, 44498], [60, 44898], [65, 45078], [69, 45338]]}, {"verse": 9, "start": 46716, "end": 50943, "text": "La cual concertó con Abraham; y de su juramento a Isaac.", "words": [[0, 46716], [3, 46840], [8, 47040], [17, 47800], [21, 47980], [30, 49049], [32, 49158], [35, 49278], [38, 49438], [48, 50098], [50, 50318]]}, {"verse": 10, "start": 51293, "end": 56535, "text": "Y la estableció a Jacob por decreto, a Israel por pacto sempiterno,", "words": [[0, 51293], [2, 51385], [5, 51515], [16, 52135], [18, 52295], [24, 52635], [28, 53075], [37, 54000], [39, 54100], [46, 54500], [50, 55195], [56, 55891]]}, {"verse": 11, "start": 56885, "end": 61480, "text": "Diciendo: A ti daré la tierra de Canaán por cordel de vuestra heredad.", "words": [[0, 56885], [10, 57968], [12, 58130], [15, 58330], [20, 58750], [23, 58810], [30, 59110], [33, 59310], [40, 59750], [44, 60070], [51, 60530], [54, 60690], [62, 61030]]}, {"verse": 12, "start": 62006, "end": 66771, "text": "Esto siendo ellos pocos hombres en número, y extranjeros en ella.", "words": [[0, 62006], [5, 62812], [12, 63092], [18, 63372], [24, 63872], [32, 64152], [35, 64412], [43, 64832], [45, 65292], [57, 66132], [60, 66312]]}, {"verse": 13, "start": 67121, "end": 71415, "text": "Y anduvieron de nación en nación, de un reino a otro pueblo.", "words": [[0, 67121], [2, 67458], [13, 67828], [16, 67968], [23, 68368], [26, 68568], [34, 69088], [37, 69708], [40, 69888], [46, 70328], [48, 70448], [53, 70648]]}, {"verse": 14, "start": 71765, "end": 77710, "text": "No consintió que hombre los agraviase; y por causa de ellos castigó los reyes.", "words": [[0, 71765], [3, 71894], [13, 72594], [17, 72794], [24, 73134], [28, 73394], [39, 74611], [41, 74735], [45, 74935], [51, 75475], [54, 75735], [60, 76015], [68, 76755], [72, 76915]]}, {"verse": 15, "start": 77930, "end": 83166, "text": "No toquéis, dijo, a mis ungidos, ni hagáis mal a mis profetas.", "words": [[0, 77930], [3, 78107], [12, 79420], [18, 80195], [20, 80316], [24, 80456], [33, 81036], [36, 81316], [43, 81636], [47, 81916], [49, 82176], [53, 82296]]}, {"verse": 16, "start": 83694, "end": 88555, "text": "Y llamó al hambre sobre la tierra, y quebrantó todo mantenimiento de pan.", "words": [[0, 83694], [2, 83816], [8, 84156], [11, 84296], [18, 84656], [24, 84896], [27, 85156], [35, 85656], [37, 86071], [47, 86731], [52, 86951], [66, 87831], [69, 88031]]}, {"verse": 17, "start": 88905, "end": 93224, "text": "Envió un varón delante de ellos, a José, que fue vendido por siervo.", "words": [[0, 88905], [6, 89232], [9, 89392], [15, 89772], [23, 90172], [26, 90352], [33, 90632], [35, 90832], [41, 91432], [45, 91652], [49, 91852], [57, 92332], [61, 92492]]}, {"verse": 18, "start": 93574, "end": 98403, "text": "Afligieron sus pies con grillos; en hierro fue puesta su persona.", "words": [[0, 93574], [11, 94374], [15, 94594], [20, 94894], [24, 95194], [33, 96242], [36, 96439], [43, 96879], [47, 97059], [54, 97519], [57, 97619]]}, {"verse": 19, "start": 98753, "end": 102511, "text": "Hasta la hora que llegó su palabra, el dicho de Jehová le probó.", "words": [[0, 98753], [6, 98958], [9, 99158], [14, 99318], [18, 99498], [24, 99758], [27, 99958], [36, 100778], [39, 100878], [45, 101138], [48, 101338], [55, 101778], [58, 101838]]}, {"verse": 20, "start": 102861, "end": 107895, "text": "Envió el rey, y le soltó; el señor de los pueblos, y le desató.", "words": [[0, 102861], [6, 103103], [9, 103383], [14, 104063], [16, 104223], [19, 104660], [26, 105259], [29, 105383], [35, 105743], [38, 106003], [42, 106143], [51, 106823], [53, 107023], [56, 107123]]}, {"verse": 21, "start": 108245, "end": 113655, "text": "Lo puso por señor de su casa, y por gobernador de todas sus posesiones;", "words": [[0, 108245], [3, 108386], [8, 108806], [12, 109026], [18, 109346], [21, 109606], [24, 109766], [30, 110146], [32, 110766], [36, 111006], [47, 111766], [50, 111986], [56, 112266], [60, 112606]]}, {"verse": 22, "start": 114005, "end": 121248, "text": "Para que reprimiera a sus grandes como él quisiese, y a sus ancianos enseñara sabiduría.", "words": [[0, 114005], [5, 114191], [9, 114411], [20, 115411], [22, 115651], [26, 115811], [34, 116291], [39, 116691], [42, 116931], [52, 117591], [54, 118331], [56, 118431], [60, 118571], [69, 119451], [78, 120331]]}, {"verse": 23, "start": 121598, "end": 127246, "text": "Después entró Israel en Egipto, y Jacob fue extranjero en la tierra de Cam.", "words": [[0, 121598], [8, 121916], [14, 122456], [21, 122836], [24, 123176], [32, 123856], [34, 124316], [40, 124636], [44, 125116], [55, 125936], [58, 126036], [61, 126156], [68, 126516], [71, 126736]]}, {"verse": 24, "start": 127596, "end": 132204, "text": "Y multiplicó su pueblo en gran manera, y lo hizo fuerte más que sus enemigos.", "words": [[0, 127596], [2, 127721], [13, 128401], [16, 128541], [23, 128981], [26, 129161], [31, 129381], [39, 129901], [41, 130081], [44, 130241], [49, 130441], [56, 130841], [60, 131101], [64, 131261], [68, 131441]]}, {"verse": 25, "start": 132554, "end": 139241, "text": "Volvió el corazón de ellos para que aborreciesen a su pueblo, para que contra sus siervos pensasen mal.", "words": [[0, 132554], [7, 133041], [10, 133141], [18, 133561], [21, 133861], [27, 134081], [32, 134381], [36, 134541], [49, 135261], [51, 135401], [54, 135541], [62, 136101], [67, 136501], [71, 136661], [78, 137001], [82, 137221], [90, 138071], [99, 138921]]}, {"verse": 26, "start": 139591, "end": 143733, "text": "Envió a su siervo Moisés, y a Aarón al cual escogió.", "words": [[0, 139591], [6, 140053], [8, 140273], [11, 140433], [18, 140853], [26, 141393], [28, 141773], [30, 142103], [36, 142433], [39, 142553], [44, 142813]]}, {"verse": 27, "start": 144083, "end": 149775, "text": "Pusieron en ellos las palabras de sus señales, y sus prodigios en la tierra de Cam.", "words": [[0, 144083], [9, 144567], [12, 144747], [18, 145007], [22, 145247], [31, 145667], [34, 145907], [38, 146067], [47, 147107], [49, 147267], [53, 147427], [63, 148187], [66, 148387], [69, 148567], [76, 148887], [79, 149147]]}, {"verse": 28, "start": 150125, "end": 155626, "text": "Echó tinieblas, e hizo oscuridad; y no fueron rebeldes a su palabra.", "words": [[0, 150321], [5, 150541], [16, 151381], [18, 151581], [23, 151921], [34, 153263], [36, 153388], [39, 153508], [46, 153828], [55, 154608], [57, 154748], [60, 154868]]}, {"verse": 29, "start": 155976, "end": 159599, "text": "Volvió sus aguas en sangre, y mató sus pescados.", "words": [[0, 155976], [7, 156418], [11, 156558], [17, 157018], [20, 157178], [28, 157638], [30, 158118], [35, 158458], [39, 158638]]}, {"verse": 30, "start": 159949, "end": 164211, "text": "Produjo su tierra ranas, aun en las cámaras de sus reyes.", "words": [[0, 159949], [8, 160373], [11, 160573], [18, 160933], [25, 162033], [29, 162453], [32, 162673], [36, 162833], [44, 163353], [47, 163453], [51, 163613]]}, {"verse": 31, "start": 164561, "end": 169718, "text": "Dijo, y vinieron enjambres de moscas, y piojos en todo su término.", "words": [[0, 164561], [6, 164886], [8, 165386], [17, 165986], [27, 166586], [30, 166726], [38, 167346], [40, 167606], [47, 168066], [50, 168326], [55, 168646], [58, 168906]]}, {"verse": 32, "start": 170068, "end": 174694, "text": "Volvió en su tierra sus lluvias en granizo, y en fuego de llamaradas.", "words": [[0, 170068], [7, 170554], [10, 170654], [13, 170814], [20, 171174], [24, 171474], [32, 172014], [35, 172194], [44, 172734], [46, 173214], [49, 173354], [55, 173614], [58, 173874]]}, {"verse": 33, "start": 175044, "end": 180640, "text": "E hirió sus viñas y sus higueras, y quebró los árboles de su término.", "words": [[0, 175044], [2, 175190], [8, 175670], [12, 175890], [18, 176570], [20, 176850], [24, 177030], [34, 177610], [36, 178130], [43, 178530], [47, 178710], [55, 179350], [58, 179710], [61, 179890]]}, {"verse": 34, "start": 180990, "end": 185424, "text": "Dijo, y vinieron langostas, y pulgón sin número;", "words": [[0, 180990], [6, 181895], [8, 182115], [17, 182575], [28, 183635], [30, 183955], [37, 184515], [41, 184775]]}, {"verse": 35, "start": 185774, "end": 190605, "text": "Y comieron toda la hierba de su país, y devoraron el fruto de su tierra.", "words": [[0, 185774], [2, 186019], [11, 186439], [16, 186719], [19, 186959], [26, 187379], [29, 187519], [32, 187679], [38, 188059], [40, 188519], [50, 189079], [53, 189299], [59, 189699], [62, 189819], [65, 189959]]}, {"verse": 36, "start": 190955, "end": 196637, "text": "Hirió además a todos los primogénitos en su tierra, el principio de toda su fuerza.", "words": [[0, 191118], [6, 191318], [13, 191718], [15, 191918], [21, 192138], [25, 192358], [38, 193118], [41, 193298], [44, 193438], [52, 193858], [55, 194458], [65, 195198], [68, 195498], [73, 195698], [76, 195978]]}, {"verse": 37, "start": 196987, "end": 201524, "text": "Y los sacó con plata y oro; y no hubo en sus tribus enfermo.", "words": [[0, 196987], [2, 197079], [6, 197199], [11, 197719], [15, 197959], [21, 198259], [23, 198619], [28, 199150], [30, 199410], [33, 199570], [38, 200030], [41, 200150], [45, 200350], [52, 200770]]}, {"verse": 38, "start": 201874, "end": 207416, "text": "Egipto se alegró de que salieran; porque su terror había caído sobre ellos.", "words": [[0, 201874], [7, 202461], [10, 202621], [17, 203081], [20, 203161], [24, 203743], [34, 204485], [41, 204689], [44, 204889], [51, 205409], [57, 205769], [63, 206309], [69, 206629]]}, {"verse": 39, "start": 207766, "end": 213494, "text": "Extendió una nube por cubierta, y fuego para alumbrar la noche.", "words": [[0, 207766], [9, 208551], [13, 208931], [18, 209371], [22, 209651], [32, 210571], [34, 211091], [40, 211531], [45, 211911], [54, 212571], [57, 212831]]}, {"verse": 40, "start": 213844, "end": 218829, "text": "Pidieron, e hizo venir codornices; y los sació de pan del cielo.", "words": [[0, 213844], [10, 214328], [12, 214668], [17, 214948], [23, 215288], [35, 216832], [37, 216954], [41, 217114], [47, 217534], [50, 217674], [54, 217954], [58, 218174]]}, {"verse": 41, "start": 219179, "end": 224331, "text": "Abrió la peña, y fluyeron aguas; corrieron por los lugares secos como un río.", "words": [[0, 219179], [6, 219488], [9, 219648], [15, 220048], [17, 220208], [26, 220768], [33, 221674], [43, 222136], [47, 222256], [51, 222436], [59, 222776], [65, 223356], [70, 223536], [73, 223756]]}, {"verse": 42, "start": 224681, "end": 229263, "text": "Porque se acordó de su santa palabra, dada a Abraham su siervo.", "words": [[0, 224681], [7, 224845], [10, 225065], [17, 225545], [20, 225645], [23, 225785], [29, 226185], [38, 227125], [43, 227625], [45, 227865], [53, 228105], [56, 228545]]}, {"verse": 43, "start": 229613, "end": 233926, "text": "Y sacó a su pueblo con gozo; con júbilo a sus escogidos.", "words": [[0, 229613], [2, 229735], [7, 230135], [9, 230235], [12, 230355], [19, 230735], [23, 231015], [29, 231932], [33, 232097], [40, 232697], [42, 232857], [46, 232977]]}, {"verse": 44, "start": 234276, "end": 238952, "text": "Y les dio las tierras de las naciones; y heredaron las labores de los pueblos:", "words": [[0, 234276], [2, 234403], [6, 234563], [10, 234743], [14, 234923], [22, 235483], [25, 235623], [29, 235763], [39, 236718], [41, 236865], [51, 237425], [55, 237605], [63, 238065], [66, 238205], [70, 238305]]}, {"verse": 45, "start": 239302, "end": 244335, "text": "Para que guardasen sus estatutos, y observasen sus leyes. Aleluya.", "words": [[0, 239302], [5, 239446], [9, 239886], [19, 240326], [23, 240506], [34, 241206], [36, 241806], [47, 242406], [51, 242586], [58, 243930]]}]}