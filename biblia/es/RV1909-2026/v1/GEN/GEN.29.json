], [45, 168031], [56, 168591], [61, 168811], [67, 169211], [73, 169431], [80, 169671], [83, 169911]]}, {"verse": 21, "start": 170942, "end": 177006, "text": "Y dijo Jacob a Labán: Dame mi mujer, porque mi tiempo es cumplido, para que cohabite con ella.", "words": [[0, 170942], [2, 171070], [7, 171363], [13, 171657], [15, 171950], [22, 172772], [27, 172988], [30, 173208], [37, 173548], [44, 173888], [47, 174128], [54, 174428], [57, 174628], [67, 175528], [72, 175808], [76, 176118], [85, 176428], [89, 176648]]}, {"verse": 22, "start": 177286, "end": 182204, "text": "Entonces Labán juntó a todos los varones de aquel lugar, e hizo banquete.", "words": [[0, 177286], [9, 178143], [15, 178583], [21, 179063], [23, 179163], [29, 179383], [33, 179693], [41, 180003], [44, 180163], [50, 180423], [57, 180723], [59, 181183], [64, 181403]]}, {"verse": 23, "start": 182554, "end": 187922, "text": "Y sucedió que a la noche tomó a Lea su hija, y se la trajo: y él entró a ella.", "words": [[0, 182554], [2, 182671], [10, 183251], [14, 183431], [16, 183491], [19, 183571], [25, 183851], [30, 184351], [32, 184451], [36, 184711], [39, 184911], [45, 185291], [47, 185391], [50, 185511], [53, 185651], [60, 186449], [62, 186619], [65, 186799], [71, 187339], [73, 187459]]}, {"verse": 24, "start": 188272, "end": 192056, "text": "Y dio Labán su sierva Zilpa a su hija Lea por criada.", "words": [[0, 188272], [2, 188378], [6, 188591], [12, 188805], [15, 189018], [22, 189448], [28, 189878], [30, 190058], [33, 190218], [38, 190678], [42, 190998], [46, 191218]]}, {"verse": 25, "start": 192406, "end": 202341, "text": "Y venida la mañana, he aquí que era Lea: y él dijo a Labán: ¿Qué es esto que me has hecho? ¿no te he servido por Raquel? ¿por qué, pues, me has engañado?", "words": [[0, 192406], [2, 192672], [9, 193032], [12, 193152], [20, 193622], [23, 194092], [28, 194372], [32, 194592], [36, 194772], [41, 195546], [43, 195712], [46, 195852], [51, 196192], [53, 196432], [60, 197246], [65, 197387], [68, 197547], [73, 197747], [77, 197907], [80, 198027], [84, 198167], [91, 198841], [95, 199027], [98, 199187], [101, 199287], [109, 199667], [113, 200042], [121, 200582], [126, 200727], [131, 200867], [137, 201207], [140, 201507], [144, 201647]]}, {"verse": 26, "start": 202621, "end": 208234, "text": "Y Labán respondió: No se hace así en nuestro lugar, que se dé la menor antes de la mayor.", "words": [[0, 202621], [2, 202742], [8, 203082], [19, 204045], [22, 204209], [25, 204429], [30, 204629], [34, 204969], [37, 205129], [45, 205329], [52, 206189], [56, 206289], [59, 206449], [62, 206629], [65, 206729], [71, 207029], [77, 207469], [80, 207689], [83, 207789]]}, {"verse": 27, "start": 208584, "end": 214831, "text": "Cumple la semana de esta, y se te dará también la otra, por el servicio que hagas conmigo otros siete años.", "words": [[0, 208584], [7, 208860], [10, 209000], [17, 209320], [20, 209540], [26, 209940], [28, 210360], [31, 210500], [34, 210640], [39, 210940], [47, 211140], [50, 211380], [56, 211680], [60, 211980], [63, 212100], [72, 212440], [76, 212720], [82, 213000], [90, 213560], [96, 213860], [102, 214180]]}, {"verse": 28, "start": 215111, "end": 221506, "text": "E hizo Jacob así, y cumplió la semana de aquella: y él le dio a Raquel su hija por mujer.", "words": [[0, 215413], [2, 215753], [7, 216093], [13, 216433], [18, 216773], [20, 217133], [28, 217493], [31, 217633], [38, 217973], [41, 218193], [50, 219049], [52, 219214], [55, 219374], [58, 219534], [62, 219754], [64, 219894], [71, 220214], [74, 220494], [79, 220774], [83, 220934]]}, {"verse": 29, "start": 221856, "end": 226044, "text": "Y dio Labán a Raquel su hija por criada a su sierva Bilha.", "words": [[0, 221856], [2, 221994], [6, 222309], [12, 222624], [14, 222939], [21, 223254], [24, 223434], [29, 223794], [33, 224154], [40, 224514], [42, 224714], [45, 224854], [52, 225472]]}, {"verse": 30, "start": 226394, "end": 233455, "text": "Y entró también a Raquel: y la amó también más que a Lea: y sirvió con él aún otros siete años.", "words": [[0, 226394], [2, 226569], [8, 226949], [16, 227229], [18, 227549], [26, 228371], [28, 228652], [31, 228812], [35, 229092], [43, 229332], [47, 229652], [51, 229812], [53, 229952], [58, 230602], [60, 230857], [67, 231297], [71, 231477], [74, 231637], [78, 231877], [84, 232277], [90, 232677]]}, {"verse": 31, "start": 233805, "end": 240320, "text": "Y vio Jehová que Lea era aborrecida, y abrió su matriz: pero Raquel era estéril.", "words": [[0, 233805], [2, 233946], [6, 234206], [13, 234586], [17, 234816], [21, 235046], [25, 235286], [37, 236606], [39, 236926], [45, 237286], [48, 237466], [56, 238518], [61, 238700], [68, 239140], [72, 239580]]}, {"verse": 32, "start": 240670, "end": 251784, "text": "Y concibió Lea, y parió un hijo, y llamó su nombre Rubén, porque dijo: Ya que ha mirado Jehová mi aflicción; ahora por tanto me amará mi marido.", "words": [[0, 240670], [2, 240776], [11, 241416], [16, 242296], [18, 242336], [24, 242696], [27, 242916], [33, 243656], [35, 243776], [41, 244076], [44, 244236], [51, 244616], [58, 245816], [65, 246036], [71, 246806], [74, 247054], [78, 247294], [81, 247474], [88, 247854], [95, 248374], [98, 248494], [109, 249538], [115, 250023], [119, 250103], [125, 250623], [128, 250723], [134, 251043], [137, 251183]]}, {"verse": 33, "start": 252064, "end": 263358, "text": "Y concibió otra vez, y parió un hijo, y dijo: Por cuanto oyó Jehová que yo era aborrecida, me ha dado también este. Y llamó su nombre Simeón.", "words": [[0, 252064], [2, 252188], [11, 252848], [16, 253068], [21, 253888], [23, 253928], [29, 254348], [32, 254648], [38, 255328], [40, 255388], [46, 256110], [50, 256230], [57, 256600], [61, 256970], [68, 257590], [72, 257650], [75, 257870], [79, 258500], [91, 259130], [94, 259290], [97, 259430], [102, 259650], [110, 260090], [116, 261406], [118, 261530], [124, 261890], [127, 262070], [134, 262450]]}, {"verse": 34, "start": 263708, "end": 275461, "text": "Y concibió otra vez, y parió un hijo, y dijo: Ahora esta vez se unirá mi marido conmigo, porque le he parido tres hijos: por tanto, llamó su nombre Leví.", "words": [[0, 263708], [2, 263832], [11, 264492], [16, 264712], [21, 265532], [23, 265572], [29, 265992], [32, 266292], [38, 266972], [40, 267032], [46, 267754], [52, 268168], [57, 268568], [61, 268888], [64, 269268], [70, 269688], [73, 269808], [80, 270208], [89, 271028], [96, 271448], [99, 271668], [102, 271808], [109, 272208], [114, 272428], [121, 273372], [125, 273496], [132, 273976], [138, 274356], [141, 274496], [148, 274856]]}, {"verse": 35, "start": 275811, "end": 285444, "text": "Y concibió otra vez, y parió un hijo, y dijo: Esta vez alabaré a Jehová: por esto llamó su nombre Judá: y dejó de parir.", "words": [[0, 275811], [2, 275935], [11, 276595], [16, 276815], [21, 277635], [23, 277675], [29, 278095], [32, 278395], [38, 279075], [40, 279135], [46, 279857], [51, 280078], [55, 280218], [63, 280358], [65, 281006], [73, 281872], [77, 281997], [82, 282297], [88, 282737], [91, 282877], [98, 283217], [104, 284066], [106, 284339], [111, 284719], [114, 284859]]}]}