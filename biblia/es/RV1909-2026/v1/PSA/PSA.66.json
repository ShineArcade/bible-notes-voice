{"book": "PSA", "chapter": 66, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 120903, "verses": [{"verse": 1, "start": 300, "end": 6638, "text": "Al Músico principal: Cántico: Salmo. ACLAMAD a Dios con alegría, toda la tierra:", "words": [[0, 300], [3, 491], [10, 1051], [21, 2172], [30, 3032], [37, 4228], [45, 4558], [47, 4658], [52, 4758], [56, 5148], [65, 5538], [70, 5778], [73, 5978]]}, {"verse": 2, "start": 6988, "end": 11946, "text": "Cantad la gloria de su nombre: poned gloria en su alabanza.", "words": [[0, 6988], [7, 7548], [10, 7768], [17, 8188], [20, 8308], [23, 8468], [31, 9636], [37, 9942], [44, 10249], [47, 10349], [50, 10509]]}, {"verse": 3, "start": 12296, "end": 19292, "text": "Decid a Dios: ¡Cuán terribles tus obras! Por lo grande de tu fortaleza se someterán a ti tus enemigos.", "words": [[0, 12475], [6, 12660], [8, 12845], [14, 13250], [20, 13554], [30, 14134], [34, 14274], [41, 15225], [45, 15369], [48, 15569], [55, 15929], [58, 16149], [61, 16309], [71, 17129], [74, 17289], [84, 18009], [86, 18069], [89, 18129], [93, 18249]]}, {"verse": 4, "start": 19642, "end": 25769, "text": "Toda la tierra te adorará, y cantará a ti; cantarán a tu nombre. (Selah.)", "words": [[0, 19642], [5, 20254], [8, 20354], [15, 20774], [18, 21014], [27, 21674], [29, 22114], [37, 22734], [39, 22914], [43, 23410], [52, 24075], [54, 24235], [57, 24355], [65, 25491]]}, {"verse": 5, "start": 26119, "end": 32435, "text": "Venid, y ved las obras de Dios, temible en hechos sobre los hijos de los hombres.", "words": [[0, 26119], [7, 26684], [9, 26964], [13, 27204], [17, 27684], [23, 28164], [26, 28444], [32, 29264], [40, 29904], [43, 30144], [50, 30384], [56, 30844], [60, 31084], [66, 31404], [69, 31604], [73, 31724]]}, {"verse": 6, "start": 32785, "end": 38975, "text": "Volvió el mar en seco; por el río pasaron a pie; allí en él nos alegramos.", "words": [[0, 32785], [7, 33251], [10, 33391], [14, 33631], [17, 33971], [23, 34850], [27, 34995], [30, 35155], [34, 35495], [42, 35975], [44, 36095], [49, 36686], [54, 37166], [57, 37506], [60, 37766], [64, 38006]]}, {"verse": 7, "start": 39325, "end": 48013, "text": "Él gobierna para siempre con su poder: sus ojos atalayan sobre las naciones: los rebeldes no serán ensalzados. (Selah.)", "words": [[0, 39325], [3, 39572], [12, 39852], [17, 40412], [25, 40852], [29, 41212], [32, 41412], [39, 42155], [43, 42355], [48, 42865], [57, 43375], [63, 43595], [67, 43875], [77, 44948], [81, 45128], [90, 45688], [93, 45868], [99, 46248], [111, 47735]]}, {"verse": 8, "start": 48363, "end": 53186, "text": "Bendecid, pueblos, a nuestro Dios, y haced oír la voz de su alabanza.", "words": [[0, 48363], [10, 49069], [19, 49649], [21, 49929], [29, 50089], [35, 50509], [37, 50789], [43, 51089], [47, 51549], [50, 51809], [54, 52069], [57, 52249], [60, 52449]]}, {"verse": 9, "start": 53536, "end": 59049, "text": "Él es el que puso nuestra alma en vida, y no permitió que nuestros pies resbalasen.", "words": [[0, 53536], [3, 53843], [6, 54223], [9, 54383], [13, 54523], [18, 54983], [26, 55163], [31, 55623], [34, 55843], [40, 56143], [42, 56323], [45, 56483], [54, 57063], [58, 57203], [67, 57383], [72, 57843]]}, {"verse": 10, "start": 59399, "end": 63619, "text": "Porque tú nos probaste, oh Dios: nos ensayaste como se afina la plata.", "words": [[0, 59399], [7, 59562], [10, 59802], [14, 59922], [24, 60282], [27, 60642], [33, 61279], [37, 61425], [47, 62185], [52, 62445], [55, 62625], [61, 62925], [64, 63065]]}, {"verse": 11, "start": 63969, "end": 68383, "text": "Nos metiste en la red; pusiste pesada carga en nuestros lomos.", "words": [[0, 63969], [4, 64118], [12, 64618], [15, 64778], [18, 65103], [23, 65649], [31, 66094], [38, 66574], [44, 67054], [47, 67254], [56, 67474]]}, {"verse": 12, "start": 68733, "end": 76062, "text": "Hombres hiciste subir sobre nuestra cabeza; entramos en fuego y en aguas, y nos sacaste a abundancia.", "words": [[0, 68733], [8, 69177], [16, 69857], [22, 70217], [28, 70577], [36, 70857], [44, 71883], [53, 72379], [56, 72639], [62, 72919], [64, 73179], [67, 73339], [74, 73919], [76, 74319], [80, 74479], [88, 74769], [90, 75059]]}, {"verse": 13, "start": 76412, "end": 80403, "text": "Entraré en tu casa con holocaustos: te pagaré mis votos,", "words": [[0, 76412], [8, 77188], [11, 77408], [14, 77588], [19, 77888], [23, 78433], [36, 79197], [39, 79443], [46, 79823], [50, 79983]]}, {"verse": 14, "start": 80753, "end": 85233, "text": "Que pronunciaron mis labios, y habló mi boca, cuando angustiado estaba.", "words": [[0, 80753], [4, 80837], [17, 81597], [21, 81797], [29, 82357], [31, 82617], [37, 82977], [40, 83097], [46, 83417], [53, 83797], [64, 84597]]}, {"verse": 15, "start": 85583, "end": 93396, "text": "Holocaustos de cebados te ofreceré, con perfume de carneros: sacrificaré bueyes y machos cabríos. (Selah.)", "words": [[0, 85583], [12, 86430], [15, 86550], [23, 87010], [26, 87170], [36, 87790], [40, 88170], [48, 88690], [51, 89207], [61, 89910], [73, 90653], [80, 91433], [82, 91573], [89, 92126], [98, 93118]]}, {"verse": 16, "start": 93746, "end": 99066, "text": "Venid, oíd todos los que teméis a Dios, y contaré lo que ha hecho a mi alma.", "words": [[0, 93746], [7, 94221], [11, 94731], [17, 95071], [21, 95411], [25, 95591], [32, 96051], [34, 96231], [40, 96471], [42, 96951], [50, 97471], [53, 97611], [57, 97771], [60, 97931], [66, 98191], [68, 98331], [71, 98491]]}, {"verse": 17, "start": 99416, "end": 103920, "text": "A él clamé con mi boca, y ensalzado fue con mi lengua.", "words": [[0, 99416], [2, 99731], [5, 99971], [11, 100371], [15, 100591], [18, 100771], [24, 101131], [26, 101631], [36, 102571], [40, 102811], [44, 103051], [47, 103271]]}, {"verse": 18, "start": 104270, "end": 109542, "text": "Si en mi corazón hubiese yo mirado a la iniquidad, el Señor no me oyera.", "words": [[0, 104270], [3, 104455], [6, 104595], [9, 104755], [17, 105255], [25, 105875], [28, 106115], [35, 106595], [37, 106715], [40, 106835], [51, 107815], [54, 107895], [60, 108255], [63, 108835], [66, 108975]]}, {"verse": 19, "start": 109892, "end": 114483, "text": "Mas ciertamente me oyó Dios; atendió a la voz de mi súplica.", "words": [[0, 109892], [4, 110375], [16, 111235], [19, 111435], [23, 111715], [29, 112492], [37, 113020], [39, 113160], [42, 113260], [46, 113480], [49, 113640], [52, 113740]]}, {"verse": 20, "start": 114833, "end": 120503, "text": "Bendito Dios, que no echó de sí mi oración, ni de mí su misericordia.", "words": [[0, 114833], [8, 115458], [14, 115738], [18, 116018], [21, 116338], [26, 116658], [29, 116858], [32, 117118], [35, 117458], [44, 118478], [47, 118758], [50, 118918], [53, 119118], [56, 119338]]}]}