{"book": "PSA", "chapter": 59, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 113452, "verses": [{"verse": 1, "start": 300, "end": 5602, "text": "Deliver me from my enemies, O my God: defend me from them that rise up against me.", "words": [[0, 300], [8, 684], [11, 864], [16, 1084], [19, 1284], [28, 1814], [30, 2344], [33, 2524], [38, 3332], [45, 3717], [48, 3837], [53, 4057], [58, 4277], [63, 4477], [68, 4697], [71, 4917], [79, 5197]]}, {"verse": 2, "start": 6052, "end": 9971, "text": "Deliver me from the workers of iniquity, and save me from bloody men.", "words": [[0, 6052], [8, 6397], [11, 6537], [16, 6737], [20, 6877], [28, 7157], [31, 7437], [41, 8017], [45, 8437], [50, 8757], [53, 8977], [58, 9197], [65, 9477]]}, {"verse": 3, "start": 10421, "end": 19039, "text": "For, lo, they lie in wait for my soul: the mighty are gathered against me; not for my transgression, nor for my sin, O LORD.", "words": [[0, 10421], [5, 10561], [9, 11281], [14, 11521], [18, 11761], [21, 12001], [26, 12241], [30, 12481], [33, 12661], [39, 13588], [43, 13673], [50, 13953], [54, 14153], [63, 14573], [71, 14893], [75, 15705], [79, 15892], [83, 16112], [86, 16272], [101, 17252], [105, 17452], [109, 17672], [112, 17832], [117, 18392], [119, 18472]]}, {"verse": 4, "start": 19489, "end": 24505, "text": "They run and prepare themselves without my fault: awake to help me, and behold.", "words": [[0, 19489], [5, 19593], [9, 19893], [13, 20113], [21, 20453], [32, 20953], [40, 21413], [43, 21693], [50, 22564], [56, 22931], [59, 23131], [64, 23311], [68, 23571], [72, 23771]]}, {"verse": 5, "start": 24955, "end": 35080, "text": "You therefore, O LORD God of hosts, the God of Israel, awake to visit all the heathen: be not merciful to any wicked transgressors. Selah.", "words": [[0, 24955], [4, 25103], [15, 25723], [17, 25843], [22, 26143], [26, 26463], [29, 26643], [36, 27523], [40, 27603], [44, 27863], [47, 28003], [55, 28803], [61, 29123], [64, 29403], [70, 29663], [74, 29943], [78, 30103], [87, 30933], [90, 31140], [94, 31380], [103, 31820], [106, 32180], [110, 32380], [117, 32740], [132, 34669]]}, {"verse": 6, "start": 35530, "end": 40268, "text": "They return at evening: they make a noise like a dog, and go round about the city.", "words": [[0, 35530], [5, 35662], [12, 36022], [15, 36242], [24, 37061], [29, 37159], [34, 37379], [36, 37479], [42, 37719], [47, 38019], [49, 38119], [54, 38459], [58, 38899], [61, 39119], [67, 39339], [73, 39559], [77, 39779]]}, {"verse": 7, "start": 40718, "end": 46517, "text": "Behold, they belch out with their mouth: swords are in their lips: for who, say they, does hear?", "words": [[0, 40718], [8, 41184], [13, 41284], [19, 41704], [23, 41844], [28, 42004], [34, 42184], [41, 42971], [48, 43413], [52, 43553], [55, 43693], [61, 43813], [67, 44677], [71, 44813], [76, 44973], [80, 45293], [86, 45573], [91, 45913]]}, {"verse": 8, "start": 46967, "end": 51859, "text": "But you, O LORD, shall laugh at them; you shall have all the heathen in derision.", "words": [[0, 46967], [4, 47076], [9, 47476], [11, 47596], [17, 48176], [23, 48356], [29, 48736], [32, 48856], [38, 49550], [42, 49701], [48, 49901], [53, 50161], [57, 50401], [61, 50581], [69, 51021], [72, 51161]]}, {"verse": 9, "start": 52309, "end": 56615, "text": "Because of his strength will I wait upon you: for God is my defence.", "words": [[0, 52309], [8, 52535], [11, 52775], [15, 52935], [24, 53355], [29, 53595], [31, 53755], [36, 53975], [41, 54255], [46, 55119], [50, 55228], [54, 55508], [57, 55748], [60, 56219]]}, {"verse": 10, "start": 57065, "end": 62734, "text": "The God of my mercy shall come to meet me: God shall let me see my desire upon my enemies.", "words": [[0, 57065], [4, 57145], [8, 57425], [11, 57585], [14, 57765], [20, 58145], [26, 58445], [31, 58685], [34, 58885], [39, 59085], [43, 59774], [47, 59978], [53, 60218], [57, 60418], [60, 60578], [64, 60798], [67, 60998], [74, 61338], [79, 61718], [82, 61978]]}, {"verse": 11, "start": 63184, "end": 70199, "text": "Slay them not, lest my people forget: scatter them by your power; and bring them down, O Lord our shield.", "words": [[0, 63184], [5, 63574], [10, 63894], [15, 63994], [20, 64334], [23, 64494], [30, 64794], [38, 65756], [46, 66196], [51, 66376], [54, 66616], [59, 66756], [66, 67645], [70, 67774], [76, 67994], [81, 68214], [87, 68814], [89, 68914], [94, 69234], [98, 69554]]}, {"verse": 12, "start": 70649, "end": 78146, "text": "For the sin of their mouth and the words of their lips let them even be taken in their pride: and for cursing and lying which they speak.", "words": [[0, 70649], [4, 70737], [8, 70877], [12, 71137], [15, 71277], [21, 71457], [27, 71817], [31, 72097], [35, 72237], [41, 72497], [44, 72677], [50, 72837], [55, 73157], [59, 73437], [64, 73637], [69, 73857], [72, 74117], [78, 74437], [81, 74657], [87, 74797], [94, 75733], [98, 75841], [102, 75981], [110, 76541], [114, 76641], [120, 76981], [126, 77301], [131, 77541]]}, {"verse": 13, "start": 78596, "end": 87630, "text": "Consume them in wrath, consume them, that they may not be: and let them know that God rules in Jacob to the ends of the earth. Selah.", "words": [[0, 78596], [8, 79120], [13, 79300], [16, 79460], [23, 79780], [31, 80460], [37, 80920], [42, 81340], [47, 81540], [51, 81720], [55, 81940], [59, 82808], [63, 83128], [67, 83328], [72, 83548], [77, 83788], [82, 83988], [86, 84288], [92, 84728], [95, 84968], [101, 85308], [104, 85528], [108, 85668], [113, 85928], [116, 86108], [120, 86248], [127, 87340]]}, {"verse": 14, "start": 88080, "end": 93519, "text": "And at evening let them return; and let them make a noise like a dog, and go round about the city.", "words": [[0, 88080], [4, 88245], [7, 88325], [15, 88625], [19, 88925], [24, 89105], [32, 90049], [36, 90174], [40, 90314], [45, 90494], [50, 90694], [52, 90774], [58, 91094], [63, 91354], [65, 91454], [70, 91774], [74, 92134], [77, 92294], [83, 92594], [89, 92854], [93, 93054]]}, {"verse": 15, "start": 93969, "end": 98402, "text": "Let them wander up and down for food, and grudge if they be not satisfied.", "words": [[0, 93969], [4, 94126], [9, 94366], [16, 94706], [19, 95006], [23, 95126], [28, 95366], [32, 95586], [38, 95986], [42, 96466], [49, 96926], [52, 97046], [57, 97206], [60, 97346], [64, 97546]]}, {"verse": 16, "start": 98852, "end": 106884, "text": "But I will sing of your power; yes, I will sing aloud of your mercy in the morning: for you have been my defence and refuge in the day of my trouble.", "words": [[0, 98852], [4, 98934], [6, 99094], [11, 99254], [16, 99514], [19, 99674], [24, 99794], [31, 100679], [36, 101107], [38, 101207], [43, 101347], [48, 101567], [54, 101807], [57, 102007], [62, 102127], [68, 102467], [71, 102667], [75, 102747], [84, 103551], [88, 103661], [92, 103861], [97, 104061], [102, 104241], [105, 104521], [113, 104801], [117, 105101], [124, 105481], [127, 105741], [131, 105841], [135, 106061], [138, 106161], [141, 106341]]}, {"verse": 17, "start": 107334, "end": 113052, "text": "To you, O my strength, will I sing: for God is my defence, and the God of my mercy.", "words": [[0, 107334], [3, 107458], [8, 107918], [10, 108018], [13, 108218], [23, 108778], [28, 108918], [30, 109058], [36, 109899], [40, 110029], [44, 110349], [47, 110549], [50, 110969], [59, 111389], [63, 111749], [67, 111849], [71, 112149], [74, 112249], [77, 112449]]}]}