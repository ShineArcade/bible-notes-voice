{"book": "LUK", "chapter": 12, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 431741, "verses": [{"verse": 1, "start": 300, "end": 13644, "text": "In the mean time, when there were gathered together an innumerable multitude of people, so that they trampled one upon another, he began to say to his disciples first of all, Beware of the leaven of the Pharisees, which is hypocrisy.", "words": [[0, 300], [3, 467], [7, 820], [12, 1174], [18, 1527], [23, 1627], [29, 1787], [34, 1907], [43, 2267], [52, 2687], [55, 2967], [67, 3667], [77, 4087], [80, 4407], [88, 5247], [91, 5447], [96, 5627], [101, 5767], [110, 6247], [114, 6467], [119, 6687], [128, 7685], [131, 7774], [137, 8094], [140, 8314], [144, 8514], [147, 8674], [151, 8854], [161, 9574], [167, 9714], [170, 9954], [175, 10534], [182, 10870], [185, 11030], [189, 11150], [196, 11470], [199, 11610], [203, 11710], [214, 12670], [220, 12770], [223, 12890]]}, {"verse": 2, "start": 14094, "end": 19124, "text": "For there is nothing covered, that shall not be revealed; neither hid, that shall not be known.", "words": [[0, 14094], [4, 14178], [10, 14318], [13, 14438], [21, 14658], [30, 15118], [35, 15658], [41, 15818], [45, 16038], [48, 16218], [58, 17154], [66, 17372], [71, 17712], [76, 18072], [82, 18252], [86, 18452], [89, 18612]]}, {"verse": 3, "start": 19574, "end": 27490, "text": "Therefore whatever you have spoken in darkness shall be heard in the light; and that which you have spoken in the ear in closets shall be proclaimed upon the housetops.", "words": [[0, 19574], [10, 20173], [19, 20353], [23, 20613], [28, 20713], [35, 21033], [38, 21233], [47, 21533], [53, 21873], [56, 22013], [62, 22213], [65, 22353], [69, 22453], [76, 23189], [80, 23333], [85, 23573], [91, 23733], [95, 23913], [100, 24013], [107, 24293], [110, 24493], [114, 24593], [118, 24783], [121, 24973], [129, 25493], [135, 25693], [138, 25833], [149, 26233], [154, 26553], [158, 26793]]}, {"verse": 4, "start": 27940, "end": 34277, "text": "And I say to you my friends, Be not afraid of them that kill the body, and after that have no more that they can do.", "words": [[0, 27940], [4, 28079], [6, 28239], [10, 28479], [13, 28679], [17, 28919], [20, 29039], [29, 29839], [32, 29999], [36, 30179], [43, 30479], [46, 30659], [51, 30839], [56, 31019], [61, 31239], [65, 31379], [71, 31959], [75, 32219], [81, 32499], [86, 32899], [91, 32979], [94, 33159], [99, 33419], [104, 33599], [109, 33739], [113, 33919]]}, {"verse": 5, "start": 34728, "end": 44096, "text": "But I will forewarn you whom you shall fear: Fear him, which after he has killed has power to cast into hell; yes, I say to you, Fear him.", "words": [[0, 34728], [4, 34830], [6, 35010], [11, 35170], [20, 35850], [24, 36130], [29, 36330], [33, 36530], [39, 36770], [45, 37628], [50, 37875], [55, 38669], [61, 38819], [67, 39139], [70, 39309], [74, 39479], [81, 39839], [85, 40079], [91, 40419], [94, 40599], [99, 40899], [104, 41179], [110, 42003], [115, 42493], [117, 42653], [121, 42913], [124, 43133], [129, 43493], [134, 43673]]}, {"verse": 6, "start": 44396, "end": 48882, "text": "Are not five sparrows sold for two farthings, and not one of them is forgotten before God?", "words": [[0, 44396], [4, 44494], [8, 44634], [13, 44914], [22, 45474], [27, 45714], [31, 45894], [35, 46074], [46, 46794], [50, 46914], [54, 47114], [58, 47294], [61, 47394], [66, 47554], [69, 47694], [79, 48014], [86, 48354]]}, {"verse": 7, "start": 49332, "end": 55515, "text": "But even the very hairs of your head are all numbered. Fear not therefore: you are of more value than many sparrows.", "words": [[0, 49332], [4, 49432], [9, 49572], [13, 49752], [18, 49952], [24, 50212], [27, 50412], [32, 50512], [37, 50732], [41, 50892], [45, 51012], [55, 51815], [60, 52018], [64, 52518], [75, 53188], [79, 53335], [83, 53555], [86, 53695], [91, 53895], [97, 54275], [102, 54495], [107, 54755]]}, {"verse": 8, "start": 55965, "end": 63575, "text": "Also I say to you, Whoever shall confess me before men, him shall the Son of man also confess before the angels of God:", "words": [[0, 55965], [5, 56246], [7, 56486], [11, 56726], [14, 56946], [19, 57486], [27, 57786], [33, 58146], [41, 58546], [44, 58786], [51, 59086], [56, 59886], [60, 60026], [66, 60306], [70, 60466], [74, 60706], [77, 60806], [81, 61066], [86, 61446], [94, 61946], [101, 62326], [105, 62546], [112, 62866], [115, 63106]]}, {"verse": 9, "start": 64025, "end": 68576, "text": "But he that denies me before men shall be denied before the angels of God.", "words": [[0, 64025], [4, 64166], [7, 64406], [12, 64646], [19, 65126], [22, 65306], [29, 65606], [33, 65966], [39, 66266], [42, 66426], [49, 66906], [56, 67286], [60, 67486], [67, 67866], [70, 68066]]}, {"verse": 10, "start": 69026, "end": 78093, "text": "And whoever shall speak a word against the Son of man, it shall be forgiven him: but to him that blasphemes against the Holy Spirit it shall not be forgiven.", "words": [[0, 69026], [4, 69148], [12, 69408], [18, 69688], [24, 69928], [26, 70088], [31, 70308], [39, 70588], [43, 70808], [47, 71008], [50, 71128], [55, 71828], [58, 71908], [64, 72068], [67, 72208], [76, 72508], [81, 73278], [85, 73473], [88, 73653], [92, 73913], [97, 74213], [108, 75033], [116, 75213], [120, 75473], [125, 75693], [132, 76413], [135, 76713], [141, 76953], [145, 77173], [148, 77413]]}, {"verse": 11, "start": 78543, "end": 86927, "text": "And when they bring you to the synagogues, and to magistrates, and powers, take no thought how or what thing you shall answer, or what you shall say:", "words": [[0, 78543], [4, 78665], [9, 78785], [14, 78945], [20, 79165], [24, 79305], [27, 79465], [31, 79585], [43, 80345], [47, 80605], [50, 80725], [63, 81465], [67, 81785], [75, 82705], [80, 82885], [83, 83145], [91, 83365], [95, 83745], [98, 84085], [103, 84365], [109, 84625], [113, 84805], [119, 84985], [127, 85365], [130, 85885], [135, 86085], [139, 86225], [145, 86445]]}, {"verse": 12, "start": 87377, "end": 91647, "text": "For the Holy Spirit shall teach you in the same hour what you ought to say.", "words": [[0, 87377], [4, 87487], [8, 87607], [13, 87887], [20, 88507], [26, 88907], [32, 89207], [36, 89407], [39, 89547], [43, 89687], [48, 89927], [53, 90327], [58, 90607], [62, 90767], [68, 90987], [71, 91167]]}, {"verse": 13, "start": 91997, "end": 97247, "text": "¶ And one of the company said to him, Master, speak to my brother, that he divide the inheritance with me.", "words": [[2, 91997], [6, 92136], [10, 92316], [13, 92396], [17, 92516], [25, 92796], [30, 93176], [33, 93376], [38, 94167], [46, 94307], [52, 94647], [55, 94807], [58, 94927], [67, 95247], [72, 95687], [75, 95787], [82, 96027], [86, 96207], [98, 96607], [103, 96927]]}, {"verse": 14, "start": 97597, "end": 101904, "text": "And he said to him, Man, who made me a judge or a divider over you?", "words": [[0, 97597], [4, 97723], [7, 97823], [12, 98043], [15, 98243], [20, 98895], [25, 99155], [29, 99395], [34, 99595], [37, 99815], [39, 99935], [45, 100355], [48, 100675], [50, 100795], [58, 101295], [63, 101515]]}, {"verse": 15, "start": 102254, "end": 110058, "text": "And he said to them, Take heed, and beware of covetousness: for a man’s life consists not in the abundance of the things which he possesses.", "words": [[0, 102254], [4, 102385], [7, 102505], [12, 102745], [15, 102945], [21, 103540], [26, 103719], [32, 104059], [36, 104279], [43, 104639], [46, 104759], [60, 105895], [64, 106007], [66, 106147], [72, 106487], [77, 106727], [86, 107127], [90, 107647], [93, 107827], [97, 107927], [107, 108287], [110, 108627], [114, 108747], [121, 108987], [127, 109227], [130, 109347]]}, {"verse": 16, "start": 110408, "end": 115482, "text": "And he spoke a parable to them, saying, The ground of a certain rich man brought forth plentifully:", "words": [[0, 110408], [4, 110510], [7, 110570], [13, 110770], [15, 110990], [23, 111330], [26, 111530], [32, 111790], [40, 112523], [44, 112602], [51, 112882], [54, 113082], [56, 113202], [64, 113422], [69, 113702], [73, 114062], [81, 114342], [87, 114662]]}, {"verse": 17, "start": 115932, "end": 121431, "text": "And he thought within himself, saying, What shall I do, because I have no room where to bestow my fruits?", "words": [[0, 115932], [4, 116027], [7, 116147], [15, 116347], [22, 116607], [31, 117167], [39, 117827], [44, 118127], [50, 118387], [52, 118567], [56, 118847], [64, 119187], [66, 119407], [71, 119567], [74, 119707], [79, 120027], [85, 120227], [88, 120327], [95, 120667], [98, 120827]]}, {"verse": 18, "start": 121881, "end": 128983, "text": "And he said, This will I do: I will pull down my barns, and build greater; and there will I bestow all my fruits and my goods.", "words": [[0, 121881], [4, 122033], [7, 122113], [13, 122433], [18, 122573], [23, 122753], [25, 122893], [29, 123603], [31, 123704], [36, 123804], [41, 124024], [46, 124224], [49, 124424], [56, 125004], [60, 125164], [66, 125384], [75, 126197], [79, 126517], [85, 126637], [90, 126797], [92, 126937], [99, 127357], [103, 127557], [106, 127717], [113, 128017], [117, 128297], [120, 128457]]}, {"verse": 19, "start": 129433, "end": 136962, "text": "And I will say to my soul, Soul, you have much goods laid up for many years; take your ease, eat, drink, and be merry.", "words": [[0, 129433], [4, 129555], [6, 129675], [11, 129815], [15, 130055], [18, 130195], [21, 130355], [27, 131135], [33, 131655], [37, 132015], [42, 132175], [47, 132415], [53, 132775], [58, 132995], [61, 133175], [65, 133335], [70, 133535], [77, 134430], [82, 134570], [87, 134790], [93, 135410], [98, 135790], [105, 136290], [109, 136350], [112, 136490]]}, {"verse": 20, "start": 137412, "end": 145709, "text": "But God said to him, You fool, this night your soul shall be required of you: then whose shall those things be, which you have provided?", "words": [[0, 137412], [4, 137534], [8, 137794], [13, 138174], [16, 138414], [21, 138914], [25, 139154], [31, 140014], [36, 140154], [42, 140434], [47, 140654], [52, 140994], [58, 141274], [61, 141454], [70, 141854], [73, 142114], [78, 142756], [83, 142991], [89, 143261], [95, 143541], [101, 143801], [108, 144101], [112, 144441], [118, 144721], [122, 144861], [127, 145001]]}, {"verse": 21, "start": 146159, "end": 150802, "text": "So is he that lays up treasure for himself, and is not rich toward God.", "words": [[0, 146159], [3, 146419], [6, 146679], [9, 146899], [14, 147159], [19, 147359], [22, 147579], [31, 147879], [35, 148159], [44, 148559], [48, 149239], [51, 149359], [55, 149579], [60, 149879], [67, 150179]]}, {"verse": 22, "start": 151152, "end": 160387, "text": "¶ And he said to his disciples, Therefore I say to you, Take no thought for your life, what you shall eat; neither for the body, what you shall put on.", "words": [[2, 151152], [6, 151274], [9, 151374], [14, 151594], [17, 151814], [21, 151954], [32, 153005], [42, 153331], [44, 153631], [48, 153871], [51, 154071], [56, 154751], [61, 155051], [64, 155351], [72, 155671], [76, 155891], [81, 156031], [87, 156611], [92, 156811], [96, 156971], [102, 157191], [107, 157962], [115, 158323], [119, 158523], [123, 158643], [129, 159203], [134, 159383], [138, 159563], [144, 159743], [148, 159963]]}, {"verse": 23, "start": 160837, "end": 164298, "text": "The life is more than food, and the body is more than clothing.", "words": [[0, 160837], [4, 160918], [9, 161198], [12, 161398], [17, 161618], [22, 161798], [28, 162338], [32, 162658], [36, 162778], [41, 163098], [44, 163338], [49, 163558], [54, 163718]]}, {"verse": 24, "start": 164748, "end": 174295, "text": "Consider the ravens: for they neither sow nor reap; which neither have storehouse nor barn; and God feeds them: how much more are you better than the fowls?", "words": [[0, 164748], [9, 165092], [13, 165312], [21, 166229], [25, 166315], [30, 166435], [38, 166715], [42, 167135], [46, 167415], [52, 168215], [58, 168359], [66, 168639], [71, 168899], [82, 169479], [86, 169799], [92, 170629], [96, 170772], [100, 171092], [106, 171392], [112, 172172], [116, 172293], [121, 172513], [126, 172733], [130, 172913], [134, 173013], [141, 173293], [146, 173533], [150, 173653]]}, {"verse": 25, "start": 174745, "end": 178231, "text": "And which of you with taking thought can add to his stature one cubit?", "words": [[0, 174745], [4, 174847], [10, 175047], [13, 175207], [17, 175327], [22, 175507], [29, 175787], [37, 176167], [41, 176427], [45, 176687], [48, 176847], [52, 176967], [60, 177447], [64, 177867]]}, {"verse": 26, "start": 178681, "end": 183606, "text": "If you then be not able to do that thing which is least, why do you take thought for the rest?", "words": [[0, 178681], [3, 178841], [7, 178981], [12, 179201], [15, 179401], [19, 179621], [24, 179921], [27, 180101], [30, 180281], [35, 180481], [41, 180741], [47, 180941], [50, 181081], [57, 181861], [61, 182121], [64, 182241], [68, 182341], [73, 182541], [81, 182821], [85, 183021], [89, 183121]]}, {"verse": 27, "start": 184056, "end": 193527, "text": "Consider the lilies how they grow: they toil not, they spin not; and yet I say to you, that Solomon in all his glory was not arrayed like one of these.", "words": [[0, 184056], [9, 184361], [13, 184621], [20, 184961], [24, 185141], [29, 185301], [35, 186079], [40, 186179], [45, 186519], [50, 187159], [55, 187259], [60, 187559], [65, 188391], [69, 188517], [73, 188657], [75, 188777], [79, 188997], [82, 189177], [87, 189777], [92, 190037], [100, 190477], [103, 190777], [107, 191037], [111, 191257], [117, 191637], [121, 191877], [125, 192097], [133, 192577], [138, 192717], [142, 192937], [145, 193077]]}, {"verse": 28, "start": 193977, "end": 204060, "text": "If then God so clothe the grass, which is today in the field, and tomorrow is cast into the oven; how much more will he clothe you, O you of little faith?", "words": [[0, 193977], [3, 194157], [8, 194457], [12, 194777], [15, 195207], [22, 195637], [26, 195717], [33, 196517], [39, 196777], [42, 196977], [48, 197297], [51, 197477], [55, 197577], [62, 198397], [66, 198597], [75, 198977], [78, 199317], [83, 199557], [88, 199897], [92, 200077], [98, 200829], [102, 200974], [107, 201234], [112, 201534], [117, 201754], [120, 201874], [127, 202274], [132, 202774], [134, 202874], [138, 203094], [141, 203274], [148, 203454]]}, {"verse": 29, "start": 204510, "end": 209493, "text": "And seek not you what you shall eat, or what you shall drink, neither be of doubtful mind.", "words": [[0, 204510], [4, 204652], [9, 204912], [13, 205172], [17, 205392], [22, 205552], [26, 205692], [32, 205912], [37, 206232], [40, 206732], [45, 206872], [49, 207032], [55, 207212], [62, 207992], [70, 208172], [73, 208452], [76, 208572], [85, 208952]]}, {"verse": 30, "start": 209943, "end": 215942, "text": "For all these things do the nations of the world seek after: and your Father knows that you have need of these things.", "words": [[0, 209943], [4, 210050], [8, 210270], [14, 210450], [21, 210790], [24, 210990], [28, 211130], [36, 211430], [39, 211630], [43, 211730], [49, 211970], [54, 212230], [61, 213113], [65, 213238], [70, 213358], [77, 213638], [83, 214078], [88, 214358], [92, 214498], [97, 214658], [102, 214938], [105, 215098], [111, 215258]]}, {"verse": 31, "start": 216392, "end": 221269, "text": "¶ But rather seek you the kingdom of God; and all these things shall be added to you.", "words": [[2, 216392], [6, 216489], [13, 216729], [18, 217129], [22, 217429], [26, 217589], [34, 217909], [37, 218169], [42, 219001], [46, 219126], [50, 219386], [56, 219566], [63, 219946], [69, 220246], [72, 220406], [78, 220686], [81, 220926]]}, {"verse": 32, "start": 221719, "end": 226315, "text": "Fear not, little flock; for it is your Father’s good pleasure to give you the kingdom.", "words": [[0, 221719], [5, 221979], [10, 222319], [17, 222639], [24, 223574], [28, 223724], [31, 223864], [34, 223984], [39, 224124], [48, 224644], [53, 224804], [62, 225164], [65, 225344], [70, 225524], [74, 225644], [78, 225744]]}, {"verse": 33, "start": 226765, "end": 237451, "text": "Sell that you have, and give alms; provide yourselves bags which do not grow old, a treasure in the heavens that fails not, where no thief approaches, neither moth corrupts.", "words": [[0, 226765], [5, 227025], [10, 227205], [14, 227345], [20, 227685], [24, 228025], [29, 228225], [35, 229166], [43, 229579], [54, 229859], [59, 230419], [65, 230759], [68, 230979], [72, 231179], [77, 231439], [82, 232239], [84, 232359], [93, 232639], [96, 232919], [100, 233019], [108, 233279], [113, 233639], [119, 233959], [124, 234639], [130, 234759], [133, 234959], [139, 235239], [151, 236179], [159, 236379], [164, 236799]]}, {"verse": 34, "start": 237901, "end": 240795, "text": "For where your treasure is, there will your heart be also.", "words": [[0, 237901], [4, 238002], [10, 238222], [15, 238362], [24, 238662], [28, 239242], [34, 239462], [39, 239642], [44, 239822], [50, 240102], [53, 240282]]}, {"verse": 35, "start": 241245, "end": 244206, "text": "Let your loins be girded about, and your lights burning;", "words": [[0, 241245], [4, 241380], [9, 241580], [15, 241920], [18, 242100], [25, 242480], [32, 242760], [36, 243260], [41, 243360], [48, 243620]]}, {"verse": 36, "start": 244656, "end": 252953, "text": "And you yourselves like to men that wait for their lord, when he will return from the wedding; that when he comes and knocks, they may open to him immediately.", "words": [[0, 244656], [4, 244819], [8, 244999], [19, 245459], [24, 245779], [27, 245999], [31, 246219], [36, 246419], [41, 246639], [45, 246839], [51, 246999], [57, 247339], [62, 247819], [65, 247979], [70, 248119], [77, 248499], [82, 248719], [86, 248859], [95, 249588], [100, 249692], [105, 249832], [108, 249992], [114, 250292], [118, 250472], [126, 251172], [131, 251432], [135, 251552], [140, 251832], [143, 252052], [147, 252212]]}, {"verse": 37, "start": 253403, "end": 264725, "text": "Blessed are those servants, whom the lord when he comes shall find watching: indeed I say to you, that he shall gird himself, and make them to sit down to food, and will come forth and serve them.", "words": [[0, 253403], [8, 253662], [12, 253962], [18, 254122], [28, 254502], [33, 255062], [37, 255222], [42, 255462], [47, 255622], [50, 255742], [56, 256082], [62, 256362], [67, 256642], [77, 257559], [84, 257863], [86, 258123], [90, 258363], [93, 258623], [98, 259063], [103, 259343], [106, 259503], [112, 259703], [117, 259983], [126, 260843], [130, 261123], [135, 261303], [140, 261583], [143, 261743], [147, 261903], [152, 262183], [155, 262363], [161, 262963], [165, 263123], [170, 263263], [175, 263503], [181, 263803], [185, 264043], [191, 264343]]}, {"verse": 38, "start": 265175, "end": 271747, "text": "And if he shall come in the second watch, or come in the third watch, and find them so, blessed are those servants.", "words": [[0, 265175], [4, 265317], [7, 265497], [10, 265637], [16, 265837], [21, 266157], [24, 266297], [28, 266417], [35, 266677], [42, 267337], [45, 267497], [50, 267777], [53, 267897], [57, 268017], [63, 268277], [70, 268977], [74, 269097], [79, 269357], [84, 269557], [88, 270297], [96, 270577], [100, 270877], [106, 271077]]}, {"verse": 39, "start": 272197, "end": 280948, "text": "And this know, that if the goodman of the house had known what hour the thief would come, he would have watched, and not have allowed his house to be broken through.", "words": [[0, 272197], [4, 272341], [9, 272601], [15, 272921], [20, 273181], [23, 273321], [27, 273551], [35, 273781], [38, 273921], [42, 274041], [48, 274381], [52, 274601], [58, 274881], [63, 275161], [68, 275561], [72, 275801], [78, 276041], [84, 276261], [90, 277201], [93, 277321], [99, 277481], [104, 277601], [113, 278539], [117, 278664], [121, 278844], [126, 279024], [134, 279304], [138, 279504], [144, 279784], [147, 279984], [150, 280104], [157, 280384]]}, {"verse": 40, "start": 281398, "end": 286048, "text": "Be therefore ready also: for the Son of man comes at an hour when you think not.", "words": [[0, 281398], [3, 281538], [13, 281958], [19, 282258], [25, 283223], [29, 283307], [33, 283407], [37, 283627], [40, 283747], [44, 284047], [50, 284367], [53, 284547], [56, 284647], [61, 284967], [66, 285247], [70, 285367], [76, 285547]]}, {"verse": 41, "start": 286398, "end": 291242, "text": "¶ Then Peter said to him, Lord, do you speak this parable to us, or even to all?", "words": [[2, 286398], [7, 286640], [13, 286920], [18, 287200], [21, 287400], [26, 288017], [32, 288435], [35, 288495], [39, 288615], [45, 288875], [50, 289155], [58, 289615], [61, 289815], [65, 290075], [68, 290435], [73, 290715], [76, 290955]]}, {"verse": 42, "start": 291592, "end": 301130, "text": "And the Lord said, Who then is that faithful and wise steward, whom his lord shall make ruler over his household, to give them their portion of food in due season?", "words": [[0, 291592], [4, 291722], [8, 291842], [13, 292042], [19, 293382], [23, 293483], [28, 293683], [31, 293903], [36, 294123], [45, 294563], [49, 294803], [54, 295143], [63, 295963], [68, 296243], [72, 296443], [77, 296683], [83, 296923], [88, 297123], [94, 297443], [99, 297783], [103, 297963], [114, 298403], [117, 298903], [122, 299103], [127, 299303], [133, 299463], [141, 299783], [144, 299963], [149, 300223], [152, 300383], [156, 300543]]}, {"verse": 43, "start": 301580, "end": 305502, "text": "Blessed is that servant, whom his lord when he comes shall find so doing.", "words": [[0, 301580], [8, 301802], [11, 302082], [16, 302282], [25, 302662], [30, 303122], [34, 303282], [39, 303582], [44, 303762], [47, 303882], [53, 304182], [59, 304402], [64, 304682], [67, 304922]]}, {"verse": 44, "start": 305952, "end": 309946, "text": "Of a truth I say to you, that he will make him ruler over all that he has.", "words": [[0, 305952], [3, 306096], [5, 306196], [11, 306456], [13, 306696], [17, 306896], [20, 307056], [25, 307216], [30, 307596], [33, 307736], [38, 307856], [43, 308096], [47, 308236], [53, 308556], [58, 308876], [62, 309216], [67, 309396], [70, 309536]]}, {"verse": 45, "start": 310396, "end": 320052, "text": "But and if that servant say in his heart, My lord delays his coming; and shall begin to beat the menservants and maidens, and to eat and drink, and to be drunken;", "words": [[0, 310396], [4, 310900], [8, 311080], [11, 311220], [16, 311400], [24, 311720], [28, 312080], [31, 312300], [35, 312440], [42, 313200], [45, 313420], [50, 313660], [57, 314060], [61, 314340], [69, 315195], [73, 315320], [79, 315520], [85, 315800], [88, 316040], [93, 316200], [97, 316600], [109, 317000], [113, 317120], [122, 317860], [126, 317960], [129, 318080], [133, 318340], [137, 318560], [144, 318920], [148, 319240], [151, 319380], [154, 319480]]}, {"verse": 46, "start": 320502, "end": 329625, "text": "The lord of that servant will come in a day when he looks not for him, and at an hour when he is not aware, and will cut him in sunder, and will appoint him his portion with the unbelievers.", "words": [[0, 320502], [4, 320582], [9, 320782], [12, 320922], [17, 321042], [25, 321362], [30, 321542], [35, 321742], [38, 321842], [40, 321962], [44, 322102], [49, 322242], [52, 322362], [58, 322522], [62, 322722], [66, 322922], [71, 323522], [75, 323602], [78, 323702], [81, 323822], [86, 324062], [91, 324282], [94, 324402], [97, 324522], [101, 324682], [108, 325469], [112, 325615], [117, 325755], [121, 325995], [125, 326175], [128, 326315], [136, 326715], [140, 327235], [145, 327395], [153, 327675], [157, 327895], [161, 328055], [169, 328435], [174, 328695], [178, 328815]]}, {"verse": 47, "start": 330075, "end": 337430, "text": "And that servant, which knew his lord’s will, and prepared not himself, neither did according to his will, shall be beaten with many stripes.", "words": [[0, 330075], [4, 330202], [9, 330362], [18, 330742], [24, 331002], [29, 331262], [33, 331442], [40, 331822], [46, 332382], [50, 332542], [59, 332862], [63, 333122], [72, 333962], [80, 334202], [84, 334422], [94, 334762], [97, 335022], [101, 335222], [107, 335742], [113, 335942], [116, 336082], [123, 336342], [128, 336542], [133, 336782]]}, {"verse": 48, "start": 337880, "end": 351289, "text": "But he that knew not, and did commit things worthy of stripes, shall be beaten with few stripes. For to whomsoever much is given, of him shall be much required: and to whom men have committed much, of him they will ask the more.", "words": [[0, 337880], [4, 338002], [7, 338242], [12, 338482], [17, 338702], [22, 339142], [26, 339422], [30, 339622], [37, 339962], [44, 340282], [51, 340642], [54, 340842], [63, 341262], [69, 341682], [72, 341862], [79, 342162], [84, 342402], [88, 342622], [97, 343549], [101, 343668], [104, 344058], [115, 344448], [120, 344708], [123, 344848], [130, 345168], [133, 345508], [137, 345708], [143, 345948], [146, 346108], [151, 346368], [161, 347356], [165, 347481], [168, 347621], [173, 347801], [177, 348141], [182, 348341], [192, 348661], [198, 349581], [201, 349821], [205, 350041], [210, 350261], [215, 350421], [219, 350661], [223, 350821]]}, {"verse": 49, "start": 351739, "end": 356308, "text": "¶ I am come to send fire on the earth; and what will I, if it be already kindled?", "words": [[2, 351739], [4, 351950], [7, 352070], [12, 352290], [15, 352530], [20, 352770], [25, 353110], [28, 353330], [32, 353450], [39, 354049], [43, 354167], [48, 354347], [53, 354567], [56, 354867], [59, 355147], [62, 355247], [65, 355347], [73, 355587]]}, {"verse": 50, "start": 356758, "end": 361800, "text": "But I have a baptism to be baptized with; and how am I straitened till it be accomplished!", "words": [[0, 356758], [4, 356862], [6, 357002], [11, 357202], [13, 357302], [21, 357662], [24, 358022], [27, 358142], [36, 358462], [42, 359332], [46, 359437], [50, 359677], [53, 359877], [55, 360197], [66, 360517], [71, 360757], [74, 360897], [77, 361017]]}, {"verse": 51, "start": 362250, "end": 367677, "text": "Do you suppose that I am come to give peace on earth? I tell you, No; but rather division:", "words": [[0, 362250], [3, 362328], [7, 362468], [15, 362768], [20, 363048], [22, 363208], [25, 363308], [30, 363508], [33, 363708], [38, 363888], [44, 364228], [47, 364508], [54, 365302], [56, 365451], [61, 365651], [66, 365831], [70, 366575], [74, 366682], [81, 367002]]}, {"verse": 52, "start": 368127, "end": 373948, "text": "For from now on there shall be five in one house divided, three against two, and two against three.", "words": [[0, 368127], [4, 368254], [9, 368494], [13, 368734], [16, 369114], [22, 369334], [28, 369514], [31, 369654], [36, 369994], [39, 370214], [43, 370394], [49, 370614], [58, 371474], [64, 371694], [72, 372014], [77, 372474], [81, 372894], [85, 373114], [93, 373474]]}, {"verse": 53, "start": 374398, "end": 387813, "text": "The father shall be divided against the son, and the son against the father; the mother against the daughter, and the daughter against the mother; the mother in law against her daughter in law, and the daughter in law against her mother in law.", "words": [[0, 374398], [4, 374480], [11, 374800], [17, 375080], [20, 375240], [28, 375680], [36, 376080], [40, 376400], [45, 376920], [49, 377200], [53, 377360], [57, 377660], [65, 378060], [69, 378360], [77, 379164], [81, 379248], [88, 379488], [96, 379888], [100, 380148], [110, 380468], [114, 380888], [118, 381028], [127, 381308], [135, 381768], [139, 382008], [147, 382743], [151, 382824], [158, 383064], [161, 383244], [165, 383504], [173, 383844], [177, 384124], [186, 384404], [189, 384624], [194, 385264], [198, 385604], [202, 385704], [211, 385984], [214, 386184], [218, 386404], [226, 386844], [230, 387104], [237, 387304], [240, 387524]]}, {"verse": 54, "start": 388163, "end": 396293, "text": "¶ And he said also to the people, When you see a cloud rise out of the west, immediately you say, There comes a shower; and so it is.", "words": [[2, 388163], [6, 388324], [9, 388444], [14, 388604], [19, 388924], [22, 389144], [26, 389264], [34, 390031], [39, 390183], [43, 390343], [47, 390583], [49, 390683], [55, 391143], [60, 391443], [64, 391723], [67, 391823], [71, 391923], [77, 392563], [89, 392963], [93, 393383], [98, 394063], [104, 394223], [110, 394443], [112, 394583], [120, 395415], [124, 395536], [127, 395716], [130, 395856]]}, {"verse": 55, "start": 396743, "end": 401916, "text": "And when you see the south wind blow, you say, There will be heat; and it comes to pass.", "words": [[0, 396743], [4, 396883], [9, 397023], [13, 397183], [17, 397363], [21, 397503], [27, 397803], [32, 398103], [38, 398563], [42, 398643], [47, 399323], [53, 399583], [58, 399743], [61, 399883], [67, 400667], [71, 400785], [74, 400885], [80, 401125], [83, 401345]]}, {"verse": 56, "start": 402366, "end": 408273, "text": "You hypocrites, you can discern the face of the sky and of the earth; but how is it that you do not discern this time?", "words": [[0, 402366], [4, 402470], [16, 403150], [20, 403230], [24, 403350], [32, 403610], [36, 403830], [41, 404070], [44, 404270], [48, 404390], [52, 404650], [56, 404890], [59, 405010], [63, 405130], [70, 405775], [74, 405877], [78, 406117], [81, 406337], [84, 406457], [89, 406597], [93, 406757], [96, 406877], [100, 407057], [108, 407477], [113, 407737]]}, {"verse": 57, "start": 408723, "end": 412243, "text": "Yes, and why even of yourselves judge you not what is right?", "words": [[0, 408723], [5, 409280], [9, 409360], [13, 409560], [18, 409880], [21, 410060], [32, 410460], [38, 410880], [42, 411120], [46, 411360], [51, 411600], [54, 411760]]}, {"verse": 58, "start": 412693, "end": 426101, "text": "¶ When you go with your adversary to the magistrate, as you are in the way, give diligence that you may be delivered from him; lest he drag you to the judge, and the judge deliver you to the officer, and the officer cast you into prison.", "words": [[2, 412693], [7, 412849], [11, 413009], [14, 413209], [19, 413429], [24, 413549], [34, 414129], [37, 414389], [41, 414509], [53, 415509], [56, 415689], [60, 415829], [64, 415969], [67, 416089], [71, 416189], [76, 416909], [81, 417069], [91, 417509], [96, 417809], [100, 417949], [104, 418089], [107, 418229], [117, 418569], [122, 418809], [127, 419446], [132, 419783], [135, 419923], [140, 420223], [144, 420403], [147, 420563], [151, 420683], [158, 421523], [162, 421743], [166, 421863], [172, 422163], [180, 422563], [184, 422843], [187, 422983], [191, 423123], [200, 424003], [204, 424143], [208, 424263], [216, 424643], [221, 425023], [225, 425323], [230, 425483]]}, {"verse": 59, "start": 426551, "end": 431341, "text": "I tell you, you shall not depart from there, till you have paid the very last mite.", "words": [[0, 426551], [2, 426713], [7, 426993], [12, 427233], [16, 427453], [22, 427673], [26, 427933], [33, 428253], [38, 428573], [45, 429073], [50, 429473], [54, 429653], [59, 429793], [64, 430053], [68, 430233], [73, 430493], [78, 430938]]}]}