{"book": "MAT", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 390695, "verses": [{"verse": 1, "start": 300, "end": 6727, "text": "Y viendo la multitud, subió al monte; y sentándose, se llegaron a él sus discípulos.", "words": [[0, 300], [2, 446], [9, 746], [12, 966], [22, 1606], [28, 2226], [31, 2386], [38, 3236], [40, 3363], [52, 4683], [55, 4903], [64, 5443], [66, 5523], [69, 5723], [73, 5923]]}, {"verse": 2, "start": 7077, "end": 9763, "text": "Y abriendo su boca, les enseñaba, diciendo:", "words": [[0, 7077], [2, 7363], [11, 7823], [14, 8003], [20, 8343], [24, 8583], [34, 9323]]}, {"verse": 3, "start": 10113, "end": 16681, "text": "Bienaventurados los pobres en espíritu: porque de ellos es el reino de los cielos.", "words": [[0, 10193], [16, 11773], [20, 11953], [27, 12413], [30, 12593], [40, 13502], [47, 13822], [50, 14082], [56, 14422], [59, 14842], [62, 15162], [68, 15682], [71, 15802], [75, 15922]]}, {"verse": 4, "start": 17031, "end": 21512, "text": "Bienaventurados los que lloran: porque ellos recibirán consolación.", "words": [[0, 17679], [16, 18039], [20, 18219], [24, 18399], [32, 19203], [39, 19440], [45, 19700], [55, 20460]]}, {"verse": 5, "start": 21862, "end": 26939, "text": "Bienaventurados los mansos: porque ellos heredarán la tierra.", "words": [[0, 22602], [16, 23442], [20, 23562], [28, 24615], [35, 24839], [41, 25239], [51, 26079], [54, 26219]]}, {"verse": 6, "start": 27289, "end": 33483, "text": "Bienaventurados los que tienen hambre y sed de justicia: porque ellos serán satisfechos.", "words": [[0, 27289], [16, 28276], [20, 28436], [24, 28616], [31, 28936], [38, 29476], [40, 29696], [44, 30036], [47, 30276], [57, 31324], [64, 31568], [70, 31848], [76, 32388]]}, {"verse": 7, "start": 33833, "end": 39211, "text": "Bienaventurados los misericordiosos: porque ellos alcanzarán misericordia.", "words": [[0, 33833], [16, 34778], [20, 35018], [37, 36696], [44, 36897], [50, 37137], [61, 38037]]}, {"verse": 8, "start": 39561, "end": 44116, "text": "Bienaventurados los de limpio corazón: porque ellos verán a Dios.", "words": [[0, 40069], [16, 40579], [20, 40852], [23, 41126], [30, 41399], [39, 42311], [46, 42536], [52, 42956], [58, 43496], [60, 43556]]}, {"verse": 9, "start": 44466, "end": 49897, "text": "Bienaventurados los pacificadores: porque ellos serán llamados hijos de Dios.", "words": [[0, 44951], [16, 45471], [20, 45771], [35, 47097], [42, 47417], [48, 47697], [54, 48157], [63, 48657], [69, 48997], [72, 49297]]}, {"verse": 10, "start": 50247, "end": 58795, "text": "Bienaventurados los que padecen persecución por causa de la justicia: porque de ellos es el reino de los cielos.", "words": [[0, 50247], [16, 51412], [20, 51952], [24, 52132], [32, 52732], [44, 53632], [48, 53912], [54, 54272], [57, 54532], [60, 54632], [70, 55616], [77, 55936], [80, 56196], [86, 56536], [89, 56956], [92, 57276], [98, 57796], [101, 57916], [105, 58036]]}, {"verse": 11, "start": 59145, "end": 67124, "text": "Bienaventurados sois cuando os insulten, os persigan y digan de vosotros todo mal por mi causa, mintiendo.", "words": [[0, 59145], [16, 60214], [21, 60634], [28, 60894], [31, 61234], [41, 62354], [44, 62494], [53, 63234], [55, 63494], [61, 63754], [64, 63894], [73, 64414], [78, 64634], [82, 65014], [86, 65254], [89, 65414], [96, 66274]]}, {"verse": 12, "start": 67474, "end": 76814, "text": "Gozaos y alegraos; porque vuestra recompensa es grande en los cielos: que así persiguieron a los profetas que fueron antes de vosotros.", "words": [[0, 67721], [7, 68001], [9, 68595], [19, 69408], [26, 69592], [34, 70242], [45, 70892], [48, 71052], [55, 71492], [58, 71752], [62, 71852], [70, 72940], [74, 73024], [78, 73264], [91, 74184], [93, 74284], [97, 74424], [106, 74904], [110, 75084], [117, 75364], [123, 75824], [126, 76004]]}, {"verse": 13, "start": 77164, "end": 89231, "text": "Vosotros sois la sal de la tierra: y si la sal pierde su sabor ¿con qué será salada? no vale más para nada, sino para ser echada fuera y pisoteada de los hombres.", "words": [[0, 77164], [9, 77622], [14, 78120], [17, 78360], [21, 78580], [24, 78780], [27, 78920], [35, 79520], [37, 80120], [40, 80240], [43, 80400], [47, 80774], [54, 81274], [57, 81494], [63, 82014], [68, 82352], [72, 82691], [77, 83029], [85, 84039], [88, 84167], [93, 84367], [97, 84547], [102, 84787], [108, 85047], [113, 85387], [118, 85667], [122, 85967], [129, 86517], [135, 87067], [137, 87267], [147, 88127], [150, 88307], [154, 88467]]}, {"verse": 14, "start": 89581, "end": 96554, "text": "Vosotros sois la luz del mundo: una ciudad asentada sobre un monte no se puede esconder.", "words": [[0, 89581], [9, 90187], [14, 90927], [17, 91187], [21, 91447], [25, 91747], [32, 92625], [36, 92845], [43, 93245], [52, 94285], [58, 94565], [61, 94765], [67, 95125], [70, 95345], [73, 95525], [79, 95825]]}, {"verse": 15, "start": 96904, "end": 105609, "text": "Ni se enciende una lámpara y se pone debajo de un recipiente, sino sobre el candelero, y alumbra a todos los que están en casa.", "words": [[0, 96904], [3, 97048], [6, 97208], [15, 97648], [19, 97808], [27, 98268], [29, 98388], [32, 98488], [37, 98728], [44, 99148], [47, 99328], [50, 99408], [62, 100388], [67, 100708], [73, 101048], [76, 101208], [87, 101868], [89, 102548], [97, 103188], [99, 103608], [105, 103948], [109, 104468], [113, 104608], [119, 104868], [122, 105048]]}, {"verse": 16, "start": 105959, "end": 114918, "text": "Así alumbre vuestra luz delante de los hombres, para que vean vuestras obras buenas, y glorifiquen a vuestro Padre que está en los cielos.", "words": [[0, 105959], [4, 106345], [12, 107045], [20, 107465], [24, 107805], [32, 108510], [35, 108670], [39, 108810], [48, 109270], [53, 109910], [57, 110090], [62, 110430], [71, 110850], [77, 111110], [85, 111490], [87, 111930], [99, 112730], [101, 112810], [109, 113130], [115, 113590], [119, 113690], [124, 113910], [127, 114090], [131, 114210]]}, {"verse": 17, "start": 115268, "end": 121705, "text": "No penséis que he venido para abolir la ley o los profetas: no he venido para abolir, sino a cumplir.", "words": [[0, 115268], [3, 115376], [11, 115856], [15, 116036], [18, 116116], [25, 116436], [30, 116656], [37, 117136], [40, 117256], [44, 117516], [46, 117696], [50, 117836], [60, 118818], [63, 118963], [66, 119063], [73, 119423], [78, 119663], [86, 120703], [91, 120843], [93, 121023]]}, {"verse": 18, "start": 122055, "end": 132374, "text": "Porque de cierto os digo, que hasta que pasen el cielo y la tierra, ni una jota ni un tilde perecerá de la ley, hasta que todas las cosas sean hechas.", "words": [[0, 122055], [7, 122420], [10, 122480], [17, 123240], [20, 123360], [26, 123820], [30, 124085], [36, 124305], [40, 124675], [46, 125045], [49, 125205], [55, 125585], [57, 125785], [60, 125925], [68, 126365], [71, 126945], [75, 127125], [80, 127565], [83, 127725], [86, 128075], [92, 128425], [101, 129025], [104, 129125], [107, 129265], [112, 129973], [118, 130313], [122, 130473], [128, 130753], [132, 131013], [138, 131353], [143, 131713]]}, {"verse": 19, "start": 132724, "end": 149997, "text": "De manera que cualquiera que infrinja uno de estos mandamientos muy pequeños, y así enseñe a los hombres, muy pequeño será llamado en el reino de los cielos: pero cualquiera que los haga y los enseñe, este será llamado grande en el reino de los cielos.", "words": [[0, 132724], [3, 132840], [10, 133040], [14, 133380], [25, 133980], [29, 134470], [38, 134960], [42, 135280], [45, 135500], [51, 135760], [64, 136520], [68, 136860], [78, 137680], [80, 138020], [84, 138500], [91, 138980], [93, 139060], [97, 139220], [106, 139600], [110, 140300], [118, 141000], [123, 141220], [131, 141620], [134, 141860], [137, 142020], [143, 142460], [146, 142600], [150, 142720], [158, 143695], [163, 143839], [174, 144439], [178, 144619], [182, 144799], [187, 145259], [189, 145419], [193, 145579], [201, 146539], [206, 146899], [211, 147199], [219, 147559], [226, 148039], [229, 148379], [232, 148559], [238, 148959], [241, 149099], [245, 149239]]}, {"verse": 20, "start": 150347, "end": 158668, "text": "Porque os digo, que si vuestra justicia no es mayor que la de los escribas y de los fariseos, no entraréis en el reino de los cielos.", "words": [[0, 150347], [7, 150568], [10, 150688], [16, 150928], [20, 151108], [23, 151268], [31, 151628], [40, 152228], [43, 152448], [46, 152548], [52, 152888], [56, 153128], [59, 153628], [62, 153768], [66, 153908], [75, 154528], [77, 154668], [80, 154808], [84, 154928], [94, 155888], [97, 156148], [107, 156888], [110, 157108], [113, 157288], [119, 157688], [122, 157828], [126, 157968]]}, {"verse": 21, "start": 159018, "end": 166459, "text": "Oísteis que fue dicho a los antiguos: No matarás; pero cualquiera que mate, será culpable de juicio.", "words": [[0, 159018], [8, 159744], [12, 159864], [16, 160084], [22, 160404], [24, 160564], [28, 160664], [38, 161834], [41, 162040], [50, 163097], [55, 163242], [66, 163842], [70, 164002], [76, 164362], [81, 164902], [90, 165582], [93, 165782]]}, {"verse": 22, "start": 166809, "end": 183738, "text": "Pero yo os digo que cualquiera que se enoje sin causa con su hermano, será culpable de juicio; y cualquiera que le diga a su hermano: Necio, será culpable ante el concilio; y cualquiera que le diga: Insensato, quedará expuesto al infierno de fuego.", "words": [[0, 166809], [5, 166953], [8, 167213], [11, 167313], [16, 167573], [20, 167753], [31, 168273], [35, 168413], [38, 168593], [44, 169033], [48, 169233], [54, 169693], [58, 169993], [61, 170193], [70, 170613], [75, 170813], [84, 171393], [87, 171553], [95, 172451], [97, 172574], [108, 173114], [112, 173274], [115, 173414], [120, 173774], [122, 173834], [125, 173974], [134, 174861], [141, 175421], [146, 175621], [155, 176321], [160, 176721], [163, 176921], [173, 178061], [175, 178146], [186, 178626], [190, 178766], [193, 178886], [199, 179621], [210, 180904], [218, 181304], [227, 182044], [230, 182224], [239, 182944], [242, 183144]]}, {"verse": 23, "start": 184088, "end": 189965, "text": "Por tanto, si traes tu ofrenda al altar y allí te acuerdas de que tu hermano tiene algo contra ti,", "words": [[0, 184088], [4, 184211], [11, 184711], [14, 184871], [20, 185231], [23, 185351], [31, 185891], [34, 186031], [40, 186451], [42, 186771], [47, 187091], [50, 187251], [59, 187771], [62, 187931], [66, 188031], [69, 188171], [77, 188551], [83, 188751], [88, 189091], [95, 189511]]}, {"verse": 24, "start": 190315, "end": 199864, "text": "Deja allí tu ofrenda delante del altar, y vete, reconcíliate primero con tu hermano, y entonces ven y ofrece tu ofrenda.", "words": [[0, 190315], [5, 190802], [10, 191082], [13, 191302], [21, 191942], [29, 192402], [33, 192642], [40, 192942], [42, 193362], [48, 194122], [61, 195082], [69, 195502], [73, 195822], [76, 195982], [85, 196722], [87, 196902], [96, 197302], [100, 197882], [102, 198462], [109, 198922], [112, 199162]]}, {"verse": 25, "start": 200214, "end": 214732, "text": "Concíliate con tu adversario pronto, entre tanto que estás con él en el camino; porque no acontezca que el adversario te entregue al juez, y el juez te entregue al guardia, y seas echado en prisión.", "words": [[0, 200576], [11, 200976], [15, 201256], [18, 201416], [29, 202136], [37, 203116], [43, 203376], [49, 203796], [53, 203996], [59, 204236], [63, 204536], [66, 204776], [69, 204996], [72, 205136], [80, 205995], [87, 206217], [90, 206477], [100, 207257], [104, 207437], [107, 207777], [118, 208557], [121, 208844], [130, 209130], [133, 209417], [139, 209977], [141, 210477], [144, 210617], [149, 211077], [152, 211350], [161, 211624], [164, 211897], [173, 212777], [175, 213097], [180, 213337], [187, 213877], [190, 214017]]}, {"verse": 26, "start": 215082, "end": 220126, "text": "De cierto te digo, que no saldrás de allí, hasta que pagues la última moneda.", "words": [[0, 215082], [3, 215248], [10, 215548], [13, 215888], [19, 216268], [23, 216528], [26, 216688], [34, 217248], [37, 217368], [43, 217688], [49, 218228], [53, 218428], [60, 218848], [63, 219008], [70, 219348]]}, {"verse": 27, "start": 220476, "end": 223875, "text": "Oísteis que fue dicho: No adulterarás:", "words": [[0, 220476], [8, 221265], [12, 221425], [16, 221625], [23, 222461], [26, 222646]]}, {"verse": 28, "start": 224225, "end": 231869, "text": "Pero yo os digo, que cualquiera que mira a una mujer para codiciarla, ya adulteró con ella en su corazón.", "words": [[0, 224225], [5, 224367], [8, 224627], [11, 224747], [17, 225027], [21, 225282], [32, 225982], [36, 226202], [41, 226482], [43, 226782], [47, 226942], [53, 227282], [58, 227862], [70, 228442], [73, 229322], [82, 230302], [86, 230522], [91, 230782], [94, 230982], [97, 231142]]}, {"verse": 29, "start": 232219, "end": 244127, "text": "Por tanto, si tu ojo derecho te es ocasión de caer, sácalo, y échalo de ti: que mejor te es que se pierda uno de tus miembros, que no que todo tu cuerpo sea echado al infierno.", "words": [[0, 232219], [4, 232343], [11, 232783], [14, 232943], [17, 233103], [21, 233403], [29, 233763], [32, 234013], [35, 234263], [43, 234783], [46, 234903], [52, 235703], [60, 236223], [62, 236603], [69, 236943], [72, 237143], [76, 237725], [80, 237807], [86, 238127], [89, 238347], [92, 238507], [96, 238587], [99, 238767], [106, 239227], [110, 239547], [113, 239747], [117, 239927], [127, 240807], [131, 241027], [134, 241187], [138, 241347], [143, 241587], [146, 241847], [153, 242187], [157, 242627], [164, 243227], [167, 243347]]}, {"verse": 30, "start": 244477, "end": 255883, "text": "Y si tu mano derecha te es ocasión de caer, córtala, y échala de ti: que mejor te es que se pierda uno de tus miembros, que no que todo tu cuerpo sea echado al infierno.", "words": [[0, 244477], [2, 244578], [5, 244698], [8, 244858], [13, 245158], [21, 245458], [24, 245758], [27, 245978], [35, 246478], [38, 246618], [44, 247338], [53, 247918], [55, 248183], [62, 248663], [65, 248923], [69, 249480], [73, 249562], [79, 249882], [82, 250102], [85, 250262], [89, 250342], [92, 250522], [99, 250982], [103, 251302], [106, 251502], [110, 251682], [120, 252562], [124, 252782], [127, 252942], [131, 253102], [136, 253342], [139, 253602], [146, 253942], [150, 254382], [157, 254982], [160, 255102]]}, {"verse": 31, "start": 256233, "end": 262068, "text": "También fue dicho: Cualquiera que se divorcie de su mujer, déle carta de divorcio:", "words": [[0, 256233], [8, 256656], [12, 256896], [19, 257657], [30, 258181], [34, 258321], [37, 258481], [46, 259061], [49, 259221], [52, 259361], [59, 260041], [64, 260461], [70, 260861], [73, 261181]]}, {"verse": 32, "start": 262418, "end": 273739, "text": "Pero yo os digo, que el que se divorcie de su mujer, a no ser por causa de fornicación, hace que ella adultere; y el que se casa con la divorciada, comete adulterio.", "words": [[0, 262418], [5, 262583], [8, 262823], [11, 263083], [17, 263403], [21, 263688], [24, 263868], [28, 263988], [31, 264168], [40, 264748], [43, 264888], [46, 265068], [53, 265488], [55, 265768], [58, 265908], [62, 266168], [66, 266388], [72, 266688], [75, 266948], [88, 267708], [93, 268068], [97, 268308], [102, 268528], [112, 269678], [114, 269823], [117, 269943], [121, 270103], [124, 270283], [129, 270643], [133, 270983], [136, 271163], [148, 272323], [155, 273057]]}, {"verse": 33, "start": 274089, "end": 282889, "text": "Además habéis oído que fue dicho a los antiguos: No jurarás falsamente; sino que cumplirás al Señor tus juramentos.", "words": [[0, 274089], [7, 274712], [14, 275044], [19, 275384], [23, 275564], [27, 275764], [33, 276084], [35, 276224], [39, 276324], [49, 277468], [52, 277712], [60, 278332], [72, 279666], [77, 279910], [81, 280110], [91, 280950], [94, 281350], [100, 281710], [104, 281990]]}, {"verse": 34, "start": 283239, "end": 290080, "text": "Pero yo os digo: No juréis en ninguna manera: ni por el cielo, porque es el trono de Dios;", "words": [[0, 283239], [5, 283382], [8, 283662], [11, 283862], [17, 284589], [20, 284776], [27, 285276], [30, 285396], [38, 285796], [46, 286689], [49, 286816], [53, 287056], [56, 287196], [63, 287996], [70, 288376], [73, 288756], [76, 288916], [82, 289336], [85, 289496]]}, {"verse": 35, "start": 290430, "end": 298194, "text": "Ni por la tierra, porque es el estrado de sus pies; ni por Jerusalén, porque es la ciudad del gran Rey.", "words": [[0, 290430], [3, 290556], [7, 290796], [10, 290976], [18, 291836], [25, 292196], [28, 292476], [31, 292616], [39, 293156], [42, 293336], [46, 293476], [52, 294529], [55, 294619], [59, 294819], [70, 295879], [77, 296139], [80, 296399], [83, 296579], [90, 296919], [94, 297319], [99, 297599]]}, {"verse": 36, "start": 298544, "end": 302926, "text": "Ni por tu cabeza jurarás, porque no puedes hacer un cabello blanco o negro.", "words": [[0, 298589], [3, 298669], [7, 298869], [10, 299009], [17, 299309], [26, 299872], [33, 300434], [36, 300554], [43, 300834], [49, 301154], [52, 301354], [60, 301714], [67, 302214], [69, 302334]]}, {"verse": 37, "start": 303276, "end": 311116, "text": "Pero sea vuestro hablar: Sí, sí; No, no; porque lo que es más de esto, de mal procede.", "words": [[0, 303276], [5, 303440], [9, 303780], [17, 304180], [25, 304880], [29, 305263], [33, 306058], [37, 306264], [41, 308264], [48, 308414], [51, 308574], [55, 308694], [58, 308814], [62, 308954], [65, 309114], [71, 309694], [74, 310014], [78, 310274]]}, {"verse": 38, "start": 311466, "end": 316628, "text": "Oísteis que fue dicho a los antiguos: Ojo por ojo, y diente por diente.", "words": [[0, 311466], [8, 312192], [12, 312312], [16, 312532], [22, 312852], [24, 313012], [28, 313112], [38, 314282], [42, 314567], [46, 314787], [51, 315327], [53, 315487], [60, 315767], [64, 315967]]}, {"verse": 39, "start": 316978, "end": 325507, "text": "Pero yo os digo: No resistáis al mal; antes a cualquiera que te hiera en tu mejilla derecha, vuélvele también la otra;", "words": [[0, 316978], [5, 317121], [8, 317401], [11, 317601], [17, 318328], [20, 318493], [30, 319133], [33, 319353], [38, 320079], [44, 320545], [46, 320725], [57, 321285], [61, 321445], [64, 321625], [70, 321925], [73, 322025], [76, 322145], [84, 322565], [93, 323385], [102, 324085], [110, 324405], [113, 324865]]}, {"verse": 40, "start": 325857, "end": 330993, "text": "Y al que quiera ponerte a pleito y quitarte la túnica, déjale también la capa;", "words": [[0, 325857], [2, 325982], [5, 326102], [9, 326242], [16, 326562], [24, 327122], [26, 327442], [33, 327762], [35, 327902], [44, 328382], [47, 328562], [55, 329457], [62, 329837], [70, 330157], [73, 330437]]}, {"verse": 41, "start": 331343, "end": 336205, "text": "Y a cualquiera que te obligue a llevar carga por una milla, ve con él dos.", "words": [[0, 331343], [2, 331498], [4, 331578], [15, 331948], [19, 332318], [22, 332438], [30, 332938], [32, 332998], [39, 333278], [45, 333758], [49, 334078], [53, 334258], [60, 334898], [63, 334998], [67, 335258], [70, 335757]]}, {"verse": 42, "start": 336555, "end": 341755, "text": "Al que te pida, dale; y al que quiera tomar de ti prestado, no se lo rehúses.", "words": [[0, 336555], [3, 336725], [7, 336865], [10, 337045], [16, 337405], [22, 338154], [24, 338280], [27, 338380], [31, 338660], [38, 338940], [44, 339220], [47, 339460], [50, 339620], [60, 340260], [63, 340480], [66, 340680], [69, 341254]]}, {"verse": 43, "start": 342105, "end": 347561, "text": "Oísteis que fue dicho: Amarás a tu prójimo, y odiarás a tu enemigo.", "words": [[0, 342105], [8, 342894], [12, 343054], [16, 343254], [23, 344090], [30, 344576], [32, 344676], [35, 344796], [44, 345936], [46, 346136], [54, 346656], [56, 346736], [59, 346876]]}, {"verse": 44, "start": 347911, "end": 359365, "text": "Pero yo os digo: Amad a vuestros enemigos, bendecid a los que os maldicen, haced bien a los que os aborrecen, y orad por los que os maltratan y os persiguen;", "words": [[0, 347911], [5, 348054], [8, 348334], [11, 348534], [17, 349261], [22, 349662], [24, 349842], [33, 350262], [43, 351357], [52, 351917], [54, 352317], [58, 352457], [62, 352597], [65, 352697], [75, 353837], [81, 354137], [86, 354417], [88, 354757], [92, 354877], [96, 354977], [99, 355137], [110, 356257], [112, 356317], [117, 356677], [121, 356922], [125, 357122], [129, 357322], [132, 357462], [142, 358222], [144, 358422], [147, 358522]]}, {"verse": 45, "start": 359715, "end": 369378, "text": "Para que seáis hijos de vuestro Padre que está en los cielos: que hace que su sol salga sobre malos y buenos, y llueve sobre justos e injustos.", "words": [[0, 359715], [5, 359881], [9, 360041], [15, 360481], [21, 360941], [24, 361221], [32, 361581], [38, 361921], [42, 362161], [47, 362381], [50, 362561], [54, 362681], [62, 363501], [66, 363623], [71, 363843], [75, 364043], [78, 364203], [82, 364503], [88, 365023], [94, 365303], [100, 365883], [102, 366023], [110, 366443], [112, 366938], [119, 367318], [125, 367578], [132, 368438], [134, 368578]]}, {"verse": 46, "start": 369728, "end": 377434, "text": "Porque si amáis a los que os aman, ¿qué recompensa tendréis? ¿No hacen también lo mismo los publicanos?", "words": [[0, 369728], [7, 369950], [10, 370210], [16, 370730], [18, 371130], [22, 371250], [26, 371430], [29, 371610], [35, 372470], [40, 372650], [51, 373750], [61, 374855], [65, 375003], [71, 375283], [79, 375683], [82, 375903], [88, 376203], [92, 376423]]}, {"verse": 47, "start": 377784, "end": 384467, "text": "Y si saludáis solamente a vuestros hermanos, ¿qué hacéis de más? ¿no hacen también así los Gentiles?", "words": [[0, 377784], [2, 377930], [5, 378030], [14, 378750], [24, 379130], [26, 379550], [35, 379910], [45, 380610], [50, 380890], [57, 381390], [60, 381490], [65, 382195], [69, 382362], [75, 382662], [83, 383142], [87, 383462], [91, 383642]]}, {"verse": 48, "start": 384817, "end": 390295, "text": "Sed, pues, vosotros perfectos, como vuestro Padre que está en los cielos es perfecto.", "words": [[0, 384932], [5, 385082], [11, 385422], [20, 386242], [31, 387122], [36, 387522], [44, 387962], [50, 388402], [54, 388522], [59, 388702], [62, 388822], [66, 388962], [73, 389362], [76, 389482]]}]}