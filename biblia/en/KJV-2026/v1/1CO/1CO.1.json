{"book": "1CO", "chapter": 1, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 194040, "verses": [{"verse": 1, "start": 300, "end": 6024, "text": "Paul, called to be an apostle of Jesus Christ through the will of God, and Sosthenes our brother,", "words": [[0, 463], [6, 643], [13, 823], [16, 1083], [19, 1263], [22, 1363], [30, 1763], [33, 2023], [39, 2283], [46, 2783], [54, 3063], [58, 3183], [63, 3383], [66, 3523], [71, 3843], [75, 4513], [85, 5183], [89, 5483]]}, {"verse": 2, "start": 6474, "end": 18097, "text": "To the church of God which is at Corinth, to them that are sanctified in Christ Jesus, called to be saints, with all that in every place call upon the name of Jesus Christ our Lord, both theirs and ours:", "words": [[0, 6474], [3, 6568], [7, 6688], [14, 6908], [17, 7088], [21, 7308], [27, 7508], [30, 7628], [33, 7748], [42, 8068], [45, 8608], [50, 8828], [55, 8988], [59, 9128], [70, 9748], [73, 9888], [80, 10108], [87, 10548], [94, 11108], [97, 11308], [100, 11428], [108, 12258], [113, 12435], [117, 12595], [122, 12755], [125, 12915], [131, 13095], [137, 13375], [142, 13695], [147, 13935], [151, 14115], [156, 14395], [159, 14535], [165, 14815], [172, 15635], [176, 15775], [182, 16555], [187, 16735], [194, 17115], [198, 17515]]}, {"verse": 3, "start": 18547, "end": 23261, "text": "Grace be to you, and peace, from God our Father, and from the Lord Jesus Christ.", "words": [[0, 18547], [6, 18764], [9, 19044], [12, 19244], [17, 19444], [21, 19664], [28, 19984], [33, 20544], [37, 20824], [41, 20984], [49, 21344], [53, 21684], [58, 21864], [62, 22024], [67, 22244], [73, 22524]]}, {"verse": 4, "start": 23711, "end": 28563, "text": "I thank my God always on your behalf, for the grace of God which is given you by Jesus Christ;", "words": [[0, 23711], [2, 23831], [8, 24011], [11, 24211], [15, 24471], [22, 24891], [25, 25071], [30, 25191], [38, 25531], [42, 26011], [46, 26091], [52, 26371], [55, 26551], [59, 26791], [65, 26991], [68, 27111], [74, 27311], [78, 27491], [81, 27611], [87, 27851]]}, {"verse": 5, "start": 29013, "end": 33212, "text": "That in every thing you are enriched by him, in all utterance, and in all knowledge;", "words": [[0, 29013], [5, 29184], [8, 29351], [14, 29517], [20, 29684], [24, 30024], [28, 30184], [37, 30464], [40, 30744], [45, 31324], [48, 31404], [52, 31524], [63, 32044], [67, 32364], [70, 32504], [74, 32644]]}, {"verse": 6, "start": 33662, "end": 36444, "text": "Even as the testimony of Christ was confirmed in you:", "words": [[0, 33662], [5, 33865], [8, 34085], [12, 34225], [22, 34625], [25, 34905], [32, 35165], [36, 35445], [46, 35865], [49, 36105]]}, {"verse": 7, "start": 36894, "end": 41248, "text": "So that you come behind in no gift; waiting for the coming of our Lord Jesus Christ:", "words": [[0, 36894], [3, 37012], [8, 37172], [12, 37272], [17, 37472], [24, 37792], [27, 37972], [30, 38112], [36, 38832], [44, 39065], [48, 39285], [52, 39445], [59, 39705], [62, 39905], [66, 40005], [71, 40265], [77, 40545]]}, {"verse": 8, "start": 41698, "end": 46765, "text": "Who shall also confirm you to the end, that you may be blameless in the day of our Lord Jesus Christ.", "words": [[0, 41698], [4, 41780], [10, 42000], [15, 42260], [23, 42640], [27, 42860], [30, 43000], [34, 43140], [39, 43500], [44, 43900], [48, 44040], [52, 44200], [55, 44340], [65, 44840], [68, 44980], [72, 45080], [76, 45300], [79, 45440], [83, 45540], [88, 45780], [94, 46060]]}, {"verse": 9, "start": 47216, "end": 51858, "text": "God is faithful, by whom you were called to the fellowship of his Son Jesus Christ our Lord.", "words": [[0, 47216], [4, 47451], [7, 47651], [17, 48031], [20, 48271], [25, 48471], [29, 48611], [34, 48731], [41, 48971], [44, 49151], [48, 49251], [59, 49631], [62, 49891], [66, 50011], [70, 50251], [76, 50551], [83, 50991], [87, 51391]]}, {"verse": 10, "start": 52308, "end": 64197, "text": "Now I beg you, brethren, by the name of our Lord Jesus Christ, that you all speak the same thing, and that there be no divisions among you; but that you be perfectly joined together in the same mind and in the same judgment.", "words": [[0, 52308], [4, 52468], [6, 52728], [10, 52968], [15, 53168], [25, 53988], [28, 54088], [32, 54208], [37, 54448], [40, 54608], [44, 54728], [49, 54968], [55, 55248], [63, 56108], [68, 56228], [72, 56408], [76, 56528], [82, 56788], [86, 57008], [91, 57268], [98, 57528], [102, 58048], [107, 58208], [113, 58348], [116, 58548], [119, 58768], [129, 59168], [135, 59468], [140, 60126], [144, 60225], [149, 60365], [153, 60465], [156, 60605], [166, 61045], [173, 61385], [182, 61785], [185, 62045], [189, 62165], [194, 62405], [199, 62725], [203, 63045], [206, 63185], [210, 63305], [215, 63505]]}, {"verse": 11, "start": 64647, "end": 71425, "text": "For it has been declared to me of you, my brethren, by them which are of the house of Chloe, that there are contentions among you.", "words": [[0, 64647], [4, 64794], [7, 64914], [11, 65114], [16, 65314], [25, 65674], [28, 65894], [31, 66034], [34, 66234], [39, 66674], [42, 66814], [52, 67594], [55, 67774], [60, 68014], [66, 68234], [70, 68394], [73, 68514], [77, 68634], [83, 68874], [86, 69014], [93, 69714], [98, 69814], [104, 70034], [108, 70154], [120, 70834], [126, 71074]]}, {"verse": 12, "start": 71875, "end": 80668, "text": "Now this I say, that every one of you says, I am of Paul; and I of Apollos; and I of Cephas; and I of Christ.", "words": [[0, 71875], [4, 72067], [9, 72367], [11, 72527], [16, 72827], [21, 73267], [27, 73527], [31, 73747], [34, 73847], [38, 73987], [44, 74679], [46, 74862], [49, 75182], [52, 75462], [58, 76296], [62, 76439], [64, 76699], [67, 76919], [76, 77962], [80, 78131], [82, 78341], [85, 78796], [93, 79627], [97, 79781], [99, 79934], [102, 80034]]}, {"verse": 13, "start": 81118, "end": 86480, "text": "Is Christ divided? was Paul crucified for you? or were you baptized in the name of Paul?", "words": [[0, 81118], [3, 81262], [10, 81582], [19, 82682], [23, 82922], [28, 83182], [38, 83522], [42, 83882], [47, 84461], [50, 84579], [55, 84759], [59, 84899], [68, 85219], [71, 85619], [75, 85699], [80, 85859], [83, 85999]]}, {"verse": 14, "start": 86930, "end": 90034, "text": "I thank God that I baptized none of you, but Crispus and Gaius;", "words": [[0, 86930], [2, 87036], [8, 87216], [12, 87496], [17, 87676], [19, 87976], [28, 88276], [33, 88416], [36, 88576], [41, 88756], [45, 88976], [53, 89196], [57, 89516]]}, {"verse": 15, "start": 90484, "end": 93080, "text": "Lest any should say that I had baptized in my own name.", "words": [[0, 90484], [5, 90742], [9, 91002], [16, 91182], [20, 91422], [25, 91562], [27, 91662], [31, 91762], [40, 92082], [43, 92382], [46, 92542], [50, 92662]]}, {"verse": 16, "start": 93530, "end": 98743, "text": "And I baptized also the household of Stephanas: besides, I know not whether I baptized any other.", "words": [[0, 93530], [4, 93629], [6, 93909], [15, 94189], [20, 94389], [24, 94549], [34, 94829], [37, 95264], [48, 95944], [57, 96446], [59, 96566], [64, 96806], [68, 97246], [76, 97546], [78, 97876], [87, 98206], [91, 98406]]}, {"verse": 17, "start": 99193, "end": 106212, "text": "For Christ sent me not to baptize, but to preach the gospel: not with wisdom of words, lest the cross of Christ should be made of none effect.", "words": [[0, 99193], [4, 99318], [11, 99578], [16, 99778], [19, 99898], [23, 100058], [26, 100178], [35, 100978], [39, 101038], [42, 101158], [49, 101378], [53, 101518], [61, 102282], [65, 102498], [70, 102718], [77, 103018], [80, 103218], [87, 103858], [92, 104118], [96, 104238], [102, 104478], [105, 104618], [112, 104878], [119, 105098], [122, 105258], [127, 105478], [130, 105578], [135, 105798]]}, {"verse": 18, "start": 106662, "end": 112870, "text": "For the preaching of the cross is to them that perish foolishness; but to us which are saved it is the power of God.", "words": [[0, 106662], [4, 106752], [8, 106832], [18, 107152], [21, 107332], [25, 107432], [31, 107672], [34, 107932], [37, 108072], [42, 108312], [47, 108692], [54, 109052], [67, 110166], [71, 110264], [74, 110484], [77, 110764], [83, 110884], [87, 111024], [93, 111364], [96, 111684], [99, 111764], [103, 111904], [109, 112244], [112, 112484]]}, {"verse": 19, "start": 113320, "end": 118600, "text": "For it is written, I will destroy the wisdom of the wise, and will bring to nothing the understanding of the prudent.", "words": [[0, 113320], [4, 113465], [7, 113605], [10, 113725], [19, 114285], [21, 114445], [26, 114605], [34, 114985], [38, 115165], [45, 115425], [48, 115605], [52, 115745], [58, 116005], [62, 116245], [67, 116385], [73, 116585], [76, 116745], [84, 117105], [88, 117325], [102, 117825], [105, 118045], [109, 118165]]}, {"verse": 20, "start": 119050, "end": 126572, "text": "Where is the wise? where is the scribe? where is the disputer of this world? has not God made foolish the wisdom of this world?", "words": [[0, 119050], [6, 119250], [9, 119410], [13, 119570], [19, 120392], [25, 120599], [28, 120799], [32, 120999], [40, 121764], [46, 121942], [49, 122102], [53, 122242], [62, 122742], [65, 122942], [70, 123102], [77, 123923], [81, 124062], [85, 124302], [89, 124562], [94, 124822], [102, 125182], [106, 125442], [113, 125722], [116, 125962], [121, 126122]]}, {"verse": 21, "start": 127022, "end": 134446, "text": "For after that in the wisdom of God the world by wisdom knew not God, it pleased God by the foolishness of preaching to save them that believe.", "words": [[0, 127022], [4, 127149], [10, 127389], [15, 127909], [18, 127969], [22, 128089], [29, 128329], [32, 128549], [36, 128929], [40, 128989], [46, 129289], [49, 129529], [56, 129809], [61, 130089], [65, 130289], [70, 130989], [73, 131129], [81, 131369], [85, 131709], [88, 131909], [92, 132069], [104, 132529], [107, 132709], [117, 133009], [120, 133289], [125, 133529], [130, 133769], [135, 134134]]}, {"verse": 22, "start": 134896, "end": 138260, "text": "For the Jews require a sign, and the Greeks seek after wisdom:", "words": [[0, 134896], [4, 134979], [8, 135079], [13, 135319], [21, 135639], [23, 135919], [29, 136259], [33, 136619], [37, 136779], [44, 136959], [49, 137299], [55, 137619]]}, {"verse": 23, "start": 138710, "end": 143219, "text": "But we preach Christ crucified, to the Jews a stumblingblock, and to the Greeks foolishness;", "words": [[0, 138710], [4, 138813], [7, 138933], [14, 139193], [21, 139493], [32, 140033], [35, 140313], [39, 140433], [44, 140673], [46, 141063], [62, 141453], [66, 141873], [69, 142013], [73, 142153], [80, 142333]]}, {"verse": 24, "start": 143669, "end": 149070, "text": "But to them which are called, both Jews and Greeks, Christ the power of God, and the wisdom of God.", "words": [[0, 143669], [4, 143766], [7, 143926], [12, 144126], [18, 144326], [22, 144466], [30, 144786], [35, 145106], [40, 145426], [44, 145606], [52, 146346], [59, 146646], [63, 146926], [69, 147186], [72, 147366], [77, 147666], [81, 148026], [85, 148166], [92, 148446], [95, 148666]]}, {"verse": 25, "start": 149520, "end": 155184, "text": "Because the foolishness of God is wiser than men; and the weakness of God is stronger than men.", "words": [[0, 149520], [8, 149728], [12, 149908], [24, 150408], [27, 150568], [31, 150828], [34, 151148], [40, 151588], [45, 151808], [50, 152509], [54, 152654], [58, 152774], [67, 153054], [70, 153374], [74, 153694], [77, 153974], [86, 154394], [91, 154774]]}, {"verse": 26, "start": 155634, "end": 162317, "text": "For you see your calling, brethren, how that not many wise men after the flesh, not many mighty, not many noble, are called:", "words": [[0, 155634], [4, 155730], [8, 155870], [12, 156130], [17, 156290], [26, 156750], [36, 157410], [40, 157510], [45, 157670], [49, 157890], [54, 158150], [59, 158470], [63, 158750], [69, 159130], [73, 159310], [80, 159990], [84, 160110], [89, 160350], [97, 160930], [101, 161030], [106, 161270], [113, 161590], [117, 161870]]}, {"verse": 27, "start": 162767, "end": 170727, "text": "But God has chosen the foolish things of the world to confound the wise; and God has chosen the weak things of the world to confound the things which are mighty;", "words": [[0, 162767], [4, 162865], [8, 163065], [12, 163305], [19, 163625], [23, 163825], [31, 164085], [38, 164425], [41, 164625], [45, 164765], [51, 165065], [54, 165245], [63, 165705], [67, 165825], [73, 166711], [77, 166830], [81, 167050], [85, 167270], [92, 167550], [96, 167790], [101, 168010], [108, 168270], [111, 168490], [115, 168590], [121, 168890], [124, 169070], [133, 169510], [137, 169650], [144, 169870], [150, 170090], [154, 170230]]}, {"verse": 28, "start": 171177, "end": 178295, "text": "And base things of the world, and things which are despised, has God chosen, yes, and things which are not, to bring to nothing things that are:", "words": [[0, 171177], [4, 171323], [9, 171563], [16, 171863], [19, 172083], [23, 172203], [30, 172503], [34, 172883], [41, 173143], [47, 173323], [51, 173443], [61, 174123], [65, 174443], [69, 174683], [77, 175023], [82, 175463], [86, 175823], [93, 176083], [99, 176263], [103, 176403], [108, 176603], [111, 176923], [117, 177123], [120, 177263], [128, 177443], [135, 177783], [140, 177963]]}, {"verse": 29, "start": 178745, "end": 181003, "text": "That no flesh should glory in his presence.", "words": [[0, 178745], [5, 178936], [8, 179136], [14, 179436], [21, 179696], [27, 180016], [30, 180216], [34, 180356]]}, {"verse": 30, "start": 181453, "end": 189254, "text": "But of him are you in Christ Jesus, who of God is made to us wisdom, and righteousness, and sanctification, and redemption:", "words": [[0, 181453], [4, 181554], [7, 181674], [11, 181934], [15, 182374], [19, 182534], [22, 182674], [29, 182914], [36, 183654], [40, 183894], [43, 184014], [47, 184334], [50, 184534], [55, 184734], [58, 184934], [61, 185074], [69, 185454], [73, 185934], [88, 186394], [92, 186914], [108, 187694], [112, 188014]]}, {"verse": 31, "start": 189704, "end": 193640, "text": "That, according as it is written, He that glories, let him glory in the Lord.", "words": [[0, 189704], [6, 189846], [16, 190146], [19, 190446], [22, 190546], [25, 190646], [34, 191266], [37, 191386], [42, 191586], [51, 192346], [55, 192526], [59, 192666], [65, 193026], [68, 193206], [72, 193286]]}]}