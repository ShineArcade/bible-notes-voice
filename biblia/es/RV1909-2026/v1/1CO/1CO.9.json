{"book": "1CO", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 193562, "verses": [{"verse": 1, "start": 300, "end": 6613, "text": "¿No soy apóstol? ¿no soy libre? ¿no he visto a Jesús el Señor nuestro? ¿no sois vosotros mi obra en el Señor?", "words": [[0, 300], [4, 444], [8, 644], [17, 1540], [21, 1684], [25, 1884], [32, 2616], [36, 2755], [39, 2795], [45, 3035], [47, 3175], [53, 3335], [56, 3575], [62, 3815], [71, 4709], [75, 4847], [80, 5087], [89, 5467], [92, 5687], [97, 5867], [100, 6007], [103, 6107]]}, {"verse": 2, "start": 6963, "end": 13633, "text": "Si a los otros no soy apóstol, a vosotros ciertamente lo soy: porque el sello de mi apostolado sois vosotros en el Señor.", "words": [[0, 6963], [3, 7101], [5, 7181], [9, 7281], [15, 7501], [18, 7721], [22, 7901], [31, 8701], [33, 8781], [42, 9221], [54, 9621], [57, 10021], [62, 10617], [69, 10797], [72, 10957], [78, 11197], [81, 11317], [84, 11437], [95, 12077], [100, 12377], [109, 12817], [112, 13017], [115, 13137]]}, {"verse": 3, "start": 13983, "end": 16474, "text": "Esta es mi respuesta a los que me preguntan.", "words": [[0, 13983], [5, 14241], [8, 14381], [11, 14501], [21, 15041], [23, 15421], [27, 15541], [31, 15681], [34, 15801]]}, {"verse": 4, "start": 16824, "end": 19118, "text": "Qué, ¿no tenemos derecho a comer y a beber?", "words": [[0, 16824], [5, 16882], [9, 17002], [17, 17342], [25, 17682], [27, 17922], [33, 18202], [35, 18602], [37, 18682]]}, {"verse": 5, "start": 19468, "end": 26686, "text": "¿No tenemos derecho a traer con nosotros una esposa creyente también como los otros apóstoles, y los hermanos del Señor, y Cefas?", "words": [[0, 19468], [4, 19647], [12, 19967], [20, 20307], [22, 20567], [28, 20847], [32, 20947], [41, 21387], [45, 21667], [52, 22047], [61, 22587], [69, 22887], [74, 23207], [78, 23387], [84, 23647], [95, 24307], [97, 24767], [101, 24907], [110, 25367], [114, 25467], [121, 25847], [123, 26289]]}, {"verse": 6, "start": 27036, "end": 29894, "text": "¿O sólo yo y Bernabé no tenemos derecho a no trabajar?", "words": [[0, 27036], [3, 27141], [8, 27381], [11, 27581], [13, 27681], [21, 28101], [24, 28221], [32, 28561], [40, 28921], [42, 29141], [45, 29221]]}, {"verse": 7, "start": 30244, "end": 37989, "text": "¿Quién jamás peleó a sus expensas? ¿quién planta viña, y no come de su fruto? ¿o quién apacienta el ganado, y no come de la leche del ganado?", "words": [[0, 30244], [7, 30499], [13, 30809], [19, 31119], [21, 31279], [25, 31359], [35, 32511], [42, 32708], [49, 33068], [55, 33368], [57, 33428], [60, 33528], [65, 33728], [68, 33868], [71, 34008], [78, 34756], [81, 34852], [87, 35202], [97, 35552], [100, 35692], [108, 36152], [110, 36412], [113, 36532], [118, 36752], [121, 36892], [124, 36992], [130, 37212], [134, 37372]]}, {"verse": 8, "start": 38339, "end": 41659, "text": "¿Digo esto según los hombres? ¿no dice esto también la ley?", "words": [[0, 38339], [6, 38582], [11, 38862], [17, 39182], [21, 39382], [30, 40232], [34, 40335], [39, 40575], [44, 40855], [52, 41155], [55, 41375]]}, {"verse": 9, "start": 42009, "end": 48625, "text": "Porque en la ley de Moisés está escrito: No pondrás bozal al buey que trilla. ¿Tiene Dios cuidado de los bueyes?", "words": [[0, 42009], [7, 42226], [10, 42366], [13, 42466], [17, 42666], [20, 42786], [27, 43146], [32, 43486], [41, 44305], [44, 44392], [52, 44832], [58, 45272], [61, 45412], [66, 45732], [70, 45832], [78, 46597], [85, 46946], [90, 47320], [98, 47692], [101, 47813], [105, 48243]]}, {"verse": 10, "start": 48975, "end": 58754, "text": "¿O lo dice enteramente por nosotros? Pues por nosotros está escrito; porque con esperanza ha de arar el que ara; y el que trilla, con esperanza de recibir el fruto.", "words": [[0, 48975], [3, 49078], [6, 49158], [11, 49418], [23, 50018], [27, 50298], [37, 51279], [42, 51418], [46, 51658], [55, 52018], [60, 52398], [69, 53238], [76, 53422], [80, 53622], [90, 54322], [93, 54522], [96, 54622], [101, 54942], [104, 55102], [108, 55412], [113, 55908], [115, 56011], [118, 56111], [122, 56231], [130, 56651], [134, 57051], [144, 57591], [147, 57711], [155, 58071], [158, 58251]]}, {"verse": 11, "start": 59104, "end": 64695, "text": "Si nosotros os sembramos lo espiritual, ¿es gran cosa si cosechamos de vuestros bienes materiales?", "words": [[0, 59104], [3, 59245], [12, 59585], [15, 59845], [25, 60325], [28, 60505], [40, 61525], [44, 61825], [49, 62025], [54, 62345], [57, 62585], [68, 63145], [71, 63325], [80, 63665], [87, 63985]]}, {"verse": 12, "start": 65045, "end": 76685, "text": "Si otros tienen en vosotros este derecho, ¿no más bien nosotros? Pero no hemos usado de este derecho: antes lo sufrimos todo, por no poner ningún obstáculo al evangelio de Cristo.", "words": [[0, 65045], [3, 65173], [9, 65413], [16, 65753], [19, 65953], [28, 66353], [33, 66633], [42, 67353], [46, 67453], [50, 67613], [55, 67753], [65, 68675], [70, 68832], [73, 69012], [79, 69192], [85, 69632], [88, 69792], [93, 69932], [102, 72112], [108, 72397], [111, 72617], [120, 73177], [126, 73757], [130, 74017], [133, 74157], [139, 74417], [146, 74737], [156, 75337], [159, 75517], [169, 76057], [172, 76157]]}, {"verse": 13, "start": 77035, "end": 83286, "text": "¿No sabéis que los que trabajan en el santuario, comen del santuario; y que los que sirven al altar, del altar participan?", "words": [[0, 77035], [4, 77153], [11, 77493], [15, 77653], [19, 77753], [23, 77893], [32, 78393], [35, 78473], [38, 78593], [49, 79113], [55, 79408], [59, 79648], [70, 80458], [72, 80544], [76, 80643], [80, 80783], [84, 80964], [91, 81324], [94, 81443], [101, 81804], [105, 82124], [111, 82404]]}, {"verse": 14, "start": 83636, "end": 87629, "text": "Así también ordenó el Señor a los que anuncian el evangelio, que vivan del evangelio.", "words": [[0, 83636], [4, 83817], [12, 84057], [19, 84517], [22, 84597], [28, 84837], [30, 85037], [34, 85177], [38, 85277], [47, 85657], [50, 85737], [61, 86497], [65, 86537], [71, 86817], [75, 86957]]}, {"verse": 15, "start": 87979, "end": 97346, "text": "Pero yo de nada de esto me aproveché: ni tampoco he escrito esto para que se haga así conmigo; porque tengo por mejor morir, antes que nadie haga vana esta mi gloria.", "words": [[0, 87979], [5, 88098], [8, 88278], [11, 88358], [16, 88578], [19, 88758], [24, 88938], [27, 89078], [38, 89958], [41, 90079], [49, 90399], [52, 90679], [60, 90939], [65, 91379], [70, 91679], [74, 91839], [77, 92019], [82, 92219], [86, 92439], [95, 93301], [102, 93464], [108, 93784], [112, 93984], [118, 94264], [125, 94884], [131, 95264], [135, 95504], [141, 95744], [146, 96094], [151, 96444], [156, 96684], [159, 96844]]}, {"verse": 16, "start": 97696, "end": 106140, "text": "Pues bien que anuncio el evangelio, no tengo por qué gloriarme; porque me es impuesta necesidad; y ¡ay de mí si no anuncio el evangelio!", "words": [[0, 97696], [5, 97863], [10, 98123], [14, 98343], [22, 98803], [25, 98943], [36, 100003], [39, 100103], [45, 100443], [49, 100703], [53, 100863], [64, 101792], [71, 101974], [74, 102254], [77, 102534], [86, 102814], [97, 103875], [99, 104003], [103, 104173], [106, 104333], [109, 104493], [112, 104713], [115, 104833], [123, 105273], [126, 105393]]}, {"verse": 17, "start": 106490, "end": 112699, "text": "Por lo cual, si lo hago de voluntad, premio tendré; pero si por fuerza, se me ha encargado esta responsabilidad.", "words": [[0, 106490], [4, 106590], [7, 106690], [13, 106930], [16, 107130], [19, 107310], [24, 107490], [27, 107630], [37, 108230], [44, 108670], [52, 109395], [57, 109533], [60, 109713], [64, 109913], [72, 110333], [75, 110673], [78, 110813], [81, 110933], [91, 111493], [96, 111693]]}, {"verse": 18, "start": 113049, "end": 122626, "text": "¿Cuál, pues, es mi recompensa? Que predicando el evangelio, ponga el evangelio de Cristo gratuitamente, para no usar mal de mi potestad en el evangelio.", "words": [[0, 113049], [7, 113259], [13, 113739], [16, 113939], [19, 114079], [31, 115519], [35, 115611], [46, 116171], [49, 116291], [60, 117371], [66, 117691], [69, 117751], [79, 118291], [82, 118371], [89, 118731], [104, 119671], [109, 120171], [112, 120351], [117, 120571], [121, 120831], [124, 120991], [127, 121091], [136, 121731], [139, 121851], [142, 121951]]}, {"verse": 19, "start": 122976, "end": 128333, "text": "Por lo cual, siendo libre para con todos, me he hecho siervo de todos por ganar a más.", "words": [[0, 122976], [4, 123084], [7, 123224], [13, 123644], [20, 123984], [26, 124384], [31, 124644], [35, 124884], [42, 125704], [45, 125964], [48, 126064], [54, 126244], [61, 126724], [64, 126864], [70, 127144], [74, 127484], [80, 127844], [82, 127904]]}, {"verse": 20, "start": 128683, "end": 139999, "text": "Me he hecho a los judíos como judío, por ganar a los judíos; a los que están sujetos a la ley (aunque yo no sea sujeto a la ley) como sujeto a la ley, por ganar a los que están sujetos a la ley;", "words": [[0, 128683], [3, 128864], [6, 129004], [12, 129224], [14, 129344], [18, 129464], [25, 129984], [30, 130204], [37, 130884], [41, 131164], [47, 131544], [49, 131564], [53, 131744], [61, 132655], [63, 132771], [67, 132851], [71, 132991], [77, 133231], [85, 133791], [87, 133911], [90, 134011], [94, 134343], [102, 134526], [105, 134786], [108, 134906], [112, 135126], [119, 135706], [121, 135786], [124, 135906], [129, 136346], [134, 136526], [141, 137026], [143, 137106], [146, 137186], [151, 137764], [155, 137893], [161, 138313], [163, 138373], [167, 138533], [171, 138653], [177, 138913], [185, 139473], [187, 139593], [190, 139673]]}, {"verse": 21, "start": 140349, "end": 148793, "text": "A los que son sin ley, como si yo fuera sin ley, (no estando yo sin ley de Dios, sino bajo la ley de Cristo) por ganar a los que estaban sin ley.", "words": [[0, 140349], [2, 140447], [6, 140547], [10, 140667], [14, 140887], [18, 141107], [23, 141727], [28, 141927], [31, 142087], [34, 142227], [40, 142507], [44, 142747], [49, 143367], [53, 143487], [61, 143867], [64, 144007], [68, 144227], [72, 144427], [75, 144587], [81, 145281], [86, 145482], [91, 145702], [94, 145902], [98, 146082], [101, 146242], [109, 146982], [113, 147102], [119, 147482], [121, 147542], [125, 147702], [129, 147822], [137, 148122], [141, 148402]]}, {"verse": 22, "start": 149143, "end": 157200, "text": "Me he hecho a los débiles, débil, por ganar a los débiles: a todos me he hecho todo, para que de todo punto salve a algunos.", "words": [[0, 149143], [3, 149322], [6, 149522], [12, 149782], [14, 149902], [18, 150042], [27, 150822], [34, 151522], [38, 151622], [44, 151982], [46, 152022], [50, 152202], [59, 153146], [61, 153346], [67, 153566], [70, 153846], [73, 153966], [79, 154146], [85, 154486], [90, 154986], [94, 155166], [97, 155306], [102, 155506], [108, 155866], [114, 156426], [116, 156466]]}, {"verse": 23, "start": 157550, "end": 162261, "text": "Y esto hago por causa del evangelio, por hacerme juntamente participante de él.", "words": [[0, 157550], [2, 157673], [7, 157933], [12, 158173], [16, 158393], [22, 158633], [26, 158893], [37, 159933], [41, 160033], [49, 160453], [60, 160993], [73, 161773], [76, 161953]]}, {"verse": 24, "start": 162611, "end": 170192, "text": "¿No sabéis que los que corren en el estadio, todos a la verdad corren, pero uno lleva el premio? Corred de tal manera que lo obtengáis.", "words": [[0, 162611], [4, 162750], [11, 163130], [15, 163290], [19, 163430], [23, 163590], [30, 163950], [33, 164050], [36, 164170], [45, 164770], [51, 165230], [53, 165470], [56, 165530], [63, 165750], [71, 166290], [76, 166670], [80, 166870], [86, 167070], [89, 167190], [97, 167895], [104, 168279], [107, 168419], [111, 168659], [118, 168979], [122, 169219], [125, 169379]]}, {"verse": 25, "start": 170542, "end": 178854, "text": "Y todo aquel que lucha, de todo se abstiene: y ellos, a la verdad, para recibir una corona corruptible; pero nosotros, incorruptible.", "words": [[0, 170542], [2, 170666], [7, 170846], [13, 171266], [17, 171366], [24, 171846], [27, 172166], [32, 172366], [35, 172586], [45, 173462], [47, 173604], [54, 173904], [56, 174124], [59, 174184], [67, 174504], [72, 174784], [80, 175204], [84, 175524], [91, 175844], [104, 176955], [109, 177084], [119, 177524]]}, {"verse": 26, "start": 179204, "end": 185896, "text": "Así que, yo de esta manera corro, no como a cosa incierta; de esta manera peleo, no como quien golpea el aire:", "words": [[0, 179204], [4, 179402], [9, 179582], [12, 179802], [15, 179942], [20, 180142], [27, 180422], [34, 181302], [37, 181402], [42, 181622], [44, 181762], [49, 181882], [59, 182836], [62, 182976], [67, 183136], [74, 183456], [81, 184336], [84, 184436], [89, 184656], [95, 184876], [102, 185396], [105, 185516]]}, {"verse": 27, "start": 186246, "end": 193162, "text": "Antes hiero mi cuerpo, y lo pongo en servidumbre; no sea que, habiendo predicado a otros, yo mismo venga a ser reprobado.", "words": [[0, 186246], [6, 186500], [12, 186780], [15, 186920], [23, 187280], [25, 187580], [28, 187680], [34, 187980], [37, 188060], [50, 188997], [53, 189181], [57, 189421], [62, 189621], [71, 189961], [81, 190561], [83, 190681], [90, 191441], [93, 191541], [99, 191821], [105, 192201], [107, 192321], [111, 192461]]}]}