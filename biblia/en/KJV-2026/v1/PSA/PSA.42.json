{"book": "PSA", "chapter": 42, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 91671, "verses": [{"verse": 1, "start": 300, "end": 5259, "text": "As the hart pants after the water brooks, so pants my soul after you, O God.", "words": [[0, 300], [3, 471], [7, 651], [12, 831], [18, 1151], [24, 1491], [28, 1631], [34, 1911], [42, 2811], [45, 2931], [51, 3331], [54, 3591], [59, 3911], [65, 4291], [70, 4671], [72, 4751]]}, {"verse": 2, "start": 5709, "end": 10825, "text": "My soul thirsts for God, for the living God: when shall I come and appear before God?", "words": [[0, 5709], [3, 5856], [8, 6156], [16, 6776], [20, 6896], [25, 7236], [29, 7456], [33, 7576], [40, 7816], [45, 8684], [50, 8830], [56, 9050], [58, 9230], [63, 9470], [67, 9610], [74, 9870], [81, 10210]]}, {"verse": 3, "start": 11275, "end": 17361, "text": "My tears have been my food day and night, while they continually say to me, Where is your God?", "words": [[0, 11275], [3, 11421], [9, 11741], [14, 12141], [19, 12361], [22, 12581], [27, 12921], [31, 13321], [35, 13521], [42, 13861], [48, 14401], [53, 14561], [65, 15121], [69, 15521], [72, 15701], [76, 16188], [82, 16424], [85, 16664], [90, 16824]]}, {"verse": 4, "start": 17711, "end": 30753, "text": "When I remember these things, I pour out my soul in me: for I had gone with the multitude, I went with them to the house of God, with the voice of joy and praise, with a multitude that kept a pilgrim feast.", "words": [[0, 17711], [5, 17874], [7, 17994], [16, 18294], [22, 18554], [30, 19214], [32, 19374], [37, 19654], [41, 19814], [44, 19954], [49, 20254], [52, 20434], [56, 20986], [60, 21137], [62, 21317], [66, 21497], [71, 21777], [76, 22057], [80, 22217], [91, 23217], [93, 23417], [98, 23637], [103, 23877], [108, 24077], [111, 24257], [115, 24397], [121, 24657], [124, 24857], [129, 25717], [134, 25817], [138, 25977], [144, 26257], [147, 26417], [151, 26817], [155, 27097], [163, 28193], [168, 28340], [170, 28440], [180, 2