{"book": "MAT", "chapter": 28, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 165320, "verses": [{"verse": 1, "start": 300, "end": 9412, "text": "Y PASADO el sábado, al amanecer del primer día de la semana, vino María Magdalena, y la otra María, a ver el sepulcro.", "words": [[0, 300], [2, 405], [9, 765], [12, 985], [20, 1885], [23, 2185], [32, 2765], [36, 2945], [43, 3325], [47, 3705], [50, 3845], [53, 3965], [61, 4825], [66, 5065], [72, 5565], [83, 6505], [85, 6785], [88, 6965], [93, 7265], [100, 7805], [102, 8125], [106, 8285], [109, 8485]]}, {"verse": 2, "start": 9862, "end": 22097, "text": "Y he aquí, hubo un gran terremoto: porque el ángel del Señor, descendiendo del cielo y llegando, había hecho rodar la piedra, y estaba sentado sobre ella.", "words": [[0, 9862], [2, 10020], [5, 10180], [11, 10540], [16, 11060], [19, 11180], [24, 11420], [35, 12810], [42, 13035], [45, 13215], [51, 13615], [55, 13775], [62, 14215], [75, 15395], [79, 15575], [85, 16115], [87, 16335], [97, 17235], [103, 17615], [109, 18235], [115, 18855], [118, 19035], [126, 20035], [128, 20135], [135, 20415], [143, 21075], [149, 21435]]}, {"verse": 3, "start": 22547, "end": 27487, "text": "Y su aspecto era como un relámpago, y su vestido blanco como la nieve.", "words": [[0, 22547], [2, 22673], [5, 22813], [13, 23533], [17, 23673], [22, 23933], [25, 24133], [36, 25053], [38, 25493], [41, 25633], [49, 26053], [56, 26453], [61, 26673], [64, 26833]]}, {"verse": 4, "start": 27937, "end": 32676, "text": "Y de miedo de él los guardas temblaron, y quedaron como muertos.", "words": [[0, 27937], [2, 28053], [5, 28153], [11, 28473], [14, 28693], [17, 28873], [21, 29153], [29, 29713], [40, 30553], [42, 31033], [51, 31513], [56, 31753]]}, {"verse": 5, "start": 33126, "end": 41038, "text": "Y respondiendo el ángel, dijo a las mujeres: No temáis vosotras; porque yo sé que buscáis a Jesús, que fue crucificado.", "words": [[0, 33126], [2, 33213], [15, 34033], [18, 34193], [25, 34653], [30, 35193], [32, 35373], [36, 35453], [45, 36502], [48, 36738], [55, 37008], [65, 38099], [72, 38279], [75, 38479], [78, 38639], [82, 38739], [90, 39159], [92, 39279], [99, 39599], [103, 39879], [107, 40079]]}, {"verse": 6, "start": 41488, "end": 47000, "text": "No está aquí; porque ha resucitado, como dijo. Venid, ved el lugar donde fue puesto el Señor.", "words": [[0, 41488], [3, 41651], [8, 41871], [14, 42639], [21, 42820], [24, 42940], [36, 43680], [41, 43840], [47, 44619], [54, 44809], [58, 45035], [61, 45262], [67, 45482], [73, 45762], [77, 46042], [84, 46362], [87, 46502]]}, {"verse": 7, "start": 47450, "end": 56570, "text": "E id pronto, decid a sus discípulos que ha resucitado de los muertos: y he aquí va delante de vosotros a Galilea; allí le veréis; he aquí, os lo he dicho.", "words": [[0, 47450], [2, 47564], [5, 47714], [13, 48164], [19, 48614], [21, 48674], [25, 48774], [36, 49394], [40, 49694], [43, 49994], [54, 50294], [57, 50394], [61, 50494], [70, 51494], [72, 51549], [75, 51639], [80, 51859], [83, 52079], [91, 52459], [94, 52579], [103, 52999], [105, 53159], [114, 54213], [119, 54445], [122, 54678], [130, 55208], [133, 55288], [139, 55548], [142, 55908], [145, 56088], [148, 56168]]}, {"verse": 8, "start": 56920, "end": 67972, "text": "Entonces ellas, saliendo del sepulcro con temor y gran gozo, fueron corriendo a dar las nuevas a sus discípulos. Y mientras iban a dar las nuevas a sus discípulos,", "words": [[0, 56920], [9, 57421], [16, 58121], [25, 58561], [29, 58781], [38, 59561], [42, 59701], [48, 60081], [50, 60161], [55, 60361], [61, 61381], [68, 61761], [78, 62461], [80, 62561], [84, 62721], [88, 62901], [95, 63181], [97, 63401], [101, 63581], [113, 64689], [115, 64808], [124, 65188], [129, 65708], [131, 65788], [135, 65988], [139, 66128], [146, 66508], [148, 66788], [152, 66968]]}, {"verse": 9, "start": 68422, "end": 78273, "text": "He aquí, Jesús les sale al encuentro, diciendo: Salve. Y ellas se llegaron y abrazaron sus pies, y le adoraron.", "words": [[0, 68469], [3, 68559], [9, 68759], [15, 69219], [19, 69579], [24, 69979], [27, 70179], [38, 70859], [48, 71930], [55, 72882], [57, 73028], [63, 73268], [66, 73488], [75, 74008], [77, 74368], [87, 74968], [91, 75188], [97, 75508], [99, 75908], [102, 76048]]}, {"verse": 10, "start": 78723, "end": 87762, "text": "Entonces Jesús les dice: No temáis: id, dad las nuevas a mis hermanos, para que vayan a Galilea, y allí me verán.", "words": [[0, 78723], [9, 78723], [15, 79168], [19, 79548], [25, 80424], [28, 81035], [36, 82007], [40, 82107], [44, 82567], [48, 82967], [55, 83307], [57, 83607], [61, 83727], [71, 84507], [76, 84827], [80, 85027], [86, 85227], [88, 85847], [97, 86467], [99, 86547], [104, 86807], [107, 87207]]}, {"verse": 11, "start": 88212, "end": 98621, "text": "Y yendo ellas, he aquí unos de la guardia vinieron a la ciudad, y dieron aviso a los príncipes de los sacerdotes de todas las cosas que habían acontecido.", "words": [[0, 88212], [2, 88355], [8, 88662], [15, 88968], [18, 89275], [23, 89525], [28, 89775], [31, 89935], [34, 90055], [42, 90535], [51, 91035], [53, 91195], [56, 91255], [64, 91635], [66, 92475], [73, 92815], [79, 93175], [81, 93315], [85, 93415], [95, 94135], [98, 94295], [102, 94415], [113, 95295], [116, 95775], [122, 96055], [126, 96375], [132, 96835], [136, 97135], [143, 97475]]}, {"verse": 12, "start": 99071, "end": 105174, "text": "Y reunidos con los ancianos, y habido consejo, dieron mucho dinero a los soldados,", "words": [[0, 99071], [2, 99238], [11, 99878], [15, 100058], [19, 100198], [29, 100938], [31, 101338], [38, 101698], [47, 102498], [54, 103158], [60, 103458], [67, 103898], [69, 104138], [73, 104238]]}, {"verse": 13, "start": 105624, "end": 111198, "text": "Diciendo: Decid: Sus discípulos vinieron de noche, y le hurtaron, durmiendo nosotros.", "words": [[0, 105624], [10, 106743], [17, 107483], [21, 107613], [32, 108233], [41, 108673], [44, 108853], [51, 109113], [53, 109333], [56, 109453], [66, 109933], [76, 110473]]}, {"verse": 14, "start": 111648, "end": 116741, "text": "Y si esto llega a oídos del gobernador, nosotros le persuadiremos, y os pondremos a salvo.", "words": [[0, 111648], [2, 111748], [5, 111868], [10, 112108], [16, 112368], [18, 112528], [24, 112888], [28, 113008], [40, 113988], [49, 114268], [52, 114568], [67, 115368], [69, 115528], [72, 115648], [82, 116088], [84, 116248]]}, {"verse": 15, "start": 117091, "end": 125596, "text": "Y ellos, tomando el dinero, hicieron como estaban instruidos: y este dicho fue divulgado entre los judíos hasta el día de hoy.", "words": [[0, 117091], [2, 117254], [9, 117494], [17, 118074], [20, 118194], [28, 118654], [37, 119674], [42, 119934], [50, 120274], [62, 121674], [64, 121969], [69, 122169], [75, 122449], [79, 122689], [89, 123389], [95, 123649], [99, 123869], [106, 124449], [112, 124709], [115, 124869], [119, 125029], [122, 125209]]}, {"verse": 16, "start": 126046, "end": 131940, "text": "Pero los once discípulos se fueron a Galilea, al monte donde Jesús les había ordenado.", "words": [[0, 126046], [5, 126188], [9, 126428], [14, 126668], [25, 127488], [28, 127868], [35, 128148], [37, 128348], [46, 129028], [49, 129268], [55, 129608], [61, 129908], [67, 130348], [71, 130748], [77, 131088]]}, {"verse": 17, "start": 132390, "end": 136670, "text": "Y como le vieron, le adoraron: pero algunos dudaban.", "words": [[0, 132390], [2, 132496], [7, 132736], [10, 132916], [18, 133736], [21, 133936], [31, 135084], [36, 135409], [44, 135749]]}, {"verse": 18, "start": 137120, "end": 144079, "text": "Y llegando Jesús, les habló, diciendo: Toda autoridad me ha sido dada en el cielo y en la tierra.", "words": [[0, 137120], [2, 137227], [11, 137627], [18, 138027], [22, 138427], [29, 138947], [39, 140126], [44, 140412], [54, 141012], [57, 141272], [60, 141412], [65, 141672], [70, 142112], [73, 142252], [76, 142392], [82, 142812], [84, 143052], [87, 143152], [90, 143312]]}, {"verse": 19, "start": 144529, "end": 154501, "text": "Por tanto, id, y haced discípulos de todas las naciones, bautizándolos en el nombre del Padre, y del Hijo, y del Espíritu Santo:", "words": [[0, 144529], [4, 144655], [11, 145295], [15, 145595], [17, 145955], [23, 146575], [34, 147495], [37, 147695], [43, 147935], [47, 148255], [57, 149215], [71, 150335], [74, 150535], [77, 150655], [84, 151035], [88, 151275], [95, 151895], [97, 152035], [101, 152215], [107, 152675], [109, 153075], [113, 153195], [122, 153855]]}, {"verse": 20, "start": 154951, "end": 164920, "text": "Enseñándoles que guarden todas las cosas que os he mandado: y he aquí, yo estoy con vosotros todos los días, hasta el fin del mundo. Amén.", "words": [[0, 155519], [13, 156079], [17, 156319], [25, 156799], [31, 157099], [35, 157379], [41, 157739], [45, 157999], [48, 158139], [51, 158259], [60, 159250], [62, 159457], [65, 159597], [71, 160097], [74, 160217], [80, 160477], [84, 160797], [93, 161337], [99, 161577], [103, 161917], [109, 162657], [115, 162957], [118, 163137], [122, 163297], [126, 163517], [133, 164346]]}]}