{"book": "GEN", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 249571, "verses": [{"verse": 1, "start": 300, "end": 4740, "text": "Era entonces toda la tierra de una lengua y unas mismas palabras.", "words": [[0, 300], [4, 637], [13, 1257], [18, 1677], [21, 1897], [28, 2277], [31, 2477], [35, 2597], [42, 3077], [44, 3177], [49, 3357], [56, 3877]]}, {"verse": 2, "start": 5190, "end": 12134, "text": "Y aconteció que, cuando salieron de oriente, hallaron una llanura en la tierra de Sinar, y se establecieron allí.", "words": [[0, 5190], [2, 5315], [12, 5935], [17, 6135], [24, 6355], [33, 6915], [36, 7095], [45, 7595], [54, 8315], [58, 8595], [66, 9075], [69, 9195], [72, 9355], [79, 9635], [82, 9875], [89, 10235], [91, 10655], [94, 10795], [108, 11675]]}, {"verse": 3, "start": 12584, "end": 22956, "text": "Y dijeron los unos a los otros: Vaya, hagamos ladrillo y cozámoslo con fuego. Y les fue el ladrillo en lugar de piedra, y el asfalto en lugar de mezcla.", "words": [[0, 12584], [2, 12688], [10, 13208], [14, 13408], [19, 13728], [21, 13988], [25, 14168], [32, 15167], [38, 15485], [46, 15885], [55, 16385], [57, 16745], [67, 17105], [71, 17285], [78, 18146], [80, 18292], [84, 18432], [88, 18672], [91, 18952], [100, 19512], [103, 19672], [109, 19892], [112, 20132], [120, 20672], [122, 20852], [125, 21032], [133, 21592], [136, 21712], [142, 21972], [145, 22232]]}, {"verse": 4, "start": 23406, "end": 34055, "text": "Y dijeron: Vamos, edifiquémonos una ciudad y una torre, cuya cúspide llegue al cielo; y hagámonos un nombre, no sea que seamos esparcidos sobre la faz de toda la tierra.", "words": [[0, 23406], [2, 23533], [11, 24466], [18, 24763], [32, 25723], [36, 25883], [43, 26263], [45, 26523], [49, 26663], [56, 27203], [61, 27803], [69, 28283], [76, 28643], [79, 28723], [86, 29506], [88, 29606], [98, 30106], [101, 30246], [109, 30706], [112, 30806], [116, 31026], [120, 31186], [127, 31586], [138, 32286], [144, 32566], [147, 32726], [151, 32966], [154, 33166], [159, 33346], [162, 33526]]}, {"verse": 5, "start": 34405, "end": 40242, "text": "Y descendió Jehová para ver la ciudad y la torre que edificaban los hijos de los hombres.", "words": [[0, 34405], [2, 34511], [12, 35151], [19, 35671], [24, 35911], [28, 36151], [31, 36331], [38, 36691], [40, 36971], [43, 37071], [49, 37591], [53, 37831], [64, 38611], [68, 38851], [74, 39191], [77, 39391], [81, 39531]]}, {"verse": 6, "start": 40692, "end": 51436, "text": "Y dijo Jehová: He aquí el pueblo es uno, y todos estos tienen un lenguaje: y han comenzado a obrar, y nada los hará desistir ahora de lo que han pensado hacer.", "words": [[0, 40692], [2, 41046], [7, 41432], [15, 42086], [18, 42166], [23, 42386], [26, 42566], [33, 42886], [36, 43126], [41, 43406], [43, 43826], [49, 44106], [55, 44566], [62, 45006], [65, 45206], [75, 46412], [77, 46534], [81, 46654], [91, 47254], [93, 47314], [100, 48014], [102, 48094], [107, 48294], [111, 48514], [116, 48834], [125, 49374], [131, 49654], [134, 49874], [137, 50014], [141, 50154], [145, 50274], [153, 50774]]}, {"verse": 7, "start": 51886, "end": 59341, "text": "Ahora pues, descendamos, y confundamos allí sus lenguas, para que ninguno entienda el habla de su compañero.", "words": [[0, 51886], [6, 52210], [12, 52530], [25, 53650], [27, 54030], [39, 54770], [44, 54970], [48, 55190], [57, 55750], [62, 56290], [66, 56430], [74, 57010], [83, 57670], [86, 57870], [92, 58070], [95, 58250], [98, 58370]]}, {"verse": 8, "start": 59691, "end": 66887, "text": "Así los esparció Jehová desde allí sobre la faz de toda la tierra, y dejaron de edificar la ciudad.", "words": [[0, 59691], [4, 60677], [8, 61150], [17, 61624], [24, 62097], [30, 62257], [35, 62597], [41, 62897], [44, 63157], [48, 63417], [51, 63697], [56, 63877], [59, 64097], [67, 64517], [69, 65037], [77, 65497], [80, 65657], [89, 66097], [92, 66337]]}, {"verse": 9, "start": 67337, "end": 78152, "text": "Por esto fue llamado el nombre de ella Babel, porque allí confundió Jehová el lenguaje de toda la tierra, y desde allí los esparció sobre la faz de toda la tierra.", "words": [[0, 67337], [4, 67461], [9, 67681], [13, 67961], [21, 68280], [24, 68520], [31, 68860], [34, 69328], [39, 69794], [46, 70261], [53, 70580], [58, 70901], [68, 71450], [75, 72000], [78, 72200], [87, 72821], [90, 72980], [95, 73220], [98, 73461], [106, 74490], [108, 74620], [114, 74840], [119, 75200], [123, 75440], [132, 76100], [138, 76400], [141, 76620], [145, 76860], [148, 77060], [153, 77260], [156, 77480]]}, {"verse": 10, "start": 78602, "end": 87634, "text": "Estas son las generaciones de Sem: Sem, de edad de cien años, engendró a Arfaxad, dos años después del diluvio.", "words": [[0, 78602], [6, 79088], [10, 79288], [14, 79528], [27, 80308], [30, 80488], [35, 81901], [40, 81901], [43, 82125], [48, 82445], [51, 82625], [56, 82805], [62, 83305], [71, 84225], [73, 84445], [82, 85245], [86, 85785], [91, 86245], [99, 86625], [103, 86865]]}, {"verse": 11, "start": 88084, "end": 95500, "text": "Y vivió Sem, después que engendró a Arfaxad, quinientos años, y engendró hijos e hijas.", "words": [[0, 88084], [2, 88229], [8, 88589], [13, 88929], [21, 89709], [25, 90089], [34, 90429], [36, 90769], [45, 91509], [56, 92249], [62, 92969], [64, 93449], [73, 94149], [79, 94529], [81, 94889]]}, {"verse": 12, "start": 95950, "end": 100603, "text": "Y Arfaxad vivió treinta y cinco años, y engendró a Sala.", "words": [[0, 96219], [2, 96525], [10, 96832], [16, 97147], [24, 97462], [26, 97777], [32, 98092], [38, 98812], [40, 99392], [49, 99972], [51, 100092]]}, {"verse": 13, "start": 101053, "end": 108732, "text": "Y vivió Arfaxad, después que engendró a Sala, cuatrocientos tres años, y engendró hijos e hijas.", "words": [[0, 101053], [2, 101177], [8, 101777], [17, 102377], [25, 102797], [29, 103017], [38, 103657], [40, 103757], [46, 104337], [60, 104917], [65, 105497], [71, 105937], [73, 106437], [82, 107137], [88, 107557], [90, 107977]]}, {"verse": 14, "start": 109182, "end": 112965, "text": "Y vivió Sala treinta años, y engendró a Heber.", "words": [[0, 109182], [2, 109325], [8, 109692], [13, 110058], [21, 110425], [27, 111005], [29, 111605], [38, 112285], [40, 112651]]}, {"verse": 15, "start": 113415, "end": 120543, "text": "Y vivió Sala, después que engendró a Heber, cuatrocientos tres años, y engendró hijos e hijas.", "words": [[0, 113415], [2, 113560], [8, 113900], [14, 114280], [22, 114660], [26, 114940], [35, 115480], [37, 116000], [44, 116520], [58, 117040], [63, 117560], [69, 118540], [71, 118580], [80, 119120], [86, 119460], [88, 119860]]}, {"verse": 16, "start": 120993, "end": 125156, "text": "Y vivió Heber treinta y cuatro años, y engendró a Peleg.", "words": [[0, 120993], [2, 121277], [8, 121545], [14, 121813], [22, 122081], [24, 122349], [31, 122617], [37, 123457], [39, 123777], [48, 124377], [50, 124786]]}, {"verse": 17, "start": 125606, "end": 133217, "text": "Y vivió Heber, después que engendró a Peleg, cuatrocientos treinta años, y engendró hijos e hijas.", "words": [[0, 125606], [2, 125727], [8, 126097], [15, 126467], [23, 126887], [27, 127147], [36, 127707], [38, 127807], [45, 128454], [59, 129100], [67, 129747], [73, 130447], [75, 130967], [84, 131687], [90, 132107], [92, 132487]]}, {"verse": 18, "start": 133667, "end": 137516, "text": "Y vivió Peleg treinta años, y engendró a Reu.", "words": [[0, 133667], [2, 133797], [8, 134204], [14, 134610], [22, 135017], [28, 135637], [30, 136117], [39, 136777], [41, 136997]]}, {"verse": 19, "start": 137966, "end": 145669, "text": "Y vivió Peleg, después que engendró a Reu, doscientos nueve años, y engendró hijos e hijas.", "words": [[0, 137966], [2, 138086], [8, 138466], [15, 138966], [23, 139906], [27, 140206], [36, 140806], [38, 140986], [43, 141579], [54, 142173], [60, 142766], [66, 143326], [68, 143666], [77, 144326], [83, 144646], [85, 144986]]}, {"verse": 20, "start": 146119, "end": 150204, "text": "Y Reu vivió treinta y dos años, y engendró a Serug.", "words": [[0, 146346], [2, 146572], [6, 146799], [12, 147039], [20, 147279], [22, 147519], [26, 147759], [32, 148379], [34, 148739], [43, 149399], [45, 149829]]}, {"verse": 21, "start": 150654, "end": 158044, "text": "Y vivió Reu, después que engendró a Serug, doscientos siete años, y engendró hijos e hijas.", "words": [[0, 150654], [2, 150783], [8, 151163], [13, 151683], [21, 152263], [25, 152503], [34, 153123], [36, 153568], [43, 154013], [54, 154458], [60, 154903], [66, 155943], [68, 156023], [77, 156623], [83, 157023], [85, 157403]]}, {"verse": 22, "start": 158494, "end": 162666, "text": "Y vivió Serug treinta años, y engendró a Nacor.", "words": [[0, 158494], [2, 158621], [8, 158961], [14, 159371], [22, 159781], [28, 160541], [30, 161301], [39, 161771], [41, 162240]]}, {"verse": 23, "start": 163116, "end": 171043, "text": "Y vivió Serug, después que engendró a Nacor, doscientos años, y engendró hijos e hijas.", "words": [[0, 163116], [2, 163242], [8, 163672], [15, 164102], [23, 164922], [27, 165322], [36, 165797], [38, 166272], [45, 166747], [56, 167222], [62, 168062], [64, 168702], [73, 169422], [79, 169822], [81, 170302]]}, {"verse": 24, "start": 171493, "end": 175140, "text": "Y vivió Nacor veintinueve años, y engendró a Taré.", "words": [[0, 171493], [2, 171618], [8, 172065], [14, 172511], [26, 172958], [32, 173578], [34, 174058], [43, 174618], [45, 174738]]}, {"verse": 25, "start": 175590, "end": 182712, "text": "Y vivió Nacor, después que engendró a Taré, ciento diecinueve años, y engendró hijos e hijas.", "words": [[0, 175590], [2, 175734], [8, 176114], [15, 176494], [23, 176874], [27, 177034], [36, 177534], [38, 177654], [44, 178254], [51, 178854], [62, 179454], [68, 180014], [70, 180794], [79, 181394], [85, 181714], [87, 182054]]}, {"verse": 26, "start": 183162, "end": 188890, "text": "Y vivió Taré setenta años, y engendró a Abram, y a Nacor, y a Harán.", "words": [[0, 183290], [2, 183450], [8, 183610], [13, 183970], [21, 184330], [27, 184830], [29, 185203], [38, 185577], [40, 185950], [47, 186570], [49, 186870], [51, 187170], [58, 187470], [60, 187964], [62, 188458]]}, {"verse": 27, "start": 189340, "end": 197985, "text": "Estas son las generaciones de Taré: Taré engendró a Abram, y a Nacor, y a Harán; y Harán engendró a Lot.", "words": [[0, 189340], [6, 189704], [10, 189884], [14, 190044], [27, 190764], [30, 190964], [36, 191675], [41, 191897], [50, 192797], [52, 192977], [59, 194597], [61, 195057], [63, 195219], [70, 195382], [72, 195544], [74, 195707], [81, 196116], [83, 196386], [89, 196656], [98, 197356], [100, 197516]]}, {"verse": 28, "start": 198435, "end": 205441, "text": "Y murió Harán antes que su padre Taré en la tierra donde nació, en Ur de los caldeos.", "words": [[0, 198435], [2, 198582], [8, 199062], [14, 199542], [20, 200102], [24, 200542], [27, 200702], [33, 201062], [38, 201582], [41, 201742], [44, 201862], [51, 202162], [57, 202622], [64, 203842], [67, 204082], [70, 204262], [73, 204422], [77, 204542]]}, {"verse": 29, "start": 205891, "end": 218915, "text": "Y tomaron Abram y Nacor para sí mujeres: el nombre de la mujer de Abram fue Sarai, y el nombre de la mujer de Nacor, Milca, hija de Harán, padre de Milca y de Isca.", "words": [[0, 205891], [2, 205988], [10, 206378], [16, 206768], [18, 207158], [24, 207548], [29, 207768], [32, 207948], [41, 209015], [44, 209162], [51, 209502], [54, 209722], [57, 209842], [63, 210242], [66, 210552], [72, 210862], [76, 211202], [83, 212262], [85, 212602], [88, 212742], [95, 213102], [98, 213322], [101, 213422], [107, 213682], [110, 213922], [117, 214782], [124, 215642], [129, 215942], [132, 216462], [139, 216982], [145, 217242], [148, 217602], [154, 217962], [156, 218182], [159, 218573]]}, {"verse": 30, "start": 219365, "end": 223070, "text": "Mas Sarai fue estéril, y no tenía hijo.", "words": [[0, 219365], [4, 219709], [10, 220469], [14, 220729], [23, 221469], [25, 221949], [28, 222089], [34, 222429]]}, {"verse": 31, "start": 223520, "end": 242023, "text": 