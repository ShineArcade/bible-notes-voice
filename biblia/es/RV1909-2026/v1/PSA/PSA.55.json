{"book": "PSA", "chapter": 55, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 160687, "verses": [{"verse": 1, "start": 300, "end": 8816, "text": "Al Músico principal: en Neginoth: Masquil de David. ESCUCHA, oh Dios, mi oración, y no te escondas de mi súplica.", "words": [[0, 300], [3, 485], [10, 985], [21, 2151], [24, 2628], [34, 3326], [42, 3853], [45, 3953], [52, 4735], [61, 5066], [64, 5432], [70, 5799], [73, 6059], [82, 6579], [84, 7079], [87, 7219], [90, 7379], [99, 7939], [102, 8059], [105, 8139]]}, {"verse": 2, "start": 9166, "end": 14810, "text": "Préstame atención, y respóndeme: clamo en mi oración, y levanto el grito,", "words": [[0, 9421], [9, 9711], [19, 10311], [21, 11041], [33, 12064], [39, 12234], [42, 12374], [45, 12534], [54, 13074], [56, 13614], [64, 13934], [67, 14254]]}, {"verse": 3, "start": 15160, "end": 24449, "text": "A causa de la voz del enemigo, por la opresión del impío; porque echaron sobre mí iniquidad, y con furor me han amenazado.", "words": [[0, 15160], [2, 15302], [8, 15642], [11, 15902], [14, 16022], [18, 16242], [22, 16402], [31, 17022], [35, 17702], [38, 17862], [47, 18422], [51, 18602], [58, 19663], [65, 19927], [73, 20587], [79, 20847], [82, 21147], [93, 21907], [95, 22367], [99, 22647], [105, 23127], [108, 23287], [112, 23507]]}, {"verse": 4, "start": 24799, "end": 30571, "text": "Mi corazón está doloroso dentro de mí, y terrores de muerte sobre mí han caído.", "words": [[0, 24799], [3, 24962], [11, 25422], [16, 25802], [25, 26422], [32, 26682], [35, 26982], [39, 27162], [41, 27582], [50, 28202], [53, 28322], [60, 28702], [66, 29102], [69, 29442], [73, 29802]]}, {"verse": 5, "start": 30921, "end": 35486, "text": "Temor y temblor vinieron sobre mí, y terror me ha cubierto.", "words": [[0, 30921], [6, 31382], [8, 31642], [16, 32222], [25, 32722], [31, 33082], [35, 33802], [37, 33902], [44, 34222], [47, 34522], [50, 34662]]}, {"verse": 6, "start": 35836, "end": 41344, "text": "Y dije: ¡Quién me diese alas como de paloma! volaría yo, y descansaría.", "words": [[0, 36038], [2, 36284], [8, 36735], [15, 37019], [18, 37229], [24, 37439], [29, 38099], [34, 38339], [37, 38519], [45, 39441], [53, 39904], [57, 40164], [59, 40284]]}, {"verse": 7, "start": 41694, "end": 46742, "text": "Ciertamente huiría lejos: moraría en el desierto. (Selah.)", "words": [[0, 41694], [12, 42562], [19, 43222], [26, 44178], [34, 44726], [37, 44886], [40, 45026], [50, 46446]]}, {"verse": 8, "start": 47092, "end": 52106, "text": "Me apresuraría a escapar del viento tempestuoso, de la tempestad.", "words": [[0, 47092], [3, 47240], [15, 48240], [17, 48440], [25, 49120], [29, 49300], [36, 49820], [49, 50900], [52, 51100], [55, 51220]]}, {"verse": 9, "start": 52456, "end": 59490, "text": "Deshace, oh Señor, divide la lengua de ellos; porque he visto violencia y rencilla en la ciudad.", "words": [[0, 52456], [9, 53343], [12, 53363], [19, 53943], [26, 54103], [29, 54383], [36, 54743], [39, 54863], [46, 55695], [53, 56055], [56, 56315], [62, 56575], [72, 57315], [74, 57455], [83, 58215], [86, 58555], [89, 58735]]}, {"verse": 10, "start": 59840, "end": 65616, "text": "Día y noche la rodean sobre sus muros; e iniquidad y trabajo hay en medio de ella.", "words": [[0, 59840], [4, 60165], [6, 60265], [12, 60465], [15, 60705], [22, 61245], [28, 61545], [32, 61785], [39, 62627], [41, 62773], [51, 63473], [53, 63633], [61, 64113], [65, 64373], [68, 64553], [74, 64853], [77, 65093]]}, {"verse": 11, "start": 65966, "end": 71682, "text": "Agravios hay en medio de ella, y el fraude y engaño no se apartan de sus plazas.", "words": [[0, 65966], [9, 66632], [13, 66912], [16, 67112], [22, 67372], [25, 67612], [31, 67972], [33, 68227], [36, 68387], [43, 68907], [45, 69167], [52, 69727], [55, 70027], [58, 70187], [66, 70727], [69, 70913], [73, 71099]]}, {"verse": 12, "start": 72032, "end": 81203, "text": "Porque no me afrentó un enemigo, lo cual habría soportado; ni se alzó contra mí el que me aborrecía, porque me hubiera ocultado de él:", "words": [[0, 72034], [7, 72234], [10, 72434], [13, 72594], [21, 73094], [24, 73234], [33, 73714], [36, 73834], [41, 74054], [48, 74394], [59, 75532], [62, 75678], [65, 75858], [70, 76238], [77, 76598], [80, 76898], [83, 77178], [87, 77318], [90, 77498], [101, 78578], [108, 79118], [111, 79338], [119, 79718], [128, 80558], [131, 80778]]}, {"verse": 13, "start": 81553, "end": 86519, "text": "Mas tú, hombre, al parecer íntimo mío, mi guía, y mi familiar:", "words": [[0, 81553], [4, 81799], [8, 82259], [16, 82999], [19, 83119], [27, 83689], [34, 84259], [39, 84679], [42, 84779], [48, 85279], [50, 85539], [53, 85699]]}, {"verse": 14, "start": 86869, "end": 93321, "text": "Que juntos comunicábamos dulcemente los secretos, a la casa de Dios andábamos en compañía.", "words": [[0, 86869], [4, 86954], [11, 87314], [25, 88274], [36, 88994], [40, 89154], [50, 90294], [52, 90554], [55, 90654], [60, 90894], [63, 91134], [68, 91414], [78, 92314], [81, 92474]]}, {"verse": 15, "start": 93671, "end": 101178, "text": "Condenados sean a muerte, desciendan vivos al infierno: porque maldades hay en su compañía, entre ellos.", "words": [[0, 93671], [11, 94420], [16, 94640], [18, 94800], [26, 95700], [37, 96280], [43, 96840], [46, 97000], [56, 98069], [63, 98253], [72, 98893], [76, 99213], [79, 99393], [82, 99513], [92, 100213], [98, 100433]]}, {"verse": 16, "start": 101528, "end": 104609, "text": "Yo a Dios clamaré; y Jehová me salvará.", "words": [[0, 101528], [3, 101882], [5, 102269], [10, 102655], [19, 103198], [21, 103440], [28, 103720], [31, 103860]]}, {"verse": 17, "start": 104959, "end": 110395, "text": "Tarde y mañana y a medio día oraré y clamaré; y él oirá mi voz.", "words": [[0, 104959], [6, 105244], [8, 105484], [15, 106164], [17, 106224], [19, 106444], [25, 106664], [29, 106884], [35, 107464], [37, 107724], [46, 108679], [48, 108839], [51, 109235], [56, 109632], [59, 109752]]}, {"verse": 18, "start": 110745, "end": 116602, "text": "Él ha redimido en paz mi alma de la guerra contra mí; pues fueron contra mí muchos.", "words": [[0, 110745], [3, 111187], [6, 111427], [15, 112127], [18, 112287], [22, 112587], [25, 112927], [30, 113187], [33, 113407], [36, 113527], [43, 113807], [50, 114227], [54, 114804], [59, 114911], [66, 115191], [73, 115611], [76, 115831]]}, {"verse": 19, "start": 116952, "end": 126350, "text": "Dios oirá, y los quebrantará luego, el que desde la antigüedad permanece (Selah); por cuanto no se mudan, ni temen a Dios.", "words": [[0, 116952], [5, 117276], [11, 118116], [13, 118556], [17, 118736], [29, 119516], [36, 120296], [39, 120636], [43, 120776], [49, 120996], [52, 121236], [63, 121836], [73, 122670], [82, 123683], [86, 123963], [93, 124183], [96, 124463], [99, 124603], [106, 125043], [109, 125343], [115, 125703], [117, 125823]]}, {"verse": 20, "start": 126700, "end": 131280, "text": "Extendió sus manos contra sus pacíficos: violó su pacto.", "words": [[0, 126700], [9, 127620], [13, 127820], [19, 128200], [26, 128540], [30, 128760], [41, 130010], [47, 130456], [50, 130556]]}, {"verse": 21, "start": 131630, "end": 140882, "text": "Ablandan más que manteca su boca, pero guerra hay en su corazón: suavizan sus palabras más que el aceite, mas ellas son cuchillos.", "words": [[0, 132000], [9, 132370], [13, 132610], [17, 132810], [25, 133350], [28, 133530], [34, 133950], [39, 134190], [46, 134550], [50, 134970], [53, 135130], [56, 135310], [65, 136698], [74, 137068], [78, 137268], [87, 137648], [91, 138048], [95, 138248], [98, 138428], [106, 138768], [110, 139108], [116, 139728], [120, 140008]]}, {"verse": 22, "start": 141232, "end": 146974, "text": "Echa sobre Jehová tu carga, y él te sustentará; no dejará para siempre caído al justo.", "words": [[0, 141384], [5, 141574], [11, 141934], [18, 142454], [21, 142554], [28, 142954], [30, 143514], [33, 143674], [36, 143794], [48, 144943], [51, 145071], [58, 145551], [63, 145671], [71, 146111], [77, 146551], [80, 146671]]}, {"verse": 23, "start": 147324, "end": 160287, "text": "Mas tú, oh Dios, harás descender aquellos al pozo de la sepultura: los hombres sanguinarios y engañadores no llegarán a la mitad de sus días: pero yo confiaré en ti.", "words": [[0, 147324], [4, 147837], [8, 148178], [11, 148520], [17, 148760], [23, 149700], [33, 150500], [42, 150960], [45, 151420], [50, 151880], [53, 151960], [56, 152080], [67, 153138], [71, 153264], [79, 153684], [92, 154884], [94, 155004], [106, 155764], [109, 156264], [118, 156844], [120, 156924], [123, 157004], [129, 157244], [132, 157584], [136, 157744], [142, 158594], [147, 158739], [150, 158919], [159, 159659], [162, 159919]]}]}