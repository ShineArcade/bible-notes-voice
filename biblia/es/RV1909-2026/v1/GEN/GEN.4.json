{"book": "GEN", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 221679, "verses": [{"verse": 1, "start": 300, "end": 8133, "text": "Y conoció Adam a su mujer Eva, la cual concibió y parió a Caín, y dijo: He adquirido varón por Jehová.", "words": [[0, 300], [2, 401], [10, 1221], [15, 1681], [17, 1721], [20, 1881], [26, 2221], [31, 3121], [34, 3241], [39, 3441], [48, 4241], [50, 4361], [56, 4721], [58, 4841], [64, 5481], [66, 5561], [72, 6291], [75, 6431], [85, 7011], [91, 7411], [95, 7800]]}, {"verse": 2, "start": 8413, "end": 15874, "text": "Y después parió a su hermano Abel. Y fue Abel pastor de ovejas, y Caín fue labrador de la tierra.", "words": [[0, 8413], [2, 8556], [10, 8836], [16, 9276], [18, 9376], [21, 9456], [29, 9896], [35, 10589], [37, 10694], [41, 10874], [46, 11214], [53, 11574], [56, 11834], [64, 12794], [66, 13154], [71, 13694], [75, 14254], [84, 14994], [87, 15134], [90, 15254]]}, {"verse": 3, "start": 16224, "end": 22432, "text": "Y aconteció andando el tiempo, que Caín trajo del fruto de la tierra una ofrenda a Jehová.", "words": [[0, 16224], [2, 16350], [12, 17150], [20, 17830], [23, 17970], [31, 18337], [35, 18705], [40, 19065], [46, 19565], [50, 19785], [56, 20225], [59, 20345], [62, 20485], [69, 20825], [73, 21125], [81, 21725], [83, 21905]]}, {"verse": 4, "start": 22782, "end": 31000, "text": "Y Abel trajo también de los primogénitos de sus ovejas, y de su grasa. Y miró Jehová con agrado a Abel y a su ofrenda;", "words": [[0, 22782], [2, 23061], [7, 23341], [13, 23761], [21, 24121], [24, 24381], [28, 24521], [41, 25381], [44, 25521], [48, 25661], [56, 26201], [58, 26401], [61, 26521], [64, 26701], [71, 27571], [73, 27877], [78, 28221], [85, 28565], [89, 28909], [96, 29253], [98, 29433], [103, 29793], [105, 29993], [107, 30113], [110, 30273]]}, {"verse": 5, "start": 31350, "end": 39388, "text": "Pero no miró con agrado a Caín y a la ofrenda suya. Y se ensañó Caín en gran manera, y decayó su semblante.", "words": [[0, 31350], [5, 31495], [8, 31715], [13, 32035], [17, 32195], [24, 32675], [26, 32855], [31, 33315], [33, 33555], [35, 33635], [38, 33735], [46, 34255], [52, 35050], [54, 35168], [57, 35498], [64, 35828], [69, 36328], [72, 36588], [77, 36868], [85, 37428], [87, 37843], [94, 38383], [97, 38523]]}, {"verse": 6, "start": 39738, "end": 46344, "text": "Entonces Jehová dijo a Caín: ¿Por qué te has enfurecido, y por qué ha decaído tu semblante?", "words": [[0, 39738], [9, 40316], [16, 41316], [21, 41556], [23, 41756], [29, 42594], [34, 42723], [38, 42903], [41, 43063], [45, 43243], [57, 43943], [59, 44228], [63, 44428], [67, 44628], [70, 44748], [78, 45168], [81, 45328]]}, {"verse": 7, "start": 46694, "end": 57063, "text": "Si haces bien, ¿no serás enaltecido? y si no haces bien, el pecado está a la puerta: con todo esto, a ti será su deseo, y tú lo dominarás.", "words": [[0, 46694], [3, 46856], [9, 47176], [15, 47856], [19, 47996], [25, 48396], [37, 49773], [39, 49890], [42, 50030], [45, 50210], [51, 50450], [57, 51090], [60, 51190], [67, 51610], [72, 51890], [74, 52050], [77, 52090], [85, 53188], [89, 53309], [94, 53529], [100, 53989], [102, 54229], [105, 54369], [110, 54689], [113, 54909], [120, 55509], [122, 55949], [125, 56089], [128, 56229]]}, {"verse": 8, "start": 57343, "end": 65987, "text": "Y habló Caín a su hermano Abel: y aconteció que estando ellos en el campo, Caín se levantó contra su hermano Abel, y le mató.", "words": [[0, 57343], [2, 57486], [8, 57726], [13, 58246], [15, 58466], [18, 58606], [26, 59006], [32, 59779], [34, 59880], [44, 60500], [48, 60740], [56, 61100], [62, 61340], [65, 61640], [68, 61740], [75, 62720], [80, 63080], [83, 63260], [91, 63840], [98, 64120], [101, 64340], [109, 64760], [115, 65060], [117, 65300], [120, 65420]]}, {"verse": 9, "start": 66337, "end": 73913, "text": "Y Jehová dijo a Caín: ¿Dónde está Abel tu hermano? Y él respondió: No sé; ¿soy yo guarda de mi hermano?", "words": [[0, 66337], [2, 66626], [9, 66946], [14, 67246], [16, 67386], [22, 68207], [29, 68473], [34, 68779], [39, 69086], [42, 69186], [51, 70282], [53, 70464], [56, 70604], [67, 71599], [70, 71744], [74, 72288], [79, 72525], [82, 72665], [89, 72985], [92, 73105], [95, 73205]]}, {"verse": 10, "start": 74193, "end": 80123, "text": "Y él le dijo: ¿Qué has hecho? La voz de la sangre de tu hermano clama a mí desde la tierra.", "words": [[0, 74193], [2, 74360], [5, 74500], [8, 74660], [14, 75385], [19, 75513], [23, 75733], [30, 76658], [33, 76799], [37, 76999], [40, 77179], [43, 77279], [50, 77639], [53, 77799], [56, 77939], [64, 78439], [70, 78819], [72, 78939], [75, 79099], [81, 79299], [84, 79499]]}, {"verse": 11, "start": 80473, "end": 87481, "text": "Ahora pues, maldito seas tú de la tierra que abrió su boca para recibir la sangre de tu hermano de tu mano:", "words": [[0, 80473], [6, 80777], [12, 81477], [20, 82177], [25, 82457], [28, 82777], [31, 82937], [34, 83037], [41, 83417], [45, 83637], [51, 83937], [54, 84097], [59, 84437], [64, 84737], [72, 85137], [75, 85417], [82, 85777], [85, 85957], [88, 86077], [96, 86597], [99, 86637], [102, 86757]]}, {"verse": 12, "start": 87831, "end": 94735, "text": "Cuando labres la tierra, no te volverá a dar su fuerza: errante y extranjero serás en la tierra.", "words": [[0, 87831], [7, 88007], [14, 88487], [17, 88607], [25, 89407], [28, 89507], [31, 89647], [39, 90127], [41, 90167], [45, 90287], [48, 90447], [56, 91535], [64, 92067], [66, 92367], [77, 93219], [83, 93662], [86, 93842], [89, 93962]]}, {"verse": 13, "start": 95015, "end": 99609, "text": "Y dijo Caín a Jehová: Grande es mi iniquidad para ser perdonada.", "words": [[0, 95015], [2, 95142], [7, 95402], [12, 95922], [14, 96142], [22, 96889], [29, 97269], [32, 97509], [35, 97689], [45, 98269], [50, 98549], [54, 98769]]}, {"verse": 14, "start": 99959, "end": 110125, "text": "He aquí me echas hoy de la faz de la tierra, y de tu presencia me esconderé; y seré errante y extranjero en la tierra; y sucederá que cualquiera que me halle, me matará.", "words": [[0, 100000], [3, 100080], [8, 100300], [11, 100500], [17, 100840], [21, 101080], [24, 101220], [27, 101360], [31, 101600], [34, 101780], [37, 101880], [45, 102220], [47, 102760], [50, 102880], [53, 103000], [63, 103580], [66, 103760], [77, 104670], [79, 104773], [84, 105093], [92, 105513], [94, 105673], [105, 106333], [108, 106433], [111, 106533], [119, 107279], [121, 107405], [130, 108045], [134, 108165], [145, 108725], [149, 108865], [152, 109045], [159, 109405], [162, 109605]]}, {"verse": 15, "start": 110405, "end": 123267, "text": "Y le respondió Jehová: Cierto que cualquiera que mate a Caín, siete veces será castigado. Entonces Jehová puso señal en Caín, para que no lo hiriese cualquiera que le hallara.", "words": [[0, 110405], [2, 110550], [5, 110670], [15, 111350], [23, 112239], [30, 112643], [34, 112823], [45, 113363], [49, 113523], [54, 113843], [56, 114333], [62, 114823], [68, 115143], [74, 115623], [79, 116003], [90, 117365], [99, 117828], [106, 118528], [111, 118788], [117, 119328], [120, 119468], [126, 120028], [131, 120688], [135, 120848], [138, 121068], [141, 121398], [149, 121728], [160, 122348], [164, 122488], [167, 122628]]}, {"verse": 16, "start": 123617, "end": 129802, "text": "Y salió Caín de delante de Jehová, y habitó en tierra de Nod, al oriente de Edén.", "words": [[0, 123617], [2, 123718], [8, 124078], [13, 124518], [16, 124658], [24, 125098], [27, 125238], [35, 125758], [37, 125898], [44, 126318], [47, 126498], [54, 126758], [57, 127058], [62, 127758], [65, 127998], [73, 128498], [76, 128938]]}, {"verse": 17, "start": 130152, "end": 141342, "text": "Y conoció Caín a su mujer, la cual concibió y parió a Enoc: y edificó una ciudad, y llamó el nombre de la ciudad del nombre de su hijo, Enoc.", "words": [[0, 130152], [2, 130315], [10, 130895], [15, 131335], [17, 131575], [20, 131735], [27, 132655], [30, 132855], [35, 133035], [44, 133875], [46, 134095], [52, 134575], [54, 134885], [60, 135670], [62, 135960], [70, 136600], [74, 136760], [82, 137180], [84, 137625], [90, 138045], [93, 138225], [100, 138585], [103, 138765], [106, 138885], [113, 139165], [117, 139485], [124, 139765], [127, 139965], [130, 140125], [136, 140735]]}, {"verse": 18, "start": 141692, "end": 151615, "text": "Y a Enoc nació Irad, e Irad engendró a Mehujael, y Mehujael engendró a Metusael, y Metusael engendró a Lamec.", "words": [[0, 141692], [2, 141851], [4, 142051], [9, 142251], [15, 142791], [21, 143556], [23, 143676], [28, 144236], [37, 144796], [39, 145433], [49, 146071], [51, 146618], [60, 147164], [69, 147711], [71, 148391], [81, 149071], [83, 149538], [92, 150004], [101, 150471], [103, 150651]]}, {"verse": 19, "start": 151965, "end": 158717, "text": "Y tomó para sí Lamec dos mujeres; el nombre de la una fue Ada, y el nombre de la otra Zila.", "words": [[0, 151965], [2, 152073], [7, 152353], [12, 152493], [15, 152813], [21, 153133], [25, 153393], [34, 154589], [37, 154756], [44, 155176], [47, 155396], [50, 155556], [54, 155776], [58, 156096], [63, 156636], [65, 156951], [68, 157091], [75, 157451], [78, 157631], [81, 157751], [86, 158252]]}, {"verse": 20, "start": 159067, "end": 165228, "text": "Y Ada parió a Jabal, el cual fue padre de los que habitan en tiendas, y crían ganados.", "words": [[0, 159067], [2, 159212], [6, 159352], [12, 159812], [14, 159932], [21, 160832], [24, 160912], [29, 161152], [33, 161452], [39, 161932], [42, 162172], [46, 162292], [50, 162452], [58, 162872], [61, 163012], [70, 163692], [72, 163972], [78, 164372]]}, {"verse": 21, "start": 165578, "end": 173055, "text": "Y el nombre de su hermano fue Jubal, el cual fue padre de todos los que manejan arpa y órgano.", "words": [[0, 165578], [2, 165739], [5, 165899], [12, 166319], [15, 166519], [18, 166699], [26, 167199], [30, 167339], [37, 168419], [40, 168539], [45, 168739], [49, 169019], [55, 169499], [58, 169919], [64, 170299], [68, 170859], [72, 171019], [80, 171579], [85, 172179], [87, 172399]]}, {"verse": 22, "start": 173405, "end": 182120, "text": "Y Zila también parió a Tubal-caín, artífice de toda obra de bronce y de hierro: y la hermana de Tubal-caín fue Naama.", "words": [[0, 173544], [2, 173718], [7, 173891], [15, 174351], [21, 174811], [23, 174931], [35, 176171], [44, 176971], [47, 177171], [52, 177391], [57, 177691], [60, 177891], [67, 178351], [69, 178451], [72, 178511], [80, 179493], [82, 179663], [85, 179783], [93, 180183], [96, 180603], [107, 181023], [111, 181597]]}, {"verse": 23, "start": 182470, "end": 192276, "text": "Y dijo Lamec a sus mujeres: Ada y Zila, oíd mi voz; mujeres de Lamec, escuchad mi dicho: que varón mataré por mi herida, y joven por mi golpe:", "words": [[0, 182470], [2, 182599], [7, 183169], [13, 183739], [15, 183899], [19, 184039], [28, 185182], [32, 185322], [34, 185572], [40, 185822], [44, 186082], [47, 186202], [52, 186906], [60, 187285], [63, 187705], [70, 188125], [79, 188605], [82, 188725], [89, 189390], [93, 189487], [99, 189767], [106, 190127], [110, 190307], [113, 190467], [121, 190827], [123, 191127], [129, 191467], [133, 191647], [136, 191747]]}, {"verse": 24, "start": 192626, "end": 197683, "text": "Si siete veces será vengado Caín, Lamec en verdad setenta veces siete lo será.", "words": [[0, 192727], [3, 192833], [9, 192940], [15, 193340], [20, 193680], [28, 194180], [34, 194770], [40, 195360], [43, 195440], [50, 195880], [58, 196320], [64, 196670], [70, 197020], [73, 197260]]}, {"verse": 25, "start": 197963, "end": 211875, "text": "Y conoció de nuevo Adam a su mujer, la cual parió un hijo, y llamó su nombre Set: Porque Dios ( dijo ella ) me ha sustituido otra simiente en lugar de Abel, a quien mató Caín.", "words": [[0, 197963], [2, 198085], [10, 198705], [13, 198845], [19, 198945], [24, 199045], [26, 199605], [29, 199785], [36, 200725], [39, 200965], [44, 201165], [50, 201585], [53, 201825], [59, 202145], [61, 202400], [67, 202760], [70, 202940], [77, 203445], [82, 204282], [89, 204462], [94, 205565], [96, 205777], [101, 205990], [106, 206202], [108, 206581], [111, 206741], [114, 206881], [125, 207841], [130, 208141], [139, 208881], [142, 209141], [148, 209381], [151, 209661], [157, 210481], [159, 210581], [165, 210721], [170, 211121]]}, {"verse": 26, "start": 212155, "end": 221279, "text": "Y a Set también le nació un hijo, y llamó su nombre Enós. Entonces los hombres comenzaron a invocar el nombre de Jehová.", "words": [[0, 212155], [2, 212324], [4, 212530], [8, 212737], [16, 213337], [19, 213557], [25, 213957], [28, 214197], [34, 214477], [36, 214712], [42, 215052], [45, 215212], [52, 215612], [58, 216664], [67, 217668], [71, 217848], [79, 218228], [90, 219008], [92, 219288], [100, 219888], [103, 220068], [110, 220468], [113, 220668]]}]}