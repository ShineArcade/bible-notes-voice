{"book": "ROM", "chapter": 4, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 171368, "verses": [{"verse": 1, "start": 300, "end": 4709, "text": "What shall we say then that Abraham our father, as pertaining to the flesh, has found?", "words": [[0, 300], [5, 472], [11, 672], [14, 812], [18, 1052], [23, 1252], [28, 1432], [36, 1792], [40, 2112], [48, 2712], [51, 2852], [62, 3272], [65, 3532], [69, 3632], [76, 4093], [80, 4192]]}, {"verse": 2, "start": 5159, "end": 10312, "text": "For if Abraham were justified by works, he has something to boast about; but not before God.", "words": [[0, 5159], [4, 5266], [7, 5406], [15, 5786], [20, 6006], [30, 6366], [33, 6766], [40, 7346], [43, 7546], [47, 7686], [57, 7986], [60, 8146], [66, 8386], [73, 9152], [77, 9272], [81, 9452], [88, 9812]]}, {"verse": 3, "start": 10762, "end": 15286, "text": "For what says the scripture? Abraham believed God, and it was counted to him for righteousness.", "words": [[0, 10762], [4, 10910], [9, 11064], [14, 11217], [18, 11317], [29, 12215], [37, 12562], [46, 12922], [51, 13242], [55, 13522], [58, 13622], [62, 13742], [70, 14082], [73, 14302], [77, 14422], [81, 14562]]}, {"verse": 4, "start": 15736, "end": 19379, "text": "Now to him that works is the reward not reckoned of grace, but of debt.", "words": [[0, 15736], [4, 15934], [7, 16093], [11, 16234], [16, 16374], [22, 16654], [25, 16894], [29, 17014], [36, 17314], [40, 17514], [49, 17974], [52, 18054], [59, 18694], [63, 18854], [66, 18974]]}, {"verse": 5, "start": 19829, "end": 26146, "text": "But to him that works not, but believes on him that justifies the ungodly, his faith is counted for righteousness.", "words": [[0, 19829], [4, 19947], [7, 20067], [11, 20307], [16, 20507], [22, 20787], [27, 21467], [31, 21607], [40, 21887], [43, 22107], [47, 22307], [52, 22487], [62, 23067], [66, 23267], [75, 24227], [79, 24347], [85, 24607], [88, 24767], [96, 25067], [100, 25327]]}, {"verse": 6, "start": 26596, "end": 32330, "text": "Even as David also describes the blessedness of the man, to whom God imputes righteousness without works,", "words": [[0, 26596], [5, 26814], [8, 27054], [14, 27414], [19, 27774], [29, 28214], [33, 28474], [45, 29054], [48, 29214], [52, 29354], [57, 29614], [60, 30014], [65, 30174], [69, 30394], [77, 30814], [91, 31294], [99, 31734]]}, {"verse": 7, "start": 32780, "end": 37238, "text": "Saying, Blessed are they whose iniquities are forgiven, and whose sins are covered.", "words": [[0, 32780], [8, 33650], [16, 33968], [20, 34268], [25, 34428], [31, 34588], [42, 35168], [46, 35308], [56, 35688], [60, 36108], [66, 36248], [71, 36528], [75, 36728]]}, {"verse": 8, "start": 37688, "end": 40573, "text": "Blessed is the man to whom the Lord will not impute sin.", "words": [[0, 37688], [8, 37884], [11, 38184], [15, 38344], [19, 38544], [22, 38724], [27, 38864], [31, 39004], [36, 39244], [41, 39444], [45, 39624], [52, 40124]]}, {"verse": 9, "start": 41023, "end": 49410, "text": "Comes this blessedness then upon the circumcision only, or upon the uncircumcision also? for we say that faith was reckoned to Abraham for righteousness.", "words": [[0, 41023], [6, 41184], [11, 41404], [23, 42024], [28, 42264], [33, 42524], [37, 42704], [50, 43284], [56, 43684], [59, 44184], [64, 44444], [68, 44564], [83, 45324], [89, 46250], [93, 46356], [96, 46456], [100, 46676], [105, 46856], [111, 47076], [115, 47296], [124, 47716], [127, 47836], [135, 48256], [139, 48576]]}, {"verse": 10, "start": 49860, "end": 56884, "text": "How was it then reckoned? when he was in circumcision, or in uncircumcision? Not in circumcision, but in uncircumcision.", "words": [[0, 49860], [4, 49987], [8, 50167], [11, 50307], [16, 50467], [26, 51268], [31, 51408], [34, 51528], [38, 51688], [41, 51828], [55, 52428], [58, 52948], [61, 53108], [77, 54518], [81, 54735], [84, 54935], [98, 55735], [102, 55815], [105, 55955]]}, {"verse": 11, "start": 57334, "end": 70311, "text": "And he received the sign of circumcision, a seal of the righteousness of the faith which he had yet being uncircumcised: that he might be the father of all them that believe, though they be not circumcised; that righteousness might be imputed to them also:", "words": [[0, 57334], [4, 57451], [7, 57531], [16, 57871], [20, 58051], [25, 58271], [28, 58351], [42, 59291], [44, 59471], [49, 59751], [52, 60031], [56, 60151], [70, 60451], [73, 60871], [77, 60991], [83, 61251], [89, 61631], [92, 61871], [96, 62071], [100, 62251], [106, 62491], [121, 63613], [126, 63803], [129, 63883], [135, 64043], [138, 64203], [142, 64323], [149, 64543], [152, 64763], [156, 65063], [161, 65343], [166, 65583], [175, 66223], [182, 66383], [187, 66543], [190, 66643], [194, 66823], [207, 67904], [212, 68021], [226, 68461], [232, 68861], [235, 69041], [243, 69461], [246, 69641], [251, 69781]]}, {"verse": 12, "start": 70761, "end": 80818, "text": "And the father of circumcision to them who are not of the circumcision only, but who also walk in the steps of that faith of our father Abraham, which he had being yet uncircumcised.", "words": [[0, 70761], [4, 70864], [8, 70965], [15, 71224], [18, 71444], [31, 72145], [34, 72385], [39, 72605], [43, 72785], [47, 72885], [51, 73105], [54, 73364], [58, 73504], [71, 74125], [77, 74804], [81, 75065], [85, 75224], [90, 75504], [95, 75785], [98, 75944], [102, 76065], [108, 76325], [111, 76504], [116, 76664], [122, 76925], [125, 77125], [129, 77245], [136, 77664], [145, 78567], [151, 78708], [154, 78868], [158, 79028], [164, 79308], [168, 79608]]}, {"verse": 13, "start": 81268, "end": 88761, "text": "For the promise, that he should be the heir of the world, was not to Abraham, or to his seed, through the law, but through the righteousness of faith.", "words": [[0, 81268], [4, 81351], [8, 81471], [17, 81791], [22, 82031], [25, 82131], [32, 82371], [35, 82551], [39, 82691], [44, 82971], [47, 83111], [51, 83231], [58, 83571], [62, 84031], [66, 84291], [69, 84451], [78, 84891], [81, 85451], [84, 85591], [88, 85731], [94, 86071], [102, 86491], [106, 86631], [111, 86911], [115, 87271], [123, 87471], [127, 87591], [141, 88011], [144, 88371]]}, {"verse": 14, "start": 89211, "end": 94578, "text": "For if they which are of the law be heirs, faith is made void, and the promise made of none effect:", "words": [[0, 89211], [4, 89358], [7, 89518], [12, 90058], [18, 90218], [22, 90398], [25, 90538], [29, 90798], [33, 91058], [36, 91318], [43, 91578], [49, 91818], [52, 92038], [57, 92238], [63, 92538], [67, 92998], [71, 93098], [79, 93358], [84, 93698], [87, 93868], [92, 94038]]}, {"verse": 15, "start": 95028, "end": 99545, "text": "Because the law works wrath: for where no law is, there is no transgression.", "words": [[0, 95028], [8, 95170], [12, 95350], [16, 95530], [22, 95890], [29, 96630], [33, 96755], [39, 96955], [42, 97175], [46, 97435], [50, 98075], [56, 98235], [59, 98475], [62, 98675]]}, {"verse": 16, "start": 99995, "end": 113035, "text": "Therefore it is of faith, that it might be by grace; to the end the promise might be sure to all the seed; not to that only which is of the law, but to that also which is of the faith of Abraham; who is the father of us all,", "words": [[0, 99995], [10, 100317], [13, 100597], [16, 100737], [19, 100877], [26, 101137], [31, 101597], [34, 101717], [40, 101897], [43, 102177], [46, 102477], [53, 103438], [56, 103536], [60, 103676], [64, 103856], [68, 103976], [76, 104296], [82, 104576], [85, 104756], [90, 104996], [93, 105156], [97, 105416], [101, 105576], [107, 106313], [111, 106530], [114, 106710], [119, 106890], [124, 107190], [130, 107450], [133, 107570], [136, 107690], [140, 107810], [145, 108370], [149, 108650], [152, 108810], [157, 109030], [162, 109390], [168, 109690], [171, 109810], [174, 109930], [178, 110030], [184, 110270], [187, 110450], [196, 111492], [200, 111637], [203, 111777], [207, 111937], [214, 112257], [217, 112437], [220, 112577]]}, {"verse": 17, "start": 113485, "end": 124418, "text": "(As it is written, I have made you a father of many nations,) before him whom he believed, even God, who gives life to the dead, and calls those things which be not as though they were.", "words": [[0, 113485], [4, 113668], [7, 113768], [10, 113908], [19, 114692], [21, 114837], [26, 114997], [31, 115197], [35, 115357], [37, 115417], [44, 115697], [47, 115937], [52, 116137], [60, 117464], [62, 117464], [69, 117740], [73, 118020], [78, 118200], [81, 118380], [91, 119180], [96, 119380], [101, 120180], [105, 120340], [111, 120560], [116, 120860], [119, 121080], [123, 121200], [129, 121480], [133, 121840], [139, 122140], [145, 122380], [152, 122700], [158, 122900], [161, 123080], [165, 123320], [168, 123620], [175, 123800], [180, 123980]]}, {"verse": 18, "start": 124868, "end": 132874, "text": "Who against hope believed in hope, that he might become the father of many nations; according to that which was spoken, So shall your seed be.", "words": [[0, 124868], [4, 124985], [12, 125305], [17, 125625], [26, 125965], [29, 126245], [35, 126505], [40, 126985], [43, 127125], [49, 127305], [56, 127605], [60, 127745], [67, 127965], [70, 128165], [75, 128385], [84, 129298], [94, 129605], [97, 129825], [102, 130045], [108, 130245], [112, 130405], [120, 131218], [123, 131370], [129, 131610], [134, 131790], [139, 132070]]}, {"verse": 19, "start": 133174, "end": 141196, "text": "And being not weak in faith, he considered not his own body now dead, when he was about a hundred years old, neither yet the deadness of Sara’s womb:", "words": [[0, 133174], [4, 133301], [10, 133541], [14, 133801], [19, 134081], [22, 134261], [29, 134941], [32, 135081], [43, 135501], [47, 135721], [51, 135901], [55, 136041], [60, 136361], [64, 136641], [70, 137261], [75, 137441], [78, 137541], [82, 137681], [88, 137901], [90, 138041], [98, 138281], [104, 138541], [109, 139181], [117, 139401], [121, 139701], [125, 139841], [134, 140261], [137, 140541], [144, 140821]]}, {"verse": 20, "start": 141646, "end": 146759, "text": "He wavered not at the promise of God through unbelief; but was strong in faith, giving glory to God;", "words": [[0, 141646], [3, 141742], [11, 142302], [15, 142402], [18, 142582], [22, 142682], [30, 142982], [33, 143202], [37, 143412], [45, 143622], [55, 144484], [59, 144583], [63, 144703], [70, 145023], [73, 145203], [80, 145683], [87, 145803], [93, 146163], [96, 146363]]}, {"verse": 21, "start": 147209, "end": 152474, "text": "And being fully persuaded that, what he had promised, he was able also to perform.", "words": [[0, 147209], [4, 147334], [10, 147494], [16, 147774], [26, 148154], [32, 148874], [37, 149014], [40, 149174], [44, 149274], [54, 149974], [57, 150074], [61, 150234], [66, 150474], [71, 150874], [74, 151054]]}, {"verse": 22, "start": 152924, "end": 155482, "text": "And therefore it was imputed to him for righteousness.", "words": [[0, 152924], [4, 153042], [14, 153382], [17, 153622], [21, 153762], [29, 154182], [32, 154342], [36, 154522], [40, 154702]]}, {"verse": 23, "start": 155932, "end": 159718, "text": "Now it was not written for his sake alone, that it was imputed to him;", "words": [[0, 155932], [4, 156293], [7, 156573], [11, 156713], [15, 156893], [23, 157173], [27, 157373], [31, 157533], [36, 157753], [43, 158033], [48, 158533], [51, 158633], [55, 158793], [63, 159213], [66, 159393]]}, {"verse": 24, "start": 160168, "end": 166228, "text": "But for us also, to whom it shall be imputed, if we believe on him that raised up Jesus our Lord from the dead;", "words": [[0, 160168], [4, 160287], [8, 160467], [11, 160707], [17, 161167], [20, 161367], [25, 161587], [28, 161687], [34, 161827], [37, 162027], [46, 162447], [49, 162647], [52, 162787], [60, 163067], [63, 163267], [67, 163427], [72, 163607], [79, 163887], [82, 164067], [88, 164347], [92, 164667], [97, 164887], [102, 165127], [106, 165247]]}, {"verse": 25, "start": 166678, "end": 170968, "text": "Who was delivered for our offences, and was raised again for our justification.", "words": [[0, 166678], [4, 166798], [8, 166978], [18, 167358], [22, 167618], [26, 167908], [36, 168198], [40, 168798], [44, 168998], [51, 169298], [57, 169698], [61, 169958], [65, 170098]]}]}