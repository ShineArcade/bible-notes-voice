{"book": "GEN", "chapter": 11, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 209029, "verses": [{"verse": 1, "start": 300, "end": 3741, "text": "And the whole earth was of one language, and of one speech.", "words": [[0, 300], [4, 433], [8, 553], [14, 793], [20, 1093], [24, 1333], [27, 1493], [31, 1733], [41, 2193], [45, 2733], [48, 2873], [52, 3053]]}, {"verse": 2, "start": 4191, "end": 11006, "text": "And it came to pass, as they journeyed from the east, that they found a plain in the land of Shinar; and they dwelt there.", "words": [[0, 4191], [4, 4316], [7, 4436], [12, 4616], [15, 4796], [21, 5256], [24, 5616], [29, 5776], [39, 6256], [44, 6396], [48, 6536], [54, 6916], [59, 7496], [64, 7636], [70, 7876], [72, 8076], [78, 8276], [81, 8516], [85, 8616], [90, 8856], [93, 8956], [101, 9963], [105, 10084], [110, 10204], [116, 10544]]}, {"verse": 3, "start": 11456, "end": 19326, "text": "And they said one to another, Go to, let us make brick, and burn them thoroughly. And they had brick for stone, and tar had they for mortar.", "words": [[0, 11456], [4, 11586], [9, 11686], [14, 11906], [18, 12186], [21, 12406], [30, 13251], [33, 13395], [37, 13575], [41, 13755], [44, 13895], [49, 14095], [56, 14395], [60, 14915], [65, 15215], [70, 15495], [82, 16443], [86, 16579], [91, 16679], [95, 16819], [101, 17039], [105, 17279], [112, 17619], [116, 17879], [120, 18199], [124, 18499], [129, 18659], [133, 18819]]}, {"verse": 4, "start": 19776, "end": 29266, "text": "And they said, Go to, let us build us a city and a tower, whose top may reach to heaven; and let us make us a name, lest we be scattered abroad upon the face of the whole earth.", "words": [[0, 19776], [4, 20116], [9, 20256], [15, 20913], [18, 21032], [22, 21192], [26, 21352], [29, 21492], [35, 21692], [38, 21892], [40, 22052], [45, 22232], [49, 22372], [51, 22472], [58, 23012], [64, 23252], [68, 23552], [72, 23792], [78, 24072], [81, 24232], [89, 24946], [93, 25046], [97, 25186], [100, 25326], [105, 25546], [108, 25746], [110, 25866], [116, 26446], [121, 26666], [124, 26806], [127, 26926], [137, 27226], [144, 27706], [149, 28066], [153, 28206], [158, 28406], [161, 28586], [165, 28706], [171, 28906]]}, {"verse": 5, "start": 29616, "end": 34183, "text": "And the LORD came down to see the city and the tower, which the children of men built.", "words": [[0, 29616], [4, 29766], [8, 29866], [13, 30066], [18, 30326], [23, 30606], [26, 30786], [30, 30926], [34, 31106], [39, 31366], [43, 31566], [47, 31666], [54, 32326], [60, 32666], [64, 32866], [73, 33206], [76, 33426], [80, 33626]]}, {"verse": 6, "start": 34633, "end": 45939, "text": "And the LORD said, Behold, the people is one, and they have all one language; and this they begin to do: and now nothing will be restrained from them, which they have imagined to do.", "words": [[0, 34633], [4, 34772], [8, 34872], [13, 35112], [19, 35816], [27, 36287], [31, 36327], [38, 36587], [41, 36787], [46, 37067], [50, 37607], [55, 37747], [60, 37927], [64, 38187], [68, 38447], [78, 39706], [82, 39845], [87, 40065], [92, 40245], [98, 40525], [101, 40725], [105, 41839], [109, 41967], [113, 42147], [121, 42467], [126, 42727], [129, 42867], [140, 43407], [145, 43547], [151, 44107], [157, 44287], [162, 44487], [167, 44647], [176, 45047], [179, 45307]]}, {"verse": 7, "start": 46389, "end": 52419, "text": "Go to, let us go down, and there confound their language, that they may not understand one another’s speech.", "words": [[0, 46389], [3, 46612], [7, 46792], [11, 46992], [14, 47152], [17, 47332], [23, 48192], [27, 48292], [33, 48392], [42, 48912], [48, 49072], [58, 49492], [63, 49852], [68, 49992], [72, 50152], [76, 50352], [87, 50892], [91, 51152], [101, 51632]]}, {"verse": 8, "start": 52769, "end": 58351, "text": "So the LORD scattered them abroad from there upon the face of all the earth: and they left off to build the city.", "words": [[0, 52769], [3, 52898], [7, 53058], [12, 53258], [22, 53678], [27, 53898], [3