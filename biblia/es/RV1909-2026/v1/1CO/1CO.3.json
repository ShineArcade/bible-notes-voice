[34, 126096], [37, 126436], [45, 126776], [50, 126976], [54, 127176], [60, 127972], [65, 128119], [73, 128479], [79, 129306], [82, 129430], [86, 129550], [93, 129760], [95, 129970], [99, 130090], [106, 130550], [109, 130690], [112, 130810], [120, 131230], [123, 131410]]}, {"verse": 20, "start": 132392, "end": 136843, "text": "Y otra vez: El Señor conoce los pensamientos de los sabios, que son vanos.", "words": [[0, 132392], [2, 132518], [7, 132698], [12, 133533], [15, 133631], [21, 133891], [28, 134371], [32, 134491], [45, 135151], [48, 135311], [52, 135431], [60, 135891], [64, 136051], [68, 136231]]}, {"verse": 21, "start": 137293, "end": 141272, "text": "Así que, ninguno se gloríe en los hombres; porque todo es vuestro;", "words": [[0, 137293], [4, 137673], [9, 137813], [17, 138293], [20, 138573], [27, 138853], [30, 138933], [34, 139053], [43, 139971], [50, 140179], [55, 140419], [58, 140639]]}, {"verse": 22, "start": 141722, "end": 151192, "text": "Sea Pablo, sea Apolos, sea Cefas, sea el mundo, sea la vida, sea la muerte, sea lo presente, sea lo por venir; todo es vuestro;", "words": [[0, 141722], [4, 141941], [11, 142641], [15, 142841], [23, 143741], [27, 144251], [34, 144761], [38, 144921], [41, 145081], [48, 145761], [52, 145941], [55, 146101], [61, 146741], [65, 146881], [68, 147041], [76, 147821], [80, 147961], [83, 148101], [93, 149041], [97, 149221], [100, 149498], [104, 149774], [111, 150351], [116, 150510], [119, 150670]]}, {"verse": 23, "start": 151642, "end": 155087, "text": "Y vosotros de Cristo; y Cristo de Dios.", "words": [[0, 151642], [2, 151765], [11, 152225], [14, 152465], [22, 153271], [24, 153397], [31, 153817], [34, 154017]]}]}