{"book": "PSA", "chapter": 78, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 415848, "verses": [{"verse": 1, "start": 300, "end": 5197, "text": "Give ear, O my people, to my law: incline your ears to the words of my mouth.", "words": [[0, 300], [5, 439], [10, 839], [12, 899], [15, 1099], [23, 1719], [26, 1819], [29, 2019], [34, 2771], [42, 3220], [47, 3400], [52, 3680], [55, 3920], [59, 4040], [65, 4280], [68, 4460], [71, 4640]]}, {"verse": 2, "start": 5647, "end": 10054, "text": "I will open my mouth in a parable: I will utter dark sayings of old:", "words": [[0, 5647], [2, 5769], [7, 5929], [12, 6189], [15, 6409], [21, 6709], [24, 6869], [26, 6969], [35, 7884], [37, 8144], [42, 8304], [48, 8564], [53, 8884], [61, 9424], [64, 9544]]}, {"verse": 3, "start": 10504, "end": 13868, "text": "Which we have heard and known, and our fathers have told us.", "words": [[0, 10504], [6, 10650], [9, 10810], [14, 10990], [20, 11270], [24, 11530], [31, 12210], [35, 12470], [39, 12610], [47, 12930], [52, 13190], [57, 13430]]}, {"verse": 4, "start": 14318, "end": 23130, "text": "We will not hide them from their children, showing to the generation to come the praises of the LORD, and his strength, and his wonderful works that he has done.", "words": [[0, 14318], [3, 14418], [8, 14558], [12, 14758], [17, 15078], [22, 15318], [27, 15538], [33, 15718], [43, 16418], [51, 16758], [54, 16998], [58, 17098], [69, 17678], [72, 17918], [77, 18158], [81, 18298], [89, 18738], [92, 18958], [96, 19078], [102, 19918], [106, 20098], [110, 20238], [120, 20638], [124, 21038], [128, 21178], [138, 21558], [144, 21978], [149, 22238], [152, 22398], [156, 22578]]}, {"verse": 5, "start": 23580, "end": 32864, "text": "For he established a testimony in Jacob, and appointed a law in Israel, which he commanded our fathers, that they should make them known to their children:", "words": [[0, 23580], [4, 23708], [7, 23928], [19, 24568], [21, 24748], [31, 25268], [34, 25588], [41, 26528], [45, 26708], [55, 27148], [57, 27348], [61, 27628], [64, 27888], [72, 28708], [78, 28908], [81, 29028], [91, 29468], [95, 29688], [104, 30668], [109, 30828], [114, 30988], [121, 31148], [126, 31388], [131, 31608], [137, 31888], [140, 32088], [146, 32248]]}, {"verse": 6, "start": 33314, "end": 41058, "text": "That the generation to come might know them, even the children which should be born; who should arise and declare them to their children:", "words": [[0, 33314], [5, 33478], [9, 33618], [20, 34198], [23, 34458], [28, 34778], [34, 35098], [39, 35418], [45, 36038], [50, 36338], [54, 36558], [63, 36938], [69, 37198], [76, 37418], [79, 37578], [85, 38484], [89, 38586], [96, 38786], [102, 39186], [106, 39446], [114, 39786], [119, 40066], [122, 40226], [128, 40386]]}, {"verse": 7, "start": 41508, "end": 47095, "text": "That they might set their hope in God, and not forget the works of God, but keep his commandments:", "words": [[0, 41508], [5, 41648], [10, 41768], [16, 41988], [20, 42268], [26, 42488], [31, 42728], [34, 42888], [39, 43208], [43, 43568], [47, 43768], [54, 44128], [58, 44348], [64, 44628], [67, 44808], [72, 45548], [76, 45648], [81, 45888], [85, 46128]]}, {"verse": 8, "start": 47545, "end": 57443, "text": "And might not be as their fathers, a stubborn and rebellious generation; a generation that set not their heart aright, and whose spirit was not steadfast with God.", "words": [[0, 47545], [4, 47683], [10, 47843], [14, 48063], [17, 48303], [20, 48443], [26, 48603], [35, 49503], [37, 49603], [46, 50023], [50, 50343], [61, 51003], [73, 52097], [75, 52203], [86, 52663], [91, 53143], [95, 53423], [99, 53703], [105, 53983], [111, 54303], [119, 54623], [123, 54923], [129, 55083], [136, 55523], [140, 55803], [144, 56003], [154, 56703], [159, 56943]]}, {"verse": 9, "start": 57893, "end": 63273, "text": "The children of Ephraim, being armed, and carrying bows, turned back in the day of battle.", "words": [[0, 57893], [4, 58205], [13, 58605], [16, 58825], [25, 59345], [31, 59625], [38, 60145], [42, 60365], [51, 60745], [57, 61185], [64, 61765], [69, 62125], [72, 62345], [76, 62445], [80, 62665], [83, 62765]]}, {"verse": 10, "start": 63723, "end": 67994, "text": "They kept not the covenant of God, and refused to walk in his law;", "words": [[0, 63723], [5, 63866], [10, 64126], [14, 64486], [18, 64706], [27, 65046], [30, 65306], [35, 65626], [39, 66146], [47, 66506], [50, 66846], [55, 67106], [58, 67286], [62, 67426]]}, {"verse": 11, "start": 68444, "end": 71852, "text": "And forgot his works, and his wonders that he had showed them.", "words": [[0, 68444], [4, 68550], [11, 68850], [15, 69090], [22, 69450], [26, 70070], [30, 70230], [38, 70610], [43, 70930], [46, 71070], [50, 71170], [57, 71450]]}, {"verse": 12, "start": 72302, "end": 77620, "text": "Marvellous things did he in the sight of their fathers, in the land of Egypt, in the field of Zoan.", "words": [[0, 72530], [11, 72790], [18, 73010], [22, 73330], [25, 73510], [28, 73690], [32, 73770], [38, 74030], [41, 74130], [47, 74290], [56, 74710], [59, 75350], [63, 75450], [68, 75670], [71, 75830], [78, 76050], [81, 76470], [85, 76570], [91, 76810], [94, 77238]]}, {"verse": 13, "start": 78070, "end": 83349, "text": "He divided the sea, and caused them to pass through; and he made the waters to stand as a heap.", "words": [[0, 78070], [3, 78161], [11, 78581], [15, 78761], [20, 79041], [24, 79281], [31, 79621], [36, 79841], [39, 79981], [44, 80221], [53, 81036], [57, 81169], [60, 81289], [65, 81529], [69, 81689], [76, 82009], [79, 82269], [85, 82609], [88, 82809], [90, 82909]]}, {"verse": 14, "start": 83799, "end": 88745, "text": "In the daytime also he led them with a cloud, and all the night with a light of fire.", "words": [[0, 83799], [3, 83925], [7, 84025], [15, 84385], [20, 84965], [23, 85305], [27, 85505], [32, 85685], [37, 85845], [39, 85945], [46, 86365], [50, 86825], [54, 87065], [58, 87205], [64, 87465], [69, 87785], [71, 87885], [77, 88065], [80, 88205]]}, {"verse": 15, "start": 89195, "end": 93696, "text": "He split the rocks in the wilderness, and gave them drink as out of the great depths.", "words": [[0, 89195], [3, 89267], [9, 89487], [13, 89667], [19, 89987], [22, 90167], [26, 90267], [38, 90707], [42, 91367], [47, 91587], [52, 91807], [58, 92107], [61, 92367], [65, 92527], [68, 92647], [72, 92747], [78, 92987]]}, {"verse": 16, "start": 94146, "end": 98776, "text": "He brought streams also out of the rock, and caused waters to run down like rivers.", "words": [[0, 94146], [3, 94210], [11, 94430], [19, 94810], [24, 95230], [28, 95490], [31, 95590], [35, 95690], [41, 96010], [45, 96430], [52, 96730], [59, 97150], [62, 97410], [66, 97630], [71, 97890], [76, 98130]]}, {"verse": 17, "start": 99226, "end": 103656, "text": "And they sinned yet more against him by provoking the most High in the wilderness.", "words": [[0, 99226], [4, 99379], [9, 99519], [16, 100019], [20, 100159], [25, 100479], [33, 100879], [37, 101139], [40, 101379], [50, 101939], [54, 102139], [59, 102339], [64, 102699], [67, 102839], [71, 102939]]}, {"verse": 18, "start": 104106, "end": 107630, "text": "And they tempted God in their heart by asking food for their lust.", "words": [[0, 104106], [4, 104230], [9, 104350], [17, 104690], [21, 105090], [24, 105310], [30, 105430], [36, 105710], [39, 105950], [46, 106270], [51, 106710], [55, 106930], [61, 107090]]}, {"verse": 19, "start": 108080, "end": 114510, "text": "Yes, they spoke against God; they said, Can God furnish a table in the wilderness?", "words": [[0, 108080], [5, 108545], [10, 108665], [16, 108945], [24, 109325], [29, 110326], [34, 110484], [40, 112086], [44, 112242], [48, 112602], [56, 113062], [58, 113142], [64, 113442], [67, 113602], [71, 113702]]}, {"verse": 20, "start": 114960, "end": 122702, "text": "Behold, he struck the rock, that the waters gushed out, and the streams overflowed; can he give bread also? can he provide flesh for his people?", "words": [[0, 114960], [8, 115419], [11, 115479], [18, 115739], [22, 115919], [28, 116219], [33, 116619], [37, 116739], [44, 117019], [51, 117439], [56, 117559], [60, 117759], [64, 117879], [72, 118179], [84, 119306], [88, 119444], [91, 119544], [96, 119724], [102, 120024], [108, 120944], [112, 121081], [115, 121161], [123, 121441], [129, 121821], [133, 122081], [137, 122221]]}, {"verse": 21, "start": 123052, "end": 130858, "text": "Therefore the LORD heard this, and was angry: so a fire was kindled against Jacob, and anger also came up against Israel;", "words": [[0, 123052], [10, 123371], [14, 123611], [19, 123891], [25, 124251], [31, 124571], [35, 125071], [39, 125231], [46, 126132], [49, 126300], [51, 126460], [56, 126700], [60, 126960], [68, 127400], [76, 127660], [83, 128560], [87, 128640], [93, 128960], [98, 129340], [103, 129640], [106, 129820], [114, 130160]]}, {"verse": 22, "start": 131308, "end": 136052, "text": "Because they believed not in God, and trusted not in his salvation:", "words": [[0, 131308], [8, 131667], [13, 131947], [22, 132467], [26, 132847], [29, 133127], [34, 133507], [38, 134067], [46, 134487], [50, 134867], [53, 135107], [57, 135267]]}, {"verse": 23, "start": 136502, "end": 140929, "text": "Though he had commanded the clouds from above, and opened the doors of heaven,", "words": [[0, 136502], [7, 136707], [10, 136907], [14, 137067], [24, 137507], [28, 137707], [35, 138107], [40, 138307], [47, 138747], [51, 139327], [58, 139667], [62, 139887], [68, 140187], [71, 140407]]}, {"verse": 24, "start": 141379, "end": 146349, "text": "And had rained down manna upon them to eat, and had given them of the grain of heaven.", "words": [[0, 141379], [4, 141503], [8, 141643], [15, 141963], [20, 142323], [26, 142843], [31, 143083], [36, 143403], [39, 143583], [44, 144163], [48, 144483], [52, 144623], [58, 144883], [63, 145123], [66, 145303], [70, 145443], [76, 145703], [79, 145903]]}, {"verse": 25, "start": 146799, "end": 150602, "text": "Man did eat angels’ food: he sent them food to the full.", "words": [[0, 146799], [4, 147019], [8, 147339], [12, 147659], [20, 148039], [26, 148975], [29, 149061], [34, 149281], [39, 149521], [44, 149761], [47, 149981], [51, 150101]]}, {"verse": 26, "start": 151052, "end": 156395, "text": "He caused an east wind to blow in the heaven: and by his power he brought in the south wind.", "words": [[0, 151052], [3, 151138], [10, 151478], [13, 151718], [18, 151998], [23, 152378], [26, 152578], [31, 152818], [34, 153018], [38, 153118], [46, 153898], [50, 154021], [53, 154201], [57, 154421], [63, 154801], [66, 155001], [74, 155261], [77, 155461], [81, 155561], [87, 155861]]}, {"verse": 27, "start": 156845, "end": 162171, "text": "He rained flesh also upon them as dust, and feathered fowls like as the sand of the sea:", "words": [[0, 156845], [3, 157055], [10, 157285], [16, 157565], [21, 157985], [26, 158325], [31, 158605], [34, 158745], [40, 159465], [44, 159685], [54, 160125], [60, 160605], [65, 160805], [68, 160985], [72, 161145], [77, 161445], [80, 161565], [84, 161705]]}, {"verse": 28, "start": 162621, "end": 166588, "text": "And he let it fall in the midst of their camp, round about their habitations.", "words": [[0, 162621], [4, 162978], [7, 163058], [11, 163218], [14, 163318], [19, 163578], [22, 163758], [26, 163838], [32, 164038], [35, 164238], [41, 164378], [47, 164978], [53, 165158], [59, 165458], [65, 165638]]}, {"verse": 29, "start": 167038, "end": 171454, "text": "So they did eat, and were well filled: for he gave them their own desire;", "words": [[0, 167038], [3, 167158], [8, 167318], [12, 167598], [17, 167838], [21, 168358], [26, 168538], [31, 168818], [39, 169702], [43, 169809], [46, 169969], [51, 170169], [56, 170369], [62, 170549], [66, 170729]]}, {"verse": 30, "start": 171904, "end": 176305, "text": "They were not estranged from their lust. But while their food was yet in their mouths,", "words": [[0, 171904], [5, 172001], [10, 172101], [14, 172281], [24, 172861], [29, 173041], [35, 173221], [41, 174101], [45, 174211], [51, 174411], [57, 174571], [62, 174891], [66, 175151], [70, 175331], [73, 175491], [79, 175611]]}, {"verse": 31, "start": 176755, "end": 183423, "text": "The wrath of God came upon them, and killed the fattest of them, and struck down the chosen men of Israel.", "words": [[0, 176755], [4, 176861], [10, 177121], [13, 177341], [17, 177681], [22, 178021], [27, 178401], [33, 179121], [37, 179221], [44, 179541], [48, 179801], [56, 180281], [59, 180441], [65, 181041], [69, 181141], [76, 181441], [81, 181821], [85, 182021], [92, 182341], [96, 182701], [99, 182881]]}, {"verse": 32, "start": 183873, "end": 188803, "text": "For all this they sinned still, and believed not for his wondrous works.", "words": [[0, 183873], [4, 183996], [8, 184256], [13, 184576], [18, 184976], [25, 185376], [32, 186396], [36, 186606], [45, 186816], [49, 187196], [53, 187436], [57, 187616], [66, 188176]]}, {"verse": 33, "start": 189253, "end": 193609, "text": "Therefore their days did he consume in vanity, and their years in trouble.", "words": [[0, 189253], [10, 189857], [16, 190017], [21, 190357], [25, 190577], [28, 190737], [36, 191157], [39, 191357], [47, 191757], [51, 192397], [57, 192577], [63, 192897], [66, 193137]]}, {"verse": 34, "start": 194059, "end": 199352, "text": "When he killed them, then they sought him: and they returned and enquired early after God.", "words": [[0, 194059], [5, 194195], [8, 194335], [15, 194615], [21, 195115], [26, 195375], [31, 195555], [38, 195815], [43, 196478], [47, 196622], [52, 196742], [61, 197222], [65, 197632], [74, 198042], [80, 198362], [86, 198762]]}, {"verse": 35, "start": 199802, "end": 203979, "text": "And they remembered that God was their rock, and the high God their redeemer.", "words": [[0, 199802], [4, 199953], [9, 200073], [20, 200453], [25, 200733], [29, 201013], [33, 201253], [39, 201473], [45, 202133], [49, 202473], [53, 202633], [58, 202833], [62, 203073], [68, 203313]]}, {"verse": 36, "start": 204429, "end": 209186, "text": "Nevertheless they did flatter him with their mouth, and they lied to him with their tongues.", "words": [[0, 204429], [13, 205057], [18, 205217], [22, 205437], [30, 205777], [34, 206037], [39, 206177], [45, 206357], [52, 206977], [56, 207317], [61, 207457], [66, 207737], [69, 207977], [73, 208137], [78, 208317], [84, 208477]]}, {"verse": 37, "start": 209636, "end": 213995, "text": "For their heart was not right with him, neither were they steadfast in his covenant.", "words": [[0, 209636], [4, 209728], [10, 209888], [16, 210188], [20, 210408], [24, 210628], [30, 210868], [35, 211128], [40, 211728], [48, 211988], [53, 212228], [58, 212408], [68, 213048], [71, 213288], [75, 213428]]}, {"verse": 38, "start": 214445, "end": 223515, "text": "But he, being full of compassion, forgave their iniquity, and destroyed them not: yes, many a time turned he his anger away, and did not stir up all his wrath.", "words": [[0, 214445], [4, 214549], [8, 214689], [14, 214949], [19, 215229], [22, 215349], [34, 215969], [42, 216629], [48, 216789], [58, 217349], [62, 217489], [72, 217849], [77, 218149], [82, 218925], [87, 219198], [92, 219318], [94, 219478], [99, 219778], [106, 220138], [109, 220418], [113, 220638], [119, 220938], [125, 221398], [129, 221718], [133, 221898], [137, 222058], [142, 222378], [145, 222618], [149, 222798], [153, 223018]]}, {"verse": 39, "start": 223965, "end": 229340, "text": "For he remembered that they were but flesh; a wind that passes away, and comes not again.", "words": [[0, 223965], [4, 224073], [7, 224213], [18, 224653], [23, 224893], [28, 225073], [33, 225193], [37, 225393], [44, 226408], [46, 226515], [51, 226815], [56, 227075], [63, 227495], [69, 227915], [73, 228135], [79, 228455], [83, 228735]]}, {"verse": 40, "start": 229790, "end": 233678, "text": "How often did they provoke him in the wilderness, and grieve him in the desert!", "words": [[0, 229790], [4, 229900], [10, 230260], [14, 230460], [19, 230580], [27, 230920], [31, 231160], [34, 231300], [38, 231380], [50, 231820], [54, 232420], [61, 232780], [65, 232880], [68, 233020], [72, 233100]]}, {"verse": 41, "start": 234128, "end": 238181, "text": "Yes, they turned back and tempted God, and limited the Holy One of Israel.", "words": [[0, 234128], [5, 234477], [10, 234577], [17, 234857], [22, 235157], [26, 235397], [34, 235717], [39, 236117], [43, 236477], [51, 236817], [55, 237037], [60, 237277], [64, 237517], [67, 237637]]}, {"verse": 42, "start": 238631, "end": 243185, "text": "They remembered not his hand, nor the day when he delivered them from the enemy.", "words": [[0, 238631], [5, 238739], [16, 239139], [20, 239499], [24, 239739], [30, 240579], [34, 240819], [38, 241019], [42, 241259], [47, 241499], [50, 241619], [60, 241979], [65, 242279], [70, 242459], [74, 242659]]}, {"verse": 43, "start": 243635, "end": 248273, "text": "How he had wrought his signs in Egypt, and his wonders in the field of Zoan:", "words": [[0, 243635], [4, 243822], [7, 244002], [11, 244162], [19, 244482], [23, 244622], [29, 244982], [32, 245202], [39, 245582], [43, 246162], [47, 246322], [55, 246682], [58, 247022], [62, 247102], [68, 247402], [71, 247872]]}, {"verse": 44, "start": 248723, "end": 253351, "text": "And had turned their rivers into blood; and their floods, that they could not drink.", "words": [[0, 248723], [4, 248849], [8, 248989], [15, 249289], [21, 249529], [28, 249889], [33, 250209], [40, 251089], [44, 251235], [50, 251395], [58, 251815], [63, 252375], [68, 252515], [74, 252675], [78, 252875]]}, {"verse": 45, "start": 253801, "end": 259462, "text": "He sent various sorts of flies among them, which devoured them; and frogs, which destroyed them.", "words": [[0, 253801], [3, 253902], [8, 254122], [16, 254462], [22, 254762], [25, 254962], [31, 255302], [37, 255642], [43, 256122], [49, 256382], [58, 256922], [64, 257566], [68, 257683], [75, 258403], [81, 258563], [91, 259023]]}, {"verse": 46, "start": 259912, "end": 264284, "text": "He gave also their increase to the caterpiller, and their labour to the locust.", "words": [[0, 259912], [3, 260025], [8, 260205], [13, 260605], [19, 260865], [28, 261285], [31, 261565], [35, 261935], [48, 262305], [52, 262825], [58, 263055], [65, 263285], [68, 263525], [72, 263645]]}, {"verse": 47, "start": 264734, "end": 269081, "text": "He destroyed their vines with hail, and their sycamore trees with frost.", "words": [[0, 264734], [3, 264837], [13, 265277], [19, 265557], [25, 266017], [30, 266177], [36, 266477], [40, 267017], [46, 267157], [55, 267717], [61, 268097], [66, 268377]]}, {"verse": 48, "start": 269531, "end": 274093, "text": "He gave up their cattle also to the hail, and their flocks to hot thunderbolts.", "words": [[0, 269531], [3, 269636], [8, 269876], [11, 270076], [17, 270256], [24, 270636], [29, 271036], [32, 271296], [36, 271456], [42, 271676], [46, 272216], [52, 272356], [59, 272836], [62, 272976], [66, 273176]]}, {"verse": 49, "start": 274543, "end": 282014, "text": "He cast upon them the fierceness of his anger, wrath, and indignation, and trouble, by sending evil angels among them.", "words": [[0, 274543], [3, 274655], [8, 275015], [13, 275315], [18, 275635], [22, 275795], [33, 276435], [36, 276555], [40, 276715], [47, 277475], [54, 278055], [58, 278095], [71, 278855], [75, 279095], [84, 279475], [87, 280015], [95, 280335], [100, 280715], [107, 281215], [113, 281555]]}, {"verse": 50, "start": 282464, "end": 288478, "text": "He made a way to his anger; he spared not their soul from death, but gave their life over to the pestilence;", "words": [[0, 282464], [3, 282563], [8, 282803], [10, 282923], [14, 283143], [17, 283363], [21, 283563], [28, 284397], [31, 284510], [38, 284910], [42, 285110], [48, 285350], [53, 285630], [58, 285850], [65, 286310], [69, 286410], [74, 286630], [80, 286830], [85, 287090], [90, 287390], [93, 287590], [97, 287690]]}, {"verse": 51, "start": 288928, "end": 294043, "text": "And struck all the firstborn in Egypt; the chief of their strength in the tabernacles of Ham:", "words": [[0, 288928], [4, 289037], [11, 289317], [15, 289577], [19, 289737], [29, 290317], [32, 290497], [39, 291437], [43, 291535], [49, 291755], [52, 291955], [58, 292095], [67, 292515], [70, 292695], [74, 292795], [86, 293315], [89, 293515]]}, {"verse": 52, "start": 294493, "end": 300003, "text": "But made his own people to go forth like sheep, and guided them in the wilderness like a flock.", "words": [[0, 294493], [4, 294604], [9, 294844], [13, 295084], [17, 295284], [24, 295624], [27, 295824], [30, 296044], [36, 296364], [41, 296624], [48, 297544], [52, 297644], [59, 298004], [64, 298264], [67, 298444], [71, 298544], [82, 298924], [87, 299284], [89, 299424]]}, {"verse": 53, "start": 300453, "end": 306670, "text": "And he led them on safely, so that they feared not: but the sea overwhelmed their enemies.", "words": [[0, 300453], [4, 300730], [7, 300870], [11, 301150], [16, 301370], [19, 301510], [27, 302030], [30, 302490], [35, 302710], [40, 302870], [47, 303190], [52, 304131], [56, 304211], [60, 304371], [64, 305051], [76, 305731], [82, 305911]]}, {"verse": 54, "start": 307120, "end": 313518, "text": "And he brought them to the border of his sanctuary, even to this mountain, which his right hand had purchased.", "words": [[0, 307120], [4, 307266], [7, 307386], [15, 307626], [20, 307946], [23, 308106], [27, 308226], [34, 308506], [37, 308746], [41, 308886], [52, 309846], [57, 310226], [60, 310466], [65, 310666], [75, 311526], [81, 311786], [85, 311966], [91, 312226], [96, 312546], [100, 312786]]}, {"verse": 55, "start": 313968, "end": 322295, "text": "He cast out the heathen also before them, and divided them an inheritance by line, and made the tribes of Israel to dwell in their tents.", "words": [[0, 313968], [3, 314066], [8, 314466], [12, 314706], [16, 314886], [24, 315266], [29, 315626], [36, 316026], [42, 316806], [46, 316866], [54, 317246], [59, 317456], [62, 317666], [74, 318166], [77, 318546], [83, 319346], [87, 319486], [92, 319686], [96, 319866], [103, 320206], [106, 320426], [113, 320826], [116, 321026], [122, 321306], [125, 321546], [131, 321706]]}, {"verse": 56, "start": 322745, "end": 327283, "text": "Yet they tempted and provoked the most high God, and kept not his testimonies:", "words": [[0, 322745], [4, 322936], [9, 323156], [17, 323576], [21, 323796], [30, 324276], [34, 324436], [39, 324616], [44, 324956], [49, 325296], [53, 325596], [58, 325856], [62, 326156], [66, 326356]]}, {"verse": 57, "start": 327733, "end": 333872, "text": "But turned back, and dealt unfaithfully like their fathers: they were turned aside like a deceitful bow.", "words": [[0, 327733], [4, 327856], [11, 328156], [17, 328516], [21, 329036], [27, 329256], [40, 330116], [45, 330356], [51, 330536], [60, 331560], [65, 331645], [70, 331785], [77, 332045], [83, 332445], [88, 332705], [90, 332805], [100, 333365]]}, {"verse": 58, "start": 334322, "end": 340658, "text": "For they provoked him to anger with their high places, and moved him to jealousy with their graven images.", "words": [[0, 334322], [4, 334433], [9, 334573], [18, 335113], [22, 335253], [25, 335393], [31, 335753], [36, 336053], [42, 336233], [47, 336473], [55, 337413], [59, 337653], [65, 337933], [69, 338173], [72, 338373], [81, 338793], [86, 339233], [92, 339413], [99, 339873]]}, {"verse": 59, "start": 341108, "end": 345191, "text": "When God heard this, he was angry, and greatly abhorred Israel:", "words": [[0, 341108], [5, 341254], [9, 341554], [15, 341854], [21, 342274], [24, 342354], [28, 342534], [35, 342974], [39, 343394], [47, 343774], [56, 344534]]}, {"verse": 60, "start": 345641, "end": 350357, "text": "So that he forsook the tabernacle of Shiloh, the tent which he placed among men;", "words": [[0, 345641], [3, 345761], [8, 345921], [11, 346061], [19, 346581], [23, 346701], [34, 347361], [37, 347461], [45, 348481], [49, 348581], [54, 348801], [60, 349041], [63, 349181], [70, 349481], [76, 349761]]}, {"verse": 61, "start": 350807, "end": 355357, "text": "And delivered his strength into captivity, and his glory into the enemy’s hand.", "words": [[0, 350807], [4, 350936], [14, 351256], [18, 351496], [27, 351876], [32, 352116], [43, 352696], [47, 353316], [51, 353496], [57, 353876], [62, 354216], [66, 354416], [74, 354916]]}, {"verse": 62, "start": 355807, "end": 361212, "text": "He gave his people over also to the sword; and was angry with his inheritance.", "words": [[0, 355807], [3, 355916], [8, 356176], [12, 356436], [19, 356776], [24, 357236], [29, 357816], [32, 358056], [36, 358236], [43, 359109], [47, 359238], [51, 359418], [57, 359818], [62, 360118], [66, 360278]]}, {"verse": 63, "start": 361662, "end": 366354, "text": "The fire consumed their young men; and their maidens were not given to marriage.", "words": [[0, 361662], [4, 361765], [9, 362085], [18, 362665], [24, 362965], [30, 363245], [35, 364108], [39, 364247], [45, 364367], [53, 364847], [58, 364987], [62, 365207], [68, 365507], [71, 365707]]}, {"verse": 64, "start": 366804, "end": 371309, "text": "Their priests fell by the sword; and their widows made no lamentation.", "words": [[0, 366804], [6, 366961], [14, 367381], [19, 367741], [22, 367981], [26, 368121], [33, 369020], [37, 369163], [43, 369303], [50, 369743], [55, 369983], [58, 370263]]}, {"verse": 65, "start": 371759, "end": 377301, "text": "Then the Lord awaked as one out of sleep, and like a mighty man that shouts by reason of wine.", "words": [[0, 371759], [5, 372048], [9, 372248], [14, 372528], [21, 372808], [24, 373088], [28, 373368], [32, 373548], [35, 373648], [42, 374208], [46, 374468], [51, 374628], [53, 374768], [60, 375008], [64, 375348], [69, 375548], [76, 375928], [79, 376148], [86, 376488], [89, 376688]]}, {"verse": 66, "start": 377751, "end": 382815, "text": "And he struck his enemies in the hinder parts: he put them to a perpetual reproach.", "words": [[0, 377751], [4, 377885], [7, 377985], [14, 378285], [18, 378525], [26, 378945], [29, 379265], [33, 379385], [40, 379645], [47, 380532], [50, 380641], [54, 380861], [59, 381081], [62, 381241], [64, 381401], [74, 381861]]}, {"verse": 67, "start": 383265, "end": 388505, "text": "Moreover he refused the tabernacle of Joseph, and chose not the tribe of Ephraim:", "words": [[0, 383265], [9, 383873], [12, 384013], [20, 384573], [24, 384773], [35, 385373], [38, 385513], [46, 385973], [50, 386513], [56, 386833], [60, 387093], [64, 387313], [70, 387653], [73, 387833]]}, {"verse": 68, "start": 388955, "end": 392778, "text": "But chose the tribe of Judah, the mount Zion which he loved.", "words": [[0, 388955], [4, 389050], [10, 389350], [14, 389590], [20, 389950], [23, 390150], [30, 390990], [34, 391090], [40, 391330], [45, 391970], [51, 392090], [54, 392250]]}, {"verse": 69, "start": 393228, "end": 398781, "text": "And he built his sanctuary like high palaces, like the earth which he has established for ever.", "words": [[0, 393228], [4, 393358], [7, 393458], [13, 393738], [17, 393898], [27, 394478], [32, 394838], [37, 395138], [46, 396178], [51, 396378], [55, 396558], [61, 396838], [67, 397158], [70, 397298], [74, 397478], [86, 397932], [90, 398385]]}, {"verse": 70, "start": 399231, "end": 402975, "text": "He chose David also his servant, and took him from the sheepfolds:", "words": [[0, 399231], [3, 399319], [9, 399619], [15, 399979], [20, 400359], [24, 400619], [33, 400979], [37, 401459], [42, 401659], [46, 401819], [51, 401979], [55, 402139]]}, {"verse": 71, "start": 403425, "end": 409104, "text": "From following the ewes great with young he brought him to feed Jacob his people, and Israel his inheritance.", "words": [[0, 403425], [5, 403568], [15, 403968], [19, 404308], [24, 404648], [30, 404808], [35, 405028], [41, 405468], [44, 405528], [52, 405728], [56, 405908], [59, 406048], [64, 406248], [70, 406628], [74, 406868], [82, 407168], [86, 407608], [93, 408008], [97, 408288]]}, {"verse": 72, "start": 409554, "end": 415448, "text": "So he fed them according to the integrity of his heart; and guided them by the skilfulness of his hands.", "words": [[0, 409554], [3, 409694], [6, 409854], [10, 410094], [15, 410354], [25, 410654], [28, 410914], [32, 411074], [42, 411534], [45, 411814], [49, 411954], [56, 412724], [60, 412868], [67, 413188], [72, 413488], [75, 413688], [79, 414018], [91, 414348], [94, 414628], [98, 414788]]}]}