{"book": "GEN", "chapter": 2, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 190269, "verses": [{"verse": 1, "start": 300, "end": 4188, "text": "Thus the heavens and the earth were finished, and all the host of them.", "words": [[0, 300], [5, 537], [9, 817], [17, 1117], [21, 1457], [25, 1617], [31, 1857], [36, 2057], [46, 2897], [50, 3017], [54, 3297], [58, 3477], [63, 3677], [66, 3877]]}, {"verse": 2, "start": 4638, "end": 12022, "text": "And on the seventh day God ended his work which he had made; and he rested on the seventh day from all his work which he had made.", "words": [[0, 4638], [4, 4779], [7, 4959], [11, 5099], [19, 5419], [23, 5879], [27, 6119], [33, 6539], [37, 6759], [42, 7039], [48, 7279], [51, 7419], [55, 7599], [61, 8407], [65, 8535], [68, 8655], [75, 8975], [78, 9215], [82, 9355], [90, 9695], [94, 10095], [99, 10355], [103, 10595], [107, 10815], [112, 11075], [118, 11295], [121, 11455], [125, 11575]]}, {"verse": 3, "start": 12472, "end": 19662, "text": "And God blessed the seventh day, and sanctified it: because that in it he had rested from all his work which God created and made.", "words": [[0, 12472], [4, 12617], [8, 12897], [16, 13217], [20, 13517], [28, 13817], [33, 14197], [37, 14457], [48, 15037], [52, 15720], [60, 15875], [65, 16135], [68, 16335], [71, 16455], [74, 16615], [78, 16735], [85, 17055], [90, 17335], [94, 17535], [98, 17755], [103, 18015], [109, 18235], [113, 18515], [121, 19035], [125, 19235]]}, {"verse": 4, "start": 20112, "end": 28217, "text": "¶ These are the generations of the heavens and of the earth when they were created, in the day that the LORD God made the earth and the heavens,", "words": [[2, 20112], [8, 20328], [12, 20548], [16, 20668], [28, 21268], [31, 21608], [35, 21768], [43, 22068], [47, 22468], [50, 22648], [54, 22808], [60, 23068], [65, 23328], [70, 23528], [75, 23648], [84, 24628], [87, 24948], [91, 25068], [95, 25308], [100, 25488], [104, 25648], [109, 25908], [113, 26