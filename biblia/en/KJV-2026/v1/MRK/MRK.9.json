{"book": "MRK", "chapter": 9, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 375355, "verses": [{"verse": 1, "start": 300, "end": 10236, "text": "And he said to them, Assuredly I say to you, That there be some of them that stand here, which shall not taste of death, till they have seen the kingdom of God come with power.", "words": [[0, 300], [4, 431], [7, 551], [12, 791], [15, 991], [21, 1586], [31, 2192], [33, 2332], [37, 2532], [40, 2712], [45, 3332], [50, 3692], [56, 3852], [59, 3972], [64, 4232], [67, 4372], [72, 4532], [77, 4752], [83, 5052], [89, 5792], [95, 5972], [101, 6212], [105, 6412], [111, 6712], [114, 6932], [121, 7706], [126, 7786], [131, 7946], [136, 8046], [141, 8266], [145, 8426], [153, 8686], [156, 8926], [160, 9226], [165, 9506], [170, 9666]]}, {"verse": 2, "start": 10586, "end": 21035, "text": "¶ And after six days Jesus takes with him Peter, and James, and John, and leads them up into a high mountain apart by themselves: and he was transfigured before them.", "words": [[2, 10586], [6, 10746], [12, 11026], [16, 11326], [21, 12186], [27, 12426], [33, 12826], [38, 13146], [42, 13286], [49, 13666], [53, 14066], [60, 14526], [64, 14906], [70, 15286], [74, 15806], [80, 16046], [85, 16286], [88, 16466], [93, 16686], [95, 16866], [100, 17046], [109, 17406], [115, 17746], [118, 18066], [130, 19182], [134, 19291], [137, 19371], [141, 19531], [154, 20291], [161, 20571]]}, {"verse": 3, "start": 21485, "end": 27775, "text": "And his clothing became shining, exceeding white as snow; so as no fuller on earth can white them.", "words": [[0, 21485], [4, 21642], [8, 21762], [17, 22142], [24, 22562], [33, 23522], [43, 24122], [49, 24422], [52, 24642], [58, 25510], [61, 25655], [64, 25835], [67, 26015], [74, 26495], [77, 26655], [83, 26855], [87, 27095], [93, 27335]]}, {"verse": 4, "start": 28225, "end": 32618, "text": "And there appeared to them Elias with Moses: and they were talking with Jesus.", "words": [[0, 28225], [4, 28