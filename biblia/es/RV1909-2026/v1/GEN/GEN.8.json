{"book": "GEN", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 216077, "verses": [{"verse": 1, "start": 300, "end": 13526, "text": "Y Dios se acordó de Noé, y de todos los animales, y de todas las bestias que estaban con él en el arca; e hizo pasar Dios un viento sobre la tierra, y disminuyeron las aguas.", "words": [[0, 300], [2, 442], [7, 682], [10, 1062], [17, 1602], [20, 1722], [25, 2362], [27, 2642], [30, 2762], [36, 3022], [40, 3302], [50, 3782], [52, 4402], [55, 4542], [61, 4762], [65, 5042], [73, 5482], [77, 5642], [85, 5982], [89, 6322], [92, 6502], [95, 6802], [98, 6942], [104, 7829], [106, 7953], [111, 8373], [117, 8753], [122, 9133], [125, 9513], [132, 10013], [138, 10333], [141, 10573], [149, 11013], [151, 11613], [164, 12573], [168, 12753]]}, {"verse": 2, "start": 13976, "end": 21665, "text": "Y se cerraron las fuentes del abismo, y las cataratas de los cielos; y la lluvia de los cielos fue detenida.", "words": [[0, 13976], [2, 14100], [5, 14200], [14, 14940], [18, 15100], [26, 15640], [30, 15840], [38, 16360], [40, 16980], [44, 17140], [54, 17880], [57, 17980], [61, 18100], [69, 19188], [71, 19492], [74, 19612], [81, 20032], [84, 20112], [88, 20252], [95, 20672], [99, 20852]]}, {"verse": 3, "start": 22115, "end": 31237, "text": "Y las aguas se retiraron de sobre la tierra, yendo y volviendo: y decrecieron las aguas al cabo de ciento cincuenta días.", "words": [[0, 22115], [2, 22221], [6, 22381], [12, 23001], [15, 23101], [25, 23841], [28, 24001], [34, 24261], [37, 24461], [45, 25421], [51, 25881], [53, 26141], [64, 27309], [66, 27418], [78, 28098], [82, 28278], [88, 28758], [91, 28898], [96, 29198], [99, 29518], [106, 29838], [116, 30158]]}, {"verse": 4, "start": 31687, "end": 38776, "text": "Y reposó el arca en el mes séptimo, a diecisiete días del mes, sobre los montes de Ararat.", "words": [[0, 31687], [2, 31808], [9, 32408], [12, 32528], [17, 32868], [20, 32988], [23, 33128], [27, 33288], [36, 34028], [38, 34708], [49, 35388], [54, 35908], [58, 36188], [63, 36468], [69, 37048], [73, 37268], [80, 37808], [83, 37968]]}, {"verse": 5, "start": 39226, "end": 48015, "text": "Y las aguas fueron decreciendo hasta el mes décimo: en el décimo, al primero del mes, se descubrieron las cimas de los montes.", "words": [[0, 39226], [2, 39354], [6, 39514], [12, 40014], [19, 40314], [31, 41274], [37, 41614], [40, 41794], [44, 42014], [52, 43180], [55, 43345], [58, 43505], [66, 44085], [69, 44225], [77, 44545], [81, 44845], [86, 45385], [89, 45525], [102, 46245], [106, 46425], [112, 46925], [115, 47105], [119, 47225]]}, {"verse": 6, "start": 48465, "end": 54755, "text": "Y sucedió que, al cabo de cuarenta días, abrió Noé la ventana del arca que había hecho,", "words": [[0, 48465], [2, 48574], [10, 49194], [15, 49694], [18, 49754], [23, 49994], [26, 50264], [35, 50534], [41, 51434], [47, 51834], [51, 52414], [54, 52654], [62, 53021], [66, 53387], [71, 53754], [75, 53914], [81, 54174]]}, {"verse": 7, "start": 55205, "end": 62849, "text": "Y envió al cuervo, el cual salió, y estuvo yendo y volviendo hasta que las aguas se secaron de sobre la tierra.", "words": [[0, 55205], [2, 55347], [8, 55787], [11, 55947], [19, 56467], [22, 56607], [27, 56747], [34, 57307], [36, 57947], [43, 58307], [49, 58767], [51, 58887], [61, 59367], [67, 59547], [71, 59727], [75, 59927], [81, 60487], [84, 60907], [92, 61407], [95, 61567], [101, 61827], [104, 62067]]}, {"verse": 8, "start": 63299, "end": 70574, "text": "Envió también de sí a la paloma, para ver si las aguas se habían retirado de sobre la faz de la tierra;", "words": [[0, 63299], [6, 63761], [14, 64201], [17, 64421], [20, 64701], [22, 64941], [25, 65041], [33, 65681], [38, 66481], [42, 66721], [45, 66901], [49, 67121], [55, 67561], [58, 67681], [65, 67921], [74, 68701], [77, 68861], [83, 69141], [86, 69361], [90, 69601], [93, 69781], [96, 69901]]}, {"verse": 9, "start": 71024, "end": 87928, "text": "Y no halló la paloma donde sentar la planta de su pie, y se volvió a él al arca, porque las aguas estaban aún sobre la faz de toda la tierra: entonces él extendió su mano, y tomándola, la hizo entrar consigo en el arca.", "words": [[0, 71024], [2, 71148], [5, 71348], [11, 71648], [14, 71788], [21, 72268], [27, 72528], [34, 73208], [37, 73348], [44, 73788], [47, 73908], [50, 74048], [55, 74968], [57, 75088], [60, 75228], [67, 75748], [69, 75988], [72, 76248], [75, 76548], [81, 77453], [88, 77638], [92, 77878], [98, 78298], [106, 78678], [110, 79178], [116, 79638], [119, 79838], [123, 80258], [126, 80658], [131, 80878], [134, 81118], [142, 82034], [151, 82556], [154, 83136], [163, 83916], [166, 84096], [172, 84396], [174, 84576], [185, 85556], [188, 85756], [193, 86016], [200, 86436], [208, 87036], [211, 87276], [214, 87396]]}, {"verse": 10, "start": 88378, "end": 93905, "text": "Y esperó aún otros siete días, y volvió a enviar la paloma fuera del arca.", "words": [[0, 88378], [2, 88467], [9, 88827], [13, 89027], [19, 89507], [25, 89947], [31, 90487], [33, 91287], [40, 91707], [42, 91767], [49, 92147], [52, 92307], [59, 92707], [65, 93007], [69, 93327]]}, {"verse": 11, "start": 94355, "end": 106447, "text": "Y la paloma volvió a él a la hora de la tarde; y he aquí que traía una hoja de olivo en su pico: y entendió Noé que las aguas se habían retirado de sobre la tierra.", "words": [[0, 94355], [2, 94478], [5, 94598], [12, 95018], [19, 95558], [21, 95678], [24, 95918], [26, 96178], [29, 96298], [34, 96538], [37, 96698], [40, 96838], [47, 97747], [49, 98180], [52, 98320], [57, 98720], [61, 98960], [67, 99380], [71, 99620], [76, 100000], [79, 100140], [85, 100480], [88, 100620], [91, 101030], [97, 101676], [99, 101801], [108, 102381], [112, 102781], [116, 102981], [120, 103241], [126, 103761], [129, 103961], [136, 104301], [145, 105101], [148, 105261], [154, 105601], [157, 105821]]}, {"verse": 12, "start": 106897, "end": 113160, "text": "Y esperó aún otros siete días, y envió la paloma, la cual no volvió ya más a él.", "words": [[0, 106897], [2, 107177], [9, 107777], [13, 108177], [19, 108577], [25, 108937], [31, 109377], [33, 109657], [39, 110077], [42, 110217], [50, 111097], [53, 111197], [58, 111437], [61, 111717], [68, 112117], [71, 112297], [75, 112557], [77, 112737]]}, {"verse": 13, "start": 113610, "end": 130481, "text": "Y sucedió que en el año seiscientos uno de Noé, en el mes primero, al primero del mes, las aguas se secaron de sobre la tierra; y quitó Noé la cubierta del arca, y miró, y he aquí que la superficie de la tierra estaba seca.", "words": [[0, 113610], [2, 113771], [10, 114391], [14, 114611], [17, 114971], [20, 115111], [24, 115604], [36, 116098], [40, 116591], [43, 116811], [48, 117671], [51, 117791], [54, 117931], [58, 118111], [67, 119051], [70, 119171], [78, 119571], [82, 119811], [87, 120631], [91, 120831], [97, 121671], [100, 121991], [108, 122571], [111, 122711], [117, 122971], [120, 123191], [128, 124217], [130, 124343], [136, 124583], [140, 124823], [143, 125063], [152, 125490], [156, 125916], [162, 126343], [164, 126603], [170, 127443], [172, 127483], [175, 127583], [180, 127843], [184, 127983], [187, 128123], [198, 128903], [201, 128983], [204, 129123], [211, 129363], [218, 129763]]}, {"verse": 14, "start": 130931, "end": 136149, "text": "Y en el mes segundo, a los veintisiete días del mes, se secó la tierra.", "words": [[0, 130931], [2, 131050], [5, 131190], [8, 131310], [12, 131490], [21, 132650], [23, 132910], [27, 133240], [39, 133570], [44, 133970], [48, 134150], [53, 134810], [56, 134970], [61, 135330], [64, 135450]]}, {"verse": 15, "start": 136599, "end": 138967, "text": "Y habló Dios a Noé diciendo:", "words": [[0, 136599], [2, 136742], [8, 137122], [13, 137362], [15, 137782], [19, 138162]]}, {"verse": 16, "start": 139217, "end": 144799, "text": "Sal del arca tú, y tu mujer, y tus hijos, y las mujeres de tus hijos contigo.", "words": [[0, 139217], [4, 139478], [8, 139678], [13, 140038], [17, 140318], [19, 140778], [22, 140918], [29, 141318], [31, 141718], [35, 141858], [42, 142218], [44, 142718], [48, 142878], [56, 143238], [59, 143458], [63, 143618], [69, 143878]]}, {"verse": 17, "start": 145249, "end": 160863, "text": "Todos los animales que están contigo de toda carne, de aves y de bestias y de todo reptil que anda arrastrando sobre la tierra, sacarás contigo; y vayan por la tierra, y fructifiquen, y multiplíquense sobre la tierra.", "words": [[0, 145249], [6, 145453], [10, 145713], [19, 146193], [23, 146553], [29, 146753], [37, 147353], [40, 147493], [45, 147633], [52, 148733], [55, 148793], [60, 149193], [62, 149373], [65, 149493], [73, 150073], [75, 150493], [78, 150633], [83, 150813], [90, 151473], [94, 151673], [99, 151933], [111, 152633], [117, 152873], [120, 153073], [128, 153873], [136, 154433], [145, 155648], [147, 155785], [153, 156125], [157, 156345], [160, 156485], [168, 156905], [170, 157345], [184, 158265], [186, 158625], [201, 159505], [207, 159865], [210, 160065]]}, {"verse": 18, "start": 161213, "end": 167586, "text": "Entonces salió Noé, y sus hijos, y su mujer, y las mujeres de sus hijos con él.", "words": [[0, 161213], [9, 161719], [15, 162519], [20, 163119], [22, 163299], [26, 163459], [33, 164399], [35, 164479], [38, 164579], [45, 165699], [47, 165779], [51, 165919], [59, 166239], [62, 166439], [66, 166619], [72, 166879], [76, 167119]]}, {"verse": 19, "start": 168036, "end": 177375, "text": "Todos los animales, y todo reptil y toda ave, todo lo que se mueve sobre la tierra según sus especies, salieron del arca.", "words": [[0, 168036], [6, 168339], [10, 168879], [20, 169359], [22, 169659], [27, 169819], [34, 170679], [36, 170859], [41, 171019], [46, 171819], [51, 172039], [54, 172259], [58, 172399], [61, 172539], [67, 172979], [73, 173239], [76, 173479], [83, 174319], [89, 174559], [93, 174899], [103, 175939], [112, 176433], [116, 176928]]}, {"verse": 20, "start": 177825, "end": 186696, "text": "Y edificó Noé un altar a Jehová, y tomó de todo animal limpio y de toda ave limpia, y ofreció holocausto en el altar.", "words": [[0, 177825], [2, 177993], [10, 178593], [14, 178953], [17, 179213], [23, 179613], [25, 179793], [33, 180233], [35, 180333], [40, 180653], [43, 180733], [48, 180993], [55, 181413], [62, 182093], [64, 182173], [67, 182293], [72, 182513], [76, 182913], [84, 183813], [86, 184233], [94, 184953], [105, 185713], [108, 185873], [111, 186013]]}, {"verse": 21, "start": 187146, "end": 204976, "text": "Y percibió Jehová olor de suavidad; y dijo Jehová en su corazón: No volveré más a maldecir la tierra por causa del hombre; porque el intento del corazón del hombre es malo desde su juventud: ni volveré más a destruir todo viviente, como he hecho.", "words": [[0, 187146], [2, 187366], [11, 188026], [18, 188486], [23, 188806], [26, 189255], [36, 189996], [38, 190100], [43, 190380], [50, 190880], [53, 190980], [56, 191140], [65, 192148], [68, 192331], [76, 192911], [80, 193071], [82, 193231], [91, 193811], [94, 194051], [101, 194471], [105, 194791], [111, 195091], [115, 195391], [123, 196388], [130, 196608], [133, 196748], [141, 197288], [145, 197408], [153, 197808], [157, 198068], [164, 198388], [167, 198948], [172, 199428], [178, 199588], [181, 199888], [191, 201173], [194, 201315], [202, 201815], [206, 202055], [208, 202295], [217, 202895], [222, 203075], [232, 203715], [237, 204095], [240, 204275]]}, {"verse": 22, "start": 205426, "end": 215677, "text": "Todavía serán todos los tiempos de la tierra; la sementera y la siega, y el frío y calor, verano e invierno, y día y noche, no cesarán.", "words": [[0, 205426], [8, 205788], [14, 206408], [20, 206647], [24, 206968], [32, 207547], [35, 207628], [38, 207728], [46, 208834], [49, 209237], [59, 209677], [61, 209877], [64, 210237], [71, 210597], [73, 210757], [76, 210857], [81, 211257], [83, 211357], [90, 211977], [97, 212637], [99, 212837], [109, 213577], [111, 213717], [115, 213937], [117, 214057], [124, 214377], [127, 214777]]}]}