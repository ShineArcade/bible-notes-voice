{"book": "PSA", "chapter": 35, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 202300, "verses": [{"verse": 1, "start": 300, "end": 7547, "text": "Salmo de David. DISPUTA, oh Jehová, con los que contra mí contienden; pelea con los que me combaten.", "words": [[0, 300], [6, 784], [9, 944], [16, 1729], [25, 2184], [28, 2670], [36, 3157], [40, 3657], [44, 3817], [48, 3977], [55, 4317], [58, 4537], [70, 5788], [76, 6192], [80, 6352], [84, 6512], [88, 6632], [91, 6772]]}, {"verse": 2, "start": 7997, "end": 12799, "text": "Echa mano al escudo y al escudo grande, y levántate en mi ayuda.", "words": [[0, 7997], [5, 8262], [10, 8522], [13, 8682], [20, 9142], [22, 9302], [25, 9422], [32, 9762], [40, 10222], [42, 10862], [52, 11682], [55, 11982], [58, 12162]]}, {"verse": 3, "start": 13249, "end": 20144, "text": "Y saca la lanza, cierra contra mis perseguidores; di a mi alma: Yo soy tu salvación.", "words": [[0, 13249], [2, 13370], [7, 13730], [10, 13850], [17, 14690], [24, 15070], [31, 15450], [35, 15710], [50, 17116], [53, 17380], [55, 17520], [58, 17640], [64, 18493], [67, 18680], [71, 18900], [74, 19140]]}, {"verse": 4, "start": 20594, "end": 29255, "text": "Avergüéncense y confúndanse los que buscan mi alma: vuelvan atrás, y sean avergonzados los que mi mal intentan.", "words": [[0, 20594], [14, 21536], [16, 21676], [28, 22457], [32, 22656], [36, 22816], [43, 23216], [46, 23457], [52, 24323], [60, 24848], [67, 25228], [69, 25828], [74, 26188], [87, 27228], [91, 27728], [95, 27908], [98, 28068], [102, 28328]]}, {"verse": 5, "start": 29705, "end": 34821, "text": "Sean como el tamo delante del viento; y el ángel de Jehová los acose.", "words": [[0, 29705], [5, 29967], [10, 30327], [13, 30507], [18, 30927], [26, 31407], [30, 31667], [38, 32756], [40, 32875], [43, 32995], [49, 33415], [52, 33555], [59, 34015], [63, 34135]]}, {"verse": 6, "start": 35271, "end": 41161, "text": "Sea su camino oscuridad y resbaladeros; y el ángel de Jehová los persiga.", "words": [[0, 35271], [4, 35557], [7, 35837], [14, 36217], [24, 37117], [26, 37852], [40, 38820], [42, 38985], [45, 39125], [51, 39545], [54, 39965], [61, 40386], [65, 40806]]}, {"verse": 7, "start": 41611, "end": 48611, "text": "Porque sin causa escondieron para mí su red en un hoyo; sin causa hicieron hoyo para mi alma.", "words": [[0, 41611], [7, 41836], [11, 42076], [17, 42556], [29, 43276], [34, 43516], [37, 43736], [40, 43936], [44, 44276], [47, 44576], [50, 44736], [56, 45559], [60, 45817], [66, 46437], [75, 47047], [80, 47657], [85, 47897], [88, 48097]]}, {"verse": 8, "start": 49061, "end": 57476, "text": "Véngale el quebrantamiento que no sepa, y su red que escondió lo prenda: con quebrantamiento en ella caiga.", "words": [[0, 49061], [8, 49565], [11, 49925], [27, 50785], [31, 51052], [34, 51318], [40, 51585], [42, 52185], [45, 52365], [49, 52705], [53, 53345], [62, 53805], [65, 53925], [73, 54856], [77, 55040], [93, 56260], [96, 56460], [101, 56680]]}, {"verse": 9, "start": 57926, "end": 62553, "text": "Y gócese mi alma en Jehová; y alégrese en su salvación.", "words": [[0, 57926], [2, 58320], [9, 58750], [12, 58910], [17, 59130], [20, 59350], [28, 60229], [30, 60508], [39, 61168], [42, 61468], [45, 61628]]}, {"verse": 10, "start": 63003, "end": 73629, "text": "Todos mis huesos dirán: Jehová, ¿quién como tú, que libras al afligido del más fuerte que él, y al pobre y necesitado del que le despoja?", "words": [[0, 63003], [6, 63185], [10, 63485], [17, 63925], [24, 64865], [32, 64865], [39, 66049], [44, 66329], [48, 67029], [52, 67049], [59, 67609], [62, 67749], [71, 68349], [75, 68529], [79, 68729], [86, 69149], [90, 69429], [94, 69789], [96, 70269], [99, 70409], [105, 71022], [107, 71636], [118, 72249], [122, 72449], [126, 72649], [129, 72789]]}, {"verse": 11, "start": 74079, "end": 78363, "text": "Se levantan testigos falsos; de lo que no sé me preguntan;", "words": [[0, 74079], [3, 74258], [12, 74838], [21, 75418], [29, 76658], [32, 76918], [35, 77038], [39, 77158], [42, 77278], [45, 77458], [48, 77578]]}, {"verse": 12, "start": 78813, "end": 82544, "text": "Me devolvieron mal por bien, para abatir a mi alma.", "words": [[0, 78813], [3, 78963], [15, 79583], [19, 79883], [23, 80143], [29, 80463], [34, 81143], [41, 81743], [43, 81823], [46, 81943]]}, {"verse": 13, "start": 82994, "end": 92197, "text": "Pero yo, cuando ellos enfermaron, me vestí de saco; afligí con ayuno mi alma, y mi oración se revolvía en mi seno.", "words": [[0, 82994], [5, 83137], [9, 83777], [16, 84137], [22, 84617], [34, 85837], [37, 86057], [43, 86457], [46, 86517], [52, 87447], [59, 88178], [63, 88358], [69, 88718], [72, 88958], [78, 89278], [80, 89838], [83, 89978], [91, 90478], [94, 90718], [103, 91378], [106, 91498], [109, 91658]]}, {"verse": 14, "start": 92647, "end": 100228, "text": "Como por mi compañero, como por mi hermano andaba; como el que trae luto por madre, enlutado me humillaba.", "words": [[0, 92647], [5, 92809], [9, 93069], [12, 93209], [23, 94049], [28, 94189], [32, 94469], [35, 94609], [43, 95049], [51, 95893], [56, 96253], [59, 96353], [63, 96493], [68, 96833], [73, 97193], [77, 97473], [84, 98313], [93, 99153], [96, 99393]]}, {"verse": 15, "start": 100678, "end": 112740, "text": "Pero ellos se alegraron en mi adversidad, y se juntaron; se juntaron contra mí gentes despreciables, y yo no lo entendía: me despedazaban, y no cesaban;", "words": [[0, 100678], [5, 100842], [11, 101122], [14, 101562], [24, 102262], [27, 102442], [30, 102622], [42, 103342], [44, 103622], [47, 103762], [57, 104878], [60, 105017], [69, 105617], [76, 105944], [79, 106270], [86, 106597], [101, 107517], [103, 107777], [106, 108037], [109, 108697], [112, 108857], [122, 110043], [125, 110318], [139, 111278], [141, 111838], [144, 111978]]}, {"verse": 16, "start": 113190, "end": 118318, "text": "Con los lisonjeros burladores bufones, crujiendo sobre mí sus dientes.", "words": [[0, 113190], [4, 113334], [8, 113574], [19, 114434], [30, 115044], [39, 115654], [49, 116794], [55, 117074], [58, 117354], [62, 117574]]}, {"verse": 17, "start": 118768, "end": 126024, "text": "Señor, ¿hasta cuándo verás esto? Recobra mi alma de sus quebrantamientos, mi única de los leones.", "words": [[0, 118768], [7, 119598], [14, 119738], [21, 120118], [27, 120378], [33, 121181], [41, 121726], [44, 121946], [49, 122246], [52, 122486], [56, 122706], [74, 124226], [77, 124506], [83, 124846], [86, 125046], [90, 125206]]}, {"verse": 18, "start": 126474, "end": 131666, "text": "Te confesaré en grande congregación; te alabaré entre numeroso pueblo.", "words": [[0, 126474], [3, 126558], [13, 127298], [16, 127538], [23, 127938], [37, 129361], [40, 129625], [48, 129926], [54, 130285], [63, 131005]]}, {"verse": 19, "start": 132116, "end": 138411, "text": "No se alegren de mí mis enemigos injustos: ni los que me aborrecen sin causa guiñen el ojo.", "words": [[0, 132116], [3, 132284], [6, 132444], [14, 132924], [17, 133084], [20, 133284], [24, 133464], [33, 133984], [43, 135292], [46, 135466], [50, 135639], [54, 135739], [57, 135898], [67, 136478], [71, 136658], [77, 137258], [84, 137859], [87, 137978]]}, {"verse": 20, "start": 138861, "end": 144297, "text": "Porque no hablan paz; y contra los mansos de la tierra piensan palabras engañosas.", "words": [[0, 138965], [7, 139105], [10, 139265], [17, 139545], [22, 140472], [24, 140568], [31, 140828], [35, 141028], [42, 141508], [45, 141628], [48, 141748], [55, 142048], [63, 142628], [72, 142988]]}, {"verse": 21, "start": 144747, "end": 151962, "text": "Y ensancharon sobre mí su boca; dijeron: ¡Ea, ea, nuestros ojos lo han visto!", "words": [[0, 144747], [2, 144987], [14, 145767], [20, 146107], [23, 146347], [26, 146507], [32, 147405], [41, 148373], [46, 148752], [50, 149192], [59, 149652], [64, 149912], [67, 150152], [71, 150292]]}, {"verse": 22, "start": 152312, "end": 157397, "text": "Tú lo has visto, oh Jehová; no calles: Señor, de mí no te alejes.", "words": [[0, 152312], [3, 152416], [6, 152536], [10, 152656], [17, 152866], [20, 153076], [28, 155060], [31, 155283], [39, 155753], [46, 155753], [49, 155918], [52, 156118], [55, 156578], [58, 156758]]}, {"verse": 23, "start": 157847, "end": 163202, "text": "Muévete y despierta para mi juicio, para mi causa, Dios mío y Señor mío.", "words": [[0, 157847], [8, 158371], [10, 158611], [20, 159371], [25, 159571], [28, 159731], [36, 160451], [41, 160491], [44, 160671], [51, 161491], [56, 161591], [60, 162231], [62, 162371], [68, 162671]]}, {"verse": 24, "start": 163652, "end": 169530, "text": "Júzgame conforme a tu justicia, Jehová Dios mío; y no se alegren de mí.", "words": [[0, 163652], [8, 164222], [17, 164942], [19, 165002], [22, 165102], [32, 166202], [39, 166922], [44, 167202], [49, 168175], [51, 168283], [54, 168423], [57, 168603], [65, 169083], [68, 169243]]}, {"verse": 25, "start": 169980, "end": 175584, "text": "No digan en su corazón: ¡Ea, alma nuestra! No digan: ¡Lo hemos devorado!", "words": [[0, 169980], [3, 170148], [9, 170548], [12, 170668], [15, 170828], [24, 172092], [29, 172339], [34, 172586], [43, 173133], [46, 173584], [53, 174537], [57, 174685], [63, 174825]]}, {"verse": 26, "start": 176034, "end": 186850, "text": "Avergüéncense, y sean confundidos a una los que de mi mal se alegran: vístanse de vergüenza y de confusión los que se engrandecen contra mí.", "words": [[0, 176034], [15, 176979], [17, 177399], [22, 177699], [34, 178579], [36, 179079], [40, 179319], [44, 179819], [48, 180039], [51, 180199], [54, 180359], [58, 180659], [61, 181019], [70, 182134], [79, 182801], [82, 182941], [92, 183561], [94, 183701], [97, 183801], [107, 184521], [111, 184981], [115, 185161], [118, 185681], [130, 186201], [137, 186501]]}, {"verse": 27, "start": 187300, "end": 197174, "text": "Canten y alégrense los que están a favor de mi justa causa, y digan siempre: Sea exaltado Jehová, que ama la paz de su siervo.", "words": [[0, 187300], [7, 187883], [9, 188423], [19, 189103], [23, 189263], [27, 189403], [33, 189603], [35, 189723], [41, 190003], [44, 190203], [47, 190323], [53, 190703], [60, 191123], [62, 191723], [68, 192083], [77, 193110], [81, 193472], [90, 194392], [98, 195032], [102, 195412], [106, 195692], [109, 195892], [113, 196132], [116, 196312], [119, 196452]]}, {"verse": 28, "start": 197624, "end": 201900, "text": "Y mi lengua hablará de tu justicia, y de tu alabanza todo el día.", "words": [[0, 197624], [2, 197746], [5, 197846], [12, 198286], [20, 198826], [23, 198946], [26, 199106], [36, 199806], [38, 200226], [41, 200346], [44, 200486], [53, 201046], [58, 201246], [61, 201466]]}]}