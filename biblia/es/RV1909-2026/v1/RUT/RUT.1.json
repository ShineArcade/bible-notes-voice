{"book": "RUT", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 228682, "verses": [{"verse": 1, "start": 300, "end": 14313, "text": "Y aconteció en los días que gobernaban los jueces, que hubo hambre en la tierra. Y un varón de Belén de Judá, fue a morar en los campos de Moab, él y su mujer, y dos hijos suyos.", "words": [[0, 300], [2, 482], [12, 1302], [15, 1482], [19, 1622], [24, 2002], [28, 2342], [39, 3102], [43, 3342], [51, 4522], [55, 4582], [60, 4982], [67, 5442], [70, 5742], [73, 5902], [81, 6850], [83, 6973], [86, 7113], [92, 7473], [95, 7613], [101, 7953], [104, 8053], [110, 8473], [114, 8653], [116, 8793], [122, 9193], [125, 9313], [129, 9453], [136, 10013], [139, 10113], [145, 11133], [148, 11553], [150, 11773], [153, 11933], [160, 12393], [162, 12973], [166, 13213], [172, 13433]]}, {"verse": 2, "start": 14763, "end": 30373, "text": "El nombre de aquel varón era Elimelec, y el de su mujer Noemí; y los nombres de sus dos hijos eran, Mahlón y Quelión, efrateos de Belén de Judá. Llegaron pues a los campos de Moab, y asentaron allí.", "words": [[0, 14763], [3, 14904], [10, 15264], [13, 15464], [19, 15764], [25, 16224], [29, 16904], [39, 17584], [41, 18344], [44, 18484], [47, 18684], [50, 18864], [56, 19284], [63, 20422], [65, 20509], [69, 20629], [77, 21089], [80, 21249], [84, 21429], [88, 21649], [94, 22009], [100, 22639], [107, 23269], [109, 23829], [118, 24389], [127, 25049], [130, 25189], [136, 25569], [139, 25689], [145, 26559], [154, 27025], [159, 27265], [161, 27465], [165, 27605], [172, 28125], [175, 28245], [181, 28725], [183, 29185], [193, 29865]]}, {"verse": 3, "start": 30823, "end": 35334, "text": "Y murió Elimelec, marido de Noemí, y quedó ella con sus dos hijos;", "words": [[0, 30823], [2, 30952], [8, 31601], [18, 32252], [25, 32652], [28, 32792], [35, 33491], [37, 33631], [43, 33932], [48, 34131], [52, 34351], [56, 34531], [60, 34732]]}, {"verse": 4, "start": 35784, "end": 45539, "text": "Los cuales se casaron con mujeres moabitas, el nombre de la una Orfa, y el nombre de la otra Ruth; y habitaron allí unos diez años.", "words": [[0, 35784], [4, 35891], [11, 36091], [14, 36311], [22, 36771], [26, 36951], [34, 37931], [44, 38911], [47, 39031], [54, 39371], [57, 39591], [60, 39731], [64, 39931], [70, 40611], [72, 41291], [75, 41451], [82, 41851], [85, 42051], [88, 42191], [93, 42666], [99, 43382], [101, 43458], [111, 44018], [116, 44258], [121, 44528], [126, 44798]]}, {"verse": 5, "start": 45989, "end": 54206, "text": "Y murieron también los dos, Mahlón y Quelión, quedando así la mujer desamparada de sus dos hijos y de su marido.", "words": [[0, 45989], [2, 46130], [11, 46590], [19, 46950], [23, 47290], [28, 48060], [35, 48830], [37, 49500], [46, 50170], [55, 50530], [59, 50710], [62, 50830], [68, 51150], [80, 52030], [83, 52190], [87, 52390], [91, 52650], [97, 53050], [99, 53310], [102, 53410], [105, 53570]]}, {"verse": 6, "start": 54656, "end": 66044, "text": "Entonces se levantó con sus nueras, y se volvió de los campos de Moab: porque oyó en el campo de Moab que Jehová había visitado a su pueblo para darles pan.", "words": [[0, 54656], [9, 55323], [12, 56003], [20, 56523], [24, 56683], [28, 56863], [36, 57363], [38, 57963], [41, 58103], [48, 58463], [51, 58563], [55, 58683], [62, 59163], [65, 59263], [71, 60128], [78, 60389], [82, 60889], [85, 61049], [88, 61189], [94, 61509], [97, 61789], [102, 62369], [106, 62809], [113, 63329], [119, 63609], [128, 64289], [130, 64369], [133, 64489], [140, 64809], [145, 65109], [152, 65529]]}, {"verse": 7, "start": 66494, "end": 75627, "text": "Salió pues del lugar donde había estado, y con ella sus dos nueras, y comenzaron a caminar para volverse a la tierra de Judá.", "words": [[0, 66494], [6, 66875], [11, 67155], [15, 67415], [21, 67815], [27, 68135], [33, 68495], [41, 68935], [43, 69135], [47, 69355], [52, 69515], [56, 69735], [60, 69975], [68, 70415], [70, 71095], [81, 71695], [83, 71815], [91, 72275], [96, 72495], [105, 73035], [107, 73215], [110, 73235], [117, 73575], [120, 73775]]}, {"verse": 8, "start": 76077, "end": 87307, "text": "Y Noemí dijo a sus dos nueras: Andad, volveos cada una a la casa de su madre: Jehová haga con vosotras misericordia, como la habéis hecho con los muertos y conmigo.", "words": [[0, 76077], [2, 76077], [8, 76077], [13, 76445], [15, 76845], [19, 76965], [23, 77604], [31, 78431], [38, 78956], [46, 79496], [51, 79736], [55, 80136], [57, 80336], [60, 80376], [65, 80656], [68, 80856], [71, 80996], [78, 81850], [85, 82350], [90, 82610], [94, 82850], [103, 83390], [117, 84690], [122, 84810], [125, 85060], [132, 85310], [138, 85610], [142, 85810], [146, 85970], [154, 86450], [156, 86630]]}, {"verse": 9, "start": 87757, "end": 99696, "text": "Os conceda Jehová que halléis descanso, cada una en casa de su marido: las besó luego, y ellas lloraron a voz en grito.", "words": [[0, 87827], [3, 87897], [11, 88517], [18, 88957], [22, 89157], [30, 89537], [40, 90437], [45, 90687], [49, 90937], [52, 91097], [57, 91317], [60, 91557], [63, 91677], [71, 94847], [75, 95046], [80, 95646], [87, 96146], [89, 97026], [95, 97306], [104, 98246], [106, 98466], [110, 98706], [113, 99026]]}, {"verse": 10, "start": 100146, "end": 105401, "text": "Y le dijeron: Ciertamente nosotras volveremos contigo a tu pueblo.", "words": [[0, 100146], [2, 100295], [5, 100395], [14, 101410], [26, 102130], [35, 102690], [46, 103250], [54, 103730], [56, 103810], [59, 103890]]}, {"verse": 11, "start": 105751, "end": 114086, "text": "Y Noemí respondió: Volveos, hijas mías: ¿para qué habéis de ir conmigo? ¿tengo yo más hijos en el vientre, que puedan ser vuestros maridos?", "words": [[0, 105751], [2, 105983], [8, 106253], [19, 107304], [28, 107909], [34, 108229], [40, 109117], [46, 109286], [50, 109446], [57, 109746], [60, 109866], [63, 109966], [72, 110968], [79, 111165], [82, 111325], [86, 111505], [92, 111725], [95, 111965], [98, 112085], [107, 112445], [111, 112545], [118, 112785], [122, 113025], [131, 113385]]}, {"verse": 12, "start": 114536, "end": 124883, "text": "Volveos, hijas mías, e idos; que yo ya soy vieja para tener marido. Y aunque dijese: Esperanza tengo; y esta noche fuese con varón, y aun pariese hijos;", "words": [[0, 114536], [9, 115062], [15, 115282], [21, 115689], [23, 116096], [29, 116764], [33, 116848], [36, 116988], [39, 117128], [43, 117288], [49, 117668], [54, 117848], [60, 118088], [68, 119040], [70, 119168], [77, 119328], [85, 120294], [95, 120902], [102, 121739], [104, 121865], [109, 122065], [115, 122305], [121, 122705], [125, 122925], [132, 123405], [134, 123625], [138, 123745], [146, 124225]]}, {"verse": 13, "start": 125333, "end": 140494, "text": "¿Habíais vosotras de esperarlos hasta que fuesen grandes? ¿habíais vosotras de quedaros sin casar por amor de ellos? No, hijas mías; que mayor amargura tengo yo que vosotras, pues la mano de Jehová ha salido contra mí.", "words": [[0, 125333], [9, 125716], [18, 126276], [21, 126376], [32, 126916], [38, 127156], [42, 127296], [49, 127716], [58, 128690], [67, 129074], [76, 129634], [79, 129754], [88, 130114], [92, 130314], [98, 130674], [102, 130854], [107, 131054], [110, 131274], [117, 132047], [121, 132277], [127, 132697], [133, 133623], [137, 133707], [143, 134007], [152, 134547], [158, 134827], [161, 135047], [165, 135187], [175, 136227], [180, 136307], [183, 136527], [188, 136747], [191, 137067], [198, 137387], [201, 137547], [208, 137967], [215, 138267]]}, {"verse": 14, "start": 140844, "end": 148462, "text": "Mas ellas alzando otra vez su voz, lloraron: y Orfa besó a su suegra, mas Ruth se quedó con ella.", "words": [[0, 140844], [4, 141049], [10, 141709], [18, 142249], [23, 142509], [27, 142809], [30, 143009], [35, 143729], [45, 144980], [47, 145205], [52, 145430], [57, 145655], [59, 145967], [62, 146279], [70, 146591], [74, 146903], [79, 147215], [82, 147555], [88, 147895], [92, 148095]]}, {"verse": 15, "start": 148912, "end": 156201, "text": "Y Noemí dijo: He aquí tu cuñada se ha vuelto a su pueblo y a sus dioses; vuélvete tú tras ella.", "words": [[0, 148912], [2, 149137], [8, 149397], [14, 150402], [17, 150402], [22, 150742], [25, 150942], [32, 151442], [35, 151622], [38, 151722], [45, 152022], [47, 152142], [50, 152242], [57, 152602], [59, 152842], [61, 152902], [65, 153082], [73, 154105], [82, 154533], [85, 154733], [90, 154973]]}, {"verse": 16, "start": 156551, "end": 169828, "text": "Y Ruth respondió: No me ruegues que te deje, y me aparte de ti: porque donde quiera que tú vayas, iré yo; y donde quiera que vivas, viviré. Tu pueblo será mi pueblo, y tu Dios mi Dios.", "words": [[0, 156551], [2, 156983], [7, 157453], [18, 158822], [21, 159009], [24, 159259], [32, 159509], [36, 159649], [39, 159809], [45, 160209], [47, 160429], [50, 160549], [57, 160969], [60, 161089], [64, 161742], [71, 161945], [77, 162125], [84, 162545], [88, 162685], [91, 162845], [98, 163345], [102, 163685], [106, 164370], [108, 164478], [114, 164598], [121, 165018], [125, 165178], [132, 165798], [140, 166622], [143, 166703], [150, 167063], [155, 167363], [158, 167583], [166, 168043], [168, 168623], [171, 168783], [176, 169063], [179, 169323]]}, {"verse": 17, "start": 170278, "end": 180102, "text": "Donde tú mueras, moriré yo, y allí seré sepultada: que el Señor me castigue severamente si algo que no sea la muerte me separa de ti.", "words": [[0, 170278], [6, 170483], [9, 170763], [17, 171163], [24, 171683], [28, 172303], [30, 172363], [35, 172583], [40, 172963], [51, 175316], [55, 175398], [58, 175518], [64, 175818], [67, 176078], [76, 176578], [88, 177398], [91, 177618], [96, 177878], [100, 178058], [103, 178198], [107, 178418], [110, 178618], [117, 178898], [120, 179158], [127, 179638], [130, 179758]]}, {"verse": 18, "start": 180452, "end": 185693, "text": "Y viendo Noemí que estaba tan resuelta a ir con ella, dejó de insistirle.", "words": [[0, 180452], [2, 180578], [9, 180898], [15, 181578], [19, 181638], [26, 181958], [30, 182238], [39, 182838], [41, 182938], [44, 183078], [48, 183298], [54, 183998], [59, 184418], [62, 184518]]}, {"verse": 19, "start": 186143, "end": 198708, "text": "Anduvieron pues ellas dos hasta que llegaron a Belén: y aconteció que entrando en Belén, toda la ciudad se conmovió por razón de ellas, y decían: ¿No es esta Noemí?", "words": [[0, 186143], [11, 186480], [16, 186860], [22, 187240], [26, 187620], [32, 188320], [36, 188480], [45, 188900], [47, 188980], [54, 189890], [56, 190010], [66, 190690], [70, 190950], [79, 191410], [82, 191590], [89, 192550], [94, 192730], [97, 193010], [104, 193330], [107, 193670], [116, 194390], [120, 194590], [126, 194970], [129, 195290], [136, 196010], [138, 196330], [146, 197428], [150, 197612], [153, 197872], [158, 198112]]}, {"verse": 20, "start": 199058, "end": 207342, "text": "Y ella les respondía: No me llaméis Noemí, sino llamadme Mara: porque en grande amargura me ha puesto el Todopoderoso.", "words": [[0, 199058], [2, 199241], [7, 199561], [11, 199841], [22, 201146], [25, 201332], [28, 201452], [36, 201892], [43, 202732], [48, 203182], [57, 203632], [63, 204364], [70, 204541], [73, 204721], [80, 205001], [89, 205561], [92, 205721], [95, 205861], [102, 206101], [105, 206281]]}, {"verse": 21, "start": 207792, "end": 217301, "text": "Yo me fui llena, pero vacía me ha vuelto Jehová. ¿Por qué me llamaréis Noemí, ya que Jehová ha dado testimonio contra mí, y el Todopoderoso me ha afligido?", "words": [[0, 207792], [3, 207957], [6, 208077], [10, 208237], [17, 208937], [22, 209077], [28, 209577], [31, 209717], [34, 209797], [41, 210269], [49, 210979], [54, 211079], [58, 211239], [61, 211379], [71, 211859], [78, 212699], [81, 212959], [85, 213099], [92, 213539], [95, 213599], [100, 213799], [111, 214459], [118, 214739], [122, 214979], [124, 215419], [127, 215559], [140, 216279], [143, 216479], [146, 216619]]}, {"verse": 22, "start": 217651, "end": 228282, "text": "Así volvió Noemí y Ruth moabita su nuera con ella; volvió de los campos de Moab, y llegaron a Belén en el principio de la siega de las cebadas.", "words": [[0, 217651], [4, 217971], [11, 218471], [17, 218871], [19, 219151], [24, 219431], [32, 220171], [35, 220411], [41, 220771], [45, 221051], [51, 221862], [58, 222387], [61, 222507], [65, 222627], [72, 223167], [75, 223247], [81, 223787], [83, 224247], [92, 224667], [94, 224927], [100, 225307], [103, 225507], [106, 225667], [116, 226187], [119, 226567], [122, 226817], [128, 227067], [131, 227247], [135, 227407]]}]}