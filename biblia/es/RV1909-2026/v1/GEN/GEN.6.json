3, 170923], [87, 171083], [94, 171463], [99, 171783], [108, 173011], [114, 173557], [116, 173697], [123, 174097]]}, {"verse": 20, "start": 175247, "end": 186075, "text": "De las aves según su especie, y de las bestias según su especie, de todo reptil de la tierra según su especie, dos de cada especie entrarán contigo para que hayan vida.", "words": [[0, 175247], [3, 175348], [7, 175488], [12, 175968], [18, 176248], [21, 176468], [30, 176948], [32, 177143], [35, 177223], [39, 177363], [47, 177843], [53, 178083], [56, 178323], [65, 179223], [68, 179343], [73, 179563], [80, 180143], [83, 180223], [86, 180323], [93, 180723], [99, 181063], [102, 181343], [111, 182434], [115, 182675], [118, 182915], [123, 183155], [131, 183735], [140, 184395], [148, 184935], [153, 185175], [157, 185355], [163, 185655]]}, {"verse": 21, "start": 186668, "end": 192943, "text": "Y toma contigo de todo alimento que se come, y almacénalo; servirá de alimento para ti y para ellos.", "words": [[0, 186668], [2, 186766], [7, 187046], [15, 187626], [18, 187786], [23, 187946], [32, 188406], [36, 188606], [39, 188746], [45, 189066], [47, 189426], [59, 190676], [67, 191203], [70, 191283], [79, 191683], [84, 191963], [87, 192223], [89, 192483], [94, 192683]]}, {"verse": 22, "start": 193507, "end": 198084, "text": "Y lo hizo así Noé; hizo conforme a todo lo que Dios le mandó.", "words": [[0, 193507], [2, 193650], [5, 193770], [10, 193990], [14, 194475], [19, 195136], [24, 195360], [33, 196180], [35, 196280], [40, 196600], [43, 196860], [47, 197000], [52, 197240], [55, 197420]]}]}