{"book": "PSA", "chapter": 145, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 128442, "verses": [{"verse": 1, "start": 300, "end": 8883, "text": "Salmo de alabanza: de David. TE ENSALZARÉ, mi Dios, mi Rey; y bendeciré tu nombre por siglo y para siempre.", "words": [[0, 300], [6, 787], [9, 947], [19, 1991], [22, 2195], [29, 3017], [32, 3159], [43, 3919], [46, 4139], [52, 4779], [55, 4879], [60, 5624], [62, 5739], [72, 6479], [75, 6619], [82, 6939], [86, 7199], [92, 7679], [94, 7879], [99, 8059]]}, {"verse": 2, "start": 9233, "end": 14349, "text": "Cada día te bendeciré, y alabaré tu nombre por siglo y para siempre.", "words": [[0, 9233], [5, 9510], [9, 9810], [12, 9990], [23, 10830], [25, 11210], [33, 11690], [36, 11870], [43, 12250], [47, 12530], [53, 13070], [55, 13310], [60, 13510]]}, {"verse": 3, "start": 14699, "end": 20693, "text": "Grande es Jehová y digno de suprema alabanza: y su grandeza es inescrutable.", "words": [[0, 14699], [7, 15104], [10, 15484], [17, 15864], [19, 16044], [25, 16564], [28, 16834], [36, 17104], [46, 18182], [48, 18306], [51, 18466], [60, 19165], [63, 19955]]}, {"verse": 4, "start": 21043, "end": 27275, "text": "Generación a generación narrará tus obras, y anunciarán tus poderosos hechos.", "words": [[0, 21043], [11, 21799], [13, 22019], [24, 22799], [32, 23539], [36, 23759], [43, 24219], [45, 24739], [56, 25459], [60, 25679], [70, 26579]]}, {"verse": 5, "start": 27625, "end": 32523, "text": "La hermosura de la gloria de tu magnificencia, y tus hechos maravillosos, hablaré.", "words": [[0, 27625], [3, 27742], [13, 28502], [16, 28662], [19, 28802], [26, 29182], [29, 29302], [32, 29442], [47, 30422], [49, 30522], [53, 30722], [60, 31002], [74, 31802]]}, {"verse": 6, "start": 32873, "end": 37829, "text": "Y lo temible de tus proezas dirán los hombres; y yo contaré tu grandeza.", "words": [[0, 32873], [2, 33116], [5, 33236], [13, 33736], [16, 33896], [20, 34256], [28, 34616], [34, 35076], [38, 35236],