{"book": "JHN", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 290266, "verses": [{"verse": 1, "start": 300, "end": 11375, "text": "De cierto, de cierto os digo: El que no entra por la puerta en el corral de las ovejas, sino que sube por otra parte, el tal es ladrón y asaltante.", "words": [[0, 517], [3, 771], [11, 1024], [14, 1277], [21, 1531], [24, 1784], [30, 2557], [33, 2699], [37, 2859], [40, 3099], [46, 3519], [50, 3739], [53, 3919], [60, 4199], [63, 4499], [66, 4769], [73, 5039], [76, 5179], [80, 5359], [88, 6159], [93, 6399], [97, 6599], [102, 6919], [106, 7119], [111, 7359], [118, 8539], [121, 8739], [125, 8919], [128, 9139], [135, 9979], [137, 10299]]}, {"verse": 2, "start": 11725, "end": 15327, "text": "Pero el que entra por la puerta, el pastor de las ovejas es.", "words": [[0, 11725], [5, 11867], [8, 12047], [12, 12247], [18, 12447], [22, 12687], [25, 12867], [33, 13507], [36, 13627], [43, 14167], [46, 14427], [50, 14567], [57, 15007]]}, {"verse": 3, "start": 15327, "end": 22951, "text": "A este abre el portero, y las ovejas oyen su voz: y a sus ovejas llama por nombre, y las saca.", "words": [[0, 15427], [2, 15527], [7, 16067], [12, 16287], [15, 16547], [24, 17287], [26, 17587], [30, 17747], [37, 18247], [42, 18667], [45, 18847], [50, 19571], [52, 19676], [54, 19756], [58, 19876], [65, 20456], [71, 21016], [75, 21356], [83, 21816], [85, 22096], [89, 22376]]}, {"verse": 4, "start": 23301, "end": 30771, "text": "Y como ha sacado fuera todas las propias, va delante de ellas; y las ovejas le siguen, porque conocen su voz.", "words": [[0, 23301], [2, 23406], [7, 23646], [10, 23846], [17, 24306], [23, 24566], [29, 24946], [33, 25246], [42, 25726], [45, 25906], [53, 26366], [56, 26546], [63, 27375], [65, 27483], [69, 27623], [76, 28063], [79, 28243], [87, 28823], [94, 29443], [102, 30083], [105, 30263]]}, {"verse": 5, "start": 31121, "end": 38548, "text": "Pero al extraño no seguirán, antes huirán de él: porque no conocen la voz de los extraños.", "words": [[0, 31121], [5, 31321], [8, 31461], [16, 32101], [19, 32581], [29, 33241], [35, 34301], [42, 34741], [45, 34961], [49, 35579], [56, 35803], [59, 36043], [67, 36703], [70, 36883], [74, 37123], [77, 37303], [81, 37423]]}, {"verse": 6, "start": 38898, "end": 44429, "text": "Esta parábola les dijo Jesús; pero ellos no entendieron qué era lo que les decía.", "words": [[0, 38898], [5, 39124], [14, 39664], [18, 39904], [23, 40204], [30, 41138], [35, 41282], [41, 41502], [44, 41762], [56, 42442], [60, 42842], [64, 43142], [67, 43322], [71, 43442], [75, 43642]]}, {"verse": 7, "start": 44779, "end": 51874, "text": "Les volvió, pues, Jesús a decir: De cierto, de cierto os digo: Yo soy la puerta de las ovejas.", "words": [[0, 44779], [4, 44955], [12, 45686], [18, 45966], [24, 46490], [26, 47014], [33, 47914], [36, 48168], [44, 48421], [47, 48674], [54, 48928], [57, 49181], [63, 49954], [66, 50142], [70, 50342], [73, 50522], [80, 50802], [83, 51022], [87, 51162]]}, {"verse": 8, "start": 52224, "end": 58918, "text": "Todos los que antes de mí vinieron, ladrones son y asaltantes; pero no los oyeron las ovejas.", "words": [[0, 52224], [6, 52486], [10, 52926], [14, 53106], [20, 53406], [23, 53606], [26, 53726], [36, 54686], [45, 55046], [49, 55426], [51, 55746], [63, 57039], [68, 57182], [71, 57462], [75, 57742], [82, 58022], [86, 58470]]}, {"verse": 9, "start": 59268, "end": 66359, "text": "Yo soy la puerta: el que por mí entra, será salvo; y entrará, y saldrá, y hallará pastos.", "words": [[0, 59268], [3, 59413], [7, 59593], [10, 59793], [18, 60621], [21, 60763], [25, 60903], [29, 61216], [32, 61530], [39, 61843], [44, 62263], [51, 63251], [53, 63369], [62, 64009], [64, 64209], [72, 64989], [74, 65189], [82, 65489]]}, {"verse": 10, "start": 66709, "end": 75496, "text": "El ladrón no viene sino para hurtar, y matar, y destruir: yo he venido para que tengan vida, y para que la tengan en abundancia.", "words": [[0, 66709], [3, 66856], [10, 67316], [13, 67496], [19, 67736], [24, 68116], [29, 68456], [37, 69216], [39, 69436], [46, 69776], [48, 70136], [58, 71274], [61, 71483], [64, 71623], [71, 71983], [76, 72183], [80, 72323], [87, 72663], [93, 73103], [95, 73358], [100, 73598], [104, 73758], [107, 73878], [114, 74198], [117, 74458]]}, {"verse": 11, "start": 75846, "end": 80397, "text": "Yo soy el buen pastor: el buen pastor su vida da por las ovejas.", "words": [[0, 75846], [3, 76031], [7, 76271], [10, 76471], [15, 76611], [23, 77569], [26, 77825], [31, 78005], [38, 78425], [41, 78685], [46, 78945], [49, 79105], [53, 79345], [57, 79545]]}, {"verse": 12, "start": 80747, "end": 93447, "text": "Pero el asalariado, que no es el pastor y a quien no pertenecen las ovejas, ve al lobo que viene, y deja las ovejas, y huye, y el lobo las arrebata, y esparce las ovejas.", "words": [[0, 80747], [5, 80892], [8, 81032], [20, 81872], [24, 81972], [27, 82112], [30, 82252], [33, 82372], [40, 82832], [42, 83147], [44, 83267], [50, 83387], [53, 83887], [64, 84387], [68, 84547], [76, 85367], [79, 85687], [82, 86007], [87, 86427], [91, 86587], [98, 86887], [100, 87167], [105, 87547], [109, 87667], [117, 88207], [119, 88707], [125, 89455], [127, 89639], [130, 89819], [135, 90159], [139, 90689], [149, 91219], [151, 91799], [159, 92379], [163, 92619]]}, {"verse": 13, "start": 93797, "end": 100077, "text": "Así que, el asalariado, huye, porque es asalariado, y no tiene cuidado de las ovejas.", "words": [[0, 93797], [4, 94166], [9, 94386], [12, 94566], [24, 95566], [30, 96166], [37, 96706], [40, 97046], [52, 98006], [54, 98146], [57, 98266], [63, 98506], [71, 98946], [74, 99206], [78, 99366]]}, {"verse": 14, "start": 100427, "end": 105855, "text": "Yo soy el buen pastor; y conozco mis ovejas, y las mías me conocen.", "words": [[0, 100427], [3, 100747], [7, 100987], [10, 101227], [15, 101387], [23, 102235], [25, 102363], [33, 102983], [37, 103183], [45, 103843], [47, 104343], [51, 104503], [56, 104883], [59, 105023]]}, {"verse": 15, "start": 106205, "end": 112020, "text": "Como el Padre me conoce, y yo conozco al Padre; y pongo mi vida por las ovejas.", "words": [[0, 106205], [5, 106513], [8, 106653], [14, 106933], [17, 107173], [25, 107813], [27, 108233], [30, 108373], [38, 108833], [41, 108973], [48, 109669], [50, 109909], [56, 110289], [59, 110509], [64, 110769], [68, 111029], [72, 111229]]}, {"verse": 16, "start": 112370, "end": 122269, "text": "También tengo otras ovejas que no son de este redil; aquellas también me conviene traer, y oirán mi voz; y habrá un rebaño, y un pastor.", "words": [[0, 112370], [8, 112655], [14, 113115], [20, 113415], [27, 113935], [31, 114215], [34, 114415], [38, 114675], [41, 114895], [46, 115418], [53, 116092], [62, 116557], [70, 116837], [73, 117037], [82, 117457], [89, 118137], [91, 118517], [97, 118957], [100, 119137], [105, 119926], [107, 120056], [113, 120316], [116, 120676], [124, 121036], [126, 121456], [129, 121893]]}, {"verse": 17, "start": 122619, "end": 127558, "text": "Por eso me ama el Padre, porque yo pongo mi vida, para volverla a tomar.", "words": [[0, 122619], [4, 122743], [8, 122943], [11, 123183], [15, 123403], [18, 123583], [25, 124323], [32, 124563], [35, 124803], [41, 125323], [44, 125503], [50, 125863], [55, 126363], [64, 126963], [66, 127043]]}, {"verse": 18, "start": 127908, "end": 138349, "text": "Nadie me la quita, pero yo la pongo de mí mismo. Tengo poder para ponerla, y tengo poder para volverla a tomar. Este mandamiento recibí de mi Padre.", "words": [[0, 127908], [6, 128312], [9, 128432], [12, 128572], [19, 129092], [24, 129172], [27, 129372], [30, 129492], [36, 130112], [39, 130292], [42, 130432], [49, 131238], [55, 131461], [61, 131821], [66, 132381], [75, 132941], [77, 133541], [83, 133821], [89, 134241], [94, 134561], [103, 135221], [105, 135341], [112, 136124], [117, 136312], [129, 136892], [136, 137512], [139, 137572], [142, 137732]]}, {"verse": 19, "start": 138699, "end": 142196, "text": "Y volvió a haber división entre los judíos por estas palabras.", "words": [[0, 138699], [2, 138804], [9, 139224], [11, 139324], [17, 139504], [26, 140084], [32, 140324], [36, 140504], [43, 140964], [47, 141184], [53, 141344]]}, {"verse": 20, "start": 142196, "end": 147471, "text": "Y muchos de ellos decían: Demonio tiene, y está fuera de sí; ¿para qué le oís?", "words": [[0, 142196], [2, 142416], [9, 142676], [12, 142936], [18, 143196], [26, 144253], [34, 144712], [41, 145012], [43, 145192], [48, 145432], [54, 145692], [57, 145912], [61, 146483], [67, 146640], [71, 146820], [74, 146940]]}, {"verse": 21, "start": 147751, "end": 153683, "text": "Decían otros: Estas palabras no son de endemoniado: ¿puede el demonio abrir los ojos de los ciegos?", "words": [[0, 147751], [7, 148276], [14, 149247], [20, 149509], [29, 149829], [32, 150109], [36, 150369], [39, 150844], [52, 151482], [59, 151703], [62, 151803], [70, 152203], [76, 152363], [80, 152563], [85, 152803], [88, 152983], [92, 153103]]}, {"verse": 22, "start": 153963, "end": 158867, "text": "Y se hacía la fiesta de la dedicación en Jerusalén; y era invierno;", "words": [[0, 153963], [2, 154067], [5, 154187], [11, 154467], [14, 154627], [21, 155007], [24, 155167], [27, 155267], [38, 155987], [41, 156227], [52, 157370], [54, 157747], [58, 157887]]}, {"verse": 23, "start": 159217, "end": 163001, "text": "Y Jesús andaba en el templo por el portal de Salomón.", "words": [[0, 159217], [2, 159345], [8, 159725], [15, 160445], [18, 160585], [21, 160725], [28, 161305], [32, 161485], [35, 161605], [42, 162025], [45, 162245]]}, {"verse": 24, "start": 163351, "end": 171895, "text": "Y le rodearon los judíos y le dijeron: ¿Hasta cuándo nos vas a mantener en duda? Si tú eres el Cristo, dínoslo abiertamente.", "words": [[0, 163351], [2, 163651], [5, 163791], [14, 164451], [18, 164631], [25, 165371], [27, 165516], [30, 165636], [39, 166562], [46, 166789], [53, 167029], [57, 167309], [61, 167489], [63, 167629], [72, 167969], [75, 168229], [81, 168859], [84, 169044], [87, 169224], [92, 169444], [95, 169604], [103, 170544], [111, 170964]]}, {"verse": 25, "start": 172175, "end": 180423, "text": "Les respondió Jesús: Os lo he dicho, y no creéis: las obras que yo hago en nombre de mi Padre, ellas dan testimonio de mí;", "words": [[0, 172175], [4, 172324], [14, 172904], [21, 173762], [24, 173887], [27, 174067], [30, 174147], [37, 174447], [39, 174667], [42, 174787], [50, 175849], [54, 176085], [60, 176355], [64, 176535], [67, 176755], [72, 176995], [75, 177135], [82, 177455], [85, 177675], [88, 177835], [95, 178515], [101, 178975], [105, 179235], [116, 179995], [119, 180115]]}, {"verse": 26, "start": 180773, "end": 185843, "text": "Pero vosotros no creéis, porque no sois de mis ovejas, como os he dicho.", "words": [[0, 180773], [5, 180957], [14, 181417], [17, 181657], [25, 182337], [32, 182937], [35, 183217], [40, 183657], [43, 183817], [47, 183957], [55, 184737], [60, 184957], [63, 185217], [66, 185297]]}, {"verse": 27, "start": 186193, "end": 190356, "text": "Mis ovejas oyen mi voz, y yo las conozco, y me siguen;", "words": [[0, 186193], [4, 186341], [11, 186921], [16, 187521], [19, 187721], [24, 188001], [26, 188241], [29, 188401], [33, 188541], [42, 189201], [44, 189621], [47, 189741]]}, {"verse": 28, "start": 190706, "end": 197594, "text": "Y yo les doy vida eterna: y no perecerán para siempre, ni nadie las arrebatará de mi mano.", "words": [[0, 190706], [2, 190833], [5, 190993], [9, 191133], [13, 191373], [18, 191593], [26, 192598], [28, 192728], [31, 192888], [41, 193668], [46, 193908], [55, 194588], [58, 195268], [64, 195628], [68, 196028], [79, 196768], [82, 196928], [85, 197048]]}, {"verse": 29, "start": 197944, "end": 205290, "text": "Mi Padre que me las dio, mayor que todos es: y nadie las puede arrebatar de la mano de mi Padre.", "words": [[0, 197944], [3, 198069], [9, 198469], [13, 198729], [16, 198879], [20, 199029], [25, 199729], [31, 200109], [35, 200349], [41, 200769], [45, 201813], [47, 201937], [53, 202257], [57, 202517], [63, 203107], [73, 203697], [76, 203817], [79, 203977], [84, 204217], [87, 204397], [90, 204537]]}, {"verse": 30, "start": 205640, "end": 207941, "text": "Yo y el Padre somos uno.", "words": [[0, 205640], [3, 205965], [5, 206205], [8, 206365], [14, 206845], [20, 207085]]}, {"verse": 31, "start": 208291, "end": 212849, "text": "Entonces volvieron a tomar piedras los judíos para apedrearle.", "words": [[0, 208291], [9, 209191], [19, 209831], [21, 209951], [27, 210191], [35, 210691], [39, 210851], [46, 211351], [51, 211571]]}, {"verse": 32, "start": 213199, "end": 220995, "text": "Les respondió Jesús: Muchas buenas obras os he mostrado de mi Padre; ¿por cuál obra de esas me apedreáis?", "words": [[0, 213199], [4, 213348], [14, 213928], [21, 214966], [28, 215146], [35, 215566], [41, 216346], [44, 216486], [47, 216746], [56, 217286], [59, 217506], [62, 217646], [69, 218556], [74, 218679], [79, 218939], [84, 219359], [87, 219599], [92, 219839], [95, 220079]]}, {"verse": 33, "start": 221345, "end": 230414, "text": "Le respondieron los judíos, diciendo: Por buena obra no te apedreamos, sino por la blasfemia; y porque tú, siendo hombre, te haces Dios.", "words": [[0, 221345], [3, 221493], [16, 222253], [20, 222493], [28, 223213], [38, 224457], [42, 224577], [48, 224777], [53, 225077], [56, 225277], [59, 225437], [71, 226297], [76, 226437], [80, 226657], [83, 226797], [94, 227747], [96, 227845], [103, 228065], [107, 228385], [114, 228905], [122, 229325], [125, 229565], [131, 229845]]}, {"verse": 34, "start": 230694, "end": 236488, "text": "Les respondió Jesús: ¿No está escrito en vuestra ley: Yo dije, Dioses sois?", "words": [[0, 230694], [4, 230842], [14, 231422], [21, 232280], [25, 232407], [30, 232607], [38, 232927], [41, 233227], [49, 233567], [54, 235147], [57, 235147], [63, 235147], [70, 235811]]}, {"verse": 35, "start": 236838, "end": 244461, "text": "Si dijo, dioses, a aquellos a los cuales vino la palabra de Dios (y la Escritura no puede ser quebrantada);", "words": [[0, 236838], [3, 237061], [9, 237401], [17, 238001], [19, 238761], [28, 239101], [30, 239361], [34, 239501], [41, 239681], [46, 240021], [49, 240221], [57, 240561], [60, 240801], [65, 241101], [68, 241561], [71, 241721], [81, 242441], [84, 242816], [90, 243056], [94, 243356]]}, {"verse": 36, "start": 244811, "end": 252737, "text": "¿A quien el Padre santificó y envió al mundo, vosotros decís: Tú blasfemas, porque dije: Hijo de Dios soy?", "words": [[0, 244811], [3, 244998], [9, 245118], [12, 245298], [18, 245758], [28, 246598], [30, 246738], [36, 247118], [39, 247278], [46, 248098], [55, 248698], [62, 249830], [65, 250166], [76, 250503], [83, 250763], [89, 251513], [94, 251780], [97, 251960], [102, 252160]]}, {"verse": 37, "start": 253087, "end": 256285, "text": "Si no hago obras de mi Padre, no me creáis.", "words": [[0, 253087], [3, 253307], [6, 253487], [11, 253867], [17, 254267], [20, 254467], [23, 254587], [30, 255167], [33, 255287], [36, 255427]]}, {"verse": 38, "start": 256635, "end": 266819, "text": "Pero si las hago, aunque a mí no creáis, creed a las obras; para que conozcáis y creáis que el Padre está en mí, y yo en el Padre.", "words": [[0, 256635], [5, 256800], [8, 256980], [12, 257200], [18, 258200], [25, 258400], [27, 258580], [30, 258700], [33, 258820], [41, 259800], [47, 260240], [49, 260300], [53, 260520], [60, 261410], [65, 261534], [69, 261694], [79, 262454], [81, 262694], [88, 263274], [92, 263534], [95, 263694], [101, 264174], [106, 264394], [109, 264634], [113, 264954], [115, 265454], [118, 265734], [121, 265974], [124, 266094]]}, {"verse": 39, "start": 267169, "end": 271692, "text": "Y procuraban otra vez prenderle; pero él se salió de sus manos;", "words": [[0, 267169], [2, 267276], [13, 267896], [18, 268096], [22, 268316], [33, 269256], [38, 269417], [41, 269757], [44, 270157], [50, 270617], [53, 270757], [57, 270957]]}, {"verse": 40, "start": 272042, "end": 279192, "text": "Y se volvió tras el Jordán, a aquel lugar donde primero había estado bautizando Juan; y se quedó allí.", "words": [[0, 272042], [2, 272242], [5, 272382], [12, 272862], [17, 273002], [20, 273222], [28, 273762], [30, 273982], [36, 274362], [42, 274662], [48, 275042], [56, 275562], [62, 275862], [69, 276222], [80, 277182], [86, 278066], [88, 278230], [91, 278290], [97, 278741]]}, {"verse": 41, "start": 279542, "end": 286981, "text": "Y muchos venían a él, y decían: Juan, a la verdad, ninguna señal hizo; pero todo lo que Juan dijo de este, era verdad.", "words": [[0, 279542], [2, 279652], [9, 279912], [16, 280392], [18, 280552], [22, 280732], [24, 280892], [32, 281902], [38, 282130], [40, 282290], [43, 282350], [51, 283090], [59, 283330], [65, 283850], [71, 284446], [76, 284564], [81, 284784], [84, 284984], [88, 285104], [93, 285324], [98, 285604], [101, 285804], [107, 286164], [111, 286464]]}, {"verse": 42, "start": 287261, "end": 289866, "text": "Y muchos creyeron allí en él.", "words": [[0, 287261], [2, 287386], [9, 287813], [18, 288239], [23, 288666], [26, 288846]]}]}