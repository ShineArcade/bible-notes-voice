{"book": "PSA", "chapter": 107, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 237312, "verses": [{"verse": 1, "start": 300, "end": 5782, "text": "O give thanks to the LORD, for he is good: for his mercy endures for ever.", "words": [[0, 300], [2, 448], [7, 708], [14, 1128], [17, 1408], [21, 1568], [27, 2188], [31, 2348], [34, 2528], [37, 2668], [43, 3495], [47, 3641], [51, 3821], [57, 4241], [65, 4776], [69, 5310]]}, {"verse": 2, "start": 6232, "end": 11091, "text": "Let the redeemed of the LORD say so, whom he has redeemed from the hand of the enemy;", "words": [[0, 6232], [4, 6380], [8, 6580], [17, 7100], [20, 7240], [24, 7380], [29, 7660], [33, 7960], [37, 8560], [42, 8740], [45, 8940], [49, 9140], [58, 9700], [63, 9900], [67, 10060], [72, 10320], [75, 10480], [79, 10640]]}, {"verse": 3, "start": 11541, "end": 17739, "text": "And gathered them out of the lands, from the east, and from the west, from the north, and from the south.", "words": [[0, 11541], [4, 11669], [13, 12029], [18, 12289], [22, 12469], [25, 12589], [29, 12709], [36, 13549], [41, 13789], [45, 13929], [51, 14349], [55, 14809], [60, 15009], [64, 15169], [70, 15769], [75, 15969], [79, 16129], [86, 16909], [90, 17009], [95, 17189], [99, 17349]]}, {"verse": 4, "start": 18189, "end": 23672, "text": "They wandered in the wilderness in a solitary way; they found no city to dwell in.", "words": [[0, 18189], [5, 18509], [14, 19049], [17, 19169], [21, 19269], [32, 19729], [35, 20109], [37, 20209], [46, 20729], [51, 21624], [56, 21732], [62, 22012], [65, 22432], [70, 22792], [73, 23012], [79, 23272]]}, {"verse": 5, "start": 24122, "end": 26714, "text": "Hungry and thirsty, their soul fainted in them.", "words": [[0, 24122], [7, 24571], [11, 24711], [20, 25271], [26, 25391], [31, 25731], [39, 26251], [42, 26391]]}, {"verse": 6, "start": 27164, "end": 31709, "text": "Then they cried to the LORD in their trouble, and he delivered them out of their distresses.", "words": [[0, 27164], [5, 27312], [10, 27452], [16, 27772], [19, 28011], [23, 28152], [28, 28391], [31, 28571], [37, 28711], [46, 29292], [50, 29612], [53, 29711], [63, 30051], [68, 30351], [72, 30591], [75, 30691], [81, 30851]]}, {"verse": 7, "start": 32159, "end": 36556, "text": "And he led them forth by the right way, that they might go to a city of habitation.", "words": [[0, 32159], [4, 32288], [7, 32388], [11, 32568], [16, 32768], [22, 33048], [25, 33308], [29, 33428], [35, 33688], [40, 34248], [45, 34628], [50, 34788], [56, 34948], [59, 35188], [62, 35308], [64, 35428], [69, 35668], [72, 35828]]}, {"verse": 8, "start": 37006, "end": 43162, "text": "Oh that men would praise the LORD for his goodness, and for his wonderful works to the children of men!", "words": [[0, 37006], [3, 37292], [8, 37412], [12, 37692], [18, 37932], [25, 38352], [29, 38612], [34, 38932], [38, 39172], [42, 39372], [52, 39792], [56, 40472], [60, 40632], [64, 40792], [74, 41212], [80, 41672], [83, 41932], [87, 42072], [96, 42452], [99, 42672]]}, {"verse": 9, "start": 43612, "end": 48299, "text": "For he satisfies the longing soul, and fills the hungry soul with goodness.", "words": [[0, 43612], [4, 43719], [7, 43839], [17, 44399], [21, 44799], [29, 45119], [35, 45599], [39, 46139], [45, 46419], [49, 46679], [56, 46959], [61, 47319], [66, 47539]]}, {"verse": 10, "start": 48749, "end": 53922, "text": "Such as sit in darkness and in the shadow of death, being bound in affliction and iron;", "words": [[0, 48749], [5, 48969], [8, 49149], [12, 49389], [15, 49589], [24, 50089], [28, 50429], [31, 50569], [35, 50669], [42, 50989], [45, 51209], [52, 51969], [58, 52169], [64, 52549], [67, 52769], [78, 53249], [82, 53429]]}, {"verse": 11, "start": 54372, "end": 59200, "text": "Because they rebelled against the words of God, and contemned the counsel of the most High:", "words": [[0, 54372], [8, 54560], [13, 54780], [22, 55280], [30, 55480], [34, 55720], [40, 55980], [43, 56140], [48, 56480], [52, 56910], [62, 57340], [66, 57660], [74, 58040], [77, 58280], [81, 58420], [86, 58560]]}, {"verse": 12, "start": 59650, "end": 64581, "text": "Therefore he brought down their heart with labour; they fell down, and there was none to help.", "words": [[0, 59650], [10, 59976], [13, 60236], [21, 60456], [26, 60756], [32, 60956], [38, 61256], [43, 61655], [51, 62305], [56, 62415], [61, 62675], [67, 63075], [71, 63475], [77, 63615], [81, 63795], [86, 63995], [89, 64235]]}, {"verse": 13, "start": 65031, "end": 69386, "text": "Then they cried to the LORD in their trouble, and he saved them out of their distresses.", "words": [[0, 65031], [5, 65354], [10, 65494], [16, 65774], [19, 65974], [23, 66114], [28, 66334], [31, 66494], [37, 66614], [46, 67254], [50, 67434], [53, 67554], [59, 67894], [64, 68114], [68, 68294], [71, 68394], [77, 68534]]}, {"verse": 14, "start": 69836, "end": 75093, "text": "He brought them out of darkness and the shadow of death, and broke their bands in sunder.", "words": [[0, 69836], [3, 69921], [11, 70161], [16, 70441], [20, 70641], [23, 70741], [32, 71221], [36, 71701], [40, 71821], [47, 72141], [50, 72361], [57, 72961], [61, 73321], [67, 73561], [73, 73801], [79, 74241], [82, 74696]]}, {"verse": 15, "start": 75543, "end": 81513, "text": "Oh that men would praise the LORD for his goodness, and for his wonderful works to the children of men!", "words": [[0, 75543], [3, 75928], [8, 76048], [12, 76288], [18, 76488], [25, 76848], [29, 77088], [34, 77348], [38, 77588], [42, 77748], [52, 78168], [56, 78868], [60, 79068], [64, 79248], [74, 79708], [80, 80148], [83, 80388], [87, 80528], [96, 80888], [99, 81088]]}, {"verse": 16, "start": 81963, "end": 86883, "text": "For he has broken the gates of brass, and cut the bars of iron in sunder.", "words": [[0, 81963], [4, 82088], [7, 82288], [11, 82508], [18, 82888], [22, 83108], [28, 83368], [31, 83548], [38, 84388], [42, 84688], [46, 84908], [50, 85068], [55, 85428], [58, 85648], [63, 86048], [66, 86248]]}, {"verse": 17, "start": 87333, "end": 92280, "text": "Fools because of their transgression, and because of their iniquities, are afflicted.", "words": [[0, 87333], [6, 87753], [14, 88093], [17, 88353], [23, 88493], [38, 89353], [42, 89713], [50, 90013], [53, 90213], [59, 90393], [71, 91233], [75, 91553]]}, {"verse": 18, "start": 92730, "end": 98036, "text": "Their soul abhors all manner of food; and they draw near to the gates of death.", "words": [[0, 92730], [6, 92824], [11, 93204], [18, 93844], [22, 94184], [29, 94544], [32, 94784], [38, 95706], [42, 96006], [47, 96126], [52, 96426], [57, 96686], [60, 96866], [64, 97006], [70, 97266], [73, 97466]]}, {"verse": 19, "start": 98486, "end": 103284, "text": "Then they cry to the LORD in their trouble, and he saves them out of their distresses.", "words": [[0, 98486], [5, 98806], [10, 99046], [14, 99286], [17, 99526], [21, 99646], [26, 99906], [29, 100066], [35, 100206], [44, 100806], [48, 101106], [51, 101246], [57, 101586], [62, 101846], [66, 102086], [69, 102186], [75, 102346]]}, {"verse": 20, "start": 103734, "end": 107833, "text": "He sent his word, and healed them, and delivered them from their destructions.", "words": [[0, 103734], [3, 103820], [8, 104060], [12, 104260], [18, 104600], [22, 104920], [29, 105240], [35, 105520], [39, 105980], [49, 106300], [54, 106600], [59, 106780], [65, 106960]]}, {"verse": 21, "start": 108283, "end": 113611, "text": "Oh that men would praise the LORD for his goodness, and for his wonderful works to the children of men!", "words": [[0, 108328], [3, 108408], [8, 108568], [12, 108788], [18, 108988], [25, 109328], [29, 109568], [34, 109808], [38, 110028], [42, 110208], [52, 110568], [56, 111068], [60, 111228], [64, 111388], [74, 111768], [80, 112208], [83, 112468], [87, 112608], [96, 112948], [99, 113148]]}, {"verse": 22, "start": 114061, "end": 120118, "text": "And let them sacrifice the sacrifices of thanksgiving, and declare his works with rejoicing.", "words": [[0, 114061], [4, 114202], [8, 114402], [13, 114622], [23, 115322], [27, 115582], [38, 116342], [41, 116662], [55, 117862], [59, 118042], [67, 118442], [71, 118682], [77, 119022], [82, 119282]]}, {"verse": 23, "start": 120568, "end": 125227, "text": "They that go down to the sea in ships, that do business in great waters;", "words": [[0, 120568], [5, 120718], [10, 120918], [13, 121138], [18, 121418], [21, 121618], [25, 121738], [29, 122038], [32, 122278], [39, 122638], [44, 123278], [47, 123538], [56, 123938], [59, 124258], [65, 124538]]}, {"verse": 24, "start": 125677, "end": 129439, "text": "These see the works of the LORD, and his wonders in the deep.", "words": [[0, 125677], [6, 125909], [10, 126289], [14, 126449], [20, 126729], [23, 126949], [27, 127109], [33, 127449], [37, 127989], [41, 128169], [49, 128569], [52, 128849], [56, 128949]]}, {"verse": 25, "start": 129889, "end": 134435, "text": "For he commands, and raises the stormy wind, which lifts up the waves of it.", "words": [[0, 129889], [4, 130011], [7, 130151], [17, 130671], [21, 130911], [28, 131291], [32, 131631], [39, 132111], [45, 132751], [51, 132991], [57, 133251], [60, 133471], [64, 133671], [70, 134011], [73, 134191]]}, {"verse": 26, "start": 134885, "end": 141029, "text": "They mount up to the heaven, they go down again to the depths: their soul is melted because of trouble.", "words": [[0, 134885], [5, 134993], [11, 135253], [14, 135473], [17, 135633], [21, 135773], [29, 136473], [34, 136653], [37, 136853], [42, 137153], [48, 137493], [51, 137693], [55, 137813], [63, 138717], [69, 138867], [74, 139247], [77, 139467], [84, 139887], [92, 140247], [95, 140467]]}, {"verse": 27, "start": 141479, "end": 148076, "text": "They reel to and fro, and stagger like a drunken man, and are at their wits’ end.", "words": [[0, 141479], [5, 141597], [10, 142097], [13, 142437], [17, 142837], [22, 143297], [26, 144017], [34, 144557], [39, 144917], [41, 145037], [49, 145537], [54, 145957], [58, 146537], [62, 146697], [65, 146857], [71, 147057], [77, 147477]]}, {"verse": 28, "start": 148526, "end": 153488, "text": "Then they cry to the LORD in their trouble, and he brings them out of their distresses.", "words": [[0, 148526], [5, 148670], [10, 148830], [14, 149210], [17, 149510], [21, 149670], [26, 149930], [29, 150130], [35, 150270], [44, 150690], [48, 151230], [51, 151370], [58, 151730], [63, 151990], [67, 152230], [70, 152330], [76, 152510]]}, {"verse": 29, "start": 153938, "end": 157600, "text": "He makes the storm a calm, so that the waves of it are still.", "words": [[0, 153938], [3, 154032], [9, 154272], [13, 154472], [19, 154832], [21, 155012], [27, 155432], [30, 155792], [35, 155992], [39, 156112], [45, 156512], [48, 156712], [51, 156852], [55, 156992]]}, {"verse": 30, "start": 158050, "end": 163636, "text": "Then are they glad because they are quiet; so he brings them to their desired haven.", "words": [[0, 158050], [5, 158335], [9, 158615], [14, 158795], [19, 159155], [27, 159615], [32, 159895], [36, 160035], [43, 161034], [46, 161242], [49, 161402], [56, 161722], [61, 161982], [64, 162162], [70, 162342], [78, 162842]]}, {"verse": 31, "start": 164086, "end": 170056, "text": "Oh that men would praise the LORD for his goodness, and for his wonderful works to the children of men!", "words": [[0, 164086], [3, 164471], [8, 164591], [12, 164831], [18, 165031], [25, 165391], [29, 165631], [34, 165891], [38, 166131], [42, 166291], [52, 166711], [56, 167411], [60, 167611], [64, 167791], [74, 168251], [80, 168691], [83, 168931], [87, 169071], [96, 169431], [99, 169631]]}, {"verse": 32, "start": 170506, "end": 176332, "text": "Let them exalt him also in the congregation of the people, and praise him in the assembly of the elders.", "words": [[0, 170506], [4, 170655], [9, 170855], [15, 171315], [19, 171475], [24, 171855], [27, 172115], [31, 172215], [44, 172735], [47, 173095], [51, 173215], [59, 173875], [63, 174115], [70, 174415], [74, 174655], [77, 174795], [81, 174915], [90, 175295], [93, 175555], [97, 175695]]}, {"verse": 33, "start": 176782, "end": 181211, "text": "He turns rivers into a wilderness, and the watersprings into dry ground;", "words": [[0, 176782], [3, 176868], [9, 177168], [16, 177488], [21, 177828], [23, 178028], [35, 178448], [39, 179108], [43, 179488], [56, 179868], [61, 180208], [65, 180548]]}, {"verse": 34, "start": 181661, "end": 185831, "text": "A fruitful land into barrenness, for the wickedness of them that dwell in it.", "words": [[0, 181661], [2, 181749], [11, 182149], [16, 182609], [21, 182849], [33, 183709], [37, 183929], [41, 184069], [52, 184529], [55, 184729], [60, 184949], [65, 185149], [71, 185349], [74, 185589]]}, {"verse": 35, "start": 186281, "end": 191060, "text": "He turns the wilderness into a standing water, and dry ground into watersprings.", "words": [[0, 186281], [3, 186366], [9, 186646], [13, 186846], [24, 187186], [29, 187546], [31, 187706], [40, 188026], [47, 188466], [51, 189086], [55, 189366], [62, 189726], [67, 190425]]}, {"verse": 36, "start": 191510, "end": 196502, "text": "And there he makes the hungry to dwell, that they may prepare a city for habitation;", "words": [[0, 191510], [4, 191653], [10, 191873], [13, 192053], [19, 192293], [23, 192493], [30, 192793], [33, 193033], [40, 193713], [45, 194193], [50, 194373], [54, 194553], [62, 194893], [64, 195113], [69, 195373], [73, 195593]]}, {"verse": 37, "start": 196952, "end": 201332, "text": "And sow the fields, and plant vineyards, which may yield fruits of increase.", "words": [[0, 196952], [4, 197109], [8, 197349], [12, 197529], [20, 198009], [24, 198269], [30, 198589], [41, 199149], [47, 199409], [51, 199649], [57, 199969], [64, 200329], [67, 200509]]}, {"verse": 38, "start": 201782, "end": 207973, "text": "He blesses them also, so that they are multiplied greatly; and suffers not their cattle to decrease.", "words": [[0, 201782], [3, 201886], [11, 202426], [16, 202566], [22, 202926], [25, 203586], [30, 203766], [35, 203906], [39, 203986], [50, 204586], [59, 205636], [63, 205745], [71, 206045], [75, 206365], [81, 206605], [88, 207025], [91, 207205]]}, {"verse": 39, "start": 208423, "end": 213069, "text": "Again, they are diminished and brought low through oppression, affliction, and sorrow.", "words": [[0, 208423], [7, 209003], [12, 209043], [16, 209143], [27, 209563], [31, 209823], [39, 210043], [43, 210363], [51, 210923], [63, 211483], [75, 212383], [79, 212423]]}, {"verse": 40, "start": 213519, "end": 219795, "text": "He pours contempt upon princes, and causes them to wander in the wilderness, where there is no way.", "words": [[0, 213519], [3, 213647], [9, 214147], [18, 214507], [23, 215007], [32, 215627], [36, 216167], [43, 216607], [48, 216887], [51, 217067], [58, 217487], [61, 217727], [65, 217827], [77, 218247], [83, 218607], [89, 218827], [92, 219007], [95, 219227]]}, {"verse": 41, "start": 220245, "end": 225508, "text": "Yet sets he the poor on high from affliction, and makes him families like a flock.", "words": [[0, 220245], [4, 220415], [9, 220775], [12, 221055], [16, 221215], [21, 221555], [24, 221855], [29, 222175], [34, 222415], [46, 223015], [50, 223475], [56, 223735], [60, 223935], [69, 224395], [74, 224715], [76, 224855]]}, {"verse": 42, "start": 225958, "end": 230703, "text": "The righteous shall see it, and rejoice: and all iniquity shall stop her mouth.", "words": [[0, 225958], [4, 226054], [14, 226374], [20, 226674], [24, 226934], [28, 227154], [32, 227414], [41, 228488], [45, 228637], [49, 228857], [58, 229457], [64, 229717], [69, 229997], [73, 230217]]}, {"verse": 43, "start": 231153, "end": 236912, "text": "Whoever is wise, and will observe these things, even they shall understand the lovingkindness of the LORD.", "words": [[0, 231153], [8, 231573], [11, 231913], [17, 232273], [21, 232573], [26, 232733], [34, 233133], [40, 233413], [48, 233933], [53, 234153], [58, 234373], [64, 234553], [75, 235173], [79, 235673], [94, 236173], [97, 236313], [101, 236433]]}]}