{"book": "JHN", "chapter": 7, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 312030, "verses": [{"verse": 1, "start": 300, "end": 6936, "text": "After these things Jesus walked in Galilee: for he would not walk in Judea, because the Jews sought to kill him.", "words": [[0, 300], [6, 513], [12, 793], [19, 1293], [25, 1553], [32, 2053], [35, 2253], [44, 3157], [48, 3260], [51, 3420], [57, 3600], [61, 3820], [66, 4180], [69, 4360], [76, 4960], [84, 5300], [88, 5540], [93, 5800], [100, 6140], [103, 6340], [108, 6580]]}, {"verse": 2, "start": 7286, "end": 9977, "text": "Now the Jews’ feast of tabernacles was at hand.", "words": [[0, 7286], [4, 7491], [8, 7671], [14, 8091], [20, 8231], [23, 8451], [35, 9111], [39, 9351], [42, 9491]]}, {"verse": 3, "start": 10327, "end": 17654, "text": "His brethren therefore said to him, Depart from here, and go into Judæa, that your disciples also may see the works that you do.", "words": [[0, 10327], [4, 10446], [13, 10966], [23, 11546], [28, 11646], [31, 11827], [36, 12376], [43, 12634], [48, 12874], [54, 13154], [58, 13634], [61, 13874], [66, 14304], [73, 14734], [78, 15074], [83, 15174], [93, 15654], [98, 16034], [102, 16234], [106, 16454], [110, 16614], [116, 16854], [121, 17074], [125, 17234]]}, {"verse": 4, "start": 18004, "end": 25193, "text": "For there is no man that does any thing in secret, and he himself seeks to be known openly. If you do these things, show yourself to the world.", "words": [[0, 18004], [4, 18107], [10, 18267], [13, 18407], [16, 18607], [20, 18827], [25, 19027], [30, 19227], [34, 19427], [40, 19627], [43, 19827], [51, 20347], [55, 20567], [58, 20727], [66, 21087], [72, 21387], [75, 21627], [78, 21727], [84, 21927], [92, 22767], [95, 22903], [99, 23023], [102, 23143], [108, 23343], [116, 23843], [121, 24103], [130, 24523], [133, 24683], [137, 24783]]}, {"verse": 5, "start": 25473, "end": 27683, "text": "For neither did his brethren believe in him.", "words": [[0, 25473], [4, 25578], [12, 25839], [16, 26098], [20, 26258], [29, 26678], [37, 27118], [40, 27359]]}, {"verse": 6, "start": 28033, "end": 33698, "text": "Then Jesus said to them, My time is not yet come: but your time is always ready.", "words": [[0, 28033], [5, 28218], [11, 28538], [16, 28898], [19, 29058], [25, 29646], [28, 29813], [33, 30173], [36, 30433], [40, 30693], [44, 30973], [50, 31858], [54, 31961], [59, 32121], [64, 32481], [67, 32741], [74, 33101]]}, {"verse": 7, "start": 34048, "end": 40417, "text": "The world cannot hate you; but me it hates, because I testify of it, that the works of it are evil.", "words": [[0, 34048], [4, 34127], [10, 34407], [17, 34707], [22, 35127], [27, 35783], [31, 35906], [34, 36166], [37, 36406], [44, 37046], [52, 37386], [54, 37566], [62, 37966], [65, 38366], [69, 38706], [74, 38946], [78, 39066], [84, 39306], [87, 39506], [90, 39666], [94, 39886]]}, {"verse": 8, "start": 40767, "end": 46968, "text": "Go up to this feast: I go not up yet to this feast; for my time is not yet full come.", "words": [[0, 40767], [3, 40994], [6, 41254], [9, 41474], [14, 41674], [21, 42552], [23, 42714], [26, 42894], [30, 43094], [33, 43314], [37, 43514], [40, 43734], [45, 43934], [52, 44749], [56, 44849], [59, 45029], [64, 45369], [67, 45629], [71, 45829], [75, 46029], [80, 46369]]}, {"verse": 9, "start": 47248, "end": 50409, "text": "When he had said these words to them, he remained in Galilee.", "words": [[0, 47248], [5, 47375], [8, 47515], [12, 47695], [17, 47915], [23, 48135], [29, 48455], [32, 48695], [38, 48995], [41, 49055], [50, 49395], [53, 49615]]}, {"verse": 10, "start": 50759, "end": 57631, "text": "¶ But when his brethren were gone up, then went he also up to the feast, not openly, but as it were in secret.", "words": [[2, 50759], [6, 50904], [11, 51104], [15, 51284], [24, 51664], [29, 51984], [34, 52244], [38, 52864], [43, 53144], [48, 53324], [51, 53544], [56, 53884], [59, 54244], [62, 54384], [66, 54504], [73, 55204], [77, 55444], [85, 56224], [89, 56384], [92, 56584], [95, 56684], [100, 56884], [103, 57044]]}, {"verse": 11, "start": 57981, "end": 61493, "text": "Then the Jews sought him at the feast, and said, Where is he?", "words": [[0, 57981], [5, 58331], [9, 58491], [14, 58811], [21, 59191], [25, 59371], [28, 59511], [32, 59651], [39, 59931], [43, 60191], [49, 60825], [55, 61024], [58, 61264]]}, {"verse": 12, "start": 61773, "end": 70407, "text": "And there was much murmuring among the people concerning him: for some said, He is a good man: others said, No; but he deceives the people.", "words": [[0, 61773], [4, 61893], [10, 62013], [14, 62213], [19, 62493], [29, 63033], [35, 63253], [39, 63473], [46, 63733], [57, 64233], [62, 64905], [66, 65013], [71, 65273], [77, 65963], [80, 66113], [83, 66333], [85, 66453], [90, 66613], [95, 67263], [102, 67492], [108, 68240], [112, 68912], [116, 69040], [119, 69220], [128, 69780], [132, 69940]]}, {"verse": 13, "start": 70687, "end": 74487, "text": "However no man spoke openly of him for fear of the Jews.", "words": [[0, 70687], [8, 71247], [11, 71347], [15, 71627], [21, 71967], [28, 72507], [31, 72807], [35, 72947], [39, 73147], [44, 73447], [47, 73647], [51, 73787]]}, {"verse": 14, "start": 74837, "end": 78990, "text": "¶ Now about the midst of the feast Jesus went up into the temple, and taught.", "words": [[2, 74837], [6, 75206], [12, 75366], [16, 75566], [22, 75786], [25, 76006], [29, 76126], [35, 76666], [41, 76906], [46, 77286], [49, 77466], [54, 77666], [58, 77826], [66, 78166], [70, 78451]]}, {"verse": 15, "start": 79340, "end": 83698, "text": "And the Jews marvelled, saying, How knows this man letters, having never learned?", "words": [[0, 79340], [4, 79465], [8, 79565], [13, 80055], [24, 80545], [32, 81256], [36, 81433], [42, 81693], [47, 81953], [51, 82253], [60, 82593], [67, 82908], [73, 83208]]}, {"verse": 16, "start": 83978, "end": 89087, "text": "Jesus answered them, and said, My doctrine is not mine, but his that sent me.", "words": [[0, 83978], [6, 84271], [15, 84791], [21, 85071], [25, 85251], [31, 85795], [34, 85961], [43, 86341], [46, 86601], [50, 86821], [56, 87641], [60, 87921], [64, 88101], [69, 88421], [74, 88701]]}, {"verse": 17, "start": 89437, "end": 95966, "text": "If any man will do his will, he shall know of the doctrine, whether it be of God, or whether I speak of myself.", "words": [[0, 89437], [3, 89556], [7, 89736], [11, 90036], [16, 90216], [19, 90416], [23, 90616], [29, 91336], [32, 91456], [38, 91696], [43, 91936], [46, 92076], [50, 92196], [60, 92976], [68, 93196], [71, 93396], [74, 93536], [77, 93676], [82, 93996], [85, 94476], [93, 94736], [95, 94896], [101, 95136], [104, 95336]]}, {"verse": 18, "start": 96316, "end": 104711, "text": "He that speaks of himself seeks his own glory: but he that seeks his glory that sent him, the same is true, and no unrighteousness is in him.", "words": [[0, 96316], [3, 96485], [8, 96665], [15, 96965], [18, 97165], [26, 97545], [32, 97905], [36, 98145], [40, 98305], [47, 99108], [51, 99206], [54, 99465], [59, 99666], [65, 99905], [69, 100146], [75, 100526], [80, 100746], [85, 100986], [90, 101526], [94, 101666], [99, 101886], [102, 102045], [108, 102605], [112, 102886], [115, 103125], [131, 104006], [134, 104226], [137, 104405]]}, {"verse": 19, "start": 105061, "end": 111410, "text": "Did not Moses give you the law, and yet none of you keeps the law? Why do you go about to kill me?", "words": [[0, 105061], [4, 105175], [8, 105395], [14, 105915], [19, 106295], [23, 106475], [27, 106595], [32, 107375], [36, 107655], [40, 107815], [45, 108095], [48, 108275], [52, 108415], [58, 108715], [62, 108975], [67, 109679], [71, 109864], [74, 110064], [78, 110204], [81, 110364], [87, 110624], [90, 110844], [95, 111044]]}, {"verse": 20, "start": 111690, "end": 115826, "text": "The people answered and said, You have a demon: who goes about to kill you?", "words": [[0, 111690], [4, 111770], [11, 111970], [20, 112390], [24, 112630], [30, 113234], [34, 113380], [39, 113700], [41, 113920], [48, 114589], [52, 114713], [57, 114933], [63, 115193], [66, 115373], [71, 115553]]}, {"verse": 21, "start": 116106, "end": 120819, "text": "Jesus answered and said to them, I have done one work, and you all marvel.", "words": [[0, 116106], [6, 116371], [15, 116891], [19, 117111], [24, 117311], [27, 117491], [33, 118160], [35, 118377], [40, 118557], [45, 118777], [49, 119017], [55, 119417], [59, 119777], [63, 119957], [67, 120197]]}, {"verse": 22, "start": 121169, "end": 129437, "text": "Moses therefore gave to you circumcision; (not because it is of Moses, but of the fathers;) and you on the sabbath day circumcise a man.", "words": [[0, 121169], [6, 121531], [16, 122051], [21, 122391], [24, 122611], [28, 122751], [42, 123917], [47, 124077], [55, 124397], [58, 124637], [61, 124777], [64, 124917], [71, 125617], [75, 125717], [78, 125817], [82, 125937], [92, 126877], [96, 126997], [100, 127197], [103, 127397], [107, 127517], [115, 127857], [119, 128177], [130, 128917], [132, 129017]]}, {"verse": 23, "start": 129787, "end": 139216, "text": "If a man on the sabbath day receive circumcision, that the law of Moses should not be broken; are you angry at me, because I have made a man every whit whole on the sabbath day?", "words": [[0, 129787], [3, 129901], [5, 130001], [9, 130281], [12, 130421], [16, 130541], [24, 130821], [28, 131181], [36, 131541], [50, 132661], [55, 132901], [59, 133021], [63, 133281], [66, 133461], [72, 133801], [79, 134101], [83, 134301], [86, 134461], [94, 135249], [98, 135338], [102, 135458], [108, 135778], [111, 135978], [115, 136118], [123, 136498], [125, 136698], [130, 136778], [135, 136938], [137, 137058], [141, 137258], [147, 137551], [152, 137845], [158, 138138], [161, 138378], [165, 138478], [173, 138718]]}, {"verse": 24, "start": 139566, "end": 142694, "text": "Judge not according to the appearance, but judge righteous judgment.", "words": [[0, 139566], [6, 139707], [10, 139927], [20, 140247], [23, 140467], [27, 140547], [39, 141307], [43, 141427], [49, 141687], [59, 142067]]}, {"verse": 25, "start": 142974, "end": 147471, "text": "Then said some of them of Jerusalem, Is not this he, whom they seek to kill?", "words": [[0, 142974], [5, 143212], [10, 143532], [15, 143852], [18, 144012], [23, 144172], [26, 144332], [37, 145336], [40, 145440], [44, 145620], [49, 145860], [53, 146140], [58, 146560], [63, 146740], [68, 146920], [71, 147100]]}, {"verse": 26, "start": 147821, "end": 153687, "text": "But, lo, he speaks boldly, and they say nothing to him. Do the rulers know indeed that this is the very Christ?", "words": [[0, 148018], [5, 148252], [9, 148485], [12, 148565], [19, 148865], [27, 149425], [31, 149625], [36, 149765], [40, 149925], [48, 150145], [51, 150405], [56, 150920], [59, 151004], [63, 151124], [70, 151384], [75, 151684], [82, 152004], [87, 152244], [92, 152464], [95, 152584], [99, 152704], [104, 153044]]}, {"verse": 27, "start": 154037, "end": 159469, "text": "However we know this man from where he is: but when Christ comes, no man knows from where he is.", "words": [[0, 154037], [8, 154314], [11, 154554], [16, 154794], [21, 155074], [25, 155354], [30, 155554], [36, 155794], [39, 156054], [43, 156668], [47, 156764], [52, 156904], [59, 157164], [66, 157864], [69, 158124], [73, 158284], [79, 158544], [84, 158744], [90, 158924], [93, 159124]]}, {"verse": 28, "start": 159749, "end": 170159, "text": "Then cried Jesus in the temple as he taught, saying, You both know me, and you know from where I am: and I am not come of myself, but he that sent me is true, whom you know not.", "words": [[0, 159749], [5, 159964], [11, 160264], [17, 160644], [20, 160944], [24, 161044], [31, 161364], [34, 161644], [37, 161764], [45, 162164], [53, 162835], [57, 162955], [62, 163195], [67, 163435], [71, 163615], [75, 164115], [79, 164235], [84, 164395], [89, 164615], [95, 164775], [97, 165015], [101, 165622], [105, 165749], [107, 165889], [110, 165989], [114, 166189], [119, 166409], [122, 166549], [130, 167329], [134, 167589], [137, 167769], [142, 167989], [147, 168229], [150, 168409], [153, 168589], [159, 169149], [164, 169289], [168, 169449], [173, 169649]]}, {"verse": 29, "start": 170509, "end": 174677, "text": "But I know him: for I am from him, and he has sent me.", "words": [[0, 170509], [4, 170616], [6, 170736], [11, 170916], [16, 171526], [20, 171713], [22, 172033], [25, 172353], [30, 172693], [35, 173533], [39, 173713], [42, 173893], [46, 174073], [51, 174333]]}, {"verse": 30, "start": 174957, "end": 180728, "text": "Then they sought to take him: but no man laid hands on him, because his hour was not yet come.", "words": [[0, 174957], [5, 175255], [10, 175475], [17, 175715], [20, 175935], [25, 176175], [30, 176714], [34, 176837], [37, 177117], [41, 177457], [46, 177737], [52, 178097], [55, 178317], [60, 178537], [68, 178917], [72, 179157], [77, 179477], [81, 179777], [85, 179997], [89, 180197]]}, {"verse": 31, "start": 181078, "end": 188721, "text": "And many of the people believed on him, and said, When Christ comes, will he do more miracles than these which this man has done?", "words": [[0, 181078], [4, 181222], [9, 181442], [12, 181602], [16, 181722], [23, 181982], [32, 182422], [35, 182702], [40, 182942], [44, 183382], [50, 184186], [55, 184339], [62, 184679], [69, 185419], [74, 185599], [77, 185699], [80, 185899], [85, 186159], [94, 186679], [99, 186979], [105, 187239], [111, 187459], [116, 187819], [120, 188079], [124, 188279]]}, {"verse": 32, "start": 189001, "end": 198294, "text": "¶ The Pharisees heard that the people murmured such things concerning him; and the Pharisees and the chief priests sent officers to take him.", "words": [[2, 189001], [6, 189141], [16, 189861], [22, 190161], [27, 190601], [31, 190741], [38, 191021], [47, 191621], [52, 191861], [59, 192281], [70, 192881], [75, 193670], [79, 194034], [83, 194134], [93, 195014], [97, 195134], [101, 195274], [107, 195474], [115, 196054], [120, 196554], [129, 197054], [132, 197394], [137, 197654]]}, {"verse": 33, "start": 198644, "end": 204004, "text": "Then said Jesus to them, Yet a little while am I with you, and then I go to him that sent me.", "words": [[0, 198644], [5, 198846], [10, 199166], [16, 199606], [19, 199946], [25, 200593], [29, 200718], [31, 200818], [38, 200978], [44, 201218], [47, 201458], [49, 201558], [54, 201778], [59, 202358], [63, 202438], [68, 202618], [70, 202738], [73, 202958], [76, 203098], [80, 203278], [85, 203458], [90, 203678]]}, {"verse": 34, "start": 204354, "end": 208873, "text": "You shall seek me, and shall not find me: and where I am, there you cannot come.", "words": [[0, 204354], [4, 204475], [10, 204635], [15, 204895], [19, 205155], [23, 205395], [29, 205575], [33, 205775], [38, 206075], [42, 206640], [46, 206763], [52, 206923], [54, 207183], [58, 207763], [64, 207883], [68, 208023], [75, 208263]]}, {"verse": 35, "start": 209153, "end": 217913, "text": "Then said the Jews among themselves, Where will he go, that we shall not find him? will he go to the dispersed among the Gentiles, and teach the Gentiles?", "words": [[0, 209153], [5, 209397], [10, 209717], [14, 209897], [19, 210137], [25, 210437], [37, 211593], [43, 211778], [48, 211978], [51, 212118], [55, 212358], [60, 212818], [63, 212958], [69, 213138], [73, 213318], [78, 213578], [83, 214178], [88, 214338], [91, 214498], [94, 214698], [97, 214838], [101, 214958], [111, 215338], [117, 215618], [121, 215818], [131, 216418], [135, 216698], [141, 216978], [145, 217178]]}, {"verse": 36, "start": 218263, "end": 225178, "text": "What manner of saying is this that he said, You shall seek me, and shall not find me: and where I am, there you cannot come?", "words": [[0, 218263], [5, 218404], [12, 218684], [15, 218884], [22, 219164], [25, 219364], [30, 219564], [35, 219804], [38, 219984], [44, 220424], [48, 220664], [54, 220884], [59, 221204], [63, 221464], [67, 221824], [73, 222044], [77, 222244], [82, 222544], [86, 223103], [90, 223244], [96, 223424], [98, 223624], [102, 224144], [108, 224284], [112, 224444], [119, 224684]]}, {"verse": 37, "start": 225458, "end": 233985, "text": "In the last day, that great day of the feast, Jesus stood and cried, saying, If any man thirst, let him come to me, and drink.", "words": [[0, 225458], [3, 225568], [7, 225668], [12, 225988], [17, 226708], [22, 226868], [28, 227188], [32, 227508], [35, 227668], [39, 227788], [46, 228468], [52, 228788], [58, 229288], [62, 229608], [69, 230308], [77, 231103], [80, 231227], [84, 231407], [88, 231667], [96, 232467], [100, 232607], [104, 232747], [109, 232967], [112, 233147], [116, 233307], [120, 233547]]}, {"verse": 38, "start": 234335, "end": 239650, "text": "He that believes on me, as the scripture has said, out of his belly shall flow rivers of living water.", "words": [[0, 234335], [3, 234517], [8, 234757], [17, 235097], [20, 235357], [24, 235597], [27, 235877], [31, 236017], [41, 236277], [45, 236537], [51, 237137], [55, 237257], [58, 237377], [62, 237477], [68, 237757], [74, 238037], [79, 238297], [86, 238637], [89, 238897], [96, 239117]]}, {"verse": 39, "start": 239930, "end": 249056, "text": "(But this spoke he of the Spirit, which they that believe on him should receive: for the Holy Spirit was not yet given; because that Jesus was not yet glorified.)", "words": [[0, 239930], [5, 240061], [10, 240281], [16, 240641], [19, 240961], [22, 241101], [26, 241241], [34, 241781], [40, 241961], [45, 242261], [50, 242521], [58, 242861], [61, 243121], [65, 243301], [72, 243561], [81, 244381], [85, 244482], [89, 244582], [94, 244782], [101, 245202], [105, 245402], [109, 245622], [113, 245802], [120, 246621], [128, 246829], [133, 247089], [139, 247389], [143, 247709], [147, 247929], [151, 248089]]}, {"verse": 40, "start": 249406, "end": 255111, "text": "¶ Many of the people therefore, when they heard this saying, said, Of a truth this is the Prophet.", "words": [[2, 249406], [7, 249635], [10, 249795], [14, 249935], [21, 250335], [32, 251155], [37, 251255], [42, 251435], [48, 251675], [53, 251915], [61, 252295], [67, 253146], [70, 253342], [72, 253442], [78, 253982], [83, 254242], [86, 254402], [90, 254522]]}, {"verse": 41, "start": 255391, "end": 260300, "text": "Others said, This is the Christ. But some said, Shall Christ come out of Galilee?", "words": [[0, 255391], [7, 255620], [13, 256368], [18, 256570], [21, 256710], [25, 256830], [33, 257651], [37, 257757], [42, 258037], [48, 258716], [54, 258833], [61, 259173], [66, 259433], [70, 259593], [73, 259673]]}, {"verse": 42, "start": 260650, "end": 266317, "text": "Has not the scripture said, That Christ comes of the seed of David, and out of the town of Bethlehem, where David was?", "words": [[0, 260650], [4, 260787], [8, 260947], [12, 261127], [22, 261367], [28, 261707], [33, 261907], [40, 262207], [46, 262507], [49, 262667], [53, 262817], [58, 262967], [61, 263087], [68, 263407], [72, 263867], [76, 264127], [79, 264267], [83, 264367], [88, 264587], [91, 264707], [102, 265267], [108, 265447], [114, 265767]]}, {"verse": 43, "start": 266597, "end": 269415, "text": "So there was a division among the people because of him.", "words": [[0, 266597], [3, 266772], [9, 266952], [13, 267132], [15, 267272], [24, 267652], [30, 267952], [34, 268212], [41, 268492], [49, 268792], [52, 269112]]}, {"verse": 44, "start": 269765, "end": 273873, "text": "And some of them would have taken him; but no man laid hands on him.", "words": [[0, 269765], [4, 269927], [9, 270167], [12, 270347], [17, 270527], [23, 270707], [28, 270807], [34, 271127], [39, 271792], [43, 272132], [46, 272372], [50, 272692], [55, 272952], [61, 273272], [64, 273512]]}, {"verse": 45, "start": 274223, "end": 280363, "text": "¶ Then came the officers to the chief priests and Pharisees; and they said to them, Why have you not brought him?", "words": [[2, 274223], [7, 274461], [12, 274721], [16, 274961], [25, 275401], [28, 275761], [32, 275881], [38, 276101], [46, 276541], [50, 276781], [61, 277777], [65, 277941], [70, 278081], [75, 278321], [78, 278521], [84, 279083], [88, 279292], [93, 279472], [97, 279592], [101, 279732], [109, 279992]]}, {"verse": 46, "start": 280643, "end": 283630, "text": "The officers answered, Never man spoke like this man.", "words": [[0, 280643], [4, 280743], [13, 281083], [23, 282083], [29, 282283], [33, 282503], [39, 282743], [44, 283063], [49, 283243]]}, {"verse": 47, "start": 283910, "end": 287367, "text": "Then answered them the Pharisees, Are you also deceived?", "words": [[0, 283910], [5, 284100], [14, 284520], [19, 284840], [23, 285040], [34, 286143], [38, 286288], [42, 286448], [47, 286748]]}, {"verse": 48, "start": 287717, "end": 290447, "text": "Have any of the rulers or of the Pharisees believed on him?", "words": [[0, 287717], [5, 287864], [9, 288144], [12, 288284], [16, 288404], [23, 288724], [26, 288984], [29, 289084], [33, 289184], [43, 289664], [52, 289904], [55, 290104]]}, {"verse": 49, "start": 290797, "end": 293227, "text": "But this people who knows not the law are cursed.", "words": [[0, 290797], [4, 290937], [9, 291117], [16, 291457], [20, 291657], [26, 291917], [30, 292137], [34, 292297], [38, 292517], [42, 292697]]}, {"verse": 50, "start": 293507, "end": 298181, "text": "Nicodemus says to them, (he that came to Jesus by night, being one of them,)", "words": [[0, 293507], [10, 294115], [15, 294275], [18, 294495], [24, 295235], [28, 295515], [33, 295715], [38, 295955], [41, 296115], [47, 296375], [50, 296735], [57, 297035], [63, 297375], [67, 297675], [70, 297815]]}, {"verse": 51, "start": 298401, "end": 302007, "text": "Does our law judge any man, before it hear him, and know what he does?", "words": [[0, 298401], [5, 298518], [9, 298718], [13, 298938], [19, 299238], [23, 299538], [28, 299818], [35, 300138], [38, 300378], [43, 300598], [48, 300858], [52, 301078], [57, 301278], [62, 301478], [65, 301558]]}, {"verse": 52, "start": 302287, "end": 309293, "text": "They answered and said to him, Are you also of Galilee? Search, and look: for out of Galilee arises no prophet.", "words": [[0, 302287], [5, 302396], [14, 302796], [18, 303016], [23, 303216], [26, 303396], [31, 303848], [35, 304008], [39, 304188], [44, 304608], [47, 304888], [56, 305668], [64, 306019], [68, 306299], [74, 306957], [78, 307058], [82, 307358], [85, 307498], [93, 307838], [100, 308338], [103, 308843]]}, {"verse": 53, "start": 309573, "end": 311630, "text": "And every man went to his own house.", "words": [[0, 309573], [4, 309700], [10, 309960], [14, 310240], [19, 310480], [22, 310660], [26, 310820], [30, 310980]]}]}