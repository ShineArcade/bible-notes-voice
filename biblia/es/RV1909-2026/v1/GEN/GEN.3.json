{"book": "GEN", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 218939, "verses": [{"verse": 1, "start": 300, "end": 12169, "text": "Pero la serpiente era astuta, más que todos los animales del campo que Jehová Dios había hecho; la cual dijo a la mujer: ¿Conque Dios os ha dicho: No comáis de todo árbol del huerto?", "words": [[0, 300], [5, 462], [8, 602], [18, 1202], [22, 1482], [30, 2522], [34, 2842], [38, 3022], [44, 3242], [48, 3502], [57, 3962], [61, 4222], [67, 4622], [71, 4842], [78, 5282], [83, 5422], [89, 5842], [96, 6760], [99, 6899], [104, 7119], [109, 7579], [111, 7739], [114, 7779], [121, 8709], [129, 8869], [134, 9109], [137, 9289], [140, 9409], [147, 10044], [150, 10210], [157, 10410], [160, 10610], [165, 10870], [171, 11270], [175, 11430]]}, {"verse": 2, "start": 12449, "end": 17502, "text": "Y la mujer respondió a la serpiente: Del fruto de los árboles del huerto comemos;", "words": [[0, 12449], [2, 12570], [5, 12670], [11, 13010], [21, 13610], [23, 13710], [26, 13770], [37, 14797], [41, 14962], [47, 15422], [50, 15562], [54, 15682], [62, 16182], [66, 16422], [73, 16742]]}, {"verse": 3, "start": 17852, "end": 24787, "text": "Pero del fruto del árbol que está en medio del huerto dijo Dios: No comeréis de él, ni le tocaréis, para que no muráis.", "words": [[0, 17852], [5, 17984], [9, 18164], [15, 18524], [19, 18704], [25, 19044], [29, 19184], [34, 19404], [37, 19584], [43, 19804], [47, 20004], [54, 20344], [59, 20604], [65, 21487], [68, 21654], [77, 22194], [80, 22394], [84, 22594], [87, 22834], [90, 22994], [100, 23574], [105, 23894], [109, 24034], [112, 24154]]}, {"verse": 4, "start": 25068, "end": 28919, "text": "Entonces la serpiente dijo a la mujer: No moriréis;", "words": [[0, 25068], [9, 25574], [12, 26054], [22, 26614], [27, 26934], [29, 27094], [32, 27154], [39, 27850], [42, 28130]]}, {"verse": 5, "start": 29269, "end": 36129, "text": "Mas sabe Dios que el día que comáis de él, serán abiertos