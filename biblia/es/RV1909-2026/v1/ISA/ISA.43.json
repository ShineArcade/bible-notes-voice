{"book": "ISA", "chapter": 43, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 246583, "verses": [{"verse": 1, "start": 300, "end": 10672, "text": "Y ahora, así dice Jehová Creador tuyo, oh Jacob, y Formador tuyo, oh Israel: No temas, porque yo te redimí; te puse nombre, mío eres tú.", "words": [[0, 300], [2, 445], [9, 745], [13, 1045], [18, 1345], [25, 1885], [33, 2245], [39, 2675], [42, 3105], [49, 3965], [51, 4005], [60, 4505], [66, 4855], [69, 5205], [77, 6180], [80, 6381], [87, 6701], [94, 7081], [97, 7301], [100, 7441], [108, 8634], [111, 8712], [116, 8992], [124, 9652], [128, 10012], [133, 10232]]}, {"verse": 2, "start": 11354, "end": 22026, "text": "Cuando pases por las aguas, yo estaré contigo; y por los ríos, no te anegarán. Cuando pases por el fuego, no te quemarás, ni la llama arderá en ti.", "words": [[0, 11354], [7, 11611], [13, 11911], [17, 12171], [21, 12371], [28, 12991], [31, 13071], [38, 13391], [47, 14586], [49, 14685], [53, 14865], [57, 15025], [63, 15525], [66, 15805], [69, 16480], [79, 17739], [86, 17956], [92, 18436], [96, 18636], [99, 18756], [106, 19436], [109, 19596], [112, 19736], [122, 20516], [125, 20696], [128, 20836], [134, 21076], [141, 21556], [144, 21636]]}, {"verse": 3, "start": 22713, "end": 31711, "text": "Porque yo Jehová Dios tuyo, el Santo de Israel, soy tu Salvador: a Egipto he dado por tu rescate, a Etiopía y a Seba por ti.", "words": [[0, 22713], [7, 22920], [10, 23320], [17, 23640], [22, 23820], [28, 24520], [31, 24620], [37, 24960], [40, 25160], [48, 25800], [52, 25920], [55, 26060], [65, 27301], [67, 27441], [74, 28001], [77, 28101], [82, 28321], [86, 28601], [89, 28741], [98, 29741], [100, 29821], [108, 30501], [110, 30661], [112, 30741], [117, 31081], [121, 31321]]}, {"verse": 4, "start": 32404, "end": 42077, "text": "Porque en mis ojos fuiste de grande estima, fuiste honorable, y yo te amé: daré pues hombres por ti, y naciones por tu alma.", "words": [[0, 32404], [7, 32630], [10, 32810], [14, 32970], [19, 33270], [26, 33770], [29, 33970], [36, 34210], [44, 35210], [51, 35530], [62, 35950], [64, 36590], [67, 36810], [70, 36950], [75, 38496], [80, 38897], [85, 39337], [93, 39557], [97, 39857], [101, 40157], [103, 40657], [112, 41137], [116, 41417], [119, 41577]]}, {"verse": 5, "start": 42768, "end": 49222, "text": "No temas, porque yo soy contigo; del oriente traeré tu generación, y del occidente te recogeré.", "words": [[0, 42768], [3, 42912], [10, 43232], [17, 43552], [20, 43812], [24, 44012], [33, 45223], [37, 45382], [45, 45882], [52, 46382], [55, 46462], [67, 47162], [69, 47622], [73, 47762], [83, 48282], [86, 48522]]}, {"verse": 6, "start": 49895, "end": 59564, "text": "Diré al norte: Da acá; y al sur: No detengas: trae de lejos mis hijos, y mis hijas de los confines de la tierra,", "words": [[0, 49895], [5, 50275], [8, 50395], [15, 51751], [18, 52027], [23, 52843], [25, 53045], [28, 53125], [33, 54109], [36, 54291], [46, 55664], [51, 55944], [54, 56004], [60, 56364], [64, 56564], [71, 56904], [73, 57524], [77, 57724], [83, 58064], [86, 58144], [90, 58244], [99, 58784], [102, 58924], [105, 59024]]}, {"verse": 7, "start": 60241, "end": 65709, "text": "Todos los llamados de mi nombre; para gloria mía los creé, los formé y los hice.", "words": [[0, 60241], [6, 60423], [10, 60683], [19, 61143], [22, 61303], [25, 61403], [33, 62436], [38, 62579], [45, 62959], [49, 63279], [53, 63599], [59, 64259], [63, 64359], [69, 64879], [71, 65119], [75, 65259]]}, {"verse": 8, "start": 66404, "end": 70838, "text": "Sacad al pueblo ciego que tiene ojos, y a los sordos que tienen oídos.", "words": [[0, 66598], [6, 66828], [9, 66928], [16, 67208], [22, 67728], [26, 67868], [32, 68128], [38, 68468], [40, 69168], [42, 69228], [46, 69368], [53, 69788], [57, 69908], [64, 70188]]}, {"verse": 9, "start": 71536, "end": 86851, "text": "Congréguense a una todas las naciones, y júntense todos los pueblos: ¿quién de ellos hay que nos dé nuevas de esto, y que nos haga oír las cosas primeras? Presenten sus testigos, y justifíquense; oigan, y digan: Verdad.", "words": [[0, 71987], [13, 72477], [15, 72567], [19, 72657], [25, 72837], [29, 73117], [39, 73657], [41, 74097], [50, 74577], [56, 74917], [60, 75177], [69, 76393], [76, 76650], [79, 76770], [85, 77050], [89, 77410], [93, 77570], [97, 77730], [100, 77910], [107, 78130], [110, 78390], [116, 78690], [118, 79050], [122, 79150], [126, 79330], [131, 79610], [135, 79950], [139, 80110], [145, 80350], [155, 81684], [165, 82186], [169, 82366], [179, 82926], [181, 83166], [196, 84749], [203, 85111], [205, 85351], [212, 86348]]}, {"verse": 10, "start": 87543, "end": 101238, "text": "Vosotros sois mis testigos, dice Jehová, y mi siervo que yo escogí; para que me conozcáis y creáis, y entendáis que yo mismo soy; antes de mí no fue formado Dios, ni lo será después de mí.", "words": [[0, 87543], [9, 88027], [14, 88427], [18, 88547], [28, 89507], [33, 89827], [41, 90807], [43, 90867], [46, 91007], [53, 91507], [57, 91667], [60, 91847], [68, 93040], [73, 93178], [77, 93318], [80, 93418], [90, 94078], [92, 94298], [100, 94878], [102, 95078], [112, 95638], [116, 95838], [119, 96058], [125, 96318], [130, 97515], [136, 97778], [139, 97978], [142, 98158], [145, 98338], [149, 98558], [157, 99038], [163, 99798], [166, 99978], [169, 100118], [174, 100298], [182, 100658], [185, 100938]]}, {"verse": 11, "start": 101956, "end": 105563, "text": "Yo, yo Jehová; y fuera de mí no hay quien salve.", "words": [[0, 101956], [4, 102241], [7, 102676], [15, 103643], [17, 103743], [23, 103983], [26, 104203], [29, 104383], [32, 104583], [36, 104743], [42, 104903]]}, {"verse": 12, "start": 106254, "end": 117183, "text": "Yo anuncié, y salvé, e hice oír, y no hubo entre vosotros extraño. Vosotros pues sois mis testigos, dice Jehová, que yo soy Dios.", "words": [[0, 106254], [3, 106478], [12, 107098], [14, 107258], [21, 108198], [23, 108278], [28, 108518], [33, 109418], [35, 109498], [38, 109638], [43, 109938], [49, 110078], [58, 110598], [67, 111933], [76, 112612], [81, 112772], [86, 113172], [90, 113292], [100, 114734], [105, 115060], [113, 116003], [117, 116103], [120, 116283], [124, 116503]]}, {"verse": 13, "start": 117869, "end": 125289, "text": "Aun antes que hubiera día, yo era; y no hay quien de mi mano libre: si yo hago, ¿quién lo estorbará?", "words": [[0, 117869], [4, 118105], [10, 118465], [14, 118666], [22, 118965], [27, 119666], [30, 119786], [35, 120811], [37, 120940], [40, 121120], [44, 121300], [50, 121500], [53, 121680], [56, 121800], [61, 122040], [68, 123159], [71, 123339], [74, 123519], [80, 124179], [87, 124439], [90, 124539]]}, {"verse": 14, "start": 125884, "end": 137754, "text": "Así dice Jehová, Redentor vuestro, el Santo de Israel: Por vosotros envié a Babilonia, e hice descender fugitivos todos ellos, y clamor de caldeos en las naves.", "words": [[0, 125884], [4, 126166], [9, 126546], [17, 127186], [26, 128066], [35, 129146], [38, 129226], [44, 129686], [47, 130185], [55, 130881], [59, 131024], [68, 131444], [74, 131864], [76, 132284], [87, 132704], [89, 133064], [94, 133264], [104, 133864], [114, 134504], [120, 134744], [127, 135184], [129, 135844], [136, 136304], [139, 136444], [147, 136924], [150, 137044], [154, 137164]]}, {"verse": 15, "start": 138486, "end": 142297, "text": "Yo Jehová, Santo vuestro, Creador de Israel, vuestro Rey.", "words": [[0, 138486], [3, 138867], [11, 139227], [17, 139467], [26, 140327], [34, 140767], [37, 140927], [45, 141587], [53, 141927]]}, {"verse": 16, "start": 142877, "end": 147924, "text": "Así dice Jehová, el que da camino en el mar, y senda en las aguas impetuosas;", "words": [[0, 142877], [4, 143255], [9, 143535], [17, 144055], [20, 144135], [24, 144275], [27, 144395], [34, 144755], [37, 144955], [40, 145095], [45, 145315], [47, 145595], [53, 146155], [56, 146255], [60, 146415], [66, 146855]]}, {"verse": 17, "start": 148374, "end": 158302, "text": "El que saca carro y caballo, ejército y fuerza; caen juntamente para no levantarse; quedan extinguidos, como mecha quedan apagados.", "words": [[0, 148374], [3, 148614], [7, 148734], [12, 149114], [18, 149494], [20, 149674], [29, 150474], [38, 151114], [40, 151254], [48, 152216], [53, 152602], [64, 153382], [69, 153602], [72, 153782], [84, 155027], [91, 155412], [104, 156372], [109, 156742], [115, 157112], [122, 157492]]}, {"verse": 18, "start": 158602, "end": 163379, "text": "No os acordéis de las cosas pasadas, ni traigáis a memoria las cosas antiguas.", "words": [[0, 158602], [3, 158789], [6, 158949], [15, 159469], [18, 159589], [22, 159729], [28, 159989], [37, 160829], [40, 161209], [49, 161689], [51, 161789], [59, 162229], [63, 162449], [69, 162689]]}, {"verse": 19, "start": 164113, "end": 174266, "text": "He aquí que yo hago cosa nueva: pronto saldrá a luz: ¿no la sabréis? Otra vez pondré camino en el desierto, y ríos en la soledad.", "words": [[0, 164161], [3, 164251], [8, 164511], [12, 164691], [15, 164871], [20, 165011], [25, 165311], [32, 166526], [39, 166686], [46, 167186], [48, 167226], [53, 168221], [57, 168346], [60, 168466], [69, 169704], [74, 169966], [78, 170306], [85, 170766], [92, 171166], [95, 171386], [98, 171486], [108, 172166], [110, 172826], [115, 173366], [118, 173546], [121, 173666]]}, {"verse": 20, "start": 174970, "end": 186738, "text": "La bestia del campo me honrará, los chacales, y los pollos del avestruz: porque daré aguas en el desierto, ríos en la soledad, para que beba mi pueblo, mi escogido.", "words": [[0, 174970], [3, 175111], [10, 175531], [14, 175691], [20, 176071], [23, 176311], [32, 177151], [36, 177371], [46, 178071], [48, 178491], [52, 178651], [59, 179114], [63, 179578], [73, 180625], [80, 180798], [85, 181158], [91, 181518], [94, 181658], [97, 181758], [107, 182838], [112, 183358], [115, 183478], [118, 183598], [127, 184238], [132, 184718], [136, 184878], [141, 185118], [144, 185238], [152, 185898], [155, 186018]]}, {"verse": 21, "start": 187427, "end": 191080, "text": "Este pueblo creé para mí; mis alabanzas publicará.", "words": [[0, 187427], [5, 187649], [12, 187989], [17, 188309], [22, 188589], [26, 189488], [30, 189610], [40, 190190]]}, {"verse": 22, "start": 191752, "end": 197329, "text": "Y no me invocaste a mí, oh Jacob; antes, de mí te cansaste, oh Israel.", "words": [[0, 191752], [2, 191835], [5, 191935], [8, 192075], [18, 192615], [20, 192795], [24, 193025], [27, 193255], [34, 194308], [41, 194689], [44, 194909], [47, 195089], [50, 195229], [60, 195899], [63, 196569]]}, {"verse": 23, "start": 198034, "end": 208969, "text": "No me trajiste a mí los animales de tus holocaustos, ni a mí me honraste con tus sacrificios: no te hice servir con ofrenda, ni te hice fatigar con incienso.", "words": [[0, 198034], [3, 198191], [6, 198331], [15, 198871], [17, 199031], [20, 199131], [24, 199291], [33, 199731], [36, 199991], [40, 200131], [53, 201371], [56, 201571], [58, 201691], [61, 201951], [64, 202271], [73, 202891], [77, 203031], [81, 203211], [94, 204733], [97, 204919], [100, 205099], [105, 205319], [112, 205699], [116, 205979], [125, 206839], [128, 207059], [131, 207239], [136, 207479], [144, 208059], [148, 208199]]}, {"verse": 24, "start": 209672, "end": 220894, "text": "No compraste para mí caña aromática por dinero, ni me saciaste con la grasa de tus sacrificios; antes me hiciste servir en tus pecados, me has fatigado con tus maldades.", "words": [[0, 209672], [3, 209812], [13, 210432], [18, 210592], [21, 210772], [26, 211092], [36, 211652], [40, 211872], [48, 212472], [51, 212852], [54, 212972], [63, 213532], [67, 213732], [70, 213852], [76, 214192], [79, 214332], [83, 214492], [96, 215993], [102, 216354], [105, 216594], [113, 217034], [120, 217414], [123, 217634], [127, 217794], [136, 218894], [139, 218994], [143, 219134], [152, 219714], [156, 219874], [160, 220054]]}, {"verse": 25, "start": 221587, "end": 227557, "text": "Yo, yo soy el que borro tus rebeliones por amor de mí; y no me acordaré de tus pecados.", "words": [[0, 221587], [4, 222146], [7, 222286], [11, 222556], [14, 222826], [18, 222966], [24, 223366], [28, 223526], [39, 224186], [43, 224426], [48, 224626], [51, 224846], [55, 225730], [57, 225827], [60, 225947], [63, 226047], [72, 226547], [75, 226667], [79, 226807]]}, {"verse": 26, "start": 228275, "end": 233565, "text": "Hazme recordar, entremos en juicio juntamente; relata tú para abonarte.", "words": [[0, 228275], [6, 228639], [16, 229199], [25, 229779], [28, 229939], [35, 230359], [47, 232055], [54, 232305], [57, 232565], [62, 232785]]}, {"verse": 27, "start": 234259, "end": 238313, "text": "Tu primer padre pecó, y tus enseñadores se rebelaron contra mí.", "words": [[0, 234259], [3, 234343], [10, 234663], [16, 235043], [22, 235583], [24, 236023], [28, 236143], [40, 236883], [43, 237263], [53, 237643], [60, 237963]]}, {"verse": 28, "start": 238995, "end": 245955, "text": "Por tanto, yo profané los príncipes del santuario, y puse por anatema a Jacob, y por deshonra a Israel.", "words": [[0, 238995], [4, 239095], [11, 239575], [14, 239715], [22, 240215], [26, 240335], [36, 240695], [40, 241055], [51, 241755], [53, 242275], [58, 242635], [62, 242835], [70, 243355], [72, 243555], [79, 243915], [81, 244455], [85, 244845], [94, 245235], [96, 245375]]}]}