{"book": "JHN", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 181731, "verses": [{"verse": 1, "start": 300, "end": 6866, "text": "Y al tercer día se hicieron unas bodas en Caná de Galilea; y estaba allí la madre de Jesús.", "words": [[0, 300], [2, 424], [5, 544], [12, 804], [16, 1244], [19, 1484], [28, 2084], [33, 2344], [39, 2864], [42, 3064], [47, 3424], [50, 3544], [59, 4492], [61, 4617], [68, 4857], [73, 5237], [76, 5597], [82, 5937], [85, 6137]]}, {"verse": 2, "start": 7216, "end": 10798, "text": "Y fue también llamado Jesús y sus discípulos a las bodas.", "words": [[0, 7216], [2, 7337], [6, 7457], [14, 7797], [22, 8217], [28, 8717], [30, 9097], [34, 9277], [45, 9957], [47, 10097], [51, 10217]]}, {"verse": 3, "start": 11148, "end": 16340, "text": "Y faltando el vino, la madre de Jesús le dijo: Vino no tienen.", "words": [[0, 11148], [2, 11269], [11, 11869], [14, 12049], [20, 12889], [23, 13149], [29, 13489], [32, 13689], [38, 14069], [41, 14489], [47, 15236], [52, 15483], [55, 15943]]}, {"verse": 4, "start": 16620, "end": 21725, "text": "Y le dice Jesús: ¿Qué tengo yo contigo, mujer? aún no ha venido mi hora.", "words": [[0, 16620], [2, 16743], [5, 16843], [10, 17103], [17, 18077], [22, 18147], [28, 18447], [31, 18627], [40, 19207], [47, 20035], [51, 20300], [54, 20620], [57, 20740], [64, 21080], [67, 21280]]}, {"verse": 5, "start": 22075, "end": 26037, "text": "Su madre dice a los que servían: Haced todo lo que os diga.", "words": [[0, 22075], [3, 22214], [9, 22594], [14, 23134], [16, 23334], [20, 23454], [24, 23594], [33, 24595], [39, 24745], [44, 25045], [47, 25285], [51, 25405], [54, 25545]]}, {"verse": 6, "start": 26317, "end": 35880, "text": "Y estaban allí seis tinajas de piedra para agua, conforme a la purificación de los judíos, que cabían en cada una dos o tres cántaros.", "words": [[0, 26317], [2, 26442], [10, 26842], [15, 27142], [20, 27462], [28, 28062], [31, 28242], [38, 28642], [43, 28842], [49, 29662], [58, 30402], [60, 30482], [63, 30562], [76, 31282], [79, 31682], [83, 31782], [91, 32802], [95, 33122], [102, 33602], [105, 33762], [110, 34082], [114, 34502], [118, 34682], [120, 34842], [125, 35022]]}, {"verse": 7, "start": 36230, "end": 41830, "text": "Les dice Jesús: Llenad estas tinajas de agua. Y las llenaron hasta arriba.", "words": [[0, 36230], [4, 36368], [9, 36628], [16, 37919], [23, 38299], [29, 38679], [37, 39059], [40, 39259], [46, 39970], [48, 40102], [52, 40222], [61, 40762], [67, 41122]]}, {"verse": 8, "start": 42180, "end": 48209, "text": "Y les dice: Sacad ahora, y llevadlo al encargado del banquete. Y se lo llevaron.", "words": [[0, 42180], [2, 42347], [6, 42447], [12, 43228], [18, 43671], [25, 44131], [27, 44651], [36, 45211], [39, 45331], [49, 46031], [53, 46231], [63, 47222], [65, 47331], [68, 47451], [71, 47571]]}, {"verse": 9, "start": 48559, "end": 61661, "text": "Y como el encargado del banquete probó el agua hecha vino, sin saber de dónde era (pero lo sabían los sirvientes que habían sacado el agua), el encargado del banquete llama al esposo,", "words": [[0, 48559], [2, 48719], [7, 49019], [10, 49259], [20, 49939], [24, 50119], [33, 50719], [39, 51219], [42, 51379], [47, 51679], [53, 51999], [59, 52759], [63, 53079], [69, 53479], [72, 53699], [78, 53919], [82, 54714], [88, 54874], [91, 55034], [98, 55514], [102, 55674], [113, 56294], [117, 56794], [124, 57074], [131, 57594], [134, 57734], [141, 58442], [144, 58803], [154, 59523], [158, 59743], [167, 60243], [173, 60603], [176, 60903]]}, {"verse": 10, "start": 62011, "end": 70366, "text": "Y le dice: Todo hombre pone primero el buen vino, y cuando están satisfechos, entonces lo que es peor; pero tú has guardado el buen vino hasta ahora.", "words": [[0, 62011], [2, 62139], [5, 62259], [11, 63043], [16, 63203], [23, 63523], [28, 63803], [36, 64163], [39, 64323], [44, 64443], [50, 64783], [52, 64958], [59, 65158], [65, 65458], [78, 66198], [87, 66718], [90, 67118], [94, 67258], [97, 67398], [103, 68071], [108, 68210], [111, 68390], [115, 68570], [124, 69050], [127, 69150], [132, 69310], [137, 69610], [143, 69870]]}, {"verse": 11, "start": 70646, "end": 79676, "text": "Este principio de señales hizo Jesús en Caná de Galilea, y manifestó su gloria; y sus discípulos creyeron en él.", "words": [[0, 70646], [5, 70930], [15, 71610], [18, 71830], [26, 72410], [31, 72670], [37, 73090], [40, 73550], [45, 74010], [48, 74050], [57, 74850], [59, 75150], [69, 75850], [72, 76030], [80, 76977], [82, 77117], [86, 77277], [97, 78017], [106, 78877], [109, 79177]]}, {"verse": 12, "start": 80026, "end": 88355, "text": "Después de esto descendió a Capernaum, él, y su madre, y hermanos, y discípulos; y estuvieron allí no muchos días.", "words": [[0, 80026], [8, 80386], [11, 80646], [16, 80906], [26, 81686], [28, 82436], [39, 83186], [43, 83386], [45, 83586], [48, 83706], [55, 84026], [57, 84326], [67, 84926], [69, 85086], [81, 86314], [83, 86423], [94, 86903], [99, 87143], [102, 87363], [109, 87603]]}, {"verse": 13, "start": 88705, "end": 93460, "text": "Y estaba cerca la Pascua de los judíos; y subió Jesús a Jerusalén.", "words": [[0, 88705], [2, 88934], [9, 89194], [15, 89614], [18, 89854], [25, 90394], [28, 90474], [32, 90614], [40, 91592], [42, 91792], [48, 92152], [54, 92472], [56, 92692]]}, {"verse": 14, "start": 93810, "end": 101323, "text": "Y halló en el templo a los que vendían bueyes, y ovejas, y palomas, y a los cambistas sentados.", "words": [[0, 93810], [2, 93989], [8, 94309], [11, 94409], [14, 94569], [21, 95224], [23, 95384], [27, 95484], [31, 95624], [39, 96124], [47, 97024], [49, 97244], [57, 97784], [59, 98024], [68, 98584], [70, 99224], [72, 99304], [76, 99774], [86, 100244]]}, {"verse": 15, "start": 101673, "end": 112009, "text": "Y hecho un látigo de cuerdas, los echó a todos del templo, y las ovejas, y los bueyes; y derramó los dineros de los cambistas, y volcó las mesas;", "words": [[0, 101673], [2, 101819], [8, 102079], [11, 102239], [18, 102639], [21, 102739], [30, 103639], [34, 103899], [39, 104259], [41, 104359], [47, 104679], [51, 104959], [59, 106019], [61, 106179], [65, 106339], [73, 106919], [75, 107399], [79, 107853], [87, 108457], [89, 108582], [97, 109042], [101, 109182], [109, 109582], [112, 109662], [116, 110032], [127, 110402], [129, 110842], [135, 111262], [139, 111362]]}, {"verse": 16, "start": 112359, "end": 119537, "text": "Y a los que vendían las palomas, dijo: Quitad de aquí esto, y no hagáis la casa de mi Padre casa de mercado.", "words": [[0, 112359], [2, 112542], [4, 112642], [8, 112782], [12, 112942], [20, 113442], [24, 113622], [33, 114542], [39, 115382], [46, 115654], [49, 115964], [54, 116184], [60, 116644], [62, 116929], [65, 117089], [72, 117429], [75, 117589], [80, 117809], [83, 118029], [86, 118149], [92, 118529], [97, 118689], [100, 118909]]}, {"verse": 17, "start": 119887, "end": 126047, "text": "Entonces se acordaron sus discípulos que está escrito: El celo de tu casa me devoró.", "words": [[0, 119887], [9, 120309], [12, 120949], [22, 121609], [26, 121849], [37, 122509], [41, 122689], [46, 122909], [55, 123833], [58, 124020], [63, 124540], [66, 124640], [69, 124800], [74, 125140], [77, 125380]]}, {"verse": 18, "start": 126397, "end": 131902, "text": "Y los judíos respondieron, y le dijeron: ¿Qué señal nos muestras de que haces esto?", "words": [[0, 126397], [2, 126504], [6, 126644], [13, 127224], [27, 127964], [29, 128504], [32, 128604], [41, 129583], [46, 129790], [52, 130036], [56, 130283], [65, 130803], [68, 130963], [72, 131103], [78, 131383]]}, {"verse": 19, "start": 132182, "end": 138321, "text": "Respondió Jesús, y les dijo: Destruid este templo, y en tres días lo levantaré.", "words": [[0, 132182], [10, 132736], [17, 133116], [19, 133436], [23, 133576], [29, 134651], [38, 135051], [43, 135351], [51, 136331], [53, 136451], [56, 136611], [61, 136911], [66, 137231], [69, 137591]]}, {"verse": 20, "start": 138671, "end": 145813, "text": "Dijeron luego los judíos: En cuarenta y seis años fue este templo edificado, ¿y tú en tres días lo levantarás?", "words": [[0, 138671], [8, 139271], [14, 139471], [18, 139751], [26, 140762], [29, 140931], [38, 141141], [40, 141351], [45, 141561], [50, 141961], [54, 142241], [59, 142481], [66, 142861], [77, 143921], [80, 144001], [83, 144141], [86, 144301], [91, 144501], [96, 144761], [99, 144981]]}, {"verse": 21, "start": 146093, "end": 148463, "text": "Mas él hablaba del templo de su cuerpo.", "words": [[0, 146193], [4, 146327], [7, 146460], [15, 146860], [19, 147060], [26, 147660], [29, 147720], [32, 147860]]}, {"verse": 22, "start": 148813, "end": 159581, "text": "Por tanto, cuando resucitó de los muertos, sus discípulos se acordaron que había dicho esto; y creyeron a la Escritura, y a la palabra que Jesús había dicho.", "words": [[0, 148813], [4, 148935], [11, 149375], [18, 149555], [27, 150375], [30, 150435], [34, 150575], [43, 151515], [47, 151835], [58, 152535], [61, 152715], [71, 153255], [75, 153455], [81, 153655], [87, 153995], [93, 154822], [95, 154959], [104, 155619], [106, 155739], [109, 155819], [120, 156619], [122, 157359], [124, 157439], [127, 157539], [135, 157939], [139, 158159], [145, 158459], [151, 158919]]}, {"verse": 23, "start": 159931, "end": 168536, "text": "Y estando en Jerusalén en la Pascua, en el día de la fiesta, muchos creyeron en su nombre, viendo las señales que hacía.", "words": [[0, 159931], [2, 160076], [10, 160616], [13, 160756], [23, 161416], [26, 161536], [29, 161676], [37, 162856], [40, 162936], [43, 163076], [47, 163276], [50, 163396], [53, 163536], [61, 163936], [68, 164616], [77, 165356], [80, 165496], [83, 165676], [91, 166116], [98, 166856], [102, 167116], [110, 167676], [114, 167836]]}, {"verse": 24, "start": 168886, "end": 174070, "text": "Pero el mismo Jesús no se confiaba a sí mismo de ellos, porque él conocía a todos,", "words": [[0, 168886], [5, 169070], [8, 169250], [14, 169530], [20, 169830], [23, 170130], [26, 170290], [35, 170810], [37, 170990], [40, 171070], [46, 171510], [49, 171690], [56, 172230], [63, 172570], [66, 172810], [74, 173370], [76, 173510]]}, {"verse": 25, "start": 174420, "end": 181331, "text": "Y no tenía necesidad de que nadie le diese testimonio del hombre; porque él sabía lo que había en el hombre.", "words": [[0, 174420], [2, 174529], [5, 174649], [11, 174989], [21, 175749], [24, 175929], [28, 176029], [34, 176389], [37, 176649], [43, 177009], [54, 177669], [58, 177809], [66, 178486], [73, 178771], [76, 178971], [82, 179511], [85, 179796], [89, 179976], [95, 180336], [98, 180636], [101, 180776]]}]}