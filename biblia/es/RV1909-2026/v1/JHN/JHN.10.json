{"book": "JHN", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 291191, "verses": [{"verse": 1, "start": 300, "end": 11375, "text": "De cierto, de cierto os digo: El que no entra por la puerta en el corral de las ovejas, sino que sube por otra parte, el tal es ladrón y asaltante.", "words": [[0, 517], [3, 771], [11, 1024], [14, 1277], [21, 1531], [24, 1784], [30, 2557], [33, 2699], [37, 2859], [40, 3099], [46, 3519], [50, 3739], [53, 3919], [60, 4199], [63, 4499], [66, 4769], [73, 5039], [76, 5179], [80, 5359], [88, 6159], [93, 6399], [97, 6599], [102, 6919], [106, 7119], [111, 7359], [118, 8539], [121, 8739], [125, 8919], [128, 9139], [135, 9979], [137, 10299]]}, {"verse": 2, "start": 11725, "end": 15217, "text": "Pero el que entra por la puerta, el pastor de las ovejas es.", "words": [[0, 11725], [5, 11867], [8, 12047], [12, 12247], [18, 12447], [22, 12687], [25, 12867], [33, 13507], [36, 13627], [43, 14167], [46, 14427], [50, 14567], [57, 15007]]}, {"verse": 3, "start": 15567, "end": 23301, "text": "A este abre el portero, y las ovejas oyen su voz: y a sus ovejas llama por nombre, y las saca.", "words": [[0, 15577], [2, 15877], [7, 16417], [12, 16637], [15, 16897], [24, 17637], [26, 17937], [30, 18097], [37, 18597], [42, 19017], [45, 19197], [50, 19921], [52, 20027], [54, 20107], [58, 20227], [65, 20807], [71, 21367], [75, 21707], [83, 22167], [85, 22447], [89, 22727]]}, {"verse": 4, "start": 23651, "end": 31122, "text": "Y como ha sacado fuera todas las propias, va delante de ellas; y las ovejas le siguen, porque conocen su voz.", "words": [[0, 23651], [2, 23757], [7, 23997], [10, 24197], [17, 24657], [23, 24917], [29, 25297], [33, 25597], [42, 26077], [45, 26257], [53, 26717], [56, 26897], [63, 27726], [65, 27834], [69, 27974], [76, 28414], [79, 28594], [87, 29174], [94, 29794], [102, 30434], [105, 30614]]}, {"verse": 5, "start": 31472, "end": 38899, "text": "Pero al extraño no seguirán, antes huirán de él: porque no conocen la voz de los extraños.", "words": [[0, 31472], [5, 31672], [8, 31812], [16, 32452], [19, 32932], [29, 33592], [35, 34652], [42, 35092], [45, 35312], [49, 35930], [56, 36154], [59, 36394], [67, 37054], [70, 37234], [74, 37474], [77, 37654], [81, 37774]]}, {"verse": 6, "start": 39249, "end": 44780, "text": "Esta parábola les dijo Jesús; pero ellos no entendieron qué era lo que les decía.", "words": [[0, 39249], [5, 39474], [14, 40014], [18, 40254], [23, 40554], [30, 41488], [35, 41632], [41, 41852], [44, 42112], [56, 42792], [60, 43192], [64, 43492], [67, 43672], [71, 43792], [75, 43992]]}, {"verse": 7, "start": 45130, "end": 52224, "text": "Les volvió, pues, Jesús a decir: De cierto, de cierto os digo: Yo soy la puerta de las ovejas.", "words": [[0, 45130], [4, 45306], [12, 46037], [18, 46317], [24, 46841], [26, 47365], [33, 48265], [36, 48519], [44, 48772], [47, 49025], [54, 49279], [57, 49532], [63, 50305], [66, 50493], [70, 50693], [73, 50873], [80, 51153], [83, 51373], [87, 51513]]}, {"verse": 8, "start": 52574, "end": 59269, "text": "Todos los que antes de mí vinieron, ladrones son y asaltantes; pero no los oyeron las ovejas.", "words": [[0, 52574], [6, 52836], [10, 53276], [14, 53456], [20, 53756], [23, 53956], [26, 54076], [36, 55036], [45, 55396], [49, 55776], [51, 56096], [63, 57389], [68, 57533], [71, 57813], [75, 58093], [82, 58373], [86, 58821]]}, {"verse": 9, "start": 59619, "end": 66710, "text": "Yo soy la puerta: el que por mí entra, será salvo; y entrará, y saldrá, y hallará pastos.", "words": [[0, 59619], [3, 59764], [7, 59944], [10, 60144], [18, 60971], [21, 61114], [25, 61254], [29, 61567], [32, 61881], [39, 62194], [44, 62614], [51, 63602], [53, 63719], [62, 64359], [64, 64559], [72, 65339], [74, 65539], [82, 65839]]}, {"verse": 10, "start": 67060, "end": 75847, "text": "El ladrón no viene sino para hurtar, y matar, y destruir: yo he venido para que tengan vida, y para que la tengan en abundancia.", "words": [[0, 67060], [3, 67207], [10, 67667], [13, 67847], [19, 68087], [24, 68467], [29, 68807], [37, 69567], [39, 69787], [46, 70127], [48, 70487], [58, 71625], [61, 71833], [64, 71973], [71, 72333], [76, 72533], [80, 72673], [87, 73013], [93, 73453], [95, 73708], [100, 73948], [104, 74108], [107, 74228], [114, 74548], [117, 74808]]}, {"verse": 11, "start": 76197, "end": 80747, "text": "Yo soy el buen pastor: el buen pastor su vida da por las ovejas.", "words": [[0, 76197], [3, 76382], [7, 76622], [10, 76822], [15, 76962], [23, 77920], [26, 78175], [31, 78355], [38, 78775], [41, 79035], [46, 79295], [49, 79455], [53, 79695], [57, 79895]]}, {"verse": 12, "start": 81097, "end": 93797, "text": "Pero el asalariado, que no es el pastor y a quien no pertenecen las ovejas, ve al lobo que viene, y deja las ovejas, y huye, y el lobo las arrebata, y esparce las ovejas.", "words": [[0, 81097], [5, 81242], [8, 81382], [20, 82222], [24, 82322], [27, 82462], [30, 82602], [33, 82722], [40, 83182], [42, 83497], [44, 83617], [50, 83737], [53, 84237], [64, 84737], [68, 84897], [76, 85717], [79, 86037], [82, 86357], [87, 86777], [91, 86937], [98, 87237], [100, 87517], [105, 87897], [109, 88017], [117, 88557], [119, 89057], [125, 89806], [127, 89990], [130, 90170], [135, 90510], [139, 91040], [149, 91570], [151, 92150], [159, 92730], [163, 92970]]}, {"verse": 13, "start": 94147, "end": 100427, "text": "Así que, el asalariado, huye, porque es asalariado, y no tiene cuidado de las ovejas.", "words": [[0, 94147], [4, 94517], [9, 94737], [12, 94917], [24, 95917], [30, 96517], [37, 97057], [40, 97397], [52, 98357], [54, 98497], [57, 98617], [63, 98857], [71, 99297], [74, 99557], [78, 99717]]}, {"verse": 14, "start": 100777, "end": 106205, "text": "Yo soy el buen pastor; y conozco mis ovejas, y las mías me conocen.", "words": [[0, 100777], [3, 101097], [7, 101337], [10, 101577], [15, 101737], [23, 102585], [25, 102714], [33, 103334], [37, 103534], [45, 104194], [47, 104694], [51, 104854], [56, 105234], [59, 105374]]}, {"verse": 15, "start": 106555, "end": 112592, "text": "Como el Padre me conoce, y yo conozco al Padre; y pongo mi vida por las ovejas.", "words": [[0, 106555], [5, 106865], [8, 107005], [14, 107285], [17, 107525], [25, 108165], [27, 108585], [30, 108725], [38, 109185], [41, 109325], [48, 110242], [50, 110482], [56, 110862], [59, 111082], [64, 111342], [68, 111602], [72, 111802]]}, {"verse": 16, "start": 112942, "end": 122841, "text": "También tengo otras ovejas que no son de este redil; aquellas también me conviene traer, y oirán mi voz; y habrá un rebaño, y un pastor.", "words": [[0, 112942], [8, 113227], [14, 113687], [20, 113987], [27, 114507], [31, 114787], [34, 114987], [38, 115247], [41, 115467], [46, 115990], [53, 116665], [62, 117129], [70, 117409], [73, 117609], [82, 118029], [89, 118709], [91, 119089], [97, 119529], [100, 119709], [105, 120498], [107, 120628], [113, 120888], [116, 121248], [124, 121608], [126, 122028], [129, 122465]]}, {"verse": 17, "start": 123191, "end": 128130, "text": "Por eso me ama el Padre, porque yo pongo mi vida, para volverla a tomar.", "words": [[0, 123191], [4, 123315], [8, 123515], [11, 123755], [15, 123975], [18, 124155], [25, 124895], [32, 125135], [35, 125375], [41, 125895], [44, 126075], [50, 126435], [55, 126935], [64, 127535], [66, 127615]]}, {"verse": 18, "start": 128480, "end": 138921, "text": "Nadie me la quita, pero yo la pongo de mí mismo. Tengo poder para ponerla, y tengo poder para volverla a tomar. Este mandamiento recibí de mi Padre.", "words": [[0, 128480], [6, 128885], [9, 129005], [12, 129145], [19, 129665], [24, 129745], [27, 129945], [30, 130065], [36, 130685], [39, 130865], [42, 131005], [49, 131810], [55, 132034], [61, 132394], [66, 132954], [75, 133514], [77, 134114], [83, 134394], [89, 134814], [94, 135134], [103, 135794], [105, 135914], [112, 136696], [117, 136885], [129, 137465], [136, 138085], [139, 138145], [142, 138305]]}, {"verse": 19, "start": 139271, "end": 142768, "text": "Y volvió a haber división entre los judíos por estas palabras.", "words": [[0, 139271], [2, 139377], [9, 139797], [11, 139897], [17, 140077], [26, 140657], [32, 140897], [36, 141077], [43, 141537], [47, 141757], [53, 141917]]}, {"verse": 20, "start": 143118, "end": 148396, "text": "Y muchos de ellos decían: Demonio tiene, y está fuera de sí; ¿para qué le oís?", "words": [[0, 143118], [2, 143338], [9, 143598], [12, 143858], [18, 144118], [26, 145178], [34, 145637], [41, 145937], [43, 146117], [48, 146357], [54, 146617], [57, 146837], [61, 147408], [67, 147565], [71, 147745], [74, 147865]]}, {"verse": 21, "start": 148676, "end": 154608, "text": "Decían otros: Estas palabras no son de endemoniado: ¿puede el demonio abrir los ojos de los ciegos?", "words": [[0, 148676], [7, 149201], [14, 150171], [20, 150433], [29, 150753], [32, 151033], [36, 151293], [39, 151768], [52, 152407], [59, 152628], [62, 152728], [70, 153128], [76, 153288], [80, 153488], [85, 153728], [88, 153908], [92, 154028]]}, {"verse": 22, "start": 154888, "end": 159792, "text": "Y se hacía la fiesta de la dedicación en Jerusalén; y era invierno;", "words": [[0, 154888], [2, 154992], [5, 155112], [11, 155392], [14, 155552], [21, 155932], [24, 156092], [27, 156192], [38, 156912], [41, 157152], [52, 158295], [54, 158672], [58, 158812]]}, {"verse": 23, "start": 160142, "end": 163926, "text": "Y Jesús andaba en el templo por el portal de Salomón.", "words": [[0, 160142], [2, 160269], [8, 160649], [15, 161369], [18, 161509], [21, 161649], [28, 162229], [32, 162409], [35, 162529], [42, 162949], [45, 163169]]}, {"verse": 24, "start": 164276, "end": 172820, "text": "Y le rodearon los judíos y le dijeron: ¿Hasta cuándo nos vas a mantener en duda? Si tú eres el Cristo, dínoslo abiertamente.", "words": [[0, 164276], [2, 164576], [5, 164716], [14, 165376], [18, 165556], [25, 166296], [27, 166441], [30, 166561], [39, 167487], [46, 167714], [53, 167954], [57, 168234], [61, 168414], [63, 168554], [72, 168894], [75, 169154], [81, 169783], [84, 169969], [87, 170149], [92, 170369], [95, 170529], [103, 171469], [111, 171889]]}, {"verse": 25, "start": 173100, "end": 181348, "text": "Les respondió Jesús: Os lo he dicho, y no creéis: las obras que yo hago en nombre de mi Padre, ellas dan testimonio de mí;", "words": [[0, 173100], [4, 173248], [14, 173828], [21, 174687], [24, 174812], [27, 174992], [30, 175072], [37, 175372], [39, 175592], [42, 175712], [50, 176773], [54, 177010], [60, 177280], [64, 177460], [67, 177680], [72, 177920], [75, 178060], [82, 178380], [85, 178600], [88, 178760], [95, 179440], [101, 179900], [105, 180160], [116, 180920], [119, 181040]]}, {"verse": 26, "start": 181698, "end": 186768, "text": "Pero vosotros no creéis, porque no sois de mis ovejas, como os he dicho.", "words": [[0, 181698], [5, 181882], [14, 182342], [17, 182582], [25, 183262], [32, 183862], [35, 184142], [40, 184582], [43, 184742], [47, 184882], [55, 185662], [60, 185882], [63, 186142], [66, 186222]]}, {"verse": 27, "start": 187118, "end": 191280, "text": "Mis ovejas oyen mi voz, y yo las conozco, y me siguen;", "words": [[0, 187118], [4, 187266], [11, 187846], [16, 188446], [19, 188646], [24, 188926], [26, 189166], [29, 189326], [33, 189466], [42, 190126], [44, 190546], [47, 190666]]}, {"verse": 28, "start": 191630, "end": 198519, "text": "Y yo les doy vida eterna: y no perecerán para siempre, ni nadie las arrebatará de mi mano.", "words": [[0, 191630], [2, 191758], [5, 191918], [9, 192058], [13, 192298], [18, 192518], [26, 193523], [28, 193653], [31, 193813], [41, 194593], [46, 194833], [55, 195513], [58, 196193], [64, 196553], [68, 196953], [79, 197693], [82, 197853], [85, 197973]]}, {"verse": 29, "start": 198869, "end": 206214, "text": "Mi Padre que me las dio, mayor que todos es: y nadie las puede arrebatar de la mano de mi Padre.", "words": [[0, 198869], [3, 198994], [9, 199394], [13, 199654], [16, 199804], [20, 199954], [25, 200654], [31, 201034], [35, 201274], [41, 201694], [45, 202738], [47, 202862], [53, 203182], [57, 203442], [63, 204032], [73, 204622], [76, 204742], [79, 204902], [84, 205142], [87, 205322], [90, 205462]]}, {"verse": 30, "start": 206564, "end": 208866, "text": "Yo y el Padre somos uno.", "words": [[0, 206564], [3, 206890], [5, 207130], [8, 207290], [14, 207770], [20, 208010]]}, {"verse": 31, "start": 209216, "end": 213774, "text": "Entonces volvieron a tomar piedras los judíos para apedrearle.", "words": [[0, 209216], [9, 210116], [19, 210756], [21, 210876], [27, 211116], [35, 211616], [39, 211776], [46, 212276], [51, 212496]]}, {"verse": 32, "start": 214124, "end": 221920, "text": "Les respondió Jesús: Muchas buenas obras os he mostrado de mi Padre; ¿por cuál obra de esas me apedreáis?", "words": [[0, 214124], [4, 214272], [14, 214852], [21, 215891], [28, 216071], [35, 216491], [41, 217271], [44, 217411], [47, 217671], [56, 218211], [59, 218431], [62, 218571], [69, 219480], [74, 219604], [79, 219864], [84, 220284], [87, 220524], [92, 220764], [95, 221004]]}, {"verse": 33, "start": 222270, "end": 231338, "text": "Le respondieron los judíos, diciendo: Por buena obra no te apedreamos, sino por la blasfemia; y porque tú, siendo hombre, te haces Dios.", "words": [[0, 222270], [3, 222418], [16, 223178], [20, 223418], [28, 224138], [38, 225382], [42, 225502], [48, 225702], [53, 226002], [56, 226202], [59, 226362], [71, 227222], [76, 227362], [80, 227582], [83, 227722], [94, 228671], [96, 228769], [103, 228989], [107, 229309], [114, 229829], [122, 230249], [125, 230489], [131, 230769]]}, {"verse": 34, "start": 231618, "end": 237413, "text": "Les respondió Jesús: ¿No está escrito en vuestra ley: Yo dije, Dioses sois?", "words": [[0, 231618], [4, 231767], [14, 232347], [21, 233205], [25, 233332], [30, 233532], [38, 233852], [41, 234152], [49, 234492], [54, 236072], [57, 236072], [63, 236072], [70, 236736]]}, {"verse": 35, "start": 237763, "end": 245385, "text": "Si dijo, dioses, a aquellos a los cuales vino la palabra de Dios (y la Escritura no puede ser quebrantada);", "words": [[0, 237763], [3, 237986], [9, 238326], [17, 238926], [19, 239686], [28, 240026], [30, 240286], [34, 240426], [41, 240606], [46, 240946], [49, 241146], [57, 241486], [60, 241726], [65, 242026], [68, 242486], [71, 242646], [81, 243366], [84, 243741], [90, 243981], [94, 244281]]}, {"verse": 36, "start": 245735, "end": 253661, "text": "¿A quien el Padre santificó y envió al mundo, vosotros decís: Tú blasfemas, porque dije: Hijo de Dios soy?", "words": [[0, 245735], [3, 245922], [9, 246042], [12, 246222], [18, 246682], [28, 247522], [30, 247662], [36, 248042], [39, 248202], [46, 249022], [55, 249622], [62, 250754], [65, 251090], [76, 251427], [83, 251687], [89, 252438], [94, 252705], [97, 252885], [102, 253085]]}, {"verse": 37, "start": 254011, "end": 257210, "text": "Si no hago obras de mi Padre, no me creáis.", "words": [[0, 254011], [3, 254231], [6, 254411], [11, 254791], [17, 255191], [20, 255391], [23, 255511], [30, 256091], [33, 256211], [36, 256351]]}, {"verse": 38, "start": 257560, "end": 267744, "text": "Pero si las hago, aunque a mí no creáis, creed a las obras; para que conozcáis y creáis que el Padre está en mí, y yo en el Padre.", "words": [[0, 257560], [5, 257725], [8, 257905], [12, 258125], [18, 259125], [25, 259325], [27, 259505], [30, 259625], [33, 259745], [41, 260725], [47, 261165], [49, 261225], [53, 261445], [60, 262335], [65, 262459], [69, 262619], [79, 263379], [81, 263619], [88, 264199], [92, 264459], [95, 264619], [101, 265099], [106, 265319], [109, 265559], [113, 265879], [115, 266379], [118, 266659], [121, 266899], [124, 267019]]}, {"verse": 39, "start": 268094, "end": 272617, "text": "Y procuraban otra vez prenderle; pero él se salió de sus manos;", "words": [[0, 268094], [2, 268200], [13, 268820], [18, 269020], [22, 269240], [33, 270180], [38, 270342], [41, 270682], [44, 271082], [50, 271542], [53, 271682], [57, 271882]]}, {"verse": 40, "start": 272967, "end": 280117, "text": "Y se volvió tras el Jordán, a aquel lugar donde primero había estado bautizando Juan; y se quedó allí.", "words": [[0, 272967], [2, 273167], [5, 273307], [12, 273787], [17, 273927], [20, 274147], [28, 274687], [30, 274907], [36, 275287], [42, 275587], [48, 275967], [56, 276487], [62, 276787], [69, 277147], [80, 278107], [86, 278991], [88, 279155], [91, 279215], [97, 279666]]}, {"verse": 41, "start": 280467, "end": 287906, "text": "Y muchos venían a él, y decían: Juan, a la verdad, ninguna señal hizo; pero todo lo que Juan dijo de este, era verdad.", "words": [[0, 280467], [2, 280576], [9, 280836], [16, 281316], [18, 281476], [22, 281656], [24, 281816], [32, 282826], [38, 283055], [40, 283215], [43, 283275], [51, 284015], [59, 284255], [65, 284775], [71, 285371], [76, 285489], [81, 285709], [84, 285909], [88, 286029], [93, 286249], [98, 286529], [101, 286729], [107, 287089], [111, 287389]]}, {"verse": 42, "start": 288186, "end": 290791, "text": "Y muchos creyeron allí en él.", "words": [[0, 288186], [2, 288310], [9, 288737], [18, 289163], [23, 289590], [26, 289770]]}]}