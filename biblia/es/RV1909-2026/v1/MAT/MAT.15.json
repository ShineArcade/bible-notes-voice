{"book": "MAT", "chapter": 15, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 293415, "verses": [{"verse": 1, "start": 300, "end": 5834, "text": "Entonces llegaron a Jesús ciertos escribas y fariseos de Jerusalén, diciendo:", "words": [[0, 300], [9, 710], [18, 1230], [20, 1330], [26, 1630], [34, 2410], [43, 2990], [45, 3130], [54, 3790], [57, 3890], [68, 5090]]}, {"verse": 2, "start": 6034, "end": 12086, "text": "¿Por qué tus discípulos quebrantan la tradición de los ancianos? porque no se lavan las manos cuando comen pan.", "words": [[0, 6034], [5, 6169], [9, 6309], [13, 6489], [24, 7049], [35, 7649], [38, 7749], [48, 8209], [51, 8329], [55, 8429], [65, 9399], [72, 9576], [75, 9756], [78, 9936], [84, 10116], [88, 10316], [94, 10636], [101, 10956], [107, 11276]]}, {"verse": 3, "start": 12366, "end": 20072, "text": "Y él respondiendo, les dijo: ¿Por qué también vosotros quebrantáis el mandamiento de Dios por vuestra tradición?", "words": [[0, 12366], [2, 12559], [5, 12779], [19, 13899], [23, 14099], [29, 14845], [34, 14967], [38, 15127], [46, 15507], [55, 16087], [67, 16667], [70, 17127], [82, 17867], [85, 18107], [90, 18367], [94, 18727], [102, 19147]]}, {"verse": 4, "start": 20422, "end": 30222, "text": "Porque Dios mandó, diciendo: Honra al padre y a la madre; y: El que maldiga al padre o a la madre, sea condenado a muerte.", "words": [[0, 20422], [7, 20604], [12, 20844], [19, 21304], [29, 22308], [35, 22856], [38, 23116], [44, 23556], [46, 23936], [48, 24016], [51, 24116], [58, 24942], [61, 25536], [64, 25676], [68, 25836], [76, 26396], [79, 26576], [85, 27016], [87, 27376], [89, 27496], [92, 27596], [99, 28376], [103, 28696], [113, 29416], [115, 29536]]}, {"verse": 5, "start": 30572, "end": 39355, "text": "Pero vosotros decís: Cualquiera que diga a su padre o a su madre: Es mi ofrenda a Dios todo aquello con que pudiera ayudarte;", "words": [[0, 30572], [5, 30719], [14, 31159], [21, 32172], [32, 32636], [36, 32816], [41, 33156], [43, 33216], [46, 33336], [52, 33736], [54, 34136], [56, 34236], [59, 34356], [66, 35194], [69, 35358], [72, 35538], [80, 36118], [82, 36278], [87, 36478], [92, 36858], [100, 37418], [104, 37658], [108, 37838], [116, 38398]]}, {"verse": 6, "start": 39705, "end": 48634, "text": "No deberá honrar a su padre o a su madre con socorro. Así habéis invalidado el mandamiento de Dios por vuestra tradición.", "words": [[0, 39705], [3, 39971], [10, 40531], [17, 41131], [19, 41291], [22, 41451], [28, 41911], [30, 42211], [32, 42331], [35, 42491], [41, 42831], [45, 43071], [54, 44107], [58, 44526], [65, 44926], [76, 45626], [79, 45766], [91, 46426], [94, 46646], [99, 46906], [103, 47211], [111, 47711]]}, {"verse": 7, "start": 48984, "end": 53030, "text": "Hipócritas, bien profetizó de vosotros Isaías, diciendo:", "words": [[0, 48984], [12, 49845], [17, 50105], [27, 50985], [30, 51085], [39, 51545], [47, 52225]]}, {"verse": 8, "start": 53380, "end": 57502, "text": "Este pueblo de labios me honra; pero su corazón lejos está de mí.", "words": [[0, 53380], [5, 53569], [12, 53889], [15, 54109], [22, 54429], [25, 54856], [32, 55451], [37, 55575], [40, 55755], [48, 56195], [54, 56755], [59, 57055], [62, 57235]]}, {"verse": 9, "start": 57852, "end": 63056, "text": "Pero en vano me honran, enseñando doctrinas y mandamientos de hombres.", "words": [[0, 57852], [5, 58175], [8, 58355], [13, 58875], [16, 59235], [24, 59595], [34, 60695], [44, 61415], [46, 61515], [59, 62215], [62, 62415]]}, {"verse": 10, "start": 63406, "end": 67501, "text": "Y llamando a sí a la multitud, les dijo: Oíd, y entended:", "words": [[0, 63406], [2, 63513], [11, 63740], [13, 63966], [16, 64193], [18, 64333], [21, 64413], [31, 65093], [35, 65193], [41, 65930], [46, 66358], [48, 66955]]}, {"verse": 11, "start": 67851, "end": 74537, "text": "No lo que entra en la boca contamina al hombre; sino lo que sale de la boca, esto contamina al hombre.", "words": [[0, 67851], [3, 67998], [6, 68118], [10, 68278], [16, 68498], [19, 68678], [22, 68798], [27, 69078], [37, 69838], [40, 69978], [48, 70744], [53, 70969], [56, 71169], [60, 71309], [65, 71629], [68, 71829], [71, 71969], [77, 72429], [82, 72589], [92, 73309], [95, 73449]]}, {"verse": 12, "start": 74887, "end": 82106, "text": "Entonces acercándose sus discípulos, le dijeron: ¿Sabes que los fariseos oyendo esta palabra se ofendieron?", "words": [[0, 74887], [9, 75448], [21, 76628], [25, 76908], [37, 77648], [40, 78108], [49, 78968], [56, 79326], [60, 79426], [64, 79546], [73, 80146], [80, 80546], [85, 80746], [93, 81166], [96, 81366]]}, {"verse": 13, "start": 82386, "end": 89284, "text": "Pero respondiendo él, dijo: Toda planta que no plantó mi Padre celestial, será desarraigada.", "words": [[0, 82386], [5, 82553], [18, 83413], [22, 83613], [28, 84313], [33, 84596], [40, 85036], [44, 85136], [47, 85276], [54, 85696], [57, 85836], [63, 86196], [74, 86956], [79, 87776]]}, {"verse": 14, "start": 89634, "end": 97699, "text": "Dejadlos: son ciegos guías de ciegos; y si el ciego guía al ciego, ambos caerán en el hoyo.", "words": [[0, 89634], [10, 90775], [14, 90980], [21, 91560], [27, 92160], [30, 92321], [38, 93219], [40, 93345], [43, 93505], [46, 93705], [52, 94245], [57, 94665], [60, 94885], [67, 95605], [73, 96165], [80, 96885], [83, 97005], [86, 97165]]}, {"verse": 15, "start": 98049, "end": 102533, "text": "Y respondiendo Pedro, le dijo: Decláranos esta parábola.", "words": [[0, 98049], [2, 98170], [15, 98990], [22, 99910], [25, 100170], [31, 101337], [42, 101687], [47, 101947]]}, {"verse": 16, "start": 102813, "end": 107199, "text": "Y Jesús dijo: ¿Aun también vosotros sois sin entendimiento?", "words": [[0, 102813], [2, 102999], [8, 103259], [14, 104184], [19, 104412], [27, 104832], [36, 105272], [41, 105712], [45, 106032]]}, {"verse": 17, "start": 107549, "end": 113828, "text": "¿No entendéis aún, que todo lo que entra en la boca, va al vientre, y es echado en la letrina?", "words": [[0, 107549], [4, 107695], [14, 107988], [19, 108282], [23, 108575], [28, 109115], [31, 109395], [35, 109625], [41, 109855], [44, 110095], [47, 110235], [53, 110475], [56, 110795], [59, 110975], [68, 111675], [70, 111895], [73, 112095], [80, 112675], [83, 112975], [86, 113115]]}, {"verse": 18, "start": 114178, "end": 119595, "text": "Pero lo que sale de la boca, del corazón sale; y esto contamina al hombre.", "words": [[0, 114178], [5, 114303], [8, 114463], [12, 114623], [17, 114883], [20, 115063], [23, 115203], [29, 115543], [33, 115928], [41, 116388], [47, 117387], [49, 117680], [54, 117960], [64, 118740], [67, 119000]]}, {"verse": 19, "start": 119945, "end": 130055, "text": "Porque del corazón salen los malos pensamientos, homicidios, adulterios, fornicaciones, hurtos, falsos testimonios, blasfemias.", "words": [[0, 119945], [7, 120147], [11, 120327], [19, 120807], [25, 121627], [29, 121907], [35, 122327], [49, 123567], [61, 124747], [73, 125787], [88, 126827], [96, 127527], [103, 127987], [116, 128787]]}, {"verse": 20, "start": 130405, "end": 137543, "text": "Estas cosas son las que contaminan al hombre: que comer con las manos sin lavar no contamina al hombre.", "words": [[0, 130405], [6, 130690], [12, 130970], [16, 131590], [20, 131770], [24, 131910], [35, 132590], [38, 132850], [46, 133629], [50, 133712], [56, 133992], [60, 134192], [64, 134392], [70, 134772], [74, 135332], [80, 135712], [83, 135912], [93, 136612], [96, 136852]]}, {"verse": 21, "start": 137893, "end": 141996, "text": "Y saliendo Jesús de allí, se fue a las partes de Tiro y de Sidón.", "words": [[0, 137893], [2, 138000], [11, 138460], [17, 138820], [20, 139080], [26, 139640], [29, 139720], [33, 139900], [35, 140040], [39, 140140], [46, 140520], [49, 140700], [54, 141120], [56, 141220], [59, 141360]]}, {"verse": 22, "start": 142346, "end": 155626, "text": "Y he aquí una mujer cananea, que había salido de aquellos términos, clamaba, diciéndole: Señor, Hijo de David, ten misericordia de mí; mi hija es cruelmente atormentada por un demonio.", "words": [[0, 142346], [2, 142524], [5, 142664], [10, 142964], [14, 143204], [20, 143624], [29, 144504], [33, 144924], [39, 145124], [46, 145644], [49, 145784], [58, 146024], [68, 146984], [77, 148124], [89, 149291], [96, 149687], [101, 150227], [104, 150367], [111, 150787], [115, 151207], [128, 151967], [131, 152087], [135, 152659], [138, 152802], [143, 153082], [146, 153242], [157, 153922], [169, 154602], [173, 154822], [176, 154962]]}, {"verse": 23, "start": 155906, "end": 166895, "text": "Pero él no le respondió palabra. Entonces acercándose sus discípulos, le rogaron, diciendo: Despídela, pues da voces tras nosotros.", "words": [[0, 155906], [5, 156049], [8, 156409], [11, 156789], [14, 156969], [24, 157569], [33, 158499], [42, 159182], [54, 160582], [58, 160942], [70, 161922], [73, 162442], [82, 163282], [92, 164655], [103, 164985], [108, 165625], [111, 165705], [117, 166105], [122, 166245]]}, {"verse": 24, "start": 167175, "end": 173385, "text": "Y él respondiendo, dijo: No soy enviado sino a las ovejas perdidas de la casa de Israel.", "words": [[0, 167175], [2, 167342], [5, 167482], [19, 168202], [25, 169019], [28, 169185], [32, 169505], [40, 170065], [45, 170305], [47, 170485], [51, 170605], [58, 171105], [67, 171785], [70, 171945], [73, 172025], [78, 172305], [81, 172565]]}, {"verse": 25, "start": 173735, "end": 179338, "text": "Entonces ella vino, y le adoró, diciendo: Señor, socórreme.", "words": [[0, 173735], [9, 174302], [14, 174722], [20, 175162], [22, 175762], [25, 175902], [32, 176622], [42, 177794], [49, 178594]]}, {"verse": 26, "start": 179618, "end": 185605, "text": "Y respondiendo él, dijo: No es bien tomar el pan de los hijos, y echarlo a los perrillos.", "words": [[0, 179618], [2, 179740], [15, 180540], [19, 180720], [25, 181501], [28, 181683], [31, 181883], [36, 182043], [42, 182463], [45, 182723], [49, 182943], [52, 183103], [56, 183263], [63, 183603], [65, 183983], [73, 184543], [75, 184623], [79, 185145]]}, {"verse": 27, "start": 185955, "end": 192705, "text": "Y ella dijo: Sí, Señor; pero los perrillos comen de las migajas que caen de la mesa de sus señores.", "words": [[0, 185955], [2, 186293], [7, 186453], [13, 187220], [17, 187706], [24, 188472], [29, 188618], [33, 188798], [43, 189258], [49, 189598], [52, 189818], [56, 189938], [64, 190558], [68, 190738], [73, 191118], [76, 191218], [79, 191338], [84, 191618], [87, 191798], [91, 191938]]}, {"verse": 28, "start": 192985, "end": 202762, "text": "Entonces respondiendo Jesús, dijo: Oh mujer, grande es tu fe; sea hecho contigo como quieres. Y fue sana su hija desde aquella hora.", "words": [[0, 192985], [9, 194029], [22, 194769], [29, 195109], [35, 196191], [38, 196281], [45, 196661], [52, 196977], [55, 197292], [58, 197608], [62, 198255], [66, 198475], [72, 198655], [80, 199215], [85, 199455], [94, 200438], [96, 200546], [100, 200706], [105, 201146], [108, 201266], [113, 201586], [119, 201746], [127, 202206]]}, {"verse": 29, "start": 203112, "end": 209347, "text": "Y partido Jesús de allí, vino junto al mar de Galilea: y subiendo al monte, se sentó allí.", "words": [[0, 203112], [2, 203370], [10, 203670], [16, 203970], [19, 204170], [25, 204450], [30, 204935], [36, 205235], [39, 205515], [43, 205735], [46, 205935], [55, 206933], [57, 207077], [66, 207537], [69, 207697], [76, 208097], [79, 208462], [85, 208922]]}, {"verse": 30, "start": 209697, "end": 220145, "text": "Y se le acercó mucha gente que traía consigo cojos, ciegos, mudos, mancos, y otros muchos enfermos: y los pusieron a los pies de Jesús, y los sanó:", "words": [[0, 209697], [2, 209966], [5, 210086], [8, 210226], [15, 210766], [21, 211226], [27, 211606], [31, 211806], [37, 212186], [45, 212526], [52, 213506], [60, 214306], [67, 214846], [75, 215286], [77, 215806], [83, 216046], [90, 216406], [100, 217497], [102, 217605], [106, 217705], [115, 218165], [117, 218305], [121, 218425], [126, 218585], [129, 218745], [136, 219065], [138, 219410], [142, 219530]]}, {"verse": 31, "start": 220495, "end": 230759, "text": "De manera que la multitud se maravillaba, viendo hablar los mudos, los mancos sanos, andar los cojos, y ver los ciegos: y glorificaron al Dios de Israel.", "words": [[0, 220495], [3, 220637], [10, 220857], [14, 221117], [17, 221257], [26, 221817], [29, 222037], [42, 222737], [49, 222997], [56, 223317], [60, 223577], [67, 224457], [71, 224517], [78, 225017], [85, 225917], [91, 226137], [95, 226397], [102, 226877], [104, 227217], [108, 227397], [112, 227617], [120, 228498], [122, 228682], [135, 229482], [138, 229662], [143, 229962], [146, 230082]]}, {"verse": 32, "start": 231109, "end": 245820, "text": "Y Jesús llamando a sus discípulos, dijo: Tengo compasión de la gente, que ya hace tres días que perseveran conmigo, y no tienen qué comer; y enviarlos en ayunas no quiero, porque no desmayen en el camino.", "words": [[0, 231109], [2, 231252], [8, 232032], [17, 232592], [19, 232692], [23, 232872], [35, 233932], [41, 234653], [47, 234933], [57, 235633], [60, 235793], [63, 235913], [70, 236353], [74, 236893], [77, 237133], [82, 237393], [87, 237753], [92, 238173], [96, 238353], [107, 239013], [116, 239673], [118, 240013], [121, 240133], [128, 240373], [132, 240593], [139, 241344], [141, 241448], [151, 242048], [154, 242328], [161, 242828], [164, 243148], [172, 243788], [179, 244148], [182, 244368], [191, 244948], [194, 245068], [197, 245188]]}, {"verse": 33, "start": 246170, "end": 254218, "text": "Entonces sus discípulos le dicen: ¿Dónde tenemos nosotros tantos panes en el desierto, para alimentar a tanta gente?", "words": [[0, 246170], [9, 246876], [13, 247656], [24, 248656], [27, 248936], [34, 249749], [41, 249970], [49, 250430], [58, 250750], [65, 251430], [71, 251810], [74, 251910], [77, 252030], [87, 252530], [92, 252785], [102, 253305], [104, 253365], [110, 253525]]}, {"verse": 34, "start": 254498, "end": 261530, "text": "Y Jesús les dice: ¿Cuántos panes tenéis? Y ellos dijeron: Siete, y unos pocos pececillos.", "words": [[0, 254498], [2, 254642], [8, 255042], [12, 255422], [18, 256213], [27, 256618], [33, 257138], [41, 258041], [43, 258224], [49, 258404], [58, 259541], [65, 259691], [67, 260031], [72, 260231], [78, 260911]]}, {"verse": 35, "start": 261810, "end": 265018, "text": "Y mandó a la multitud que se recostase en tierra.", "words": [[0, 261810], [2, 261914], [8, 262254], [10, 262354], [13, 262434], [22, 263054], [26, 263194], [29, 263354], [39, 264054], [42, 264274]]}, {"verse": 36, "start": 265368, "end": 273869, "text": "Y tomando los siete panes y los peces, haciendo gracias, partió y dio a sus discípulos; y los discípulos a la gente.", "words": [[0, 265368], [2, 265706], [10, 266266], [14, 266606], [20, 266906], [26, 267526], [28, 267626], [32, 267726], [39, 268406], [48, 268726], [57, 269526], [64, 270046], [66, 270286], [70, 270526], [72, 270666], [76, 270826], [88, 271938], [90, 272041], [94, 272181], [105, 272861], [107, 273161], [110, 273221]]}, {"verse": 37, "start": 274219, "end": 281118, "text": "Y comieron todos, y se saciaron: y alzaron lo que sobró de los pedazos, siete canastas llenas.", "words": [[0, 274219], [2, 274341], [11, 274781], [18, 275181], [20, 275561], [23, 275681], [33, 276865], [35, 276966], [43, 277526], [46, 277686], [50, 277826], [56, 278266], [59, 278326], [63, 278466], [72, 279016], [78, 279566], [87, 280346]]}, {"verse": 38, "start": 281468, "end": 286376, "text": "Y eran los que habían comido, cuatro mil hombres, sin las mujeres y los niños.", "words": [[0, 281468], [2, 281634], [7, 281834], [11, 282054], [15, 282214], [22, 282474], [30, 282912], [37, 283351], [41, 283789], [50, 284149], [54, 284669], [58, 284889], [66, 285289], [68, 285529], [72, 285669]]}, {"verse": 39, "start": 286726, "end": 293015, "text": "Entonces, despedida la gente, subió en el barco: y vino a los términos de Magdala.", "words": [[0, 286726], [10, 287382], [20, 288522], [23, 288642], [30, 289102], [36, 289602], [39, 289742], [42, 289862], [49, 290735], [51, 291015], [56, 291255], [58, 291395], [62, 291535], [71, 292115], [74, 292585]]}]}