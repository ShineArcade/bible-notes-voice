{"book": "GEN", "chapter": 42, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 304146, "verses": [{"verse": 1, "start": 300, "end": 7727, "text": "Now when Jacob saw that there was grain in Egypt, Jacob said to his sons, Why do you look one upon another?", "words": [[0, 300], [4, 457], [9, 677], [15, 977], [19, 1357], [24, 1537], [30, 1717], [34, 1877], [40, 2257], [43, 2517], [50, 3257], [56, 3557], [61, 3877], [64, 4057], [68, 4237], [74, 5726], [78, 5964], [81, 6224], [85, 6364], [90, 6584], [94, 6864], [99, 7144]]}, {"verse": 2, "start": 8007, "end": 16573, "text": "And he said, Behold, I have heard that there is grain in Egypt: get you down there, and buy for us from there; that we may live, and not die.", "words": [[0, 8007], [4, 8141], [7, 8281], [13, 9690], [21, 10010], [23, 10230], [28, 10430], [34, 10670], [39, 10890], [45, 11050], [48, 11170], [54, 11410], [57, 11570], [64, 12308], [68, 12429], [72, 12569], [77, 12769], [84, 13049], [88, 13389], [92, 13669], [96, 13889], [99, 14049], [104, 14229], [111, 14841], [116, 14944], [119, 15104], [123, 15244], [129, 15584], [133, 15884], [137, 16084]]}, {"verse": 3, "start": 16853, "end": 20241, "text": "¶ And Joseph’s ten brethren went down to buy grain in Egypt.", "words": [[2, 16853], [6, 16985], [15, 17385], [19, 17785], [28, 18265], [33, 18585], [38, 18845], [41, 19025], [45, 19185], [51, 19525], [54, 19725]]}, {"verse": 4, "start": 20591, "end": 27531, "text": "But Benjamin, Joseph’s brother, Jacob sent not with his brethren; for he said, Lest perhaps mischief befall him.", "words": [[0, 20591], [4, 20715], [14, 21055], [23, 21795], [32, 22175], [38, 22615], [43, 22775], [47, 23135], [52, 23435], [56, 23595], [66, 24555], [70, 24672], [73, 24832], [79, 25452], [84, 25812], [92, 26152], [101, 26732], [108, 27172]]}, {"verse": 5, "start": 27881, "end": 34148, "text": "And the sons of Israel came to buy grain among those that came: for the famine was in the land of Canaan.", "words": [[0, 27881], [4, 28010], [8, 28130], [13, 28410], [16, 28630], [23, 29010], [28, 29350], [31, 29570], [35, 29790], [41, 30170], [47, 30590], [53, 30950], [58, 31230], [64, 31990], [68, 32084], [72, 32224], [79, 32584], [83, 32864], [86, 33004], [90, 33104], [95, 33344], [98, 33484]]}, {"verse": 6, "start": 34498, "end": 45419, "text": "And Joseph was the governor over the land, and he it was that sold to all the people of the land: and Joseph’s brethren came, and bowed down themselves before him with their faces to the earth.", "words": [[0, 34498], [4, 34632], [11, 34932], [15, 35212], [19, 35372], [28, 35652], [33, 35952], [37, 36132], [43, 36832], [47, 37052], [50, 37252], [53, 37432], [57, 37712], [62, 38012], [67, 38292], [70, 38512], [74, 38752], [78, 38892], [85, 39152], [88, 39352], [92, 39492], [98, 40170], [102, 40289], [111, 40809], [120, 41109], [126, 41549], [130, 42249], [136, 42629], [141, 42809], [152, 43169], [159, 43749], [163, 44049], [168, 44229], [174, 44389], [180, 44729], [183, 45029], [187, 45189]]}, {"verse": 7, "start": 45769, "end": 57626, "text": "And Joseph saw his brethren, and he knew them, but made himself strange to them, and spoke roughly to them; and he said to them, From where come you? And they said, From the land of Canaan to buy food.", "words": [[0, 45769], [4, 45917], [11, 46217], [15, 46577], [19, 46757], [29, 47597], [33, 47757], [36, 47897], [41, 48117], [47, 48657], [51, 48837], [56, 49057], [64, 49417], [72, 49857], [75, 50137], [81, 50657], [85, 50717], [91, 50917], [99, 51337], [102, 51617], [108, 52214], [112, 52357], [115, 52497], [120, 52737], [123, 52937], [129, 53417], [134, 53577], [140, 53797], [145, 54037], [150, 54639], [154, 54778], [159, 54978], [165, 55338], [170, 55618], [174, 55778], [179, 55998], [182, 56158], [189, 56598], [192, 56798], [196, 57058]]}, {"verse": 8, "start": 57976, "end": 60863, "text": "And Joseph knew his brethren, but they knew not him.", "words": [[0, 57976], [4, 58123], [11, 58463], [16, 58783], [20, 58943], [30, 59703], [34, 59823], [39, 60003], [44, 60183], [48, 60403]]}, {"verse": 9, "start": 61213, "end": 69862, "text": "And Joseph remembered the dreams which he dreamed of them, and said to them, You are spies; to see the nakedness of the land you are come.", "words": [[0, 61213], [4, 61363], [11, 61663], [22, 62123], [26, 62383], [33, 62743], [39, 62983], [42, 63203], [50, 63503], [53, 63703], [59, 64463], [63, 64623], [68, 64843], [71, 65023], [77, 66128], [81, 66248], [85, 66348], [92, 67347], [95, 67446], [99, 67726], [103, 67886], [113, 68506], [116, 68686], [120, 68846], [125, 69106], [129, 69286], [133, 69426]]}, {"verse": 10, "start": 70142, "end": 74804, "text": "And they said to him, No, my lord, but to buy food are your servants come.", "words": [[0, 70142], [4, 70278], [9, 70418], [14, 70638], [17, 70838], [22, 71298], [26, 71758], [29, 71858], [35, 72578], [39, 72698], [42, 72878], [46, 73118], [51, 73638], [55, 73718], [60, 73838], [69, 74218]]}, {"verse": 11, "start": 75154, "end": 79946, "text": "We are all one man’s sons; we are true men, your servants are no spies.", "words": [[0, 75154], [3, 75324], [7, 75464], [11, 75724], [15, 76004], [21, 76484], [27, 77236], [30, 77403], [34, 77523], [39, 77803], [44, 78323], [49, 78383], [58, 78743], [62, 78983], [65, 79163]]}, {"verse": 12, "start": 80296, "end": 84419, "text": "And he said to them, No, but to see the nakedness of the land you are come.", "words": [[0, 80296], [4, 80426], [7, 80546], [12, 80786], [15, 80986], [21, 81532], [25, 81791], [29, 82011], [32, 82231], [36, 82431], [40, 82571], [50, 83151], [53, 83311], [57, 83431], [62, 83691], [66, 83871], [70, 84011]]}, {"verse": 13, "start": 84699, "end": 94247, "text": "And they said, Your servants are twelve brethren, the sons of one man in the land of Canaan; and, behold, the youngest is this day with our father, and one is not.", "words": [[0, 84699], [4, 84848], [9, 84988], [15, 85268], [20, 85428], [29, 85848], [33, 86068], [40, 86448], [50, 87488], [54, 87548], [59, 87788], [62, 88008], [66, 88228], [70, 88488], [73, 88668], [77, 88768], [82, 89028], [85, 89168], [93, 90009], [98, 90275], [106, 91075], [110, 91255], [119, 91515], [122, 91835], [127, 92055], [131, 92315], [136, 92515], [140, 92655], [148, 93315], [152, 93415], [156, 93635], [159, 93835]]}, {"verse": 14, "start": 94597, "end": 98790, "text": "And Joseph said to them, That is it that I spoke to you, saying, You are spies:", "words": [[0, 94597], [4, 94738], [11, 95058], [16, 95378], [19, 95578], [25, 96173], [30, 96373], [33, 96553], [36, 96673], [41, 96813], [43, 96933], [49, 97153], [52, 97373], [57, 97533], [65, 97833], [69, 98073], [73, 98153]]}, {"verse": 15, "start": 99140, "end": 105284, "text": "Hereby you shall be proved: By the life of Pharaoh you shall not go forth from here, unless your youngest brother come here.", "words": [[0, 99140], [7, 99691], [11, 99791], [17, 99951], [20, 100071], [28, 100744], [31, 100849], [35, 100969], [40, 101249], [43, 101369], [51, 101869], [55, 101929], [61, 102109], [65, 102329], [68, 102509], [74, 102789], [79, 102949], [85, 103589], [92, 103849], [97, 104049], [106, 104329], [114, 104669], [119, 104929]]}, {"verse": 16, "start": 105634, "end": 116317, "text": "Send one of you, and let him fetch your brother, and you shall be kept in prison, that your words may be proved, whether there be any truth in you: or else by the life of Pharaoh surely you are spies.", "words": [[0, 105634], [5, 105830], [9, 106130], [12, 106270], [17, 106470], [21, 106670], [25, 106830], [29, 107010], [35, 107310], [40, 107510], [49, 108230], [53, 108370], [57, 108470], [63, 108590], [66, 108750], [71, 108970], [74, 109130], [82, 109810], [87, 109930], [92, 110090], [98, 110410], [102, 110630], [105, 110770], [113, 111150], [121, 111670], [127, 111890], [130, 112090], [134, 112230], [140, 112550], [143, 112810], [148, 113319], [151, 113484], [156, 113644], [159, 113864], [163, 113984], [168, 114264], [171, 114584], [179, 114904], [186, 115164], [190, 115464], [194, 115584]]}, {"verse": 17, "start": 116597, "end": 119496, "text": "And he put them all together into ward three days.", "words": [[0, 116597], [4, 116738], [7, 116838], [11, 117018], [16, 117198], [20, 117458], [29, 117798], [34, 118138], [39, 118518], [45, 118858]]}, {"verse": 18, "start": 119846, "end": 124559, "text": "And Joseph said to them the third day, This do, and live; for I fear God:", "words": [[0, 119846], [4, 119992], [11, 120312], [16, 120632], [19, 120832], [24, 121032], [28, 121212], [34, 121452], [39, 122162], [44, 122360], [48, 122680], [52, 123030], [58, 123600], [62, 123759], [64, 123939], [69, 124119]]}, {"verse": 19, "start": 124909, "end": 131838, "text": "If you be true men, let one of your brethren be bound in the house of your prison: go, carry grain for the famine of your houses:", "words": [[0, 124909], [3, 125027], [7, 125147], [10, 125287], [15, 125567], [20, 126247], [24, 126407], [28, 126687], [31, 126787], [36, 126907], [45, 127307], [48, 127507], [54, 127787], [57, 127987], [61, 128087], [67, 128307], [70, 128467], [75, 128567], [83, 129264], [87, 129383], [93, 129723], [99, 130163], [103, 130443], [107, 130583], [114, 130863], [117, 131083], [122, 131223]]}, {"verse": 20, "start": 132188, "end": 138481, "text": "But bring your youngest brother to me; so shall your words be verified, and you shall not die. And they did so.", "words": [[0, 132188], [4, 132289], [10, 132569], [15, 132789], [24, 133149], [32, 133509], [35, 133729], [39, 134181], [42, 134364], [48, 134604], [53, 134784], [59, 135104], [62, 135304], [72, 135764], [76, 136304], [80, 136444], [86, 136624], [90, 136844], [95, 137570], [99, 137727], [104, 137827], [108, 138027]]}, {"verse": 21, "start": 138831, "end": 150950, "text": "¶ And they said one to another, We are indeed guilty concerning our brother, in that we saw the anguish of his soul, when he besought us, and we would not hear; therefore is this distress come upon us.", "words": [[2, 138831], [6, 138978], [11, 139078], [16, 139298], [20, 139538], [23, 139738], [32, 140318], [35, 140678], [39, 140878], [46, 141178], [53, 141638], [64, 142258], [68, 142558], [77, 142918], [80, 143558], [85, 143718], [88, 143898], [92, 144178], [96, 144338], [104, 144878], [107, 145058], [111, 145198], [117, 145638], [122, 146258], [125, 146398], [134, 146818], [138, 147497], [142, 147625], [145, 147765], [151, 147945], [155, 148145], [161, 148831], [171, 149336], [174, 149436], [179, 149556], [188, 149976], [193, 150276], [198, 150536]]}, {"verse": 22, "start": 151300, "end": 160594, "text": "And Reuben answered them, saying, Spoke I not to you, saying, Do not sin against the child; and you would not hear? therefore, behold, also his blood is required.", "words": [[0, 151300], [4, 151546], [11, 151826], [20, 152126], [26, 152346], [34, 153444], [40, 153667], [42, 153927], [46, 154127], [49, 154307], [54, 154487], [62, 154807], [65, 155187], [69, 155327], [73, 155567], [81, 155827], [85, 155987], [92, 156703], [96, 156829], [100, 156949], [106, 157049], [110, 157189], [116, 157950], [127, 158534], [135, 159014], [140, 159294], [144, 159494], [150, 159774], [153, 159974]]}, {"verse": 23, "start": 160874, "end": 165503, "text": "And they knew not that Joseph understood them; for he spoke to them by an interpreter.", "words": [[0, 160874], [4, 161028], [9, 161168], [14, 161428], [18, 161668], [23, 161908], [30, 162188], [41, 162828], [47, 163492], [51, 163601], [54, 163741], [60, 164021], [63, 164241], [68, 164401], [71, 164641], [74, 164741]]}, {"verse": 24, "start": 165853, "end": 175439, "text": "And he turned himself about from them, and wept; and returned to them again, and communed with them, and took from them Simeon, and bound him before their eyes.", "words": [[0, 165853], [4, 165991], [7, 166091], [14, 166351], [22, 166751], [28, 167151], [33, 167411], [39, 167691], [43, 168071], [49, 168820], [53, 168972], [62, 169292], [65, 169532], [70, 169672], [77, 170412], [81, 170592], [90, 171152], [95, 171272], [101, 171832], [105, 172032], [110, 172232], [115, 172472], [120, 172692], [128, 173532], [132, 173792], [138, 174092], [142, 174312], [149, 174552], [155, 174852]]}, {"verse": 25, "start": 175789, "end": 185813, "text": "¶ Then Joseph commanded to fill their sacks with grain, and to restore every man’s money into his sack, and to give them provision for the way: and thus did he to them.", "words": [[2, 175789], [7, 176066], [14, 176486], [24, 177006], [27, 177246], [32, 177426], [38, 177606], [44, 177966], [49, 178146], [56, 178766], [60, 179126], [63, 179266], [71, 179706], [77, 180026], [83, 180486], [89, 180746], [94, 181066], [98, 181266], [104, 181866], [108, 182146], [111, 182266], [116, 182426], [121, 182626], [131, 183086], [135, 183366], [139, 183506], [144, 184158], [148, 184478], [153, 184758], [157, 185058], [160, 185178], [163, 185398]]}, {"verse": 26, "start": 186163, "end": 189804, "text": "And they loaded their donkeys with the grain, and departed from there.", "words": [[0, 186163], [4, 186291], [9, 186391], [16, 186691], [22, 186931], [30, 187371], [35, 187591], [39, 187731], [46, 188011], [50, 188591], [59, 188991], [64, 189291]]}, {"verse": 27, "start": 190154, "end": 198222, "text": "And as one of them opened his sack to give his donkey provender in the inn, he espied his money; for, behold, it was in his sack’s mouth.", "words": [[0, 190154], [4, 190302], [7, 190422], [11, 190622], [14, 190742], [19, 190902], [26, 191162], [30, 191402], [35, 191722], [38, 191942], [43, 192082], [47, 192262], [54, 192692], [64, 193122], [67, 193302], [71, 193442], [76, 194122], [79, 194432], [86, 194742], [90, 194902], [97, 195586], [102, 195697], [110, 196677], [113, 196797], [117, 196997], [120, 197177], [124, 197317], [131, 197797]]}, {"verse": 28, "start": 198572, "end": 211620, "text": "And he said to his brethren, My money is restored; and, lo, it is even in my sack: and their heart failed them, and they were afraid, saying one to another, What is this that God has done to us?", "words": [[0, 198572], [4, 198715], [7, 198815], [12, 199055], [15, 199255], [19, 199395], [29, 200175], [32, 200375], [38, 200695], [41, 200915], [51, 201930], [56, 202505], [60, 203115], [63, 203215], [66, 203375], [71, 203615], [74, 203755], [77, 203955], [83, 204791], [87, 204958], [93, 205138], [99, 205438], [106, 205898], [112, 206418], [116, 206498], [121, 206678], [126, 206898], [134, 207638], [141, 207978], [145, 208298], [148, 208558], [157, 209378], [162, 209558], [165, 209738], [170, 209998], [175, 210218], [179, 210478], [183, 210718], [188, 210978], [191, 211178]]}, {"verse": 29, "start": 211970, "end": 218442, "text": "¶ And they came to Jacob their father to the land of Canaan, and told him all that befell to them; saying,", "words": [[2, 211970], [6, 212100], [11, 212220], [16, 212460], [19, 212660], [25, 212960], [31, 213220], [38, 213560], [41, 213820], [45, 213980], [50, 214260], [53, 214440], [61, 215480], [65, 215540], [70, 215800], [74, 216040], [78, 216380], [83, 216600], [90, 216980], [93, 217180], [99, 217810]]}, {"verse": 30, "start": 218792, "end": 224972, "text": "The man, who is the lord of the land, spoke roughly to us, and took us for spies of the country.", "words": [[0, 218792], [4, 218891], [9, 219171], [13, 219431], [16, 219611], [20, 219771], [25, 220051], [28, 220231], [32, 220371], [38, 220771], [44, 221391], [52, 221911], [55, 222231], [59, 222511], [63, 223031], [68, 223211], [71, 223411], [75, 223591], [81, 223991], [84, 224231], [88, 224351]]}, {"verse": 31, "start": 225322, "end": 229629, "text": "And we said to him, We are true men; we are no spies:", "words": [[0, 225322], [4, 225470], [7, 225630], [12, 225890], [15, 226090], [20, 226650], [23, 226910], [27, 227050], [32, 227370], [37, 228266], [40, 228453], [44, 228613], [47, 228853]]}, {"verse": 32, "start": 229979, "end": 237181, "text": "We are twelve brethren, sons of our father; one is not, and the youngest is this day with our father in the land of Canaan.", "words": [[0, 229979], [3, 230163], [7, 230283], [14, 230603], [24, 231563], [29, 231763], [32, 231963], [36, 232083], [44, 232852], [48, 233039], [51, 233219], [56, 233719], [60, 233899], [64, 233999], [73, 234259], [76, 234579], [81, 234799], [85, 235059], [90, 235259], [94, 235399], [101, 235759], [104, 235979], [108, 236059], [113, 236359], [116, 236519]]}, {"verse": 33, "start": 237531, "end": 248814, "text": "And the man, the lord of the country, said to us, Hereby shall I know that you are true men; leave one of your brethren here with me, and take food for the famine of your households, and be gone:", "words": [[0, 237531], [4, 237678], [8, 237818], [13, 238038], [17, 238258], [22, 238478], [25, 238638], [29, 238738], [38, 239118], [43, 239558], [46, 239798], [50, 240558], [57, 241038], [63, 241338], [65, 241578], [70, 241858], [75, 242158], [79, 242338], [83, 242478], [88, 242718], [93, 243559], [99, 243756], [103, 243996], [106, 244076], [111, 244196], [120, 244516], [125, 244856], [130, 245076], [134, 245396], [138, 245856], [143, 246036], [148, 246336], [152, 246536], [156, 246636], [163, 246916], [166, 247076], [171, 247196], [183, 247616], [187, 248096], [190, 248256]]}, {"verse": 34, "start": 249164, "end": 259550, "text": "And bring your youngest brother to me: then shall I know that you are no spies, but that you are true men: so will I deliver you your brother, and you shall trade in the land.", "words": [[0, 249164], [4, 249288], [10, 249468], [15, 249628], [24, 249948], [32, 250288], [35, 250528], [39, 251147], [44, 251417], [50, 251717], [52, 251917], [57, 252157], [62, 252357], [66, 252537], [70, 252657], [73, 252877], [80, 253857], [84, 254097], [89, 254277], [93, 254537], [97, 254677], [102, 254977], [107, 255627], [110, 255828], [115, 256068], [117, 256208], [125, 256568], [129, 256908], [134, 257048], [143, 257788], [147, 258028], [151, 258168], [157, 258368], [163, 258708], [166, 258888], [170, 258988]]}, {"verse": 35, "start": 259900, "end": 271341, "text": "¶ And it came to pass as they emptied their sacks, that, behold, every man’s bundle of money was in his sack: and when both they and their father saw the bundles of money, they were afraid.", "words": [[2, 259900], [6, 260034], [9, 260154], [14, 260334], [17, 260494], [22, 260854], [25, 261114], [30, 261254], [38, 261754], [44, 261894], [51, 262774], [57, 263094], [65, 263874], [71, 264134], [77, 264614], [84, 264854], [87, 265094], [93, 265374], [97, 265634], [100, 265814], [104, 265974], [110, 266780], [114, 266924], [119, 267064], [124, 267364], [129, 267724], [133, 268064], [139, 268334], [146, 268604], [150, 268944], [154, 269064], [162, 269504], [165, 269604], [172, 270424], [177, 270544], [182, 270724]]}, {"verse": 36, "start": 271691, "end": 281130, "text": "And Jacob their father said to them, Me have you bereaved of my children: Joseph is not, and Simeon is not, and you will take Benjamin away: all these things are against me.", "words": [[0, 271691], [4, 271834], [10, 272094], [16, 272334], [23, 272674], [28, 272954], [31, 273134], [37, 273662], [40, 273807], [45, 274027], [49, 274167], [58, 274707], [61, 274827], [64, 274987], [74, 275822], [81, 276084], [84, 276344], [89, 276644], [93, 277024], [100, 277484], [103, 277604], [108, 277864], [112, 278204], [116, 278304], [121, 278424], [126, 278624], [135, 279084], [141, 279824], [145, 279985], [151, 280145], [158, 280385], [162, 280565], [170, 280745]]}, {"verse": 37, "start": 281410, "end": 290491, "text": "And Reuben spoke to his father, saying, Slay my two sons, if I bring him not to you: deliver him into my hand, and I will bring him to you again.", "words": [[0, 281410], [4, 281658], [11, 281938], [17, 282198], [20, 282478], [24, 282638], [32, 283298], [40, 284128], [45, 284363], [48, 284503], [52, 284683], [58, 284983], [61, 285583], [63, 285723], [69, 285963], [73, 286163], [77, 286343], [80, 286543], [85, 287115], [93, 287360], [97, 287640], [102, 287920], [105, 288120], [111, 288460], [115, 288860], [117, 288980], [122, 289100], [128, 289340], [132, 289560], [135, 289740], [139, 289940]]}, {"verse": 38, "start": 290771, "end": 303745, "text": "And he said, My son shall not go down with you; for his brother is dead, and he is left alone: if mischief befall him by the way in which you go, then shall you bring down my gray hairs with sorrow to the grave.", "words": [[0, 290771], [4, 290906], [7, 291046], [13, 292454], [16, 292573], [20, 292803], [26, 293033], [30, 293213], [33, 293373], [38, 293553], [43, 293773], [48, 294205], [52, 294313], [56, 294413], [64, 294653], [67, 294833], [73, 295093], [77, 295473], [80, 295653], [83, 295773], [88, 295973], [95, 296647], [98, 296795], [107, 297215], [114, 297655], [118, 297915], [121, 298155], [125, 298295], [129, 298515], [132, 298635], [138, 298775], [142, 298955], [146, 299655], [151, 299795], [157, 299995], [161, 300155], [167, 300355], [172, 300675], [175, 300895], [180, 301155], [186, 301555], [191, 301715], [198, 302075], [201, 302295], [205, 302435]]}]}