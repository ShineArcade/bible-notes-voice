{"book": "ACT", "chapter": 4, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 310821, "verses": [{"verse": 1, "start": 300, "end": 8677, "text": "Y hablando ellos al pueblo, sobrevinieron los sacerdotes, y el jefe de la guardia del templo, y los saduceos,", "words": [[0, 300], [2, 422], [11, 662], [17, 1062], [20, 1342], [28, 2102], [42, 3022], [46, 3262], [58, 4182], [60, 4662], [63, 4802], [68, 5242], [71, 5342], [74, 5442], [82, 5922], [86, 6102], [94, 7122], [96, 7282], [100, 7502]]}, {"verse": 2, "start": 9127, "end": 15623, "text": "Resentidos de que enseñasen al pueblo, y anunciasen en Jesús la resurrección de los muertos.", "words": [[0, 9127], [11, 9908], [14, 10068], [18, 10478], [28, 10888], [31, 11008], [39, 11428], [41, 12088], [52, 12748], [55, 12848], [61, 13228], [64, 13748], [77, 14588], [80, 14768], [84, 14888]]}, {"verse": 3, "start": 16073, "end": 22491, "text": "Y les echaron mano, y los pusieron en la cárcel hasta el día siguiente; porque era ya tarde.", "words": [[0, 16073], [2, 16199], [6, 16339], [14, 16799], [20, 17179], [22, 17959], [26, 18059], [35, 18559], [38, 18719], [41, 18859], [48, 19379], [54, 19659], [57, 19839], [61, 20039], [72, 21188], [79, 21452], [83, 21672], [86, 21832]]}, {"verse": 4, "start": 22941, "end": 29662, "text": "Pero muchos de los que habían oído la palabra, creyeron; y fue el número de los varones como cinco mil.", "words": [[0, 22941], [5, 23145], [12, 23785], [15, 24165], [19, 24305], [23, 24465], [30, 24725], [35, 25045], [38, 25205], [47, 25585], [57, 26777], [59, 26903], [63, 27123], [66, 27483], [73, 27803], [76, 28023], [80, 28183], [88, 28543], [93, 28929], [99, 29315]]}, {"verse": 5, "start": 30112, "end": 37655, "text": "Y aconteció al día siguiente, que se juntaron en Jerusalén los príncipes de ellos, y los ancianos, y los escribas;", "words": [[0, 30112], [2, 30217], [12, 30957], [15, 31097], [19, 31257], [30, 31697], [34, 31977], [37, 32137], [46, 32817], [49, 32957], [59, 33697], [63, 34077], [73, 34757], [76, 34937], [83, 35237], [85, 35697], [89, 35857], [99, 36437], [101, 36657], [105, 36817]]}, {"verse": 6, "start": 38105, "end": 46911, "text": "Y Anás, sumo sacerdote, y Caifás, y Juan y Alejandro, y todos los que eran del linaje sacerdotal;", "words": [[0, 38105], [2, 38269], [8, 38689], [13, 39409], [24, 40209], [26, 40789], [34, 41549], [36, 42149], [41, 42469], [43, 42769], [54, 43409], [56, 43989], [62, 44269], [66, 44569], [70, 44809], [75, 45089], [79, 45369], [86, 45869]]}, {"verse": 7, "start": 47361, "end": 55906, "text": "Y haciéndolos presentar en medio, les preguntaron: ¿Con qué potestad, o en qué nombre, habéis hecho vosotros esto?", "words": [[0, 47361], [2, 47661], [14, 48341], [24, 49021], [27, 49141], [34, 49961], [38, 50181], [51, 51382], [56, 51546], [60, 51826], [70, 52106], [72, 52386], [75, 52546], [79, 52686], [87, 53066], [94, 53786], [100, 54006], [109, 54506]]}, {"verse": 8, "start": 56256, "end": 62318, "text": "Entonces Pedro, lleno del Espíritu Santo, les dijo: Príncipes del pueblo, y ancianos de Israel:", "words": [[0, 56256], [9, 57181], [16, 57481], [22, 57781], [26, 58081], [35, 58641], [42, 58921], [46, 59181], [52, 59962], [62, 60413], [66, 60593], [74, 60933], [76, 61153], [85, 61673], [88, 61773]]}, {"verse": 9, "start": 62768, "end": 69053, "text": "Pues que somos hoy interrogados acerca del beneficio hecho a un hombre enfermo, de qué manera este haya sido sanado,", "words": [[0, 62768], [5, 62888], [9, 63008], [15, 63288], [19, 63588], [32, 64268], [39, 64568], [43, 64888], [53, 65508], [59, 65728], [61, 65908], [64, 66028], [71, 66248], [80, 67028], [83, 67188], [87, 67308], [94, 67568], [99, 67968], [104, 68208], [109, 68468]]}, {"verse": 10, "start": 69503, "end": 84471, "text": "Sea notorio a todos vosotros, y a todo el pueblo de Israel, que en el nombre de Jesucristo de Nazaret, al que vosotros crucificasteis y Dios le resucitó de los muertos, por él este hombre está en vuestra presencia sano.", "words": [[0, 69503], [4, 69678], [12, 70198], [14, 70318], [20, 70558], [30, 71198], [32, 71738], [34, 71798], [39, 71998], [42, 72138], [49, 72338], [52, 72518], [60, 72918], [64, 73318], [67, 73418], [70, 73518], [77, 73818], [80, 73978], [91, 74638], [94, 74758], [103, 76155], [106, 76311], [110, 76431], [119, 76831], [134, 77991], [136, 78211], [141, 78431], [144, 78671], [153, 79271], [156, 79351], [160, 79491], [169, 80431], [173, 80631], [176, 80791], [181, 81171], [188, 81451], [193, 81731], [196, 81871], [204, 82251], [214, 82771]]}, {"verse": 11, "start": 84921, "end": 91090, "text": "Este es la piedra rechazada por vosotros los edificadores, la cual es puesta por cabeza del ángulo.", "words": [[0, 84921], [5, 85204], [8, 85444], [11, 85624], [18, 86024], [28, 86664], [32, 86864], [41, 87364], [45, 87584], [59, 88864], [62, 88964], [67, 89231], [70, 89497], [77, 89764], [81, 89984], [88, 90324], [92, 90564]]}, {"verse": 12, "start": 91540, "end": 99482, "text": "Y en ningún otro hay salvación; porque no hay otro nombre debajo del cielo, dado a los hombres, en que podamos ser salvos.", "words": [[0, 91540], [2, 91665], [5, 91765], [12, 92105], [17, 92445], [21, 92745], [32, 93830], [39, 94041], [42, 94281], [46, 94481], [51, 94741], [58, 95161], [65, 95641], [69, 95841], [76, 96261], [81, 96801], [83, 97001], [87, 97121], [96, 97481], [99, 98021], [103, 98161], [111, 98581], [115, 98801]]}, {"verse": 13, "start": 99832, "end": 112876, "text": "Entonces viendo la valentía de Pedro y de Juan, sabido que eran hombres sin formación y del pueblo común, se maravillaban; y reconocían que habían estado con Jesús.", "words": [[0, 99832], [9, 100945], [16, 101265], [19, 101505], [28, 102145], [31, 102265], [37, 102785], [39, 102965], [42, 103065], [48, 103825], [55, 104325], [59, 104525], [64, 104765], [72, 105285], [76, 105765], [86, 106505], [88, 106985], [92, 107145], [99, 107465], [106, 108305], [109, 108525], [123, 109931], [125, 110171], [136, 111091], [140, 111311], [147, 111571], [154, 111871], [158, 112191]]}, {"verse": 14, "start": 113326, "end": 119299, "text": "Y viendo al hombre que había sido sanado, que estaba con ellos, no podían decir nada en contra.", "words": [[0, 113326], [2, 113467], [9, 113787], [12, 113987], [19, 114227], [23, 114427], [29, 114627], [34, 114947], [42, 115587], [46, 115627], [53, 115847], [57, 116147], [64, 116907], [67, 117287], [74, 117727], [80, 118027], [85, 118387], [88, 118607]]}, {"verse": 15, "start": 119749, "end": 125072, "text": "Pero les mandaron que se saliesen fuera del Consejo; y deliberaban entre sí,", "words": [[0, 119749], [5, 119885], [9, 120055], [18, 120535], [22, 120715], [25, 120855], [34, 121395], [40, 121715], [44, 121995], [53, 123404], [55, 123404], [67, 124211], [73, 124530]]}, {"verse": 16, "start": 125522, "end": 136022, "text": "Diciendo: ¿Qué hemos de hacer a estos hombres? porque de cierto, señal manifiesta ha sido hecha por ellos, notoria a todos los que moran en Jerusalén, y no lo podemos negar.", "words": [[0, 125522], [10, 126640], [15, 126795], [21, 127035], [24, 127255], [30, 127435], [32, 127595], [38, 127755], [47, 128699], [54, 128922], [57, 129082], [65, 129302], [71, 129882], [82, 130562], [85, 130682], [90, 130862], [96, 131142], [100, 131362], [107, 131942], [115, 132522], [117, 132842], [123, 133042], [127, 133322], [131, 133502], [137, 133822], [140, 134062], [151, 134302], [153, 134942], [156, 135062], [159, 135162], [167, 135462]]}, {"verse": 17, "start": 136472, "end": 143898, "text": "Sin embargo, para que no se divulgue más por el pueblo, amenacémoslos que no hablen de aquí en adelante a hombre alguno en este nombre.", "words": [[0, 136472], [4, 136588], [13, 137068], [18, 137228], [22, 137368], [25, 137508], [28, 137648], [37, 138128], [41, 138328], [45, 138588], [48, 138708], [56, 139508], [70, 140308], [74, 140508], [77, 140728], [84, 141048], [87, 141128], [92, 141368], [95, 141508], [104, 141948], [106, 142248], [113, 142528], [120, 143068], [123, 143208], [128, 143428]]}, {"verse": 18, "start": 144248, "end": 150806, "text": "Y llamándolos, les ordenaron que en ninguna manera hablasen ni enseñasen en el nombre de Jesús.", "words": [[0, 144248], [2, 144374], [15, 145694], [19, 145894], [29, 146694], [33, 146894], [36, 147034], [44, 147394], [51, 147889], [60, 148384], [63, 148879], [73, 149374], [76, 149494], [79, 149614], [86, 149914], [89, 150134]]}, {"verse": 19, "start": 151256, "end": 159386, "text": "Entonces Pedro y Juan, respondiendo, les dijeron: Juzgad si es justo delante de Dios obedecer antes a vosotros que a Dios:", "words": [[0, 151256], [9, 152085], [15, 152445], [17, 152625], [23, 153105], [37, 153585], [41, 154065], [50, 154902], [57, 155422], [60, 155682], [63, 155842], [69, 156042], [77, 156522], [80, 156622], [85, 156842], [94, 157602], [100, 157962], [102, 158162], [111, 158582], [115, 158822], [117, 158922]]}, {"verse": 20, "start": 159836, "end": 162928, "text": "Porque no podemos dejar de decir lo que hemos visto y oído.", "words": [[0, 159836], [7, 160025], [10, 160245], [18, 160625], [24, 160965], [27, 161145], [33, 161425], [36, 161645], [40, 161765], [46, 161925], [52, 162305], [54, 162505]]}, {"verse": 21, "start": 163278, "end": 174980, "text": "Ellos entonces los despacharon amenazándolos, no hallando ningún modo de castigarlos, por causa del pueblo; porque todos glorificaban a Dios de lo que había sido hecho.", "words": [[0, 163278], [6, 163645], [15, 164125], [19, 164445], [31, 165205], [46, 166605], [49, 166925], [58, 167505], [65, 167845], [70, 168305], [73, 168465], [86, 169225], [90, 169525], [96, 169845], [100, 170125], [108, 171021], [115, 171225], [121, 171665], [134, 172825], [136, 172965], [141, 173185], [144, 173565], [147, 173705], [151, 173865], [157, 174065], [162, 174425]]}, {"verse": 22, "start": 175430, "end": 182167, "text": "Porque el hombre en quien había sido hecho este milagro de sanidad, era de más de cuarenta años.", "words": [[0, 175430], [7, 175716], [10, 176116], [17, 176456], [20, 176716], [26, 176876], [32, 177256], [37, 177716], [43, 178016], [48, 178256], [56, 178836], [59, 178936], [68, 179596], [72, 180256], [75, 180436], [79, 180656], [82, 180936], [91, 181216]]}, {"verse": 23, "start": 182617, "end": 189865, "text": "Y sueltos, vinieron a los suyos, y contaron todo lo que los principales sacerdotes y los ancianos les habían dicho.", "words": [[0, 182617], [2, 182721], [11, 183261], [20, 183781], [22, 184041], [26, 184201], [33, 184741], [35, 184881], [44, 185481], [49, 185801], [52, 186081], [56, 186201], [60, 186341], [72, 187041], [83, 187821], [85, 187981], [89, 188141], [98, 188761], [102, 188941], [109, 189281]]}, {"verse": 24, "start": 190315, "end": 201837, "text": "Y ellos, habiéndolo oído, alzaron unánimes la voz a Dios, y dijeron: Señor, tú eres el Dios que hiciste el cielo y la tierra, el mar, y todo lo que en ellos hay;", "words": [[0, 190315], [2, 190575], [9, 190875], [20, 191555], [26, 192275], [34, 193155], [43, 194035], [46, 194335], [50, 194555], [52, 194815], [58, 195015], [60, 195335], [69, 196352], [76, 196989], [79, 197029], [84, 197249], [87, 197429], [92, 197629], [96, 197869], [104, 198199], [107, 198529], [113, 198829], [115, 198989], [118, 199129], [126, 199789], [129, 199869], [134, 200089], [136, 200549], [141, 200749], [144, 200969], [148, 201089], [151, 201249], [157, 201429]]}, {"verse": 25, "start": 202287, "end": 208249, "text": "Que por boca de David, tu siervo, dijiste: ¿Por qué han bramado las gentes, y los pueblos han pensado cosas vanas?", "words": [[0, 202287], [4, 202369], [8, 202549], [13, 202849], [16, 203029], [23, 203289], [26, 203529], [34, 203889], [43, 204674], [48, 204802], [52, 204942], [56, 205172], [64, 205402], [68, 205562], [76, 206022], [78, 206302], [82, 206442], [90, 206842], [94, 206962], [102, 207382], [108, 207622]]}, {"verse": 26, "start": 208699, "end": 214424, "text": "Se presentaron los reyes de la tierra, y los príncipes se juntaron en uno contra el Señor, y contra su Cristo.", "words": [[0, 208699], [3, 208803], [15, 209323], [19, 209463], [25, 209803], [28, 209923], [31, 210023], [39, 210383], [41, 210763], [45, 210903], [55, 211463], [58, 211603], [67, 212063], [70, 212203], [74, 212363], [81, 212663], [84, 212803], [91, 213063], [93, 213503], [100, 213743], [103, 213923]]}, {"verse": 27, "start": 214874, "end": 225139, "text": "Porque verdaderamente se juntaron en esta ciudad contra tu santo Hijo Jesús, al cual ungiste, Herodes y Poncio Pilato, con los Gentiles y los pueblos de Israel,", "words": [[0, 214874], [7, 215079], [22, 215819], [25, 216059], [34, 216539], [37, 216679], [42, 216879], [49, 217279], [56, 217619], [59, 217799], [65, 218059], [70, 218339], [77, 219339], [80, 219419], [85, 219619], [94, 220219], [102, 220819], [104, 221159], [111, 221519], [119, 222579], [123, 222659], [127, 222779], [136, 223259], [138, 223419], [142, 223539], [150, 223959], [153, 224039]]}, {"verse": 28, "start": 225589, "end": 230233, "text": "Para hacer lo que tu mano y tu consejo habían antes determinado que había de ser hecho.", "words": [[0, 225589], [5, 225758], [11, 226078], [14, 226238], [18, 226358], [21, 226518], [26, 226778], [28, 226958], [31, 227058], [39, 227658], [46, 227978], [52, 228378], [64, 229078], [68, 229238], [74, 229458], [77, 229618], [81, 229798]]}, {"verse": 29, "start": 230683, "end": 236257, "text": "Y ahora, Señor, mira sus amenazas, y da a tus siervos que con toda confianza hablen tu palabra;", "words": [[0, 230683], [2, 230806], [9, 231106], [16, 231846], [21, 232026], [25, 232206], [35, 232966], [37, 233186], [40, 233346], [42, 233446], [46, 233546], [54, 233986], [58, 234166], [62, 234366], [67, 234526], [77, 235266], [84, 235546], [87, 235686]]}, {"verse": 30, "start": 236707, "end": 243423, "text": "Que extiendas tu mano a que sanidades, y milagros, y prodigios sean hechos por el nombre de tu santo Hijo Jesús.", "words": [[0, 236707], [4, 236821], [14, 237421], [17, 237581], [22, 237821], [24, 237981], [28, 238061], [39, 238681], [41, 238881], [51, 239461], [53, 239581], [63, 240261], [68, 240841], [75, 241181], [79, 241461], [82, 241601], [89, 241841], [92, 242041], [95, 242181], [101, 242461], [106, 242781]]}, {"verse": 31, "start": 243773, "end": 254339, "text": "Y cuando hubieron orado, el lugar en que estaban congregados tembló; y todos fueron llenos del Espíritu Santo, y hablaron la palabra de Dios con confianza.", "words": [[0, 243773], [2, 243876], [9, 244216], [18, 244556], [25, 245516], [28, 245956], [34, 246336], [37, 246556], [41, 246656], [49, 246996], [61, 247856], [69, 248792], [71, 248899], [77, 249079], [84, 249439], [91, 249979], [95, 250139], [104, 250639], [111, 250979], [113, 251719], [122, 252159], [125, 252299], [133, 252639], [136, 252879], [141, 253119], [145, 253359]]}, {"verse": 32, "start": 254789, "end": 265228, "text": "Y la multitud de los que habían creído era de un corazón y un alma: y ninguno decía ser suyo algo de lo que poseía; pero todas las cosas les eran comunes.", "words": [[0, 254789], [2, 254895], [5, 255265], [14, 255635], [17, 255855], [21, 255995], [25, 256155], [32, 256395], [39, 256895], [43, 257055], [46, 257215], [49, 257315], [57, 257695], [59, 257955], [62, 258095], [68, 258924], [70, 259048], [78, 259528], [84, 259808], [88, 260128], [93, 260588], [98, 260828], [101, 261048], [104, 261168], [108, 261268], [116, 262401], [121, 262545], [127, 262825], [131, 263105], [137, 263525], [141, 264105], [146, 264365]]}, {"verse": 33, "start": 265678, "end": 274352, "text": "Y los apóstoles daban testimonio de la resurrección del Señor Jesús con gran poder; y gran gracia era en todos ellos.", "words": [[0, 265678], [2, 265824], [6, 265964], [16, 266784], [22, 267524], [33, 268304], [36, 268424], [39, 268564], [52, 269444], [56, 269664], [62, 269984], [68, 270504], [72, 270804], [77, 271044], [84, 271933], [86, 272037], [91, 272237], [98, 272957], [102, 273257], [105, 273417], [111, 273637]]}, {"verse": 34, "start": 274802, "end": 283686, "text": "Que ningún necesitado había entre ellos: porque todos los que poseían tierras o casas, vendiéndolas, traían el precio de lo vendido,", "words": [[0, 274802], [4, 275124], [11, 275504], [22, 276584], [28, 276844], [34, 277264], [41, 278102], [48, 278306], [54, 278706], [58, 279146], [62, 279326], [70, 279946], [78, 280626], [80, 280826], [87, 281486], [101, 282466], [108, 283366], [111, 283439], [118, 283512], [121, 283585], [124, 283658]]}, {"verse": 35, "start": 284136, "end": 292141, "text": "Y lo ponían a los pies de los apóstoles; y era repartido a cada uno según su necesidad.", "words": [[0, 285363], [2, 285763], [5, 285883], [12, 286363], [14, 286563], [18, 286703], [23, 286963], [26, 287163], [30, 287322], [41, 287780], [43, 288630], [47, 288930], [57, 289870], [59, 289990], [64, 290190], [68, 290570], [74, 290870], [77, 291170]]}, {"verse": 36, "start": 292591, "end": 303892, "text": "Entonces José, que fue llamado de los apóstoles por sobrenombre, Bernabé, (que es interpretado, Hijo de consolación) levita, natural de Chipre,", "words": [[0, 292591], [9, 293596], [15, 293976], [19, 294176], [23, 294356], [31, 294696], [34, 294976], [38, 295096], [48, 295896], [52, 296216], [65, 297216], [74, 298516], [79, 298556], [82, 298776], [96, 299856], [101, 300376], [104, 300576], [117, 301936], [125, 302656], [133, 303056], [136, 303256]]}, {"verse": 37, "start": 304342, "end": 310421, "text": "Como tuviese un terreno, lo vendió, y trajo el precio, y lo puso a los pies de los apóstoles.", "words": [[0, 304342], [5, 304505], [13, 304925], [16, 305105], [25, 305585], [28, 305805], [36, 306385], [38, 306765], [44, 307205], [47, 307345], [55, 307805], [57, 308445], [60, 308565], [65, 308865], [67, 308965], [71, 309065], [76, 309245], [79, 309425], [83, 309525]]}]}