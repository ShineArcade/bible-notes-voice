{"book": "ROM", "chapter": 3, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 174419, "verses": [{"verse": 1, "start": 300, "end": 4175, "text": "What advantage then has the Jew? or what profit is there of circumcision?", "words": [[0, 343], [5, 423], [15, 843], [20, 1163], [24, 1383], [28, 1523], [33, 2224], [36, 2345], [41, 2525], [48, 2865], [51, 3065], [57, 3265], [60, 3405]]}, {"verse": 2, "start": 4625, "end": 9039, "text": "Much every way: chiefly, because that to them were committed the oracles of God.", "words": [[0, 4625], [5, 4844], [11, 5164], [16, 5848], [25, 6290], [33, 6710], [38, 7010], [41, 7170], [46, 7390], [51, 7530], [61, 7850], [65, 8090], [73, 8430], [76, 8610]]}, {"verse": 3, "start": 9489, "end": 13734, "text": "For what if some did not believe? shall their unbelief make the faith of God without effect?", "words": [[0, 9489], [4, 9572], [9, 9712], [12, 9812], [17, 10012], [21, 10192], [25, 10352], [34, 11178], [40, 11334], [46, 11554], [55, 12134], [60, 12294], [64, 12434], [70, 12614], [73, 12774], [77, 12974], [85, 13214]]}, {"verse": 4, "start": 14184, "end": 23750, "text": "God forbid: yes, let God be true, but every man a liar; as it is written, That you might be justified in your sayings, and might overcome when you are judged.", "words": [[0, 14184], [4, 14443], [12, 15257], [17, 15674], [21, 15754], [25, 15974], [28, 16194], [34, 16754], [38, 16854], [44, 17094], [48, 17354], [50, 17554], [56, 18272], [59, 18496], [62, 18616], [65, 18756], [74, 19056], [79, 19496], [83, 19656], [89, 19876], [92, 20056], [102, 20496], [105, 20856], [110, 20956], [119, 21516], [123, 21896], [129, 22116], [138, 22596], [143, 22976], [147, 23096], [151, 23196]]}, {"verse": 5, "start": 24200, "end": 32084, "text": "But if our unrighteousness commend the righteousness of God, what shall we say? Is God unrighteous who takes vengeance? (I speak as a man)", "words": [[0, 24200], [4, 24300], [7, 24440], [11, 24740], [27, 25360], [35, 25980], [39, 26100], [53, 26460], [56, 26760], [61, 27440], [66, 27620], [72, 27840], [75, 28000], [80, 28691], [83, 28853], [87, 29093], [99, 29753], [103, 29893], [109, 30093], [120, 31120], [123, 31241], [129, 31461], [132, 31661], [134, 31741]]}, {"verse": 6, "start": 32534, "end": 35512, "text": "God forbid: for then how shall God judge the world?", "words": [[0, 32534], [4, 32781], [12, 33641], [16, 33740], [21, 34120], [25, 34200], [31, 34360], [35, 34620], [41, 34880], [45, 35080]]}, {"verse": 7, "start": 35962, "end": 41986, "text": "For if the truth of God has more abounded through my lie to his glory; why yet am I also judged as a sinner?", "words": [[0, 35962], [4, 36104], [7, 36264], [11, 36424], [17, 36684], [20, 36884], [24, 37144], [28, 37364], [33, 37564], [42, 38024], [50, 38224], [53, 38404], [57, 38664], [60, 38864], [64, 38964], [71, 39767], [75, 39948], [79, 40228], [82, 40428], [84, 40568], [89, 40848], [96, 41228], [99, 41488], [101, 41568]]}, {"verse": 8, "start": 42436, "end": 50677, "text": "And not rather, (as we are slanderously reported, and as some affirm that we say,) Let us do evil, that good may come? whose damnation is just.", "words": [[0, 42436], [4, 42598], [8, 42798], [16, 43218], [20, 43538], [23, 43678], [27, 43818], [40, 44478], [50, 44918], [54, 45498], [57, 45638], [62, 45898], [69, 46198], [74, 46498], [77, 46658], [83, 47158], [87, 47318], [90, 47478], [93, 47658], [99, 47978], [104, 48258], [109, 48458], [113, 48638], [119, 49347], [125, 49467], [135, 50027], [138, 50227]]}, {"verse": 9, "start": 51127, "end": 59368, "text": "What then? are we better than they? No, by no means: for we have before proved both Jews and Gentiles, that they are all under sin;", "words": [[0, 51127], [5, 51288], [11, 52012], [15, 52115], [18, 52235], [25, 52495], [30, 52715], [36, 53405], [40, 53618], [43, 53878], [46, 54098], [53, 54953], [57, 55040], [60, 55200], [65, 55360], [72, 55640], [79, 55980], [84, 56180], [89, 56540], [93, 56860], [103, 57500], [108, 57960], [113, 58120], [117, 58260], [121, 58540], [127, 58840]]}, {"verse": 10, "start": 59818, "end": 62655, "text": "As it is written, There is none righteous, no, not one:", "words": [[0, 59818], [3, 59960], [6, 60080], [9, 60180], [18, 60740], [24, 60860], [27, 60960], [32, 61180], [43, 61780], [47, 62120], [51, 62260]]}, {"verse": 11, "start": 63105, "end": 66610, "text": "There is none that understands, there is none that seeks after God.", "words": [[0, 63105], [6, 63320], [9, 63480], [14, 63720], [19, 63900], [32, 64840], [38, 65040], [41, 65200], [46, 65420], [51, 65620], [57, 65820], [63, 66120]]}, {"verse": 12, "start": 67060, "end": 73118, "text": "They are all gone out of the way, they are together become unprofitable; there is none that does good, no, not one.", "words": [[0, 67060], [5, 67245], [9, 67365], [13, 67525], [18, 67745], [22, 67945], [25, 68045], [29, 68165], [34, 68685], [39, 68825], [43, 68905], [52, 69225], [59, 69605], [73, 70917], [79, 71079], [82, 71219], [87, 71439], [92, 71659], [97, 71799], [103, 72199], [107, 72519], [111, 72679]]}, {"verse": 13, "start": 73568, "end": 79968, "text": "Their throat is an open tomb; with their tongues they have used deceit; the poison of asps is under their lips:", "words": [[0, 73568], [6, 73683], [13, 73983], [16, 74263], [19, 74403], [24, 74723], [30, 75530], [35, 75671], [41, 75771], [49, 76051], [54, 76291], [59, 76451], [64, 76711], [72, 77725], [76, 77846], [83, 78146], [86, 78346], [91, 78806], [94, 79006], [100, 79286], [106, 79506]]}, {"verse": 14, "start": 80418, "end": 82873, "text": "Whose mouth is full of cursing and bitterness:", "words": [[0, 80418], [6, 80522], [12, 80882], [15, 81082], [20, 81322], [23, 81462], [31, 81982], [35, 82182]]}, {"verse": 15, "start": 83323, "end": 85217, "text": "Their feet are swift to shed blood:", "words": [[0, 83323], [6, 83479], [11, 83739], [15, 83939], [21, 84239], [24, 84439], [29, 84699]]}, {"verse": 16, "start": 85667, "end": 87811, "text": "Destruction and misery are in their ways:", "words": [[0, 85667], [12, 86208], [16, 86528], [23, 86848], [27, 87128], [30, 87228], [36, 87348]]}, {"verse": 17, "start": 88261, "end": 90132, "text": "And the way of peace have they not known:", "words": [[0, 88261], [4, 88387], [8, 88507], [12, 88667], [15, 88807], [21, 89047], [26, 89287], [31, 89447], [35, 89627]]}, {"verse": 18, "start": 90582, "end": 92660, "text": "There is no fear of God before their eyes.", "words": [[0, 90582], [6, 90702], [9, 90822], [12, 91002], [17, 91262], [20, 91382], [24, 91602], [31, 91882], [37, 92122]]}, {"verse": 19, "start": 93110, "end": 101940, "text": "Now we know that what things soever the law says, it says to them who are under the law: that every mouth may be stopped, and all the world may become guilty before God.", "words": [[0, 93110], [4, 93320], [7, 93520], [12, 93680], [17, 93920], [22, 94170], [29, 94420], [36, 94800], [40, 94980], [44, 95180], [50, 95780], [53, 95960], [58, 96140], [61, 96340], [66, 96520], [70, 96720], [74, 96860], [80, 97080], [84, 97260], [89, 97926], [94, 98050], [100, 98230], [106, 98510], [110, 98690], [113, 98770], [122, 99130], [126, 99630], [130, 99910], [134, 100050], [140, 100310], [144, 100510], [151, 100790], [158, 101110], [165, 101430]]}, {"verse": 20, "start": 102390, "end": 109194, "text": "Therefore by the deeds of the law there shall no flesh be justified in his sight: for by the law is the knowledge of sin.", "words": [[0, 102390], [10, 102892], [13, 103012], [17, 103152], [23, 103392], [26, 103592], [30, 103712], [34, 103912], [40, 104152], [46, 104392], [49, 104672], [55, 104972], [58, 105132], [68, 105692], [71, 105892], [75, 106012], [82, 106660], [86, 106764], [89, 106964], [93, 107124], [97, 107424], [100, 107944], [104, 108104], [114, 108444], [117, 108744]]}, {"verse": 21, "start": 109644, "end": 115041, "text": "But now the righteousness of God without the law is manifested, being witnessed by the law and the prophets;", "words": [[0, 109644], [4, 109762], [8, 109922], [12, 110082], [26, 110442], [29, 110802], [33, 111022], [41, 111302], [45, 111502], [49, 111722], [52, 111842], [64, 112802], [70, 113022], [80, 113402], [83, 113682], [87, 113842], [91, 114062], [95, 114242], [99, 114362]]}, {"verse": 22, "start": 115491, "end": 121793, "text": "Even the righteousness of God which is by faith of Jesus Christ to all and upon all them that believe: for there is no difference:", "words": [[0, 115491], [5, 115651], [9, 115831], [23, 116191], [26, 116571], [30, 116911], [36, 117051], [39, 117171], [42, 117331], [48, 117591], [51, 117731], [57, 117971], [64, 118351], [67, 118571], [71, 118811], [75, 118931], [80, 119131], [84, 119371], [89, 119571], [94, 119771], [103, 120600], [107, 120700], [113, 120840], [116, 120960], [119, 121120]]}, {"verse": 23, "start": 122243, "end": 125430, "text": "For all have sinned, and come short of the glory of God;", "words": [[0, 122243], [4, 122377], [8, 122557], [13, 122777], [21, 123457], [25, 123617], [30, 123837], [36, 124137], [39, 124357], [43, 124457], [49, 124777], [52, 124957]]}, {"verse": 24, "start": 125880, "end": 130253, "text": "Being justified freely by his grace through the redemption that is in Christ Jesus:", "words": [[0, 125880], [6, 126042], [16, 126562], [23, 127002], [26, 127282], [30, 127482], [36, 127802], [44, 128062], [48, 128182], [59, 128602], [64, 128962], [67, 129102], [70, 129242], [77, 129522]]}, {"verse": 25, "start": 130703, "end": 139505, "text": "Whom God has set forth to be a propitiation through faith in his blood, to declare his righteousness for the remission of sins that are past, through the forbearance of God;", "words": [[0, 130703], [5, 130841], [9, 131121], [13, 131321], [17, 131521], [23, 131821], [26, 132041], [29, 132221], [31, 132341], [44, 133061], [52, 133341], [58, 133621], [61, 133801], [65, 133941], [72, 134501], [75, 134681], [83, 135041], [87, 135261], [101, 135761], [105, 136081], [109, 136181], [119, 136541], [122, 136701], [127, 136961], [132, 137201], [136, 137321], [142, 138092], [150, 138199], [154, 138319], [166, 138999], [169, 139139]]}, {"verse": 26, "start": 139955, "end": 146442, "text": "To declare, I say, at this time his righteousness: that he might be just, and the justifier of him which believes in Jesus.", "words": [[0, 139955], [3, 140039], [12, 140299], [14, 140459], [19, 141019], [22, 141159], [27, 141359], [32, 141639], [36, 141819], [51, 142918], [56, 143023], [59, 143123], [65, 143303], [68, 143503], [74, 143863], [78, 144243], [82, 144343], [92, 144783], [95, 145023], [99, 145243], [105, 145463], [114, 145723], [117, 145923]]}, {"verse": 27, "start": 146892, "end": 153366, "text": "Where is boasting then? It is excluded. By what law? of works? No: but by the law of faith.", "words": [[0, 146892], [6, 147053], [9, 147193], [18, 147553], [24, 148257], [27, 148354], [30, 148454], [40, 149444], [43, 149590], [48, 149770], [53, 150498], [56, 150682], [63, 151520], [67, 152242], [71, 152346], [74, 152546], [78, 152666], [82, 152866], [85, 152986]]}, {"verse": 28, "start": 153816, "end": 157925, "text": "Therefore we conclude that a man is justified by faith without the deeds of the law.", "words": [[0, 153816], [10, 154213], [13, 154273], [22, 154613], [27, 154873], [29, 154953], [33, 155173], [36, 155333], [46, 155713], [49, 156113], [55, 156453], [63, 156753], [67, 156973], [73, 157233], [76, 157433], [80, 157533]]}, {"verse": 29, "start": 158375, "end": 163475, "text": "Is he the God of the Jews only? is he not also of the Gentiles? Yes, of the Gentiles also:", "words": [[0, 158375], [3, 158520], [6, 158620], [10, 158760], [14, 158960], [17, 159080], [21, 159200], [26, 159400], [32, 160202], [35, 160362], [38, 160442], [42, 160602], [47, 160902], [50, 161042], [54, 161142], [64, 162134], [69, 162435], [72, 162475], [76, 162595], [85, 162995]]}, {"verse": 30, "start": 163925, "end": 168598, "text": "Seeing it is one God, which shall justify the circumcision by faith, and uncircumcision through faith.", "words": [[0, 163925], [7, 164152], [10, 164312], [13, 164412], [17, 164612], [22, 164872], [28, 165232], [34, 165432], [42, 165872], [46, 166052], [59, 166552], [62, 166752], [69, 167052], [73, 167312], [88, 168012], [96, 168252]]}, {"verse": 31, "start": 169048, "end": 174019, "text": "Do we then make void the law through faith? God forbid: yes, we establish the law.", "words": [[0, 169048], [3, 169147], [6, 169267], [11, 169387], [16, 169587], [21, 169807], [25, 169987], [29, 170167], [37, 170387], [44, 171177], [48, 171319], [56, 172249], [61, 172772], [64, 172872], [74, 173352], [78, 173592]]}]}