]}, {"verse": 13, "start": 85854, "end": 92050, "text": "And Arphaxad lived after he begot Salah four hundred and three years, and begot sons and daughters.", "words": [[0, 85854], [4, 86293], [13, 86753], [19, 87073], [25, 87493], [28, 87673], [34, 88073], [40, 88325], [45, 88577], [53, 88829], [57, 89081], [63, 89333], [70, 89693], [74, 90313], [80, 90713], [85, 91053], [89, 91353]]}, {"verse": 14, "start": 92500, "end": 95353, "text": "And Salah lived thirty years, and begot Eber:", "words": [[0, 92500], [4, 92624], [10, 93064], [16, 93394], [23, 93724], [30, 94144], [34, 94444], [40, 94824]]}, {"verse": 15, "start": 95803, "end": 101241, "text": "And Salah lived after he begot Eber four hundred and three years, and begot sons and daughters.", "words": [[0, 95803], [4, 95928], [10, 96348], [16, 96528], [22, 96888], [25, 97068], [31, 97448], [36, 97696], [41, 97944], [49, 98192], [53, 98440], [59, 98688], [66, 99028], [70, 99608], [76, 99988], [81, 100288], [85, 100548]]}, {"verse": 16, "start": 101691, "end": 105230, "text": "And Eber lived four and thirty years, and begot Peleg:", "words": [[0, 101691], [4, 101886], [9, 102116], [15, 102416], [20, 102776], [24, 102936], [31, 103216], [38, 103716], [42, 104216], [48, 104752]]}, {"verse": 17, "start": 105680, "end": 111147, "text": "And Eber lived after he begot Peleg four hundred and thirty years, and begot sons and daughters.", "words": [[0, 105680], [4, 105844], [9, 106104], [15, 106324], [21, 106664], [24, 106844], [30, 107117], [36, 107391], [41, 107664], [49, 107937], [53, 108211], [60, 108484], [67, 108904], [71, 109564], [77, 109904], [82, 110224], [86, 110484]]}, {"verse": 18, "start": 111597, "end": 114793, "text": "And Peleg lived thirty years, and begot Reu:", "words": [[0, 111597], [4, 111724], [10, 112164], [16, 112594], [23, 113024], [30, 113484], [34, 113904], [40, 114374]]}, {"verse": 19, "start": 115243, "end": 121037, "text": "And Peleg lived after he begot Reu two hundred and nine years, and begot sons and daughters.", "words": [[0, 115243], [4, 115382], [10, 115722], [16, 116042], [22, 116442], [25, 116662], [31, 116949], [35, 117235], [39, 117522], [47, 117809], [51, 118095], [56, 118382], [63, 118722], [67, 119282], [73, 119682], [78, 120042], [82, 120362]]}, {"verse": 20, "start": 121487, "end": 124728, "text": "And Reu lived two and thirty years, and begot Serug:", "words": [[0, 121487], [4, 121639], [8, 121829], [14, 122129], [18, 122449], [22, 122589], [29, 122809], [36, 123269], [40, 123809], [46, 124310]]}, {"verse": 21, "start": 125178, "end": 130077, "text": "And Reu lived after he begot Serug two hundred and seven years, and begot sons and daughters.", "words": [[0, 125178], [4, 125337], [8, 125527], [14, 125847], [20, 126187], [23, 126367], [29, 126630], [35, 126894], [39, 127157], [47, 127420], [51, 127684], [57, 127947], [64, 128307], [68, 128567], [74, 128927], [79, 129187], [83, 129407]]}, {"verse": 22, "start": 130527, "end": 133890, "text": "And Serug lived thirty years, and begot Nahor:", "words": [[0, 130527], [4, 130837], [10, 131147], [16, 131467], [23, 131927], [30, 132387], [34, 132911], [40, 133435]]}, {"verse": 23, "start": 134340, "end": 139560, "text": "And Serug lived after he begot Nahor two hundred years, and begot sons and daughters.", "words": [[0, 134340], [4, 134608], [10, 134908], [16, 135188], [22, 135528], [25, 135668], [31, 136028], [37, 136281], [41, 136535], [49, 136788], [56, 137288], [60, 137868], [66, 138228], [71, 138628], [75, 138908]]}, {"verse": 24, "start": 140010, "end": 144214, "text": "And Nahor lived nine and twenty years, and begot Terah:", "words": [[0, 140010], [4, 140231], [10, 140531], [16, 140811], [21, 141171], [25, 141411], [32, 141651], [39, 142031], [43, 142311], [49, 143295]]}, {"verse": 25, "start": 144664, "end": 150848, "text": "And Nahor lived after he begot Terah a hundred and nineteen years, and begot sons and daughters.", "words": [[0, 144664], [4, 144820], [10, 145240], [16, 145560],