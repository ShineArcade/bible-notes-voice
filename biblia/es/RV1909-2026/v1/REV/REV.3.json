{"book": "REV", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 233313, "verses": [{"verse": 1, "start": 300, "end": 14153, "text": "Y escribe al ángel de la iglesia en SARDIS: El que tiene los siete Espíritus de Dios, y las siete estrellas, dice estas cosas: Yo conozco tus obras, que tienes nombre que vives, y estás muerto.", "words": [[0, 300], [2, 422], [10, 802], [13, 1042], [19, 1482], [22, 1602], [25, 1722], [33, 2202], [36, 2728], [44, 3479], [47, 3630], [51, 3750], [57, 4030], [61, 4250], [67, 4610], [77, 5390], [80, 5610], [86, 5930], [88, 6450], [92, 6590], [98, 6870], [109, 7730], [114, 8130], [120, 8450], [127, 9460], [130, 9663], [138, 10263], [142, 10443], [149, 11323], [153, 11623], [160, 11903], [167, 12303], [171, 12523], [178, 13023], [180, 13183], [186, 13403]]}, {"verse": 2, "start": 14603, "end": 22627, "text": "Sé vigilante y fortalece las otras cosas que están para morir; porque no he hallado tus obras completas delante de Dios.", "words": [[0, 14603], [3, 14810], [13, 15510], [15, 15650], [25, 16390], [29, 16550], [35, 16830], [41, 17250], [45, 17470], [51, 17690], [56, 17930], [63, 18771], [70, 19156], [73, 19396], [76, 19556], [84, 19956], [88, 20256], [94, 20556], [104, 21336], [112, 21836], [115, 22036]]}, {"verse": 3, "start": 23077, "end": 35010, "text": "Acuérdate pues de lo que has recibido y has oído, y guárdalo, y arrepiéntete. Y si no velas, vendré a ti como ladrón, y no sabrás en qué hora vendré a ti.", "words": [[0, 23077], [10, 23676], [15, 24176], [18, 24776], [21, 24936], [25, 25096], [29, 25236], [38, 25956], [40, 26096], [44, 26256], [50, 26696], [52, 27416], [62, 28056], [64, 28666], [78, 29513], [80, 29600], [83, 29740], [86, 29880], [93, 30400], [100, 31240], [102, 31360], [105, 31520], [110, 31780], [118, 32440], [120, 32740], [123, 32880], [130, 33420], [133, 33660], [137, 33880], [142, 34120], [149, 34560], [151, 34700]]}, {"verse": 4, "start": 35460, "end": 45003, "text": "Pero tienes unas pocas personas en Sardis que no han manchado sus vestiduras: y andarán conmigo en vestiduras blancas; porque son dignos.", "words": [[0, 35460], [5, 35627], [12, 35947], [17, 36207], [23, 36607], [32, 37087], [35, 37307], [42, 37807], [46, 38027], [49, 38247], [53, 38427], [62, 39067], [66, 39287], [78, 40709], [80, 40952], [88, 41452], [96, 41932], [99, 42032], [110, 42612], [119, 43965], [126, 44327], [130, 44688]]}, {"verse": 5, "start": 45453, "end": 57188, "text": "El que venza, será vestido de vestiduras blancas; y no borraré su nombre del libro de la vida, y confesaré su nombre delante de mi Padre, y delante de sus ángeles.", "words": [[0, 45453], [3, 45599], [7, 45739], [14, 46199], [19, 46559], [27, 47139], [30, 47279], [41, 47819], [50, 48845], [52, 48966], [55, 49106], [63, 49626], [66, 49746], [73, 50106], [77, 50326], [83, 50726], [86, 50926], [89, 51046], [95, 51366], [97, 52106], [107, 52826], [110, 52986], [117, 53506], [125, 54186], [128, 54346], [131, 54486], [138, 55346], [140, 55506], [148, 55946], [151, 56106], [155, 56246]]}, {"verse": 6, "start": 57638, "end": 62471, "text": "El que tiene oído, oiga lo que el Espíritu dice a las iglesias.", "words": [[0, 57638], [3, 57780], [7, 57900], [13, 58220], [19, 59040], [24, 59860], [27, 60060], [31, 60240], [34, 60420], [43, 61000], [48, 61240], [50, 61380], [54, 61540]]}, {"verse": 7, "start": 62921, "end": 76048, "text": "Y escribe al ángel de la iglesia en FILADELFIA: Estas cosas dice el Santo, el Verdadero, el que tiene la llave de David, el que abre y ninguno cierra, y cierra y ninguno abre:", "words": [[0, 62921], [2, 63046], [10, 63406], [13, 63626], [19, 64046], [22, 64146], [25, 64286], [33, 64766], [36, 64966], [48, 66192], [54, 66552], [60, 66852], [65, 67432], [68, 67672], [75, 68272], [78, 68412], [89, 69492], [92, 69732], [96, 69872], [102, 70152], [105, 70352], [111, 70672], [114, 70812], [121, 71512], [124, 71672], [128, 71812], [133, 72152], [135, 72452], [143, 72932], [151, 73972], [153, 74092], [160, 74632], [162, 74892], [170, 75432]]}, {"verse": 8, "start": 76498, "end": 89909, "text": "Yo conozco tus obras: he aquí, he dado una puerta abierta delante de ti, la cual ninguno puede cerrar; porque tienes un poco de fuerza, y has guardado mi palabra, y no has negado mi nombre.", "words": [[0, 76498], [3, 76686], [11, 77126], [15, 77266], [22, 78508], [25, 78658], [31, 79418], [34, 79498], [39, 79758], [43, 79958], [50, 80258], [58, 80898], [66, 81338], [69, 81538], [73, 81978], [76, 82198], [81, 82458], [89, 83018], [95, 83278], [103, 84297], [110, 84480], [117, 84800], [120, 85020], [125, 85240], [128, 85420], [136, 85820], [138, 86340], [142, 86480], [151, 87000], [154, 87160], [163, 87640], [165, 88460], [168, 88600], [172, 88700], [179, 89120], [182, 89300]]}, {"verse": 9, "start": 90359, "end": 104072, "text": "He aquí, yo doy de la sinagoga de Satanás, los que se dicen ser judíos, y no lo son, sino que mienten; he aquí, yo haré que vengan y adoren delante de tus pies, y sepan que yo te he amado.", "words": [[0, 90510], [3, 90704], [9, 90897], [12, 91077], [16, 91417], [19, 91497], [22, 91657], [31, 92317], [34, 92517], [43, 93457], [47, 94097], [51, 94257], [54, 94397], [60, 94697], [64, 94997], [72, 95657], [74, 96057], [77, 96237], [80, 96397], [85, 97057], [90, 97297], [94, 97497], [103, 98633], [106, 98723], [112, 99083], [115, 99423], [120, 99643], [124, 99763], [131, 100163], [133, 100403], [140, 100763], [148, 101263], [151, 101423], [155, 101543], [161, 101863], [163, 102503], [169, 102863], [173, 103043], [176, 103223], [179, 103363], [182, 103483]]}, {"verse": 10, "start": 104522, "end": 115975, "text": "Porque has guardado la palabra de mi perseverancia, yo también te guardaré de la hora de la prueba que ha de venir en todo el mundo, para probar a los que moran en la tierra.", "words": [[0, 104522], [7, 104786], [11, 105186], [20, 105866], [23, 106026], [31, 106386], [34, 106646], [37, 106806], [52, 108486], [55, 108706], [63, 109046], [66, 109306], [75, 109846], [78, 109986], [81, 110166], [86, 110326], [89, 110466], [92, 110606], [99, 110906], [103, 111186], [106, 111326], [109, 111446], [115, 111726], [118, 111926], [123, 112146], [126, 112346], [133, 113219], [138, 113401], [145, 114001], [147, 114161], [151, 114301], [155, 114461], [161, 114941], [164, 115161], [167, 115281]]}, {"verse": 11, "start": 116425, "end": 122402, "text": "He aquí, yo vengo pronto; retén lo que tienes, para que ninguno tome tu corona.", "words": [[0, 116565], [3, 116735], [9, 116955], [12, 117155], [18, 117455], [26, 118476], [32, 118983], [35, 119163], [39, 119303], [47, 119763], [52, 120523], [56, 120683], [64, 121223], [69, 121563], [72, 121683]]}, {"verse": 12, "start": 122852, "end": 141596, "text": "Al que venza, yo lo haré columna en el templo de mi Dios, y nunca más saldrá fuera; y escribiré sobre él el nombre de mi Dios, y el nombre de la ciudad de mi Dios, la nueva Jerusalén, la cual desciende del cielo, de mi Dios, y mi nombre nuevo.", "words": [[0, 122905], [3, 122995], [7, 123195], [14, 123395], [17, 123735], [20, 123975], [25, 124255], [33, 124755], [36, 124895], [39, 125035], [46, 125595], [49, 125675], [52, 125775], [58, 126675], [60, 126915], [66, 127095], [70, 127715], [77, 128175], [84, 128976], [86, 129114], [96, 129834], [102, 130134], [105, 130474], [108, 130734], [115, 131174], [118, 131394], [121, 131514], [127, 132354], [129, 132614], [132, 132754], [139, 133194], [142, 133614], [145, 133754], [152, 134114], [155, 134494], [158, 134614], [164, 135614], [167, 135714], [173, 135974], [184, 137334], [187, 137414], [192, 137614], [202, 138174], [206, 138394], [213, 138894], [216, 139374], [219, 139494], [225, 140366], [227, 140511], [230, 140651], [237, 140931]]}, {"verse": 13, "start": 142046, "end": 147107, "text": "El que tiene oído, oiga lo que el Espíritu dice a las iglesias.", "words": [[0, 142046], [3, 142173], [7, 142293], [13, 142573], [19, 143283], [24, 143993], [27, 144193], [31, 144393], [34, 144753], [43, 145653], [48, 145933], [50, 146093], [54, 146253]]}, {"verse": 14, "start": 147557, "end": 157693, "text": "Y escribe al ángel de la iglesia en LAODICEA: He aquí dice el Amén, el testigo fiel y verdadero, el principio de la creación de Dios:", "words": [[0, 147557], [2, 147694], [10, 148154], [13, 148394], [19, 148834], [22, 148934], [25, 149074], [33, 149594], [36, 150330], [46, 151392], [49, 151492], [54, 151812], [59, 152212], [62, 152452], [68, 153432], [71, 153452], [79, 153972], [84, 154352], [86, 154512], [97, 155312], [100, 155412], [110, 156072], [113, 156392], [116, 156512], [125, 157092], [128, 157272]]}, {"verse": 15, "start": 158143, "end": 164000, "text": "Yo conozco tus obras, que ni eres frío, ni caliente. ¡Ojalá fueses frío, o caliente!", "words": [[0, 158143], [3, 158264], [11, 158684], [15, 158844], [22, 159184], [26, 159684], [29, 159904], [34, 160104], [40, 160544], [43, 160684], [53, 161748], [60, 162103], [67, 162493], [73, 163053], [75, 163193]]}, {"verse": 16, "start": 164450, "end": 169888, "text": "Pero porque eres tibio, y no frío ni caliente, te vomitaré de mi boca.", "words": [[0, 164450], [5, 164614], [12, 164974], [17, 165194], [24, 166054], [26, 166474], [29, 166614], [34, 167014], [37, 167174], [47, 168334], [50, 168434], [59, 169094], [62, 169174], [65, 169314]]}, {"verse": 17, "start": 170338, "end": 184302, "text": "Porque tú dices: Yo soy rico, y estoy enriquecido, y no tengo necesidad de ninguna cosa; y no conoces que tú eres un desventurado y miserable y pobre y ciego y desnudo;", "words": [[0, 170338], [7, 170522], [10, 170802], [17, 171839], [20, 172008], [24, 172188], [30, 172648], [32, 173128], [38, 173368], [51, 174408], [53, 174888], [56, 175048], [62, 175448], [72, 176268], [75, 176428], [83, 176768], [89, 177831], [91, 177958], [94, 178098], [102, 178698], [106, 178878], [109, 179178], [114, 179458], [117, 179818], [130, 181038], [132, 181158], [142, 181738], [144, 182438], [150, 182818], [152, 183018], [158, 183458], [160, 183578]]}, {"verse": 18, "start": 184752, "end": 200041, "text": "Yo te aconsejo que de mí compres oro refinado en fuego, para que seas hecho rico, y seas vestido de vestiduras blancas, para que no se descubra la vergüenza de tu desnudez; y unge tus ojos con colirio, para que veas.", "words": [[0, 184752], [3, 184896], [6, 185036], [15, 185636], [19, 185796], [22, 185976], [25, 186116], [33, 186716], [37, 187136], [46, 187936], [49, 188076], [56, 188476], [61, 189036], [65, 189196], [70, 189516], [76, 189876], [82, 190336], [84, 190796], [89, 191036], [97, 191796], [100, 191976], [111, 192656], [120, 193725], [125, 193872], [129, 194032], [132, 194172], [135, 194332], [144, 194892], [147, 195032], [157, 195632], [160, 195812], [163, 195992], [173, 197131], [175, 197351], [180, 197611], [184, 197791], [189, 198111], [193, 198431], [202, 199011], [207, 199231], [211, 199411]]}, {"verse": 19, "start": 200491, "end": 206801, "text": "Yo reprendo y castigo a todos los que amo: sé pues fervoroso, y arrepiéntete.", "words": [[0, 200491], [3, 200841], [12, 201561], [14, 201741], [22, 202341], [24, 202481], [30, 202681], [34, 202881], [38, 203101], [43, 203957], [46, 204077], [51, 204337], [62, 205197], [64, 206034]]}, {"verse": 20, "start": 207251, "end": 217791, "text": "He aquí, yo estoy a la puerta y llamo: si alguno oye mi voz y abre la puerta, entraré a él, y cenaré con él, y él conmigo.", "words": [[0, 207304], [3, 207394], [9, 207674], [12, 208234], [18, 208494], [20, 208654], [23, 208734], [30, 208974], [32, 209294], [39, 210411], [42, 210615], [49, 211295], [53, 211595], [56, 211755], [60, 212095], [62, 212355], [67, 212595], [70, 212795], [78, 213515], [86, 214135], [88, 214255], [92, 214515], [94, 215195], [101, 215695], [105, 215895], [109, 216135], [111, 216835], [114, 217015]]}, {"verse": 21, "start": 218241, "end": 227611, "text": "Al que venza, yo le daré que se siente conmigo en mi trono; así como yo he vencido, y me he sentado con mi Padre en su trono.", "words": [[0, 218296], [3, 218386], [7, 218546], [14, 218946], [17, 219586], [20, 219746], [25, 220066], [29, 220146], [32, 220326], [39, 220706], [47, 221326], [50, 221466], [53, 221626], [60, 222525], [64, 222849], [69, 223189], [72, 223509], [75, 223669], [84, 224329], [86, 224829], [89, 224969], [92, 225129], [100, 225729], [104, 225949], [107, 226169], [113, 226529], [116, 226749], [119, 226929]]}, {"verse": 22, "start": 228061, "end": 232913, "text": "El que tiene oído, oiga lo que el Espíritu dice a las iglesias.", "words": [[0, 228061], [3, 228360], [7, 228480], [13, 228780], [19, 229280], [24, 230060], [27, 230360], [31, 230540], [34, 230700], [43, 231400], [48, 231660], [50, 231840], [54, 232000]]}]}