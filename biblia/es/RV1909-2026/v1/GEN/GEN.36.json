{"book": "GEN", "chapter": 36, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 353544, "verses": [{"verse": 1, "start": 300, "end": 4346, "text": "Y estas son las generaciones de Esaú, el cual es Edom.", "words": [[0, 300], [2, 470], [8, 710], [12, 1070], [16, 1250], [29, 2110], [32, 2533], [38, 2955], [41, 3055], [46, 3295], [49, 3675]]}, {"verse": 2, "start": 4696, "end": 14989, "text": "Esaú tomó sus mujeres de las hijas de Canaán: a Ada, hija de Elón heteo, y a Aholibama, hija de Ana, hija de Zibeón el heveo;", "words": [[0, 4910], [5, 5160], [10, 5480], [14, 5600], [22, 6060], [25, 6320], [29, 6480], [35, 6820], [38, 6940], [46, 8000], [48, 8174], [53, 8347], [58, 8847], [61, 8987], [66, 9537], [73, 10087], [75, 10507], [77, 10937], [88, 11367], [93, 11787], [96, 11887], [101, 12127], [106, 12547], [109, 13173], [116, 13800], [119, 14426]]}, {"verse": 3, "start": 15339, "end": 19598, "text": "Y a Basemat, hija de Ismael, hermana de Nebaiot.", "words": [[0, 15339], [2, 15744], [4, 16184], [13, 16624], [18, 16944], [21, 17044], [29, 18084], [37, 18624], [40, 19138]]}, {"verse": 4, "start": 19948, "end": 24920, "text": "Y Ada parió a Esaú a Elifaz; y Basemat parió a Reuel.", "words": [[0, 19948], [2, 20240], [6, 20566], [12, 20892], [14, 21302], [19, 21712], [21, 22289], [29, 23204], [31, 23418], [39, 23631], [45, 24051], [47, 24507]]}, {"verse": 5, "start": 25270, "end": 34682, "text": "Y Aholibama parió a Jeús, y a Jaalam, y a Coré: estos son los hijos de Esaú, que le nacieron en la tierra de Canaán.", "words": [[0, 25270], [2, 25654], [12, 26074], [18, 26594], [20, 26794], [26, 27794], [28, 27854], [30, 28344], [38, 28834], [40, 29074], [42, 29154], [48, 29769], [54, 30367], [58, 30607], [62, 30787], [68, 31087], [71, 31367], [77, 32127], [81, 32327], [84, 32447], [93, 32967], [96, 33267], [99, 33387], [106, 33747], [109, 34241]]}, {"verse": 6, "start": 35032, "end": 54239, "text": "Y Esaú tomó sus mujeres, y sus hijos, y sus hijas, y todas las personas de su casa, y sus ganados, y todas sus bestias, y todo cuanto había adquirido en la tierra de Canaán, y se fue a otra tierra, separándose de Jacob su hermano:", "words": [[0, 35032], [2, 35178], [7, 35698], [12, 36158], [16, 36258], [25, 36818], [27, 37243], [31, 37483], [38, 37923], [40, 38523], [44, 38723], [51, 39663], [53, 39883], [59, 40183], [63, 40503], [72, 41063], [75, 41243], [78, 41423], [84, 41783], [86, 42443], [90, 42883], [99, 43323], [101, 43903], [107, 44103], [111, 44383], [120, 45318], [122, 45442], [127, 45642], [134, 46062], [140, 46582], [150, 47522], [153, 47642], [156, 47802], [163, 48182], [166, 48402], [174, 49482], [176, 49582], [179, 49742], [183, 50042], [185, 50282], [190, 50522], [198, 51562], [210, 52502], [213, 52662], [219, 53082], [222, 53442]]}, {"verse": 7, "start": 54589, "end": 63806, "text": "Porque los bienes de ellos eran muchos, y no podían habitar juntos, ni la tierra donde vivían los podía sostener a causa de sus ganados.", "words": [[0, 54589], [7, 54816], [11, 55016], [18, 55416], [21, 55556], [27, 55756], [32, 56036], [40, 56576], [42, 56941], [45, 57101], [52, 57461], [60, 57861], [68, 58381], [71, 59101], [74, 59281], [81, 59581], [87, 59941], [94, 60601], [98, 60761], [104, 61181], [113, 61941], [115, 62181], [121, 62581], [124, 62801], [128, 62981]]}, {"verse": 8, "start": 64156, "end": 68838, "text": "Y Esaú habitó en el monte de Seir: Esaú es Edom.", "words": [[0, 64471], [2, 64805], [7, 65138], [14, 65818], [17, 66078], [20, 66218], [26, 66578], [29, 66858], [35, 67733], [40, 67733], [43, 68309]]}, {"verse": 9, "start": 69188, "end": 74036, "text": "Estos son los linajes de Esaú, padre de Edom, en el monte de Seir.", "words": [[0, 69188], [6, 69588], [10, 69828], [14, 70008], [22, 70568], [25, 70928], [31, 71288], [37, 71508], [40, 71788], [46, 72488], [49, 72608], [52, 72748], [58, 73048], [61, 73268]]}, {"verse": 10, "start": 74386, "end": 83990, "text": "Estos son los nombres de los hijos de Esaú: Elifaz, hijo de Ada, mujer de Esaú; Reuel, hijo de Basemat, mujer de Esaú.", "words": [[0, 74386], [6, 74735], [10, 74916], [14, 75056], [22, 75595], [25, 75996], [29, 76116], [35, 76396], [38, 76816], [44, 77755], [52, 78150], [57, 78544], [60, 78939], [65, 79334], [71, 79729], [74, 80124], [80, 81122], [87, 81582], [92, 81762], [95, 81942], [104, 82782], [110, 83182], [113, 83614]]}, {"verse": 11, "start": 84340, "end": 89046, "text": "Y los hijos de Elifaz fueron Temán, Omar, Zefo, Gatam, y Cenaz.", "words": [[0, 84340], [2, 84425], [6, 84545], [12, 84845], [15, 85185], [22, 85525], [29, 85785], [36, 86329], [42, 86872], [48, 87416], [55, 87959], [57, 88503]]}, {"verse": 12, "start": 89396, "end": 98954, "text": "Y Timna fue concubina de Elifaz, hijo de Esaú, la cual le parió a Amalec: estos son los hijos de Ada, mujer de Esaú.", "words": [[0, 89396], [2, 90182], [8, 91002], [12, 91572], [22, 92142], [25, 92732], [33, 93322], [38, 93502], [41, 93912], [47, 94322], [50, 94462], [55, 94642], [58, 94822], [64, 95222], [66, 95697], [74, 96336], [80, 96647], [84, 96787], [88, 96947], [94, 97187], [97, 97447], [102, 97947], [108, 98147], [111, 98584]]}, {"verse": 13, "start": 99304, "end": 107184, "text": "Y los hijos de Reuel fueron Nahat, Zera, Sama, y Miza: estos son los hijos de Basemat, mujer de Esaú.", "words": [[0, 99304], [2, 99391], [6, 99511], [12, 99811], [15, 100171], [21, 100651], [28, 101426], [35, 102201], [41, 102976], [47, 103276], [49, 103624], [55, 104136], [61, 104578], [65, 104758], [69, 104918], [75, 105198], [78, 105458], [87, 106218], [93, 106478], [96, 106855]]}, {"verse": 14, "start": 107534, "end": 118810, "text": "Estos fueron los hijos de Aholibama, mujer de Esaú, hija de Ana, que fue hija de Zibeón: ella parió a Esaú a Jeús, Jaalam, y Coré.", "words": [[0, 107534], [6, 107799], [13, 108059], [17, 108319], [23, 108679], [26, 109059], [37, 110379], [43, 110759], [46, 110999], [52, 111999], [57, 112359], [60, 112479], [65, 113259], [69, 113279], [73, 113519], [78, 114099], [81, 114582], [89, 115437], [94, 115671], [100, 115904], [102, 116332], [107, 116760], [109, 117188], [115, 117616], [123, 118044], [125, 118455]]}, {"verse": 15, "start": 119160, "end": 131168, "text": "Estos son los jefes de los hijos de Esaú. Hijos de Elifaz, primogénito de Esaú: el jefe Temán, el jefe Omar, el jefe Zefo, el jefe Cenaz,", "words": [[0, 119160], [6, 119627], [10, 119947], [14, 120207], [20, 120867], [23, 121067], [27, 121207], [33, 121547], [36, 122015], [42, 122639], [48, 122984], [51, 123444], [59, 123904], [71, 124824], [74, 125229], [80, 125796], [83, 126212], [88, 126658], [95, 127105], [98, 127558], [103, 128012], [109, 128465], [112, 128932], [117, 129398], [123, 129865], [126, 130317], [131, 130769]]}, {"verse": 16, "start": 131518, "end": 142002, "text": "El jefe Coré, el jefe Gatam, y el jefe Amalec: estos son los jefes de Elifaz en la tierra de Edom; estos fueron los hijos de Ada.", "words": [[0, 131518], [3, 131686], [8, 132026], [14, 132746], [17, 132966], [22, 133306], [29, 134206], [31, 134466], [34, 134586], [39, 135228], [47, 136028], [53, 136388], [57, 136588], [61, 136768], [67, 137288], [70, 137598], [77, 137908], [80, 138048], [83, 138188], [90, 138548], [93, 138788], [99, 139719], [105, 140199], [112, 140419], [116, 140659], [122, 140959], [125, 141279]]}, {"verse": 17, "start": 142352, "end": 159931, "text": "Y estos son los hijos de Reuel, hijo de Esaú: el jefe Nahat, el jefe Zera, el jefe Sama, y el jefe Miza: estos son los jefes de la línea de Reuel en la tierra de Edom; estos hijos vienen de Basemat, mujer de Esaú.", "words": [[0, 142352], [2, 142528], [8, 142788], [12, 143188], [16, 143368], [22, 143648], [25, 144308], [32, 144968], [37, 145328], [40, 145568], [46, 146521], [49, 146647], [54, 147277], [61, 147907], [64, 147947], [69, 148527], [75, 149107], [78, 149127], [83, 149427], [89, 149827], [91, 150347], [94, 150427], [99, 150973], [105, 151716], [111, 152105], [115, 152325], [119, 152525], [125, 153145], [128, 153245], [131, 153385], [137, 153725], [140, 154085], [146, 154445], [149, 154825], [152, 154985], [159, 155365], [162, 155645], [168, 156493], [174, 156985], [180, 157205], [187, 157545], [190, 157825], [199, 158845], [205, 159165], [208, 159575]]}, {"verse": 18, "start": 160281, "end": 173173, "text": "Y estos son los hijos de Aholibama, mujer de Esaú: el jefe Jeús, el jefe Jaalam, y el jefe Coré: estos fueron los jefes que salieron de Aholibama, mujer de Esaú, hija de Ana.", "words": [[0, 160281], [2, 160577], [8, 160777], [12, 161097], [16, 161357], [22, 161677], [25, 162287], [36, 162897], [42, 163157], [45, 163576], [51, 164158], [54, 164282], [59, 164872], [65, 165462], [68, 165542], [73, 166042], [81, 166542], [83, 167082], [86, 167202], [91, 167562], [97, 168306], [103, 168574], [110, 168834], [114, 169054], [120, 169514], [124, 169574], [133, 170034], [136, 170624], [147, 171214], [153, 171414], [156, 171884], [162, 172354], [167, 172654], [170, 172754]]}, {"verse": 19, "start": 173523, "end": 178212, "text": "Estos, pues, son los hijos de Esaú, y sus jefes: él es Edom.", "words": [[0, 173523], [7, 173787], [13, 173987], [17, 174447], [21, 174607], [27, 174907], [30, 175247], [36, 175587], [38, 176067], [42, 176247], [49, 177250], [52, 177451], [55, 177831]]}, {"verse": 20, "start": 178562, "end": 186200, "text": "Y estos son los hijos de Seir horeo, moradores de aquella tierra: Lotán, Sobal, Zibeón, Ana,", "words": [[0, 178562], [2, 178680], [8, 178940], [12, 179340], [16, 179520], [22, 179840], [25, 180280], [30, 180720], [37, 181160], [47, 181980], [50, 182220], [58, 182520], [66, 183987], [73, 184552], [80, 185117], [88, 185682]]}, {"verse": 21, "start": 186550, "end": 193716, "text": "Disón, Ezer, y Disán: estos son los jefes de los horeos, hijos de Seir en la tierra de Edom.", "words": [[0, 186550], [7, 187026], [13, 187536], [15, 187796], [22, 188651], [28, 189057], [32, 189257], [36, 189477], [42, 189997], [45, 190097], [49, 190707], [57, 191317], [63, 191497], [66, 191807], [71, 192117], [74, 192437], [77, 192597], [84, 192937], [87, 193197]]}, {"verse": 22, "start": 194066, "end": 199188, "text": "Los hijos de Lotán fueron Hori y Hemán; y Timna fue hermana de Lotán.", "words": [[0, 194066], [4, 194192], [10, 194512], [13, 194832], [19, 195152], [26, 195602], [31, 196052], [33, 196493], [40, 197114], [42, 197260], [48, 197760], [52, 198000], [60, 198420], [63, 198830]]}, {"verse": 23, "start": 199538, "end": 205281, "text": "Y los hijos de Sobal fueron Alván, Manahat, Ebal, Sefo, y Onán.", "words": [[0, 199538], [2, 199660], [6, 199800], [12, 200100], [15, 200380], [21, 200660], [28, 201460], [35, 202260], [44, 203060], [50, 203860], [56, 204300], [58, 204700]]}, {"verse": 24, "start": 205631, "end": 216599, "text": "Y los hijos de Zibeón fueron Aja, y Ana. Este Ana es el que descubrió los mulos en el desierto, cuando apacentaba los asnos de Zibeón su padre.", "words": [[0, 205631], [2, 205737], [6, 205877], [12, 206157], [15, 206507], [22, 206857], [29, 207361], [34, 207865], [36, 208369], [41, 209031], [46, 209316], [50, 209696], [53, 210236], [56, 210396], [60, 210556], [70, 211116], [74, 211256], [80, 211716], [83, 211876], [86, 212016], [96, 212636], [103, 213216], [114, 214076], [118, 214316], [124, 214876], [127, 215356], [134, 215836], [137, 215936]]}, {"verse": 25, "start": 216949, "end": 220990, "text": "Los hijos de Ana fueron Disón, y Aholibama, hija de Ana.", "words": [[0, 216949], [4, 217053], [10, 217353], [13, 217593], [17, 217753], [24, 218033], [31, 218693], [33, 219420], [44, 220148], [49, 220428], [52, 220548]]}, {"verse": 26, "start": 221340, "end": 226477, "text": "Y estos fueron los hijos de Disón: Hemdán, Eshbán, Itrán, y Querán.", "words": [[0, 221340], [2, 221497], [8, 221757], [15, 222117], [19, 222357], [25, 222657], [28, 222897], [35, 224091], [43, 224386], [51, 224681], [58, 224976], [60, 225726]]}, {"verse": 27, "start": 226827, "end": 230948, "text": "Y estos fueron los hijos de Ezer: Bilhán, Zaaván, y Acán.", "words": [[0, 226827], [2, 226936], [8, 227116], [15, 227376], [19, 227576], [25, 227876], [28, 228252], [34, 229111], [42, 229457], [50, 229804], [52, 230104]]}, {"verse": 28, "start": 231298, "end": 234358, "text": "Estos fueron los hijos de Disán: Huz, y Arán.", "words": [[0, 231298], [6, 231665], [13, 231905], [17, 232125], [23, 232385], [26, 232585], [33, 233683], [38, 233930], [40, 234176]]}, {"verse": 29, "start": 234708, "end": 242895, "text": "Y estos fueron los jefes de los horeos: el jefe Lotán, el jefe Sobal, el jefe Zibeón, el jefe Ana,", "words": [[0, 234708], [2, 234870], [8, 235130], [15, 235550], [19, 235790], [25, 236230], [28, 236330], [32, 236821], [40, 237482], [43, 237628], [48, 237908], [55, 238968], [58, 239048], [63, 239728], [70, 240408], [73, 240428], [78, 241178], [86, 241928], [89, 242008], [94, 242328]]}, {"verse": 30, "start": 243245, "end": 252649, "text": "El jefe Disón, el jefe Ezer, el jefe Disán: estos fueron los jefes de los horeos: por sus ducados en la tierra de Seir.", "words": [[0, 243245], [3, 243374], [8, 243984], [15, 244594], [18, 244834], [23, 245417], [29, 245999], [32, 246059], [37, 246812], [44, 247731], [50, 248080], [57, 248340], [61, 248580], [67, 249020], [70, 249120], [74, 249592], [82, 250200], [86, 250325], [90, 250525], [98, 251085], [101, 251305], [104, 251425], [111, 251765], [114, 251985]]}, {"verse": 31, "start": 252999, "end": 260203, "text": "Y los reyes que reinaron en la tierra de Edom, antes que reinase rey sobre los hijos de Israel, fueron estos:", "words": [[0, 252999], [2, 253123], [6, 253263], [12, 253663], [16, 253863], [25, 254483], [28, 254683], [31, 254803], [38, 255143], [41, 255383], [47, 256243], [53, 256703], [57, 256923], [65, 257543], [69, 257863], [75, 258063], [79, 258303], [85, 258583], [88, 258783], [96, 259343], [103, 259543]]}, {"verse": 32, "start": 260553, "end": 266676, "text": "Bela, hijo de Beor, reinó en Edom: y el nombre de su ciudad fue Dinaba.", "words": [[0, 260635], [6, 261211], [11, 261531], [14, 262011], [20, 262491], [26, 262971], [29, 263291], [35, 264060], [37, 264225], [40, 264405], [47, 264825], [50, 265045], [53, 265245], [60, 265685], [64, 265945]]}, {"verse": 33, "start": 267026, "end": 272942, "text": "Y murió Bela, y reinó en su lugar Jobab, hijo de Zera, de Bosra.", "words": [[0, 267026], [2, 267152], [8, 267752], [14, 268352], [16, 268632], [22, 269292], [25, 269412], [28, 269572], [34, 270342], [41, 271112], [46, 271412], [49, 271852], [55, 272292], [58, 272644]]}, {"verse": 34, "start": 273292, "end": 279081, "text": "Y murió Jobab, y en su lugar reinó Husam, de tierra de Temán.", "words": [[0, 273292], [2, 273414], [8, 274104], [15, 274794], [17, 275094], [20, 275274], [23, 275534], [29, 276187], [35, 276841], [42, 277494], [45, 277714], [52, 278194], [55, 278434]]}, {"verse": 35, "start": 279431, "end": 289703, "text": "Y murió Husam, y reinó en su lugar Adad, hijo de Badad, el que hirió a Madián en el campo de Moab: y el nombre de su ciudad fue Avit.", "words": [[0, 279431], [2, 279595], [8, 280065], [15, 280535], [17, 281195], [23, 281635], [26, 281835], [29, 282015], [35, 282355], [41, 283135], [46, 283355], [49, 283575], [56, 284095], [59, 284235], [63, 284565], [69, 284895], [71, 285185], [78, 285475], [81, 285675], [84, 285795], [90, 286075], [93, 286355], [99, 287171], [101, 287317], [104, 287437], [111, 287837], [114, 288037], [117, 288217], [124, 288637], [128, 289197]]}, {"verse": 36, "start": 290053, "end": 295065, "text": "Y murió Adad, y en su lugar reinó Samla, de Masreca.", "words": [[0, 290053], [2, 290215], [8, 290747], [14, 291280], [16, 291560], [19, 291760], [22, 292000], [28, 292340], [34, 292820], [41, 293460], [44, 294294]]}, {"verse": 37, "start": 295415, "end": 300979, "text": "Y murió Samla, y reinó en su lugar Saúl, de Rehobot del Río.", "words": [[0, 295415], [2, 295561], [8, 296031], [15, 296501], [17, 296961], [23, 297481], [26, 297601], [29, 297781], [35, 298101], [41, 298921], [44, 299451], [52, 299981], [56, 300301]]}, {"verse": 38, "start": 301329, "end": 306947, "text": "Y murió Saúl, y en lugar suyo reinó Baal-hanán, hijo de Acbor.", "words": [[0, 301329], [2, 301454], [8, 301754], [14, 302674], [16, 302934], [19, 303074], [25, 303354], [30, 304161], [36, 304967], [48, 305774], [53, 306134], [56, 306570]]}, {"verse": 39, "start": 307297, "end": 320737, "text": "Y murió Baal-hanán, hijo de Acbor, y reinó Adar en lugar suyo: y el nombre de su ciudad fue Pau; y el nombre de su mujer Mehetabel, hija de Matred, hija de Mezaab.", "words": [[0, 307297], [2, 307557], [8, 308287], [20, 309017], [25, 309357], [28, 309917], [35, 310477], [37, 310577], [43, 311027], [48, 311477], [51, 311697], [57, 311977], [63, 313013], [65, 313139], [68, 313239], [75, 313619], [78, 313819], [81, 314039], [88, 314519], [92, 314704], [97, 315637], [99, 315769], [102, 315889], [109, 316229], [112, 316429], [115, 316629], [121, 317429], [132, 318229], [137, 318589], [140, 318669], [148, 319549], [153, 319869], [156, 320337]]}, {"verse": 40, "start": 321087, "end": 332302, "text": "Estos, pues, son los nombres de los jefes de Esaú por sus linajes, por sus lugares, y sus nombres: el jefe Timna, el jefe Alva, el jefe Jetet,", "words": [[0, 321263], [7, 321473], [13, 322093], [17, 322433], [21, 322613], [29, 323093], [32, 323273], [36, 323393], [42, 323793], [45, 324113], [50, 324433], [54, 324533], [58, 324753], [67, 325813], [71, 325933], [75, 326363], [84, 326793], [86, 327013], [90, 327173], [99, 328098], [102, 328314], [107, 328554], [114, 329674], [117, 330187], [122, 330701], [128, 331214], [131, 331577], [136, 331939]]}, {"verse": 41, "start": 332652, "end": 336644, "text": "El duque Aholibama, el duque Ela, el duque Pinón,", "words": [[0, 332652], [3, 332859], [9, 333619], [20, 334379], [23, 334699], [29, 335079], [34, 335599], [37, 335619], [43, 335919]]}, {"verse": 42, "start": 336994, "end": 340811, "text": "El duque Cenaz, el duque Temán, el duque Mibzar,", "words": [[0, 336994], [3, 337136], [9, 337776], [16, 338416], [19, 338496], [25, 338796], [32, 339616], [35, 339696], [41, 340254]]}, {"verse": 43, "start": 341161, "end": 353144, "text": "El jefe Magdiel, y el jefe Hiram. Estos fueron los jefes de Edom por sus habitaciones en la tierra de su posesión. Edom es el mismo Esaú, padre de los edomitas.", "words": [[0, 341161], [3, 341608], [8, 342054], [17, 342501], [19, 342761], [22, 343149], [27, 343537], [34, 344122], [40, 344466], [47, 344726], [51, 344946], [57, 345406], [60, 345676], [65, 345946], [69, 346126], [73, 346306], [86, 347046], [89, 347266], [92, 347406], [99, 347746], [102, 347926], [105, 348106], [115, 349121], [120, 349548], [123, 350008], [126, 350308], [132, 350856], [138, 351403], [144, 351923], [147, 352063], [151, 352203]]}]}