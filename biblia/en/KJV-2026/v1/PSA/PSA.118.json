, 90066], [27, 90726], [31, 90846], [39, 91166], [43, 91386], [49, 91646], [52, 91826], [56, 91966]]}, {"verse": 18, "start": 92916, "end": 97073, "text": "The LORD has chastened me severely: but he has not given me over to death.", "words": [[0, 92916], [4, 93013], [9, 93193], [13, 93413], [23, 94033], [26, 94153], [36, 95212], [40, 95341], [43, 95461], [47, 95581], [51, 95781], [57, 96041], [60, 96281], [65, 96481], [68, 96661]]}, {"verse": 19, "start": 97523, "end": 102572, "text": "Open to me the gates of righteousness: I will go into them, and I will praise the LORD:", "words": [[0, 97523], [5, 97782], [8, 98022], [11, 98182], [15, 98342], [21, 98702], [24, 98982], [39, 100046], [41, 100197], [46, 100357], [49, 100537], [54, 100817], [60, 101077], [64, 101297], [66, 101417], [71, 101537], [78, 101857], [82, 102117]]}, {"verse": 20, "start": 103022, "end": 105895, "text": "This gate of the LORD, into which the righteous shall enter.", "words": [[0, 103022], [5, 103209], [10, 103509], [13, 103649], [17, 103749], [23, 104009], [28, 104329], [34, 104569], [38, 104729], [48, 105009], [54, 105349]]}, {"verse": 21, "start": 106345, "end": 110322, "text": "I will praise you: for you have heard me, and are become my salvation.", "words": [[0, 106345], [2, 106490], [7, 106610], [14, 106890], [19, 107579], [23, 107708], [27, 107868], [32, 108048], [38, 108288], [42, 108488], [46, 108728], [50, 108868], [57, 109108], [60, 109428]]}, {"verse": 22, "start": 110772, "end": 114810, "text": "The stone which the builders refused is become the head stone of the corner.", "words": [[0, 110772], [4, 110875], [10, 111175], [16, 111455], [20, 111655], [29, 111935], [37, 112375], [40, 112815], [47, 113155], [51, 113402], [56, 113648], [62, 113895], [65, 114115], [69, 114215]]}, {"verse": 23, "start": 115260, "end": 119177, "text": "This is the LORD’s doing; it is marvellous in our eyes.", "words": [[0, 115260], [5, 115483], [8, 115603], [12, 115783], [19, 116223], [26, 117509], [29, 117613], [32, 117903], [43, 118193], [46, 118473], [50, 118653]]}, {"verse": 24, "start": 119627, "end": 123705, "text": "This is the day which the LORD has made; we will rejoice and be glad in it.", "words": [[0, 119627], [5, 119811], [8, 119931], [12, 120091], [16, 120331], [22, 120511], [26, 120691], [31, 120911], [35, 121091], [41, 121873], [44, 121980], [49, 122140], [57, 122580], [61, 122860], [64, 123000], [69, 123280], [72, 123480]]}, {"verse": 25, "start": 124155, "end": 129957, "text": "Save now, I beg you, O LORD: O LORD, I beg you, send now prosperity.", "words": [[0, 124155], [5, 124417], [10, 124857], [12, 124917], [16, 125117], [21, 125617], [23, 125617], [29, 126955], [31, 127092], [37, 127532], [39, 127592], [43, 127832], [48, 128512], [53, 128672], [57, 128992]]}, {"verse": 26, "start": 130407, "end": 135709, "text": "Blessed be he that comes in the name of the LORD: we have blessed you out of the house of the LORD.", "words": [[0, 130407], [8, 130631], [11, 130971], [14, 131171], [19, 131371], [25, 131671], [28, 131891], [32, 131991], [37, 132251], [40, 132411], [44, 132511], [50, 133381], [53, 133509], [58, 133649], [66, 133929], [70, 134189], [74, 134389], [77, 134529], [81, 134649], [87, 134889], [90, 135069], [94, 135209]]}, {"verse": 27, "start": 136159, "end": 143124, "text": "God is the LORD, which has showed us light: bind the sacrifice with cords, even to the horns of the altar.", "words": [[0, 136159], [4, 136445], [7, 136665], [11, 136845], [17, 137505], [23, 137705], [27, 137865], [34, 138125], [37, 138305], [44, 139090], [49, 139412], [53, 139672], [63, 140272], [68, 140572], [75, 141032], [80, 141572], [83, 141792], [87, 141932], [93, 142252], [96, 142472], [100, 142592]]}, {"verse": 28, "start": 143574, "end": 149029, "text": "You are my God, and I will praise you: you are my God, I will exalt you.", "words": [[0, 143574], [4, 143963], [8, 144123], [11, 144323], [16, 145163], [20, 145243], [22, 145423], [27, 145563], [34, 145843], [3