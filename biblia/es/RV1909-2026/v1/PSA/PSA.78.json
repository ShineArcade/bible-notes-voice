{"book": "PSA", "chapter": 78, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 449471, "verses": [{"verse": 1, "start": 300, "end": 7438, "text": "Masquil de Asaf. ESCUCHA, pueblo mío, mi ley: inclinad vuestro oído a las palabras de mi boca.", "words": [[0, 300], [8, 849], [11, 1194], [17, 1799], [26, 2157], [33, 2537], [38, 2735], [41, 2933], [46, 4230], [55, 5120], [63, 5540], [68, 5940], [70, 6100], [74, 6180], [83, 6540], [86, 6760], [89, 6880]]}, {"verse": 2, "start": 7888, "end": 12654, "text": "Abriré mi boca en parábola; hablaré cosas reservadas de antiguo:", "words": [[0, 7888], [7, 8548], [10, 8668], [15, 8908], [18, 9108], [28, 10327], [36, 10768], [42, 11008], [53, 11788], [56, 11968]]}, {"verse": 3, "start": 13104, "end": 17730, "text": "Las cuales hemos oído y entendido; que nuestros padres nos las contaron.", "words": [[0, 13104], [4, 13213], [11, 13393], [17, 13753], [22, 14293], [24, 14453], [35, 15651], [39, 15733], [48, 15933], [55, 16513], [59, 16793], [63, 16953]]}, {"verse": 4, "start": 18180, "end": 28575, "text": "No las encubriremos a sus hijos, contando a la generación venidera las alabanzas de Jehová, y su fortaleza, y sus maravillas que hizo.", "words": [[0, 18180], [3, 18550], [7, 18830], [20, 19930], [22, 20150], [26, 20310], [33, 21210], [42, 21970], [44, 22090], [47, 22170], [58, 22890], [67, 23610], [71, 23790], [81, 24470], [84, 24570], [92, 25350], [94, 25510], [97, 25670], [108, 26630], [110, 26990], [114, 27150], [125, 27830], [129, 28030]]}, {"verse": 5, "start": 29025, "end": 37408, "text": "Él estableció testimonio en Jacob, y pusó ley en Israel; la cual mandó a nuestros padres que la notificasen a sus hijos;", "words": [[0, 29025], [3, 29229], [14, 29989], [25, 30649], [28, 30729], [35, 31049], [37, 31349], [42, 31709], [46, 31929], [49, 32289], [57, 33344], [60, 33450], [65, 33650], [71, 34210], [73, 34350], [82, 34550], [89, 35230], [93, 35530], [96, 36050], [108, 36570], [110, 36650], [114, 36830]]}, {"verse": 6, "start": 37858, "end": 45032, "text": "Para que lo sepa la generación venidera, y los hijos que nacerán; y los que se levantarán, lo cuenten a sus hijos;", "words": [[0, 37858], [5, 38193], [9, 38313], [12, 38453], [17, 38773], [20, 38873], [31, 39493], [41, 40133], [43, 40253], [47, 40433], [53, 40713], [57, 40933], [66, 41941], [68, 42068], [72, 42188], [76, 42348], [79, 42528], [91, 43348], [94, 43488], [102, 44028], [104, 44128], [108, 44308]]}, {"verse": 7, "start": 45482, "end": 53006, "text": "A fin de que pongan en Dios su confianza, y no se olviden de las obras de Dios, y guarden sus mandamientos:", "words": [[0, 45482], [2, 45622], [6, 45782], [9, 45942], [13, 46062], [20, 46582], [23, 46722], [28, 46982], [31, 47382], [42, 48402], [44, 48582], [47, 48722], [50, 48902], [58, 49462], [61, 49642], [65, 49822], [71, 50122], [74, 50322], [80, 50662], [82, 51142], [90, 51682], [94, 51902]]}, {"verse": 8, "start": 53456, "end": 63921, "text": "Y no sean como sus padres, generación obstinada y rebelde; generación que no preparó su corazón, ni fue fiel para con Dios su espíritu.", "words": [[0, 53456], [2, 53585], [5, 53725], [10, 54045], [15, 54385], [19, 54605], [27, 55685], [38, 56545], [48, 57425], [50, 57565], [59, 58642], [70, 59251], [74, 59411], [77, 59551], [85, 60031], [88, 60151], [97, 61011], [100, 61251], [104, 61471], [109, 61891], [114, 62191], [118, 62451], [123, 62731], [126, 63111]]}, {"verse": 9, "start": 64371, "end": 69827, "text": "Los hijos de Efraín armados, flecheros, volvieron las espaldas el día de la batalla.", "words": [[0, 64371], [4, 64500], [10, 64860], [13, 65320], [20, 65780], [29, 66440], [40, 67300], [50, 67740], [54, 67920], [63, 68600], [66, 68780], [70, 69000], [73, 69140], [76, 69240]]}, {"verse": 10, "start": 70277, "end": 74618, "text": "No guardaron el pacto de Dios, ni quisieron andar en su ley:", "words": [[0, 70277], [3, 70480], [13, 71120], [16, 71320], [22, 71840], [25, 71940], [31, 72280], [34, 72720], [44, 73340], [50, 73760], [53, 74000], [56, 74160]]}, {"verse": 11, "start": 75068, "end": 81016, "text": "Antes se olvidaron de sus obras, y de sus maravillas que les había mostrado.", "words": [[0, 75068], [6, 75535], [9, 76155], [19, 76795], [22, 76995], [26, 77175], [33, 77595], [35, 78415], [38, 78535], [42, 78715], [53, 79415], [57, 79655], [61, 79835], [67, 80135]]}, {"verse": 12, "start": 81466, "end": 87573, "text": "Delante de sus padres hizo maravillas en la tierra de Egipto, en el campo de Zoán.", "words": [[0, 81466], [8, 81934], [11, 82114], [15, 82234], [22, 82694], [27, 83434], [38, 84214], [41, 84434], [44, 84574], [51, 84934], [54, 85174], [62, 85814], [65, 86194], [68, 86354], [74, 86694], [77, 87166]]}, {"verse": 13, "start": 88023, "end": 93791, "text": "Rompió el mar, y los hizo pasar; e hizo estar las aguas como en un montón.", "words": [[0, 88023], [7, 88465], [10, 88625], [15, 88905], [17, 89545], [21, 89705], [26, 89925], [33, 90924], [35, 91205], [40, 91445], [46, 91765], [50, 92005], [56, 92465], [61, 92665], [64, 92845], [67, 92965]]}, {"verse": 14, "start": 94241, "end": 98732, "text": "Y los llevó de día con nube, y toda la noche con resplandor de fuego.", "words": [[0, 94241], [2, 94481], [6, 94621], [12, 94981], [15, 95061], [19, 95281], [23, 95501], [29, 96001], [31, 96361], [36, 96581], [39, 96821], [45, 97081], [49, 97361], [60, 98021], [63, 98121]]}, {"verse": 15, "start": 99182, "end": 104728, "text": "Hendió las peñas en el desierto: y les dio a beber como de grandes abismos;", "words": [[0, 99326], [7, 99506], [11, 99626], [17, 100146], [20, 100366], [23, 100486], [33, 101595], [35, 101870], [39, 101990], [43, 102150], [45, 102290], [51, 102470], [56, 102770], [59, 102950], [67, 103270]]}, {"verse": 16, "start": 105178, "end": 109786, "text": "Pues sacó de la peña corrientes, e hizo descender aguas como ríos.", "words": [[0, 105178], [5, 105178], [10, 105615], [13, 105695], [16, 105815], [21, 106135], [33, 106775], [35, 107155], [40, 107475], [50, 108115], [56, 108795], [61, 109035]]}, {"verse": 17, "start": 110236, "end": 115291, "text": "Pero aun volvieron a pecar contra él, enojando en la soledad al Altísimo.", "words": [[0, 110236], [5, 110403], [9, 110643], [19, 111203], [21, 111363], [27, 111723], [34, 112063], [38, 112943], [47, 113463], [50, 113583], [53, 113683], [61, 114263], [64, 114403]]}, {"verse": 18, "start": 115741, "end": 120181, "text": "Pues tentaron a Dios en su corazón, pidiendo comida a su gusto.", "words": [[0, 115741], [5, 115902], [14, 116502], [16, 116662], [21, 116922], [24, 117182], [27, 117342], [36, 118222], [45, 118802], [52, 119242], [54, 119422], [57, 119522]]}, {"verse": 19, "start": 120631, "end": 124635, "text": "Y hablaron contra Dios, diciendo: ¿Podrá poner mesa en el desierto?", "words": [[0, 120631], [2, 120736], [11, 121176], [18, 121496], [24, 121776], [34, 122844], [41, 123128], [47, 123308], [52, 123668], [55, 123808], [58, 123908]]}, {"verse": 20, "start": 125085, "end": 132670, "text": "He aquí ha herido la peña, y corrieron aguas, y arroyos salieron ondeando: ¿podrá también dar pan? ¿preparará carne a su pueblo?", "words": [[0, 125085], [3, 125229], [8, 125409], [11, 125589], [18, 125869], [21, 125989], [27, 126409], [29, 126769], [39, 127209], [46, 127689], [48, 127849], [56, 128249], [65, 128669], [75, 129677], [82, 129981], [90, 130221], [94, 130441], [99, 131427], [110, 131667], [116, 131907], [118, 132087], [121, 132167]]}, {"verse": 21, "start": 133020, "end": 141163, "text": "Por tanto, oyó Jehová y se indignó; se encendió el fuego contra Jacob, y el furor subió también contra Israel;", "words": [[0, 133020], [4, 133164], [11, 133657], [15, 134151], [22, 134644], [24, 134824], [27, 134924], [36, 136145], [39, 136305], [48, 136925], [51, 137045], [57, 137345], [64, 137785], [71, 138205], [73, 138525], [76, 138685], [82, 139145], [88, 139585], [96, 139885], [103, 140385]]}, {"verse": 22, "start": 141613, "end": 146133, "text": "Por cuanto no habían creído a Dios, ni habían confiado en su salvación:", "words": [[0, 141613], [4, 141715], [11, 141955], [14, 142295], [21, 142615], [28, 143095], [30, 143235], [36, 143645], [39, 144055], [46, 144355], [55, 145055], [58, 145175], [61, 145315]]}, {"verse": 23, "start": 146583, "end": 151620, "text": "A pesar de que mandó a las nubes de arriba, y abrió las puertas de los cielos,", "words": [[0, 146583], [2, 146725], [8, 146965], [11, 147185], [15, 147325], [21, 147785], [23, 147905], [27, 148005], [33, 148445], [36, 148585], [44, 148985], [46, 149545], [52, 149825], [56, 149985], [64, 150545], [67, 150725], [71, 150865]]}, {"verse": 24, "start": 152070, "end": 157073, "text": "E hizo llover sobre ellos maná para comer, y les dio trigo de los cielos.", "words": [[0, 152070], [2, 152215], [7, 152575], [14, 153055], [20, 153395], [26, 153715], [31, 154095], [36, 154215], [43, 155075], [45, 155435], [49, 155575], [53, 155735], [59, 156135], [62, 156255], [66, 156395]]}, {"verse": 25, "start": 157523, "end": 162042, "text": "Pan de nobles comió el hombre: les envió comida a hartura.", "words": [[0, 157523], [4, 157700], [7, 157840], [14, 158240], [20, 159020], [23, 159180], [31, 159983], [35, 160112], [41, 160532], [48, 160992], [50, 161539]]}, {"verse": 26, "start": 162492, "end": 166760, "text": "Movió el solano en el cielo, y trajo con su fortaleza el sur.", "words": [[0, 162492], [6, 162976], [9, 163096], [16, 163536], [19, 163656], [22, 163776], [29, 164236], [31, 164676], [37, 165096], [41, 165296], [44, 165476], [54, 166176], [57, 166316]]}, {"verse": 27, "start": 167210, "end": 173392, "text": "E hizo llover sobre ellos carne como polvo, y aves de alas como arena del mar.", "words": [[0, 167210], [2, 167354], [7, 167594], [14, 168074], [20, 168334], [26, 168714], [32, 169254], [37, 169554], [44, 170654], [46, 170894], [51, 171194], [54, 171454], [59, 171894], [64, 172194], [70, 172594], [74, 172894]]}, {"verse": 28, "start": 173842, "end": 178622, "text": "Y las hizo caer en medio de su campo, alrededor de sus tiendas.", "words": [[0, 173842], [2, 173968], [6, 174108], [11, 174408], [16, 174968], [19, 175108], [25, 175468], [28, 175688], [31, 175848], [38, 176308], [48, 177048], [51, 177668], [55, 177808]]}, {"verse": 29, "start": 179072, "end": 183271, "text": "Y comieron, y se hartaron mucho: les cumplió pues su deseo.", "words": [[0, 179072], [2, 179173], [12, 179633], [14, 179853], [17, 179973], [26, 180433], [33, 181374], [37, 181671], [45, 182001], [50, 182281], [53, 182621]]}, {"verse": 30, "start": 183721, "end": 188573, "text": "No habían quitado de sí su deseo, aún estaba su comida en su boca,", "words": [[0, 183721], [3, 183832], [10, 184052], [18, 184612], [21, 184852], [24, 184992], [27, 185192], [34, 186252], [38, 186512], [45, 186932], [48, 187212], [55, 187552], [58, 187772], [61, 187952]]}, {"verse": 31, "start": 189023, "end": 197069, "text": "Cuando vino sobre ellos el furor de Dios, y mató los más robustos de ellos, y derribó los escogidos de Israel.", "words": [[0, 189023], [7, 189206], [12, 189486], [18, 189826], [24, 190186], [27, 190406], [33, 190826], [36, 190986], [42, 191306], [44, 191786], [49, 192166], [53, 192326], [57, 192606], [66, 193686], [69, 193846], [76, 194166], [78, 194546], [86, 195386], [90, 195526], [100, 196186], [103, 196346]]}, {"verse": 32, "start": 197519, "end": 202011, "text": "Con todo esto pecaron aún, y no dieron crédito a sus maravillas.", "words": [[0, 197519], [4, 197645], [9, 197905], [14, 198165], [22, 198825], [27, 199085], [29, 199585], [32, 199745], [39, 200005], [47, 200725], [49, 200865], [53, 201005]]}, {"verse": 33, "start": 202461, "end": 207487, "text": "Consumió por tanto en nada sus días, y sus años en la tribulación.", "words": [[0, 202461], [9, 203065], [13, 203245], [19, 203585], [22, 203825], [27, 204165], [31, 204445], [37, 204785], [39, 205085], [43, 205265], [48, 205625], [51, 206325], [54, 206465]]}, {"verse": 34, "start": 207937, "end": 214108, "text": "Si los mataba, entonces buscaban a Dios; entonces se volvían solícitos en busca suya.", "words": [[0, 207937], [3, 208081], [7, 208201], [15, 208601], [24, 208981], [33, 209621], [35, 209721], [41, 210556], [50, 211218], [53, 211798], [61, 212238], [71, 212978], [74, 213178], [80, 213398]]}, {"verse": 35, "start": 214558, "end": 220355, "text": "Y se acordaban que Dios era su refugio, y el Dios Alto su redentor.", "words": [[0, 214558], [2, 214667], [5, 214787], [15, 215407], [19, 215607], [24, 215907], [28, 216287], [31, 216507], [40, 217307], [42, 217727], [45, 217867], [50, 218107], [55, 219187], [58, 219327]]}, {"verse": 36, "start": 220805, "end": 224877, "text": "Pero le halagaban con su boca, y con su lengua le mentían:", "words": [[0, 220805], [5, 220949], [8, 221349], [18, 221749], [22, 221909], [25, 222149], [31, 222529], [33, 223109], [37, 223289], [40, 223469], [47, 223849], [50, 223969]]}, {"verse": 37, "start": 225327, "end": 230951, "text": "Pues sus corazones no eran rectos con él, ni estuvieron firmes en su pacto.", "words": [[0, 225327], [5, 225530], [9, 226090], [19, 226790], [22, 227130], [27, 227390], [34, 227970], [38, 228210], [42, 228590], [45, 228970], [56, 229450], [63, 230030], [66, 230190], [69, 230370]]}, {"verse": 38, "start": 231401, "end": 240690, "text": "Pero él misericordioso, perdonaba la maldad, y no los destruía: y abundó para apartar su ira, y no despertó todo su enojo.", "words": [[0, 231401], [5, 231586], [8, 232026], [24, 233046], [34, 233486], [37, 233646], [45, 234106], [47, 234546], [50, 234726], [54, 234886], [64, 236142], [66, 236268], [73, 236728], [78, 236928], [86, 237588], [89, 237868], [94, 238288], [96, 238708], [99, 238868], [108, 239568], [113, 239788], [116, 240048]]}, {"verse": 39, "start": 241140, "end": 245361, "text": "Y se acordó que eran carne; soplo que va y no vuelve.", "words": [[0, 241140], [2, 241248], [5, 241368], [12, 241828], [16, 241948], [21, 242128], [28, 243207], [34, 243829], [38, 243989], [41, 244269], [43, 244609], [46, 244749]]}, {"verse": 40, "start": 245811, "end": 251120, "text": "¡Cuántas veces lo irritaron en el desierto, lo enojaron en la soledad!", "words": [[0, 245811], [9, 246154], [15, 246614], [18, 246954], [28, 247614], [31, 247814], [34, 247954], [44, 249094], [47, 249214], [56, 250094], [59, 250254], [62, 250394]]}, {"verse": 41, "start": 251570, "end": 256541, "text": "Y volvían, y tentaban a Dios, y ponían límite al Santo de Israel.", "words": [[0, 251570], [2, 251717], [11, 252277], [13, 252697], [22, 253217], [24, 253337], [30, 253577], [32, 254197], [39, 254557], [46, 255177], [49, 255297], [55, 255617], [58, 255857]]}, {"verse": 42, "start": 256991, "end": 261690, "text": "No se acordaron de su mano, del día que los redimió de angustia;", "words": [[0, 256991], [3, 257177], [6, 257337], [16, 257977], [19, 258157], [22, 258317], [28, 258737], [32, 259417], [36, 259697], [40, 260077], [44, 260457], [52, 260837], [55, 260937]]}, {"verse": 43, "start": 262140, "end": 267279, "text": "Cuando puso en Egipto sus señales, y sus maravillas en el campo de Zoán;", "words": [[0, 262140], [7, 262397], [12, 262857], [15, 262957], [22, 263497], [26, 263697], [35, 264497], [37, 264697], [41, 264837], [52, 265577], [55, 265897], [58, 266017], [64, 266357], [67, 266841]]}, {"verse": 44, "start": 267729, "end": 272793, "text": "Y volvió sus ríos en sangre, y sus corrientes, porque no bebiesen.", "words": [[0, 267729], [2, 267850], [9, 268270], [13, 268430], [18, 268910], [21, 269110], [29, 269670], [31, 270190], [35, 270350], [47, 271070], [54, 271610], [57, 271870]]}, {"verse": 45, "start": 273243, "end": 279320, "text": "Envió entre ellos una mezcla de moscas que los comían, y ranas que los destruyeron.", "words": [[0, 273243], [6, 273681], [12, 274021], [18, 274381], [22, 274621], [29, 275161], [32, 275301], [39, 275761], [43, 275921], [47, 276081], [55, 276661], [57, 277181], [63, 277801], [67, 277961], [71, 278161]]}, {"verse": 46, "start": 279770, "end": 284729, "text": "dio también al pulgón sus frutos, y sus trabajos a la langosta.", "words": [[0, 279770], [4, 279977], [12, 280437], [15, 280757], [22, 281297], [26, 281537], [34, 282157], [36, 282837], [40, 283017], [49, 283677], [51, 283777], [54, 283877]]}, {"verse": 47, "start": 285179, "end": 289668, "text": "Sus viñas destruyó con granizo, y sus higuerales con piedra;", "words": [[0, 285179], [4, 285322], [10, 285862], [19, 286622], [23, 286802], [32, 287402], [34, 287902], [38, 288102], [49, 288742], [53, 288882]]}, {"verse": 48, "start": 290118, "end": 295192, "text": "Y entregó al pedrisco sus bestias, y al fuego sus ganados.", "words": [[0, 290118], [2, 290240], [10, 290780], [13, 290900], [22, 291460], [26, 291700], [35, 292320], [37, 293340], [40, 293500], [46, 293780], [50, 294380]]}, {"verse": 49, "start": 295642, "end": 302951, "text": "Envió sobre ellos el furor de su saña, ira y enojo y angustia, con misión de malos ángeles.", "words": [[0, 295642], [6, 296086], [12, 296386], [18, 296666], [21, 296926], [27, 297346], [30, 297599], [33, 297853], [39, 298106], [43, 298746], [45, 299066], [51, 299586], [53, 299806], [63, 300846], [67, 301026], [74, 301506], [77, 301726], [83, 302106]]}, {"verse": 50, "start": 303401, "end": 311026, "text": "Dispuso el camino a su furor; no eximió la vida de ellos de la muerte, sino que entregó su vida a la mortandad.", "words": [[0, 303401], [8, 304031], [11, 304211], [18, 304591], [20, 304851], [23, 304971], [30, 305914], [33, 306121], [40, 306721], [43, 306881], [48, 307121], [51, 307341], [57, 307601], [60, 307761], [63, 307861], [71, 308601], [76, 308781], [80, 308981], [88, 309461], [91, 309601], [96, 309941], [98, 310081], [101, 310580]]}, {"verse": 51, "start": 311476, "end": 316554, "text": "E hirió a todo primogénito en Egipto, las primicias de las fuerzas en las tiendas de Cam.", "words": [[0, 311476], [2, 311812], [8, 312162], [10, 312282], [15, 312462], [27, 313382], [30, 313482], [38, 313942], [42, 314082], [52, 314582], [55, 314722], [59, 314822], [67, 315282], [70, 315462], [74, 315582], [82, 315982], [85, 316082]]}, {"verse": 52, "start": 317004, "end": 322473, "text": "Pero hizo salir a su pueblo como ovejas, y los llevó por el desierto, como un rebaño.", "words": [[0, 317004], [5, 317171], [10, 317451], [16, 317891], [18, 318051], [21, 318171], [28, 318531], [33, 318851], [41, 319351], [43, 319731], [47, 319871], [53, 320271], [57, 320431], [60, 320611], [70, 321191], [75, 321511], [78, 321691]]}, {"verse": 53, "start": 322923, "end": 328507, "text": "Y los guió con seguridad, que no tuvieron miedo; y el mar cubrió a sus enemigos.", "words": [[0, 322923], [2, 323026], [6, 323206], [11, 323506], [15, 323706], [26, 324766], [30, 324926], [33, 325106], [42, 325546], [49, 326469], [51, 326595], [54, 326695], [58, 326935], [65, 327455], [67, 327595], [71, 327715]]}, {"verse": 54, "start": 328957, "end": 335275, "text": "Los metió después en los términos de su santuario, en este monte que ganó su mano derecha.", "words": [[0, 328957], [4, 329105], [10, 329465], [18, 329765], [21, 330005], [25, 330145], [34, 330725], [37, 330805], [40, 330945], [51, 331625], [54, 331785], [59, 331985], [65, 332265], [69, 332525], [74, 332865], [77, 333025], [82, 333305]]}, {"verse": 55, "start": 335725, "end": 344556, "text": "Y echó las naciones de delante de ellos, y les repartió una herencia con cuerdas; e hizo habitar en sus moradas a las tribus de Israel.", "words": [[0, 335725], [2, 335725], [7, 335725], [11, 335872], [20, 336312], [23, 336512], [31, 336952], [34, 337132], [41, 337452], [43, 337872], [47, 338402], [56, 338932], [60, 339152], [69, 339812], [73, 340389], [82, 341240], [84, 341384], [89, 341644], [97, 342104], [100, 342244], [104, 342384], [112, 342924], [114, 343104], [118, 343224], [125, 343684], [128, 343804]]}, {"verse": 56, "start": 345006, "end": 350918, "text": "Mas tentaron y enojaron al Dios Altísimo, y no guardaron sus testimonios;", "words": [[0, 345006], [4, 345306], [13, 346046], [15, 346346], [24, 346986], [27, 347186], [32, 347446], [42, 348466], [44, 349026], [47, 349186], [57, 349746], [61, 349926]]}, {"verse": 57, "start": 351368, "end": 357806, "text": "Sino que se volvieron, y se rebelaron como sus padres: se volvieron como arco engañoso.", "words": [[0, 351368], [5, 351593], [9, 351773], [12, 351933], [23, 352513], [25, 353053], [28, 353503], [38, 353953], [43, 354213], [47, 354413], [55, 355500], [58, 355625], [68, 356125], [73, 356425], [78, 356845]]}, {"verse": 58, "start": 358256, "end": 363532, "text": "Y lo enojaron con sus altos, y lo provocaron a celo con sus esculturas.", "words": [[0, 358256], [2, 358382], [5, 358502], [14, 359162], [18, 359382], [22, 359622], [29, 360362], [31, 360682], [34, 360822], [45, 361522], [47, 361682], [52, 362042], [56, 362222], [60, 362442]]}, {"verse": 59, "start": 363982, "end": 368775, "text": "Lo oyó Dios, y se enojó, y en gran manera aborreció a Israel.", "words": [[0, 363982], [3, 364190], [7, 364490], [13, 364690], [15, 365110], [18, 365250], [25, 365990], [27, 366170], [30, 366330], [35, 366530], [42, 367050], [52, 367930], [54, 368010]]}, {"verse": 60, "start": 369225, "end": 374793, "text": "Dejó por tanto el tabernáculo de Silo, la tienda en que habitó entre los hombres;", "words": [[0, 369225], [5, 369713], [9, 369893], [15, 370313], [18, 370573], [30, 371313], [33, 371533], [39, 372513], [42, 372573], [49, 373013], [52, 373173], [56, 373293], [63, 373673], [69, 373833], [73, 374053]]}, {"verse": 61, "start": 375243, "end": 380960, "text": "Y dio en cautividad su fortaleza, y su gloria en mano del enemigo.", "words": [[0, 375243], [2, 375625], [6, 375925], [9, 376285], [20, 377045], [23, 377365], [34, 378285], [36, 378505], [39, 378665], [46, 379205], [49, 379545], [54, 379905], [58, 380185]]}, {"verse": 62, "start": 381410, "end": 386011, "text": "Entregó también su pueblo a filo de espada, y se airó contra su heredad.", "words": [[0, 381410], [8, 382019], [16, 382339], [19, 382619], [26, 383019], [28, 383219], [33, 383539], [36, 383659], [44, 384179], [46, 384319], [49, 384479], [54, 384819], [61, 385099], [64, 385359]]}, {"verse": 63, "start": 386461, "end": 393706, "text": "El fuego devoró sus jóvenes, y sus vírgenes no fueron alabadas en cantos nupciales.", "words": [[0, 386461], [3, 386805], [9, 387125], [16, 387705], [20, 387885], [29, 388445], [31, 389545], [35, 389725], [44, 390245], [47, 390625], [54, 390905], [63, 391745], [66, 392005], [73, 392625]]}, {"verse": 64, "start": 394156, "end": 398769, "text": "Sus sacerdotes cayeron a espada, y sus viudas no lamentaron.", "words": [[0, 394156], [4, 394281], [15, 395081], [23, 395841], [25, 395961], [33, 396581], [35, 397001], [39, 397201], [46, 397471], [49, 397741]]}, {"verse": 65, "start": 399219, "end": 407265, "text": "Entonces despertó el Señor a la manera del que ha dormido, como un valiente que grita excitado del vino:", "words": [[0, 399219], [9, 399822], [18, 401222], [21, 401562], [27, 401962], [29, 402342], [32, 402462], [39, 402822], [43, 403102], [47, 403302], [50, 403442], [59, 404222], [64, 404562], [67, 404762], [76, 405242], [80, 405502], [86, 405902], [95, 406562], [99, 406762]]}, {"verse": 66, "start": 407715, "end": 413468, "text": "E hirió a sus enemigos en las partes posteriores: les dio perpetua afrenta.", "words": [[0, 407715], [2, 408010], [8, 408340], [10, 408580], [14, 408780], [23, 409360], [26, 409540], [30, 409700], [37, 410060], [50, 411647], [54, 411777], [58, 412057], [67, 412793]]}, {"verse": 67, "start": 413918, "end": 418626, "text": "Y desechó el tabernáculo de José, y no escogió la tribu de Efraín;", "words": [[0, 413918], [2, 414044], [10, 414584], [13, 414994], [25, 415404], [28, 415604], [34, 415964], [36, 416404], [39, 416644], [47, 417184], [50, 417304], [56, 417704], [59, 417844]]}, {"verse": 68, "start": 419076, "end": 424006, "text": "Sino que escogió la tribu de Judá, el monte de Sion, al cual amó.", "words": [[0, 419076], [5, 419337], [9, 419597], [17, 420237], [20, 420507], [26, 420777], [29, 420877], [35, 421517], [38, 421617], [44, 421917], [47, 422137], [53, 423037], [56, 423177], [61, 423417]]}, {"verse": 69, "start": 424456, "end": 430739, "text": "Y edificó su santuario a manera de eminencia, como la tierra que cimentó para siempre.", "words": [[0, 424456], [2, 424601], [10, 425221], [13, 425381], [23, 426201], [25, 426361], [32, 426661], [35, 426901], [46, 427881], [51, 428321], [54, 428481], [61, 428821], [65, 429061], [73, 429721], [78, 429901]]}, {"verse": 70, "start": 431189, "end": 435832, "text": "Y eligió a David su siervo, y lo tomó de las majadas de las ovejas:", "words": [[0, 431189], [2, 431350], [9, 431830], [11, 431930], [17, 432250], [20, 432510], [28, 433090], [30, 433550], [33, 433670], [38, 434070], [41, 434130], [45, 434250], [53, 434790], [56, 434950], [60, 435090]]}, {"verse": 71, "start": 436282, "end": 442564, "text": "De tras las paridas lo trajo, para que apacentase a Jacob su pueblo, y a Israel su heredad.", "words": [[0, 436282], [3, 436409], [8, 436629], [12, 436809], [20, 437249], [23, 437449], [30, 437949], [35, 438429], [39, 438609], [50, 439389], [52, 439509], [58, 439829], [61, 440169], [69, 440589], [71, 440929], [73, 441029], [80, 441569], [83, 441969]]}, {"verse": 72, "start": 443014, "end": 449071, "text": "Y los apacentó con entereza de su corazón; y los pastoreó con la pericia de sus manos.", "words": [[0, 443014], [2, 443138], [6, 443278], [15, 443958], [19, 444368], [28, 444778], [31, 444958], [34, 445098], [43, 446201], [45, 446308], [49, 446428], [58, 447148], [62, 447328], [65, 447488], [73, 447948], [76, 448108], [80, 448228]]}]}