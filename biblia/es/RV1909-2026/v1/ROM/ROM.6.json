{"book": "ROM", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 168107, "verses": [{"verse": 1, "start": 300, "end": 3985, "text": "¿Pues qué diremos? ¿Perseveraremos en pecado para que la gracia crezca?", "words": [[0, 300], [6, 422], [10, 582], [19, 1403], [35, 2065], [38, 2285], [45, 2645], [50, 2825], [54, 2985], [57, 3105], [64, 3465]]}, {"verse": 2, "start": 4435, "end": 9466, "text": "En ninguna manera. Porque los que somos muertos al pecado, ¿cómo viviremos aún en él?", "words": [[0, 4435], [3, 4556], [11, 4876], [19, 5768], [26, 5949], [30, 6089], [34, 6249], [40, 6469], [48, 6929], [51, 7129], [59, 7989], [65, 8149], [75, 8749], [79, 8969], [82, 9169]]}, {"verse": 3, "start": 9916, "end": 15452, "text": "¿O no sabéis que todos los que somos bautizados en Cristo Jesús, somos bautizados en su muerte?", "words": [[0, 9916], [3, 10018], [6, 10058], [13, 10438], [17, 10598], [23, 10858], [27, 11138], [31, 11298], [37, 11538], [48, 12278], [51, 12478], [58, 12738], [65, 13238], [71, 13878], [82, 14598], [85, 14778], [88, 14898]]}, {"verse": 4, "start": 15902, "end": 26252, "text": "Porque somos sepultados juntamente con él a muerte por el bautismo; para que como Cristo resucitó de los muertos por la gloria del Padre, así también nosotros andemos en novedad de vida.", "words": [[0, 15902], [7, 16064], [13, 16344], [24, 17004], [35, 17604], [39, 17824], [42, 17984], [44, 18044], [51, 18324], [55, 18564], [58, 18664], [68, 19605], [73, 19745], [77, 19885], [82, 20125], [89, 20525], [98, 21185], [101, 21245], [105, 21385], [113, 21785], [117, 22025], [120, 22145], [127, 22465], [131, 22605], [138, 23545], [142, 23725], [150, 24125], [159, 24425], [167, 25085], [170, 25265], [178, 25725], [181, 25865]]}, {"verse": 5, "start": 26702, "end": 33272, "text": "Porque si fuimos plantados juntamente en él a la semejanza de su muerte, así también lo seremos a la de su resurrección:", "words": [[0, 26702], [7, 26881], [10, 27021], [17, 27381], [27, 27941], [38, 28581], [41, 28721], [44, 28841], [46, 28921], [49, 29001], [59, 29621], [62, 29721], [65, 29841], [73, 30721], [77, 30941], [85, 31301], [88, 31461], [96, 31821], [98, 32061], [101, 32101], [104, 32261], [107, 32401]]}, {"verse": 6, "start": 33722, "end": 42623, "text": "Sabiendo esto, que nuestro viejo hombre juntamente fue crucificado con él, para que el cuerpo del pecado sea deshecho, a fin de que no sirvamos más al pecado.", "words": [[0, 33722], [9, 34176], [15, 34496], [19, 34696], [27, 34836], [33, 35356], [40, 35616], [51, 36256], [55, 36456], [67, 37156], [71, 37376], [75, 37556], [80, 38116], [84, 38276], [87, 38416], [94, 38716], [98, 38916], [105, 39336], [109, 39866], [119, 40396], [121, 40676], [125, 40856], [128, 41016], [132, 41116], [135, 41256], [144, 41736], [148, 41896], [151, 42056]]}, {"verse": 7, "start": 43073, "end": 46006, "text": "Porque el que es muerto, justificado es del pecado.", "words": [[0, 43073], [7, 43313], [10, 43433], [14, 43553], [17, 43673], [25, 44253], [37, 45033], [40, 45233], [44, 45393]]}, {"verse": 8, "start": 46456, "end": 50114, "text": "Y si morimos con Cristo, creemos que también viviremos con él;", "words": [[0, 46456], [2, 46574], [5, 46694], [13, 47094], [17, 47314], [25, 48094], [33, 48494], [37, 48654], [45, 48994], [55, 49654], [59, 49834]]}, {"verse": 9, "start": 50564, "end": 57488, "text": "Sabiendo que Cristo, habiendo resucitado de entre los muertos, ya no muere: la muerte ya no tiene dominio sobre él.", "words": [[0, 50564], [9, 51022], [13, 51182], [21, 51962], [30, 52322], [41, 53082], [44, 53222], [50, 53422], [54, 53582], [63, 54222], [66, 54242], [69, 54382], [76, 55160], [79, 55264], [86, 55584], [89, 55884], [92, 56024], [98, 56264], [106, 56784], [112, 57064]]}, {"verse": 10, "start": 57938, "end": 62882, "text": "Porque el haber muerto, al pecado murió una vez; pero el vivir, a Dios vive.", "words": [[0, 57938], [7, 58179], [10, 58339], [16, 58499], [24, 59059], [27, 59319], [34, 59759], [40, 60119], [44, 60259], [49, 61067], [54, 61269], [57, 61429], [64, 61729], [66, 62069], [71, 62269]]}, {"verse": 11, "start": 63332, "end": 70766, "text": "Así también vosotros, pensad que de cierto estáis muertos al pecado, pero vivos a Dios en Cristo Jesús Señor nuestro.", "words": [[0, 63332], [4, 63557], [12, 63937], [22, 64417], [29, 64977], [33, 65117], [36, 65257], [43, 65557], [50, 66037], [58, 66397], [61, 66597], [69, 67477], [74, 67817], [80, 68217], [82, 68317], [87, 68497], [90, 68717], [97, 69297], [103, 69877], [109, 70057]]}, {"verse": 12, "start": 71216, "end": 77370, "text": "No reine, pues, el pecado en vuestro cuerpo mortal, para que le obedezcáis en sus malos deseos;", "words": [[0, 71216], [3, 71442], [10, 71822], [16, 72082], [19, 72502], [26, 72962], [29, 73102], [37, 73482], [44, 73722], [52, 74302], [57, 74882], [61, 75042], [64, 75182], [75, 75822], [78, 75982], [82, 76142], [88, 76642]]}, {"verse": 13, "start": 77820, "end": 88742, "text": "Ni tampoco presentéis vuestros miembros al pecado por instrumentos de iniquidad; antes presentaos a Dios como vivos de los muertos, y vuestros miembros a Dios por instrumentos de justicia.", "words": [[0, 77820], [3, 77940], [11, 78280], [22, 79000], [31, 79360], [40, 79780], [43, 79960], [50, 80360], [54, 80560], [67, 81260], [70, 81380], [81, 82263], [87, 82581], [98, 83381], [100, 83501], [105, 83701], [110, 84021], [116, 84441], [119, 84541], [123, 84661], [132, 85141], [134, 85781], [143, 86141], [152, 86581], [154, 86761], [159, 86941], [163, 87221], [176, 87901], [179, 87981]]}, {"verse": 14, "start": 89192, "end": 96138, "text": "Porque el pecado ya no tendrá dominio sobre vosotros; pues no estáis bajo la ley, sino bajo la gracia.", "words": [[0, 89192], [7, 89410], [10, 89550], [17, 89990], [20, 90190], [23, 90330], [30, 90710], [38, 91110], [44, 91290], [54, 93540], [59, 93660], [62, 93820], [69, 94200], [74, 94360], [77, 94560], [82, 95080], [87, 95220], [92, 95440], [95, 95600]]}, {"verse": 15, "start": 96588, "end": 102320, "text": "¿Pues qué? ¿Pecaremos, porque no estamos bajo de la ley, sino bajo de la gracia? En ninguna manera.", "words": [[0, 96588], [6, 96767], [11, 97436], [23, 97879], [30, 98199], [33, 98399], [41, 98699], [46, 98999], [49, 99199], [52, 99299], [57, 99739], [62, 99879], [67, 100179], [70, 100379], [73, 100459], [81, 101321], [84, 101448], [92, 101708]]}, {"verse": 16, "start": 102770, "end": 113752, "text": "¿No sabéis que a quien os prestáis vosotros mismos por siervos para obedecerle, sois siervos de aquel a quien obedecéis, o del pecado para muerte, o de la obediencia para justicia?", "words": [[0, 102770], [4, 102878], [11, 103278], [15, 103478], [17, 103638], [23, 103758], [26, 103938], [35, 104498], [44, 104998], [51, 105398], [55, 105778], [63, 106218], [68, 106438], [80, 107498], [85, 107938], [93, 108318], [96, 108498], [102, 108838], [104, 108918], [110, 109078], [121, 109878], [123, 110238], [127, 110378], [134, 110758], [139, 110958], [147, 111835], [149, 111954], [152, 112054], [155, 112134], [166, 112734], [171, 112974]]}, {"verse": 17, "start": 114202, "end": 122283, "text": "Pero gracias a Dios, que aunque fuisteis siervos del pecado, habéis obedecido de corazón a aquella forma de doctrina a la cual sois entregados;", "words": [[0, 114202], [5, 114342], [13, 114662], [15, 114942], [21, 115522], [25, 115622], [32, 115742], [41, 116322], [49, 116722], [53, 116902], [61, 117682], [68, 117962], [78, 118542], [81, 118722], [89, 118902], [91, 119082], [99, 119582], [105, 119882], [108, 120062], [117, 120582], [119, 120842], [122, 120902], [127, 121122], [132, 121442]]}, {"verse": 18, "start": 122733, "end": 126245, "text": "Y libertados del pecado, sois hechos siervos de la justicia.", "words": [[0, 122733], [2, 122833], [13, 123393], [17, 123573], [25, 124093], [30, 124633], [37, 124893], [45, 125333], [48, 125433], [51, 125513]]}, {"verse": 19, "start": 126695, "end": 140373, "text": "Humana cosa digo, por la debilidad de vuestra naturaleza humana: que como para iniquidad presentasteis vuestros miembros a servir a la inmundicia y a la iniquidad, así ahora para santidad presentéis vuestros miembros a servir a la justicia.", "words": [[0, 126695], [7, 127142], [12, 127302], [18, 127642], [22, 127942], [25, 128062], [35, 128582], [38, 128742], [46, 129082], [57, 129742], [65, 130613], [69, 130706], [74, 130926], [79, 131166], [89, 131726], [103, 132666], [112, 133026], [121, 133546], [123, 133686], [130, 133966], [132, 134146], [135, 134226], [146, 134846], [148, 134966], [150, 135006], [153, 135126], [164, 136046], [168, 136346], [174, 136726], [179, 136946], [188, 137486], [199, 138146], [208, 138506], [217, 139006], [219, 139126], [226, 139426], [228, 139546], [231, 139626]]}, {"verse": 20, "start": 140823, "end": 145291, "text": "Porque cuando fuisteis siervos del pecado, erais libres acerca de la justicia.", "words": [[0, 140823], [7, 141023], [14, 141263], [23, 141803], [31, 142183], [35, 142343], [43, 143023], [49, 143483], [56, 143923], [63, 144203], [66, 144443], [69, 144523]]}, {"verse": 21, "start": 145741, "end": 151841, "text": "¿Qué fruto, pues, teníais de aquellas cosas de las cuales ahora os avergonzáis? porque el fin de ellas es muerte.", "words": [[0, 145741], [5, 145823], [12, 146243], [18, 146683], [26, 147123], [29, 147283], [38, 147683], [44, 147963], [47, 148183], [51, 148303], [58, 148523], [64, 148923], [67, 149103], [80, 150321], [87, 150503], [90, 150643], [94, 150803], [97, 150963], [103, 151083], [106, 151283]]}, {"verse": 22, "start": 152291, "end": 160001, "text": "Pero ahora, librados del pecado, y hechos siervos a Dios, tenéis por vuestro fruto la santificación, y por fin la vida eterna.", "words": [[0, 152291], [5, 152424], [12, 152684], [21, 153224], [25, 153404], [33, 153964], [35, 154304], [42, 154564], [50, 155004], [52, 155164], [58, 155924], [65, 156264], [69, 156424], [77, 156824], [83, 157184], [86, 157324], [101, 158104], [103, 158584], [107, 158744], [111, 159004], [114, 159164], [119, 159364]]}, {"verse": 23, "start": 160451, "end": 167707, "text": "Porque la paga del pecado es muerte: pero el regalo de Dios es vida eterna en Cristo Jesús Señor nuestro.", "words": [[0, 160451], [7, 160630], [10, 160870], [15, 161110], [19, 161230], [26, 161710], [29, 161950], [37, 162856], [42, 163013], [45, 163153], [52, 163533], [55, 163673], [60, 163953], [63, 164353], [68, 164653], [75, 165213], [78, 165353], [85, 166033], [91, 166793], [97, 167033]]}]}