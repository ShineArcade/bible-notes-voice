{"book": "1CO", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 125587, "verses": [{"verse": 1, "start": 300, "end": 7825, "text": "Así que, hermanos, cuando fui a vosotros, no fui con altivez de palabra, o de sabiduría, a anunciaros el testimonio de Cristo.", "words": [[0, 300], [4, 516], [9, 696], [19, 1236], [26, 1356], [30, 1656], [32, 1756], [42, 2276], [45, 2836], [49, 3056], [53, 3366], [61, 3676], [64, 3876], [73, 4296], [75, 4556], [78, 4676], [89, 5396], [91, 5816], [102, 6436], [105, 6596], [116, 7196], [119, 7276]]}, {"verse": 2, "start": 8275, "end": 13079, "text": "Porque no me propuse saber algo entre vosotros, sino a Jesucristo, y a este crucificado.", "words": [[0, 8275], [7, 8483], [10, 8663], [13, 8763], [21, 9223], [27, 9423], [32, 9743], [38, 9923], [48, 10503], [53, 10703], [55, 10883], [67, 11563], [69, 11923], [71, 12003], [76, 12203]]}, {"verse": 3, "start": 13529, "end": 17233, "text": "Y estuve yo con vosotros con debilidad, y mucho temor y temblor;", "words": [[0, 13529], [2, 13631], [9, 13951], [12, 14131], [16, 14331], [25, 14731], [29, 14931], [40, 15471], [42, 15891], [48, 16131], [54, 16571], [56, 16671]]}, {"verse": 4, "start": 17683, "end": 25018, "text": "Y ni mi palabra ni mi predicación fue con palabras persuasivas de humana sabiduría, sino con demostración del Espíritu y de poder;", "words": [[0, 17683], [2, 17825], [5, 17865], [8, 18025], [16, 18405], [19, 18625], [22, 18765], [34, 19665], [38, 19985], [42, 20165], [51, 20445], [63, 21205], [66, 21385], [73, 21685], [84, 22545], [89, 22785], [93, 22985], [106, 23625], [110, 23805], [119, 24345], [121, 24445], [124, 24525]]}, {"verse": 5, "start": 25468, "end": 30630, "text": "Para que vuestra fe no esté fundada en sabiduría de hombres, sino en poder de Dios.", "words": [[0, 25468], [5, 25624], [9, 25784], [17, 26204], [20, 26444], [23, 26624], [28, 26824], [36, 27424], [39, 27564], [49, 28184], [52, 28304], [61, 28924], [66, 29404], [69, 29584], [75, 29844], [78, 30104]]}, {"verse": 6, "start": 31080, "end": 38721, "text": "Pero hablamos sabiduría entre los maduros; y sabiduría, no de este siglo, ni de los príncipes de este siglo, que se deshacen:", "words": [[0, 31080], [5, 31222], [14, 31682], [24, 32342], [30, 32582], [34, 32782], [43, 33791], [45, 33895], [56, 34535], [59, 34715], [62, 34875], [67, 35075], [74, 35815], [77, 35935], [80, 36055], [84, 36195], [94, 36915], [97, 37115], [102, 37335], [109, 37735], [113, 37955], [116, 38095]]}, {"verse": 7, "start": 39171, "end": 47178, "text": "Pero hablamos sabiduría de Dios en misterio, la sabiduría oculta, la cual Dios predestinó antes de los siglos para nuestra gloria:", "words": [[0, 39171], [5, 39308], [14, 39668], [24, 40268], [27, 40388], [32, 40608], [35, 40808], [45, 41728], [48, 41808], [58, 42388], [66, 43308], [69, 43428], [74, 43648], [79, 44028], [90, 44948], [96, 45288], [99, 45488], [103, 45628], [110, 46028], [115, 46248], [123, 46468]]}, {"verse": 8, "start": 47628, "end": 55807, "text": "La que ninguno de los príncipes de este siglo conoció; porque si la hubieran conocido, nunca hubieran crucificado al Señor de gloria:", "words": [[0, 47628], [3, 47732], [7, 47852], [15, 48252], [18, 48352], [22, 48472], [32, 49112], [35, 49252], [40, 49472], [46, 49772], [55, 50842], [62, 51077], [65, 51317], [68, 51457], [77, 51817], [87, 52777], [93, 53217], [102, 53777], [114, 54657], [117, 54817], [123, 55077], [126, 55277]]}, {"verse": 9, "start": 56257, "end": 67105, "text": "Antes, como está escrito: Cosas que ojo no vio, ni oreja oyó, ni han subido en corazón de hombre, son las que ha Dios preparado para aquellos que le aman.", "words": [[0, 56257], [7, 56740], [12, 57160], [17, 57420], [26, 58386], [32, 58641], [36, 58941], [40, 59368], [43, 59794], [48, 60221], [51, 60441], [57, 61071], [62, 61701], [65, 61861], [69, 62001], [76, 62481], [79, 62601], [87, 62961], [90, 63221], [98, 64061], [102, 64221], [106, 64441], [110, 64661], [113, 64881], [118, 65101], [128, 65681], [133, 65921], [142, 66241], [146, 66501], [149, 66641]]}, {"verse": 10, "start": 67555, "end": 74441, "text": "Pero Dios nos lo reveló a nosotros por el Espíritu: porque el Espíritu todo lo escudriña, aun lo profundo de Dios.", "words": [[0, 67555], [5, 67693], [10, 67913], [14, 68173], [17, 68353], [24, 68813], [26, 68893], [35, 69253], [39, 69613], [42, 69733], [52, 70762], [59, 70980], [62, 71140], [71, 71660], [76, 71820], [79, 72020], [90, 72700], [94, 73040], [97, 73220], [106, 73740], [109, 73900]]}, {"verse": 11, "start": 74891, "end": 85272, "text": "Porque ¿quién de los hombres sabe las cosas del hombre, sino el espíritu del hombre que está en él? Así tampoco nadie conoció las cosas de Dios, sino el Espíritu de Dios.", "words": [[0, 74891], [7, 75131], [14, 75511], [17, 75691], [21, 75831], [29, 76131], [34, 76451], [38, 76631], [44, 76951], [48, 77191], [56, 77771], [61, 78151], [64, 78371], [73, 78971], [77, 79111], [84, 79391], [88, 79551], [93, 79771], [96, 79991], [100, 80606], [104, 80851], [112, 81211], [118, 81651], [126, 82171], [130, 82351], [136, 82631], [139, 82891], [145, 83651], [150, 83771], [153, 84011], [162, 84631], [165, 84731]]}, {"verse": 12, "start": 85722, "end": 95154, "text": "Y nosotros hemos recibido, no el espíritu del mundo, sino el Espíritu que es de Dios, para que conozcamos lo que Dios nos ha dado;", "words": [[0, 85722], [2, 85824], [11, 86064], [17, 86444], [27, 87184], [30, 87624], [33, 87804], [42, 88324], [46, 88464], [53, 89124], [58, 89404], [61, 89624], [70, 90164], [74, 90284], [77, 90444], [80, 90564], [86, 90824], [91, 91384], [95, 91524], [106, 92084], [109, 92304], [113, 92424], [118, 92664], [122, 92864], [125, 93044]]}, {"verse": 13, "start": 95604, "end": 104487, "text": "Lo cual también hablamos, no con doctas palabras de humana sabiduría, sino con doctrina del Espíritu, acomodando lo espiritual a lo espiritual.", "words": [[0, 95604], [3, 95742], [8, 95982],