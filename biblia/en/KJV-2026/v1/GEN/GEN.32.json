{"book": "GEN", "chapter": 32, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 246188, "verses": [{"verse": 1, "start": 300, "end": 3886, "text": "And Jacob went on his way, and the angels of God met him.", "words": [[0, 300], [4, 445], [10, 745], [15, 1045], [18, 1265], [22, 1465], [27, 2085], [31, 2345], [35, 2485], [42, 2825], [45, 3025], [49, 3285], [53, 3545]]}, {"verse": 2, "start": 4236, "end": 10338, "text": "And when Jacob saw them, he said, This is God’s host: and he called the name of that place Mahanaim.", "words": [[0, 4236], [4, 4377], [9, 4537], [15, 4857], [19, 5197], [25, 5597], [28, 5677], [34, 6333], [39, 6509], [42, 6669], [48, 7109], [54, 7826], [58, 7952], [61, 8052], [68, 8292], [72, 8492], [77, 8772], [80, 8932], [85, 9132], [91, 9759]]}, {"verse": 3, "start": 10688, "end": 16734, "text": "And Jacob sent messengers before him to Esau his brother to the land of Seir, the country of Edom.", "words": [[0, 10688], [4, 10814], [10, 11094], [15, 11374], [26, 11954], [33, 12334], [37, 12654], [40, 12814], [45, 13274], [49, 13474], [57, 13774], [60, 14014], [64, 14154], [69, 14414], [72, 14574], [78, 15454], [82, 15594], [90, 15914], [93, 16134]]}, {"verse": 4, "start": 17084, "end": 25559, "text": "And he commanded them, saying, Thus shall you speak to my lord Esau; Your servant Jacob says thus, I have sojourned with Laban, and stayed there until now:", "words": [[0, 17084], [4, 17191], [7, 17311], [17, 17731], [23, 18091], [31, 18581], [36, 18792], [42, 19072], [46, 19192], [52, 19412], [55, 19592], [58, 19752], [63, 19992], [69, 20879], [74, 20984], [82, 21324], [88, 21704], [93, 22004], [99, 22644], [101, 22784], [106, 22924], [116, 23444], [121, 23584], [128, 24244], [132, 24414], [139, 24584], [145, 24844], [151, 25104]]}, {"verse": 5, "start": 25909, "end": 34549, "text": "And I have oxen, and donkeys, flocks, and menservants, and womenservants: and I have sent to tell my lord, that I may find grace in your sight.", "words": [[0, 25909], [4, 26033], [6, 26193], [11, 26373], [17, 26913], [21, 27253], [30, 28093], [38, 28473], [42, 28843], [55, 29213], [59, 29863], [74, 30679], [78, 30839], [80, 30999], [85, 31159], [90, 31419], [93, 31619], [98, 31819], [101, 31979], [107, 32239], [112, 32439], [114, 32659], [118, 32839], [123, 33199], [129, 33579], [132, 33899], [137, 34019]]}, {"verse": 6, "start": 34829, "end": 42770, "text": "¶ And the messengers returned to Jacob, saying, We came to your brother Esau, and also he comes to meet you, and four hundred men with him.", "words": [[2, 34829], [6, 34977], [10, 35077], [21, 35537], [30, 36017], [33, 36237], [40, 36897], [48, 37639], [51, 37743], [56, 37983], [59, 38203], [64, 38323], [72, 38583], [78, 39243], [82, 39603], [87, 39883], [90, 40083], [96, 40303], [99, 40503], [104, 40683], [109, 40963], [113, 41210], [118, 41456], [126, 41703], [130, 42203], [135, 42463]]}, {"verse": 7, "start": 43050, "end": 51450, "text": "Then Jacob was greatly afraid and distressed: and he divided the people that was with him, and the flocks, and herds, and the camels, into two bands;", "words": [[0, 43050], [5, 43251], [11, 43571], [15, 43871], [23, 44231], [30, 44671], [34, 44891], [46, 45840], [50, 45964], [53, 46044], [61, 46424], [65, 46644], [72, 46924], [77, 47104], [81, 47264], [86, 47524], [91, 47764], [95, 48164], [99, 48244], [107, 48764], [111, 48964], [118, 49464], [122, 49624], [126, 49744], [134, 50284], [139, 50524], [143, 50764]]}, {"verse": 8, "start": 51800, "end": 58089, "text": "And said, If Esau come to the one company, and strike it, then the other company which is left shall escape.", "words": [[0, 51800], [4, 52077], [10, 52523], [13, 52680], [18, 53220], [23, 53460], [26, 53620], [30, 53720], [34, 53920], [43, 54280], [47, 54760], [54, 55100], [58, 55560], [63, 55720], [67, 55880], [73, 56040], [81, 56400], [87, 56600], [90, 56780], [95, 57040], [101, 57480]]}, {"verse": 9, "start": 58369, "end": 67914, "text": "¶ And Jacob said, O God of my father Abraham, and God of my father Isaac, the LORD which said to me, Return to your country, and to your kindred, and I will deal well with you:", "words": [[2, 58369], [6, 58516], [12, 58816], [18, 59518], [20, 59655], [24, 59875], [27, 60035], [30, 60195], [37, 60455], [46, 61035], [50, 61535], [54, 61735], [57, 61875], [60, 62035], [67, 62275], [74, 62755], [78, 63195], [83, 63415], [89, 63575], [94, 63795], [97, 63955], [101, 64115], [108, 64575], [111, 64835], [116, 64975], [125, 65375], [129, 65755], [132, 65915], [137, 66035], [146, 66765], [150, 66876], [152, 66976], [157, 67096], [162, 67276], [167, 67476], [172, 67696]]}, {"verse": 10, "start": 68264, "end": 78075, "text": "I am not worthy of the least of all the mercies, and of all the truth, which you have showed to your servant; for with my staff I passed over this Jordan; and now I am become two bands.", "words": [[0, 68264], [2, 68409], [5, 68529], [9, 68729], [16, 69049], [19, 69229], [23, 69329], [29, 69569], [32, 69769], [36, 69909], [40, 70029], [49, 70549], [53, 70769], [56, 70889], [60, 71129], [64, 71269], [71, 71549], [77, 72009], [81, 72169], [86, 72249], [93, 72489], [96, 72689], [101, 72789], [110, 73563], [114, 73657], [119, 73797], [122, 73957], [128, 74257], [130, 74437], [137, 74677], [142, 74917], [147, 75117], [155, 75809], [159, 75987], [163, 76287], [165, 76587], [168, 76707], [175, 77047], [179, 77427]]}, {"verse": 11, "start": 78425, "end": 86585, "text": "Deliver me, please, from the hand of my brother, from the hand of Esau: for I fear him, lest he will come and strike me, and the mother with the children.", "words": [[0, 78425], [8, 78764], [12, 78904], [20, 79464], [25, 79704], [29, 79864], [34, 80064], [37, 80164], [40, 80304], [49, 80984], [54, 81064], [58, 81204], [63, 81424], [66, 81544], [72, 82349], [76, 82472], [78, 82672], [83, 82932], [88, 83572], [93, 83832], [96, 83952], [101, 84092], [106, 84292], [110, 84552], [117, 84852], [121, 85132], [125, 85472], [129, 85592], [136, 85812], [141, 85992], [145, 86092]]}, {"verse": 12, "start": 86935, "end": 92981, "text": "And you said, I will surely do you good, and make your seed as the sand of the sea, which cannot be numbered for multitude.", "words": [[0, 86935], [4, 87041], [8, 87161], [14, 87441], [16, 87621], [21, 87721], [28, 88101], [31, 88321], [35, 88401], [41, 88701], [45, 89141], [50, 89321], [55, 89461], [60, 89761], [63, 89901], [67, 90081], [72, 90381], [75, 90501], [79, 90621], [84, 91081], [90, 91301], [97, 91581], [100, 91801], [109, 92101], [113, 92321]]}, {"verse": 13, "start": 93261, "end": 99751, "text": "¶ And he lodged there that same night; and took of that which came to his hand a present for Esau his brother;", "words": [[2, 93261], [6, 93399], [9, 93519], [16, 94059], [22, 94319], [27, 94519], [32, 94879], [39, 95650], [43, 95794], [48, 95994], [51, 96174], [56, 96374], [62, 96634], [67, 96894], [70, 97114], [74, 97294], [79, 97594], [81, 97774], [89, 98174], [93, 98474], [98, 99014], [102, 99174]]}, {"verse": 14, "start": 100101, "end": 105223, "text": "Two hundred she goats, and twenty he goats, two hundred ewes, and twenty rams,", "words": [[0, 100248], [4, 100394], [12, 100541], [16, 100801], [23, 101121], [27, 101571], [34, 102021], [37, 102201], [44, 102586], [48, 102971], [56, 103356], [62, 103741], [66, 104151], [73, 104561]]}, {"verse": 15, "start": 105573, "end": 111846, "text": "Thirty milk camels with their colts, forty cows, and ten bulls, twenty she donkeys, and ten foals.", "words": [[0, 105662], [7, 105782], [12, 106082], [19, 106602], [24, 106782], [30, 106942], [37, 107432], [43, 107922], [49, 108362], [53, 108672], [57, 108982], [64, 109379], [71, 109777], [75, 109997], [84, 110517], [88, 110827], [92, 111137]]}, {"verse": 16, "start": 112196, "end": 121776, "text": "And he delivered them into the hand of his servants, every drove by themselves; and said to his servants, Pass over before me, and put a space between drove and drove.", "words": [[0, 112196], [4, 112315], [7, 112395], [17, 112715], [22, 112995], [27, 113175], [31, 113315], [36, 113535], [39, 113655], [43, 113775], [53, 114655], [59, 114955], [65, 115275], [68, 115535], [80, 116591], [84, 116718], [89, 116918], [92, 117138], [96, 117298], [106, 118093], [111, 118322], [116, 118682], [123, 119042], [127, 119342], [131, 119762], [135, 119942], [137, 120042], [143, 120422], [151, 120762], [157, 121162], [161, 121422]]}, {"verse": 17, "start": 122056, "end": 130806, "text": "And he commanded the foremost, saying, When Esau my brother meets you, and asks you, saying, Whose are you? and where are you going? and whose are these before you?", "words": [[0, 122056], [4, 122176], [7, 122296], [17, 122756], [21, 122936], [31, 123696], [39, 124493], [44, 124633], [49, 125153], [52, 125233], [60, 125613], [66, 125773], [71, 126033], [75, 126253], [80, 126553], [85, 126793], [93, 126940], [99, 127088], [103, 127236], [108, 128109], [112, 128409], [118, 128609], [122, 128749], [126, 128829], [133, 129519], [137, 129678], [143, 129878], [147, 129978], [153, 130098], [160, 130458]]}, {"verse": 18, "start": 131156, "end": 137581, "text": "Then you shall say, They are your servant Jacob’s; it is a present sent to my lord Esau: and, behold, also he is behind us.", "words": [[0, 131156], [5, 131260], [9, 131380], [15, 131560], [20, 131800], [25, 131980], [29, 132100], [34, 132200], [42, 132500], [51, 133350], [54, 133456], [57, 133576], [59, 133656], [67, 133936], [72, 134236], [75, 134396], [78, 134536], [83, 134776], [89, 135572], [94, 135729], [102, 136029], [107, 136589], [110, 136809], [113, 136889], [120, 137189]]}, {"verse": 19, "start": 137861, "end": 146182, "text": "And so commanded he the second, and the third, and all that followed the droves, saying, On this manner shall you speak to Esau, when you find him.", "words": [[0, 137861], [4, 138013], [7, 138213], [17, 138673], [20, 138933], [24, 139113], [32, 139453], [36, 139713], [40, 139853], [47, 140473], [51, 140673], [55, 140893], [60, 141153], [69, 141513], [73, 141733], [81, 142413], [89, 143183], [92, 143342], [97, 143622], [104, 143902], [110, 144062], [114, 144222], [120, 144402], [123, 144602], [129, 145082], [134, 145442], [138, 145582], [143, 145802]]}, {"verse": 20, "start": 146532, "end": 157998, "text": "And say you moreover, Behold, your servant Jacob is behind us. For he said, I will appease him with the present that goes before me, and afterward I will see his face; perhaps he will accept of me.", "words": [[0, 146532], [4, 146653], [8, 146873], [12, 147033], [22, 147853], [30, 148093], [35, 148433], [43, 148693], [49, 149013], [52, 149313], [59, 149613], [63, 150350], [67, 150508], [70, 150668], [76, 151415], [78, 151553], [83, 151713], [91, 152153], [95, 152273], [100, 152413], [104, 152553], [112, 152833], [117, 153053], [122, 153253], [129, 153613], [133, 154213], [137, 154353], [147, 154813], [149, 155173], [154, 155333], [158, 155533], [162, 155713], [168, 156512], [176, 156813], [179, 157073], [184, 157193], [191, 157473], [194, 157673]]}, {"verse": 21, "start": 158278, "end": 163468, "text": "So went the present over before him: and himself lodged that night in the company.", "words": [[0, 158278], [3, 158478], [8, 158758], [12, 158918], [20, 159298], [25, 159678], [32, 160078], [37, 160816], [41, 160963], [49, 161403], [56, 162003], [61, 162223], [67, 162523], [70, 162743], [74, 162843]]}, {"verse": 22, "start": 163818, "end": 171152, "text": "And he rose up that night, and took his two wives, and his two womenservants, and his eleven sons, and passed over the ford Jabbok.", "words": [[0, 163818], [4, 163942], [7, 164062], [12, 164262], [15, 164542], [20, 164782], [27, 165062], [31, 165322], [36, 165502], [40, 165722], [44, 165922], [51, 166362], [55, 166622], [59, 166782], [63, 167232], [78, 167682], [82, 168202], [86, 168342], [93, 168682], [99, 169182], [103, 169507], [110, 169807], [115, 170087], [119, 170450], [124, 170813]]}, {"verse": 23, "start": 171502, "end": 175865, "text": "And he took them, and sent them over the brook, and sent over that he had.", "words": [[0, 171502], [4, 171633], [7, 171753], [12, 172013], [18, 172273], [22, 172673], [27, 172933], [32, 173133], [37, 173353], [41, 173493], [48, 173973], [52, 174393], [57, 174653], [62, 174933], [67, 175173], [70, 175333]]}, {"verse": 24, "start": 176215, "end": 181947, "text": "¶ And Jacob was left alone; and there wrestled a man with him until the breaking of the day.", "words": [[2, 176215], [6, 176555], [12, 176895], [16, 177215], [21, 177455], [28, 178370], [32, 178793], [38, 178953], [47, 179253], [49, 179553], [53, 179833], [58, 180093], [62, 180293], [68, 180573], [72, 180753], [81, 181093], [84, 181333], [88, 181453]]}, {"verse": 25, "start": 182297, "end": 190795, "text": "And when he saw that he prevailed not against him, he touched the hollow of his thigh; and the hollow of Jacob’s thigh was out of joint, as he wrestled with him.", "words": [[0, 182297], [4, 182429], [9, 182569], [12, 182729], [16, 182989], [21, 183189], [24, 183269], [34, 183769], [38, 183969], [46, 184369], [51, 184949], [54, 185069], [62, 185409], [66, 185629], [73, 185869], [76, 186089], [80, 186249], [87, 187057], [91, 187173], [95, 187293], [102, 187553], [105, 187773], [113, 188313], [119, 188513], [123, 188713], [127, 188893], [130, 188993], [137, 189333], [140, 189753], [143, 189893], [152, 190333], [157, 190513]]}, {"verse": 26, "start": 191145, "end": 198762, "text": "And he said, Let me go, for the day breaks. And he said, I will not let you go, unless you bless me.", "words": [[0, 191145], [4, 191280], [7, 191420], [13, 192829], [17, 193008], [20, 193128], [24, 193308], [28, 193528], [32, 193668], [36, 193888], [44, 194731], [48, 194865], [51, 195005], [57, 196414], [59, 196558], [64, 196698], [68, 196878], [72, 197118], [76, 197278], [80, 197578], [87, 197958], [91, 198218], [97, 198418]]}, {"verse": 27, "start": 199042, "end": 203702, "text": "And he said to him, What is your name? And he said, Jacob.", "words": [[0, 199042], [4, 199168], [7, 199268], [12, 199488], [15, 199688], [20, 200290], [25, 200458], [28, 200618], [33, 200758], [39, 201529], [43, 201664], [46, 201804], [52, 203213]]}, {"verse": 28, "start": 203982, "end": 212560, "text": "And he said, Your name shall be called no more Jacob, but Israel: for as a prince have you power with God and with men, and have prevailed.", "words": [[0, 203982], [4, 204117], [7, 204257], [13, 205666], [18, 205845], [23, 206125], [29, 206365], [32, 206525], [39, 206845], [42, 207145], [47, 207345], [54, 208125], [58, 208225], [66, 208939], [70, 209026], [73, 209186], [75, 209286], [82, 209486], [87, 209706], [91, 209826], [97, 210146], [102, 210406], [106, 210646], [110, 210886], [115, 211046], [120, 211306], [124, 211726], [129, 211866]]}, {"verse": 29, "start": 212840, "end": 222353, "text": "And Jacob asked him, and said, Tell me, please, your name. And he said, Why is it that you do ask after my name? And he blessed him there.", "words": [[0, 212840], [4, 212963], [10, 213263], [16, 213703], [21, 213943], [25, 214163], [31, 215044], [36, 215197], [40, 215377], [48, 216017], [53, 216117], [59, 216834], [63, 216969], [66, 217109], [72, 218517], [76, 218754], [79, 219014], [82, 219154], [87, 219274], [91, 219414], [94, 219534], [98, 219854], [104, 220214], [107, 220454], [113, 221181], [117, 221330], [120, 221410], [128, 221650], [132, 221910]]}, {"verse": 30, "start": 222703, "end": 229298, "text": "And Jacob called the name of the place Peniel: for I have seen God face to face, and my life is preserved.", "words": [[0, 222703], [4, 222847], [10, 223127], [17, 223467], [21, 223667], [26, 223907], [29, 224047], [33, 224167], [39, 224447], [47, 225551], [51, 225656], [53, 225856], [58, 226096], [63, 226376], [67, 226676], [72, 227016], [75, 227216], [81, 227816], [85, 228096], [88, 228216], [93, 228476], [96, 228616]]}, {"verse": 31, "start": 229578, "end": 234602, "text": "And as he passed over Penuel the sun rose upon him, and he halted upon his thigh.", "words": [[0, 229578], [4, 229708], [7, 229908], [10, 230028], [17, 230368], [22, 230628], [29, 231348], [33, 231448], [37, 231728], [42, 232028], [47, 232348], [52, 232988], [56, 233108], [59, 233208], [66, 233548], [71, 233748], [75, 234028]]}, {"verse": 32, "start": 234952, "end": 245788, "text": "Therefore the children of Israel eat not of the sinew which shrank, which is upon the hollow of the thigh, to this day: because he touched the hollow of Jacob’s thigh in the sinew that shrank.", "words": [[0, 234952], [10, 235231], [14, 235491], [23, 235831], [26, 236011], [33, 236411], [37, 236751], [41, 237031], [44, 237231], [48, 237391], [54, 237831], [60, 238271], [68, 238711], [74, 238951], [77, 239071], [82, 239311], [86, 239591], [93, 239831], [96, 240071], [100, 240211], [107, 240611], [110, 240871], [115, 241091], [120, 241806], [128, 242031], [131, 242271], [139, 242571], [143, 242791], [150, 243031], [153, 243271], [161, 243771], [167, 244051], [170, 244431], [174, 244571], [180, 245031], [185, 245171]]}]}