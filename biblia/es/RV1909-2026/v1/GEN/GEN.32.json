{"book": "GEN", "chapter": 32, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 257883, "verses": [{"verse": 1, "start": 300, "end": 5465, "text": "Y Jacob se fue su camino, y le salieron al encuentro ángeles de Dios.", "words": [[0, 519], [2, 773], [8, 1026], [11, 1106], [15, 1326], [18, 1506], [26, 2006], [28, 2746], [31, 2866], [40, 3426], [43, 3606], [53, 4206], [61, 4686], [64, 4866]]}, {"verse": 2, "start": 5815, "end": 13476, "text": "Y dijo Jacob cuando los vio: El campo de Dios es este: y llamó el nombre de aquel lugar Mahanaim.", "words": [[0, 5815], [2, 5960], [7, 6240], [13, 6660], [20, 7100], [24, 7540], [29, 8142], [32, 8260], [38, 8580], [41, 8780], [46, 9060], [49, 9460], [55, 10379], [57, 10486], [63, 10846], [66, 10946], [73, 11306], [76, 11526], [82, 11906], [88, 12186]]}, {"verse": 3, "start": 13826, "end": 21088, "text": "Y envió Jacob mensajeros delante de sí a Esaú su hermano, a la tierra de Seir, campo de Edom.", "words": [[0, 13826], [2, 13970], [8, 14350], [14, 15050], [25, 15750], [33, 16250], [36, 16430], [39, 16870], [41, 17170], [46, 17470], [49, 17590], [58, 18390], [60, 18490], [63, 18570], [70, 18910], [73, 19380], [79, 19850], [85, 20250], [88, 20510]]}, {"verse": 4, "start": 21438, "end": 29593, "text": "Y les mandó diciendo: Así diréis a mi señor Esaú: Así dice tu siervo Jacob: Con Labán he morado, y me he detenido hasta ahora;", "words": [[0, 21438], [2, 21726], [6, 21866], [12, 22306], [22, 23310], [26, 23491], [33, 23891], [35, 24161], [38, 24431], [44, 24701], [50, 25139], [54, 25321], [59, 25601], [62, 25761], [69, 26226], [76, 26944], [80, 27074], [86, 27204], [89, 27334], [97, 27794], [99, 28134], [102, 28314], [105, 28394], [114, 28894], [120, 29134]]}, {"verse": 5, "start": 29943, "end": 37220, "text": "Y tengo vacas, y asnos, y ovejas, y siervos y siervas; y envío a decirlo a mi señor, por hallar gracia en tus ojos.", "words": [[0, 29943], [2, 30032], [8, 30252], [15, 30732], [17, 30872], [24, 31252], [26, 31472], [34, 31912], [36, 32112], [44, 32512], [46, 32692], [55, 33566], [57, 33668], [63, 34048], [65, 34148], [73, 34648], [75, 34748], [78, 34848], [85, 35568], [89, 35708], [96, 35988], [103, 36388], [106, 36468], [110, 36588]]}, {"verse": 6, "start": 37500, "end": 45403, "text": "Y los mensajeros volvieron a Jacob, diciendo: Vinimos a tu hermano Esaú, y él también viene a recibirte, y cuatrocientos hombres con él.", "words": [[0, 37500], [2, 37604], [6, 37704], [17, 38284], [27, 38824], [29, 39044], [36, 39444], [46, 39916], [54, 40335], [56, 40475], [59, 40575], [67, 40975], [73, 41395], [75, 41915], [78, 42055], [86, 42355], [92, 42695], [94, 42855], [105, 43495], [107, 43785], [121, 44075], [129, 44795], [133, 45135]]}, {"verse": 7, "start": 45683, "end": 55655, "text": "Entonces Jacob tuvo gran temor, y se angustió; y partió el pueblo que tenía consigo, y las ovejas y las vacas y los camellos, en dos cuadrillas;", "words": [[0, 45683], [9, 46587], [15, 46930], [20, 47350], [25, 47730], [32, 48150], [34, 48350], [37, 48490], [47, 49551], [49, 49661], [56, 50061], [59, 50201], [66, 50541], [70, 50841], [76, 51181], [85, 51801], [87, 52006], [91, 52146], [98, 52706], [100, 52966], [104, 53106], [110, 53526], [112, 53646], [116, 53786], [126, 54406], [129, 54586], [133, 54786]]}, {"verse": 8, "start": 56005, "end": 61433, "text": "Y dijo: Si viene Esaú contra un campamento y lo ataca, el otro campamento escapará.", "words": [[0, 56005], [2, 56149], [8, 56867], [11, 57103], [17, 57343], [22, 57583], [29, 57843], [32, 58043], [43, 58643], [45, 58763], [48, 58863], [55, 59703], [58, 59803], [63, 59983], [74, 60663]]}, {"verse": 9, "start": 61713, "end": 70658, "text": "Y dijo Jacob: Dios de mi padre Abraham, y Dios de mi padre Isaac, Jehová, que me dijiste: Vuélvete a tu tierra y a tu parentela, y yo te haré bien;", "words": [[0, 61713], [2, 61841], [7, 62081], [14, 62845], [19, 63067], [22, 63247], [25, 63347], [31, 63727], [40, 64107], [42, 64362], [47, 64562], [50, 64722], [53, 64822], [59, 65222], [66, 65862], [74, 66462], [78, 66522], [81, 66642], [90, 67481], [99, 67966], [101, 68066], [104, 68186], [111, 68486], [113, 68706], [115, 68786], [118, 68886], [129, 69486], [131, 69886], [134, 70006], [137, 70126], [142, 70346]]}, {"verse": 10, "start": 71008, "end": 80982, "text": "Menor soy que todas las misericordias, y que toda la verdad que has usado para con tu siervo; que con mi bastón pasé este Jordán, y ahora estoy sobre dos cuadrillas.", "words": [[0, 71008], [6, 71247], [10, 71527], [14, 71687], [20, 71907], [24, 72147], [39, 73087], [41, 73507], [45, 73627], [50, 73887], [53, 74067], [60, 74327], [64, 74647], [68, 74747], [74, 75127], [79, 75367], [83, 75607], [86, 75727], [94, 76496], [98, 76592], [102, 76772], [105, 76932], [112, 77352], [117, 77752], [122, 77932], [130, 78372], [132, 78912], [138, 79212], [144, 79552], [150, 79872], [154, 80132]]}, {"verse": 11, "start": 81332, "end": 88335, "text": "Líbrame ahora de la mano de mi hermano, de la mano de Esaú, porque le temo; no venga quizá, y me hiera la madre con los hijos.", "words": [[0, 81332], [8, 81756], [14, 81976], [17, 82156], [20, 82276], [25, 82496], [28, 82656], [31, 82776], [40, 83516], [43, 83596], [46, 83696], [51, 83896], [54, 84296], [60, 84696], [67, 84856], [70, 85036], [76, 85765], [79, 85865], [85, 86145], [92, 86795], [94, 86935], [97, 87055], [103, 87315], [106, 87415], [112, 87675], [116, 87875], [120, 88075]]}, {"verse": 12, "start": 88685, "end": 97069, "text": "Y tú has dicho: Yo te haré bien, y pondré tu simiente como la arena del mar, que no se puede contar por la multitud.", "words": [[0, 88745], [2, 89030], [5, 89190], [9, 89330], [16, 91800], [19, 91945], [22, 92105], [27, 92345], [33, 92565], [35, 92925], [42, 93325], [45, 93485], [54, 94005], [59, 94285], [62, 94465], [68, 94705], [72, 94905], [77, 95105], [81, 95325], [84, 95465], [87, 95625], [93, 95825], [100, 96165], [104, 96385], [107, 96525]]}, {"verse": 13, "start": 97349, "end": 103461, "text": "Y durmió allí aquella noche, y tomó de lo que le vino a la mano un presente para su hermano Esaú:", "words": [[0, 97349], [2, 97475], [9, 97975], [14, 98255], [22, 98715], [29, 99075], [31, 99715], [36, 100135], [39, 100215], [42, 100355], [46, 100495], [49, 100615], [54, 100875], [56, 101055], [59, 101135], [64, 101375], [67, 101535], [76, 101915], [81, 102375], [84, 102575], [92, 103045]]}, {"verse": 14, "start": 103811, "end": 109193, "text": "Doscientas cabras y veinte machos cabríos, doscientas ovejas y veinte carneros,", "words": [[0, 103811], [11, 103811], [18, 104353], [20, 104813], [27, 105193], [34, 105933], [43, 106673], [54, 107333], [61, 107853], [63, 108133], [70, 108453]]}, {"verse": 15, "start": 109543, "end": 115848, "text": "Treinta camellas paridas, con sus hijos, cuarenta vacas y diez novillos, veinte asnas y diez borricos.", "words": [[0, 109829], [8, 110149], [17, 110469], [26, 110889], [30, 111109], [34, 111329], [41, 111909], [50, 112489], [56, 113009], [58, 113169], [63, 113329], [73, 113889], [80, 114449], [86, 115109], [88, 115377], [93, 115644]]}, {"verse": 16, "start": 116198, "end": 126205, "text": "Y lo entregó en mano de sus siervos, cada manada de por sí; y dijo a sus siervos: Pasad delante de mí, y poned espacio entre manada y manada.", "words": [[0, 116665], [2, 116925], [5, 117025], [13, 117505], [16, 117605], [21, 117825], [24, 117985], [28, 118475], [37, 118965], [42, 119285], [49, 119785], [52, 119965], [56, 120165], [60, 120780], [62, 120956], [67, 121166], [69, 121326], [73, 121466], [82, 122603], [88, 122763], [96, 123223], [99, 123383], [103, 123543], [105, 123970], [111, 124396], [119, 124823], [125, 125043], [132, 125483], [134, 125683]]}, {"verse": 17, "start": 126485, "end": 137214, "text": "Y mandó al primero, diciendo: Si Esaú mi hermano te encuentra, y te pregunta, diciendo: ¿De quién eres? ¿y adónde vas? ¿y para quién es esto que llevas delante de ti?", "words": [[0, 126485], [2, 126626], [8, 126906], [11, 127186], [20, 127586], [30, 128705], [33, 128924], [38, 129178], [41, 129431], [49, 129811], [52, 129911], [63, 130371], [65, 130531], [68, 130651], [78, 131171], [88, 132464], [92, 132622], [98, 132822], [104, 133581], [107, 133758], [114, 134038], [119, 134732], [122, 134814], [127, 134994], [133, 135234], [136, 135454], [141, 135754], [145, 135894], [152, 136254], [160, 136674], [163, 136854]]}, {"verse": 18, "start": 137564, "end": 144871, "text": "Entonces dirás: Es un regalo de tu siervo Jacob, que envía a mi señor Esaú; y he aquí también él viene tras nosotros.", "words": [[0, 137564], [9, 137999], [16, 138939], [19, 139064], [22, 139184], [29, 139584], [32, 139704], [35, 139844], [42, 140264], [49, 140584], [53, 140924], [59, 141284], [61, 141364], [64, 141444], [70, 141764], [76, 142555], [78, 142606], [81, 142696], [86, 142916], [94, 143256], [97, 143616], [103, 143836], [108, 144116]]}, {"verse": 19, "start": 145151, "end": 155948, "text": "Y mandó también al segundo, y al tercero, y a todos los que iban tras aquellas manadas, diciendo: Conforme a esto hablaréis a Esaú, cuando lo encontréis.", "words": [[0, 145151], [2, 145314], [8, 145674], [16, 146094], [19, 146414], [28, 147014], [30, 147419], [33, 147599], [42, 148519], [44, 148799], [46, 148879], [52, 149199], [56, 149519], [60, 149739], [65, 150079], [70, 150279], [79, 150839], [88, 151359], [98, 152926], [107, 153287], [109, 153427], [114, 153667], [124, 154187], [126, 154327], [132, 154627], [139, 154987], [142, 155187]]}, {"verse": 20, "start": 156298, "end": 167669, "text": "Y diréis también: He aquí tu siervo Jacob viene tras nosotros. Porque dijo: Apaciguaré su ira con el regalo que va delante de mí, y después veré su rostro: quizá me reciba bien.", "words": [[0, 156298], [2, 156398], [9, 156718], [18, 157613], [21, 157693], [26, 157893], [29, 158093], [36, 158453], [42, 158753], [48, 159153], [53, 159433], [63, 160561], [70, 160731], [76, 161771], [87, 162091], [90, 162231], [94, 162511], [98, 162671], [101, 162811], [108, 163191], [112, 163331], [115, 163471], [123, 163891], [126, 164051], [130, 164251], [132, 164711], [140, 165011], [145, 165471], [148, 165551], [156, 166360], [162, 166744], [165, 166844], [172, 167304]]}, {"verse": 21, "start": 167949, "end": 174168, "text": "Y pasó el presente delante de él; y él durmió aquella noche en el campamento.", "words": [[0, 167949], [2, 168099], [7, 168519], [10, 168879], [19, 169439], [27, 170119], [30, 170319], [34, 171035], [36, 171457], [39, 171577], [46, 172037], [54, 172497], [60, 172957], [63, 173097], [66, 173217]]}, {"verse": 22, "start": 174518, "end": 183401, "text": "Y se levantó aquella noche, y tomó sus dos mujeres, y sus dos siervas, y sus once hijos, y pasó el vado de Jaboc.", "words": [[0, 174518], [2, 174642], [5, 174762], [13, 175342], [21, 175682], [28, 176662], [30, 177002], [35, 177342], [39, 177522], [43, 177702], [52, 178182], [54, 178522], [58, 178662], [62, 178882], [71, 179502], [73, 179882], [77, 180042], [82, 180502], [89, 180902], [91, 181562], [96, 181922], [99, 182322], [104, 182682], [107, 183074]]}, {"verse": 23, "start": 183751, "end": 188773, "text": "Los tomó pues, y los hizo pasar el arroyo, e hizo pasar lo que tenía.", "words": [[0, 183751], [4, 183899], [9, 184259], [15, 184679], [17, 185019], [21, 185199], [26, 185499], [32, 185879], [35, 186099], [43, 187019], [45, 187199], [50, 187439], [56, 187719], [59, 187979], [63, 188119]]}, {"verse": 24, "start": 189123, "end": 194242, "text": "Y se quedó Jacob solo, y luchó con él un varón hasta que rayaba el alba.", "words": [[0, 189123], [2, 189270], [5, 189350], [11, 189690], [17, 189970], [23, 190490], [25, 191070], [31, 191470], [35, 191650], [38, 191830], [41, 192050], [47, 192550], [53, 192810], [57, 192990], [64, 193490], [67, 193650]]}, {"verse": 25, "start": 194592, "end": 203460, "text": "Y cuando vio que no podía con él, tocó en la coyuntura de su cadera, y se dislocó la cadera de Jacob mientras con él luchaba.", "words": [[0, 194592], [2, 194718], [9, 194958], [13, 195338], [17, 195498], [20, 195658], [26, 196038], [30, 196318], [34, 196918], [39, 197258], [42, 197418], [45, 197558], [55, 198198], [58, 198358], [61, 198518], [69, 198998], [71, 199478], [74, 199958], [82, 200438], [85, 200578], [92, 200998], [95, 201118], [101, 201518], [110, 202118], [114, 202538], [117, 202678]]}, {"verse": 26, "start": 203810, "end": 209346, "text": "Y dijo: Déjame, que raya el alba. Y él dijo: No te dejaré, si no me bendices.", "words": [[0, 203810], [2, 203954], [8, 204698], [16, 205075], [20, 205255], [25, 205655], [28, 205775], [34, 206454], [36, 206642], [39, 206802], [45, 207521], [48, 207702], [51, 207862], [59, 208302], [62, 208422], [65, 208502], [68, 208622]]}, {"verse": 27, "start": 209626, "end": 213830, "text": "Y él le dijo: ¿Cuál es tu nombre? Y él respondió: Jacob.", "words": [[0, 209626], [2, 209793], [5, 209933], [8, 210093], [14, 210818], [20, 211019], [23, 211159], [26, 211279], [34, 212056], [36, 212237], [39, 212377], [50, 213609]]}, {"verse": 28, "start": 214110, "end": 221525, "text": "Y él dijo: No se dirá más tu nombre Jacob, sino Israel: porque has peleado con Dios y con los hombres, y has vencido.", "words": [[0, 214110], [2, 214298], [5, 214458], [11, 215177], [14, 215314], [17, 215434], [22, 215734], [26, 215854], [29, 216074], [36, 216434], [43, 217154], [48, 217314], [56, 218232], [63, 218411], [67, 218591], [75, 219071], [79, 219271], [84, 219511], [86, 219751], [90, 219891], [94, 220031], [103, 220411], [105, 220711], [109, 220871]]}, {"verse": 29, "start": 221805, "end": 230587, "text": "Entonces Jacob le preguntó, y dijo: Dime ahora tu nombre. Y él respondió: ¿Por qué preguntas por mi nombre? Y lo bendijo allí.", "words": [[0, 221805], [9, 222550], [15, 222810], [18, 223170], [28, 223810], [30, 223990], [36, 224651], [41, 224908], [47, 225128], [50, 225328], [58, 226116], [60, 226298], [63, 226438], [74, 227432], [79, 227593], [83, 227713], [93, 228153], [97, 228473], [100, 228613], [108, 229356], [110, 229465], [113, 229605], [121, 230105]]}, {"verse": 30, "start": 230937, "end": 237935, "text": "Y llamó Jacob el nombre de aquel lugar, Peniel: porque vi a Dios cara a cara, y fue librada mi alma.", "words": [[0, 230937], [2, 231045], [8, 231405], [14, 231625], [17, 231965], [24, 232305], [27, 232525], [33, 232885], [40, 233585], [48, 234487], [55, 235323], [58, 235519], [60, 235659], [65, 235879], [70, 236179], [72, 236339], [78, 236599], [80, 236784], [84, 236964], [92, 237364], [95, 237524]]}, {"verse": 31, "start": 238215, "end": 243190, "text": "Y le salió el sol después que hubo pasado Peniel; y cojeaba de su cadera.", "words": [[0, 238215], [2, 238342], [5, 238442], [11, 238842], [14, 239022], [18, 239242], [26, 239662], [30, 239902], [35, 240122], [42, 240462], [50, 241328], [52, 241785], [60, 242245], [63, 242405], [66, 242545]]}, {"verse": 32, "start": 243540, "end": 257483, "text": "Por esto no comen los hijos de Israel, hasta hoy día, del tendón que se contrajo, el cual está en el encaje del muslo: porque tocó a Jacob este sitio de su muslo en el tendón que se contrajo.", "words": [[0, 243540], [4, 243683], [9, 243903], [12, 244143], [18, 244463], [22, 244703], [28, 245043], [31, 245203], [39, 245763], [45, 246243], [49, 246603], [54, 247123], [58, 247763], [65, 248283], [69, 248403], [72, 248563], [82, 249303], [85, 249963], [90, 250203], [95, 250643], [98, 250903], [101, 251063], [108, 251703], [112, 251863], [119, 252782], [126, 252966], [131, 253486], [133, 253586], [139, 253926], [144, 254326], [150, 254766], [153, 254946], [156, 255106], [162, 255606], [165, 255846], [168, 255986], [175, 256406], [179, 256566], [182, 256686]]}]}