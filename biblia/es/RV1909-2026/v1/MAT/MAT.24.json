{"book": "MAT", "chapter": 24, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 392335, "verses": [{"verse": 1, "start": 300, "end": 8087, "text": "Y salido Jesús, se iba del templo; y se llegaron sus discípulos, para mostrarle los edificios del templo.", "words": [[0, 300], [2, 422], [9, 842], [16, 1162], [19, 1582], [23, 1802], [27, 2022], [35, 3062], [37, 3188], [40, 3268], [49, 3728], [53, 3988], [65, 4908], [70, 5428], [80, 6268], [84, 6448], [94, 7228], [98, 7408]]}, {"verse": 2, "start": 8537, "end": 19663, "text": "Y respondiendo él, les dijo: ¿Veis todo esto? de cierto os digo, que no será dejada aquí piedra sobre piedra, que no sea destruida.", "words": [[0, 8537], [2, 8745], [15, 9485], [19, 9925], [23, 10365], [29, 11420], [35, 11770], [40, 11970], [46, 13013], [49, 13266], [56, 13552], [59, 13838], [65, 14699], [69, 14939], [72, 15099], [77, 15358], [84, 15978], [89, 16259], [96, 16778], [102, 17038], [110, 18118], [114, 18178], [117, 18358], [121, 18618]]}, {"verse": 3, "start": 20113, "end": 32613, "text": "Y sentándose él en el monte de los Olivos, se llegaron a él los discípulos aparte, diciendo: Dinos, ¿cuándo serán estas cosas, y qué señal habrá de tu venida, y del fin del mundo?", "words": [[0, 20113], [2, 20237], [13, 21217], [16, 21657], [19, 21937], [22, 22257], [28, 22577], [31, 22737], [35, 22917], [43, 23757], [46, 24057], [55, 24577], [57, 24697], [60, 24897], [64, 25077], [75, 25717], [83, 26757], [93, 27907], [100, 28203], [108, 28623], [114, 28963], [120, 29123], [127, 29583], [129, 30063], [133, 30203], [139, 30583], [145, 30823], [148, 30883], [151, 31003], [159, 31443], [161, 31643], [165, 31803], [169, 31963], [173, 32123]]}, {"verse": 4, "start": 32963, "end": 37514, "text": "Y respondiendo Jesús, les dijo: Mirad que nadie os engañe.", "words": [[0, 32963], [2, 33084], [15, 33884], [22, 34244], [26, 34604], [32, 35494], [38, 35941], [42, 36141], [48, 36501], [51, 36781]]}, {"verse": 5, "start": 37964, "end": 44610, "text": "Porque vendrán muchos en mi nombre, diciendo: Yo soy el Cristo; y a muchos engañarán.", "words": [[0, 37964], [7, 38166], [15, 38706], [22, 39046], [25, 39346], [28, 39506], [36, 39866], [46, 41114], [49, 41470], [53, 41690], [56, 41910], [64, 43030], [66, 43155], [68, 43235], [75, 43735]]}, {"verse": 6, "start": 45060, "end": 55162, "text": "Y oiréis guerras, y rumores de guerras: mirad que no os turbéis; porque es necesario que todo esto acontezca; pero aún no es el fin.", "words": [[0, 45060], [2, 45224], [9, 45664], [18, 46184], [20, 46584], [28, 47144], [31, 47324], [40, 48344], [46, 48789], [50, 49009], [53, 49249], [56, 49409], [65, 50622], [72, 50772], [75, 50852], [85, 51432], [89, 51652], [94, 51852], [99, 52296], [110, 53039], [115, 53305], [119, 53705], [122, 54065], [125, 54325], [128, 54485]]}, {"verse": 7, "start": 55612, "end": 64023, "text": "Porque se levantará nación contra nación, y reino contra reino; y habrá pestes, y hambres, y terremotos por los lugares.", "words": [[0, 55612], [7, 55795], [10, 55955], [20, 56535], [27, 56955], [34, 57355], [42, 57835], [44, 58275], [50, 58815], [57, 59195], [64, 60317], [66, 60441], [72, 60811], [80, 61181], [82, 61491], [91, 61801], [93, 62241], [104, 62921], [108, 63101], [112, 63261]]}, {"verse": 8, "start": 64473, "end": 67849, "text": "Y todas estas cosas, principio de dolores.", "words": [[0, 64473], [2, 64574], [8, 64754], [14, 65134], [21, 65994], [31, 66674], [34, 67014]]}, {"verse": 9, "start": 68299, "end": 77595, "text": "Entonces os entregarán para ser afligidos, y os matarán; y seréis aborrecidos de todas las gentes por causa de mi nombre.", "words": [[0, 68299], [9, 69205], [12, 69325], [23, 70165], [28, 70345], [32, 70585], [43, 71305], [45, 71485], [48, 71605], [57, 72642], [59, 72745], [66, 73395], [78, 74045], [81, 74205], [87, 74665], [91, 75125], [98, 75645], [102, 76105], [108, 76465], [111, 76765], [114, 76885]]}, {"verse": 10, "start": 78045, "end": 87104, "text": "Y muchos entonces serán escandalizados; y se entregarán unos a otros, y unos a otros se aborrecerán.", "words": [[0, 78045], [2, 78173], [9, 78513], [18, 79273], [24, 80133], [40, 81699], [42, 82045], [45, 82165], [56, 82965], [61, 83245], [63, 83605], [70, 84425], [72, 84805], [77, 85045], [79, 85265], [85, 85585], [88, 86105]]}, {"verse": 11, "start": 87554, "end": 92198, "text": "Y muchos falsos profetas se levantarán y engañarán a muchos.", "words": [[0, 87554], [2, 87676], [9, 87896], [16, 88496], [25, 89016], [28, 89216], [39, 89936], [41, 90296], [51, 91156], [53, 91336]]}, {"verse": 12, "start": 92648, "end": 97164, "text": "Y por haberse multiplicado la maldad, el amor de muchos se enfriará.", "words": [[0, 92648], [2, 92901], [6, 93081], [14, 93461], [27, 94281], [30, 94441], [38, 95221], [41, 95301], [46, 95561], [49, 95741], [56, 96021], [59, 96401]]}, {"verse": 13, "start": 97614, "end": 101262, "text": "Pero el que persevere hasta el fin, este será salvo.", "words": [[0, 97614], [5, 97758], [8, 97938], [12, 98038], [22, 98818], [28, 99078], [31, 99258], [36, 100098], [41, 100298], [46, 100618]]}, {"verse": 14, "start": 101712, "end": 110737, "text": "Y será predicado este evangelio del reino en todo el mundo, por testimonio a todos los Gentiles; y entonces vendrá el fin.", "words": [[0, 101712], [2, 101833], [7, 102093], [17, 102933], [22, 103153], [32, 103913], [36, 104053], [42, 104553], [45, 104693], [50, 104893], [53, 105093], [60, 105853], [64, 106093], [75, 106953], [77, 107053], [83, 107233], [87, 107533], [97, 108673], [99, 108802], [108, 109282], [115, 110142], [118, 110439]]}, {"verse": 15, "start": 111187, "end": 119858, "text": "Por tanto, cuando veáis en el lugar santo la abominación desoladora de que habló el profeta Daniel (el que lee, entienda),", "words": [[0, 111187], [4, 111312], [11, 111772], [18, 111972], [24, 112452], [27, 112632], [30, 112752], [36, 113052], [42, 113912], [45, 114192], [57, 115132], [68, 115912], [71, 116112], [75, 116252], [81, 116592], [84, 116692], [92, 117232], [99, 118252], [103, 118372], [107, 118532], [112, 119221]]}, {"verse": 16, "start": 120308, "end": 124248, "text": "Entonces los que están en Judea, huyan a los montes;", "words": [[0, 120308], [9, 120906], [13, 121486], [17, 121646], [23, 121846], [26, 122006], [33, 122606], [39, 123226], [41, 123426], [45, 123546]]}, {"verse": 17, "start": 124698, "end": 129929, "text": "Y el que sobre la azotea, no descienda a tomar algo de su casa;", "words": [[0, 124698], [2, 124860], [5, 124960], [9, 125140], [15, 125560], [18, 125800], [26, 126640], [29, 127220], [39, 127880], [41, 128080], [47, 128380], [52, 128960], [55, 129180], [58, 129320]]}, {"verse": 18, "start": 130379, "end": 135417, "text": "Y el que en el campo, no vuelva atrás a tomar sus vestidos.", "words": [[0, 130379], [2, 130585], [5, 130785], [9, 131005], [12, 131305], [15, 131465], [22, 132025], [25, 132825], [32, 133305], [38, 133625], [40, 133865], [46, 134185], [50, 134445]]}, {"verse": 19, "start": 135867, "end": 140885, "text": "Pero ¡ay de las embarazadas, y de las que crían en aquellos días!", "words": [[0, 135867], [5, 136152], [9, 136472], [12, 136652], [16, 136792], [29, 137732], [31, 138252], [34, 138352], [38, 138492], [42, 138632], [48, 139092], [51, 139232], [60, 139472]]}, {"verse": 20, "start": 141335, "end": 145858, "text": "Orad, pues, que vuestra huida no sea en invierno ni en sábado;", "words": [[0, 141335], [6, 141335], [12, 141582], [16, 142102], [24, 142482], [30, 142862], [33, 143082], [37, 143462], [40, 143802], [49, 144502], [52, 144922], [55, 145102]]}, {"verse": 21, "start": 146308, "end": 153479, "text": "Porque habrá entonces grande aflicción, cual no fue desde el principio del mundo hasta ahora, ni será.", "words": [[0, 146308], [7, 146512], [13, 146832], [22, 147252], [29, 147972], [40, 149232], [45, 149692], [48, 149852], [52, 150112], [58, 150412], [61, 150592], [71, 151152], [75, 151472], [81, 151792], [87, 152052], [94, 152692], [97, 152892]]}, {"verse": 22, "start": 153929, "end": 163651, "text": "Y si aquellos días no fuesen acortados, nadie sobreviviría; pero por causa de los escogidos, aquellos días serán acortados.", "words": [[0, 153929], [2, 154069], [5, 154169], [14, 154409], [19, 154719], [22, 155029], [29, 155469], [40, 156589], [46, 157129], [60, 158844], [65, 159009], [69, 159269], [75, 159549], [78, 159829], [82, 159929], [93, 160609], [102, 160889], [107, 161209], [113, 161609]]}, {"verse": 23, "start": 164101, "end": 170621, "text": "Entonces, si alguno os dice: Mirad, aquí está el Cristo» o «Mirad, allí está», no lo creáis.", "words": [[0, 164101], [10, 164101], [13, 164281], [20, 164571], [23, 164861], [29, 166272], [36, 166272], [41, 166649], [46, 166849], [49, 166989], [57, 167969], [59, 168049], [67, 168829], [72, 169029], [79, 169629], [82, 169729], [85, 169849]]}, {"verse": 24, "start": 171071, "end": 183037, "text": "Porque se levantarán falsos Cristos, y falsos profetas, y darán señales grandes y prodigios; de tal manera que engañarán, si es posible, aun a los escogidos.", "words": [[0, 171071], [7, 171254], [10, 171434], [21, 172034], [28, 172574], [37, 173274], [39, 173394], [46, 173814], [56, 174414], [58, 175054], [64, 175414], [72, 175874], [80, 176334], [82, 176754], [93, 178030], [96, 178157], [100, 178337], [107, 178677], [111, 178917], [122, 179817], [125, 180177], [128, 180377], [137, 180957], [141, 181577], [143, 181917], [147, 182097]]}, {"verse": 25, "start": 183487, "end": 185698, "text": "He aquí os lo he dicho antes.", "words": [[0, 183587], [3, 183687], [8, 183967], [11, 184307], [14, 184527], [17, 184647], [23, 184887]]}, {"verse": 26, "start": 186148, "end": 194480, "text": "Así que, si os dicen: He aquí en el desierto está; no salgáis: He aquí en lugares ocultos; no creáis.", "words": [[0, 186148], [4, 186457], [9, 186657], [12, 186827], [15, 186997], [22, 187951], [25, 188041], [30, 188301], [33, 188541], [36, 188661], [45, 189181], [51, 190016], [54, 190558], [63, 191429], [66, 191509], [71, 191729], [74, 191949], [82, 192289], [91, 193588], [94, 193765]]}, {"verse": 27, "start": 194930, "end": 202637, "text": "Porque como el relámpago que sale del oriente y se muestra hasta el occidente, así será también la venida del Hijo del hombre.", "words": [[0, 194930], [7, 195193], [12, 195513], [15, 195733], [25, 196473], [29, 196653], [34, 197033], [38, 197253], [46, 197733], [48, 197913], [51, 198013], [59, 198433], [65, 198633], [68, 198773], [79, 199393], [83, 200033], [88, 200373], [96, 200813], [99, 201143], [106, 201473], [110, 201673], [115, 201893], [119, 202113]]}, {"verse": 28, "start": 203087, "end": 208617, "text": "Porque donde quiera que esté el cuerpo muerto, allí se juntarán las águilas.", "words": [[0, 203087], [7, 203311], [13, 203571], [20, 204111], [24, 204271], [29, 204471], [32, 204591], [39, 204871], [47, 205951], [52, 206371], [55, 206571], [64, 207111], [68, 207864]]}, {"verse": 29, "start": 209067, "end": 222939, "text": "Y luego después de la aflicción de aquellos días, el sol se oscurecerá, y la luna no dará su resplandor, y las estrellas caerán del cielo, y las potencias de los cielos serán conmovidas.", "words": [[0, 209067], [2, 209190], [8, 209530], [16, 209810], [19, 210070], [22, 210190], [32, 210930], [35, 211110], [44, 211370], [50, 211840], [53, 212310], [57, 212690], [60, 213150], [72, 214050], [74, 214490], [77, 214630], [82, 215010], [85, 215510], [90, 215870], [93, 216050], [105, 216810], [107, 217490], [111, 217670], [121, 218230], [128, 218690], [132, 218870], [139, 219919], [141, 220159], [145, 220299], [155, 220959], [158, 221099], [162, 221239], [169, 221719], [175, 222039]]}, {"verse": 30, "start": 223389, "end": 238665, "text": "Y entonces se mostrará la señal del Hijo del hombre en el cielo; y entonces lamentarán todas las tribus de la tierra, y verán al Hijo del hombre que vendrá sobre las nubes del cielo, con grande poder y gloria.", "words": [[0, 223389], [2, 223542], [11, 223982], [14, 224542], [23, 225142], [26, 225242], [32, 225742], [36, 225902], [41, 226202], [45, 226362], [52, 226802], [55, 227002], [58, 227142], [65, 228065], [67, 228208], [76, 228708], [87, 229788], [93, 230148], [97, 230688], [104, 231228], [107, 231328], [110, 231448], [118, 231888], [120, 232548], [126, 232928], [129, 233148], [134, 233368], [138, 233608], [145, 233968], [149, 234188], [156, 234628], [162, 234928], [166, 235168], [172, 235648], [176, 235808], [183, 236248], [187, 236948], [194, 237388], [200, 237808], [202, 238008]]}, {"verse": 31, "start": 239115, "end": 249457, "text": "Y enviará sus ángeles con gran voz de trompeta, y juntarán sus escogidos de los cuatro vientos, de un extremo del cielo hasta el otro.", "words": [[0, 239115], [2, 239234], [10, 239834], [14, 240034], [22, 240754], [26, 241194], [31, 241474], [35, 241794], [38, 241974], [48, 242894], [50, 243354], [59, 244074], [63, 244274], [73, 245094], [76, 245274], [80, 245414], [87, 245674], [96, 246294], [99, 246754], [102, 246934], [110, 247674], [114, 247814], [120, 248334], [126, 248754], [129, 248954]]}, {"verse": 32, "start": 249907, "end": 258428, "text": "De la higuera aprended la parábola: Cuando ya su rama se pone tierna, y las hojas brotan, sabéis que el verano está cerca.", "words": [[0, 249907], [3, 250073], [6, 250480], [14, 250886], [23, 251293], [26, 251573], [36, 252670], [43, 252854], [46, 253134], [49, 253414], [54, 253694], [57, 253874], [62, 254054], [70, 254694], [72, 255114], [76, 255294], [82, 255594], [90, 256434], [97, 256874], [101, 257054], [104, 257174], [111, 257534], [116, 257734]]}, {"verse": 33, "start": 258878, "end": 265490, "text": "Así también vosotros, cuando veáis todas estas cosas, conoced que está cerca, a las puertas.", "words": [[0, 258878], [4, 259220], [12, 259560], [22, 260600], [29, 260800], [35, 261320], [41, 261580], [47, 261980], [54, 262540], [62, 263100], [66, 263390], [71, 263680], [78, 264160], [80, 264660], [84, 264760]]}, {"verse": 34, "start": 265940, "end": 272366, "text": "De cierto os digo, que no pasará esta generación, que todas estas cosas no acontezcan.", "words": [[0, 265940], [3, 266128], [10, 266428], [13, 266848], [19, 267728], [23, 267908], [26, 268028], [33, 268468], [38, 268788], [50, 269928], [54, 270228], [60, 270448], [66, 270728], [72, 271128], [75, 271428]]}, {"verse": 35, "start": 272816, "end": 277191, "text": "El cielo y la tierra pasarán, pero mis palabras no pasarán.", "words": [[0, 272816], [3, 272959], [9, 273359], [11, 273659], [14, 273799], [21, 274059], [30, 274979], [35, 275339], [39, 275559], [48, 275999], [51, 276519]]}, {"verse": 36, "start": 277641, "end": 284180, "text": "Pero del día y hora nadie sabe, ni aun los ángeles de los cielos, sino mi Padre solo.", "words": [[0, 277641], [5, 277803], [9, 278063], [13, 278383], [15, 278603], [20, 278803], [26, 279163], [32, 280283], [35, 280563], [39, 280843], [43, 281103], [51, 281643], [54, 281783], [58, 281923], [66, 282663], [71, 282903], [74, 283143], [80, 283403]]}, {"verse": 37, "start": 284630, "end": 288891, "text": "Pero como los días de Noé, así será la venida del Hijo del hombre.", "words": [[0, 284630], [5, 284774], [10, 285034], [14, 285254], [19, 285594], [22, 285814], [27, 286174], [31, 286534], [36, 286914], [39, 287234], [46, 287554], [50, 287794], [55, 288114], [59, 288294]]}, {"verse": 38, "start": 289341, "end": 299001, "text": "Porque como en los días antes del diluvio estaban comiendo y bebiendo, casándose y dando en casamiento, hasta el día que Noé entró en el arca,", "words": [[0, 289341], [7, 289603], [12, 289883], [15, 290043], [19, 290163], [24, 290403], [30, 290863], [34, 291103], [42, 291643], [50, 291923], [59, 292663], [61, 292763], [71, 293723], [81, 294403], [83, 294703], [89, 294983], [92, 295183], [104, 296203], [110, 296483], [113, 296683], [117, 296923], [121, 297223], [125, 297523], [131, 298163], [134, 298323], [137, 298463]]}, {"verse": 39, "start": 299451, "end": 307603, "text": "Y no conocieron hasta que vino el diluvio y llevó a todos, así será también la venida del Hijo del hombre.", "words": [[0, 299451], [2, 299580], [5, 299700], [16, 300320], [22, 300580], [26, 300780], [31, 301000], [34, 301200], [42, 301740], [44, 301900], [50, 302220], [52, 302280], [59, 303360], [63, 303580], [68, 303900], [76, 304320], [79, 304520], [86, 304960], [90, 305180], [95, 305420], [99, 305640]]}, {"verse": 40, "start": 308053, "end": 314210, "text": "Entonces estarán dos en el campo; el uno será tomado, y el otro será dejado:", "words": [[0, 308053], [9, 308053], [17, 308577], [21, 308897], [24, 309337], [27, 309477], [34, 310404], [37, 310572], [41, 310832], [46, 311072], [54, 311812], [56, 312592], [59, 312752], [64, 313012], [69, 313372]]}, {"verse": 41, "start": 314660, "end": 321126, "text": "Dos mujeres moliendo en un molino; la una será tomada, y la otra será dejada.", "words": [[0, 314660], [4, 315322], [12, 315862], [21, 316702], [24, 316902], [27, 317042], [35, 318135], [38, 318280], [42, 318500], [47, 318780], [55, 319420], [57, 319540], [60, 319680], [65, 319960], [70, 320260]]}, {"verse": 42, "start": 321576, "end": 326237, "text": "Velad pues, porque no sabéis a qué hora ha de venir vuestro Señor.", "words": [[0, 321576], [6, 321964], [12, 322544], [19, 323124], [22, 323264], [29, 323824], [31, 324064], [35, 324204], [40, 324504], [43, 324764], [46, 324924], [52, 325184], [60, 325584]]}, {"verse": 43, "start": 326687, "end": 335855, "text": "Pero sabed esto, que si el padre de la familia supiese a qué hora vendría el ladrón, velaría, y no dejaría entrar a robar en su casa.", "words": [[0, 326687], [5, 326971], [11, 327291], [17, 327531], [21, 327711], [24, 327891], [27, 328051], [33, 328371], [36, 328571], [39, 328691], [47, 329071], [55, 329631], [57, 329791], [61, 329951], [66, 330171], [74, 330691], [77, 330951], [85, 331971], [94, 332471], [96, 333151], [99, 333291], [107, 333771], [114, 334211], [116, 334491], [122, 334931], [125, 335051], [128, 335231]]}, {"verse": 44, "start": 336305, "end": 343657, "text": "Por tanto, también vosotros estad preparados; porque el Hijo del hombre ha de venir a la hora que no pensáis.", "words": [[0, 336305], [4, 336429], [11, 336889], [19, 337169], [28, 337599], [34, 338029], [46, 339632], [53, 339894], [56, 340214], [61, 340474], [65, 340654], [72, 340974], [75, 341274], [78, 341414], [84, 341734], [86, 341994], [89, 342134], [94, 342354], [98, 342534], [101, 342674]]}, {"verse": 45, "start": 344107, "end": 352473, "text": "¿Quién pues es el siervo fiel y prudente, al cual puso su señor sobre su familia para que les dé alimento a tiempo?", "words": [[0, 344107], [7, 344465], [12, 344855], [15, 345055], [18, 345175], [25, 345655], [30, 345975], [32, 346335], [42, 346695], [45, 347175], [50, 347335], [55, 347915], [58, 348095], [64, 348495], [70, 348875], [73, 349115], [81, 349715], [86, 350255], [90, 350435], [94, 350575], [97, 350855], [106, 351515], [108, 351675]]}, {"verse": 46, "start": 352923, "end": 359165, "text": "Bienaventurado aquel siervo, al cual, cuando su señor venga, le halle haciendo así.", "words": [[0, 352923], [15, 354010], [21, 354410], [29, 354970], [32, 355170], [38, 355890], [45, 356230], [48, 356430], [54, 356730], [61, 357630], [64, 357790], [70, 358110], [79, 358450]]}, {"verse": 47, "start": 359615, "end": 363249, "text": "De cierto os digo, que sobre todos sus bienes le pondrá.", "words": [[0, 359615], [3, 359760], [10, 360040], [13, 360460], [19, 360760], [23, 360960], [29, 361290], [35, 361620], [39, 361920], [46, 362440], [49, 362540]]}, {"verse": 48, "start": 363699, "end": 369463, "text": "Y si aquel siervo malo dice en su corazón: Mi señor se tarda en venir:", "words": [[0, 363699], [2, 363825], [5, 363945], [11, 364285], [18, 364745], [23, 365305], [28, 365905], [31, 366285], [34, 366445], [43, 367496], [46, 367621], [52, 368161], [55, 368181], [61, 368641], [64, 368821]]}, {"verse": 49, "start": 369913, "end": 377024, "text": "Y comienza a herir a sus compañeros de servicio, y aun a comer y a beber con los borrachos;", "words": [[0, 369913], [2, 370021], [11, 370661], [13, 370981], [19, 371401], [21, 371501], [25, 371681], [36, 372541], [39, 372661], [49, 373321], [51, 374021], [55, 374261], [57, 374581], [63, 374901], [65, 375301], [67, 375421], [73, 375621], [77, 376001], [81, 376161]]}, {"verse": 50, "start": 377474, "end": 382608, "text": "Vendrá el señor de aquel siervo en el día que no espera, y a la hora que no sabe,", "words": [[0, 377474], [7, 377931], [10, 378071], [16, 378371], [19, 378631], [25, 378931], [32, 379451], [35, 379571], [38, 379711], [42, 379951], [46, 380131], [49, 380291], [57, 380971], [59, 381331], [61, 381451], [64, 381531], [69, 381791], [73, 381971], [76, 382111]]}, {"verse": 51, "start": 383058, "end": 391935, "text": "Y le cortará por medio, y pondrá su parte con los hipócritas: allí será el llanto y el crujir de dientes.", "words": [[0, 383058], [2, 383183], [5, 383303], [13, 383903], [17, 384163], [24, 384723], [26, 385243], [33, 385663], [36, 385843], [42, 386343], [46, 386663], [50, 386803], [62, 388205], [67, 388608], [72, 388868], [75, 389068], [82, 389708], [84, 390268], [87, 390628], [94, 390988], [97, 391148]]}]}