{"book": "GEN", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 227364, "verses": [{"verse": 1, "start": 300, "end": 7876, "text": "Y bendijo Dios a Noé y a sus hijos, y les dijo: Fructificad, y multiplicaos, y llenad la tierra:", "words": [[0, 300], [2, 442], [10, 942], [15, 1242], [17, 1482], [21, 1882], [23, 2202], [25, 2262], [29, 2442], [36, 3302], [38, 3382], [42, 3542], [48, 4661], [61, 5141], [63, 5281], [77, 6261], [79, 6601], [86, 6941], [89, 7061]]}, {"verse": 2, "start": 8226, "end": 21457, "text": "Y vuestro temor y vuestro pavor será sobre todo animal de la tierra, y sobre toda ave de los cielos, en todo lo que se moverá en la tierra, y en todos los peces del mar: en vuestra mano son entregados.", "words": [[0, 8226], [2, 8346], [10, 8686], [16, 9166], [18, 9266], [26, 9586], [32, 10026], [37, 10346], [43, 10666], [48, 11026], [55, 11446], [58, 11706], [61, 11806], [69, 12186], [71, 12421], [77, 12661], [82, 13041], [86, 13441], [89, 13581], [93, 13721], [101, 14321], [104, 14681], [109, 14981], [112, 15201], [116, 15321], [119, 15461], [126, 15861], [129, 15941], [132, 16041], [140, 16885], [142, 17028], [145, 17148], [151, 17328], [155, 17608], [161, 18028], [165, 18228], [170, 19104], [173, 19246], [181, 19606], [186, 19906], [190, 20266]]}, {"verse": 3, "start": 21807, "end": 29627, "text": "Todo lo que se mueve y vive, os será para mantenimiento: así como las legumbres y hierbas, os lo he dado todo.", "words": [[0, 21807], [5, 22009], [8, 22229], [12, 22349], [15, 22489], [21, 22969], [23, 23129], [29, 23559], [32, 23989], [37, 24249], [42, 24529], [57, 25968], [61, 26234], [66, 26494], [70, 26674], [80, 27234], [82, 27414], [91, 27914], [94, 28294], [97, 28514], [100, 28614], [105, 28834]]}, {"verse": 4, "start": 29977, "end": 33713, "text": "Pero carne con su vida, que es su sangre, no comeréis.", "words": [[0, 29977], [5, 30139], [11, 30559], [15, 30819], [18, 30959], [24, 31639], [28, 31719], [31, 31919], [34, 32019], [42, 32759], [45, 32859]]}, {"verse": 5, "start": 34063, "end": 44784, "text": "Porque ciertamente demandaré la sangre de vuestras vidas; de mano de todo animal la demandaré, y de mano del hombre; de mano del varón su hermano demandaré la vida del hombre.", "words": [[0, 34063], [7, 34267], [19, 35027], [29, 35627], [32, 35747], [39, 36127], [42, 36307], [51, 36687], [58, 37561], [61, 37720], [66, 37980], [69, 38180], [74, 38380], [81, 38820], [84, 39040], [95, 39680], [97, 39875], [100, 39995], [105, 40275], [109, 40515], [117, 41458], [120, 41551], [125, 41771], [129, 41991], [135, 42351], [138, 42511], [146, 42991], [156, 43491], [159, 43631], [164, 43851], [168, 44051]]}, {"verse": 6, "start": 45134, "end": 52230, "text": "El que derrame sangre del hombre, por el hombre su sangre será derramada; porque a imagen de Dios es hecho el hombre.", "words": [[0, 45134], [3, 45277], [7, 45397], [15, 45817], [22, 46217], [26, 46437], [34, 47017], [38, 47197], [41, 47317], [48, 47577], [51, 47777], [58, 48137], [63, 48397], [74, 49595], [81, 49766], [83, 49956], [90, 50316], [93, 50556], [98, 50836], [101, 51256], [107, 51516], [110, 51676]]}, {"verse": 7, "start": 52580, "end": 60206, "text": "Mas vosotros fructificad, y multiplicaos; procread abundantemente en la tierra, y multiplicaos en ella.", "words": [[0, 52580], [4, 52776], [13, 53276], [26, 54256], [28, 54436], [42, 55942], [51, 56538], [66, 57478], [69, 57598], [72, 57698], [80, 58038], [82, 58518], [95, 59398], [98, 59538]]}, {"verse": 8, "start": 60486, "end": 64743, "text": "Y habló Dios a Noé y a sus hijos con él, diciendo:", "words": [[0, 60486], [2, 60611], [8, 61011], [13, 61271], [15, 61571], [19, 62191], [21, 62411], [23, 62491], [27, 62671], [33, 62971], [37, 63331], [41, 63571]]}, {"verse": 9, "start": 64943, "end": 70719, "text": "Yo, he aquí que yo establezco mi pacto con vosotros, y con vuestra simiente después de vosotros;", "words": [[0, 64943], [4, 65115], [7, 65235], [12, 65515], [16, 65715], [19, 65895], [30, 66535], [33, 66675], [39, 67115], [43, 67215], [53, 67775], [55, 68035], [59, 68215], [67, 68555], [76, 69155], [84, 69495], [87, 69795]]}, {"verse": 10, "start": 71069, "end": 82875, "text": "Y con toda alma viviente que está con vosotros, de aves, de animales, y de toda bestia de la tierra que está con vosotros; desde todos los que salieron del arca hasta todo animal de la tierra.", "words": [[0, 71069], [2, 71172], [6, 71352], [11, 71592], [16, 71892], [25, 72472], [29, 72652], [34, 72872], [38, 73092], [48, 74132], [51, 74212], [57, 74872], [60, 74932], [70, 75352], [72, 75772], [75, 75892], [80, 76072], [87, 76612], [90, 76712], [93, 76812], [100, 77132], [104, 77332], [109, 77532], [113, 77772], [123, 78776], [129, 78995], [135, 79355], [139, 79635], [143, 79815], [152, 80255], [156, 80435], [161, 80835], [167, 81135], [172, 81475], [179, 81755], [182, 81995], [185, 82075]]}, {"verse": 11, "start": 83225, "end": 92627, "text": "Estableceré mi pacto con vosotros, y no fenecerá ya más toda carne con aguas de diluvio; ni habrá más diluvio para destruir la tierra.", "words": [[0, 83225], [12, 83987], [15, 84047], [21, 84507], [25, 84647], [35, 85207], [37, 85727], [40, 85887], [49, 86254], [52, 86620], [56, 86987], [61, 87127], [67, 87587], [71, 87867], [77, 88227], [80, 88327], [89, 89389], [92, 89566], [98, 89926], [102, 90106], [110, 90786], [115, 91066], [124, 91706], [127, 91806]]}, {"verse": 12, "start": 92907, "end": 103167, "text": "Y dijo Dios: Esta será la señal del pacto que yo establezco entre mí y vosotros y toda alma viviente que está con vosotros, por siglos perpetuos:", "words": [[0, 92907], [2, 93251], [7, 93627], [13, 94135], [18, 94493], [23, 94813], [26, 94953], [32, 95413], [36, 95533], [42, 96073], [46, 96173], [49, 96333], [60, 97013], [66, 97233], [69, 97533], [71, 97748], [80, 98408], [82, 98683], [87, 98883], [92, 99263], [101, 99863], [105, 100083], [110, 100323], [114, 100623], [124, 101583], [128, 101783], [135, 102203]]}, {"verse": 13, "start": 103517, "end": 109910, "text": "Mi arco pondré en las nubes, el cual será por señal de convenio entre mí y la tierra.", "words": [[0, 103517], [3, 103719], [8, 104039], [15, 104559], [18, 104759], [22, 104899], [29, 105759], [32, 106059], [37, 106299], [42, 106619], [46, 106859], [52, 107339], [55, 107439], [64, 108059], [70, 108379], [73, 108719], [75, 108959], [78, 109099]]}, {"verse": 14, "start": 110260, "end": 116466, "text": "Y será que cuando haga venir nubes sobre la tierra, se dejará ver entonces mi arco en las nubes.", "words": [[0, 110260], [2, 110383], [7, 110623], [11, 110883], [18, 111163], [23, 111463], [29, 111763], [35, 112323], [41, 112563], [44, 112723], [52, 113143], [55, 113388], [62, 113828], [66, 114028], [75, 114528], [78, 115048], [83, 115328], [86, 115448], [90, 115568]]}, {"verse": 15, "start": 116816, "end": 128334, "text": "Y me acordaré del pacto mío, que hay entre mí y vosotros y toda alma viviente de toda carne; y no serán más las aguas por diluvio para destruir toda carne.", "words": [[0, 116816], [2, 116934], [5, 117034], [14, 117634], [18, 117814], [24, 118354], [29, 119034], [33, 119314], [37, 119514], [43, 119754], [46, 120034], [48, 120294], [57, 120934], [59, 121494], [64, 121714], [69, 122074], [78, 122674], [81, 122834], [86, 123034], [93, 124188], [95, 124289], [98, 124429], [104, 124829], [108, 125049], [112, 125229], [118, 125669], [122, 125829], [130, 126329], [135, 126569], [144, 127209], [149, 127389]]}, {"verse": 16, "start": 128684, "end": 138840, "text": "Y estará el arco en las nubes, y lo veré para acordarme del pacto perpetuo entre Dios y toda alma viviente, con toda carne que hay sobre la tierra.", "words": [[0, 128684], [2, 128823], [9, 129323], [12, 129463], [17, 129823], [20, 129963], [24, 130123], [31, 131083], [33, 131163], [36, 131303], [41, 131583], [46, 131763], [56, 132383], [60, 132583], [66, 133083], [75, 133763], [81, 134083], [86, 134483], [88, 134883], [93, 135083], [98, 135403], [108, 136483], [112, 136583], [117, 136803], [123, 137203], [127, 137423], [131, 137603], [137, 137863], [140, 138063]]}, {"verse": 17, "start": 139120, "end": 147958, "text": "Dijo, pues, Dios a Noé: Esta será la señal del pacto que he establecido entre mí y toda carne que está sobre la tierra.", "words": [[0, 139120], [6, 139646], [12, 140446], [17, 140826], [19, 141249], [24, 141805], [29, 142109], [34, 142389], [37, 142529], [43, 142949], [47, 143089], [53, 143669], [57, 143789], [60, 143929], [72, 144569], [78, 144849], [81, 145109], [83, 145549], [88, 145749], [94, 146209], [98, 146429], [103, 146669], [109, 146969], [112, 147149]]}, {"verse": 18, "start": 148238, "end": 155532, "text": "Y los hijos de Noé que salieron del arca fueron Sem, Cam y Jafet: y Cam es el padre de Canaán.", "words": [[0, 148238], [2, 148345], [6, 148465], [12, 148785], [15, 148945], [19, 149285], [23, 149365], [32, 149845], [36, 150065], [41, 150445], [48, 150705], [53, 151985], [57, 152325], [59, 152765], [66, 153555], [68, 153649], [72, 153775], [75, 153902], [78, 154202], [84, 154662], [87, 155118]]}, {"verse": 19, "start": 155882, "end": 161029, "text": "Estos tres son los hijos de Noé; y de ellos fue llena toda la tierra.", "words": [[0, 155882], [6, 156370], [11, 156690], [15, 157170], [19, 157390], [25, 157690], [28, 157970], [33, 158739], [35, 158887], [38, 158987], [44, 159187], [48, 159487], [54, 159867], [59, 160067], [62, 160327]]}, {"verse": 20, "start": 161379, "end": 165136, "text": "Y comenzó Noé a labrar la tierra, y plantó una viña:", "words": [[0, 161379], [2, 161501], [10, 162101], [14, 162421], [16, 162521], [23, 162941], [26, 163081], [34, 163501], [36, 163886], [43, 164426], [47, 164566]]}, {"verse": 21, "start": 165486, "end": 171190, "text": "Y bebió del vino, y se embriagó, y estaba descubierto en medio de su tienda.", "words": [[0, 165486], [2, 165613], [8, 165953], [12, 166093], [18, 166513], [20, 166993], [23, 167113], [33, 167913], [35, 168353], [42, 168673], [54, 169553], [57, 169733], [63, 170093], [66, 170313], [69, 170473]]}, {"verse": 22, "start": 171540, "end": 179025, "text": "Y Cam, padre de Canaán, vio la desnudez de su padre, y lo dijo a sus dos hermanos a la parte de afuera.", "words": [[0, 171540], [2, 171844], [7, 172184], [13, 172524], [16, 172644], [24, 173184], [28, 173724], [31, 174264], [40, 174964], [43, 175044], [46, 175184], [53, 175544], [55, 176084], [58, 176204], [63, 176464], [65, 176684], [69, 176804], [73, 177104], [82, 177824], [84, 177924], [87, 178004], [93, 178284], [96, 178484]]}, {"verse": 23, "start": 179375, "end": 195437, "text": "Entonces Sem y Jafet tomaron la ropa, y la pusieron sobre sus propios hombros, y andando hacia atrás, cubrieron la desnudez de su padre, teniendo vueltos sus rostros, y así no vieron la desnudez de su padre.", "words": [[0, 179375], [9, 179914], [13, 180414], [15, 180694], [21, 181234], [29, 181599], [32, 181799], [38, 182299], [40, 182739], [43, 182839], [52, 183379], [58, 183699], [62, 183999], [70, 184519], [79, 185159], [81, 185639], [89, 186219], [95, 186419], [102, 187329], [112, 188239], [115, 188619], [124, 188999], [127, 189239], [130, 189439], [137, 190209], [146, 190979], [154, 191599], [158, 192174], [167, 192909], [169, 193035], [173, 193255], [176, 193515], [183, 193848], [186, 194182], [195, 194515], [198, 194715], [201, 194835]]}, {"verse": 24, "start": 195787, "end": 201587, "text": "Y despertó Noé de su vino, y supo lo que había hecho con él su hijo el más joven;", "words": [[0, 195787], [2, 196047], [11, 196767], [15, 197167], [18, 197287], [21, 197467], [27, 197827], [29, 198347], [34, 198847], [37, 198987], [41, 199147], [47, 199387], [53, 199667], [57, 199907], [60, 200087], [63, 200347], [68, 200647], [71, 200827], [75, 201007]]}, {"verse": 25, "start": 201937, "end": 206739, "text": "Y dijo: Maldito sea Canaán; siervo de siervos será a sus hermanos.", "words": [[0, 201937], [2, 202295], [8, 202868], [16, 203387], [20, 203887], [28, 204741], [35, 204961], [38, 205231], [46, 205501], [51, 205741], [53, 205881], [57, 206021]]}, {"verse": 26, "start": 207019, "end": 211709, "text": "Dijo más: Bendito Jehová el Dios de Sem, y que le sea Canaán siervo.", "words": [[0, 207019], [5, 207368], [10, 208150], [18, 208632], [25, 209092], [28, 209232], [33, 209412], [36, 209612], [41, 209972], [43, 210107], [47, 210227], [50, 210347], [54, 210717], [61, 211087]]}, {"verse": 27, "start": 212059, "end": 217950, "text": "Engrandezca Dios a Jafet, y habite en las tiendas de Sem, y que le sea Canaán siervo.", "words": [[0, 212059], [12, 212895], [17, 213155], [19, 213355], [26, 213875], [28, 214275], [35, 214655], [38, 214735], [42, 214855], [50, 215355], [53, 215655], [58, 215955], [60, 216255], [64, 216375], [67, 216495], [71, 216775], [78, 217255]]}, {"verse": 28, "start": 218230, "end": 221974, "text": "Y vivió Noé después del diluvio trescientos cincuenta años.", "words": [[0, 218230], [2, 218352], [8, 218712], [12, 219072], [20, 219372], [24, 219632], [32, 219985], [44, 220339], [54, 220692]]}, {"verse": 29, "start": 222324, "end": 226964, "text": "Y fueron todos los días de Noé novecientos cincuenta años; y murió.", "words": [[0, 222324], [2, 222589], [9, 222849], [15, 223309], [19, 223649], [24, 223889], [27, 224194], [31, 224499], [43, 224804], [53, 225109], [59, 226356], [61, 226464]]}]}