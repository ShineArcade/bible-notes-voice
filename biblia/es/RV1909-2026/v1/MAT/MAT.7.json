{"book": "MAT", "chapter": 7, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 218888, "verses": [{"verse": 1, "start": 300, "end": 3022, "text": "No juzguéis, para que no seáis juzgados.", "words": [[0, 300], [3, 489], [13, 1109], [18, 1409], [22, 1569], [25, 1749], [31, 2169]]}, {"verse": 2, "start": 3372, "end": 10448, "text": "Porque con el juicio con que juzgáis, seréis juzgados; y con la medida con que medís, os volverán a medir.", "words": [[0, 3372], [7, 3554], [11, 3814], [14, 3934], [21, 4314], [25, 4534], [29, 4714], [38, 5294], [45, 6094], [55, 7164], [57, 7272], [61, 7432], [64, 7592], [71, 7912], [75, 8172], [79, 8672], [86, 9172], [89, 9312], [98, 9872], [100, 9932]]}, {"verse": 3, "start": 10798, "end": 16369, "text": "Y ¿por qué miras la paja que está en el ojo de tu hermano, y no notas la viga que está en tu ojo?", "words": [[0, 10798], [2, 10942], [7, 11142], [11, 11382], [17, 11842], [20, 11962], [25, 12322], [29, 12502], [34, 12682], [37, 12822], [40, 12922], [44, 13162], [47, 13282], [50, 13402], [59, 14222], [61, 14422], [64, 14562], [70, 14942], [73, 15092], [78, 15242], [82, 15462], [87, 15622], [90, 15742], [93, 15902]]}, {"verse": 4, "start": 16719, "end": 23741, "text": "O ¿cómo dirás a tu hermano: Espera, echaré de tu ojo la mota, y he aquí la viga en tu ojo?", "words": [[0, 16719], [2, 16822], [8, 17082], [14, 17562], [16, 17662], [19, 17762], [28, 18634], [36, 19658], [43, 20118], [46, 20238], [49, 20458], [53, 20778], [56, 20958], [62, 21778], [64, 22018], [67, 22178], [72, 22478], [75, 22678], [80, 22878], [83, 23038], [86, 23238]]}, {"verse": 5, "start": 24091, "end": 31829, "text": "¡Hipócrita! echa primero la viga de tu ojo, y entonces verás bien para sacar la paja del ojo de tu hermano.", "words": [[0, 24091], [12, 25266], [17, 25474], [25, 25834], [28, 26084], [33, 26334], [36, 26534], [39, 26694], [44, 27154], [46, 27814], [55, 28274], [61, 29154], [66, 29394], [71, 29714], [77, 29994], [80, 30274], [85, 30534], [89, 30734], [93, 31014], [96, 31134], [99, 31254]]}, {"verse": 6, "start": 32179, "end": 41994, "text": "No deis lo santo a los perros, ni echéis vuestras perlas delante de los cerdos; porque no las pisoteen con sus pies, y vuelvan y os despedacen.", "words": [[0, 32179], [3, 32364], [8, 32637], [11, 32911], [17, 33184], [19, 33304], [23, 33424], [31, 34104], [34, 34404], [41, 34824], [50, 35284], [57, 35764], [65, 36224], [68, 36384], [72, 36524], [80, 37489], [87, 37713], [90, 37973], [94, 38173], [103, 38973], [107, 39153], [111, 39413], [117, 39693], [119, 40173], [127, 40753], [129, 40943], [132, 41133]]}, {"verse": 7, "start": 42344, "end": 47899, "text": "Pedid, y se os dará; buscad, y hallaréis; llamad, y se os abrirá.", "words": [[0, 42344], [7, 42710], [9, 42930], [12, 43090], [15, 43230], [21, 44190], [29, 44470], [31, 45080], [42, 45849], [50, 46436], [52, 46896], [55, 47036], [58, 47495]]}, {"verse": 8, "start": 48249, "end": 54459, "text": "Porque cualquiera que pide, recibe; y el que busca, halla; y al que llama, se abrirá.", "words": [[0, 48249], [7, 48452], [18, 49032], [22, 49172], [28, 49512], [36, 50486], [38, 50613], [41, 50713], [45, 50853], [52, 51607], [59, 52540], [61, 52648], [64, 52788], [68, 53108], [75, 53428], [78, 53959]]}, {"verse": 9, "start": 54809, "end": 59804, "text": "¿Qué hombre hay de vosotros, a quien si su hijo le pide pan, le dará una piedra?", "words": [[0, 54809], [5, 54931], [12, 55251], [16, 55491], [19, 55631], [29, 56231], [31, 56511], [37, 56671], [40, 56911], [43, 57091], [48, 57311], [51, 57511], [56, 57771], [61, 58131], [64, 58671], [69, 58951], [73, 59071]]}, {"verse": 10, "start": 60154, "end": 63524, "text": "¿Y si le pide un pez, le dará una serpiente?", "words": [[0, 60154], [3, 60260], [6, 60360], [9, 60500], [14, 60760], [17, 60900], [22, 61500], [25, 61980], [30, 62280], [34, 62380]]}, {"verse": 11, "start": 63874, "end": 74851, "text": "Pues si vosotros, siendo malos, sabéis dar buenas dádivas a vuestros hijos, ¿cuánto más vuestro Padre que está en los cielos, dará buenas cosas a los que le piden?", "words": [[0, 63874], [5, 64041], [8, 64201], [18, 64681], [25, 64941], [32, 65821], [39, 66581], [43, 66841], [50, 67181], [58, 67801], [60, 68001], [69, 68401], [76, 69261], [84, 69741], [88, 69961], [96, 70361], [102, 70701], [106, 70941], [111, 71161], [114, 71281], [118, 71401], [126, 71981], [131, 72741], [138, 73181], [144, 73681], [146, 73941], [150, 74041], [154, 74181], [157, 74321]]}, {"verse": 12, "start": 75201, "end": 85714, "text": "Así que, todas las cosas que quisierais que los hombres hiciesen con vosotros, así también haced vosotros con ellos; porque esta es la ley y los profetas.", "words": [[0, 75201], [4, 75496], [9, 75716], [15, 75996], [19, 76296], [25, 76696], [29, 76956], [40, 77596], [44, 77796], [48, 77976], [56, 78376], [65, 79216], [69, 79436], [79, 80436], [83, 80636], [91, 81076], [97, 81576], [106, 82156], [110, 82416], [117, 83147], [124, 83371], [129, 83731], [132, 83931], [135, 84071], [139, 84371], [141, 84791], [145, 84911]]}, {"verse": 13, "start": 86064, "end": 95293, "text": "Entrad por la puerta estrecha: porque ancha es la puerta, y espacioso el camino que lleva a perdición, y muchos son los que entran por ella.", "words": [[0, 86282], [7, 86542], [11, 86887], [14, 87067], [21, 87387], [31, 88423], [38, 88708], [44, 89028], [47, 89388], [50, 89508], [58, 89928], [60, 90410], [70, 90893], [73, 91133], [80, 91453], [84, 91733], [90, 92013], [92, 92173], [103, 92813], [105, 93118], [112, 93418], [116, 93818], [120, 94018], [124, 94218], [131, 94618], [135, 94838]]}, {"verse": 14, "start": 95643, "end": 102860, "text": "Porque estrecha es la puerta, y angosto el camino que lleva a la vida, y pocos son los que la hallan.", "words": [[0, 95643], [7, 95865], [16, 96385], [19, 96545], [22, 96685], [30, 97705], [32, 97965], [40, 98565], [43, 98645], [50, 98965], [54, 99205], [60, 99345], [62, 99485], [65, 99685], [71, 100445], [73, 100685], [79, 101365], [83, 101585], [87, 101765], [91, 101965], [94, 102145]]}, {"verse": 15, "start": 103210, "end": 111937, "text": "Y guardaos de los falsos profetas, que vienen a vosotros con vestidos de ovejas, pero de dentro son lobos rapaces.", "words": [[0, 103210], [2, 103562], [11, 103952], [14, 104172], [18, 104292], [25, 104812], [35, 105312], [39, 105532], [46, 105872], [48, 106072], [57, 106632], [61, 107097], [70, 107577], [73, 107717], [81, 108657], [86, 108757], [89, 108957], [96, 109417], [100, 110017], [106, 111007]]}, {"verse": 16, "start": 112287, "end": 118695, "text": "Por sus frutos los conoceréis. ¿Se cogen uvas de los espinos, o higos de los cardos?", "words": [[0, 112287], [4, 112554], [8, 112754], [15, 113694], [19, 113894], [31, 115108], [35, 115250], [41, 115650], [46, 116090], [49, 116230], [53, 116350], [62, 116970], [64, 117350], [70, 117750], [73, 117870], [77, 117970]]}, {"verse": 17, "start": 118695, "end": 124331, "text": "Así, todo buen árbol lleva buenos frutos; pero el árbol malo lleva malos frutos.", "words": [[0, 118695], [5, 118915], [10, 119215], [15, 119515], [21, 119895], [27, 120155], [34, 120595], [42, 121615], [47, 121901], [50, 122101], [56, 122461], [61, 123001], [67, 123221], [73, 123721]]}, {"verse": 18, "start": 124681, "end": 130492, "text": "No puede el buen árbol llevar malos frutos, ni el árbol malo llevar frutos buenos.", "words": [[0, 124681], [3, 124831], [9, 125171], [12, 125411], [17, 125591], [23, 126051], [30, 126331], [36, 126911], [44, 127931], [47, 128031], [50, 128211], [56, 128571], [61, 129011], [68, 129211], [75, 129851]]}, {"verse": 19, "start": 130842, "end": 135249, "text": "Todo árbol que no lleva buen fruto, se corta y se echa en el fuego.", "words": [[0, 130842], [5, 131004], [11, 131544], [15, 131744], [18, 131924], [24, 132184], [29, 132484], [36, 133084], [39, 133244], [45, 133844], [47, 133964], [50, 134104], [55, 134384], [58, 134524], [61, 134664]]}, {"verse": 20, "start": 135599, "end": 138637, "text": "Así que, por sus frutos los conoceréis.", "words": [[0, 135599], [4, 135841], [9, 136021], [13, 136261], [17, 136461], [24, 137061], [28, 137601]]}, {"verse": 21, "start": 138987, "end": 149010, "text": "No todo el que me dice: Señor, Señor, entrará en el reino de los cielos: sino el que hace la voluntad de mi Padre que está en los cielos.", "words": [[0, 138987], [3, 139133], [8, 139473], [11, 139693], [15, 139813], [18, 139953], [24, 140656], [31, 141596], [38, 142416], [46, 143116], [49, 143336], [52, 143476], [58, 143916], [61, 144036], [65, 144176], [73, 145057], [78, 145362], [81, 145542], [85, 145682], [90, 146062], [93, 146282], [102, 146862], [105, 146982], [108, 147122], [114, 147642], [118, 147762], [123, 147962], [126, 148102], [130, 148222]]}, {"verse": 22, "start": 149360, "end": 160332, "text": "Muchos me dirán en aquel día: Señor, Señor, ¿no profetizamos en tu nombre, y en tu nombre lanzamos demonios, y en tu nombre hicimos muchos milagros?", "words": [[0, 149360], [7, 149708], [10, 149988], [16, 150328], [19, 150448], [25, 150808], [30, 151517], [37, 152100], [44, 153000], [48, 153160], [61, 154160], [64, 154400], [67, 154580], [75, 155060], [77, 155560], [80, 155700], [83, 155880], [90, 156240], [99, 156900], [109, 157800], [111, 158040], [114, 158160], [117, 158320], [124, 158620], [132, 159100], [139, 159420]]}, {"verse": 23, "start": 160682, "end": 167396, "text": "Y entonces les declararé: Nunca os conocí; apartaos de mí, hacedores de maldad.", "words": [[0, 160682], [2, 160867], [11, 161427], [15, 162047], [26, 163237], [32, 163704], [35, 163824], [43, 165078], [52, 165398], [55, 165598], [59, 166098], [69, 166598], [72, 166818]]}, {"verse": 24, "start": 167746, "end": 176739, "text": "Cualquiera, pues, que me oye estas palabras, y las hace, le compararé a un hombre prudente, que edificó su casa sobre la roca;", "words": [[0, 167746], [12, 168371], [18, 169011], [22, 169111], [25, 169291], [29, 169631], [35, 169871], [45, 170411], [47, 170806], [51, 170986], [57, 171906], [60, 172026], [70, 172686], [72, 172786], [75, 172946], [82, 173226], [92, 173946], [96, 174341], [104, 175061], [107, 175201], [112, 175541], [118, 175941], [121, 176141]]}, {"verse": 25, "start": 177089, "end": 187380, "text": "Y descendió lluvia, y vinieron ríos, y soplaron vientos, y golpearon aquella casa; y no cayó: porque estaba fundada sobre la roca.", "words": [[0, 177089], [2, 177193], [12, 177713], [20, 178253], [22, 178773], [31, 179193], [37, 179913], [39, 180433], [48, 180953], [57, 181513], [59, 182033], [69, 182653], [77, 183013], [83, 184030], [85, 184250], [88, 184470], [94, 184890], [101, 185092], [108, 185452], [116, 186132], [122, 186452], [125, 186712]]}, {"verse": 26, "start": 187730, "end": 197310, "text": "Y cualquiera que me oye estas palabras, y no las hace, le compararé a un hombre insensato, que edificó su casa sobre la arena;", "words": [[0, 187730], [2, 187853], [13, 188433], [17, 188633], [20, 188833], [24, 189153], [30, 189433], [40, 189993], [42, 190573], [45, 190713], [49, 190933], [55, 191713], [58, 191833], [68, 192573], [70, 192713], [73, 192873], [80, 193173], [91, 194453], [95, 194953], [103, 195533], [106, 195673], [111, 196013], [117, 196413], [120, 196673]]}, {"verse": 27, "start": 197660, "end": 207135, "text": "Y descendió lluvia, y vinieron ríos, y soplaron vientos, y golpearon aquella casa; y cayó, y fue grande su ruina.", "words": [[0, 197660], [2, 197764], [12, 198284], [20, 198824], [22, 199344], [31, 199764], [37, 200484], [39, 201004], [48, 201524], [57, 202084], [59, 202604], [69, 203224], [77, 203584], [83, 204418], [85, 204776], [91, 205296], [93, 205816], [97, 205956], [104, 206276], [107, 206556]]}, {"verse": 28, "start": 207485, "end": 213295, "text": "Y aconteció que, como Jesús acabó estas palabras, la gente se admiraba de su enseñanza;", "words": [[0, 207485], [2, 207664], [12, 208384], [17, 208564], [22, 208824], [28, 209144], [34, 209724], [40, 209884], [50, 210844], [53, 211064], [59, 211344], [62, 211604], [71, 212144], [74, 212284], [77, 212424]]}, {"verse": 29, "start": 213645, "end": 218488, "text": "Porque les enseñaba como quien tiene autoridad, y no como los escribas.", "words": [[0, 213645], [7, 213945], [11, 214125], [20, 214785], [25, 215025], [31, 215305], [37, 215685], [48, 216445], [50, 217005], [53, 217145], [58, 217425], [62, 217645]]}]}