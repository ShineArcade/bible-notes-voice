{"book": "ISA", "chapter": 47, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 161744, "verses": [{"verse": 1, "start": 300, "end": 12273, "text": "Desciende, y siéntate en el polvo, virgen hija de Babilonia, siéntate en la tierra sin trono, hija de los caldeos: que nunca más te llamarán tierna y delicada.", "words": [[0, 300], [11, 1038], [13, 1318], [22, 2038], [25, 2218], [28, 2338], [35, 3358], [42, 3958], [47, 4158], [50, 4238], [61, 5358], [70, 5998], [73, 6098], [76, 6198], [83, 6538], [87, 6778], [94, 7718], [99, 8018], [102, 8098], [106, 8218], [115, 9596], [119, 9673], [125, 9893], [129, 10333], [132, 10453], [141, 10813], [148, 11433], [150, 11513]]}, {"verse": 2, "start": 12957, "end": 22031, "text": "Toma el molino, y muele harina: descubre tus guedejas, descalza los pies, descubre las piernas, pasa los ríos.", "words": [[0, 12957], [5, 13237], [8, 13317], [16, 13757], [18, 13997], [24, 14297], [32, 16410], [41, 16951], [45, 17391], [55, 17831], [64, 18271], [68, 18491], [74, 19231], [83, 19731], [87, 19891], [96, 20991], [101, 21151], [105, 21591]]}, {"verse": 3, "start": 22720, "end": 30092, "text": "Descubierta será tu vergüenza, y tu deshonor será visto: tomaré venganza, y no encontraré hombre.", "words": [[0, 22720], [12, 23501], [17, 23720], [20, 23920], [31, 24580], [33, 25001], [36, 25140], [45, 25740], [50, 25980], [57, 27182], [64, 27682], [74, 28402], [76, 28702], [79, 28882], [90, 29562]]}, {"verse": 4, "start": 30688, "end": 36632, "text": "Nuestro Redentor, Jehová de los ejércitos es su nombre, el Santo de Israel.", "words": [[0, 30688], [8, 31193], [18, 31773], [25, 32353], [28, 32513], [32, 32653], [42, 33453], [45, 33753], [48, 34093], [56, 35033], [59, 35173], [65, 35593], [68, 35853]]}, {"verse": 5, "start": 36932, "end": 43479, "text": "Siéntate, calla, y entra en tinieblas, hija de los caldeos: porque nunca más te llamarán señora de reinos.", "words": [[0, 36932], [10, 37399], [17, 37959], [19, 38139], [25, 38319], [28, 38479], [39, 39319], [44, 39539], [47, 39599], [51, 39719], [60, 40998], [67, 41199], [73, 41379], [77, 41779], [80, 41859], [89, 42319], [96, 42659], [99, 42879]]}, {"verse": 6, "start": 44165, "end": 53450, "text": "Me enojé contra mi pueblo, profané mi heredad, y los entregué en tu mano: no les hiciste misericordias; sobre el viejo agravaste mucho tu yugo.", "words": [[0, 44165], [3, 44307], [9, 44647], [16, 44887], [19, 45067], [27, 45667], [35, 46067], [38, 46207], [47, 46667], [49, 46887], [53, 47007], [62, 47507], [65, 47607], [68, 47727], [74, 48678], [77, 48822], [81, 49042], [89, 49502], [104, 51123], [110, 51360], [113, 51540], [119, 51900], [129, 52480], [135, 52760], [138, 52960]]}, {"verse": 7, "start": 54139, "end": 60650, "text": "Y dijiste: Para siempre seré señora: y no has pensado en esto, ni te acordaste de tu final.", "words": [[0, 54139], [2, 54279], [11, 55459], [16, 55600], [24, 55920], [29, 56440], [37, 57530], [39, 57630], [42, 57770], [46, 57910], [54, 58370], [57, 58470], [63, 58750], [66, 59230], [69, 59370], [79, 59870], [82, 60030], [85, 60150]]}, {"verse": 8, "start": 61371, "end": 73658, "text": "Oye pues ahora esto, delicada, la que está sentada confiadamente, la que dice en su corazón: Yo soy, y fuera de mí no hay más; no quedaré viuda, ni conoceré orfandad.", "words": [[0, 61371], [4, 61772], [9, 61812], [15, 62152], [21, 62912], [31, 63912], [34, 64092], [38, 64252], [43, 64432], [51, 64932], [66, 66132], [69, 66312], [73, 66472], [78, 66732], [81, 66872], [84, 66992], [93, 68201], [96, 68340], [101, 68620], [103, 68980], [109, 69200], [112, 69400], [115, 69600], [118, 69880], [122, 70020], [127, 71038], [130, 71318], [138, 71678], [145, 72278], [148, 72538], [157, 73058]]}, {"verse": 9, "start": 74339, "end": 87853, "text": "Estas dos cosas te vendrán de repente en un mismo día, orfandad y viudez: en toda su perfección vendrán sobre ti, por la multitud de tus adivinanzas, y por la copia de tus muchos agüeros.", "words": [[0, 74339], [6, 74764], [10, 74904], [16, 75404], [19, 75664], [27, 76104], [30, 76204], [38, 76624], [41, 76984], [44, 77104], [50, 77384], [55, 78284], [64, 79104], [66, 79629], [74, 80696], [77, 80853], [82, 81053], [85, 81293], [96, 81913], [104, 82393], [110, 82633], [114, 83313], [118, 83573], [121, 83713], [130, 84253], [133, 84413], [137, 84553], [150, 85533], [152, 85873], [156, 86033], [159, 86173], [165, 86493], [168, 86613], [172, 86773], [179, 87073]]}, {"verse": 10, "start": 88572, "end": 99155, "text": "Porque te confiaste en tu maldad, diciendo: Nadie me ve. Tu sabiduría y tu misma ciencia te engañaron, y dijiste en tu corazón: Yo, y no más.", "words": [[0, 88653], [7, 88773], [10, 88873], [20, 89453], [23, 89613], [26, 89713], [34, 90113], [44, 91447], [50, 91848], [53, 91988], [57, 92890], [60, 92974], [70, 93634], [72, 93714], [75, 93834], [81, 94034], [89, 94614], [92, 94774], [103, 95374], [105, 95914], [113, 96374], [116, 96514], [119, 96614], [128, 97833], [132, 98175], [134, 98535], [137, 98675]]}, {"verse": 11, "start": 99841, "end": 112286, "text": "Vendrá pues sobre ti mal, cuyo nacimiento no sabrás: caerá sobre ti quebrantamiento, el cual no podrás remediar: y destrucción que no sabrás, vendrá de repente sobre ti.", "words": [[0, 99841], [7, 100205], [12, 100525], [18, 100705], [21, 101025], [26, 101205], [31, 101685], [42, 102245], [45, 102425], [53, 104185], [59, 104569], [65, 104789], [68, 105109], [85, 106629], [88, 106689], [93, 106909], [96, 107089], [103, 107529], [113, 108745], [115, 108846], [127, 109546], [131, 109686], [134, 109826], [142, 110586], [149, 111006], [152, 111106], [160, 111466], [166, 111826]]}, {"verse": 12, "start": 112984, "end": 124011, "text": "Estáte ahora en tus encantamientos, y con la multitud de tus agüeros, en los cuales te fatigaste desde tu niñez; quizá podrás mejorarte, quizá te fortificarás.", "words": [[0, 112984], [7, 113483], [13, 113823], [16, 114063], [20, 114203], [36, 115243], [38, 115803], [42, 115983], [45, 116103], [54, 116663], [57, 116823], [61, 116963], [70, 117603], [73, 117883], [77, 118003], [84, 118323], [87, 118563], [97, 119203], [103, 119443], [106, 119723], [113, 120877], [119, 121181], [126, 121561], [137, 122581], [143, 122881], [146, 123001]]}, {"verse": 13, "start": 124706, "end": 139098, "text": "Te has fatigado en la multitud de tus consejos. Aparezcan ahora y te defiendan los contempladores de los cielos, los especuladores de las estrellas, los que contaban los meses, para pronosticar lo que vendrá sobre ti.", "words": [[0, 124706], [3, 124810], [7, 124970], [16, 125650], [19, 125790], [22, 125870], [31, 126470], [34, 126630], [38, 126790], [48, 128227], [58, 128868], [64, 129248], [66, 129728], [69, 129848], [79, 130468], [83, 130608], [98, 131448], [101, 131608], [105, 131728], [113, 132808], [117, 132888], [131, 133668], [134, 133868], [138, 133988], [149, 135068], [153, 135308], [157, 135448], [166, 135948], [170, 136108], [177, 136528], [182, 137108], [194, 137888], [197, 137968], [201, 138088], [208, 138468], [214, 138688]]}, {"verse": 14, "start": 139790, "end": 151249, "text": "He aquí que serán como tamo; fuego los quemará, no salvarán sus vidas del poder de la llama; no quedará brasa para calentarse, ni lumbre a la cual se sienten.", "words": [[0, 139841], [3, 139931], [8, 140191], [12, 140411], [18, 140771], [23, 140971], [29, 142040], [35, 142363], [39, 142663], [48, 143663], [51, 143763], [60, 144423], [64, 144623], [70, 145083], [74, 145263], [80, 145603], [83, 145823], [86, 145943], [93, 147037], [96, 147199], [104, 147599], [110, 148019], [115, 148259], [127, 149079], [130, 149579], [137, 149999], [139, 150099], [142, 150159], [147, 150359], [150, 150599]]}, {"verse": 15, "start": 151932, "end": 161116, "text": "Así te serán aquellos con quienes te fatigaste, tus negociantes desde tu niñez: cada uno echará por su camino, no habrá quien te salve.", "words": [[0, 151932], [4, 152154], [7, 152314], [13, 152654], [22, 152994], [26, 153374], [34, 153594], [37, 153794], [48, 154934], [52, 155034], [64, 155774], [70, 156054], [73, 156314], [80, 157515], [85, 157696], [89, 158036], [96, 158596], [100, 158756], [103, 158916], [111, 159716], [114, 159896], [120, 160176], [126, 160316], [129, 160496]]}]}