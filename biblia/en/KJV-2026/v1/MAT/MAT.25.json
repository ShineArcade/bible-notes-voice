{"book": "MAT", "chapter": 25, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 315669, "verses": [{"verse": 1, "start": 300, "end": 6789, "text": "Then shall the kingdom of heaven be likened to ten virgins, which took their lamps, and went forth to meet the bridegroom.", "words": [[0, 300], [5, 528], [11, 808], [15, 968], [23, 1228], [26, 1448], [33, 1708], [36, 1968], [44, 2408], [47, 2488], [51, 2688], [60, 3528], [66, 3688], [71, 3908], [77, 4128], [84, 4928], [88, 5068], [93, 5248], [99, 5568], [102, 5828], [107, 5968], [111, 6128]]}, {"verse": 2, "start": 7239, "end": 10067, "text": "And five of them were wise, and five were foolish.", "words": [[0, 7239], [4, 7365], [9, 7605], [12, 7765], [17, 7945], [22, 8065], [28, 8445], [32, 8945], [37, 9225], [42, 9445]]}, {"verse": 3, "start": 10517, "end": 13757, "text": "They that were foolish took their lamps, and took no oil with them:", "words": [[0, 10517], [5, 10621], [10, 10761], [15, 10901], [23, 11221], [28, 11501], [34, 11701], [41, 12061], [45, 12521], [50, 12721], [53, 12921], [57, 13201], [62, 13461]]}, {"verse": 4, "start": 14207, "end": 16844, "text": "But the wise took oil in their vessels with their lamps.", "words": [[0, 14207], [4, 14307], [8, 14427], [13, 14707], [18, 15007], [22, 15327], [25, 15547], [31, 15647], [39, 15927], [44, 16207], [50, 16307]]}, {"verse": 5, "start": 17294, "end": 20291, "text": "While the bridegroom was delayed, they all slumbered and slept.", "words": [[0, 17294], [6, 17399], [10, 17519], [21, 17979], [25, 18139], [34, 18919], [39, 19039], [43, 19159], [53, 19699], [57, 19779]]}, {"verse": 6, "start": 20741, "end": 26103, "text": "And at mid night there was a cry made Behold the bridegroom comes go you out to meet him", "words": [[0, 20741], [4, 20863], [7, 21050], [11, 21236], [17, 21423], [23, 21763], [27, 21923], [29, 22043], [33, 22403], [38, 22683], [45, 23703], [49, 23763], [60, 24363], [66, 24763], [69, 24963], [73, 25123], [77, 25343], [80, 25543], [85, 25723]]}, {"verse": 7, "start": 26553, "end": 29807, "text": "Then all those virgins arose, and trimmed their lamps.", "words": [[0, 26553], [5, 26692], [9, 26912], [15, 27132], [23, 27592], [30, 28052], [34, 28612], [42, 28912], [48, 29152]]}, {"verse": 8, "start": 30257, "end": 34725, "text": "And the foolish said to the wise, Give us of your oil; for our lamps are gone out.", "words": [[0, 30257], [4, 30375], [8, 30475], [16, 30755], [21, 31075], [24, 31235], [28, 31335], [34, 32035], [39, 32175], [42, 32335], [45, 32455], [50, 32575], [55, 33305], [59, 33429], [63, 33569], [69, 33869], [73, 34049], [78, 34229]]}, {"verse": 9, "start": 35175, "end": 43235, "text": "But the wise answered, saying, Not so; lest there be not enough for us and you: but go rather to them that sell, and buy for yourselves.", "words": [[0, 35175], [4, 35255], [8, 35375], [13, 35595], [23, 36035], [31, 36615], [35, 36835], [39, 37623], [44, 37806], [50, 37966], [53, 38066], [57, 38266], [64, 38506], [68, 38726], [71, 38886], [75, 39026], [80, 39671], [84, 39791], [87, 40011], [94, 40291], [97, 40531], [102, 40771], [107, 40991], [113, 41411], [117, 41911], [121, 42251], [125, 42471]]}, {"verse": 10, "start": 43685, "end": 50638, "text": "And while they went to buy, the bridegroom came; and they that were ready went in with him to the marriage: and the door was shut.", "words": [[0, 43685], [4, 43790], [10, 43990], [15, 44170], [20, 44330], [23, 44470], [28, 45090], [32, 45190], [43, 45690], [49, 46514], [53, 46694], [58, 46854], [63, 47054], [68, 47174], [74, 47454], [79, 47734], [82, 47954], [87, 48134], [91, 48294], [94, 48414], [98, 48534], [108, 49446], [112, 49565], [116, 49665], [121, 49945], [125, 50145]]}, {"verse": 11, "start": 51088, "end": 55145, "text": "Afterward came also the other virgins, saying, Lord, Lord, open to us.", "words": [[0, 51088], [10, 51466], [15, 51746], [20, 52046], [24, 52246], [30, 52426], [39, 52886], [47, 53466], [53, 54026], [59, 54346], [64, 54566], [67, 54826]]}, {"verse": 12, "start": 55595, "end": 59247, "text": "But he answered and said, Assuredly I say to you, I know you not.", "words": [[0, 55595], [4, 55701], [7, 55801], [16, 56141], [20, 56381], [26, 56841], [36, 57481], [38, 57561], [42, 57741], [45, 57901], [50, 58321], [52, 58441], [57, 58641], [61, 58801]]}, {"verse": 13, "start": 59697, "end": 64503, "text": "Watch therefore, for you know neither the day nor the hour in which the Son of man comes.", "words": [[0, 59697], [6, 59990], [17, 60490], [21, 60790], [25, 60930], [30, 61130], [38, 61350], [42, 61590], [46, 61870], [50, 62110], [54, 62270], [59, 62590], [62, 62830], [68, 62990], [72, 63190], [76, 63430], [79, 63530], [83, 63810]]}, {"verse": 14, "start": 64953, "end": 72021, "text": "¶ For the kingdom of heaven is as a man travelling into a far country, who called his own servants, and delivered to them his goods.", "words": [[2, 64953], [6, 65064], [10, 65164], [18, 65464], [21, 65704], [28, 65964], [31, 66224], [34, 66384], [36, 66504], [40, 66884], [51, 67264], [56, 67584], [58, 67764], [62, 68004], [71, 68444], [75, 68944], [82, 69224], [86, 69444], [90, 69624], [100, 70024], [104, 70564], [114, 70884], [117, 71104], [122, 71304], [126, 71464]]}, {"verse": 15, "start": 72471, "end": 81315, "text": "And to one he gave five talents, to another two, and to another one; to every man according to his several ability; and immediately took his journey.", "words": [[0, 72471], [4, 72652], [7, 72812], [11, 73132], [14, 73372], [19, 73552], [24, 73892], [33, 74752], [36, 74852], [44, 75132], [49, 75772], [53, 75912], [56, 76112], [64, 76352], [69, 77076], [72, 77196], [78, 77456], [82, 77776], [92, 78116], [95, 78376], [99, 78516], [107, 78776], [116, 79711], [120, 79855], [132, 80195], [137, 80655], [141, 80855]]}, {"verse": 16, "start": 81765, "end": 87571, "text": "Then he that had received the five talents went and traded with the same, and made them other five talents.", "words": [[0, 81765], [5, 81910], [8, 82210], [13, 82550], [17, 82690], [26, 83070], [30, 83310], [35, 83550], [43, 83950], [48, 84250], [52, 84510], [59, 84790], [64, 85010], [68, 85190], [74, 85510], [78, 85990], [83, 86190], [88, 86410], [94, 86630], [99, 86950]]}, {"verse": 17, "start": 88021, "end": 91726, "text": "And likewise he that had received two, he also gained other two.", "words": [[0, 88021], [4, 88146], [13, 88766], [16, 88866], [21, 89026], [25, 89186], [34, 89466], [39, 90266], [42, 90386], [47, 90646], [54, 90986], [60, 91266]]}, {"verse": 18, "start": 92176, "end": 96703, "text": "But he that had received one went and dug in the earth, and hid his lord’s money.", "words": [[0, 92176], [4, 92278], [7, 92478], [12, 92678], [16, 92818], [25, 93178], [29, 93578], [34, 93998], [38, 94238], [42, 94498], [45, 94658], [49, 94778], [56, 95078], [60, 95438], [64, 95698], [68, 95898], [75, 96338]]}, {"verse": 19, "start": 97153, "end": 101220, "text": "After a long time the lord of those servants comes, and reckons with them.", "words": [[0, 97153], [6, 97395], [8, 97575], [13, 97755], [18, 98435], [22, 98515], [27, 98775], [30, 98895], [36, 99055], [45, 99415], [52, 99795], [56, 100255], [64, 100695], [69, 100895]]}, {"verse": 20, "start": 101670, "end": 112615, "text": "And so he that had received five talents came and brought other five talents, saying, Lord, you delivered to me five talents: behold, I have gained beside them five talents more.", "words": [[0, 101670], [4, 101791], [7, 102091], [10, 102411], [15, 102711], [19, 102891], [28, 103291], [33, 103731], [41, 104151], [46, 104491], [50, 104711], [58, 104911], [64, 105191], [69, 105471], [78, 106011], [86, 106691], [92, 107291], [96, 107351], [106, 107691], [109, 107931], [112, 108071], [117, 108371], [126, 109347], [134, 110128], [136, 110308], [141, 110448], [148, 110728], [155, 111008], [160, 111388], [165, 111688], [173, 112068]]}, {"verse": 21, "start": 113065, "end": 124152, "text": "His lord said to him, Well done, you good and faithful servant: you have been faithful over a few things, I will make you ruler over many things: enter into the joy of your lord.", "words": [[0, 113115], [4, 113205], [9, 113425], [14, 113705], [17, 113905], [22, 114405], [27, 114745], [33, 115505], [37, 115645], [42, 115985], [46, 116225], [55, 116605], [64, 117529], [68, 117670], [73, 117850], [78, 118050], [87, 118470], [92, 118770], [94, 118950], [98, 119110], [106, 119770], [108, 119950], [113, 120110], [118, 120310], [122, 120490], [128, 120810], [133, 121130], [138, 121430], [146, 122343], [152, 122602], [157, 122942], [161, 123102], [165, 123402], [168, 123582], [173, 123682]]}, {"verse": 22, "start": 124602, "end": 134121, "text": "He also that had received two talents came and said, Lord, you delivered to me two talents: behold, I have gained two other talents beside them.", "words": [[0, 124602], [3, 124701], [8, 125041], [13, 125321], [17, 125461], [26, 125801], [30, 126101], [38, 126501], [43, 126881], [47, 127121], [53, 127741], [59, 128561], [63, 128661], [73, 129021], [76, 129261], [79, 129441], [83, 129681], [92, 130677], [100, 131478], [102, 131738], [107, 131898], [114, 132218], [118, 132518], [124, 132798], [132, 133218], [139, 133618]]}, {"verse": 23, "start": 134571, "end": 146109, "text": "His lord said to him, Well done, good and faithful servant; you have been faithful over a few things, I will make you ruler over many things: enter into the joy of your lord.", "words": [[0, 134633], [4, 134723], [9, 134963], [14, 135243], [17, 135443], [22, 135963], [27, 136323], [33, 137123], [38, 137663], [42, 137730], [51, 137796], [60, 139397], [64, 139597], [69, 139777], [74, 139937], [83, 140337], [88, 140637], [90, 140837], [94, 140957], [102, 141737], [104, 141997], [109, 142137], [114, 142337], [118, 142497], [124, 142837], [129, 143157], [134, 143437], [142, 144424], [148, 144689], [153, 144929], [157, 145089], [161, 145349], [164, 145529], [169, 145629]]}, {"verse": 24, "start": 146459, "end": 157638, "text": "Then he which had received the one talent came and said, Lord, I knew you that you are a hard man, reaping where you have not sown, and gathering where you have not scattered:", "words": [[0, 146459], [5, 146724], [8, 147224], [14, 147404], [18, 147604], [27, 147984], [31, 148304], [35, 148544], [42, 149104], [47, 149324], [51, 149664], [57, 150349], [63, 150836], [65, 151036], [70, 151336], [74, 151816], [79, 151976], [83, 152176], [87, 152376], [89, 152476], [94, 152736], [99, 153576], [107, 154036], [113, 154196], [117, 154356], [122, 154496], [126, 154696], [132, 155596], [136, 155716], [146, 156076], [152, 156416], [156, 156596], [161, 156736], [165, 156936]]}, {"verse": 25, "start": 158088, "end": 164099, "text": "And I was afraid, and went and hid your talent in the earth: lo, there you have that is yours.", "words": [[0, 158088], [4, 158247], [6, 158407], [10, 158567], [18, 159267], [22, 159627], [27, 159867], [31, 160147], [35, 160327], [40, 160507], [47, 160867], [50, 161087], [54, 161227], [61, 162188], [65, 162538], [71, 162638], [75, 162818], [80, 163258], [85, 163338], [88, 163498]]}, {"verse": 26, "start": 164549, "end": 172771, "text": "His lord answered and said to him, You wicked and slothful servant, you knew that I reap where I sowed not, and gather where I have not scattered:", "words": [[0, 164549], [4, 164709], [9, 164949], [18, 165409], [22, 165649], [27, 165849], [30, 166009], [35, 166689], [39, 166949], [46, 167309], [50, 167529], [59, 168029], [68, 168909], [72, 168989], [77, 169189], [82, 169389], [84, 169529], [89, 169749], [95, 169989], [97, 170149], [103, 170509], [108, 171049], [112, 171189], [119, 171469], [125, 171709], [127, 171869], [132, 172009], [136, 172169]]}, {"verse": 27, "start": 173221, "end": 180593, "text": "You ought therefore to have put my money to the exchangers, and then at my coming I should have received my own with usury.", "words": [[0, 173221], [4, 173399], [10, 173599], [20, 174059], [23, 174279], [28, 174439], [32, 174659], [35, 174879], [41, 175199], [44, 175359], [48, 175499], [60, 176719], [64, 176919], [69, 177119], [72, 177279], [75, 177439], [82, 177799], [84, 178259], [91, 178439], [96, 178559], [105, 178919], [108, 179279], [112, 179639], [117, 179899]]}, {"verse": 28, "start": 181043, "end": 185604, "text": "Take therefore the talent from him, and give it to him which has ten talents.", "words": [[0, 181043], [5, 181238], [15, 181678], [19, 181938], [26, 182278], [31, 182558], [36, 183198], [40, 183398], [45, 183578], [48, 183718], [51, 183898], [55, 184138], [61, 184358], [65, 184598], [69, 184898]]}, {"verse": 29, "start": 186054, "end": 194202, "text": "For to every one that has shall be given, and he shall have abundance: but from him that has not shall be taken away even that which he has.", "words": [[0, 186054], [4, 186162], [7, 186309], [13, 186455], [17, 186602], [22, 187042], [26, 187262], [32, 187542], [35, 187742], [42, 188302], [46, 188562], [49, 188722], [55, 188942], [60, 189142], [71, 190204], [75, 190301], [80, 190501], [84, 190721], [89, 190921], [93, 191061], [97, 191381], [103, 191841], [106, 192001], [112, 192261], [117, 192601], [122, 193001], [127, 193301], [133, 193501], [136, 193661]]}, {"verse": 30, "start": 194652, "end": 200164, "text": "And cast the unprofitable servant into outer darkness: there shall be weeping and gnashing of teeth.", "words": [[0, 194652], [4, 194755], [9, 195055], [13, 195255], [26, 195975], [34, 196375], [39, 196735], [45, 197015], [55, 198073], [61, 198157], [67, 198317], [70, 198477], [78, 198897], [82, 199097], [91, 199517], [94, 199677]]}, {"verse": 31, "start": 200614, "end": 208616, "text": "¶ When the Son of man shall come in his glory, and all the holy angels with him, then shall he sit upon the throne of his glory:", "words": [[2, 200614], [7, 200784], [11, 200904], [15, 201184], [18, 201304], [22, 201644], [28, 201944], [33, 202204], [36, 202344], [40, 202484], [47, 203344], [51, 203504], [55, 203864], [59, 204024], [64, 204284], [71, 204744], [76, 205084], [81, 205664], [86, 206004], [92, 206324], [95, 206504], [99, 206784], [104, 207124], [108, 207404], [115, 207724], [118, 207944], [122, 208064]]}, {"verse": 32, "start": 209066, "end": 216557, "text": "And before him shall be gathered all nations: and he shall separate them one from another, as a shepherd divides his sheep from the goats:", "words": [[0, 209066], [4, 209188], [11, 209488], [15, 209728], [21, 209948], [24, 210088], [33, 210408], [37, 210768], [46, 211767], [50, 211872], [53, 211992], [59, 212172], [68, 212612], [73, 212912], [77, 213152], [82, 213372], [91, 213992], [94, 214332], [96, 214432], [105, 214712], [113, 215112], [117, 215432], [123, 215692], [128, 215932], [132, 216092]]}, {"verse": 33, "start": 217007, "end": 220937, "text": "And he shall set the sheep on his right hand, but the goats on the left.", "words": [[0, 217007], [4, 217132], [7, 217292], [13, 217492], [17, 217752], [21, 217932], [27, 218172], [30, 218392], [34, 218572], [40, 218792], [46, 219492], [50, 219732], [54, 219872], [60, 220092], [63, 220352], [67, 220472]]}, {"verse": 34, "start": 221387, "end": 230211, "text": "Then shall the King say to them on his right hand, Come, you blessed of my Father, inherit the kingdom prepared for you from the foundation of the world:", "words": [[0, 221387], [5, 221623], [11, 221903], [15, 222083], [20, 222283], [24, 222583], [27, 222763], [32, 222963], [35, 223123], [39, 223323], [45, 223523], [51, 224323], [57, 225083], [61, 225183], [69, 225483], [72, 225703], [75, 225883], [83, 226723], [91, 227003], [95, 227303], [103, 227583], [112, 227983], [116, 228323], [120, 228483], [125, 228683], [129, 228823], [140, 229323], [143, 229563], [147, 229683]]}, {"verse": 35, "start": 230661, "end": 238039, "text": "For I was hungry, and you gave me food: I was thirsty, and you gave me drink: I was a stranger, and you took me in:", "words": [[0, 230661], [4, 230799], [6, 230999], [10, 231159], [18, 231739], [22, 232079], [26, 232199], [31, 232359], [34, 232519], [40, 233373], [42, 233494], [46, 233654], [55, 234074], [59, 234474], [63, 234574], [68, 234734], [71, 234894], [78, 235814], [80, 236134], [84, 236274], [86, 236374], [96, 236814], [100, 237194], [104, 237314], [109, 237454], [112, 237654]]}, {"verse": 36, "start": 238489, "end": 244133, "text": "Naked, and you clothed me: I was sick, and you visited me: I was in prison, and you came to me.", "words": [[0, 238489], [7, 238869], [11, 239229], [15, 239469], [23, 239709], [27, 240300], [29, 240444], [33, 240624], [39, 240904], [43, 241104], [47, 241224], [55, 241504], [59, 242252], [61, 242397], [65, 242537], [68, 242697], [76, 242977], [80, 243257], [84, 243397], [89, 243637], [92, 243837]]}, {"verse": 37, "start": 244583, "end": 251308, "text": "Then shall the righteous answer him, saying, Lord, when saw we you hungry, and fed you? or thirsty, and gave you drink?", "words": [[0, 244583], [5, 244766], [11, 245026], [15, 245186], [25, 245466], [32, 245906], [37, 246226], [45, 246666], [51, 247426], [56, 247566], [60, 247826], [63, 248026], [67, 248146], [75, 248506], [79, 248726], [83, 248966], [88, 249681], [91, 249801], [100, 250181], [104, 250501], [109, 250701], [113, 250841]]}, {"verse": 38, "start": 251758, "end": 256137, "text": "When saw we you a stranger, and took you in? or naked, and clothed you?", "words": [[0, 251758], [5, 251897], [9, 252177], [12, 252417], [16, 252597], [18, 252717], [28, 253157], [32, 253577], [37, 253777], [41, 253937], [45, 254647], [48, 254771], [55, 255131], [59, 255331], [67, 255871]]}, {"verse": 39, "start": 256587, "end": 259848, "text": "Or when saw we you sick, or in prison, and came to you?", "words": [[0, 256587], [3, 256710], [8, 256910], [12, 257170], [15, 257390], [19, 257550], [25, 257890], [28, 258290], [31, 258430], [39, 258730], [43, 259110], [48, 259350], [51, 259530]]}, {"verse": 40, "start": 260298, "end": 269375, "text": "And the King shall answer and say to them, Assuredly I say to you, Inasmuch as you have done it to one of the least of these my brethren, you have done it to me.", "words": [[0, 260298], [4, 260440], [8, 260560], [13, 260800], [19, 261060], [26, 261460], [30, 261660], [34, 261900], [37, 262060], [43, 262620], [53, 263260], [55, 263460], [59, 263680], [62, 263880], [67, 264700], [76, 265100], [79, 265260], [83, 265400], [88, 265500], [93, 265720], [96, 265820], [99, 265960], [103, 266100], [106, 266220], [110, 266320], [116, 266600], [119, 266780], [125, 267140], [128, 267220], [138, 268132], [142, 268315], [147, 268515], [152, 268755], [155, 268895], [158, 269055]]}, {"verse": 41, "start": 269825, "end": 277806, "text": "Then shall he say also to them on the left hand, Depart from me, you cursed, into everlasting fire, prepared for the devil and his angels:", "words": [[0, 269825], [5, 270030], [11, 270290], [14, 270450], [18, 270650], [23, 270990], [26, 271190], [31, 271370], [34, 271550], [38, 271670], [43, 271870], [49, 272550], [56, 272810], [61, 273130], [65, 273450], [69, 273570], [77, 274310], [82, 274450], [94, 274910], [100, 275930], [109, 276230], [113, 276450], [117, 276570], [123, 276850], [127, 277050], [131, 277210]]}, {"verse": 42, "start": 278256, "end": 283247, "text": "For I was hungry, and you gave me no food: I was thirsty, and you gave me no drink:", "words": [[0, 278256], [4, 278456], [6, 278716], [10, 278856], [18, 279236], [22, 279656], [26, 279756], [31, 279916], [34, 280076], [37, 280236], [43, 281093], [45, 281202], [49, 281342], [58, 281742], [62, 282142], [66, 282262], [71, 282402], [74, 282562], [77, 282722]]}, {"verse": 43, "start": 283697, "end": 291176, "text": "I was a stranger, and you took me not in: naked, and you clothed me not: sick, and in prison, and you visited me not.", "words": [[0, 283697], [2, 283803], [6, 283903], [8, 284003], [18, 284403], [22, 284963], [26, 285083], [31, 285223], [34, 285383], [38, 285563], [42, 286363], [49, 286793], [53, 287093], [57, 287213], [65, 287813], [68, 287933], [73, 288781], [79, 289104], [83, 289304], [86, 289444], [94, 289744], [98, 290004], [102, 290124], [110, 290444], [113, 290724]]}, {"verse": 44, "start": 291626, "end": 301394, "text": "Then shall they also answer him, saying, Lord, when saw we you hungry, or thirsty, or a stranger, or naked, or sick, or in prison, and did not minister to you?", "words": [[0, 291626], [5, 291860], [11, 292100], [16, 292280], [21, 292580], [28, 293000], [33, 293420], [41, 293920], [47, 294660], [52, 294820], [56, 295120], [59, 295320], [63, 295480], [71, 296080], [74, 296140], [83, 296880], [86, 296900], [88, 296920], [98, 297760], [101, 297800], [108, 298360], [111, 298420], [117, 298920], [120, 298960], [123, 299080], [131, 299960], [135, 300068], [139, 300208], [143, 300388], [152, 300808], [155, 301068]]}, {"verse": 45, "start": 301844, "end": 309330, "text": "Then shall he answer them, saying, Assuredly I say to you, Inasmuch as you did it not to one of the least of these, you did it not to me.", "words": [[0, 301844], [5, 302017], [11, 302317], [14, 302477], [21, 302777], [27, 303117], [35, 303757], [45, 304337], [47, 304477], [51, 304717], [54, 304877], [59, 305417], [68, 305937], [71, 306097], [75, 306217], [79, 306397], [82, 306497], [86, 306697], [89, 306897], [93, 307037], [96, 307137], [100, 307237], [106, 307437], [109, 307597], [116, 308177], [120, 308297], [124, 308457], [127, 308577], [131, 308777], [134, 308977]]}, {"verse": 46, "start": 309780, "end": 315269, "text": "And these shall go away into everlasting punishment: but the righteous into life eternal.", "words": [[0, 309780], [4, 309921], [10, 310141], [16, 310441], [19, 310641], [24, 311041], [29, 311401], [41, 311901], [53, 313209], [57, 313294], [61, 313434], [71, 313854], [76, 314214], [81, 314554]]}]}