{"book": "GEN", "chapter": 23, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 182135, "verses": [{"verse": 1, "start": 300, "end": 6214, "text": "Y fue la vida de Sara ciento veintisiete años: tantos fueron los años de la vida de Sara.", "words": [[0, 300], [2, 424], [6, 584], [9, 724], [14, 944], [17, 1144], [22, 1477], [29, 1811], [41, 2144], [47, 3631], [54, 4138], [61, 4358], [65, 4638], [70, 4978], [73, 5178], [76, 5278], [81, 5478], [84, 5678]]}, {"verse": 2, "start": 6664, "end": 16669, "text": "Y murió Sara en Quiriat-arba, que es Hebrón, en la tierra de Canaán: y vino Abraham a hacer el duelo a Sara, y a llorarla.", "words": [[0, 6664], [2, 6791], [8, 7111], [13, 7471], [16, 8191], [30, 8911], [34, 8951], [37, 9171], [45, 10051], [48, 10271], [51, 10391], [58, 10711], [61, 11247], [69, 12026], [71, 12173], [76, 12453], [84, 13133], [86, 13793], [92, 14093], [95, 14313], [101, 14673], [103, 14873], [109, 15213], [111, 15773], [113, 16247]]}, {"verse": 3, "start": 17119, "end": 23255, "text": "Y se levantó Abraham de delante de su muerto, y habló a los hijos de Het, diciendo:", "words": [[0, 17119], [2, 17226], [5, 17346], [13, 17926], [21, 18426], [24, 18686], [32, 19126], [35, 19286], [38, 19446], [46, 20006], [48, 20666], [54, 21126], [56, 21246], [60, 21406], [66, 21686], [69, 21966], [74, 22246]]}, {"verse": 4, "start": 23505, "end": 31527, "text": "Extranjero y forastero soy entre vosotros; dadme heredad de sepultura con vosotros, y sepultaré mi muerto de delante de mí.", "words": [[0, 23505], [11, 24266], [13, 24676], [23, 25086], [27, 25326], [33, 25686], [43, 26839], [49, 27257], [57, 27677], [60, 27777], [70, 28317], [74, 28557], [84, 29137], [86, 29437], [96, 29997], [99, 30137], [106, 30537], [109, 30677], [117, 31097], [120, 31257]]}, {"verse": 5, "start": 31877, "end": 36931, "text": "Y respondieron los hijos de Het a Abraham, y le dijeron:", "words": [[0, 31877], [2, 32002], [15, 32722], [19, 32942], [25, 33282], [28, 33652], [32, 34022], [34, 34402], [43, 35062], [45, 35982], [48, 36122]]}, {"verse": 6, "start": 37181, "end": 48928, "text": "Oyenos, señor mío, eres un príncipe de Dios entre nosotros; en lo mejor de nuestras sepulturas sepulta a tu muerta; ninguno de nosotros te impedirá su sepultura, para que entierres a tu muerta.", "words": [[0, 37181], [8, 37565], [14, 37845], [19, 38665], [24, 38865], [27, 39105], [36, 39625], [39, 39785], [44, 39985], [50, 40265], [60, 41362], [63, 41481], [66, 41561], [72, 41881], [75, 42041], [84, 42281], [95, 42891], [103, 43501], [105, 43581], [108, 43661], [116, 44589], [124, 44998], [127, 45098], [136, 45498], [139, 45738], [148, 46198], [151, 46558], [162, 46918], [167, 47518], [171, 47678], [181, 48138], [183, 48258], [186, 48338]]}, {"verse": 7, "start": 49278, "end": 56034, "text": "Y Abraham se levantó, y se inclinó al pueblo de aquella tierra, a los hijos de Het;", "words": [[0, 49278], [2, 49416], [10, 49856], [13, 50156], [22, 50916], [24, 51596], [27, 51986], [35, 52376], [38, 52536], [45, 52836], [48, 53176], [56, 53516], [64, 53936], [66, 54596], [70, 54736], [76, 55076], [79, 55555]]}, {"verse": 8, "start": 56484, "end": 65537, "text": "Y habló con ellos, diciendo: Si tenéis voluntad que yo sepulte mi muerto de delante de mí, oídme, e interceded por mí con Efrón, hijo de Zohar,", "words": [[0, 56484], [2, 56611], [8, 56931], [12, 57091], [19, 57391], [29, 58668], [32, 58789], [39, 59129], [48, 59669], [52, 59809], [55, 59929], [63, 60489], [66, 60569], [73, 60949], [76, 61089], [84, 61469], [87, 61629], [91, 62269], [98, 62669], [100, 63049], [111, 63649], [115, 63809], [118, 63969], [122, 64129], [129, 64789], [134, 64909], [137, 65254]]}, {"verse": 9, "start": 65987, "end": 74595, "text": "Para que me dé la cueva de Macpela, que tiene al extremo de su heredad: que por su justo precio me la dé, para posesión de sepultura en medio de vosotros.", "words": [[0, 65987], [5, 66141], [9, 66281], [12, 66401], [15, 66521], [18, 66681], [24, 67041], [27, 67121], [36, 67701], [40, 67881], [46, 68161], [49, 68301], [57, 68821], [60, 68901], [63, 69081], [72, 69811], [76, 69891], [80, 70091], [83, 70271], [89, 70531], [96, 70951], [99, 71151], [102, 71291], [106, 71511], [111, 72071], [120, 72631], [123, 72751], [133, 73311], [136, 73451], [142, 73671], [145, 73851]]}, {"verse": 10, "start": 74945, "end": 88650, "text": "Este Efrón se hallaba entre los hijos de Het: y respondió Efrón heteo a Abraham, en oídos de los hijos de Het, de todos los que entraban por la puerta de su ciudad, diciendo:", "words": [[0, 74945], [5, 75234], [11, 75934], [14, 76114], [22, 76594], [28, 76874], [32, 77094], [38, 77394], [41, 77817], [46, 78487], [48, 78592], [58, 79252], [64, 79912], [70, 80212], [72, 80512], [81, 81592], [84, 81732], [90, 82292], [93, 82452], [97, 82592], [103, 82932], [106, 83582], [111, 84232], [114, 84392], [120, 84752], [124, 85232], [128, 85432], [137, 86072], [141, 86312], [144, 86452], [151, 86772], [154, 87052], [157, 87212], [165, 87672]]}, {"verse": 11, "start": 88900, "end": 98111, "text": "No, señor mío, óyeme: te doy la heredad, y te doy también la cueva que está en ella; delante de los hijos de mi pueblo te la doy; sepulta tu muerto.", "words": [[0, 88900], [4, 89197], [10, 89357], [15, 89977], [22, 90730], [25, 90813], [29, 91053], [32, 91153], [41, 91713], [43, 92033], [46, 92153], [50, 92373], [58, 92633], [61, 92813], [67, 93153], [71, 93253], [76, 93453], [79, 93593], [85, 94280], [93, 94706], [96, 94866], [100, 94986], [106, 95226], [109, 95406], [112, 95506], [119, 95866], [122, 96046], [125, 96186], [130, 97038], [138, 97318], [141, 97418]]}, {"verse": 12, "start": 98461, "end": 102162, "text": "Y Abraham se inclinó delante del pueblo de la tierra.", "words": [[0, 98461], [2, 98584], [10, 98944], [13, 99384], [21, 100124], [29, 100584], [33, 100804], [40, 101184], [43, 101404], [46, 101524]]}, {"verse": 13, "start": 102612, "end": 114275, "text": "Y respondió a Efrón en oídos del pueblo de la tierra, diciendo: Antes, si te place, te ruego que me oigas; yo daré el precio de la heredad, tómalo de mí, y sepultaré en ella mi muerto.", "words": [[0, 102612], [2, 102736], [12, 103476], [14, 103736], [20, 104236], [23, 104556], [29, 104936], [33, 105056], [40, 105296], [43, 105536], [46, 105656], [54, 105936], [64, 106971], [71, 107207], [74, 107477], [77, 107577], [84, 108397], [87, 108457], [93, 108777], [97, 108937], [100, 109077], [107, 109982], [110, 110165], [115, 110405], [118, 110485], [125, 110785], [128, 110965], [131, 111065], [140, 111685], [147, 112005], [150, 112125], [154, 112285], [156, 112665], [166, 113265], [169, 113405], [174, 113545], [177, 113745]]}, {"verse": 14, "start": 114625, "end": 118112, "text": "Y respondió Efrón a Abraham, diciéndole:", "words": [[0, 114625], [2, 114752], [12, 115412], [18, 115972], [20, 116172], [29, 117192]]}, {"verse": 15, "start": 118362, "end": 125605, "text": "Señor mío, escúchame: la tierra vale cuatrocientos siclos de plata: ¿qué es esto entre mí y ti? entierra pues tu muerto.", "words": [[0, 118362], [6, 118647], [11, 119167], [22, 119989], [25, 120094], [32, 120354], [37, 120841], [51, 121327], [58, 121814], [61, 121934], [68, 122742], [73, 122866], [76, 123046], [81, 123266], [87, 123466], [90, 123686], [92, 123766], [96, 124492], [105, 124652], [110, 124812], [113, 124972]]}, {"verse": 16, "start": 125955, "end": 139637, "text": "Entonces Abraham se convino con Efrón, y pesó Abraham a Efrón el dinero que dijo, oyéndolo los hijos de Het, cuatrocientos siclos de plata, de buena ley entre mercaderes.", "words": [[0, 125955], [9, 126477], [17, 127017], [20, 127497], [28, 127977], [32, 128177], [39, 128577], [41, 129297], [46, 129697], [54, 130377], [56, 130617], [62, 131097], [65, 131357], [72, 131677], [76, 131877], [82, 132777], [91, 133397], [95, 133597], [101, 133917], [104, 134507], [109, 135097], [123, 135747], [130, 136397], [133, 136537], [140, 136937], [143, 13