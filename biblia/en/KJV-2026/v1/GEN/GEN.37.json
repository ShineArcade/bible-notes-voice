{"book": "GEN", "chapter": 37, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 308953, "verses": [{"verse": 1, "start": 300, "end": 5450, "text": "And Jacob dwelt in the land in which his father was a stranger, in the land of Canaan.", "words": [[0, 300], [4, 446], [10, 786], [16, 1226], [19, 1426], [23, 1546], [28, 1826], [31, 2006], [37, 2226], [41, 2406], [48, 2806], [52, 3086], [54, 3226], [64, 3686], [67, 4266], [71, 4366], [76, 4646], [79, 4786]]}, {"verse": 2, "start": 5900, "end": 21377, "text": "These are the generations of Jacob. Joseph, being seventeen years old, was feeding the flock with his brethren; and the lad was with the sons of Bilhah, and with the sons of Zilpah, his father’s wives: and Joseph brought to his father their evil report.", "words": [[0, 5900], [6, 6145], [10, 6365], [14, 6465], [26, 7085], [29, 7365], [36, 8260], [44, 8760], [50, 9090], [60, 9420], [66, 9760], [71, 10520], [75, 10680], [83, 10980], [87, 11200], [93, 11480], [98, 11780], [102, 11900], [112, 12906], [116, 13051], [120, 13171], [124, 13471], [128, 13731], [133, 13911], [137, 14051], [142, 14351], [145, 14551], [153, 15171], [157, 15631], [162, 15771], [166, 15911], [171, 16171], [174, 16351], [182, 16871], [186, 17051], [195, 17511], [202, 18481], [206, 18615], [213, 18955], [221, 19295], [224, 19515], [228, 19675], [235, 20055], [241, 20375], [246, 20715]]}, {"verse": 3, "start": 21827, "end": 29438, "text": "Now Israel loved Joseph more than all his children, because he was the son of his old age: and he made him a coat of many colours.", "words": [[0, 21827], [4, 22016], [11, 22396], [17, 22816], [24, 23156], [29, 23516], [34, 23696], [38, 23876], [42, 24076], [52, 24556], [60, 25076], [63, 25296], [67, 25456], [71, 25616], [75, 25856], [78, 25976], [82, 26116], [86, 26336], [91, 27213], [95, 27349], [98, 27449], [103, 27669], [107, 27829], [109, 27949], [114, 28229], [117, 28449], [122, 28978]]}, {"verse": 4, "start": 29888, "end": 38117, "text": "And when his brethren saw that their father loved him more than all his brethren, they hated him, and could not speak peaceably to him.", "words": [[0, 29888], [4, 30033], [9, 30193], [13, 30393], [22, 30853], [26, 31353], [31, 31633], [37, 31793], [44, 32113], [50, 32513], [54, 32713], [59, 33013], [64, 33193], [68, 33533], [72, 33753], [82, 34753], [87, 34993], [93, 35373], [98, 35693], [102, 36153], [108, 36353], [112, 36573], [118, 36893], [128, 37513], [131, 37733]]}, {"verse": 5, "start": 38567, "end": 44240, "text": "¶ And Joseph dreamed a dream, and he told it his brethren: and they hated him yet the more.", "words": [[2, 38567], [6, 38706], [13, 39086], [21, 39626], [23, 39786], [30, 40426], [34, 40726], [37, 40826], [42, 41106], [45, 41306], [49, 41466], [59, 42489], [63, 42635], [68, 42795], [74, 43075], [78, 43295], [82, 43435], [86, 43615]]}, {"verse": 6, "start": 44690, "end": 48667, "text": "And he said to them, Hear, please, this dream which I have dreamed:", "words": [[0, 44690], [4, 44807], [7, 44907], [12, 45127], [15, 45307], [21, 46177], [27, 46427], [35, 46907], [40, 47087], [46, 47467], [52, 47707], [54, 47907], [59, 48067]]}, {"verse": 7, "start": 49117, "end": 60717, "text": "For, behold, we were binding sheaves in the field, and, lo, my sheaf arose, and also stood upright; and, behold, your sheaves stood round about, and made obeisance to my sheaf.", "words": [[0, 49117], [5, 49227], [13, 49987], [16, 50167], [21, 50307], [29, 50707], [37, 51287], [40, 51467], [44, 51567], [51, 52087], [56, 52227], [60, 52687], [63, 52807], [69, 53207], [76, 54087], [80, 54187], [85, 54487], [91, 54827], [100, 55838], [105, 55984], [113, 56604], [118, 56724], [126, 57224], [132, 57504], [138, 57844], [145, 58444], [149, 58824], [154, 59044], [164, 59664], [167, 59904], [170, 60104]]}, {"verse": 8, "start": 61167, "end": 71406, "text": "And his brethren said to him, Shall you indeed reign over us? or shall you indeed have dominion over us? And they hated him yet the more for his dreams, and for his words.", "words": [[0, 61167], [4, 61273], [8, 61413], [17, 61753], [22, 62093], [25, 62313], [30, 62853], [36, 63133], [40, 63373], [47, 63693], [53, 64033], [58, 64313], [62, 65119], [65, 65226], [71, 65446], [75, 65646], [82, 65926], [87, 66246], [96, 66786], [101, 66966], [105, 67779], [109, 67925], [114, 68065], [120, 68325], [124, 68565], [128, 68765], [132, 68965], [137, 69205], [141, 69405], [145, 69585], [153, 70025], [157, 70405], [161, 70585], [165, 70765]]}, {"verse": 9, "start": 71856, "end": 84181, "text": "¶ And he dreamed yet another dream, and told it his brethren, and said, Behold, I have dreamed a dream more; and, behold, the sun and the moon and the eleven stars made obeisance to me.", "words": [[2, 71856], [6, 71981], [9, 72101], [17, 72481], [21, 72781], [29, 73221], [36, 73661], [40, 74181], [45, 74401], [48, 74601], [52, 74761], [62, 75181], [66, 75521], [72, 76367], [80, 77214], [82, 77454], [87, 77614], [95, 77914], [97, 78094], [103, 78374], [109, 79256], [114, 79400], [122, 80220], [126, 80440], [130, 80820], [134, 81060], [138, 81200], [143, 81500], [147, 81760], [151, 81880], [158, 82180], [164, 82640], [169, 83020], [179, 83600], [182, 83840]]}, {"verse": 10, "start": 84631, "end": 96842, "text": "And he told it to his father, and to his brethren: and his father rebuked him, and said to him, What is this dream that you have dreamed? Shall I and your mother and your brethren indeed come to bow down ourselves to you to the earth?", "words": [[0, 84631], [4, 84752], [7, 84892], [12, 85112], [15, 85292], [18, 85452], [22, 85632], [30, 86032], [34, 86712], [37, 86912], [41, 87072], [51, 88033], [55, 88158], [59, 88298], [66, 88658], [74, 89318], [79, 89438], [83, 89598], [88, 89858], [91, 90058], [96, 90698], [101, 90843], [104, 90983], [109, 91243], [115, 91463], [120, 91643], [124, 91763], [129, 91883], [138, 92663], [144, 92889], [146, 93129], [150, 93249], [155, 93349], [162, 93609], [166, 93769], [171, 93889], [180, 94189], [187, 94609], [192, 94889], [195, 95029], [199, 95229], [204, 95469], [214, 95809], [217, 96089], [221, 96249], [224, 96389], [228, 96529]]}, {"verse": 11, "start": 97192, "end": 101022, "text": "And his brethren envied him; but his father observed the saying.", "words": [[0, 97192], [4, 97330], [8, 97470], [17, 97850], [24, 98450], [29, 99127], [33, 99246], [37, 99386], [44, 99726], [53, 100266], [57, 100466]]}, {"verse": 12, "start": 101472, "end": 104581, "text": "¶ And his brethren went to feed their father’s flock in Shechem.", "words": [[2, 101472], [6, 101609], [10, 101749], [19, 102089], [24, 102369], [27, 102569], [32, 102769], [38, 102969], [47, 103349], [53, 103689], [56, 104170]]}, {"verse": 13, "start": 105031, "end": 113657, "text": "And Israel said to Joseph, Do not your brethren feed the flock in Shechem? come, and I will send you to them. And he said to him, Here am I.", "words": [[0, 105031], [4, 105194], [11, 105514], [16, 105834], [19, 105994], [27, 106860], [30, 107006], [34, 107206], [39, 107446], [48, 107786], [53, 108126], [57, 108286], [63, 108546], [66, 108726], [75, 109536], [81, 109677], [85, 109997], [87, 110117], [92, 110257], [97, 110517], [101, 110697], [104, 110877], [110, 111553], [114, 111675], [117, 111795], [122, 112035], [125, 112255], [130, 112858], [135, 113038], [138, 113238]]}, {"verse": 14, "start": 114107, "end": 125712, "text": "And he said to him, Go, please, see whether it be well with your brethren, and well with the flocks; and bring me word again. So he sent him out of the vale of Hebron, and he came to Shechem.", "words": [[0, 114107], [4, 114233], [7, 114313], [12, 114553], [15, 114773], [20, 115402], [24, 115563], [32, 116343], [36, 116583], [44, 116843], [47, 117003], [50, 117143], [55, 117403], [60, 117583], [65, 117703], [75, 118083], [79, 118623], [84, 118863], [89, 119043], [93, 119163], [101, 120032], [105, 120177], [111, 120397], [114, 120577], [119, 120777], [126, 122042], [129, 122160], [132, 122300], [137, 122580], [141, 122760], [145, 122940], [148, 123060], [152, 123250], [157, 123440], [160, 123600], [168, 124480], [172, 124560], [175, 124700], [180, 124940], [183, 125363]]}, {"verse": 15, "start": 126162, "end": 133812, "text": "¶ And a certain man found him, and, behold, he was wandering in the field: and the man asked him, saying, What do you seek?", "words": [[2, 126162], [6, 126306], [8, 126406], [16, 126626], [20, 126946], [26, 127346], [31, 127966], [36, 128066], [44, 128706], [47, 128786], [51, 128946], [61, 129346], [64, 129586], [68, 129686], [75, 130497], [79, 130604], [83, 130684], [87, 130904], [93, 131264], [98, 131504], [106, 132931], [111, 133091], [114, 133211], [118, 133311]]}, {"verse": 16, "start": 134162, "end": 138969, "text": "And he said, I seek my brethren: tell me, please, where they feed their flocks.", "words": [[0, 134162], [4, 134290], [7, 134390], [13, 135485], [15, 135485], [20, 135485], [23, 135651], [33, 136664], [38, 136825], [42, 137105], [50, 137566], [56, 137686], [61, 137846], [66, 138105], [72, 138306]]}, {"verse": 17, "start": 139419, "end": 149550, "text": "And the man said, They are departed from here; for I heard them say, Let us go to Dothan. And Joseph went after his brethren, and found them in Dothan.", "words": [[0, 139419], [4, 139538], [8, 139638], [12, 139838], [18, 140418], [23, 140678], [27, 140818], [36, 141278], [41, 141618], [47, 142420], [51, 142543], [53, 142803], [59, 143083], [64, 143283], [69, 143923], [73, 144143], [76, 144323], [79, 144523], [82, 144967], [90, 145711], [94, 145853], [101, 146193], [106, 146553], [112, 146833], [116, 147013], [126, 147413], [130, 148033], [136, 148353], [141, 148553], [144, 149085]]}, {"verse": 18, "start": 150000, "end": 156779, "text": "And when they saw him afar off, even before he came near to them, they conspired against him to slay him.", "words": [[0, 150000], [4, 150145], [9, 150285], [14, 150445], [18, 150745], [22, 150965], [27, 151305], [32, 152145], [37, 152425], [44, 152825], [47, 153025], [52, 153285], [57, 153525], [60, 153725], [66, 154385], [71, 154545], [81, 155245], [89, 155545], [93, 155845], [96, 156005], [101, 156445]]}, {"verse": 19, "start": 157229, "end": 161206, "text": "And they said one to another, Behold, this dreamer comes.", "words": [[0, 157229], [4, 157368], [9, 157468], [14, 157688], [18, 157948], [21, 158128], [30, 158928], [38, 159908], [43, 160068], [51, 160548]]}, {"verse": 20, "start": 161656, "end": 171371, "text": "Come now therefore, and let us slay him, and cast him into some pit, and we will say, Some evil beast has devoured him: and we shall see what will become of his dreams.", "words": [[0, 161656], [5, 161821], [9, 162201], [20, 162761], [24, 162841], [28, 163001], [31, 163141], [36, 163601], [41, 163741], [45, 164161], [50, 164481], [54, 164701], [59, 164861], [64, 165121], [69, 165601], [73, 165681], [76, 165841], [81, 166021], [86, 166321], [91, 166821], [96, 167121], [102, 167481], [106, 167721], [115, 168221], [120, 168819], [124, 168959], [127, 169119], [133, 169319], [137, 169619], [142, 169879], [147, 169999], [154, 170299], [157, 170539], [161, 170679]]}, {"verse": 21, "start": 171821, "end": 177502, "text": "And Reuben heard it, and he delivered him out of their hands; and said, Let us not kill him.", "words": [[0, 171821], [4, 171963], [11, 172303], [17, 172543], [21, 173083], [25, 173183], [28, 173283], [38, 173643], [42, 173883], [46, 174043], [49, 174143], [55, 174303], [62, 175221], [66, 175541], [72, 176266], [76, 176476], [79, 176676], [83, 176876], [88, 177176]]}, {"verse": 22, "start": 177852, "end": 189369, "text": "And Reuben said to them, Shed no blood, but cast him into this pit that is in the wilderness, and lay no hand upon him; that he might rid him out of their hands, to deliver him to his father again.", "words": [[0, 177852], [4, 178084], [11, 178354], [16, 178574], [19, 178774], [25, 180416], [30, 180572], [33, 180852], [40, 181132], [44, 181332], [49, 181632], [53, 181812], [58, 181992], [63, 182212], [67, 182452], [72, 182652], [75, 182792], [78, 182892], [82, 182992], [94, 183392], [98, 184112], [102, 184312], [105, 184572], [110, 184872], [115, 185112], [120, 185866], [125, 186036], [128, 186156], [134, 186386], [138, 186616], [142, 186776], [146, 186896], [149, 186996], [155, 187156], [162, 187496], [165, 187936], [173, 188196], [177, 188416], [180, 188536], [184, 188676], [191, 188936]]}, {"verse": 23, "start": 189719, "end": 199503, "text": "¶ And it came to pass, when Joseph was come to his brethren, that they stripped Joseph out of his coat, his coat of many colours that was on him;", "words": [[2, 189719], [6, 189860], [9, 189980], [14, 190200], [17, 190380], [23, 190760], [28, 191080], [35, 191460], [39, 191780], [44, 192040], [47, 192220], [51, 192420], [61, 192880], [66, 193480], [71, 193680], [80, 193980], [87, 194500], [91, 194860], [94, 195000], [98, 195120], [104, 195880], [108, 196040], [113, 196300], [116, 196460], [121, 196790], [129, 197120], [134, 197420], [138, 197580], [141, 197820]]}, {"verse": 24, "start": 199953, "end": 205380, "text": "And they took him, and cast him into a pit: and the pit was empty, there was no water in it.", "words": [[0, 199953], [4, 200097], [9, 200217], [14, 200477], [19, 200717], [23, 201157], [28, 201457], [32, 201697], [37, 201897], [39, 202057], [44, 202767], [48, 202893], [52, 202993], [56, 203173], [60, 203433], [67, 204053], [73, 204113], [77, 204293], [80, 204513], [86, 204853], [89, 205073]]}, {"verse": 25, "start": 205830, "end": 218969, "text": "And they sat down to eat bread: and they lifted up their eyes and looked, and, behold, a company of Ishmeelites came from Gilead with their camels bearing spicery and balm and myrrh, going to carry it down to Egypt.", "words": [[0, 205830], [4, 206110], [9, 206230], [13, 206490], [18, 206790], [21, 206970], [25, 207110], [32, 207987], [36, 208133], [41, 208233], [48, 208493], [51, 208713], [57, 208873], [62, 209193], [66, 209393], [74, 210013], [79, 210153], [87, 210403], [89, 210653], [97, 210993], [100, 211463], [112, 211933], [117, 212173], [122, 212433], [129, 212993], [134, 213133], [140, 213293], [147, 213793], [155, 214293], [163, 214793], [167, 215013], [172, 215373], [176, 215757], [183, 216371], [189, 216731], [192, 216871], [198, 217111], [201, 217271], [206, 217491], [209, 217651]]}, {"verse": 26, "start": 219419, "end": 224661, "text": "And Judah said to his brethren, What profit is it if we slay our brother, and conceal his blood?", "words": [[0, 219419], [4, 219592], [10, 219872], [15, 220172], [18, 220372], [22, 220512], [32, 221431], [37, 221577], [44, 221977], [47, 222257], [50, 222357], [53, 222497], [56, 222617], [61, 222917], [65, 223037], [74, 223337], [78, 223577], [86, 223957], [90, 224177]]}, {"verse": 27, "start": 225111, "end": 233812, "text": "Come, and let us sell him to the Ishmeelites, and let not our hand be upon him; for he is our brother and our flesh. And his brethren were content.", "words": [[0, 225111], [6, 225295], [10, 225715], [14, 225835], [17, 225955], [22, 226235], [26, 226395], [29, 226555], [33, 226965], [46, 227375], [50, 227715], [54, 227895], [58, 228155], [62, 228375], [67, 228635], [70, 228775], [75, 229075], [80, 229762], [84, 229888], [87, 230088], [90, 230348], [94, 230488], [102, 230808], [106, 231168], [110, 231288], [117, 232223], [121, 232368], [125, 232488], [134, 232868], [139, 233148]]}, {"verse": 28, "start": 234262, "end": 245779, "text": "Then there passed by Midianites merchantmen; and they drew and lifted up Joseph out of the pit, and sold Joseph to the Ishmeelites for twenty pieces of silver: and they brought Joseph into Egypt.", "words": [[0, 234262], [5, 234459], [11, 234689], [18, 234989], [21, 235229], [32, 235869], [45, 237005], [49, 237130], [54, 237250], [59, 237590], [63, 237930], [70, 238250], [73, 238450], [80, 238810], [84, 239190], [87, 239290], [91, 239410], [96, 239690], [100, 240170], [105, 240430], [112, 240930], [115, 241110], [119, 241500], [131, 241890], [135, 242140], [142, 242390], [149, 242770], [152, 242990], [160, 243890], [164, 244019], [169, 244119], [177, 244399], [184, 244799], [189, 245139]]}, {"verse": 29, "start": 246229, "end": 252462, "text": "¶ And Reuben returned to the pit; and, behold, Joseph was not in the pit; and he tore his clothes.", "words": [[2, 246229], [6, 246498], [13, 246798], [22, 247218], [25, 247418], [29, 247498], [34, 248193], [39, 248338], [47, 249118], [54, 249538], [58, 249858], [62, 250098], [65, 250278], [69, 250378], [74, 251043], [78, 251165], [81, 251285], [86, 251505], [90, 251705]]}, {"verse": 30, "start": 252912, "end": 258081, "text": "And he returned to his brethren, and said, The child is not; and I, where shall I go?", "words": [[0, 252912], [4, 253172], [7, 253272], [16, 253672], [19, 253852], [23, 253972], [33, 254352], [37, 254672], [43, 255297], [47, 255360], [53, 255720], [56, 255940], [61, 256677], [65, 256793], [68, 257273], [74, 257413], [80, 257613], [82, 257753]]}, {"verse": 31, "start": 258431, "end": 263267, "text": "And they took Joseph’s coat, and killed a kid of the goats, and dipped the coat in the blood;", "words": [[0, 258431], [4, 258552], [9, 258652], [14, 258852], [23, 259412], [29, 259632], [33, 260072], [40, 260292], [42, 260472], [46, 260672], [49, 260772], [53, 260912], [60, 261232], [64, 261812], [71, 262032], [75, 262272], [80, 262512], [83, 262712], [87, 262812]]}, {"verse": 32, "start": 263717, "end": 272662, "text": "And they sent the coat of many colours, and they brought it to their father; and said, This have we found: know now whether it be your son’s coat or no.", "words": [[0, 263717], [4, 263845], [9, 263945], [14, 264145], [18, 264335], [23, 264525], [26, 264685], [31, 265005], [40, 265325], [44, 265905], [49, 266005], [57, 266205], [60, 266365], [63, 266485], [69, 266625], [77, 267475], [81, 267609], [87, 267909], [92, 268189], [97, 268409], [100, 268589], [107, 269449], [112, 269717], [116, 270077], [124, 270417], [127, 270597], [130, 270817], [135, 270997], [141, 271397], [146, 271697], [149, 272197]]}, {"verse": 33, "start": 273112, "end": 280720, "text": "And he knew it, and said, It is my son’s coat; an evil beast has devoured him; Joseph is without doubt torn to pieces.", "words": [[0, 273112], [4, 273278], [7, 273438], [12, 273678], [16, 273838], [20, 274078], [26, 274755], [29, 274859], [32, 274959], [35, 275099], [41, 275559], [47, 276322], [50, 276464], [55, 276664], [61, 277004], [65, 277264], [74, 277804], [79, 278449], [86, 278767], [89, 279007], [97, 279247], [103, 279607], [108, 279907], [111, 280087]]}, {"verse": 34, "start": 281070, "end": 287722, "text": "And Jacob tore his clothes, and put sackcloth upon his loins, and mourned for his son many days.", "words": [[0, 281070], [4, 281216], [10, 281536], [15, 281896], [19, 282136], [28, 282556], [32, 283156], [36, 283356], [46, 284096], [51, 284336], [55, 284636], [62, 285136], [66, 285636], [74, 286056], [78, 286196], [82, 286396], [86, 286676], [91, 286936]]}, {"verse": 35, "start": 288172, "end": 302106, "text": "And all his sons and all his daughters rose up to comfort him; but he refused to be comforted; and he said, For I will go down into the grave to my son mourning. Thus his father wept for him.", "words": [[0, 288172], [4, 288452], [8, 288672], [12, 288852], [17, 289232], [21, 289532], [25, 289712], [29, 289912], [39, 290292], [44, 290672], [47, 290972], [50, 291132], [58, 291432], [63, 292687], [67, 292813], [70, 292893], [78, 293313], [81, 293493], [84, 293613], [95, 294469], [99, 294592], [102, 294712], [108, 295389], [112, 295498], [114, 295678], [119, 295898], [122, 296058], [127, 296338], [132, 296538], [136, 296718], [142, 297058], [145, 297298], [148, 298258], [152, 299218], [162, 300528], [167, 300688], [171, 300808], [178, 301168], [183, 301568], [187, 301748]]}, {"verse": 36, "start": 3025