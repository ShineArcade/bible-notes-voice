{"book": "JHN", "chapter": 5, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 376906, "verses": [{"verse": 1, "start": 300, "end": 7120, "text": "Después de estas cosas, era un día de fiesta de los judíos, y subió Jesús a Jerusalén.", "words": [[0, 300], [8, 604], [11, 864], [17, 1084], [24, 2184], [28, 2504], [31, 2684], [35, 2844], [38, 3024], [45, 3484], [48, 3624], [52, 3804], [60, 4484], [62, 5004], [68, 5404], [74, 5784], [76, 6164]]}, {"verse": 2, "start": 7570, "end": 16794, "text": "Y hay en Jerusalén a la puerta del ganado un estanque, que en hebreo es llamado Betesda, el cual tiene cinco portales.", "words": [[0, 7570], [2, 7696], [6, 7836], [9, 8016], [19, 8796], [21, 8956], [24, 9076], [31, 9356], [35, 9656], [42, 10256], [45, 10516], [55, 11216], [59, 11896], [62, 12176], [69, 12636], [72, 12816], [80, 13476], [89, 14136], [92, 14316], [97, 14536], [103, 14956], [109, 15616]]}, {"verse": 3, "start": 17244, "end": 25969, "text": "En estos yacía multitud de enfermos, ciegos, cojos, con miembros atrofiados, que estaban esperando el movimiento del agua.", "words": [[0, 17244], [3, 17416], [9, 17996], [15, 18496], [24, 19176], [27, 19416], [37, 20556], [45, 21296], [52, 22276], [56, 22376], [65, 22876], [77, 23616], [81, 23816], [89, 24096], [99, 24476], [102, 24756], [113, 25156], [117, 25536]]}, {"verse": 4, "start": 26419, "end": 40482, "text": "Porque un ángel descendía a cierto tiempo al estanque, y revolvía el agua; y el que primero descendía en el estanque después del movimiento del agua, era sano de cualquier enfermedad que tuviese.", "words": [[0, 26419], [7, 26859], [10, 27079], [16, 27579], [26, 28279], [28, 28519], [35, 28779], [42, 29459], [45, 29759], [55, 30439], [57, 31029], [66, 31619], [69, 31819], [75, 32694], [77, 32840], [80, 32980], [84, 33140], [92, 33660], [102, 34540], [105, 34780], [108, 34920], [117, 35540], [125, 35860], [129, 36140], [140, 36660], [144, 37060], [150, 37420], [154, 37980], [159, 38340], [162, 38520], [172, 38820], [183, 39660], [187, 39780]]}, {"verse": 5, "start": 40932, "end": 45157, "text": "Y estaba allí un hombre que había treinta y ocho años que estaba enfermo.", "words": [[0, 40932], [2, 41040], [9, 41340], [14, 41660], [17, 41840], [24, 42160], [28, 42380], [34, 42580], [42, 42780], [44, 42980], [49, 43180], [54, 43920], [58, 44140], [65, 44400]]}, {"verse": 6, "start": 45607, "end": 52760, "text": "Como Jesús vio a este echado, y entendió que ya había mucho tiempo, le dice: ¿Quieres ser sano?", "words": [[0, 45607], [5, 45771], [11, 46111], [15, 46791], [17, 47011], [22, 47331], [30, 48011], [32, 48631], [41, 49271], [45, 49451], [48, 49711], [54, 49891], [60, 50191], [68, 50751], [71, 50831], [77, 51619], [86, 51963], [90, 52123]]}, {"verse": 7, "start": 53060, "end": 61707, "text": "Señor, le respondió el enfermo, no tengo quien me meta en el estanque cuando el agua sea revuelta; y mientras voy, otro desciende antes que yo.", "words": [[0, 53060], [7, 53896], [10, 54018], [20, 54598], [23, 54718], [32, 55728], [35, 55875], [41, 56195], [47, 56395], [50, 56555], [55, 56815], [58, 56935], [61, 57035], [70, 57515], [77, 57735], [80, 57915], [85, 58115], [89, 58315], [99, 59292], [101, 59394], [110, 59694], [115, 60034], [120, 60474], [130, 60974], [136, 61174], [140, 61394]]}, {"verse": 8, "start": 62057, "end": 65570, "text": "Le dice Jesús: Levántate, toma tu lecho, y anda.", "words": [[0, 62057], [3, 62205], [8, 62445], [15, 63453], [26, 64158], [31, 64378], [34, 64568], [41, 64758], [43, 65098]]}, {"verse": 9, "start": 66020, "end": 73264, "text": "Y de inmediato aquel hombre fue sanado, y tomó su lecho, e iba andando. Y era sábado aquel día.", "words": [[0, 66020], [2, 66148], [5, 66248], [15, 66848], [21, 67128], [28, 67328], [32, 67568], [40, 68128], [42, 68668], [47, 68968], [50, 69068], [57, 69508], [59, 69928], [63, 70148], [72, 71210], [74, 71490], [78, 71690], [85, 72310], [91, 72830]]}, {"verse": 10, "start": 73714, "end": 81853, "text": "Entonces los judíos decían a aquel que había sido sanado: Sábado es: no te es lícito llevar tu lecho.", "words": [[0, 73714], [9, 74695], [13, 74935], [20, 75575], [27, 76415], [29, 76635], [35, 76975], [39, 77115], [45, 77355], [50, 77775], [58, 79101], [65, 79426], [69, 79993], [72, 80157], [75, 80410], [78, 80664], [85, 80917], [92, 81137], [95, 81377]]}, {"verse": 11, "start": 82203, "end": 86923, "text": "Les respondió: El que me sanó, él mismo me dijo: Toma tu lecho y anda.", "words": [[0, 82203], [4, 82356], [15, 83450], [18, 83573], [22, 83673], [25, 83813], [31, 84413], [34, 84553], [40, 84833], [43, 85013], [49, 85751], [54, 85972], [57, 86072], [63, 86372], [65, 86552]]}, {"verse": 12, "start": 87273, "end": 92121, "text": "Le preguntaron entonces: ¿Quién es el que te dijo: Toma tu lecho y anda?", "words": [[0, 87273], [3, 87398], [15, 88138], [25, 89506], [32, 89712], [35, 89812], [38, 89932], [42, 90032], [45, 90172], [51, 90898], [56, 91154], [59, 91254], [65, 91574], [67, 91754]]}, {"verse": 13, "start": 92471, "end": 101905, "text": "Y el que había sido sanado, no sabía quién fuese; porque Jesús se había apartado de la gente que estaba en aquel lugar.", "words": [[0, 92471], [2, 92638], [5, 92758], [9, 92938], [15, 93138], [20, 93538], [28, 94498], [31, 94838], [37, 95298], [43, 95598], [50, 96664], [57, 96888], [63, 97328], [66, 97588], [72, 97828], [81, 98568], [84, 98728], [87, 98848], [93, 99168], [97, 99368], [104, 99668], [107, 99828], [113, 100128]]}, {"verse": 14, "start": 102355, "end": 111643, "text": "Después le halló Jesús en el templo, y le dijo: He aquí, has sido sanado; no peques más, porque no te venga alguna cosa peor.", "words": [[0, 102355], [8, 102355], [11, 102565], [17, 103025], [23, 103485], [26, 103965], [29, 104105], [37, 104745], [39, 104845], [42, 104985], [48, 105880], [51, 105970], [57, 106320], [61, 106670], [66, 107030], [74, 108032], [77, 108218], [84, 108558], [89, 109318], [96, 109718], [99, 109918], [102, 110058], [108, 110358], [115, 110638], [120, 110998]]}, {"verse": 15, "start": 112093, "end": 116992, "text": "Él se fue, y dio aviso a los judíos, que Jesús era el que le había sanado.", "words": [[0, 112093], [3, 112240], [6, 112420], [11, 112700], [13, 112980], [17, 113200], [23, 113540], [25, 113680], [29, 113780], [37, 114580], [41, 114800], [47, 115100], [51, 115560], [54, 115720], [58, 115860], [61, 116020], [67, 116260]]}, {"verse": 16, "start": 117442, "end": 125180, "text": "Y por esta causa los judíos perseguían a Jesús, y procuraban matarle, porque hacía estas cosas en sábado.", "words": [[0, 117442], [2, 117583], [6, 117803], [11, 118063], [17, 118523], [21, 118803], [28, 119303], [39, 120003], [41, 120103], [48, 120443], [50, 121023], [61, 121723], [70, 122883], [77, 123283], [83, 123663], [89, 123923], [95, 124263], [98, 124543]]}, {"verse": 17, "start": 125630, "end": 131967, "text": "Y Jesús les respondió: Mi Padre hasta ahora trabaja, y yo trabajo.", "words": [[0, 125630], [2, 125980], [8, 126390], [12, 126800], [23, 127894], [26, 128039], [32, 128299], [38, 128679], [44, 128959], [53, 130219], [55, 130419], [58, 130559]]}, {"verse": 18, "start": 132417, "end": 144408, "text": "Entonces, por tanto, más procuraban los judíos matarle, porque no sólo quebrantaba el sábado, sino que también a su Padre llamaba Dios, haciéndose igual a Dios.", "words": [[0, 132417], [10, 133144], [14, 133224], [21, 134004], [25, 134784], [36, 135564], [40, 135724], [47, 136244], [56, 137004], [63, 137544], [66, 137804], [71, 138084], [83, 138864], [86, 139024], [94, 139884], [99, 140064], [103, 140264], [111, 140604], [113, 140744], [116, 140864], [122, 141124], [130, 141604], [136, 142324], [147, 143004], [153, 143484], [155, 143844]]}, {"verse": 19, "start": 144858, "end": 159979, "text": "Respondió entonces Jesús, y les dijo: De cierto, de cierto os digo: No puede el Hijo hacer nada de sí mismo, sino lo que ve hacer al Padre: porque todo lo que él hace, esto también hace el Hijo juntamente.", "words": [[0, 145138], [10, 145638], [19, 145898], [26, 146538], [28, 146898], [32, 147018], [38, 148126], [41, 148382], [49, 148638], [52, 148894], [59, 149150], [62, 149350], [68, 150203], [71, 150394], [77, 150754], [80, 151114], [85, 151394], [91, 151694], [96, 152174], [99, 152434], [102, 152634], [109, 153374], [114, 153614], [117, 153794], [121, 153914], [124, 154154], [130, 154274], [133, 154454], [140, 155289], [147, 155493], [152, 155933], [155, 156213], [159, 156393], [162, 156573], [168, 157133], [173, 157433], [181, 157833], [186, 158273], [189, 158653], [194, 158933]]}, {"verse": 20, "start": 160429, "end": 171134, "text": "Porque el Padre ama al Hijo, y le muestra todas las cosas que él hace; y mayores obras que estas le mostrará, de suerte que vosotros os maravilléis.", "words": [[0, 160429], [7, 160672], [10, 160832], [16, 161332], [20, 161612], [23, 161932], [29, 162252], [31, 162912], [34, 163032], [42, 163532], [48, 163792], [52, 164112], [58, 164452], [62, 164752], [65, 164952], [71, 165903], [73, 166011], [81, 166471], [87, 166771], [91, 167011], [97, 167251], [100, 167491], [110, 168151], [113, 168651], [120, 169131], [124, 169331], [133, 169851], [136, 170091]]}, {"verse": 21, "start": 171584, "end": 178484, "text": "Porque como el Padre levanta los muertos, y les da vida, así también el Hijo a los que quiere da vida.", "words": [[0, 171584], [7, 171828], [12, 172108], [15, 172288], [21, 172848], [29, 173368], [33, 173488], [42, 174108], [44, 174708], [48, 174828], [51, 175048], [57, 175948], [61, 176208], [69, 176495], [72, 176781], [77, 177068], [79, 177248], [83, 177348], [87, 177488], [94, 177738], [97, 177988]]}, {"verse": 22, "start": 178934, "end": 183663, "text": "Porque el Padre a nadie juzga, sino que todo el juicio dio al Hijo;", "words": [[0, 178934], [7, 179156], [10, 179336], [16, 179856], [18, 179976], [24, 180296], [31, 181196], [36, 181516], [40, 181716], [45, 181956], [48, 182216], [55, 182656], [59, 182956], [62, 183236]]}, {"verse": 23, "start": 184113, "end": 193118, "text": "Para que todos honren al Hijo como honran al Padre. El que no honra al Hijo, no honra al Padre que le envió.", "words": [[0, 184113], [5, 184256], [9, 184416], [15, 184696], [22, 185476], [25, 185816], [30, 186156], [35, 186476], [42, 187116], [45, 187316], [52, 188239], [55, 188361], [59, 188521], [62, 188701], [68, 189241], [71, 189481], [77, 190421], [80, 190581], [86, 191241], [89, 191461], [95, 192061], [99, 192201], [102, 192381]]}, {"verse": 24, "start": 193568, "end": 205664, "text": "De cierto, de cierto os digo: El que oye mi palabra, y cree al que me ha enviado, tiene vida eterna; y no vendrá a condenación, sino que pasó de muerte a vida.", "words": [[0, 193786], [3, 194042], [11, 194298], [14, 194554], [21, 194810], [24, 195010], [30, 195864], [33, 196023], [37, 196223], [41, 196603], [44, 196763], [53, 197323], [55, 197663], [60, 197963], [63, 198243], [67, 198423], [70, 198583], [73, 198703], [82, 199303], [88, 199923], [93, 200343], [101, 201629], [103, 201750], [106, 201870], [113, 202230], [115, 202330], [128, 203570], [133, 203930], [137, 204110], [142, 204410], [145, 204590], [152, 204910], [154, 205130]]}, {"verse": 25, "start": 206114, "end": 215785, "text": "De cierto, de cierto os digo: Vendrá hora, y ahora es, cuando los muertos oirán la voz del Hijo de Dios: y los que oyen vivirán.", "words": [[0, 206332], [3, 206588], [11, 206844], [14, 207100], [21, 207356], [24, 207556], [30, 208410], [37, 208856], [43, 209256], [45, 209736], [51, 209996], [55, 210336], [62, 210756], [66, 210996], [74, 211436], [80, 212096], [83, 212296], [87, 212576], [91, 212896], [96, 213176], [99, 213316], [105, 214269], [107, 214391], [111, 214531], [115, 214711], [120, 215280]]}, {"verse": 26, "start": 216235, "end": 222293, "text": "Porque como el Padre tiene vida en sí mismo, así dio también al Hijo que tuviese vida en sí mismo:", "words": [[0, 216235], [7, 216418], [12, 216698], [15, 216858], [21, 217278], [27, 217498], [32, 217818], [35, 217998], [38, 218178], [45, 219018], [49, 219358], [53, 219578], [61, 219938], [64, 220178], [69, 220478], [73, 220658], [81, 221098], [86, 221418], [89, 221618], [92, 221778]]}, {"verse": 27, "start": 222743, "end": 227491, "text": "Y también le dio poder de hacer juicio, en cuanto es el Hijo del hombre.", "words": [[0, 222743], [2, 222848], [10, 223188], [13, 223428], [17, 223608], [23, 223968], [26, 224208], [32, 224408], [40, 225108], [43, 225708], [50, 225928], [53, 226268], [56, 226428], [61, 226668], [65, 226928]]}, {"verse": 28, "start": 227941, "end": 235851, "text": "No os maravilléis de esto; porque vendrá hora, cuando todos los que están en los sepulcros oirán su voz;", "words": [[0, 227941], [3, 228352], [6, 228802], [18, 229252], [21, 229472], [27, 230342], [34, 230546], [41, 231026], [47, 231786], [54, 232146], [60, 232546], [64, 232846], [68, 233026], [74, 233266], [77, 233426], [81, 233566], [91, 234326], [97, 235046], [100, 235286]]}, {"verse": 29, "start": 236301, "end": 244648, "text": "Y los que hicieron bien, saldrán a resurrección de vida; pero los que hicieron mal, a resurrección de condenación.", "words": [[0, 236301], [2, 236423], [6, 236543], [10, 236723], [19, 237203], [25, 237543], [33, 238783], [35, 238943], [48, 239743], [51, 239923], [57, 240721], [62, 240946], [66, 241166], [70, 241346], [79, 241806], [84, 242206], [86, 242666], [99, 243466], [102, 243606]]}, {"verse": 30, "start": 245098, "end": 256663, "text": "No puedo yo de mí mismo hacer nada: como oigo, juzgo: y mi juicio es justo; porque no busco mi voluntad, sino la voluntad del que me envió, del Padre.", "words": [[0, 245098], [3, 245226], [9, 245486], [12, 245746], [15, 245906], [18, 246066], [24, 246366], [30, 246646], [36, 248023], [41, 248023], [47, 248739], [54, 249771], [56, 249896], [59, 249996], [66, 250436], [69, 250716], [76, 251619], [83, 251821], [86, 252021], [92, 252341], [95, 252501], [105, 253421], [110, 253641], [113, 253861], [122, 254581], [126, 254821], [130, 255001], [133, 255181], [140, 255801], [144, 256021]]}, {"verse": 31, "start": 257113, "end": 261583, "text": "Si yo doy testimonio de mí mismo, mi testimonio no es verdadero.", "words": [[0, 257113], [3, 257295], [6, 257495], [10, 257735], [21, 258375], [24, 258495], [27, 258635], [34, 259295], [37, 259435], [48, 260235], [51, 260495], [54, 260715]]}, {"verse": 32, "start": 262033, "end": 268428, "text": "Otro es el que da testimonio de mí; y sé que el testimonio que da de mí, es verdadero.", "words": [[0, 262033], [5, 262397], [8, 262577], [11, 262717], [15, 262877], [18, 263097], [29, 263897], [32, 264037], [36, 264690], [38, 264816], [41, 265036], [45, 265236], [48, 265436], [59, 266256], [63, 266376], [66, 266536], [69, 266696], [73, 266876], [76, 267496]]}, {"verse": 33, "start": 268878, "end": 273476, "text": "Vosotros enviasteis a Juan, y él dio testimonio a la verdad.", "words": [[0, 268878], [9, 269324], [20, 270204], [22, 270324], [28, 270644], [30, 271524], [33, 271744], [37, 271944], [48, 272704], [50, 272804], [53, 272884]]}, {"verse": 34, "start": 273926, "end": 280532, "text": "Pero yo no tomo el testimonio de hombre; pero digo esto, para que vosotros seáis salvos.", "words": [[0, 273926], [5, 274070], [8, 274250], [11, 274430], [16, 274810], [19, 274890], [30, 275510], [33, 275630], [41, 277872], [46, 277872], [51, 277872], [57, 277872], [62, 278042], [66, 278203], [75, 278823], [81, 279503]]}, {"verse": 35, "start": 280982, "end": 288152, "text": "Él era antorcha que ardía y alumbraba: y vosotros quisisteis alegraros por un tiempo en su luz.", "words": [[0, 280982], [3, 281353], [7, 281593], [16, 282413], [20, 282613], [26, 283093], [28, 283253], [39, 284381], [41, 284507], [50, 285007], [61, 285827], [71, 286507], [75, 286747], [78, 286907], [85, 287287], [88, 287507], [91, 287667]]}, {"verse": 36, "start": 288602, "end": 301492, "text": "Pero yo tengo mayor testimonio que el de Juan: porque las obras que el Padre me dio que cumpliese, las mismas obras que yo hago, dan testimonio de mí, que el Padre me haya enviado.", "words": [[0, 288602], [5, 288745], [8, 288905], [14, 289205], [20, 289545], [31, 290405], [35, 290585], [38, 291025], [41, 291185], [47, 292114], [54, 292338], [58, 292538], [64, 292898], [68, 293178], [71, 293358], [77, 293958], [80, 294118], [84, 294338], [88, 294498], [99, 295618], [103, 295718], [110, 296138], [116, 296438], [120, 296638], [123, 296878], [129, 297218], [133, 297758], [144, 298458], [147, 298598], [151, 298818], [155, 299338], [158, 299498], [164, 300218], [167, 300398], [172, 300678]]}, {"verse": 37, "start": 301942, "end": 310723, "text": "Y el que me envió, el Padre, él ha dado testimonio de mí. Ni nunca habéis oído su voz, ni habéis visto su aspecto.", "words": [[0, 301942], [2, 302104], [5, 302224], [9, 302424], [12, 302604], [19, 303023], [22, 303323], [29, 304244], [32, 304436], [35, 304630], [40, 304823], [51, 305583], [54, 305684], [58, 306392], [61, 306579], [67, 307079], [74, 307679], [79, 308019], [82, 308219], [87, 308999], [90, 309179], [97, 309519], [103, 309959], [106, 310259]]}, {"verse": 38, "start": 311173, "end": 318385, "text": "Ni tenéis su palabra permanente en vosotros; porque al que él envió, a este vosotros no creéis.", "words": [[0, 311447], [3, 311757], [10, 312177], [13, 312497], [21, 312857], [32, 313577], [35, 313717], [45, 314765], [52, 314967], [55, 315167], [59, 315307], [62, 315487], [69, 316207], [71, 316567], [76, 316747], [85, 317307], [88, 317527]]}, {"verse": 39, "start": 318835, "end": 329111, "text": "Examinad cuidadosamente las Escrituras, porque a vosotros os parece que en ellas tenéis la vida eterna; y ellas son las que dan testimonio de mí.", "words": [[0, 318835], [9, 319705], [24, 320625], [28, 320905], [40, 321885], [47, 322245], [49, 322405], [58, 323025], [61, 323465], [68, 323805], [72, 324085], [75, 324225], [81, 324445], [88, 324985], [91, 325165], [96, 325385], [104, 326575], [106, 326733], [112, 326973], [116, 327293], [120, 327513], [124, 327693], [128, 327873], [139, 328653], [142, 328773]]}, {"verse": 40, "start": 329561, "end": 331995, "text": "Y no queréis venir a mí, para que tengáis vida.", "words": [[0, 329561], [2, 329665], [5, 329785], [13, 330165], [19, 330385], [21, 330625], [25, 330745], [30, 330925], [34, 331085], [42, 331485]]}, {"verse": 41, "start": 332445, "end": 334355, "text": "Gloria de los hombres no recibo.", "words": [[0, 332445], [7, 332890], [10, 333010], [14, 333150], [22, 333470], [25, 333710]]}, {"verse": 42, "start": 334805, "end": 338273, "text": "Pero yo os conozco, que no tenéis amor de Dios en vosotros.", "words": [[0, 334805], [5, 334926], [8, 335166], [11, 335306], [20, 335806], [24, 335946], [27, 336086], [34, 336526], [39, 336806], [42, 337026], [47, 337266], [50, 337506]]}, {"verse": 43, "start": 338723, "end": 346520, "text": "Yo he venido en nombre de mi Padre, y no me recibís: si otro viene en su propio nombre, a aquel recibiréis.", "words": [[0, 338723], [3, 339063], [6, 339183], [13, 339543], [16, 339663], [23, 339963], [26, 340163], [29, 340303], [36, 340663], [38, 341223], [41, 341383], [44, 341483], [53, 342578], [56, 342739], [61, 342979], [67, 343319], [70, 343519], [73, 343699], [80, 343979], [88, 344439], [90, 344839], [96, 345299]]}, {"verse": 44, "start": 346970, "end": 355937, "text": "¿Cómo podéis vosotros creer, pues tomáis la gloria los unos de los otros, y no buscáis la gloria que de sólo Dios viene?", "words": [[0, 346970], [6, 347192], [13, 347732], [22, 348372], [29, 348972], [34, 349172], [41, 349812], [44, 350092], [51, 350712], [55, 350872], [60, 351112], [63, 351292], [67, 351432], [74, 351772], [76, 352332], [79, 352532], [87, 353112], [90, 353392], [97, 353892], [101, 354492], [104, 354632], [109, 354932], [114, 355252]]}, {"verse": 45, "start": 356387, "end": 364057, "text": "No penséis que yo os voy a acusar delante del Padre; hay quien os acusa, Moisés, en quien vosotros esperáis.", "words": [[0, 356387], [3, 356517], [11, 356957], [15, 357137], [18, 357377], [21, 357617], [25, 357857], [27, 358037], [34, 358517], [42, 358957], [46, 359177], [53, 360112], [57, 360341], [63, 360641], [66, 360941], [73, 361401], [81, 361901], [84, 362301], [90, 362541], [99, 363161]]}, {"verse": 46, "start": 364507, "end": 371183, "text": "Porque si vosotros creyeseis a Moisés, creeríais a mí; porque de mí escribió él.", "words": [[0, 364507], [7, 364691], [10, 364871], [19, 365521], [29, 366171], [31, 366311], [39, 367331], [49, 368111], [51, 368231], [55, 368832], [62, 369096], [65, 369336], [68, 369636], [77, 370616]]}, {"verse": 47, "start": 371633, "end": 376506, "text": "Y si a sus escritos no creéis, ¿cómo creeréis a mis palabras?", "words": [[0, 371633], [2, 371772], [5, 371932], [7, 372112], [11, 372332], [20, 372932], [23, 373252], [31, 374352], [37, 374692], [46, 375392], [48, 375492], [52, 375632]]}]}