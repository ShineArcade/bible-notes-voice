{"book": "REV", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 161727, "verses": [{"verse": 1, "start": 300, "end": 12331, "text": "Y yo me paré sobre la arena del mar, y vi una bestia subir del mar, que tenía siete cabezas y diez cuernos; y sobre sus cuernos diez diademas; y sobre las cabezas de ella nombre de blasfemia.", "words": [[0, 300], [2, 409], [5, 529], [8, 669], [13, 1049], [19, 1229], [22, 1469], [28, 1769], [32, 1989], [37, 2649], [39, 2729], [42, 2869], [46, 3049], [53, 3469], [59, 3669], [63, 3909], [68, 4189], [72, 4389], [78, 4709], [84, 5029], [92, 5649], [94, 5799], [99, 5949], [108, 6971], [110, 7071], [116, 7231], [120, 7451], [128, 8031], [133, 8611], [143, 9434], [145, 9542], [151, 9762], [155, 10002], [163, 10562], [166, 10702], [171, 10942], [178, 11322], [181, 11522]]}, {"verse": 2, "start": 12781, "end": 23350, "text": "Y la bestia que vi, era semejante a un leopardo, y sus pies como de oso, y su boca como boca de león. Y el dragón le dio su poder, y su trono, y gran autoridad.", "words": [[0, 12781], [2, 12883], [5, 12983], [12, 13423], [16, 13543], [20, 13783], [24, 14403], [34, 15043], [36, 15163], [39, 15263], [49, 15803], [51, 16303], [55, 16483], [60, 16723], [65, 17023], [68, 17203], [73, 17483], [75, 17983], [78, 18123], [83, 18423], [88, 18703], [93, 18983], [96, 19163], [102, 19950], [104, 20068], [107, 20168], [114, 20568], [117, 20708], [121, 20888], [124, 21008], [131, 21368], [133, 21568], [136, 21688], [143, 22128], [145, 22448], [150, 22628]]}, {"verse": 3, "start": 23800, "end": 31460, "text": "Y vi una de sus cabezas como herida de muerte, y su herida mortal fue curada: y se maravilló toda la tierra en pos de la bestia.", "words": [[0, 23800], [2, 23926], [5, 24066], [9, 24266], [12, 24386], [16, 24526], [24, 25126], [29, 25346], [36, 25686], [39, 25826], [47, 26186], [49, 26646], [52, 26806], [59, 27126], [66, 27506], [70, 27706], [78, 28611], [80, 28732], [83, 28852], [93, 29472], [98, 29632], [101, 29812], [108, 30152], [111, 30412], [115, 30592], [118, 30772], [121, 30872]]}, {"verse": 4, "start": 31910, "end": 41316, "text": "Y adoraron al dragón que había dado la autoridad a la bestia, y adoraron a la bestia, diciendo: ¿Quién es semejante a la bestia, y quién podrá luchar contra ella?", "words": [[0, 31910], [2, 32056], [11, 32536], [14, 32696], [21, 33136], [25, 33256], [31, 33436], [36, 33736], [39, 33916], [49, 34476], [51, 34576], [54, 34656], [62, 35176], [64, 35516], [73, 36016], [75, 36156], [78, 36196], [86, 36676], [96, 37705], [103, 37926], [106, 38066], [116, 38546], [118, 38626], [121, 38706], [129, 39546], [131, 39606], [137, 39786], [143, 40166], [150, 40486], [157, 40806]]}, {"verse": 5, "start": 41766, "end": 48322, "text": "Y le fue dada boca que hablaba palabras arrogantes y blasfemias: y le fue dada autoridad para actuar cuarenta y dos meses.", "words": [[0, 41766], [2, 41877], [5, 41977], [9, 42157], [14, 42437], [19, 42637], [23, 42857], [31, 43177], [40, 43497], [51, 44197], [53, 44337], [65, 45413], [67, 45518], [70, 45618], [74, 45758], [79, 45998], [89, 46498], [94, 46738], [101, 46953], [110, 47168], [112, 47383], [116, 47598]]}, {"verse": 6, "start": 48772, "end": 55421, "text": "Y abrió su boca en blasfemias contra Dios, para blasfemar su nombre, y su tabernáculo, y a los que moran en el cielo.", "words": [[0, 48772], [2, 48878], [8, 49138], [11, 49298], [16, 49558], [19, 49678], [30, 50278], [37, 50638], [43, 50938], [48, 51538], [58, 52118], [61, 52258], [69, 52598], [71, 52758], [74, 52878], [87, 53598], [89, 53998], [91, 54058], [95, 54198], [99, 54338], [105, 54718], [108, 54838], [111, 54958]]}, {"verse": 7, "start": 55871, "end": 63744, "text": "Y le fue dado hacer guerra contra los santos, y vencerlos. También le fue dada autoridad sobre toda tribu y pueblo y lengua y nación.", "words": [[0, 55871], [2, 55972], [5, 56072], [9, 56232], [14, 56512], [20, 56792], [27, 57052], [34, 57412], [38, 57612], [46, 58092], [48, 58192], [59, 59236], [67, 59494], [70, 59694], [74, 59914], [79, 60294], [89, 60894], [95, 61234], [100, 61554], [106, 62034], [108, 62134], [115, 62454], [117, 62654], [124, 63034], [126, 63114]]}, {"verse": 8, "start": 64194, "end": 73078, "text": "Y todos los que moran en la tierra le adoraron, cuyos nombres no están escritos en el libro de la vida del Cordero, el cual fue muerto desde el principio del mundo.", "words": [[0, 64194], [2, 64310], [8, 64510], [12, 64810], [16, 64990], [22, 65350], [25, 65450], [28, 65550], [35, 65890], [38, 66090], [48, 66730], [54, 66990], [62, 67330], [65, 67510], [71, 67750], [80, 68290], [83, 68530], [86, 68690], [92, 68890], [95, 69070], [98, 69170], [103, 69370], [107, 69550], [116, 70517], [119, 70658], [124, 70838], [128, 71078], [135, 71498], [141, 71678], [144, 71878], [154, 72338], [158, 72598]]}, {"verse": 9, "start": 73528, "end": 75358, "text": "Si alguno tiene oído, oiga.", "words": [[0, 73528], [3, 73642], [10, 73902], [16, 74162], [22, 74642]]}, {"verse": 10, "start": 75808, "end": 86350, "text": "El que lleva en cautividad, va en cautividad: el que a espada mata, es necesario que a espada sea muerto. Aquí está la perseverancia y la fe de los santos.", "words": [[0, 75808], [3, 75910], [7, 76030], [13, 76270], [16, 76410], [28, 76990], [31, 77470], [34, 77630], [46, 78773], [49, 78900], [53, 79020], [55, 79080], [62, 79440], [68, 79760], [71, 80280], [81, 80840], [85, 81040], [87, 81100], [94, 81460], [98, 81640], [106, 83535], [111, 83739], [116, 84039], [119, 84159], [133, 84999], [135, 85159], [138, 85259], [141, 85419], [144, 85559], [148, 85679]]}, {"verse": 11, "start": 86800, "end": 93616, "text": "Después vi otra bestia que subía de la tierra; y tenía dos cuernos semejantes a los de un cordero, pero hablaba como un dragón.", "words": [[0, 86800], [8, 87082], [11, 87342], [16, 87542], [23, 88002], [27, 88122], [33, 88462], [36, 88562], [39, 88682], [47, 89546], [49, 89629], [55, 89849], [59, 90089], [67, 90569], [78, 91149], [80, 91329], [84, 91449], [87, 91589], [90, 91689], [99, 92209], [104, 92349], [112, 92729], [117, 92949], [120, 93069]]}, {"verse": 12, "start": 94066, "end": 104712, "text": "Y ejerce todo el poder de la primera bestia en presencia de ella; y hace a la tierra y a los moradores de ella adorar la primera bestia, cuya herida mortal fue curada.", "words": [[0, 94066], [2, 94172], [9, 94612], [14, 94872], [17, 95072], [23, 95312], [26, 95492], [29, 95612], [37, 95932], [44, 96452], [47, 96572], [57, 97192], [60, 97432], [66, 98164], [68, 98311], [73, 98531], [75, 98691], [78, 98751], [85, 99131], [87, 99351], [89, 99391], [93, 99511], [103, 99971], [106, 100231], [111, 100471], [118, 100851], [121, 101051], [129, 101371], [137, 102271], [142, 102511], [149, 102771], [156, 103171], [160, 103451]]}, {"verse": 13, "start": 105162, "end": 111715, "text": "Y hace grandes señales, de tal manera que aun hace descender fuego del cielo a la tierra delante de los hombres.", "words": [[0, 105162], [2, 105302], [7, 105542], [15, 105962], [24, 107002], [27, 107102], [31, 107282], [38, 107582], [42, 107862], [46, 108062], [51, 108342], [61, 108922], [67, 109222], [71, 109462], [77, 109842], [79, 109982], [82, 110062], [89, 110362], [97, 110822], [100, 110942], [104, 111042]]}, {"verse": 14, "start": 112165, "end": 123686, "text": "Y engaña a los moradores de la tierra por las señales que le ha sido dado hacer en presencia de la bestia, mandando a los moradores de la tierra que hagan la imagen de la bestia que tiene la herida de espada, y vivió.", "words": [[0, 112165], [2, 112264], [9, 112744], [11, 112864], [15, 112964], [25, 113404], [28, 113584], [31, 113684], [38, 114084], [42, 114324], [46, 114464], [54, 114944], [58, 115124], [61, 115264], [64, 115404], [69, 115604], [74, 115994], [80, 116384], [83, 116584], [93, 117144], [96, 117324], [99, 117424], [107, 118286], [116, 118728], [118, 118808], [122, 118928], [132, 119348], [135, 119528], [138, 119628], [145, 119928], [149, 120168], [155, 120428], [158, 120548], [165, 120848], [168, 121048], [171, 121168], [178, 121588], [182, 121728], [188, 121968], [191, 122148], [198, 122428], [201, 122568], [209, 123008], [211, 123228]]}, {"verse": 15, "start": 124136, "end": 133775, "text": "Y le fue dado que diese espíritu a la imagen de la bestia, para que la imagen de la bestia hable; y hará que cualesquiera que no adoran la imagen de la bestia sean muertos.", "words": [[0, 124136], [2, 124242], [5, 124362], [9, 124542], [14, 124822], [18, 125062], [24, 125302], [33, 125902], [35, 125962], [38, 126042], [45, 126382], [48, 126562], [51, 126662], [59, 127362], [64, 127722], [68, 127862], [71, 127982], [78, 128322], [81, 128502], [84, 128602], [91, 129042], [98, 129871], [100, 129970], [105, 130170], [109, 130530], [122, 130890], [126, 131110], [129, 131330], [136, 131550], [139, 131730], [146, 132030], [149, 132210], [152, 132330], [159, 132790], [164, 133010]]}, {"verse": 16, "start": 134225, "end": 143183, "text": "Y hacía que a todos, a los pequeños y grandes, ricos y pobres, libres y siervos, se pusiese una marca en su mano derecha, o en sus frentes:", "words": [[0, 134225], [2, 134323], [8, 134563], [12, 134763], [14, 134863], [21, 135343], [23, 135483], [27, 135603], [36, 136123], [38, 136223], [47, 136983], [53, 137283], [55, 137443], [63, 138003], [70, 138303], [72, 138423], [81, 139243], [84, 139383], [92, 139743], [96, 139983], [102, 140283], [105, 140423], [108, 140543], [113, 140743], [122, 141423], [124, 141603], [127, 141683], [131, 141783]]}, {"verse": 17, "start": 143633, "end": 150491, "text": "Y que ninguno pudiese comprar o vender, sino el que tuviera la marca, o el nombre de la bestia, o el número de su nombre.", "words": [[0, 143633], [2, 143737], [6, 143837], [14, 144257], [22, 144677], [30, 145157], [32, 145317], [40, 145717], [45, 146257], [48, 146437], [52, 146517], [60, 146857], [63, 146997], [70, 147377], [72, 147797], [75, 147897], [82, 148137], [85, 148277], [88, 148397], [96, 148957], [98, 149297], [101, 149417], [108, 149677], [111, 149857], [114, 149997]]}, {"verse": 18, "start": 150941, "end": 161327, "text": "Aquí hay sabiduría. El que tiene entendimiento, cuente el número de la bestia; porque es el número de hombre: y el número de ella, seiscientos sesenta y seis.", "words": [[0, 150941], [5, 151261], [9, 151581], [20, 152713], [23, 152829], [27, 152949], [33, 153229], [48, 154129], [55, 155029], [58, 155149], [65, 155389], [68, 155569], [71, 155669], [79, 156693], [86, 156833], [89, 156993], [92, 157093], [99, 157333], [102, 157553], [110, 158350], [112, 158452], [115, 158532], [122, 158772], [125, 158992], [131, 159470], [143, 159948], [151, 160426], [153, 160904]]}]}