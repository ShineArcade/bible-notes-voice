{"book": "ISA", "chapter": 57, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 203874, "verses": [{"verse": 1, "start": 300, "end": 11468, "text": "Perece el justo, y no hay quien piense en ello; y los piadosos son recogidos, y no hay quien entienda que delante de la aflicción es recogido el justo.", "words": [[0, 300], [7, 766], [10, 986], [17, 1386], [19, 1706], [22, 1926], [26, 2086], [32, 2466], [39, 2846], [42, 3006], [48, 3782], [50, 4006], [54, 4336], [63, 4666], [67, 4886], [78, 6166], [80, 6446], [83, 6626], [87, 6786], [93, 7006], [102, 7666], [106, 7846], [114, 8326], [117, 8506], [120, 8666], [130, 9326], [133, 9866], [142, 10786], [145, 10886]]}, {"verse": 2, "start": 11918, "end": 18138, "text": "Entrará en la paz; descansarán en sus lechos todos los que andan delante de Dios.", "words": [[0, 11918], [8, 12487], [11, 12607], [14, 12727], [19, 13519], [31, 14304], [34, 14424], [38, 14604], [45, 15064], [51, 15664], [55, 16144], [59, 16404], [65, 16844], [73, 17304], [76, 17484]]}, {"verse": 3, "start": 18438, "end": 24230, "text": "Mas vosotros llegaos acá, hijos de la hechicera, generación de adúltero y de fornicaria.", "words": [[0, 18438], [4, 18620], [13, 19100], [21, 19660], [26, 20380], [32, 20600], [35, 20800], [38, 20900], [49, 21680], [60, 22380], [63, 22540], [72, 23220], [74, 23380], [77, 23480]]}, {"verse": 4, "start": 24917, "end": 34783, "text": "¿De quién os habéis burlado? ¿contra quién ensanchasteis la boca, y alargasteis la lengua? ¿No sois vosotros hijos rebeldes, simiente mentirosa,", "words": [[0, 24917], [4, 25061], [10, 25281], [13, 25481], [20, 25781], [29, 27017], [37, 27261], [43, 27561], [57, 28441], [60, 28581], [66, 28861], [68, 29281], [80, 30001], [83, 30121], [91, 31161], [95, 31323], [100, 31703], [109, 32143], [115, 32403], [125, 33363], [134, 33943]]}, {"verse": 5, "start": 35461, "end": 42970, "text": "Que os enfervorizáis con los ídolos debajo de todo árbol frondoso, que sacrificáis los hijos en los valles, debajo de los peñascos?", "words": [[0, 35461], [4, 35540], [7, 35970], [21, 36400], [25, 36600], [29, 36780], [36, 37380], [43, 37740], [46, 37920], [51, 38080], [57, 38550], [67, 39020], [71, 39560], [83, 40260], [87, 40400], [93, 40660], [96, 40880], [100, 41000], [108, 41420], [115, 42060], [118, 42180], [122, 42280]]}, {"verse": 6, "start": 43704, "end": 56426, "text": "En las pulimentadas piedras del valle está tu parte; ellas, ellas son tu suerte; y a ellas derramaste libación, y ofreciste presente. ¿No me tengo de vengar de estas cosas?", "words": [[0, 43704], [3, 43826], [7, 43945], [20, 44746], [28, 45306], [32, 45486], [38, 45826], [43, 46186], [46, 46386], [53, 47508], [60, 48450], [66, 48850], [70, 48990], [73, 49150], [81, 50369], [83, 50486], [85, 50566], [91, 51079], [102, 51593], [112, 52106], [114, 52566], [124, 53126], [134, 54476], [138, 54576], [141, 54676], [147, 54916], [150, 55076], [157, 55456], [160, 55556], [166, 55756]]}, {"verse": 7, "start": 57151, "end": 63471, "text": "Sobre el monte alto y empinado pusiste tu cama: allí también subiste a hacer sacrificio.", "words": [[0, 57151], [6, 57471], [9, 57691], [15, 57991], [20, 58391], [22, 58591], [31, 59171], [39, 59731], [42, 59891], [48, 60966], [53, 61311], [61, 61511], [69, 62171], [71, 62351], [77, 62591]]}, {"verse": 8, "start": 64146, "end": 77781, "text": "Y tras la puerta y el umbral pusiste tu recuerdo: porque a otro que a mí te descubriste, y subiste, y ensanchaste tu cama, e hiciste con ellos pacto: amaste su cama donde quiera que la veías.", "words": [[0, 64146], [2, 64252], [7, 64412], [10, 64592], [17, 64932], [19, 65112], [22, 65212], [29, 65592], [37, 66372], [40, 66552], [50, 67749], [57, 68006], [59, 68206], [64, 68466], [68, 68706], [70, 68786], [73, 68906], [76, 69026], [89, 69806], [91, 70186], [100, 70826], [102, 71126], [114, 71866], [117, 72066], [123, 72966], [125, 73046], [133, 73546], [137, 73786], [143, 73966], [150, 75253], [157, 75681], [160, 75861], [165, 76221], [171, 76401], [178, 76821], [182, 76961], [185, 77081]]}, {"verse": 9, "start": 78470, "end": 87200, "text": "Y fuiste al rey con ungüento, y multiplicaste tus perfumes, y enviaste tus embajadores lejos, y te abatiste hasta el profundo.", "words": [[0, 78470], [2, 78570], [9, 78970], [12, 79270], [16, 79570], [20, 79870], [30, 80170], [32, 80630], [46, 81390], [50, 81610], [60, 82270], [62, 82870], [71, 83370], [75, 83590], [87, 84170], [94, 84810], [96, 85290], [99, 85410], [108, 86030], [114, 86310], [117, 86450]]}, {"verse": 10, "start": 87879, "end": 99582, "text": "En la multitud de tus caminos te cansaste, pero no dijiste: No hay remedio; hallaste la vida de tu mano, por tanto no te arrepentiste.", "words": [[0, 87879], [3, 88015], [6, 88115], [15, 88695], [18, 88795], [22, 88955], [30, 89475], [33, 89635], [43, 90615], [48, 90755], [51, 90955], [60, 92919], [63, 93137], [67, 93397], [76, 94671], [85, 95172], [88, 95332], [93, 95572], [96, 95752], [99, 95892], [105, 96612], [109, 96772], [115, 97492], [118, 97712], [121, 97872]]}, {"verse": 11, "start": 100271, "end": 112550, "text": "¿Y de quién te asustaste y temiste, que has faltado a la fe, y no te has acordado de mí, ni te vino al pensamiento? ¿No he disimulado yo desde tiempos antiguos, y nunca me has temido?", "words": [[0, 100271], [3, 100392], [6, 100512], [12, 100712], [15, 100912], [25, 101612], [27, 101732], [36, 102752], [40, 102832], [44, 103012], [52, 103532], [54, 103632], [57, 103672], [61, 103912], [63, 104352], [66, 104492], [69, 104632], [73, 104792], [82, 105312], [85, 105472], [89, 105672], [92, 106072], [95, 106252], [100, 106432], [103, 106552], [116, 107979], [120, 108180], [123, 108360], [134, 109040], [137, 109280], [143, 109680], [151, 110280], [161, 111000], [163, 111360], [169, 111560], [172, 111820], [176, 111940]]}, {"verse": 12, "start": 113223, "end": 116826, "text": "Yo publicaré tu justicia y tus obras, que no te aprovecharán.", "words": [[0, 113223], [3, 113366], [13, 113906], [16, 114046], [25, 114606], [27, 114706], [31, 114846], [38, 115186], [42, 115666], [45, 115846], [48, 115986]]}, {"verse": 13, "start": 117529, "end": 130079, "text": "Cuando clames, que te libren tus ídolos; pero a todos ellos llevará el viento, un soplo los arrebatará; mas el que en mí espera, tendrá la tierra por heredad, y poseerá el monte de mi santidad.", "words": [[0, 117529], [7, 117726], [15, 118166], [19, 118346], [22, 118486], [29, 118786], [33, 118986], [41, 120225], [46, 120389], [48, 120529], [54, 120769], [60, 121189], [68, 121689], [71, 121809], [79, 122569], [82, 122829], [88, 123229], [92, 123429], [104, 124799], [108, 124959], [111, 125119], [115, 125259], [118, 125379], [121, 125479], [129, 126219], [136, 126679], [139, 126779], [146, 127119], [150, 127479], [159, 127839], [161, 128179], [169, 128759], [172, 128859], [178, 129139], [181, 129339], [184, 129439]]}, {"verse": 14, "start": 130665, "end": 138420, "text": "Y dirá: Allanad, allanad; barred el camino, quitad los tropiezos del camino de mi pueblo.", "words": [[0, 130665], [2, 130865], [8, 132227], [17, 132873], [26, 133804], [33, 134329], [36, 134609], [44, 135069], [51, 135529], [55, 135829], [65, 136589], [69, 137089], [76, 137469], [79, 137689], [82, 137809]]}, {"verse": 15, "start": 138870, "end": 156453, "text": "Porque así dijo el Alto y Sublime, el que habita la eternidad, y cuyo nombre es el Santo: Yo habito en la altura y la santidad, y con el quebrantado y humilde de espíritu, para hacer vivir el espíritu de los humildes, y para vivificar el corazón de los quebrantados.", "words": [[0, 138870], [7, 139051], [11, 139451], [16, 139951], [19, 140111], [24, 140351], [26, 140491], [35, 141371], [38, 141451], [42, 141631], [49, 141991], [52, 142151], [63, 142891], [65, 143091], [70, 143411], [77, 143731], [80, 144151], [83, 144451], [90, 145441], [93, 145579], [100, 145959], [103, 146079], [106, 146199], [113, 146519], [115, 146679], [118, 146799], [128, 147639], [130, 147999], [134, 148159], [137, 148279], [149, 148959], [151, 149079], [159, 149379], [162, 149519], [172, 150499], [177, 150779], [183, 151039], [189, 151279], [192, 151599], [201, 152139], [204, 152199], [208, 152339], [218, 153674], [220, 153793], [225, 153973], [235, 154533], [238, 154753], [246, 155173], [249, 155413], [253, 155513]]}, {"verse": 16, "start": 157154, "end": 166863, "text": "Porque no tengo de contender para siempre, ni para siempre me he de enojar: pues decaería ante mí el espíritu, y las almas que yo he creado.", "words": [[0, 157154], [7, 157373], [10, 157573], [16, 157953], [19, 158113], [29, 158733], [34, 158953], [43, 159773], [46, 160193], [51, 160453], [59, 160953], [62, 161233], [65, 161353], [68, 161453], [76, 162666], [81, 162783], [90, 163483], [95, 163703], [98, 163943], [101, 164083], [111, 165003], [113, 165123], [117, 165303], [123, 165723], [127, 165903], [130, 166103], [133, 166203]]}, {"verse": 17, "start": 167553, "end": 176631, "text": "Por la iniquidad de su codicia me enojé y le herí, escondí mi rostro y me ensañé; y fue él rebelde por el camino de su corazón.", "words": [[0, 167553], [4, 167673], [7, 167813], [17, 168413], [20, 168553], [23, 168713], [31, 169253], [34, 169473], [40, 169893], [42, 170133], [45, 170373], [51, 170613], [59, 171653], [62, 171733], [69, 172313], [71, 172553], [74, 172673], [82, 173788], [84, 173911], [88, 174111], [91, 174411], [99, 174951], [103, 175131], [106, 175231], [113, 175611], [116, 175831], [119, 175951]]}, {"verse": 18, "start": 177322, "end": 184479, "text": "He visto sus caminos, y le sanaré, y le pastorearé, y le daré consolaciones, a él y a sus enlutados.", "words": [[0, 177322], [3, 177419], [9, 177719], [13, 177939], [22, 178539], [24, 178759], [27, 178979], [35, 179479], [37, 179819], [40, 179939], [52, 180699], [54, 181239], [57, 181359], [62, 181639], [77, 182539], [79, 182959], [82, 183259], [84, 183539], [86, 183599], [90, 183739]]}, {"verse": 19, "start": 185213, "end": 192839, "text": "Crío fruto de labios: Paz, paz al lejano y al cercano, dijo Jehová; y lo sanaré.", "words": [[0, 185213], [5, 185744], [11, 186124], [14, 186264], [22, 187512], [27, 188134], [31, 188514], [34, 188654], [41, 189174], [43, 189354], [46, 189454], [55, 190683], [60, 191193], [68, 191974], [70, 192069], [73, 192199]]}, {"verse": 20, "start": 193522, "end": 199982, "text": "Pero los impíos son como el mar en tempestad, que no puede estarse quieta, y sus aguas arrojan cieno y lodo.", "words": [[0, 193522], [5, 193662], [9, 194002], [16, 194342], [20, 194622], [25, 194882], [28, 195022], [32, 195182], [35, 195362], [46, 196202], [50, 196302], [53, 196442], [59, 196642], [67, 197082], [75, 197842], [77, 197942], [81, 198062], [87, 198482], [95, 198932], [101, 199382], [103, 199522]]}, {"verse": 21, "start": 200704, "end": 203214, "text": "No hay paz, dijo mi Dios, para los impíos.", "words": [[0, 200704], [3, 200844], [7, 201024], [12, 201444], [17, 201564], [20, 201744], [26, 202224], [31, 202324], [35, 202504]]}]}