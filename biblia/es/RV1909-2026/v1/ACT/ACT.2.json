{"book": "ACT", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 367321, "verses": [{"verse": 1, "start": 300, "end": 5957, "text": "Y como se cumplieron los días de Pentecostés, estaban todos unánimes juntos;", "words": [[0, 300], [2, 424], [7, 664], [10, 844], [21, 1484], [25, 1664], [30, 1944], [33, 2124], [46, 3024], [54, 3644], [60, 4204], [69, 5044]]}, {"verse": 2, "start": 6407, "end": 16010, "text": "Y de repente vino un estruendo del cielo como de un viento recio que corría, el cual llenó toda la casa donde estaban sentados;", "words": [[0, 6407], [2, 6531], [5, 6651], [13, 7151], [18, 7651], [21, 7891], [31, 8431], [35, 8651], [41, 9091], [46, 9391], [49, 9571], [52, 9651], [59, 10091], [65, 10531], [69, 10671], [77, 11911], [80, 12051], [85, 12271], [91, 12671], [96, 12951], [99, 13211], [104, 13651], [110, 14331], [118, 15197]]}, {"verse": 3, "start": 16460, "end": 22934, "text": "Y se les aparecieron lenguas repartidas, como de fuego, que se asentó sobre cada uno de ellos.", "words": [[0, 16460], [2, 16604], [5, 16724], [9, 16884], [21, 17704], [29, 18244], [41, 19104], [46, 19404], [49, 19584], [56, 20024], [60, 20524], [63, 20704], [70, 21244], [76, 21524], [81, 21784], [85, 22124], [88, 22324]]}, {"verse": 4, "start": 23384, "end": 31384, "text": "Y fueron todos llenos del Espíritu Santo, y comenzaron a hablar en otras lenguas, como el Espíritu les daba que hablasen.", "words": [[0, 23384], [2, 23526], [9, 23746], [15, 24186], [22, 24786], [26, 24966], [35, 25466], [42, 25826], [44, 26606], [55, 27266], [57, 27426], [64, 27706], [67, 27926], [73, 28106], [82, 28746], [87, 29246], [90, 29466], [99, 30066], [103, 30206], [108, 30466], [112, 30646]]}, {"verse": 5, "start": 31834, "end": 39598, "text": "Moraban entonces en Jerusalén judíos, varones religiosos, de todas las naciones debajo del cielo.", "words": [[0, 31834], [8, 32310], [17, 32890], [20, 33210], [30, 33850], [38, 34830], [46, 35350], [58, 36570], [61, 36890], [67, 37230], [71, 37730], [80, 38350], [87, 38810], [91, 39030]]}, {"verse": 6, "start": 40048, "end": 48025, "text": "Y hecho este estruendo, se juntó la multitud; y estaban confusos, porque cada uno les oía hablar su propia lengua.", "words": [[0, 40048], [2, 40228], [8, 40428], [13, 40728], [24, 41588], [27, 41768], [33, 42168], [36, 42268], [46, 43369], [48, 43453], [56, 43713], [66, 44733], [73, 45253], [78, 45573], [82, 45913], [86, 46153], [90, 46513], [97, 46753], [100, 46993], [107, 47313]]}, {"verse": 7, "start": 48475, "end": 55051, "text": "Y estaban atónitos y maravillados, diciendo: He aquí ¿no son galileos todos estos que hablan?", "words": [[0, 48475], [2, 48595], [10, 48975], [19, 49895], [21, 50095], [35, 50935], [45, 52198], [48, 52288], [53, 52548], [57, 52768], [61, 52988], [70, 53588], [76, 53848], [82, 54208], [86, 54488]]}, {"verse": 8, "start": 55501, "end": 59872, "text": "¿Cómo, pues, les oímos nosotros hablar cada uno en nuestra lengua de nacimiento?", "words": [[0, 55501], [7, 55682], [13, 56282], [17, 56382], [23, 56822], [32, 57062], [39, 57602], [44, 57842], [48, 58182], [51, 58322], [59, 58462], [66, 58962], [69, 59042]]}, {"verse": 9, "start": 60322, "end": 68224, "text": "Partos y medos, y elamitas, y los que habitamos en Mesopotamia, en Judea y en Capadocia, en el Ponto y en Asia,", "words": [[0, 60322], [7, 60790], [9, 60930], [16, 61310], [18, 61430], [28, 61970], [30, 62650], [34, 62810], [38, 62990], [48, 63550], [51, 63730], [64, 64870], [67, 64910], [73, 65410], [75, 65530], [78, 65650], [89, 66810], [92, 66890], [95, 67150], [101, 67410], [103, 67610], [106, 67710]]}, {"verse": 10, "start": 68674, "end": 78101, "text": "En Frigia y Panfilia, en Egipto y en las partes de Africa que está del otro lado de Cirene, y Romanos extranjeros, tanto judíos como convertidos,", "words": [[0, 68674], [3, 68834], [10, 69374], [12, 69834], [22, 70294], [25, 70354], [32, 70854], [34, 70934], [37, 71014], [41, 71134], [48, 71494], [51, 71694], [58, 72074], [62, 72254], [67, 72514], [71, 72694], [76, 72914], [81, 73174], [84, 73474], [92, 73774], [94, 74214], [102, 74714], [115, 75794], [121, 75954], [128, 76494], [133, 76714]]}, {"verse": 11, "start": 78551, "end": 83259, "text": "Cretenses y árabes, les oímos hablar en nuestras lenguas las maravillas de Dios.", "words": [[0, 78821], [10, 79091], [12, 79311], [20, 79731], [24, 79891], [30, 80391], [37, 80671], [40, 80871], [49, 81071], [57, 81751], [61, 81911], [72, 82531], [75, 82711]]}, {"verse": 12, "start": 83609, "end": 93464, "text": "Y estaban todos atónitos y perplejos, diciendo los unos a los otros: ¿Qué significa esto?", "words": [[0, 83609], [2, 83710], [10, 84070], [16, 84470], [25, 85330], [27, 85490], [38, 86183], [47, 86877], [51, 87570], [56, 87790], [58, 88050], [62, 88210], [69, 89170], [74, 89274], [84, 89674]]}, {"verse": 13, "start": 93814, "end": 98516, "text": "Pero otros burlándose, decían: Que están llenos de vino nuevo.", "words": [[0, 93814], [5, 93998], [11, 94768], [23, 95538], [31, 96924], [35, 97008], [41, 97248], [48, 97648], [51, 97788], [56, 97948]]}, {"verse": 14, "start": 98866, "end": 111367, "text": "Entonces Pedro, poniéndose en pie con los once, alzó su voz, y les habló diciendo: Varones judíos, y todos los que habitáis en Jerusalén, esto os sea notorio, y oíd mis palabras.", "words": [[0, 98866], [9, 99548], [16, 100408], [27, 101008], [30, 101188], [34, 101307], [38, 101508], [42, 101688], [48, 102708], [53, 103028], [56, 103167], [61, 103468], [63, 103867], [67, 104008], [73, 104408], [83, 105352], [91, 105719], [99, 106299], [101, 106419], [107, 106639], [111, 106859], [115, 107039], [124, 107499], [127, 107599], [138, 108639], [143, 108749], [146, 108859], [150, 109179], [159, 109839], [161, 110129], [165, 110419], [169, 110579]]}, {"verse": 15, "start": 111817, "end": 116223, "text": "Porque estos no están borrachos, como vosotros pensáis, siendo la tercera hora del día;", "words": [[0, 111817], [7, 112018], [13, 112238], [16, 112458], [22, 112658], [33, 113238], [38, 113438], [47, 113878], [56, 114638], [63, 114858], [66, 115038], [74, 115418], [79, 115618], [83, 115818]]}, {"verse": 16, "start": 116673, "end": 119420, "text": "Pero esto es lo que fue dicho por el profeta Joel:", "words": [[0, 116673], [5, 116810], [10, 117130], [13, 117370], [16, 117490], [20, 117630], [24, 117810], [30, 118130], [34, 118390], [37, 118510], [45, 118910]]}, {"verse": 17, "start": 119870, "end": 132300, "text": "Y será en los últimos días, dice Dios, derramaré de mi Espíritu sobre toda carne, y vuestros hijos y vuestras hijas profetizarán; y vuestros jóvenes verán visiones, y vuestros viejos soñarán sueños:", "words": [[0, 119870], [2, 119990], [7, 120190], [10, 120390], [14, 120510], [22, 120830], [28, 121510], [33, 121710], [39, 122490], [49, 122990], [52, 123130], [55, 123250], [64, 123790], [70, 124010], [75, 124250], [82, 124690], [84, 125190], [93, 125570], [99, 125950], [101, 126170], [110, 126550], [116, 126910], [130, 128072], [132, 128170], [141, 128530], [149, 128830], [155, 129270], [165, 130070], [167, 130370], [176, 130710], [183, 131090], [191, 131590]]}, {"verse": 18, "start": 132750, "end": 138717, "text": "Y de cierto sobre mis siervos y sobre mis siervas en aquellos días derramaré de mi Espíritu, y profetizarán.", "words": [[0, 132750], [2, 132961], [5, 133215], [12, 133468], [18, 133648], [22, 133828], [30, 134268], [32, 134408], [38, 134568], [42, 134788], [50, 135188], [53, 135348], [62, 135568], [67, 135988], [77, 136568], [80, 136688], [83, 136808], [93, 137648], [95, 137788]]}, {"verse": 19, "start": 139167, "end": 145437, "text": "Y daré prodigios arriba en el cielo, y señales abajo en la tierra, sangre y fuego y vapor de humo:", "words": [[0, 139167], [2, 139270], [7, 139550], [17, 140070], [24, 140370], [27, 140570], [30, 140690], [37, 141050], [39, 141550], [47, 142050], [53, 142370], [56, 142590], [59, 142690], [67, 143390], [74, 143870], [76, 144030], [82, 144310], [84, 144570], [90, 144810], [93, 145050]]}, {"verse": 20, "start": 145887, "end": 152580, "text": "El sol se volverá en tinieblas, y la luna en sangre, antes que venga el día del Señor, grande y manifiesto;", "words": [[0, 145887], [3, 146006], [7, 146266], [10, 146466], [18, 146926], [21, 147306], [32, 147686], [34, 147866], [37, 148006], [42, 148186], [45, 148346], [53, 148906], [59, 149486], [63, 149706], [69, 150026], [72, 150166], [76, 150306], [80, 150486], [87, 150846], [94, 151626], [96, 151786]]}, {"verse": 21, "start": 153030, "end": 156489, "text": "Y será que todo aquel que invoque el nombre del Señor, será salvo.", "words": [[0, 153030], [2, 153134], [7, 153274], [11, 153454], [16, 153654], [22, 154034], [26, 154134], [34, 154514], [37, 154614], [44, 154854], [48, 155034], [55, 155434], [60, 155974]]}, {"verse": 22, "start": 156939, "end": 169446, "text": "Varones israelitas, oíd estas palabras: Jesús nazareno, varón aprobado de Dios entre vosotros en maravillas y prodigios y señales, que Dios hizo por él en medio de vosotros, como también vosotros sabéis;", "words": [[0, 157099], [8, 157299], [20, 157939], [24, 158579], [30, 158759], [40, 159812], [46, 160041], [56, 161001], [62, 161361], [71, 161861], [74, 162041], [79, 162261], [85, 162541], [94, 163121], [97, 163361], [108, 163901], [110, 164061], [120, 164621], [122, 164741], [131, 165261], [135, 165681], [140, 165941], [145, 166221], [149, 166501], [152, 166661], [155, 166781], [161, 167001], [164, 167161], [174, 167901], [179, 168001], [187, 168361], [196, 168881]]}, {"verse": 23, "start": 169896, "end": 178948, "text": "A este, entregado según el plan determinado y el conocimiento anticipado de Dios, prendisteis y matasteis por manos de los inicuos, crucificándole;", "words": [[0, 169896], [2, 169993], [8, 170193], [18, 170753], [24, 171013], [27, 171213], [32, 171473], [44, 172153], [46, 172233], [49, 172333], [62, 172933], [73, 173593], [76, 173733], [82, 174553], [94, 175233], [96, 175353], [106, 175933], [110, 176073], [116, 176313], [119, 176513], [123, 176613], [132, 177313]]}, {"verse": 24, "start": 179398, "end": 186429, "text": "Al cual Dios levantó, habiéndolo liberado de los dolores de la muerte, por cuanto era imposible que ella lo retuviese.", "words": [[0, 179398], [3, 179515], [8, 179695], [13, 179955], [22, 180615], [33, 181275], [42, 181835], [45, 181975], [49, 182115], [57, 182555], [60, 182695], [63, 182815], [71, 183215], [75, 183795], [82, 184035], [86, 184355], [96, 185055], [100, 185275], [105, 185455], [108, 185615]]}, {"verse": 25, "start": 186879, "end": 193740, "text": "Porque David dice de él: Veía al Señor siempre delante de mí: porque está a mi diestra, no seré conmovido.", "words": [[0, 186879], [7, 187092], [13, 187392], [18, 187772], [21, 187972], [25, 188594], [30, 188976], [33, 189096], [39, 189356], [47, 189816], [55, 190296], [58, 190436], [62, 191023], [69, 191228], [74, 191528], [76, 191668], [79, 191728], [88, 192548], [91, 192648], [96, 193008]]}, {"verse": 26, "start": 194190, "end": 199941, "text": "Por lo cual mi corazón se alegró, y se gozó mi lengua; y aun mi carne descansará en esperanza;", "words": [[0, 194190], [4, 194291], [7, 194411], [12, 194651], [15, 194791], [23, 195151], [26, 195431], [34, 195911], [36, 196151], [39, 196291], [44, 196611], [47, 196691], [55, 197498], [57, 197638], [61, 197778], [64, 197998], [70, 198318], [81, 199058], [84, 199178]]}, {"verse": 27, "start": 200391, "end": 204628, "text": "Que no dejarás mi alma en el infierno, ni darás a tu Santo que vea corrupción.", "words": [[0, 200391], [4, 200472], [7, 200592], [15, 201052], [18, 201192], [23, 201412], [26, 201552], [29, 201652], [39, 202372], [42, 202532], [48, 202852], [50, 202932], [53, 203032], [59, 203412], [63, 203592], [67, 203832]]}, {"verse": 28, "start": 205078, "end": 209405, "text": "Me diste a conocer los caminos de la vida; me llenarás de gozo con tu presencia.", "words": [[0, 205181], [3, 205321], [9, 205461], [11, 205581], [19, 205901], [23, 206081], [31, 206461], [34, 206581], [37, 206681], [43, 207413], [46, 207510], [55, 207970], [58, 208070], [63, 208370], [67, 208530], [70, 208630]]}, {"verse": 29, "start": 209855, "end": 218638, "text": "Varones hermanos, se os puede libremente decir del patriarca David, que murió, y fue sepultado, y su sepulcro está con nosotros hasta el día de hoy.", "words": [[0, 209987], [8, 210157], [18, 210737], [21, 210877], [24, 210977], [30, 211237], [41, 211624], [47, 212010], [51, 212397], [61, 212917], [68, 213177], [72, 213697], [79, 214117], [81, 214597], [85, 214777], [96, 215497], [98, 215937], [101, 216077], [110, 216617], [115, 216917], [119, 217137], [128, 217517], [134, 217857], [137, 217997], [141, 218197], [144, 218357]]}, {"verse": 30, "start": 219088, "end": 229282, "text": "Pero siendo profeta, y sabiendo que con juramento le había Dios jurado que del fruto de su lomo, cuanto a la carne, levantaría al Cristo que se sentaría sobre su trono;", "words": [[0, 219088], [5, 219324], [12, 219544], [21, 220224], [23, 220344], [32, 220824], [36, 220984], [40, 221224], [50, 221784], [53, 222004], [59, 222224], [64, 222544], [71, 223024], [75, 223204], [79, 223364], [85, 223724], [88, 223884], [91, 224024], [97, 224484], [104, 225004], [106, 225204], [109, 225264], [116, 226177], [127, 226801], [130, 227001], [137, 227341], [141, 227581], [144, 227701], [153, 228281], [159, 228561], [162, 228761]]}, {"verse": 31, "start": 229732, "end": 236710, "text": "Viéndolo antes, habló de la resurrección de Cristo, que su alma no fue dejada en el infierno, ni su carne vio corrupción.", "words": [[0, 229732], [9, 230194], [16, 230534], [22, 231074], [25, 231134], [28, 231274], [41, 231954], [44, 232074], [52, 232814], [56, 233014], [59, 233214], [64, 233414], [67, 233654], [71, 233814], [78, 234234], [81, 234334], [84, 234434], [94, 234934], [97, 235334], [100, 235474], [106, 235774], [110, 236054]]}, {"verse": 32, "start": 237160, "end": 241494, "text": "A este Jesús resucitó Dios, de lo cual todos nosotros somos testigos.", "words": [[0, 237160], [2, 237278], [7, 237478], [13, 237878], [22, 238538], [28, 239118], [31, 239198], [34, 239318], [39, 239558], [45, 239798], [54, 240258], [60, 240658]]}, {"verse": 33, "start": 241944, "end": 250414, "text": "Así que, levantado por la diestra de Dios, y recibiendo del Padre la promesa del Espíritu Santo, ha derramado esto que vosotros veis y oís.", "words": [[0, 241944], [4, 242120], [9, 242300], [19, 242900], [23, 243100], [26, 243200], [34, 243560], [37, 243720], [43, 244000], [45, 244600], [56, 245180], [60, 245380], [66, 245760], [69, 245860], [77, 246300], [81, 246480], [90, 247020], [97, 247360], [100, 247960], [110, 248520], [115, 248800], [119, 249000], [128, 249440], [133, 249860], [135, 249980]]}, {"verse": 34, "start": 250864, "end": 257472, "text": "Porque David no subió a los cielos; pero él dice: Dijo el Señor a mi Señor: Siéntate a mi diestra,", "words": [[0, 250864], [7, 251042], [13, 251302], [16, 251562], [22, 251882], [24, 251982], [28, 252082], [36, 252956], [41, 253115], [44, 253335], [50, 254184], [55, 254465], [58, 254645], [64, 254925], [66, 255145], [69, 255225], [76, 256081], [85, 256639], [87, 256779], [90, 256859]]}, {"verse": 35, "start": 257922, "end": 261112, "text": "Hasta que ponga a tus enemigos por estrado de tus pies.", "words": [[0, 257922], [6, 258146], [10, 258326], [16, 258766], [18, 258846], [22, 258986], [31, 259526], [35, 259826], [43, 260266], [46, 260406], [50, 260546]]}, {"verse": 36, "start": 261562, "end": 269917, "text": "Sepa pues ciertísimamente toda la casa de Israel, que a este Jesús que vosotros crucificasteis, Dios ha hecho Señor y Cristo.", "words": [[0, 261562], [5, 261896], [10, 262196], [26, 263216], [31, 263536], [34, 263756], [39, 264036], [42, 264216], [50, 264676], [54, 265216], [56, 265316], [61, 265516], [67, 265896], [71, 266116], [80, 266556], [96, 267676], [101, 268096], [104, 268336], [110, 268536], [116, 268916], [118, 269316]]}, {"verse": 37, "start": 270267, "end": 281314, "text": "Entonces oído esto, fueron compungidos de corazón, y dijeron a Pedro y a los otros apóstoles: Varones hermanos, ¿qué haremos?", "words": [[0, 270267], [9, 271365], [14, 271865], [20, 272185], [27, 272605], [39, 273625], [42, 273785], [51, 274305], [53, 274985], [61, 275485], [63, 275565], [69, 275905], [71, 276165], [73, 276245], [77, 276345], [83, 276685], [94, 278264], [102, 278474], [112, 279174], [117, 279234]]}, {"verse": 38, "start": 281664, "end": 291521, "text": "Y Pedro les dice: Arrepentíos, y bautícese cada uno de vosotros en el nombre de Jesucristo para perdón de los pecados; y recibiréis el don del Espíritu Santo.", "words": [[0, 281664], [2, 281788], [8, 282148], [12, 282558], [18, 283169], [31, 283946], [33, 284066], [43, 284706], [48, 284886], [52, 285166], [55, 285306], [64, 285826], [67, 286046], [70, 286146], [77, 286446], [80, 286606], [91, 287266], [96, 287466], [103, 287926], [106, 288006], [110, 288126], [119, 289133], [121, 289224], [132, 289904], [135, 290064], [139, 290244], [143, 290424], [152, 290964]]}, {"verse": 39, "start": 291971, "end": 299229, "text": "Porque para vosotros es la promesa, y para vuestros hijos, y para todos los que están lejos; para cuantos el Señor nuestro Dios llame.", "words": [[0, 291971], [7, 292171], [12, 292371], [21, 292811], [24, 292991], [27, 293111], [36, 293611], [38, 293851], [43, 294031], [52, 294431], [59, 294691], [61, 295011], [66, 295211], [72, 295451], [76, 295651], [80, 295811], [86, 296011], [93, 296871], [98, 297018], [106, 297418], [109, 297518], [115, 297738], [123, 297978], [128, 298318]]}, {"verse": 40, "start": 299579, "end": 307524, "text": "Y con otras muchas palabras testificaba y exhortaba, diciendo: Sed salvos de esta perversa generación.", "words": [[0, 299579], [2, 299716], [6, 299916], [12, 300116], [19, 300456], [28, 300916], [40, 301956], [42, 302136], [53, 303476], [63, 304528], [67, 304792], [74, 305272], [77, 305432], [82, 305592], [91, 306152]]}, {"verse": 41, "start": 307874, "end": 316402, "text": "Así que, los que recibieron su palabra, fueron bautizados: y fueron añadidas a ellos aquel día como tres mil personas.", "words": [[0, 307874], [4, 308089], [9, 308289], [13, 308429], [17, 308589], [28, 309249], [31, 309429], [40, 309889], [47, 310289], [59, 311702], [61, 311955], [68, 312175], [77, 313075], [79, 313395], [85, 313735], [91, 314455], [95, 314695], [100, 314895], [105, 315095], [109, 315295]]}, {"verse": 42, "start": 316852, "end": 325631, "text": "Y perseveraban en la enseñanza de los apóstoles, y en la comunión, y en el partimiento del pan, y en las oraciones.", "words": [[0, 316852], [2, 316973], [15, 318073], [18, 318373], [21, 318533], [31, 319473], [34, 319613], [38, 319753], [49, 320473], [51, 320953], [54, 321073], [57, 321193], [67, 321933], [69, 322433], [72, 322553], [75, 322673], [87, 323433], [91, 323653], [96, 323993], [98, 324313], [101, 324433], [105, 324573]]}, {"verse": 43, "start": 326081, "end": 332882, "text": "Y toda persona tenía temor: y muchas maravillas y señales eran hechas por los apóstoles.", "words": [[0, 326081], [2, 326327], [7, 326507], [15, 327007], [21, 327507], [28, 328403], [30, 328548], [37, 328988], [48, 329868], [50, 330048], [58, 330608], [63, 330848], [70, 331408], [74, 331768], [78, 331948]]}, {"verse": 44, "start": 333332, "end": 338551, "text": "Y todos los que creían estaban juntos; y tenían todas las cosas comunes;", "words": [[0, 333332], [2, 333457], [8, 333777], [12, 334057], [16, 334237], [23, 334737], [31, 335037], [39, 336181], [41, 336409], [48, 336669], [54, 337029], [58, 337309], [64, 337649]]}, {"verse": 45, "start": 339001, "end": 346643, "text": "Y vendían las posesiones, y los bienes, y los repartían a todos, según la necesidad de cada uno.", "words": [[0, 339001], [2, 339126], [10, 339586], [14, 339766], [26, 340586], [28, 341286], [32, 341426], [40, 342326], [42, 342566], [46, 342706], [56, 343326], [58, 343426], [65, 344186], [71, 344686], [74, 344946], [84, 345626], [87, 345766], [92, 346006]]}, {"verse": 46, "start": 347093, "end": 356793, "text": "Y perseverando unánimes cada día en el templo, y partiendo el pan en las casas, comían juntos con alegría y con sencillez de corazón,", "words": [[0, 347093], [2, 347220], [15, 348110], [24, 349000], [29, 349320], [33, 349680], [36, 349900], [39, 350040], [47, 350820], [49, 350960], [59, 351500], [62, 351660], [66, 351940], [69, 352100], [73, 352260], [80, 353300], [87, 353760], [94, 354120], [98, 354460], [106, 355000], [108, 355080], [112, 355500], [122, 355920], [125, 356040]]}, {"verse": 47, "start": 357243, "end": 366921, "text": "Alabando a Dios, y teniendo gracia con todo el pueblo. Y el Señor añadía cada día a la iglesia los que habían de ser salvos.", "words": [[0, 357243], [9, 357803], [11, 357903], [17, 358163], [19, 359023], [28, 359523], [35, 360063], [39, 360283], [44, 360483], [47, 360663], [55, 361596], [57, 361720], [60, 361860], [66, 362240], [73, 363120], [78, 363400], [82, 363840], [84, 364140], [87, 364220], [95, 364780], [99, 365220], [103, 365420], [110, 365740], [113, 365940], [117, 366140]]}]}