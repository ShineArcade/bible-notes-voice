{"book": "LUK", "chapter": 18, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 315284, "verses": [{"verse": 1, "start": 300, "end": 7660, "text": "Y LES PROPUSO también una parábola sobre que es necesario orar siempre, y no desanimarse,", "words": [[0, 300], [2, 442], [6, 562], [14, 1202], [22, 1582], [26, 2022], [35, 2641], [41, 3002], [45, 3282], [48, 3462], [58, 4361], [63, 4982], [72, 5442], [74, 5922], [77, 6082]]}, {"verse": 2, "start": 8010, "end": 14733, "text": "Diciendo: Había un juez en una ciudad, el cual ni temía a Dios, ni respetaba a hombre.", "words": [[0, 8010], [10, 9013], [16, 9255], [19, 9515], [24, 9955], [27, 10115], [31, 10275], [39, 10667], [42, 11060], [47, 11360], [50, 11840], [56, 12300], [58, 12540], [64, 12800], [67, 13280], [77, 14020], [79, 14180]]}, {"verse": 3, "start": 15083, "end": 23346, "text": "Había también en aquella ciudad una viuda, la cual venía a él diciendo: Hazme justicia de mi adversario.", "words": [[0, 15083], [6, 15393], [14, 15833], [17, 16273], [25, 16693], [32, 17073], [36, 17453], [43, 18393], [46, 18613], [51, 18833], [57, 19373], [59, 19593], [62, 19833], [72, 20890], [78, 21306], [87, 22046], [90, 22226], [93, 22326]]}, {"verse": 4, "start": 23626, "end": 32001, "text": "Y él no quiso por algún tiempo; pero después de esto dijo dentro de sí: Aunque ni temo a Dios, ni tengo respeto a hombre,", "words": [[0, 23626], [2, 23787], [5, 23927], [8, 24087], [14, 24447], [18, 24667], [24, 24927], [32, 25850], [37, 26224], [45, 26564], [48, 26764], [53, 27004], [58, 27324], [65, 27884], [68, 28184], [72, 28781], [79, 28981], [82, 29181], [87, 29501], [89, 29581], [95, 30281], [98, 30441], [104, 30741], [112, 31321], [114, 31461]]}, {"verse": 5, "start": 32001, "end": 38386, "text": "Sin embargo, porque esta viuda me es molesta, le haré justicia, para que al fin no venga y me muela.", "words": [[0, 32061], [4, 32121], [13, 32861], [20, 33041], [25, 33321], [31, 33681], [34, 33881], [37, 34021], [46, 34901], [49, 35001], [54, 35241], [64, 36261], [69, 36561], [73, 36741], [76, 36861], [80, 37061], [83, 37281], [89, 37641], [91, 37781], [94, 37881]]}, {"verse": 6, "start": 38666, "end": 42492, "text": "Y dijo el Señor: Oíd lo que dice el juez injusto.", "words": [[0, 38666], [2, 38790], [7, 39090], [10, 39230], [17, 40142], [21, 40554], [24, 40834], [28, 40974], [33, 41254], [36, 41454], [41, 41734]]}, {"verse": 7, "start": 42842, "end": 48881, "text": "¿Y Dios no hará justicia a sus escogidos, que claman a él día y noche, aunque sea paciente con ellos?", "words": [[0, 42842], [3, 42971], [8, 43291], [11, 43706], [16, 43886], [25, 44426], [27, 44606], [31, 44726], [42, 45366], [46, 45506], [53, 45736], [55, 45966], [58, 46146], [62, 46386], [64, 46566], [71, 47186], [78, 47366], [82, 47666], [91, 48166], [95, 48406]]}, {"verse": 8, "start": 49231, "end": 55816, "text": "Os digo que los defenderá pronto. Pero cuando venga el Hijo del hombre, ¿hallará fe en la tierra?", "words": [[0, 49231], [3, 49355], [8, 49655], [12, 49815], [16, 49975], [26, 50555], [34, 51481], [39, 51625], [46, 51885], [52, 52325], [55, 52445], [60, 52665], [64, 52825], [72, 53565], [81, 54205], [84, 54505], [87, 54825], [90, 54985]]}, {"verse": 9, "start": 56166, "end": 62693, "text": "Y dijo también a unos que confiaban de sí como justos, y menospreciaban a los otros, esta parábola:", "words": [[0, 56166], [2, 56278], [7, 56518], [15, 56858], [17, 57118], [22, 57298], [26, 57478], [36, 58078], [39, 58338], [42, 58458], [47, 58738], [55, 59378], [57, 59498], [72, 60438], [74, 60618], [78, 60798], [85, 61638], [90, 61958]]}, {"verse": 10, "start": 63043, "end": 69736, "text": "Dos hombres subieron al templo a orar: el uno fariseo, el otro recaudador de impuestos.", "words": [[0, 63043], [4, 63249], [12, 63739], [21, 64229], [24, 64389], [31, 64969], [33, 65129], [39, 65837], [42, 66118], [46, 66278], [55, 67418], [58, 67518], [63, 67718], [74, 68558], [77, 68758]]}, {"verse": 11, "start": 70086, "end": 82673, "text": "El fariseo, en pie, oraba consigo de esta manera: Dios, te doy gracias, que no soy como los otros hombres, ladrones, injustos, adúlteros, ni aun como este recaudador de impuestos;", "words": [[0, 70086], [3, 70249], [12, 71009], [15, 71149], [20, 71509], [26, 72569], [34, 73049], [37, 73369], [42, 73589], [50, 74457], [56, 74623], [59, 74803], [63, 75023], [72, 75783], [76, 75843], [79, 76023], [83, 76263], [88, 76483], [92, 76683], [98, 76923], [107, 77823], [117, 78663], [127, 79523], [138, 80463], [141, 80663], [145, 80863], [150, 81183], [155, 81403], [166, 82043], [169, 82203]]}, {"verse": 12, "start": 83023, "end": 87281, "text": "Ayuno dos veces a la semana, doy diezmos de todo lo que poseo.", "words": [[0, 83464], [6, 83924], [10, 84104], [16, 84364], [18, 84584], [21, 84644], [29, 85484], [33, 85684], [41, 86064], [44, 86244], [49, 86404], [52, 86584], [56, 86704]]}, {"verse": 13, "start": 87561, "end": 100131, "text": "Pero el recaudador de impuestos estando lejos no quería ni aun alzar los ojos al cielo, sino que se golpeaba el pecho, diciendo: Dios, ten misericordia de mí, pecador.", "words": [[0, 87561], [5, 87783], [8, 87983], [19, 88663], [22, 88903], [32, 89483], [40, 89983], [46, 90683], [49, 91123], [56, 91523], [59, 91923], [63, 92223], [69, 92903], [73, 93263], [78, 93663], [81, 93943], [88, 94483], [93, 95023], [97, 95223], [100, 95363], [109, 95963], [112, 96163], [119, 96903], [129, 97874], [135, 98120], [139, 98340], [152, 99100], [155, 99220], [159, 99560]]}, {"verse": 14, "start": 100411, "end": 111825, "text": "Os digo que este descendió a su casa justificado, a diferencia del otro; porque cualquiera que se enaltece, será humillado; y el que se humilla, será enaltecido.", "words": [[0, 100411], [3, 100535], [8, 100855], [12, 101115], [17, 101335], [27, 102055], [29, 102195], [32, 102315], [37, 102655], [50, 103995], [52, 104215], [63, 104555], [67, 105115], [73, 105833], [80, 106056], [91, 106716], [95, 106896], [98, 107056], [108, 107816], [113, 108136], [124, 109359], [126, 109520], [129, 109620], [133, 109760], [136, 109940], [145, 110360], [150, 110700]]}, {"verse": 15, "start": 112175, "end": 118378, "text": "Y traían a él los niños para que los tocase; lo cual viendo los discípulos les reprendían.", "words": [[0, 112175], [2, 112279], [9, 112819], [11, 112999], [14, 113199], [18, 113379], [24, 113819], [29, 114199], [33, 114379], [37, 114499], [45, 115539], [48, 115646], [53, 115806], [60, 116126], [64, 116346], [75, 117106], [79, 117486]]}, {"verse": 16, "start": 118728, "end": 126931, "text": "Pero Jesús llamándolos, dijo: Dejad los niños venir a mí, y no los impidáis; porque de tales es el reino de Dios.", "words": [[0, 118728], [5, 118873], [11, 119513], [24, 120153], [30, 120656], [36, 121236], [40, 121396], [46, 121776], [52, 122156], [54, 122336], [58, 122516], [60, 122936], [63, 123096], [67, 123684], [77, 124461], [84, 124685], [87, 124905], [93, 125205], [96, 125545], [99, 125745], [105, 126165], [108, 126325]]}, {"verse": 17, "start": 127281, "end": 134211, "text": "De cierto os digo, que cualquiera que no reciba el reino de Dios como un niño, no entrará en él.", "words": [[0, 127281], [3, 127467], [10, 127787], [13, 128167], [19, 128447], [23, 129007], [34, 129627], [38, 129767], [41, 129947], [48, 130507], [51, 130647], [57, 131007], [60, 131167], [65, 131407], [70, 131727], [73, 131967], [79, 132347], [82, 132967], [90, 133627], [93, 133807]]}, {"verse": 18, "start": 134561, "end": 140287, "text": "Y le preguntó un dirigente, diciendo: Maestro bueno, ¿qué haré para poseer la vida eterna?", "words": [[0, 134561], [2, 134669], [5, 134769], [14, 135289], [17, 135369], [28, 136049], [38, 137219], [46, 137699], [53, 138419], [58, 138539], [63, 138799], [68, 138959], [75, 139419], [78, 139519], [83, 139699]]}, {"verse": 19, "start": 140567, "end": 145856, "text": "Y Jesús le dijo: ¿Por qué me llamas bueno? ninguno hay bueno sino sólo Dios.", "words": [[0, 140567], [2, 140678], [8, 141078], [11, 141398], [17, 142205], [22, 142326], [26, 142506], [29, 142646], [36, 142986], [43, 143677], [51, 144143], [55, 144303], [61, 144623], [66, 144883], [71, 145203]]}, {"verse": 20, "start": 146206, "end": 157192, "text": "Los mandamientos sabes: No matarás: No adulterarás: No hurtarás: No dirás falso testimonio: Honra a tu padre y a tu madre.", "words": [[0, 146206], [4, 146332], [17, 146952], [24, 147876], [27, 148156], [36, 149221], [39, 149581], [52, 150940], [55, 151544], [65, 152403], [68, 152663], [74, 153023], [80, 153443], [92, 154601], [98, 155105], [100, 155305], [103, 155425], [109, 155865], [111, 156325], [113, 156425], [116, 156565]]}, {"verse": 21, "start": 157542, "end": 161614, "text": "Y él dijo: Todas estas cosas he guardado desde mi juventud.", "words": [[0, 157542], [2, 157859], [5, 158019], [11, 158775], [17, 158913], [23, 159253], [29, 159693], [32, 160033], [41, 160513], [47, 160733], [50, 160953]]}, {"verse": 22, "start": 161894, "end": 172988, "text": "Y Jesús, oído esto, le dijo: Aún te falta una cosa: vende todo lo que tienes, y da a los pobres, y tendrás tesoro en el cielo; y ven, sígueme.", "words": [[0, 161894], [2, 162017], [9, 162417], [14, 163097], [20, 163797], [23, 163937], [29, 164762], [33, 164985], [36, 165185], [42, 165485], [46, 165725], [52, 166449], [58, 166836], [63, 167136], [66, 167356], [70, 167456], [78, 167836], [80, 168336], [83, 168556], [85, 168676], [89, 168776], [97, 169396], [99, 169776], [107, 170236], [114, 170716], [117, 170836], [120, 170956], [127, 171720], [129, 171904], [134, 172364]]}, {"verse": 23, "start": 173338, "end": 179139, "text": "Entonces él, oídas estas cosas, se puso muy triste, porque era muy rico.", "words": [[0, 173338], [9, 173897], [13, 174317], [19, 174877], [25, 175117], [32, 175857], [35, 176117], [40, 176437], [44, 176797], [52, 177357], [59, 177977], [63, 178237], [67, 178517]]}, {"verse": 24, "start": 179489, "end": 189208, "text": "Y viendo Jesús que se había entristecido mucho, dijo: ¡Con cuánta dificultad entrarán en el reino de Dios los que tienen riquezas!", "words": [[0, 179489], [2, 179611], [9, 179871], [15, 180351], [19, 180871], [22, 181031], [28, 181691], [41, 182351], [48, 182991], [54, 183772], [59, 183920], [66, 184500], [77, 185400], [86, 186160], [89, 186380], [92, 186560], [98, 186960], [101, 187100], [106, 187380], [110, 187820], [114, 187960], [121, 188620]]}, {"verse": 25, "start": 189558, "end": 196561, "text": "Porque más fácil cosa es entrar un camello por el ojo de una aguja, que un rico entrar en el reino de Dios.", "words": [[0, 189558], [7, 189783], [11, 189963], [17, 190363], [22, 190803], [25, 191083], [32, 191523], [35, 191783], [43, 192263], [47, 192503], [50, 192623], [54, 192923], [57, 193043], [61, 193223], [68, 193843], [72, 194028], [75, 194188], [80, 194448], [87, 194968], [90, 195328], [93, 195488], [99, 195848], [102, 195968]]}, {"verse": 26, "start": 196911, "end": 200087, "text": "Y los que lo oían, dijeron: ¿Y quién podrá ser salvo?", "words": [[0, 196911], [2, 197017], [6, 197157], [10, 197317], [13, 197517], [19, 197997], [28, 198751], [31, 198876], [37, 199076], [43, 199476], [47, 199576]]}, {"verse": 27, "start": 200367, "end": 206284, "text": "Y él les dijo: Lo que es imposible para con los hombres, posible es para Dios.", "words": [[0, 200367], [2, 200549], [5, 200749], [9, 201109], [15, 201951], [18, 202093], [22, 202253], [25, 202413], [35, 203253], [40, 203493], [44, 203713], [48, 203893], [57, 204533], [65, 205253], [68, 205493], [73, 205693]]}, {"verse": 28, "start": 206634, "end": 212778, "text": "Entonces Pedro dijo: He aquí, nosotros hemos dejado las posesiones nuestras, y te hemos seguido.", "words": [[0, 206634], [9, 207175], [15, 207735], [21, 208659], [24, 208749], [30, 208989], [39, 209289], [45, 209769], [52, 210269], [56, 210409], [67, 210969], [77, 211449], [79, 211869], [82, 212029], [88, 212189]]}, {"verse": 29, "start": 213058, "end": 222499, "text": "Y él les dijo: De cierto os digo, que nadie hay que haya dejado casa, padres, o hermanos, o mujer, o hijos, por el reino de Dios,", "words": [[0, 213058], [2, 213221], [5, 213371], [9, 213521], [15, 214301], [18, 214509], [25, 214809], [28, 215229], [34, 215509], [38, 216109], [44, 216509], [48, 216989], [52, 217209], [57, 217369], [64, 217889], [70, 218257], [78, 218625], [80, 218993], [90, 219361], [92, 219729], [99, 220189], [101, 220389], [108, 220749], [112, 221329], [115, 221489], [121, 221889], [124, 222049]]}, {"verse": 30, "start": 222849, "end": 228114, "text": "Que no haya de recibir mucho más en este tiempo, y en la era venidera la vida eterna.", "words": [[0, 222849], [4, 222933], [7, 223113], [12, 223333], [15, 223513], [23, 223913], [29, 224293], [33, 224553], [36, 224733], [41, 224933], [49, 225393], [51, 225678], [54, 225858], [57, 226058], [61, 226318], [70, 226938], [73, 227018], [78, 227238]]}, {"verse": 31, "start": 228464, "end": 239405, "text": "Y Jesús, tomando a los doce, les dijo: He aquí subimos a Jerusalén, y serán cumplidas todas las cosas que fueron escritas por los profetas, del Hijo del hombre.", "words": [[0, 228464], [2, 228742], [9, 229462], [17, 229922], [19, 230022], [23, 230142], [29, 230942], [33, 231002], [39, 231777], [42, 231857], [47, 232077], [55, 232657], [57, 232817], [68, 233537], [70, 234037], [76, 234417], [86, 235117], [92, 235397], [96, 235697], [102, 235977], [106, 236197], [113, 236457], [122, 237077], [126, 237297], [130, 237457], [140, 238117], [144, 238442], [149, 238742], [153, 238922]]}, {"verse": 32, "start": 239755, "end": 246739, "text": "Porque será entregado a los gentiles, y será objeto de burlas, e injuriado, y escupido.", "words": [[0, 239755], [7, 239958], [12, 240338], [22, 241318], [24, 241398], [28, 241498], [38, 242218], [40, 242738], [45, 243018], [52, 243638], [55, 243878], [63, 244438], [65, 244738], [76, 245658], [78, 245878]]}, {"verse": 33, "start": 247089, "end": 252507, "text": "Y después que le hayan azotado, le matarán: pero al tercer día resucitará.", "words": [[0, 247089], [2, 247259], [10, 247499], [14, 247679], [17, 247799], [23, 248229], [32, 248659], [35, 248799], [44, 249721], [49, 250145], [52, 250385], [59, 250685], [63, 251145]]}, {"verse": 34, "start": 252857, "end": 261436, "text": "Pero ellos nada de estas cosas entendían, y esta palabra les era encubierta, y no entendían lo que se decía.", "words": [[0, 252857], [5, 253018], [11, 253738], [16, 254078], [19, 254298], [25, 254518], [31, 254958], [42, 256258], [44, 256498], [49, 256718], [57, 257098], [61, 257638], [65, 257878], [77, 258718], [79, 259318], [82, 259498], [92, 260178], [95, 260378], [99, 260518], [102, 260658]]}, {"verse": 35, "start": 261786, "end": 268249, "text": "Y aconteció que acercándose él a Jericó, un ciego estaba sentado junto al camino mendigando;", "words": [[0, 261786], [2, 261908], [12, 262628], [16, 263008], [28, 263768], [31, 264128], [33, 264328], [41, 265308], [44, 265578], [50, 265848], [57, 266068], [65, 266608], [71, 266788], [74, 267008], [81, 267348]]}, {"verse": 36, "start": 268599, "end": 272560, "text": "El cual cuando oyó la gente que pasaba, preguntó qué era aquello.", "words": [[0, 268599], [3, 268788], [8, 269008], [15, 269248], [19, 269708], [22, 269828], [28, 270088], [32, 270268], [40, 270988], [49, 271528], [53, 271708], [57, 271908]]}, {"verse": 37, "start": 272910, "end": 275527, "text": "Y le dijeron que pasaba Jesús nazareno.", "words": [[0, 272910], [2, 273018], [5, 273118], [13, 273618], [17, 273738], [24, 274178], [30, 274518]]}, {"verse": 38, "start": 275877, "end": 281517, "text": "Entonces dio voces, diciendo: Jesús, Hijo de David, ten misericordia de mí.", "words": [[0, 275877], [9, 276495], [13, 277075], [20, 277555], [30, 278501], [37, 279050], [42, 279270], [45, 279390], [52, 279850], [56, 280310], [69, 281090], [72, 281230]]}, {"verse": 39, "start": 281797, "end": 290448, "text": "Y los que iban delante, le reprendían para que callase; pero él clamaba mucho más: Hijo de David, ten misericordia de mí.", "words": [[0, 281797], [2, 281918], [6, 282078], [10, 282278], [15, 282538], [24, 282988], [27, 283438], [38, 284178], [43, 284478], [47, 284698], [56, 285813], [61, 285958], [64, 286218], [72, 286778], [78, 287118], [83, 288000], [88, 288258], [91, 288398], [98, 288958], [102, 289078], [115, 289878], [118, 290018]]}, {"verse": 40, "start": 290728, "end": 297006, "text": "Jesús entonces parándose, mandó traerle a sí: y como él llegó, le preguntó,", "words": [[0, 290728], [6, 291516], [15, 292316], [26, 293136], [32, 293456], [40, 293833], [42, 294210], [46, 294740], [48, 295004], [53, 295244], [56, 295464], [63, 295764], [66, 296284]]}, {"verse": 41, "start": 297356, "end": 301854, "text": "Diciendo: ¿Qué quieres que te haga? Y él dijo: Señor, que vea.", "words": [[0, 297356], [10, 298414], [15, 298518], [23, 298858], [27, 299038], [30, 299198], [36, 299924], [38, 300111], [41, 300446], [47, 300927], [54, 301233], [58, 301433]]}, {"verse": 42, "start": 302134, "end": 307113, "text": "Y Jesús le dijo: Recobra la vista, tu fe te ha hecho salvo.", "words": [[0, 302134], [2, 302257], [8, 302657], [11, 302977], [17, 304006], [25, 304336], [28, 304476], [35, 305316], [38, 305536], [41, 305816], [44, 306056], [47, 306196], [53, 306416]]}, {"verse": 43, "start": 307463, "end": 314884, "text": "Y enseguida vio, y le seguía, glorificando a Dios: y todo el pueblo como lo vio, dio a Dios alabanza.", "words": [[0, 307463], [2, 307596], [12, 308076], [17, 308416], [19, 308796], [22, 308916], [30, 309316], [43, 310176], [45, 310276], [51, 310987], [53, 311116], [58, 311356], [61, 311656], [68, 312056], [73, 312276], [76, 312476], [81, 313116], [85, 313376], [87, 313636], [92, 314294]]}]}