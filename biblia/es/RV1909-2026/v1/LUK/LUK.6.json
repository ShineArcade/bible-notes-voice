{"book": "LUK", "chapter": 6, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 448414, "verses": [{"verse": 1, "start": 300, "end": 11921, "text": "Y aconteció que pasando él por los sembrados en un sábado segundo del primero, sus discípulos arrancaban espigas, y comían, restregándolas con las manos.", "words": [[0, 300], [2, 422], [12, 1062], [16, 1262], [24, 1642], [27, 1982], [31, 2182], [35, 2382], [45, 3042], [48, 3262], [51, 3382], [58, 3902], [66, 4402], [70, 4722], [79, 5782], [83, 6082], [94, 6862], [105, 7642], [114, 8422], [116, 8902], [124, 9862], [139, 10902], [143, 11122], [147, 11302]]}, {"verse": 2, "start": 12371, "end": 17879, "text": "Y algunos de los fariseos les dijeron: ¿Por qué hacéis lo que no es lícito hacer en los sábados?", "words": [[0, 12371], [2, 12450], [10, 12770], [13, 12990], [17, 13090], [26, 13770], [30, 14070], [39, 15020], [44, 15135], [48, 15335], [55, 15775], [58, 15875], [62, 15995], [65, 16175], [68, 16315], [75, 16735], [81, 16975], [84, 17155], [88, 17275]]}, {"verse": 3, "start": 18229, "end": 28164, "text": "Y respondiendo Jesús les dijo: ¿Ni aun esto habéis leído, qué hizo David cuando tuvo hambre, él, y los que con él estaban;", "words": [[0, 18229], [2, 18351], [15, 19131], [21, 19491], [25, 19851], [31, 20839], [35, 20939], [39, 21199], [44, 21659], [51, 22039], [58, 22519], [62, 22759], [67, 23159], [73, 23519], [80, 23859], [85, 24279], [93, 25299], [97, 25719], [99, 26499], [103, 26659], [107, 26799], [111, 27059], [114, 27219]]}, {"verse": 4, "start": 28614, "end": 41936, "text": "Cómo entró en la casa de Dios, y tomó los panes de la Presencia, y comió, y dio también a los que estaban con él, los cuales no era lícito comer, sino a solos los sacerdotes?", "words": [[0, 28614], [5, 28820], [11, 29300], [14, 29380], [17, 29500], [22, 29780], [25, 30000], [31, 30300], [33, 31120], [38, 31440], [42, 31560], [48, 32020], [51, 32100], [54, 32220], [65, 32880], [67, 33020], [74, 33500], [76, 34000], [80, 34160], [88, 34640], [90, 35200], [94, 35320], [98, 35460], [106, 35720], [110, 36060], [114, 36789], [118, 36916], [125, 37236], [128, 37876], [132, 38036], [139, 38436], [146, 39316], [151, 39516], [153, 39716], [159, 40256], [163, 40736]]}, {"verse": 5, "start": 42386, "end": 46736, "text": "Y les decía: El Hijo del hombre es Señor aun del sábado.", "words": [[0, 42386], [2, 42535], [6, 42635], [13, 43674], [16, 43992], [21, 44212], [25, 44392], [32, 44772], [35, 45032], [41, 45332], [45, 45712], [49, 45972]]}, {"verse": 6, "start": 47186, "end": 56770, "text": "Y aconteció también en otro sábado, que él entró en la sinagoga y enseñaba; y estaba allí un hombre que tenía la mano derecha atrofiada.", "words": [[0, 47186], [2, 47330], [12, 48010], [20, 48350], [23, 48650], [28, 48870], [36, 49430], [40, 49910], [43, 50310], [49, 50830], [52, 50930], [55, 51070], [64, 51710], [66, 51890], [76, 53078], [78, 53339], [85, 53619], [90, 53899], [93, 54059], [100, 54359], [104, 54539], [110, 54819], [113, 54999], [118, 55219], [126, 55779]]}, {"verse": 7, "start": 57220, "end": 63968, "text": "Y le acechaban los escribas y los fariseos, si sanaría en sábado, por hallar de qué le acusasen.", "words": [[0, 57220], [2, 57345], [5, 57485], [15, 58125], [19, 58285], [28, 58985], [30, 59145], [34, 59305], [44, 60305], [47, 60565], [55, 61065], [58, 61305], [66, 61865], [70, 62165], [77, 62465], [80, 62745], [84, 62945], [87, 63105]]}, {"verse": 8, "start": 64418, "end": 75253, "text": "Pero él sabía los pensamientos de ellos; y dijo al hombre que tenía la mano atrofiada: Levántate, y ponte en medio. Y él levantándose, se puso en pie.", "words": [[0, 64418], [5, 64561], [8, 64761], [14, 65161], [18, 65301], [31, 65881], [34, 66101], [41, 66916], [43, 67198], [48, 67438], [51, 67618], [58, 67838], [62, 68138], [68, 68438], [71, 68578], [76, 68918], [87, 70416], [98, 71081], [100, 71321], [106, 71681], [109, 71861], [116, 72745], [118, 72908], [121, 73048], [135, 73948], [138, 74128], [143, 74528], [146, 74668]]}, {"verse": 9, "start": 75703, "end": 85494, "text": "Entonces Jesús les dice: Os preguntaré una cosa: ¿Es lícito en sábados hacer bien, o hacer mal? ¿salvar la vida, o quitarla?", "words": [[0, 75703], [9, 76323], [15, 76803], [19, 77103], [25, 77950], [28, 78117], [39, 78897], [43, 79057], [49, 80008], [53, 80201], [60, 80781], [63, 80961], [71, 81481], [77, 81861], [83, 82221], [85, 82741], [91, 83021], [96, 83801], [104, 84158], [107, 84418], [113, 84638], [115, 84818]]}, {"verse": 10, "start": 85944, "end": 94078, "text": "Y mirándolos a todos alrededor, dice al hombre: Extiende tu mano. Y él lo hizo así, y su mano fue restaurada.", "words": [[0, 85944], [2, 86069], [13, 86809], [15, 86929], [21, 87189], [32, 88109], [37, 88309], [40, 88549], [48, 89300], [57, 89908], [60, 90108], [66, 90998], [68, 91167], [71, 91287], [74, 91467], [79, 91707], [84, 92067], [86, 92307], [89, 92487], [94, 92727], [98, 92987]]}, {"verse": 11, "start": 94528, "end": 100871, "text": "Y ellos se llenaron de rabia; y hablaban los unos a los otros qué harían a Jesús.", "words": [[0, 94528], [2, 94839], [8, 95139], [11, 95659], [20, 96159], [23, 96299], [30, 97328], [32, 97434], [41, 97934], [45, 98174], [50, 98574], [52, 98874], [56, 99034], [62, 99354], [66, 99654], [73, 100114], [75, 100234]]}, {"verse": 12, "start": 101321, "end": 107436, "text": "Y aconteció en aquellos días, que fue al monte a orar, y pasó la noche orando a Dios.", "words": [[0, 101321], [2, 101446], [12, 102226], [15, 102366], [24, 102606], [30, 103106], [34, 103366], [38, 103586], [41, 103726], [47, 104026], [49, 104186], [55, 104626], [57, 105246], [62, 105566], [65, 105786], [71, 106086], [78, 106726], [80, 106886]]}, {"verse": 13, "start": 107886, "end": 115928, "text": "Y como fue de día, llamó a sus discípulos, y escogió doce de ellos, a los cuales también llamó apóstoles:", "words": [[0, 107886], [2, 107989], [7, 108209], [11, 108429], [14, 108569], [19, 109529], [25, 109969], [27, 110049], [31, 110229], [43, 111069], [45, 111769], [53, 112449], [58, 113109], [61, 113329], [68, 113689], [70, 113949], [74, 114089], [81, 114269], [89, 114629], [95, 115049]]}, {"verse": 14, "start": 116378, "end": 124478, "text": "A Simón, al cual también llamó Pedro, y a Andrés su hermano, Jacobo y Juan, Felipe y Bartolomé,", "words": [[0, 116378], [2, 116541], [9, 117261], [12, 117361], [17, 117561], [25, 117921], [31, 118401], [38, 119301], [40, 119541], [42, 119621], [49, 120361], [52, 120401], [61, 121261], [68, 121901], [70, 122061], [76, 122821], [83, 123221], [85, 123661]]}, {"verse": 15, "start": 124928, "end": 130604, "text": "Mateo y Tomás, Jacobo hijo de Alfeo, y Simón el que se llama Zelote,", "words": [[0, 124928], [6, 125494], [8, 125654], [15, 126434], [22, 127094], [27, 127254], [30, 127454], [37, 128414], [39, 128474], [45, 129094], [48, 129254], [52, 129394], [55, 129534], [61, 130089]]}, {"verse": 16, "start": 131054, "end": 136220, "text": "Judas hermano de Jacobo, y Judas Iscariote, que también fue el traidor.", "words": [[0, 131054], [6, 131360], [14, 131960], [17, 132020], [25, 132940], [27, 133100], [33, 133480], [44, 134480], [48, 134580], [56, 134960], [60, 135200], [63, 135480]]}, {"verse": 17, "start": 136670, "end": 155596, "text": "Y descendió con ellos, y se paró en un lugar llano, y un grupo numeroso de sus discípulos, y una grande multitud de pueblo de toda Judea y de Jerusalén, y de la costa de Tiro y de Sidón, que habían venido a oírle, y para ser sanados de sus enfermedades;", "words": [[0, 136670], [2, 136793], [12, 137313], [16, 137573], [23, 137933], [25, 138693], [28, 138873], [33, 139273], [36, 139453], [39, 139593], [45, 139973], [52, 141033], [54, 141213], [57, 141333], [63, 141553], [72, 142193], [75, 142373], [79, 142553], [91, 143353], [93, 143793], [97, 143953], [104, 144253], [113, 144953], [116, 145153], [123, 145553], [126, 145793], [131, 146073], [137, 146753], [139, 146853], [142, 146973], [153, 148231], [155, 148367], [158, 148487], [161, 148627], [167, 149167], [170, 149267], [175, 149647], [177, 149847], [180, 149987], [187, 150607], [191, 150967], [198, 151207], [205, 151667], [207, 151767], [214, 152467], [216, 152867], [221, 153067], [225, 153347], [233, 153967], [236, 154167], [240, 154327]]}, {"verse": 18, "start": 156046, "end": 161360, "text": "Y los que habían sido atormentados de espíritus inmundos: y estaban curados.", "words": [[0, 156046], [2, 156168], [6, 156288], [10, 156428], [17, 156688], [22, 157028], [35, 157968], [38, 158108], [48, 158848], [58, 160059], [60, 160160], [68, 160420]]}, {"verse": 19, "start": 161810, "end": 167738, "text": "Y toda la gente procuraba tocarle; porque salía de él poder, y sanaba a todos.", "words": [[0, 161810], [2, 161954], [7, 162174], [10, 162394], [16, 162714], [26, 163454], [35, 164635], [42, 164798], [48, 165258], [51, 165398], [54, 165558], [61, 165858], [63, 166438], [70, 166918], [72, 167058]]}, {"verse": 20, "start": 168188, "end": 177176, "text": "Y alzando él los ojos a sus discípulos, decía: Bienaventurados vosotros los pobres; porque vuestro es el reino de Dios.", "words": [[0, 168188], [2, 168316], [10, 168636], [13, 168956], [17, 169116], [22, 169496], [24, 169716], [28, 169896], [40, 170876], [47, 172098], [63, 172994], [72, 173514], [76, 173694], [84, 174739], [91, 174944], [99, 175444], [102, 175764], [105, 175944], [111, 176364], [114, 176504]]}, {"verse": 21, "start": 177626, "end": 187491, "text": "Bienaventurados los que ahora tenéis hambre; porque seréis saciados. Bienaventurados los que ahora lloráis, porque reiréis.", "words": [[0, 177626], [16, 178753], [20, 179333], [24, 179553], [30, 179793], [37, 180333], [45, 181356], [52, 181537], [59, 182037], [69, 183411], [85, 184511], [89, 184711], [93, 184911], [99, 185151], [108, 185931], [115, 186311]]}, {"verse": 22, "start": 187941, "end": 199900, "text": "Bienaventurados seréis, cuando los hombres os aborrezcan, y cuando os aparten de sí, y os insulten, y desechen vuestro nombre como malo, por el Hijo del hombre.", "words": [[0, 187941], [16, 188745], [24, 189245], [31, 189725], [35, 190045], [43, 190425], [46, 191095], [58, 191765], [60, 192325], [67, 192545], [70, 192765], [78, 193325], [81, 193465], [85, 193785], [87, 194585], [90, 194725], [100, 195725], [102, 196045], [111, 196645], [119, 197025], [126, 197385], [131, 197705], [137, 198305], [141, 198725], [144, 198865], [149, 199125], [153, 199325]]}, {"verse": 23, "start": 200350, "end": 210699, "text": "Gozaos en aquel día, y alegraos; porque he aquí vuestro recompensa es grande en los cielos; porque así hacían sus padres a los profetas.", "words": [[0, 200636], [7, 200956], [10, 201196], [16, 201556], [21, 201876], [23, 202607], [33, 203605], [40, 203732], [43, 203892], [48, 204232], [56, 204752], [67, 205652], [70, 205852], [77, 206312], [80, 206552], [84, 206652], [92, 207688], [99, 208008], [103, 208388], [110, 208848], [114, 209088], [121, 209548], [123, 209788], [127, 209908]]}, {"verse": 24, "start": 211148, "end": 215184, "text": "Pero ¡ay de vosotros, ricos! porque tenéis vuestro consuelo.", "words": [[0, 211148], [5, 211468], [9, 211788], [12, 212009], [22, 212468], [29, 213509], [36, 213693], [43, 214053], [51, 214393]]}, {"verse": 25, "start": 215634, "end": 224827, "text": "¡Ay de vosotros, los que estáis hartos! porque tendréis hambre. ¡Ay de vosotros, los que ahora reís! porque lamentaréis y lloraréis.", "words": [[0, 215733], [4, 215873], [7, 216073], [17, 216593], [21, 216813], [25, 216953], [32, 217373], [40, 218542], [47, 218747], [56, 219367], [64, 220464], [68, 220574], [71, 220754], [81, 221314], [85, 221874], [89, 222074], [95, 222314], [101, 223527], [108, 223667], [120, 224054], [122, 224440]]}, {"verse": 26, "start": 225277, "end": 235052, "text": "¡Ay de vosotros, cuando todos los hombres hablen bien de vosotros! porque así hacían sus padres a los falsos profetas.", "words": [[0, 225910], [4, 226560], [7, 226780], [17, 227360], [24, 227660], [30, 228120], [34, 228380], [42, 228740], [49, 229340], [54, 229620], [57, 229900], [67, 231041], [74, 231401], [78, 231801], [85, 232621], [89, 232841], [96, 233361], [98, 233641], [102, 233741], [109, 234181]]}, {"verse": 27, "start": 235502, "end": 241856, "text": "Pero a vosotros los que oís, digo: Amad a vuestros enemigos, haced bien a los que os aborrecen;", "words": [[0, 235502], [5, 235669], [7, 235769], [16, 236229], [20, 236449], [24, 236669], [29, 237009], [35, 238064], [40, 238230], [42, 238397], [51, 238797], [61, 239597], [67, 239897], [72, 240257], [74, 240597], [78, 240717], [82, 240857], [85, 240997]]}, {"verse": 28, "start": 242306, "end": 247418, "text": "Bendecid a los que os maldicen, y orad por los que os calumnian.", "words": [[0, 242796], [9, 243286], [11, 243526], [15, 243646], [19, 243786], [22, 243926], [32, 244499], [34, 245073], [39, 245646], [43, 246006], [47, 246226], [51, 246386], [54, 246526]]}, {"verse": 29, "start": 247868, "end": 255927, "text": "Y al que te hiera en la mejilla, dale también la otra; y al que te quite la capa, no le niegues tampoco la túnica.", "words": [[0, 247868], [2, 248007], [5, 248147], [9, 248307], [12, 248597], [18, 248887], [21, 249047], [24, 249127], [33, 250187], [38, 250487], [46, 250827], [49, 251147], [55, 252052], [57, 252154], [60, 252234], [64, 252374], [67, 252534], [73, 252774], [76, 253034], [82, 253934], [85, 254034], [88, 254174], [96, 254634], [104, 254914], [107, 255234]]}, {"verse": 30, "start": 256377, "end": 261378, "text": "Y a cualquiera que te pida, dale; y al que tome lo que es tuyo, no vuelvas a pedir.", "words": [[0, 256377], [2, 256463], [4, 256523], [15, 257003], [19, 257143], [22, 257303], [28, 257603], [34, 258408], [36, 258595], [39, 258715], [43, 258895], [48, 259335], [51, 259455], [55, 259595], [58, 259795], [64, 260135], [67, 260295], [75, 260775], [77, 260855]]}, {"verse": 31, "start": 261828, "end": 267228, "text": "Y como queréis que os hagan los hombres, así hacedles también vosotros:", "words": [[0, 261828], [2, 261931], [7, 262131], [15, 262631], [19, 262811], [22, 262971], [28, 263271], [32, 263451], [41, 264511], [45, 264851], [54, 265891], [62, 266211]]}, {"verse": 32, "start": 267678, "end": 275573, "text": "Porque si amáis a los que os aman, ¿qué gracias tendréis? porque también los pecadores aman a los que los aman.", "words": [[0, 267678], [7, 267922], [10, 268142], [16, 268662], [18, 269082], [22, 269202], [26, 269382], [29, 269562], [35, 270362], [40, 270602], [48, 271002], [58, 272139], [65, 272323], [73, 272823], [77, 273023], [87, 273583], [92, 274123], [94, 274523], [98, 274643], [102, 274763], [106, 274903]]}, {"verse": 33, "start": 276023, "end": 283291, "text": "Y si hacéis bien a los que os hacen bien, ¿qué gracias tendréis? porque también los pecadores hacen lo mismo.", "words": [[0, 276023], [2, 276144], [5, 276284], [12, 276804], [17, 277024], [19, 277304], [23, 277424], [27, 277592], [30, 277758], [36, 277924], [42, 278604], [47, 279124], [55, 279524], [65, 280847], [72, 281052], [80, 281432], [84, 281612], [94, 282132], [100, 282512], [103, 282712]]}, {"verse": 34, "start": 283741, "end": 293836, "text": "Y si prestáis a aquellos de quienes esperáis recibir, ¿qué gracias tendréis? porque también los pecadores prestan a los pecadores, para recibir otro tanto.", "words": [[0, 283741], [2, 284048], [5, 284188], [14, 284888], [16, 285108], [25, 285468], [28, 285748], [36, 286008], [45, 286628], [54, 287488], [59, 287608], [67, 288008], [77, 289336], [84, 289688], [92, 290128], [96, 290308], [106, 290868], [114, 291508], [116, 291588], [120, 291688], [131, 292148], [136, 292408], [144, 292888], [149, 293168]]}, {"verse": 35, "start": 294286, "end": 309728, "text": "Amad, pues, a vuestros enemigos, y haced bien, y prestad, no esperando de ello nada; y será vuestro recompensa grande, y seréis hijos del Altísimo: porque él es benigno para con los ingratos y malos.", "words": [[0, 294466], [6, 294686], [12, 294926], [14, 295166], [23, 295526], [33, 296146], [35, 296406], [41, 296666], [47, 297066], [49, 297756], [58, 298446], [61, 298526], [71, 298946], [74, 299226], [79, 299366], [85, 300234], [87, 300360], [92, 300600], [100, 301280], [111, 302360], [119, 302840], [121, 303340], [128, 303860], [134, 304280], [138, 304600], [148, 305950], [155, 306194], [158, 306574], [161, 306854], [169, 307694], [174, 307914], [178, 308154], [182, 308294], [191, 308854], [193, 309094]]}, {"verse": 36, "start": 310178, "end": 314843, "text": "Sed pues misericordiosos, como también vuestro Padre es misericordioso.", "words": [[0, 310178], [4, 310661], [9, 311241], [26, 311821], [31, 312041], [39, 312401], [47, 312801], [53, 313501], [56, 313661]]}, {"verse": 37, "start": 315293, "end": 323434, "text": "No juzguéis, y no seréis juzgados: no condenéis, y no seréis condenados: perdonad, y seréis perdonados.", "words": [[0, 315293], [3, 315620], [13, 315980], [15, 316200], [18, 316340], [25, 316700], [35, 317875], [38, 318095], [49, 318715], [51, 319135], [54, 319295], [61, 319755], [73, 321021], [83, 321615], [85, 321835], [92, 322295]]}, {"verse": 38, "start": 323884, "end": 335953, "text": "Dad, y se os dará; medida buena, apretada, sacudida, y rebosando darán en vuestro regazo: porque con la misma medida con que medís, os será vuelto a medir.", "words": [[0, 323884], [5, 324384], [7, 324704], [10, 324844], [13, 325024], [19, 325968], [26, 326178], [33, 326638], [43, 327438], [53, 328098], [55, 328598], [65, 329098], [71, 329658], [74, 329878], [82, 330522], [90, 331516], [97, 331666], [101, 331866], [104, 332006], [110, 332306], [117, 332986], [121, 333206], [125, 333426], [132, 333936], [135, 334446], [140, 334806], [147, 335366], [149, 335446]]}, {"verse": 39, "start": 336403, "end": 342674, "text": "Y les decía una parábola: ¿Puede el ciego guiar al ciego? ¿No caerán ambos en el hoyo?", "words": [[0, 336403], [2, 336530], [6, 336670], [12, 337090], [16, 337330], [26, 338464], [33, 338708], [36, 338848], [42, 339288], [48, 339688], [51, 339828], [58, 340766], [62, 340912], [69, 341472], [75, 341852], [78, 342072], [81, 342403]]}, {"verse": 40, "start": 343124, "end": 350933, "text": "El discípulo no es superior a su maestro; pero cualquiera que sea como el maestro, estará plenamente formado.", "words": [[0, 343124], [3, 343290], [13, 344050], [16, 344370], [19, 344570], [28, 345090], [30, 345370], [33, 345450], [42, 346573], [47, 346718], [58, 347238], [62, 347398], [66, 347618], [71, 347878], [74, 348018], [83, 349018], [90, 349598], [101, 350138]]}, {"verse": 41, "start": 351383, "end": 358437, "text": "¿Por qué miras la paja que está en el ojo de tu hermano, y la viga que está en tu propio ojo no consideras?", "words": [[0, 351440], [5, 351534], [9, 351627], [15, 352227], [18, 352527], [23, 352907], [27, 353067], [32, 353287], [35, 353487], [38, 353607], [42, 353887], [45, 354027], [48, 354147], [57, 355207], [59, 355327], [62, 355487], [67, 355787], [71, 355927], [76, 356127], [79, 356247], [82, 356387], [89, 356727], [93, 357227], [96, 357387]]}, {"verse": 42, "start": 358887, "end": 376727, "text": "¿O cómo puedes decir a tu hermano: Hermano, deja, echaré fuera la paja que está en tu ojo, no mirando tú la viga que está en tu ojo? Hipócrita, echa primero fuera de tu ojo la viga, y entonces verás bien para sacar la paja que está en el ojo de tu hermano.", "words": [[0, 358887], [3, 359004], [8, 359264], [15, 359724], [21, 360184], [23, 360364], [26, 360484], [35, 361398], [44, 362206], [50, 362826], [57, 363866], [63, 364126], [66, 364406], [71, 364806], [75, 365006], [80, 365186], [83, 365346], [86, 365566], [91, 366046], [94, 366546], [102, 367006], [105, 367306], [108, 367486], [113, 367806], [117, 367946], [122, 368146], [125, 368286], [128, 368466], [133, 369255], [144, 369766], [149, 370316], [157, 370676], [163, 370996], [166, 371256], [169, 371436], [173, 371676], [176, 371836], [182, 372216], [184, 372356], [193, 372756], [199, 373656], [204, 373836], [209, 374156], [215, 374496], [218, 374756], [223, 375096], [227, 375236], [232, 375456], [235, 375556], [238, 375676], [242, 375916], [245, 376036], [248, 376176]]}, {"verse": 43, "start": 377177, "end": 382936, "text": "Porque no es buen árbol el que da malos frutos; ni árbol malo el que da buen fruto.", "words": [[0, 377177], [7, 377402], [10, 377662], [13, 377862], [18, 378062], [24, 378582], [27, 378842], [31, 378982], [34, 379142], [40, 379462], [48, 380674], [51, 380764], [57, 381164], [62, 381624], [65, 381751], [69, 381877], [72, 382004], [77, 382244]]}, {"verse": 44, "start": 383386, "end": 392529, "text": "Porque cada árbol por su fruto es conocido: que no cogen higos de los espinos, ni vendimian uvas de las zarzas.", "words": [[0, 383386], [7, 383571], [12, 383971], [18, 384551], [22, 384791], [25, 385011], [31, 385471], [34, 385591], [44, 386770], [48, 386853], [51, 387013], [57, 387573], [63, 388032], [66, 388193], [70, 388333], [79, 389046], [82, 389760], [92, 390472], [97, 391133], [100, 391453], [104, 392014]]}, {"verse": 45, "start": 392979, "end": 404059, "text": "El buen hombre del buen tesoro de su corazón saca bien; y el mal hombre del mal tesoro de su corazón saca mal; porque de la abundancia del corazón habla su boca.", "words": [[0, 392979], [3, 393103], [8, 393283], [15, 393583], [19, 393803], [24, 394003], [31, 394483], [34, 394603], [37, 394763], [45, 395203], [50, 395583], [56, 396360], [58, 396480], [61, 396640], [65, 396920], [72, 397480], [76, 397680], [80, 397940], [87, 398440], [90, 398580], [93, 398720], [101, 399160], [106, 399640], [111, 400864], [118, 400864], [121, 401164], [124, 401324], [135, 402164], [139, 402324], [147, 402864], [153, 403304], [156, 403484]]}, {"verse": 46, "start": 404509, "end": 407969, "text": "¿Por qué me llamáis, Señor, Señor, y no hacéis lo que digo?", "words": [[0, 404509], [5, 404613], [9, 404753], [12, 404873], [21, 405493], [28, 405973], [35, 406553], [37, 406633], [40, 406773], [47, 407213], [50, 407353], [54, 407493]]}, {"verse": 47, "start": 408419, "end": 415273, "text": "Todo aquel que viene a mí, y oye mis palabras, y las hace, os enseñaré a quién es semejante:", "words": [[0, 408419], [5, 408604], [11, 409044], [15, 409164], [21, 409424], [23, 409584], [27, 409764], [29, 410064], [33, 410324], [37, 410484], [47, 410984], [49, 411604], [53, 411804], [59, 412664], [62, 412784], [71, 413504], [73, 413704], [79, 413864], [82, 414264]]}, {"verse": 48, "start": 415723, "end": 433323, "text": "Semejante es al hombre que edifica una casa, el cual cavó y ahondó, y puso el fundamento sobre la roca; y cuando vino una crecida, el río dio con ímpetu en aquella casa, pero no la pudo mover: porque estaba fundada sobre la roca.", "words": [[0, 416086], [10, 416486], [13, 416726], [16, 416886], [23, 417146], [27, 417386], [35, 418106], [39, 418386], [45, 419226], [48, 419526], [53, 419956], [58, 420386], [60, 420526], [68, 421106], [70, 421586], [75, 421966], [78, 422086], [89, 422726], [95, 422966], [98, 423186], [104, 424098], [106, 424215], [113, 424435], [118, 424735], [122, 425555], [131, 426375], [134, 426515], [138, 426815], [142, 427035], [146, 427335], [153, 428135], [156, 428315], [164, 428615], [170, 429475], [175, 429595], [178, 429815], [181, 429935], [186, 430215], [193, 431062], [200, 431226], [207, 431506], [215, 432166], [221, 432446], [224, 432686]]}, {"verse": 49, "start": 433773, "end": 448014, "text": "Pero el que oyó y no hizo, semejante es al hombre que edificó su casa sobre tierra, sin fundamento; en la cual el río dio con ímpetu, y luego cayó; y fue grande la ruina de aquella casa.", "words": [[0, 433773], [5, 433935], [8, 434075], [12, 434235], [16, 434615], [18, 434815], [21, 434935], [27, 435775], [37, 436555], [40, 436915], [43, 437215], [50, 437495], [54, 437735], [62, 438355], [65, 438515], [70, 438815], [76, 439115], [84, 439555], [88, 440235], [100, 441654], [103, 441782], [106, 441902], [111, 442162], [114, 442502], [118, 442862], [122, 443042], [126, 443302], [134, 443902], [136, 444302], [142, 444522], [148, 445511], [150, 445618], [154, 445778], [161, 446098], [164, 446358], [170, 446818], [173, 446998], [181, 447358]]}]}