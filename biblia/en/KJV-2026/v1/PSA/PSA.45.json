{"book": "PSA", "chapter": 45, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 116536, "verses": [{"verse": 1, "start": 300, "end": 7844, "text": "My heart is inditing a good matter: I speak of the things which I have made touching the king: my tongue is the pen of a ready writer.", "words": [[0, 300], [3, 428], [9, 748], [12, 1148], [21, 1548], [23, 1648], [28, 1808], [36, 2678], [38, 2765], [44, 2985], [47, 3205], [51, 3325], [58, 3605], [64, 3865], [66, 4045], [71, 4165], [76, 4405], [85, 4725], [89, 4985], [95, 5783], [98, 5908], [105, 6168], [108, 6408], [112, 6548], [116, 6808], [119, 6948], [121, 7048], [127, 7268]]}, {"verse": 2, "start": 8294, "end": 15764, "text": "You are fairer than the children of men: grace is poured into your lips: therefore God has blessed you for ever.", "words": [[0, 8294], [4, 8479], [8, 8699], [15, 9299], [20, 9439], [24, 9559], [33, 9919], [36, 10139], [41, 11024], [47, 11310], [50, 11610], [57, 11950], [62, 12250], [67, 12470], [73, 13354], [83, 13856], [87, 14136], [91, 14396], [99, 14716], [103, 15080], [107, 15444]]}, {"verse": 3, "start": 16215, "end": 21355, "text": "Gird your sword upon your thigh, O most mighty, with your glory and your majesty.", "words": [[0, 16215], [5, 16446], [10, 16606], [16, 16946], [21, 17266], [26, 17526], [33, 17813], [35, 18099], [40, 18386], [48, 19506], [53, 19606], [58, 19786], [64, 20226], [68, 20466], [73, 20606]]}, {"verse": 4, "start": 21805, "end": 29728, "text": "And in your majesty ride prosperously because of truth and meekness and righteousness; and your right hand shall teach you terrible things.", "words": [[0, 21805], [4, 21949], [7, 22049], [12, 22189], [20, 22669], [25, 23069], [38, 24009], [46, 24329], [49, 24549], [55, 24869], [59, 25149], [68, 25609], [72, 25809], [87, 27023], [91, 27160], [96, 27320], [102, 27540], [107, 27840], [113, 28100], [119, 28400], [123, 28600], [132, 28960]]}, {"verse": 5, "start": 30178, "end": 34920, "text": "Your arrows are sharp in the heart of the king’s enemies; by which the people fall under you.", "words": [[0, 30178], [5, 30307], [12, 30667], [16, 30887], [22, 31227], [25, 31487], [29, 31607], [35, 31747], [38, 31867], [42, 31987], [49, 32327], [58, 33172], [61, 33291], [67, 33491], [71, 33691], [78, 33951], [83, 34271], [89, 34571]]}, {"verse": 6, "start": 35370, "end": 41120, "text": "Your throne, O God, is for ever and ever: the sceptre of your kingdom is a right sceptre.", "words": [[0, 35370], [5, 35482], [13, 36062], [15, 36182], [20, 36782], [23, 37009], [27, 37235], [32, 37462], [36, 37802], [42, 38607], [46, 38866], [54, 39156], [57, 39336], [62, 39456], [70, 39816], [73, 40136], [75, 40236], [81, 40706]]}, {"verse": 7, "start": 41570, "end": 50366, "text": "You love righteousness, and hate wickedness: therefore God, your God, has anointed you with the oil of gladness above your fellows.", "words": [[0, 41570], [4, 41675], [9, 41935], [24, 42455], [28, 42975], [33, 43235], [45, 44373], [55, 45249], [60, 45729], [65, 45969], [70, 46369], [74, 46809], [83, 47229], [87, 47529], [92, 47769], [96, 47929], [100, 48249], [103, 48449], [112, 49049], [118, 49389], [123, 49649]]}, {"verse": 8, "start": 50816, "end": 57740, "text": "All your garments smell of myrrh, and aloes, and cassia, out of the ivory palaces, by which they have made you glad.", "words": [[0, 50816], [4, 50988], [9, 51168], [18, 51468], [24, 51888], [27, 52158], [34, 52428], [38, 53008], [45, 53668], [49, 54018], [57, 54368], [61, 54848], [64, 54988], [68, 55088], [74, 55408], [83, 56028], [86, 56308], [92, 56508], [97, 56708], [102, 56808], [107, 56988], [111, 57168]]}, {"verse": 9, "start": 58190, "end": 65020, "text": "Kings’ daughters were among your honourable women: upon your right hand did stand the queen in gold of Ophir.", "words": [[0, 58190], [7, 58796], [17, 59096], [22, 59396], [28, 59596], [33, 59946], [44, 60296], [51, 61242], [56, 61565], [61, 61785], [67, 62045], [72, 62465], [76, 62865], [82, 63285], [86, 63465], [92, 63785], [95, 64045], [100, 64305], [103, 64485]]}, {"verse": 10, "start": 65470, "end": 72286, "text": "Hearken, O daughter, and consider, and incline your ear; forget also your own people, and your father’s house;", "words": [[0, 65698], [9, 65958], [11, 66058], [21, 66858], [25, 66958], [35, 67418], [39, 67898], [47, 68398], [52, 68578], [57, 69363], [64, 69602], [69, 69982], [74, 70282], [78, 70482], [86, 70822], [90, 71182], [95, 71342], [104, 71782]]}, {"verse": 11, "start": 72736, "end": 77829, "text": "So shall the king greatly desire your beauty: for he is your Lord; and worship him.", "words": [[0, 72736], [3, 72854], [9, 73054], [13, 73234], [18, 73434], [26, 73774], [33, 74174], [38, 74434], [46, 75272], [50, 75592], [53, 75792], [56, 75952], [61, 76092], [67, 76931], [71, 77079], [79, 77359]]}, {"verse": 12, "start": 78279, "end": 83766, "text": "And the daughter of Tyre shall be there with a gift; even the rich among the people shall entreat your favour.", "words": [[0, 78279], [4, 78389], [8, 78489], [17, 78749], [20, 78909], [25, 79289], [31, 79429], [34, 79609], [40, 79849], [45, 80009], [47, 80109], [53, 80869], [58, 81082], [62, 81262], [67, 81462], [73, 81682], [77, 81922], [84, 82282], [90, 82542], [98, 82982], [103, 83403]]}, {"verse": 13, "start": 84216, "end": 89202, "text": "The king’s daughter is all glorious within: her clothing is of wrought gold.", "words": [[0, 84216], [4, 84300], [11, 84720], [20, 85000], [23, 85260], [27, 85440], [36, 85940], [44, 87026], [48, 87132], [57, 87552], [60, 87832], [63, 87972], [71, 88292]]}, {"verse": 14, "start": 89652, "end": 97226, "text": "She shall be brought to the king in clothing of needlework: the virgins her companions that follow her shall be brought to you.", "words": [[0, 89652], [4, 89793], [10, 90033], [13, 90173], [21, 90413], [24, 90633], [28, 90733], [33, 91033], [36, 91253], [45, 91593], [48, 91813], [60, 93948], [64, 94087], [72, 94367], [76, 94647], [87, 95047], [92, 95427], [99, 95727], [103, 95947], [109, 96187], [112, 96347], [120, 96587], [123, 96867]]}, {"verse": 15, "start": 97676, "end": 102553, "text": "With gladness and rejoicing shall they be brought: they shall enter into the king’s palace.", "words": [[0, 97676], [5, 97802], [14, 98402], [18, 98542], [28, 99142], [34, 99422], [39, 99582], [42, 99722], [51, 100602], [56, 100692], [62, 100892], [68, 101172], [73, 101412], [77, 101572], [84, 101892]]}, {"verse": 16, "start": 103003, "end": 108230, "text": "Instead of your fathers shall be your children, whom you may make princes in all the earth.", "words": [[0, 103003], [8, 103314], [11, 103574], [16, 103714], [24, 104114], [30, 104454], [33, 104654], [38, 104854], [48, 105634], [53, 105914], [57, 106134], [61, 106354], [66, 106594], [74, 107034], [77, 107334], [81, 107594], [85, 107814]]}, {"verse": 17, "start": 108680, "end": 116136, "text": "I will make your name to be remembered in all generations: therefore shall the people praise you for ever and ever.", "words": [[0, 108680], [2, 108836], [7, 108996], [12, 109196], [17, 109376], [22, 109616], [25, 109796], [28, 109976], [39, 110396], [42, 110696], [46, 110916], [59, 112289], [69, 112705], [75, 113065], [79, 113225], [86, 113465], [93, 113845], [97, 114145], [101, 114385], [106, 114625], [110, 114905]]}]}