{"book": "MAT", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 250197, "verses": [{"verse": 1, "start": 300, "end": 7862, "text": "Y llegándose los fariseos y los saduceos para tentarle, le pedían que les mostrase señal del cielo.", "words": [[0, 300], [2, 427], [13, 1167], [17, 1347], [26, 2127], [28, 2247], [32, 2387], [41, 3187], [46, 3930], [56, 4672], [59, 4892], [66, 5412], [70, 5612], [74, 5772], [83, 6452], [89, 7052], [93, 7192]]}, {"verse": 2, "start": 8212, "end": 16819, "text": "Pero él respondiendo, les dijo: Cuando es la tarde del día, decís: Sereno; porque el cielo está rojizo.", "words": [[0, 8212], [5, 8556], [8, 9296], [22, 10316], [26, 10416], [32, 11262], [39, 11427], [42, 11667], [45, 11827], [51, 12107], [55, 12407], [60, 12955], [67, 13724], [75, 14804], [82, 15086], [85, 15286], [91, 15666], [96, 15966]]}, {"verse": 3, "start": 17169, "end": 29164, "text": "Y a la mañana: Hoy tempestad; porque el cielo está rojizo y sombrío. Hipócritas, que sabéis hacer diferencia en el aspecto del cielo; ¿y en las señales de los tiempos no podéis?", "words": [[0, 17169], [2, 17337], [4, 17417], [7, 17477], [15, 18289], [19, 18479], [30, 19545], [37, 19770], [40, 19950], [46, 20350], [51, 20610], [58, 21170], [60, 21310], [69, 22225], [81, 23325], [85, 23465], [92, 23925], [98, 24205], [109, 24945], [112, 25145], [115, 25245], [123, 25725], [127, 25885], [134, 26637], [137, 26753], [140, 26873], [144, 26993], [152, 27573], [155, 27673], [159, 27813], [167, 28293], [170, 28433]]}, {"verse": 4, "start": 29514, "end": 39117, "text": "La generación mala y adúltera demanda señal; pero señal no le será dada, sino la señal de Jonás profeta. Y dejándolos, se fue.", "words": [[0, 29514], [3, 29621], [14, 30261], [19, 30661], [21, 31051], [30, 31441], [38, 31941], [45, 32816], [50, 33116], [56, 33756], [59, 34056], [62, 34356], [67, 34576], [73, 34976], [78, 35256], [81, 35516], [87, 35976], [90, 36096], [96, 36336], [105, 37475], [107, 37602], [119, 38422], [122, 38722]]}, {"verse": 5, "start": 39467, "end": 45134, "text": "Y viniendo sus discípulos del otro lado del lago, se habían olvidado de tomar pan.", "words": [[0, 39467], [2, 39595], [11, 40135], [15, 40315], [26, 41055], [30, 41275], [35, 41495], [40, 41795], [44, 42055], [50, 42795], [53, 43275], [60, 43495], [69, 44095], [72, 44255], [78, 44475]]}, {"verse": 6, "start": 45484, "end": 53195, "text": "Y Jesús les dijo: Mirad, y guardaos de la levadura de los fariseos y de los saduceos.", "words": [[0, 45484], [2, 45608], [8, 45948], [12, 46268], [18, 47724], [25, 48289], [27, 48929], [36, 49709], [39, 50069], [42, 50189], [51, 50709], [54, 50869], [58, 51009], [67, 51789], [69, 51929], [72, 52069], [76, 52189]]}, {"verse": 7, "start": 53545, "end": 58551, "text": "Y ellos pensaban dentro de sí, diciendo: Esto dice porque no tomamos pan.", "words": [[0, 53545], [2, 53671], [8, 53871], [17, 54491], [24, 54811], [27, 55071], [31, 55771], [41, 56662], [46, 56899], [51, 57219], [58, 57559], [61, 57759], [69, 58139]]}, {"verse": 8, "start": 58831, "end": 66217, "text": "Y entendiéndolo Jesús, les dijo: ¿Por qué pensáis dentro de vosotros, hombres de poca fe, que no tomasteis pan?", "words": [[0, 58831], [2, 59285], [16, 59775], [23, 60215], [27, 60635], [33, 61374], [38, 61498], [42, 61638], [50, 62258], [57, 62598], [60, 62938], [70, 63658], [78, 63938], [81, 64138], [86, 64418], [90, 64998], [94, 65058], [97, 65467], [107, 65876]]}, {"verse": 9, "start": 66567, "end": 73827, "text": "¿No entendéis aún, ni os acordáis de los cinco panes entre cinco mil hombres, y cuántos cestos recogisteis?", "words": [[0, 66567], [4, 66755], [14, 67335], [19, 67835], [22, 68335], [25, 68495], [34, 69095], [37, 69275], [41, 69435], [47, 69755], [53, 70295], [59, 70555], [65, 70955], [69, 71235], [78, 71615], [80, 71870], [88, 72230], [95, 72590]]}, {"verse": 10, "start": 74177, "end": 78356, "text": "¿Ni de los siete panes entre cuatro mil, y cuántas canastas tomasteis?", "words": [[0, 74177], [4, 74302], [7, 74402], [11, 74582], [17, 74762], [23, 75302], [29, 75555], [36, 75809], [41, 76062], [43, 76442], [51, 76842], [60, 77502]]}, {"verse": 11, "start": 78706, "end": 87201, "text": "¿Cómo es que no entendéis que no por el pan os dije, que os guardaseis de la levadura de los fariseos y de los saduceos?", "words": [[0, 78706], [6, 78936], [9, 79136], [13, 79276], [16, 79436], [26, 80436], [30, 80536], [33, 80696], [37, 80936], [40, 81056], [44, 81336], [47, 81496], [53, 82416], [57, 82536], [60, 82676], [71, 83556], [74, 83936], [77, 84076], [86, 84576], [89, 84716], [93, 84836], [102, 85616], [104, 85816], [107, 85936], [111, 86076]]}, {"verse": 12, "start": 87551, "end": 96753, "text": "Entonces entendieron que no les había dicho que se guardasen de la levadura de pan, sino de la doctrina de los fariseos y de los saduceos.", "words": [[0, 87551], [9, 88355], [21, 88955], [25, 89155], [28, 89295], [32, 89455], [38, 89715], [44, 90095], [48, 90295], [51, 90435], [61, 91175], [64, 91295], [67, 91455], [76, 91915], [79, 92075], [84, 92475], [89, 92815], [92, 93015], [95, 93155], [104, 93755], [107, 93915], [111, 94415], [120, 94915], [122, 95295], [125, 95415], [129, 95555]]}, {"verse": 13, "start": 97103, "end": 106074, "text": "Y viniendo Jesús a las partes de Cesarea de Filipo, preguntó a sus discípulos, diciendo: ¿Quién dicen los hombres que es el Hijo del hombre?", "words": [[0, 97103], [2, 97207], [11, 97727], [17, 97987], [19, 98227], [23, 98327], [30, 98707], [33, 99097], [41, 99487], [44, 99967], [52, 100447], [61, 101147], [63, 101227], [67, 101407], [79, 102067], [89, 103030], [96, 103354], [102, 103754], [106, 104014], [114, 104454], [118, 104674], [121, 104894], [124, 105034], [129, 105274], [133, 105474]]}, {"verse": 14, "start": 106424, "end": 114164, "text": "Y ellos dijeron: Unos, Juan el Bautista; y otros, Elías; y otros, Jeremías, o alguno de los profetas.", "words": [[0, 106424], [2, 106694], [8, 106964], [17, 108010], [23, 108314], [28, 108634], [31, 108794], [41, 109764], [43, 109943], [50, 110203], [57, 111379], [59, 111522], [66, 111762], [76, 112582], [78, 112822], [85, 113222], [88, 113262], [92, 113382]]}, {"verse": 15, "start": 114444, "end": 117880, "text": "Él les dice: Y vosotros, ¿quién decís que soy?", "words": [[0, 114444], [3, 114653], [7, 114833], [13, 115691], [15, 115797], [25, 116357], [32, 116817], [38, 117317], [42, 117397]]}, {"verse": 16, "start": 118230, "end": 123869, "text": "Y respondiendo Simón Pedro, dijo: Tú eres el Cristo, el Hijo del Dios viviente.", "words": [[0, 118230], [2, 118230], [15, 119318], [21, 119658], [28, 120098], [34, 121194], [37, 121351], [42, 121531], [45, 121711], [53, 122491], [56, 122591], [61, 122811], [65, 122951], [70, 123151]]}, {"verse": 17, "start": 124149, "end": 136128, "text": "Entonces, respondiendo Jesús, le dijo: Bienaventurado eres, Simón, hijo de Jonás; porque no te lo reveló carne ni sangre, sino mi Padre que está en los cielos.", "words": [[0, 124149], [10, 124669], [23, 125789], [30, 126609], [33, 126749], [39, 128186], [54, 128766], [60, 128986], [67, 129826], [72, 129986], [75, 130146], [82, 131020], [89, 131204], [92, 131424], [95, 131544], [98, 131839], [105, 132134], [111, 132429], [114, 132724], [122, 133444], [127, 133764], [130, 134024], [136, 134624], [140, 134904], [145, 135124], [148, 135284], [152, 135384]]}, {"verse": 18, "start": 136478, "end": 146893, "text": "Pero yo también te digo, que tú eres Pedro, y sobre esta piedra edificaré mi iglesia; y las puertas del infierno no prevalecerán contra ella.", "words": [[0, 136478], [5, 136619], [8, 136799], [16, 137119], [19, 137459], [25, 137879], [29, 138359], [32, 138519], [37, 138699], [44, 139259], [46, 139564], [52, 139864], [57, 140244], [64, 141044], [74, 141844], [77, 142396], [86, 143133], [88, 143241], [92, 143341], [100, 143701], [104, 143901], [113, 144561], [116, 145101], [129, 145961], [136, 146341]]}, {"verse": 19, "start": 147243, "end": 159448, "text": "Y a ti daré las llaves del reino de los cielos; y todo lo que ligues en la tierra será ligado en los cielos; y todo lo que desates en la tierra será desatado en los cielos.", "words": [[0, 147243], [2, 147421], [4, 147541], [7, 147721], [12, 148101], [16, 148261], [23, 148821], [27, 149141], [33, 149641], [36, 149761], [40, 149881], [48, 150915], [50, 151167], [55, 151347], [58, 151567], [62, 151687], [69, 152047], [72, 152147], [75, 152287], [82, 152587], [87, 153037], [94, 153487], [97, 153607], [101, 153727], [109, 154674], [111, 154795], [116, 155115], [119, 155435], [123, 155595], [131, 156175], [134, 156455], [137, 156595], [144, 157035], [149, 157435], [158, 158375], [161, 158495], [165, 158655]]}, {"verse": 20, "start": 159798, "end": 164889, "text": "Entonces mandó a sus discípulos que a nadie dijesen que él era Jesús el Cristo.", "words": [[0, 159798], [9, 160278], [15, 160858], [17, 160958], [21, 161098], [32, 161758], [36, 161978], [38, 162098], [44, 162578], [52, 163058], [56, 163258], [59, 163438], [63, 163578], [69, 164036], [72, 164494]]}, {"verse": 21, "start": 165239, "end": 182562, "text": "Desde aquel tiempo comenzó Jesús a declarar a sus discípulos que le convenía ir a Jerusalén, y padecer mucho de los ancianos, y de los príncipes de los sacerdotes, y de los escribas; y ser muerto, y resucitar al tercer día.", "words": [[0, 165239], [6, 165425], [12, 165805], [19, 166125], [27, 166825], [33, 167145], [35, 167425], [44, 168065], [46, 168145], [50, 168325], [61, 169245], [65, 169805], [68, 169945], [77, 170625], [80, 170965], [82, 171065], [93, 172325], [95, 172645], [103, 173165], [109, 173625], [112, 173805], [116, 173965], [126, 174725], [128, 174985], [131, 175085], [135, 175595], [145, 176105], [148, 176285], [152, 176405], [164, 177609], [166, 177756], [169, 177796], [173, 177956], [183, 179106], [185, 179247], [189, 179407], [197, 180067], [199, 180447], [209, 181287], [212, 181567], [219, 181887]]}, {"verse": 22, "start": 182912, "end": 191922, "text": "Y Pedro, tomándolo aparte, comenzó a reprenderle, diciendo: Señor, ten compasión de ti: en ninguna manera esto te acontezca.", "words": [[0, 182912], [2, 183191], [9, 183671], [19, 184231], [27, 185271], [35, 185731], [37, 185831], [50, 186611], [60, 187778], [67, 188419], [71, 188499], [81, 189059], [84, 189199], [88, 189700], [91, 189838], [99, 190098], [106, 190598], [111, 190978], [114, 191473]]}, {"verse": 23, "start": 192202, "end": 204101, "text": "Entonces él, volviéndose, dijo a Pedro: Quítate de delante de mí, Satanás; me eres tropiezo; porque no entiendes lo que es de Dios sino lo que es de los hombres.", "words": [[0, 192202], [9, 192842], [13, 193512], [26, 194212], [31, 194612], [33, 194772], [40, 195517], [48, 195942], [51, 196162], [59, 196602], [62, 196782], [66, 197262], [75, 198461], [78, 198871], [83, 199316], [93, 199916], [100, 200100], [103, 200320], [113, 201000], [116, 201140], [120, 201280], [123, 201420], [126, 201500], [131, 201820], [136, 202280], [139, 202820], [143, 203000], [146, 203160], [149, 203280], [153, 203420]]}, {"verse": 24, "start": 204451, "end": 213846, "text": "Entonces Jesús dijo a sus discípulos: Si alguno quiere venir en pos de mí, niéguese a sí mismo, y tome su cruz, y sígame.", "words": [[0, 204451], [9, 204869], [15, 205469], [20, 206089], [22, 206329], [26, 206529], [38, 207783], [41, 207927], [48, 208367], [55, 208547], [61, 208887], [64, 209127], [68, 209367], [71, 209567], [75, 210187], [84, 210627], [86, 210747], [89, 210847], [96, 211227], [98, 211687], [103, 211967], [106, 212107], [112, 212707], [114, 213309]]}, {"verse": 25, "start": 214196, "end": 221904, "text": "Porque todo el que quiera salvar su vida, la perderá, y todo el que pierda su vida por causa de mí, la hallará.", "words": [[0, 214196], [7, 214419], [12, 214759], [15, 214999], [19, 215139], [26, 215479], [33, 215839], [36, 216119], [42, 216479], [45, 216684], [54, 217304], [56, 217764], [61, 218024], [64, 218244], [68, 218344], [75, 218724], [78, 218884], [83, 219144], [87, 219384], [93, 219604], [96, 219964], [100, 220124], [103, 220624]]}, {"verse": 26, "start": 222254, "end": 230392, "text": "Porque ¿de qué aprovecha al hombre, si gana todo el mundo y pierde su alma? O ¿qué recompensa dará el hombre por su alma?", "words": [[0, 222254], [7, 222536], [11, 223076], [15, 223236], [25, 223596], [28, 223956], [36, 224216], [39, 224676], [44, 224956], [49, 225216], [52, 225436], [58, 225716], [60, 225876], [67, 226276], [70, 226416], [76, 227488], [78, 227488], [83, 227591], [94, 228511], [99, 228911], [102, 229031], [109, 229331], [113, 229611], [116, 229791]]}, {"verse": 27, "start": 230742, "end": 241012, "text": "Porque el Hijo del hombre vendrá en la gloria de su Padre con sus ángeles, y entonces recompensará a cada uno conforme a sus obras.", "words": [[0, 230742], [7, 231018], [10, 231238], [15, 231518], [19, 231718], [26, 232138], [33, 232958], [36, 233258], [39, 233438], [46, 233838], [49, 233998], [52, 234178], [58, 234538], [62, 234838], [66, 235058], [75, 235638], [77, 236178], [86, 236718], [99, 238518], [101, 238758], [106, 238978], [110, 239278], [119, 240058], [121, 240158], [125, 240298]]}, {"verse": 28, "start": 241362, "end": 249797, "text": "De cierto os digo: hay algunos de los que están aquí, que no probarán la muerte, hasta que hayan visto al Hijo del hombre viniendo en su reino.", "words": [[0, 241362], [3, 241486], [10, 241766], [13, 242106], [19, 242765], [23, 242942], [31, 243342], [34, 243522], [38, 243622], [42, 243762], [48, 243962], [54, 244302], [58, 244527], [61, 244727], [70, 245267], [73, 245427], [81, 245907], [87, 246587], [91, 246807], [97, 247147], [103, 247467], [106, 247707], [111, 247887], [115, 248107], [122, 248387], [131, 248987], [134, 249127], [137, 249287]]}]}