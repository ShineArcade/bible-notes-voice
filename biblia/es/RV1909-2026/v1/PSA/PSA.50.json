{"book": "PSA", "chapter": 50, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 144650, "verses": [{"verse": 1, "start": 300, "end": 9890, "text": "Salmo de Asaf. EL Dios de dioses, Jehová, ha hablado, y convocado la tierra desde el nacimiento del sol hasta donde se pone.", "words": [[0, 300], [6, 752], [9, 912], [15, 1846], [18, 2033], [23, 2273], [26, 2680], [34, 3086], [42, 3493], [45, 3673], [54, 4373], [56, 4693], [66, 5413], [69, 5613], [76, 6073], [82, 6693], [85, 7033], [96, 7713], [100, 7933], [104, 8333], [110, 8873], [116, 9153], [119, 9393]]}, {"verse": 2, "start": 10340, "end": 14933, "text": "De Sion, perfección de hermosura, ha Dios resplandecido.", "words": [[0, 10621], [3, 10935], [9, 11248], [20, 11868], [23, 12048], [34, 12780], [37, 13511], [42, 14243]]}, {"verse": 3, "start": 15383, "end": 23462, "text": "Vendrá nuestro Dios, y no callará: fuego consumirá delante de él, y en derredor suyo habrá tempestad grande.", "words": [[0, 15383], [7, 15827], [15, 16067], [21, 16487], [23, 16787], [26, 16947], [35, 17985], [41, 18359], [51, 19220], [59, 19659], [62, 19839], [66, 20100], [68, 20420], [71, 20560], [80, 21100], [85, 21640], [91, 21999], [101, 22640]]}, {"verse": 4, "start": 23912, "end": 28675, "text": "Convocará a los cielos de arriba, y a la tierra, para juzgar a su pueblo.", "words": [[0, 23912], [10, 24638], [12, 24798], [16, 24938], [23, 25398], [26, 25518], [34, 25858], [36, 26098], [38, 26178], [41, 26238], [49, 26698], [54, 27278], [61, 27818], [63, 27918], [66, 28078]]}, {"verse": 5, "start": 28975, "end": 34011, "text": "Juntadme mis santos; los que hicieron conmigo pacto con sacrificio.", "words": [[0, 29222], [9, 29512], [13, 29652], [21, 30893], [25, 31010], [29, 31170], [38, 31550], [46, 32030], [52, 32610], [56, 32890]]}, {"verse": 6, "start": 34361, "end": 39332, "text": "Y declararán los cielos su justicia; porque Dios es el juez. (Selah.)", "words": [[0, 34361], [2, 34753], [13, 35183], [17, 35403], [24, 35883], [27, 36043], [37, 37104], [44, 37288], [49, 37568], [52, 37788], [55, 37948], [61, 39097]]}, {"verse": 7, "start": 39632, "end": 47669, "text": "Oye, pueblo mío, y hablaré: escucha, Israel, y testificaré contra ti: yo soy Dios, el Dios tuyo.", "words": [[0, 39632], [5, 39896], [12, 40076], [17, 40696], [19, 40916], [28, 42031], [37, 42628], [45, 43068], [47, 43428], [59, 44188], [66, 44428], [70, 45419], [73, 45581], [77, 45781], [83, 46421], [86, 46541], [91, 46741]]}, {"verse": 8, "start": 48119, "end": 54887, "text": "No te reprenderé sobre tus sacrificios, ni por tus holocaustos, que delante de mí están siempre.", "words": [[0, 48119], [3, 48243], [6, 48383], [17, 49003], [23, 49163], [27, 49383], [40, 50423], [43, 50583], [47, 50803], [51, 50963], [64, 51783], [68, 51943], [76, 52363], [79, 52503], [82, 52663], [88, 52923]]}, {"verse": 9, "start": 55337, "end": 60214, "text": "No tomaré de tu casa becerros, ni machos cabríos de tus apriscos.", "words": [[0, 55337], [3, 55520], [10, 56060], [13, 56200], [16, 56320], [21, 56580], [31, 57480], [34, 57880], [41, 58360], [49, 58940], [52, 59060], [56, 59180]]}, {"verse": 10, "start": 60664, "end": 65604, "text": "Porque mía es toda bestia del bosque, y los millares de animales en los collados.", "words": [[0, 60664], [7, 60868], [11, 61308], [14, 61528], [19, 61668], [26, 62228], [30, 62368], [38, 62888], [40, 63128], [44, 63268], [53, 63748], [56, 63908], [65, 64288], [68, 64548], [72, 64648]]}, {"verse": 11, "start": 66054, "end": 71296, "text": "Conozco todas las aves de los montes, y en mi poder están las fieras del campo.", "words": [[0, 66054], [8, 66555], [14, 66755], [18, 67035], [23, 67375], [26, 67475], [30, 67595], [38, 68415], [40, 68575], [43, 68715], [46, 68835], [52, 69255], [58, 69675], [62, 69915], [69, 70355], [73, 70495]]}, {"verse": 12, "start": 71746, "end": 77738, "text": "Si yo tuviese hambre, no te lo diría a ti: porque mío es el mundo y su plenitud.", "words": [[0, 71746], [3, 71946], [6, 72106], [14, 72466], [22, 73166], [25, 73286], [28, 73406], [31, 73526], [37, 73986], [39, 74066], [43, 74842], [50, 75004], [54, 75564], [57, 75844], [60, 76044], [66, 76404], [68, 76684], [71, 76804]]}, {"verse": 13, "start": 78188, "end": 82970, "text": "¿He de comer yo carne de toros, o de beber sangre de machos cabríos?", "words": [[0, 78188], [4, 78328], [7, 78468], [13, 78728], [16, 79048], [22, 79448], [25, 79628], [32, 80128], [34, 80488], [37, 80648], [43, 80908], [50, 81408], [53, 81608], [60, 82163]]}, {"verse": 14, "start": 83420, "end": 87506, "text": "Sacrifica a Dios alabanza, y paga tus votos al Altísimo.", "words": [[0, 83420], [10, 84069], [12, 84189], [17, 84629], [27, 85069], [29, 85429], [34, 85769], [38, 85969], [44, 86429], [47, 86529]]}, {"verse": 15, "start": 87956, "end": 93072, "text": "E invócame en el día de la angustia: te libraré, y tú me honrarás.", "words": [[0, 87956], [2, 88089], [11, 88609], [14, 88969], [17, 89089], [21, 89309], [24, 89449], [27, 89549], [37, 90764], [40, 90821], [49, 91321], [51, 91761], [54, 91941], [57, 92391]]}, {"verse": 16, "start": 93422, "end": 99986, "text": "Pero al malo dijo Dios: ¿Qué tienes tú que declarar mis leyes, y que tomar mi pacto en tu boca,", "words": [[0, 93422], [5, 93586], [8, 93806], [13, 94206], [18, 94446], [24, 95392], [29, 95508], [36, 95868], [39, 96148], [43, 96308], [52, 96828], [56, 96928], [63, 97388], [65, 97928], [69, 98028], [75, 98308], [78, 98508], [84, 98928], [87, 99008], [90, 99128]]}, {"verse": 17, "start": 100436, "end": 104439, "text": "Pues que tú aborreces el castigo, y echas a tu espalda mis palabras?", "words": [[0, 100436], [5, 100546], [9, 100666], [12, 100806], [22, 101306], [25, 101486], [34, 102126], [36, 102506], [42, 102766], [44, 102866], [47, 102946], [55, 103366], [59, 103486]]}, {"verse": 18, "start": 104889, "end": 110418, "text": "Si veías al ladrón, tú corrías con él; y con los adúlteros era tu parte.", "words": [[0, 104889], [3, 105098], [9, 105518], [12, 105738], [20, 106358], [23, 106458], [31, 106898], [35, 107118], [39, 108003], [41, 108123], [45, 108283], [49, 108603], [59, 108923], [63, 109383], [66, 109563]]}, {"verse": 19, "start": 110868, "end": 114525, "text": "Tu boca metías en mal, y tu lengua componía engaño.", "words": [[0, 110868], [3, 110948], [8, 111228], [15, 111668], [18, 111848], [23, 112168], [25, 112468], [28, 112608], [35, 113028], [44, 113608]]}, {"verse": 20, "start": 114975, "end": 121172, "text": "Tomabas asiento, y hablabas contra tu hermano; contra el hijo de tu madre ponías infamia.", "words": [[0, 114975], [8, 115392], [17, 115932], [19, 116412], [28, 116852], [35, 117112], [38, 117332], [47, 118422], [54, 118679], [57, 118839], [62, 119019], [65, 119159], [68, 119279], [74, 119829], [81, 120379]]}, {"verse": 21, "start": 121622, "end": 130633, "text": "Estas cosas hiciste, y yo he callado: pensabas que de cierto sería yo como tú: yo te reprenderé, y las pondré delante de tus ojos.", "words": [[0, 121622], [6, 122012], [12, 122292], [21, 122952], [23, 123132], [26, 123272], [29, 123372], [38, 124460], [47, 124958], [51, 125078], [54, 125258], [61, 125558], [67, 125998], [70, 126258], [75, 126498], [79, 127427], [82, 127589], [85, 127729], [97, 128429], [99, 128689], [103, 128829], [110, 129229], [118, 129609], [121, 129749], [125, 129869]]}, {"verse": 22, "start": 131083, "end": 136835, "text": "Entended ahora esto, los que os olvidáis de Dios; no sea que arrebate, sin que nadie libre.", "words": [[0, 131083], [9, 131565], [15, 131825], [21, 132185], [25, 132425], [29, 132605], [32, 132705], [41, 133165], [44, 133305], [50, 134358], [53, 134497], [57, 134697], [61, 134877], [71, 135417], [75, 135657], [79, 135817], [85, 136017]]}, {"verse": 23, "start": 137285, "end": 144250, "text": "El que sacrifica alabanza me honrará: y al que ordene su camino, le mostraré la salvación de Dios.", "words": [[0, 137285], [3, 137403], [7, 137503], [17, 138123], [26, 138743], [29, 138823], [38, 140118], [40, 140197], [43, 140297], [47, 140397], [54, 140777], [57, 140897], [65, 141357], [68, 141897], [77, 142517], [80, 142817], [90, 143357], [93, 143497]]}]}