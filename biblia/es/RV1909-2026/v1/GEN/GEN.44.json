{"book": "GEN", "chapter": 44, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 265782, "verses": [{"verse": 1, "start": 300, "end": 10488, "text": "Y mandó José al mayordomo de su casa, diciendo: Llena los costales de estos varones de alimentos, cuanto puedan llevar, y pon el dinero de cada uno en la boca de su costal:", "words": [[0, 300], [2, 427], [8, 787], [13, 1107], [16, 1567], [26, 2027], [29, 2127], [32, 2267], [38, 3367], [48, 4458], [54, 4654], [58, 4834], [67, 5274], [70, 5474], [76, 5654], [84, 6154], [87, 6314], [98, 6754], [105, 7054], [112, 7474], [120, 7794], [122, 7996], [126, 8199], [129, 8319], [136, 8559], [139, 8739], [144, 8939], [148, 9239], [151, 9379], [154, 9459], [159, 9659], [162, 9839], [165, 9939]]}, {"verse": 2, "start": 10838, "end": 19522, "text": "Y pondrás mi copa, la copa de plata, en la boca del costal del menor, con el dinero de su trigo. Y él hizo como dijo José.", "words": [[0, 10838], [2, 10962], [10, 11381], [13, 11582], [19, 12542], [22, 12662], [27, 13002], [30, 13102], [37, 13522], [40, 14081], [43, 14202], [48, 14422], [52, 14662], [59, 15122], [63, 15262], [70, 15962], [74, 16122], [77, 16242], [84, 16542], [87, 16722], [90, 16842], [97, 17635], [99, 17792], [102, 17912], [107, 18352], [112, 18632], [117, 18952]]}, {"verse": 3, "start": 19872, "end": 23572, "text": "Venida la mañana, los hombres fueron despedidos con sus asnos.", "words": [[0, 19872], [7, 20362], [10, 20502], [18, 20862], [22, 21102], [30, 21462], [37, 21762], [48, 22502], [52, 22682], [56, 22862]]}, {"verse": 4, "start": 23922, "end": 37751, "text": "Habiendo ellos salido de la ciudad, de la que aún no se habían alejado, dijo José a su mayordomo: Levántate, y sigue a esos hombres; y cuando los alcances, diles: ¿Por qué habéis vuelto mal por bien?", "words": [[0, 23922], [9, 24235], [15, 24585], [22, 25145], [25, 25285], [28, 25425], [36, 26185], [39, 26425], [42, 26565], [46, 26765], [50, 27125], [53, 27565], [56, 28065], [63, 28565], [72, 29065], [77, 29465], [82, 29965], [84, 30345], [87, 30947], [98, 31683], [109, 32301], [111, 32561], [117, 32841], [119, 32981], [124, 33141], [133, 33987], [135, 34089], [142, 34269], [146, 34489], [156, 35489], [163, 36039], [168, 36160], [172, 36320], [179, 36600], [186, 36920], [190, 37120], [194, 37320]]}, {"verse": 5, "start": 38101, "end": 43927, "text": "¿No es esta en la que bebe mi señor, y por la que suele adivinar? habéis hecho mal en lo que hicisteis.", "words": [[0, 38101], [4, 38263], [7, 38463], [12, 38743], [15, 38883], [18, 38983], [22, 39103], [27, 39363], [30, 39463], [37, 39763], [39, 40243], [43, 40423], [46, 40523], [50, 40643], [56, 40923], [66, 41701], [73, 42101], [79, 42341], [83, 42641], [86, 42801], [89, 42921], [93, 43061]]}, {"verse": 6, "start": 44207, "end": 47597, "text": "Y como él los alcanzó, les dijo estas palabras.", "words": [[0, 44207], [2, 44309], [7, 44549], [10, 44769], [14, 44889], [23, 46009], [27, 46129], [32, 46489], [38, 46709]]}, {"verse": 7, "start": 47947, "end": 53918, "text": "Y ellos le respondieron: ¿Por qué dice mi señor tales cosas? Nunca tal hagan tus siervos.", "words": [[0, 47947], [2, 48154], [8, 48394], [11, 48574], [25, 49673], [30, 49796], [34, 49976], [39, 50256], [42, 50436], [48, 50736], [54, 50976], [61, 51948], [67, 52396], [71, 52636], [77, 53016], [81, 53156]]}, {"verse": 8, "start": 54268, "end": 65789, "text": "He aquí, el dinero que hallamos en la boca de nuestros costales, te lo volvimos a traer desde la tierra de Canaán; ¿cómo, pues, habíamos de hurtar de casa de tu señor plata ni oro?", "words": [[0, 54314], [3, 54394], [9, 54654], [12, 54874], [19, 55234], [23, 55454], [32, 55814], [35, 55974], [38, 56094], [43, 56294], [46, 56494], [55, 56674], [65, 57754], [68, 57974], [71, 58114], [80, 58554], [82, 58754], [88, 59174], [94, 59354], [97, 59554], [104, 59874], [107, 60114], [115, 60981], [122, 61205], [128, 62225], [137, 62745], [140, 63065], [147, 63385], [150, 63545], [155, 63945], [158, 64185], [161, 64345], [167, 64685], [173, 65025], [176, 65365]]}, {"verse": 9, "start": 66139, "end": 74859, "text": "Aquel de tus siervos en quien sea hallada la copa, que muera, y los demás seremos esclavos de mi señor.", "words": [[0, 66139], [6, 66657], [9, 66797], [13, 66957], [21, 67637], [24, 67917], [30, 68137], [34, 68597], [42, 69157], [45, 69317], [51, 70197], [55, 70257], [62, 71197], [64, 71557], [68, 71737], [74, 72097], [82, 73177], [91, 73897], [94, 74057], [97, 74197]]}, {"verse": 10, "start": 75209, "end": 83227, "text": "Y él dijo: También ahora sea conforme a vuestras palabras; aquel en quien se halle, será mi siervo, y vosotros seréis sin culpa.", "words": [[0, 75209], [2, 75397], [5, 75557], [11, 76276], [19, 76552], [25, 76872], [29, 77152], [38, 77832], [40, 77872], [49, 78252], [59, 79220], [65, 79584], [68, 79704], [74, 79844], [77, 80064], [84, 80344], [89, 80664], [92, 80864], [100, 81344], [102, 81724], [111, 82164], [118, 82524], [122, 82684]]}, {"verse": 11, "start": 83507, "end": 91400, "text": "Ellos entonces se dieron prisa, y derribando cada uno su costal en tierra, abrió cada cual el costal suyo.", "words": [[0, 83507], [6, 83891], [15, 84431], [18, 84731], [25, 85031], [32, 86231], [34, 86271], [45, 87031], [50, 87271], [54, 87591], [57, 87811], [64, 88291], [67, 88431], [75, 89271], [81, 89651], [86, 89891], [91, 90191], [94, 90331], [101, 90831]]}, {"verse": 12, "start": 91750, "end": 98969, "text": "Y buscó; desde el mayor comenzó, y acabó en el menor; y la copa fue hallada en el costal de Benjamín.", "words": [[0, 91750], [2, 91892], [9, 92640], [15, 92846], [18, 93026], [24, 93286], [33, 94066], [35, 94386], [41, 94926], [44, 95086], [47, 95246], [54, 95906], [56, 96029], [59, 96149], [64, 96549], [68, 96729], [76, 97229], [79, 97369], [82, 97509], [89, 98029], [92, 98149]]}, {"verse": 13, "start": 99319, "end": 106385, "text": "Entonces ellos rasgaron sus vestidos, y cargó cada uno su asno, y volvieron a la ciudad.", "words": [[0, 99319], [9, 99836], [15, 100716], [24, 101596], [28, 101776], [38, 102456], [40, 102696], [46, 103216], [51, 103456], [55, 103756], [58, 103996], [64, 104476], [66, 104936], [76, 105496], [78, 105636], [81, 105736]]}, {"verse": 14, "start": 106735, "end": 113674, "text": "Y llegó Judá con sus hermanos a casa de José, que aún estaba allí, y se postraron delante de él en tierra.", "words": [[0, 106735], [2, 106857], [8, 107117], [13, 107537], [17, 107757], [21, 107957], [30, 108637], [32, 108737], [37, 108977], [40, 109177], [46, 109677], [50, 109757], [54, 109957], [61, 110257], [67, 111017], [69, 111097], [72, 111217], [82, 112037], [90, 112517], [93, 112697], [96, 112857], [99, 112997]]}, {"verse": 15, "start": 114024, "end": 119383, "text": "Y les dijo José: ¿Qué obra es esta que habéis hecho? ¿no sabéis que un hombre como yo sabe adivinar?", "words": [[0, 114024], [2, 114130], [6, 114250], [11, 114530], [17, 115237], [22, 115319], [27, 115499], [30, 115739], [35, 115999], [39, 116159], [46, 116459], [53, 117121], [57, 117220], [64, 117560], [68, 117740], [71, 117860], [78, 118040], [83, 118280], [86, 118480], [91, 118700]]}, {"verse": 16, "start": 119663, "end": 134677, "text": "Entonces dijo Judá: ¿Qué diremos a mi señor? ¿qué hablaremos? ¿o con qué nos justificaremos? Dios ha hallado la maldad de tus siervos: he aquí, nosotros somos siervos de mi señor, nosotros, y también aquel en cuyo poder fue hallada la copa.", "words": [[0, 119663], [9, 120226], [14, 120886], [20, 121683], [25, 121767], [33, 122147], [35, 122247], [38, 122347], [45, 123037], [50, 123121], [62, 124051], [65, 124135], [69, 124295], [73, 124395], [77, 124555], [93, 125741], [98, 125959], [101, 126259], [109, 126639], [112, 126759], [119, 127119], [122, 127259], [126, 127399], [135, 128257], [138, 128400], [144, 128660], [153, 128880], [159, 129440], [167, 129980], [170, 130140], [173, 130240], [180, 130940], [190, 131880], [192, 132000], [200, 132300], [206, 132780], [209, 132900], [214, 133140], [220, 133400], [224, 133720], [232, 134080], [235, 134200]]}, {"verse": 17, "start": 134957, "end": 143638, "text": "Y él respondió: Nunca yo tal haga: el varón en cuyo poder fue hallada la copa, él será mi siervo; vosotros id en paz a vuestro padre.", "words": [[0, 134957], [2, 135139], [5, 135279], [16, 136274], [22, 136671], [25, 136974], [29, 137278], [35, 137757], [38, 137860], [44, 138180], [47, 138320], [52, 138540], [58, 138840], [62, 139060], [70, 139400], [73, 139540], [79, 140300], [82, 140380], [87, 140600], [90, 140800], [98, 141556], [107, 141944], [110, 142374], [113, 142474], [117, 142634], [119, 142794], [127, 143114]]}, {"verse": 18, "start": 143918, "end": 156143, "text": "Entonces Judá se llegó a él, y dijo: Ay señor mío, te ruego que hable tu siervo una palabra en oídos de mi señor, y no se encienda tu enojo contra tu siervo, pues que tú eres como Faraón.", "words": [[0, 143918], [9, 144498], [14, 145108], [17, 145488], [23, 145808], [25, 145968], [29, 146228], [31, 146563], [37, 147412], [40, 147629], [46, 147889], [51, 148869], [54, 149009], [60, 149269], [64, 149469], [70, 149709], [73, 149849], [80, 150249], [84, 150409], [92, 150789], [95, 151009], [101, 151349], [104, 151449], [107, 151549], [114, 151929], [116, 152114], [119, 152254], [122, 152394], [131, 152814], [134, 152974], [140, 153334], [147, 153614], [150, 153834], [158, 154638], [163, 154740], [167, 154920], [170, 155100], [175, 155280], [180, 155520]]}, {"verse": 19, "start": 156493, "end": 160475, "text": "Mi señor preguntó a sus siervos, diciendo: ¿Tenéis padre o hermano?", "words": [[0, 156493], [3, 156579], [9, 156839], [18, 157419], [20, 157479], [24, 157639], [33, 158319], [43, 159122], [51, 159402], [57, 159742], [59, 159942]]}, {"verse": 20, "start": 160825, "end": 171816, "text": "Y nosotros respondimos a mi señor: Tenemos un padre anciano, y un mozo que le nació en su vejez, pequeño aún; y un hermano suyo murió, y él quedó solo de su madre, y su padre lo ama.", "words": [[0, 160825], [2, 160925], [11, 161205], [23, 161905], [25, 162065], [28, 162145], [35, 162837], [43, 163041], [46, 163261], [52, 163521], [61, 164181], [63, 164441], [66, 164561], [71, 164901], [75, 165021], [78, 165121], [84, 165441], [87, 165681], [90, 165921], [97, 166161], [105, 166421], [110, 167118], [112, 167257], [115, 167397], [123, 167797], [128, 168057], [135, 168777], [137, 169057], [140, 169177], [146, 169457], [151, 169677], [154, 169837], [157, 169977], [164, 170697], [166, 170757], [169, 170877], [175, 171157], [178, 171397]]}, {"verse": 21, "start": 172166, "end": 176277, "text": "Y tú dijiste a tus siervos: Traédmelo, y pondré mis ojos sobre él.", "words": [[0, 172166], [2, 172268], [5, 172408], [13, 172828], [15, 172928], [19, 173028], [28, 173883], [39, 174428], [41, 174728], [48, 175108], [52, 175268], [57, 175488], [63, 175828]]}, {"verse": 22, "start": 176627, "end": 182679, "text": "Y nosotros dijimos a mi señor: El joven no puede dejar a su padre, porque si lo deja, su padre morirá.", "words": [[0, 176627], [2, 176733], [11, 177013], [19, 177573], [21, 177733], [24, 177813], [31, 178561], [34, 178667], [40, 178967], [43, 179107], [49, 179347], [55, 179687], [57, 179767], [60, 179907], [67, 180547], [74, 180787], [77, 180967], [80, 181107], [86, 181667], [89, 181787], [95, 182067]]}, {"verse": 23, "start": 183029, "end": 189062, "text": "Y dijiste a tus siervos: Si vuestro hermano menor no desciende con vosotros, no veáis más mi rostro.", "words": [[0, 183029], [2, 183138], [10, 183518], [12, 183598], [16, 183678], [25, 184589], [28, 184749], [36, 185109], [44, 185469], [50, 185749], [53, 185969], [63, 186429], [67, 186649], [77, 187429], [80, 187709], [86, 188109], [90, 188269], [93, 188489]]}, {"verse": 24, "start": 189412, "end": 194180, "text": "Aconteció pues, que como llegamos a mi padre tu siervo, le contamos las palabras de mi señor.", "words": [[0, 189412], [10, 189955], [16, 190175], [20, 190375], [25, 190575], [34, 191015], [36, 191115], [39, 191215], [45, 191575], [48, 191695], [56, 192435], [59, 192515], [68, 192915], [72, 193055], [81, 193355], [84, 193615], [87, 193715]]}, {"verse": 25, "start": 194530, "end": 198028, "text": "Y dijo nuestro padre: Volved a comprarnos un poco de alimento.", "words": [[0, 194530], [2, 194636], [7, 194836], [15, 195076], [22, 195886], [29, 196230], [31, 196330], [42, 196870], [45, 197070], [50, 197250], [53, 197410]]}, {"verse": 26, "start": 198378, "end": 208574, "text": "Y nosotros respondimos: No podemos ir: si nuestro hermano va con nosotros, iremos; porque no podemos ver el rostro del varón, si no está con nosotros nuestro hermano el menor.", "words": [[0, 198378], [2, 198481], [11, 198761], [24, 199994], [27, 200100], [35, 200400], [39, 201027], [42, 201153], [50, 201313], [58, 201793], [61, 201893], [65, 202053], [75, 202853], [83, 203655], [90, 203840], [93, 204020], [101, 204340], [105, 204620], [108, 204780], [115, 205140], [119, 205260], [126, 205700], [129, 206180], [132, 206300], [137, 206540], [141, 206780], [150, 207240], [158, 207600], [166, 208080], [169, 208160]]}, {"verse": 27, "start": 208924, "end": 213808, "text": "Entonces tu siervo mi padre nos dijo: Vosotros sabéis que dos me parió mi mujer;", "words": [[0, 208924], [9, 209346], [12, 209586], [19, 209986], [22, 210106], [28, 210386], [32, 210586], [38, 211274], [47, 211718], [54, 212178], [58, 212358], [62, 212558], [65, 212758], [71, 213038], [74, 213178]]}, {"verse": 28, "start": 214158, "end": 219571, "text": "Y el uno salió de conmigo, y pienso de cierto que fue despedazado, y hasta ahora no le he visto;", "words": [[0, 214158], [2, 214253], [5, 214293], [9, 214433], [15, 214793], [18, 214893], [27, 215433], [29, 215673], [36, 215953], [39, 216233], [46, 216513], [50, 216733], [54, 216913], [67, 217773], [69, 218193], [75, 218393], [81, 218653], [84, 218813], [87, 218953], [90, 219053]]}, {"verse": 29, "start": 219921, "end": 226852, "text": "Y si también tomáis a este de delante de mí, y le ocurre algún desastre, haréis descender mis canas con dolor a la sepultura.", "words": [[0, 219921], [2, 220018], [5, 220078], [13, 220398], [20, 220778], [22, 220918], [27, 221138], [30, 221298], [38, 221658], [41, 221798], [45, 222018], [47, 222538], [50, 222638], [57, 222958], [63, 223198], [73, 224138], [80, 224478], [90, 224918], [94, 225098], [100, 225478], [104, 225638], [110, 225918], [112, 226018], [115, 226118]]}, {"verse": 30, "start": 227202, "end": 234355, "text": "Ahora, pues, cuando yo vuelva a tu siervo mi padre, si el joven no va conmigo, como su alma está ligada al alma de él,", "words": [[0, 227202], [7, 227421], [13, 228181], [20, 228381], [23, 228691], [30, 229001], [32, 229041], [35, 229161], [42, 229521], [45, 229641], [52, 230401], [55, 230601], [58, 230701], [64, 231061], [67, 231221], [70, 231321], [79, 232141], [84, 232321], [87, 232521], [92, 232761], [97, 233041], [104, 233501], [107, 233621], [112, 233841], [115, 234061]]}, {"verse": 31, "start": 234705, "end": 242804, "text": "Sucederá que cuando no vea al joven, morirá: y tus siervos harán descender las canas de tu siervo nuestro padre con dolor a la sepultura.", "words": [[0, 234705], [9, 235290], [13, 235410], [20, 235650], [23, 235850], [27, 236050], [30, 236210], [37, 236750], [45, 237975], [47, 238081], [51, 238201], [59, 238621], [65, 238941], [75, 239421], [79, 239561], [85, 239961], [88, 240061], [91, 240181], [98, 240621], [106, 240781], [112, 241361], [116, 241501], [122, 241821], [124, 242001], [127, 242061]]}, {"verse": 32, "start": 243084, "end": 252640, "text": "Como tu siervo salió por fiador del joven con mi padre, diciendo: Si no te lo vuelvo a traer, entonces yo seré culpable ante mi padre para siempre;", "words": [[0, 243084], [5, 243230], [8, 243430], [15, 243910], [21, 244290], [25, 244530], [32, 245050], [36, 245310], [42, 245730], [46, 245890], [49, 246090], [56, 246890], [66, 247794], [69, 247911], [72, 248051], [75, 248171], [78, 248291], [85, 248611], [87, 248731], [94, 249431], [103, 249811], [106, 250231], [111, 250571], [120, 251071], [125, 251271], [128, 251451], [134, 251771], [139, 252031]]}, {"verse": 33, "start": 252990, "end": 259582, "text": "Te ruego por tanto que quede ahora tu siervo por el mozo por siervo de mi señor, y que el joven vaya con sus hermanos.", "words": [[0, 252990], [3, 253088], [9, 253368], [13, 253548], [19, 253808], [23, 254068], [29, 254348], [35, 254588], [38, 254788], [45, 255248], [49, 255448], [52, 255568], [57, 256050], [61, 256153], [68, 256613], [71, 256713], [74, 256813], [81, 257613], [83, 257673], [87, 257793], [90, 257893], [96, 258233], [101, 258473], [105, 258673], [109, 258833]]}, {"verse": 34, "start": 259932, "end": 265382, "text": "Porque ¿cómo iré yo a mi padre sin el joven? No podré, por no ver el mal que sobrevendrá a mi padre.", "words": [[0, 260052], [7, 260172], [13, 260452], [17, 260712], [20, 260892], [22, 261012], [25, 261132], [31, 261432], [35, 261692], [38, 261852], [45, 262547], [48, 262651], [55, 262951], [59, 263191], [62, 263311], [66, 263511], [69, 263651], [73, 263831], [77, 264011], [89, 264671], [91, 264771], [94, 264851]]}]}