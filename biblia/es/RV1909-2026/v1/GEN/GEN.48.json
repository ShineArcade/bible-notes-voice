{"book": "GEN", "chapter": 48, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 223247, "verses": [{"verse": 1, "start": 300, "end": 10340, "text": "Y sucedió después de estas cosas el haberse dicho a José: He aquí tu padre está enfermo. Y él tomó consigo sus dos hijos Manasés y Efraín.", "words": [[0, 300], [2, 427], [10, 1007], [18, 1307], [21, 1507], [27, 1687], [33, 2207], [36, 2727], [44, 3127], [50, 3387], [52, 3567], [58, 4328], [61, 4408], [66, 4608], [69, 4808], [75, 5108], [80, 5428], [89, 6347], [91, 6524], [94, 6644], [99, 6984], [107, 7404], [111, 7684], [115, 7944], [121, 8264], [129, 9104], [131, 9544]]}, {"verse": 2, "start": 10790, "end": 20566, "text": "Y se hizo saber a Jacob, diciendo: He aquí tu hijo José viene a ti. Entonces se esforzó Israel, y se sentó sobre la cama;", "words": [[0, 10790], [2, 11109], [5, 11289], [10, 11569], [16, 11929], [18, 12089], [25, 12469], [35, 13877], [38, 13957], [43, 14137], [46, 14357], [51, 14557], [56, 14857], [62, 15217], [64, 15377], [68, 15988], [77, 16518], [80, 16998], [88, 17678], [96, 18178], [98, 18978], [101, 19118], [107, 19578], [113, 19798], [116, 20018]]}, {"verse": 3, "start": 21016, "end": 26960, "text": "Y dijo a José: El Dios Omnipotente me apareció en Luz en la tierra de Canaán, y me bendijo,", "words": [[0, 21016], [2, 21308], [7, 21568], [9, 21768], [15, 22508], [18, 22667], [23, 22987], [35, 23707], [38, 23847], [47, 24347], [50, 24427], [54, 24567], [57, 24727], [60, 24827], [67, 25087], [70, 25247], [78, 25727], [80, 26167], [83, 26287]]}, {"verse": 4, "start": 27410, "end": 37419, "text": "Y me dijo: He aquí, yo te haré crecer, y te multiplicaré, y te pondré por estirpe de pueblos: y daré esta tierra a tu descendencia después de ti por heredad perpetua.", "words": [[0, 27410], [2, 27512], [5, 27612], [11, 28368], [14, 28497], [20, 28937], [23, 29017], [26, 29157], [31, 29377], [39, 29857], [41, 29977], [44, 30077], [58, 30877], [60, 31277], [63, 31417], [70, 31777], [74, 31937], [82, 32397], [85, 32517], [94, 33465], [96, 33565], [101, 33845], [106, 34045], [113, 34385], [115, 34585], [118, 34685], [131, 35405], [139, 35665], [142, 35905], [145, 36085], [149, 36345], [157, 36725]]}, {"verse": 5, "start": 37869, "end": 49354, "text": "Y ahora tus dos hijos Efraín y Manasés, que te nacieron en la tierra de Egipto, antes que viniese a ti a la tierra de Egipto, míos son; como Rubén y Simeón, serán míos:", "words": [[0, 37869], [2, 37989], [8, 38209], [12, 38429], [16, 38649], [22, 38929], [29, 39509], [31, 39979], [40, 40449], [44, 40649], [47, 40769], [56, 41209], [59, 41369], [62, 41469], [69, 41689], [72, 41929], [80, 42749], [86, 43029], [90, 43229], [98, 43649], [100, 43829], [103, 43969], [105, 44229], [108, 44309], [115, 44549], [118, 44749], [126, 45219], [131, 45689], [136, 46394], [141, 46539], [147, 46959], [149, 47079], [157, 47559], [163, 48059]]}, {"verse": 6, "start": 49804, "end": 56325, "text": "Y los que después de ellos has engendrado, serán tuyos; por el nombre de sus hermanos serán llamados en sus heredades.", "words": [[0, 49804], [2, 49904], [6, 50024], [10, 50184], [18, 50484], [21, 50664], [27, 51024], [31, 51384], [43, 51744], [49, 52164], [56, 53089], [60, 53207], [63, 53327], [70, 53607], [73, 53787], [77, 53927], [86, 54467], [92, 54767], [101, 55207], [104, 55367], [108, 55567]]}, {"verse": 7, "start": 56775, "end": 68036, "text": "Porque cuando yo venía de Padan-aram, se me murió Raquel en la tierra de Canaán, en el camino, como media legua de tierra viniendo a Efrata; y la sepulté allí en el camino de Efrata, que es Belén.", "words": [[0, 56775], [7, 56948], [14, 57228], [17, 57428], [23, 57768], [26, 57908], [38, 58608], [41, 59088], [44, 59248], [50, 59548], [57, 59928], [60, 60068], [63, 60148], [70, 60408], [73, 60828], [81, 61248], [84, 61308], [87, 61428], [95, 62288], [100, 62488], [106, 62788], [112, 63188], [115, 63288], [122, 63568], [131, 64108], [133, 64188], [141, 64992], [143, 65077], [146, 65177], [154, 65697], [159, 65917], [162, 66057], [165, 66177], [172, 66437], [175, 66677], [183, 67437], [187, 67477], [190, 67617]]}, {"verse": 8, "start": 68386, "end": 74895, "text": "Y vio Israel los hijos de José, y dijo: ¿Quiénes son estos?", "words": [[0, 68386], [2, 68533], [6, 68793], [13, 69293], [17, 69593], [23, 69913], [26, 70173], [32, 70513], [34, 70853], [40, 73191], [49, 73778], [53, 74366]]}, {"verse": 9, "start": 75245, "end": 84952, "text": "Y respondió José a su padre: Son mis hijos, que Dios me ha dado aquí. Y él dijo: Acércalos ahora a mí, y los bendeciré.", "words": [[0, 75245], [2, 75373], [12, 76013], [17, 76373], [19, 76653], [22, 76773], [29, 77693], [33, 77874], [37, 78054], [44, 78294], [48, 78554], [53, 78754], [56, 79014], [59, 79114], [64, 79294], [70, 80078], [72, 80267], [75, 80427], [81, 81195], [91, 81860], [97, 82080], [99, 82300], [103, 82420], [105, 82940], [109, 83100]]}, {"verse": 10, "start": 85302, "end": 94298, "text": "Y los ojos de Israel estaban tan agravados de la vejez, que no podía ver. Les hizo, pues, llegar a él, y él los besó y abrazó.", "words": [[0, 85302], [2, 85421], [6, 85561], [11, 85861], [14, 86081], [21, 86521], [29, 86921], [33, 87241], [43, 87921], [46, 88148], [49, 88374], [56, 88601], [60, 88961], [63, 89121], [69, 89461], [74, 90146], [78, 90288], [84, 90548], [90, 90908], [97, 91388], [99, 91628], [103, 92108], [105, 92488], [108, 92648], [112, 92788], [117, 93428], [119, 93668]]}, {"verse": 11, "start": 94748, "end": 101344, "text": "Y dijo Israel a José: No pensaba yo ver tu rostro, y he aquí Dios me ha hecho ver también tu descendencia.", "words": [[0, 94748], [2, 94871], [7, 95131], [14, 95731], [16, 96031], [22, 96757], [25, 96899], [33, 97319], [36, 97519], [40, 97659], [43, 97779], [51, 98299], [53, 98509], [56, 98719], [61, 98879], [66, 99319], [69, 99559], [72, 99659], [78, 99859], [82, 100039], [90, 100319], [93, 100519]]}, {"verse": 12, "start": 101694, "end": 106946, "text": "Entonces José los sacó de entre sus rodillas, y se inclinó a tierra.", "words": [[0, 101694], [9, 102237], [14, 102597], [18, 102957], [23, 103457], [26, 103557], [32, 103837], [36, 104097], [46, 104677], [48, 105437], [51, 105597], [59, 106257], [61, 106357]]}, {"verse": 13, "start": 107396, "end": 119360, "text": "Y los tomó José a ambos, Efraín a su derecha, a la izquierda de Israel; y a Manasés a su izquierda, a la derecha de Israel; y los acercó a él.", "words": [[0, 107396], [2, 107501], [6, 107621], [11, 107961], [16, 108281], [18, 108601], [25, 109541], [32, 110181], [34, 110301], [37, 110461], [46, 111421], [48, 111481], [51, 111581], [61, 112221], [64, 112361], [72, 113418], [74, 113724], [76, 114070], [84, 114417], [86, 114677], [89, 114897], [100, 115917], [102, 116177], [105, 116277], [113, 116737], [116, 116877], [124, 117913], [126, 118025], [130, 118165], [137, 118745], [139, 118925]]}, {"verse": 14, "start": 119810, "end": 135747, "text": "Entonces Israel extendió su diestra, y la puso sobre la cabeza de Efraín, que era el menor, y su siniestra sobre la cabeza de Manasés, colocando así sus manos adrede, aunque Manasés era el primogénito.", "words": [[0, 119810], [9, 120354], [16, 121134], [25, 122074], [28, 122254], [37, 122814], [39, 123434], [42, 123554], [47, 123914], [53, 124214], [56, 124394], [63, 124794], [66, 125074], [74, 126014], [78, 126194], [82, 126374], [85, 126534], [92, 127634], [94, 127734], [97, 127874], [107, 128714], [113, 129034], [116, 129234], [123, 129634], [126, 129874], [135, 130814], [145, 131514], [149, 131734], [153, 132014], [159, 132656], [167, 133543], [174, 133788], [182, 134408], [186, 134873], [189, 135338]]}, {"verse": 15, "start": 136197, "end": 145674, "text": "Y bendijo a José, y dijo: El Dios en cuya presencia anduvieron mis padres Abraham e Isaac, el Dios que me mantiene desde que yo soy hasta este día,", "words": [[0, 136197], [2, 136304], [10, 136744], [12, 136844], [18, 137224], [20, 137644], [26, 138485], [29, 138555], [34, 138755], [37, 138995], [42, 139255], [52, 139795], [63, 140335], [67, 140495], [74, 140855], [82, 141475], [84, 141955], [91, 142835], [94, 142915], [99, 143135], [103, 143315], [106, 143415], [115, 143915], [121, 144115], [125, 144335], [128, 144515], [132, 144715], [138, 144955], [143, 145215]]}, {"verse": 16, "start": 146124, "end": 157722, "text": "El Ángel que me libra de todo mal, bendiga a estos jóvenes: y mi nombre sea llamado en ellos, y el nombre de mis padres Abraham e Isaac: y multipliquen en gran manera en medio de la tierra.", "words": [[0, 146124], [3, 146266], [9, 146666], [13, 146786], [16, 146926], [22, 147226], [25, 147346], [30, 147546], [35, 147886], [43, 148526], [45, 148606], [51, 148806], [60, 149933], [62, 150039], [65, 150119], [72, 150459], [76, 150799], [84, 151079], [87, 151299], [94, 151599], [96, 152119], [99, 152219], [106, 152519], [109, 152719], [113, 152859], [120, 153219], [128, 153859], [130, 154299], [137, 155205], [139, 155305], [152, 155885], [155, 156005], [160, 156145], [167, 156545], [170, 156745], [176, 156965], [179, 157125], [182, 157245]]}, {"verse": 17, "start": 158072, "end": 173288, "text": "Entonces viendo José que su padre ponía la mano derecha sobre la cabeza de Efraín, le causó esto disgusto; y tomó la mano de su padre, para cambiarla de sobre la cabeza de Efraín a la cabeza de Manasés.", "words": [[0, 158072], [9, 159112], [16, 159432], [21, 159832], [25, 160032], [28, 160192], [34, 160572], [40, 161032], [43, 161152], [48, 161372], [56, 161852], [62, 162132], [65, 162332], [72, 162732], [75, 162992], [83, 163972], [86, 164072], [92, 164712], [97, 165092], [107, 166567], [109, 166711], [114, 167071], [117, 167211], [122, 167451], [125, 167631], [128, 167791], [135, 168251], [140, 168831], [150, 169551], [153, 169711], [159, 170051], [162, 170271], [169, 170691], [172, 170911], [179, 171611], [181, 171851], [184, 171931], [191, 172311], [194, 172834]]}, {"verse": 18, "start": 173738, "end": 181833, "text": "Y dijo José a su padre: No así, padre mío, porque este es el primogénito; pon tu diestra sobre su cabeza.", "words": [[0, 173738], [2, 173843], [7, 174103], [12, 174423], [14, 174603], [17, 174683], [24, 175535], [27, 175714], [32, 176134], [38, 176394], [43, 177054], [50, 177274], [55, 177634], [58, 177874], [61, 177994], [74, 179213], [78, 179353], [81, 179533], [89, 179913], [95, 180193], [98, 180373]]}, {"verse": 19, "start": 182183, "end": 195905, "text": "Mas su padre no quiso, y dijo: Lo sé, hijo mío, lo sé: también él vendrá a ser un pueblo, y será también acrecentado; pero su hermano menor será más grande que él, y su descendencia formará multitud de naciones.", "words": [[0, 182183], [4, 182350], [7, 182470], [13, 182770], [16, 183030], [23, 183510], [25, 184030], [31, 184815], [34, 184940], [38, 185140], [43, 185340], [48, 185800], [51, 185920], [55, 186581], [63, 186925], [66, 187105], [73, 187485], [75, 187585], [79, 187745], [82, 187865], [90, 188205], [92, 188705], [97, 188925], [105, 189555], [118, 190431], [123, 190571], [126, 190711], [134, 191071], [140, 191291], [145, 191551], [149, 191751], [156, 192071], [160, 192271], [164, 192491], [166, 192791], [169, 192931], [182, 193671], [190, 194071], [199, 194571], [202, 194691]]}, {"verse": 20, "start": 196255, "end": 207308, "text": "Y los bendijo aquel día, diciendo: En ti bendecirá Israel, diciendo: Que Dios te ponga como a Efraín y como a Manasés. Y puso a Efraín delante de Manasés.", "words": [[0, 196255], [2, 196379], [6, 196479], [14, 196999], [20, 197379], [25, 197599], [35, 198771], [38, 198953], [41, 199113], [51, 199693], [59, 200113], [69, 201129], [73, 201213], [78, 201393], [81, 201613], [87, 202013], [92, 202213], [94, 202353], [101, 202833], [103, 203033], [108, 203213], [110, 203393], [119, 204407], [121, 204532], [126, 204932], [128, 205032], [135, 205492], [143, 205972], [146, 206132]]}, {"verse": 21, "start": 207758, "end": 215391, "text": "Y dijo Israel a José: He aquí, yo muero, pero Dios será con vosotros, y os hará volver a la tierra de vuestros padres.", "words": [[0, 207758], [2, 207880], [7, 208140], [14, 208740], [16, 209040], [22, 209766], [25, 209928], [31, 210168], [34, 210368], [41, 210888], [46, 211028], [51, 211328], [56, 211708], [60, 211988], [70, 213008], [72, 213068], [75, 213228], [80, 213468], [87, 213668], [89, 213868], [92, 213948], [99, 214228], [102, 214428], [111, 214728]]}, {"verse": 22, "start": 215841, "end": 222847, "text": "Y yo te he dado a ti una parte sobre tus hermanos, la cual tomé yo de mano del amorreo con mi espada y con mi arco.", "words": [[0, 215841], [2, 215959], [5, 216179], [8, 216339], [11, 216479], [16, 216719], [18, 216839], [21, 216999], [25, 217179], [31, 217519], [37, 217819], [41, 218039], [51, 219139], [54, 219219], [59, 219459], [64, 219839], [67, 220039], [70, 220199], [75, 220439], [79, 220799], [87, 221159], [91, 221359], [94, 221539], [101, 221959], [103, 222119], [107, 222279], [110, 222459]]}]}