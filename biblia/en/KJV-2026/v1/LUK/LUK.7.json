{"book": "LUK", "chapter": 7, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 390203, "verses": [{"verse": 1, "start": 300, "end": 5751, "text": "Now when he had ended all his sayings in the audience of the people, he entered into Capernaum.", "words": [[0, 300], [4, 820], [9, 940], [12, 1120], [16, 1280], [22, 1520], [26, 1760], [30, 1960], [38, 2460], [41, 2600], [45, 2720], [54, 3120], [57, 3320], [61, 3440], [69, 4240], [72, 4360], [80, 4640], [85, 5222]]}, {"verse": 2, "start": 6201, "end": 11292, "text": "And a certain centurion’s servant, who was dear to him, was sick, and ready to die.", "words": [[0, 6201], [4, 6328], [6, 6488], [14, 6728], [26, 7708], [35, 8008], [39, 8308], [43, 8508], [48, 8728], [51, 8928], [56, 9088], [60, 9548], [66, 9908], [70, 10388], [76, 10628], [79, 10808]]}, {"verse": 3, "start": 11742, "end": 18033, "text": "And when he heard of Jesus, he sent to him the elders of the Jews, beseeching him that he would come and heal his servant.", "words": [[0, 11742], [4, 11872], [9, 12032], [12, 12212], [18, 12432], [21, 12532], [28, 13112], [31, 13172], [36, 13412], [39, 13592], [43, 13792], [47, 13972], [54, 14292], [57, 14592], [61, 14712], [67, 15632], [78, 16032], [82, 16192], [87, 16392], [90, 16512], [96, 16652], [101, 16892], [105, 17092], [110, 17272], [114, 17492]]}, {"verse": 4, "start": 18483, "end": 25737, "text": "And when they came to Jesus, they besought him instantly, saying, That he was worthy for whom he should do this:", "words": [[0, 18483], [4, 18627], [9, 18807], [14, 18987], [19, 19287], [22, 19487], [29, 20368], [34, 20487], [43, 20928], [47, 21188], [58, 22088], [66, 23512], [71, 23639], [74, 23759], [78, 23959], [85, 24359], [89, 24619], [94, 24839], [97, 24979], [104, 25179], [107, 25379]]}, {"verse": 5, "start": 26187, "end": 29339, "text": "For he loves our nation, and he has built us a synagogue.", "words": [[0, 26187], [4, 26293], [7, 26473], [13, 26753], [17, 26993], [25, 27373], [29, 27853], [32, 27993], [36, 28133], [42, 28393], [45, 28593], [47, 28713]]}, {"verse": 6, "start": 29689, "end": 42867, "text": "Then Jesus went with them. And when he was now not far from the house, the centurion sent friends to him, saying to him, Lord, trouble not yourself: for I am not worthy that you should enter under my roof:", "words": [[0, 29689], [5, 29956], [11, 30316], [16, 30736], [21, 31036], [27, 31662], [31, 31789], [36, 31949], [39, 32109], [43, 32269], [47, 32529], [51, 32769], [55, 33089], [60, 33329], [64, 33489], [71, 34309], [75, 34389], [85, 35069], [90, 35329], [98, 35709], [101, 35929], [106, 36289], [113, 36529], [116, 36789], [121, 38288], [127, 38598], [135, 38978], [139, 39238], [149, 40132], [153, 40257], [155, 40417], [158, 40537], [162, 40737], [169, 41157], [174, 41377], [178, 41517], [185, 41697], [191, 41997], [197, 42257], [200, 42457]]}, {"verse": 7, "start": 43317, "end": 49539, "text": "Therefore neither thought I myself worthy to come to you: but say in a word, and my servant shall be healed.", "words": [[0, 43317], [10, 43823], [18, 44043], [26, 44463], [28, 44603], [35, 44923], [42, 45343], [45, 45583], [50, 45823], [53, 46023], [58, 47016], [62, 47179], [66, 47419], [69, 47509], [71, 47599], [77, 47999], [81, 48159], [84, 48319], [92, 48699], [98, 48979], [101, 49139]]}, {"verse": 8, "start": 49989, "end": 61851, "text": "For I also am a man set under authority, having under me soldiers, and I say to one, Go, and he goes; and to another, Come, and he comes; and to my servant, Do this, and he does it.", "words": [[0, 49989], [4, 50101], [6, 50261], [11, 50541], [14, 50761], [16, 50841], [20, 51101], [24, 51361], [30, 51581], [41, 52221], [48, 52361], [54, 52621], [57, 52841], [67, 53701], [71, 53801], [73, 53921], [77, 54081], [80, 54221], [85, 54661], [89, 55121], [93, 55221], [96, 55381], [102, 56181], [106, 56324], [109, 56424], [118, 56684], [124, 57564], [128, 57684], [131, 57864], [138, 58755], [142, 58924], [145, 59064], [148, 59244], [157, 59984], [160, 60264], [166, 60604], [170, 61104], [173, 61284], [178, 61504]]}, {"verse": 9, "start": 62201, "end": 73492, "text": "When Jesus heard these things, he marvelled at him, and turned him about, and said to the people that followed him, I say to you, I have not found so great faith, no, not in Israel.", "words": [[0, 62201], [5, 62329], [11, 62609], [17, 62949], [23, 63169], [31, 63909], [34, 64279], [44, 64649], [47, 64729], [52, 64909], [56, 65389], [63, 65629], [67, 65809], [74, 66109], [78, 66469], [83, 66709], [86, 66849], [90, 66969], [97, 67229], [102, 67429], [111, 67729], [116, 68397], [118, 68542], [122, 68782], [125, 69002], [130, 69642], [132, 69822], [137, 69942], [141, 70102], [147, 70502], [150, 70742], [156, 71062], [163, 71882], [167, 72622], [171, 72762], [174, 72902]]}, {"verse": 10, "start": 73842, "end": 78896, "text": "And they that were sent, returning to the house, found the servant whole that had been sick.", "words": [[0, 73842], [4, 73991], [9, 74171], [14, 74391], [19, 74551], [25, 75191], [35, 75591], [38, 75811], [42, 75931], [49, 76711], [55, 76891], [59, 77111], [67, 77411], [73, 77711], [78, 77991], [82, 78151], [87, 78331]]}, {"verse": 11, "start": 79346, "end": 87153, "text": "¶ And it came to pass the day after, that he went into a city called Nain; and many of his disciples went with him, and much people.", "words": [[2, 79346], [6, 79464], [9, 79584], [14, 79744], [17, 79904], [22, 80164], [26, 80384], [30, 80684], [37, 81024], [42, 81644], [45, 81784], [50, 81964], [55, 82224], [57, 82384], [62, 82604], [69, 82964], [75, 83907], [79, 84048], [84, 84268], [87, 84448], [91, 84588], [101, 85108], [106, 85448], [111, 85728], [116, 85948], [120, 86328], [125, 86568]]}, {"verse": 12, "start": 87603, "end": 98026, "text": "Now when he came near to the gate of the city, behold, there was a dead man carried out, the only son of his mother, and she was a widow: and much people of the city was with her.", "words": [[0, 87603], [4, 87762], [9, 87942], [12, 88062], [17, 88262], [22, 88522], [25, 88682], [29, 88802], [34, 89002], [37, 89142], [41, 89242], [47, 89662], [55, 90742], [61, 90862], [65, 91022], [67, 91142], [72, 91342], [76, 91662], [84, 92022], [89, 92802], [93, 92942], [98, 93182], [102, 93462], [105, 93582], [109, 93702], [117, 94482], [121, 94622], [125, 94822], [129, 95002], [131, 95122], [138, 95902], [142, 96032], [147, 96252], [154, 96652], [157, 96852], [161, 96972], [166, 97212], [170, 97452], [175, 97712]]}, {"verse": 13, "start": 98476, "end": 103443, "text": "And when the Lord saw her, he had compassion on her, and said to her, Weep not.", "words": [[0, 98476], [4, 98620], [9, 98760], [13, 98920], [18, 99140], [22, 99460], [27, 100060], [30, 100160], [34, 100360], [45, 100880], [48, 101160], [53, 101380], [57, 101640], [62, 101880], [65, 102060], [70, 102643], [75, 102943]]}, {"verse": 14, "start": 103793, "end": 111985, "text": "And he came and touched the bier: and those who carried him stood still. And he said, Young man, I say to you, Arise.", "words": [[0, 103793], [4, 103927], [7, 104047], [12, 104367], [16, 104627], [24, 104907], [28, 105301], [34, 105947], [38, 106070], [44, 106270], [48, 106490], [56, 106810], [60, 107030], [66, 107310], [73, 108270], [77, 108437], [80, 108537], [86, 109315], [92, 109505], [97, 110145], [99, 110325], [103, 110605], [106, 110805], [111, 111285]]}, {"verse": 15, "start": 112335, "end": 117260, "text": "And he that was dead sat up, and began to speak. And he delivered him to his mother.", "words": [[0, 112335], [4, 112479], [7, 112659], [12, 112879], [16, 113059], [21, 113339], [25, 113639], [29, 113959], [33, 114359], [39, 114659], [42, 114839], [49, 115673], [53, 115796], [56, 115896], [66, 116216], [70, 116476], [73, 116636], [77, 116776]]}, {"verse": 16, "start": 117710, "end": 126933, "text": "And there came a fear on all: and they glorified God, saying, That a great prophet is risen up among us; and, That God has visited his people.", "words": [[0, 117710], [4, 117834], [10, 117994], [15, 118194], [17, 118374], [22, 118594], [25, 118854], [30, 119531], [34, 119645], [39, 119795], [49, 120435], [54, 120795], [62, 121215], [67, 122111], [69, 122211], [75, 122571], [83, 122991], [86, 123331], [92, 123651], [95, 123971], [101, 124231], [105, 124995], [110, 125179], [115, 125359], [119, 125639], [123, 125899], [131, 126239], [135, 126459]]}, {"verse": 17, "start": 127283, "end": 132644, "text": "And this rumour of him went forth throughout all Judæa, and throughout all the region round about.", "words": [[0, 127283], [4, 127408], [9, 127658], [16, 127908], [19, 128128], [23, 128248], [28, 128468], [34, 128808], [45, 129128], [49, 129628], [56, 130128], [60, 130628], [71, 130888], [75, 131228], [79, 131368], [86, 131688], [92, 131988]]}, {"verse": 18, "start": 133094, "end": 136503, "text": "And the disciples of John showed him of all these things.", "words": [[0, 133094], [4, 133519], [8, 133619], [18, 134079], [21, 134339], [26, 134679], [33, 135039], [37, 135259], [40, 135419], [44, 135579], [50, 135779]]}, {"verse": 19, "start": 136953, "end": 145298, "text": "¶ And John calling to him two of his disciples sent them to Jesus, saying, Are you he that should come? or look we for another?", "words": [[2, 136953], [6, 137115], [11, 137435], [19, 137895], [22, 138135], [26, 138315], [30, 138635], [33, 138835], [37, 138995], [47, 139595], [52, 140015], [57, 140235], [60, 140415], [67, 140795], [75, 142761], [79, 142896], [83, 143056], [86, 143216], [91, 143416], [98, 143536], [104, 144292], [107, 144391], [112, 144571], [115, 144691], [119, 144891]]}, {"verse": 20, "start": 145648, "end": 152626, "text": "When the men were come to him, they said, John Baptist has sent us to you, saying, Are you he that should come? or look we for another?", "words": [[0, 145648], [5, 145777], [9, 145897], [13, 146077], [18, 146237], [23, 146457], [26, 146637], [31, 146957], [36, 147077], [42, 147785], [47, 147980], [55, 148320], [59, 148580], [64, 148820], [67, 148980], [70, 149160], [75, 149340], [83, 149980], [87, 150200], [91, 150360], [94, 150500], [99, 150680], [106, 150820], [112, 151567], [115, 151692], [120, 151852], [123, 151992], [127, 152172]]}, {"verse": 21, "start": 152976, "end": 161506, "text": "And in that same hour he cured many of their infirmities and plagues, and of evil spirits; and to many that were blind he gave sight.", "words": [[0, 152976], [4, 153112], [7, 153272], [12, 153452], [17, 153732], [22, 154232], [25, 154512], [31, 154852], [36, 155232], [39, 155452], [45, 155612], [57, 156312], [61, 156532], [70, 157092], [74, 157572], [77, 157712], [82, 158052], [91, 159163], [95, 159311], [98, 159451], [103, 159691], [108, 159891], [113, 160031], [119, 160651], [122, 160731], [127, 160951]]}, {"verse": 22, "start": 161956, "end": 177120, "text": "Then Jesus answering said to them, Go your way, and tell John what things you have seen and heard; how that the blind see, the lame walk, the lepers are cleansed, the deaf hear, the dead are raised, to the poor the gospel is preached.", "words": [[0, 161956], [5, 162119], [11, 162539], [21, 163179], [26, 163479], [29, 163659], [35, 164312], [38, 164483], [43, 164703], [48, 165023], [52, 165483], [57, 165683], [62, 166003], [67, 166263], [74, 166583], [78, 166783], [83, 166883], [88, 167183], [92, 167383], [99, 168123], [103, 168406], [108, 168626], [112, 168786], [118, 169106], [123, 170226], [127, 170346], [132, 170646], [138, 171466], [142, 171566], [149, 171926], [153, 172106], [163, 172946], [167, 173006], [172, 173266], [178, 173866], [182, 173946], [187, 174186], [191, 174306], [199, 175126], [202, 175226], [206, 175346], [211, 175686], [215, 175886], [222, 176286], [225, 176546]]}, {"verse": 23, "start": 177570, "end": 181410, "text": "And blessed is he, whoever shall not be offended in me.", "words": [[0, 177570], [4, 177710], [12, 178050], [15, 178430], [19, 179110], [27, 179450], [33, 179850], [37, 180130], [40, 180350], [49, 180770], [52, 181010]]}, {"verse": 24, "start": 181760, "end": 190908, "text": "¶ And when the messengers of John were departed, he began to speak to the people concerning John, What did you go out into the wilderness to see? A reed shaken with the wind?", "words": [[2, 181760], [6, 181892], [11, 182032], [15, 182192], [26, 182632], [29, 182812], [34, 183112], [39, 183332], [49, 184112], [52, 184252], [58, 184512], [61, 184672], [67, 184872], [70, 185072], [74, 185192], [81, 185452], [92, 185952], [98, 186860], [103, 187003], [107, 187183], [111, 187303], [114, 187463], [118, 187643], [123, 187863], [127, 188003], [138, 188323], [141, 188663], [146, 189391], [148, 189551], [153, 189852], [160, 190111], [165, 190352], [169, 190472]]}, {"verse": 25, "start": 191358, "end": 200138, "text": "But what did you go out to see? A man clothed in soft clothing? Behold, they which are gorgeously apparelled, and live delicately, are in kings’ courts.", "words": [[0, 191358], [4, 191456], [9, 191636], [13, 191796], [17, 191896], [20, 192016], [24, 192176], [27, 192336], [32, 193021], [34, 193117], [38, 193357], [46, 193857], [49, 193937], [54, 194197], [64, 195113], [72, 195431], [77, 195791], [83, 196071], [87, 196211], [98, 196871], [110, 197531], [114, 197731], [119, 197971], [131, 198911], [135, 199031], [138, 199151], [145, 199591]]}, {"verse": 26, "start": 200588, "end": 205387, "text": "But what did you go out to see? A prophet? Yes, I say to you, and much more than a prophet.", "words": [[0, 200588], [4, 200672], [9, 200832], [13, 200972], [17, 201072], [20, 201212], [24, 201372], [27, 201532], [32, 202144], [34, 202433], [43, 203007], [48, 203387], [50, 203467], [54, 203667], [57, 203827], [62, 204007], [66, 204247], [71, 204467], [76, 204687], [81, 204847], [83, 205137]]}, {"verse": 27, "start": 205837, "end": 212609, "text": "This is he, of whom it is written, Behold, I send my messenger before your face, which shall prepare your way before you.", "words": [[0, 205837], [5, 206004], [8, 206144], [12, 206304], [15, 206464], [20, 206664], [23, 206804], [26, 206924], [35, 207564], [43, 208444], [45, 208624], [50, 208844], [53, 209024], [63, 209444], [70, 209784], [75, 210024], [81, 210744], [87, 210864], [93, 211064], [101, 211424], [106, 211644], [110, 211864], [117, 212204]]}, {"verse": 28, "start": 213059, "end": 223238, "text": "For I say to you, Among those that are born of women there is not a greater prophet than John the Baptist: but he that is least in the kingdom of God is greater than he.", "words": [[0, 213059], [4, 213186], [6, 213346], [10, 213566], [13, 213766], [18, 214206], [24, 214386], [30, 214786], [35, 215006], [39, 215126], [44, 215386], [47, 215586], [53, 216186], [59, 216486], [62, 216646], [66, 216846], [68, 216946], [76, 217226], [84, 217686], [89, 217966], [94, 218246], [98, 218426], [107, 219435], [111, 219558], [114, 219858], [119, 220158], [122, 220338], [128, 220638], [131, 220858], [135, 220958], [143, 221258], [146, 221498], [150, 221818], [153, 222218], [161, 222558], [166, 222838]]}, {"verse": 29, "start": 223588, "end": 230746, "text": "And all the people that heard him, and the tax collectors, justified God, being baptized with the baptism of John.", "words": [[0, 223588], [4, 223701], [8, 224002], [12, 224201], [19, 224442], [24, 224662], [30, 224882], [35, 225402], [39, 225581], [43, 225682], [47, 225961], [59, 226682], [69, 227402], [74, 227902], [80, 228521], [89, 228981], [94, 229421], [98, 229541], [106, 229902], [109, 230201]]}, {"verse": 30, "start": 231196, "end": 237628, "text": "But the Pharisees and lawyers rejected the counsel of God against themselves, being not baptized of him.", "words": [[0, 231196], [4, 231324], [8, 231424], [18, 232164], [22, 232264], [30, 232624], [39, 233224], [43, 233544], [51, 233924], [54, 234184], [58, 234464], [66, 234844], [78, 235944], [84, 236144], [88, 236384], [97, 236864], [100, 237264]]}, {"verse": 31, "start": 238078, "end": 244264, "text": "¶ And the Lord said, To what then shall I liken the men of this generation? and to what are they like?", "words": [[2, 238078], [6, 238203], [10, 238303], [15, 238543], [21, 239330], [24, 239427], [29, 239647], [34, 239927], [40, 240227], [42, 240427], [48, 240787], [52, 241067], [56, 241407], [59, 241607], [64, 241847], [76, 243050], [80, 243194], [83, 243334], [88, 243534], [92, 243634], [97, 243814]]}, {"verse": 32, "start": 244714, "end": 255334, "text": "They are like to children sitting in the marketplace, and calling one to another, and saying, We have piped to you, and you have not danced; we have mourned to you, and you have not wept.", "words": [[0, 244714], [5, 244818], [9, 244898], [14, 245098], [17, 245258], [26, 245678], [34, 246038], [37, 246218], [41, 246318], [54, 246838], [58, 247458], [66, 247738], [70, 247998], [73, 248198], [82, 248518], [86, 249038], [94, 249598], [97, 249918], [102, 250098], [108, 250478], [111, 250598], [116, 250818], [120, 251238], [124, 251358], [129, 251458], [133, 251638], [141, 252639], [144, 252750], [149, 252890], [157, 253310], [160, 253470], [165, 253690], [169, 254230], [173, 254410], [178, 254590], [182, 254790]]}, {"verse": 33, "start": 255784, "end": 261267, "text": "For John the Baptist came neither eating bread nor drinking wine; and you say, He has a demon.", "words": [[0, 255784], [4, 255867], [9, 256127], [13, 256267], [21, 256587], [26, 256927], [34, 257187], [41, 257507], [47, 257867], [51, 258147], [60, 258487], [66, 259429], [70, 259555], [74, 259695], [79, 260015], [82, 260355], [86, 260595], [88, 260695]]}, {"verse": 34, "start": 261717, "end": 269913, "text": "The Son of man is come eating and drinking; and you say, Behold a gluttonous man, and a drunkard, a friend of tax collectors and sinners!", "words": [[0, 261717], [4, 261799], [8, 262059], [11, 262179], [15, 262439], [18, 262699], [23, 262879], [30, 263179], [34, 263459], [44, 264331], [48, 264455], [52, 264575], [57, 265255], [64, 265575], [66, 265875], [77, 266355], [82, 266675], [86, 267135], [88, 267235], [98, 267935], [100, 268015], [107, 268215], [110, 268375], [114, 268635], [125, 269095], [129, 269335]]}, {"verse": 35, "start": 270363, "end": 272745, "text": "But wisdom is justified of all her children.", "words": [[0, 270363], [4, 270460], [11, 270760], [14, 271020], [24, 271420], [27, 271800], [31, 272000], [35, 272140]]}, {"verse": 36, "start": 273095, "end": 280013, "text": "¶ And one of the Pharisees desired him that he would eat with him. And he went into the Pharisee’s house, and sat down to eat.", "words": [[2, 273095], [6, 273221], [10, 273421], [13, 273541], [17, 273681], [27, 274361], [35, 274741], [39, 275121], [44, 275341], [47, 275461], [53, 275621], [57, 275741], [62, 275941], [67, 276575], [71, 276701], [74, 276821], [79, 277021], [84, 277321], [88, 277481], [99, 278141], [106, 278361], [110, 278961], [114, 279201], [119, 279481], [122, 279661]]}, {"verse": 37, "start": 280463, "end": 291174, "text": "And, behold, a woman in the city, which was a sinner, when she knew that Jesus sat at the table in the Pharisee’s house, brought an alabaster box of ointment,", "words": [[0, 280463], [5, 280632], [13, 281372], [15, 281572], [21, 281832], [24, 282052], [28, 282172], [34, 282912], [40, 283092], [44, 283312], [46, 283452], [54, 283772], [59, 284312], [63, 284492], [68, 284732], [73, 284912], [79, 285192], [83, 285612], [86, 285752], [90, 285892], [96, 286272], [99, 286472], [103, 286592], [114, 287272], [121, 287912], [129, 288172], [132, 288372], [142, 289052], [146, 289332], [149, 289592]]}, {"verse": 38, "start": 291624, "end": 302615, "text": "And stood at his feet behind him weeping, and began to wash his feet with tears, and did wipe them with the hairs of her head, and kissed his feet, and anointed them with the ointment.", "words": [[0, 291624], [4, 291751], [10, 292011], [13, 292211], [17, 292371], [22, 292631], [29, 293091], [33, 293491], [42, 294291], [46, 294511], [52, 294851], [55, 295091], [60, 295411], [64, 295731], [69, 296011], [74, 296251], [81, 296671], [85, 297091], [89, 297291], [94, 297611], [99, 297891], [104, 298111], [108, 298231], [114, 298491], [117, 298731], [121, 298851], [127, 299191], [131, 299471], [138, 299771], [142, 300011], [148, 300797], [152, 300922], [161, 301342], [166, 301642], [171, 301842], [175, 302002]]}, {"verse": 39, "start": 303065, "end": 315027, "text": "Now when the Pharisee which had bidden him saw it, he spoke within himself, saying, This man, if he were a prophet, would have known who and what manner of woman this is that touches him: for she is a sinner.", "words": [[0, 303065], [4, 303505], [9, 303625], [13, 303745], [22, 304465], [28, 304605], [32, 304765], [39, 305085], [43, 305245], [47, 305585], [51, 306005], [54, 306085], [60, 306405], [67, 306705], [76, 307405], [84, 308192], [89, 308376], [94, 308976], [97, 309156], [100, 309336], [105, 309496], [107, 309576], [116, 310156], [122, 310276], [127, 310456], [133, 310676], [137, 310956], [141, 311156], [146, 311376], [153, 311716], [156, 311976], [162, 312196], [167, 312456], [170, 312716], [175, 312876], [183, 313196], [188, 313865], [192, 314008], [196, 314228], [199, 314488], [201, 314668]]}, {"verse": 40, "start": 315377, "end": 323363, "text": "And Jesus answering said to him, Simon, I have somewhat to say to you. And he says, Master, say on.", "words": [[0, 315377], [4, 315560], [10, 315960], [20, 316560], [25, 316900], [28, 317120], [33, 318464], [40, 318981], [42, 319221], [47, 319461], [56, 319841], [59, 320101], [63, 320221], [66, 320361], [71, 321031], [75, 321156], [78, 321276], [84, 322057], [92, 322507], [96, 322957]]}, {"verse": 41, "start": 323663, "end": 328927, "text": "There was a certain creditor which had two debtors: the one owed five hundred denarii, and the other fifty.", "words": [[0, 323663], [6, 323767], [10, 323907], [12, 324027], [20, 324267], [29, 324767], [35, 324967], [39, 325147], [43, 325387], [52, 326293], [56, 326373], [60, 326593], [65, 326908], [70, 327223], [78, 327538], [87, 327853], [91, 328133], [95, 328273], [101, 328628]]}, {"verse": 42, "start": 329377, "end": 335178, "text": "And when they had nothing to pay, he frankly forgave them both. Tell me therefore, which of them will love him most?", "words": [[0, 329377], [4, 329483], [9, 329583], [14, 329703], [18, 329823], [26, 330023], [29, 330243], [34, 330623], [37, 330683], [45, 330963], [53, 331403], [58, 331503], [64, 332213], [69, 332370], [72, 332710], [83, 333310], [89, 333450], [92, 333610], [97, 333870], [102, 334110], [107, 334390], [111, 334570]]}, {"verse": 43, "start": 335528, "end": 343478, "text": "Simon answered and said, I suppose that he, to whom he forgave most. And he said to him, You have rightly judged.", "words": [[0, 335528], [6, 335854], [15, 336274], [19, 336494], [25, 337874], [27, 338014], [35, 338294], [40, 338574], [44, 339154], [47, 339234], [52, 339394], [55, 339514], [63, 339954], [69, 340766], [73, 340892], [76, 340992], [81, 341212], [84, 341412], [89, 342064], [93, 342241], [98, 342461], [106, 342861]]}, {"verse": 44, "start": 343828, "end": 355492, "text": "And he turned to the woman, and said to Simon, Do you see this woman? I entered into your house, you gave me no water for my feet: but she has washed my feet with tears, and wiped them with the hairs of her head.", "words": [[0, 343828], [4, 343970], [7, 344090], [14, 344350], [17, 344530], [21, 344630], [28, 344890], [32, 345310], [37, 345570], [40, 345730], [47, 346624], [50, 346720], [54, 346840], [58, 347060], [63, 347280], [70, 348065], [72, 348203], [80, 348483], [85, 348743], [90, 348923], [97, 349543], [101, 349623], [106, 349803], [109, 349983], [112, 350183], [118, 350543], [122, 350763], [125, 350923], [131, 351755], [135, 351856], [139, 352016], [143, 352156], [150, 352476], [153, 352696], [158, 352976], [163, 353196], [170, 353556], [174, 353796], [180, 354036], [185, 354256], [190, 354396], [194, 354516], [200, 354696], [203, 354876], [207, 354996]]}, {"verse": 45, "start": 355942, "end": 361510, "text": "You gave me no kiss: but this woman since the time I came in has not ceased to kiss my feet.", "words": [[0, 355942], [4, 356038], [9, 356218], [12, 356358], [15, 356518], [21, 357430], [25, 357532], [30, 357732], [36, 358032], [42, 358332], [46, 358552], [51, 358792], [53, 358932], [58, 359152], [61, 359432], [65, 359712], [69, 359932], [76, 360252], [79, 360652], [84, 360852], [87, 361072]]}, {"verse": 46, "start": 361960, "end": 366879, "text": "My head with oil you did not anoint: but this woman has anointed my feet with ointment.", "words": [[0, 361960], [3, 362098], [8, 362338], [13, 362498], [17, 362818], [21, 363098], [25, 363218], [29, 363418], [37, 364262], [41, 364530], [46, 364710], [52, 364970], [56, 365170], [65, 365550], [68, 365810], [73, 366090], [78, 366330]]}, {"verse": 47, "start": 367329, "end": 375669, "text": "Therefore I say to you, Her sins, which are many, are forgiven; for she loved much: but to whom little is forgiven, the same loves little.", "words": [[0, 367329], [10, 367612], [12, 367892], [16, 368092], [19, 368292], [24, 368472], [28, 368652], [34, 369292], [40, 369512], [44, 369652], [50, 370252], [54, 370332], [64, 371305], [68, 371409], [72, 371589], [78, 371849], [84, 372774], [88, 372878], [91, 373018], [96, 373218], [103, 373498], [106, 373718], [116, 374518], [120, 374598], [125, 374878], [131, 375178]]}, {"verse": 48, "start": 376019, "end": 378829, "text": "And he said to her, Your sins are forgiven.", "words": [[0, 376019], [4, 376150], [7, 376290], [12, 376550], [15, 376810], [20, 377405], [25, 377560], [30, 377900], [34, 378180]]}, {"verse": 49, "start": 379179, "end": 385356, "text": "And they that sat at the table with him began to say within themselves, Who is this that forgives sins also?", "words": [[0, 379179], [4, 379342], [9, 379542], [14, 379762], [18, 380062], [21, 380242], [25, 380322], [31, 380662], [36, 380962], [40, 381122], [46, 381402], [49, 381642], [53, 381882], [60, 382182], [72, 383294], [76, 383443], [79, 383603], [84, 383903], [89, 384163], [98, 384583], [103, 384823]]}, {"verse": 50, "start": 385706, "end": 389803, "text": "And he said to the woman, Your faith has saved you; go in peace.", "words": [[0, 385706], [4, 385838], [7, 385958], [12, 386198], [15, 386398], [19, 386498], [26, 387241], [31, 387347], [37, 387587], [41, 387847], [47, 388127], [52, 388769], [55, 389013], [58, 389273]]}]}