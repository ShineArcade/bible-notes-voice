u, los cuales son de Dios.", "words": [[0, 147409], [7, 147778], [17, 148178], [22, 148558], [26, 148718], [34, 149556], [45, 150295], [50, 150435], [52, 150615], [57, 150815], [60, 151035], [68, 151355], [75, 151675], [77, 151875], [80, 151955], [88, 152255], [98, 153215], [102, 153335], [109, 153655], [113, 153995], [116, 154135]]}]}