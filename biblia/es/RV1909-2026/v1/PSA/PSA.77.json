{"book": "PSA", "chapter": 77, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 133298, "verses": [{"verse": 1, "start": 300, "end": 9261, "text": "Al Músico principal: para Jedutún: Salmo de Asaf. CON mi voz clamé a Dios, a Dios clamé, y él me escuchará.", "words": [[0, 300], [3, 468], [10, 968], [21, 2132], [26, 2600], [35, 3343], [41, 3844], [44, 4024], [50, 4838], [54, 4961], [57, 5161], [61, 5861], [67, 6161], [69, 6301], [75, 6801], [77, 6861], [82, 7041], [89, 8001], [91, 8101], [94, 8281], [97, 8441]]}, {"verse": 2, "start": 9711, "end": 18239, "text": "Al Señor busqué en el día de mi angustia: mi mal corría de noche, y no cesaba: mi alma rehusaba consuelo.", "words": [[0, 9711], [3, 9858], [9, 10158], [16, 10738], [19, 11018], [22, 11158], [26, 11378], [29, 11558], [32, 11678], [42, 12774], [45, 12938], [49, 13198], [56, 13678], [59, 13818], [66, 14118], [68, 14558], [71, 14718], [79, 15806], [82, 15986], [87, 16346], [96, 17266]]}, {"verse": 3, "start": 18689, "end": 25087, "text": "Me acordaba de Dios, y gritaba: me quejaba, y desmayaba mi espíritu. (Selah.)", "words": [[0, 18689], [3, 18777], [12, 19237], [15, 19397], [21, 19657], [23, 19897], [32, 20889], [35, 21109], [44, 21749], [46, 22069], [56, 22649], [59, 22809], [69, 24718]]}, {"verse": 4, "start": 25537, "end": 29524, "text": "Tenías los párpados de mis ojos: estaba yo quebrantado, y no hablaba.", "words": [[0, 25537], [7, 25537], [11, 25537], [20, 25941], [23, 26181], [27, 26281], [33, 27232], [40, 27599], [43, 27779], [56, 28579], [58, 28699], [61, 28839]]}, {"verse": 5, "start": 29974, "end": 34707, "text": "Consideraba los días desde el principio, los años de los siglos.", "words": [[0, 29974], [12, 30871], [16, 31071], [21, 31371], [27, 31791], [30, 32051], [41, 33111], [45, 33311], [50, 33611], [53, 33791], [57, 34271]]}, {"verse": 6, "start": 35157, "end": 41639, "text": "Me acordaba de mis canciones de noche; meditaba con mi corazón, y mi espíritu inquiría.", "words": [[0, 35157], [3, 35263], [12, 35823], [15, 35963], [19, 36083], [29, 36623], [32, 36783], [39, 37655], [48, 38357], [52, 38577], [55, 38817], [64, 39317], [66, 39897], [69, 40057], [78, 40797]]}, {"verse": 7, "start": 42089, "end": 46352, "text": "¿Desechará el Señor para siempre, y no volverá más a amar?", "words": [[0, 42089], [11, 42715], [14, 42875], [20, 43175], [25, 43535], [34, 44115], [36, 44855], [39, 44995], [47, 45475], [51, 45715], [53, 45835]]}, {"verse": 8, "start": 46802, "end": 53604, "text": "¿Se ha acabado para siempre su misericordia? ¿se ha acabado la palabra suya para generación y generación?", "words": [[0, 46802], [4, 46965], [7, 47085], [15, 47525], [20, 47745], [28, 48125], [31, 48345], [45, 49718], [49, 49879], [52, 50039], [60, 50539], [63, 50659], [71, 50959], [76, 51539], [81, 51759], [92, 52559], [94, 52739]]}, {"verse": 9, "start": 54054, "end": 61026, "text": "¿Ha olvidado Dios el tener misericordia? ¿ha encerrado con ira sus piedades? (Selah.)", "words": [[0, 54054], [4, 54314], [13, 54894], [18, 55194], [21, 55714], [27, 55994], [41, 57491], [45, 57676], [55, 58376], [59, 58656], [63, 58936], [67, 59096], [77, 60657]]}, {"verse": 10, "start": 61476, "end": 68815, "text": "Y dije: Enfermedad mía es esta; traeré pues a la memoria los años de la diestra del Altísimo.", "words": [[0, 61476], [2, 61623], [8, 62434], [19, 63219], [23, 63659], [26, 63913], [32, 65159], [39, 65599], [44, 65699], [46, 65919], [49, 66019], [57, 66479], [61, 66659], [66, 66959], [69, 67159], [72, 67279], [80, 67699], [84, 67899]]}, {"verse": 11, "start": 69265, "end": 74662, "text": "Me acordaré de las obras de JAH: sí, haré yo memoria de tus maravillas antiguas.", "words": [[0, 69265], [3, 69371], [12, 69931], [15, 70144], [19, 70358], [25, 70571], [28, 70883], [33, 71455], [37, 71958], [42, 72178], [45, 72358], [53, 72858], [56, 73038], [60, 73198], [71, 73798]]}, {"verse": 12, "start": 75112, "end": 79242, "text": "Y meditaré en todas tus obras, y hablaré de tus hechos.", "words": [[0, 75112], [2, 75372], [11, 76052], [14, 76272], [20, 76552], [24, 76912], [31, 77332], [33, 77852], [41, 78312], [44, 78432], [48, 78652]]}, {"verse": 13, "start": 79692, "end": 84923, "text": "Oh Dios, en santidad es tu camino: ¿qué Dios grande como el Dios nuestro?", "words": [[0, 79692], [3, 80124], [9, 80564], [12, 80704], [21, 81384], [24, 81724], [27, 81844], [35, 82764], [40, 82871], [45, 83091], [52, 83551], [57, 83851], [60, 84011], [65, 84191]]}, {"verse": 14, "start": 85373, "end": 90822, "text": "Tú eres el Dios que hace maravillas: tú hiciste notoria en los pueblos tu fortaleza.", "words": [[0, 85373], [3, 85515], [8, 85795], [11, 86055], [16, 86295], [20, 86555], [25, 86815], [37, 88073], [40, 88198], [48, 88738], [56, 89278], [59, 89398], [63, 89518], [71, 89938], [74, 90078]]}, {"verse": 15, "start": 91272, "end": 97019, "text": "Con tu brazo redimiste a tu pueblo, a los hijos de Jacob y de José. (Selah.)", "words": [[0, 91272], [4, 91401], [7, 91581], [13, 92361], [23, 93001], [25, 93161], [28, 93221], [36, 94061], [38, 94121], [42, 94261], [48, 94541], [51, 94741], [57, 95041], [59, 95401], [62, 95521], [68, 96650]]}, {"verse": 16, "start": 97469, "end": 104133, "text": "Te vieron las aguas, oh Dios; te vieron las aguas, temieron; y temblaron los abismos.", "words": [[0, 97469], [3, 97570], [10, 97830], [14, 98050], [21, 98790], [24, 99190], [30, 100013], [33, 100115], [40, 100395], [44, 100615], [51, 101300], [61, 102224], [63, 102349], [73, 103109], [77, 103249]]}, {"verse": 17, "start": 104583, "end": 111140, "text": "Las nubes echaron inundaciones de aguas; tronaron los cielos, y corrieron tus rayos.", "words": [[0, 104583], [4, 104693], [10, 105294], [18, 105994], [31, 106833], [34, 107134], [41, 108046], [50, 108726], [54, 108946], [62, 109606], [64, 109726], [74, 110226], [78, 110683]]}, {"verse": 18, "start": 111590, "end": 120239, "text": "Anduvo en derredor el sonido de tus truenos; los relámpagos alumbraron el mundo; se estremeció y tembló la tierra.", "words": [[0, 111590], [7, 112010], [10, 112190], [19, 112710], [22, 112870], [29, 113310], [32, 113450], [36, 113650], [45, 114911], [49, 115078], [60, 115858], [71, 116518], [74, 116718], [81, 118287], [84, 118487], [95, 118687], [97, 118987], [104, 119427], [107, 119527]]}, {"verse": 19, "start": 120689, "end": 127787, "text": "En el mar fue tu camino, y tus sendas en las muchas aguas; y tus pisadas no fueron conocidas.", "words": [[0, 120689], [3, 120826], [6, 120986], [10, 121226], [14, 121466], [17, 121646], [25, 122146], [27, 122646], [31, 122806], [38, 123466], [41, 123666], [45, 123786], [52, 124086], [59, 125214], [61, 125340], [65, 125520], [73, 126140], [76, 126460], [83, 126720]]}, {"verse": 20, "start": 128237, "end": 132897, "text": "Condujiste a tu pueblo como ovejas, por mano de Moisés y de Aarón.", "words": [[0, 128237], [11, 128799], [13, 128939], [16, 128999], [23, 129379], [28, 129739], [36, 130739], [40, 131019], [45, 131259], [48, 131459], [55, 131879], [57, 132139], [60, 132530]]}]}