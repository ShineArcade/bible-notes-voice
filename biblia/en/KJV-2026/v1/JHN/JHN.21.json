{"book": "JHN", "chapter": 21, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 231404, "verses": [{"verse": 1, "start": 300, "end": 7487, "text": "After these things Jesus showed himself again to the disciples at the sea of Tiberias; and in this way showed he himself.", "words": [[0, 300], [6, 567], [12, 807], [19, 1327], [25, 1607], [32, 1967], [40, 2327], [46, 2767], [49, 2987], [53, 3127], [63, 3607], [66, 3887], [70, 3967], [74, 4247], [77, 4367], [87, 5535], [91, 5660], [94, 5760], [99, 5980], [103, 6240], [110, 6580], [113, 6820]]}, {"verse": 2, "start": 7837, "end": 17676, "text": "There were together Simon Peter, and Thomas called Didymus, and Nathanael of Cana in Galilee, and the sons of Zebedee, and two other of his disciples.", "words": [[0, 7837], [6, 8018], [11, 8178], [20, 8538], [26, 8978], [33, 9458], [37, 9998], [44, 10358], [51, 10698], [60, 11518], [64, 11918], [74, 12798], [77, 12898], [82, 13338], [85, 13498], [94, 14078], [98, 14518], [102, 14658], [107, 14918], [110, 15118], [119, 15718], [123, 15998], [127, 16238], [133, 16458], [136, 16658], [140, 16798]]}, {"verse": 3, "start": 18026, "end": 27752, "text": "Simon Peter says to them, I go a fishing. They say to him, We also go with you. They went forth, and entered into a ship immediately; and that night they caught nothing.", "words": [[0, 18026], [6, 18332], [12, 18672], [17, 19012], [20, 19252], [26, 19819], [28, 19959], [31, 20049], [33, 20139], [42, 21064], [47, 21169], [51, 21409], [54, 21609], [59, 22117], [62, 22238], [67, 22478], [70, 22698], [75, 22938], [80, 23439], [85, 23540], [90, 23720], [97, 24040], [101, 24300], [109, 24600], [114, 24900], [116, 25020], [121, 25220], [134, 26201], [138, 26329], [143, 26489], [149, 26869], [154, 26989], [161, 27229]]}, {"verse": 4, "start": 28102, "end": 34466, "text": "But when the morning was now come, Jesus stood on the shore: but the disciples knew not that it was Jesus.", "words": [[0, 28102], [4, 28204], [9, 28344], [13, 28484], [21, 28724], [25, 28984], [29, 29184], [35, 29964], [41, 30204], [47, 30584], [50, 30784], [54, 30904], [61, 31628], [65, 31722], [69, 31862], [79, 32382], [84, 32742], [88, 33002], [93, 33242], [96, 33362], [100, 33622]]}, {"verse": 5, "start": 34816, "end": 40072, "text": "Then Jesus says to them, Children, have you any food? They answered him, No.", "words": [[0, 34816], [5, 35000], [11, 35300], [16, 35660], [19, 35860], [25, 36457], [35, 36711], [40, 36991], [44, 37131], [48, 37311], [54, 38180], [59, 38345], [68, 38705], [73, 39818]]}, {"verse": 6, "start": 40352, "end": 50327, "text": "And he said to them, Cast the net on the right side of the ship, and you shall find. They cast therefore, and now they were not able to draw it for the multitude of fishes.", "words": [[0, 40352], [4, 40482], [7, 40602], [12, 40842], [15, 41042], [21, 41588], [26, 41846], [30, 42106], [34, 42326], [37, 42546], [41, 42666], [47, 42866], [52, 43166], [55, 43306], [59, 43406], [65, 43726], [69, 44266], [73, 44466], [79, 44686], [85, 45606], [90, 45723], [95, 46143], [106, 47083], [110, 47123], [114, 47343], [119, 47523], [124, 47683], [128, 47923], [133, 48203], [136, 48363], [141, 48683], [144, 48803], [148, 48963], [152, 49063], [162, 49503], [165, 49723]]}, {"verse": 7, "start": 50677, "end": 63433, "text": "Therefore that disciple whom Jesus loved says to Peter, It is the Lord. Now when Simon Peter heard that it was the Lord, he girt his fisher’s coat to him, (for he was naked,) and did cast himself into the sea.", "words": [[0, 50677], [10, 51168], [15, 51288], [24, 51788], [29, 52128], [35, 52488], [41, 53188], [46, 53388], [49, 53608], [56, 54298], [59, 54394], [62, 54514], [66, 54654], [72, 55393], [76, 55596], [81, 55856], [87, 56156], [93, 56536], [99, 56916], [104, 57116], [107, 57216], [111, 57416], [115, 57576], [121, 58336], [124, 58586], [129, 58836], [133, 58916], [142, 59556], [147, 59596], [150, 59836], [155, 60296], [160, 60416], [163, 60556], [167, 60736], [175, 61476], [179, 61636], [183, 61796], [188, 62036], [196, 62476], [201, 62816], [205, 62996]]}, {"verse": 8, "start": 63783, "end": 71473, "text": "And the other disciples came in a little ship; (for they were not far from land, but as it were two hundred cubits,) dragging the net with fishes.", "words": [[0, 63783], [4, 63909], [8, 64009], [14, 64209], [24, 64769], [29, 65069], [32, 65289], [34, 65429], [41, 65569], [47, 66299], [52, 66401], [57, 66521], [62, 66661], [66, 66841], [70, 67121], [75, 67361], [81, 67861], [85, 67961], [88, 68181], [91, 68321], [96, 68521], [100, 68721], [108, 68921], [117, 69761], [126, 70141], [130, 70401], [134, 70581], [139, 70781]]}, {"verse": 9, "start": 71823, "end": 78712, "text": "As soon then as they were come to land, they saw a fire of coals there, and fish laid on it, and bread.", "words": [[0, 71823], [3, 72006], [8, 72286], [13, 72546], [16, 72706], [21, 72846], [26, 73026], [31, 73266], [34, 73446], [40, 74226], [45, 74546], [49, 74786], [51, 74986], [56, 75306], [59, 75526], [65, 76026], [72, 76746], [76, 76806], [81, 77226], [86, 77506], [89, 77766], [93, 77926], [97, 78337]]}, {"verse": 10, "start": 79062, "end": 82707, "text": "Jesus says to them, Bring of the fish which you have now caught.", "words": [[0, 79062], [6, 79347], [11, 79707], [14, 79967], [20, 80628], [26, 80897], [29, 81077], [33, 81177], [38, 81497], [44, 81737], [48, 81897], [53, 81997], [57, 82177]]}, {"verse": 11, "start": 82987, "end": 92828, "text": "Simon Peter went up, and drew the net to land full of great fishes, a hundred and fifty and three: and for all there were so many, yet was not the net broken.", "words": [[0, 82987], [6, 83287], [12, 83627], [17, 83927], [21, 84227], [25, 84807], [30, 85047], [34, 85227], [38, 85487], [41, 85667], [46, 85967], [51, 86227], [54, 86367], [60, 86627], [68, 87114], [70, 87600], [78, 88087], [82, 88325], [88, 88563], [92, 88800], [99, 89228], [103, 89354], [107, 89534], [111, 89794], [117, 89974], [122, 90134], [125, 90354], [131, 91054], [135, 91254], [139, 91494], [143, 91734], [147, 91954], [151, 92154]]}, {"verse": 12, "start": 93178, "end": 101823, "text": "Jesus says to them, Come and dine. And none of the disciples dared ask him, Who are you? knowing that it was the Lord.", "words": [[0, 93178], [6, 93462], [11, 93802], [14, 94042], [20, 94648], [25, 94888], [29, 95268], [35, 96183], [39, 96326], [44, 96506], [47, 96646], [51, 96766], [61, 97246], [67, 97646], [71, 98066], [76, 98746], [80, 98926], [84, 99206], [89, 100182], [97, 100487], [102, 100767], [105, 100867], [109, 101047], [113, 101207]]}, {"verse": 13, "start": 102173, "end": 106813, "text": "Jesus then comes, and takes bread, and gives them, and fish likewise.", "words": [[0, 102173], [6, 102483], [11, 102903], [18, 103243], [22, 103543], [28, 103803], [35, 104163], [39, 104743], [45, 105003], [51, 105283], [55, 105543], [60, 105863]]}, {"verse": 14, "start": 107163, "end": 112983, "text": "This is now the third time that Jesus showed himself to his disciples, after that he was risen from the dead.", "words": [[0, 107163], [5, 107395], [8, 107575], [12, 107775], [16, 107935], [22, 108235], [27, 108615], [32, 108835], [38, 109115], [45, 109475], [53, 109915], [56, 110135], [60, 110315], [71, 110875], [77, 111350], [82, 111550], [85, 111690], [89, 111850], [95, 112130], [100, 112390], [104, 112550]]}, {"verse": 15, "start": 113333, "end": 127143, "text": "¶ So when they had dined, Jesus says to Simon Peter, Simon, son of Jonas, do you love me more than these? He says to him, Yes, Lord; you know that I love you. He says to him, Feed my lambs.", "words": [[2, 113333], [5, 113492], [10, 113692], [15, 113832], [19, 113992], [26, 114692], [32, 114932], [37, 115312], [40, 115552], [46, 115852], [53, 116661], [60, 117140], [64, 117320], [67, 117440], [74, 118120], [77, 118340], [81, 118460], [86, 118700], [89, 118920], [94, 119140], [99, 119340], [104, 120424], [106, 120973], [10