{"book": "GEN", "chapter": 38, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 274969, "verses": [{"verse": 1, "start": 300, "end": 9094, "text": "Y aconteció en aquel tiempo, que Judá se apartó de sus hermanos, y se fue a un varón adulamita, que se llamaba Hira.", "words": [[0, 300], [2, 682], [12, 1102], [15, 1242], [21, 1542], [29, 1962], [33, 2310], [38, 2657], [41, 2957], [48, 3417], [51, 3537], [55, 3697], [65, 4617], [67, 4817], [70, 4957], [74, 5197], [76, 5457], [79, 5677], [85, 6117], [96, 6957], [100, 7477], [103, 7617], [111, 8371]]}, {"verse": 2, "start": 9444, "end": 17343, "text": "Y vio allí Judá la hija de un hombre cananeo, el cual se llamaba Súa; y la tomó, y entró a ella:", "words": [[0, 9444], [2, 9565], [6, 9865], [11, 10255], [16, 10645], [19, 10875], [24, 11105], [27, 11265], [30, 11425], [37, 11705], [46, 12885], [49, 12965], [54, 13185], [57, 13425], [65, 13905], [70, 14849], [72, 15012], [75, 15092], [81, 15592], [83, 16212], [89, 16712], [91, 16812]]}, {"verse": 3, "start": 17693, "end": 22004, "text": "La cual concibió, y parió un hijo; y llamó su nombre Er.", "words": [[0, 17693], [3, 17817], [8, 17977], [18, 18797], [20, 18937], [26, 19317], [29, 19617], [35, 20378], [37, 20658], [43, 20978], [46, 21118], [53, 21586]]}, {"verse": 4, "start": 22354, "end": 27132, "text": "Y concibió otra vez, y parió un hijo, y llamó su nombre Onán.", "words": [[0, 22354], [2, 22481], [11, 23141], [16, 23421], [21, 23881], [23, 24136], [29, 24516], [32, 24736], [38, 25016], [40, 25331], [46, 25651], [49, 25831], [56, 26511]]}, {"verse": 5, "start": 27482, "end": 33987, "text": "Y volvió a concebir, y parió un hijo, y llamó su nombre Sela. Y estaba en Quezib cuando lo parió.", "words": [[0, 27482], [2, 27612], [9, 27992], [11, 28072], [21, 28792], [23, 29012], [29, 29372], [32, 29572], [38, 29892], [40, 30147], [46, 30447], [49, 30607], [56, 31090], [62, 31739], [64, 31843], [71, 32103], [74, 32453], [81, 32803], [88, 33223], [91, 33483]]}, {"verse": 6, "start": 34337, "end": 39288, "text": "Y Judá tomó mujer para su primogénito Er, la cual se llamaba Tamar.", "words": [[0, 34337], [2, 34602], [7, 34902], [12, 35242], [18, 35582], [23, 35882], [26, 36082], [38, 36922], [42, 37482], [45, 37602], [50, 37862], [53, 38122], [61, 38602]]}, {"verse": 7, "start": 39638, "end": 46251, "text": "Y Er, el primogénito de Judá, fue malo a los ojos de Jehová, y le quitó Jehová la vida.", "words": [[0, 39638], [2, 39872], [6, 40142], [9, 40302], [21, 41142], [24, 41562], [30, 41982], [34, 42142], [39, 42802], [41, 43002], [45, 43142], [50, 43462], [53, 43662], [61, 44162], [63, 44582], [66, 44742], [72, 45182], [79, 45582], [82, 45642]]}, {"verse": 8, "start": 46601, "end": 54470, "text": "Entonces Judá dijo a Onán: Únete a la mujer de tu hermano, cumple con tu deber de cuñado y da descendencia a tu hermano.", "words": [[0, 46601], [9, 47131], [14, 47873], [19, 48136], [21, 48336], [27, 49079], [33, 49444], [35, 49544], [38, 49604], [44, 49824], [47, 50044], [50, 50184], [59, 50984], [66, 51304], [70, 51484], [73, 51624], [79, 51864], [82, 52044], [89, 52564], [91, 52784], [94, 52904], [107, 53684], [109, 53804], [112, 53904]]}, {"verse": 9, "start": 54750, "end": 66626, "text": "Y sabiendo Onán que la descendencia no había de ser suya, sucedía que cuando entraba a la mujer de su hermano vertía en tierra, por no dar descendencia a su hermano.", "words": [[0, 54750], [2, 54895], [11, 55375], [16, 56115], [20, 56535], [23, 56675], [36, 57555], [39, 57755], [45, 57975], [48, 58135], [52, 58355], [58, 59235], [66, 59915], [70, 60095], [77, 60355], [85, 60685], [87, 61015], [90, 61135], [96, 61435], [99, 61655], [102, 61815], [110, 62275], [117, 62875], [120, 63155], [128, 64155], [132, 64300], [135, 64500], [139, 64780], [152, 65740], [154, 65900], [157, 65960]]}, {"verse": 10, "start": 66976, "end": 72493, "text": "Y desagradó ante los ojos de Jehová lo que hacía, y también quitó a él la vida.", "words": [[0, 66976], [2, 67098], [12, 67838], [17, 68098], [21, 68298], [26, 68698], [29, 68958], [36, 69438], [39, 69558], [43, 69738], [50, 70218], [52, 70678], [60, 70958], [66, 71538], [68, 71638], [71, 71798], [74, 71978]]}, {"verse": 11, "start": 72843, "end": 86542, "text": "Y Judá dijo a Tamar su nuera: Quédate viuda en casa de tu padre, hasta que crezca Sela mi hijo; porque dijo: Que quizá no muera él también como sus hermanos. Y se fue Tamar, y se quedó en casa de su padre.", "words": [[0, 72843], [2, 72972], [7, 73452], [12, 73852], [14, 74032], [20, 74352], [23, 74552], [30, 75373], [38, 75708], [44, 76148], [47, 76308], [52, 76528], [55, 76728], [58, 76848], [65, 77208], [71, 77708], [75, 78048], [82, 78388], [87, 78728], [90, 78948], [96, 79811], [103, 79981], [109, 80701], [113, 80802], [119, 81202], [122, 81342], [128, 81642], [131, 81782], [139, 82082], [144, 82362], [148, 82542], [158, 83528], [160, 83652], [163, 83752], [167, 83932], [174, 84452], [176, 84972], [179, 85092], [185, 85392], [188, 85492], [193, 85752], [196, 85972], [199, 86112]]}, {"verse": 12, "start": 86892, "end": 100504, "text": "Y pasaron muchos días, y murió la hija de Súa, mujer de Judá; y Judá se consoló, y subía a los trasquiladores de sus ovejas a Timnat, él y su amigo Hira el adulamita.", "words": [[0, 86892], [2, 86997], [10, 87417], [17, 87697], [23, 88137], [25, 88757], [31, 89137], [34, 89297], [39, 89677], [42, 89777], [47, 90457], [53, 90697], [56, 90917], [62, 91633], [64, 91801], [69, 92181], [72, 92301], [81, 93521], [83, 93781], [89, 94301], [91, 94481], [95, 94641], [110, 95481], [113, 95681], [117, 95861], [124, 96401], [126, 97021], [134, 97641], [137, 97901], [139, 98101], [142, 98241], [148, 98721], [153, 99201], [156, 99381]]}, {"verse": 13, "start": 100854, "end": 107657, "text": "Y avisaron a Tamar, diciendo: He aquí tu suegro sube a Timnat a esquilar sus ovejas.", "words": [[0, 100854], [2, 101002], [11, 101582], [13, 101742], [20, 102122], [30, 103464], [33, 103554], [38, 103754], [41, 104114], [48, 104474], [53, 104874], [55, 105014], [62, 105554], [64, 105994], [73, 106574], [77, 107148]]}, {"verse": 14, "start": 108007, "end": 123359, "text": "Entonces quitó ella de sobre sí los vestidos de su viudez, y se cubrió con un velo, y se tapó, y se puso a la puerta de las aguas que están junto al camino de Timnat; porque veía que había crecido Sela, y ella no era dada a él por mujer.", "words": [[0, 108007], [9, 108454], [15, 109054], [20, 109294], [23, 109454], [29, 109734], [32, 110034], [36, 110474], [45, 110974], [48, 111134], [51, 111407], [59, 111681], [61, 111954], [64, 112114], [71, 112614], [75, 112834], [78, 113014], [84, 113394], [86, 113534], [89, 113654], [95, 114337], [97, 114437], [100, 114557], [105, 114917], [107, 114997], [110, 115057], [117, 115377], [120, 115617], [124, 115777], [130, 116157], [134, 116277], [140, 116537], [146, 116797], [149, 117077], [156, 117377], [159, 117886], [167, 118548], [174, 118732], [179, 119192], [183, 119352], [189, 119552], [197, 120072], [203, 120532], [205, 120932], [210, 121152], [213, 121412], [217, 121592], [222, 122032], [224, 122272], [227, 122472], [231, 122732]]}, {"verse": 15, "start": 123709, "end": 128671, "text": "Y la vio Judá, y la tuvo por ramera, porque había ella cubierto su rostro.", "words": [[0, 123709], [2, 123831], [5, 123951], [9, 124151], [15, 124631], [17, 124846], [20, 124966], [25, 125226], [29, 125646], [37, 126066], [44, 126646], [50, 126946], [55, 127206], [64, 127746], [67, 127966]]}, {"verse": 16, "start": 129021, "end": 140342, "text": "Y se apartó del camino hacia ella, y le dijo: Vamos, pues, ahora me acostaré contigo; porque no sabía que era su nuera; y ella dijo: ¿Qué me has de dar, si entras a mí?", "words": [[0, 129021], [2, 129412], [5, 129552], [12, 130112], [16, 130272], [23, 130612], [29, 130912], [35, 131372], [37, 131652], [40, 131752], [46, 132487], [53, 132710], [59, 133290], [65, 133430], [68, 133590], [77, 133970], [86, 134855], [93, 135018], [96, 135258], [102, 135678], [106, 135898], [110, 136138], [113, 136358], [120, 137230], [122, 137396], [127, 137576], [133, 138394], [138, 138538], [141, 138778], [145, 138958], [148, 139098], [153, 139338], [156, 139598], [163, 139898], [165, 140038]]}, {"verse": 17, "start": 140622, "end": 148832, "text": "Él respondió: Yo te enviaré del ganado un cabrito de las cabras. Y ella dijo: Me has de dar prenda hasta que lo envíes.", "words": [[0, 140622], [3, 140789], [14, 141819], [17, 141943], [20, 142123], [28, 142563], [32, 142703], [39, 143123], [42, 143263], [50, 143663], [53, 143803], [57, 143943], [65, 144846], [67, 145007], [72, 145207], [78, 145998], [81, 146198], [85, 146398], [88, 146618], [92, 146838], [99, 147458], [105, 147758], [109, 147958], [112, 148435]]}, {"verse": 18, "start": 149112, "end": 162325, "text": "Entonces él dijo: ¿Qué prenda te daré? Ella respondió: Tu anillo, y tu manto, y tu bastón que tienes en tu mano. Y él se los dio, y entró a ella, la cual concibió de él.", "words": [[0, 149112], [9, 149677], [12, 150237], [18, 150995], [23, 151209], [30, 151459], [33, 151639], [39, 152274], [44, 152500], [55, 153631], [58, 153711], [66, 154191], [68, 154371], [71, 154531], [78, 155031], [80, 155431], [83, 155571], [90, 156131], [94, 156271], [101, 156591], [104, 156851], [107, 156971], [113, 157781], [115, 157946], [118, 158106], [121, 158286], [125, 158506], [130, 158826], [132, 159071], [138, 159691], [140, 159891], [146, 160731], [149, 160831], [154, 161031], [163, 161711], [166, 161851]]}, {"verse": 19, "start": 162675, "end": 169924, "text": "Y se levantó, y se fue: y se quitó el velo de sobre sí, y se vistió las ropas de su viudez.", "words": [[0, 162675], [2, 162841], [5, 162921], [14, 163721], [16, 164181], [19, 164321], [24, 165003], [26, 165128], [29, 165228], [35, 165648], [38, 165768], [43, 166068], [46, 166228], [52, 166548], [56, 167468], [58, 167548], [61, 167708], [68, 168208], [72, 168388], [78, 168828], [81, 169216], [84, 169604]]}, {"verse": 20, "start": 170274, "end": 178806, "text": "Y Judá envió el cabrito de las cabras por mano de su amigo el adulamita, para que tomase la prenda de mano de la mujer; pero no la halló.", "words": [[0, 170274], [2, 170399], [7, 170719], [13, 171039], [16, 171179], [24, 171639], [27, 171799], [31, 171939], [38, 172379], [42, 172599], [47, 172859], [50, 173079], [53, 173239], [59, 173579], [62, 173739], [73, 174419], [78, 175119], [82, 175279], [89, 175719], [92, 175859], [99, 176279], [102, 176399], [107, 176599], [110, 176759], [113, 176859], [120, 177580], [125, 177725], [128, 178045], [131, 178453]]}, {"verse": 21, "start": 179156, "end": 188488, "text": "Y preguntó a los hombres de aquel lugar, diciendo: ¿Dónde está la ramera de las aguas junto al camino? Y ellos le dijeron: No ha estado aquí ramera.", "words": [[0, 179156], [2, 179281], [11, 180001], [13, 180161], [17, 180321], [25, 180721], [28, 180921], [34, 181241], [41, 181581], [51, 182706], [58, 182967], [63, 183207], [66, 183477], [73, 183747], [76, 183887], [80, 184067], [86, 184427], [92, 184587], [95, 184787], [103, 185555], [105, 185738], [111, 185958], [114, 186138], [123, 187038], [126, 187240], [129, 187360], [136, 187660], [141, 188040]]}, {"verse": 22, "start": 188768, "end": 197023, "text": "Entonces él se volvió a Judá, y dijo: No la he hallado; y también los hombres del lugar dijeron: Aquí no ha estado ramera.", "words": [[0, 188768], [9, 189734], [12, 189967], [15, 190227], [22, 190707], [24, 190987], [30, 191267], [32, 191447], [38, 192148], [41, 192293], [44, 192433], [47, 192573], [56, 193314], [58, 193421], [66, 193661], [70, 193881], [78, 194201], [82, 194421], [88, 194721], [97, 195588], [102, 195947], [105, 196127], [108, 196187], [115, 196407]]}, {"verse": 23, "start": 197303, "end": 204749, "text": "Y Judá dijo: Que se lo quede, para que no seamos menospreciados: he aquí yo he enviado este cabrito, y tú no la hallaste.", "words": [[0, 197303], [2, 197607], [7, 197946], [13, 198508], [17, 198568], [20, 198648], [23, 198788], [30, 199148], [35, 199488], [39, 199628], [42, 199748], [49, 200148], [65, 201457], [68, 201457], [73, 201761], [76, 202081], [79, 202181], [87, 202621], [92, 202821], [101, 203341], [103, 203781], [106, 203961], [109, 204234], [112, 204508]]}, {"verse": 24, "start": 205029, "end": 217950, "text": "Y acaeció que al cabo de unos tres meses fue dado aviso a Judá, diciendo: Tamar tu nuera ha fornicado, y aun cierto está preñada de las fornicaciones. Y Judá dijo: Sacadla, y sea quemada.", "words": [[0, 205029], [2, 205134], [10, 205694], [14, 206014], [17, 206094], [22, 206374], [25, 206574], [30, 206694], [35, 206974], [41, 207614], [45, 207694], [50, 207994], [56, 208454], [58, 208594], [64, 209334], [74, 210294], [80, 210579], [83, 210719], [89, 211099], [92, 211499], [103, 211899], [105, 212119], [109, 212259], [116, 212719], [121, 212999], [129, 213619], [132, 213759], [136, 214477], [151, 215346], [153, 215650], [158, 215989], [164, 216718], [173, 216978], [175, 217178], [179, 217298]]}, {"verse": 25, "start": 218230, "end": 232589, "text": "Y ella, cuando la sacaban, envió a decir a su suegro: Del varón cuyas son estas cosas, estoy encinta: y dijo más: Mira ahora de quién son estas cosas, el anillo, y el manto, y el bastón.", "words": [[0, 218230], [2, 218414], [8, 218714], [15, 219154], [18, 219594], [27, 220034], [33, 221054], [35, 221294], [41, 221634], [43, 221934], [46, 222094], [54, 223058], [58, 223118], [64, 223578], [70, 224038], [74, 224218], [80, 224438], [87, 224958], [93, 225694], [102, 226641], [104, 226781], [109, 227021], [114, 227865], [119, 228065], [125, 228365], [128, 228545], [134, 228725], [138, 229045], [144, 229265], [151, 230105], [154, 230205], [162, 230705], [164, 230985], [167, 231105], [174, 231565], [176, 231785], [179, 231905]]}, {"verse": 26, "start": 232869, "end": 241261, "text": "Entonces Judá los reconoció, y dijo: Más justa es que yo, por cuanto no la he dado a Sela mi hijo. Y nunca más la conoció.", "words": [[0, 232869], [9, 233393], [14, 233951], [18, 234231], [29, 234931], [31, 235131], [37, 235892], [41, 236150], [47, 236490], [50, 236590], [54, 236710], [58, 236950], [62, 237210], [69, 237470], [72, 237750], [75, 237910], [78, 238010], [83, 238210], [85, 238480], [90, 238750], [93, 238910], [99, 239601], [101, 239726], [107, 239986], [111, 240226], [114, 240466]]}, {"verse": 27, "start": 241611, "end": 246264, "text": "Y aconteció que al tiempo del parir, he aquí había dos en su vientre.", "words": [[0, 241611], [2, 241889], [12, 242529], [16, 242709], [19, 242869], [26, 243169], [30, 243449], [37, 244129], [40, 244289], [45, 244709], [51, 244949], [55, 245229], [58, 245469], [61, 245898]]}, {"verse": 28, "start": 246614, "end": 257242, "text": "Y sucedió, cuando paría, que sacó la mano el uno, y la partera tomó y ató a su mano un hilo escarlata, diciendo: Este salió primero.", "words": [[0, 246614], [2, 246756], [11, 247456], [18, 247736], [25, 249096], [29, 249176], [34, 249516], [37, 249616], [42, 249796], [45, 250016], [50, 250316], [52, 250816], [55, 250936], [63, 251316], [68, 251796], [70, 251936], [74, 252316], [76, 252516], [79, 252676], [84, 253056], [87, 253436], [92, 253816], [103, 254556], [113, 255734], [118, 255984], [124, 256384]]}, {"verse": 29, "start": 257522, "end": 267661, "text": "Pero fue que volviendo él a meter la mano, he aquí su hermano salió; y ella dijo: ¡Cómo te has abierto paso! Y llamó su nombre Fares.", "words": [[0, 257522], [5, 257665], [9, 257885], [13, 258065], [23, 258665], [26, 258865], [28, 258985], [34, 259225], [37, 259465], [43, 259852], [46, 260240], [51, 260460], [54, 260700], [62, 261140], [69, 261942], [71, 262108], [76, 262288], [82, 263106], [88, 263283], [91, 263463], [95, 263623], [103, 264023], [109, 265615], [111, 265737], [117, 266077], [120, 266237], [127, 266917]]}, {"verse": 30, "start": 268011, "end": 274569, "text": "Y después salió su hermano, el que tenía en su mano el hilo escarlata, y llamó su nombre Zara.", "words": [[0, 268011], [2, 268119], [10, 268359], [16, 268859], [19, 269059], [28, 269979], [31, 270159], [35, 270279], [41, 270599], [44, 270799], [47, 270959], [52, 271259], [55, 271539], [60, 271779], [71, 272959], [73, 273039], [79, 273359], [82, 273479], [89, 274042]]}]}