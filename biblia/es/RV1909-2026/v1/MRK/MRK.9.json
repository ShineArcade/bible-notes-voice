{"book": "MRK", "chapter": 9, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 416265, "verses": [{"verse": 1, "start": 300, "end": 9716, "text": "También les dijo: De cierto os digo que hay algunos de los que están aquí, que no probarán la muerte hasta que hayan visto el reino de Dios que viene con poder.", "words": [[0, 300], [8, 620], [12, 820], [18, 1646], [21, 1794], [28, 1974], [31, 2154], [36, 2694], [40, 2934], [44, 3094], [52, 3534], [55, 3714], [59, 3814], [63, 3934], [69, 4174], [75, 4974], [79, 5054], [82, 5214], [91, 5754], [94, 5874], [101, 6294], [107, 6794], [111, 6994], [117, 7254], [123, 7514], [126, 7714], [132, 8094], [135, 8254], [140, 8494], [144, 8694], [150, 8954], [154, 9174]]}, {"verse": 2, "start": 10166, "end": 21438, "text": "Y seis días después tomó Jesús a Pedro, y a Jacobo, y a Juan, y los sacó aparte solos a un monte alto; y fue transfigurado delante de ellos.", "words": [[0, 10166], [2, 10288], [7, 10588], [12, 11048], [20, 11468], [25, 11988], [31, 12268], [33, 12508], [40, 12988], [42, 13548], [44, 13628], [52, 14328], [54, 14588], [56, 14648], [62, 15008], [64, 15328], [68, 15648], [73, 16008], [80, 16448], [86, 17008], [88, 17208], [91, 17348], [97, 17708], [103, 18706], [105, 18963], [109, 19123], [123, 20123], [131, 20643], [134, 20823]]}, {"verse": 3, "start": 21888, "end": 32043, "text": "Y sus vestidos se volvieron resplandecientes, muy blancos, como la nieve; tanto que ningún lavandero en la tierra los puede hacer tan blancos.", "words": [[0, 21888], [2, 21995], [6, 22155], [15, 22655], [18, 22815], [28, 23335], [46, 24835], [50, 25155], [59, 26095], [64, 26355], [67, 26535], [74, 27416], [80, 27621], [84, 27881], [91, 28281], [101, 29041], [104, 29141], [107, 29261], [114, 29621], [118, 30201], [124, 30501], [130, 30841], [134, 31181]]}, {"verse": 4, "start": 32493, "end": 36704, "text": "Y les apareció Elías con Moisés, que hablaban con Jesús.", "words": [[0, 32493], [2, 32602], [6, 32722], [15, 33422], [21, 34002], [25, 34262], [33, 35322], [37, 35382], [46, 35822], [50, 36002]]}, {"verse": 5, "start": 37154, "end": 49171, "text": "Entonces respondiendo Pedro, dice a Jesús: Maestro, bien será que nos quedemos aquí, y hagamos tres refugios: para ti uno, y para Moisés otro, y para Elías otro;", "words": [[0, 37154], [9, 38374], [22, 39194], [29, 40094], [34, 40394], [36, 40614], [43, 41472], [52, 42058], [57, 42178], [62, 42478], [66, 42698], [70, 42858], [79, 43318], [85, 43598], [87, 44158], [95, 44498], [100, 44778], [110, 45938], [115, 46082], [118, 46282], [123, 46542], [125, 46902], [130, 47082], [137, 47422], [143, 47762], [145, 48182], [150, 48342], [156, 48762]]}, {"verse": 6, "start": 49521, "end": 52814, "text": "Porque no sabía qué decir, pues estaban espantados.", "words": [[0, 49521], [7, 49728], [10, 49928], [16, 50368], [20, 50528], [27, 51288], [32, 51428], [40, 51788]]}, {"verse": 7, "start": 53264, "end": 62422, "text": "Y vino una nube que les hizo sombra, y una voz de la nube, que decía: Este es mi Hijo amado: a él oíd.", "words": [[0, 53264], [2, 53387], [7, 53687], [11, 54007], [16, 54407], [20, 54607], [24, 54847], [29, 55327], [37, 56227], [39, 56367], [43, 56547], [47, 56907], [50, 57187], [53, 57327], [59, 57767], [63, 58007], [70, 59021], [75, 59343], [78, 59603], [81, 59783], [86, 60003], [93, 61381], [95, 61633], [98, 61886]]}, {"verse": 8, "start": 62772, "end": 68575, "text": "Y luego, como miraron, no vieron más a nadie consigo, sino a Jesús solo.", "words": [[0, 62772], [2, 62889], [9, 63289], [14, 63509], [23, 64609], [26, 64909], [33, 65309], [37, 65569], [39, 65889], [45, 66209], [54, 66689], [59, 67169], [61, 67449], [67, 67729]]}, {"verse": 9, "start": 69025, "end": 79145, "text": "Y descendiendo ellos del monte, les mandó que a nadie dijesen lo que habían visto, sino cuando el Hijo del hombre hubiese resucitado de los muertos.", "words": [[0, 69025], [2, 69147], [15, 69887], [21, 70107], [25, 70287], [32, 71327], [36, 71447], [42, 71907], [46, 72067], [48, 72227], [54, 72837], [62, 73447], [65, 73607], [69, 73747], [76, 74067], [83, 75107], [88, 75347], [95, 75607], [98, 75847], [103, 76127], [107, 76287], [114, 76587], [122, 77027], [133, 78027], [136, 78147], [140, 78267]]}, {"verse": 10, "start": 79595, "end": 86073, "text": "Y retuvieron la palabra en sí, discutiendo qué sería aquéllo: Resucitar de los muertos.", "words": [[0, 79595], [2, 79720], [13, 80340], [16, 80480], [24, 80820], [27, 81060], [31, 81660], [43, 82240], [47, 82460], [53, 82900], [62, 84085], [72, 84911], [75, 85051], [79, 85171]]}, {"verse": 11, "start": 86523, "end": 93147, "text": "Y le preguntaron, diciendo: ¿Qué es lo que los escribas dicen, que es necesario que Elías venga antes?", "words": [[0, 86523], [2, 86649], [5, 86729], [18, 87449], [28, 88498], [33, 88498], [36, 88660], [39, 88780], [43, 88940], [47, 89080], [56, 89680], [63, 90540], [67, 90820], [70, 90940], [80, 91540], [84, 91820], [90, 92100], [96, 92520]]}, {"verse": 12, "start": 93497, "end": 106940, "text": "Y respondiendo él, les dijo: Elías a la verdad, viniendo antes, restaurará todas las cosas: y cómo está escrito del Hijo del hombre, que padezca mucho y sea tenido en nada.", "words": [[0, 93605], [2, 93745], [15, 94585], [19, 95005], [23, 95425], [29, 96359], [35, 96906], [37, 97106], [40, 97186], [48, 97486], [57, 98646], [64, 98965], [75, 99284], [81, 99603], [85, 99921], [92, 101308], [94, 102228], [99, 102528], [104, 102728], [112, 103068], [116, 103368], [121, 103608], [125, 103748], [133, 104208], [137, 104588], [145, 105068], [151, 105388], [153, 105678], [157, 105968], [164, 106108], [167, 106248]]}, {"verse": 13, "start": 107390, "end": 113639, "text": "Pero os digo que Elías ya vino, y le hicieron todo lo que quisieron, como está escrito de él.", "words": [[0, 107390], [5, 107555], [8, 107755], [13, 108015], [17, 108255], [23, 108935], [26, 109155], [32, 109455], [34, 110155], [37, 110295], [46, 110735], [51, 111015], [54, 111235], [58, 111395], [69, 111955], [74, 112455], [79, 112635], [87, 112935], [90, 113255]]}, {"verse": 14, "start": 114089, "end": 121778, "text": "Y cuando vino a los discípulos, vio grande compañía alrededor de ellos, y escribas que disputaban con ellos.", "words": [[0, 114089], [2, 114211], [9, 114391], [14, 114811], [16, 114991], [20, 115111], [32, 116131], [36, 116551], [43, 116851], [52, 117731], [62, 118211], [65, 118671], [72, 118991], [74, 119511], [83, 120131], [87, 120291], [98, 121011], [102, 121231]]}, {"verse": 15, "start": 122228, "end": 128015, "text": "Y luego toda la gente, viéndole, se espantó, y corriendo a él, le saludaron.", "words": [[0, 122228], [2, 122375], [8, 122635], [13, 123175], [16, 123395], [23, 123695], [33, 124695], [36, 125145], [45, 125595], [47, 125915], [57, 126475], [59, 126595], [63, 127135], [66, 127215]]}, {"verse": 16, "start": 128465, "end": 131254, "text": "Y les preguntó: ¿Qué disputáis con ellos?", "words": [[0, 128465], [2, 128610], [6, 128690], [16, 129740], [21, 129864], [31, 130484], [35, 130704]]}, {"verse": 17, "start": 131704, "end": 137979, "text": "Y respondiendo uno de la multitud, dijo: Maestro, traje a ti mi hijo, que tiene un espíritu mudo,", "words": [[0, 131704], [2, 131980], [15, 132860], [19, 133040], [22, 133200], [25, 133320], [35, 133840], [41, 134701], [50, 135158], [56, 135538], [58, 135638], [61, 135858], [64, 135918], [70, 136498], [74, 136578], [80, 136818], [83, 136978], [92, 137518]]}, {"verse": 18, "start": 138429, "end": 149619, "text": "El cual, donde quiera que le toma, lo convulsiona; y echa espuma por la boca, y rechina los dientes, y queda rígido: y dije a tus discípulos que le echasen fuera, y no pudieron.", "words": [[0, 138429], [3, 138548], [9, 138968], [15, 139148], [22, 139528], [26, 139668], [29, 139768], [35, 140488], [38, 140568], [51, 141759], [53, 141881], [58, 142081], [65, 142541], [69, 142721], [72, 142841], [78, 143121], [80, 143381], [88, 143841], [92, 143981], [101, 144421], [103, 144861], [109, 145061], [117, 145970], [119, 146069], [124, 146349], [126, 146529], [130, 146689], [141, 147349], [145, 147569], [148, 147709], [156, 148149], [163, 148489], [165, 148889], [168, 149009]]}, {"verse": 19, "start": 149969, "end": 160634, "text": "Y respondiendo él, les dijo: ¡Oh generación infiel! ¿hasta cuándo estaré con vosotros? ¿hasta cuándo tendré que soportaros? Traédmele.", "words": [[0, 150076], [2, 150216], [15, 151056], [19, 151476], [23, 151896], [29, 152907], [33, 153017], [44, 153777], [52, 154844], [59, 155027], [66, 155327], [73, 155867], [77, 156047], [87, 157189], [94, 157469], [101, 157889], [108, 158229], [112, 158329], [124, 159541]]}, {"verse": 20, "start": 161084, "end": 171184, "text": "Y se le trajeron: y como le vio, luego el espíritu lo convulsionó; y cayendo en tierra, se revolcaba, echando espuma por la boca.", "words": [[0, 161084], [2, 161192], [5, 161312], [8, 161452], [18, 162546], [20, 162631], [25, 162811], [28, 162991], [33, 163691], [39, 164031], [42, 164431], [51, 164951], [54, 165051], [67, 166222], [69, 166366], [77, 166946], [80, 167106], [88, 167566], [91, 168216], [102, 168866], [110, 169686], [117, 170266], [121, 170466], [124, 170626]]}, {"verse": 21, "start": 171634, "end": 179728, "text": "Y Jesús preguntó a su padre: ¿Desde cuándo le sucede esto? Y él dijo: Desde niño:", "words": [[0, 171634], [2, 171760], [8, 172120], [17, 173120], [19, 173180], [22, 173280], [29, 174130], [36, 174379], [43, 174699], [46, 175039], [53, 175419], [59, 176319], [61, 176486], [64, 176606], [70, 177384], [76, 177588]]}, {"verse": 22, "start": 180178, "end": 186742, "text": "Y muchas veces le echa en el fuego y en aguas, para matarle; pero, si puedes algo, ayúdanos, teniendo misericordia de nosotros.", "words": [[0, 180178], [2, 180178], [9, 180178], [15, 180178], [18, 180178], [23, 180178], [26, 180178], [29, 180178], [35, 180453], [37, 180673], [40, 180793], [47, 181233], [52, 181693], [61, 182665], [67, 182789], [70, 182969], [77, 183229], [83, 183949], [93, 184609], [102, 185189], [115, 185929], [118, 186029]]}, {"verse": 23, "start": 187092, "end": 191815, "text": "Y Jesús le dijo: Si puedes creer, al que cree todo es posible.", "words": [[0, 187092], [2, 187222], [8, 187622], [11, 187982], [17, 188871], [20, 189014], [27, 189314], [34, 189694], [37, 190074], [41, 190354], [46, 190634], [51, 190834], [54, 191034]]}, {"verse": 24, "start": 192265, "end": 196899, "text": "Y luego el padre del muchacho dijo clamando: Creo, ayuda mi incredulidad.", "words": [[0, 192265], [2, 192373], [8, 192553], [11, 192793], [17, 193113], [21, 193333], [30, 193893], [35, 194353], [45, 195356], [51, 195533], [57, 195873], [60, 196133]]}, {"verse": 25, "start": 197249, "end": 209523, "text": "Y como Jesús vio que la multitud se agolpaba, reprendió al espíritu inmundo, diciéndole: Espíritu mudo y sordo, yo te mando, sal de él, y no entres más en él.", "words": [[0, 197249], [2, 197354], [7, 197594], [13, 197914], [17, 198394], [21, 198534], [24, 198674], [33, 199294], [36, 199494], [46, 200554], [56, 201294], [59, 201454], [68, 202014], [77, 202974], [89, 204263], [98, 204788], [103, 205208], [105, 205308], [112, 206068], [115, 206228], [118, 206368], [125, 206748], [129, 206988], [132, 207248], [136, 207548], [138, 208008], [141, 208188], [148, 208568], [152, 208868], [155, 209148]]}, {"verse": 26, "start": 209973, "end": 219355, "text": "Entonces el espíritu clamó, lo convulsionó violentamente y salió; y él quedó como muerto, de modo que muchos decían: Está muerto.", "words": [[0, 209973], [9, 210490], [12, 210770], [21, 211310], [28, 212410], [31, 212550], [43, 213410], [57, 214370], [59, 214550], [66, 215325], [68, 215445], [71, 215585], [77, 215905], [82, 216085], [90, 216805], [93, 216965], [98, 217105], [102, 217305], [109, 217505], [117, 218584], [122, 218805]]}, {"verse": 27, "start": 219705, "end": 224396, "text": "Pero Jesús tomándole de la mano, le enderezó; y se levantó.", "words": [[0, 219705], [5, 219867], [11, 220467], [21, 221007], [24, 221187], [27, 221327], [33, 222087], [36, 222207], [46, 223361], [48, 223509], [51, 223589]]}, {"verse": 28, "start": 224846, "end": 231933, "text": "Y como él entró en casa, sus discípulos le preguntaron aparte: ¿Por qué nosotros no pudimos echarle fuera?", "words": [[0, 224846], [2, 224933], [7, 225153], [10, 225373], [16, 225753], [19, 225873], [25, 226773], [29, 226933], [40, 227673], [43, 227853], [55, 228573], [63, 229559], [68, 229718], [72, 229838], [81, 230218], [84, 230538], [92, 230998], [100, 231478]]}, {"verse": 29, "start": 232283, "end": 237571, "text": "Y les dijo: Este género con nada puede salir, sino con oración y ayuno.", "words": [[0, 232283], [2, 232440], [6, 232520], [12, 233303], [17, 233506], [24, 234066], [28, 234226], [33, 234546], [39, 234826], [46, 235566], [51, 235766], [55, 236046], [63, 236666], [65, 236966]]}, {"verse": 30, "start": 238021, "end": 244038, "text": "Y habiendo salido de allí, caminaron por Galilea; y no quería que nadie lo supiese.", "words": [[0, 238021], [2, 238309], [11, 238629], [18, 239129], [21, 239309], [27, 239929], [37, 240569], [41, 240809], [50, 241954], [52, 242050], [55, 242170], [62, 242410], [66, 242710], [72, 242990], [75, 243230]]}, {"verse": 31, "start": 244488, "end": 256985, "text": "Porque enseñaba a sus discípulos, y les decía: El Hijo del hombre será entregado en manos de hombres, y le matarán; pero muerto él, resucitará al tercer día.", "words": [[0, 244488], [7, 244771], [16, 245811], [18, 246051], [22, 246271], [34, 247211], [36, 247411], [40, 247591], [47, 248607], [50, 248775], [55, 249115], [59, 249275], [66, 249655], [71, 249855], [81, 250555], [84, 250675], [90, 250915], [93, 251155], [102, 251495], [104, 252115], [107, 252235], [116, 253724], [121, 253724], [128, 254268], [132, 254908], [143, 255808], [146, 255968], [153, 256288]]}, {"verse": 32, "start": 257435, "end": 261630, "text": "Pero ellos no entendían esta palabra, y tenían miedo de preguntarle.", "words": [[0, 257435], [5, 257582], [11, 257842], [14, 258142], [24, 258722], [29, 258962], [38, 259362], [40, 259562], [47, 259862], [53, 260362], [56, 260582]]}, {"verse": 33, "start": 262080, "end": 269622, "text": "Y llegó a Capernaum; y así que estuvo en casa, les preguntó: ¿Qué disputabais entre vosotros en el camino?", "words": [[0, 262080], [2, 262420], [8, 262640], [10, 262900], [21, 264216], [23, 264322], [27, 264542], [31, 264762], [38, 265082], [41, 265222], [47, 265662], [51, 265742], [61, 266814], [66, 267374], [78, 267954], [84, 268154], [93, 268674], [96, 268894], [99, 269034]]}, {"verse": 34, "start": 270072, "end": 276616, "text": "Pero ellos callaron; porque los unos con los otros habían disputado en el camino quién había de ser el mayor.", "words": [[0, 270072], [5, 270216], [11, 270436], [21, 271583], [28, 271810], [32, 272030], [37, 272310], [41, 272570], [45, 272770], [51, 273090], [58, 273450], [68, 274270], [71, 274410], [74, 274530], [81, 274770], [87, 275150], [93, 275450], [96, 275650], [100, 275870], [103, 276010]]}, {"verse": 35, "start": 277066, "end": 287801, "text": "Entonces sentándose, llamó a los doce, y les dice: Si alguno quiere ser el primero, será el último de todos, y el servidor de todos.", "words": [[0, 277066], [9, 278111], [21, 279271], [27, 279751], [29, 279911], [33, 280091], [39, 280571], [41, 281071], [45, 281271], [51, 282166], [54, 282332], [61, 282812], [68, 283012], [72, 283352], [75, 283512], [84, 283932], [89, 284292], [92, 284552], [99, 284952], [102, 285192], [109, 285572], [111, 286252], [114, 286392], [123, 286952], [126, 287152]]}, {"verse": 36, "start": 288251, "end": 294282, "text": "Y tomando un niño, lo puso en medio de ellos; y tomándole en sus brazos, les dice:", "words": [[0, 288251], [2, 288349], [10, 288769], [13, 288969], [19, 289329], [22, 289869], [27, 290229], [30, 290369], [36, 290629], [39, 290909], [46, 291776], [48, 291884], [58, 292484], [61, 292624], [65, 292804], [73, 293304], [77, 293804]]}, {"verse": 37, "start": 294732, "end": 304574, "text": "El que reciba en mi nombre uno de los tales niños, a mí recibe; y quien me recibe a mí no me recibe a mí, sino al que me envió.", "words": [[0, 294732], [3, 294880], [7, 295020], [14, 295660], [17, 295780], [20, 295940], [27, 296320], [31, 296740], [34, 296900], [38, 297040], [44, 297280], [51, 298200], [53, 298620], [56, 298740], [64, 299841], [66, 299965], [72, 300185], [75, 300385], [82, 300885], [84, 300985], [87, 301545], [90, 301645], [93, 301785], [100, 302305], [102, 302385], [106, 302885], [111, 303125], [114, 303545], [118, 303725], [121, 303885]]}, {"verse": 38, "start": 305024, "end": 315201, "text": "Y le respondió Juan, diciendo: Maestro, hemos visto a uno que en tu nombre echaba fuera los demonios, el cual no nos sigue; y se lo prohibimos, porque no nos sigue.", "words": [[0, 305024], [2, 305145], [5, 305285], [15, 305985], [21, 306425], [31, 307961], [40, 308440], [46, 308520], [52, 308900], [54, 309080], [58, 309220], [62, 309440], [65, 309540], [68, 309660], [75, 309940], [82, 310360], [88, 310580], [92, 310840], [102, 311580], [105, 311680], [110, 311880], [113, 312080], [117, 312260], [124, 313025], [126, 313129], [129, 313209], [132, 313349], [144, 314009], [151, 314349], [154, 314569], [158, 314769]]}, {"verse": 39, "start": 315551, "end": 323747, "text": "Y Jesús dijo: No se lo prohibáis; porque ninguno hay que haga milagro en mi nombre que luego pueda decir mal de mí.", "words": [[0, 315551], [2, 315689], [8, 316049], [14, 316949], [17, 317118], [20, 317338], [23, 317518], [34, 318866], [41, 319070], [49, 319650], [53, 319890], [57, 320050], [62, 320290], [70, 320910], [73, 321010], [76, 321190], [83, 321530], [87, 321750], [93, 321990], [99, 322430], [105, 322830], [109, 323190], [112, 323410]]}, {"verse": 40, "start": 324197, "end": 327889, "text": "Porque el que no es contra nosotros, por nosotros es.", "words": [[0, 324197], [7, 324548], [10, 324728], [14, 324868], [17, 325048], [20, 325188], [27, 325508], [37, 326388], [41, 326728], [50, 327248]]}, {"verse": 41, "start": 328339, "end": 336914, "text": "Y cualquiera que os dé un vaso de agua en mi nombre, porque sois de Cristo, de cierto os digo que no perderá su recompensa.", "words": [[0, 328339], [2, 328484], [13, 329084], [17, 329304], [20, 329424], [23, 329564], [26, 329684], [31, 330084], [34, 330224], [39, 330464], [42, 330644], [45, 330804], [53, 331264], [60, 331504], [65, 331884], [68, 332004], [76, 332551], [79, 333097], [86, 333644], [89, 334104], [94, 334444], [98, 334924], [101, 335084], [109, 335624], [112, 335784]]}, {"verse": 42, "start": 337364, "end": 347643, "text": "Y cualquiera que haga caer a uno de estos pequeños que creen en mí, mejor le fuera si se le atase una piedra de molino al cuello, y fuera echado en el mar.", "words": [[0, 337364], [2, 337469], [13, 338069], [17, 338289], [22, 338529], [27, 338989], [29, 339069], [33, 339289], [36, 339529], [42, 339729], [51, 340349], [55, 340509], [61, 340909], [64, 341049], [68, 341689], [74, 342129], [77, 342349], [83, 342669], [86, 342909], [89, 343069], [92, 343339], [98, 343609], [102, 343769], [109, 344229], [112, 344349], [119, 344809], [122, 344969], [130, 345819], [132, 345927], [138, 346227], [145, 346907], [148, 347107], [151, 347227]]}, {"verse": 43, "start": 348093, "end": 358813, "text": "Y si tu mano te hace pecar, córtala: mejor te es entrar a la vida manco, que teniendo dos manos ir a la Gehenna, al fuego que no puede ser apagado;", "words": [[0, 348093], [2, 348196], [5, 348336], [8, 348516], [13, 348776], [16, 348996], [21, 349176], [28, 349816], [37, 350781], [43, 351130], [46, 351310], [49, 351490], [56, 351830], [58, 352010], [61, 352110], [66, 352310], [73, 353130], [77, 353330], [86, 353910], [90, 354290], [96, 354910], [99, 355350], [101, 355450], [104, 355780], [113, 356110], [116, 356630], [122, 356990], [126, 357250], [129, 357390], [135, 357630], [139, 357950]]}, {"verse": 44, "start": 359263, "end": 363068, "text": "Donde su gusano no muere, y el fuego nunca se apaga.", "words": [[0, 359263], [6, 359528], [9, 359848], [16, 360308], [19, 360528], [26, 360928], [28, 361168], [31, 361308], [37, 361588], [43, 362008], [46, 362428]]}, {"verse": 45, "start": 363518, "end": 375092, "text": "Y si tu pie te es ocasión de caer, córtalo: mejor te es entrar a la vida cojo, que teniendo dos pies ser echado en la Gehenna, al fuego que no puede ser apagado;", "words": [[0, 363518], [2, 363625], [5, 363745], [8, 363955], [12, 364165], [15, 364305], [18, 364445], [26, 364965], [29, 365105], [35, 365565], [44, 366551], [50, 366903], [53, 367123], [56, 367303], [63, 367643], [65, 367823], [68, 367923], [73, 368143], [79, 369123], [83, 369363], [92, 369943], [96, 370143], [101, 370543], [105, 370923], [112, 371403], [115, 371523], [118, 372133], [127, 372743], [130, 372963], [136, 373383], [140, 373643], [143, 373783], [149, 374023], [153, 374323]]}, {"verse": 46, "start": 375542, "end": 380774, "text": "Donde el gusano de ellos no muere, y el fuego nunca se apaga.", "words": [[0, 375542], [6, 375886], [9, 376206], [16, 376686], [19, 376906], [25, 377126], [28, 377386], [35, 377886], [37, 378346], [40, 378506], [46, 378926], [52, 379706], [55, 380106]]}, {"verse": 47, "start": 381224, "end": 392412, "text": "Y si tu ojo te es ocasión de caer, sácalo: mejor te es entrar al reino de Dios con un ojo, que teniendo dos ojos ser echado a la Gehenna;", "words": [[0, 381224], [2, 381524], [5, 381684], [8, 381904], [12, 382244], [15, 382424], [18, 382604], [26, 383144], [29, 383324], [35, 383904], [43, 384929], [49, 385412], [52, 385632], [55, 385852], [62, 386272], [65, 386592], [71, 387032], [74, 387192], [79, 387452], [83, 387732], [86, 387952], [91, 388652], [95, 388872], [104, 389432], [108, 389772], [113, 390172], [117, 390632], [124, 391352], [126, 391492], [129, 391988]]}, {"verse": 48, "start": 392862, "end": 398094, "text": "Donde el gusano de ellos no muere, y el fuego nunca se apaga.", "words": [[0, 392862], [6, 393206], [9, 393526], [16, 394006], [19, 394226], [25, 394446], [28, 394706], [35, 395206], [37, 395666], [40, 395826], [46, 396246], [52, 397026], [55, 397426]]}, {"verse": 49, "start": 398544, "end": 405581, "text": "Porque todos serán salados con fuego, y todo sacrificio será salado con sal.", "words": [[0, 398544], [7, 398768], [13, 399128], [19, 399668], [27, 400168], [31, 400368], [38, 400808], [40, 401528], [45, 401748], [56, 402528], [61, 402768], [68, 403268], [72, 403468]]}, {"verse": 50, "start": 406031, "end": 415865, "text": "Buena es la sal; pero si la sal pierde su sabor, ¿con qué la sazonaréis? Tened en vosotros mismos sal; y tened paz los unos con los otros.", "words": [[0, 406113], [6, 406233], [9, 406353], [12, 406513], [17, 407206], [22, 407206], [25, 407206], [28, 407206], [32, 407206], [39, 407590], [42, 407750], [49, 408470], [54, 408690], [58, 408990], [61, 409170], [73, 410550], [79, 411068], [82, 411188], [91, 411628], [98, 411888], [103, 412953], [105, 413134], [111, 413354], [115, 413734], [119, 414174], [124, 414554], [128, 414974], [132, 415174]]}]}