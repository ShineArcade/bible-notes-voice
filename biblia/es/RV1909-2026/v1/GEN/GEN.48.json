{"book": "GEN", "chapter": 48, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 212848, "verses": [{"verse": 1, "start": 300, "end": 10065, "text": "Y sucedió después de estas cosas el haberse dicho a José: He aquí tu padre está enfermo. Y él tomó consigo sus dos hijos Manasés y Efraín.", "words": [[0, 300], [2, 427], [10, 1007], [18, 1307], [21, 1507], [27, 1687], [33, 2207], [36, 2572], [44, 2972], [50, 3232], [52, 3412], [58, 4123], [61, 4203], [66, 4403], [69, 4603], [75, 4903], [80, 5223], [89, 6072], [91, 6249], [94, 6369], [99, 6709], [107, 7129], [111, 7409], [115, 7669], [121, 7989], [129, 8829], [131, 9269]]}, {"verse": 2, "start": 10415, "end": 19596, "text": "Y se hizo saber a Jacob, diciendo: He aquí tu hijo José viene a ti. Entonces se esforzó Israel, y se sentó sobre la cama;", "words": [[0, 10415], [2, 10734], [5, 10914], [10, 11194], [16, 11554], [18, 11714], [25, 12094], [35, 13452], [38, 13532], [43, 13712], [46, 13932], [51, 14132], [56, 14432], [62, 14792], [64, 14952], [68, 15493], [77, 16023], [80, 16503], [88, 17183], [96, 17683], [98, 18008], [101, 18148], [107, 18608], [113, 18828], [116, 19048]]}, {"verse": 3, "start": 19946, "end": 25840, "text": "Y dijo a José: El Dios Omnipotente me apareció en Luz en la tierra de Canaán, y me bendijo,", "words": [[0, 19946], [2, 20238], [7, 20498], [9, 20698], [15, 21388], [18, 21547], [23, 21867], [35, 22587], [38, 22727], [47, 23227], [50, 23307], [54, 23447], [57, 23607], [60, 23707], [67, 23967], [70, 24127], [78, 24607], [80, 25047], [83, 25167]]}, {"verse": 4, "start": 26190, "end": 36039, "text": "Y me dijo: He aquí, yo te haré crecer, y te multiplicaré, y te pondré por estirpe de pueblos: y daré esta tierra a tu descendencia después de ti por heredad perpetua.", "words": [[0, 26190], [2, 26292], [5, 26392], [11, 27068], [14, 27197], [20, 27637], [23, 27717], [26, 27857], [31, 28077], [39, 28557], [41, 28677], [44, 28777], [58, 29577], [60, 29977], [63, 30117], [70, 30477], [74, 30637], [82, 31097], [85, 31217], [94, 32085], [96, 32185], [101, 32465], [106, 32665], [113, 33005], [115, 33205], [118, 33305], [131, 34025], [139, 34285], [142, 34525], [145, 34705], [149, 34965], [157, 35345]]}, {"verse": 5, "start": 36389, "end": 47794, "text": "Y ahora tus dos hijos Efraín y Manasés, que te nacieron en la tierra de Egipto, antes que viniese a ti a la tierra de Egipto, míos son; como Rubén y Simeón, serán míos:", "words": [[0, 36389], [2, 36509], [8, 36729], [12, 36949], [16, 37169], [22, 37449], [29, 38029], [31, 38499], [40, 38969], [44, 39169], [47, 39289], [56, 39729], [59, 39889], [62, 39989], [69, 40209], [72, 40449], [80, 41269], [86, 41549], [90, 41749], [98, 42169], [100, 42349], [103, 42489], [105, 42749], [108, 42829], [115, 43069], [118, 43269], [126, 43739], [131, 44209], [136, 44834], [141, 44979], [147, 45399], [149, 45519], [157, 45999], [163, 46499]]}, {"verse": 6, "start": 48144, "end": 54585, "text": "Y los que después de ellos has engendrado, serán tuyos; por el nombre de sus hermanos serán llamados en sus heredades.", "words": [[0, 48144], [2, 48244], [6, 48364], [10, 48524], [18, 48824], [21, 49004], [27, 49364], [31, 49724], [43, 50084], [49, 50504], [56, 51349], [60, 51467], [63, 51587], [70, 51867], [73, 52047], [77, 52187], [86, 52727], [92, 53027], [101, 53467], [104, 53627], [108, 53827]]}, {"verse": 7, "start": 54935, "end": 66116, "text": "Porque cuando yo venía de Padan-aram, se me murió Raquel en la tierra de Canaán, en el camino, como media legua de tierra viniendo a Efrata; y la sepulté allí en el camino de Efrata, que es Belén.", "words": [[0, 54935], [7, 55108], [14, 55388], [17, 55588], [23, 55928], [26, 56068], [38, 56768], [41, 57248], [44, 57408], [50, 57708], [57, 58088], [60, 58228], [63, 58308], [70, 58568], [73, 58988], [81, 59408], [84, 59468], [87, 59588], [95, 60448], [100, 60648], [106, 60948], [112, 61348], [115, 61448], [122, 61728], [131, 62268], [133, 62348], [141, 63072], [143, 63157], [146, 63257], [154, 63777], [159, 63997], [162, 64137], [165, 64257], [172, 64517], [175, 64757], [183, 65517], [187, 65557], [190, 65697]]}, {"verse": 8, "start": 66396, "end": 71001, "text": "Y vio Israel los hijos de José, y dijo: ¿Quiénes son estos?", "words": [[0, 66396], [2, 66542], [6, 66802], [13, 67302], [17, 67602], [23, 67922], [26, 68182], [32, 68522], [34, 68862], [40, 70125], [49, 70423], [53, 70720]]}, {"verse": 9, "start": 71281, "end": 79817, "text": "Y respondió José a su padre: Son mis hijos, que Dios me ha dado aquí. Y él dijo: Acércalos ahora a mí, y los bendeciré.", "words": [[0, 71281], [2, 71408], [12, 72048], [17, 72408], [19, 72688], [22, 72808], [29, 73679], [33, 73860], [37, 74040], [44, 74280], [48, 74540], [53, 74740], [56, 75000], [59, 75100], [64, 75280], [70, 75994], [72, 76182], [75, 76342], [81, 77061], [91, 77726], [97, 77946], [99, 78166], [103, 78286], [105, 78806], [109, 78966]]}, {"verse": 10, "start": 80097, "end": 88718, "text": "Y los ojos de Israel estaban tan agravados de la vejez, que no podía ver. Les hizo, pues, llegar a él, y él los besó y abrazó.", "words": [[0, 80097], [2, 80215], [6, 80355], [11, 80655], [14, 80875], [21, 81315], [29, 81715], [33, 82035], [43, 82715], [46, 82942], [49, 83168], [56, 83395], [60, 83755], [63, 83915], [69, 84255], [74, 84861], [78, 85003], [84, 85263], [90, 85623], [97, 86103], [99, 86343], [103, 86823], [105, 87203], [108, 87363], [112, 87503], [117, 87975], [119, 88088]]}, {"verse": 11, "start": 89068, "end": 95614, "text": "Y dijo Israel a José: No pensaba yo ver tu rostro, y he aquí Dios me ha hecho ver también tu descendencia.", "words": [[0, 89068], [2, 89190], [7, 89450], [14, 90050], [16, 90350], [22, 91026], [25, 91169], [33, 91589], [36, 91789], [40, 91929], [43, 92049], [51, 92569], [53, 92779], [56, 92989], [61, 93149], [66, 93589], [69, 93829], [72, 93929], [78, 94129], [82, 94309], [90, 94589], [93, 94789]]}, {"verse": 12, "start": 95894, "end": 100701, "text": "Entonces José los sacó de entre sus rodillas, y se inclinó a tierra.", "words": [[0, 95894], [9, 96437], [14, 96797], [18, 97157], [23, 97657], [26, 97757], [32, 98037], [36, 98297], [46, 98877], [48, 99192], [51, 99352], [59, 100012], [61, 100112]]}, {"verse": 13, "start": 101051, "end": 112855, "text": "Y los tomó José a ambos, Efraín a su derecha, a la izquierda de Israel; y a Manasés a su izquierda, a la derecha de Israel; y los acercó a él.", "words": [[0, 101051], [2, 101156], [6, 101276], [11, 101616], [16, 101936], [18, 102256], [25, 103196], [32, 103836], [34, 103956], [37, 104116], [46, 105076], [48, 105136], [51, 105236], [61, 105876], [64, 106016], [72, 106993], [74, 107299], [76, 107645], [84, 107992], [86, 108252], [89, 108472], [100, 109492], [102, 109752], [105, 109852], [113, 110312], [116, 110452], [124, 111407], [126, 111520], [130, 111660], [137, 112240], [139, 112420]]}, {"verse": 14, "start": 113205, "end": 128657, "text": "Entonces Israel extendió su diestra, y la puso sobre la cabeza de Efraín, que era el menor, y su siniestra sobre la cabeza de Manasés, colocando así sus manos adrede, aunque Manasés era el primogénito.", "words": [[0, 113205], [9, 113749], [16, 114529], [25, 115469], [28, 115649], [37, 116209], [39, 116829], [42, 116949], [47, 117309], [53, 117609], [56, 117789], [63, 118189], [66, 118469], [74, 119409], [78, 119589], [82, 119769], [85, 119929], [92, 120624], [94, 120724], [97, 120864], [107, 121704], [113, 122024], [116, 122224], [123, 122624], [126, 122864], [135, 123804], [145, 124504], [149, 124724], [153, 125004], [159, 125646], [167, 126452], [174, 126698], [182, 127318], [186, 127783], [189, 128248]]}, {"verse": 15, "start": 129007, "end": 138434, "text": "Y bendijo a José, y dijo: El Dios en cuya presencia anduvieron mis padres Abraham e Isaac, el Dios que me mantiene desde que yo soy hasta este día,", "words": [[0, 129007], [2, 129113], [10, 129553], [12, 129653], [18, 130033], [20, 130453], [26, 131245], [29, 131315], [34, 131515], [37, 131755], [42, 132015], [52, 132555], [63, 133095], [67, 133255], [74, 133615], [82, 134235], [84, 134715], [91, 135595], [94, 135675], [99, 135895], [103, 136075], [106, 136175], [115, 136675], [121, 136875], [125, 137095], [128, 137275], [132, 137475], [138, 137715], [143, 137975]]}, {"verse": 16, "start": 138784, "end": 150222, "text": "El Ángel que me libra de todo mal, bendiga a estos jóvenes: y mi nombre sea llamado en ellos, y el nombre de mis padres Abraham e Isaac: y multipliquen en gran manera en medio de la tierra.", "words": [[0, 138784], [3, 138925], [9, 139325], [13, 139445], [16, 139585], [22, 139885], [25, 140005], [30, 140205], [35, 140545], [43, 141185], [45, 141265], [51, 141465], [60, 142513], [62, 142619], [65, 142699], [72, 143039], [76, 143379], [84, 143659], [87, 143879], [94, 144179], [96, 144699], [99, 144799], [106, 145099], [109, 145299], [113, 145439], [120, 145799], [128, 146439], [130, 146879], [137, 147705], [139, 147805], [152, 148385], [155, 148505], [160, 148645], [167, 149045], [170, 149245], [176, 149465], [179, 149625], [182, 149745]]}, {"verse": 17, "start": 150502, "end": 165352, "text": "Entonces viendo José que su padre ponía la mano derecha sobre la cabeza de Efraín, le causó esto disgusto; y tomó la mano de su padre, para cambiarla de sobre la cabeza de Efraín a la cabeza de Manasés.", "words": [[0, 150502], [9, 151542], [16, 151862], [21, 152262], [25, 152462], [28, 152622], [34, 153002], [40, 153462], [43, 153582], [48, 153802], [56, 154282], [62, 154562], [65, 154762], [72, 155162], [75, 155422], [83, 156402], [86, 156502], [92, 157142], [97, 157522], [107, 158917], [109, 159061], [114, 159421], [117, 159561], [122, 159801], [125, 159981], [128, 160141], [135, 160601], [140, 160896], [150, 161616], [153, 161776], [159, 162116], [162, 162336], [169, 162756], [172, 162976], [179, 163676], [181, 163916], [184, 163996], [191, 164376], [194, 164899]]}, {"verse": 18, "start": 165702, "end": 172879, "text": "Y dijo José a su padre: No así, padre mío, porque este es el primogénito; pon tu diestra sobre su cabeza.", "words": [[0, 165702], [2, 165807], [7, 166067], [12, 166387], [14, 166567], [17, 166647], [24, 167450], [27, 167628], [32, 168048], [38, 168308], [43, 168968], [50, 169188], [55, 169548], [58, 169788], [61, 169908], [74, 171048], [78, 171188], [81, 171368], [89, 171748], [95, 172028], [98, 172208]]}, {"verse": 19, "start": 173159, "end": 186027, "text": "Mas su padre no quiso, y dijo: Lo sé, hijo mío, lo sé: también él vendrá a ser un pueblo, y será también acrecentado; pero su hermano menor será más grande que él, y su descendencia formará multitud de naciones.", "words": [[0, 173159], [4, 173326], [7, 173446], [13, 173746], [16, 174006], [23, 174486], [25, 175006], [31, 175741], [34, 175866], [38, 176066], [43, 176266], [48, 176726], [51, 176846], [55, 177427], [63, 177771], [66, 177951], [73, 178331], [75, 178431], [79, 178591], [82, 178711], [90, 179051], [92, 179551], [97, 179771], [105, 180401], [118, 181197], [123, 181337], [126, 181477], [134, 181837], [140, 182057], [145, 182317], [149, 182517], [156, 182837], [160, 183037], [164, 183257], [166, 183557], [169, 183697], [182, 184437], [190, 184837], [199, 185337], [202, 185457]]}, {"verse": 20, "start": 186307, "end": 197160, "text": "Y los bendijo aquel día, diciendo: En ti bendecirá Israel, diciendo: Que Dios te ponga como a Efraín y como a Manasés. Y puso a Efraín delante de Manasés.", "words": [[0, 186307], [2, 186431], [6, 186531], [14, 187051], [20, 187431], [25, 187651], [35, 188773], [38, 188955], [41, 189115], [51, 189695], [59, 190115], [69, 191051], [73, 191135], [78, 191315], [81, 191535], [87, 191935], [92, 192135], [94, 192275], [101, 192755], [103, 192955], [108, 193135], [110, 193315], [119, 194258], [121, 194384], [126, 194784], [128, 194884], [135, 195344], [143, 195824], [146, 195984]]}, {"verse": 21, "start": 197510, "end": 205093, "text": "Y dijo Israel a José: He aquí, yo muero, pero Dios será con vosotros, y os hará volver a la tierra de vuestros padres.", "words": [[0, 197510], [2, 197632], [7, 197892], [14, 198492], [16, 198792], [22, 199468], [25, 199630], [31, 199870], [34, 200070], [41, 200590], [46, 200730], [51, 201030], [56, 201410], [60, 201690], [70, 202710], [72, 202770], [75, 202930], [80, 203170], [87, 203370], [89, 203570], [92, 203650], [99, 203930], [102, 204130], [111, 204430]]}, {"verse": 22, "start": 205443, "end": 212448, "text": "Y yo te he dado a ti una parte sobre tus hermanos, la cual tomé yo de mano del amorreo con mi espada y con mi arco.", "words": [[0, 205443], [2, 205560], [5, 205780], [8, 205940], [11, 206080], [16, 206320], [18, 206440], [21, 206600], [25, 206780], [31, 207120], [37, 207420], [41, 207640], [51, 208740], [54, 208820], [59, 209060], [64, 209440], [67, 209640], [70, 209800], [75, 210040], [79, 210400], [87, 210760], [91, 210960], [94, 211140], [101, 211560], [103, 211720], [107, 211880], [110, 212060]]}]}