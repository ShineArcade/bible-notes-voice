{"book": "1CO", "chapter": 8, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 96237, "verses": [{"verse": 1, "start": 300, "end": 8454, "text": "Y por lo que hace a lo sacrificado a los ídolos, sabemos que todos tenemos conocimiento. El conocimiento envanece, pero el amor edifica.", "words": [[0, 300], [2, 425], [6, 625], [9, 805], [13, 965], [18, 1225], [20, 1385], [23, 1445], [35, 2125], [37, 2245], [41, 2365], [49, 3165], [57, 3565], [61, 3865], [67, 4105], [75, 4505], [89, 5735], [92, 5839], [105, 6479], [115, 7119], [120, 7419], [123, 7559], [128, 7759]]}, {"verse": 2, "start": 8804, "end": 13188, "text": "Y si alguno se imagina que sabe algo, aún no sabe nada como debe saber.", "words": [[0, 8804], [2, 8893], [5, 9013], [12, 9433], [15, 9533], [23, 10033], [27, 10133], [32, 10393], [38, 11033], [42, 11413], [45, 11633], [50, 11873], [55, 12153], [60, 12433], [65, 12653]]}, {"verse": 3, "start": 13538, "end": 16435, "text": "Pero si alguno ama a Dios, el tal es conocido de él.", "words": [[0, 13538], [5, 13697], [8, 13877], [15, 14297], [19, 14437], [21, 14597], [27, 15077], [30, 15197], [34, 15377], [37, 15517], [46, 16017], [49, 16177]]}, {"verse": 4, "start": 16785, "end": 24171, "text": "Acerca, pues, de los alimentos sacrificados a los ídolos, sabemos que el ídolo nada es en el mundo, y que no hay más de un Dios.", "words": [[0, 16785], [8, 17201], [14, 17921], [17, 18001], [21, 18121], [31, 18461], [44, 19381], [46, 19561], [50, 19681], [58, 20421], [66, 20761], [70, 21061], [73, 21181], [79, 21461], [84, 21701], [87, 22001], [90, 22121], [93, 22261], [100, 22601], [102, 23001], [106, 23121], [109, 23301], [113, 23381], [117, 23561], [120, 23721], [123, 23821]]}, {"verse": 5, "start": 24521, "end": 31117, "text": "Porque aunque haya algunos que se llamen dioses, o en el cielo, o en la tierra (como hay muchos dioses y muchos señores),", "words": [[0, 24521], [7, 24732], [14, 24912], [19, 25212], [27, 25572], [31, 25812], [34, 26022], [41, 26232], [49, 26772], [51, 27172], [54, 27292], [57, 27412], [64, 27772], [66, 28052], [69, 28152], [72, 28252], [79, 28765], [85, 28907], [89, 29047], [96, 29267], [103, 29847], [105, 30107], [112, 30347]]}, {"verse": 6, "start": 31467, "end": 42421, "text": "Pero nosotros no tenemos más de un Dios, el Padre, del cual son todas las cosas, y nosotros en él: y un Señor Jesucristo, por el cual son todas las cosas, y nosotros por él.", "words": [[0, 31467], [5, 31604], [14, 31904], [17, 32224], [25, 32524], [29, 32864], [32, 33044], [35, 33224], [41, 33984], [44, 34124], [51, 34864], [55, 35024], [60, 35224], [64, 35484], [70, 35684], [74, 35964], [81, 36324], [83, 36884], [92, 37204], [95, 37584], [99, 38074], [101, 38232], [104, 38352], [110, 38632], [122, 39612], [126, 39712], [129, 39832], [134, 39972], [138, 40232], [144, 40492], [148, 40772], [155, 41152], [157, 41472], [166, 41732], [170, 42172]]}, {"verse": 7, "start": 42771, "end": 53535, "text": "Pero no en todos hay este conocimiento: porque algunos con conciencia del ídolo hasta aquí, comen como sacrificado a ídolos; y su conciencia, siendo débil, es contaminada.", "words": [[0, 42771], [5, 42916], [8, 43096], [11, 43256], [17, 43436], [21, 43776], [26, 44016], [40, 46090], [47, 46270], [55, 46570], [59, 46850], [70, 47410], [74, 47610], [80, 47870], [86, 48090], [92, 48390], [98, 48870], [103, 49130], [115, 49890], [117, 50010], [125, 50782], [127, 50883], [130, 50983], [142, 51823], [149, 52043], [156, 52643], [159, 52743]]}, {"verse": 8, "start": 53885, "end": 61298, "text": "Si bien el alimento no nos hace más aceptos a Dios: porque ni que comamos, seremos mejores; ni que no comamos, seremos peores.", "words": [[0, 53885], [3, 54060], [8, 54270], [11, 54390], [20, 54690], [23, 54890], [27, 55070], [32, 55390], [36, 55750], [44, 56070], [46, 56390], [52, 56874], [59, 57080], [62, 57300], [66, 57420], [75, 57900], [83, 58320], [92, 59140], [95, 59299], [99, 59439], [102, 59619], [111, 60119], [119, 60559]]}, {"verse": 9, "start": 61648, "end": 66105, "text": "Pero mirad que esta vuestra libertad no sea ocasión de tropiezo a los que son débiles.", "words": [[0, 61648], [5, 61795], [11, 62195], [15, 62335], [20, 62535], [28, 62935], [37, 63475], [40, 63615], [44, 63815], [52, 64335], [55, 64435], [64, 64955], [66, 65075], [70, 65195], [74, 65335], [78, 65535]]}, {"verse": 10, "start": 66455, "end": 77640, "text": "Porque si te ve alguno, a ti que tienes conocimiento, que estás sentado a la mesa en el lugar de los ídolos, ¿la conciencia de aquel que es débil, no será animada a comer de lo sacrificado a los ídolos?", "words": [[0, 66455], [7, 66633], [10, 66793], [13, 66953], [16, 67073], [24, 67813], [26, 67853], [29, 67973], [33, 68093], [40, 68353], [54, 69373], [58, 69543], [64, 69713], [72, 70233], [74, 70353], [77, 70433], [82, 70733], [85, 70913], [88, 71033], [94, 71273], [97, 71433], [101, 71573], [109, 72453], [113, 72593], [124, 73193], [127, 73353], [133, 73713], [137, 73853], [140, 74013], [147, 74662], [150, 74765], [155, 74965], [163, 75505], [165, 75645], [171, 75885], [174, 76105], [177, 76205], [189, 76865], [191, 76965], [195, 77085]]}, {"verse": 11, "start": 77990, "end": 81946, "text": "Y por tu conocimiento se perderá el hermano débil por el cual Cristo murió.", "words": [[0, 77990], [2, 78096], [6, 78216], [9, 78316], [22, 79016], [25, 79156], [33, 79656], [36, 79736], [44, 80136], [50, 80436], [54, 80656], [57, 80776], [62, 80936], [69, 81356]]}, {"verse": 12, "start": 82296, "end": 88898, "text": "De esta manera, pues, pecando contra los hermanos, e hiriendo su débil conciencia, contra Cristo pecáis.", "words": [[0, 82296], [3, 82413], [8, 82633], [16, 82973], [22, 83333], [30, 83898], [37, 84218], [41, 84398], [51, 85338], [53, 85618], [62, 85898], [65, 86118], [71, 86378], [83, 87178], [90, 87758], [97, 88358]]}, {"verse": 13, "start": 89248, "end": 95837, "text": "Por lo cual, si la comida puede hacer pecar a mi hermano, j