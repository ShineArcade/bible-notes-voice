{"book": "MRK", "chapter": 8, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 279982, "verses": [{"verse": 1, "start": 300, "end": 7715, "text": "In those days the multitude being very great, and having nothing to eat, Jesus called his disciples to him, and says to them,", "words": [[0, 300], [3, 426], [9, 646], [14, 966], [18, 1186], [28, 1546], [34, 1966], [39, 2306], [46, 2726], [50, 3226], [57, 3446], [65, 3746], [68, 4006], [73, 4546], [79, 4766], [86, 5186], [90, 5406], [100, 5906], [103, 6206], [108, 6426], [112, 6826], [117, 7086], [120, 7326]]}, {"verse": 2, "start": 7965, "end": 13008, "text": "I have compassion on the multitude, because they have now been with me three days, and have nothing to eat:", "words": [[0, 7965], [2, 8152], [7, 8311], [18, 8832], [21, 9051], [25, 9151], [36, 9612], [44, 10052], [49, 10311], [54, 10412], [58, 10592], [63, 10832], [68, 10992], [71, 11172], [77, 11412], [83, 11712], [87, 12052], [92, 12192], [100, 12452], [103, 12651]]}, {"verse": 3, "start": 13458, "end": 19925, "text": "And if I send them away fasting to their own houses, they will faint by the way: for some of them have come from afar.", "words": [[0, 13458], [4, 13580], [7, 13720], [9, 13840], [14, 14120], [19, 14260], [24, 14480], [32, 14940], [35, 15180], [41, 15340], [45, 15500], [53, 16460], [58, 16560], [63, 16720], [69, 17020], [72, 17320], [76, 17440], [81, 18078], [85, 18155], [90, 18395], [93, 18535], [98, 18695], [103, 18835], [108, 19115], [113, 19315]]}, {"verse": 4, "start": 20275, "end": 26151, "text": "And his disciples answered him, From from where can a man satisfy these men with bread here in the wilderness?", "words": [[0, 20275], [4, 20403], [8, 20523], [18, 20983], [27, 21423], [32, 22036], [37, 22036], [42, 22287], [48, 23027], [52, 23227], [54, 23327], [58, 23507], [66, 24067], [72, 24427], [76, 24667], [81, 24847], [87, 25107], [92, 25367], [95, 25487], [99, 25587]]}, {"verse": 5, "start": 26501, "end": 31136, "text": "And he asked them, How many loaves have you? And they said, Seven.", "words": [[0, 26501], [4, 26624], [7, 26744], [13, 27044], [19, 27692], [23, 27854], [28, 28074], [35, 28674], [40, 28874], [45, 29623], [49, 29772], [54, 29892], [60, 30909]]}, {"verse": 6, "start": 31486, "end": 42711, "text": "And he commanded the people to sit down on the ground: and he took the seven loaves, and gave thanks, and broke, and gave to his disciples to set before them; and they did set them before the people.", "words": [[0, 31486], [4, 31625], [7, 31745], [17, 32245], [21, 32445], [28, 32725], [31, 32945], [35, 33165], [40, 33465], [43, 33645], [47, 33765], [55, 34623], [59, 34732], [62, 34832], [67, 35052], [71, 35252], [77, 35552], [85, 36132], [89, 36292], [94, 36512], [102, 36932], [106, 37232], [113, 38052], [117, 38132], [122, 38392], [125, 38572], [129, 38732], [139, 39272], [142, 39552], [146, 39792], [153, 40092], [159, 40797], [163, 40937], [168, 41057], [172, 41317], [176, 41597], [181, 41777], [188, 42017], [192, 42237]]}, {"verse": 7, "start": 43161, "end": 48198, "text": "And they had a few small fishes: and he blessed, and commanded to set them also before them.", "words": [[0, 43161], [4, 43267], [9, 43367], [13, 43527], [15, 43647], [19, 43767], [25, 44107], [33, 45046], [37, 45170], [40, 45310], [49, 45770], [53, 46090], [63, 46550], [66, 46790], [70, 46990], [75, 47170], [80, 47410], [87, 47730]]}, {"verse": 8, "start": 48648, "end": 54495, "text": "So they did eat, and were filled: and they took up of the broken food that was left seven baskets.", "words": [[0, 48648], [3, 48793], [8, 48973], [12, 49233], [17, 49573], [21, 49953], [26, 50113], [34, 50939], [38, 51095], [43, 51195], [48, 51415], [51, 51635], [54, 51795], [58, 51935], [65, 52255], [70, 52675], [75, 52855], [79, 53015], [84, 53275], [90, 53675]]}, {"verse": 9, "start": 54945, "end": 58961, "text": "And they that had eaten were about four thousand: and he sent them away.", "words": [[0, 54945], [4, 55111], [9, 55291], [14, 55531], [18, 55671], [24, 55931], [29, 56251], [35, 56688], [40, 57126], [50, 57803], [54, 57944], [57, 58044], [62, 58264], [67, 58444]]}, {"verse": 10, "start": 59411, "end": 65087, "text": "¶ And immediately he entered into a ship with his disciples, and came into the parts of Dalmanutha.", "words": [[2, 59411], [6, 59550], [18, 59950], [21, 60430], [29, 60750], [34, 61030], [36, 61210], [41, 61450], [46, 61710], [50, 61810], [61, 62410], [65, 63030], [70, 63310], [75, 63510], [79, 63670], [85, 64010], [88, 64170]]}, {"verse": 11, "start": 65537, "end": 72148, "text": "And the Pharisees came forth, and began to question with him, seeking of him a sign from heaven, tempting him.", "words": [[0, 65537], [4, 65677], [8, 65797], [18, 66477], [23, 66697], [30, 67157], [34, 67657], [40, 67957], [43, 68137], [52, 68517], [57, 68837], [62, 69197], [70, 69417], [73, 69697], [77, 69837], [79, 70037], [84, 70317], [89, 70537], [97, 71117], [106, 71417]]}, {"verse": 12, "start": 72598, "end": 83170, "text": "And he sighed deeply in his spirit, and says, Why does this generation seek after a sign? indeed I say to you, There shall no sign be given to this generation.", "words": [[0, 72598], [4, 72978], [7, 73138], [14, 73618], [21, 73918], [24, 74158], [28, 74298], [36, 74758], [40, 75158], [46, 75976], [50, 76215], [55, 76395], [60, 76595], [71, 77155], [76, 77555], [82, 77955], [84, 78155], [90, 79056], [97, 79300], [99, 79600], [103, 79820], [106, 80020], [111, 80540], [117, 80780], [123, 81000], [126, 81240], [131, 81620], [134, 81840], [140, 82100], [143, 82320], [148, 82460]]}, {"verse": 13, "start": 83520, "end": 87936, "text": "And he left them, and entering into the ship again departed to the other side.", "words": [[0, 83520], [4, 83653], [7, 83773], [12, 84033], [18, 84713], [22, 84873], [31, 85213], [36, 85473], [40, 85653], [45, 85873], [51, 86273], [60, 86753], [63, 87033], [67, 87193], [73, 87353]]}, {"verse": 14, "start": 88386, "end": 93475, "text": "¶ Now the disciples had forgotten to take bread, neither had they in the ship with them more than one loaf.", "words": [[2, 88386], [6, 88563], [10, 88723], [20, 89143], [24, 89383], [34, 89743], [37, 90023], [42, 90223], [49, 90923], [57, 91103], [61, 91403], [66, 91563], [69, 91703], [73, 91823], [78, 92023], [83, 92223], [88, 92383], [93, 92623], [98, 92823], [102, 93023]]}, {"verse": 15, "start": 93925, "end": 100719, "text": "And he charged them, saying, Take heed, beware of the leaven of the Pharisees, and of the leaven of Herod.", "words": [[0, 93925], [4, 94245], [7, 94365], [15, 94685], [21, 94925], [29, 96293], [34, 96450], [40, 96870], [47, 97250], [50, 97450], [54, 97570], [61, 97890], [64, 98030], [68, 98150], [79, 98990], [83, 99370], [86, 99490], [90, 99610], [97, 99970], [100, 100090]]}, {"verse": 16, "start": 101069, "end": 105529, "text": "And they reasoned among themselves, saying, It is because we have no bread.", "words": [[0, 101069], [4, 101210], [9, 101350], [18, 101870], [24, 102010], [36, 102950], [44, 103745], [47, 103849], [50, 103969], [58, 104249], [61, 104549], [66, 104789], [69, 105029]]}, {"verse": 17, "start": 105879, "end": 115588, "text": "And when Jesus knew it, he says to them, Why do you reason, because you have no bread? do you not perceive yet, neither understand? have you your heart yet hardened?", "words": [[0, 105879], [4, 106012], [9, 106192], [15, 106572], [20, 106952], [24, 107372], [27, 107512], [32, 107752], [35, 107992], [41, 108685], [45, 108845], [48, 108985], [52, 109065], [60, 109685], [68, 109925], [72, 110165], [77, 110365], [80, 110505], [87, 111296], [90, 111380], [94, 111500], [98, 111580], [107, 111980], [112, 112600], [120, 112840], [132, 114090], [137, 114272], [141, 114412], [146, 114572], [152, 114832], [156, 114972]]}, {"verse": 18, "start": 116038, "end": 121324, "text": "Having eyes, do you not see? and having ears, do you not hear? and do you not remember?", "words": [[0, 116038], [7, 116204], [13, 116664], [16, 116664], [20, 116784], [24, 116904], [29, 117735], [33, 117894], [40, 118154], [46, 118554], [49, 118834], [53, 118974], [57, 119154], [63, 120000], [67, 120144], [70, 120304], [74, 120404], [78, 120584]]}, {"verse": 19, "start": 121774, "end": 132009, "text": "When I broke the five loaves among five thousand, how many baskets full of fragments took you up? They say to him, Twelve.", "words": [[0, 121774], [5, 121879], [7, 121999], [13, 122199], [17, 122399], [22, 122659], [29, 123159], [35, 123606], [40, 124052], [50, 124499], [54, 124739], [59, 124899], [67, 125379], [72, 125679], [75, 125799], [85, 126199], [90, 126539], [94, 126719], [96, 128707], [98, 130249], [103, 130378], [107, 130618], [110, 130818], [115, 131777]]}, {"verse": 20, "start": 132309, "end": 142707, "text": "And when the seven among four thousand, how many baskets full of fragments took you up? And they said, Seven.", "words": [[0, 132309], [4, 132627], [9, 132867], [13, 133077], [19, 133287], [25, 133814], [30, 134340], [40, 134867], [44, 135047], [49, 135247], [57, 135747], [62, 136047], [65, 136187], [75, 136607], [80, 136927], [84, 137107], [86, 139027], [88, 140568], [92, 140694], [97, 140854], [103, 142479]]}, {"verse": 21, "start": 143057, "end": 146742, "text": "And he said to them, How is it that you do not understand?", "words": [[0, 143057], [4, 143187], [7, 143307], [12, 143547], [15, 143747], [21, 144343], [25, 144602], [28, 144942], [31, 145082], [36, 145282], [40, 145462], [43, 145622], [47, 145822]]}, {"verse": 22, "start": 147092, "end": 153441, "text": "¶ And he comes to Bethsaida; and they bring a blind man to him, and besought him to touch him.", "words": [[2, 147092], [6, 147228], [9, 147328], [15, 147588], [18, 148707], [29, 150062], [33, 150188], [38, 150288], [44, 150528], [46, 150648], [52, 150968], [56, 151328], [59, 151568], [64, 151788], [68, 152108], [77, 152508], [81, 152688], [84, 152848], [90, 153148]]}, {"verse": 23, "start": 153891, "end": 163276, "text": "And he took the blind man by the hand, and led him out of the town; and when he had spit on his eyes, and put his hands upon him, he asked him if he saw anything.", "words": [[0, 153891], [4, 154018], [7, 154098], [12, 154258], [16, 154418], [22, 154698], [26, 154938], [29, 155178], [33, 155318], [39, 155678], [43, 155958], [47, 156158], [51, 156358], [55, 156598], [58, 156718], [62, 156818], [68, 157620], [72, 157764], [77, 157924], [80, 158124], [84, 158324], [89, 158564], [92, 158784], [96, 158984], [102, 159344], [106, 159904], [110, 160104], [114, 160284], [120, 160564], [125, 160844], [130, 161504], [133, 161584], [139, 161884], [143, 162084], [146, 162224], [149, 162344], [153, 162584]]}, {"verse": 24, "start": 163726, "end": 167280, "text": "And he looked up, and said, I see men as trees, walking.", "words": [[0, 163726], [4, 163870], [7, 163970], [14, 164170], [18, 164470], [22, 164710], [28, 165422], [30, 165522], [34, 165702], [38, 165982], [41, 166182], [48, 166462]]}, {"verse": 25, "start": 167630, "end": 174781, "text": "After that he put his hands again upon his eyes, and made him look up: and he was restored, and saw every man clearly.", "words": [[0, 167630], [6, 167892], [11, 168272], [14, 168372], [18, 168552], [22, 168732], [28, 169032], [34, 169292], [39, 169552], [43, 169812], [49, 170112], [53, 170352], [58, 170552], [62, 170712], [67, 170892], [71, 171626], [75, 171938], [78, 172058], [82, 172238], [92, 172718], [96, 173258], [100, 173518], [106, 173838], [110, 174098]]}, {"verse": 26, "start": 175231, "end": 181553, "text": "And he sent him away to his house, saying, Neither go into the town, nor tell it to any in the town.", "words": [[0, 175231], [4, 175531], [7, 175671], [12, 175911], [16, 176091], [21, 176291], [24, 176491], [28, 176631], [35, 177211], [43, 177987], [51, 178263], [54, 178563], [59, 178763], [63, 178923], [69, 179343], [73, 179803], [78, 180123], [81, 180303], [84, 180443], [88, 180723], [91, 180923], [95, 181023]]}, {"verse": 27, "start": 181903, "end": 191989, "text": "¶ And Jesus went out, and his disciples, into the towns of Cæsarea Philippi: and by the way he asked his disciples, saying to them, Whom do men say that I am?", "words": [[2, 181903], [6, 182056], [12, 182376], [17, 182736], [22, 183036], [26, 183436], [30, 183596], [41, 184176], [46, 184856], [50, 185016], [56, 185356], [59, 185756], [67, 186156], [77, 187142], [81, 187268], [84, 187448], [88, 187568], [92, 187728], [95, 187928], [101, 188228], [105, 188408], [116, 189208], [123, 189428], [126, 189648], [132, 190185], [137, 190499], [140, 190619], [144, 190859], [148, 191179], [153, 191379], [155, 191599]]}, {"verse": 28, "start": 192339, "end": 198326, "text": "And they answered, John the Baptist: but some say, Elias; and others, One of the prophets.", "words": [[0, 192339], [4, 192481], [9, 192641], [19, 193532], [24, 193729], [28, 193869], [37, 194779], [41, 194939], [46, 195219], [51, 195479], [58, 196469], [62, 196599], [70, 197239], [74, 197459], [77, 197599], [81, 197699]]}, {"verse": 29, "start": 198676, "end": 207957, "text": "And he says to them, But whom say you that I am? And Peter answers and says to him, You are the Christ.", "words": [[0, 198676], [4, 198799], [7, 198919], [12, 199139], [15, 199359], [21, 199968], [25, 200072], [30, 200352], [34, 200572], [38, 200772], [43, 200952], [45, 201112], [47, 203039], [49, 204580], [53, 204738], [59, 204998], [67, 205398], [71, 205618], [76, 205818], [79, 206038], [84, 206599], [88, 206797], [92, 207137], [96, 207297]]}, {"verse": 30, "start": 208307, "end": 211158, "text": "And he charged them that they should tell no man of him.", "words": [[0, 208307], [4, 208441], [7, 208561], [15, 209001], [20, 209321], [25, 209521], [30, 209701], [37, 209861], [42, 210141], [45, 210401], [49, 210641], [52, 210841]]}, {"verse": 31, "start": 211608, "end": 224550, "text": "And he began to teach them, that the Son of man must suffer many things, and be rejected of the elders, and of the chief priests, and scribes, and be killed, and after three days rise again.", "words": [[0, 211608], [4, 211742], [7, 211842], [13, 212162], [16, 212362], [22, 212662], [28, 212962], [33, 213542], [37, 213702], [41, 213962], [44, 214082], [48, 214362], [53, 214602], [60, 214962], [65, 215302], [73, 215782], [77, 216362], [80, 216502], [89, 216962], [92, 217242], [96, 217382], [104, 217762], [108, 218402], [111, 218542], [115, 218662], [121, 218902], [130, 219422], [134, 220022], [143, 221199], [147, 221351], [150, 221511], [158, 222411], [162, 222531], [168, 222831], [174, 223171], [179, 223491], [184, 223871]]}, {"verse": 32, "start": 225000, "end": 229992, "text": "And he spoke that saying openly. And Peter took him, and began to rebuke him.", "words": [[0, 225000], [4, 225142], [7, 225242], [13, 225542], [18, 225842], [25, 226182], [33, 227304], [37, 227429], [43, 227729], [48, 228029], [53, 228309], [57, 228669], [63, 228989], [66, 229189], [73, 229709]]}, {"verse": 33, "start": 230442, "end": 240775, "text": "But when he had turned about and looked on his disciples, he rebuked Peter, saying, Get behind me, Satan: for you are not mindful of the things of God, but the things that be of men.", "words": [[0, 230442], [4, 230568], [9, 230788], [12, 230988], [16, 231148], [23, 231428], [29, 231748], [33, 232088], [40, 232288], [43, 232508], [47, 232688], [58, 233768], [61, 233848], [69, 234428], [76, 235048], [84, 235861], [88, 235982], [95, 236302], [99, 236582], [106, 237366], [110, 237453], [114, 237613], [118, 237733], [122, 237853], [130, 238293], [133, 238513], [137, 238593], [144, 238813], [147, 238973], [152, 239413], [156, 239493], [160, 239633], [167, 239893], [172, 240053], [175, 240213], [178, 240333]]}, {"verse": 34, "start": 241125, "end": 251933, "text": "¶ And when he had called the people to him with his disciples also, he said to them, Whoever will come after me, let him deny himself, and take up his cross, and follow me.", "words": [[2, 241125], [6, 241253], [11, 241413], [14, 241633], [18, 241753], [25, 241993], [29, 242173], [36, 242453], [39, 242693], [43, 242933], [48, 243133], [52, 243273], [62, 243773], [68, 244813], [71, 244933], [76, 245173], [79, 245373], [85, 247118], [93, 247322], [98, 247582], [103, 247802], [109, 248102], [113, 248682], [117, 248802], [121, 248942], [126, 249282], [135, 249662], [139, 250142], [144, 250362], [147, 250542], [151, 250642], [158, 250982], [162, 251342], [169, 251662]]}, {"verse": 35, "start": 252383, "end": 258935, "text": "For whoever will save his life shall lose it; but whoever shall lose his life for my sake and the gospel’s, the same shall save it.", "words": [[0, 252383], [4, 252479], [12, 252719], [17, 252979], [22, 253219], [26, 253379], [31, 253679], [37, 253899], [42, 254159], [46, 254722], [50, 254840], [58, 255080], [64, 255360], [69, 255620], [73, 255780], [78, 256020], [82, 256200], [85, 256420], [90, 256640], [94, 256860], [98, 256960], [108, 257800], [112, 257900], [117, 258180], [123, 258420], [128, 258700]]}, {"verse": 36, "start": 259385, "end": 264488, "text": "For what shall it profit a man, if he shall gain the whole world, and lose his own soul?", "words": [[0, 259385], [4, 259498], [9, 259698], [15, 259918], [18, 260038], [25, 260378], [27, 260558], [32, 260878], [35, 261498], [38, 261638], [44, 261818], [49, 262078], [53, 262278], [59, 262458], [66, 262878], [70, 263218], [75, 263438], [79, 263658], [83, 263838]]}, {"verse": 37, "start": 264938, "end": 267684, "text": "Or what shall a man give in exchange for his soul?", "words": [[0, 264938], [3, 265040], [8, 265220], [14, 265380], [16, 265520], [20, 265720], [25, 266020], [28, 266300], [37, 266660], [41, 267040], [45, 267180]]}, {"verse": 38, "start": 268134, "end": 279582, "text": "Whoever therefore shall be ashamed of me and of my words in this adulterous and sinful generation; of him also shall the Son of man be ashamed, when he comes in the glory of his Father with the holy angels.", "words": [[0, 268134], [8, 268340], [18, 268860], [24, 269120], [27, 269300], [35, 269680], [38, 269920], [41, 270160], [45, 270420], [48, 270540], [51, 270720], [57, 271080], [60, 271300], [65, 271440], [76, 272120], [80, 272240], [87, 272620], [99, 273680], [102, 273844], [106, 273984], [111, 274384], [117, 274684], [121, 274864], [125, 275084], [128, 275204], [132, 275444], [135, 275664], [144, 276104], [149, 276624], [152, 276744], [158, 276984], [161, 277204], [165, 277304], [171, 277604], [174, 277804], [178, 277964], [185, 278304], [190, 278524], [194, 278684], [199, 278884]]}]}