{"book": "GEN", "chapter": 35, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 254073, "verses": [{"verse": 1, "start": 300, "end": 10084, "text": "Y dijo Dios a Jacob: Levántate, sube a Bet-el, y quédate allí; y haz allí un altar al Dios que te apareció cuando huías de tu hermano Esaú.", "words": [[0, 300], [2, 442], [7, 702], [12, 962], [14, 1162], [21, 1953], [32, 2491], [37, 3071], [39, 3131], [47, 3571], [49, 4091], [57, 4511], [63, 5500], [65, 5645], [69, 5825], [74, 6085], [77, 6225], [83, 6545], [86, 6705], [91, 6965], [95, 7245], [98, 7385], [107, 7925], [114, 8205], [120, 8685], [123, 8825], [126, 8945], [134, 9325]]}, {"verse": 2, "start": 10364, "end": 20823, "text": "Entonces Jacob dijo a su familia y a todos los que con él estaban: Quitad los dioses ajenos que hay entre vosotros, y limpiaos, y cambiad vuestros vestidos.", "words": [[0, 10364], [9, 11268], [15, 11568], [20, 12008], [22, 12208], [25, 12328], [33, 12928], [35, 13288], [37, 13369], [43, 13828], [47, 14288], [51, 14468], [55, 14689], [58, 14808], [67, 15799], [74, 15979], [78, 16199], [85, 16559], [92, 17119], [96, 17279], [100, 17439], [106, 17659], [116, 18239], [118, 18459], [128, 19119], [130, 19379], [138, 19639], [147, 20119]]}, {"verse": 3, "start": 21173, "end": 30554, "text": "Y levantémonos, y subamos a Bet-el; y haré allí altar al Dios que me respondió en el día de mi angustia, y ha sido conmigo en el camino que he andado.", "words": [[0, 21173], [2, 21273], [16, 22093], [18, 22213], [26, 22633], [28, 22813], [36, 23496], [38, 23650], [43, 23990], [48, 24250], [54, 24610], [57, 24830], [62, 25090], [66, 25330], [69, 25450], [79, 26110], [82, 26270], [85, 26390], [89, 26630], [92, 26770], [95, 26890], [105, 27590], [107, 28030], [110, 28150], [115, 28370], [123, 28910], [126, 29050], [129, 29150], [136, 29490], [140, 29790], [143, 29990]]}, {"verse": 4, "start": 30834, "end": 44507, "text": "Así dieron a Jacob todos los dioses ajenos que había