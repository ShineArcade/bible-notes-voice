{"book": "GEN", "chapter": 21, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 244288, "verses": [{"verse": 1, "start": 300, "end": 6008, "text": "And the LORD visited Sarah as he had said, and the LORD did to Sarah as he had spoken.", "words": [[0, 300], [4, 448], [8, 568], [13, 788], [21, 1228], [27, 1788], [30, 2188], [33, 2348], [37, 2508], [43, 3348], [47, 3608], [51, 3788], [56, 3968], [60, 4228], [63, 4448], [69, 4808], [72, 5088], [75, 5228], [79, 5368]]}, {"verse": 2, "start": 6358, "end": 13189, "text": "For Sarah conceived, and bore Abraham a son in his old age, at the set time of which God had spoken to him.", "words": [[0, 6358], [4, 6455], [10, 6795], [21, 7395], [25, 7615], [30, 7855], [38, 8455], [40, 8755], [44, 8995], [47, 9195], [51, 9375], [55, 9615], [60, 10355], [63, 10595], [67, 10735], [71, 10975], [76, 11335], [79, 11555], [85, 11755], [89, 12055], [93, 12255], [100, 12595], [103, 12855]]}, {"verse": 3, "start": 13539, "end": 18991, "text": "And Abraham called the name of his son that was born to him, whom Sarah bore to him, Isaac.", "words": [[0, 13539], [4, 13644], [12, 14084], [19, 14544], [23, 14744], [28, 14984], [31, 15164], [35, 15344], [39, 15684], [44, 15864], [48, 16004], [53, 16304], [56, 16504], [61, 16884], [66, 17224], [72, 17584], [77, 17904], [80, 18124], [85, 18444]]}, {"verse": 4, "start": 19341, "end": 24937, "text": "And Abraham circumcised his son Isaac being eight days old, as God had commanded him.", "words": [[0, 19341], [4, 19490], [12, 19950], [24, 20810], [28, 20990], [32, 21290], [38, 22110], [44, 22310], [50, 22630], [55, 22850], [60, 23470], [63, 23610], [67, 23910], [71, 24110], [81, 24530]]}, {"verse": 5, "start": 25287, "end": 29892, "text": "And Abraham was a hundred years old, when his son Isaac was born to him.", "words": [[0, 25287], [4, 25410], [12, 25750], [16, 26110], [18, 26270], [26, 26530], [32, 26890], [37, 27270], [42, 27870], [46, 28030], [50, 28350], [56, 28750], [60, 29070], [65, 29350], [68, 29590]]}, {"verse": 6, "start": 30242, "end": 35598, "text": "¶ And Sarah said, God has made me to laugh, so that all that hear will laugh with me.", "words": [[2, 30242], [6, 30370], [12, 30798], [18, 31368], [22, 31668], [26, 31948], [31, 32248], [34, 32448], [37, 32648], [44, 33288], [47, 33588], [52, 33768], [56, 33948], [61, 34188], [66, 34428], [71, 34688], [77, 34988], [82, 35208]]}, {"verse": 7, "start": 35878, "end": 43235, "text": "And she said, Who would have said to Abraham, that Sarah should have given children suck? for I have born him a son in his old age.", "words": [[0, 35878], [4, 35981], [8, 36141], [14, 36771], [18, 36911], [24, 37051], [29, 37151], [34, 37391], [37, 37611], [46, 38571], [51, 38731], [57, 39071], [64, 39331], [69, 39451], [75, 39671], [84, 40111], [90, 40894], [94, 41033], [96, 41173], [101, 41403], [106, 41633], [110, 41713], [112, 41793], [116, 42053], [119, 42233], [123, 42393], [127, 42593]]}, {"verse": 8, "start": 43515, "end": 49694, "text": "And the child grew, and was weaned: and Abraham made a great feast the same day that Isaac was weaned.", "words": [[0, 43515], [4, 43642], [8, 43722], [14, 44042], [20, 44462], [24, 45002], [28, 45202], [36, 45994], [40, 46142], [48, 46542], [53, 46862], [55, 46982], [61, 47262], [67, 47562], [71, 47822], [76, 48122], [80, 48362], [85, 48502], [91, 48822], [95, 49142]]}, {"verse": 9, "start": 50044, "end": 55332, "text": "¶ And Sarah saw the son of Hagar the Egyptian, which she had born to Abraham, mocking.", "words": [[2, 50044], [6, 50195], [12, 50575], [16, 50895], [20, 51035], [24, 51275], [27, 51395], [33, 51815], [37, 51995], [47, 52875], [53, 53035], [57, 53235], [61, 53495], [66, 53755], [69, 53895], [78, 54475]]}, {"verse": 10, "start": 55682, "end": 64631, "text": "Therefore she said to Abraham, Cast out this bondwoman and her son: for the son of this bondwoman shall not be heir with my son, even with Isaac.", "words": [[0, 55682], [10, 56130], [14, 56250], [19, 56490], [22, 56650], [31, 57798], [36, 57938], [40, 58158], [45, 58558], [55, 58958], [59, 59178], [63, 59318], [68, 60132], [72, 60190], [76, 60330], [80, 60550], [83, 60650], [88, 61040], [98, 61430], [104, 61710], [108, 61970], [111, 62190], [116, 62390], [121, 62570], [124, 62770], [129, 63510], [134, 63770], [139, 64030]]}, {"verse": 11, "start": 64911, "end": 69106, "text": "And the thing was very grievous in Abraham’s sight because of his son.", "words": [[0, 64911], [4, 65043], [8, 65163], [14, 65383], [18, 65623], [23, 65963], [32, 66523], [35, 66763], [45, 67503], [51, 67723], [59, 68143], [62, 68383], [66, 68523]]}, {"verse": 12, "start": 69456, "end": 82116, "text": "¶ And God said to Abraham, Let it not be grievous in your sight because of the lad, and because of your bondwoman; in all that Sarah has said to you, hearken to her voice; for in Isaac shall your seed be called.", "words": [[2, 69456], [6, 69599], [10, 69839], [15, 70139], [18, 70359], [27, 71360], [31, 71497], [34, 71617], [38, 71837], [41, 72057], [50, 72497], [53, 72677], [58, 72777], [64, 73077], [72, 73377], [75, 73557], [79, 73677], [84, 73997], [88, 74457], [96, 74717], [99, 74917], [104, 75397], [115, 76376], [118, 76456], [122, 76676], [127, 76856], [133, 77156], [137, 77376], [142, 77596], [145, 77736], [150, 78056], [158, 78376], [161, 78556], [165, 78696], [172, 79754], [176, 79936], [179, 80216], [185, 80596], [191, 80916], [196, 81076], [201, 81356], [204, 81576]]}, {"verse": 13, "start": 82697, "end": 86980, "text": "And also of the son of the bondwoman will I make a nation, because he is your seed.", "words": [[0, 82697], [4, 82840], [9, 83180], [12, 83380], [16, 83500], [20, 83720], [23, 83820], [27, 84120], [37, 84420], [42, 84620], [44, 84760], [49, 84920], [51, 85040], [59, 85640], [67, 85840], [70, 86100], [73, 86260], [78, 86380]]}, {"verse": 14, "start": 87484, "end": 101738, "text": "And Abraham rose up early in the morning, and took bread, and a bottle of water, and gave it to Hagar, putting it on her shoulder, and the child, and sent her away: and she departed, and wandered in the wilderness of Beer-sheba.", "words": [[0, 87484], [4, 87599], [12, 87999], [17, 88459], [20, 88739], [26, 89079], [29, 89259], [33, 89339], [42, 89679], [46, 90359], [51, 90579], [58, 90979], [62, 91499], [64, 91619], [71, 91879], [74, 92059], [81, 92419], [85, 93059], [90, 93279], [93, 93439], [96, 93559], [103, 94339], [111, 94579], [114, 94779], [117, 94919], [121, 95059], [131, 95439], [135, 95839], [139, 95959], [146, 96785], [150, 96972], [155, 97192], [159, 97352], [165, 98134], [169, 98267], [173, 98427], [183, 98867], [187, 99227], [196, 99747], [199, 99907], [203, 100027], [214, 100447], [217, 100787]]}, {"verse": 15, "start": 102088, "end": 106482, "text": "And the water was spent in the bottle, and she cast the child under one of the shrubs.", "words": [[0, 102088], [4, 102231], [8, 102331], [14, 102551], [18, 102771], [24, 102991], [27, 103191], [31, 103291], [39, 103951], [43, 104091], [47, 104211], [52, 104511], [56, 104731], [62, 105031], [68, 105371], [72, 105591], [75, 105691], [79, 105811]]}, {"verse": 16, "start": 106832, "end": 119110, "text": "And she went, and sat her down over against him a good way off, as it were a bowshot: for she said, Let me not see the death of the child. And she sat over against him, and lift up her voice, and wept.", "words": [[0, 106832], [4, 106969], [8, 107109], [14, 107349], [18, 107569], [22, 107829], [26, 108009], [31, 108349], [36, 108669], [44, 109069], [48, 109289], [50, 109389], [55, 109589], [59, 109809], [64, 110109], [67, 110669], [70, 110789], [75, 110969], [77, 111380], [86, 111932], [90, 112035], [94, 112195], [100, 112903], [104, 113037], [107, 113197], [111, 113357], [115, 113617], [119, 113777], [125, 114037], [128, 114217], [132, 114337], [139, 115268], [143, 115385], [147, 115545], [151, 115845], [156, 116125], [164, 116525], [169, 116765], [173, 117205], [178,