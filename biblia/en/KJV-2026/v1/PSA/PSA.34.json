{"book": "PSA", "chapter": 34, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 114189, "verses": [{"verse": 1, "start": 300, "end": 5963, "text": "I will bless the LORD at all times: his praise shall continually be in my mouth.", "words": [[0, 300], [2, 438], [7, 618], [13, 958], [17, 1238], [22, 1578], [25, 1818], [29, 2098], [36, 3179], [40, 3304], [47, 3724], [53, 4104], [65, 4804], [68, 5164], [71, 5404], [74, 5604]]}, {"verse": 2, "start": 6413, "end": 11430, "text": "My soul shall make her boast in the LORD: the humble shall hear of it, and be glad.", "words": [[0, 6413], [3, 6580], [8, 6940], [14, 7180], [19, 7460], [23, 7620], [29, 8020], [32, 8280], [36, 8380], [42, 9152], [46, 9249], [53, 9529], [59, 9849], [64, 10129], [67, 10329], [71, 10469], [75, 10709], [78, 10849]]}, {"verse": 3, "start": 11880, "end": 16181, "text": "O magnify the LORD with me, and let us exalt his name together.", "words": [[0, 11880], [2, 12045], [10, 12685], [14, 12945], [19, 13225], [24, 13505], [28, 14145], [32, 14205], [36, 14385], [39, 14565], [45, 15045], [49, 15265], [54, 15525]]}, {"verse": 4, "start": 16631, "end": 21157, "text": "I sought the LORD, and he heard me, and delivered me from all my fears.", "words": [[0, 16631], [2, 16795], [9, 17055], [13, 17315], [19, 17995], [23, 18135], [26, 18315], [32, 18595], [36, 19135], [40, 19215], [50, 19555], [53, 19875], [58, 20075], [62, 20315], [65, 20535]]}, {"verse": 5, "start": 21607, "end": 25989, "text": "They looked to him, and were lightened: and their faces were not ashamed.", "words": [[0, 21607], [5, 21752], [12, 21992], [15, 22232], [20, 22452], [24, 22952], [29, 23112], [40, 24096], [44, 24276], [50, 24416], [56, 24796], [61, 25096], [65, 25316]]}, {"verse": 6, "start": 26439, "end": 31272, "text": "This poor man cried, and the LORD heard him, and saved him out of all his troubles.", "words": [[0, 26439], [5, 26669], [10, 27009], [14, 27309], [21, 28229], [25, 28429], [29, 28589], [34, 28829], [40, 29129], [45, 29329], [49, 29509], [55, 29809], [59, 29989], [63, 30149], [66, 30289], [70, 30429], [74, 30609]]}, {"verse": 7, "start": 31722, "end": 36084, "text": "The angel of the LORD encamps round about them that fear him, and delivers them.", "words": [[0, 31722], [4, 31803], [10, 32203], [13, 32383], [17, 32483], [22, 32723], [30, 33283], [36, 33563], [42, 33863], [47, 34143], [52, 34323], [57, 34583], [62, 34843], [66, 35183], [75, 35503]]}, {"verse": 8, "start": 36534, "end": 41275, "text": "O taste and see that the LORD is good: blessed is the man that trusts in him.", "words": [[0, 36534], [2, 36678], [8, 36938], [12, 37338], [16, 37618], [21, 37818], [25, 37938], [30, 38178], [33, 38358], [39, 39181], [47, 39425], [50, 39725], [54, 39865], [58, 40085], [63, 40245], [70, 40585], [73, 40885]]}, {"verse": 9, "start": 41725, "end": 46542, "text": "O fear the LORD, you his saints: for there is no want to them that fear him.", "words": [[0, 41725], [2, 41874], [7, 42154], [11, 42354], [17, 43014], [21, 43194], [25, 43454], [33, 44366], [37, 44471], [43, 44651], [46, 44791], [49, 44971], [54, 45251], [57, 45431], [62, 45631], [67, 45831], [72, 46111]]}, {"verse": 10, "start": 46992, "end": 53145, "text": "The young lions do lack, and suffer hunger: but they that seek the LORD shall not want any good thing.", "words": [[0, 46992], [4, 47096], [10, 47336], [16, 47736], [19, 48016], [25, 48376], [29, 48656], [36, 48956], [44, 49859], [48, 49966], [53, 50206], [58, 50426], [63, 50746], [67, 50966], [72, 51266], [78, 51526], [82, 51786], [87, 52046], [91, 52346], [96, 52606]]}, {"verse": 11, "start": 53595, "end": 58013, "text": "Come, you children, hearken to me: I will teach you the fear of the LORD.", "words": [[0, 53595], [6, 53921], [10, 53981], [20, 54661], [28, 54901], [31, 55101], [35, 55729], [37, 56035], [42, 56235], [48, 56495], [52, 56735], [56, 56875], [61, 57175], [64, 57355], [68, 57495]]}, {"verse": 12, "start": 58463, "end": 63792, "text": "What man is he that desires life, and loves many days, that he may see good?", "words": [[0, 58463], [5, 58671], [9, 58971], [12, 59211], [15, 59411], [20, 59631], [28, 60011], [34, 60511], [38, 61111], [44, 61391], [49, 61731], [55, 62111], [60, 62751], [63, 62911], [67, 63051], [71, 63271]]}, {"verse": 13, "start": 64242, "end": 67755, "text": "Keep your tongue from evil, and your lips from speaking guile.", "words": [[0, 64242], [5, 64642], [10, 64842], [17, 65122], [22, 65402], [28, 65742], [32, 66102], [37, 66242], [42, 66502], [47, 66742], [56, 67102]]}, {"verse": 14, "start": 68205, "end": 72170, "text": "Depart from evil, and do good; seek peace, and pursue it.", "words": [[0, 68205], [7, 68745], [12, 68925], [18, 69245], [22, 69525], [25, 69705], [31, 70532], [36, 70852], [43, 71172], [47, 71452], [54, 71772]]}, {"verse": 15, "start": 72620, "end": 76928, "text": "The eyes of the LORD are upon the righteous, and his ears are open to their cry.", "words": [[0, 72620], [4, 72728], [9, 73048], [12, 73208], [16, 73348], [21, 73628], [25, 73788], [30, 74028], [34, 74228], [45, 74888], [49, 75148], [53, 75328], [58, 75488], [62, 75728], [67, 75968], [70, 76148], [76, 76308]]}, {"verse": 16, "start": 77378, "end": 82749, "text": "The face of the LORD is against them that do evil, to cut off the remembrance of them from the earth.", "words": [[0, 77378], [4, 77466], [9, 77726], [12, 77906], [16, 78046], [21, 78246], [24, 78426], [32, 78686], [37, 79006], [42, 79206], [45, 79446], [51, 80146], [54, 80366], [58, 80586], [62, 80746], [66, 80946], [78, 81346], [81, 81706], [86, 81886], [91, 82126], [95, 82326]]}, {"verse": 17, "start": 83199, "end": 87921, "text": "The righteous cry, and the LORD hears, and delivers them out of all their troubles.", "words": [[0, 83199], [4, 83324], [14, 83624], [19, 84104], [23, 84404], [27, 84544], [32, 84784], [39, 85844], [43, 85864], [52, 86184], [57, 86504], [61, 86704], [64, 86844], [68, 87064], [74, 87244]]}, {"verse": 18, "start": 88371, "end": 94224, "text": "The LORD is near to them that are of a broken heart; and saves such as be of a contrite spirit.", "words": [[0, 88371], [4, 88482], [9, 88702], [12, 88922], [17, 89142], [20, 89362], [25, 89562], [30, 89802], [34, 89982], [37, 90122], [39, 90222], [46, 90522], [53, 91485], [57, 91707], [63, 91967], [68, 92307], [71, 92507], [74, 92727], [77, 92907], [79, 93007], [88, 93607]]}, {"verse": 19, "start": 94674, "end": 99073, "text": "Many are the afflictions of the righteous: but the LORD delivers him out of them all.", "words": [[0, 94674], [5, 94943], [9, 95123], [13, 95243], [25, 95823], [28, 96003], [32, 96123], [43, 97086], [47, 97189], [51, 97329], [56, 97549], [65, 98009], [69, 98229], [73, 98429], [76, 98663], [81, 98898]]}, {"verse": 20, "start": 99523, "end": 102989, "text": "He keeps all his bones: not one of them is broken.", "words": [[0, 99523], [3, 99610], [9, 99850], [13, 100150], [17, 100330], [24, 101370], [28, 101540], [32, 101840], [35, 101940], [40, 102120], [43, 102280]]}, {"verse": 21, "start": 103439, "end": 107979, "text": "Evil shall slay the wicked: and they that hate the righteous shall be desolate.", "words": [[0, 103439], [5, 103688], [11, 104008], [16, 104428], [20, 104528], [28, 105354], [32, 105498], [37, 105658], [42, 105878], [47, 106138], [51, 106338], [61, 106698], [67, 107038], [70, 107198]]}, {"verse": 22, "start": 108429, "end": 113789, "text": "The LORD redeems the soul of his servants: and none of them that trust in him shall be desolate.", "words": [[0, 108429], [4, 108572], [9, 108832], [17, 109412], [21, 109592], [26, 109912], [29, 110072], [33, 110232], [43, 111268], [47, 111415], [52, 111655], [55, 111795], [60, 111965], [65, 112135], [71, 112415], [74, 112615], [78, 112755], [84, 112995], [87, 113135]]}]}