{"book": "ROM", "chapter": 6, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 144882, "verses": [{"verse": 1, "start": 300, "end": 4421, "text": "What shall we say then? Shall we continue in sin, that grace may abound?", "words": [[0, 300], [5, 440], [11, 620], [14, 760], [18, 980], [24, 1697], [30, 1841], [33, 1981], [42, 2341], [45, 2561], [50, 2861], [55, 3381], [61, 3661], [65, 3901]]}, {"verse": 2, "start": 4871, "end": 8783, "text": "God forbid. How shall we, that are dead to sin, live any longer in it?", "words": [[0, 4871], [4, 5091], [12, 5986], [16, 6113], [22, 6313], [26, 6473], [31, 6633], [35, 6733], [40, 6993], [43, 7193], [48, 7523], [53, 7853], [57, 8013], [64, 8293], [67, 8513]]}, {"verse": 3, "start": 9233, "end": 14553, "text": "Do you not know, that so many of us as were baptized into Jesus Christ were baptized into his death?", "words": [[0, 9233], [3, 9313], [7, 9413], [11, 9593], [17, 9813], [22, 10033], [25, 10253], [30, 10473], [33, 10653], [36, 10913], [39, 11033], [44, 11173], [53, 11533], [58, 11893], [64, 12193], [71, 12993], [76, 13093], [85, 13473], [90, 13893], [94, 14073]]}, {"verse": 4, "start": 15003, "end": 24275, "text": "Therefore we are buried with him by baptism into death: that like as Christ was raised up from the dead by the glory of the Father, even so we also should walk in newness of life.", "words": [[0, 15003], [10, 15485], [13, 15585], [17, 15685], [24, 15945], [29, 16185], [33, 16345], [36, 16525], [44, 16985], [49, 17305], [56, 17982], [61, 18135], [66, 18355], [69, 18495], [76, 18795], [80, 19035], [87, 19335], [90, 19555], [95, 19715], [99, 19855], [104, 20075], [107, 20235], [111, 20375], [117, 20675], [120, 20835], [124, 20955], [132, 21675], [137, 21955], [140, 22215], [143, 22375], [148, 22675], [155, 22915], [160, 23195], [163, 23375], [171, 23695], [174, 23835]]}, {"verse": 5, "start": 24725, "end": 30955, "text": "For if we have been planted together in the likeness of his death, we shall be also in the likeness of his resurrection:", "words": [[0, 24725], [4, 24893], [7, 25053], [10, 25213], [15, 25393], [20, 25553], [28, 25973], [37, 26373], [40, 26633], [44, 26773], [53, 27193], [56, 27333], [60, 27453], [67, 28153], [70, 28313], [76, 28493], [79, 28673], [84, 29033], [87, 29293], [91, 29413], [100, 29833], [103, 29993], [107, 30153]]}, {"verse": 6, "start": 31405, "end": 38744, "text": "Knowing this, that our old man is crucified with him, that the body of sin might be destroyed, that from now on we should not serve sin.", "words": [[0, 31405], [8, 31679], [14, 31979], [19, 32219], [23, 32359], [27, 32679], [31, 32919], [34, 33099], [44, 33479], [49, 33839], [54, 34339], [59, 34559], [63, 34659], [68, 34959], [71, 35099], [75, 35359], [81, 35579], [84, 35739], [95, 36519], [100, 36599], [105, 36779], [109, 37039], [112, 37299], [115, 37619], [122, 37779], [126, 38019], [132, 38299]]}, {"verse": 7, "start": 39194, "end": 41549, "text": "For he that is dead is freed from sin.", "words": [[0, 39194], [4, 39342], [7, 39502], [12, 39702], [15, 39862], [20, 40142], [23, 40442], [29, 40782], [34, 41002]]}, {"verse": 8, "start": 41999, "end": 46114, "text": "Now if we be dead with Christ, we believe that we shall also live with him:", "words": [[0, 41999], [4, 42361], [7, 42461], [10, 42601], [13, 42721], [18, 42961], [23, 43141], [31, 43861], [34, 43981], [42, 44341], [47, 44581], [50, 44741], [56, 44921], [61, 45261], [66, 45501], [71, 45761]]}, {"verse": 9, "start": 46564, "end": 51217, "text": "Knowing that Christ being raised from the dead dies no more; death has no more dominion over him.", "words": [[0, 46564], [8, 46804], [13, 47024], [20, 47324], [26, 47604], [33, 47904], [38, 48084], [42, 48224], [47, 48444], [52, 48704], [55, 48884], [61, 49524], [67, 49763], [71, 49983], [74, 50183], [79, 50323], [88, 50743], [93, 50903]]}, {"verse": 10, "start": 51667, "end": 56934, "text": "For in that he died, he died to sin once: but in that he lives, he lives to God.", "words": [[0, 51667], [4, 51774], [7, 51914], [12, 52094], [15, 52274], [21, 52834], [24, 52974], [29, 53194], [32, 53374], [36, 53574], [42, 54445], [46, 54602], [49, 54902], [54, 55062], [57, 55482], [64, 55902], [67, 56122], [73, 56342], [76, 56502]]}, {"verse": 11, "start": 57384, "end": 63127, "text": "Likewise reckon you also yourselves to be dead indeed to sin, but alive to God through Jesus Christ our Lord.", "words": [[0, 57384], [9, 57887], [16, 58087], [20, 58287], [25, 58587], [36, 59047], [39, 59267], [42, 59367], [47, 59587], [54, 60187], [57, 60267], [62, 60887], [66, 60987], [72, 61287], [75, 61487], [79, 61667], [87, 61887], [93, 62127], [100, 62427], [104, 62687]]}, {"verse": 12, "start": 63577, "end": 68279, "text": "Let not sin therefore reign in your mortal body, that you should obey it in the lusts of it.", "words": [[0, 63577], [4, 63764], [8, 64004], [12, 64324], [22, 64724], [28, 65064], [31, 65324], [36, 65464], [43, 65724], [49, 66084], [54, 66504], [58, 66644], [65, 66804], [70, 67144], [73, 67344], [76, 67504], [80, 67624], [86, 67984], [89, 68044]]}, {"verse": 13, "start": 68729, "end": 78872, "text": "Neither yield you your members as instruments of unrighteousness to sin: but yield yourselves to God, as those that are alive from the dead, and your members as instruments of righteousness to God.", "words": [[0, 68729], [8, 68952], [14, 69292], [18, 69492], [23, 69652], [31, 69992], [34, 70452], [46, 70932], [49, 71192], [65, 71992], [68, 72172], [73, 72884], [77, 73004], [83, 73264], [94, 73684], [97, 73904], [102, 74144], [105, 74524], [111, 74724], [116, 74964], [120, 75124], [126, 75384], [131, 75604], [135, 75724], [141, 75984], [145, 76364], [150, 76484], [158, 76824], [161, 77104], [173, 77544], [176, 77804], [190, 78204], [193, 78544]]}, {"verse": 14, "start": 79322, "end": 84665, "text": "For sin shall not have dominion over you: for you are not under the law, but under grace.", "words": [[0, 79322], [4, 79408], [8, 79768], [14, 80148], [18, 80368], [23, 80548], [32, 81048], [37, 81248], [42, 81840], [46, 81971], [50, 82151], [54, 82411], [58, 82651], [64, 82991], [68, 83171], [73, 83671], [77, 83751], [83, 84071]]}, {"verse": 15, "start": 85115, "end": 90363, "text": "What then? shall we sin, because we are not under the law, but under grace? God forbid.", "words": [[0, 85115], [5, 85299], [11, 86015], [17, 86181], [20, 86391], [25, 86601], [33, 86881], [36, 87081], [40, 87181], [44, 87381], [50, 87641], [54, 87781], [59, 88281], [63, 88381], [69, 88701], [76, 89609], [80, 89807]]}, {"verse": 16, "start": 90813, "end": 99784, "text": "Do you not know, that to whom you yield yourselves servants to obey, his servants you are to whom you obey; whether of sin to death, or of obedience to righteousness?", "words": [[0, 90813], [3, 90909], [7, 91009], [11, 91169], [17, 91429], [22, 91789], [25, 91969], [30, 92169], [34, 92289], [40, 92619], [51, 92949], [60, 93389], [63, 93629], [69, 94289], [73, 94429], [82, 94769], [86, 95029], [90, 95249], [93, 95449], [98, 95649], [102, 95789], [108, 96567], [116, 96787], [119, 97007], [123, 97287], [126, 97467], [133, 97747], [136, 98147], [139, 98307], [149, 98667], [152, 98987]]}, {"verse": 17, "start": 100234, "end": 106257, "text": "But God be thanked, that you were the servants of sin, but you have obeyed from the heart that form of doctrine which was delivered you.", "words": [[0, 100234], [4, 100352], [8, 100552], [11, 100732], [20, 101072], [25, 101452], [29, 101592], [34, 101712], [38, 101832], [47, 102112], [50, 102352], [55, 102992], [59, 103112], [63, 103252], [68, 103372], [75, 103752], [80, 103892], [84, 104012], [90, 104252], [95, 104412], [100, 104692], [103, 104812], [112, 105152], [118, 105392], [122, 105552], [132, 105892]]}, {"verse": 18, "start": 106707, "end": 110159, "text": "Being then made free from sin, you became the servants of righteousness.", "words": [[0, 106707], [6, 106904], [11, 107144], [16, 107364], [21, 107604], [26, 107824], [31, 108384], [35, 108444], [42, 108704], [46, 108884], [55, 109184], [58, 109424]]}, {"verse": 19, "start": 110609, "end": 122412, "text": "I speak after the manner of men because of the infirmity of your flesh: for as you have yielded your members servants to uncleanness and to iniquity to iniquity; even so now yield your members servants to righteousness to holiness.", "words": [[0, 110609], [2, 110727], [8, 110947], [14, 111267], [18, 111427], [25, 111647], [28, 111847], [32, 112047], [40, 112327], [43, 112507], [47, 112627], [57, 113147], [60, 113287], [65, 113407], [72, 114267], [76, 114368], [79, 114528], [83, 114648], [88, 114768], [96, 115168], [101, 115338], [109, 115508], [118, 115928], [121, 116148], [133, 116828], [137, 116948], [140, 117068], [149, 117548], [152, 117688], [162, 118581], [167, 118777], [170, 119217], [174, 119317], [180, 119717], [185, 119987], [193, 120257], [202, 120677], [205, 120897], [219, 121657], [222, 121697]]}, {"verse": 20, "start": 122862, "end": 126535, "text": "For when you were the servants of sin, you were free from righteousness.", "words": [[0, 122862], [4, 122981], [9, 123181], [13, 123361], [18, 123481], [22, 123601], [31, 123921], [34, 124181], [39, 124481], [43, 124941], [48, 125081], [53, 125401], [58, 125661]]}, {"verse": 21, "start": 126985, "end": 132084, "text": "What fruit had you then in those things of which you are now ashamed? for the end of those things is death.", "words": [[0, 126985], [5, 127146], [11, 127466], [15, 127706], [19, 127866], [24, 128066], [27, 128246], [33, 128426], [40, 128706], [43, 128886], [49, 129026], [53, 129166], [57, 129286], [61, 129446], [70, 130401], [74, 130494], [78, 130654], [82, 130814], [85, 130914], [91, 131134], [98, 131434], [101, 131654]]}, {"verse": 22, "start": 132534, "end": 138813, "text": "But now being made free from sin, and become servants to God, you have your fruit to holiness, and the end everlasting life.", "words": [[0, 132534], [4, 132652], [8, 132872], [14, 133052], [19, 133292], [24, 133512], [29, 133732], [34, 134072], [38, 134452], [45, 134692], [54, 135072], [57, 135332], [62, 135852], [66, 135952], [71, 136052], [76, 136172], [82, 136432], [85, 136612], [95, 136972], [99, 137432], [103, 137572], [107, 137812], [119, 138132]]}, {"verse": 23, "start": 139263, "end": 144482, "text": "For the wages of sin is death; but the gift of God is eternal life through Jesus Christ our Lord.", "words": [[0, 139263], [4, 139365], [8, 139465], [14, 139785], [17, 140005], [21, 140245], [24, 140405], [31, 141033], [35, 141132], [39, 141252], [44, 141492], [47, 141672], [51, 141912], [54, 142112], [62, 142452], [67, 142852], [75, 143072], [81, 143372], [88, 143772], [92, 144032]]}]}