{"book": "ROM", "chapter": 16, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 185504, "verses": [{"verse": 1, "start": 300, "end": 6200, "text": "Pero os recomiendo a Febe nuestra hermana, la cual es diaconisa de la iglesia que está en Cencrea:", "words": [[0, 300], [5, 480], [8, 640], [19, 1220], [21, 1480], [26, 1740], [34, 1920], [43, 2880], [46, 2980], [51, 3180], [54, 3400], [64, 4000], [67, 4160], [70, 4260], [78, 4640], [82, 4800], [87, 5020], [90, 5635]]}, {"verse": 2, "start": 6550, "end": 16200, "text": "Que la recibáis en el Señor, como es digno a los santos, y que la ayudéis en cualquiera cosa en que necesite de vosotros: porque ella ha ayudado a muchos, y a mí mismo.", "words": [[0, 6550], [4, 6647], [7, 6747], [16, 7347], [19, 7527], [22, 7647], [29, 7987], [34, 8447], [37, 8627], [43, 8987], [45, 8987], [49, 9087], [57, 9987], [59, 10127], [63, 10267], [66, 10407], [74, 10887], [77, 11087], [88, 11287], [93, 11807], [96, 11987], [100, 12067], [109, 12647], [112, 12767], [122, 13549], [129, 13733], [134, 14073], [137, 14293], [145, 14673], [147, 14793], [155, 15093], [157, 15493], [159, 15553], [162, 15673]]}, {"verse": 3, "start": 16550, "end": 20407, "text": "Saludad a Priscila y a Aquila, mis colaboradores en Cristo Jesús;", "words": [[0, 16712], [8, 16878], [10, 17045], [19, 17705], [21, 17765], [23, 17825], [31, 18325], [35, 18425], [49, 19205], [52, 19465], [59, 19745]]}, {"verse": 4, "start": 20757, "end": 27856, "text": "(Que pusieron sus cuellos por mi vida: a los cuales no doy gracias yo solo, sino también todas las iglesias de los Gentiles;)", "words": [[0, 20757], [5, 20836], [14, 21276], [18, 21576], [26, 21876], [30, 22076], [33, 22256], [39, 22886], [41, 22997], [45, 23097], [52, 23357], [55, 23697], [59, 23917], [67, 24177], [70, 24437], [76, 25197], [81, 25357], [89, 25757], [95, 26057], [99, 26357], [108, 26877], [111, 27017], [115, 27117]]}, {"verse": 5, "start": 28206, "end": 34629, "text": "Asimismo a la iglesia de su casa. Saludad a Epeneto, amado mío, que es las primicias de Acaya en Cristo.", "words": [[0, 28206], [9, 28866], [11, 28986], [14, 29046], [22, 29426], [25, 29566], [28, 29726], [34, 30447], [42, 30992], [44, 31072], [53, 31552], [59, 31852], [64, 32372], [68, 32472], [71, 32632], [75, 32772], [85, 33352], [88, 33572], [94, 33932], [97, 34052]]}, {"verse": 6, "start": 34979, "end": 38087, "text": "Saludad a María, la cual ha trabajado mucho con vosotros.", "words": [[0, 34979], [8, 35437], [10, 35517], [17, 35857], [20, 35957], [25, 36197], [28, 36357], [38, 36897], [44, 37117], [48, 37397]]}, {"verse": 7, "start": 38437, "end": 48469, "text": "Saludad a Andrónico y a Junias, mis parientes, y mis compañeros en la cautividad, los que son destacados entre los apóstoles; los cuales también fueron antes de mí en Cristo.", "words": [[0, 38711], [8, 38991], [10, 39091], [20, 39631], [22, 39751], [24, 39831], [32, 40431], [36, 40511], [47, 41051], [49, 41371], [53, 41511], [64, 42131], [67, 42291], [70, 42391], [82, 43411], [86, 43511], [90, 43651], [94, 43851], [105, 44491], [111, 44731], [115, 44911], [126, 45965], [130, 46087], [137, 46407], [145, 46767], [152, 47087], [158, 47427], [161, 47627], [164, 47787], [167, 47907]]}, {"verse": 8, "start": 48819, "end": 51107, "text": "Saludad a Amplias, amado mío en el Señor.", "words": [[0, 48819], [8, 49303], [10, 49573], [19, 49843], [25, 50063], [29, 50403], [32, 50503], [35, 50603]]}, {"verse": 9, "start": 51457, "end": 56005, "text": "Saludad a Urbano, nuestro colaborador en Cristo Jesús, y a Estaquis, amado mío.", "words": [[0, 51457], [8, 51918], [10, 51998], [18, 52358], [26, 52598], [38, 53238], [41, 53378], [48, 53618], [55, 54138], [57, 54598], [59, 54968], [69, 55338], [75, 55578]]}, {"verse": 10, "start": 56355, "end": 60263, "text": "Saludad a Apeles, probado en Cristo. Saludad a los que son de Aristóbulo.", "words": [[0, 56564], [8, 56814], [10, 57014], [18, 57214], [26, 57554], [29, 57674], [37, 58625], [45, 58885], [47, 59025], [51, 59165], [55, 59285], [59, 59465], [62, 59585]]}, {"verse": 11, "start": 60613, "end": 66848, "text": "Saludad a Herodión, mi pariente. Saludad a los que son de la casa de Narciso, los que están en el Señor.", "words": [[0, 60613], [8, 61149], [10, 61249], [20, 61789], [23, 61829], [33, 62782], [41, 63302], [43, 63422], [47, 63542], [51, 63682], [55, 63882], [58, 64022], [61, 64122], [66, 64362], [69, 64542], [78, 65482], [82, 65622], [86, 65802], [92, 66062], [95, 66222], [98, 66342]]}, {"verse": 12, "start": 67198, "end": 74879, "text": "Saludad a Trifena y a Trifosa, las cuales trabajan en el Señor. Saludad a Pérsida amada, la cual ha trabajado mucho en el Señor.", "words": [[0, 67350], [8, 67536], [10, 67722], [18, 68262], [20, 68528], [22, 68792], [31, 69058], [35, 69158], [42, 69418], [51, 70018], [54, 70118], [57, 70258], [64, 71153], [72, 71333], [74, 71513], [82, 72013], [89, 72833], [92, 73013], [97, 73213], [100, 73373], [110, 73873], [116, 74133], [119, 74313], [122, 74433]]}, {"verse": 13, "start": 75229, "end": 78615, "text": "Saludad a Rufo, escogido en el Señor, y a su madre y mía.", "words": [[0, 75229], [8, 75667], [10, 75767], [16, 76087], [25, 76547], [28, 76647], [31, 76747], [38, 77027], [40, 77567], [42, 77647], [45, 77767], [51, 78027], [53, 78247]]}, {"verse": 14, "start": 78965, "end": 85164, "text": "Saludad a Asíncrito, y a Flegonte, a Hermas, a Patrobas, a Hermes, y a los hermanos que están con ellos.", "words": [[0, 79190], [8, 79420], [10, 79710], [21, 80000], [23, 80140], [25, 80180], [35, 81080], [37, 81120], [45, 81760], [47, 81820], [57, 82620], [59, 82680], [67, 83200], [69, 83540], [71, 83600], [75, 83700], [84, 84180], [88, 84260], [94, 84460], [98, 84680]]}, {"verse": 15, "start": 85514, "end": 93030, "text": "Saludad a Filólogo y a Julia, a Nereo y a su hermana, y a Olimpas, y a todos los santos que están con ellos.", "words": [[0, 85693], [8, 85879], [10, 86066], [19, 86726], [21, 86906], [23, 86966], [30, 87826], [32, 87886], [38, 88326], [40, 88446], [42, 88526], [45, 88666], [54, 89546], [56, 89766], [58, 89846], [67, 90426], [69, 90966], [71, 91026], [77, 91226], [81, 91506], [88, 91966], [92, 92086], [98, 92306], [102, 92566]]}, {"verse": 16, "start": 93380, "end": 98758, "text": "Saludaos los unos a los otros con beso santo. Os saludan todas las iglesias de Cristo.", "words": [[0, 93380], [9, 94002], [13, 94182], [18, 94462], [20, 94662], [24, 94782], [30, 95082], [34, 95412], [39, 95742], [46, 96404], [49, 96510], [57, 97050], [63, 97230], [67, 97550], [76, 98050], [79, 98190]]}, {"verse": 17, "start": 99108, "end": 107203, "text": "Y os ruego hermanos, que miréis los que causan divisiones y escándalos contra la doctrina que vosotros habéis aprendido; y apartaos de ellos.", "words": [[0, 99108], [2, 99227], [5, 99367], [11, 99687], [21, 100327], [25, 100647], [32, 101067], [36, 101207], [40, 101367], [47, 101787], [58, 102407], [60, 102507], [71, 103127], [78, 103407], [81, 103547], [90, 104007], [94, 104207], [103, 104607], [110, 104967], [121, 105882], [123, 106164], [132, 106484], [135, 106684]]}, {"verse": 18, "start": 107553, "end": 116004, "text": "Porque los tales no sirven al Señor nuestro Jesucristo, sino a sus vientres; y con palabras suaves y halagos engañan los corazones de los ingenuos.", "words": [[0, 107553], [7, 107741], [11, 107941], [17, 108181], [20, 108421], [27, 108821], [30, 108981], [36, 109201], [44, 109481], [56, 110661], [61, 110841], [63, 111021], [67, 111161], [77, 112087], [79, 112171], [83, 112311], [92, 112631], [99, 113111], [101, 113291], [109, 113731], [117, 114291], [121, 114411], [131, 114991], [134, 115111], [138, 115211]]}, {"verse": 19, "start": 116354, "end": 125314, "text": "Porque vuestra obediencia ha venido a ser notoria a todos; así que me gozo de vosotros; pero quiero que seáis sabios en el bien, y inocentes en cuanto al mal.", "words": [[0, 116354], [7, 116534], [15, 116894], [26, 117454], [29, 117734], [36, 118054], [38, 118194], [42, 118334], [50, 118834], [52, 118954], [59, 119725], [63, 119904], [67, 120084], [70, 120184], [75, 120484], [78, 120624], [88, 121519], [93, 121799], [100, 122039], [104, 122239], [110, 122579], [117, 122959], [120, 123139], [123, 123259], [129, 123479], [131, 123819], [141, 124339], [144, 124559], [151, 124719], [154, 124979]]}, {"verse": 20, "start": 125664, "end": 133793, "text": "Y el Dios de paz quebrantará pronto a Satanás debajo de vuestros pies. La gracia del Señor nuestro Jesucristo sea con vosotros.", "words": [[0, 125664], [2, 125784], [5, 125944], [10, 126144], [13, 126424], [17, 126684], [29, 127444], [36, 127804], [38, 128024], [46, 128584], [53, 129084], [56, 129224], [65, 129544], [71, 130397], [74, 130540], [81, 130980], [85, 131080], [91, 131540], [99, 131800], [110, 132620], [114, 132780], [118, 133040]]}, {"verse": 21, "start": 134143, "end": 139381, "text": "Os saludan Timoteo, mi colaborador, y Lucio y Jasón y Sosipater, mis parientes.", "words": [[0, 134143], [3, 134264], [11, 134784], [20, 135404], [23, 135484], [36, 136244], [38, 136449], [44, 136909], [46, 137229], [52, 137549], [54, 137649], [65, 138409], [69, 138489]]}, {"verse": 22, "start": 139731, "end": 143062, "text": "Yo Tercio, que escribí la epístola, os saludo en el Señor.", "words": [[0, 139731], [3, 139874], [11, 140234], [15, 140394], [23, 140814], [26, 140894], [36, 141794], [39, 141894], [46, 142314], [49, 142434], [52, 142554]]}, {"verse": 23, "start": 143412, "end": 150523, "text": "Os saluda Gayo, mi anfitrión, y de toda la iglesia. Os saluda Erasto, tesorero de la ciudad, y el hermano Cuarto.", "words": [[0, 143412], [3, 143535], [10, 143885], [16, 144235], [19, 144375], [30, 144955], [32, 145195], [35, 145315], [40, 145455], [43, 145655], [52, 146500], [55, 146645], [62, 147185], [70, 147705], [79, 148405], [82, 148545], [85, 148685], [93, 149345], [95, 149505], [98, 149585], [106, 149985]]}, {"verse": 24, "start": 150873, "end": 155106, "text": "La gracia del Señor nuestro Jesucristo sea con todos vosotros. Amén.", "words": [[0, 150873], [3, 150991], [10, 151411], [14, 151511], [20, 151831], [28, 152131], [39, 152891], [43, 153171], [47, 153431], [53, 153751], [63, 154671]]}, {"verse": 25, "start": 155456, "end": 164377, "text": "Y al que puede fortaleceros según mi evangelio y la predicación de Jesucristo, según la revelación del misterio encubierto desde tiempos eternos,", "words": [[0, 155456], [2, 155556], [5, 155656], [9, 155776], [15, 156036], [28, 157136], [34, 157336], [37, 157576], [47, 158316], [49, 158416], [52, 158516], [64, 159176], [67, 159336], [79, 160416], [85, 160736], [88, 160936], [99, 161496], [103, 161676], [112, 162216], [123, 162856], [129, 163076], [137, 163656]]}, {"verse": 26, "start": 164727, "end": 174236, "text": "Pero manifestado ahora, y por las Escrituras de los profetas, según el mandamiento del Dios eterno, declarado a todas las naciones para que obedezcan a la fe;", "words": [[0, 164727], [5, 164885], [17, 165625], [24, 165985], [26, 166245], [30, 166425], [34, 166605], [45, 167185], [48, 167345], [52, 167485], [62, 168505], [68, 168805], [71, 169025], [83, 169605], [87, 169865], [92, 170105], [100, 171145], [110, 171605], [112, 171745], [118, 171905], [122, 172225], [131, 172645], [136, 172925], [140, 173105], [150, 173685], [152, 173805], [155, 173865]]}, {"verse": 27, "start": 174586, "end": 185104, "text": "Al solo Dios sabio, sea gloria por Jesucristo para siempre. Amén. fue escrita de Corinto a los Romanos, enviada por medio de Febe, diaconisa de la iglesia de Cencrea.", "words": [[0, 174586], [3, 174765], [8, 175085], [13, 175505], [20, 176165], [24, 176325], [31, 176805], [35, 177005], [46, 177665], [51, 177845], [60, 178696], [66, 179355], [70, 179500], [78, 179900], [81, 180020], [89, 180460], [91, 180580], [95, 180660], [104, 181300], [112, 181720], [116, 181960], [122, 182240], [125, 182400], [131, 182980], [141, 183680], [144, 183860], [147, 183940], [155, 184340], [158, 184750]]}]}