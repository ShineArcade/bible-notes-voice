{"book": "MAT", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 297650, "verses": [{"verse": 1, "start": 300, "end": 4951, "text": "Y respondiendo Jesús, les volvió a hablar en parábolas, diciendo:", "words": [[0, 300], [2, 446], [15, 1166], [22, 2186], [26, 2306], [33, 2706], [35, 2766], [42, 2946], [45, 3126], [56, 3806]]}, {"verse": 2, "start": 5301, "end": 9984, "text": "El reino de los cielos es semejante a un rey que celebró la boda de su hijo;", "words": [[0, 5301], [3, 5561], [9, 5981], [12, 6101], [16, 6241], [23, 6741], [26, 6921], [36, 7521], [38, 7641], [41, 7741], [45, 8161], [49, 8241], [57, 8761], [60, 8881], [65, 9141], [68, 9321], [71, 9501]]}, {"verse": 3, "start": 10334, "end": 15757, "text": "Y envió sus siervos para que llamasen los invitados a la boda; pero no quisieron venir.", "words": [[0, 10334], [2, 10473], [8, 10853], [12, 11053], [20, 11733], [25, 11958], [29, 12098], [38, 12618], [42, 12758], [52, 13418], [54, 13558], [57, 13638], [63, 14364], [68, 14509], [71, 14649], [81, 15109]]}, {"verse": 4, "start": 16107, "end": 29331, "text": "Volvió a enviar otros siervos, diciendo: Decid a los llamados: He aquí, he preparado mi comida; mis toros y animales engordados son muertos, y todo está listo: venid a las bodas.", "words": [[0, 16107], [7, 16474], [9, 16534], [16, 16814], [22, 17014], [31, 17654], [41, 18839], [47, 19408], [49, 19588], [53, 19728], [63, 20703], [66, 21155], [72, 21815], [75, 21895], [85, 22475], [88, 22615], [96, 23471], [100, 23635], [106, 24175], [108, 24335], [117, 24755], [128, 25575], [132, 25835], [141, 26515], [143, 26850], [148, 27050], [153, 27270], [160, 28108], [166, 28471], [168, 28551], [172, 28691]]}, {"verse": 5, "start": 29681, "end": 35113, "text": "Pero ellos no hicieron caso, y se fueron, uno a su labranza, y otro a sus negocios;", "words": [[0, 29681], [5, 29805], [11, 30025], [14, 30225], [23, 30605], [29, 31005], [31, 31485], [34, 31625], [42, 31965], [46, 32645], [48, 32865], [51, 32945], [61, 33585], [63, 33765], [68, 33945], [70, 34145], [74, 34225]]}, {"verse": 6, "start": 35463, "end": 40396, "text": "Y otros, tomando a sus siervos, los maltrataron y los mataron.", "words": [[0, 35463], [2, 35622], [9, 35942], [17, 36602], [19, 36722], [23, 36882], [32, 38082], [36, 38182], [48, 39082], [50, 39422], [54, 39562]]}, {"verse": 7, "start": 40746, "end": 50517, "text": "Y el rey, oyendo esto, se enojó; y enviando sus ejércitos, destruyó a aquellos asesinos, y puso fuego a su ciudad.", "words": [[0, 40746], [2, 40906], [5, 41046], [10, 41706], [17, 42186], [23, 42626], [26, 43106], [33, 44150], [35, 44257], [44, 44737], [48, 44977], [59, 45957], [68, 47037], [70, 47257], [79, 47597], [89, 48377], [91, 48817], [96, 49177], [102, 49537], [104, 49757], [107, 49897]]}, {"verse": 8, "start": 50867, "end": 59186, "text": "Entonces dice a sus siervos: Las bodas a la verdad están preparadas; pero los que eran llamados no eran dignos.", "words": [[0, 50867], [9, 51575], [14, 52455], [16, 52635], [20, 52755], [29, 53783], [33, 53930], [39, 54410], [41, 54570], [44, 54670], [51, 54930], [57, 55350], [69, 56822], [74, 56966], [78, 57126], [82, 57306], [87, 57506], [96, 57966], [99, 58166], [104, 58366]]}, {"verse": 9, "start": 59536, "end": 64142, "text": "Id pues a los cruces de los caminos, y llamad a las bodas a cuantos encontréis.", "words": [[0, 59660], [3, 59820], [8, 59980], [10, 60260], [14, 60380], [21, 60800], [24, 60920], [28, 61020], [37, 61560], [39, 61747], [46, 61933], [48, 62120], [52, 62300], [58, 62640], [60, 62760], [68, 63140]]}, {"verse": 10, "start": 64492, "end": 73374, "text": "Y saliendo los siervos por los caminos, juntaron a todos los que hallaron, juntamente malos y buenos: y las bodas fueron llenas de invitados.", "words": [[0, 64492], [2, 64599], [11, 65059], [15, 65239], [23, 65659], [27, 65859], [31, 65999], [40, 66519], [49, 67379], [51, 67519], [57, 67879], [61, 68279], [65, 68439], [75, 68939], [86, 69759], [92, 70259], [94, 70379], [102, 71200], [104, 71325], [108, 71465], [114, 71785], [121, 72005], [128, 72425], [131, 72525]]}, {"verse": 11, "start": 73724, "end": 78277, "text": "Y entró el rey para ver los invitados, y vio allí un hombre no vestido de boda.", "words": [[0, 73724], [2, 73867], [8, 74247], [11, 74387], [15, 74667], [20, 74827], [24, 75047], [28, 75187], [39, 75927], [41, 76167], [45, 76407], [50, 76587], [53, 76807], [60, 77067], [63, 77267], [71, 77687], [74, 77827]]}, {"verse": 12, "start": 78627, "end": 85043, "text": "Y le dijo: Amigo, ¿cómo entraste aquí no teniendo vestido de boda? Pero él se quedó sin palabras.", "words": [[0, 78627], [2, 78754], [5, 78834], [11, 79809], [18, 80149], [24, 80269], [33, 80849], [38, 81049], [41, 81422], [50, 81796], [58, 82169], [61, 82309], [67, 83073], [72, 83235], [75, 83535], [78, 83715], [84, 84015], [88, 84175]]}, {"verse": 13, "start": 85393, "end": 97021, "text": "Entonces el rey dijo a los que servían: Atado de pies y de manos tomadle, y echadle en las tinieblas de afuera: allí será el llanto y el crujir de dientes.", "words": [[0, 85393], [9, 86026], [12, 86486], [16, 86846], [21, 87226], [23, 87366], [27, 87466], [31, 87606], [40, 88516], [46, 88985], [49, 89145], [54, 89405], [56, 89585], [59, 89705], [65, 90135], [74, 90565], [76, 90880], [84, 91600], [87, 91860], [91, 92040], [101, 92700], [104, 92800], [112, 93632], [117, 93931], [122, 94131], [125, 94371], [132, 94931], [134, 95351], [137, 95701], [144, 96051], [147, 96191]]}, {"verse": 14, "start": 97371, "end": 100833, "text": "Porque muchos son llamados, y pocos escogidos.", "words": [[0, 97371], [7, 97555], [14, 97855], [18, 98295], [28, 99015], [30, 99415], [36, 99875]]}, {"verse": 15, "start": 101183, "end": 107084, "text": "Entonces, idos los fariseos, consultaron cómo le tomarían en alguna palabra.", "words": [[0, 101183], [10, 101640], [15, 102440], [19, 102700], [29, 103580], [41, 104620], [46, 104960], [49, 105140], [58, 105800], [61, 106060], [68, 106340]]}, {"verse": 16, "start": 107434, "end": 121680, "text": "Y envían a él los discípulos de ellos, con los Herodianos, diciendo: Maestro, sabemos que eres sincero, y que enseñas con verdad el camino de Dios, y que no te dejas influir por nadie, porque no muestras favoritismo.", "words": [[0, 107434], [2, 107722], [9, 108202], [11, 108342], [14, 108582], [18, 108902], [29, 109582], [32, 109762], [39, 110102], [43, 110622], [47, 110842], [59, 111702], [69, 112909], [78, 113473], [86, 113753], [90, 114093], [95, 114213], [104, 115153], [106, 115293], [110, 115393], [118, 115913], [122, 116053], [129, 116413], [132, 116633], [139, 116913], [142, 117153], [148, 117433], [150, 117933], [154, 118053], [157, 118193], [160, 118353], [166, 118653], [174, 119133], [178, 119293], [185, 119693], [192, 120153], [195, 120353], [204, 120813]]}, {"verse": 17, "start": 122030, "end": 126275, "text": "Dinos pues, ¿qué te parece? ¿es lícito dar tributo a César, o no?", "words": [[0, 122030], [6, 122357], [12, 122797], [17, 122877], [20, 123017], [28, 123836], [32, 123980], [39, 124380], [43, 124780], [51, 125180], [53, 125280], [60, 125720], [62, 125980]]}, {"verse": 18, "start": 126555, "end": 131935, "text": "Pero Jesús, entendida la malicia de ellos, les dice: ¿Por qué me tentáis, hipócritas?", "words": [[0, 126555], [5, 126701], [12, 127281], [22, 127921], [25, 128081], [33, 128521], [36, 128701], [43, 129241], [47, 129341], [53, 130052], [58, 130174], [62, 130421], [65, 130667], [74, 130914]]}, {"verse": 19, "start": 132285, "end": 137286, "text": "Mostradme la moneda del tributo. Y ellos le presentaron un denario.", "words": [[0, 132560], [10, 132870], [13, 132990], [20, 133350], [24, 133550], [33, 134583], [35, 134843], [41, 135203], [44, 135603], [56, 136283], [59, 136603]]}, {"verse": 20, "start": 137636, "end": 142244, "text": "Entonces les dice: ¿De quién son esta imagen y esta inscripción?", "words": [[0, 137636], [9, 138024], [13, 138324], [19, 139085], [23, 139231], [29, 139451], [33, 139791], [38, 140031], [45, 140511], [47, 140851], [52, 141091]]}, {"verse": 21, "start": 142594, "end": 150656, "text": "Le dicen: De César. Y les dice: Pagad pues a César lo que es de César, y a Dios lo que es de Dios.", "words": [[0, 142594], [3, 142739], [10, 143656], [13, 143799], [20, 144678], [22, 144772], [26, 144902], [32, 145652], [38, 146070], [43, 146230], [45, 146450], [51, 146930], [54, 147310], [58, 147470], [61, 147630], [64, 147750], [71, 148370], [73, 148590], [75, 148730], [80, 148950], [83, 149570], [87, 149730], [90, 149950], [93, 150070]]}, {"verse": 22, "start": 151006, "end": 155525, "text": "Y oyendo esto, se maravillaron; y dejándole se fueron.", "words": [[0, 151006], [2, 151329], [9, 151709], [15, 152489], [18, 152649], [32, 153933], [34, 154285], [44, 154675], [47, 154875]]}, {"verse": 23, "start": 155875, "end": 162401, "text": "Aquel día llegaron a él los saduceos, que dicen no haber resurrección, y le preguntaron,", "words": [[0, 155875], [6, 156216], [10, 156436], [19, 156996], [21, 157096], [24, 157296], [28, 157696], [38, 158876], [42, 159071], [48, 159371], [51, 159771], [57, 160051], [71, 161171], [73, 161386], [76, 161486]]}, {"verse": 24, "start": 162751, "end": 171280, "text": "Diciendo: Maestro, Moisés dijo: Si alguno muere sin hijos, su hermano se casará con su mujer, y levantará descendencia a su hermano.", "words": [[0, 162751], [10, 163728], [19, 164173], [26, 164613], [32, 165482], [35, 165623], [42, 166023], [48, 166303], [52, 166543], [59, 167283], [62, 167363], [70, 167803], [73, 167923], [80, 168323], [84, 168503], [87, 168663], [94, 169003], [96, 169423], [106, 170013], [119, 170603], [121, 170703], [124, 170783]]}, {"verse": 25, "start": 171630, "end": 179502, "text": "Hubo pues, entre nosotros siete hermanos: y el primero tomó mujer, y murió; y no teniendo descendencia, dejó su mujer a su hermano.", "words": [[0, 171630], [5, 172090], [11, 172270], [17, 172530], [26, 172850], [32, 173330], [42, 174291], [44, 174397], [47, 174497], [55, 174837], [60, 175197], [67, 175517], [69, 175957], [76, 176632], [78, 176737], [81, 176837], [90, 177277], [104, 178057], [109, 178397], [112, 178497], [118, 178797], [120, 178917], [123, 178997]]}, {"verse": 26, "start": 179852, "end": 183561, "text": "De la misma manera también el segundo, y el tercero, hasta los siete.", "words": [[0, 179852], [3, 179978], [6, 180078], [12, 180278], [19, 180698], [27, 180958], [30, 181218], [39, 181578], [41, 181918], [44, 182018], [53, 182598], [59, 182878], [63, 183058]]}, {"verse": 27, "start": 183911, "end": 186111, "text": "Y después de todos murió también la mujer.", "words": [[0, 183911], [2, 184020], [10, 184300], [13, 184520], [19, 184740], [25, 185200], [33, 185420], [36, 185640]]}, {"verse": 28, "start": 186461, "end": 191801, "text": "En la resurrección pues, ¿de cuál de los siete será ella mujer? porque todos la tuvieron.", "words": [[0, 186461], [3, 186585], [6, 186705], [19, 187345], [25, 188245], [29, 188325], [34, 188545], [37, 188705], [41, 188845], [47, 189085], [52, 189405], [57, 189645], [64, 190444], [71, 190611], [77, 190911], [80, 191191]]}, {"verse": 29, "start": 192081, "end": 199245, "text": "Entonces respondiendo Jesús, les dijo: Erráis ignorando las Escrituras, y el poder de Dios.", "words": [[0, 192081], [9, 192964], [22, 193617], [29, 193957], [33, 194377], [39, 195125], [46, 195760], [56, 196620], [60, 196840], [72, 197540], [74, 197840], [77, 197980], [83, 198340], [86, 198580]]}, {"verse": 30, "start": 199595, "end": 208924, "text": "Porque en la resurrección, ni se casarán ni se darán en casamiento; sino que son como los ángeles de Dios en el cielo.", "words": [[0, 199595], [7, 199979], [10, 200319], [13, 200459], [27, 201339], [30, 202219], [33, 202399], [41, 203009], [44, 203619], [47, 203759], [53, 204139], [56, 204299], [68, 205595], [73, 205832], [77, 206052], [81, 206292], [86, 206592], [90, 206772], [98, 207332], [101, 207532], [106, 207792], [109, 208152], [112, 208292]]}, {"verse": 31, "start": 209274, "end": 215832, "text": "Y de la resurrección de los muertos, ¿no habéis leído lo que os es dicho por Dios, que dice:", "words": [[0, 209274], [2, 209482], [5, 209622], [8, 209802], [21, 210762], [24, 210902], [28, 211042], [37, 212197], [41, 212497], [48, 212877], [54, 213417], [57, 213617], [61, 213797], [64, 213937], [67, 214077], [73, 214397], [77, 214677], [83, 214937], [87, 215357]]}, {"verse": 32, "start": 216182, "end": 224466, "text": "Yo soy el Dios de Abraham, y el Dios de Isaac, y el Dios de Jacob? Dios no es Dios de muertos, sino de vivos.", "words": [[0, 216182], [3, 216386], [7, 216706], [10, 216926], [15, 217166], [18, 217386], [27, 217826], [29, 218361], [32, 218521], [37, 218781], [40, 219001], [47, 219541], [49, 220106], [52, 220266], [57, 220506], [60, 220666], [67, 221459], [72, 221726], [75, 222166], [78, 222386], [83, 222606], [86, 222806], [95, 223526], [100, 223846], [103, 224046]]}, {"verse": 33, "start": 224816, "end": 228161, "text": "Y oyendo esto la gente se admiraba de su doctrina.", "words": [[0, 224816], [2, 224966], [9, 225326], [14, 225606], [17, 225806], [23, 226126], [26, 226426], [35, 227046], [38, 227206], [41, 227386]]}, {"verse": 34, "start": 228511, "end": 235678, "text": "Entonces los fariseos, oyendo que había hecho callar a los saduceos, se juntaron a una.", "words": [[0, 228511], [9, 229247], [13, 229747], [23, 230967], [30, 231327], [34, 231547], [40, 231767], [46, 232087], [53, 232527], [55, 232627], [59, 232807], [69, 234127], [72, 234367], [81, 234927], [83, 235167]]}, {"verse": 35, "start": 236028, "end": 241479, "text": "Y preguntó uno de ellos, experto en la ley, tentándole y diciendo:", "words": [[0, 236028], [2, 236133], [11, 236793], [15, 237133], [18, 237313], [25, 237933], [33, 238653], [36, 238793], [39, 238953], [44, 239593], [55, 240473], [57, 240753]]}, {"verse": 36, "start": 241679, "end": 244438, "text": "Maestro, ¿cuál es el mandamiento grande en la ley?", "words": [[0, 241679], [9, 242478], [15, 242718], [18, 242838], [21, 242958], [33, 243498], [40, 243798], [43, 244038], [46, 244138]]}, {"verse": 37, "start": 244718, "end": 252389, "text": "Y Jesús le dijo: Amarás al Señor tu Dios de todo tu corazón, y de toda tu alma, y de toda tu mente.", "words": [[0, 244718], [2, 244866], [8, 245206], [11, 245546], [17, 246288], [24, 246794], [27, 246974], [33, 247294], [36, 247614], [41, 247994], [44, 248514], [49, 248774], [52, 249014], [61, 249474], [63, 249994], [66, 250114], [71, 250314], [74, 250614], [80, 250934], [82, 251234], [85, 251334], [90, 251574], [93, 251794]]}, {"verse": 38, "start": 252739, "end": 255686, "text": "Este es el primero y el grande mandamiento.", "words": [[0, 252739], [5, 253063], [8, 253263], [11, 253383], [19, 253803], [21, 254223], [24, 254715], [31, 255208]]}, {"verse": 39, "start": 256036, "end": 261219, "text": "Y el segundo es semejante a este: Amarás a tu prójimo como a ti mismo.", "words": [[0, 256036], [2, 256177], [5, 256297], [13, 256717], [16, 257057], [26, 257737], [28, 257937], [34, 258693], [41, 259188], [43, 259328], [46, 259488], [54, 260108], [59, 260348], [61, 260528], [64, 260628]]}, {"verse": 40, "start": 261569, "end": 265708, "text": "De estos dos mandamientos depende toda la ley y los profetas.", "words": [[0, 261569], [3, 261735], [9, 261975], [13, 262215], [26, 262915], [34, 263275], [39, 263835], [42, 264155], [46, 264435], [48, 264615], [52, 264775]]}, {"verse": 41, "start": 266058, "end": 269349, "text": "Y estando juntos los fariseos, Jesús les preguntó,", "words": [[0, 266058], [2, 266155], [10, 266515], [17, 266855], [21, 267115], [31, 268135], [37, 268395], [41, 268655]]}, {"verse": 42, "start": 269699, "end": 275494, "text": "Diciendo: ¿Qué os parece del Cristo? ¿de quién es Hijo? Le dicen: De David.", "words": [[0, 269699], [10, 270696], [15, 270799], [18, 270919], [25, 271279], [29, 271519], [37, 272524], [41, 272669], [47, 272849], [50, 273089], [56, 273834], [59, 273980], [66, 274897], [69, 275080]]}, {"verse": 43, "start": 275774, "end": 280284, "text": "Él les dice: ¿Pues cómo David en Espíritu le llama Señor, diciendo:", "words": [[0, 275774], [3, 275979], [7, 276099], [13, 276935], [19, 277199], [24, 277499], [30, 277799], [33, 277979], [42, 278559], [45, 278659], [51, 278859], [58, 279679]]}, {"verse": 44, "start": 280634, "end": 287677, "text": "Dijo el Señor a mi Señor: Siéntate a mi derecha, entre tanto que pongo tus enemigos por estrado de tus pies?", "words": [[0, 280634], [5, 280901], [8, 281101], [14, 281361], [16, 281601], [19, 281721], [26, 282545], [35, 283051], [37, 283171], [40, 283311], [49, 284171], [55, 284411], [61, 284771], [65, 285011], [71, 285371], [75, 285571], [84, 286071], [88, 286371], [96, 286751], [99, 286931], [103, 287091]]}, {"verse": 45, "start": 288027, "end": 290974, "text": "Pues si David le llama Señor, ¿cómo es su Hijo?", "words": [[0, 288027], [5, 288169], [8, 288349], [14, 288569], [17, 288849], [23, 289149], [30, 289949], [36, 290109], [39, 290349], [42, 290509]]}, {"verse": 46, "start": 291324, "end": 297250, "text": "Y nadie le podía responder palabra; ni se atrevió alguno desde aquel día a preguntarle más.", "words": [[0, 291324], [2, 291453], [8, 291753], [11, 291993], [17, 292293], [27, 292833], [36, 293936], [39, 294116], [42, 294276], [50, 294776], [57, 295256], [63, 295396], [69, 295776], [73, 295976], [75, 296136], [87, 296676]]}]}