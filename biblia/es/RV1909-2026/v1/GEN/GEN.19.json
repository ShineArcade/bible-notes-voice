{"book": "GEN", "chapter": 19, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 381392, "verses": [{"verse": 1, "start": 300, "end": 15113, "text": "Llegaron, pues, los dos ángeles a Sodoma a la caída de la tarde: y Lot estaba sentado a la puerta de Sodoma. Y viéndolos Lot, se levantó a recibirlos, y se inclinó hacia el suelo;", "words": [[0, 300], [10, 805], [16, 1125], [20, 1905], [24, 2125], [32, 2825], [34, 3165], [41, 3725], [43, 3925], [46, 4025], [52, 4505], [55, 4705], [58, 4825], [65, 5710], [67, 5840], [71, 6080], [78, 6720], [86, 7360], [88, 7460], [91, 7540], [98, 7840], [101, 8100], [109, 9118], [111, 9242], [121, 9862], [126, 10262], [129, 10982], [137, 11542], [139, 11642], [151, 12602], [153, 13142], [156, 13542], [164, 13942], [170, 14202], [173, 14522]]}, {"verse": 2, "start": 15563, "end": 31040, "text": "Y dijo: Ahora, pues, mis señores, os ruego que vengáis a casa de vuestro siervo y os hospedéis, y lavaréis vuestros pies: y por la mañana os levantaréis, y seguiréis vuestro camino. Y ellos respondieron: No, que en la plaza nos quedaremos esta noche.", "words": [[0, 15563], [2, 15707], [8, 16447], [15, 16684], [21, 17064], [25, 17144], [34, 17904], [37, 18004], [43, 18384], [47, 18544], [55, 19024], [57, 19144], [62, 19384], [65, 19584], [73, 19924], [80, 20384], [82, 20504], [85, 20624], [96, 21204], [98, 21484], [107, 21904], [116, 22284], [122, 23135], [124, 23234], [128, 23374], [131, 23494], [138, 23814], [141, 24114], [154, 24874], [156, 25114], [166, 25534], [174, 25854], [182, 26730], [184, 26914], [190, 27254], [204, 28920], [208, 29078], [212, 29218], [215, 29278], [218, 29378], [224, 29698], [228, 29818], [239, 30278], [244, 30558]]}, {"verse": 3, "start": 31390, "end": 41749, "text": "Mas él insistió tanto, y fueron con él, y entraron en su casa; y les hizo banquete, y coció panes sin levadura, y comieron.", "words": [[0, 31390], [4, 31598], [7, 31978], [16, 32758], [23, 33178], [25, 33378], [32, 33618], [36, 33898], [40, 34178], [42, 34838], [51, 35478], [54, 35638], [57, 35758], [63, 36643], [65, 36787], [69, 36947], [74, 37167], [84, 37847], [86, 38447], [92, 38807], [98, 39407], [102, 39627], [112, 40267], [114, 40967]]}, {"verse": 4, "start": 42199, "end": 53918, "text": "Y antes que se acostasen, rodearon la casa los hombres de la ciudad, los varones de Sodoma, todo el pueblo junto, desde el más joven hasta el más viejo;", "words": [[0, 42199], [2, 42343], [8, 42543], [12, 42723], [15, 42883], [26, 43743], [35, 44703], [38, 44943], [43, 45343], [47, 46043], [55, 46483], [58, 46683], [61, 46783], [69, 47763], [73, 48023], [81, 48403], [84, 48583], [92, 49703], [97, 49963], [100, 50183], [107, 50483], [114, 51663], [120, 51963], [123, 52223], [127, 52403], [133, 52803], [139, 53023], [142, 53143], [146, 53303]]}, {"verse": 5, "start": 54368, "end": 62533, "text": "Y llamaron a Lot, y le dijeron: ¿Dónde están los varones que vinieron a ti esta noche? sácanoslos, para que los conozcamos.", "words": [[0, 54368], [2, 54493], [11, 54953], [13, 55232], [18, 55493], [20, 56052], [23, 56192], [32, 57212], [39, 57538], [45, 57798], [49, 57978], [57, 58358], [61, 58558], [70, 58938], [72, 59098], [75, 59258], [80, 59498], [87, 60719], [99, 61099], [104, 61399], [108, 61539], [112, 61659]]}, {"verse": 6, "start": 62883, "end": 68520, "text": "Entonces Lot salió a ellos a la puerta, y cerró las puertas tras sí,", "words": [[0, 62883], [9, 63384], [13, 64084], [19, 64764], [21, 64964], [27, 65264], [29, 65604], [32, 65704], [40, 66124], [42, 66884], [48, 67284], [52, 67444], [60, 67810], [65, 68175]]}, {"verse": 7, "start": 68970, "end": 72555, "text": "Y dijo: Os ruego, hermanos míos, que no hagáis tal maldad.", "words": [[0, 68970], [2, 69114], [8, 69853], [11, 69977], [18, 70297], [27, 70757], [33, 71137], [37, 71277], [40, 71437], [47, 71737], [51, 71937]]}, {"verse": 8, "start": 73005, "end": 84382, "text": "He aquí ahora yo tengo dos hijas que son vírgenes; os las sacaré afuera, y haced de ellas como bien os parezca: solamente a estos varones no hagáis nada, pues que vinieron a la sombra de mi tejado.", "words": [[0, 73036], [3, 73106], [8, 73286], [14, 73526], [17, 73746], [23, 74046], [27, 74306], [33, 74666], [37, 74766], [41, 74946], [51, 75995], [54, 76109], [58, 76259], [65, 76679], [73, 77099], [75, 77239], [81, 77519], [84, 77699], [90, 77899], [95, 78179], [100, 78399], [103, 78539], [112, 79988], [122, 80561], [124, 80701], [130, 80881], [138, 81321], [141, 81561], [148, 81861], [154, 82401], [159, 82501], [163, 82681], [172, 83061], [174, 83181], [177, 83281], [184, 83681], [187, 83801], [190, 83881]]}, {"verse": 9, "start": 84732, "end": 102888, "text": "Y ellos respondieron: Quita allá: y añadieron: Vino este aquí para habitar como un extraño, ¿y habrá de erigirse en juez? Ahora te haremos más mal que a ellos. Y hacían gran violencia al varón, a Lot, y se acercaron para romper las puertas.", "words": [[0, 84732], [2, 84916], [8, 85256], [22, 87129], [28, 87373], [34, 87912], [36, 88080], [47, 89172], [52, 89435], [57, 89695], [62, 89955], [67, 90195], [75, 90615], [80, 90855], [83, 91035], [92, 91615], [95, 92135], [101, 92455], [104, 92535], [113, 92995], [116, 93155], [122, 93950], [128, 94192], [131, 94352], [139, 94672], [143, 94932], [147, 95212], [151, 95412], [153, 95512], [160, 96421], [162, 96542], [169, 96982], [174, 97242], [184, 97962], [187, 98142], [194, 98755], [196, 99369], [201, 99982], [203, 100082], [206, 100202], [216, 100982], [221, 101262], [228, 101862], [232, 102022]]}, {"verse": 10, "start": 103338, "end": 110577, "text": "Entonces los varones alargaron la mano, y metieron a Lot en casa con ellos, y cerraron las puertas.", "words": [[0, 103338], [9, 103863], [13, 104343], [21, 104723], [31, 105423], [34, 105563], [40, 105903], [42, 106283], [51, 106783], [53, 107063], [57, 107223], [60, 107523], [65, 107863], [69, 108183], [76, 108503], [78, 108983], [87, 109643], [91, 109783]]}, {"verse": 11, "start": 111027, "end": 120304, "text": "Y a los hombres que estaban a la puerta de la casa desde el menor hasta el mayor, hirieron con ceguera; mas ellos no podían encontrar la puerta.", "words": [[0, 111027], [2, 111150], [4, 111230], [8, 111350], [16, 111730], [20, 111930], [28, 112210], [30, 112370], [33, 112510], [40, 112770], [43, 113030], [46, 113150], [51, 113410], [57, 113690], [60, 113910], [66, 114270], [72, 114930], [75, 115110], [82, 115717], [91, 116325], [95, 116932], [104, 117793], [108, 117853], [114, 118093], [117, 118333], [124, 118753], [134, 119173], [137, 119513]]}, {"verse": 12, "start": 120754, "end": 129608, "text": "Y dijeron los varones a Lot: ¿Tienes aquí alguno más? Yernos, y tus hijos y tus hijas, y todo lo que tienes en la ciudad, saca lo de este lugar:", "words": [[0, 120754], [2, 120894], [10, 121314], [14, 121434], [22, 121814], [24, 121994], [29, 122644], [37, 122959], [42, 123179], [49, 123619], [54, 124374], [62, 124872], [64, 124972], [68, 125112], [74, 125392], [76, 125612], [80, 125752], [87, 126452], [89, 126632], [94, 126812], [97, 127012], [101, 127132], [108, 127392], [111, 127572], [114, 127672], [122, 128045], [127, 128419], [130, 128792], [133, 128912], [138, 129112]]}, {"verse": 13, "start": 130058, "end": 138390, "text": "Porque vamos a destruir este lugar, por cuanto el clamor de ellos ha subido de punto delante de Jehová; por tanto Jehová nos ha enviado para destruirlo.", "words": [[0, 130058], [7, 130267], [13, 130527], [15, 130747], [24, 131267], [29, 131447], [36, 131807], [40, 132107], [47, 132347], [50, 132527], [57, 132927], [60, 133087], [66, 133307], [69, 133527], [76, 133907], [79, 134027], [85, 134307], [93, 134787], [96, 134927], [104, 135722], [108, 135823], [114, 136223], [121, 136663], [125, 136783], [128, 136963], [136, 137383], [141, 137583]]}, {"verse": 14, "start": 138740, "end": 153569, "text": "Entonces salió Lot, y habló a sus yernos, los que habían de tomar sus hijas, y les dijo: Levantaos, salid de este lugar; porque Jehová va a destruir esta ciudad. Mas pareció a sus yernos como que se burlaba.", "words": [[0, 138740], [9, 139268], [15, 139968], [20, 140288], [22, 141028], [28, 141388], [30, 141488], [34, 141668], [42, 142198], [46, 142728], [50, 142888], [57, 143108], [60, 143288], [66, 143528], [70, 144068], [77, 144608], [79, 144868], [83, 145028], [89, 145811], [100, 146242], [106, 146712], [109, 146932], [114, 147112], [121, 147900], [128, 148103], [135, 148563], [138, 148623], [140, 148743], [149, 149263], [154, 149443], [162, 150294], [166, 150451], [174, 151071], [176, 151231], [180, 151661], [187, 152091], [192, 152411], [196, 152591], [199, 152751]]}, {"verse": 15, "start": 154019, "end": 165741, "text": "Y al rayar el alba, los ángeles daban prisa a Lot, diciendo: Levántate, toma tu mujer, y tus dos hijas que se hallan aquí, porque no perezcas en el castigo de la ciudad.", "words": [[0, 154019], [2, 154127], [5, 154447], [11, 154767], [14, 154907], [20, 155807], [24, 155947], [32, 156527], [38, 157047], [44, 157487], [46, 157707], [51, 157967], [61, 159543], [72, 160400], [77, 160560], [80, 160740], [87, 161080], [89, 161580], [93, 161760], [97, 161940], [103, 162460], [107, 162580], [110, 162720], [117, 162980], [123, 163440], [130, 163760], [133, 164080], [142, 164400], [145, 164580], [148, 164660], [156, 165080], [159, 165180], [162, 165280]]}, {"verse": 16, "start": 166091, "end": 181363, "text": "Y deteniéndose él, los varones asieron de su mano, y de la mano de su mujer, y de las manos de sus dos hijas, según la misericordia de Jehová para con él; y le sacaron, y le pusieron fuera de la ciudad.", "words": [[0, 166091], [2, 166237], [15, 167177], [19, 167597], [23, 167797], [31, 168917], [39, 169557], [42, 169757], [45, 169917], [51, 170297], [53, 171057], [56, 171177], [59, 171317], [64, 171617], [67, 171797], [70, 171957], [77, 172397], [79, 173077], [82, 173177], [86, 173357], [92, 173737], [95, 173917], [99, 174097], [103, 174337], [110, 175422], [116, 175684], [119, 175944], [132, 176824], [135, 176924], [142, 177464], [147, 177644], [151, 177884], [155, 178585], [157, 178711], [160, 178811], [169, 179411], [171, 179671], [174, 179771], [183, 180251], [189, 180511], [192, 180731], [195, 180831]]}, {"verse": 17, "start": 181813, "end": 192607, "text": "Y aconteció que cuando los hubo sacado fuera, dijo: Escapa por tu vida; no mires tras ti, ni pares en toda esta llanura; escapa al monte, no sea que perezcas.", "words": [[0, 181813], [2, 182080], [12, 182760], [16, 182940], [23, 183200], [27, 183420], [32, 183790], [39, 184160], [46, 184420], [52, 185344], [59, 185883], [63, 186063], [66, 186223], [72, 186983], [75, 187128], [81, 187468], [86, 187608], [90, 188148], [93, 188468], [99, 188828], [102, 188948], [107, 189108], [112, 189348], [121, 190260], [128, 190685], [131, 190825], [138, 191405], [141, 191505], [145, 191685], [149, 191865]]}, {"verse": 18, "start": 192957, "end": 196767, "text": "Y Lot les dijo: No, yo os ruego, señores míos;", "words": [[0, 192957], [2, 193118], [6, 193338], [10, 193798], [16, 194717], [20, 194935], [23, 195215], [26, 195455], [33, 195795], [41, 196235]]}, {"verse": 19, "start": 197217, "end": 209447, "text": "He aquí ahora ha hallado tu siervo gracia en tus ojos, y has engrandecido tu misericordia que has hecho conmigo dándome la vida; mas yo no podré escapar al monte, no sea caso que me alcance el mal, y muera.", "words": [[0, 197217], [3, 197341], [8, 197701], [14, 197871], [17, 198041], [25, 198401], [28, 198561], [35, 198981], [42, 199421], [45, 199521], [49, 199681], [55, 200041], [57, 200561], [61, 200761], [74, 201481], [77, 201601], [90, 202461], [94, 202601], [98, 202781], [104, 203001], [112, 203481], [120, 203941], [123, 204101], [129, 204832], [133, 204993], [136, 205133], [139, 205253], [145, 205613], [153, 206013], [156, 206153], [163, 206893], [166, 206973], [170, 207173], [175, 207493], [179, 207693], [182, 207833], [190, 208293], [193, 208453], [198, 208673], [200, 208993]]}, {"verse": 20, "start": 209897, "end": 218424, "text": "He aquí ahora esta ciudad está cerca para huir allá, la cual es pequeña; escaparé ahora allá, (¿no es ella pequeña?) y salvaré mi vida.", "words": [[0, 209934], [3, 210014], [8, 210194], [14, 210494], [19, 210794], [26, 211134], [31, 211434], [37, 211814], [42, 212114], [47, 212414], [53, 213014], [56, 213094], [61, 213294], [64, 213494], [73, 214372], [82, 214951], [88, 215411], [94, 215871], [99, 216011], [102, 216191], [107, 216331], [117, 216811], [119, 217471], [127, 217931], [130, 217991]]}, {"verse": 21, "start": 218774, "end": 224545, "text": "Y le respondió: También he aceptado tu petición, y no destruiré la ciudad de que has hablado.", "words": [[0, 218774], [2, 218919], [5, 219059], [16, 220188], [24, 220527], [27, 220727], [36, 221227], [39, 221347], [49, 221987], [51, 222287], [54, 222407], [64, 223027], [67, 223127], [74, 223407], [77, 223727], [81, 223867], [85, 224007]]}, {"verse": 22, "start": 224995, "end": 233012, "text": "Date prisa, escápate allá; porque nada podré hacer hasta que allí hayas llegado. Por esto fue llamado el nombre de la ciudad, Zoar.", "words": [[0, 224995], [5, 225182], [12, 225842], [21, 226302], [27, 227016], [34, 227174], [39, 227474], [45, 227774], [51, 228114], [57, 228334], [61, 228494], [66, 228734], [72, 229054], [81, 229870], [85, 229995], [90, 230235], [94, 230495], [102, 230815], [105, 231055], [112, 231395], [115, 231595], [118, 231715], [126, 232399]]}, {"verse": 23, "start": 233462, "end": 237939, "text": "El sol salía sobre la tierra, cuando Lot llegó a Zoar.", "words": [[0, 233462], [3, 233766], [7, 234066], [13, 234686], [19, 234966], [22, 235186], [30, 235506], [37, 236246], [41, 236606], [47, 237046], [49, 237518]]}, {"verse": 24, "start": 238389, "end": 246790, "text": "Entonces llovió Jehová sobre Sodoma y sobre Gomorra azufre y fuego de parte de Jehová desde los cielos;", "words": [[0, 238389], [9, 239366], [16, 240026], [23, 240526], [29, 240746], [36, 241386], [38, 241526], [44, 241766], [52, 242646], [59, 243526], [61, 243986], [67, 244366], [70, 244606], [76, 244926], [79, 245166], [86, 245666], [92, 245766], [96, 246046]]}, {"verse": 25, "start": 247240, "end": 255893, "text": "Y destruyó las ciudades, y toda aquella llanura, con todos los moradores de aquellas ciudades, y el fruto de la tierra.", "words": [[0, 247240], [2, 247401], [11, 248181], [15, 248341], [25, 249121], [27, 249521], [32, 249961], [40, 250541], [49, 251061], [53, 251321], [59, 251761], [63, 252061], [73, 252661], [76, 252861], [85, 253301], [95, 254101], [97, 254281], [100, 254461], [106, 254981], [109, 255101], [112, 255221]]}, {"verse": 26, "start": 256343, "end": 262557, "text": "Entonces la mujer de Lot miró atrás, a espaldas de él, y se volvió estatua de sal.", "words": [[0, 256343], [9, 256848], [12, 257128], [18, 257488], [21, 257648], [25, 257928], [30, 258608], [37, 259448], [39, 259568], [48, 260128], [51, 260648], [55, 261168], [57, 261288], [60, 261428], [67, 261710], [75, 261992], [78, 262274]]}, {"verse": 27, "start": 263007, "end": 269724, "text": "Y subió Abraham por la mañana al lugar donde había estado delante de Jehová:", "words": [[0, 263776], [2, 264336], [8, 265076], [16, 265556], [20, 265976], [23, 266136], [30, 266596], [33, 267056], [39, 267336], [45, 267656], [51, 267956], [58, 268316], [66, 268876], [69, 269056]]}, {"verse": 28, "start": 270174, "end": 280856, "text": "Y miró hacia Sodoma y Gomorra, y hacia toda la tierra de aquella llanura miró; y he aquí que el humo subía de la tierra como el humo de un horno.", "words": [[0, 270174], [2, 270356], [7, 270716], [13, 271116], [20, 271836], [22, 272016], [31, 272696], [33, 273276], [39, 273516], [44, 273936], [47, 274196], [54, 274536], [57, 274876], [65, 275256], [73, 275716], [79, 276658], [81, 276768], [84, 276988], [89, 277288], [93, 277508], [96, 277708], [101, 277968], [107, 278368], [110, 278488], [113, 278608], [120, 278968], [125, 279348], [128, 279588], [133, 279948], [136, 280048], [139, 280248]]}, {"verse": 29, "start": 281306, "end": 295423, "text": "Así fue que, cuando destruyó Dios las ciudades de la llanura, se acordó Dios de Abraham, y envió fuera a Lot de en medio de la destrucción, al asolar las ciudades donde Lot estaba.", "words": [[0, 281306], [4, 281605], [8, 281905], [13, 282105], [20, 282405], [29, 283245], [34, 283565], [38, 284065], [47, 284665], [50, 284805], [53, 284925], [62, 285845], [65, 286145], [72, 286585], [77, 286925], [80, 287125], [89, 287625], [91, 288225], [97, 288645], [103, 289045], [105, 289365], [109, 289645], [112, 290145], [115, 290425], [121, 290785], [124, 290985], [127, 291105], [140, 292653], [143, 292913], [150, 293173], [154, 293493], [163, 294133], [169, 294383], [173, 294633]]}, {"verse": 30, "start": 295873, "end": 306904, "text": "Pero Lot subió de Zoar, y moró en el monte, y sus dos hijas con él; porque tuvo miedo de quedar en Zoar, y se alojó en una cueva él y sus dos hijas.", "words": [[0, 296013], [5, 296187], [9, 296360], [15, 297060], [18, 297390], [24, 297720], [26, 298220], [31, 298520], [34, 298620], [37, 298740], [44, 299140], [46, 299640], [50, 299800], [54, 300060], [60, 300600], [64, 300800], [68, 301490], [75, 301694], [80, 301974], [86, 302394], [89, 302594], [96, 302834], [99, 303264], [105, 303694], [107, 303814], [110, 303954], [116, 304394], [119, 304494], [123, 304674], [129, 305114], [132, 305414], [134, 305654], [138, 305854], [142, 306114]]}, {"verse": 31, "start": 307354, "end": 316737, "text": "Entonces la mayor dijo a la menor: Nuestro padre es viejo, y no queda varón en la tierra que entre a nosotras conforme a la costumbre de toda la tierra:", "words": [[0, 307354], [9, 308279], [12, 308399], [18, 308739], [23, 309079], [25, 309259], [28, 309339], [35, 310131], [43, 310519], [49, 310819], [52, 311119], [59, 311839], [61, 312099], [64, 312219], [70, 312439], [76, 312879], [79, 312999], [82, 313099], [89, 313359], [93, 313599], [99, 313739], [101, 313879], [110, 314519], [119, 315099], [121, 315139], [124, 315199], [134, 315759], [137, 315879], [142, 316059], [145, 316239]]}, {"verse": 32, "start": 317187, "end": 323857, "text": "Ven, demos a beber vino a nuestro padre, y durmamos con él, y conservaremos de nuestro padre descendencia.", "words": [[0, 317354], [5, 317520], [11, 317687], [13, 317887], [19, 318047], [24, 318387], [26, 318527], [34, 318707], [41, 319087], [43, 319527], [52, 319967], [56, 320207], [60, 320387], [62, 320727], [76, 321407], [79, 321607], [87, 321727], [93, 322830]]}, {"verse": 33, "start": 324207, "end": 334830, "text": "Y dieron a beber vino a su padre aquella noche: y entró la mayor, y durmió con su padre; mas él no sintió cuándo se acostó ella, ni cuándo se levantó.", "words": [[0, 324207], [2, 324414], [9, 324654], [11, 324814], [17, 325014], [22, 325394], [24, 325574], [27, 325714], [33, 326134], [41, 326554], [48, 327472], [50, 327620], [56, 328000], [59, 328140], [66, 328520], [68, 328980], [75, 329480], [79, 329660], [82, 329840], [89, 330792], [93, 331001], [96, 331221], [99, 331701], [106, 332241], [113, 332681], [116, 332781], [123, 333091], [129, 333401], [132, 333621], [139, 334001], [142, 334081]]}, {"verse": 34, "start": 335280, "end": 350162, "text": "El día siguiente dijo la mayor a la menor: He aquí yo dormí la noche pasada con mi padre; démosle a beber vino también esta noche, y entra y duerme con él, para que conservemos la descendencia de nuestro padre.", "words": [[0, 335280], [3, 335419], [7, 335599], [17, 336139], [22, 336779], [25, 337059], [31, 337439], [33, 337799], [36, 337899], [43, 338653], [46, 338801], [51, 339521], [54, 339661], [60, 340101], [63, 340181], [69, 340461], [76, 341001], [80, 341181], [83, 341341], [90, 342159], [98, 342683], [100, 342763], [106, 342963], [111, 343283], [119, 343623], [124, 343943], [131, 344323], [133, 344723], [139, 345123], [141, 345263], [148, 345583], [152, 345843], [156, 346063], [161, 346443], [165, 346603], [177, 347283], [180, 347443], [193, 348203], [196, 348323], [204, 348503]]}, {"verse": 35, "start": 350512, "end": 360981, "text": "Y dieron a beber vino a su padre también aquella noche: y se levantó la menor, y durmió con él; pero no echó de ver cuándo se acostó ella, ni cuándo se levantó.", "words": [[0, 350512], [2, 350629], [9, 350969], [11, 351109], [17, 351309], [22, 351649], [24, 351789], [27, 351889], [33, 352209], [41, 352569], [49, 353029], [56, 353922], [58, 354030], [61, 354130], [69, 354650], [72, 354750], [79, 355010], [81, 355550], [88, 356010], [92, 356190], [96, 356872], [101, 357036], [104, 357236], [109, 357536], [112, 357656], [116, 357836], [123, 358276], [126, 358396], [133, 358976], [139, 359176], [142, 359496], [149, 360116], [152, 360236]]}, {"verse": 36, "start": 361431, "end": 365126, "text": "Y concibieron las dos hijas de Lot, de su padre.", "words": [[0, 361431], [2, 361521], [14, 362241], [18, 362481], [22, 362781], [28, 363361], [31, 363501], [36, 363781], [39, 364261], [42, 364441]]}, {"verse": 37, "start": 365576, "end": 372791, "text": "Y parió la mayor un hijo, y llamó su nombre Moab, el cual es padre de los moabitas hasta hoy.", "words": [[0, 365576], [2, 365704], [8, 366044], [11, 366204], [17, 366504], [20, 366764], [26, 367064], [28, 367524], [34, 367844], [37, 367984], [44, 368304], [50, 369004], [53, 369484], [58, 369724], [61, 369944], [67, 370324], [70, 370584], [74, 370724], [83, 371444], [89, 371724]]}, {"verse": 38, "start": 373241, "end": 380992, "text": "La menor también parió un hijo, y llamó su nombre Ben-ammí, el cual es padre de los amonitas hasta hoy.", "words": [[0, 373241], [3, 373367], [9, 373627], [17, 374047], [23, 374427], [26, 374627], [32, 374907], [34, 375607], [40, 375947], [43, 376127], [50, 377097], [60, 378067], [63, 378307], [68, 378487], [71, 378707], [77, 379087], [80, 379287], [84, 379427], [93, 380047], [99, 380547]]}]}