{"book": "PSA", "chapter": 104, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 214535, "verses": [{"verse": 1, "start": 300, "end": 9464, "text": "Bendice, alma mía, a Jehová. Jehová, Dios mío, mucho te has engrandecido; te has vestido de gloria y de magnificencia.", "words": [[0, 300], [9, 885], [14, 1205], [19, 1825], [21, 2085], [29, 2862], [37, 3262], [42, 3422], [47, 4182], [53, 4642], [56, 5164], [60, 5684], [74, 6369], [77, 6473], [81, 6573], [89, 7193], [92, 7333], [99, 7893], [101, 8093], [104, 8213]]}, {"verse": 2, "start": 9814, "end": 15724, "text": "El que se cubre de luz como de vestidura, que extiende los cielos como una cortina;", "words": [[0, 9814], [3, 9982], [7, 10122], [10, 10282], [16, 10742], [19, 10902], [23, 11082], [28, 11442], [31, 11622], [42, 12342], [46, 12902], [55, 13562], [59, 13742], [66, 14322], [71, 14542], [75, 14782]]}, {"verse": 3, "start": 16074, "end": 24282, "text": "Que establece sus aposentos entre las aguas; el que pone las nubes por su carroza, el que anda sobre las alas del viento;", "words": [[0, 16074], [4, 16175], [14, 16655], [18, 16795], [28, 17575], [34, 17795], [38, 18055], [45, 18939], [48, 19066], [52, 19206], [57, 19526], [61, 19746], [67, 20146], [71, 20366], [74, 21006], [83, 21646], [86, 21986], [90, 22166], [95, 22446], [101, 22826], [105, 23066], [110, 23406], [114, 23586]]}, {"verse": 4, "start": 24632, "end": 29645, "text": "El que hace a sus ángeles espíritus, sus ministros al fuego flameante.", "words": [[0, 24632], [3, 24757], [7, 24917], [12, 25217], [14, 25397], [18, 25497], [26, 26077], [37, 27197], [41, 27377], [51, 28077], [54, 28257], [60, 28557]]}, {"verse": 5, "start": 29995, "end": 34608, "text": "Él fundó la tierra sobre sus bases; no será jamás removida.", "words": [[0, 29995], [3, 30160], [9, 30620], [12, 30740], [19, 31100], [25, 31460], [29, 31700], [36, 32653], [39, 32923], [44, 33163], [50, 33895]]}, {"verse": 6, "start": 34958, "end": 39994, "text": "Con el abismo, como con vestido, la cubriste; sobre los montes estaban las aguas.", "words": [[0, 34958], [4, 35082], [7, 35222], [15, 35622], [20, 35902], [24, 36102], [33, 36682], [36, 36802], [46, 37781], [52, 38045], [56, 38265], [63, 38705], [71, 39065], [75, 39345]]}, {"verse": 7, "start": 40344, "end": 46198, "text": "A tu reprensión huyeron; al sonido de tu trueno se apresuraron;", "words": [[0, 40344], [2, 40656], [5, 40776], [16, 41576], [25, 42751], [28, 43130], [35, 43870], [38, 44050], [41, 44250], [48, 44710], [51, 45466]]}, {"verse": 8, "start": 46548, "end": 51411, "text": "Subieron los montes, descendieron los valles, al lugar que tú les fundaste.", "words": [[0, 46548], [9, 47006], [13, 47186], [21, 48126], [34, 48846], [38, 49066], [46, 49546], [49, 49926], [55, 50266], [59, 50486], [62, 50666], [66, 50846]]}, {"verse": 9, "start": 51761, "end": 57376, "text": "Les pusiste un límite, el cual no traspasarán; ni volverán a cubrir la tierra.", "words": [[0, 51761], [4, 52304], [12, 52784], [15, 52924], [23, 53964], [26, 54044], [31, 54124], [34, 54324], [47, 55666], [50, 55736], [59, 56316], [61, 56416], [68, 56796], [71, 56956]]}, {"verse": 10, "start": 57726, "end": 62462, "text": "Tú eres el que envías las fuentes por los arroyos; van entre los montes.", "words": [[0, 57726], [3, 57868], [8, 58128], [11, 58328], [15, 58488], [22, 58821], [26, 59155], [34, 59488], [38, 59728], [42, 59908], [51, 60916], [55, 61115], [61, 61415], [65, 61615]]}, {"verse": 11, "start": 62812, "end": 68643, "text": "Dan de beber a todas las bestias del campo: quebrantan su sed los asnos montaraces.", "words": [[0, 62812], [4, 63022], [7, 63182], [13, 63462], [15, 63642], [21, 63862], [25, 64142], [33, 64542], [37, 64662], [44, 65861], [55, 66172], [58, 66412], [62, 66772], [66, 67152], [72, 67611]]}, {"verse": 12, "start": 68993, "end": 74687, "text": "Junto a aquellos habitarán las aves de los cielos; entre las ramas dan voces.", "words": [[0, 68993], [6, 69254], [8, 69474], [17, 69774], [27, 70614], [31, 70794], [36, 71214], [39, 71354], [43, 71494], [51, 72573], [57, 72974], [61, 73214], [67, 73694], [71, 74191]]}, {"verse": 13, "start": 75037, "end": 81455, "text": "El que riega los montes desde sus aposentos: del fruto de sus obras se sacia la tierra.", "words": [[0, 75037], [3, 75183], [7, 75323], [13, 75763], [17, 75923], [24, 76463], [30, 76723], [34, 77023], [45, 78151], [49, 78491], [55, 78951], [58, 79091], [62, 79251], [68, 79691], [71, 80151], [77, 80631], [80, 80771]]}, {"verse": 14, "start": 81805, "end": 89442, "text": "El que hace producir el heno para las bestias, y la hierba para el servicio del hombre; sacando el pan de la tierra.", "words": [[0, 81805], [3, 81933], [7, 82093], [12, 82373], [21, 83053], [24, 83363], [29, 83673], [34, 83893], [38, 84073], [47, 84693], [49, 85113], [52, 85233], [59, 85753], [64, 86033], [67, 86193], [76, 86618], [80, 87043], [88, 87620], [96, 88063], [99, 88203], [103, 88523], [106, 88703], [109, 88803]]}, {"verse": 15, "start": 89792, "end": 99218, "text": "Y el vino que alegra el corazón del hombre, y el aceite que hace lucir el rostro, y el pan que sustenta el corazón del hombre.", "words": [[0, 89792], [2, 89935], [5, 90095], [10, 90395], [14, 90655], [21, 91095], [24, 91215], [32, 91615], [36, 91915], [44, 92895], [46, 93255], [49, 93415], [56, 93795], [60, 94135], [65, 94395], [71, 94935], [74, 95075], [82, 95855], [84, 96035], [87, 96195], [91, 96575], [95, 97075], [104, 97835], [107, 97975], [115, 98375], [119, 98715]]}, {"verse": 16, "start": 99568, "end": 104627, "text": "Se llenan de jugo los árboles de Jehová, los cedros del Líbano que él plantó.", "words": [[0, 99568], [3, 99731], [10, 100071], [13, 100251], [18, 100691], [22, 100851], [30, 101391], [33, 101531], [41, 102331], [45, 102411], [52, 102851], [56, 103031], [63, 103531], [67, 103751], [70, 103891]]}, {"verse": 17, "start": 104977, "end": 109525, "text": "Allí anidan las aves; en las hayas hace su casa la cigüeña.", "words": [[0, 104977], [5, 105316], [12, 105676], [16, 105916], [22, 106798], [25, 106964], [29, 107314], [35, 107664], [40, 107964], [43, 108204], [48, 108504], [51, 108724]]}, {"verse": 18, "start": 109875, "end": 115140, "text": "Los montes altos para las cabras monteses; las peñas, madrigueras para los conejos.", "words": [[0, 109875], [4, 110085], [11, 110565], [17, 111025], [22, 111205], [26, 111425], [33, 111845], [43, 112961], [47, 113092], [54, 113452], [66, 114092], [71, 114272], [75, 114412]]}, {"verse": 19, "start": 115490, "end": 119383, "text": "Hizo la luna para los tiempos: el sol conoce su ocaso.", "words": [[0, 115490], [5, 115872], [8, 116052], [13, 116352], [18, 116512], [22, 116672], [31, 117633], [34, 117733], [38, 117933], [45, 118513], [48, 118713]]}, {"verse": 20, "start": 119733, "end": 124813, "text": "Pone las tinieblas, y es la noche: en ella corretean todas las bestias de la selva.", "words": [[0, 119733], [5, 119958], [9, 120138], [20, 120778], [22, 120918], [25, 120998], [28, 121138], [35, 121868], [38, 122033], [43, 122533], [53, 123133], [59, 123373], [63, 123673], [71, 124053], [74, 124173], [77, 124273]]}, {"verse": 21, "start": 125163, "end": 128949, "text": "Los leoncillos rugen a la presa, y para buscar de Dios su comida.", "words": [[0, 125163], [4, 125312], [15, 126112], [21, 126432], [23, 126592], [26, 126672], [33, 127052], [35, 127132], [40, 127312], [47, 127632], [50, 127892], [55, 128112], [58, 128312]]}, {"verse": 22, "start": 129299, "end": 133015, "text": "Sale el sol, se recogen, y se echan en sus cuevas.", "words": [[0, 129299], [5, 129603], [8, 129863], [13, 130103], [16, 130323], [25, 131003], [27, 131523], [30, 131663], [36, 131923], [39, 132103], [43, 132283]]}, {"verse": 23, "start": 133365, "end": 137229, "text": "Sale el hombre a su labor, y a su labranza hasta la tarde.", "words": [[0, 133365], [5, 133711], [8, 134051], [15, 134351], [17, 134511], [20, 134631], [27, 135051], [29, 135266], [31, 135346], [34, 135466], [43, 136186], [49, 136471], [52, 136631]]}, {"verse": 24, "start": 137579, "end": 145866, "text": "¡Cuán muchas son tus obras, oh Jehová! Hiciste todas ellas con sabiduría: la tierra está llena de tus beneficios.", "words": [[0, 137579], [6, 137786], [13, 138126], [17, 138406], [21, 138586], [28, 139048], [31, 139511], [39, 140193], [47, 140750], [53, 141050], [59, 141450], [63, 142148], [74, 143006], [77, 143196], [84, 143556], [89, 143996], [95, 144436], [98, 144576], [102, 144776]]}, {"verse": 25, "start": 146216, "end": 154329, "text": "Asimismo esta gran mar y ancha de términos: en ella pescados sin número, animales pequeños y grandes.", "words": [[0, 146216], [9, 146940], [14, 147320], [19, 147760], [23, 148180], [25, 148440], [31, 148780], [34, 148920], [44, 149952], [47, 150120], [52, 150500], [61, 150880], [65, 151200], [73, 151780], [82, 152560], [91, 153440], [93, 153540]]}, {"verse": 26, "start": 154679, "end": 160930, "text": "Allí andan navíos; allí este leviathán que hiciste para que jugase en ella.", "words": [[0, 154679], [5, 155029], [11, 155649], [19, 156708], [24, 157100], [29, 157810], [39, 158520], [43, 158720], [51, 159320], [56, 159580], [60, 159760], [67, 160340], [70, 160560]]}, {"verse": 27, "start": 161280, "end": 166040, "text": "Todos ellos esperan en ti, para que les des su comida a su tiempo.", "words": [[0, 161280], [6, 161482], [12, 161822], [20, 162462], [23, 162622], [27, 162882], [32, 163642], [36, 163782], [40, 163922], [44, 164182], [47, 164622], [54, 164982], [56, 165302], [59, 165402]]}, {"verse": 28, "start": 166390, "end": 170395, "text": "Les das, recogen; abres tu mano, se hartan de bien.", "words": [[0, 166390], [4, 166499], [9, 167099], [18, 168103], [24, 168570], [27, 168750], [33, 169190], [36, 169330], [43, 169790], [46, 169910]]}, {"verse": 29, "start": 170745, "end": 178100, "text": "Escondes tu rostro, se turban: les quitas el espíritu, dejan de ser, y se convierten en su polvo.", "words": [[0, 170745], [9, 171425], [12, 171585], [20, 172065], [23, 172205], [31, 173173], [35, 173294], [42, 173754], [45, 173894], [55, 174994], [61, 175474], [64, 175654], [69, 175974], [71, 176139], [74, 176299], [85, 176959], [88, 177339], [91, 177499]]}, {"verse": 30, "start": 178450, "end": 183180, "text": "Envías tu espíritu, son creados: y renuevas la faz de la tierra.", "words": [[0, 178450], [7, 178856], [10, 178996], [20, 179536], [24, 179616], [33, 180638], [35, 180774], [44, 181494], [47, 181834], [51, 182134], [54, 182414], [57, 182534]]}, {"verse": 31, "start": 183530, "end": 188017, "text": "Sea la gloria de Jehová para siempre; alégrese Jehová en sus obras;", "words": [[0, 183530], [4, 183694], [7, 183954], [14, 184214], [17, 184524], [24, 184834], [29, 184994], [38, 185898], [47, 186389], [54, 186909], [57, 187049], [61, 187189]]}, {"verse": 32, "start": 188367, "end": 193644, "text": "El cual mira a la tierra, y ella tiembla; toca los montes, y humean.", "words": [[0, 188367], [3, 188534], [8, 188734], [13, 189074], [15, 189294], [18, 189374], [26, 189874], [28, 190414], [33, 190634], [42, 191551], [47, 191733], [51, 191933], [59, 192613], [61, 192933]]}, {"verse": 33, "start": 193994, "end": 199216, "text": "A Jehová cantaré en mi vida: a mi Dios cantaré salmos mientras viva.", "words": [[0, 193994], [2, 194132], [9, 194532], [17, 195012], [20, 195272], [23, 195452], [29, 196175], [31, 196375], [34, 196515], [39, 196755], [47, 197255], [54, 197915], [63, 198355]]}, {"verse": 34, "start": 199566, "end": 204527, "text": "Dulce será mi meditación en él: yo me alegraré en Jehová.", "words": [[0, 199566], [6, 200175], [11, 200495], [14, 200735], [25, 201575], [28, 201835], [32, 202538], [35, 202658], [38, 202838], [47, 203538], [50, 204051]]}, {"verse": 35, "start": 204877, "end": 214135, "text": "Sean consumidos de la tierra los pecadores, y los impíos dejen de ser. Bendice, alma mía, a Jehová. Aleluya.", "words": [[0, 204877], [5, 205135], [16, 205975], [19, 206115], [22, 206215], [29, 206695], [33, 206795], [44, 207415], [46, 207750], [50, 207910], [57, 208750], [63, 209390], [66, 209570], [71, 210592], [80, 210897], [85, 211357], [90, 211957], [92, 212257], [100, 213677]]}]}