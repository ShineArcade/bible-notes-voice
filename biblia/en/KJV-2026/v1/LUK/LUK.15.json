{"book": "LUK", "chapter": 15, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 213899, "verses": [{"verse": 1, "start": 300, "end": 4613, "text": "Then drew near to him all the tax collectors and sinners to hear him.", "words": [[0, 300], [5, 580], [10, 880], [15, 1140], [18, 1360], [22, 1540], [26, 1920], [30, 2080], [34, 2420], [45, 2980], [49, 3280], [57, 3680], [60, 4000], [65, 4220]]}, {"verse": 2, "start": 4963, "end": 10563, "text": "And the Pharisees and scribes murmured, saying, This man receives sinners, and eats with them.", "words": [[0, 4963], [4, 5270], [8, 5390], [18, 6110], [22, 6230], [30, 6890], [40, 7630], [48, 8467], [53, 8601], [57, 8734], [66, 9054], [75, 9534], [79, 9994], [84, 10174], [89, 10374]]}, {"verse": 3, "start": 10843, "end": 13230, "text": "¶ And he spoke this parable to them, saying,", "words": [[2, 10843], [6, 10966], [9, 11086], [15, 11366], [20, 11646], [28, 12146], [31, 12326], [37, 12706]]}, {"verse": 4, "start": 13430, "end": 22950, "text": "What man of you, having a hundred sheep, if he lose one of them, does not leave the ninety and nine in the wilderness, and go after that which is lost, until he find it?", "words": [[0, 13430], [5, 13632], [9, 13932], [12, 14112], [17, 14532], [24, 14772], [26, 14972], [34, 15232], [41, 15612], [44, 15972], [47, 16092], [52, 16332], [56, 16592], [59, 16692], [65, 17172], [70, 17292], [74, 17532], [80, 17812], [84, 17972], [91, 18272], [95, 18472], [100, 18712], [103, 18892], [107, 18972], [119, 19842], [123, 19966], [126, 20166], [132, 20426], [137, 20726], [143, 20986], [146, 21186], [152, 21586], [158, 22126], [161, 22326], [166, 22646]]}, {"verse": 5, "start": 23300, "end": 26769, "text": "And when he has found it, he lays it on his shoulders, rejoicing.", "words": [[0, 23300], [4, 23424], [9, 23564], [12, 23724], [16, 23904], [22, 24244], [26, 24564], [29, 24684], [34, 24924], [37, 25084], [40, 25204], [44, 25324], [55, 26064]]}, {"verse": 6, "start": 27119, "end": 35310, "text": "And when he comes home, he calls together his friends and neighbours, saying to them, Rejoice with me; for I have found my sheep which was lost.", "words": [[0, 27119], [4, 27318], [9, 27518], [12, 27678], [18, 27898], [24, 28478], [27, 28558], [33, 28818], [42, 29218], [46, 29418], [54, 29798], [58, 30308], [70, 30818], [77, 31098], [80, 31298], [86, 31878], [94, 32418], [99, 32598], [103, 33128], [107, 33220], [109, 33440], [114, 33580], [120, 33840], [123, 34040], [129, 34320], [135, 34560], [139, 34740]]}, {"verse": 7, "start": 35660, "end": 44192, "text": "I say to you, that likewise joy shall be in heaven over one sinner that repents, more than over ninety and nine just persons, which need no repentance.", "words": [[0, 35660], [2, 35800], [6, 36060], [9, 36200], [14, 36760], [19, 36920], [28, 37260], [32, 37720], [38, 37980], [41, 38140], [44, 38300], [51, 38480], [56, 38760], [60, 39060], [67, 39380], [72, 39580], [81, 40440], [86, 40600], [91, 40760], [96, 40940], [103, 41280], [107, 41460], [112, 41720], [117, 41940], [126, 42420], [132, 42940], [137, 43180], [140, 43380]]}, {"verse": 8, "start": 44542, "end": 53322, "text": "¶ Either what woman having ten pieces of silver, if she lose one piece, does not light a lamp, and sweep the house, and seek diligently till she find it?", "words": [[2, 44542], [9, 44800], [14, 45080], [20, 45400], [27, 45680], [31, 46040], [38, 46420], [41, 46600], [49, 47300], [52, 47680], [56, 47820], [61, 48060], [65, 48340], [72, 49080], [77, 49220], [81, 49420], [87, 49620], [89, 49760], [95, 50060], [99, 50400], [105, 50620], [109, 50840], [116, 51160], [120, 51620], [125, 51840], [136, 52360], [141, 52640], [145, 52800], [150, 53120]]}, {"verse": 9, "start": 53602, "end": 61999, "text": "And when she has found it, she calls her friends and her neighbours together, saying, Rejoice with me; for I have found the piece which I had lost.", "words": [[0, 53602], [4, 53725], [9, 53885], [13, 54085], [17, 54265], [23, 54605], [27, 55065], [31, 55205], [37, 55505], [41, 55705], [49, 56065], [53, 56405], [57, 56625], [68, 56845], [78, 57545], [86, 58259], [94, 58852], [99, 59052], [103, 59678], [107, 59787], [109, 59947], [114, 60067], [120, 60367], [124, 60617], [130, 60867], [136, 61127], [138, 61347], [142, 61487]]}, {"verse": 10, "start": 62219, "end": 68342, "text": "Likewise, I say to you, there is joy in the presence of the angels of God over one sinner that repents.", "words": [[0, 62219], [10, 62802], [12, 62882], [16, 63102], [19, 63282], [24, 63902], [30, 64062], [33, 64222], [37, 64602], [40, 64822], [44, 64902], [53, 65202], [56, 65462], [60, 65602], [67, 65982], [70, 66162], [74, 66462], [79, 66802], [83, 67102], [90, 67462], [95, 67702]]}, {"verse": 11, "start": 68622, "end": 72195, "text": "¶ And he said, A certain man had two sons:", "words": [[2, 68622], [6, 68757], [9, 68897], [15, 70305], [17, 70395], [25, 70635], [29, 70975], [33, 71255], [37, 71495]]}, {"verse": 12, "start": 72475, "end": 79717, "text": "And the younger of them said to his father, Father, give me the portion of goods that falls to me. And he divided to them his living.", "words": [[0, 72475], [4, 72602], [8, 72702], [16, 72942], [19, 73182], [24, 73342], [29, 73582], [32, 73762], [36, 73902], [44, 74639], [52, 75023], [57, 75433], [60, 75613], [64, 75753], [72, 76113], [75, 76333], [81, 76633], [86, 76873], [92, 77173], [95, 77393], [99, 77911], [103, 78037], [106, 78117], [114, 78517], [117, 78757], [122, 78997], [126, 79217]]}, {"verse": 13, "start": 79937, "end": 88705, "text": "And not many days after the younger son gathered all together, and took his journey into a far country, and there wasted his substance with riotous living.", "words": [[0, 79937], [4, 80063], [8, 80263], [13, 80543], [18, 80863], [24, 81263], [28, 81423], [36, 81683], [40, 82043], [49, 82443], [53, 82763], [63, 83183], [67, 83703], [72, 83883], [76, 84063], [84, 84443], [89, 84703], [91, 84903], [95, 85143], [104, 85583], [108, 86103], [114, 86223], [121, 86603], [125, 86843], [135, 87323], [140, 87643], [148, 88203]]}, {"verse": 14, "start": 89055, "end": 95332, "text": "And when he had spent all, there arose a mighty famine in that land; and he began to be in want.", "words": [[0, 89055], [4, 89198], [9, 89378], [12, 89578], [16, 89698], [22, 89918], [27, 90838], [33, 91018], [39, 91418], [41, 91598], [48, 91878], [55, 92338], [58, 92678], [63, 92898], [69, 93610], [73, 93755], [76, 93875], [82, 94175], [85, 94395], [88, 94615], [91, 94795]]}, {"verse": 15, "start": 95682, "end": 101839, "text": "And he went and joined himself to a citizen of that country; and he sent him into his fields to feed swine.", "words": [[0, 95682], [4, 95824], [7, 95944], [12, 96164], [16, 96424], [23, 96684], [31, 97144], [34, 97344], [36, 97464], [44, 97784], [47, 98004], [52, 98184], [61, 98966], [65, 99083], [68, 99183], [73, 99463], [77, 99663], [82, 99983], [86, 100203], [93, 100603], [96, 100863], [101, 101103]]}, {"verse": 16, "start": 102119, "end": 107723, "text": "And he would gladly have filled his belly with the husks that the swine did eat: and no man gave to him.", "words": [[0, 102119], [4, 102257], [7, 102377], [13, 102537], [20, 102977], [25, 103237], [32, 103477], [36, 103697], [42, 103997], [47, 104237], [51, 104377], [57, 104797], [62, 104937], [66, 105097], [72, 105457], [76, 105617], [81, 106306], [85, 106442], [88, 106622], [92, 106882], [97, 107162], [100, 107382]]}, {"verse": 17, "start": 108073, "end": 115546, "text": "And when he came to himself, he said, How many hired servants of my father’s have bread enough and to spare, and I perish with hunger!", "words": [[0, 108073], [4, 108192], [9, 108332], [12, 108472], [17, 108692], [20, 108892], [29, 109492], [32, 109572], [38, 110175], [42, 110308], [47, 110568], [53, 110928], [62, 111348], [65, 111608], [68, 111788], [77, 112128], [82, 112398], [88, 112668], [95, 112968], [99, 113328], [102, 113528], [109, 114088], [113, 114368], [115, 114488], [122, 114868], [127, 115128]]}, {"verse": 18, "start": 115896, "end": 122082, "text": "I will arise and go to my father, and will say to him, Father, I have sinned against heaven, and before you,", "words": [[0, 115896], [2, 116033], [7, 116193], [13, 116553], [17, 116993], [20, 117153], [23, 117313], [26, 117433], [34, 117753], [38, 117988], [43, 118148], [47, 118368], [50, 118508], [55, 119008], [63, 119588], [65, 119828], [70, 120008], [77, 120188], [85, 120448], [93, 120888], [97, 121368], [104, 121668]]}, {"verse": 19, "start": 122432, "end": 126452, "text": "And am no more worthy to be called your son: make me as one of your hired servants.", "words": [[0, 122432], [4, 122555], [7, 122715], [10, 122855], [15, 123055], [22, 123375], [25, 123515], [28, 123655], [35, 123875], [40, 124035], [45, 124691], [50, 124851], [53, 125031], [56, 125151], [60, 125291], [63, 125371], [68, 125491], [74, 125751]]}, {"verse": 20, "start": 126672, "end": 135791, "text": "And he arose, and came to his father. But when he was yet a great way off, his father saw him, and had compassion, and ran, and fell on his neck, and kissed him.", "words": [[0, 126672], [4, 126830], [7, 126970], [14, 127250], [18, 127650], [23, 127870], [26, 128070], [30, 128230], [38, 128961], [42, 129065], [47, 129185], [50, 129325], [54, 129485], [58, 129625], [60, 129745], [66, 129985], [70, 130185], [75, 130845], [79, 131005], [86, 131345], [90, 131685], [95, 131945], [99, 132325], [103, 132485], [115, 133045], [119, 133365], [124, 133705], [128, 133985], [133, 134185], [136, 134365], [140, 134505], [146, 134825], [150, 135185], [157, 135425]]}, {"verse": 21, "start": 136071, "end": 142583, "text": "And the son said to him, Father, I have sinned against heaven, and in your sight, and am no more worthy to be called your son.", "words": [[0, 136071], [4, 136199], [8, 136319], [12, 136599], [17, 136899], [20, 137099], [25, 137667], [33, 138105], [35, 138185], [40, 138345], [47, 138765], [55, 138885], [63, 139265], [67, 139705], [70, 139805], [75, 139925], [82, 140265], [86, 140545], [89, 140825], [92, 140965], [97, 141145], [104, 141465], [107, 141625], [110, 141725], [117, 141965], [122, 142145]]}, {"verse": 22, "start": 142863, "end": 149937, "text": "But the father said to his servants, Bring forth the best robe, and put it on him; and put a ring on his hand, and shoes on his feet:", "words": [[0, 142863], [4, 142950], [8, 143090], [15, 143370], [20, 143710], [23, 143890], [27, 144050], [37, 144925], [43, 145145], [49, 145445], [53, 145685], [58, 145925], [64, 146245], [68, 146545], [72, 146725], [75, 146845], [78, 147065], [83, 147622], [87, 147725], [91, 147865], [93, 147985], [98, 148185], [101, 148305], [105, 148425], [111, 148685], [115, 148985], [121, 149245], [124, 149425], [128, 149545]]}, {"verse": 23, "start": 150287, "end": 154415, "text": "And bring here the fatted calf, and kill it; and let us eat, and be merry:", "words": [[0, 150287], [4, 150413], [10, 150613], [15, 150813], [19, 150953], [26, 151273], [32, 151613], [36, 152053], [41, 152333], [45, 152855], [49, 152941], [53, 153081], [56, 153261], [61, 153541], [65, 153841], [68, 154001]]}, {"verse": 24, "start": 154765, "end": 160675, "text": "For this my son was dead, and is alive again; he was lost, and is found. And they began to be merry.", "words": [[0, 154765], [4, 154849], [9, 155069], [12, 155269], [16, 155529], [20, 155709], [26, 156009], [30, 156409], [33, 156529], [39, 156809], [46, 157516], [49, 157584], [53, 157764], [59, 158144], [63, 158364], [66, 158484], [73, 159265], [77, 159403], [82, 159523], [88, 159864], [91, 160023], [94, 160123]]}, {"verse": 25, "start": 160895, "end": 167541, "text": "Now his elder son was in the field: and as he came and drew near to the house, he heard music and dancing.", "words": [[0, 160895], [4, 161197], [8, 161477], [14, 161757], [18, 162117], [22, 162337], [25, 162477], [29, 162577], [36, 163324], [40, 163630], [43, 163910], [46, 164070], [51, 164350], [55, 164550], [60, 164750], [65, 164910], [68, 165050], [72, 165170], [79, 165770], [82, 165930], [88, 166150], [94, 166550], [98, 166870]]}, {"verse": 26, "start": 167891, "end": 171172, "text": "And he called one of the servants, and asked what these things meant.", "words": [[0, 167891], [4, 168027], [7, 168127], [14, 168427], [18, 168667], [21, 168767], [25, 168887], [35, 169227], [39, 169632], [45, 169912], [50, 170092], [56, 170332], [63, 170652]]}, {"verse": 27, "start": 171452, "end": 178565, "text": "And he said to him, Your brother is come; and your father has killed the fatted calf, because he has received him safe and sound.", "words": [[0, 171452], [4, 171619], [7, 171759], [12, 172039], [15, 172259], [20, 172823], [25, 172966], [33, 173266], [36, 173526], [42, 174230], [46, 174352], [51, 174452], [58, 174712], [62, 174952], [69, 175212], [73, 175392], [80, 175652], [86, 176272], [94, 176472], [97, 176732], [101, 176912], [110, 177292], [114, 177512], [119, 177832], [123, 178032]]}, {"verse": 28, "start": 178785, "end": 184046, "text": "And he was angry, and would not go in: therefore came his father out, and entreated him.", "words": [[0, 178785], [4, 178916], [7, 179056], [11, 179236], [18, 179716], [22, 180021], [28, 180221], [32, 180421], [35, 180681], [39, 181319], [49, 181656], [54, 181996], [58, 182216], [65, 182496], [70, 182876], [74, 183316], [84, 183756]]}, {"verse": 29, "start": 184326, "end": 195072, "text": "And he answering said to his father, Lo, these many years do I serve you, neither transgressed I at any time your commandment: and yet you never gave me a kid, that I might make merry with my friends:", "words": [[0, 184326], [4, 184486], [7, 184666], [17, 185206], [22, 185546], [25, 185746], [29, 185886], [37, 186870], [41, 187060], [47, 187060], [52, 187300], [58, 187540], [61, 187740], [63, 187880], [69, 188140], [74, 188700], [82, 188880], [95, 189700], [97, 189920], [100, 190120], [104, 190280], [109, 190560], [114, 190720], [127, 191590], [131, 191694], [135, 191834], [139, 191994], [145, 192214], [150, 192474], [153, 192654], [155, 192794], [160, 193034], [165, 193434], [167, 193554], [173, 193714], [178, 193954], [184, 194194], [189, 194374], [192, 194514]]}, {"verse": 30, "start": 195422, "end": 201073, "text": "But as soon as this your son was come, which has devoured your living with harlots, you have killed for him the fatted calf.", "words": [[0, 195422], [4, 195523], [7, 195643], [12, 195863], [15, 195983], [20, 196163], [25, 196403], [29, 196663], [33, 196843], [39, 197323], [45, 197503], [49, 197643], [58, 198103], [63, 198223], [70, 198483], [75, 198723], [84, 199403], [88, 199503], [93, 199623], [100, 199903], [104, 200123], [108, 200263], [112, 200403], [119, 200703]]}, {"verse": 31, "start": 201353, "end": 206377, "text": "And he said to him, Son, you are ever with me, and all that I have is yours.", "words": [[0, 201353], [4, 201487], [7, 201607], [12, 201847], [15, 202067], [20, 202707], [25, 203367], [29, 203848], [33, 204008], [38, 204268], [43, 204548], [47, 204768], [51, 205108], [55, 205248], [60, 205388], [62, 205508], [67, 205728], [70, 205848]]}, {"verse": 32, "start": 206727, "end": 213499, "text": "It was meet that we should make merry, and be glad: for this your brother was dead, and is alive again; and was lost, and is found.", "words": [[0, 206727], [3, 206846], [7, 207056], [12, 207266], [17, 207466], [20, 207606], [27, 207766], [32, 207986], [39, 208326], [43, 208666], [46, 208786], [52, 209493], [56, 209590], [61, 209810], [66, 209990], [74, 210230], [78, 210470], [84, 210730], [88, 211070], [91, 211190], [97, 211430], [104, 212131], [108, 212279], [112, 212439], [118, 212719], [122, 212999], [125, 213119]]}]}