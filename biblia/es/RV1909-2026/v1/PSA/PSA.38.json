{"book": "PSA", "chapter": 38, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 131549, "verses": [{"verse": 1, "start": 300, "end": 7438, "text": "Salmo de David, para recordar. JEHOVÁ, no me reprendas en tu furor, ni me castigues en tu ira.", "words": [[0, 300], [6, 743], [9, 903], [16, 1203], [21, 1563], [31, 2790], [39, 3291], [42, 3371], [45, 3551], [55, 4351], [58, 4551], [61, 4751], [68, 5281], [71, 5811], [74, 5991], [84, 6611], [87, 6771], [90, 6971]]}, {"verse": 2, "start": 7788, "end": 12555, "text": "Porque tus flechas descendieron a mí, y sobre mí ha caído tu mano.", "words": [[0, 7788], [7, 8251], [11, 8471], [19, 8911], [32, 9651], [34, 9831], [38, 10031], [40, 10551], [46, 10811], [49, 11131], [52, 11391], [58, 11791], [61, 11991]]}, {"verse": 3, "start": 12905, "end": 19798, "text": "No hay sanidad en mi carne a causa de tu ira; ni hay paz en mis huesos a causa de mi pecado.", "words": [[0, 12905], [3, 13173], [7, 13413], [15, 14073], [18, 14313], [21, 14673], [27, 15033], [29, 15193], [35, 15493], [38, 15773], [41, 15973], [46, 16529], [49, 16809], [53, 16969], [57, 17249], [60, 17589], [64, 17769], [71, 18309], [73, 18449], [79, 18749], [82, 19009], [85, 19149]]}, {"verse": 4, "start": 20148, "end": 26779, "text": "Porque mis iniquidades han pasado mi cabeza: como carga pesada se han agravado sobre mí.", "words": [[0, 20148], [7, 20372], [11, 20612], [23, 21652], [27, 22052], [34, 22532], [37, 22812], [45, 23752], [50, 23935], [56, 24335], [63, 24995], [66, 25215], [70, 25375], [79, 26095], [85, 26335]]}, {"verse": 5, "start": 27129, "end": 31645, "text": "Se pudrieron, se corrompieron mis llagas, a causa de mi locura.", "words": [[0, 27129], [3, 27270], [14, 28110], [17, 28190], [30, 28990], [34, 29480], [42, 29970], [44, 30390], [50, 30650], [53, 30930], [56, 31030]]}, {"verse": 6, "start": 31995, "end": 37035, "text": "Estoy encorvado, estoy humillado en gran manera, ando enlutado todo el día.", "words": [[0, 31995], [6, 32222], [17, 33362], [23, 33482], [33, 34062], [36, 34222], [41, 34362], [49, 35042], [54, 35462], [63, 36042], [68, 36262], [71, 36522]]}, {"verse": 7, "start": 37385, "end": 41661, "text": "Porque mis lomos están llenos de irritación, y no hay sanidad en mi carne.", "words": [[0, 37385], [7, 37626], [11, 37806], [17, 38186], [23, 38526], [30, 38946], [33, 39086], [45, 39806], [47, 40041], [50, 40181], [54, 40301], [62, 40741], [65, 40941], [68, 41081]]}, {"verse": 8, "start": 42011, "end": 47800, "text": "Estoy debilitado y molido en gran manera; bramo a causa de la conmoción de mi corazón.", "words": [[0, 42011], [6, 42404], [17, 43124], [19, 43264], [26, 43664], [29, 43804], [34, 43984], [42, 44870], [48, 45299], [50, 45499], [56, 45799], [59, 46039], [62, 46139], [72, 46759], [75, 46959], [78, 47059]]}, {"verse": 9, "start": 48150, "end": 54561, "text": "Señor, delante de ti están todos mis deseos; y mi suspiro no te es oculto.", "words": [[0, 48150], [7, 49321], [15, 49741], [18, 49901], [21, 50141], [27, 50441], [33, 50841], [37, 51161], [45, 52260], [47, 52388], [50, 52528], [58, 53268], [61, 53428], [64, 53825], [67, 54223]]}, {"verse": 10, "start": 54911, "end": 61681, "text": "Mi corazón está acongojado, me ha dejado mi vigor; y aun la misma luz de mis ojos no está conmigo.", "words": [[0, 54911], [3, 55034], [11, 55474], [16, 55854], [28, 57074], [31, 57194], [34, 57274], [41, 57694], [44, 57854], [51, 58554], [53, 58699], [57, 58879], [60, 59079], [66, 59299], [70, 59699], [73, 60099], [77, 60239], [82, 60519], [85, 60739], [90, 60879]]}, {"verse": 11, "start": 62031, "end": 68298, "text": "Mis amigos y mis compañeros se quitaron de delante de mi plaga; y mis cercanos se pusieron lejos.", "words": [[0, 62031], [4, 62138], [11, 62498], [13, 62678], [17, 62818], [28, 63538], [31, 63918], [40, 64398], [43, 64538], [51, 64978], [54, 65138], [57, 65298], [64, 66210], [66, 66309], [70, 66429], [79, 67048], [82, 67289], [91, 67748]]}, {"verse": 12, "start": 68648, "end": 77493, "text": "Y los que buscaban mi alma armaron lazos; y los que procuraban mi mal hablaban iniquidades, y meditaban fraudes todo el día.", "words": [[0, 68648], [2, 68755], [6, 68875], [10, 69035], [19, 69595], [22, 69835], [27, 70135], [35, 70755], [42, 71737], [44, 71822], [48, 71922], [52, 72062], [63, 72682], [66, 72922], [70, 73202], [79, 73922], [92, 74822], [94, 75362], [104, 75942], [112, 76502], [117, 76822], [120, 77062]]}, {"verse": 13, "start": 77843, "end": 83982, "text": "Mas yo, como si fuera sordo, no oía; y estaba como un mudo, que no abre su boca.", "words": [[0, 77843], [4, 78033], [8, 78193], [13, 78413], [16, 78613], [22, 78873], [29, 79793], [32, 79953], [37, 80830], [39, 80955], [46, 81335], [51, 81715], [54, 81935], [60, 82455], [64, 82675], [67, 82895], [72, 83135], [75, 83375]]}, {"verse": 14, "start": 84332, "end": 89377, "text": "fui pues como un hombre que no oye, y que en su boca no tiene reprensiones.", "words": [[0, 84332], [4, 84603], [9, 84783], [14, 85103], [17, 85343], [24, 85663], [28, 85863], [31, 86063], [36, 86463], [38, 86903], [42, 87043], [45, 87163], [48, 87343], [53, 87703], [56, 87903], [62, 88223]]}, {"verse": 15, "start": 89727, "end": 94539, "text": "Porque a ti, oh Jehová, esperé yo: tú responderás, Jehová Dios mío.", "words": [[0, 89727], [7, 89971], [9, 90151], [13, 90478], [16, 90804], [24, 91131], [31, 91451], [35, 92108], [38, 92312], [51, 93367], [58, 93747], [63, 93907]]}, {"verse": 16, "start": 94889, "end": 101409, "text": "Porque dije: Que no se alegren de mí: cuando mi pie resbalaba, sobre mí se engrandecían.", "words": [[0, 95015], [7, 95175], [13, 96034], [17, 96254], [20, 96414], [23, 96574], [31, 97094], [34, 97254], [38, 97844], [45, 98028], [48, 98448], [52, 98868], [63, 99288], [69, 99748], [72, 100008], [75, 100228]]}, {"verse": 17, "start": 101759, "end": 106450, "text": "Pero yo estoy a punto de caer, y mi dolor está delante de mí continuamente.", "words": [[0, 101759], [5, 101903], [8, 102103], [14, 102323], [16, 102443], [22, 102703], [25, 102963], [31, 103463], [33, 103943], [36, 104083], [42, 104363], [47, 104663], [55, 105143], [58, 105303], [61, 105423]]}, {"verse": 18, "start": 106800, "end": 111169, "text": "Por tanto confesaré mi maldad; me angustiaré por mi pecado.", "words": [[0, 106800], [4, 107060], [10, 107520], [20, 108360], [23, 108460], [31, 109398], [34, 109747], [45, 110127], [49, 110327], [52, 110487]]}, {"verse": 19, "start": 111519, "end": 117645, "text": "Porque mis enemigos están vivos y fuertes: y se han aumentado los que me aborrecen sin causa:", "words": [[0, 111519], [7, 111701], [11, 111901], [20, 112481], [26, 112721], [32, 113341], [34, 113461], [43, 114449], [45, 114577], [48, 114717], [52, 114877], [62, 115617], [66, 115777], [70, 115937], [73, 116077], [83, 116597], [87, 116837]]}, {"verse": 20, "start": 117995, "end": 122732, "text": "Y pagando mal por bien me son contrarios, por seguir yo lo bueno.", "words": [[0, 117995], [2, 118243], [10, 118723], [14, 119003], [18, 119263], [23, 119483], [26, 119703], [30, 119943], [42, 121163], [46, 121463], [53, 121763], [56, 122083], [59, 122223]]}, {"verse": 21, "start": 123082, "end": 127124, "text": "No me desampares, oh Jehová: Dios mío, no te alejes de mí.", "words": [[0, 123082], [3, 123320], [6, 123460], [18, 124070], [21, 124680], [29, 125561], [34, 125731], [39, 126051], [42, 126131], [45, 126311], [52, 126651], [55, 126811]]}, {"verse": 22, "start": 127474, "end": 131149, "text": "Apresúrate a ayudarme, oh Señor, mi salvación.", "words": [[0, 127474], [11, 128294], [13, 128514], [23, 129214], [26, 129334], [33, 130134], [36, 130294]]}]}