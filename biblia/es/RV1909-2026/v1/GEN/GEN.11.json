{"book": "GEN", "chapter": 11, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 240569, "verses": [{"verse": 1, "start": 300, "end": 4740, "text": "Era entonces toda la tierra de una lengua y unas mismas palabras.", "words": [[0, 300], [4, 637], [13, 1257], [18, 1677], [21, 1897], [28, 2277], [31, 2477], [35, 2597], [42, 3077], [44, 3177], [49, 3357], [56, 3877]]}, {"verse": 2, "start": 5090, "end": 12034, "text": "Y aconteció que, cuando salieron de oriente, hallaron una llanura en la tierra de Sinar, y se establecieron allí.", "words": [[0, 5090], [2, 5215], [12, 5835], [17, 6035], [24, 6255], [33, 6815], [36, 6995], [45, 7495], [54, 8215], [58, 8495], [66, 8975], [69, 9095], [72, 9255], [79, 9535], [82, 9775], [89, 10135], [91, 10555], [94, 10695], [108, 11575]]}, {"verse": 3, "start": 12384, "end": 22636, "text": "Y dijeron los unos a los otros: Vaya, hagamos ladrillo y cozámoslo con fuego. Y les fue el ladrillo en lugar de piedra, y el asfalto en lugar de mezcla.", "words": [[0, 12384], [2, 12488], [10, 13008], [14, 13208], [19, 13528], [21, 13788], [25, 13968], [32, 14917], [38, 15235], [46, 15635], [55, 16135], [57, 16495], [67, 16855], [71, 17035], [78, 17826], [80, 17972], [84, 18112], [88, 18352], [91, 18632], [100, 19192], [103, 19352], [109, 19572], [112, 19812], [120, 20352], [122, 20532], [125, 20712], [133, 21272], [136, 21392], [142, 21652], [145, 21912]]}, {"verse": 4, "start": 22986, "end": 33505, "text": "Y dijeron: Vamos, edifiquémonos una ciudad y una torre, cuya cúspide llegue al cielo; y hagámonos un nombre, no sea que seamos esparcidos sobre la faz de toda la tierra.", "words": [[0, 22986], [2, 23113], [11, 23996], [18, 24293], [32, 25253], [36, 25413], [43, 25793], [45, 26053], [49, 26193], [56, 26733], [61, 27333], [69, 27813], [76, 28173], [79, 28253], [86, 28956], [88, 29056], [98, 29556], [101, 29696], [109, 30156], [112, 30256], [116, 30476], [120, 30636], [127, 31036], [138, 31736], [144, 32016], [147, 32176], [151, 32416], [154, 32616], [159, 32796], [162, 32976]]}, {"verse": 5, "start": 33785, "end": 39622, "text": "Y descendió Jehová para ver la ciudad y la torre que edificaban los hijos de los hombres.", "words": [[0, 33785], [2, 33891], [12, 34531], [19, 35051], [24, 35291], [28, 35531], [31, 35711], [38, 36071], [40, 36351], [43, 36451], [49, 36971], [53, 37211], [64, 37991], [68, 38231], [74, 38571], [77, 38771], [81, 38911]]}, {"verse": 6, "start": 39972, "end": 50354, "text": "Y dijo Jehová: He aquí el pueblo es uno, y todos estos tienen un lenguaje: y han comenzado a obrar, y nada los hará desistir ahora de lo que han pensado hacer.", "words": [[0, 39972], [2, 40326], [7, 40712], [15, 41316], [18, 41396], [23, 41616], [26, 41796], [33, 42116], [36, 42356], [41, 42636], [43, 43056], [49, 43336], [55, 43796], [62, 44236], [65, 44436], [75, 45562], [77, 45684], [81, 45804], [91, 46404], [93, 46464], [100, 47164], [102, 47244], [107, 47444], [111, 47664], [116, 47984], [125, 48524], [131, 48804], [134, 49024], [137, 49164], [141, 49304], [145, 49424], [153, 49924]]}, {"verse": 7, "start": 50936, "end": 58170, "text": "Ahora pues, descendamos, y confundamos allí sus lenguas, para que ninguno entienda el habla de su compañero.", "words": [[0, 50936], [6, 51260], [12, 51580], [25, 52700], [27, 53080], [39, 53820], [44, 54020], [48, 54240], [57, 54800], [62, 55340], [66, 55480], [74, 56060], [83, 56720], [86, 56920], [92, 57120], [95, 57300], [98, 57420]]}, {"verse": 8, "start": 58671, "end": 65392, "text": "Así los esparció Jehová desde allí sobre la faz de toda la tierra, y dejaron de edificar la ciudad.", "words": [[0, 58671], [4, 59269], [8, 59714], [17, 60158], [24, 60602], [30, 60762], [35, 61102], [41, 61402], [44, 61662], [48, 61922], [51, 62202], [56, 62382], [59, 62602], [67, 63022], [69, 63542], [77, 64002], [80, 64162], [89, 64602], [92, 64842]]}, {"verse": 9, "start": 65742, "end": 76355, "text": "Por esto fue llamado el nombre de ella Babel, porque allí confundió Jehová el lenguaje de toda la tierra, y desde allí los esparció sobre la faz de toda la tierra.", "words": [[0, 65742], [4, 65866], [9, 66086], [13, 66366], [21, 66686], [24, 66926], [31, 67266], [34, 67732], [39, 68199], [46, 68666], [53, 68986], [58, 69306], [68, 69856], [75, 70406], [78, 70606], [87, 71226], [90, 71386], [95, 71626], [98, 71866], [106, 72815], [108, 72945], [114, 73165], [119, 73525], [123, 73765], [132, 74425], [138, 74725], [141, 74945], [145, 75185], [148, 75385], [153, 75585], [156, 75805]]}, {"verse": 10, "start": 76705, "end": 85510, "text": "Estas son las generaciones de Sem: Sem, de edad de cien años, engendró a Arfaxad, dos años después del diluvio.", "words": [[0, 76705], [6, 77171], [10, 77391], [14, 77611], [27, 78391], [30, 78591], [35, 79111], [40, 79491], [43, 79971], [48, 80311], [51, 80491], [56, 80671], [62, 81331], [71, 82111], [73, 82331], [82, 83131], [86, 83671], [91, 84131], [99, 84491], [103, 84771]]}, {"verse": 11, "start": 85860, "end": 92941, "text": "Y vivió Sem, después que engendró a Arfaxad, quinientos años, y engendró hijos e hijas.", "words": [[0, 85860], [2, 86005], [8, 86365], [13, 86705], [21, 87485], [25, 87865], [34, 88205], [36, 88545], [45, 89118], [56, 89690], [62, 90410], [64, 90890], [73, 91590], [79, 91970], [81, 92330]]}, {"verse": 12, "start": 93291, "end": 97943, "text": "Y Arfaxad vivió treinta y cinco años, y engendró a Sala.", "words": [[0, 93560], [2, 93866], [10, 94173], [16, 94488], [24, 94803], [26, 95118], [32, 95433], [38, 96153], [40, 96733], [49, 97313], [51, 97433]]}, {"verse": 13, "start": 98293, "end": 105972, "text": "Y vivió Arfaxad, después que engendró a Sala, cuatrocientos tres años, y engendró hijos e hijas.", "words": [[0, 98293], [2, 98417], [8, 99017], [17, 99617], [25, 100037], [29, 100257], [38, 100897], [40, 100997], [46, 101577], [60, 102157], [65, 102737], [71, 103177], [73, 103677], [82, 104377], [88, 104797], [90, 105217]]}, {"verse": 14, "start": 106322, "end": 110105, "text": "Y vivió Sala treinta años, y engendró a Heber.", "words": [[0, 106322], [2, 106465], [8, 106832], [13, 107198], [21, 107565], [27, 108145], [29, 108745], [38, 109425], [40, 109791]]}, {"verse": 15, "start": 110455, "end": 117583, "text": "Y vivió Sala, después que engendró a Heber, cuatrocientos tres años, y engendró hijos e hijas.", "words": [[0, 110455], [2, 110601], [8, 110941], [14, 111321], [22, 111701], [26, 111981], [35, 112521], [37, 113041], [44, 113561], [58, 114081], [63, 114601], [69, 115581], [71, 115621], [80, 116161], [86, 116501], [88, 116901]]}, {"verse": 16, "start": 117933, "end": 122096, "text": "Y vivió Heber treinta y cuatro años, y engendró a Peleg.", "words": [[0, 117933], [2, 118218], [8, 118486], [14, 118754], [22, 119022], [24, 119290], [31, 119558], [37, 120398], [39, 120718], [48, 121318], [50, 121727]]}, {"verse": 17, "start": 122446, "end": 129653, "text": "Y vivió Heber, después que engendró a Peleg, cuatrocientos treinta años, y engendró hijos e hijas.", "words": [[0, 122446], [2, 122567], [8, 122937], [15, 123307], [23, 123727], [27, 123987], [36, 124547], [38, 124647], [45, 125159], [59, 125670], [67, 126182], [73, 126882], [75, 127402], [84, 128122], [90, 128542], [92, 128922]]}, {"verse": 18, "start": 130003, "end": 133851, "text": "Y vivió Peleg treinta años, y engendró a Reu.", "words": [[0, 130003], [2, 130133], [8, 130540], [14, 130946], [22, 131353], [28, 131973], [30, 132453], [39, 133113], [41, 133333]]}, {"verse": 19, "start": 134201, "end": 141307, "text": "Y vivió Peleg, después que engendró a Reu, doscientos nueve años, y engendró hijos e hijas.", "words": [[0, 134201], [2, 134342], [8, 134702], [15, 135182], [23, 135627], [27, 135907], [36, 136527], [38, 136687], [43, 137280], [54, 137874], [60, 138467], [66, 139007], [68, 139367], [77, 140027], [83, 140367], [85, 140707]]}, {"verse": 20, "start": 141657, "end": 145742, "text": "Y Reu vivió treinta y dos años, y engendró a Serug.", "words": [[0, 141884], [2, 142110], [6, 142337], [12, 142577], [20, 142817], [22, 143057], [26, 143297], [32, 143917], [34, 144277], [43, 144937], [45, 145367]]}, {"verse": 21, "start": 146092, "end": 153207, "text": "Y vivió Reu, después que engendró a Serug, doscientos siete años, y engendró hijos e hijas.", "words": [[0, 146092], [2, 146221], [8, 146601], [13, 147121], [21, 147701], [25, 147941], [34, 148561], [36, 148937], [43, 149313], [54, 149690], [60, 150066], [66, 151106], [68, 151186], [77, 151786], [83, 152186], [85, 152566]]}, {"verse": 22, "start": 153557, "end": 157434, "text": "Y vivió Serug treinta años, y engendró a Nacor.", "words": [[0, 153557], [2, 153684], [8, 154024], [14, 154434], [22, 154844], [28, 155604], [30, 156069], [39, 156539], [41, 157008]]}, {"verse": 23, "start": 157784, "end": 165711, "text": "Y vivió Serug, después que engendró a Nacor, doscientos años, y engendró hijos e hijas.", "words": [[0, 157784], [2, 157911], [8, 158341], [15, 158771], [23, 159591], [27, 159991], [36, 160466], [38, 160941], [45, 161416], [56, 161891], [62, 162731], [64, 163371], [73, 164091], [79, 164491], [81, 164971]]}, {"verse": 24, "start": 166061, "end": 169708, "text": "Y vivió Nacor veintinueve años, y engendró a Taré.", "words": [[0, 166061], [2, 166187], [8, 166634], [14, 167080], [26, 167527], [32, 168147], [34, 168627], [43, 169187], [45, 169307]]}, {"verse": 25, "start": 170058, "end": 176685, "text": "Y vivió Nacor, después que engendró a Taré, ciento diecinueve años, y engendró hijos e hijas.", "words": [[0, 170058], [2, 170203], [8, 170583], [15, 170963], [23, 171343], [27, 171503], [36, 172003], [38, 172123], [44, 172723], [51, 173323], [62, 173923], [68, 174483], [70, 174768], [79, 175368], [85, 175688], [87, 176028]]}, {"verse": 26, "start": 177035, "end": 182108, "text": "Y vivió Taré setenta años, y engendró a Abram, y a Nacor, y a Harán.", "words": [[0, 177163], [2, 177323], [8, 177483], [13, 177843], [21, 178203], [27, 178703], [29, 179076], [38, 179450], [40, 179823], [47, 180443], [49, 180737], [51, 181031], [58, 181325], [60, 181586], [62, 181847]]}, {"verse": 27, "start": 182458, "end": 190944, "text": "Estas son las generaciones de Taré: Taré engendró a Abram, y a Nacor, y a Harán; y Harán engendró a Lot.", "words": [[0, 182458], [6, 182823], [10, 183003], [14, 183163], [27, 183883], [30, 184083], [36, 184714], [41, 184936], [50, 185836], [52, 186016], [59, 187636], [61, 188096], [63, 188258], [70, 188421], [72, 188583], [74, 188746], [81, 189074], [83, 189344], [89, 189614], [98, 190314], [100, 190474]]}, {"verse": 28, "start": 191294, "end": 198300, "text": "Y murió Harán antes que su padre Taré en la tierra donde nació, en Ur de los caldeos.", "words": [[0, 191294], [2, 191441], [8, 191921], [14, 192401], [20, 192961], [24, 193401], [27, 193561], [33, 193921], [38, 194441], [41, 194601], [44, 194721], [51, 195021], [57, 195481], [64, 196701], [67, 196941], [70, 197121], [73, 197281], [77, 197401]]}, {"verse": 29, "start": 198650, "end": 211594, "text": "Y tomaron Abram y Nacor para sí mujeres: el nombre de la mujer de Abram fue Sarai, y el nombre de la mujer de Nacor, Milca, hija de Harán, padre de Milca y de Isca.", "words": [[0, 198650], [2, 198747], [10, 199137], [16, 199527], [18, 199917], [24, 200307], [29, 200527], [32, 200707], [41, 201693], [44, 201841], [51, 202181], [54, 202401], [57, 202521], [63, 202921], [66, 203231], [72, 203541], [76, 203881], [83, 204941], [85, 205281], [88, 205421], [95, 205781], [98, 206001], [101, 206101], [107, 206361], [110, 206601], [117, 207461], [124, 208321], [129, 208621], [132, 209141], [139, 209661], [145, 209921], [148, 210281], [154, 210641], [156, 210861], [159, 211252]]}, {"verse": 30, "start": 211944, "end": 215648, "text": "Mas Sarai fue estéril, y no tenía hijo.", "words": [[0, 211944], [4, 212288], [10, 213048], [14, 213308], [23, 214048], [25, 214528], [28, 214668], [34, 215008]]}, {"verse": 31, "start": 215998, "end": 233867, "text": "Y tomó