{"book": "LUK", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 514423, "verses": [{"verse": 1, "start": 300, "end": 8098, "text": "Habiendo muchos intentado poner en orden la historia de las cosas que entre nosotros han sido ciertísimas,", "words": [[0, 300], [9, 656], [16, 1016], [26, 1876], [32, 2216], [35, 2436], [41, 2756], [44, 3336], [53, 3836], [56, 4096], [60, 4236], [66, 4676], [70, 4976], [76, 5296], [85, 5796], [89, 6276], [94, 6656]]}, {"verse": 2, "start": 8448, "end": 14902, "text": "Como nos lo enseñaron los que desde el principio lo vieron por sus ojos, y fueron ministros de la palabra;", "words": [[0, 8448], [5, 8614], [9, 8814], [12, 8954], [22, 9754], [26, 9874], [30, 10074], [36, 10414], [39, 10654], [49, 11234], [52, 11474], [59, 11774], [63, 11974], [67, 12194], [73, 12574], [75, 13074], [82, 13294], [92, 13954], [95, 14094], [98, 14194]]}, {"verse": 3, "start": 15252, "end": 26078, "text": "Me ha parecido también a mí, después de haber entendido todas las cosas desde el principio con diligencia, escribírtelas por orden, oh muy buen Teófilo,", "words": [[0, 15252], [3, 15418], [6, 15558], [15, 16058], [23, 16418], [25, 16658], [29, 17038], [37, 17638], [40, 17818], [46, 17998], [56, 18658], [62, 18978], [66, 19298], [72, 19658], [78, 20078], [81, 20378], [91, 20978], [95, 21758], [107, 22538], [121, 23458], [125, 23698], [132, 24218], [135, 24738], [139, 25078], [144, 25378]]}, {"verse": 4, "start": 26428, "end": 31390, "text": "Para que conozcas la verdad de las cosas en las cuales has sido enseñado.", "words": [[0, 26428], [5, 26613], [9, 26773], [18, 27293], [21, 27453], [28, 27693], [31, 28013], [35, 28173], [41, 28573], [44, 29253], [48, 29353], [55, 29703], [59, 30053], [64, 30413]]}, {"verse": 5, "start": 31740, "end": 43665, "text": "HUBO en los días de Herodes, rey de Judea, un sacerdote llamado Zacarías, del grupo sacerdotal de Abías; y su mujer, de las hijas de Aarón, llamada Elisabet.", "words": [[0, 31740], [5, 32006], [8, 32066], [12, 32166], [17, 32426], [20, 32646], [29, 33186], [33, 33726], [36, 33946], [43, 34926], [46, 35026], [56, 35726], [64, 36046], [74, 37446], [78, 37526], [84, 37866], [95, 39106], [98, 39570], [105, 40206], [107, 40309], [110, 40429], [117, 40749], [120, 40909], [124, 41089], [130, 41429], [133, 41909], [140, 42389], [148, 43057]]}, {"verse": 6, "start": 44015, "end": 51642, "text": "Y eran ambos justos delante de Dios, andando sin reprensión en todos los mandamientos y estatutos del Señor.", "words": [[0, 44015], [2, 44158], [7, 44398], [13, 44998], [20, 45658], [28, 46118], [31, 46298], [37, 46898], [45, 47458], [49, 47948], [60, 48438], [63, 48778], [69, 49098], [73, 49318], [86, 50058], [88, 50278], [98, 50778], [102, 51038]]}, {"verse": 7, "start": 51992, "end": 58853, "text": "Y no tenían hijo, porque Elisabet era estéril, y ambos eran avanzados en días.", "words": [[0, 51992], [2, 52138], [5, 52438], [12, 52738], [18, 53598], [25, 54088], [34, 54578], [38, 55268], [47, 55958], [49, 56138], [55, 56518], [60, 57018], [70, 57938], [73, 58178]]}, {"verse": 8, "start": 59203, "end": 66495, "text": "Y aconteció que ejerciendo Zacarías el sacerdocio delante de Dios según el turno que le correspondía,", "words": [[0, 59203], [2, 59506], [12, 60166], [16, 60786], [27, 61406], [36, 62026], [39, 62226], [50, 63026], [58, 63486], [61, 63666], [66, 64306], [72, 64586], [75, 64826], [81, 65306], [85, 65386], [88, 65506]]}, {"verse": 9, "start": 66845, "end": 75072, "text": "Conforme a la costumbre del sacerdocio, salió en suerte a poner el incienso, entrando en el templo del Señor.", "words": [[0, 66845], [9, 67354], [11, 67554], [14, 67614], [24, 68194], [28, 68374], [40, 69714], [46, 70274], [49, 70534], [56, 71054], [58, 71214], [64, 71494], [67, 71694], [77, 72754], [86, 73354], [89, 73514], [92, 73654], [99, 74194], [103, 74334]]}, {"verse": 10, "start": 75422, "end": 80632, "text": "Y toda la multitud del pueblo estaba fuera orando a la hora del incienso.", "words": [[0, 75422], [2, 75560], [7, 75960], [10, 76220], [19, 76760], [23, 76960], [30, 77380], [37, 77680], [43, 78040], [50, 78780], [52, 79040], [55, 79160], [60, 79400], [64, 79620]]}, {"verse": 11, "start": 80982, "end": 86732, "text": "Y se le apareció el ángel del Señor puesto en pie a la derecha del altar del incienso.", "words": [[0, 80982], [2, 81129], [5, 81229], [8, 81389], [17, 82049], [20, 82349], [26, 82829], [30, 82949], [36, 83269], [43, 83669], [46, 84009], [50, 84249], [52, 84449], [55, 84549], [63, 84989], [67, 85209], [73, 85609], [77, 85889]]}, {"verse": 12, "start": 87082, "end": 90577, "text": "Y se turbó Zacarías viéndole, y cayó temor sobre él.", "words": [[0, 87082], [2, 87191], [5, 87311], [11, 87811], [20, 88311], [30, 88871], [32, 89071], [37, 89451], [43, 89831], [49, 90131]]}, {"verse": 13, "start": 90927, "end": 100038, "text": "Pero el ángel le dijo: Zacarías, no temas; porque tu oración ha sido oída, y tu mujer Elisabet te parirá un hijo, y llamarás su nombre Juan.", "words": [[0, 90927], [5, 91211], [8, 91371], [14, 91851], [17, 92131], [23, 93020], [33, 93310], [36, 93470], [43, 94284], [50, 94450], [53, 94670], [61, 95090], [64, 95290], [69, 95530], [75, 95970], [77, 96330], [80, 96450], [86, 96790], [95, 97130], [98, 97550], [105, 97930], [108, 98090], [114, 98350], [116, 98770], [125, 99170], [128, 99310], [135, 99530]]}, {"verse": 14, "start": 100388, "end": 103885, "text": "Y tendrás gozo y alegría, y muchos se gozarán de su nacimiento.", "words": [[0, 100388], [2, 100473], [10, 100793], [15, 101173], [17, 101293], [26, 101793], [28, 101973], [35, 102273], [38, 102473], [46, 102933], [49, 102993], [52, 103113]]}, {"verse": 15, "start": 104235, "end": 112458, "text": "Porque será grande delante de Dios, y no beberá vino ni bebida embriagante; y será lleno del Espíritu Santo, aun desde el seno de su madre.", "words": [[0, 104235], [7, 104465], [12, 104705], [19, 105105], [27, 105565], [30, 105745], [36, 106025], [38, 106300], [41, 106440], [48, 106860], [53, 107140], [56, 107360], [63, 107740], [76, 108838], [78, 108942], [83, 109122], [89, 109542], [93, 109662], [102, 110222], [109, 110582], [113, 110962], [119, 111242], [122, 111462], [127, 111782], [130, 111862], [133, 112002]]}, {"verse": 16, "start": 112808, "end": 116348, "text": "Y a muchos de los hijos de Israel convertirá al Señor Dios de ellos.", "words": [[0, 112808], [2, 112909], [4, 113009], [11, 113269], [14, 113449], [18, 113569], [24, 113789], [27, 113949], [34, 114269], [45, 114989], [48, 115089], [54, 115329], [59, 115629], [62, 115889]]}, {"verse": 17, "start": 116698, "end": 128621, "text": "Porque él irá delante de él con el espíritu y poder de Elías, para convertir los corazones de los padres a los hijos, y los rebeldes a la prudencia de los justos, para preparar al Señor un pueblo bien dispuesto.", "words": [[0, 116698], [7, 116917], [10, 117117], [14, 117357], [22, 117777], [25, 117917], [28, 118057], [32, 118257], [35, 118377], [44, 118957], [46, 119037], [52, 119277], [55, 119497], [62, 120117], [67, 120377], [77, 120957], [81, 121077], [91, 121677], [94, 121817], [98, 121957], [105, 122297], [107, 122537], [111, 122677], [118, 123475], [120, 123574], [124, 123674], [133, 124154], [135, 124274], [138, 124354], [148, 124794], [151, 124914], [155, 125054], [163, 125874], [168, 126174], [177, 126694], [180, 126774], [186, 127034], [189, 127274], [196, 127574], [201, 127854]]}, {"verse": 18, "start": 128901, "end": 135710, "text": "Y dijo Zacarías al ángel: ¿En qué conoceré esto? porque yo soy viejo, y mi mujer avanzada en días.", "words": [[0, 128901], [2, 129027], [7, 129645], [16, 130262], [19, 130482], [26, 131340], [30, 131477], [34, 131677], [43, 132217], [49, 132798], [56, 132978], [59, 133158], [63, 133338], [70, 133858], [72, 134178], [75, 134278], [81, 134518], [90, 135078], [93, 135198]]}, {"verse": 19, "start": 135990, "end": 145198, "text": "Y respondiendo el ángel le dijo: Yo soy Gabriel, que estoy delante de Dios; y soy enviado a hablarte, y a darte estas buenas nuevas.", "words": [[0, 135990], [2, 136197], [15, 137397], [18, 137597], [24, 138097], [27, 138217], [33, 139132], [36, 139282], [40, 139482], [49, 140102], [53, 140122], [59, 140402], [67, 140862], [70, 141022], [76, 141833], [78, 141958], [82, 142038], [90, 142618], [92, 142718], [102, 143318], [104, 143498], [106, 143638], [112, 143938], [118, 144158], [125, 144478]]}, {"verse": 20, "start": 145548, "end": 153627, "text": "Y he aquí estarás mudo y no podrás hablar, hasta el día que esto sea hecho, por cuanto no creíste a mis palabras, las cuales se cumplirán a su tiempo.", "words": [[0, 145548], [2, 145692], [5, 145812], [10, 146012], [18, 146492], [23, 146812], [25, 146892], [28, 147012], [35, 147392], [43, 148072], [49, 148332], [52, 148492], [56, 148672], [60, 148832], [65, 149032], [69, 149332], [76, 149812], [80, 149912], [87, 150092], [90, 150332], [98, 150612], [100, 150892], [104, 151012], [114, 151752], [118, 151872], [125, 152152], [128, 152412], [138, 152912], [140, 152972], [143, 153112]]}, {"verse": 21, "start": 153907, "end": 159757, "text": "Y el pueblo estaba esperando a Zacarías, y se maravillaban de que él se detuviese en el templo.", "words": [[0, 153907], [2, 154028], [5, 154168], [12, 154428], [19, 154768], [29, 155288], [31, 155468], [41, 156028], [43, 156493], [46, 156633], [59, 157313], [62, 157553], [66, 157693], [69, 157933], [72, 158113], [82, 158773], [85, 158953], [88, 159093]]}, {"verse": 22, "start": 160107, "end": 169568, "text": "Y saliendo, no les podía hablar: y entendieron que había visto visión en el templo: y él les hablaba por señas, y quedó mudo.", "words": [[0, 160107], [2, 160212], [12, 160672], [15, 160952], [19, 161152], [25, 161532], [33, 162411], [35, 162611], [47, 163311], [51, 163531], [57, 163731], [63, 164051], [70, 164591], [73, 164831], [76, 164991], [84, 165879], [86, 166099], [89, 166359], [93, 166739], [101, 167259], [105, 167479], [112, 168459], [114, 168699], [120, 169039]]}, {"verse": 23, "start": 169918, "end": 173916, "text": "Y fue, que cumplidos los días de su oficio, se vino a su casa.", "words": [[0, 169918], [2, 170025], [7, 170165], [11, 170305], [21, 170985], [25, 171165], [30, 171425], [33, 171605], [36, 171785], [44, 172605], [47, 172825], [52, 173025], [54, 173205], [57, 173305]]}, {"verse": 24, "start": 174266, "end": 181216, "text": "Y después de aquellos días concibió su mujer Elisabet, y se mantuvo oculta por cinco meses, diciendo:", "words": [[0, 174266], [2, 174375], [10, 174695], [13, 174855], [22, 175015], [27, 175395], [36, 176155], [39, 176295], [45, 176845], [55, 177395], [57, 177950], [60, 178070], [68, 178590], [75, 179250], [79, 179390], [85, 179690], [92, 180510]]}, {"verse": 25, "start": 181416, "end": 186706, "text": "Porque el Señor me ha hecho así en los días en que miró para quitar mi vergüenza entre los hombres.", "words": [[0, 181416], [7, 181616], [10, 181716], [16, 181976], [19, 182236], [22, 182316], [28, 182496], [32, 182816], [35, 183076], [39, 183236], [44, 183516], [47, 183756], [51, 183876], [56, 184216], [61, 184496], [68, 184876], [71, 185016], [81, 185576], [87, 185816], [91, 185996]]}, {"verse": 26, "start": 186986, "end": 194445, "text": "Y al sexto mes, el ángel Gabriel fue enviado de Dios a una ciudad de Galilea, llamada Nazaret,", "words": [[0, 186986], [2, 187143], [5, 187303], [11, 187763], [16, 188563], [19, 188863], [25, 189263], [33, 189663], [37, 190023], [45, 190583], [48, 190783], [53, 191023], [55, 191243], [59, 191403], [66, 191743], [69, 192023], [78, 192961], [86, 193541]]}, {"verse": 27, "start": 194795, "end": 202376, "text": "A una virgen desposada con un varón que se llamaba José, de la casa de David: y el nombre de la virgen era María.", "words": [[0, 194807], [2, 194907], [6, 195067], [13, 195487], [23, 196187], [27, 196427], [30, 196567], [36, 196907], [40, 197067], [43, 197187], [51, 197547], [57, 198007], [60, 198427], [63, 198527], [68, 198787], [71, 199027], [78, 199817], [80, 199978], [83, 200138], [90, 200538], [93, 200718], [96, 200858], [103, 201378], [107, 201718]]}, {"verse": 28, "start": 202726, "end": 210918, "text": "Y entrando el ángel a donde estaba, dijo, ¡Salve, muy favorecida! el Señor es contigo: bendita tú entre las mujeres.", "words": [[0, 202726], [2, 202873], [11, 203333], [14, 203553], [20, 204033], [22, 204133], [28, 204313], [36, 204753], [42, 205690], [50, 206091], [54, 206291], [66, 207369], [69, 207531], [75, 207811], [78, 208031], [87, 208996], [95, 209533], [98, 209753], [104, 209973], [108, 210193]]}, {"verse": 29, "start": 211198, "end": 217913, "text": "Pero ella, cuando le vio, se turbó de sus palabras, y pensaba qué clase de saludo era este.", "words": [[0, 211198], [5, 211363], [11, 211823], [18, 211923], [21, 212203], [26, 212963], [29, 213183], [35, 213643], [38, 213743], [42, 213903], [52, 214483], [54, 214938], [62, 215518], [66, 215758], [72, 216258], [75, 216478], [82, 217038], [86, 217298]]}, {"verse": 30, "start": 218263, "end": 223787, "text": "Entonces el ángel le dijo: María, no temas, porque has hallado gracia ante Dios.", "words": [[0, 218263], [9, 219123], [12, 219403], [18, 219823], [21, 219923], [27, 220652], [34, 221031], [37, 221091], [44, 221731], [51, 221951], [55, 222191], [63, 222531], [70, 222871], [75, 223331]]}, {"verse": 31, "start": 224137, "end": 229096, "text": "Y he aquí, concebirás en tu seno, y parirás un hijo, y llamarás su nombre JESÚS.", "words": [[0, 224137], [2, 224295], [5, 224395], [11, 224655], [22, 225375], [25, 225515], [28, 225655], [34, 226355], [36, 226395], [44, 226875], [47, 227035], [53, 227295], [55, 227615], [64, 228035], [67, 228175], [74, 228415]]}, {"verse": 32, "start": 229446, "end": 235723, "text": "Este será grande, y será llamado Hijo del Altísimo: y le dará el Señor Dios el trono de David su padre:", "words": [[0, 229446], [5, 229682], [10, 229942], [18, 230362], [20, 230622], [25, 230802], [33, 231202], [38, 231622], [42, 231782], [52, 232771], [54, 232895], [57, 232975], [62, 233235], [65, 233315], [71, 233595], [76, 233935], [79, 234255], [85, 234575], [88, 234675], [94, 234975], [97, 235235]]}, {"verse": 33, "start": 236003, "end": 240990, "text": "Y reinará en la casa de Jacob por siempre; y de su reino no habrá fin.", "words": [[0, 236003], [2, 236129], [10, 236789], [13, 236869], [16, 236989], [21, 237269], [24, 237489], [30, 237809], [34, 238149], [43, 239079], [45, 239185], [48, 239305], [51, 239445], [57, 239945], [60, 240125], [66, 240445]]}, {"verse": 34, "start": 241340, "end": 246513, "text": "Entonces María dijo al ángel: ¿Cómo será esto? porque no conozco varón.", "words": [[0, 241340], [9, 241705], [15, 242645], [20, 242985], [23, 243165], [30, 243886], [36, 244089], [41, 244349], [47, 245157], [54, 245321], [57, 245481], [65, 245921]]}, {"verse": 35, "start": 246793, "end": 258553, "text": "Y respondiendo el ángel le dijo: El Espíritu Santo vendrá sobre ti, y el poder del Altísimo te hará sombra; por lo cual también lo Santo que nacerá, será llamado Hijo de Dios.", "words": [[0, 246793], [2, 247000], [15, 248200], [18, 248400], [24, 248900], [27, 249020], [33, 249793], [36, 249911], [45, 250431], [51, 250711], [58, 251231], [64, 251451], [68, 251751], [70, 252331], [73, 252451], [79, 252691], [83, 252911], [92, 253471], [95, 253751], [100, 253971], [108, 254711], [112, 254816], [115, 254936], [120, 255136], [128, 255416], [131, 255696], [137, 256036], [141, 256196], [149, 256656], [154, 257136], [162, 257576], [167, 257896], [170, 258056]]}, {"verse": 36, "start": 258903, "end": 266284, "text": "Y he aquí, Elisabet tu parienta, también ella ha concebido hijo en su vejez; y este es el sexto mes a ella que es llamada la estéril:", "words": [[0, 258903], [2, 259044], [5, 259164], [11, 259464], [20, 259764], [23, 260004], [33, 260844], [41, 261104], [46, 261384], [49, 261544], [59, 262064], [64, 262304], [67, 262541], [70, 262777], [77, 263234], [79, 263401], [84, 263661], [87, 263841], [90, 263961], [96, 264341], [100, 264541], [102, 264681], [107, 264881], [111, 265081], [114, 265221], [122, 265581], [125, 265701]]}, {"verse": 37, "start": 266634, "end": 269146, "text": "Porque ninguna cosa es imposible para Dios.", "words": [[0, 266634], [7, 266819], [15, 267139], [20, 267559], [23, 267759], [33, 268359], [38, 268579]]}, {"verse": 38, "start": 269426, "end": 277639, "text": "Entonces María dijo: He aquí la sierva del Señor; hágase a mí conforme a tu palabra. Y el ángel partió de ella.", "words": [[0, 269426], [9, 269971], [15, 270511], [21, 271439], [24, 271499], [29, 271779], [32, 271979], [39, 272419], [43, 272559], [50, 273402], [57, 273828], [59, 273968], [62, 274088], [71, 274708], [73, 274748], [76, 274828], [85, 275775], [87, 275940], [90, 276080], [96, 276540], [103, 277000], [106, 277160]]}, {"verse": 39, "start": 277989, "end": 284375, "text": "En aquellos días levantándose María, fue a la montaña con prisa, a una ciudad de Judá;", "words": [[0, 277989], [3, 278279], [12, 278479], [17, 279359], [30, 280159], [37, 280499], [41, 280859], [43, 280999], [46, 281059], [54, 281599], [58, 281819], [65, 282399], [67, 282779], [71, 282939], [78, 283319], [81, 283579]]}, {"verse": 40, "start": 284725, "end": 288865, "text": "Y entró en casa de Zacarías, y saludó a Elisabet.", "words": [[0, 284725], [2, 284892], [8, 285312], [11, 285452], [16, 285732], [19, 286212], [29, 286692], [31, 287272], [38, 287952], [40, 288443]]}, {"verse": 41, "start": 289215, "end": 298487, "text": "Y aconteció, que como oyó Elisabet el saludo de María, la criatura saltó en su vientre; y Elisabet fue llena del Espíritu Santo,", "words": [[0, 289215], [2, 289320], [13, 290100], [17, 290420], [22, 290600], [26, 291030], [35, 291460], [38, 291800], [45, 292200], [48, 292360], [55, 293200], [58, 293300], [67, 293900], [73, 294460], [76, 294560], [79, 294720], [88, 295619], [90, 295766], [99, 296326], [103, 296766], [109, 297186], [113, 297326], [122, 297906]]}, {"verse": 42, "start": 298837, "end": 305428, "text": "Y exclamó a gran voz, y dijo: Bendita tú entre las mujeres, y bendito el fruto de tu vientre.", "words": [[0, 298837], [2, 299020], [10, 299720], [12, 299820], [17, 299980], [22, 300360], [24, 300660], [30, 301330], [38, 301960], [41, 302180], [47, 302440], [51, 302680], [60, 303120], [62, 303485], [70, 304045], [73, 304205], [79, 304525], [82, 304665], [85, 304805]]}, {"verse": 43, "start": 305778, "end": 309584, "text": "¿Y de dónde esto a mí, que la madre de mi Señor venga a mí?", "words": [[0, 305778], [3, 305885], [6, 306005], [12, 306225], [17, 306605], [19, 306805], [23, 307305], [27, 307405], [30, 307545], [36, 307885], [39, 308085], [42, 308205], [48, 308585], [54, 309105], [56, 309285]]}, {"verse": 44, "start": 309934, "end": 316227, "text": "Porque he aquí, cuando llegó la voz de tu saludo a mis oídos, la criatura saltó de alegría en mi vientre.", "words": [[0, 309934], [7, 310134], [10, 310414], [16, 310694], [23, 310914], [29, 311254], [32, 311494], [36, 311734], [39, 311874], [42, 311994], [49, 312454], [51, 312574], [55, 312714], [62, 313554], [65, 313694], [74, 314234], [80, 314734], [83, 314834], [91, 315354], [94, 315474], [97, 315594]]}, {"verse": 45, "start": 316578, "end": 322475, "text": "Y bienaventurada la que creyó, porque se cumplirán las cosas que le fueron dichas de parte del Señor.", "words": [[0, 316578], [2, 316657], [17, 317477], [20, 317618], [24, 317778], [31, 318477], [38, 318977], [41, 319138], [51, 319638], [55, 319818], [61, 320157], [65, 320398], [68, 320537], [75, 320798], [82, 321258], [85, 321378], [91, 321638], [95, 321917]]}, {"verse": 46, "start": 322755, "end": 326811, "text": "Entonces María dijo: engrandece mi alma al Señor;", "words": [[0, 322755], [9, 323300], [15, 323840], [21, 324708], [32, 325490], [35, 325690], [40, 325970], [43, 326290]]}, {"verse": 47, "start": 327161, "end": 329875, "text": "Y mi espíritu se alegró en Dios mi Salvador.", "words": [[0, 327161], [2, 327270], [5, 327370], [14, 328050], [17, 328150], [24, 328590], [27, 328730], [32, 329150], [35, 329230]]}, {"verse": 48, "start": 330225, "end": 337895, "text": "Porque ha mirado a la condición humilde de su sierva; porque he aquí, desde ahora me dirán bienaventurada todas las generaciones.", "words": [[0, 330225], [7, 330403], [10, 330603], [17, 331063], [19, 331163], [22, 331223], [32, 331823], [40, 332343], [43, 332483], [46, 332623], [54, 333485], [61, 333685], [64, 333965], [70, 334265], [76, 334485], [82, 334930], [85, 335375], [91, 335820], [106, 336265], [112, 336505], [116, 336805]]}, {"verse": 49, "start": 338245, "end": 342304, "text": "Porque me ha hecho grandes cosas el Poderoso; y santo es su nombre.", "words": [[0, 338245], [7, 338393], [10, 338593], [13, 338693], [19, 338873], [27, 339173], [33, 339593], [36, 339853], [46, 340855], [48, 340965], [54, 341365], [57, 341665], [60, 341785]]}, {"verse": 50, "start": 342654, "end": 346984, "text": "Y su misericordia de generación a generación a los que le temen.", "words": [[0, 342654], [2, 342743], [5, 342883], [18, 343723], [21, 343823], [32, 344843], [34, 345023], [45, 345743], [47, 346023], [51, 346163], [55, 346303], [58, 346443]]}, {"verse": 51, "start": 347334, "end": 352535, "text": "Mostró poder con su brazo: esparció los soberbios del pensamiento de su corazón.", "words": [[0, 347334], [7, 347738], [13, 347998], [17, 348258], [20, 348438], [27, 349228], [36, 349815], [40, 350015], [50, 350615], [54, 350775], [66, 351475], [69, 351635], [72, 351775]]}, {"verse": 52, "start": 352885, "end": 356490, "text": "Quitó los poderosos de los tronos, y levantó a los humildes.", "words": [[0, 352885], [6, 353167], [10, 353307], [20, 353887], [23, 354047], [27, 354167], [35, 354707], [37, 355047], [45, 355547], [47, 355627], [51, 355747]]}, {"verse": 53, "start": 356840, "end": 360760, "text": "A los hambrientos llenó de bienes; y a los ricos envió vacíos.", "words": [[0, 356840], [2, 356965], [6, 357345], [18, 357725], [24, 357985], [27, 358105], [35, 358913], [37, 359037], [39, 359097], [43, 359257], [49, 359637], [55, 360057]]}, {"verse": 54, "start": 361110, "end": 366285, "text": "Recibió a Israel su siervo, acordándose de la misericordia,", "words": [[0, 361110], [8, 361711], [10, 361791], [17, 362211], [20, 362411], [28, 362931], [40, 363931], [43, 364051], [46, 364151]]}, {"verse": 55, "start": 366635, "end": 371260, "text": "Como habló a nuestros padres a Abraham y a su descendencia para siempre.", "words": [[0, 366635], [5, 366795], [11, 367175], [13, 367255], [22, 367455], [29, 368075], [31, 368455], [39, 368915], [41, 369355], [43, 369435], [46, 369515], [59, 370335], [64, 370535]]}, {"verse": 56, "start": 371540, "end": 375914, "text": "Y se quedó María con ella como tres meses: después se volvió a su casa.", "words": [[0, 371540], [2, 371661], [5, 371741], [11, 372061], [17, 372321], [21, 372621], [26, 372801], [31, 373081], [36, 373381], [43, 374341], [51, 374605], [54, 374805], [61, 375185], [63, 375245], [66, 375345]]}, {"verse": 57, "start": 376264, "end": 380687, "text": "Y a Elisabet se le cumplió el tiempo de parir, y parió un hijo.", "words": [[0, 376264], [2, 376411], [4, 376711], [13, 377011], [16, 377471], [19, 377611], [27, 378031], [30, 378131], [37, 378411], [40, 378611], [47, 379051], [49, 379451], [55, 379891], [58, 380211]]}, {"verse": 58, "start": 381037, "end": 388247, "text": "Y oyeron los vecinos y los parientes que Dios había hecho con ella grande misericordia, y se alegraron con ella.", "words": [[0, 381037], [2, 381178], [9, 381598], [13, 381738], [21, 382258], [23, 382438], [27, 382538], [37, 383018], [41, 383298], [46, 383538], [52, 383938], [58, 384318], [62, 384578], [67, 384758], [74, 385138], [88, 386158], [90, 386778], [93, 386938], [103, 387498], [107, 387758]]}, {"verse": 59, "start": 388597, "end": 397142, "text": "Y aconteció, que al octavo día vinieron para circuncidar al niño; y le llamaban del nombre de su padre, Zacarías.", "words": [[0, 388597], [2, 389069], [13, 389569], [17, 389769], [20, 389949], [27, 390389], [31, 390689], [40, 391329], [45, 391689], [57, 392709], [60, 392949], [66, 393832], [68, 393949], [71, 394099], [80, 394599], [84, 394819], [91, 395139], [94, 395359], [97, 395499], [104, 396356]]}, {"verse": 60, "start": 397492, "end": 402332, "text": "Y respondiendo su madre, dijo: No; sino Juan será llamado.", "words": [[0, 397492], [2, 397636], [15, 398476], [18, 398696], [25, 399336], [31, 400096], [35, 400737], [40, 400999], [45, 401339], [50, 401639]]}, {"verse": 61, "start": 402612, "end": 407104, "text": "Y le dijeron: ¿Por qué? nadie hay en tu parentela que se llame de este nombre.", "words": [[0, 402612], [2, 402759], [5, 402839], [14, 403802], [19, 403943], [24, 404492], [30, 404897], [34, 405037], [37, 405157], [40, 405277], [50, 405757], [54, 405917], [57, 406087], [63, 406257], [66, 406457], [71, 406617]]}, {"verse": 62, "start": 407384, "end": 410783, "text": "Y hablaron por señas a su padre, cómo le quería llamar.", "words": [[0, 407384], [2, 407492], [11, 407912], [15, 408072], [21, 408592], [23, 408692], [26, 408812], [33, 409192], [38, 409597], [41, 409927], [48, 410257]]}, {"verse": 63, "start": 411133, "end": 418323, "text": "Y pidiendo la tablilla, escribió, diciendo: Juan es su nombre. Y todos se maravillaron.", "words": [[0, 411133], [2, 411438], [11, 411918], [14, 412278], [24, 412638], [34, 413758], [44, 414883], [49, 415169], [52, 415589], [55, 415749], [63, 416473], [65, 416595], [71, 416895], [74, 417335]]}, {"verse": 64, "start": 418673, "end": 423791, "text": "Y luego fue abierta su boca y su lengua, y habló bendiciendo a Dios.", "words": [[0, 418673], [2, 418815], [8, 419015], [12, 419375], [20, 419935], [23, 420115], [28, 420475], [30, 420615], [33, 420795], [41, 421775], [43, 422055], [49, 422375], [61, 423055], [63, 423215]]}, {"verse": 65, "start": 424141, "end": 431973, "text": "Y fue un temor sobre todos los vecinos de ellos; y en todas las montañas de Judea fueron divulgadas todas estas cosas.", "words": [[0, 424141], [2, 424301], [6, 424461], [9, 424621], [15, 424961], [21, 425221], [27, 425581], [31, 425861], [39, 426301], [42, 426461], [49, 427253], [51, 427398], [54, 427558], [60, 427818], [64, 428118], [73, 428798], [76, 428898], [82, 429438], [89, 429658], [100, 430478], [106, 430798], [112, 431198]]}, {"verse": 66, "start": 432323, "end": 441584, "text": "Y todos los que las oían, las conservaban en su corazón, diciendo: ¿Quién será este niño? Y la mano del Señor estaba con él.", "words": [[0, 432323], [2, 432601], [8, 432861], [12, 433061], [16, 433261], [20, 433441], [26, 434161], [30, 434561], [42, 435421], [45, 435601], [48, 435781], [57, 436321], [67, 437895], [74, 438153], [79, 438313], [84, 438593], [90, 439355], [92, 439474], [95, 439594], [100, 439834], [104, 440054], [110, 440374], [117, 440814], [121, 441154]]}, {"verse": 67, "start": 441934, "end": 447641, "text": "Y Zacarías su padre fue lleno de Espíritu Santo, y profetizó, diciendo:", "words": [[0, 441934], [2, 442286], [11, 442666], [14, 442906], [20, 443426], [24, 443566], [30, 443946], [33, 444046], [42, 444646], [49, 445686], [51, 445766], [62, 446606]]}, {"verse": 68, "start": 447841, "end": 452224, "text": "Bendito el Señor Dios de Israel, que ha visitado y hecho redención a su pueblo,", "words": [[0, 447841], [8, 448287], [11, 448447], [17, 448707], [22, 449047], [25, 449267], [33, 449587], [37, 449847], [40, 449947], [49, 450587], [51, 450747], [57, 450967], [67, 451447], [69, 451587], [72, 451687]]}, {"verse": 69, "start": 452574, "end": 456828, "text": "Y nos levantó un cuerno de salvación en la casa de David su siervo,", "words": [[0, 452574], [2, 452660], [6, 452740], [14, 453240], [17, 453340], [24, 453760], [27, 453840], [37, 454440], [40, 454600], [43, 454700], [48, 454960], [51, 455120], [57, 455540], [60, 455620]]}, {"verse": 70, "start": 457178, "end": 461027, "text": "Como habló por boca de sus santos profetas que fueron desde el principio:", "words": [[0, 457178], [5, 457388], [11, 457638], [15, 457818], [20, 458118], [23, 458278], [27, 458418], [34, 458878], [43, 459378], [47, 459578], [54, 459838], [60, 460118], [63, 460318]]}, {"verse": 71, "start": 461377, "end": 465443, "text": "Salvación de nuestros enemigos, y de mano de todos los que nos aborrecieron;", "words": [[0, 461377], [10, 461945], [13, 462105], [22, 462325], [32, 463085], [34, 463325], [37, 463445], [42, 463645], [45, 463825], [51, 464045], [55, 464305], [59, 464465], [63, 464605]]}, {"verse": 72, "start": 465793, "end": 470324, "text": "Para hacer misericordia con nuestros padres, y acordándose de su santo pacto;", "words": [[0, 465793], [5, 465972], [11, 466232], [24, 467112], [28, 467312], [37, 467512], [45, 468092], [47, 468407], [59, 469147], [62, 469267], [65, 469427], [71, 469727]]}, {"verse": 73, "start": 470674, "end": 474747, "text": "Del juramento que juró a Abraham nuestro padre, que nos había de dar,", "words": [[0, 470674], [4, 470817], [14, 471337], [18, 471647], [23, 471957], [25, 472077], [33, 472577], [41, 472797], [48, 473477], [52, 473657], [56, 473797], [62, 474117], [65, 474297]]}, {"verse": 74, "start": 475097, "end": 478451, "text": "Que sin temor librados de nuestros enemigos, le serviríamos", "words": [[0, 475097], [4, 475181], [8, 475361], [14, 475721], [23, 476161], [26, 476301], [35, 476481], [45, 477401], [48, 477641]]}, {"verse": 75, "start": 478801, "end": 482923, "text": "En santidad y en justicia delante de él, todos los días nuestros.", "words": [[0, 478801], [3, 478924], [12, 479524], [14, 479664], [17, 479764], [26, 480324], [34, 480724], [37, 480904], [41, 481124], [47, 481564], [51, 481864], [56, 482104]]}, {"verse": 76, "start": 483273, "end": 489741, "text": "Y tú, niño, profeta del Altísimo serás llamado; porque irás ante la faz del Señor, para preparar sus caminos;", "words": [[0, 483273], [2, 483398], [6, 483538], [12, 484158], [20, 484638], [24, 484798], [33, 485398], [39, 485638], [48, 486408], [55, 486567], [60, 486817], [65, 487067], [68, 487227], [72, 487447], [76, 487607], [83, 487987], [88, 488467], [97, 488927], [101, 489027]]}, {"verse": 77, "start": 490091, "end": 494227, "text": "Dando conocimiento de salvación a su pueblo, para perdón de sus pecados,", "words": [[0, 490217], [6, 490347], [19, 491067], [22, 491207], [32, 491747], [34, 491867], [37, 491967], [45, 492387], [50, 492727], [57, 493187], [60, 493307], [64, 493507]]}, {"verse": 78, "start": 494577, "end": 499807, "text": "Por la profunda misericordia de nuestro Dios, el Sol naciente nos visitó desde lo alto,", "words": [[0, 494577], [4, 494683], [7, 494823], [16, 495303], [29, 496063], [32, 496163], [40, 496323], [46, 497283], [49, 497343], [53, 497583], [62, 498123], [66, 498343], [73, 498923], [79, 499063], [82, 499323]]}, {"verse": 79, "start": 500157, "end": 506191, "text": "Para dar luz a los que habitan en tinieblas y en sombra de muerte; para encaminar nuestros pies por camino de paz.", "words": [[0, 500157], [5, 500317], [9, 500457], [13, 500657], [15, 500797], [19, 500917], [23, 501057], [31, 501437], [34, 501577], [44, 502177], [46, 502377], [49, 502517], [56, 502857], [59, 502937], [67, 503703], [72, 503861], [82, 504381], [91, 504601], [96, 504981], [100, 505301], [107, 505561], [110, 505761]]}, {"verse": 80, "start": 506471, "end": 514023, "text": "Y el niño crecía, y se fortalecía en espíritu: y estuvo en los desiertos hasta el día que se mostró a Israel.", "words": [[0, 506471], [2, 506631], [5, 506791], [10, 507111], [18, 507851], [20, 508106], [23, 508266], [34, 509086], [37, 509226], [47, 510144], [49, 510405], [56, 510745], [59, 510885], [63, 510985], [73, 511665], [79, 511905], [82, 512065], [86, 512285], [90, 512445], [93, 512585], [100, 513085], [102, 513205]]}]}