{"book": "JHN", "chapter": 12, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 355216, "verses": [{"verse": 1, "start": 300, "end": 8030, "text": "Then Jesus six days before the passover came to Bethany, where Lazarus was which had been dead, whom he raised from the dead.", "words": [[0, 300], [5, 580], [11, 980], [15, 1360], [20, 1680], [27, 2120], [31, 2360], [40, 2840], [45, 3180], [48, 3380], [57, 4120], [63, 4440], [71, 5060], [75, 5260], [81, 5600], [85, 5760], [90, 5980], [96, 6320], [101, 6660], [104, 6840], [111, 7200], [116, 7440], [120, 7580]]}, {"verse": 2, "start": 8480, "end": 15476, "text": "There they made him a supper; and Martha served: but Lazarus was one of them that sat at the table with him.", "words": [[0, 8480], [6, 8682], [11, 8882], [16, 9102], [20, 9242], [22, 9362], [30, 10182], [34, 10330], [41, 10610], [49, 11560], [53, 11690], [61, 12290], [65, 12490], [69, 12730], [72, 12850], [77, 13090], [82, 13310], [86, 13570], [89, 13710], [93, 13810], [99, 14130], [104, 14410]]}, {"verse": 3, "start": 15926, "end": 26849, "text": "Then took Mary a pound of ointment of spikenard, very costly, and anointed the feet of Jesus, and wiped his feet with her hair: and the house was filled with the odour of the ointment.", "words": [[0, 15926], [5, 16126], [10, 16346], [15, 16666], [17, 16886], [23, 17086], [26, 17306], [35, 17726], [38, 17846], [49, 18846], [54, 19106], [62, 20246], [66, 20386], [75, 20766], [79, 21026], [84, 21226], [87, 21386], [94, 22326], [98, 22406], [104, 22626], [108, 22886], [113, 23106], [118, 23306], [122, 23446], [128, 24193], [132, 24335], [136, 24435], [142, 24695], [146, 24955], [153, 25235], [158, 25515], [162, 25725], [168, 25935], [171, 26115], [175, 26235]]}, {"verse": 4, "start": 27299, "end": 33448, "text": "Then says one of his disciples, Judas Iscariot, Simon’s son, which should betray him,", "words": [[0, 27299], [5, 27529], [10, 27889], [14, 28209], [17, 28349], [21, 28489], [32, 29509], [38, 29889], [48, 31089], [56, 31749], [61, 32229], [67, 32389], [74, 32669], [81, 33029]]}, {"verse": 5, "start": 33698, "end": 37604, "text": "Why was not this ointment sold for three hundred denarii, and given to the poor?", "words": [[0, 33698], [4, 33862], [8, 34042], [12, 34202], [17, 34452], [26, 34702], [31, 35022], [35, 35262], [41, 35502], [49, 35742], [58, 36462], [62, 36622], [68, 36862], [71, 37062], [75, 37182]]}, {"verse": 6, "start": 37954, "end": 45319, "text": "This he said, not that he cared for the poor; but because he was a thief, and had the bag, and carried what was put in it.", "words": [[0, 37954], [5, 38390], [8, 38470], [14, 38810], [18, 38950], [23, 39150], [26, 39250], [32, 39490], [36, 39670], [40, 39810], [46, 40815], [50, 41075], [58, 41395], [61, 41635], [65, 41855], [67, 41975], [74, 42215], [78, 42735], [82, 42895], [86, 43035], [91, 43355], [95, 43875], [103, 44215], [108, 44475], [112, 44655], [116, 44875], [119, 45075]]}, {"verse": 7, "start": 45769, "end": 51182, "text": "Then said Jesus, Let her alone: against the day of my burying has she kept this.", "words": [[0, 45769], [5, 45996], [10, 46256], [17, 47207], [21, 47389], [25, 47589], [32, 48463], [40, 48762], [44, 48982], [48, 49182], [51, 49302], [54, 49482], [62, 50062], [66, 50162], [70, 50322], [75, 50622]]}, {"verse": 8, "start": 51632, "end": 55291, "text": "For the poor always you have with you; but me you have not always.", "words": [[0, 51632], [4, 51716], [8, 51816], [13, 52096], [20, 52516], [24, 52756], [29, 52936], [34, 53156], [39, 53804], [43, 53908], [46, 54288], [50, 54368], [55, 54508], [59, 54648]]}, {"verse": 9, "start": 55641, "end": 65123, "text": "Much people of the Jews therefore knew that he was there: and they came not for Jesus’ sake only, but that they might see Lazarus also, whom he had raised from the dead.", "words": [[0, 55641], [5, 55794], [12, 56114], [15, 56334], [19, 56434], [24, 56734], [34, 57154], [39, 57494], [44, 57714], [47, 57834], [51, 58014], [58, 58824], [62, 58949], [67, 59049], [72, 59269], [76, 59529], [80, 59729], [87, 60329], [92, 60589], [98, 61329], [102, 61469], [107, 61589], [112, 61729], [118, 61929], [122, 62169], [130, 62749], [136, 63449], [141, 63629], [144, 63829], [148, 63949], [155, 64249], [160, 64489], [164, 64649]]}, {"verse": 10, "start": 65573, "end": 69656, "text": "¶ But the chief priests consulted that they might put Lazarus also to death;", "words": [[2, 65573], [6, 65686], [10, 65786], [16, 66046], [24, 66446], [34, 67186], [39, 67506], [44, 67646], [50, 67886], [54, 68066], [62, 68706], [67, 69026], [70, 69246]]}, {"verse": 11, "start": 70106, "end": 74953, "text": "Because that by reason of him many of the Jews went away, and believed on Jesus.", "words": [[0, 70106], [8, 70285], [13, 70585], [16, 70805], [23, 71145], [26, 71345], [30, 71505], [35, 71825], [38, 71985], [42, 72125], [47, 72405], [52, 72745], [58, 73145], [62, 73585], [71, 73965], [74, 74225]]}, {"verse": 12, "start": 75403, "end": 81006, "text": "¶ On the next day much people that were come to the feast, when they heard that Jesus was coming to Jerusalem,", "words": [[2, 75403], [5, 75558], [9, 75658], [14, 75858], [18, 76338], [23, 76478], [30, 76838], [35, 77058], [40, 77198], [45, 77438], [48, 77578], [52, 77698], [59, 77978], [64, 78638], [69, 78798], [75, 78998], [80, 79158], [86, 79458], [90, 79798], [97, 80038], [100, 80218]]}, {"verse": 13, "start": 81456, "end": 89851, "text": "Took branches of palm trees, and went forth to meet him, and cried, Hosanna: Blessed is the King of Israel that comes in the name of the Lord.", "words": [[0, 81456], [5, 81577], [14, 81997], [17, 82257], [22, 82537], [29, 82877], [33, 83417], [38, 83577], [44, 83857], [47, 84057], [52, 84277], [57, 84477], [61, 84777], [68, 85647], [77, 86562], [85, 86867], [88, 87227], [92, 87387], [97, 87607], [100, 87787], [107, 88147], [112, 88427], [118, 88707], [121, 88887], [125, 88967], [130, 89187], [133, 89287], [137, 89427]]}, {"verse": 14, "start": 90201, "end": 95001, "text": "And Jesus, when he had found a young donkey, sat on it; as it is written,", "words": [[0, 90201], [4, 90347], [11, 90947], [16, 91067], [19, 91227], [23, 91347], [29, 91627], [31, 91787], [37, 92047], [45, 92847], [49, 93147], [52, 93407], [56, 94015], [59, 94220], [62, 94340], [65, 94460]]}, {"verse": 15, "start": 95451, "end": 101124, "text": "Fear not, daughter of Sion: behold, your King comes, sitting on a donkey’s colt.", "words": [[0, 95451], [5, 95651], [10, 96111], [19, 96351], [22, 96794], [28, 97528], [36, 98492], [41, 98592], [46, 98892], [53, 99552], [61, 99812], [64, 100052], [66, 100152], [75, 100674]]}, {"verse": 16, "start": 101574, "end": 111094, "text": "These things understood not his disciples at the first: but when Jesus was glorified, then remembered they that these things were written of him, and that they had done these things to him.", "words": [[0, 101574], [6, 101732], [13, 101992], [24, 102632], [28, 102792], [32, 103012], [42, 103492], [45, 103712], [49, 103832], [56, 104682], [60, 104787], [65, 104967], [71, 105247], [75, 105547], [86, 106667], [91, 106887], [102, 107327], [107, 107627], [112, 107827], [118, 108027], [125, 108307], [130, 108487], [138, 108727], [141, 108967], [146, 109127], [150, 109427], [155, 109567], [160, 109687], [164, 109827], [169, 110047], [175, 110227], [182, 110507], [185, 110687]]}, {"verse": 17, "start": 111544, "end": 118344, "text": "The people therefore that was with him when he called Lazarus out of his grave, and raised him from the dead, bore witness.", "words": [[0, 111544], [4, 111621], [11, 111881], [21, 112321], [26, 112661], [30, 112861], [35, 113101], [39, 113281], [44, 113461], [47, 113581], [54, 113801], [62, 114421], [66, 114561], [69, 114641], [73, 114761], [80, 115541], [84, 115781], [91, 116041], [95, 116281], [100, 116461], [104, 116621], [110, 117301], [115, 117581]]}, {"verse": 18, "start": 118794, "end": 123428, "text": "For this cause the people also met him, for that they heard that he had done this miracle.", "words": [[0, 118794], [4, 118882], [9, 119082], [15, 119442], [19, 119662], [26, 119922], [31, 120282], [35, 120582], [40, 121182], [44, 121362], [49, 121522], [54, 121662], [60, 121922], [65, 122122], [68, 122262], [72, 122402], [77, 122602], [82, 122802]]}, {"verse": 19, "start": 123878, "end": 130879, "text": "The Pharisees therefore said among themselves, Do you perceive how you prevail nothing? behold, the world is gone after him.", "words": [[0, 123878], [4, 123974], [14, 124694], [24, 125274], [29, 125354], [35, 125614], [47, 126805], [50, 126884], [54, 126984], [63, 127424], [67, 127684], [71, 127824], [79, 128184], [88, 129124], [96, 129485], [100, 129645], [106, 129845], [109, 130045], [114, 130265], [120, 130585]]}, {"verse": 20, "start": 131229, "end": 135171, "text": "¶ And there were certain Greeks among them that came up to worship at the feast:", "words": [[2, 131229], [6, 131387], [12, 131527], [17, 131707], [25, 132027], [32, 132407], [38, 132767], [43, 133047], [48, 133247], [53, 133487], [56, 133647], [59, 133807], [67, 134167], [70, 134407], [74, 134567]]}, {"verse": 21, "start": 135621, "end": 144272, "text": "The same came therefore to Philip, which was of Bethsaida of Galilee, and desired him, saying, Sir, we would see Jesus.", "words": [[0, 135621], [4, 135725], [9, 136025], [14, 136305], [24, 136785], [27, 137005], [35, 137785], [41, 137965], [45, 138185], [48, 138345], [58, 139525], [61, 139885], [70, 140685], [74, 140705], [82, 141145], [87, 141685], [95, 142476], [100, 143032], [103, 143172], [109, 143332], [113, 143552]]}, {"verse": 22, "start": 144622, "end": 148995, "text": "Philip comes and tells Andrew: and again Andrew and Philip tell Jesus.", "words": [[0, 144622], [7, 144851], [13, 145211], [17, 145511], [23, 145751], [31, 146689], [35, 146851], [41, 147251], [48, 147611], [52, 147791], [59, 148011], [64, 148291]]}, {"verse": 23, "start": 149445, "end": 155162, "text": "¶ And Jesus answered them, saying, The hour is come, that the Son of man should be glorified.", "words": [[2, 149445], [6, 149588], [12, 149928], [21, 150368], [27, 150708], [35, 151440], [39, 151540], [44, 151880], [47, 152160], [53, 152540], [58, 153060], [62, 153200], [66, 153460], [69, 153580], [73, 153900], [80, 154160], [83, 154300]]}, {"verse": 24, "start": 155612, "end": 164798, "text": "Most assuredly, I say to you, Except a grain of wheat fall into the ground and die, it abides alone: but if it die, it brings forth much fruit.", "words": [[0, 155612], [5, 155793], [16, 156453], [18, 156653], [22, 156933], [25, 157133], [30, 157633], [37, 157893], [39, 158133], [45, 158373], [48, 158533], [54, 158773], [59, 159113], [64, 159373], [68, 159513], [75, 159833], [79, 160093], [84, 160813], [87, 160913], [94, 161353], [101, 162283], [105, 162385], [108, 162505], [111, 162605], [116, 163465], [119, 163565], [126, 163805], [132, 164065], [137, 164325]]}, {"verse": 25, "start": 165248, "end": 171572, "text": "He that loves his life shall lose it; and he that hates his life in this world shall keep it to life eternal.", "words": [[0, 165248], [3, 165351], [8, 165551], [14, 165811], [18, 166051], [23, 166351], [29, 166611], [34, 166871], [38, 167521], [42, 167801], [45, 167981], [50, 168241], [56, 168461], [60, 168701], [65, 168981], [68, 169221], [73, 169481], [79, 169841], [85, 170101], [90, 170361], [93, 170541], [96, 170701], [101, 170941]]}, {"verse": 26, "start": 172022, "end": 180215, "text": "If any man serve me, let him follow me; and where I am, there shall also my servant be: if any man serve me, him will my Father honour.", "words": [[0, 172022], [3, 172162], [7, 172422], [11, 172662], [17, 173022], [21, 173582], [25, 173742], [29, 173902], [36, 174242], [40, 174852], [44, 174971], [50, 175131], [52, 175371], [56, 175851], [62, 175951], [68, 176091], [73, 176431], [76, 176651], [84, 176931], [88, 177648], [91, 177791], [95, 177991], [99, 178211], [105, 178491], [109, 178911], [113, 179051], [118, 179211], [121, 179391], [128, 179821]]}, {"verse": 27, "start": 180665, "end": 188111, "text": "Now is my soul troubled; and what shall I say? Father, save me from this hour: but for this cause came I to this hour.", "words": [[0, 180665], [4, 180850], [7, 181050], [10, 181190], [15, 181450], [25, 182359], [29, 182503], [34, 182683], [40, 182883], [42, 183063], [47, 183885], [55, 184325], [60, 184525], [63, 184765], [68, 184925], [73, 185145], [79, 185906], [83, 186010], [87, 186170], [92, 186370], [98, 186730], [103, 187030], [105, 187230], [108, 187410], [113, 187630]]}, {"verse": 28, "start": 188561, "end": 197789, "text": "Father, glorify your name. Then came there a voice from heaven, saying, I have both glorified it, and will glorify it again.", "words": [[0, 188561], [8, 188783], [16, 189383], [21, 189583], [27, 190465], [32, 190674], [37, 190974], [43, 191274], [45, 191394], [51, 191694], [56, 192014], [64, 192394], [72, 194344], [74, 194504], [79, 194664], [84, 194944], [94, 195624], [98, 195824], [102, 196124], [107, 196264], [115, 196804], [118, 196984]]}, {"verse": 29, "start": 198139, "end": 204490, "text": "The people therefore, that stood by, and heard it, said that it thundered: others said, An angel spoke to him.", "words": [[0, 198139], [4, 198225], [11, 198605], [22, 199045], [27, 199145], [33, 199365], [37, 199705], [41, 200045], [47, 200325], [51, 200845], [56, 201085], [61, 201305], [64, 201385], [75, 202255], [82, 202525], [88, 203233], [91, 203396], [97, 203636], [103, 203976], [106, 204196]]}, {"verse": 30, "start": 204840, "end": 210184, "text": "Jesus answered and said, This voice came not because of me, but for your sakes.", "words": [[0, 204840], [6, 205120], [15, 205720], [19, 205980], [25, 206755], [30, 206972], [36, 207292], [41, 207592], [45, 207852], [53, 208152], [56, 208352], [60, 208852], [64, 209152], [68, 209372], [73, 209512]]}, {"verse": 31, "start": 210634, "end": 215337, "text": "Now is the judgment of this world: now shall the prince of this world be cast out.", "words": [[0, 210634], [4, 210872], [7, 211092], [11, 211232], [20, 211552], [23, 211852], [28, 212032], [35, 212871], [39, 213097], [45, 213317], [49, 213477], [56, 213737], [59, 213897], [64, 214077], [70, 214337], [73, 214537], [78, 214817]]}, {"verse": 32, "start": 215787, "end": 220592, "text": "And I, if I be lifted up from the earth, will draw all men to me.", "words": [[0, 215787], [4, 215951], [7, 216831], [10, 217171], [12, 217371], [15, 217511], [22, 217851], [25, 218051], [30, 218251], [34, 218411], [41, 219071], [46, 219331], [51, 219591], [55, 219831], [59, 220031], [62, 220291]]}, {"verse": 33, "start": 220942, "end": 223965, "text": "This he said, signifying what death he should die.", "words": [[0, 220942], [5, 221363], [8, 221443], [14, 221803], [25, 222403], [30, 222723], [36, 223063], [39, 223243], [46, 223443]]}, {"verse": 34, "start": 224415, "end": 233731, "text": "The people answered him, We have heard out of the law that Christ abides for ever: and how do you say, The Son of man must be lifted up? who is this Son of man?", "words": [[0, 224415], [4, 224492], [11, 224752], [20, 225152], [25, 225862], [28, 225982], [33, 226102], [39, 226382], [43, 226562], [46, 226682], [50, 226782], [54, 227062], [59, 227282], [66, 227642], [73, 228062], [77, 228482], [83, 229151], [87, 229254], [91, 229434], [94, 229554], [98, 229674], [103, 229894], [107, 230194], [111, 230494], [114, 230634], [118, 230914], [123, 231134], [126, 231354], [133, 231774], [137, 232424], [141, 232582], [144, 232742], [149, 232962], [153, 233202], [156, 233322]]}, {"verse": 35, "start": 234081, "end": 246415, "text": "Then Jesus said to them, Yet a little while is the light with you. Walk while you have the light, lest darkness come upon you: for he that walks in darkness knows not where he goes.", "words": [[0, 234081], [5, 234287], [11, 234567], [16, 234967], [19, 235147], [25, 237276], [29, 237412], [31, 237572], [38, 237732], [44, 238072], [47, 238392], [51, 238572], [57, 238812], [62, 239032], [67, 239653], [72, 239893], [78, 240173], [82, 240353], [87, 240573], [91, 240733], [98, 241393], [103, 241593], [112, 242013], [117, 242333], [122, 242633], [127, 243340], [131, 243445], [134, 243665], [139, 243865], [145, 244145], [148, 244385], [157, 244825], [163, 245165], [167, 245445], [173, 245685], [176, 245845]]}, {"verse": 36, "start": 246865, "end": 256724, "text": "While you have light, believe in the light, that you may be the children of light. These things spoke Jesus, and departed, and did hide himself from them.", "words": [[0, 246865], [6, 247057], [10, 247237], [15, 247417], [22, 248117], [30, 248397], [33, 248637], [37, 248737], [44, 249237], [49, 249517], [53, 249677], [57, 249917], [60, 250157], [64, 250377], [73, 250737], [76, 250977], [83, 251721], [89, 251921], [96, 252321], [102, 252681], [109, 253161], [113, 253881], [123, 254361], [127, 255081], [131, 255261], [136, 255561], [144, 255901], [149, 256381]]}, {"verse": 37, "start": 257174, "end": 262267, "text": "¶ But though he had done so many miracles before them, yet they believed not on him:", "words": [[2, 257174], [6, 257536], [13, 257756], [16, 257956], [20, 258136], [25, 258376], [28, 258636], [33, 258876], [42, 259396], [49, 259816], [55, 260436], [59, 260636], [64, 260966], [73, 261296], [77, 261576], [80, 261896]]}, {"verse": 38, "start": 262717, "end": 272134, "text": "That the saying of Esaias the prophet might be fulfilled, which he spoke, Lord, who has believed our report? and to whom has the arm of the Lord been revealed?", "words": [[0, 262717], [5, 262867], [9, 262947], [16, 263287], [19, 263687], [26, 264087], [30, 264227], [38, 264547], [44, 264847], [47, 265047], [58, 265967], [64, 266187], [67, 266347], [74, 266867], [80, 267467], [84, 267647], [88, 267807], [97, 268147], [101, 268427], [109, 269404], [113, 269549], [116, 269669], [121, 269909], [125, 270209], [129, 270369], [133, 270669], [136, 270789], [140, 270929], [145, 271189], [150, 271409]]}, {"verse": 39, "start": 272584, "end": 276105, "text": "Therefore they could not believe, because that Esaias said again,", "words": [[0, 272584], [10, 273002], [15, 273102], [21, 273222], [25, 273422], [34, 273822], [42, 274542], [47, 274852], [54, 275162], [59, 275502]]}, {"verse": 40, "start": 276555, "end": 287442, "text": "He has blinded their eyes, and hardened their heart; that they should not see with their eyes, nor understand with their heart, and be converted, and I should heal them.", "words": [[0, 276555], [3, 276659], [7, 276819], [15, 277359], [21, 277499], [27, 277899], [31, 278419], [40, 278759], [46, 279039], [53, 279805], [58, 279966], [63, 280146], [70, 280346], [74, 280606], [78, 281026], [83, 281266], [89, 281466], [95, 282386], [99, 282706], [110, 283466], [115, 283826], [121, 284046], [128, 284646], [132, 284846], [135, 285026], [146, 286106], [150, 286226], [152, 286486], [159, 286706], [164, 287006]]}, {"verse": 41, "start": 287892, "end": 291891, "text": "These things said Esaias, when he saw his glory, and spoke of him.", "words": [[0, 287892], [6, 288059], [13, 288379], [18, 288929], [26, 289479], [31, 289679], [34, 289819], [38, 290059], [42, 290259], [49, 290679], [53, 290979], [59, 291259], [62, 291519]]}, {"verse": 42, "start": 292341, "end": 301678, "text": "¶ Nevertheless among the chief rulers also many believed on him; but because of the Pharisees they did not confess him, lest they should be put out of the synagogue:", "words": [[2, 292341], [15, 293052], [21, 293252], [25, 293492], [31, 293692], [38, 294352], [43, 294632], [48, 294992], [57, 295412], [60, 295672], [65, 296345], [69, 296444], [77, 296744], [80, 296944], [84, 297064], [94, 297844], [99, 297924], [103, 298124], [107, 298284], [115, 298744], [120, 299464], [125, 299784], [130, 299944], [137, 300104], [140, 300264], [144, 300484], [148, 300704], [151, 300824], [155, 300944]]}, {"verse": 43, "start": 302128, "end": 305565, "text": "For they loved the praise of men more than the praise of God.", "words": [[0, 302128], [4, 302209], [9, 302369], [15, 302729], [19, 302929], [26, 303309], [29, 303549], [33, 303849], [38, 304189], [43, 304389], [47, 304509], [54, 304829], [57, 305009]]}, {"verse": 44, "start": 306015, "end": 312963, "text": "¶ Jesus cried and said, He that believes on me, believes not on me, but on him that sent me.", "words": [[2, 306015], [8, 306384], [14, 306924], [18, 307164], [24, 307896], [27, 308129], [32, 308369], [41, 308729], [44, 309029], [48, 309669], [57, 310129], [61, 310449], [64, 310689], [68, 311289], [72, 311509], [75, 311709], [79, 311989], [84, 312309], [89, 312569]]}, {"verse": 45, "start": 313412, "end": 316228, "text": "And he that sees me sees him that sent me.", "words": [[0, 313412], [4, 313530], [7, 313790], [12, 313990], [17, 314290], [20, 314790], [25, 315050], [29, 315350], [34, 315610], [39, 315850]]}, {"verse": 46, "start": 316678, "end": 321792, "text": "I am come a light into the world, that whoever believes on me should not abide in darkness.", "words": [[0, 316678], [2, 316865], [5, 316965], [10, 317165], [12, 317285], [18, 317565], [23, 317805], [27, 317965], [34, 318525], [39, 318885], [47, 319125], [56, 319605], [59, 319865], [62, 320045], [69, 320245], [73, 320465], [79, 320845], [82, 321065]]}, {"verse": 47, "start": 322242, "end": 330100, "text": "And if any man hear my words, and believe not, I judge him not: for I came not to judge the world, but to save the world.", "words": [[0, 322242], [4, 322346], [7, 322446], [11, 322606], [15, 322886], [20, 323026], [23, 323226], [30, 323926], [34, 324126], [42, 324386], [47, 325026], [49, 325146], [55, 325466], [59, 325646], [64, 326417], [68, 326630], [70, 326950], [75, 327190], [79, 327490], [82, 327670], [88, 327930], [92, 328130], [99, 328710], [103, 328990], [106, 329150], [111, 329450], [115, 329630]]}, {"verse": 48, "start": 330550, "end": 339074, "text": "He that rejects me, and receives not my words, has one that judges him: the word that I have spoken, the same shall judge him in the last day.", "words": [[0, 330550], [3, 330686], [8, 330906], [16, 331466], [20, 331586], [24, 331846], [33, 332246], [37, 332526], [40, 332766], [47, 333186], [51, 333726], [55, 334046], [60, 334246], [67, 334546], [72, 335259], [76, 335362], [81, 335602], [86, 335782], [88, 335942], [93, 336082], [101, 336962], [105, 337062], [110, 337362], [116, 337582], [122, 337942], [126, 338102], [129, 338242], [133, 338342], [138, 338662]]}, {"verse": 49, "start": 339524, "end": 346606, "text": "For I have not spoken of myself; but the Father which sent me, he gave me a commandment, what I should say, and what I should speak.", "words": [[0, 339524], [4, 339632], [6, 339752], [11, 339872], [15, 340032], [22, 340412], [25, 340612], [33, 341502], [37, 341604], [41, 341724], [48, 341964], [54, 342184], [59, 342444], [63, 342904], [66, 343044], [71, 343244], [74, 343424], [76, 343524], [89, 344404], [94, 344584], [96, 344724], [103, 344884], [108, 345444], [112, 345664], [117, 345804], [119, 345924], [126, 346084]]}, {"verse": 50, "start": 347056, "end": 354816, "text": "And I know that his commandment is life everlasting: whatever I speak therefore, even as the Father said to me, so I speak.", "words": [[0, 347056], [4, 347179], [6, 347299], [11, 347539], [16, 347779], [20, 347919], [32, 348519], [35, 348699], [40, 349019], [53, 350188], [62, 350465], [64, 350725], [70, 351025], [81, 351805], [86, 352245], [89, 352465], [93, 352605], [100, 352845], [105, 353125], [108, 353325], [112, 353845], [115, 354085], [117, 354245]]}]}