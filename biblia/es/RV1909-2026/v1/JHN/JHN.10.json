{"book": "JHN", "chapter": 10, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 300929, "verses": [{"verse": 1, "start": 300, "end": 11455, "text": "De cierto, de cierto os digo: El que no entra por la puerta en el corral de las ovejas, sino que sube por otra parte, el tal es ladrón y asaltante.", "words": [[0, 517], [3, 771], [11, 1024], [14, 1277], [21, 1531], [24, 1784], [30, 2637], [33, 2779], [37, 2939], [40, 3179], [46, 3599], [50, 3819], [53, 3999], [60, 4279], [63, 4579], [66, 4849], [73, 5119], [76, 5259], [80, 5439], [88, 6239], [93, 6479], [97, 6679], [102, 6999], [106, 7199], [111, 7439], [118, 8619], [121, 8819], [125, 8999], [128, 9219], [135, 10059], [137, 10379]]}, {"verse": 2, "start": 11905, "end": 16136, "text": "Pero el que entra por la puerta, el pastor de las ovejas es.", "words": [[0, 11905], [5, 12047], [8, 12227], [12, 12427], [18, 12627], [22, 12867], [25, 13047], [33, 13687], [36, 13807], [43, 14347], [46, 14607], [50, 14767], [57, 15207]]}, {"verse": 3, "start": 16586, "end": 23638, "text": "A este abre el portero, y las ovejas oyen su voz: y a sus ovejas llama por nombre, y las saca.", "words": [[0, 16586], [2, 16586], [7, 16586], [12, 16903], [15, 17143], [24, 18043], [26, 18203], [30, 18383], [37, 18843], [42, 19283], [45, 19443], [50, 20258], [52, 20363], [54, 20443], [58, 20563], [65, 21143], [71, 21703], [75, 22043], [83, 22503], [85, 22783], [89, 23063]]}, {"verse": 4, "start": 24088, "end": 31638, "text": "Y como ha sacado fuera todas las propias, va delante de ellas; y las ovejas le siguen, porque conocen su voz.", "words": [[0, 24088], [2, 24193], [7, 24433], [10, 24633], [17, 25093], [23, 25353], [29, 25733], [33, 26033], [42, 26513], [45, 26693], [53, 27153], [56, 27333], [63, 28242], [65, 28351], [69, 28491], [76, 28931], [79, 29111], [87, 29691], [94, 30311], [102, 30951], [105, 31131]]}, {"verse": 5, "start": 32088, "end": 39596, "text": "Pero al extraño no seguirán, antes huirán de él: porque no conocen la voz de los extraños.", "words": [[0, 32088], [5, 32288], [8, 32428], [16, 33068], [19, 33548], [29, 34208], [35, 35268], [42, 35708], [45, 35928], [49, 36627], [56, 36850], [59, 37090], [67, 37750], [70, 37930], [74, 38170], [77, 38350], [81, 38470]]}, {"verse": 6, "start": 40046, "end": 46720, "text": "Esta parábola les dijo Jesús; pero ellos no entendieron qué era lo que les decía.", "words": [[0, 40046], [5, 40271], [14, 40811], [18, 41051], [23, 41351], [30, 42365], [35, 42509], [41, 42729], [44, 42989], [56, 43669], [60, 44069], [64, 44369], [67, 44549], [71, 44669], [75, 44869]]}, {"verse": 7, "start": 47170, "end": 53518, "text": "Les volvió, pues, Jesús a decir: De cierto, de cierto os digo: Yo soy la puerta de las ovejas.", "words": [[0, 47170], [4, 47170], [12, 47170], [18, 47428], [24, 47956], [26, 48484], [33, 49479], [36, 49733], [44, 49986], [47, 50239], [54, 50493], [57, 50746], [63, 51599], [66, 51787], [70, 51987], [73, 52167], [80, 52447], [83, 52667], [87, 52807]]}, {"verse": 8, "start": 53968, "end": 60743, "text": "Todos los que antes de mí vinieron, ladrones son y asaltantes; pero no los oyeron las ovejas.", "words": [[0, 53968], [6, 54230], [10, 54670], [14, 54850], [20, 55150], [23, 55350], [26, 55470], [36, 56430], [45, 56790], [49, 57170], [51, 57490], [63, 58863], [68, 59007], [71, 59287], [75, 59567], [82, 59847], [86, 60295]]}, {"verse": 9, "start": 61193, "end": 68444, "text": "Yo soy la puerta: el que por mí entra, será salvo; y entrará, y saldrá, y hallará pastos.", "words": [[0, 61193], [3, 61337], [7, 61517], [10, 61717], [18, 62625], [21, 62768], [25, 62908], [29, 63221], [32, 63535], [39, 63848], [44, 64268], [51, 65336], [53, 65453], [62, 66093], [64, 66293], [72, 67073], [74, 67273], [82, 67573]]}, {"verse": 10, "start": 68894, "end": 78206, "text": "El ladrón no viene sino para hurtar, y matar, y destruir: yo he venido para que tengan vida, y para que la tengan en abundancia.", "words": [[0, 68894], [3, 69041], [10, 69501], [13, 69681], [19, 69921], [24, 70301], [29, 70641], [37, 71401], [39, 71621], [46, 71961], [48, 72321], [58, 73539], [61, 73747], [64, 73887], [71, 74247], [76, 74447], [80, 74587], [87, 74927], [93, 75367], [95, 76067], [100, 76307], [104, 76467], [107, 76587], [114, 76907], [117, 77167]]}, {"verse": 11, "start": 78656, "end": 83286, "text": "Yo soy el buen pastor: el buen pastor su vida da por las ovejas.", "words": [[0, 78656], [3, 78841], [7, 79081], [10, 79281], [15, 79421], [23, 80459], [26, 80714], [31, 80894], [38, 81314], [41, 81574], [46, 81834], [49, 81994], [53, 82234], [57, 82434]]}, {"verse": 12, "start": 83736, "end": 96801, "text": "Pero el asalariado, que no es el pastor y a quien no pertenecen las ovejas, ve al lobo que viene, y deja las ovejas, y huye, y el lobo las arrebata, y esparce las ovejas.", "words": [[0, 83736], [5, 83881], [8, 84021], [20, 84861], [24, 84961], [27, 85101], [30, 85241], [33, 85361], [40, 85821], [42, 86421], [44, 86541], [50, 86661], [53, 87161], [64, 87661], [68, 87821], [76, 88641], [79, 88961], [82, 89281], [87, 89701], [91, 89861], [98, 90161], [100, 90441], [105, 90821], [109, 90941], [117, 91481], [119, 91981], [125, 92810], [127, 92994], [130, 93174], [135, 93514], [139, 94044], [149, 94574], [151, 95154], [159, 95734], [163, 95974]]}, {"verse": 13, "start": 97251, "end": 103531, "text": "Así que, el asalariado, huye, porque es asalariado, y no tiene cuidado de las ovejas.", "words": [[0, 97251], [4, 97621], [9, 97841], [12, 98021], [24, 99021], [30, 99621], [37, 100161], [40, 100501], [52, 101461], [54, 101601], [57, 101721], [63, 101961], [71, 102401], [74, 102661], [78, 102821]]}, {"verse": 14, "start": 103981, "end": 109489, "text": "Yo soy el buen pastor; y conozco mis ovejas, y las mías me conocen.", "words": [[0, 103981], [3, 104301], [7, 104541], [10, 104781], [15, 104941], [23, 105869], [25, 105998], [33, 106618], [37, 106818], [45, 107478], [47, 107978], [51, 108138], [56, 108518], [59, 108658]]}, {"verse": 15, "start": 109939, "end": 116056, "text": "Como el Padre me conoce, y yo conozco al Padre; y pongo mi vida por las ovejas.", "words": [[0, 109939], [5, 110249], [8, 110389], [14, 110669], [17, 110909], [25, 111549], [27, 111969], [30, 112109], [38, 112569], [41, 112709], [48, 113705], [50, 113945], [56, 114325], [59, 114545], [64, 114805], [68, 115065], [72, 115265]]}, {"verse": 16, "start": 116506, "end": 126565, "text": "También tengo otras ovejas que no son de este redil; aquellas también me conviene traer, y oirán mi voz; y habrá un rebaño, y un pastor.", "words": [[0, 116506], [8, 116791], [14, 117251], [20, 117551], [27, 118071], [31, 118351], [34, 118551], [38, 118811], [41, 119031], [46, 119554], [53, 120308], [62, 120773], [70, 121053], [73, 121253], [82, 121673], [89, 122353], [91, 122733], [97, 123173], [100, 123353], [105, 124222], [107, 124352], [113, 124612], [116, 124972], [124, 125332], [126, 125752], [129, 126189]]}, {"verse": 17, "start": 127015, "end": 131954, "text": "Por eso me ama el Padre, porque yo pongo mi vida, para volverla a tomar.", "words": [[0, 127015], [4, 127139], [8, 127339], [11, 127579], [15, 127799], [18, 127979], [25, 128719], [32, 128959], [35, 129199], [41, 129719], [44, 129899], [50, 130259], [55, 130759], [64, 131359], [66, 131439]]}, {"verse": 18, "start": 132404, "end": 143005, "text": "Nadie me la quita, pero yo la pongo de mí mismo. Tengo poder para ponerla, y tengo poder para volverla a tomar. Este mandamiento recibí de mi Padre.", "words": [[0, 132404], [6, 132809], [9, 132929], [12, 133069], [19, 133589], [24, 133669], [27, 133869], [30, 133989], [36, 134609], [39, 134789], [42, 134929], [49, 135814], [55, 136038], [61, 136398], [66, 136958], [75, 137518], [77, 138118], [83, 138398], [89, 138818], [94, 139138], [103, 139798], [105, 139918], [112, 140780], [117, 140969], [129, 141549], [136, 142169], [139, 142229], [142, 142389]]}, {"verse": 19, "start": 143455, "end": 146952, "text": "Y volvió a haber división entre los judíos por estas palabras.", "words": [[0, 143455], [2, 143561], [9, 143981], [11, 144081], [17, 144261], [26, 144841], [32, 145081], [36, 145261], [43, 145721], [47, 145941], [53, 146101]]}, {"verse": 20, "start": 147402, "end": 152810, "text": "Y muchos de ellos decían: Demonio tiene, y está fuera de sí; ¿para qué le oís?", "words": [[0, 147402], [2, 147622], [9, 147882], [12, 148142], [18, 148402], [26, 149512], [34, 149970], [41, 150270], [43, 150450], [48, 150690], [54, 150950], [57, 151170], [61, 151822], [67, 151979], [71, 152159], [74, 152279]]}, {"verse": 21, "start": 153160, "end": 159222, "text": "Decían otros: Estas palabras no son de endemoniado: ¿puede el demonio abrir los ojos de los ciegos?", "words": [[0, 153160], [7, 153685], [14, 154705], [20, 154967], [29, 155287], [32, 155567], [36, 155827], [39, 156302], [52, 157021], [59, 157242], [62, 157342], [70, 157742], [76, 157902], [80, 158102], [85, 158342], [88, 158522], [92, 158642]]}, {"verse": 22, "start": 159572, "end": 164556, "text": "Y se hacía la fiesta de la dedicación en Jerusalén; y era invierno;", "words": [[0, 159572], [2, 159676], [5, 159796], [11, 160076], [14, 160236], [21, 160616], [24, 160776], [27, 160876], [38, 161596], [41, 161836], [52, 163059], [54, 163436], [58, 163576]]}, {"verse": 23, "start": 165006, "end": 168790, "text": "Y Jesús andaba en el templo por el portal de Salomón.", "words": [[0, 165006], [2, 165133], [8, 165513], [15, 166233], [18, 166373], [21, 166513], [28, 167093], [32, 167273], [35, 167393], [42, 167813], [45, 168033]]}, {"verse": 24, "start": 169240, "end": 178189, "text": "Y le rodearon los judíos y le dijeron: ¿Hasta cuándo nos vas a mantener en duda? Si tú eres el Cristo, dínoslo abiertamente.", "words": [[0, 169240], [2, 169540], [5, 169680], [14, 170340], [18, 170520], [25, 171260], [27, 171680], [30, 171800], [39, 172775], [46, 173003], [53, 173243], [57, 173523], [61, 173703], [63, 173843], [72, 174183], [75, 174443], [81, 175152], [84, 175338], [87, 175518], [92, 175738], [95, 175898], [103, 176838], [111, 177258]]}, {"verse": 25, "start": 178539, "end": 186947, "text": "Les respondió Jesús: Os lo he dicho, y no creéis: las obras que yo hago en nombre de mi Padre, ellas dan testimonio de mí;", "words": [[0, 178539], [4, 178687], [14, 179267], [21, 180206], [24, 180331], [27, 180511], [30, 180591], [37, 180891], [39, 181111], [42, 181231], [50, 182372], [54, 182609], [60, 182879], [64, 183059], [67, 183279], [72, 183519], [75, 183659], [82, 183979], [85, 184199], [88, 184359], [95, 185039], [101, 185499], [105, 185759], [116, 186519], [119, 186639]]}, {"verse": 26, "start": 187397, "end": 192467, "text": "Pero vosotros no creéis, porque no sois de mis ovejas, como os he dicho.", "words": [[0, 187397], [5, 187581], [14, 188041], [17, 188281], [25, 188961], [32, 189561], [35, 189841], [40, 190281], [43, 190441], [47, 190581], [55, 191361], [60, 191581], [63, 191841], [66, 191921]]}, {"verse": 27, "start": 192917, "end": 197079, "text": "Mis ovejas oyen mi voz, y yo las conozco, y me siguen;", "words": [[0, 192917], [4, 193065], [11, 193645], [16, 194245], [19, 194445], [24, 194725], [26, 194965], [29, 195125], [33, 195265], [42, 195925], [44, 196345], [47, 196465]]}, {"verse": 28, "start": 197529, "end": 204498, "text": "Y yo les doy vida eterna: y no perecerán para siempre, ni nadie las arrebatará de mi mano.", "words": [[0, 197529], [2, 197657], [5, 197817], [9, 197957], [13, 198197], [18, 198417], [26, 199501], [28, 199632], [31, 199792], [41, 200572], [46, 200812], [55, 201492], [58, 202172], [64, 202532], [68, 202932], [79, 203672], [82, 203832], [85, 203952]]}, {"verse": 29, "start": 204948, "end": 212373, "text": "Mi Padre que me las dio, mayor que todos es: y nadie las puede arrebatar de la mano de mi Padre.", "words": [[0, 204948], [3, 205073], [9, 205473], [13, 205733], [16, 205883], [20, 206033], [25, 206733], [31, 207113], [35, 207353], [41, 207773], [45, 208897], [47, 209021], [53, 209341], [57, 209601], [63, 210191], [73, 210781], [76, 210901], [79, 211061], [84, 211301], [87, 211481], [90, 211621]]}, {"verse": 30, "start": 212823, "end": 215125, "text": "Yo y el Padre somos uno.", "words": [[0, 212823], [3, 213149], [5, 213389], [8, 213549], [14, 214029], [20, 214269]]}, {"verse": 31, "start": 215575, "end": 220133, "text": "Entonces volvieron a tomar piedras los judíos para apedrearle.", "words": [[0, 215575], [9, 216475], [19, 217115], [21, 217235], [27, 217475], [35, 217975], [39, 218135], [46, 218635], [51, 218855]]}, {"verse": 32, "start": 220583, "end": 228659, "text": "Les respondió Jesús: Muchas buenas obras os he mostrado de mi Padre; ¿por cuál obra de esas me apedreáis?", "words": [[0, 220583], [4, 220731], [14, 221311], [21, 222490], [28, 222730], [35, 223150], [41, 223930], [44, 224070], [47, 224330], [56, 224870], [59, 225090], [62, 225230], [69, 226219], [74, 226343], [79, 226603], [84, 227023], [87, 227263], [92, 227503], [95, 227743]]}, {"verse": 33, "start": 229109, "end": 238307, "text": "Le respondieron los judíos, diciendo: Por buena obra no te apedreamos, sino por la blasfemia; y porque tú, siendo hombre, te haces Dios.", "words": [[0, 229109], [3, 229257], [16, 230017], [20, 230257], [28, 230977], [38, 232271], [42, 232391], [48, 232591], [53, 232891], [56, 233091], [59, 233251], [71, 234111], [76, 234251], [80, 234471], [83, 234611], [94, 235640], [96, 235738], [103, 235958], [107, 236278], [114, 236798], [122, 237218], [125, 237458], [131, 237738]]}, {"verse": 34, "start": 238657, "end": 244612, "text": "Les respondió Jesús: ¿No está escrito en vuestra ley: Yo dije, Dioses sois?", "words": [[0, 238657], [4, 238806], [14, 239386], [21, 240324], [25, 240451], [30, 240651], [38, 240971], [41, 241271], [49, 241611], [54, 243271], [57, 243271], [63, 243271], [70, 243935]]}, {"verse": 35, "start": 245062, "end": 252849, "text": "Si dijo, dioses, a aquellos a los cuales vino la palabra de Dios (y la Escritura no puede ser quebrantada);", "words": [[0, 245062], [3, 245285], [9, 245625], [17, 246225], [19, 246985], [28, 247325], [30, 247585], [34, 247725], [41, 247905], [46, 248245], [49, 248445], [57, 248785], [60, 249025], [65, 249325], [68, 249785], [71, 249945], [81, 250665], [84, 251205], [90, 251445], [94, 251745]]}, {"verse": 36, "start": 253299, "end": 262140, "text": "¿A quien el Padre santificó y envió al mundo, vosotros decís: Tú blasfemas, porque dije: Hijo de Dios soy?", "words": [[0, 253299], [3, 253486], [9, 253606], [12, 253786], [18, 254246], [28, 255086], [30, 255226], [36, 255606], [39, 255766], [46, 256926], [55, 257526], [62, 258986], [65, 259406], [76, 259826], [83, 260086], [89, 260916], [94, 261183], [97, 261363], [102, 261563]]}, {"verse": 37, "start": 262590, "end": 265788, "text": "Si no hago obras de mi Padre, no me creáis.", "words": [[0, 262590], [3, 262810], [6, 262990], [11, 263370], [17, 263770], [20, 263970], [23, 264090], [30, 264670], [33, 264790], [36, 264930]]}, {"verse": 38, "start": 266238, "end": 276502, "text": "Pero si las hago, aunque a mí no creáis, creed a las obras; para que conozcáis y creáis que el Padre está en mí, y yo en el Padre.", "words": [[0, 266238], [5, 266403], [8, 266583], [12, 266803], [18, 267803], [25, 268003], [27, 268183], [30, 268303], [33, 268423], [41, 269403], [47, 269843], [49, 269903], [53, 270123], [60, 271093], [65, 271217], [69, 271377], [79, 272137], [81, 272377], [88, 272957], [92, 273217], [95, 273377], [101, 273857], [106, 274077], [109, 274317], [113, 274637], [115, 275137], [118, 275417], [121, 275657], [124, 275777]]}, {"verse": 39, "start": 276952, "end": 281735, "text": "Y procuraban otra vez prenderle; pero él se salió de sus manos;", "words": [[0, 276952], [2, 277059], [13, 277679], [18, 277879], [22, 278099], [33, 279298], [38, 279460], [41, 279800], [44, 280200], [50, 280660], [53, 280800], [57, 281000]]}, {"verse": 40, "start": 282185, "end": 289555, "text": "Y se volvió tras el Jordán, a aquel lugar donde primero había estado bautizando Juan; y se quedó allí.", "words": [[0, 282185], [2, 282525], [5, 282665], [12, 283145], [17, 283285], [20, 283505], [28, 284045], [30, 284265], [36, 284645], [42, 284945], [48, 285325], [56, 285845], [62, 286145], [69, 286505], [80, 287465], [86, 288429], [88, 288593], [91, 288653], [97, 289104]]}, {"verse": 41, "start": 290005, "end": 297574, "text": "Y muchos venían a él, y decían: Juan, a la verdad, ninguna señal hizo; pero todo lo que Juan dijo de este, era verdad.", "words": [[0, 290005], [2, 290114], [9, 290374], [16, 290854], [18, 291014], [22, 291194], [24, 291354], [32, 292414], [38, 292643], [40, 292803], [43, 292863], [51, 293603], [59, 293843], [65, 294363], [71, 295039], [76, 295157], [81, 295377], [84, 295577], [88, 295697], [93, 295917], [98, 296197], [101, 296397], [107, 296757], [111, 297057]]}, {"verse": 42, "start": 297924, "end": 300529, "text": "Y muchos creyeron allí en él.", "words": [[0, 297924], [2, 298048], [9, 298475], [18, 298901], [23, 299328], [26, 299508]]}]}