{"book": "GEN", "chapter": 21, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 269256, "verses": [{"verse": 1, "start": 300, "end": 6689, "text": "Y visitó Jehová a Sara, como había dicho, e hizo Jehová con Sara como había hablado.", "words": [[0, 300], [2, 425], [9, 1005], [16, 1525], [18, 1725], [24, 2185], [29, 2325], [35, 2625], [42, 3785], [44, 3885], [49, 4185], [56, 4785], [60, 4945], [65, 5265], [70, 5585], [76, 5965]]}, {"verse": 2, "start": 7039, "end": 13860, "text": "Y concibió y parió Sara a Abraham un hijo en su vejez, en el tiempo que Dios le había dicho.", "words": [[0, 7039], [2, 7159], [11, 7979], [13, 8139], [19, 8559], [24, 8959], [26, 9419], [34, 10214], [37, 10334], [42, 10634], [45, 10975], [48, 11316], [55, 11656], [58, 11789], [61, 11929], [68, 12229], [72, 12509], [77, 12789], [80, 13069], [86, 13269]]}, {"verse": 3, "start": 14210, "end": 20160, "text": "Y llamó Abraham el nombre de su hijo que le nació, que le parió Sara, Isaac.", "words": [[0, 14210], [2, 14334], [8, 14714], [16, 15314], [19, 15714], [26, 16134], [29, 16374], [32, 16554], [37, 16854], [41, 17074], [44, 17214], [51, 17854], [55, 17914], [58, 18074], [64, 18783], [70, 19493]]}, {"verse": 4, "start": 20510, "end": 26846, "text": "Y circuncidó Abraham a su hijo Isaac de ocho días, como Dios le había mandado.", "words": [[0, 20510], [2, 20638], [13, 21538], [21, 22178], [23, 22478], [26, 22678], [31, 22938], [37, 23288], [40, 23638], [45, 23998], [51, 24718], [56, 24978], [61, 25298], [64, 25838], [70, 26058]]}, {"verse": 5, "start": 27196, "end": 32263, "text": "Y era Abraham de cien años, cuando le nació Isaac su hijo.", "words": [[0, 27196], [2, 27383], [6, 27603], [14, 28283], [17, 28543], [22, 28903], [28, 29923], [35, 30083], [38, 30343], [44, 30783], [50, 31323], [53, 31743]]}, {"verse": 6, "start": 32613, "end": 38890, "text": "Entonces dijo Sara: Dios me ha hecho reír, y cualquiera que lo oiga, se reirá conmigo.", "words": [[0, 32613], [9, 33160], [14, 33760], [20, 34551], [25, 34796], [28, 35056], [31, 35236], [37, 35456], [43, 35956], [45, 36256], [56, 36776], [60, 36936], [63, 37096], [69, 37416], [72, 37776], [78, 38196]]}, {"verse": 7, "start": 39170, "end": 46533, "text": "Y añadió: ¿Quién habría dicho a Abraham que Sara había de dar de mamar a hijos? pues que le he parido un hijo a su vejez.", "words": [[0, 39170], [2, 39292], [10, 40157], [17, 40357], [24, 40657], [30, 40957], [32, 41197], [40, 41537], [44, 41857], [49, 42177], [55, 42477], [58, 42697], [62, 42897], [65, 43057], [71, 43417], [73, 43477], [80, 44350], [85, 44473], [89, 44673], [92, 44793], [95, 44933], [102, 45333], [105, 45533], [110, 45793], [112, 46040], [115, 46286]]}, {"verse": 8, "start": 46813, "end": 55298, "text": "Y creció el niño, y fue destetado; e hizo Abraham gran banquete el día que fue destetado Isaac.", "words": [[0, 46813], [2, 46978], [9, 47438], [12, 47638], [18, 48058], [20, 48598], [24, 48838], [35, 50301], [37, 50447], [42, 50727], [50, 51307], [55, 51947], [64, 52647], [67, 52967], [71, 53207], [75, 53387], [79, 53627], [89, 54607]]}, {"verse": 9, "start": 55648, "end": 62697, "text": "Y vio Sara al hijo de Agar la egipcia, el cual había esta parido a Abraham, que se burlaba.", "words": [[0, 55648], [2, 55774], [6, 55974], [11, 56354], [14, 56714], [19, 56934], [22, 57141], [27, 57347], [30, 57554], [39, 58654], [42, 58774], [47, 59054], [53, 59541], [58, 60027], [65, 60514], [67, 60774], [76, 61754], [80, 61774], [83, 61974]]}, {"verse": 10, "start": 63047, "end": 71960, "text": "Por tanto dijo a Abraham: Echa a esta sierva y a su hijo; que el hijo de esta sierva no ha de heredar con mi hijo, con Isaac.", "words": [[0, 63047], [4, 63172], [10, 63872], [15, 64102], [17, 64332], [26, 65520], [31, 65670], [33, 65820], [38, 66160], [45, 66740], [47, 66960], [49, 67060], [52, 67180], [58, 67855], [62, 67957], [65, 68057], [70, 68237], [73, 68397], [78, 68617], [85, 69157], [88, 69437], [91, 69617], [94, 69757], [102, 70157], [106, 70357], [109, 70537], [115, 71137], [119, 71377]]}, {"verse": 11, "start": 72240, "end": 77310, "text": "Este dicho pareció grave en gran manera a Abraham a causa de su hijo.", "words": [[0, 72240], [5, 72547], [11, 72947], [19, 73547], [25, 73907], [28, 74167], [33, 74367], [40, 74907], [42, 75207], [50, 75647], [52, 76047], [58, 76387], [61, 76647], [64, 76827]]}, {"verse": 12, "start": 77660, "end": 90250, "text": "Entonces dijo Dios a Abraham: No te parezca grave a causa del muchacho y de tu sierva; en todo lo que te diga Sara, oye su voz, porque por medio de Isaac te vendrá descendencia.", "words": [[0, 77660], [9, 78145], [14, 78825], [19, 79305], [21, 79725], [30, 80695], [33, 80876], [36, 81056], [44, 81556], [50, 81896], [52, 82056], [58, 82356], [62, 82596], [71, 83096], [73, 83216], [76, 83296], [79, 83436], [87, 84485], [90, 84650], [95, 84890], [98, 85110], [102, 85230], [105, 85370], [110, 85670], [116, 86410], [120, 86650], [123, 86790], [128, 87410], [135, 87690], [139, 87930], [145, 88230], [148, 88430], [154, 88770], [157, 89030], [164, 89390]]}, {"verse": 13, "start": 90863, "end": 94935, "text": "Y también al hijo de la sierva pondré en nación, porque es tu simiente.", "words": [[0, 90863], [2, 90965], [10, 91245], [13, 91525], [18, 91705], [21, 91845], [24, 91945], [31, 92425], [38, 92885], [41, 92985], [49, 93705], [56, 93905], [59, 94145], [62, 94245]]}, {"verse": 14, "start": 95437, "end": 110908, "text": "Entonces Abraham se levantó muy de mañana, y tomó pan, y un odre de agua, y lo dio a Agar, poniéndolo sobre su hombro, y le entregó el muchacho, y la despidió. Y ella salió y anduvo errante por el desierto de Beerseba.", "words": [[0, 95437], [9, 95884], [17, 96524], [20, 96924], [28, 97424], [32, 97644], [35, 97804], [43, 98264], [45, 98499], [50, 98819], [55, 99119], [57, 99344], [60, 99524], [65, 99984], [68, 100124], [74, 100484], [76, 100904], [79, 101044], [83, 101244], [85, 101524], [91, 102044], [102, 102984], [108, 103244], [111, 103524], [119, 104184], [121, 104324], [124, 104444], [132, 104714], [135, 104984], [145, 105938], [147, 106041], [150, 106161], [160, 107022], [162, 107171], [167, 107391], [173, 107974], [175, 108076], [182, 108416], [190, 108896], [194, 109136], [197, 109256], [206, 109816], [209, 110397]]}, {"verse": 15, "start": 111258, "end": 115321, "text": "Y faltó el agua del odre, y echó al muchacho debajo de un árbol;", "words": [[0, 111258], [2, 111380], [8, 111760], [11, 111860], [16, 112080], [20, 112300], [26, 112960], [28, 113120], [33, 113440], [36, 113540], [45, 114060], [52, 114500], [55, 114660], [58, 114780]]}, {"verse": 16, "start": 115671, "end": 129478, "text": "Y se fue y se sentó enfrente, a distancia de un tiro de arco; porque decía: No veré cuando el muchacho muera: y cuando ella se sentó enfrente, el muchacho alzó su voz y lloró.", "words": [[0, 115671], [2, 115839], [5, 115919], [9, 116179], [11, 116699], [14, 116859], [20, 117479], [30, 118379], [32, 118999], [42, 119759], [45, 119979], [48, 120139], [53, 120419], [56, 120639], [62, 121383], [69, 121608], [76, 122627], [79, 122814], [84, 123174], [91, 123374], [94, 123574], [103, 123954], [110, 124788], [112, 124894], [119, 125194], [124, 125494], [127, 125714], [133, 126334], [143, 126954], [146, 126994], [155, 127554], [160, 128294], [163, 128414], [167, 128674], [169, 128954]]}, {"verse": 17, "start": 129828, "end": 142373, "text": "Y oyó Dios la voz del muchacho; y el ángel de Dios llamó a Agar desde el cielo, y le dijo: ¿Qué tienes, Agar? No temas; porque Dios ha oído la voz del muchacho en donde está.", "words": [[0, 129828], [2, 130103], [6, 130413], [11, 130813], [14, 131153], [18, 131393], [22, 131573], [32, 132574], [34, 132703], [37, 132843], [43, 133263], [46, 133383], [51, 133683], [57, 134423], [59, 134683], [64, 134943], [70, 135203], [73, 135403], [80, 135823], [82, 136003], [85, 136123], [91, 136885], [96, 136987], [104, 137452], [110, 138082], [113, 138251], [120, 139044], [127, 139248], [132, 139588], [135, 139948], [140, 140368], [143, 140548], [147, 140788], [151, 140948], [160, 141508], [163, 141668], [169, 141808]]}, {"verse": 18, "start": 142593, "end": 148351, "text": "Levántate, alza al muchacho, y tómalo de tu mano, porque en gran gente lo tengo de poner.", "words": [[0, 142593], [11, 143213], [16, 143633], [19, 143733], [29, 144293], [31, 144813], [38, 145253], [41, 145373], [44, 145493], [50, 145793], [57, 146433], [60, 146653], [65, 146793], [71, 147193], [74, 147413], [80, 147713], [83, 147873]]}, {"verse": 19, "start": 148631, "end": 158672, "text": "Entonces abrió Dios sus ojos, y vio una fuente de agua; y fue, y llenó el odre de agua, y dio de beber al muchacho.", "words": [[0, 148631], [9, 149095], [15, 149815], [20, 150055], [24, 150395], [30, 150795], [32, 151355], [36, 151635], [40, 151955], [47, 152435], [50, 152635], [56, 153367], [58, 153516], [63, 154256], [65, 154536], [71, 155016], [74, 155296], [79, 155696], [82, 155816], [88, 156736], [90, 157056], [94, 157256], [97, 157416], [103, 157696], [106, 157916]]}, {"verse": 20, "start": 159022, "end": 165406, "text": "Y fue Dios con el muchacho; y creció, y habitó en el desierto, y fue tirador de arco.", "words": [[0, 159022], [2, 159222], [6, 159422], [11, 159722], [15, 160082], [18, 160222], [28, 161203], [30, 161347], [38, 161927], [40, 162187], [47, 162647], [50, 162767], [53, 162887], [63, 163547], [65, 163802], [69, 163962], [77, 164522], [80, 164782]]}, {"verse": 21, "start": 165756, "end": 171503, "text": "Y habitó en el desierto de Parán; y su madre le tomó mujer de la tierra de Egipto.", "words": [[0, 165756], [2, 165889], [9, 166309], [12, 166429], [15, 166549], [24, 167029], [27, 167229], [34, 167969], [36, 168067], [39, 168207], [45, 168587], [48, 168867], [53, 169327], [59, 169587], [62, 169847], [65, 170107], [72, 170367], [75, 170607]]}, {"verse": 22, "start": 171853, "end": 183770, "text": "Y aconteció en aquel mismo tiempo que habló Abimelec, y Ficol, príncipe de su ejército, a Abraham diciendo: Dios es contigo en todo cuanto haces:", "words": [[0, 171853], [2, 171996], [12, 172776], [15, 172996], [21, 173316], [27, 173576], [34, 174096], [38, 174336], [44, 174956], [54, 175576], [56, 176240], [63, 176902], [72, 177562], [75, 177761], [78, 177921], [88, 178942], [90, 179222], [98, 179622], [108, 180803], [113, 181131], [116, 181511], [124, 182051], [127, 182211], [132, 182451], [139, 182851]]}, {"verse": 23, "start": 184120, "end": 197970, "text": "Ahora pues, júrame aquí por Dios, que no faltarás a mí, ni a mi hijo, ni a mi nieto; sino que conforme a la bondad que yo hice contigo, harás tú conmigo, y con la tierra donde has morado.", "words": [[0, 184120], [6, 184524], [12, 185324], [19, 185804], [24, 186064], [28, 186324], [34, 187064], [38, 187124], [41, 187264], [50, 187864], [52, 187964], [56, 188544], [59, 188804], [61, 188884], [64, 189064], [70, 189884], [73, 189984], [75, 190084], [78, 190204], [85, 191066], [90, 191293], [94, 191513], [103, 192253], [105, 192333], [108, 192413], [115, 192953], [119, 193073], [122, 193293], [127, 193473], [136, 194253], [142, 194713], [145, 194913], [154, 195653], [156, 196093], [160, 196293], [163, 196433], [170, 196753], [176, 197033], [180, 197313]]}, {"verse": 24, "start": 198320, "end": 200845, "text": "Y respondió Abraham: Yo juraré.", "words": [[0, 198320], [2, 198427], [12, 199067], [21, 200092], [24, 200275]]}, {"verse": 25, "start": 201125, "end": 209979, "text": "Y Abraham reprendió a Abimelec a causa de un pozo de agua, que los siervos de Abimelec le habían quitado.", "words": [[0, 201125], [2, 201247], [10, 201887], [20, 203167], [22, 203697], [31, 204227], [33, 204627], [39, 204967], [42, 205207], [45, 205307], [50, 205687], [53, 205847], [59, 206447], [63, 206687], [67, 206847], [75, 207427], [78, 207847], [87, 208267], [90, 208467], [97, 208827]]}, {"verse": 26, "start": 210329, "end": 217604, "text": "Y respondió Abimelec: No sé quién haya hecho esto, ni tampoco tú me lo hiciste saber, ni yo lo he oído hasta hoy.", "words": [[0, 210329], [2, 210329], [12, 211302], [22, 212513], [25, 212656], [28, 212796], [34, 212996], [39, 213236], [45, 213556], [51, 214096], [54, 214196], [62, 214536], [65, 214796], [68, 214916], [71, 215036], [79, 215396], [86, 216076], [89, 216196], [92, 216396], [95, 216556], [98, 216716], [103, 217016], [109, 217276]]}, {"verse": 27, "start": 217884, "end": 224148, "text": "Y tomó Abraham ovejas y vacas, y dio a Abimelec; e hicieron ambos pacto.", "words": [[0, 217884], [2, 218029], [7, 218549], [15, 219069], [22, 219509], [24, 219669], [31, 220769], [33, 220869], [37, 221109], [39, 221768], [49, 222583], [51, 222728], [60, 223368], [66, 223668]]}, {"verse": 28, "start": 224148, "end": 227809, "text": "Y puso Abraham siete corderas del rebaño aparte.", "words": [[0, 224348], [2, 224588], [7, 225088], [15, 225348], [21, 225748], [30, 226195], [34, 226641], [41, 227088]]}, {"verse": 29, "start": 228159, "end": 233798, "text": "Y dijo Abimelec a Abraham: ¿Qué significan esas siete corderas que has puesto aparte?", "words": [[0, 228159], [2, 228399], [7, 228919], [16, 229466], [18, 230013], [27, 230700], [32, 230800], [43, 231480], [48, 231660], [54, 232020], [63, 232600], [67, 232800], [71, 232940], [78, 233140]]}, {"verse": 30, "start": 234078, "end": 240939, "text": "Y él respondió: Que estas siete corderas tomarás de mi mano, para que me sean en testimonio de que yo cavé este pozo.", "words": [[0, 234078], [2, 234260], [5, 234400], [16, 235395], [20, 235500], [26, 235780], [32, 236100], [41, 236640], [49, 237160], [52, 237240], [55, 237340], [61, 237640], [66, 237900], [70, 238060], [73, 238220], [78, 238440], [81, 238620], [92, 239300], [95, 239420], [99, 239580], [102, 239850], [107, 240120], [112, 240320]]}, {"verse": 31, "start": 241219, "end": 246065, "text": "Por esto llamó a aquel lugar Beerseba; porque allí juraron ambos.", "words": [[0, 241219], [4, 241363], [9, 241603], [15, 242103], [17, 242263], [23, 242683], [29, 243413], [39, 244333], [46, 244549], [51, 244799], [59, 245379]]}, {"verse": 32, "start": 246415, "end": 256798, "text": "Así hicieron pacto en Beerseba: y se levantó Abimelec, y Ficol, príncipe de su ejército, y se volvieron a tierra de los filisteos.", "words": [[0, 246415], [4, 246715], [13, 247355], [19, 248115], [22, 248668], [32, 249389], [34, 249531], [37, 249631], [45, 250331], [55, 251031], [57, 251391], [64, 252251], [73, 253151], [76, 253331], [79, 253511], [89, 254171], [91, 254331], [94, 254431], [104, 255011], [106, 255131], [113, 255431], [116, 255671], [120, 255831]]}, {"verse": 33, "start": 257148, "end": 264235, "text": "Y plantó Abraham un bosque en Beerseba, e invocó allí el nombre de Jehová Dios eterno.", "words": [[0, 257148], [2, 257270], [9, 257830], [17, 258390], [20, 258650], [27, 259170], [30, 259810], [40, 260450], [42, 260730], [49, 261330], [54, 261570], [57, 261810], [64, 262130], [67, 262350], [74, 263150], [79, 263350]]}, {"verse": 34, "start": 264585, "end": 268856, "text": "Y moró Abraham en tierra de los filisteos muchos días.", "words": [[0, 264585], [2, 264714], [7, 265114], [15, 265714], [18, 266074], [25, 266534], [28, 266794], [32, 266934], [42, 267634], [49, 268054]]}]}