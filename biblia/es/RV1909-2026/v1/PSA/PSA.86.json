{"book": "PSA", "chapter": 86, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 121929, "verses": [{"verse": 1, "start": 300, "end": 7470, "text": "Oración de David. INCLINA, oh Jehová, tu oído, y óyeme; porque estoy afligido y necesitado.", "words": [[0, 300], [8, 745], [11, 1005], [18, 1895], [27, 2407], [30, 2947], [38, 3487], [41, 3707], [47, 4167], [49, 4407], [56, 5554], [63, 5634], [69, 5714], [78, 6314], [80, 6474]]}, {"verse": 2, "start": 7920, "end": 15014, "text": "Guarda mi alma, porque soy piadoso: salva tú, oh Dios mío, a tu siervo que en ti, confía.", "words": [[0, 7920], [7, 8345], [10, 8505], [16, 8785], [23, 9105], [27, 9385], [36, 11320], [42, 11320], [46, 11320], [49, 11467], [54, 11647], [59, 12167], [61, 12227], [64, 12367], [71, 12847], [75, 13047], [78, 13227], [82, 13507]]}, {"verse": 3, "start": 15464, "end": 19780, "text": "Ten misericordia de mí, oh Jehová: porque a ti clamo todo el día.", "words": [[0, 15464], [4, 15608], [17, 16428], [20, 16568], [24, 16950], [27, 17333], [35, 17951], [42, 18134], [44, 18414], [47, 18594], [53, 18774], [58, 19054], [61, 19314]]}, {"verse": 4, "start": 20230, "end": 24973, "text": "Alegra el alma de tu siervo: porque a ti, oh Señor, levanto mi alma.", "words": [[0, 20454], [7, 20704], [10, 20844], [15, 21044], [18, 21224], [21, 21344], [29, 22259], [36, 22463], [38, 22623], [42, 22813], [45, 23003], [52, 23383], [60, 24283], [63, 24423]]}, {"verse": 5, "start": 25423, "end": 33455, "text": "Porque tú, Señor, eres bueno y perdonador, y grande en misericordia para con todos los que te invocan.", "words": [[0, 25423], [7, 25648], [11, 25908], [18, 26428], [23, 27168], [29, 27628], [31, 28108], [43, 28868], [45, 29548], [52, 29968], [55, 30148], [68, 31008], [73, 31248], [77, 31528], [83, 31948], [87, 32328], [91, 32488], [94, 32628]]}, {"verse": 6, "start": 33905, "end": 38097, "text": "Escucha, oh Jehová, mi oración, y está atento a la voz de mis ruegos.", "words": [[0,