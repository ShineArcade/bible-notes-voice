{"book": "1CO", "chapter": 1, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 217684, "verses": [{"verse": 1, "start": 300, "end": 5668, "text": "Pablo, llamado a ser apóstol de Jesucristo por la voluntad de Dios, y Sóstenes el hermano,", "words": [[0, 300], [7, 560], [15, 860], [17, 1100], [21, 1240], [29, 1800], [32, 1900], [43, 2560], [47, 2780], [50, 2900], [59, 3420], [62, 3520], [68, 3820], [70, 4400], [79, 5020], [82, 5120]]}, {"verse": 2, "start": 6118, "end": 17413, "text": "A la iglesia de Dios que está en Corinto, santificados en Cristo Jesús, llamados santos, y a todos los que invocan el nombre de nuestro Señor Jesucristo en cualquier lugar, Señor de ellos y nuestro:", "words": [[0, 6118], [2, 6218], [5, 6278], [13, 6618], [16, 6738], [21, 6978], [25, 7158], [30, 7338], [33, 7458], [42, 8298], [55, 9058], [58, 9238], [65, 9458], [72, 9978], [81, 10498], [89, 11438], [91, 11598], [93, 11678], [99, 11818], [103, 12038], [107, 12178], [115, 12658], [118, 12758], [125, 13058], [128, 13238], [136, 13418], [142, 13778], [153, 14558], [156, 14678], [166, 14878], [173, 15805], [179, 16144], [182, 16384], [188, 16604], [190, 16804]]}, {"verse": 3, "start": 17863, "end": 21476, "text": "Gracia y paz de Dios nuestro Padre, y del Señor Jesucristo.", "words": [[0, 17863], [7, 18302], [9, 18402], [13, 18602], [16, 18802], [21, 18962], [29, 19222], [36, 20042], [38, 20162], [42, 20322], [48, 20562]]}, {"verse": 4, "start": 21926, "end": 27560, "text": "Gracias doy a mi Dios siempre por vosotros, por la gracia de Dios que os es dada en Cristo Jesús;", "words": [[0, 21926], [8, 22284], [12, 22664], [14, 22724], [17, 22804], [22, 23024], [30, 23384], [34, 23644], [44, 24564], [48, 24664], [51, 24804], [58, 25224], [61, 25344], [66, 25584], [70, 25844], [73, 26004], [76, 26144], [81, 26384], [84, 26524], [91, 26824]]}, {"verse": 5, "start": 28010, "end": 33470, "text": "Que en todas las cosas sois enriquecidos en él, en toda lengua y en todo conocimiento;", "words": [[0, 28010], [4, 28125], [7, 28245], [13, 28425], [17, 28765], [23, 29165], [28, 29605], [41, 30265], [44, 30525], [48, 31205], [51, 31325], [56, 31525], [63, 32065], [65, 32185], [68, 32305], [73, 32525]]}, {"verse": 6, "start": 33920, "end": 37604, "text": "Así como el testimonio de Cristo ha sido confirmado en vosotros:", "words": [[0, 33920], [4, 34182], [9, 34442], [12, 34602], [23, 35262], [26, 35362], [33, 35782], [36, 36042], [41, 36222], [52, 36842], [55, 36942]]}, {"verse": 7, "start": 38054, "end": 44615, "text": "De tal manera que nada os falte en ningún don, esperando la manifestación de nuestro Señor Jesucristo:", "words": [[0, 38054], [3, 38192], [7, 38352], [14, 38672], [18, 38912], [23, 39132], [26, 39372], [32, 39582], [35, 39792], [42, 40072], [47, 40952], [57, 41372], [60, 41652], [74, 42412], [77, 42552], [85, 42732], [91, 43152]]}, {"verse": 8, "start": 45065, "end": 51024, "text": "El cual también os confirmará hasta el fin, para que seáis sin falta en el día de nuestro Señor Jesucristo.", "words": [[0, 45065], [3, 45185], [8, 45405], [16, 45785], [19, 46065], [30, 46685], [36, 46925], [39, 47065], [44, 47325], [49, 47765], [53, 47905], [59, 48285], [63, 48485], [69, 48825], [72, 49045], [75, 49165], [79, 49385], [82, 49525], [90, 49685], [96, 50105]]}, {"verse": 9, "start": 51474, "end": 57034, "text": "Fiel es Dios, por el cual sois llamados a la participación de su Hijo Jesucristo nuestro Señor.", "words": [[0, 51474], [5, 51756], [8, 51876], [14, 52116], [18, 52416], [21, 52536], [26, 52756], [31, 53136], [40, 53636], [42, 53776], [45, 53856], [59, 54816], [62, 54976], [65, 55176], [70, 55416], [81, 56116], [89, 56276]]}, {"verse": 10, "start": 57484, "end": 70771, "text": "Os ruego pues, hermanos, por el nombre de nuestro Señor Jesucristo, que habléis todos una misma cosa, y que no haya entre vosotros divisiones, antes seáis perfectamente unidos en una misma mente y en un mismo parecer.", "words": [[0, 57484], [3, 57638], [9, 58038], [15, 58458], [25, 59238], [29, 59358], [32, 59458], [39, 59718], [42, 59878], [50, 60098], [56, 60458], [68, 61678], [72, 61758], [80, 62138], [86, 62318], [90, 62658], [96, 62858], [102, 63318], [104, 63778], [108, 63898], [111, 64078], [116, 64298], [122, 64518], [131, 64998], [143, 66246], [149, 66511], [155, 66991], [169, 67771], [176, 68211], [179, 68531], [183, 68671], [189, 68931], [195, 69371], [197, 69551], [200, 69651], [203, 69751], [209, 70031]]}, {"verse": 11, "start": 71221, "end": 77440, "text": "Porque me ha sido declarado de vosotros, hermanos míos, por los que son de Cloé, que hay entre vosotros contiendas;", "words": [[0, 71221], [7, 71386], [10, 71546], [13, 71626], [18, 71846], [28, 72446], [31, 72586], [41, 73266], [50, 73746], [56, 74466], [60, 74566], [64, 74686], [68, 74786], [72, 74946], [75, 75316], [81, 75686], [85, 75806], [89, 75946], [95, 76166], [104, 76831]]}, {"verse": 12, "start": 77890, "end": 86061, "text": "Quiero decir, que cada uno de vosotros dice: Yo cierto soy de Pablo; pues yo de Apolos; y yo de Cefas; y yo de Cristo.", "words": [[0, 77890], [7, 78099], [14, 78499], [18, 78759], [23, 78999], [27, 79279], [30, 79439], [39, 79879], [45, 80760], [48, 81027], [55, 81507], [59, 81647], [62, 81807], [69, 82622], [74, 82728], [77, 82968], [80, 83108], [88, 84033], [90, 84174], [93, 84294], [96, 84659], [103, 85324], [105, 85471], [108, 85591], [111, 85711]]}, {"verse": 13, "start": 86511, "end": 93691, "text": "¿Está dividido Cristo? ¿fue crucificado Pablo por vosotros? ¿o habéis sido bautizados en el nombre de Pablo?", "words": [[0, 86511], [6, 87152], [15, 87652], [23, 88563], [28, 88690], [40, 89450], [46, 89770], [50, 90030], [60, 90990], [63, 91091], [70, 91411], [75, 91631], [86, 92351], [89, 92551], [92, 92651], [99, 92931], [102, 93111]]}, {"verse": 14, "start": 94141, "end": 99871, "text": "Doy gracias a Dios, que a ninguno de vosotros he bautizado, sino a Crispo y a Gayo;", "words": [[0, 94141], [4, 94361], [12, 94581], [14, 94861], [20, 95061], [24, 95361], [26, 95441], [34, 95881], [37, 95961], [46, 96421], [49, 96621], [60, 97581], [65, 97721], [67, 97881], [74, 98261], [76, 98401], [78, 98501]]}, {"verse": 15, "start": 100321, "end": 103370, "text": "Para que ninguno diga que habéis sido bautizados en mi nombre.", "words": [[0, 100321], [5, 100461], [9, 100601], [17, 101021], [22, 101361], [26, 101461], [33, 101801], [38, 101981], [49, 102561], [52, 102781], [55, 102901]]}, {"verse": 16, "start": 103820, "end": 108499, "text": "Y también bauticé la familia de Estéfanas: pero no sé si he bautizado algún otro.", "words": [[0, 103820], [2, 103926], [10, 104186], [18, 104706], [21, 104846], [29, 105206], [32, 105366], [43, 106457], [48, 106599], [51, 106759], [54, 106979], [57, 107179], [60, 107259], [70, 107699], [76, 108039]]}, {"verse": 17, "start": 108949, "end": 117562, "text": "Porque no me envió Cristo a bautizar, sino a predicar el evangelio: no en sabiduría de palabras, porque no sea hecha vana la cruz de Cristo.", "words": [[0, 108949], [7, 109169], [10, 109329], [13, 109469], [19, 109789], [26, 110149], [28, 110559], [38, 110969], [43, 111469], [45, 111609], [54, 112089], [57, 112269], [68, 113284], [71, 113445], [74, 113585], [84, 114225], [87, 114345], [97, 115065], [104, 115265], [107, 115570], [111, 115875], [117, 116180], [122, 116485], [125, 116585], [130, 116905], [133, 117005]]}, {"verse": 18, "start": 118012, "end": 125694, "text": "Porque la palabra de la cruz es locura a los que se pierden; pero a los que se salvan, es decir, a nosotros, es poder de Dios.", "words": [[0, 118012], [7, 118172], [10, 118332], [18, 118712], [21, 118892], [24, 119012], [29, 119472], [32, 119632], [39, 120192], [41, 120352], [45, 120472], [49, 120592], [52, 120732], [61, 121705], [66, 121824], [68, 121944], [72, 122064], [76, 122184], [79, 122304], [87, 122824], [90, 123024], [97, 123424], [99, 123724], [109, 124544], [112, 124684], [118, 124964], [121, 125204]]}, {"verse": 19, "start": 126144, "end": 132441, "text": "Porque está escrito: Destruiré la sabiduría de los sabios, y desecharé la inteligencia de los entendidos.", "words": [[0, 126144], [7, 126320], [12, 126540], [21, 127502], [31, 128084], [34, 128164], [44, 128804], [47, 128904], [51, 129044], [59, 129664], [61, 129884], [71, 130444], [74, 130584], [87, 131304], [90, 131424], [94, 131544]]}, {"verse": 20, "start": 132891, "end": 141333, "text": "¿Dónde está el sabio? ¿Dónde está el escriba? ¿Dónde está el que debate en esta época? ¿No ha enloquecido Dios la sabiduría del mundo?", "words": [[0, 132891], [7, 133208], [12, 133448], [15, 133568], [22, 134457], [29, 134756], [34, 135016], [37, 135176], [46, 136099], [53, 136417], [58, 136637], [61, 136757], [65, 136897], [72, 137237], [75, 137437], [80, 137677], [87, 138605], [91, 138767], [94, 138947], [106, 139647], [111, 139907], [114, 140127], [124, 140707], [128, 140827]]}, {"verse": 21, "start": 141783, "end": 151264, "text": "Porque, en la sabiduría de Dios, el mundo no conoció a Dios mediante la sabiduría, agradó a Dios salvar a los creyentes por la locura de la predicación.", "words": [[0, 141783], [8, 142043], [11, 142223], [14, 142283], [24, 142923], [27, 143043], [33, 143783], [36, 143883], [42, 144163], [45, 144403], [53, 144883], [55, 145023], [60, 145223], [69, 145783], [72, 145903], [83, 146943], [90, 147423], [92, 147623], [97, 147803], [104, 148283], [106, 148443], [110, 148603], [120, 149183], [124, 149483], [127, 149623], [134, 150043], [137, 150163], [140, 150283]]}, {"verse": 22, "start": 151714, "end": 155275, "text": "Porque los judíos piden señales, y los griegos buscan sabiduría:", "words": [[0, 151714], [7, 151874], [11, 152054], [18, 152454], [24, 152774], [33, 153454], [35, 153574], [39, 153714], [47, 154094], [54, 154494]]}, {"verse": 23, "start": 155725, "end": 162613, "text": "Pero nosotros predicamos a Cristo crucificado, a los judíos ciertamente tropezadero, y a los Gentiles