{"book": "MAT", "chapter": 23, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 280193, "verses": [{"verse": 1, "start": 300, "end": 4411, "text": "Then spoke Jesus to the multitude, and to his disciples,", "words": [[0, 300], [5, 550], [11, 931], [17, 1330], [20, 1630], [24, 1730], [35, 2690], [39, 2870], [42, 3030], [46, 3170]]}, {"verse": 2, "start": 4861, "end": 8107, "text": "Saying, The scribes and the Pharisees sit in Moses’ seat:", "words": [[0, 4995], [8, 5421], [12, 5511], [20, 6131], [24, 6231], [28, 6351], [38, 7011], [42, 7151], [45, 7291], [52, 7731]]}, {"verse": 3, "start": 8557, "end": 15899, "text": "All therefore whatever they bid you observe, that observe and do; but do not you after their works: for they say, and do not.", "words": [[0, 8557], [4, 8741], [14, 9261], [23, 9481], [28, 9741], [32, 10021], [36, 10161], [45, 10861], [50, 11121], [58, 11501], [62, 11701], [66, 12432], [70, 12549], [73, 12709], [77, 12869], [81, 13129], [87, 13389], [93, 13589], [100, 14417], [104, 14481], [109, 14621], [114, 15001], [118, 15341], [121, 15481]]}, {"verse": 4, "start": 16349, "end": 24563, "text": "For they bind heavy burdens and grievous to be borne, and lay them on men’s shoulders; but they themselves will not move them with one of their fingers.", "words": [[0, 16349], [4, 16443], [9, 16603], [14, 17003], [20, 17303], [28, 17763], [32, 18043], [41, 18443], [44, 18643], [47, 19023], [54, 19403], [58, 19623], [62, 19843], [67, 20023], [70, 20203], [76, 20583], [87, 21510], [91, 21613], [96, 21793], [107, 22273], [112, 22653], [116, 22833], [121, 23133], [126, 23333], [131, 23513], [135, 23673], [138, 23753], [144, 23893]]}, {"verse": 5, "start": 25013, "end": 31480, "text": "But all their works they do for to be seen of men: they make broad their phylacteries, and enlarge the borders of their garments,", "words": [[0, 25013], [4, 25131], [8, 25271], [14, 25431], [20, 25711], [25, 25931], [28, 26131], [32, 26571], [35, 26651], [38, 26791], [43, 26971], [46, 27111], [51, 27841], [56, 27943], [61, 28103], [67, 28403], [73, 28623], [87, 29383], [91, 29683], [99, 30143], [103, 30243], [111, 30523], [114, 30683], [120, 30803]]}, {"verse": 6, "start": 31930, "end": 36543, "text": "And love the uppermost rooms at feasts, and the chief seats in the synagogues,", "words": [[0, 31930], [4, 32071], [9, 32391], [13, 32631], [23, 33231], [29, 33611], [32, 33831], [40, 34331], [44, 34851], [48, 34971], [54, 35191], [60, 35511], [63, 35731], [67, 35811]]}, {"verse": 7, "start": 36993, "end": 41231, "text": "And greetings in the markets, and to be called of men, Rabbi, Rabbi.", "words": [[0, 36993], [4, 37134], [14, 37454], [17, 37734], [21, 37814], [30, 38574], [34, 38674], [37, 38794], [40, 38914], [47, 39134], [50, 39334], [55, 39854], [62, 40654]]}, {"verse": 8, "start": 41681, "end": 47881, "text": "But be not you called Rabbi: for one is your Master, even Christ; and all you are brethren.", "words": [[0, 41681], [4, 41785], [7, 41925], [11, 42105], [15, 42365], [22, 42665], [29, 43752], [33, 43864], [37, 44064], [40, 44344], [45, 44464], [53, 45244], [58, 45424], [66, 46359], [70, 46483], [74, 46723], [78, 47003], [82, 47283]]}, {"verse": 9, "start": 48331, "end": 53136, "text": "And call no man your father upon the earth: for one is your Father, which is in heaven.", "words": [[0, 48331], [4, 48436], [9, 48676], [12, 48916], [16, 49196], [21, 49416], [28, 49696], [33, 49976], [37, 50196], [44, 50856], [48, 50980], [52, 51240], [55, 51560], [60, 51680], [68, 52260], [74, 52440], [77, 52560], [80, 52700]]}, {"verse": 10, "start": 53586, "end": 57798, "text": "Neither be called masters: for one is your Master, even Christ.", "words": [[0, 53586], [8, 53946], [11, 54146], [18, 54406], [27, 55465], [31, 55574], [35, 55774], [38, 55914], [43, 56034], [51, 56914], [56, 57074]]}, {"verse": 11, "start": 58248, "end": 60853, "text": "But he that is greatest among you shall be your servant.", "words": [[0, 58248], [4, 58346], [7, 58506], [12, 58686], [15, 58806], [24, 59106], [30, 59406], [34, 59706], [40, 59986], [43, 60166], [48, 60286]]}, {"verse": 12, "start": 61303, "end": 67009, "text": "And whoever shall exalt himself shall be abased; and he that shall humble himself shall be exalted.", "words": [[0, 61303], [4, 61579], [12, 61859], [18, 62159], [24, 62539], [32, 62919], [38, 63179], [41, 63359], [49, 64260], [53, 64417], [56, 64657], [61, 64877], [67, 65117], [74, 65417], [82, 65897], [88, 66177], [91, 66357]]}, {"verse": 13, "start": 67459, "end": 77973, "text": "¶ But woe to you, scribes and Pharisees, hypocrites! for you shut up the kingdom of heaven against men: for you neither go in yourselves, nor do you allow those who are entering to go in.", "words": [[2, 67459], [6, 67576], [10, 67936], [13, 68036], [18, 68376], [26, 68976], [30, 69076], [41, 69856], [53, 70949], [57, 71034], [61, 71194], [66, 71474], [69, 71594], [73, 71734], [81, 71994], [84, 72234], [91, 72474], [99, 72774], [104, 73644], [108, 73752], [112, 73892], [120, 74132], [123, 74392], [126, 74512], [138, 75012], [142, 75692], [145, 75852], [149, 75912], [155, 76212], [161, 76572], [165, 76712], [169, 76792], [178, 77152], [181, 77392], [184, 77572]]}, {"verse": 14, "start": 78423, "end": 88423, "text": "Woe to you, scribes and Pharisees, hypocrites! for you devour widows’ houses, and for a pretence make long prayer: therefore you shall receive the greater damnation.", "words": [[0, 78423], [4, 78803], [7, 78883], [12, 79023], [20, 79663], [24, 79783], [35, 80603], [47, 81657], [51, 81795], [55, 81955], [62, 82455], [70, 82955], [78, 83275], [82, 83795], [86, 84035], [88, 84275], [97, 84515], [102, 84795], [107, 85075], [115, 85970], [125, 86277], [129, 86537], [135, 86717], [143, 87137], [147, 87317], [155, 87597]]}, {"verse": 15, "start": 88873, "end": 99514, "text": "Woe to you, scribes and Pharisees, hypocrites! for you compass sea and land to make one proselyte, and when he is made, you make him twofold more the child of hell than yourselves.", "words": [[0, 88873], [4, 89198], [7, 89278], [12, 89418], [20, 89998], [24, 90078], [35, 90838], [47, 91810], [51, 91870], [55, 92030], [63, 92350], [67, 92790], [71, 93010], [76, 93310], [79, 93530], [84, 93710], [88, 93910], [99, 94930], [103, 95150], [108, 95310], [111, 95470], [114, 95610], [120, 96350], [124, 96490], [129, 96670], [133, 96850], [141, 97330], [146, 97630], [150, 97770], [156, 98110], [159, 98270], [164, 98550], [169, 98750]]}, {"verse": 16, "start": 99964, "end": 110316, "text": "Woe to you, you blind guides, which say, Whoever shall swear by the temple, it is nothing; but whoever shall swear by the gold of the temple, he is a debtor!", "words": [[0, 99964], [4, 100316], [7, 100416], [12, 100776], [16, 100876], [22, 101216], [30, 102256], [36, 102376], [41, 103076], [49, 103356], [55, 103736], [61, 104096], [64, 104356], [68, 104496], [76, 105276], [79, 105376], [82, 105516], [91, 106402], [95, 106502], [103, 106762], [109, 107142], [115, 107482], [118, 107722], [122, 107882], [127, 108142], [130, 108322], [134, 108422], [142, 109042], [145, 109322], [148, 109702], [150, 109842]]}, {"verse": 17, "start": 110766, "end": 116752, "text": "You fools and blind: for whether is greater, the gold, or the temple that sanctifies the gold?", "words": [[0, 110766], [4, 110952], [10, 111392], [14, 111692], [21, 112640], [25, 112748], [33, 112948], [36, 113208], [45, 113568], [49, 114048], [55, 114428], [58, 114848], [62, 114968], [69, 115288], [74, 115488], [85, 116068], [89, 116268]]}, {"verse": 18, "start": 117202, "end": 123435, "text": "And, Whoever shall swear by the altar, it is nothing; but whoever swears by the gift that is upon it, he is guilty.", "words": [[0, 117202], [5, 117310], [13, 117550], [19, 117850], [25, 118190], [28, 118390], [32, 118550], [39, 118990], [42, 119090], [45, 119230], [54, 120137], [58, 120275], [66, 120555], [73, 121155], [76, 121315], [80, 121455], [85, 121715], [90, 121895], [93, 122035], [98, 122335], [102, 122635], [105, 122735], [108, 122875]]}, {"verse": 19, "start": 123885, "end": 129488, "text": "You fools and blind: for whether is greater, the gift, or the altar that sanctifies the gift?", "words": [[0, 123885], [4, 124046], [10, 124666], [14, 124766], [21, 125713], [25, 125811], [33, 125991], [36, 126191], [45, 126891], [49, 126971], [55, 127511], [58, 127631], [62, 127771], [68, 128031], [73, 128271], [84, 128831], [88, 129031]]}, {"verse": 20, "start": 129938, "end": 135064, "text": "Whoever therefore shall swear by the altar, swears by it, and by all things on it.", "words": [[0, 129938], [8, 130184], [18, 130784], [24, 131084], [30, 131464], [33, 131704], [37, 131864], [44, 132544], [51, 133004], [54, 133224], [58, 133604], [62, 133824], [65, 133984], [69, 134264], [76, 134524], [79, 134824]]}, {"verse": 21, "start": 135514, "end": 140106, "text": "And whoever shall swear by the temple, swears by it, and by him that dwells in it.", "words": [[0, 135514], [4, 135611], [12, 135851], [18, 136171], [24, 136471], [27, 136671], [31, 136791], [39, 137131], [46, 137931], [49, 138171], [53, 138451], [57, 138651], [60, 138831], [64, 139091], [69, 139291], [76, 139731], [79, 139851]]}, {"verse": 22, "start": 140556, "end": 145946, "text": "And he that shall swear by heaven, swears by the throne of God, and by him that sits on it.", "words": [[0, 140556], [4, 140705], [7, 140945], [12, 141185], [18, 141405], [24, 141745], [27, 141985], [35, 142605], [42, 143165], [45, 143345], [49, 143465], [56, 143705], [59, 143845], [64, 144465], [68, 144625], [71, 144845], [75, 145045], [80, 145245], [85, 145445], [88, 145705]]}, {"verse": 23, "start": 146396, "end": 160633, "text": "Woe to you, scribes and Pharisees, hypocrites! for you pay tithe of mint and anise and cummin, and have omitted the weightier matters of the law, judgment, mercy, and faith: these ought you to have done, and not to leave the other undone.", "words": [[0, 146396], [4, 146714], [7, 146774], [12, 146914], [20, 147534], [24, 147634], [35, 148414], [47, 149418], [51, 149478], [55, 149598], [59, 149778], [65, 150158], [68, 150298], [73, 150578], [77, 150818], [83, 151318], [87, 151788], [95, 152258], [99, 152338], [104, 152498], [112, 152818], [116, 152998], [126, 153378], [134, 153738], [137, 153978], [141, 154078], [146, 154778], [156, 155498], [163, 156178], [167, 156218], [174, 156978], [180, 157162], [186, 157502], [190, 157722], [193, 157802], [198, 158002], [204, 158322], [208, 158882], [212, 159082], [215, 159302], [221, 159462], [225, 159662], [231, 159902]]}, {"verse": 24, "start": 161083, "end": 164539, "text": "You blind guides, which strain at a gnat, and swallow a camel.", "words": [[0, 161083], [4, 161185], [10, 161525], [18, 161965], [24, 162165], [31, 162505], [34, 162685], [36, 162865], [42, 163045], [46, 163485], [54, 163785], [56, 164045]]}, {"verse": 25, "start": 164989, "end": 174415, "text": "Woe to you, scribes and Pharisees, hypocrites! for you make clean the outside of the cup and of the platter, but within they are full of extortion and excess.", "words": [[0, 164989], [4, 165288], [7, 165348], [12, 165488], [20, 166028], [24, 166108], [35, 167048], [47, 168206], [51, 168335], [55, 168495], [60, 168655], [66, 169015], [70, 169255], [78, 169615], [81, 169895], [85, 169995], [89, 170275], [93, 170615], [96, 170755], [100, 170875], [109, 171735], [113, 171855], [120, 172155], [125, 172375], [129, 172475], [134, 172695], [137, 172835], [147, 173435], [151, 173795]]}, {"verse": 26, "start": 174865, "end": 181099, "text": "You blind Pharisee, cleanse first that which is within the cup and platter, that the outside of them may be clean also.", "words": [[0, 174865], [4, 174984], [10, 175344], [20, 175984], [28, 176264], [34, 176604], [39, 176924], [45, 177084], [48, 177264], [55, 177484], [59, 177644], [63, 177904], [67, 178144], [76, 178604], [81, 179024], [85, 179144], [93, 179484], [96, 179764], [101, 179904], [105, 180124], [108, 180204], [114, 180484]]}, {"verse": 27, "start": 181549, "end": 192527, "text": "Woe to you, scribes and Pharisees, hypocrites! for you are like to whitewashed tombs, which indeed appear beautiful outward, but are within full of dead men’s bones, and of all uncleanness.", "words": [[0, 181549], [4, 181892], [7, 181972], [12, 182152], [20, 182672], [24, 182772], [35, 183472], [47, 184521], [51, 184581], [55, 184741], [59, 184881], [64, 185081], [67, 185421], [79, 185761], [86, 186541], [92, 186801], [99, 187121], [106, 187421], [116, 188001], [125, 188781], [129, 188941], [133, 189041], [140, 189301], [145, 189681], [148, 189801], [153, 190021], [159, 190361], [166, 190661], [170, 191201], [173, 191321], [177, 191521]]}, {"verse": 28, "start": 192977, "end": 198803, "text": "Even so you also outwardly appear righteous to men, but within you are full of hypocrisy and iniquity.", "words": [[0, 192977], [5, 193160], [8, 193520], [12, 193580], [17, 193900], [27, 194580], [34, 194740], [44, 195220], [47, 195500], [52, 196060], [56, 196200], [63, 196480], [67, 196720], [71, 196900], [76, 197140], [79, 197260], [89, 197900], [93, 198180]]}, {"verse": 29, "start": 199253, "end": 207436, "text": "Woe to you, scribes and Pharisees, hypocrites! because you build the tombs of the prophets, and garnish the tombs of the righteous,", "words": [[0, 199253], [4, 199541], [7, 199601], [12, 199741], [20, 200321], [24, 200421], [35, 201241], [47, 202345], [55, 202623], [59, 202923], [65, 203223], [69, 203423], [75, 203903], [78, 204023], [82, 204123], [92, 204583], [96, 205423], [104, 205763], [108, 206103], [114, 206583], [117, 206683], [121, 206783]]}, {"verse": 30, "start": 207886, "end": 214065, "text": "And say, If we had been in the days of our fathers, we would not have been partakers with them in the blood of the prophets.", "words": [[0, 207886], [4, 208011], [9, 208311], [12, 208511], [15, 208671], [19, 208811], [24, 208991], [27, 209111], [31, 209211], [36, 209491], [39, 209651], [43, 209771], [52, 210611], [55, 210811], [61, 210971], [65, 211131], [70, 211271], [75, 211431], [85, 211951], [90, 212271], [95, 212491], [98, 212711], [102, 212831], [108, 213071], [111, 213231], [115, 213351]]}, {"verse": 31, "start": 214515, "end": 219515, "text": "Therefore you be witnesses to yourselves, that you are the children of them which killed the prophets.", "words": [[0, 214515], [10, 214896], [14, 215156], [17, 215296], [27, 215656], [30, 215996], [42, 216776], [47, 217136], [51, 217316], [55, 217436], [59, 217536], [68, 217836], [71, 218076], [76, 218236], [82, 218456], [89, 218716], [93, 218876]]}, {"verse": 32, "start": 219965, "end": 221998, "text": "Fill up then the measure of your fathers.", "words": [[0, 219965], [5, 220163], [8, 220343], [13, 220583], [17, 220743], [25, 221023], [28, 221223], [33, 221343]]}, {"verse": 33, "start": 222448, "end": 227312, "text": "You serpents, you generation of vipers, how can you escape the damnation of hell?", "words": [[0, 222448], [4, 222654], [14, 223374], [18, 223454], [29, 223914], [32, 224254], [40, 225114], [44, 225294], [48, 225474], [52, 225574], [59, 225874], [63, 226094], [73, 226714], [76, 226894]]}, {"verse": 34, "start": 227762, "end": 240331, "text": "¶ Therefore, behold, I send to you prophets, and wise men, and scribes: and some of them you shall kill and crucify; and some of them shall you scourge in your synagogues, and persecute them from city to city:", "words": [[2, 227762], [13, 228224], [21, 228824], [23, 229044], [28, 229304], [31, 229484], [35, 229584], [45, 229984], [49, 230404], [54, 230744], [59, 231104], [63, 231384], [72, 232382], [76, 232513], [81, 232793], [84, 232973], [89, 233173], [93, 233373], [99, 233613], [104, 234013], [108, 234353], [117, 235490], [121, 235629], [126, 235869], [129, 236009], [134, 236169], [140, 236409], [144, 236589], [152, 237149], [155, 237269], [160, 237369], [172, 238109], [176, 238429], [186, 239069], [191, 239229], [196, 239449], [201, 239729], [204, 239889]]}, {"verse": 35, "start": 240781, "end": 251303, "text": "That upon you may come all the righteous blood shed upon the earth, from the blood of righteous Abel to the blood of Zacharias son of Barachias, whom you killed between the temple and the altar.", "words": [[0, 240781], [5, 240883], [10, 241183], [14, 241383], [18, 241563], [23, 241803], [27, 242183], [31, 242343], [41, 242643], [47, 243063], [52, 243323], [57, 243563], [61, 243803], [68, 244383], [73, 244563], [77, 244723], [83, 245063], [86, 245243], [96, 245543], [101, 246023], [104, 246163], [108, 246283], [114, 246503], [117, 246663], [127, 247223], [131, 247563], [134, 248033], [145, 248754], [150, 248927], [154, 249107], [161, 249407], [169, 249747], [173, 249967], [180, 250287], [184, 250707], [188, 250827]]}, {"verse": 36, "start": 251753, "end": 255611, "text": "Assuredly I say to you, All these things shall come upon this generation.", "words": [[0, 251753], [10, 252351], [12, 252391], [16, 252631], [19, 252811], [24, 253151], [28, 253311], [34, 253531], [41, 253891], [47, 254131], [52, 254331], [57, 254591], [62, 254891]]}, {"verse": 37, "start": 256061, "end": 269308, "text": "O Jerusalem, Jerusalem, you that kill the prophets, and stone them which are sent to you, how often would I have gathered your children together, even as a hen gathers her chickens under her wings, and you would not!", "words": [[0, 256061], [2, 256319], [13, 257539], [24, 258079], [28, 258519], [33, 259179], [38, 259459], [42, 259639], [52, 260039], [56, 260619], [62, 260979], [67, 261239], [73, 261439], [77, 261579], [82, 261799], [85, 261999], [90, 262519], [94, 262779], [100, 263159], [106, 263339], [108, 263479], [113, 263579], [122, 263919], [127, 264079], [136, 264439], [146, 265364], [151, 265584], [154, 265784], [156, 265904], [160, 266104], [168, 266564], [172, 266724], [181, 267004], [187, 267304], [191, 267484], [198, 268144], [202, 268324], [206, 268584], [212, 268804]]}, {"verse": 38, "start": 269758, "end": 272026, "text": "Behold, your house is left to you desolate.", "words": [[0, 269758], [8, 270261], [13, 270341], [19, 270661], [22, 270801], [27, 271061], [30, 271281], [34, 271361]]}, {"verse": 39, "start": 272476, "end": 279793, "text": "For I say to you, You shall not see me from now on, till you shall say, Blessed is he that comes in the name of the Lord.", "words": [[0, 272476], [4, 272586], [6, 272766], [10, 273006], [13, 273206], [18, 273666], [22, 273846], [28, 274046], [32, 274246], [36, 274506], [39, 274666], [44, 274866], [48, 275106], [52, 276026], [57, 276126], [61, 276266], [67, 276486], [72, 277146], [80, 277446], [83, 277866], [86, 278046], [91, 278246], [97, 278506], [100, 278706], [104, 278786], [109, 279046], [112, 279166], [116, 279286]]}]}