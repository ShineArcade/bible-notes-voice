{"book": "JHN", "chapter": 13, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 301048, "verses": [{"verse": 1, "start": 300, "end": 13525, "text": "Antes de la fiesta de la Pascua, sabiendo Jesús que su hora había venido para que pasase de este mundo al Padre, como había amado a los suyos que estaban en el mundo, los amó hasta el fin.", "words": [[0, 300], [6, 642], [9, 822], [12, 942], [19, 1362], [22, 1482], [25, 1602], [33, 2562], [42, 3222], [48, 3642], [52, 4102], [55, 4342], [60, 4702], [66, 5082], [73, 5562], [78, 5822], [82, 6002], [89, 6522], [92, 6682], [97, 6942], [103, 7242], [106, 7422], [113, 8288], [118, 8537], [124, 8877], [130, 9537], [132, 9637], [136, 9777], [142, 10257], [146, 10377], [154, 10677], [157, 10897], [160, 11057], [167, 11797], [171, 12197], [175, 12637], [181, 12897], [184, 13057]]}, {"verse": 2, "start": 13875, "end": 22622, "text": "Y la cena acabada, como el diablo ya había metido en el corazón de Judas, hijo de Simón Iscariote, que le entregase,", "words": [[0, 13875], [2, 14001], [5, 14141], [10, 14421], [19, 15141], [24, 15521], [27, 15761], [34, 16241], [37, 16521], [43, 16761], [50, 17361], [53, 17481], [56, 17601], [64, 18021], [67, 18261], [74, 19041], [79, 19421], [82, 19661], [88, 20241], [99, 21536], [103, 21616], [106, 21756]]}, {"verse": 3, "start": 22972, "end": 30653, "text": "Sabiendo Jesús que el Padre le había dado todas las cosas en las manos, y que había salido de Dios, y a Dios iba,", "words": [[0, 22972], [9, 23351], [15, 23771], [19, 24331], [22, 24491], [28, 24931], [31, 25051], [37, 25311], [42, 25651], [48, 25991], [52, 26291], [58, 26591], [61, 26851], [65, 26991], [72, 27411], [74, 27831], [78, 27971], [84, 28191], [91, 28731], [94, 28911], [100, 29251], [102, 29606], [104, 29726], [109, 29946]]}, {"verse": 4, "start": 31003, "end": 37005, "text": "Se levanta de la cena, y se quita su ropa, y tomando una toalla, se la ató a la cintura.", "words": [[0, 31003], [3, 31163], [11, 31703], [14, 31803], [17, 31923], [23, 32263], [25, 32523], [28, 32683], [34, 32983], [37, 33163], [43, 33643], [45, 33843], [53, 34303], [57, 34463], [65, 35463], [68, 35563], [71, 35770], [75, 35976], [77, 36183], [80, 36263]]}, {"verse": 5, "start": 37355, "end": 47497, "text": "Luego puso agua en una palangana, y comenzó a lavar los pies de los discípulos, y a limpiarlos con la toalla que llevaba atada a la cintura.", "words": [[0, 37355], [6, 37639], [11, 38359], [16, 38739], [19, 39019], [23, 39199], [34, 39959], [36, 40639], [44, 41179], [46, 41299], [52, 41639], [56, 41779], [61, 42139], [64, 42359], [68, 42499], [80, 43219], [82, 43439], [84, 43539], [95, 44319], [99, 44579], [102, 44759], [109, 45179], [113, 45379], [121, 45799], [127, 46399], [129, 46619], [132, 46719]]}, {"verse": 6, "start": 47847, "end": 53641, "text": "Entonces vino a Simón Pedro; y Pedro le dice: ¿Señor, tú me lavas los pies?", "words": [[0, 47847], [9, 48411], [14, 49111], [16, 49351], [22, 49751], [29, 50656], [31, 50802], [37, 51122], [40, 51342], [46, 52114], [54, 52522], [57, 52582], [60, 52702], [66, 52982], [70, 53122]]}, {"verse": 7, "start": 53921, "end": 60376, "text": "Respondió Jesús, y le dijo: Lo que yo hago, tú no entiendes ahora; pero lo entenderás después.", "words": [[0, 53921], [10, 54522], [17, 54802], [19, 55062], [22, 55182], [28, 55642], [31, 56082], [35, 56242], [38, 56462], [44, 56822], [47, 56977], [50, 57177], [60, 57797], [67, 58702], [72, 58843], [75, 59023], [86, 59703]]}, {"verse": 8, "start": 60726, "end": 68439, "text": "Le dice Pedro: No me lavarás los pies jamás. Le respondió Jesús: Si no te lavo, no tendrás parte conmigo.", "words": [[0, 60726], [3, 60850], [8, 61090], [15, 61869], [18, 62028], [21, 62168], [29, 62648], [33, 62788], [38, 63048], [45, 63966], [48, 64095], [58, 64675], [65, 65552], [68, 65696], [71, 65836], [74, 65976], [80, 66616], [83, 66856], [91, 67256], [97, 67596]]}, {"verse": 9, "start": 68789, "end": 73585, "text": "Le dice Simón Pedro: Señor, no sólo mis pies, sino también las manos y la cabeza.", "words": [[0, 68789], [3, 68931], [8, 69171], [14, 69591], [21, 70330], [28, 70745], [31, 70825], [36, 71045], [40, 71225], [46, 71765], [51, 71905], [59, 72285], [63, 72465], [69, 72765], [71, 72945], [74, 73045]]}, {"verse": 10, "start": 73865, "end": 83646, "text": "Le dice Jesús: El que se ha bañado, no necesita sino que lave los pies, pero está todo limpio: y vosotros limpios estáis, aunque no todos.", "words": [[0, 73865], [3, 74067], [8, 74307], [15, 75355], [18, 75482], [22, 75622], [25, 75762], [28, 75902], [36, 76422], [39, 76602], [48, 77162], [53, 77462], [57, 77682], [62, 78002], [66, 78122], [72, 79022], [77, 79202], [82, 79382], [87, 79622], [95, 80600], [97, 80707], [106, 81147], [114, 81707], [122, 82547], [129, 82747], [132, 82987]]}, {"verse": 11, "start": 83996, "end": 89475, "text": "Porque sabía quién le había de entregar; por eso dijo: No estáis limpios todos.", "words": [[0, 83996], [7, 84458], [13, 84918], [19, 85178], [22, 85438], [28, 85658], [31, 85818], [41, 86712], [45, 86834], [49, 87034], [55, 87834], [58, 87940], [65, 88320], [73, 88800]]}, {"verse": 12, "start": 89825, "end": 98875, "text": "Así que, después que les hubo lavado los pies, y tomado su ropa, volviéndose a sentar a la mesa, les dijo: ¿Sabéis lo que os he hecho?", "words": [[0, 89825], [4, 90070], [9, 90270], [17, 90670], [21, 90890], [25, 91070], [30, 91530], [37, 91950], [41, 92090], [47, 92370], [49, 92650], [56, 93050], [59, 93250], [65, 93930], [77, 94810], [79, 94990], [86, 95470], [88, 95530], [91, 95650], [97, 96010], [101, 96090], [107, 97094], [115, 97558], [118, 97878], [122, 98058], [125, 98218], [128, 98358]]}, {"verse": 13, "start": 99225, "end": 105200, "text": "Vosotros me llamáis, Maestro, y, Señor: y decís bien; porque lo soy.", "words": [[0, 99225], [9, 99750], [12, 99970], [21, 100450], [30, 101190], [33, 101830], [40, 102791], [42, 102918], [48, 103398], [54, 104367], [61, 104521], [64, 104674]]}, {"verse": 14, "start": 105550, "end": 113877, "text": "Pues si yo, el Señor y el Maestro, he lavado vuestros pies, vosotros también debéis lavar los pies los unos a los otros.", "words": [[0, 105550], [5, 105694], [8, 105874], [12, 106474], [15, 106494], [21, 106914], [23, 107234], [26, 107414], [35, 108454], [38, 108754], [45, 109174], [54, 109594], [60, 110434], [69, 110854], [77, 111114], [84, 111594], [90, 111954], [94, 112094], [99, 112354], [103, 112634], [108, 112914], [110, 113134], [114, 113294]]}, {"verse": 15, "start": 114227, "end": 119943, "text": "Porque ejemplo os he dado, para que como yo os he hecho, vosotros también hagáis.", "words": [[0, 114227], [7, 114470], [15, 114930], [18, 115210], [21, 115310], [27, 115550], [32, 115850], [36, 116050], [41, 116370], [44, 116690], [47, 116930], [50, 117170], [57, 118130], [66, 118650], [74, 118990]]}, {"verse": 16, "start": 120293, "end": 128493, "text": "De cierto, de cierto os digo: El siervo no es mayor que su señor, ni el apóstol es mayor que el que le envió.", "words": [[0, 120553], [3, 120845], [11, 121137], [14, 121429], [21, 121721], [24, 121961], [30, 122640], [33, 122797], [40, 123417], [43, 123652], [46, 123892], [52, 124312], [56, 124492], [59, 124672], [66, 125512], [69, 125652], [72, 125852], [80, 126592], [83, 126852], [89, 127252], [93, 127532], [96, 127672], [100, 127812], [103, 127952]]}, {"verse": 17, "start": 128843, "end": 133237, "text": "Si sabéis estas cosas, bienaventurados seréis, si las hacéis.", "words": [[0, 128843], [3, 128967], [10, 129387], [16, 129587], [23, 130487], [39, 131327], [47, 131907], [50, 132387], [54, 132567]]}, {"verse": 18, "start": 133587, "end": 144308, "text": "No hablo de todos vosotros: yo sé los que he elegido: pero para que se cumpla la Escritura: El que come pan conmigo, levantó contra mí su talón.", "words": [[0, 133587], [3, 133827], [9, 134247], [12, 134407], [18, 134707], [28, 135857], [31, 136104], [34, 136314], [38, 136524], [42, 136724], [45, 136904], [54, 137848], [59, 137995], [64, 138235], [68, 138415], [71, 138575], [78, 139255], [81, 139415], [92, 140571], [95, 140698], [99, 140818], [104, 141058], [108, 141358], [117, 142098], [125, 142958], [132, 143198], [135, 143478], [138, 143618]]}, {"verse": 19, "start": 144658, "end": 150864, "text": "Desde ahora os lo digo antes que se haga, para que cuando se haga, creáis que yo soy.", "words": [[0, 144658], [6, 144883], [12, 145223], [15, 145443], [18, 145603], [23, 145883], [29, 146383], [33, 146623], [36, 146823], [42, 147523], [47, 147923], [51, 148083], [58, 148343], [61, 148683], [67, 149463], [74, 149983], [78, 150163], [81, 150343]]}, {"verse": 20, "start": 151214, "end": 160711, "text": "De cierto, de cierto os digo: El que recibe al que yo envío, a mí recibe; y quien me recibe a mí, recibe al que me envió.", "words": [[0, 151474], [3, 151766], [11, 152058], [14, 152350], [21, 152642], [24, 152882], [30, 153561], [33, 153747], [37, 153867], [44, 154487], [47, 154627], [51, 154767], [54, 154987], [61, 155507], [63, 155707], [66, 155967], [74, 157568], [76, 157693], [82, 157953], [85, 158233], [92, 158733], [94, 158813], [98, 159333], [105, 159813], [108, 159913], [112, 160053], [115, 160193]]}, {"verse": 21, "start": 161061, "end": 170246, "text": "Cuando hubo dicho Jesús esto, fue conmovido en el espíritu, y declaró, y dijo: De cierto, de cierto os digo, que uno de vosotros me ha de entregar.", "words": [[0, 161061], [7, 161247], [12, 161627], [18, 161847], [24, 162187], [30, 162867], [34, 162887], [44, 163727], [47, 163847], [50, 163967], [60, 164587], [62, 164727], [71, 165307], [73, 165447], [79, 166377], [82, 166637], [90, 166897], [93, 167157], [100, 167417], [103, 167617], [109, 167937], [113, 168162], [117, 168362], [120, 168542], [129, 169022], [132, 169282], [135, 169402], [138, 169522]]}, {"verse": 22, "start": 170596, "end": 175752, "text": "Entonces los discípulos se miraban los unos a los otros, sin saber de quién hablaba.", "words": [[0, 170596], [9, 171136], [13, 171456], [24, 172116], [27, 172336], [35, 172696], [39, 172876], [44, 173116], [46, 173296], [50, 173456], [57, 174056], [61, 174316], [67, 174676], [70, 174856], [76, 175036]]}, {"verse": 23, "start": 176102, "end": 182378, "text": "Y uno de sus discípulos, al cual Jesús amaba, estaba recostado junto al pecho de Jesús.", "words": [[0, 176102], [2, 176263], [6, 176423], [9, 176563], [13, 176723], [25, 177643], [28, 177923], [33, 178103], [39, 178443], [46, 179563], [53, 179843], [63, 180643], [69, 180863], [72, 181163], [78, 181563], [81, 181703]]}, {"verse": 24, "start": 182728, "end": 189921, "text": "A este, pues, hizo señas Simón Pedro, para que preguntase quién era aquel de quien decía.", "words": [[0, 182728], [2, 182869], [8, 183209], [14, 183669], [19, 184449], [25, 185009], [31, 185369], [38, 186349], [43, 186409], [47, 186549], [58, 187209], [64, 187769], [68, 188249], [74, 188789], [77, 188929], [83, 189129]]}, {"verse": 25, "start": 190271, "end": 195906, "text": "Él entonces recostándose sobre el pecho de Jesús, le dice: Señor, ¿quién es?", "words": [[0, 190271], [3, 190458], [12, 191191], [25, 192123], [31, 192483], [34, 192783], [40, 193163], [43, 193283], [50, 194163], [53, 194243], [59, 194977], [66, 195401], [73, 195581]]}, {"verse": 26, "start": 196186, "end": 204263, "text": "Respondió Jesús: Aquel es, a quien yo dé el pan mojado. Y mojando el pan, lo dio a Judas Iscariote, hijo de Simón.", "words": [[0, 196441], [10, 196721], [17, 197569], [23, 197917], [27, 198197], [29, 198402], [35, 198602], [38, 198769], [41, 198935], [44, 199102], [48, 199442], [56, 200314], [58, 200440], [66, 200900], [69, 201080], [74, 201340], [77, 201580], [81, 201820], [83, 202020], [89, 202180], [100, 203260], [105, 203460], [108, 203660]]}, {"verse": 27, "start": 204613, "end": 212388, "text": "Y tras el bocado Satanás entró en él. Entonces Jesús le dice: Lo que haces, hazlo más pronto.", "words": [[0, 204613], [2, 204844], [7, 205024], [10, 205264], [17, 205684], [25, 206404], [31, 207024], [34, 207244], [38, 207822], [47, 208343], [53, 208923], [56, 209303], [62, 210123], [65, 210249], [69, 210389], [76, 211060], [82, 211520], [86, 211740]]}, {"verse": 28, "start": 212738, "end": 217744, "text": "Pero ninguno de los que estaban a la mesa entendió a qué propósito le dijo esto.", "words": [[0, 212738], [5, 212929], [13, 213869], [16, 213989], [20, 214129], [24, 214269], [32, 214529], [34, 214729], [37, 214829], [42, 215069], [51, 215669], [53, 215869], [57, 216029], [67, 216829], [70, 216969], [75, 217249]]}, {"verse": 29, "start": 218094, "end": 228525, "text": "Porque los unos pensaban, porque Judas tenía la bolsa, que Jesús le decía: Compra lo que necesitamos para la fiesta: o, que diese algo a los pobres.", "words": [[0, 218094], [7, 218318], [11, 218518], [16, 218718], [26, 219898], [33, 220238], [39, 220618], [45, 221018], [48, 221198], [55, 221718], [59, 221893], [65, 222253], [68, 222633], [75, 223537], [82, 224022], [85, 224262], [89, 224402], [101, 225222], [106, 225502], [109, 225682], [117, 226573], [120, 226753], [124, 226943], [130, 227133], [135, 227553], [137, 227693], [141, 227773]]}, {"verse": 30, "start": 228875, "end": 233528, "text": "Como él pues hubo tomado el bocado, salió de inmediato: y era ya noche.", "words": [[0, 228875], [5, 229057], [8, 229417], [13, 229617], [18, 229857], [25, 230257], [28, 230337], [36, 230857], [42, 231197], [45, 231337], [56, 232398], [58, 232564], [62, 232744], [65, 232924]]}, {"verse": 31, "start": 233878, "end": 241714, "text": "Entonces como él salió, dijo Jesús: Ahora es glorificado el Hijo del hombre, y Dios es glorificado en él.", "words": [[0, 233878], [9, 234563], [14, 234703], [17, 234883], [24, 235583], [29, 235743], [36, 236720], [42, 237065], [45, 237305], [57, 238145], [60, 238265], [65, 238485], [69, 238705], [77, 239445], [79, 239605], [84, 239925], [87, 240365], [99, 241285], [102, 241425]]}, {"verse": 32, "start": 242064, "end": 249827, "text": "Si Dios es glorificado en él, Dios también le glorificará en sí mismo, y de inmediato le glorificará.", "words": [[0, 242064], [3, 242226], [8, 242486], [11, 242726], [23, 243526], [26, 243706], [30, 244386], [35, 244706], [43, 245186], [46, 245466], [58, 246246], [61, 246406], [64, 246546], [71, 246986], [73, 247646], [76, 247786], [86, 248586], [89, 248786]]}, {"verse": 33, "start": 250177, "end": 261002, "text": "Hijitos, aun un poco estoy con vosotros. Me buscaréis; pero, como dije a los judíos: Donde yo voy, vosotros no podéis venir; así digo a vosotros ahora.", "words": [[0, 250177], [9, 250693], [13, 250993], [16, 251233], [21, 251613], [27, 251953], [31, 252273], [41, 253217], [44, 253313], [55, 254423], [61, 254933], [66, 255073], [71, 255353], [73, 255513], [77, 255593], [85, 256531], [91, 256773], [94, 257073], [99, 257253], [108, 257965], [111, 258088], [118, 258468], [125, 259190], [129, 259510], [134, 259910], [136, 260050], [145, 260470]]}, {"verse": 34, "start": 261352, "end": 269825, "text": "Un mandamiento nuevo os doy: Que os améis unos a otros: como os he amado, que también os améis los unos a los otros.", "words": [[0, 261352], [3, 261536], [15, 262216], [21, 262616], [24, 262956], [29, 263674], [33, 263776], [36, 263896], [42, 264316], [47, 264601], [49, 265001], [56, 265857], [61, 266081], [64, 266301], [67, 266581], [74, 267021], [78, 267181], [86, 267461], [89, 267721], [95, 268041], [99, 268221], [104, 268581], [106, 268921], [110, 269101]]}, {"verse": 35, "start": 270175, "end": 276162, "text": "En esto conocerán todos que sois mis discípulos, si tenéis amor los unos con los otros.", "words": [[0, 270175], [3, 270395], [8, 270615], [18, 271295], [24, 271575], [28, 271855], [33, 272175], [37, 272375], [49, 273575], [52, 273835], [59, 274255], [64, 274575], [68, 274855], [73, 275115], [77, 275355], [81, 275555]]}, {"verse": 36, "start": 276512, "end": 285824, "text": "Le dice Simón Pedro: Señor, ¿adónde vas? Le respondió Jesús: Donde yo voy, no me puedes ahora seguir; pero me seguirás después.", "words": [[0, 276512], [3, 276653], [8, 276893], [14, 277313], [21, 278052], [28, 278675], [36, 278935], [41, 279723], [44, 279851], [54, 280431], [61, 281309], [67, 281511], [70, 281751], [75, 282331], [78, 282671], [81, 282811], [88, 283131], [94, 283511], [102, 284340], [107, 284482], [110, 284642], [119, 285102]]}, {"verse": 37, "start": 286174, "end": 290947, "text": "Le dice Pedro: Señor, ¿por qué no te puedo seguir ahora? daré mi vida por ti.", "words": [[0, 286174], [3, 286299], [8, 286539], [15, 287318], [22, 288053], [27, 288173], [31, 288293], [34, 288413], [37, 288533], [43, 288733], [50, 289033], [57, 289829], [62, 290107], [65, 290187], [70, 290407], [74, 290587]]}, {"verse": 38, "start": 291227, "end": 300648, "text": "Le respondió Jesús: ¿Darás tu vida por mí? De cierto, de cierto te digo: No cantará el gallo, sin que me hayas negado tres veces.", "words": [[0, 291227], [3, 291356], [13, 291936], [20, 292813], [27, 293238], [30, 293358], [35, 293638], [39, 293898], [43, 294733], [46, 295005], [54, 295277], [57, 295549], [64, 295821], [67, 296041], [73, 296758], [76, 297077], [84, 297431], [87, 297784], [94, 298244], [98, 298604], [102, 298804], [105, 298984], [111, 299244], [118, 299704], [123, 299924]]}]}