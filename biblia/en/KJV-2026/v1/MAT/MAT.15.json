{"book": "MAT", "chapter": 15, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 255136, "verses": [{"verse": 1, "start": 300, "end": 5167, "text": "Then came to Jesus scribes and Pharisees, which were of Jerusalem, saying,", "words": [[0, 300], [5, 486], [10, 786], [13, 986], [19, 1586], [27, 1926], [31, 2046], [42, 3206], [48, 3486], [53, 3726], [56, 3866], [67, 4646]]}, {"verse": 2, "start": 5367, "end": 11093, "text": "Why do your disciples transgress the tradition of the elders? for they wash not their hands when they eat bread.", "words": [[0, 5367], [4, 5611], [7, 5811], [12, 5971], [22, 6451], [33, 7091], [37, 7311], [47, 7791], [50, 7991], [54, 8131], [62, 8835], [66, 8905], [71, 9065], [76, 9365], [80, 9585], [86, 9825], [92, 10145], [97, 10345], [102, 10505], [106, 10685]]}, {"verse": 3, "start": 11373, "end": 17148, "text": "But he answered and said to them, Why do you also transgress the commandment of God by your tradition?", "words": [[0, 11373], [4, 11558], [7, 11738], [16, 12198], [20, 12518], [25, 12798], [28, 12998], [34, 13564], [38, 13730], [41, 13870], [45, 14010], [50, 14270], [61, 14890], [65, 15090], [77, 15610], [80, 15790], [84, 16090], [87, 16390], [92, 16530]]}, {"verse": 4, "start": 17498, "end": 23818, "text": "For God commanded, saying, Honour your father and mother: and, He that curses father or mother, let him die the death.", "words": [[0, 17498], [4, 17602], [8, 17802], [19, 18162], [27, 18642], [34, 19122], [39, 19342], [46, 19622], [50, 19902], [58, 21005], [63, 21005], [66, 21151], [71, 21351], [78, 21731], [85, 22071], [88, 22271], [96, 22771], [100, 22931], [104, 23071], [108, 23331], [112, 23471]]}, {"verse": 5, "start": 24168, "end": 30066, "text": "But you say, Whoever shall say to his father or his mother, It is a gift, by whatever you might be profited by me;", "words": [[0, 24168], [4, 24267], [8, 24427], [13, 24687], [21, 24947], [27, 25227], [31, 25447], [34, 25567], [38, 25707], [45, 26027], [48, 26267], [52, 26427], [60, 27147], [63, 27287], [66, 27427], [68, 27527], [74, 27827], [77, 28307], [86, 28547], [90, 28767], [96, 28907], [99, 29067], [108, 29487], [111, 29707]]}, {"verse": 6, "start": 30416, "end": 38005, "text": "And honour not his father or his mother, he shall be free. Thus have you made the commandment of God of none effect by your tradition.", "words": [[0, 30416], [4, 30632], [11, 30882], [15, 31122], [19, 31362], [26, 31702], [29, 31982], [33, 32202], [41, 32862], [44, 32942], [50, 33162], [53, 33322], [59, 33997], [64, 34222], [69, 34482], [73, 34602], [78, 34782], [82, 34922], [94, 35502], [97, 35662], [101, 35962], [104, 36122], [109, 36602], [116, 36862], [119, 37162], [124, 37302]]}, {"verse": 7, "start": 38355, "end": 41781, "text": "You hypocrites, well did Esaias prophesy of you, saying,", "words": [[0, 38355], [4, 38512], [16, 39152], [21, 39352], [25, 39772], [32, 40192], [41, 40612], [44, 40912], [49, 41232]]}, {"verse": 8, "start": 42131, "end": 47236, "text": "This people draws near to me with their mouth, and honours me with their lips; but their heart is far from me.", "words": [[0, 42131], [5, 42268], [12, 42568], [18, 42888], [23, 43148], [26, 43328], [29, 43468], [34, 43648], [40, 43788], [47, 44108], [51, 44448], [59, 44788], [62, 45028], [67, 45188], [73, 45328], [79, 46080], [83, 46177], [89, 46317], [95, 46557], [98, 46697], [102, 46977], [107, 47197]]}, {"verse": 9, "start": 47586, "end": 52489, "text": "But in vain they do worship me, teaching for doctrines the commandments of men.", "words": [[0, 47586], [4, 47690], [7, 47870], [12, 48150], [17, 48470], [20, 48730], [28, 49090], [32, 49850], [41, 50230], [45, 50530], [55, 51150], [59, 51290], [72, 51730], [75, 52070]]}, {"verse": 10, "start": 52769, "end": 57002, "text": "¶ And he called the multitude, and said to them, Hear, and understand:", "words": [[2, 52769], [6, 52892], [9, 52992], [16, 53272], [20, 53452], [31, 53932], [35, 54572], [40, 54812], [43, 54992], [49, 55487], [55, 55767], [59, 56067]]}, {"verse": 11, "start": 57352, "end": 63529, "text": "Not that which goes into the mouth defiles a man; but that which comes out of the mouth, this defiles a man.", "words": [[0, 57352], [4, 57511], [9, 57731], [15, 57931], [20, 58151], [25, 58411], [29, 58551], [35, 58871], [43, 59431], [45, 59571], [50, 60244], [54, 60344], [59, 60524], [65, 60724], [71, 61024], [75, 61364], [78, 61504], [82, 61604], [89, 62104], [94, 62424], [102, 62984], [104, 63104]]}, {"verse": 12, "start": 63809, "end": 70221, "text": "Then came his disciples, and said to him, Do you know that the Pharisees were offended, after they heard this saying?", "words": [[0, 63809], [5, 64092], [10, 64392], [14, 64652], [25, 65872], [29, 65992], [34, 66252], [37, 66452], [42, 67084], [45, 67162], [49, 67302], [54, 67442], [59, 67602], [63, 67702], [73, 68282], [78, 68402], [88, 68802], [94, 69122], [99, 69322], [105, 69542], [110, 69762]]}, {"verse": 13, "start": 70501, "end": 75947, "text": "But he answered and said, Every plant, which my heavenly Father has not planted, shall be rooted up.", "words": [[0, 70501], [4, 70629], [7, 70769], [16, 71189], [20, 71389], [26, 72031], [32, 72250], [39, 72590], [45, 72850], [48, 73030], [57, 73330], [64, 73690], [68, 73930], [72, 74110], [81, 74530], [87, 75050], [90, 75250], [97, 75490]]}, {"verse": 14, "start": 76297, "end": 83624, "text": "Let them alone: they are blind leaders of the blind. And if the blind lead the blind, both shall fall into the ditch.", "words": [[0, 76297], [4, 76419], [9, 76579], [16, 77358], [21, 77678], [25, 77778], [31, 78078], [39, 78578], [42, 78958], [46, 79078], [53, 79738], [57, 79902], [60, 80022], [64, 80142], [70, 80522], [75, 80862], [79, 81022], [86, 81742], [91, 82082], [97, 82422], [102, 82682], [107, 82942], [111, 83122]]}, {"verse": 15, "start": 83904, "end": 87245, "text": "Then answered Peter and said to him, Declare to us this parable.", "words": [[0, 83904], [5, 84076], [14, 84436], [20, 84716], [24, 84936], [29, 85096], [32, 85276], [37, 85935], [45, 86125], [48, 86405], [51, 86545], [56, 86725]]}, {"verse": 16, "start": 87525, "end": 90895, "text": "And Jesus said, Are you also yet without understanding?", "words": [[0, 87525], [4, 87647], [10, 87967], [16, 88844], [20, 88950], [24, 89070], [29, 89390], [33, 89670], [41, 89970]]}, {"verse": 17, "start": 91245, "end": 97458, "text": "Do not you yet understand, that whatever enters in at the mouth goes into the belly, and is cast out into the draught?", "words": [[0, 91245], [3, 91341], [7, 91501], [11, 91701], [15, 91921], [27, 92481], [32, 93041], [41, 93281], [48, 93681], [51, 93941], [54, 94061], [58, 94161], [64, 94421], [69, 94701], [74, 94981], [78, 95121], [85, 95401], [89, 95841], [92, 95961], [97, 96241], [101, 96541], [106, 96741], [110, 97126]]}, {"verse": 18, "start": 97808, "end": 102454, "text": "But those things which proceed out of the mouth come forth from the heart; and they defile the man.", "words": [[0, 97808], [4, 97893], [10, 98093], [17, 98473], [23, 98673], [31, 99113], [35, 99433], [38, 99553], [42, 99653], [48, 99933], [53, 100233], [59, 100513], [64, 100733], [68, 100853], [75, 101466], [79, 101584], [84, 101704], [91, 102144], [95, 102284]]}, {"verse": 19, "start": 102804, "end": 109415, "text": "For out of the heart proceed evil thoughts, murders, adulteries, fornications, thefts, false witness, blasphemies:", "words": [[0, 102804], [4, 102905], [8, 103025], [11, 103125], [15, 103205], [21, 103365], [29, 103745], [34, 104065], [44, 104805], [53, 105325], [65, 106105], [79, 107105], [87, 107705], [93, 107925], [102, 108605]]}, {"verse": 20, "start": 109765, "end": 115414, "text": "These are the things which defile a man: but to eat with unwashed hands defiles not a man.", "words": [[0, 109765], [6, 109951], [10, 110171], [14, 110271], [21, 110571], [27, 110811], [34, 111351], [36, 111471], [41, 112198], [45, 112294], [48, 112434], [52, 112614