{"book": "ACT", "chapter": 24, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 216011, "verses": [{"verse": 1, "start": 300, "end": 11943, "text": "Y cinco días después descendió el sumo sacerdote Ananías, con algunos de los ancianos, y un cierto Tértulo, orador; y comparecieron delante del gobernador contra Pablo.", "words": [[0, 300], [2, 427], [8, 747], [13, 1167], [21, 1567], [31, 2327], [34, 2567], [39, 3067], [49, 3787], [58, 4707], [62, 4867], [70, 5267], [73, 5407], [77, 5527], [87, 6167], [89, 6507], [92, 6667], [99, 7197], [108, 7727], [116, 8668], [118, 8768], [132, 9588], [140, 10108], [144, 10328], [155, 10968], [162, 11308]]}, {"verse": 2, "start": 12293, "end": 22978, "text": "Y citado que fue, Tértulo comenzó a acusar, diciendo: Como por causa tuya vivamos en grande paz, y muchas cosas sean bien gobernadas en el pueblo por tu prudencia,", "words": [[0, 12293], [2, 12457], [9, 12897], [13, 13077], [18, 13837], [26, 14317], [34, 15017], [36, 15157], [44, 16017], [54, 17043], [59, 17218], [63, 17418], [69, 17598], [74, 18098], [82, 18498], [85, 18718], [92, 18918], [97, 19298], [99, 19523], [106, 19763], [112, 20163], [117, 20483], [122, 20683], [133, 21283], [136, 21463], [139, 21563], [146, 21803], [150, 22083], [153, 22223]]}, {"verse": 3, "start": 23328, "end": 28629, "text": "Siempre y en todo lugar lo recibimos con todo agradecimiento, oh excelentísimo Félix.", "words": [[0, 23328], [8, 23750], [10, 23850], [13, 23990], [18, 24110], [24, 24470], [27, 24630], [37, 25210], [41, 25450], [46, 25690], [62, 26410], [65, 27130], [79, 27950]]}, {"verse": 4, "start": 28979, "end": 34028, "text": "Pero por no molestarte más largamente, te ruego que nos oigas brevemente conforme a tu equidad.", "words": [[0, 28979], [5, 29138], [9, 29358], [12, 29498], [23, 30078], [27, 30298], [39, 30978], [42, 31193], [48, 31473], [52, 31633], [56, 31793], [62, 32233], [73, 32813], [82, 33373], [84, 33413], [87, 33513]]}, {"verse": 5, "start": 34378, "end": 43592, "text": "Porque hemos hallado que este hombre es pestilencial, y levantador de sediciones entre todos los judíos por todo el mundo, y cabecilla de la secta de los nazarenos:", "words": [[0, 34378], [7, 34625], [13, 34845], [21, 35345], [25, 35525], [30, 35765], [37, 36065], [40, 36305], [54, 37085], [56, 37280], [67, 37860], [70, 38020], [81, 38600], [87, 38980], [93, 39280], [97, 39520], [104, 40000], [108, 40180], [113, 40380], [116, 40560], [123, 40880], [125, 41340], [135, 41940], [138, 42060], [141, 42180], [147, 42580], [150, 42660], [154, 42780]]}, {"verse": 6, "start": 43942, "end": 50007, "text": "El cual también intentó profanar el templo; y prendiéndole, le quisimos juzgar conforme a nuestra ley:", "words": [[0, 43942], [3, 44084], [8, 44264], [16, 44604], [24, 45244], [33, 45724], [36, 45824], [44, 46576], [46, 46677], [60, 47637], [63, 47757], [72, 48197], [79, 48697], [88, 49277], [90, 49337], [98, 49477]]}, {"verse": 7, "start": 50357, "end": 55305, "text": "Pero interviniendo el comandante Lisias, con grande violencia le quitó de nuestras manos,", "words": [[0, 50357], [5, 50494], [19, 51294], [22, 51374], [33, 51924], [41, 52474], [45, 52734], [52, 53054], [62, 53694], [65, 53914], [71, 54254], [74, 54314], [83, 54494]]}, {"verse": 8, "start": 55655, "end": 63124, "text": "Mandando a sus acusadores que viniesen a ti; del cual tú mismo juzgando, podrás entender todas estas cosas de que le acusamos.", "words": [[0, 55655], [9, 56117], [11, 56197], [15, 56317], [26, 56897], [30, 57157], [39, 57577], [41, 57777], [45, 58298], [49, 58417], [54, 58637], [57, 58857], [63, 59217], [73, 60017], [80, 60477], [89, 60837], [95, 61157], [101, 61517], [107, 61897], [110, 62137], [114, 62237], [117, 62357]]}, {"verse": 9, "start": 63404, "end": 67892, "text": "Y contendían también los judíos, diciendo ser así estas cosas.", "words": [[0, 63404], [2, 63529], [13, 64249], [21, 64649], [25, 64909], [33, 65909], [42, 66229], [46, 66589], [50, 66869], [56, 67109]]}, {"verse": 10, "start": 68242, "end": 79644, "text": "Entonces Pablo, haciéndole el gobernador señal que hablase, respondió: Porque sé que desde hace muchos años eres gobernador de esta nación, con buen ánimo presentaré mi defensa.", "words": [[0, 68242], [9, 69022], [16, 69605], [27, 70225], [30, 70365], [41, 71005], [47, 71525], [51, 71645], [60, 72445], [71, 73446], [78, 73646], [81, 73886], [85, 74046], [91, 74246], [96, 74606], [103, 74866], [108, 75306], [113, 75706], [124, 76326], [127, 76506], [132, 76686], [140, 77666], [144, 77786], [149, 77966], [155, 78306], [166, 78906], [169, 79026]]}, {"verse": 11, "start": 79994, "end": 84521, "text": "Porque tú puedes entender que no hace más de doce días que subí a adorar a Jerusalén;", "words": [[0, 79994], [7, 80174], [10, 80314], [17, 80594], [26, 81054], [30, 81294], [33, 81474], [38, 81674], [42, 81894], [45, 82124], [50, 82354], [55, 82734], [59, 83074], [64, 83414], [66, 83534], [73, 83714], [75, 83854]]}, {"verse": 12, "start": 84871, "end": 91091, "text": "Y ni me hallaron en el templo disputando con ninguno, ni reuniendo multitudes, ni en sinagogas, ni en la ciudad;", "words": [[0, 84871], [2, 84958], [5, 85058], [8, 85178], [17, 85498], [20, 85618], [23, 85758], [30, 86118], [41, 86678], [45, 86858], [54, 87718], [57, 87858], [67, 88318], [79, 89338], [82, 89418], [85, 89518], [96, 90338], [99, 90418], [102, 90498], [105, 90598]]}, {"verse": 13, "start": 91441, "end": 94001, "text": "Ni te pueden probar las cosas de que ahora me acusan.", "words": [[0, 91441], [3, 91560], [6, 91660], [13, 91900], [20, 92300], [24, 92420], [30, 92720], [33, 92960], [37, 93060], [43, 93260], [46, 93420]]}, {"verse": 14, "start": 94351, "end": 104608, "text": "Pero esto te confieso, que conforme a aquel Camino que llaman herejía, así sirvo al Dios de mis padres, creyendo todas las cosas que en la ley y en los profetas están escritas;", "words": [[0, 94351], [5, 94491], [10, 94751], [13, 94931], [23, 95771], [27, 95871], [36, 96411], [38, 96511], [44, 96711], [51, 97011], [55, 97231], [62, 97901], [71, 98571], [75, 98751], [81, 99151], [84, 99291], [89, 99451], [92, 99651], [96, 99771], [104, 100598], [113, 101019], [119, 101239], [123, 101519], [129, 101819], [133, 102119], [136, 102259], [139, 102359], [143, 102639], [145, 102879], [148, 102979], [152, 103079], [161, 103599], [167, 103879]]}, {"verse": 15, "start": 104958, "end": 112005, "text": "Teniendo esperanza en Dios que ha de haber resurrección de los muertos, así de justos como de injustos, la cual también ellos esperan.", "words": [[0, 104958], [9, 105317], [19, 105917], [22, 106057], [27, 106277], [31, 106577], [34, 106697], [37, 106777], [43, 106937], [56, 107637], [59, 107757], [63, 107857], [72, 108557], [76, 108737], [79, 108917], [86, 109357], [91, 109537], [94, 109677], [104, 110457], [107, 110537], [112, 110717], [120, 111017], [126, 111357]]}, {"verse": 16, "start": 112355, "end": 118594, "text": "Y por esto, procuro yo tener siempre conciencia sin remordimiento acerca de Dios y acerca de los hombres.", "words": [[0, 112355], [2, 112455], [6, 112615], [12, 112815], [20, 113355], [23, 113515], [29, 113775], [37, 114215], [48, 114915], [52, 115155], [66, 115955], [73, 116275], [76, 116575], [81, 116815], [83, 117335], [90, 117675], [93, 117875], [97, 117995]]}, {"verse": 17, "start": 118944, "end": 123405, "text": "Pero pasados muchos años, vine a hacer limosnas a mi nación, y ofrendas,", "words": [[0, 118944], [5, 119065], [13, 119505], [20, 119725], [26, 120165], [31, 120705], [33, 120925], [39, 121197], [48, 121469], [50, 121741], [53, 122013], [61, 122285], [63, 122825]]}, {"verse": 18, "start": 123755, "end": 129276, "text": "Cuando me hallaron purificado en el templo (no con multitud ni con alboroto) unos judíos de Asia;", "words": [[0, 123755], [7, 123893], [10, 124123], [19, 124353], [30, 124993], [33, 125073], [36, 125213], [43, 126013], [47, 126093], [51, 126293], [60, 126773], [63, 126933], [67, 127053], [77, 128013], [82, 128173], [89, 128633], [92, 128753]]}, {"verse": 19, "start": 129626, "end": 134111, "text": "Los cuales debieron comparecer delante de ti, y acusarme, si contra mí tenían algo.", "words": [[0, 129626], [4, 129706], [11, 129986], [20, 130386], [31, 131066], [39, 131466], [42, 131606], [46, 131826], [48, 132186], [58, 132746], [61, 132946], [68, 133206], [71, 133386], [78, 133566]]}, {"verse": 20, "start": 134461, "end": 139538, "text": "O digan estos mismos si hallaron en mí alguna cosa mal hecha, cuando yo estuve en el Consejo,", "words": [[0, 134461], [2, 134586], [8, 134926], [14, 135126], [21, 135546], [24, 135786], [33, 136146], [36, 136266], [39, 136446], [46, 136766], [51, 137093], [55, 137419], [62, 137746], [69, 137991], [72, 138231], [79, 138611], [82, 138751], [85, 138851]]}, {"verse": 21, "start": 139888, "end": 147322, "text": "A no ser que, estando entre ellos prorrumpí en alta voz: Acerca de la resurrección de los muertos soy hoy juzgado de vosotros.", "words": [[0, 139888], [2, 140007], [5, 140107], [9, 140307], [14, 140847], [22, 141287], [28, 141527], [34, 141977], [44, 142427], [47, 142547], [52, 142747], [57, 143429], [64, 143853], [67, 143973], [70, 144093], [83, 144753], [86, 144873], [90, 144973], [98, 145633], [102, 145773], [106, 145933], [114, 146413], [117, 146593]]}, {"verse": 22, "start": 147602, "end": 159990, "text": "Entonces Félix, oídas estas cosas, estando bien informado de esta secta, aplazó el asunto, diciendo: Cuando descienda el comandante Lisias acabaré de conocer de vuestro asunto.", "words": [[0, 147602], [9, 148479], [16, 149222], [22, 149822], [28, 150022], [35, 150702], [43, 151102], [48, 151602], [58, 152102], [61, 152262], [66, 152442], [73, 153422], [80, 153922], [83, 154042], [91, 154782], [101, 155734], [108, 155912], [118, 156572], [121, 156672], [132, 157278], [139, 157884], [147, 158367], [150, 158487], [158, 158867], [161, 159107], [169, 159427]]}, {"verse": 23, "start": 160270, "end": 170968, "text": "Y mandó al centurión que Pablo fuese guardado, y aliviado de las prisiones; y que no prohibiese a ninguno de sus conocidos atenderlo, o venir a él.", "words": [[0, 160270], [2, 160392], [8, 160812], [11, 160952], [21, 161572], [25, 161712], [31, 162112], [37, 162492], [47, 163132], [49, 163272], [58, 163892], [61, 164052], [65, 164192], [76, 165152], [78, 165342], [82, 165482], [85, 165782], [96, 166742], [98, 167022], [106, 167642], [109, 167762], [113, 167982], [123, 168742], [134, 169642], [136, 170102], [142, 170382], [144, 170562]]}, {"verse": 24, "start": 171318, "end": 181494, "text": "Y algunos días después, viniendo Félix con Drusila, su mujer, la cual era judía, llamó a Pablo, y oyó de él la fe que es en Jesucristo.", "words": [[0, 171318], [2, 171440], [10, 171720], [15, 172020], [24, 172420], [33, 173260], [39, 173780], [43, 174350], [52, 174920], [55, 175020], [62, 175960], [65, 176060], [70, 176260], [74, 176500], [81, 177440], [87, 177920], [89, 178020], [96, 178340], [98, 178625], [102, 179065], [105, 179185], [108, 179405], [111, 179585], [114, 179805], [118, 180105], [121, 180345], [124, 180525]]}, {"verse": 25, "start": 181844, "end": 193685, "text": "Y disertando él de la justicia, y del dominio propio, y del juicio venidero, espantado Félix, respondió: Ahora vete; pero cuando tenga oportunidad te llamaré:", "words": [[0, 181844], [2, 181971], [13, 182791], [16, 183271], [19, 183331], [22, 183431], [32, 184171], [34, 184346], [38, 184506], [46, 185006], [54, 185406], [56, 186006], [60, 186146], [67, 186586], [77, 187326], [87, 188126], [94, 189226], [105, 190203], [111, 190462], [117, 191256], [122, 191399], [129, 191679], [135, 192079], [147, 192759], [150, 193099]]}, {"verse": 26, "start": 193965, "end": 205467, "text": "Esperando también con esto, que de parte de Pablo le serían dados dineros, porque le soltase; por lo cual, haciéndole venir muchas veces, hablaba con él.", "words": [[0, 193965], [10, 194663], [18, 195123], [22, 195443], [28, 196303], [32, 196343], [35, 196503], [41, 196883], [44, 197103], [50, 197503], [53, 197763], [60, 198203], [66, 198603], [75, 199443], [82, 199923], [85, 200103], [94, 201200], [98, 201324], [101, 201464], [107, 201884], [118, 202764], [124, 203064], [131, 203484], [138, 203984], [146, 204824], [150, 205044]]}, {"verse": 27, "start": 205817, "end": 215611, "text": "Pero al cabo de dos años recibió Félix por sucesor a Porcio Festo: y queriendo Félix ganar la gracia de los judíos, dejó preso a Pablo.", "words": [[0, 205817], [5, 205993], [8, 206203], [13, 206443], [16, 206663], [20, 206883], [25, 207263], [33, 207783], [39, 208203], [43, 208443], [51, 209303], [53, 209503], [60, 210043], [67, 210956], [69, 211085], [79, 211565], [85, 212025], [91, 212525], [94, 212645], [101, 213125], [104, 213225], [108, 213345], [116, 214245], [121, 214525], [127, 214945], [129, 215025]]}]}