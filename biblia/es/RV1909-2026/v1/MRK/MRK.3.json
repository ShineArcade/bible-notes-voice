{"book": "MRK", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 259077, "verses": [{"verse": 1, "start": 300, "end": 6158, "text": "Y otra vez entró en la sinagoga; y había allí un hombre que tenía una mano atrofiada.", "words": [[0, 300], [2, 463], [7, 623], [11, 943], [17, 1403], [20, 1523], [23, 1623], [33, 2812], [35, 2938], [41, 3238], [46, 3538], [49, 3758], [56, 4098], [60, 4298], [66, 4618], [70, 4878], [75, 5138]]}, {"verse": 2, "start": 6608, "end": 12333, "text": "Y lo observaban atentamente para ver si lo sanaría en sábado, para acusarle.", "words": [[0, 6608], [2, 6848], [5, 6988], [16, 7908], [28, 8928], [33, 9188], [37, 9388], [40, 9588], [43, 9815], [51, 10041], [54, 10268], [62, 10988], [67, 11676]]}, {"verse": 3, "start": 12783, "end": 18177, "text": "Entonces dijo al hombre que tenía la mano atrofiada: Levántate en medio.", "words": [[0, 12783], [9, 13428], [14, 14308], [17, 14528], [24, 14788], [28, 15008], [34, 15288], [37, 15488], [42, 15708], [53, 16865], [63, 17450], [66, 17630]]}, {"verse": 4, "start": 18627, "end": 27138, "text": "Y les dice: ¿Es lícito hacer bien en sábado, o hacer mal? ¿salvar la vida, o quitarla? Pero ellos callaban.", "words": [[0, 18627], [2, 18754], [6, 18874], [12, 19770], [16, 20055], [23, 20735], [29, 20995], [34, 21255], [37, 21455], [45, 22075], [47, 22415], [53, 22655], [58, 23528], [66, 23891], [69, 24171], [75, 24491], [77, 24931], [87, 25963], [92, 26107], [98, 26644]]}, {"verse": 5, "start": 27588, "end": 40473, "text": "Y mirándolos alrededor con enojo, entristecido por la dureza de sus corazones, dice al hombre: Extiende tu mano. Y la extendió, y su mano fue restaurada sana.", "words": [[0, 27588], [2, 27729], [13, 28529], [23, 28949], [27, 29409], [34, 30329], [47, 31329], [51, 31609], [54, 31809], [61, 32309], [64, 32449], [68, 32629], [79, 33709], [84, 34069], [87, 34309], [95, 35132], [104, 35762], [107, 35962], [113, 36775], [115, 36982], [118, 37222], [128, 38122], [130, 38362], [133, 38542], [138, 38862], [142, 39122], [153, 39862]]}, {"verse": 6, "start": 40923, "end": 47862, "text": "Entonces saliendo los fariseos, tomaron consejo con los Herodianos contra él, para matarle.", "words": [[0, 40923], [9, 42009], [18, 42649], [22, 42829], [32, 43809], [40, 44249], [48, 45029], [52, 45249], [56, 45449], [67, 46249], [74, 46569], [78, 46869], [83, 47109]]}, {"verse": 7, "start": 48312, "end": 55348, "text": "Pero Jesús se apartó al mar con sus discípulos: y le siguió gran multitud de Galilea, y de Judea,", "words": [[0, 48312], [5, 48456], [11, 48836], [14, 49456], [21, 49916], [24, 50056], [28, 50276], [32, 50496], [36, 50636], [48, 51816], [50, 51937], [53, 52057], [60, 52497], [65, 52677], [74, 53337], [77, 53497], [86, 54277], [88, 54557], [91, 54677]]}, {"verse": 8, "start": 55798, "end": 68682, "text": "Y de Jerusalén, y de Idumea, y del otro lado del Jordán. Y los de alrededor de Tiro y de Sidón, grande multitud, oyendo cuán grandes cosas hacía, vinieron a él.", "words": [[0, 55798], [2, 55919], [5, 56019], [16, 56779], [18, 56979], [21, 57099], [29, 57919], [31, 58339], [35, 58519], [40, 58759], [45, 59119], [49, 59687], [57, 60488], [59, 60595], [63, 60775], [66, 60955], [76, 61375], [79, 61795], [84, 62215], [86, 62355], [89, 62515], [96, 63355], [103, 63895], [113, 65015], [120, 65395], [125, 65835], [133, 66275], [139, 66675], [146, 67595], [155, 68115], [157, 68295]]}, {"verse": 9, "start": 69132, "end": 77709, "text": "Y dijo a sus discípulos que le estuviese siempre lista una barca pequeña, por causa del gentío, para que no lo aplastaran.", "words": [[0, 69132], [2, 69257], [7, 69577], [9, 69717], [13, 69917], [24, 70717], [28, 70997], [31, 71277], [41, 71557], [49, 71917], [55, 72357], [59, 72597], [65, 72977], [74, 73457], [78, 73977], [84, 74357], [88, 74637], [96, 75277], [101, 76097], [105, 76277], [108, 76537], [111, 76697]]}, {"verse": 10, "start": 78159, "end": 85504, "text": "Porque había sanado a muchos; de manera que se lanzaban sobre él cuantos tenían dolencias, por tocarle.", "words": [[0, 78159], [7, 78322], [13, 78602], [20, 79142], [22, 79242], [30, 80280], [33, 80388], [40, 80608], [44, 80888], [47, 81048], [56, 81668], [62, 81968], [65, 82228], [73, 82488], [80, 83108], [91, 83868], [95, 84608]]}, {"verse": 11, "start": 85955, "end": 94790, "text": "Y los espíritus inmundos, al verle, se postraban delante de él, y daban voces, diciendo: Tú eres el Hijo de Dios.", "words": [[0, 85955], [2, 86059], [6, 86199], [16, 86919], [26, 87599], [29, 87979], [36, 88739], [39, 88819], [49, 89578], [57, 90078], [60, 90279], [64, 90498], [66, 90658], [72, 90979], [79, 91699], [89, 93107], [92, 93224], [97, 93464], [100, 93664], [105, 93864], [108, 94004]]}, {"verse": 12, "start": 95140, "end": 99046, "text": "Pero él les ordenaba firmemente que no le manifestasen.", "words": [[0, 95140], [5, 95286], [8, 95566], [12, 95926], [21, 96686], [32, 97446], [36, 97706], [39, 97846], [42, 97966]]}, {"verse": 13, "start": 99496, "end": 104230, "text": "Y subió al monte, y llamó a sí a los que él quiso; y vinieron a él.", "words": [[0, 99496], [2, 99605], [8, 100005], [11, 100145], [18, 100545], [20, 101055], [26, 101565], [28, 101655], [31, 101745], [33, 101835], [37, 101925], [41, 102065], [44, 102205], [51, 103056], [53, 103182], [62, 103642], [64, 103862]]}, {"verse": 14, "start": 104680, "end": 110275, "text": "Y estableció doce, para que estuviesen con él, y para enviarlos a predicar,", "words": [[0, 104680], [2, 104804], [13, 105404], [19, 106084], [24, 106584], [28, 106744], [39, 107284], [43, 107544], [47, 107824], [49, 108504], [54, 108684], [64, 109224], [66, 109464]]}, {"verse": 15, "start": 110725, "end": 115725, "text": "Y que tuviesen autoridad de sanar enfermedades, y de echar fuera demonios:", "words": [[0, 110725], [2, 110828], [6, 110948], [15, 111468], [25, 112168], [28, 112388], [34, 112808], [48, 113728], [50, 114088], [53, 114208], [59, 114528], [65, 114768]]}, {"verse": 16, "start": 116175, "end": 118970, "text": "A Simón, al cual puso por nombre Pedro;", "words": [[0, 116175], [2, 116284], [9, 117004], [12, 117124], [17, 117324], [22, 117724], [26, 117944], [33, 118224]]}, {"verse": 17, "start": 119420, "end": 129310, "text": "Y a Jacobo, hijo de Zebedeo, y a Juan hermano de Jacobo; y les dio el sobrenombre Boanerges, que es, Hijos del trueno;", "words": [[0, 119420], [2, 119562], [4, 119682], [12, 120562], [17, 120742], [20, 121362], [29, 121982], [31, 122282], [33, 122362], [38, 122562], [46, 123122], [49, 123202], [57, 124199], [59, 124301], [63, 124461], [67, 124701], [70, 124861], [82, 125981], [93, 127101], [97, 127221], [101, 127541], [107, 128221], [111, 128661]]}, {"verse": 18, "start": 129760, "end": 138870, "text": "Y a Andrés, y a Felipe, y a Bartolomé, y a Mateo, y a Tomás, y a Jacobo hijo de Alfeo, y a Tadeo, y a Simón el cananista,", "words": [[0, 129760], [2, 129924], [4, 130024], [12, 130524], [14, 130744], [16, 130784], [24, 131764], [26, 131824], [28, 131904], [39, 132944], [41, 132964], [43, 133024], [50, 133504], [52, 133684], [54, 133724], [61, 134484], [63, 134544], [65, 134604], [72, 135264], [77, 135424], [80, 135644], [87, 136164], [89, 136284], [91, 136404], [98, 137144], [100, 137204], [102, 137304], [108, 137864], [111, 137944]]}, {"verse": 19, "start": 139320, "end": 144088, "text": "Y a Judas Iscariote, el que le entregó. Y vinieron a casa.", "words": [[0, 139320], [2, 139456], [4, 139576], [10, 139796], [21, 140936], [24, 141356], [28, 141576], [31, 141736], [40, 142776], [42, 142905], [51, 143325], [53, 143485]]}, {"verse": 20, "start": 144538, "end": 149777, "text": "Y se agolpó de nuevo la gente, de modo que ellos ni siquiera podían comer.", "words": [[0, 144538], [2, 144666], [5, 144806], [12, 145386], [15, 145446], [21, 145666], [24, 145906], [31, 146766], [34, 146966], [39, 147146], [43, 147466], [49, 147746], [52, 148286], [61, 148726], [68, 149186]]}, {"verse": 21, "start": 150227, "end": 157168, "text": "Y como lo oyeron los suyos, vinieron para sujetarlo: porque decían: Está fuera de sí.", "words": [[0, 150227], [2, 150329], [7, 150569], [10, 150749], [17, 151209], [21, 151349], [28, 152409], [37, 153049], [42, 153309], [53, 154821], [60, 154971], [68, 156085], [73, 156309], [79, 156569], [82, 156789]]}, {"verse": 22, "start": 157518, "end": 166838, "text": "Y los escribas que habían venido de Jerusalén, decían que tenía a Beelzebú, y que por el príncipe de los demonios echaba fuera los demonios.", "words": [[0, 157518], [2, 157606], [6, 157746], [15, 158286], [19, 158426], [26, 158686], [33, 159146], [36, 159286], [47, 159966], [54, 160786], [58, 160966], [64, 161426], [66, 161886], [76, 162346], [78, 162946], [82, 163066], [86, 163286], [89, 163406], [98, 164086], [101, 164266], [105, 164406], [114, 165006], [121, 165466], [127, 165746], [131, 166026]]}, {"verse": 23, "start": 167288, "end": 173851, "text": "Y habiéndolos llamado, les decía en parábolas: ¿Cómo puede Satanás echar fuera a Satanás?", "words": [[0, 167288], [2, 167413], [14, 168093], [23, 168673], [27, 169253], [33, 169673], [36, 169893], [47, 171097], [53, 171329], [59, 171599], [67, 172159], [73, 172459], [79, 172899], [81, 173019]]}, {"verse": 24, "start": 174301, "end": 179938, "text": "Y si algún reino contra sí mismo está dividido, no puede permanecer el tal reino.", "words": [[0, 174301], [2, 174576], [5, 174736], [11, 175056], [17, 175576], [24, 175936], [27, 176176], [33, 176556], [38, 176776], [48, 177436], [51, 177816], [57, 178136], [68, 178936], [71, 179096], [75, 179276]]}, {"verse": 25, "start": 180388, "end": 185360, "text": "Y si una casa está dividida contra sí misma, no puede permanecer la tal casa.", "words": [[0, 180388], [2, 180468], [5, 180568], [9, 180768], [14, 181028], [19, 181288], [28, 181908], [35, 182188], [38, 182448], [45, 183248], [48, 183328], [54, 183568], [65, 184348], [68, 184528], [72, 184688]]}, {"verse": 26, "start": 185810, "end": 193243, "text": "Y si Satanás se levanta contra sí mismo, y se divide, no puede permanecer; antes tiene fin.", "words": [[0, 185810], [2, 185937], [5, 186097], [13, 186777], [16, 186877], [24, 187377], [31, 187717], [34, 187977], [41, 188477], [43, 189157], [46, 189317], [54, 190177], [57, 190537], [63, 190817], [75, 192028], [81, 192372], [87, 192712]]}, {"verse": 27, "start": 193693, "end": 202069, "text": "Nadie puede saquear los bienes del hombre fuerte entrando en su casa, si antes no ata al hombre fuerte y entonces saqueará su casa.", "words": [[0, 193693], [6, 194158], [12, 194478], [20, 195258], [24, 195438], [31, 195878], [35, 196018], [42, 196238], [49, 196618], [58, 197318], [61, 197518], [64, 197658], [70, 198378], [73, 198498], [79, 198738], [82, 199058], [86, 199418], [89, 199538], [96, 199738], [103, 200138], [105, 200338], [114, 200838], [123, 201338], [126, 201538]]}, {"verse": 28, "start": 202519, "end": 211309, "text": "De cierto os digo que todos los pecados serán perdonados a los hijos de los hombres, y las blasfemias, cualesquiera que sean;", "words": [[0, 202734], [3, 202988], [10, 203241], [13, 203721], [18, 204081], [22, 204301], [28, 204601], [32, 204861], [40, 205461], [46, 205921], [57, 206741], [59, 206981], [63, 207141], [69, 207441], [72, 207641], [76, 207761], [85, 208121], [87, 208641], [91, 208801], [103, 209641], [116, 210481], [120, 210681]]}, {"verse": 29, "start": 211759, "end": 220378, "text": "Pero cualquiera que blasfeme contra el Espíritu Santo, no tiene jamás perdón, sino que es reo de juicio eterno.", "words": [[0, 211759], [5, 211923], [16, 212523], [20, 212743], [29, 213523], [36, 213943], [39, 214143], [48, 214743], [55, 215183], [58, 215663], [64, 216143], [70, 216623], [78, 217383], [83, 217823], [87, 218003], [90, 218143], [94, 218723], [97, 218823], [104, 219423]]}, {"verse": 30, "start": 220828, "end": 224426, "text": "Porque decían: Tiene espíritu inmundo.", "words": [[0, 220828], [7, 221054], [15, 222107], [21, 222326], [30, 223376]]}, {"verse": 31, "start": 224776, "end": 231152, "text": "Vienen después sus hermanos y su madre, y estando fuera, enviaron a él llamándole.", "words": [[0, 224776], [7, 225081], [15, 225421], [19, 225721], [28, 226361], [30, 226481], [33, 226601], [40, 227781], [42, 227821], [50, 228261], [57, 229181], [66, 229901], [68, 230081], [71, 230221]]}, {"verse": 32, "start": 231602, "end": 239408, "text": "Y la gente estaba sentada alrededor de él, y le dijeron: He aquí, tu madre y tus hermanos te buscan fuera.", "words": [[0, 231602], [2, 231707], [5, 231787], [11, 232067], [18, 232427], [26, 233107], [36, 233487], [39, 234147], [43, 234407], [45, 234587], [48, 234707], [57, 235695], [60, 235859], [66, 236099], [69, 236279], [75, 236579], [77, 236739], [81, 236859], [90, 237339], [93, 237439], [100, 237819]]}, {"verse": 33, "start": 239758, "end": 244693, "text": "Y él les respondió, diciendo: ¿Quién es mi madre y mis hermanos?", "words": [[0, 239758], [2, 239945], [5, 240095], [9, 240245], [20, 241025], [30, 242424], [37, 242649], [40, 242769], [43, 242909], [49, 243309], [51, 243589], [55, 243789]]}, {"verse": 34, "start": 245143, "end": 251638, "text": "Y mirando a los que estaban sentados alrededor de él, dijo: He aquí mi madre y hermanos.", "words": [[0, 245143], [2, 245405], [10, 245865], [12, 245985], [16, 246105], [20, 246225], [28, 246585], [37, 247265], [47, 247685], [50, 248185], [54, 248325], [60, 249275], [63, 249365], [68, 249605], [71, 249825], [77, 250205], [79, 250745]]}, {"verse": 35, "start": 252088, "end": 258677, "text": "Porque cualquiera que hace la voluntad de Dios, este es mi hermano, y mi hermana, y mi madre.", "words": [[0, 252088], [7, 252349], [18, 253029], [22, 253229], [27, 253529], [30, 253749], [39, 254309], [42, 254449], [48, 255129], [53, 255589], [56, 255729], [59, 255849], [68, 256649], [70, 256829], [73, 256969], [82, 257489], [84, 257949], [87, 258069]]}]}