{"book": "GEN", "chapter": 32, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 272693, "verses": [{"verse": 1, "start": 300, "end": 5465, "text": "Y Jacob se fue su camino, y le salieron al encuentro ángeles de Dios.", "words": [[0, 519], [2, 773], [8, 1026], [11, 1106], [15, 1326], [18, 1506], [26, 2006], [28, 2746], [31, 2866], [40, 3426], [43, 3606], [53, 4206], [61, 4686], [64, 4866]]}, {"verse": 2, "start": 5915, "end": 13658, "text": "Y dijo Jacob cuando los vio: El campo de Dios es este: y llamó el nombre de aquel lugar Mahanaim.", "words": [[0, 5915], [2, 6060], [7, 6340], [13, 6760], [20, 7200], [24, 7640], [29, 8292], [32, 8410], [38, 8730], [41, 8930], [46, 9210], [49, 9610], [55, 10599], [57, 10700], [63, 11040], [66, 11140], [73, 11500], [76, 11720], [82, 12040], [88, 12871]]}, {"verse": 3, "start": 14108, "end": 22082, "text": "Y envió Jacob mensajeros delante de sí a Esaú su hermano, a la tierra de Seir, campo de Edom.", "words": [[0, 14108], [2, 14423], [8, 14777], [14, 15130], [25, 15950], [33, 16390], [36, 16618], [39, 16846], [41, 17074], [46, 17302], [49, 17530], [58, 18550], [60, 18690], [63, 18790], [70, 19110], [73, 19430], [79, 20170], [85, 20610], [88, 20850]]}, {"verse": 4, "start": 22532, "end": 30585, "text": "Y les mandó diciendo: Así diréis a mi señor Esaú: Así dice tu siervo Jacob: Con Labán he morado, y me he detenido hasta ahora;", "words": [[0, 22532], [2, 22532], [6, 22679], [12, 23139], [22, 24129], [26, 24308], [33, 24688], [35, 24953], [38, 25218], [44, 25483], [50, 25988], [54, 26213], [59, 26556], [62, 26898], [69, 27240], [76, 27823], [80, 27977], [86, 28171], [89, 28364], [97, 28764], [99, 29224], [102, 29344], [105, 29424], [114, 29924], [120, 30144]]}, {"verse": 5, "start": 31035, "end": 38416, "text": "Y tengo vacas, y asnos, y ovejas, y siervos y siervas; y envío a decirlo a mi señor, por hallar gracia en tus ojos.", "words": [[0, 31035], [2, 31141], [8, 31361], [15, 31901], [17, 32041], [24, 32401], [26, 32581], [34, 33001], [36, 33181], [44, 33541], [46, 33721], [55, 34549], [57, 34664], [63, 35104], [65, 35244], [73, 35764], [75, 35844], [78, 35904], [85, 36724], [89, 36884], [96, 37164], [103, 37604], [106, 37684], [110, 37824]]}, {"verse": 6, "start": 38766, "end": 47835, "text": "Y los mensajeros volvieron a Jacob, diciendo: Vinimos a tu hermano Esaú, y él también viene a recibirte, y cuatrocientos hombres con él.", "words": [[0, 38766], [2, 38870], [6, 38970], [17, 39550], [27, 40090], [29, 40310], [36, 40710], [46, 42349], [54, 42767], [56, 42907], [59, 43007], [67, 43407], [73, 43827], [75, 44347], [78, 44487], [86, 44787], [92, 45127], [94, 45287], [105, 45927], [107, 46217], [121, 46507], [129, 47227], [133, 47567]]}, {"verse": 7, "start": 48185, "end": 58918, "text": "Entonces Jacob tuvo gran temor, y se angustió; y partió el pueblo que tenía consigo, y las ovejas y las vacas y los camellos, en dos cuadrillas;", "words": [[0, 48185], [9, 49338], [15, 49758], [20, 50178], [25, 50558], [32, 50978], [34, 51178], [37, 51318], [47, 52459], [49, 52569], [56, 52969], [59, 53109], [66, 53449], [70, 53749], [76, 54089], [85, 54709], [87, 55269], [91, 55409], [98, 55969], [100, 56229], [104, 56369], [110, 56789], [112, 56909], [116, 57049], [126, 57669], [129, 57849], [133, 58049]]}, {"verse": 8, "start": 59368, "end": 64846, "text": "Y dijo: Si viene Esaú contra un campamento y lo ataca, el otro campamento escapará.", "words": [[0, 59368], [2, 59511], [8, 60279], [11, 60516], [17, 60756], [22, 60996], [29, 61256], [32, 61456], [43, 62056], [45, 62176], [48, 62276], [55, 63116], [58, 63216], [63, 63396], [74, 64076]]}, {"verse": 9, "start": 65196, "end": 75606, "text": "Y dijo Jacob: Dios de mi padre Abraham, y Dios de mi padre Isaac, Jehová, que me dijiste: Vuélvete a tu tierra y a tu parentela, y yo te haré bien;", "words": [[0, 65196], [2, 65323], [7, 65563], [14, 66378], [19, 66656], [22, 66876], [25, 66976], [31, 67396], [40, 68496], [42, 68536], [47, 68796], [50, 68996], [53, 69096], [59, 69456], [66, 70136], [74, 70776], [78, 70836], [81, 70956], [90, 72168], [99, 72548], [101, 72668], [104, 72788], [111, 73128], [113, 73348], [115, 73408], [118, 73528], [129, 74148], [131, 74668], [134, 74828], [137, 74968], [142, 75248]]}, {"verse": 10, "start": 76056, "end": 85957, "text": "Menor soy que todas las misericordias, y que toda la verdad que has usado para con tu siervo; que con mi bastón pasé este Jordán, y ahora estoy sobre dos cuadrillas.", "words": [[0, 76056], [6, 76335], [10, 76595], [14, 76775], [20, 77035], [24, 77275], [39, 78275], [41, 78695], [45, 78815], [50, 79035], [53, 79195], [60, 79455], [64, 79755], [68, 79895], [74, 80275], [79, 80515], [83, 80735], [86, 80855], [94, 81732], [98, 81816], [102, 81996], [105, 82136], [112, 82576], [117, 82996], [122, 83196], [130, 83636], [132, 84056], [138, 84316], [144, 84616], [150, 84936], [154, 85176]]}, {"verse": 11, "start": 86407, "end": 94127, "text": "Líbrame ahora de la mano de mi hermano, de la mano de Esaú, porque le temo; no venga quizá, y me hiera la madre con los hijos.", "words": [[0, 86407], [8, 86887], [14, 87167], [17, 87367], [20, 87487], [25, 87707], [28, 87887], [31, 88007], [40, 88767], [43, 88927], [46, 89027], [51, 89207], [54, 89657], [60, 90107], [67, 90267], [70, 90427], [76, 91153], [79, 91299], [85, 91559], [92, 92359], [94, 92459], [97, 92559], [103, 92819], [106, 92919], [112, 93139], [116, 93379], [120, 93539]]}, {"verse": 12, "start": 94577, "end": 100624, "text": "Y tú has dicho: Yo te haré bien, y pondré tu simiente como la arena del mar, que no se puede contar por la multitud.", "words": [[0, 94725], [2, 94907], [5, 95089], [9, 95271], [16, 95705], [19, 95797], [22, 95917], [27, 96097], [33, 96317], [35, 96777], [42, 97097], [45, 97397], [54, 97697], [59, 97917], [62, 98077], [68, 98277], [72, 98437], [77, 98657], [81, 98937], [84, 99057], [87, 99197], [93, 99377], [100, 99677], [104, 99937], [107, 100037]]}, {"verse": 13, "start": 100974, "end": 108083, "text": "Y durmió allí aquella noche, y tomó de lo que le vino a la mano un presente para su hermano Esaú:", "words": [[0, 100974], [2, 101101], [9, 101621], [14, 101921], [22, 102321], [29, 103501], [31, 103601], [36, 103981], [39, 104061], [42, 104201], [46, 104321], [49, 104441], [54, 104621], [56, 104781], [59, 104841], [64, 105101], [67, 105241], [76, 105581], [81, 105981], [84, 106161], [92, 107122]]}, {"verse": 14, "start": 108533, "end": 113765, "text": "Doscientas cabras y veinte machos cabríos, doscientas ovejas y veinte carneros,", "words": [[0, 108533], [11, 108533], [18, 109017], [20, 109357], [27, 109697], [34, 110277], [43, 110857], [54, 111437], [61, 112237], [63, 112537], [70, 112837]]}, {"verse": 15, "start": 114215, "end": 121925, "text": "Treinta camellas paridas, con sus hijos, cuarenta vacas y diez novillos, veinte asnas y diez borricos.", "words": [[0, 114384], [8, 114594], [17, 115214], [26, 115634], [30, 115874], [34, 116154], [41, 116834], [50, 117514], [56, 118114], [58, 118294], [63, 118474], [73, 119054], [80, 119634], [86, 120334], [88, 120704], [93, 121074]]}, {"verse": 16, "start": 122375, "end": 133761, "text": "Y lo entregó en mano de sus siervos, cada manada de por sí; y dijo a sus siervos: Pasad delante de mí, y poned espacio entre manada y manada.", "words": [[0, 122375], [2, 122460], [5, 122600], [13, 123140], [16, 123280], [21, 123580], [24, 123760], [28, 123900], [37, 124760], [42, 124980], [49, 125420], [52, 125580], [56, 125760], [60, 126593], [62, 126853], [67, 127153], [69, 127293], [73, 127413], [82, 128681], [88, 128841], [96, 129301], [99, 129461], [103, 129621], [105, 130048], [111, 130474], [119, 130901], [125, 131121], [132, 131561], [134, 131761]]}, {"verse": 17, "start": 134111, "end": 145270, "text": "Y mandó al primero, diciendo: Si Esaú mi hermano te encuentra, y te pregunta, diciendo: ¿De quién eres? ¿y adónde vas? ¿y para quién es esto que llevas delante de ti?", "words": [[0, 134111], [2, 134252], [8, 134532], [11, 134812], [20, 135212], [30, 137535], [33, 137675], [38, 137815], [41, 138035], [49, 138415], [52, 138495], [63, 138955], [65, 139135], [68, 139255], [78, 139675], [88, 140694], [92, 140964], [98, 141270], [104, 141820], [107, 141965], [114, 142265], [119, 143016], [122, 143119], [127, 143279], [133, 143479], [136, 143699], [141, 143919], [145, 144079], [152, 144419], [160, 144759], [163, 144899]]}, {"verse": 18, "start": 145720, "end": 153434, "text": "Entonces dirás: Es un regalo de tu siervo Jacob, que envía a mi señor Esaú; y he aquí también él viene tras nosotros.", "words": [[0, 145720], [9, 146082], [16, 147302], [19, 147550], [22, 147797], [29, 148045], [32, 148293], [35, 148540], [42, 148787], [49, 149035], [53, 149215], [59, 149595], [61, 149858], [64, 150120], [70, 150382], [76, 150888], [78, 150936], [81, 151026], [86, 151266], [94, 151706], [97, 152126], [103, 152306], [108, 152586]]}, {"verse": 19, "start": 153784, "end": 165026, "text": "Y mandó también al segundo, y al tercero, y a todos los que iban tras aquellas manadas, diciendo: Conforme a esto hablaréis a Esaú, cuando lo encontréis.", "words": [[0, 153784], [2, 153947], [8, 154307], [16, 154727], [19, 155047], [28, 155647], [30, 156447], [33, 156627], [42, 157547], [44, 157827], [46, 157907], [52, 158227], [56, 158547], [60, 158767], [65, 159107], [70, 159307], [79, 159867], [88, 160387], [98, 162004], [107, 162366], [109, 162506], [114, 162746], [124, 163266], [126, 163406], [132, 163706], [139, 164066], [142, 164266]]}, {"verse": 20, "start": 165476, "end": 177128, "text": "Y diréis también: He aquí tu siervo Jacob viene tras nosotros. Porque dijo: Apaciguaré su ira con el regalo que va delante de mí, y después veré su rostro: quizá me reciba bien.", "words": [[0, 165476], [2, 165576], [9, 165896], [18, 166871], [21, 166951], [26, 167151], [29, 167351], [36, 167711], [42, 168011], [48, 168411], [53, 168691], [63, 169889], [70, 170059], [76, 171149], [87, 171469], [90, 171609], [94, 171889], [98, 172049], [101, 172189], [108, 172569], [112, 172709], [115, 172849], [123, 173269], [126, 173429], [130, 173629], [132, 174089], [140, 174389], [145, 174849], [148, 174929], [156, 175818], [162, 176202], [165, 176302], [172, 176762]]}, {"verse": 21, "start": 177478, "end": 183776, "text": "Y pasó el presente delante de él; y él durmió aquella noche en el campamento.", "words": [[0, 177478], [2, 177627], [7, 178047], [10, 178407], [19, 178967], [27, 179647], [30, 179847], [34, 180643], [36, 181066], [39, 181186], [46, 181646], [54, 182106], [60, 182566], [63, 182706], [66, 182826]]}, {"verse": 22, "start": 184226, "end": 193109, "text": "Y se levantó aquella noche, y tomó sus dos mujeres, y sus dos siervas, y sus once hijos, y pasó el vado de Jaboc.", "words": [[0, 184226], [2, 184350], [5, 184470], [13, 185050], [21, 185390], [28, 186370], [30, 186710], [35, 187050], [39, 187230], [43, 187410], [52, 187890], [54, 188230], [58, 188370], [62, 188590], [71, 189210], [73, 189590], [77, 189750], [82, 190210], [89, 190610], [91, 191270], [96, 191630], [99, 192030], [104, 192390], [107, 192782]]}, {"verse": 23, "start": 193559, "end": 198582, "text": "Los tomó pues, y los hizo pasar el arroyo, e hizo pasar lo que tenía.", "words": [[0, 193559], [4, 193707], [9, 194067], [15, 194487], [17, 194827], [21, 195007], [26, 195307], [32, 195687], [35, 195907], [43, 196827], [45, 197007], [50, 197247], [56, 197527], [59, 197787], [63, 197927]]}, {"verse": 24, "start": 199032, "end": 204151, "text": "Y se quedó Jacob solo, y luchó con él un varón hasta que rayaba el alba.", "words": [[0, 199032], [2, 199178], [5, 199258], [11, 199598], [17, 199878], [23, 200398], [25, 200978], [31, 201378], [35, 201558], [38, 201738], [41, 201958], [47, 202458], [53, 202718], [57, 202898], [64, 203398], [67, 203558]]}, {"verse": 25, "start": 204601, "end": 213245, "text": "Y cuando vio que no podía con él, tocó en la coyuntura de su cadera, y se dislocó la cadera de Jacob mientras con él luchaba.", "words": [[0, 204601], [2, 204724], [9, 204924], [13, 205384], [17, 205584], [20, 205764], [26, 206124], [30, 206424], [34, 206984], [39, 207404], [42, 207624], [45, 207744], [55, 208364], [58, 208504], [61, 208664], [69, 209144], [71, 209524], [74, 209664], [82, 210304], [85, 210444], [92, 210884], [95, 211004], [101, 211364], [110, 211924], [114, 212344], [117, 212504]]}, {"verse": 26, "start": 213695, "end": 219374, "text": "Y dijo: Déjame, que raya el alba. Y él dijo: No te dejaré, si no me bendices.", "words": [[0, 213695], [2, 213838], [8, 214606], [16, 214983], [20, 215163], [25, 215563], [28, 215683], [34, 216432], [36, 216620], [39, 216780], [45, 217549], [48, 217730], [51, 217890], [59, 218330], [62, 218450], [65, 218530], [68, 218650]]}, {"verse": 27, "start": 219724, "end": 224098, "text": "Y él le dijo: ¿Cuál es tu nombre? Y él respondió: Jacob.", "words": [[0, 219724], [2, 219892], [5, 220032], [8, 220192], [14, 220966], [20, 221167], [23, 221307], [26, 221427], [34, 222274], [36, 222456], [39, 222596], [50, 223877]]}, {"verse": 28, "start": 224448, "end": 231993, "text": "Y él dijo: No se dirá más tu nombre Jacob, sino Israel: porque has peleado con Dios y con los hombres, y has vencido.", "words": [[0, 224448], [2, 224636], [5, 224796], [11, 225565], [14, 225702], [17, 225822], [22, 226122], [26, 226242], [29, 226462], [36, 226822], [43, 227542], [48, 227702], [56, 228701], [63, 228880], [67, 229060], [75, 229540], [79, 229740], [84, 229980], [86, 230219], [90, 230360], [94, 230499], [103, 230880], [105, 231180], [109, 231340]]}, {"verse": 29, "start": 232343, "end": 244511, "text": "Entonces Jacob le preguntó, y dijo: Dime ahora tu nombre. Y él respondió: ¿Por qué preguntas por mi nombre? Y lo bendijo allí.", "words": [[0, 232343], [9, 233088], [15, 233348], [18, 233708], [28, 234348], [30, 234528], [36, 235239], [41, 235497], [47, 235717], [50, 235917], [58, 236774], [60, 236956], [63, 237096], [74, 238141], [79, 238280], [83, 238440], [93, 238920], [97, 239240], [100, 239400], [108, 243280], [110, 243390], [113, 243530], [121, 244030]]}, {"verse": 30, "start": 244961, "end": 252415, "text": "Y llamó Jacob el nombre de aquel lugar, Peniel: porque vi a Dios cara a cara, y fue librada mi alma.", "words": [[0, 244961], [2, 245069], [8, 245429], [14, 245649], [17, 245989], [24, 246329], [27, 246549], [33, 246909], [40, 247609], [48, 248592], [55, 249507], [58, 249704], [60, 249844], [65, 250064], [70, 250364], [72, 250524], [78, 250784], [80, 251264], [84, 251444], [92, 251844], [95, 252004]]}, {"verse": 31, "start": 252765, "end": 257819, "text": "Y le salió el sol después que hubo pasado Peniel; y cojeaba de su cadera.", "words": [[0, 252765], [2, 252891], [5, 252991], [11, 253391], [14, 253571], [18, 253791], [26, 254211], [30, 254451], [35, 254671], [42, 255011], [50, 255957], [52, 256415], [60, 256875], [63, 257035], [66, 257175]]}, {"verse": 32, "start": 258269, "end": 272293, "text": "Por esto no comen los hijos de Israel, hasta hoy día, del tendón que se contrajo, el cual está en el encaje del muslo: porque tocó a Jacob este sitio de su muslo en el tendón que se contrajo.", "words": [[0, 258269], [4, 258413], [9, 258633], [12, 258873], [18, 259193], [22, 259433], [28, 259773], [31, 259933], [39, 260493], [45, 260973], [49, 261333], [54, 261853], [58, 262493], [65, 263013], [69, 263133], [72, 263293], [82, 264033], [85, 264693], [90, 264933], [95, 265373], [98, 265633], [101, 265793], [108, 266433], [112, 266593], [119, 267592], [126, 267776], [131, 268296], [133, 268396], [139, 268736], [144, 269136], [150, 269576], [153, 269756], [156, 269916], [162, 270416], [165, 270656], [168, 270796], [175, 271216], [179, 271376], [182, 271496]]}]}