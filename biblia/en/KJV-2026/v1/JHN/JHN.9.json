{"book": "JHN", "chapter": 9, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 288761, "verses": [{"verse": 1, "start": 300, "end": 4982, "text": "And as Jesus passed by, he saw a man which was blind from his birth.", "words": [[0, 300], [4, 446], [7, 626], [13, 906], [20, 1326], [24, 2286], [27, 2346], [31, 2626], [33, 2846], [37, 3126], [43, 3426], [47, 3626], [53, 4026], [58, 4306], [62, 4486]]}, {"verse": 2, "start": 5432, "end": 12615, "text": "And his disciples asked him, saying, Master, who did sin, this man, or his parents, that he was born blind?", "words": [[0, 5432], [4, 5555], [8, 5695], [18, 6255], [24, 6715], [29, 6915], [37, 8315], [45, 8635], [49, 8835], [53, 9035], [58, 9655], [63, 9795], [68, 10335], [71, 10555], [75, 10715], [84, 11415], [89, 11555], [92, 11675], [96, 11815], [101, 12055]]}, {"verse": 3, "start": 12965, "end": 20881, "text": "Jesus answered, Neither has this man sinned, nor his parents: but that the works of God should be made manifest in him.", "words": [[0, 12965], [6, 13243], [16, 14263], [24, 14608], [28, 14988], [33, 15208], [37, 15508], [45, 16248], [49, 16568], [53, 16828], [62, 17828], [66, 17912], [71, 18072], [75, 18212], [81, 18452], [84, 18652], [88, 18992], [95, 19272], [98, 19452], [103, 19712], [112, 20212], [115, 20552]]}, {"verse": 4, "start": 21331, "end": 27165, "text": "I must work the works of him that sent me, while it is day: the night comes, when no man can work.", "words": [[0, 21331], [2, 21709], [7, 21889], [12, 22169], [16, 22349], [22, 22569], [25, 22789], [29, 22969], [34, 23189], [39, 23469], [43, 23689], [49, 24089], [52, 24269], [55, 24389], [60, 25135], [64, 25219], [70, 25399], [77, 25759], [82, 25999], [85, 26199], [89, 26439], [93, 26679]]}, {"verse": 5, "start": 27615, "end": 30840, "text": "As long as I am in the world, I am the light of the world.", "words": [[0, 27615], [3, 27756], [8, 27976], [11, 28196], [13, 28356], [16, 28436], [19, 28556], [23, 28656], [30, 29356], [32, 29536], [35, 29656], [39, 29796], [45, 30056], [48, 30196], [52, 30316]]}, {"verse": 6, "start": 31190, "end": 39553, "text": "When he had thus spoken, he spat on the ground, and made clay of the spittle, and he anointed the eyes of the blind man with the clay,", "words": [[0, 31190], [5, 31358], [8, 31538], [12, 31718], [17, 31898], [25, 32878], [28, 32958], [33, 33258], [36, 33518], [40, 33638], [48, 33978], [52, 34578], [57, 34798], [62, 35178], [65, 35378], [69, 35558], [78, 36338], [82, 36538], [85, 36678], [94, 37058], [98, 37298], [103, 37638], [106, 37838], [110, 37958], [116, 38258], [120, 38638], [125, 38838], [129, 38998]]}, {"verse": 7, "start": 40003, "end": 49816, "text": "And said to him, Go, wash in the pool of Siloam, (which is by interpretation, Sent.) He went his way therefore, and washed, and came seeing.", "words": [[0, 40003], [4, 40283], [9, 40483], [12, 40703], [17, 41756], [21, 41928], [26, 42368], [29, 42588], [33, 42708], [38, 43008], [41, 43188], [49, 44135], [56, 44338], [59, 44498], [62, 44678], [78, 45318], [85, 46338], [88, 46498], [93, 46718], [97, 46898], [101, 47118], [112, 47618], [116, 48078], [124, 48858], [128, 48918], [133, 49138]]}, {"verse": 8, "start": 50266, "end": 56699, "text": "¶ The neighbours therefore, and they which before had seen him that he was blind, said, Is not this he that sat and begged?", "words": [[2, 50266], [6, 50441], [17, 50651], [28, 51391], [32, 51511], [37, 51711], [43, 51951], [50, 52311], [54, 52551], [59, 52791], [63, 53111], [68, 53191], [71, 53291], [75, 53451], [82, 54051], [88, 54779], [91, 54914], [95, 55094], [100, 55394], [103, 55627], [108, 55861], [112, 56094], [116, 56234]]}, {"verse": 9, "start": 57049, "end": 62929, "text": "Some said, This is he: others said, He is like him: but he said, I am he.", "words": [[0, 57049], [5, 57223], [11, 57963], [16, 58129], [19, 58269], [23, 58999], [30, 59228], [36, 60026], [39, 60187], [42, 60307], [47, 60487], [52, 61277], [56, 61421], [59, 61541], [65, 62240], [67, 62380], [70, 62500]]}, {"verse": 10, "start": 63279, "end": 66631, "text": "Therefore said they to him, How were your eyes opened?", "words": [[0, 63279], [10, 63585], [15, 63925], [20, 64145], [23, 64345], [28, 64922], [32, 65158], [37, 65358], [42, 65558], [47, 65938]]}, {"verse": 11, "start": 66981, "end": 77560, "text": "He answered and said, A man that is called Jesus made clay, and anointed my eyes, and said to me, Go to the pool of Siloam, and wash: and I went and washed, and I received sight.", "words": [[0, 66981], [3, 67094], [12, 67394], [16, 67614], [22, 68320], [24, 68445], [28, 68625], [33, 68765], [36, 68905], [43, 69085], [49, 69465], [54, 69825], [60, 70205], [64, 70705], [73, 71065], [76, 71305], [82, 71605], [86, 71825], [91, 72045], [94, 72225], [98, 72525], [101, 72885], [104, 73085], [108, 73205], [113, 73465], [116, 73605], [124, 74085], [128, 74305], [134, 75175], [138, 75294], [140, 75414], [145, 75614], [149, 75834], [157, 76134], [161, 76434], [163, 76534], [172, 76934]]}, {"verse": 12, "start": 77910, "end": 82283, "text": "Then said they to him, Where is he? He said, I know not.", "words": [[0, 77910], [5, 78151], [10, 78471], [15, 78691], [18, 78891], [23, 79490], [29, 79689], [32, 79929], [36, 80508], [39, 80590], [45, 81329], [47, 81526], [52, 81726]]}, {"verse": 13, "start": 82633, "end": 85932, "text": "¶ They brought to the Pharisees him that before was blind.", "words": [[2, 82633], [7, 82759], [15, 82999], [18, 83219], [22, 83359], [32, 84039], [36, 84279], [41, 84579], [48, 84939], [52, 85279]]}, {"verse": 14, "start": 86382, "end": 90747, "text": "And it was the sabbath day when Jesus made the clay, and opened his eyes.", "words": [[0, 86382], [4, 86503], [7, 86583], [11, 86723], [15, 86863], [23, 87203], [27, 87643], [32, 87903], [38, 88183], [43, 88563], [47, 88743], [53, 89043], [57, 89583], [64, 89863], [68, 90123]]}, {"verse": 15, "start": 91197, "end": 100321, "text": "Then again the Pharisees also asked him how he had received his sight. He said to them, He put clay upon my eyes, and I washed, and do see.", "words": [[0, 91197], [5, 91420], [11, 91920], [15, 91980], [25, 92700], [30, 93000], [36, 93460], [40, 93640], [44, 93900], [47, 94120], [51, 94300], [60, 94720], [64, 94980], [71, 95804], [74, 95934], [79, 96194], [82, 96394], [88, 97102], [91, 97216], [95, 97329], [100, 97609], [105, 97789], [108, 98049], [114, 98369], [118, 98729], [120, 98849], [128, 99269], [132, 99729], [135, 99909]]}, {"verse": 16, "start": 100671, "end": 112572, "text": "Therefore said some of the Pharisees, This man is not of God, because he keeps not the sabbath day. Others said, How can a man that is a sinner do such miracles? And there was a division among them.", "words": [[0, 100671], [10, 101024], [15, 101384], [20, 101644], [23, 101824], [27, 101924], [38, 103065], [43, 103202], [47, 103422], [50, 103542], [54, 103702], [57, 103842], [62, 104082], [70, 104542], [73, 104782], [79, 105002], [83, 105302], [87, 105522], [95, 105782], [100, 106612], [107, 106841], [113, 107639], [117, 107819], [121, 108039], [123, 108139], [127, 108319], [132, 108499], [135, 108619], [137, 108699], [144, 108999], [147, 109339], [152, 109619], [162, 110730], [166, 110875], [172, 111035], [176, 111255], [178, 111415], [187, 111795], [193, 112095]]}, {"verse": 17, "start": 113022, "end": 120257, "text": "They say to the blind man again, What do you say of him, that he has opened your eyes? He said, He is a prophet.", "words": [[0, 113022], [5, 113145], [9, 113345], [12, 113525], [16, 113645], [22, 113965], [26, 114265], [33, 115211], [38, 115371], [41, 115491], [45, 115611], [49, 115811], [52, 115971], [57, 116231], [62, 116671], [65, 116831], [69, 117031], [76, 117351], [81, 117551], [87, 118375], [90, 118457], [96, 119196], [99, 119388], [102, 119568], [104, 119668]]}, {"verse": 18, "start": 120607, "end": 129031, "text": "But the Jews did not believe concerning him, that he had been blind, and received his sight, until they called the parents of him that had received his sight.", "words": [[0, 120607], [4, 120767], [8, 120887], [13, 121167], [17, 121467], [21, 121627], [29, 122007], [40, 122547], [45, 122947], [50, 123447], [53, 123607], [57, 123747], [62, 123927], [69, 124307], [73, 124567], [82, 124947], [86, 125167], [93, 125487], [99, 126087], [104, 126347], [111, 126587], [115, 126807], [123, 127147], [126, 127387], [130, 127567], [135, 127767], [139, 127927], [148, 128307], [152, 128567]]}, {"verse": 19, "start": 129481, "end": 136136, "text": "And they asked them, saying, Is this your son, who you say was born blind? how then does he now see?", "words": [[0, 129481], [4, 129599], [9, 129759], [15, 130059], [21, 130299], [29, 131578], [32, 131738], [37, 131918], [42, 132138], [47, 132518], [51, 132998], [55, 133158], [59, 133418], [63, 133618], [68, 133898], [75, 134818], [79, 134964], [84, 135184], [89, 135384], [92, 135544], [96, 135704]]}, {"verse": 20, "start": 136486, "end": 142354, "text": "His parents answered them and said, We know that this is our son, and that he was born blind:", "words": [[0, 136486], [4, 136590], [12, 136990], [21, 137470], [26, 137730], [30, 137910], [36, 139516], [39, 139620], [44, 139760], [49, 139900], [54, 140080], [57, 140200], [61, 140360], [66, 140700], [70, 141080], [75, 141220], [78, 141340], [82, 141500], [87, 141760]]}, {"verse": 21, "start": 142804, "end": 151255, "text": "But by what means he now sees, we know not; or who has opened his eyes, we know not: he is of age; ask him: he shall speak for himself.", "words": [[0, 142804], [4, 142904], [7, 143044], [12, 143224], [18, 143484], [21, 143644], [25, 143824], [31, 144464], [34, 144644], [39, 144824], [44, 145577], [47, 145698], [51, 145858], [55, 146057], [62, 146358], [66, 146598], [72, 146997], [75, 147057], [80, 147258], [85, 147975], [88, 148197], [91, 148317], [94, 148457], [99, 149150], [103, 149373], [108, 149927], [111, 150035], [117, 150215], [123, 150475], [127, 150695]]}, {"verse": 22, "start": 151605, "end": 162141, "text": "These words spoke his parents, because they feared the Jews: for the Jews had agreed already, that if any man did confess that he was Christ, he should be put out of the synagogue.", "words": [[0, 151605], [6, 151758], [12, 152098], [18, 152388], [22, 152678], [31, 153138], [39, 153838], [44, 154098], [51, 154418], [55, 154618], [61, 155606], [65, 155699], [69, 155839], [74, 156099], [78, 156319], [85, 156639], [94, 157159], [99, 157679], [102, 157819], [106, 157999], [110, 158279], [114, 158499], [122, 158959], [127, 159219], [130, 159359], [134, 159519], [142, 160419], [145, 160459], [152, 160619], [155, 160759], [159, 160959], [163, 161139], [166, 161259], [170, 161359]]}, {"verse": 23, "start": 162591, "end": 166028, "text": "Therefore said his parents, He is of age; ask him.", "words": [[0, 162591], [10, 162935], [15, 163255], [19, 163435], [28, 164328], [31, 164490], [34, 164690], [37, 164850], [42, 165569], [46, 165755]]}, {"verse": 24, "start": 166378, "end": 174122, "text": "Then again called they the man that was blind, and said to him, Give God the praise: we know that this man is a sinner.", "words": [[0, 166378], [5, 166557], [11, 166837], [18, 167617], [23, 168157], [27, 168277], [31, 168517], [36, 168717], [40, 168897], [47, 169697], [51, 169857], [56, 170097], [59, 170317], [64, 170913], [69, 171098], [73, 171378], [77, 171558], [85, 172423], [88, 172524], [93, 172724], [98, 172884], [103, 173044], [107, 173364], [110, 173564], [112, 173664]]}, {"verse": 25, "start": 174472, "end": 181784, "text": "He answered and said, Whether he be a sinner or no, I know not: one thing I know, that, whereas I was blind, now I see.", "words": [[0, 174472], [3, 174585], [12, 174885], [16, 175105], [22, 175811], [30, 175993], [33, 176193], [36, 176313], [38, 176453], [45, 176693], [48, 176933], [52, 177373], [54, 177473], [59, 177633], [64, 178333], [68, 178495], [74, 178695], [76, 178855], [82, 179095], [88, 179515], [96, 180115], [98, 180355], [102, 180455], [109, 180815], [113, 181255], [115, 181415]]}, {"verse": 26, "start": 182134, "end": 186884, "text": "Then said they to him again, What did he to you? how opened he your eyes?", "words": [[0, 182134], [5, 182357], [10, 182677], [15, 182897], [18, 183057], [22, 183277], [29, 184170], [34, 184290], [38, 184450], [41, 184830], [44, 184830], [49, 185466], [53, 185612], [60, 185972], [63, 186172], [68, 186392]]}, {"verse": 27, "start": 187234, "end": 194889, "text": "He answered them, I have told you already, and you did not hear: why would you hear it again? will you also be his disciples?", "words": [[0, 187234], [3, 187345], [12, 187645], [18, 188331], [20, 188491], [25, 188631], [30, 188871], [34, 189091], [43, 189471], [47, 189991], [51, 190111], [55, 190271], [59, 190491], [65, 191293], [69, 191574], [75, 191814], [79, 191934], [84, 192174], [87, 192294], [94, 193101], [99, 193191], [103, 193311], [108, 193671], [111, 193911], [115, 194071]]}, {"verse": 28, "start": 195239, "end": 200637, "text": "Then they reviled him, and said, You are his disciple; but we are Moses’ disciples.", "words": [[0, 195239], [5, 195506], [10, 195706], [18, 196246], [23, 196406], [27, 196626], [33, 197282], [37, 197459], [41, 197639], [45, 197779], [55, 198722], [59, 198848], [62, 199048], [66, 199308], [73, 199968]]}, {"verse": 29, "start": 201087, "end": 206226, "text": "We know that God spoke to Moses: as for this fellow, we know not from where he is.", "words": [[0, 201087], [3, 201230], [8, 201510], [13, 201730], [17, 201970], [23, 202270], [26, 202470], [33, 203331], [36, 203504], [40, 203684], [45, 203904], [53, 204564], [56, 204664], [61, 204844], [65, 205124], [70, 205344], [76, 205564], [79, 205764]]}, {"verse": 30, "start": 206576, "end": 214161, "text": "The man answered and said to them, Why herein is a marvellous thing, that you know not from where he is, and yet he has opened my eyes.", "words": [[0, 206576], [4, 206673], [8, 206913], [17, 207373], [21, 207593], [26, 207773], [29, 207973], [35, 208550], [39, 208846], [46, 209176], [49, 209316], [51, 209516], [62, 209716], [69, 210396], [74, 210576], [78, 210716], [83, 210876], [87, 211116], [92, 211336], [98, 211556], [101, 211716], [105, 212196], [109, 212376], [113, 212556], [116, 212736], [120, 212936], [127, 213316], [130, 213576]]}, {"verse": 31, "start": 214611, "end": 221503, "text": "Now we know that God hears not sinners: but if any man be a worshipper of God, and does his will, him he hears.", "words": [[0, 214611], [4, 214795], [7, 215015], [12, 215195], [17, 215395], [21, 215635], [27, 216215], [31, 216295], [40, 217284], [44, 217403], [47, 217523], [51, 217783], [55, 218043], [58, 218243], [60, 218323], [71, 218703], [74, 218863], [79, 219143], [83, 219583], [88, 219783], [92, 219943], [98, 220563], [102, 220703], [105, 220943]]}, {"verse": 32, "start": 221953, "end": 227424, "text": "Since the world began was it not heard that any man opened the eyes of one that was born blind.", "words": [[0, 221953], [6, 222157], [10, 222377], [16, 222657], [22, 223437], [26, 223557], [29, 223697], [33, 223877], [39, 224237], [44, 224437], [48, 224717], [52, 224997], [59, 225337], [63, 225557], [68, 225837], [71, 225997], [75, 226217], [80, 226397], [84, 226577], [89, 226817]]}, {"verse": 33, "start": 227874, "end": 230233, "text": "If this man were not of God, he could do nothing.", "words": [[0, 227874], [3, 227997], [8, 228197], [12, 228437], [17, 228597], [21, 228737], [24, 228877], [29, 229397], [32, 229497], [38, 229637], [41, 229777]]}, {"verse": 34, "start": 230583, "end": 236762, "text": "They answered and said to him, You were altogether born in sins, and do you teach us? And they cast him out.", "words": [[0, 230583], [5, 230692], [14, 231092], [18, 231312], [23, 231512], [26, 231692], [31, 232193], [35, 232338], [40, 232708], [51, 233078], [56, 233478], [59, 233638], [65, 233898], [69, 234338], [72, 234478], [76, 234558], [82, 234778], [86, 235560], [90, 235711], [95, 235831], [100, 236151], [104, 236371]]}, {"verse": 35, "start": 237212, "end": 245768, "text": "Jesus heard that they had cast him out; and when he had found him, he said to him, Do you believe on the Son of God?", "words": [[0, 237212], [6, 237536], [12, 238016], [17, 238256], [22, 238416], [26, 238556], [31, 238876], [35, 239096], [40, 239815], [44, 239940], [49, 240120], [52, 240320], [56, 240440], [62, 240740], [67, 241300], [70, 241440], [75, 241700], [78, 241880], [83, 243745], [86, 243842], [90, 244102], [98, 244462], [101, 244702], [105, 244822], [109, 245082], [112, 245222]]}, {"verse": 36, "start": 246118, "end": 251082, "text": "He answered and said, Who is he, Lord, that I might believe on him?", "words": [[0, 246118], [3, 246231], [12, 246531], [16, 246751], [22, 247457], [26, 247601], [29, 247981], [33, 248341], [39, 248941], [44, 249101], [46, 249221], [52, 249421], [60, 249701], [63, 249881]]}, {"verse": 37, "start": 251432, "end": 256633, "text": "And Jesus said to him, You have both seen him, and it is he that talks with you.", "words": [[0, 251432], [4, 251583], [10, 251883], [15, 252283], [18, 252483], [23, 253034], [27, 253169], [32, 253369], [37, 253649], [42, 253989], [47, 254649], [51, 254789], [54, 254909], [57, 255089], [60, 255349], [65, 255629], [71, 255949], [76, 256269]]}, {"verse": 38, "start": 256983, "end": 261596, "text": "And he said, Lord, I believe. And he worshipped him.", "words": [[0, 256983], [4, 257118], [7, 257258], [13, 258716], [19, 259241], [21, 259341], [30, 260391], [34, 260562], [37, 260722], [48, 261282]]}, {"verse": 39, "start": 262046, "end": 271033, "text": "¶ And Jesus said, For judgment I am come into this world, that they which see not might see; and that they which see might be made blind.", "words": [[2, 262046], [6, 262212], [12, 262492], [18, 263372], [22, 263502], [31, 263902], [33, 264282], [36, 264422], [41, 264682], [46, 264942], [51, 265202], [58, 265622], [63, 266162], [68, 266442], [74, 266642], [78, 266962], [82, 267302], [88, 267702], [93, 268577], [97, 268718], [102, 268898], [107, 269118], [113, 269338], [117, 269618], [123, 269858], [126, 270078], [131, 270358]]}, {"verse": 40, "start": 271383, "end": 278031, "text": "And some of the Pharisees which were with him heard these words, and said to him, Are we blind also?", "words": [[0, 271383], [4, 271498], [9, 271718], [12, 271858], [16, 271978], [26, 272678], [32, 272818], [37, 272998], [42, 273218], [46, 273378], [52, 273658], [58, 273898], [65, 274298], [69, 274938], [74, 275198], [77, 275398], [82, 276791], [86, 276914], [89, 277054], [95, 277334]]}, {"verse": 41, "start": 278381, "end": 288361, "text": "Jesus said to them, If you were blind, you should have no sin: but now you say, We see; therefore your sin remains.", "words": [[0, 278381], [6, 278640], [11, 278980], [14, 279160], [20, 281437], [23, 281625], [27, 281825], [32, 281945], [39, 282805], [43, 282925], [50, 283105], [55, 283365], [58, 283585], [63, 284484], [67, 284585], [71, 284765], [75, 284965], [80, 285505], [83, 285805], [88, 286658], [98, 287201], [103, 287281], [107, 287561]]}]}