{"book": "ISA", "chapter": 32, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 173158, "verses": [{"verse": 1, "start": 300, "end": 5430, "text": "He aquí que en justicia reinará un rey, y príncipes presidirán en juicio.", "words": [[0, 351], [3, 431], [8, 671], [12, 891], [15, 991], [24, 1571], [32, 2191], [35, 2291], [40, 3191], [42, 3251], [52, 3911], [63, 4671], [66, 4831]]}, {"verse": 2, "start": 5880, "end": 18222, "text": "Y será aquel varón como escondedero contra el viento, y como acogida contra el turbión; como arroyos de aguas en tierra de sequedad, como sombra de gran peñasco en tierra calurosa.", "words": [[0, 5880], [2, 5985], [7, 6225], [13, 6545], [19, 6945], [24, 7105], [36, 7745], [43, 8025], [46, 8225], [54, 8605], [56, 9005], [61, 9185], [69, 9745], [76, 10065], [79, 10205], [88, 11200], [93, 11405], [101, 12045], [104, 12205], [110, 12685], [113, 12905], [120, 13225], [123, 13885], [133, 14545], [138, 14845], [145, 15485], [148, 15625], [153, 16155], [161, 16685], [164, 16825], [171, 17205]]}, {"verse": 3, "start": 18672, "end": 25446, "text": "No se ofuscarán entonces los ojos de los que ven, y los oídos de los oyentes oirán atentos.", "words": [[0, 18672], [3, 18840], [6, 19220], [16, 19600], [25, 20080], [29, 20440], [34, 20860], [37, 21320], [41, 21440], [45, 21600], [50, 21840], [52, 22400], [56, 22580], [62, 23120], [65, 23220], [69, 23360], [77, 23990], [83, 24620]]}, {"verse": 4, "start": 25896, "end": 33801, "text": "Y el corazón de los necios entenderá para saber, y la lengua de los tartamudos será desenvuelta para hablar claramente.", "words": [[0, 25896], [2, 26041], [5, 26201], [13, 26721], [16, 26961], [20, 27101], [27, 27521], [37, 28301], [42, 28481], [49, 29341], [51, 29421], [54, 29561], [61, 29961], [64, 30041], [68, 30161], [79, 30841], [84, 31451], [96, 32061], [101, 32401], [108, 32741]]}, {"verse": 5, "start": 34251, "end": 40294, "text": "El mezquino nunca más será llamado generoso, ni será dicho generoso el avariento.", "words": [[0, 34251], [3, 34673], [12, 35133], [18, 35693], [22, 36193], [27, 36413], [35, 36833], [45, 37693], [48, 37953], [53, 38213], [59, 38513], [68, 39273], [71, 39453]]}, {"verse": 6, "start": 40744, "end": 55434, "text": "Porque el mezquino hablará mezquindades, y su corazón fabricará iniquidad, para hacer la impiedad y para hablar burla contra Jehová, dejando vacía el alma hambrienta, y quitando la bebida al sediento.", "words": [[0, 40744], [7, 40987], [10, 41327], [19, 41667], [27, 42107], [41, 43487], [43, 43627], [46, 43787], [54, 44327], [64, 45327], [75, 46127], [80, 46707], [86, 47087], [89, 47287], [98, 48027], [100, 48187], [105, 48407], [112, 48847], [118, 49507], [125, 49827], [133, 50607], [141, 51027], [147, 51507], [150, 51647], [155, 51867], [167, 53117], [169, 53317], [178, 53777], [181, 53957], [188, 54397], [191, 54557]]}, {"verse": 7, "start": 55884, "end": 66540, "text": "Cierto los avaros malas medidas tienen: él maquina pensamientos para enredar a los simples con palabras cautelosas, y para hablar en juicio contra el pobre.", "words": [[0, 55884], [7, 56646], [11, 56916], [18, 57186], [24, 57566], [32, 57966], [40, 58991], [43, 59138], [51, 60178], [64, 60858], [69, 61138], [77, 61718], [79, 61818], [83, 61918], [91, 62398], [95, 62678], [104, 63398], [116, 64118], [118, 64478], [123, 64678], [130, 64898], [133, 65118], [140, 65458], [147, 65778], [150, 65978]]}, {"verse": 8, "start": 66990, "end": 72422, "text": "Pero el generoso pensará liberalidades, y por liberalidades subirá.", "words": [[0, 66990], [5, 67154], [8, 67274], [17, 67854], [25, 68593], [40, 69854], [42, 70173], [46, 70374], [60, 71514]]}, {"verse": 9, "start": 72872, "end": 79165, "text": "Mujeres indolentes, levantaos, oíd mi voz; confiadas, escuchad mi razón.", "words": [[0, 72872], [8, 73321], [20, 74491], [31, 75661], [35, 75901], [38, 76061], [43, 76858], [54, 77927], [63, 78387], [66, 78507]]}, {"verse": 10, "start": 79615, "end": 88477, "text": "Días y años tendréis espanto, oh confiadas; porque la vendimia faltará, y la cosecha no acudirá.", "words": [[0, 79615], [5, 79880], [7, 80100], [12, 80400], [21, 81020], [30, 81420], [33, 81820], [44, 83159], [51, 83399], [54, 83579], [63, 84219], [72, 84859], [74, 85279], [77, 85419], [85, 85919], [88, 86099]]}, {"verse": 11, "start": 88927, "end": 97625, "text": "Temblad, oh reposadas; turbaos, oh confiadas: despojaos, desnudaos, ceñid los lomos con saco.", "words": [[0, 88956], [9, 89016], [12, 89076], [23, 90533], [32, 91193], [35, 91853], [46, 93285], [57, 94415], [68, 95245], [74, 96075], [78, 96355], [84, 96775], [88, 97015]]}, {"verse": 12, "start": 98075, "end": 102904, "text": "Sobre los pechos lamentarán por los campos deleitosos, por la vid fértil.", "words": [[0, 98075], [6, 98337], [10, 98557], [17, 99117], [28, 100137], [32, 100318], [36, 100497], [43, 101038], [55, 102077], [59, 102398], [62, 102566], [66, 102735]]}, {"verse": 13, "start": 103354, "end": 112242, "text": "Sobre la tierra de mi pueblo subirán espinas y cardos; y aun sobre todas las casas de placer en la ciudad de alegría.", "words": [[0, 103354], [6, 104442], [9, 104702], [16, 105022], [19, 105262], [22, 105402], [29, 105702], [37, 106282], [45, 106942], [47, 107122], [55, 108115], [57, 108239], [61, 108399], [67, 108779], [73, 109159], [77, 109459], [83, 109959], [86, 110059], [93, 110539], [96, 110799], [99, 110939], [106, 111259], [109, 111539]]}, {"verse": 14, "start": 112692, "end": 126486, "text": "Porque los palacios serán desiertos, la multitud de la ciudad cesará: las torres y fortalezas se volverán cuevas para siempre, donde descansen asnos monteses, y ganados hagan majada:", "words": [[0, 112692], [7, 113072], [11, 113272], [20, 113832], [26, 114212], [37, 115192], [40, 115292], [49, 115892], [52, 116052], [55, 116172], [62, 116472], [70, 117716], [74, 117860], [81, 118440], [83, 118560], [94, 119340], [97, 119560], [106, 120060], [113, 120520], [118, 120720], [127, 121700], [133, 121940], [143, 122710], [149, 123480], [159, 124300], [161, 124860], [169, 125360], [175, 125820]]}, {"verse": 15, "start": 126936, "end": 136919, "text": "Hasta que sobre nosotros sea derramado espíritu de lo alto, y el desierto se torne en campo labrado, y el campo labrado sea estimado por bosque.", "words": [[0, 126936], [6, 127162], [10, 127342], [16, 127602], [25, 128042], [29, 128522], [39, 129182], [48, 129782], [51, 130022], [54, 130262], [60, 130502], [62, 131082], [65, 131222], [74, 131802], [77, 132062], [83, 132562], [86, 132782], [92, 133102], [101, 133782], [103, 134242], [106, 134402], [112, 134762], [120, 135302], [124, 135522], [133, 136082], [137, 136282]]}, {"verse": 16, "start": 137369, "end": 143519, "text": "Y habitará el juicio en el desierto, y en el campo labrado asentará la justicia.", "words": [[0, 137369], [2, 137515], [11, 138135], [14, 138355], [21, 138895], [24, 139195], [27, 139335], [37, 140435], [39, 140675], [42, 140795], [45, 140935], [51, 141315], [59, 141955], [68, 142615], [71, 142735]]}, {"verse": 17, "start": 143969, "end": 150386, "text": "Y el efecto de la justicia será paz; y la labor de justicia, reposo y seguridad para siempre.", "words": [[0, 143969], [2, 144098], [5, 144198], [12, 144558], [15, 144798], [18, 144898], [27, 145498], [32, 145778], [37, 146727], [39, 146815], [42, 146935], [48, 147215], [51, 147395], [61, 148035], [68, 148595], [70, 148775], [80, 149315], [85, 149615]]}, {"verse": 18, "start": 150836, "end": 157774, "text": "Y mi pueblo habitará en morada de paz, y en habitaciones seguras, y en recreos de reposo.", "words": [[0, 150836], [2, 150958], [5, 151078], [12, 151478], [21, 152358], [24, 152598], [31, 153038], [34, 153218], [39, 153618], [41, 154238], [44, 154378], [57, 154958], [66, 155738], [68, 156158], [71, 156318], [79, 156918], [82, 157018]]}, {"verse": 19, "start": 158224, "end": 164492, "text": "Y el granizo, cuando descienda, será en los montes; y la ciudad será del todo abatida.", "words": [[0, 158224], [2, 158390], [5, 158490], [14, 159010], [21, 159330], [32, 160050], [37, 160290], [40, 160490], [44, 160630], [52, 161723], [54, 161964], [57, 162084], [64, 162464], [69, 163044], [73, 163304], [78, 163604]]}, {"verse": 20, "start": 164942, "end": 172758, "text": "Dichosos vosotros los que sembráis sobre todas aguas, y metéis en ellas el pie de buey y de asno.", "words": [[0, 164942], [9, 165546], [18, 166026], [22, 166506], [26, 166666], [35, 167266], [41, 167666], [47, 167966], [54, 169066], [56, 169346], [63, 169886], [66, 170166], [72, 170506], [75, 170866], [79, 171146], [82, 171476], [87, 171806], [89, 171986], [92, 172126]]}]}