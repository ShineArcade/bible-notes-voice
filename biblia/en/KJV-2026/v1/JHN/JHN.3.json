[14, 168834], [17, 169034], [23, 169414], [27, 169674], [32, 169914], [35, 170134], [40, 171607], [47, 171863], [50, 172143], [55, 172323], [59, 172483], [64, 172683], [68, 172823], [75, 173123], [83, 173763], [86, 173923], [91, 174103], [95, 174223], [100, 174423], [109, 175143], [117, 175763], [121, 175823], [126, 176003], [136, 176843], [140, 176943], [144, 177183], [148, 177403], [153, 177623], [156, 177823]]}, {"verse": 27, "start": 178344, "end": 183187, "text": "John answered and said, A man can receive nothing, unless it be given him from heaven.", "words": [[0, 178344], [5, 178564], [14, 179004], [18, 179304], [24, 179894], [26, 180001], [30, 180161], [34, 180361], [42, 180661], [51, 181541], [58, 181761], [61, 181961], [64, 182101], [70, 182301], [74, 182521], [79, 182681]]}, {"verse": 28, "start": 183537, "end": 188745, "text": "You yourselves bear me witness, that I said, I am not the Christ, but that I am sent before him.", "words": [[0, 183537], [4, 183661], [15, 183981], [20, 184421], [23, 184581], [32, 184921], [37, 185261], [39, 185381], [45, 185601], [47, 186021], [50, 186161], [54, 186361], [58, 186541], [66, 187141], [70, 187241], [75, 187401], [77, 187541], [80, 187641], [85, 187961], [92, 188341]]}, {"verse": 29, "start": 189095, "end": 199317, "text": "He that has the bride is the bridegroom: but the friend of the bridegroom, which stands and hears him, rejoices greatly because of the bridegroom’s voice: this my joy therefore is fulfilled.", "words": [[0, 189095], [3, 189227], [8, 189407], [12, 189607], [16, 189767], [22, 190087], [25, 190387], [29, 190527], [41, 191486], [45, 191573], [49, 191693], [56, 191933], [59, 192053], [63, 192173], [75, 192693], [81, 192853], [88, 193213], [92, 193473], [98, 193713], [103, 194293], [112, 194893], [120, 195193], [128, 195593], [131, 195753], [135, 195853], [148, 196473], [155, 197172], [160, 197377], [163, 197617], [167, 197897], [177, 198357], [180, 198657]]}, {"verse": 30, "start": 199667, "end": 201