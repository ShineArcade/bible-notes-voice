{"book": "PSA", "chapter": 66, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 124837, "verses": [{"verse": 1, "start": 300, "end": 6878, "text": "Al Músico principal: Cántico: Salmo. ACLAMAD a Dios con alegría, toda la tierra:", "words": [[0, 300], [3, 491], [10, 1051], [21, 2252], [30, 3192], [37, 4468], [45, 4798], [47, 4898], [52, 4998], [56, 5388], [65, 5778], [70, 6018], [73, 6218]]}, {"verse": 2, "start": 7328, "end": 12366, "text": "Cantad la gloria de su nombre: poned gloria en su alabanza.", "words": [[0, 7328], [7, 7888], [10, 8108], [17, 8528], [20, 8648], [23, 8808], [31, 10056], [37, 10362], [44, 10669], [47, 10769], [50, 10929]]}, {"verse": 3, "start": 12816, "end": 19972, "text": "Decid a Dios: ¡Cuán terribles tus obras! Por lo grande de tu fortaleza se someterán a ti tus enemigos.", "words": [[0, 12995], [6, 13180], [8, 13365], [14, 13850], [20, 14154], [30, 14734], [34, 14874], [41, 15905], [45, 16049], [48, 16249], [55, 16609], [58, 16829], [61, 16989], [71, 17809], [74, 17969], [84, 18689], [86, 18749], [89, 18809], [93, 18929]]}, {"verse": 4, "start": 20422, "end": 26709, "text": "Toda la tierra te adorará, y cantará a ti; cantarán a tu nombre. (Selah.)", "words": [[0, 20422], [5, 21034], [8, 21134], [15, 21554], [18, 21794], [27, 22454], [29, 22894], [37, 23514], [39, 23694], [43, 24270], [52, 24935], [54, 25095], [57, 25215], [65, 26431]]}, {"verse": 5, "start": 27159, "end": 33475, "text": "Venid, y ved las obras de Dios, temible en hechos sobre los hijos de los hombres.", "words": [[0, 27159], [7, 27724], [9, 28004], [13, 28244], [17, 28724], [23, 29204], [26, 29484], [32, 30304], [40, 30944], [43, 31184], [50, 31424], [56, 31884], [60, 32124], [66, 32444], [69, 32644], [73, 32764]]}, {"verse": 6, "start": 33925, "end": 40275, "text": "Volvió el mar en seco; por el río pasaron a pie; allí en él nos alegramos.", "words": [[0, 33925], [7, 34391], [10, 34531], [14, 34771], [17, 35111], [23, 36070], [27, 36215], [30, 36375], [34, 36715], [42, 37195], [44, 37315], [49, 37986], [54, 38466], [57, 38806], [60, 39066], [64, 39306]]}, {"verse": 7, "start": 40725, "end": 49653, "text": "Él gobierna para siempre con su poder: sus ojos atalayan sobre las naciones: los rebeldes no serán ensalzados. (Selah.)", "words": [[0, 40725], [3, 40972], [12, 41252], [17, 41812], [25, 42252], [29, 42612], [32, 42812], [39, 43635], [43, 43835], [48, 44345], [57, 44855], [63, 45075], [67, 45355], [77, 46508], [81, 46688], [90, 47248], [93, 47428], [99, 47808], [111, 49375]]}, {"verse": 8, "start": 50103, "end": 54926, "text": "Bendecid, pueblos, a nuestro Dios, y haced oír la voz de su alabanza.", "words": [[0, 50103], [10, 50809], [19, 51389], [21, 51669], [29, 51829], [35, 52249], [37, 52529], [43, 52829], [47, 53289], [50, 53549], [54, 53809], [57, 53989], [60, 54189]]}, {"verse": 9, "start": 55376, "end": 60889, "text": "Él es el que puso nuestra alma en vida, y no permitió que nuestros pies resbalasen.", "words": [[0, 55376], [3, 55683], [6, 56063], [9, 56223], [13, 56363], [18, 56823], [26, 57003], [31, 57463], [34, 57683], [40, 57983], [42, 58163], [45, 58323], [54, 58902], [58, 59043], [67, 59223], [72, 59683]]}, {"verse": 10, "start": 61339, "end": 65639, "text": "Porque tú nos probaste, oh Dios: nos ensayaste como se afina la plata.", "words": [[0, 61339], [7, 61502], [10, 61742], [14, 61862], [24, 62222], [27, 62582], [33, 63299], [37, 63445], [47, 64205], [52, 64465], [55, 64645], [61, 64945], [64, 65085]]}, {"verse": 11, "start": 66089, "end": 70583, "text": "Nos metiste en la red; pusiste pesada carga en nuestros lomos.", "words": [[0, 66089], [4, 66238], [12, 66738], [15, 66898], [18, 67223], [23, 67849], [31, 68294], [38, 68774], [44, 69254], [47, 69454], [56, 69674]]}, {"verse": 12, "start": 71033, "end": 78442, "text": "Hombres hiciste subir sobre nuestra cabeza; entramos en fuego y en aguas, y nos sacaste a abundancia.", "words": [[0, 71033], [8, 71477], [16, 72157], [22, 72517], [28, 72877], [36, 73157], [44, 74263], [53, 74759], [56, 75019], [62, 75299], [64, 75559], [67, 75719], [74, 76299], [76, 76699], [80, 76859], [88, 77149], [90, 77439]]}, {"verse": 13, "start": 78892, "end": 83264, "text": "Entraré en tu casa con holocaustos: te pagaré mis votos,", "words": [[0, 78892], [8, 79668], [11, 79888], [14, 80068], [19, 80368], [23, 81013], [36, 81915], [39, 82160], [46, 82540], [50, 82700]]}, {"verse": 14, "start": 83714, "end": 88194, "text": "Que pronunciaron mis labios, y habló mi boca, cuando angustiado estaba.", "words": [[0, 83714], [4, 83798], [17, 84558], [21, 84758], [29, 85318], [31, 85578], [37, 85938], [40, 86058], [46, 86378], [53, 86758], [64, 87558]]}, {"verse": 15, "start": 88644, "end": 96617, "text": "Holocaustos de cebados te ofreceré, con perfume de carneros: sacrificaré bueyes y machos cabríos. (Selah.)", "words": [[0, 88644], [12, 89491], [15, 89611], [23, 90071], [26, 90231], [36, 90851], [40, 91231], [48, 91751], [51, 92268], [61, 93051], [73, 93794], [80, 94574], [82, 94714], [89, 95267], [98, 96340]]}, {"verse": 16, "start": 97067, "end": 102388, "text": "Venid, oíd todos los que teméis a Dios, y contaré lo que ha hecho a mi alma.", "words": [[0, 97067], [7, 97542], [11, 98052], [17, 98392], [21, 98732], [25, 98912], [32, 99372], [34, 99552], [40, 99792], [42, 100272], [50, 100792], [53, 100932], [57, 101092], [60, 101252], [66, 101512], [68, 101652], [71, 101812]]}, {"verse": 17, "start": 102838, "end": 107341, "text": "A él clamé con mi boca, y ensalzado fue con mi lengua.", "words": [[0, 102838], [2, 103152], [5, 103392], [11, 103792], [15, 104012], [18, 104192], [24, 104552], [26, 105052], [36, 105992], [40, 106232], [44, 106472], [47, 106692]]}, {"verse": 18, "start": 107791, "end": 113714, "text": "Si en mi corazón hubiese yo mirado a la iniquidad, el Señor no me oyera.", "words": [[0, 107791], [3, 107976], [6, 108116], [9, 108276], [17, 108776], [25, 109396], [28, 109636], [35, 110116], [37, 110236], [40, 110356], [51, 111336], [54, 111416], [60, 111776], [63, 112356], [66, 112496]]}, {"verse": 19, "start": 114164, "end": 118317, "text": "Mas ciertamente me oyó Dios; atendió a la voz de mi súplica.", "words": [[0, 114164], [4, 114164], [16, 114988], [19, 115188], [23, 115468], [29, 116326], [37, 116854], [39, 116994], [42, 117094], [46, 117314], [49, 117474], [52, 117574]]}, {"verse": 20, "start": 118767, "end": 124437, "text": "Bendito Dios, que no echó de sí mi oración, ni de mí su misericordia.", "words": [[0, 118767], [8, 119392], [14, 119672], [18, 119952], [21, 120272], [26, 120592], [29, 120792], [32, 121052], [35, 121392], [44, 122412], [47, 122692], [50, 122852], [53, 123052], [56, 123272]]}]}