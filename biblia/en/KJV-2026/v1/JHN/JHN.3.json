": 228386, "text": "The Father loves the Son, and has given all things into his hand.", "words": [[0, 224569], [4, 224717], [11, 225017], [17, 225297], [21, 225537], [26, 225817], [30, 226377], [34, 226557], [40, 226777], [44, 227097], [51, 227417], [56, 227797], [60, 227977]]}, {"verse": 36, "start": 228736, "end": 236993, "text": "He that believes on the Son has everlasting life: and he that believes not the Son shall not see life; but the wrath of God abides on him.", "words": [[0, 228736], [3, 228982], [8, 229302], [17, 229522], [20, 229722], [24, 229882], [28, 230042], [32, 230242], [44, 230582], [50, 231301], [54, 231428], [57, 231628], [62, 231828], [71, 232188], [75, 232688], [79, 232928], [83, 233168], [89, 233488], [93, 233708], [97, 233928], [103, 234484], [107, 234679], [111, 234839], [117, 235099], [120, 235319], [124, 235619], [131, 236359], [134, 236639]]}]}