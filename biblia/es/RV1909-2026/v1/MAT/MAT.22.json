{"book": "MAT", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 297430, "verses": [{"verse": 1, "start": 300, "end": 4951, "text": "Y respondiendo Jesús, les volvió a hablar en parábolas, diciendo:", "words": [[0, 300], [2, 446], [15, 1166], [22, 2186], [26, 2306], [33, 2706], [35, 2766], [42, 2946], [45, 3126], [56, 3806]]}, {"verse": 2, "start": 5301, "end": 9984, "text": "El reino de los cielos es semejante a un rey que celebró la boda de su hijo;", "words": [[0, 5301], [3, 5561], [9, 5981], [12, 6101], [16, 6241], [23, 6741], [26, 6921], [36, 7521], [38, 7641], [41, 7741], [45, 8161], [49, 8241], [57, 8761], [60, 8881], [65, 9141], [68, 9321], [71, 9501]]}, {"verse": 3, "start": 10334, "end": 15757, "text": "Y envió sus siervos para que llamasen los invitados a la boda; pero no quisieron venir.", "words": [[0, 10334], [2, 10473], [8, 10853], [12, 11053], [20, 11733], [25, 11958], [29, 12098], [38, 12618], [42, 12758], [52, 13418], [54, 13558], [57, 13638], [63, 14364], [68, 14509], [71, 14649], [81, 15109]]}, {"verse": 4, "start": 16107, "end": 29331, "text": "Volvió a enviar otros siervos, diciendo: Decid a los llamados: He aquí, he preparado mi comida; mis toros y animales engordados son muertos, y todo está listo: venid a las bodas.", "words": [[0, 16107], [7, 16474], [9, 16534], [16, 16814], [22, 17014], [31, 17654], [41, 18839], [47, 19408], [49, 19588], [53, 19728], [63, 20703], [66, 21155], [72, 21815], [75, 21895], [85, 22475], [88, 22615], [96, 23471], [100, 23635], [106, 24175], [108, 24335], [117, 24755], [128, 25575], [132, 25835], [141, 26515], [143, 26850], [148, 27050], [153, 27270], [160, 28108], [166, 28471], [168, 28551], [172, 28691]]}, {"verse": 5, "start": 29681, "end": 35113, "text": "Pero ellos no hicieron caso, y se fueron, uno a su labranza, y otro a sus negocios;", "words": [[0, 29681], [5, 29805], [11, 30025], [14, 30225], [23, 30605], [29, 31005], [31, 31485], [34, 31625], [42, 31965], [46, 32645], [48, 32865], [51, 32945], [61, 33585], [63, 33765], [68, 33945], [70, 34145], [74, 34225]]}, {"verse": 6, "start": 35463, "end": 40396, "text": "Y otros, tomando a sus siervos, los maltrataron y los mataron.", "words": [[0, 35463], [2, 35622], [9, 35942], [17, 36602], [19, 36722], [23, 36882], [32, 38082], [36, 38182], [48, 39082], [50, 39422], [54, 39562]]}, {"verse": 7, "start": 40746, "end": 50517, "text": "Y el rey, oyendo esto, se enojó; y enviando sus ejércitos, destruyó a aquellos asesinos, y puso fuego a su ciudad.", "words": [[0, 40746], [2, 40906], [5, 41046], [10, 41706], [17, 42186], [23, 42626], [26, 43106], [33, 44150], [35, 44257], [44, 44737], [48, 44977], [59, 45957], [68, 47037], [70, 47257], [79, 47597], [89, 48377], [91, 48817], [96, 49177], [102, 49537], [104, 49757], [107, 49897]]}, {"verse": 8, "start": 50867, "end": 59186, "text": "Entonces dice a sus siervos: Las bodas a la verdad están preparadas; pero los que eran llamados no eran dignos.", "words": [[0, 50867], [9, 51575], [14, 52455], [16, 52635], [20, 52755], [29, 53783], [33, 53930], [39, 54410], [41, 54570], [44, 54670], [51, 54930], [57, 55350], [69, 56822], [74, 56966], [78, 57126], [82, 57306], [87, 57506], [96, 57966], [99, 58166], [104, 58366]]}, {"verse": 9, "start": 59536, "end": 64142, "text": "Id pues a los cruces de los caminos, y llamad a las bodas a cuantos encontréis.", "words": [[0, 59660], [3, 59820], [8, 59980], [10, 60260], [14, 60380], [21, 60800], [24, 60920], [28, 61020], [37, 61560], [39, 61747], [46, 61933], [48, 62120], [52, 62300], [58, 62640], [60, 62760], [68, 63140]]}, {"verse": 10, "start": 64492, "end": 73374, "text": "Y saliendo los siervos por los caminos, juntaron a todos los que hallaron, juntamente malos y buenos: y las bodas fueron llenas de invitados.", "words": [[0, 64492], [2, 64599], [11, 65059], [15, 65239], [23, 65659], [27, 65859], [31, 65999], [40, 66519], [49, 67379], [51, 67519], [57, 67879], [61, 68279], [65, 68439], [75, 68939], [86, 69759], [92, 70259], [94, 70379], [102, 71200], [104, 71325], [108, 71465], [114, 71785], [121, 72005], [128, 72425], [131, 72525]]}, {"verse": 11, "start": 73724, "end": 78277, "text": "Y entró el rey para ver los invitados, y vio allí un hombre no vestido de boda.", "words": [[0, 73724], [2, 73867], [8, 74247], [11, 74387], [15, 74667], [20, 74827], [24, 75047], [28, 75187], [39, 75927], [41, 76167], [45, 76407], [50, 76587], [53, 76807], [60, 77067], [63, 77267], [71, 77687], [74, 77827]]}, {"verse": 12, "start": 78627, "end": 85043, "text": "Y le dijo: Amigo, ¿cómo entraste aquí no teniendo vestido de boda? Pero él se quedó sin palabras.", "words": [[0, 78627], [2, 78754], [5, 78834], [11, 79809], [18, 80149], [24, 80269], [33, 80849], [38, 81049], [41, 81422], [50, 81796], [58, 82169], [61, 82309], [67, 83073], [72, 83235], [75, 83535], [78, 83715], [84, 84015], [88, 84175]]}, {"verse": 13, "start": 85393, "end": 97021, "text": "Entonces el rey dijo a los que servían: Atado de pies y de manos tomadle, y echadle en las tinieblas de afuera: allí será el llanto y el crujir de dientes.", "words": [[0, 85393], [9, 86026], [12, 86486], [16, 86846], [21, 87226], [23, 87366], [27, 87466], [31, 87606], [40, 88516], [46, 88985], [49, 89145], [54, 89405], [56, 89585], [59, 89705], [65, 90135], [74, 90565], [76, 90880], [84, 91600], [87, 91860], [91, 92040], [101, 92700], [104, 92800], [112, 93632], [117, 93931], [122, 94131], [125, 94371], [132, 94931], [134, 95351], [137, 95701], [144, 96051], [147, 96191]]}, {"verse": 14, "start": 97371, "end": 100833, "text": "Porque muchos son llamados, y pocos escogidos.", "words": [[0, 97371], [7, 97555], [14, 97855], [18, 98295], [28, 99015], [30, 99415], [36, 99875]]}, {"verse": 15, "start": 101183, "end": 107084, "text": "Entonces, idos los fariseos, consultaron cómo le tomarían en alguna palabra.", "words": [[0, 101183], [10, 101640], [15, 102440], [19, 102700], [29, 103580], [41, 104620], [46, 104960], [49, 105140], [58, 105800], [61, 106060], [68, 106340]]}, {"verse": 16, "start": 107434, "end": 121680, "text": "Y envían a él los discípulos de ellos, con los Herodianos, diciendo: Maestro, sabemos que eres sincero, y que enseñas con verdad el camino de Dios, y que no te dejas influir por nadie, porque no muestras favoritismo.", "words": [[0, 107434], [2, 107722], [9, 108202], [11, 108342], [14, 108582], [18, 108902], [29, 109582], [32, 109762], [39, 110102], [43, 110622], [47, 110842], [59, 111702], [69, 112909], [78, 113473], [86, 113753], [90, 114093], [95, 114213], [104, 115153], [106, 115293], [110, 115393], [118, 115913], [122, 116053], [129, 116413], [132, 116633], [139, 116913], [142, 117153], [148, 117433], [150, 117933], [154, 118053], [157, 118193], [160, 118353], [166, 118653], [174, 119133], [178, 119293], [185, 119693], [192, 120153], [195, 120353], [204, 120813]]}, {"verse": 17, "start": 122030, "end": 126275, "text": "Dinos pues, ¿qué te parece? ¿es lícito dar tributo a César, o no?", "words": [[0, 122030], [6, 122357], [12, 122797], [17, 122877], [20, 123017], [28, 123836], [32, 123980], [39, 124380], [43, 124780], [51, 125180], [53, 125280], [60, 125720], [62, 125980]]}, {"verse": 18, "start": 126555, "end": 131935, "text": "Pero Jesús, entendida la malicia de ellos, les dice: ¿Por qué me tentáis, hipócritas?", "words": [[0, 126555], [5, 126701], [12, 127281], [22, 127921], [25, 128081], [33, 128521], [36, 128701], [43, 129241], [47, 129341], [53, 130052], [58, 130174], [62, 130421], [65, 130667], [74, 130914]]}, {"verse": 19, "start": 132285, "end": 137066, "text": "Mostradme la moneda del tributo. Y ellos le presentaron un denario.", "words": [[0, 132560], [10, 132870], [13, 132990], [20, 133350], [24, 133550], [33, 134363], [35, 134623], [41, 134983], [44, 135383], [56, 136063], [59, 136383]]}, {"verse": 20, "start": 137416, "end": 142023, "text": "Entonces les dice: ¿De quién son esta imagen y esta inscripción?", "words": [[0, 137416], [9, 137804], [13, 138104], [19, 138865], [23, 139011], [29, 139231], [33, 139571], [38, 139811], [45, 140291], [47, 140631], [52, 140871]]}, {"verse": 21, "start": 142373, "end": 150436, "text": "Le dicen: De César. Y les dice: Pagad pues a César lo que es de César, y a Dios lo que es de Dios.", "words": [[0, 142373], [3, 142519], [10, 143436], [13, 143579], [20, 144458], [22, 144552], [26, 144682], [32, 145432], [38, 145850], [43, 146010], [45, 146230], [51, 146710], [54, 147090], [58, 147250], [61, 147410], [64, 147530], [71, 148150], [73, 148370], [75, 148510], [80, 148730], [83, 149350], [87, 149510], [90, 149730], [93, 149850]]}, {"verse": 22, "start": 150786, "end": 155305, "text": "Y oyendo esto, se maravillaron; y dejándole se fueron.", "words": [[0, 150786], [2, 151109], [9, 151489], [15, 152269], [18, 152429], [32, 153713], [34, 154065], [44, 154455], [47, 154655]]}, {"verse": 23, "start": 155655, "end": 162181, "text": "Aquel día llegaron a él los saduceos, que dicen no haber resurrección, y le preguntaron,", "words": [[0, 155655], [6, 155996], [10, 156216], [19, 156776], [21, 156876], [24, 157076], [28, 157476], [38, 158656], [42, 158851], [48, 159151], [51, 159551], [57, 159831], [71, 160951], [73, 161166], [76, 161266]]}, {"verse": 24, "start": 162531, "end": 171060, "text": "Diciendo: Maestro, Moisés dijo: Si alguno muere sin hijos, su hermano se casará con su mujer, y levantará descendencia a su hermano.", "words": [[0, 162531], [10, 163508], [19, 163953], [26, 164393], [32, 165262], [35, 165403], [42, 165803], [48, 166083], [52, 166323], [59, 167063], [62, 167143], [70, 167583], [73, 167703], [80, 168103], [84, 168283], [87, 168443], [94, 168783], [96, 169203], [106, 169793], [119, 170383], [121, 170483], [124, 170563]]}, {"verse": 25, "start": 171410, "end": 179282, "text": "Hubo pues, entre nosotros siete hermanos: y el primero tomó mujer, y murió; y no teniendo descendencia, dejó su mujer a su hermano.", "words": [[0, 171410], [5, 171870], [11, 172050], [17, 172310], [26, 172630], [32, 173110], [42, 174071], [44, 174177], [47, 174277], [55, 174617], [60, 174977], [67, 175297], [69, 175737], [76, 176412], [78, 176517], [81, 176617], [90, 177057], [104, 177837], [109, 178177], [112, 178277], [118, 178577], [120, 178697], [123, 178777]]}, {"verse": 26, "start": 179632, "end": 183341, "text": "De la misma manera también el segundo, y el tercero, hasta los siete.", "words": [[0, 179632], [3, 179758], [6, 179858], [12, 180058], [19, 180478], [27, 180738], [30, 180998], [39, 181358], [41, 181698], [44, 181798], [53, 182378], [59, 182658], [63, 182838]]}, {"verse": 27, "start": 183691, "end": 185891, "text": "Y después de todos murió también la mujer.", "words": [[0, 183691], [2, 183800], [10, 184080], [13, 184300], [19, 184520], [25, 184980], [33, 185200], [36, 185420]]}, {"verse": 28, "start": 186241, "end": 191581, "text": "En la resurrección pues, ¿de cuál de los siete será ella mujer? porque todos la tuvieron.", "words": [[0, 186241], [3, 186365], [6, 186485], [19, 187125], [25, 188025], [29, 188105], [34, 188325], [37, 188485], [41, 188625], [47, 188865], [52, 189185], [57, 189425], [64, 190224], [71, 190391], [77, 190691], [80, 190971]]}, {"verse": 29, "start": 191861, "end": 199025, "text": "Entonces respondiendo Jesús, les dijo: Erráis ignorando las Escrituras, y el poder de Dios.", "words": [[0, 191861], [9, 192744], [22, 193397], [29, 193737], [33, 194157], [39, 194905], [46, 195540], [56, 196400], [60, 196620], [72, 197320], [74, 197620], [77, 197760], [83, 198120], [86, 198360]]}, {"verse": 30, "start": 199375, "end": 208704, "text": "Porque en la resurrección, ni se casarán ni se darán en casamiento; sino que son como los ángeles de Dios en el cielo.", "words": [[0, 199375], [7, 199759], [10, 200099], [13, 200239], [27, 201119], [30, 201999], [33, 202179], [41, 202789], [44, 203399], [47, 203539], [53, 203919], [56, 204079], [68, 205375], [73, 205612], [77, 205832], [81, 206072], [86, 206372], [90, 206552], [98, 207112], [101, 207312], [106, 207572], [109, 207932], [112, 208072]]}, {"verse": 31, "start": 209054, "end": 215612, "text": "Y de la resurrección de los muertos, ¿no habéis leído lo que os es dicho por Dios, que dice:", "words": [[0, 209054], [2, 209262], [5, 209402], [8, 209582], [21, 210542], [24, 210682], [28, 210822], [37, 211977], [41, 212277], [48, 212657], [54, 213197], [57, 213397], [61, 213577], [64, 213717], [67, 213857], [73, 214177], [77, 214457], [83, 214717], [87, 215137]]}, {"verse": 32, "start": 215962, "end": 224246, "text": "Yo soy el Dios de Abraham, y el Dios de Isaac, y el Dios de Jacob? Dios no es Dios de muertos, sino de vivos.", "words": [[0, 215962], [3, 216166], [7, 216486], [10, 216706], [15, 216946], [18, 217166], [27, 217606], [29, 218141], [32, 218301], [37, 218561], [40, 218781], [47, 219321], [49, 219886], [52, 220046], [57, 220286], [60, 220446], [67, 221239], [72, 221506], [75, 221946], [78, 222166], [83, 222386], [86, 222586], [95, 223306], [100, 223626], [103, 223826]]}, {"verse": 33, "start": 224596, "end": 227940, "text": "Y oyendo esto la gente se admiraba de su doctrina.", "words": [[0, 224596], [2, 224746], [9, 225106], [14, 225386], [17, 225586], [23, 225906], [26, 226206], [35, 226826], [38, 226986], [41, 227166]]}, {"verse": 34, "start": 228290, "end": 235458, "text": "Entonces los fariseos, oyendo que había hecho callar a los saduceos, se juntaron a una.", "words": [[0, 228290], [9, 229027], [13, 229527], [23, 230747], [30, 231107], [34, 231327], [40, 231547], [46, 231867], [53, 232307], [55, 232407], [59, 232587], [69, 233907], [72, 234147], [81, 234707], [83, 234947]]}, {"verse": 35, "start": 235808, "end": 241259, "text": "Y preguntó uno de ellos, experto en la ley, tentándole y diciendo:", "words": [[0, 235808], [2, 235913], [11, 236573], [15, 236913], [18, 237093], [25, 237713], [33, 238433], [36, 238573], [39, 238733], [44, 239373], [55, 240253], [57, 240533]]}, {"verse": 36, "start": 241459, "end": 244218, "text": "Maestro, ¿cuál es el mandamiento grande en la ley?", "words": [[0, 241459], [9, 242258], [15, 242498], [18, 242618], [21, 242738], [33, 243278], [40, 243578], [43, 243818], [46, 243918]]}, {"verse": 37, "start": 244498, "end": 252169, "text": "Y Jesús le dijo: Amarás al Señor tu Dios de todo tu corazón, y de toda tu alma, y de toda tu mente.", "words": [[0, 244498], [2, 244646], [8, 244986], [11, 245326], [17, 246068], [24, 246574], [27, 246754], [33, 247074], [36, 247394], [41, 247774], [44, 248294], [49, 248554], [52, 248794], [61, 249254], [63, 249774], [66, 249894], [71, 250094], [74, 250394], [80, 250714], [82, 251014], [85, 251114], [90, 251354], [93, 251574]]}, {"verse": 38, "start": 252519, "end": 255466, "text": "Este es el primero y el grande mandamiento.", "words": [[0, 252519], [5, 252843], [8, 253043], [11, 253163], [19, 253583], [21, 254003], [24, 254495], [31, 254988]]}, {"verse": 39, "start": 255816, "end": 260999, "text": "Y el segundo es semejante a este: Amarás a tu prójimo como a ti mismo.", "words": [[0, 255816], [2, 255957], [5, 256077], [13, 256497], [16, 256837], [26, 257517], [28, 257717], [34, 258473], [41, 258968], [43, 259108], [46, 259268], [54, 259888], [59, 260128], [61, 260308], [64, 260408]]}, {"verse": 40, "start": 261349, "end": 265487, "text": "De estos dos mandamientos depende toda la ley y los profetas.", "words": [[0, 261349], [3, 261515], [9, 261755], [13, 261995], [26, 262695], [34, 263055], [39, 263615], [42, 263935], [46, 264215], [48, 264395], [52, 264555]]}, {"verse": 41, "start": 265837, "end": 269129, "text": "Y estando juntos los fariseos, Jesús les preguntó,", "words": [[0, 265837], [2, 265935], [10, 266295], [17, 266635], [21, 266895], [31, 267915], [37, 268175], [41, 268435]]}, {"verse": 42, "start": 269479, "end": 275274, "text": "Diciendo: ¿Qué os parece del Cristo? ¿de quién es Hijo? Le dicen: De David.", "words": [[0, 269479], [10, 270476], [15, 270579], [18, 270699], [25, 271059], [29, 271299], [37, 272304], [41, 272449], [47, 272629], [50, 272869], [56, 273614], [59, 273760], [66, 274677], [69, 274860]]}, {"verse": 43, "start": 275554, "end": 280063, "text": "Él les dice: ¿Pues cómo David en Espíritu le llama Señor, diciendo:", "words": [[0, 275554], [3, 275759], [7, 275879], [13, 276715], [19, 276979], [24, 277279], [30, 277579], [33, 277759], [42, 278339], [45, 278439], [51, 278639], [58, 279459]]}, {"verse": 44, "start": 280413, "end": 287457, "text": "Dijo el Señor a mi Señor: Siéntate a mi derecha, entre tanto que pongo tus enemigos por estrado de tus pies?", "words": [[0, 280413], [5, 280681], [8, 280881], [14, 281141], [16, 281381], [19, 281501], [26, 282324], [35, 282831], [37, 282951], [40, 283091], [49, 283951], [55, 284191], [61, 284551], [65, 284791], [71, 285151], [75, 285351], [84, 285851], [88, 286151], [96, 286531], [99, 286711], [103, 286871]]}, {"verse": 45, "start": 287807, "end": 290754, "text": "Pues si David le llama Señor, ¿cómo es su Hijo?", "words": [[0, 287807], [5, 287949], [8, 288129], [14, 288349], [17, 288629], [23, 288929], [30, 289729], [36, 289889], [39, 290129], [42, 290289]]}, {"verse": 46, "start": 291104, "end": 297030, "text": "Y nadie le podía responder palabra; ni se atrevió alguno desde aquel día a preguntarle más.", "words": [[0, 291104], [2, 291233], [8, 291533], [11, 291773], [17, 292073], [27, 292613], [36, 293716], [39, 293896], [42, 294056], [50, 294556], [57, 295036], [63, 295176], [69, 295556], [73, 295756], [75, 295916], [87, 296456]]}]}