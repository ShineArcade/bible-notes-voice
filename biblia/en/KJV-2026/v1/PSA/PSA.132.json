], [39, 55317], [43, 55717], [46, 55877], [56, 56277], [61, 56677], [63, 56797], [69, 56957], [75, 57217], [81, 58017], [87, 58077], [96, 58477], [102, 58677], [107, 58977], [111, 59237], [116, 59497], [121, 59677], [128, 60107], [132, 60537]]}, {"verse": 13, "start": 61542, "end": 65647, "text": "For the LORD has chosen Zion; he has desired it for his habitation.", "words": [[0, 61542], [4, 61641], [8, 61761], [13, 62021], [17, 62221], [24, 62661], [30, 63657], [33, 63775], [37, 63915], [45, 64335], [48, 64555], [52, 64775], [56, 64935]]}, {"verse": 14, "start": 65947, "end": 71008, "text": "This is my rest for ever: here will I dwell; for I have desired it.", "words": [[0, 65947], [5, 66119], [8, 66239], [11, 66399], [16, 66726], [20, 67052], [26, 67904], [31, 68139], [36, 68359], [38, 68499], [45, 69606], [49, 69721], [51, 69861], [56, 69981], [64, 70381]]}, {"verse": 15, "start": 71458, "end": 76057, "text": "I will abundantly bless her provision: I will satisfy her poor with bread.", "words": [[0, 71458], [2, 71565], [7, 71685], [18, 72265], [24, 72485], [28, 72685], [39, 73893], [41, 74012], [46, 74112], [54, 74532], [58, 74792], [63, 75012], [68, 75252]]}, {"verse": 16, "start": 76507, "end": 82051, "text": "I will also clothe her priests with salvation: and her saints shall shout aloud for joy.", "words": [[0, 76507], [2, 76607], [7, 76747], [12, 77027], [19, 77467], [23, 77587], [31, 77947], [36, 78227], [47, 79629], [51, 79749], [55, 79849], [62, 80169], [68, 80429], [74, 80709], [80, 81009], [84, 81229]]}, {"verse": 17, "start": 82501, "end": 87592, "text": "There will I make the horn of David to bud: I have ordained a lamp for my anointed.", "words": [[0, 82501], [6, 82618], [11, 82738], [13, 82878], [18, 83098], [22, 83258], [27, 83498], [30, 83638], [36, 83998], [39, 84198], [44, 85306], [46, 85433], [51, 85553], [60, 85973], [62, 86053], [67, 86293], [71, 86493], [74, 86693]]}, {"verse": 18, "start": 88042, "end": 92631, "text": "His enemies will I cl