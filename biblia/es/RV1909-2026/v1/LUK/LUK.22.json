{"book": "LUK", "chapter": 22, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 505074, "verses": [{"verse": 1, "start": 300, "end": 5579, "text": "Y estaba cerca el día de la fiesta de los panes sin levadura, que se llama la Pascua.", "words": [[0, 300], [2, 385], [9, 665], [15, 1025], [18, 1305], [22, 1465], [25, 1625], [28, 1745], [35, 2125], [38, 2265], [42, 2385], [48, 2825], [52, 3185], [62, 4265], [66, 4385], [69, 4505], [75, 4765], [78, 4925]]}, {"verse": 2, "start": 5929, "end": 12924, "text": "Y los principales sacerdotes y los escribas buscaban cómo le matarían; pero tenían miedo del pueblo.", "words": [[0, 5929], [2, 5994], [6, 6134], [18, 6794], [29, 7594], [31, 7774], [35, 7894], [44, 8514], [53, 9334], [58, 9654], [61, 9794], [71, 10828], [76, 11192], [83, 11532], [89, 11972], [93, 12192]]}, {"verse": 3, "start": 13274, "end": 20502, "text": "Y entró Satanás en Judas, por sobrenombre Iscariote, el cual era uno del número de los doce;", "words": [[0, 13274], [2, 13436], [8, 13856], [16, 14416], [19, 14556], [26, 15616], [30, 15736], [42, 16696], [53, 18016], [56, 18116], [61, 18336], [65, 18596], [69, 18856], [73, 19056], [80, 19456], [83, 19676], [87, 19836]]}, {"verse": 4, "start": 20852, "end": 27441, "text": "Y fue, y habló con los principales sacerdotes, y con los jefes de la guardia, de cómo se lo entregaría.", "words": [[0, 20852], [2, 21016], [7, 21196], [9, 21476], [15, 21836], [19, 21956], [23, 22076], [35, 22876], [47, 23816], [49, 24021], [53, 24181], [57, 24321], [63, 24721], [66, 24801], [69, 24901], [78, 25801], [81, 25881], [86, 26121], [89, 26381], [92, 26501]]}, {"verse": 5, "start": 27792, "end": 31311, "text": "Los cuales se alegraron, y acordaron darle dinero.", "words": [[0, 27792], [4, 27900], [11, 28160], [14, 28460], [25, 29180], [27, 29680], [37, 30280], [43, 30520]]}, {"verse": 6, "start": 31661, "end": 38791, "text": "Y prometió, y buscaba oportunidad para entregarle a ellos sin la multitud presente.", "words": [[0, 31661], [2, 31825], [12, 32945], [14, 33165], [22, 33645], [34, 34525], [39, 35025], [50, 35885], [52, 36005], [58, 36365], [62, 36945], [65, 37225], [74, 37785]]}, {"verse": 7, "start": 39141, "end": 45761, "text": "Y vino el día de los panes sin levadura, en el cual era necesario sacrificar el cordero de la Pascua.", "words": [[0, 39141], [2, 39246], [7, 39466], [10, 39646], [14, 39826], [17, 39966], [21, 40106], [27, 40546], [31, 40786], [41, 41806], [44, 41966], [47, 42086], [52, 42306], [56, 42686], [66, 43326], [77, 44166], [80, 44286], [88, 44826], [91, 44966], [94, 45066]]}, {"verse": 8, "start": 46111, "end": 51031, "text": "Y envió a Pedro y a Juan, diciendo: Id, preparadnos la pascua para que comamos.", "words": [[0, 46111], [2, 46271], [8, 46691], [10, 46831], [16, 47131], [18, 47391], [20, 47471], [26, 47741], [36, 48141], [40, 48271], [52, 49291], [55, 49431], [62, 49951], [67, 50131], [71, 50291]]}, {"verse": 9, "start": 51381, "end": 54650, "text": "Y ellos le dijeron: ¿Dónde quieres que preparemos?", "words": [[0, 51381], [2, 51528], [8, 51829], [11, 52168], [20, 53069], [27, 53356], [35, 53656], [39, 53836]]}, {"verse": 10, "start": 54930, "end": 64278, "text": "Y él les dijo: He aquí cuando entréis en la ciudad, os encontrará un hombre que lleva un cántaro de agua: seguidle hasta la casa donde entre,", "words": [[0, 54930], [2, 55126], [5, 55266], [9, 55466], [15, 56287], [18, 56367], [23, 56587], [30, 56867], [38, 57467], [41, 57627], [44, 57767], [52, 58127], [55, 58507], [66, 59227], [69, 59407], [76, 59647], [80, 59827], [86, 60087], [89, 60307], [97, 60867], [100, 61067], [106, 61764], [115, 62403], [121, 62743], [124, 62943], [129, 63183], [135, 63503]]}, {"verse": 11, "start": 64628, "end": 72809, "text": "Y decid al dueño de la casa: El Maestro te dice: ¿Dónde está el aposento donde tengo de comer la pascua con mis discípulos?", "words": [[0, 64628], [2, 64749], [8, 65069], [11, 65489], [17, 65889], [20, 65989], [23, 66109], [29, 66985], [32, 67135], [40, 67675], [43, 67855], [49, 68606], [56, 68994], [61, 69194], [64, 69354], [73, 69834], [79, 70074], [85, 70454], [88, 70614], [94, 70874], [97, 71204], [104, 71534], [108, 71674], [112, 71874]]}, {"verse": 12, "start": 73159, "end": 79283, "text": "Entonces él os mostrará una gran sala amueblada en el piso de arriba; preparad allí.", "words": [[0, 73159], [9, 73846], [12, 74246], [15, 74491], [24, 75111], [28, 75271], [33, 75491], [38, 76011], [48, 76531], [51, 76691], [54, 76831], [59, 77331], [62, 77471], [70, 78317], [79, 78805]]}, {"verse": 13, "start": 79633, "end": 84181, "text": "Fueron pues, y hallaron como les había dicho; y prepararon la pascua.", "words": [[0, 79633], [7, 79919], [13, 80359], [15, 80684], [24, 81104], [29, 81464], [33, 81684], [39, 82024], [46, 82894], [48, 83003], [59, 83683], [62, 83932]]}, {"verse": 14, "start": 84531, "end": 89013, "text": "Y como fue hora, se sentó a la mesa, y con él los apóstoles.", "words": [[0, 84531], [2, 84854], [7, 85074], [11, 85484], [17, 85894], [20, 85994], [26, 86414], [28, 86494], [31, 86574], [37, 86854], [39, 87294], [43, 87534], [46, 87734], [50, 87994]]}, {"verse": 15, "start": 89363, "end": 95658, "text": "Y les dijo: En gran manera he deseado comer con vosotros esta pascua antes que padezca;", "words": [[0, 89363], [2, 89487], [6, 89627], [12, 90358], [15, 90525], [20, 90765], [27, 91245], [30, 91445], [38, 91985], [44, 92325], [48, 92585], [57, 93285], [62, 93665], [69, 94185], [75, 94625], [79, 94885]]}, {"verse": 16, "start": 96008, "end": 101598, "text": "Porque os digo que no comeré más de ella, hasta que se cumpla en el reino de Dios.", "words": [[0, 96008], [7, 96401], [10, 96561], [15, 96781], [19, 96961], [22, 97121], [29, 97561], [33, 97821], [36, 98041], [42, 98361], [48, 98841], [52, 99021], [55, 99161], [62, 99801], [65, 100281], [68, 100441], [74, 100841], [77, 101001]]}, {"verse": 17, "start": 101948, "end": 108354, "text": "Y tomando la copa, habiendo dado gracias, dijo: Tomad esto, y repartidlo entre vosotros;", "words": [[0, 101948], [2, 102093], [10, 102573], [13, 102753], [19, 103353], [28, 103693], [33, 103953], [42, 104793], [48, 105595], [54, 105979], [60, 106359], [62, 106831], [73, 107304], [79, 107724]]}, {"verse": 18, "start": 108704, "end": 114213, "text": "Porque os digo, que no beberé más del fruto de la vid, hasta que el reino de Dios venga.", "words": [[0, 108704], [7, 108925], [10, 109065], [16, 109285], [20, 109665], [23, 109865], [30, 110345], [34, 110565], [38, 110955], [44, 111345], [47, 111465], [50, 111625], [55, 111785], [61, 112305], [65, 112485], [68, 112625], [74, 113005], [77, 113165], [82, 113405]]}, {"verse": 19, "start": 114563, "end": 125374, "text": "Y tomando el pan, habiendo dado gracias, partió, y les dio, diciendo: Esto es mi cuerpo, que por vosotros es dado: haced esto en memoria de mí.", "words": [[0, 114563], [2, 114680], [10, 115100], [13, 115260], [18, 115800], [27, 116340], [32, 116600], [41, 117640], [49, 118320], [51, 118800], [55, 118980], [60, 119442], [70, 120484], [75, 120677], [78, 120817], [81, 120917], [89, 121277], [93, 121537], [97, 121757], [106, 122317], [109, 122517], [115, 123425], [121, 123625], [126, 124185], [129, 124365], [137, 124845], [140, 125025]]}, {"verse": 20, "start": 125724, "end": 136317, "text": "Asimismo también la copa, después que hubo cenado, diciendo: Esta copa es el nuevo pacto en mi sangre, que por vosotros se derrama.", "words": [[0, 125985], [9, 126275], [17, 127274], [20, 127438], [26, 127878], [34, 128158], [38, 128358], [43, 128758], [51, 129158], [61, 130661], [66, 130923], [71, 131463], [74, 131603], [77, 131783], [83, 132123], [89, 132823], [92, 132923], [95, 133083], [103, 133503], [107, 133983], [111, 134743], [120, 135283], [123, 135543]]}, {"verse": 21, "start": 136667, "end": 140829, "text": "Con todo eso, he aquí la mano del que me entrega, conmigo en la mesa.", "words": [[0, 136667], [4, 136809], [9, 137089], [14, 137429], [17, 137749], [22, 138029], [25, 138189], [30, 138369], [34, 138549], [38, 138729], [41, 138909], [50, 139589], [58, 140049], [61, 140149], [64, 140269]]}, {"verse": 22, "start": 141179, "end": 149013, "text": "Y a la verdad el Hijo del hombre va, según lo que está determinado; pero ¡ay de aquel hombre por el cual es entregado!", "words": [[0, 141179], [2, 141276], [4, 141316], [7, 141436], [14, 141876], [17, 142416], [22, 142716], [26, 142876], [33, 143256], [37, 143456], [43, 143916], [46, 144216], [50, 144356], [55, 144576], [68, 145786], [73, 146074], [77, 146394], [80, 146614], [86, 146894], [93, 147134], [97, 147434], [100, 147574], [105, 147814], [108, 148074]]}, {"verse": 23, "start": 149363, "end": 156034, "text": "Ellos entonces comenzaron a preguntar entre sí, cuál de ellos sería el que había de hacer esto.", "words": [[0, 149363], [6, 149795], [15, 150455], [26, 151415], [28, 151495], [38, 152115], [44, 152375], [48, 152735], [53, 153495], [56, 153755], [62, 153995], [68, 154305], [71, 154615], [75, 154735], [81, 154955], [84, 155175], [90, 155415]]}, {"verse": 24, "start": 156384, "end": 160639, "text": "Y hubo entre ellos una disputa, quién de ellos parecía ser el mayor.", "words": [[0, 156384], [2, 156544], [7, 156884], [13, 157104], [19, 157424], [23, 157664], [32, 158424], [38, 158684], [41, 158784], [47, 159064], [55, 159644], [59, 159924], [62, 160044]]}, {"verse": 25, "start": 160989, "end": 171265, "text": "Entonces él les dijo: Los reyes de las naciones dominan sobre ellas; y los que sobre ellas tienen autoridad, son llamados bienhechores:", "words": [[0, 160989], [9, 161814], [12, 161954], [16, 162174], [22, 162912], [26, 163058], [32, 163458], [35, 163578], [39, 163738], [48, 164258], [56, 165118], [62, 165418], [69, 166406], [71, 166533], [75, 166673], [79, 166853], [85, 167173], [91, 167433], [98, 167933], [109, 168873], [113, 169433], [122, 170013]]}, {"verse": 26, "start": 171615, "end": 180487, "text": "Pero vosotros, no así: antes el que es mayor entre vosotros, sea como el más joven; y el que dirige, como el que sirve.", "words": [[0, 171615], [5, 171782], [15, 172822], [18, 172902], [23, 173607], [29, 174107], [32, 174487], [36, 174647], [39, 174807], [45, 175167], [51, 175467], [61, 176107], [65, 176807], [70, 177107], [73, 177247], [77, 177387], [84, 178206], [86, 178330], [89, 178480], [93, 178640], [101, 179220], [106, 179510], [109, 179800], [113, 179880]]}, {"verse": 27, "start": 180837, "end": 190792, "text": "Porque, ¿cuál es mayor, el que se sienta a la mesa, o el que sirve? ¿No es el que se sienta a la mesa? Y yo soy entre vosotros como el que sirve.", "words": [[0, 180999], [8, 181199], [14, 181819], [17, 181979], [24, 182399], [27, 182719], [31, 182899], [34, 183059], [41, 183619], [43, 183699], [46, 183819], [52, 184159], [54, 184504], [57, 184624], [61, 184744], [68, 185649], [72, 185839], [75, 186159], [78, 186439], [82, 186579], [85, 186719], [92, 187239], [94, 187339], [97, 187419], [103, 188202], [105, 188330], [108, 188510], [112, 188810], [118, 189070], [127, 189690], [132, 189950], [135, 190130], [139, 190230]]}, {"verse": 28, "start": 191142, "end": 196431, "text": "Pero vosotros sois los que habéis permanecido conmigo en mis tentaciones:", "words": [[0, 191142], [5, 191306], [14, 191866], [19, 192946], [23, 193446], [27, 193606], [34, 193846], [46, 194586], [54, 195066], [57, 195206], [61, 195346]]}, {"verse": 29, "start": 196781, "end": 202202, "text": "Yo pues os concedo un reino, como mi Padre me lo concedió a mí,", "words": [[0, 196781], [3, 197222], [8, 197542], [11, 197982], [19, 198522], [22, 198622], [29, 199362], [34, 199882], [37, 200082], [43, 200502], [46, 200922], [49, 201042], [58, 201702], [60, 201822]]}, {"verse": 30, "start": 202552, "end": 211285, "text": "Para que comáis y bebáis en mi mesa en mi reino, y os sentéis sobre tronos juzgando a las doce tribus de Israel.", "words": [[0, 202552], [5, 202713], [9, 202893], [16, 203633], [18, 203993], [25, 204433], [28, 204653], [31, 204813], [36, 205093], [39, 205293], [42, 205433], [49, 205822], [51, 206210], [54, 206599], [62, 206988], [68, 207328], [75, 208148], [84, 208868], [86, 209028], [90, 209168], [95, 209588], [102, 210228], [105, 210368]]}, {"verse": 31, "start": 211635, "end": 219024, "text": "Dijo también el Señor: Simón, Simón, he aquí Satanás os ha pedido para zarandaros como a trigo;", "words": [[0, 211635], [5, 212121], [13, 212441], [16, 212721], [23, 213478], [30, 213882], [37, 214532], [40, 215182], [45, 215562], [53, 216502], [56, 216602], [59, 216722], [66, 217122], [71, 217362], [82, 218142], [87, 218456], [89, 218770]]}, {"verse": 32, "start": 219374, "end": 226235, "text": "Pero yo he rogado por ti que tu fe no falte: y tú, una vez vuelto, fortalece a tus hermanos.", "words": [[0, 219374], [5, 219715], [8, 219915], [11, 220195], [18, 220475], [22, 220735], [25, 221015], [29, 221155], [32, 221335], [35, 221595], [38, 221695], [45, 222647], [47, 222786], [51, 223026], [55, 223426], [59, 223766], [67, 224326], [77, 225126], [79, 225206], [83, 225346]]}, {"verse": 33, "start": 226585, "end": 231382, "text": "Y él le dijo: Señor, estoy dispuesto a ir contigo aun a cárcel y a muerte.", "words": [[0, 226585], [2, 226791], [5, 226931], [8, 227051], [14, 227769], [21, 228465], [27, 228665], [37, 229165], [39, 229325], [42, 229405], [50, 229665], [54, 229925], [56, 230185], [63, 230665], [65, 230825], [67, 230845]]}, {"verse": 34, "start": 231662, "end": 238374, "text": "Y él dijo: Pedro, te digo que el gallo no cantará hoy antes que tú niegues tres veces que me conoces.", "words": [[0, 231662], [2, 231807], [5, 231927], [11, 232588], [18, 233433], [21, 233613], [26, 233873], [30, 234053], [33, 234153], [39, 234433], [42, 234573], [50, 235113], [54, 235393], [60, 235753], [64, 235973], [67, 236173], [75, 236613], [80, 236833], [86, 237213], [90, 237413], [93, 237553]]}, {"verse": 35, "start": 238724, "end": 248098, "text": "Y a ellos dijo: Cuando os envié sin bolsa, y sin bolsa de viaje, y sin zapatos, ¿os faltó algo? Y ellos dijeron: Nada.", "words": [[0, 238724], [2, 238871], [4, 238951], [10, 239111], [16, 239931], [23, 240236], [26, 240576], [32, 240916], [36, 241056], [43, 241576], [45, 241696], [49, 241876], [55, 242316], [58, 242416], [65, 242716], [67, 242996], [71, 243156], [80, 244196], [84, 244356], [90, 244816], [96, 245571], [98, 245712], [104, 245892], [113, 246894]]}, {"verse": 36, "start": 248378, "end": 257164, "text": "Y les dijo: Pues ahora, el que tiene bolsa, tómela, y también la bolsa de viaje, y el que no tiene, venda su capa y compre espada.", "words": [[0, 248378], [2, 248502], [6, 248642], [12, 249373], [17, 249518], [24, 249918], [27, 250478], [31, 250618], [37, 250838], [44, 251563], [52, 251943], [54, 252323], [62, 252603], [65, 252783], [71, 253103], [74, 253223], [81, 253563], [83, 254043], [86, 254143], [90, 254263], [93, 254423], [100, 255143], [106, 255403], [109, 255583], [114, 256003], [116, 256083], [123, 256483]]}, {"verse": 37, "start": 257514, "end": 266892, "text": "Porque os digo, que es necesario que se cumpla todavía en mí aquello que está escrito: Y con los malos fue contado: porque lo que está escrito de mí, cumplimiento tiene.", "words": [[0, 257514], [7, 257736], [10, 257896], [16, 258096], [20, 258336], [23, 258516], [33, 259236], [37, 259436], [40, 259576], [47, 260036], [55, 260356], [58, 260656], [61, 260796], [69, 261416], [73, 261536], [78, 261676], [87, 262459], [89, 262537], [93, 262697], [97, 262857], [103, 263177], [107, 263337], [116, 264223], [123, 264407], [126, 264587], [130, 264707], [135, 264847], [143, 265167], [146, 265427], [150, 265587], [163, 266247]]}, {"verse": 38, "start": 267242, "end": 273095, "text": "Entonces ellos dijeron: Señor, he aquí dos espadas. Y él les dijo: Basta.", "words": [[0, 267242], [9, 267758], [15, 268158], [24, 269172], [31, 269690], [34, 269770], [39, 270010], [43, 270190], [52, 271234], [54, 271430], [57, 271570], [61, 271770], [67, 272545]]}, {"verse": 39, "start": 273445, "end": 279406, "text": "Y saliendo, se fue, como solía, al monte de los Olivos; y sus discípulos también le siguieron.", "words": [[0, 273445], [2, 273635], [12, 274175], [15, 274375], [20, 274655], [25, 274975], [32, 275475], [35, 275735], [41, 276015], [44, 276275], [48, 276415], [56, 277337], [58, 277445], [62, 277585], [73, 278205], [81, 278485], [84, 278705]]}, {"verse": 40, "start": 279756, "end": 285122, "text": "Y cuando llegó a aquel lugar, les dijo: Orad que no entréis en tentación.", "words": [[0, 279756], [2, 279888], [9, 280188], [15, 280588], [17, 280928], [23, 281268], [30, 281908], [34, 282088], [40, 282835], [45, 283239], [49, 283414], [52, 283594], [60, 284074], [63, 284254]]}, {"verse": 41, "start": 285472, "end": 290345, "text": "Y él se apartó de ellos como un tiro de piedra; y puesto de rodillas oró,", "words": [[0, 285472], [2, 285622], [5, 285762], [8, 285922], [15, 286462], [18, 286602], [24, 286882], [29, 287202], [32, 287422], [37, 287702], [40, 287902], [48, 288743], [50, 288978], [57, 289238], [60, 289498], [69, 289998]]}, {"verse": 42, "start": 290345, "end": 297859, "text": "Diciendo: Padre, si quieres, aparta esta copa de mí; pero no se haga mi voluntad, sino la tuya.", "words": [[0, 290418], [10, 291851], [17, 292428], [20, 292648], [29, 293358], [36, 294068], [41, 294248], [46, 294668], [49, 294788], [53, 295277], [58, 295443], [61, 295623], [64, 295803], [69, 295983], [72, 296163], [82, 296783], [87, 297083], [90, 297323]]}, {"verse": 43, "start": 298209, "end": 301501, "text": "Y le apareció un ángel del cielo confortándole.", "words": [[0, 298209], [2, 298334], [5, 298434], [14, 299034], [17, 299314], [23, 299754], [27, 299914], [33, 300314]]}, {"verse": 44, "start": 301851, "end": 310625, "text": "Y estando en agonía, oraba más intensamente: y fue su sudor como grandes gotas de sangre que caían hasta la tierra.", "words": [[0, 301851], [2, 302031], [10, 302471], [13, 302631], [21, 303691], [27, 304251], [31, 304551], [45, 305954], [47, 306076], [51, 306256], [54, 306476], [60, 306916], [65, 307156], [73, 307636], [79, 308256], [82, 308396], [89, 308836], [93, 309056], [99, 309516], [105, 309796], [108, 309976]]}, {"verse": 45, "start": 310975, "end": 316982, "text": "Y como se levantó de la oración, y vino a sus discípulos, los halló durmiendo de tristeza;", "words": [[0, 310975], [2, 311212], [7, 311412], [10, 311592], [18, 312072], [21, 312325], [24, 312579], [33, 312832], [35, 313232], [40, 313472], [42, 313632], [46, 313812], [58, 314832], [62, 314992], [68, 315412], [78, 315972], [81, 316132]]}, {"verse": 46, "start": 317332, "end": 322807, "text": "Y les dijo: ¿Por qué dormís? Levantaos, y orad que no entréis en tentación.", "words": [[0, 317332], [2, 317456], [6, 317596], [12, 318327], [17, 318451], [21, 318651], [29, 319640], [40, 320411], [42, 320631], [47, 320951], [51, 321151], [54, 321331], [62, 321871], [65, 322011]]}, {"verse": 47, "start": 323157, "end": 333861, "text": "Estando él aún hablando, he aquí una turba; y el que se llamaba Judas, uno de los doce, iba delante de ellos; y se acercó hasta Jesús para besarlo.", "words": [[0, 323157], [8, 323604], [11, 323904], [15, 324204], [25, 324504], [28, 324804], [33, 325004], [37, 325244], [44, 326123], [46, 326344], [49, 326464], [53, 326584], [56, 326744], [64, 327124], [71, 327964], [75, 328364], [78, 328524], [82, 328664], [88, 329464], [92, 329744], [100, 330204], [103, 330384], [110, 331206], [112, 331329], [115, 331469], [122, 332069], [128, 332309], [134, 332689], [139, 333303]]}, {"verse": 48, "start": 334211, "end": 339703, "text": "Entonces Jesús le dijo: Judas, ¿con beso entregas al Hijo del hombre?", "words": [[0, 334211], [9, 334618], [15, 335158], [18, 335498], [24, 336248], [31, 337188], [36, 337608], [41, 338028], [50, 338588], [53, 338748], [58, 338988], [62, 339188]]}, {"verse": 49, "start": 340053, "end": 346349, "text": "Y viendo los que estaban con él lo que había de ser, le dijeron: Señor, ¿heriremos con la espada?", "words": [[0, 340053], [2, 340200], [9, 340540], [13, 340740], [17, 340880], [25, 341200], [29, 341500], [32, 341740], [35, 342060], [39, 342200], [45, 342420], [48, 342620], [53, 343200], [56, 343360], [65, 344340], [72, 345058], [83, 345558], [87, 345718], [90, 345818]]}, {"verse": 50, "start": 346629, "end": 352730, "text": "Y uno de ellos hirió a un siervo del sumo sacerdote, y le quitó la oreja derecha.", "words": [[0, 346629], [2, 346809], [6, 347049], [9, 347209], [15, 347549], [21, 348089], [23, 348309], [26, 348469], [33, 349009], [37, 349129], [42, 349649], [53, 350389], [55, 350809], [58, 350949], [64, 351469], [67, 351669], [73, 352069]]}, {"verse": 51, "start": 353080, "end": 359597, "text": "Entonces respondiendo Jesús, dijo: Dejad hasta aquí. Y tocando su oreja, le sanó.", "words": [[0, 353080], [9, 353792], [22, 354612], [29, 354792], [35, 355691], [41, 356187], [47, 356507], [53, 357363], [55, 357469], [63, 357889], [66, 358149], [73, 359029], [76, 359129]]}, {"verse": 52, "start": 359947, "end": 372886, "text": "Y Jesús dijo a los que habían venido a él, los principales sacerdotes, y los jefes de la guardia del templo, y los ancianos: ¿Como a ladrón habéis salido con espadas y con palos?", "words": [[0, 359947], [2, 360074], [8, 360474], [13, 360974], [15, 361294], [19, 361434], [23, 361594], [30, 361914], [37, 362394], [39, 362554], [43, 363334], [47, 363494], [59, 364194], [71, 364994], [73, 365494], [77, 365634], [83, 366014], [86, 366094], [89, 366194], [97, 366534], [101, 366694], [109, 367254], [111, 367734], [115, 367874], [125, 368989], [131, 369156], [133, 369356], [140, 369856], [147, 370516], [154, 371156], [158, 371376], [166, 371856], [168, 372056], [172, 372236]]}, {"verse": 53, "start": 373236, "end": 383317, "text": "Habiendo estado con vosotros cada día en el templo, no extendisteis las manos contra mí; pero esta es vuestra hora, y la potestad de las tinieblas.", "words": [[0, 373236], [9, 373562], [16, 373862], [20, 374202], [29, 374702], [34, 374922], [38, 375242], [41, 375402], [44, 375542], [52, 376562], [55, 376702], [68, 378082], [72, 378402], [78, 378782], [85, 379122], [89, 379702], [94, 379849], [99, 380109], [102, 380249], [110, 380629], [116, 380949], [118, 381184], [121, 381324], [130, 381924], [133, 382044], [137, 382184]]}, {"verse": 54, "start": 383667, "end": 391026, "text": "Y prendiéndole le trajeron, y le metieron en casa del sumo sacerdote. Y Pedro le seguía de lejos.", "words": [[0, 383667], [2, 383791], [15, 384811], [18, 385111], [28, 385951], [30, 386136], [33, 386236], [42, 386696], [45, 386896], [50, 387196], [54, 387436], [59, 387916], [70, 389022], [72, 389290], [78, 389610], [81, 389830], [88, 390230], [91, 390330]]}, {"verse": 55, "start": 391376, "end": 399691, "text": "Y habiendo encendido fuego en medio del patio, y sentándose todos alrededor, se sentó también Pedro entre ellos.", "words": [[0, 391376], [2, 391481], [11, 391881], [21, 392561], [27, 392921], [30, 393301], [36, 393581], [40, 393801], [47, 394821], [49, 394901], [60, 395701], [66, 396081], [77, 397461], [80, 397601], [86, 398021], [94, 398301], [100, 398781], [106, 399101]]}, {"verse": 56, "start": 400041, "end": 407663, "text": "Y como una criada le vio que estaba sentado al fuego, se fijó en él, y dijo: Y este con él estaba.", "words": [[0, 400041], [2, 400166], [7, 400406], [11, 400646], [18, 401206], [21, 401386], [25, 401646], [29, 401766], [36, 402216], [44, 402666], [47, 402806], [54, 403766], [57, 404006], [62, 404446], [65, 404626], [69, 404906], [71, 405201], [77, 405974], [79, 406121], [84, 406421], [88, 406701], [91, 406901]]}, {"verse": 57, "start": 407943, "end": 412387, "text": "Entonces él lo negó, diciendo: Mujer, no le conozco.", "words": [[0, 407943], [9, 408388], [12, 408888], [15, 409188], [21, 409648], [31, 411023], [38, 411363], [41, 411663], [44, 411783]]}, {"verse": 58, "start": 412667, "end": 419613, "text": "Y un poco después, viéndole otro, dijo: Y tú de ellos eras. Y Pedro dijo: Hombre, no soy.", "words": [[0, 412667], [2, 412770], [5, 412890], [10, 413110], [19, 414010], [28, 414430], [34, 415150], [40, 415791], [42, 415913], [45, 416133], [48, 416333], [54, 416553], [60, 417434], [62, 417558], [68, 417898], [74, 418801], [82, 419002], [85, 419202]]}, {"verse": 59, "start": 419893, "end": 427356, "text": "Y como una hora pasada otro afirmaba, diciendo: Verdaderamente también este estaba con él, porque es galileo.", "words": [[0, 419893], [2, 420022], [7, 420282], [11, 420522], [16, 420922], [23, 421322], [28, 421542], [38, 422802], [48, 423860], [63, 424596], [71, 424856], [76, 425216], [83, 425516], [87, 425796], [91, 426416], [98, 426656], [101, 426776]]}, {"verse": 60, "start": 427636, "end": 434422, "text": "Y Pedro dijo: Hombre, no sé qué dices. Y enseguida, estando él aún hablando, el gallo cantó.", "words": [[0, 427636], [2, 427760], [8, 428100], [14, 429003], [22, 429385], [25, 429445], [28, 429625], [32, 429725], [39, 430641], [41, 430768], [52, 431328], [60, 431768], [63, 431968], [67, 432148], [77, 433268], [80, 433408], [86, 433828]]}, {"verse": 61, "start": 434772, "end": 445814, "text": "Entonces, vuelto el Señor, miró a Pedro: y Pedro se acordó de la palabra del Señor como le había dicho: Antes que el gallo cante, me negarás tres veces.", "words": [[0, 434772], [10, 435372], [17, 436152], [20, 436312], [27, 437432], [32, 437772], [34, 437852], [41, 438152], [43, 438372], [49, 438732], [52, 439132], [59, 439612], [62, 439712], [65, 439812], [73, 440112], [77, 440372], [83, 440672], [88, 441292], [91, 441452], [97, 441672], [104, 442470], [110, 442814], [114, 443014], [117, 443154], [123, 443584], [130, 444014], [133, 444354], [141, 444694], [146, 444954]]}, {"verse": 62, "start": 446164, "end": 449420, "text": "Y saliendo fuera Pedro, lloró amargamente.", "words": [[0, 446164], [2, 446269], [11, 446729], [17, 446969], [24, 447929], [30, 448309]]}, {"verse": 63, "start": 449770, "end": 454169, "text": "Y los hombres que tenían a Jesús, se burlaban de él hiriéndole;", "words": [[0, 449770], [2, 449875], [6, 450035], [14, 450375], [18, 450555], [25, 450895], [27, 451115], [34, 451495], [37, 452055], [46, 452655], [49, 452915], [52, 453570]]}, {"verse": 64, "start": 454519, "end": 461833, "text": "Y cubriéndole, herían su rostro, y le preguntaban, diciendo: Profetiza quién es el que te hirió.", "words": [[0, 454519], [2, 454682], [15, 455402], [22, 456122], [25, 456282], [33, 457322], [35, 457402], [38, 457522], [51, 458282], [61, 459901], [71, 460485], [77, 460725], [80, 460945], [83, 461045], [87, 461185], [90, 461530]]}, {"verse": 65, "start": 462113, "end": 465013, "text": "Y decían otras muchas cosas injuriándole.", "words": [[0, 462113], [2, 462223], [9, 462703], [15, 462983], [22, 463363], [28, 464216]]}, {"verse": 66, "start": 465363, "end": 473567, "text": "Al amanecer, se juntaron los ancianos del pueblo, y los principales sacerdotes, y los escribas, y le trajeron a su Consejo,", "words": [[0, 465363], [3, 465563], [13, 466183], [16, 466383], [25, 466943], [29, 467123], [38, 467643], [42, 467783], [50, 468283], [52, 468743], [56, 468883], [68, 469583], [80, 470463], [82, 470683], [86, 470803], [96, 471503], [98, 471843], [101, 471963], [110, 472543], [112, 472623], [115, 472763]]}, {"verse": 67, "start": 473917, "end": 480814, "text": "Y le preguntaron: ¿Eres tú el Cristo? dínoslo. Y les dijo: Si os lo digo, no creeréis;", "words": [[0, 473917], [2, 474016], [5, 474136], [18, 475318], [24, 475498], [27, 475798], [30, 475938], [38, 476758], [47, 477626], [49, 477750], [53, 477890], [59, 478621], [62, 478971], [65, 479131], [68, 479291], [74, 479651], [77, 479791]]}, {"verse": 68, "start": 481164, "end": 485875, "text": "Y también si os pregunto, no me responderíais ni me soltaríais.", "words": [[0, 481164], [2, 481271], [10, 481551], [13, 481811], [16, 481891], [26, 482671], [29, 482971], [32, 483151], [46, 484211], [49, 484651], [52, 485288]]}, {"verse": 69, "start": 486225, "end": 491087, "text": "Pero desde ahora el Hijo del hombre se sentará a la diestra del poder de Dios.", "words": [[0, 486225], [5, 486370], [11, 486650], [17, 487030], [20, 487250], [25, 487530], [29, 487670], [36, 488070], [39, 488190], [47, 488770], [49, 489010], [52, 489090], [60, 489590], [64, 489830], [70, 490190], [73, 490430]]}, {"verse": 70, "start": 491437, "end": 498386, "text": "Y dijeron todos: ¿Entonces tú eres Hijo de Dios? Y él les dijo: Vosotros decís que yo soy.", "words": [[0, 491437], [2, 491604], [10, 492124], [17, 493164], [27, 493686], [30, 493946], [35, 494106], [40, 494386], [43, 494546], [49, 495358], [51, 495554], [54, 495694], [58, 495894], [64, 496670], [73, 497136], [79, 497616], [83, 497716], [86, 497896]]}, {"verse": 71, "start": 498736, "end": 504674, "text": "Entonces ellos dijeron: ¿Qué más testimonio deseamos? porque nosotros lo hemos oído de su boca.", "words": [[0, 498736], [9, 499253], [15, 499653], [24, 500667], [29, 500771], [33, 500951], [44, 501551], [54, 502553], [61, 502717], [70, 503057], [73, 503377], [79, 503517], [84, 503897], [87, 504057], [90, 504197]]}]}