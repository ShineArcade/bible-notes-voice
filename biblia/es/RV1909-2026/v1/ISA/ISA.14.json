{"book": "ISA", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 306014, "verses": [{"verse": 1, "start": 300, "end": 12959, "text": "Porque Jehová tendrá piedad de Jacob, y todavía escogerá a Israel, y les hará reposar en su tierra: y a ellos se unirán extranjeros, y se juntarán a la familia de Jacob.", "words": [[0, 300], [7, 584], [14, 1084], [21, 1424], [28, 1884], [31, 2024], [38, 2384], [40, 3284], [48, 3604], [57, 4344], [59, 4524], [67, 5464], [69, 5804], [73, 6004], [78, 6344], [86, 6984], [89, 7104], [92, 7244], [100, 8190], [102, 8298], [104, 8378], [110, 8638], [113, 9038], [120, 9458], [133, 10438], [135, 10658], [138, 10778], [147, 11518], [149, 11678], [152, 11758], [160, 12178], [163, 12358]]}, {"verse": 2, "start": 13409, "end": 28525, "text": "Y los tomarán los pueblos, y los traerán a su lugar: y la casa de Israel los poseerá por siervos y criadas en la tierra de Jehová: y cautivarán a los que los cautivaron, y señorearán a los que los oprimieron.", "words": [[0, 13409], [2, 13551], [6, 13671], [14, 14211], [18, 14371], [27, 15071], [29, 15731], [33, 15891], [41, 16611], [43, 16691], [46, 16811], [53, 17690], [55, 17794], [58, 17914], [63, 18194], [66, 18434], [73, 18814], [77, 19034], [85, 19674], [89, 19834], [97, 20354], [99, 20514], [107, 20994], [110, 21214], [113, 21334], [120, 21634], [123, 21834], [131, 22621], [133, 22765], [144, 23545], [146, 23645], [150, 23765], [154, 23905], [158, 24045], [170, 24805], [172, 25525], [183, 26645], [185, 27025], [189, 27165], [193, 27305], [197, 27445]]}, {"verse": 3, "start": 28975, "end": 37507, "text": "Y será en el día que Jehová te dé reposo de tu trabajo, y de tu temor, y de la dura servidumbre en que te hicieron servir,", "words": [[0, 28975], [2, 29120], [7, 29359], [10, 29560], [13, 29679], [17, 29920], [21, 30120], [28, 30700], [31, 30780], [34, 30999], [41, 31640], [44, 31839], [47, 31979], [56, 32520], [58, 33120], [61, 33260], [64, 33420], [71, 33920], [73, 34320], [76, 34420], [79, 34579], [84, 34760], [96, 35760], [99, 36040], [103, 36180], [106, 36340], [115, 36860]]}, {"verse": 4, "start": 37957, "end": 47583, "text": "Que levantarás esta parábola sobre el rey de Babilonia, y dirás: ¡Cómo terminó el opresor, cómo cesó la ciudad codiciosa del oro!", "words": [[0, 37957], [4, 38042], [15, 38882], [20, 39282], [29, 40002], [35, 40382], [38, 40822], [42, 41202], [45, 41282], [56, 42022], [58, 42482], [65, 43362], [71, 43563], [79, 44103], [82, 44603], [91, 45103], [96, 45423], [101, 45843], [104, 45943], [111, 46223], [121, 47063], [125, 47203]]}, {"verse": 5, "start": 47933, "end": 53063, "text": "Quebrantó Jehová el bastón de los impíos, el cetro de los señores;", "words": [[0, 48270], [10, 48644], [17, 49017], [20, 49137], [27, 49657], [30, 49757], [34, 50487], [42, 51217], [45, 51317], [51, 51877], [54, 51997], [58, 52137]]}, {"verse": 6, "start": 53513, "end": 62121, "text": "Al que con ira hería los pueblos de llaga permanente, el cual dominaba a las naciones con furor, y las perseguía con crueldad.", "words": [[0, 53513], [3, 53677], [7, 53837], [11, 54117], [15, 54497], [21, 55057], [25, 55217], [33, 55737], [36, 55967], [42, 56197], [54, 57017], [57, 57117], [62, 57317], [71, 57937], [73, 58057], [77, 58197], [86, 58597], [90, 58877], [97, 59437], [99, 60217], [103, 60357], [113, 61077], [117, 61631]]}, {"verse": 7, "start": 62571, "end": 67052, "text": "Descansó, sosegó toda la tierra: cantaron alabanza.", "words": [[0, 62571], [10, 63297], [17, 64057], [22, 64277], [25, 64769], [33, 65824], [42, 66144]]}, {"verse": 8, "start": 67502, "end": 77859, "text": "Aun las hayas se alegraron de ti, y los cedros del Líbano, diciendo: Desde que tú pereciste, no ha subido cortador contra nosotros.", "words": [[0, 67502], [4, 67863], [8, 68383], [14, 68903], [17, 69183], [27, 69823], [30, 70023], [34, 70323], [36, 70923], [40, 71103], [47, 71723], [51, 72103], [59, 72823], [69, 74304], [75, 74462], [79, 74682], [82, 74862], [93, 75862], [96, 75982], [99, 76102], [106, 76382], [115, 76842], [122, 77122]]}, {"verse": 9, "start": 78209, "end": 91824, "text": "El infierno abajo se espantó de ti; te despertó muertos que en tu venida saliesen a recibirte, hizo levantar de sus tronos a todos los príncipes de la tierra, a todos los reyes de las naciones.", "words": [[0, 78209], [3, 78332], [12, 78992], [18, 79352], [21, 79652], [29, 80292], [32, 80412], [36, 81123], [39, 81220], [48, 81820], [56, 82320], [60, 82520], [63, 82620], [66, 82760], [73, 83140], [82, 83660], [84, 83880], [95, 85160], [100, 85420], [109, 86140], [112, 86260], [116, 86460], [123, 87040], [125, 87300], [131, 87680], [135, 88000], [145, 88840], [148, 88940], [151, 89080], [159, 89940], [161, 90000], [167, 90220], [171, 90460], [177, 90840], [180, 90960], [184, 91100]]}, {"verse": 10, "start": 92274, "end": 98683, "text": "Todos ellos darán voces, y te dirán: ¿Tú también enfermaste como nosotros, y como nosotros fuiste?", "words": [[0, 92274], [6, 92463], [12, 93003], [18, 93463], [25, 93923], [27, 94103], [30, 94263], [37, 95107], [41, 95229], [49, 95549], [60, 96209], [65, 96469], [75, 96989], [77, 97369], [82, 97589], [91, 97989]]}, {"verse": 11, "start": 99033, "end": 108024, "text": "Descendió al sepulcro tu soberbia, y el sonido de tus vihuelas: gusanos serán tu cama, y gusanos te cubrirán.", "words": [[0, 99033], [10, 99782], [13, 100002], [22, 100642], [25, 100842], [35, 101502], [37, 101862], [40, 102002], [47, 102502], [50, 102662], [54, 103220], [64, 104025], [72, 104717], [78, 105397], [81, 105537], [87, 105937], [89, 106517], [97, 106997], [100, 107197]]}, {"verse": 12, "start": 108474, "end": 117556, "text": "¡Cómo caíste del cielo, oh Lucero, hijo de la mañana! Cortado fuiste por tierra, tú que debilitabas a las naciones.", "words": [[0, 108474], [6, 108839], [13, 109379], [17, 109599], [24, 110019], [27, 110439], [35, 111239], [40, 111359], [43, 111559], [46, 111679], [54, 112706], [62, 113269], [69, 113649], [73, 114289], [81, 114929], [84, 115269], [88, 115729], [100, 116569], [102, 116689], [106, 116809]]}, {"verse": 13, "start": 118006, "end": 128301, "text": "Tú que decías en tu corazón: Subiré al cielo, en lo alto junto a las estrellas de Dios ensalzaré mi trono, y en el monte del testimonio me sentaré, a los lados del norte;", "words": [[0, 118006], [3, 118130], [7, 118370], [14, 118910], [17, 119130], [20, 119270], [29, 120309], [36, 120723], [39, 120863], [46, 121163], [49, 121323], [52, 121463], [57, 121743], [63, 121983], [65, 122183], [69, 122303], [79, 122843], [82, 122943], [87, 123543], [97, 124143], [100, 124303], [107, 124683], [109, 125083], [112, 125183], [115, 125283], [121, 125643], [125, 126003], [136, 126363], [139, 126483], [148, 127003], [150, 127243], [154, 127363], [160, 127603], [164, 127843]]}, {"verse": 14, "start": 128751, "end": 133202, "text": "Sobre las alturas de las nubes subiré, y seré semejante al Altísimo.", "words": [[0, 128751], [6, 129035], [10, 129235], [18, 129755], [21, 129875], [25, 129995], [31, 130395], [39, 130955], [41, 131415], [46, 131755], [56, 132355], [59, 132475]]}, {"verse": 15, "start": 133552, "end": 137950, "text": "Mas tú derribado eres en el sepulcro, a lo profundo de la fosa.", "words": [[0, 133552], [4, 133802], [7, 134002], [17, 134702], [22, 134962], [25, 135222], [28, 135382], [38, 136122], [40, 136562], [43, 136662], [52, 137182], [55, 137322], [58, 137422]]}, {"verse": 16, "start": 138400, "end": 147327, "text": "Se inclinarán hacia ti los que te ven, te considerarán diciendo: ¿Es este aquel varón que hacía temblar la tierra, que trastornaba los reinos;", "words": [[0, 138400], [3, 138539], [14, 139379], [20, 139659], [23, 140099], [27, 140419], [31, 140619], [34, 140759], [39, 141259], [42, 141439], [55, 142379], [65, 143439], [69, 143622], [74, 143862], [80, 144142], [86, 144422], [90, 144542], [96, 144802], [104, 145222], [107, 145342], [115, 145722], [119, 145942], [131, 146582], [135, 146762]]}, {"verse": 17, "start": 147777, "end": 153039, "text": "Que puso el mundo como un desierto, que asoló sus ciudades; que a sus presos nunca abrió la cárcel?", "words": [[0, 147777], [4, 147857], [9, 148157], [12, 148297], [18, 148517], [23, 148777], [26, 148917], [36, 149477], [40, 149677], [46, 150037], [50, 150157], [60, 151192], [64, 151269], [66, 151349], [70, 151429], [77, 151829], [83, 152099], [89, 152369], [92, 152469]]}, {"verse": 18, "start": 153389, "end": 159920, "text": "Todos los reyes de las naciones, todos ellos yacen con honra cada uno en su casa.", "words": [[0, 153389], [6, 153693], [10, 154173], [16, 154733], [19, 154893], [23, 155053], [33, 155893], [39, 156113], [45, 156633], [51, 157393], [55, 157573], [61, 158433], [66, 158733], [70, 159053], [73, 159253], [76, 159373]]}, {"verse": 19, "start": 160370, "end": 172723, "text": "Pero tú echado eres de tu sepulcro como tronco abominable, como vestido de muertos pasados a espada, que descendieron al fondo de la sepultura; como cuerpo muerto pisoteado.", "words": [[0, 160370], [5, 160514], [8, 160754], [15, 161274], [20, 161534], [23, 161734], [26, 161874], [35, 162594], [40, 162894], [47, 163694], [59, 164834], [64, 165114], [72, 165594], [75, 165754], [83, 166254], [91, 166774], [93, 166954], [101, 167454], [105, 167834], [118, 168474], [121, 168654], [127, 168994], [130, 169214], [133, 169314], [144, 170429], [149, 170597], [156, 171037], [163, 171597]]}, {"verse": 20, "start": 173173, "end": 184278, "text": "No serás contado con ellos en la sepultura: porque tú destruiste tu tierra, mataste tu pueblo. No será nombrada para siempre la descendencia de los malignos.", "words": [[0, 173173], [3, 173321], [9, 173681], [17, 174321], [21, 174541], [27, 174861], [30, 175121], [33, 175241], [44, 176528], [51, 176690], [54, 177050], [65, 178030], [68, 178250], [76, 178930], [84, 179550], [87, 179750], [95, 180618], [98, 180725], [103, 180925], [112, 181565], [117, 181765], [125, 182185], [128, 182425], [141, 183205], [144, 183325], [148, 183445]]}, {"verse": 21, "start": 184728, "end": 196822, "text": "Preparad sus hijos para el matadero por la maldad de sus padres: no se levanten, ni posean la tierra, e hinchan la faz del mundo de ciudades.", "words": [[0, 185013], [9, 185333], [13, 185553], [19, 185933], [24, 186293], [27, 186453], [36, 187173], [40, 187973], [43, 188173], [50, 188653], [53, 188893], [57, 189053], [65, 190247], [68, 190433], [71, 190593], [81, 191253], [84, 191913], [91, 192613], [94, 192773], [102, 193253], [104, 193773], [112, 194413], [115, 194693], [119, 194973], [123, 195273], [129, 195633], [132, 195853]]}, {"verse": 22, "start": 197122, "end": 207767, "text": "Porque yo me levantaré sobre ellos, dice Jehová de los ejércitos, y raeré de Babilonia el nombre y las reliquias, hijo y nieto, dice Jehová.", "words": [[0, 197122], [7, 197308], [10, 197528], [13, 197648], [23, 198208], [29, 198488], [36, 199408], [41, 199848], [48, 200328], [51, 200428], [55, 200568], [66, 201808], [68, 201888], [74, 202388], [77, 202468], [87, 203088], [90, 203348], [97, 203708], [99, 203968], [103, 204528], [114, 205088], [119, 205388], [121, 205628], [128, 206748], [133, 207074]]}, {"verse": 23, "start": 208067, "end": 217784, "text": "Y la convertiré en posesión de erizos, y en lagunas de agua; y la barreré con escobas de destrucción, dice Jehová de los ejércitos.", "words": [[0, 208067], [2, 208171], [5, 208251], [16, 209031], [19, 209271], [28, 209871], [31, 210051], [39, 210751], [41, 211111], [44, 211231], [52, 211711], [55, 211851], [61, 212842], [63, 212944], [66, 213044], [74, 213544], [78, 213724], [86, 214224], [89, 214324], [102, 215775], [107, 216097], [114, 216557], [117, 216637], [121, 216777]]}, {"verse": 24, "start": 218234, "end": 226784, "text": "Jehová de los ejércitos juró, diciendo: Ciertamente se hará de la manera que lo he pensado, y será confirmado como lo he determinado:", "words": [[0, 218234], [7, 218618], [10, 218678], [14, 218818], [24, 219418], [30, 219918], [40, 221038], [52, 221804], [55, 222064], [60, 222304], [63, 222364], [66, 222484], [73, 222804], [77, 223064], [80, 223204], [83, 223284], [92, 223904], [94, 224444], [99, 224664], [110, 225404], [115, 225624], [118, 225804], [121, 225924]]}, {"verse": 25, "start": 227480, "end": 236949, "text": "Que quebrantaré al asirio en mi tierra, y en mis montes lo pisotearé; y su yugo será apartado de ellos, y su carga será quitada de su hombro.", "words": [[0, 227480], [4, 227557], [16, 228157], [19, 228317], [26, 228777], [29, 228877], [32, 228977], [40, 229317], [42, 229797], [45, 229877], [49, 230017], [56, 230497], [59, 230657], [70, 231956], [72, 232079], [75, 232219], [80, 232619], [85, 232919], [94, 233759], [97, 233919], [104, 234579], [106, 234799], [109, 234959], [115, 235299], [120, 235639], [128, 236139], [131, 236299], [134, 236479]]}, {"verse": 26, "start": 237546, "end": 245709, "text": "Este es el consejo que está acordado sobre toda la tierra; y esta, la mano extendida sobre todas las naciones.", "words": [[0, 237546], [5, 237914], [8, 238234], [11, 238414], [19, 239074], [23, 239194], [28, 239454], [37, 240114], [43, 240414], [48, 240714], [51, 240974], [59, 241934], [61, 242093], [67, 242793], [70, 242993], [75, 243233], [85, 243973], [91, 244233], [97, 244593], [101, 244933]]}, {"verse": 27, "start": 246159, "end": 254847, "text": "Porque Jehová de los ejércitos ha determinado: ¿y quién invalidará? Y su mano extendida, ¿quién la hará volver?", "words": [[0, 246159], [7, 246383], [14, 246843], [17, 246903], [21, 247043], [31, 247703], [34, 247883], [47, 249066], [50, 249446], [56, 249746], [68, 251194], [70, 251300], [73, 251480], [78, 251720], [89, 253060], [96, 253640], [99, 253900], [104, 254220]]}, {"verse": 28, "start": 255297, "end": 258894, "text": "En el año que murió el rey Acaz fue esta carga:", "words": [[0, 255297], [3, 255438], [6, 255578], [10, 255798], [14, 256018], [20, 256458], [23, 256698], [27, 257138], [32, 257578], [36, 257798], [41, 258218]]}, {"verse": 29, "start": 259344, "end": 270874, "text": "No te alegres tú, Filistea toda, por haberse quebrado la vara del que te hería; porque de la raíz de la culebra saldrá áspid, y su fruto, ceraste volador.", "words": [[0, 259344], [3, 259450], [6, 259590], [14, 260030], [18, 260550], [27, 261070], [33, 261310], [37, 261870], [45, 262250], [54, 262730], [57, 262890], [62, 263170], [66, 263370], [70, 263610], [73, 263830], [80, 264762], [87, 264987], [90, 265187], [93, 265367], [98, 265887], [101, 266007], [104, 266147], [112, 266667], [119, 267367], [126, 268087], [128, 268487], [131, 268687], [138, 269427], [146, 270167]]}, {"verse": 30, "start": 271324, "end": 283128, "text": "Y los primogénitos de los pobres serán apacentados, y los necesitados se acostarán seguramente: mas yo haré morir de hambre tu raíz, y mataré tus reliquias.", "words": [[0, 271324], [2, 271580], [6, 271700], [19, 272520], [22, 272640], [26, 272740], [33, 273320], [39, 273960], [52, 274780], [54, 275220], [58, 275360], [70, 276220], [73, 276360], [83, 276960], [96, 278167], [100, 278447], [103, 278907], [108, 279187], [114, 279587], [117, 279727], [124, 280087], [127, 280307], [133, 280987], [135, 281447], [142, 281887], [146, 282087]]}, {"verse": 31, "start": 283578, "end": 295045, "text": "Aulla, oh puerta; clama, oh ciudad; disuelta estás toda tú, Filistea: porque humo vendrá de norte, no quedará uno solo en sus asambleas.", "words": [[0, 283784], [7, 284024], [10, 284264], [18, 285492], [25, 285706], [28, 285919], [36, 287118], [45, 287438], [51, 287698], [56, 287978], [60, 288558], [70, 289607], [77, 289892], [82, 290412], [89, 290812], [92, 290932], [99, 291872], [102, 292252], [110, 292752], [114, 293112], [119, 293592], [122, 293792], [126, 293952]]}, {"verse": 32, "start": 295495, "end": 305614, "text": "¿Y qué se responderá a los mensajeros de la gentilidad? Que Jehová fundó a Sion, y que a ella se acogerán los afligidos de su pueblo.", "words": [[0, 295495], [3, 295832], [7, 296032], [10, 296232], [21, 297132], [23, 297312], [27, 297512], [38, 298492], [41, 298692], [44, 298852], [56, 300212], [60, 300316], [67, 300836], [73, 301169], [75, 301503], [81, 301836], [83, 302396], [87, 302576], [89, 302716], [94, 302956], [97, 303176], [106, 303796], [110, 303976], [120, 304656], [123, 304816], [126, 304956]]}]}