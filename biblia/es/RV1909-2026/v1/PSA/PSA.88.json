{"book": "PSA", "chapter": 88, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 118529, "verses": [{"verse": 1, "start": 300, "end": 14446, "text": "Canción: Salmo para los hijos de Coré: al Músico principal: para cantar sobre Mahalat: Masquil de Hemán ezraíta. OH Jehová, Dios de mi salvación, día y noche clamo delante de ti.", "words": [[0, 300], [9, 1330], [15, 1908], [20, 2208], [24, 2388], [30, 2668], [33, 3032], [39, 3617], [42, 3778], [49, 4238], [60, 5368], [65, 5535], [72, 6095], [78, 6395], [87, 7860], [95, 8220], [98, 8736], [104, 9253], [113, 9954], [116, 10143], [124, 10823], [129, 11003], [132, 11183], [135, 11283], [146, 12283], [150, 12563], [152, 12803], [158, 13043], [164, 13563], [172, 13923], [175, 14103]]}, {"verse": 2, "start": 14796, "end": 19650, "text": "Entre mi oración en tu presencia: inclina tu oído a mi clamor.", "words": [[0, 14796], [6, 15093], [9, 15353], [17, 15813], [20, 16033], [23, 16153], [34, 17723], [42, 18103], [45, 18343], [50, 18763], [52, 18943], [55, 19063]]}, {"verse": 3, "start": 20000, "end": 25066, "text": "Porque mi alma está harta de males, y mi vida cercana al sepulcro.", "words": [[0, 20000], [7, 20164], [10, 20404], [15, 20704], [20, 21024], [26, 21504], [29, 21704], [36, 22124], [38, 22864], [41, 23024], [46, 23304], [54, 23924], [57, 24124]]}, {"verse": 4, "start": 25416, "end": 30549, "text": "Soy contado con los que descienden al hoyo, soy como hombre sin fuerza:", "words": [[0, 25416], [4, 25661], [12, 26381], [16, 26621], [20, 26781], [24, 26921], [35, 27501], [38, 27741], [44, 28541], [48, 28941], [53, 29261], [60, 29601], [64, 29841]]}, {"verse": 5, "start": 30899, "end": 39973, "text": "Libre entre los muertos, como los matados que yacen en el sepulcro, que no te acuerdas más de ellos, y que son cortados de tu mano.", "words": [[0, 30899], [6, 31343], [12, 31723], [16, 31923], [25, 32903], [30, 33223], [34, 33383], [42, 33963], [46, 34163], [52, 34663], [55, 34803], [58, 34943], [68, 36043], [72, 36143], [75, 36283], [78, 36403], [87, 36823], [91, 36983], [94, 37183], [101, 37483], [103, 38103], [107, 38223], [111, 38403], [120, 39123], [123, 39283], [126, 39423]]}, {"verse": 6, "start": 40323, "end": 44738, "text": "Me has puesto en el hoyo profundo, en tinieblas, en honduras.", "words": [[0, 40323], [3, 40470], [7, 40610], [14, 40870], [17, 41150], [20, 41320], [25, 41490], [35, 42530], [38, 42750], [49, 43830], [52, 44317]]}, {"verse": 7, "start": 45088, "end": 50538, "text": "Sobre mí se ha acostado tu ira, y me has afligido con todas tus ondas. (Selah.)", "words": [[0, 45088], [6, 45310], [9, 45550], [12, 45730], [15, 45850], [24, 46310], [27, 46510], [32, 47110], [34, 47310], [37, 47430], [41, 47590], [50, 48210], [54, 48450], [60, 48770], [64, 49030], [71, 50301]]}, {"verse": 8, "start": 50888, "end": 58702, "text": "Has alejado de mí mis conocidos: me has puesto por abominación a ellos: encerrado estoy, y no puedo salir.", "words": [[0, 51185], [4, 51519], [12, 51852], [15, 52012], [18, 52172], [22, 52372], [33, 53461], [36, 53609], [40, 53809], [47, 54089], [51, 54589], [63, 55409], [65, 55609], [72, 56379], [82, 57143], [89, 57383], [91, 57703], [94, 57823], [100, 58083]]}, {"verse": 9, "start": 58702, "end": 66518, "text": "Mis ojos enfermaron a causa de mi aflicción: te he llamado, oh Jehová, cada día; he extendido a ti mis manos.", "words": [[0, 58702], [4, 58942], [9, 59262], [20, 60202], [22, 60302], [28, 60662], [31, 60922], [34, 61042], [45, 62217], [48, 62338], [51, 62418], [60, 62738], [63, 63058], [71, 63498], [76, 63718], [81, 64506], [84, 64787], [94, 65507], [96, 65627], [99, 65727], [103, 65867]]}, {"verse": 10, "start": 66868, "end": 72699, "text": "¿Harás tú milagro a los muertos? ¿se levantarán los muertos para alabarte? (Selah.)", "words": [[0, 66868], [7, 67216], [10, 67416], [18, 68136], [20, 68196], [24, 68296], [33, 69327], [37, 69417], [48, 70097], [52, 70197], [60, 70617], [65, 70937], [75, 72372]]}, {"verse": 11, "start": 73049, "end": 78158, "text": "¿Será contada en el sepulcro tu misericordia, o tu verdad en la perdición?", "words": [[0, 73049], [6, 73447], [14, 74127], [17, 74267], [20, 74427], [29, 75107], [32, 75167], [46, 76067], [48, 76287], [51, 76367], [58, 76667], [61, 77087], [64, 77227]]}, {"verse": 12, "start": 78508, "end": 84055, "text": "¿Será conocida en las tinieblas tu maravilla, ni tu justicia en la tierra del olvido?", "words": [[0, 78508], [6, 78830], [15, 79410], [18, 79530], [22, 79690], [32, 80330], [35, 80450], [46, 81290], [49, 81610], [52, 81770], [61, 82470], [64, 82630], [67, 82750], [74, 83130], [78, 83390]]}, {"verse": 13, "start": 84405, "end": 89824, "text": "Mas yo a ti he clamado, oh Jehová; y de mañana mi oración llegó antes a ti.", "words": [[0, 84565], [4, 84745], [7, 84925], [9, 85165], [12, 85325], [15, 85771], [24, 86217], [27, 86663], [35, 87265], [37, 87382], [40, 87502], [47, 87822], [50, 88102], [58, 88522], [64, 88842], [70, 89182], [72, 89482]]}, {"verse": 14, "start": 90174, "end": 94982, "text": "¿Por qué, oh Jehová, desechas mi alma? ¿por qué escondes de mí tu rostro?", "words": [[0, 90174], [5, 90298], [10, 90618], [13, 90938], [21, 91258], [30, 92038], [33, 92218], [39, 93053], [44, 93195], [48, 93355], [57, 93875], [60, 94015], [63, 94155], [66, 94295]]}, {"verse": 15, "start": 95332, "end": 102156, "text": "Yo soy afligido y necesitado: desde la juventud he llevado tus terrores, he estado temeroso.", "words": [[0, 95332], [3, 95519], [7, 95759], [16, 96459], [18, 96559], [30, 97760], [36, 98160], [39, 98380], [48, 99080], [51, 99320], [59, 99780], [63, 99960], [73, 100820], [76, 100880], [83, 101200]]}, {"verse": 16, "start": 102506, "end": 106725, "text": "Sobre mí han pasado tus iras; tus espantos me han cortado.", "words": [[0, 102506], [6, 102773], [9, 103053], [13, 103253], [20, 103673], [24, 104210], [30, 104940], [34, 105067], [43, 106027], [46, 106267], [50, 106427]]}, {"verse": 17, "start": 107075, "end": 111944, "text": "Me han rodeado como aguas de continuo; me han cercado a una.", "words": [[0, 107075], [3, 107919], [7, 108079], [15, 108619], [20, 108879], [26, 109239], [29, 109339], [39, 110387], [42, 110607], [46, 110707], [54, 111267], [56, 111427]]}, {"verse": 18, "start": 112294, "end": 118129, "text": "Has alejado de mí el amigo y el compañero; y mis conocidos se esconden en la tiniebla.", "words": [[0, 112444], [4, 112594], [12, 113034], [15, 113194], [18, 113394], [21, 113654], [27, 113974], [29, 114174], [32, 114314], [43, 115351], [45, 115448], [49, 115588], [59, 116308], [62, 116528], [71, 117088], [74, 117288], [77, 117731]]}]}