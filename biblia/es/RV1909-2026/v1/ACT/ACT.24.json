{"book": "ACT", "chapter": 24, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 223347, "verses": [{"verse": 1, "start": 300, "end": 12023, "text": "Y cinco días después descendió el sumo sacerdote Ananías, con algunos de los ancianos, y un cierto Tértulo, orador; y comparecieron delante del gobernador contra Pablo.", "words": [[0, 300], [2, 427], [8, 747], [13, 1167], [21, 1567], [31, 2327], [34, 2567], [39, 3067], [49, 3787], [58, 4707], [62, 4867], [70, 5267], [73, 5407], [77, 5527], [87, 6167], [89, 6507], [92, 6667], [99, 7197], [108, 7727], [116, 8748], [118, 8848], [132, 9668], [140, 10188], [144, 10408], [155, 11048], [162, 11388]]}, {"verse": 2, "start": 12473, "end": 23483, "text": "Y citado que fue, Tértulo comenzó a acusar, diciendo: Como por causa tuya vivamos en grande paz, y muchas cosas sean bien gobernadas en el pueblo por tu prudencia,", "words": [[0, 12473], [2, 12637], [9, 13077], [13, 13257], [18, 14017], [26, 14497], [34, 15197], [36, 15337], [44, 16197], [54, 17273], [59, 17448], [63, 17648], [69, 17828], [74, 18328], [82, 18728], [85, 18948], [92, 19148], [97, 19528], [99, 20028], [106, 20268], [112, 20668], [117, 20988], [122, 21188], [133, 21788], [136, 21968], [139, 22068], [146, 22308], [150, 22588], [153, 22728]]}, {"verse": 3, "start": 23933, "end": 29234, "text": "Siempre y en todo lugar lo recibimos con todo agradecimiento, oh excelentísimo Félix.", "words": [[0, 23933], [8, 24355], [10, 24455], [13, 24595], [18, 24715], [24, 25075], [27, 25235], [37, 25815], [41, 26055], [46, 26295], [62, 27015], [65, 27735], [79, 28555]]}, {"verse": 4, "start": 29684, "end": 35018, "text": "Pero por no molestarte más largamente, te ruego que nos oigas brevemente conforme a tu equidad.", "words": [[0, 29684], [5, 29843], [9, 30063], [12, 30203], [23, 30783], [27, 31003], [39, 31683], [42, 32183], [48, 32463], [52, 32623], [56, 32783], [62, 33223], [73, 33803], [82, 34363], [84, 34403], [87, 34503]]}, {"verse": 5, "start": 35468, "end": 45006, "text": "Porque hemos hallado que este hombre es pestilencial, y levantador de sediciones entre todos los judíos por todo el mundo, y cabecilla de la secta de los nazarenos:", "words": [[0, 35468], [7, 35715], [13, 35935], [21, 36435], [25, 36615], [30, 36855], [37, 37155], [40, 37395], [54, 38175], [56, 38695], [67, 39275], [70, 39435], [81, 40015], [87, 40395], [93, 40695], [97, 40935], [104, 41415], [108, 41595], [113, 41795], [116, 41975], [123, 42295], [125, 42755], [135, 43355], [138, 43475], [141, 43595], [147, 43995], [150, 44075], [154, 44195]]}, {"verse": 6, "start": 45457, "end": 51602, "text": "El cual también intentó profanar el templo; y prendiéndole, le quisimos juzgar conforme a nuestra ley:", "words": [[0, 45457], [3, 45599], [8, 45779], [16, 46119], [24, 46759], [33, 47239], [36, 47339], [44, 48171], [46, 48272], [60, 49232], [63, 49352], [72, 49792], [79, 50292], [88, 50872], [90, 50932], [98, 51072]]}, {"verse": 7, "start": 52052, "end": 57000, "text": "Pero interviniendo el comandante Lisias, con grande violencia le quitó de nuestras manos,", "words": [[0, 52052], [5, 52189], [19, 52989], [22, 53069], [33, 53619], [41, 54169], [45, 54429], [52, 54749], [62, 55389], [65, 55609], [71, 55949], [74, 56009], [83, 56189]]}, {"verse": 8, "start": 57450, "end": 64999, "text": "Mandando a sus acusadores que viniesen a ti; del cual tú mismo juzgando, podrás entender todas estas cosas de que le acusamos.", "words": [[0, 57450], [9, 57912], [11, 57992], [15, 58112], [26, 58692], [30, 58952], [39, 59372], [41, 59572], [45, 60173], [49, 60292], [54, 60512], [57, 60732], [63, 61092], [73, 61892], [80, 62352], [89, 62712], [95, 63032], [101, 63392], [107, 63772], [110, 64012], [114, 64112], [117, 64232]]}, {"verse": 9, "start": 65349, "end": 69837, "text": "Y contendían también los judíos, diciendo ser así estas cosas.", "words": [[0, 65349], [2, 65474], [13, 66194], [21, 66594], [25, 66854], [33, 67854], [42, 68174], [46, 68534], [50, 68814], [56, 69054]]}, {"verse": 10, "start": 70287, "end": 82084, "text": "Entonces Pablo, haciéndole el gobernador señal que hablase, respondió: Porque sé que desde hace muchos años eres gobernador de esta nación, con buen ánimo presentaré mi defensa.", "words": [[0, 70287], [9, 71375], [16, 71995], [27, 72615], [30, 72755], [41, 73395], [47, 73915], [51, 74035], [60, 74835], [71, 75886], [78, 76086], [81, 76326], [85, 76486], [91, 76686], [96, 77046], [103, 77306], [108, 77746], [113, 78146], [124, 78766], [127, 78946], [132, 79126], [140, 80106], [144, 80226], [149, 80406], [155, 80746], [166, 81346], [169, 81466]]}, {"verse": 11, "start": 82534, "end": 87061, "text": "Porque tú puedes entender que no hace más de doce días que subí a adorar a Jerusalén;", "words": [[0, 82534], [7, 82714], [10, 82854], [17, 83134], [26, 83594], [30, 83834], [33, 84014], [38, 84214], [42, 84434], [45, 84664], [50, 84894], [55, 85274], [59, 85614], [64, 85954], [66, 86074], [73, 86254], [75, 86394]]}, {"verse": 12, "start": 87511, "end": 93731, "text": "Y ni me hallaron en el templo disputando con ninguno, ni reuniendo multitudes, ni en sinagogas, ni en la ciudad;", "words": [[0, 87511], [2, 87598], [5, 87698], [8, 87818], [17, 88138], [20, 88258], [23, 88398], [30, 88758], [41, 89318], [45, 89498], [54, 90358], [57, 90498], [67, 90958], [79, 91978], [82, 92058], [85, 92158], [96, 92978], [99, 93058], [102, 93138], [105, 93238]]}, {"verse": 13, "start": 94181, "end": 96741, "text": "Ni te pueden probar las cosas de que ahora me acusan.", "words": [[0, 94181], [3, 94300], [6, 94400], [13, 94640], [20, 95040], [24, 95160], [30, 95460], [33, 95700], [37, 95800], [43, 96000], [46, 96160]]}, {"verse": 14, "start": 97191, "end": 107528, "text": "Pero esto te confieso, que conforme a aquel Camino que llaman herejía, así sirvo al Dios de mis padres, creyendo todas las cosas que en la ley y en los profetas están escritas;", "words": [[0, 97191], [5, 97331], [10, 97591], [13, 97771], [23, 98611], [27, 98711], [36, 99251], [38, 99351], [44, 99551], [51, 99851], [55, 100071], [62, 100741], [71, 101411], [75, 101591], [81, 101991], [84, 102131], [89, 102291], [92, 102491], [96, 102611], [104, 103518], [113, 103939], [119, 104159], [123, 104439], [129, 104739], [133, 105039], [136, 105179], [139, 105279], [143, 105559], [145, 105799], [148, 105899], [152, 105999], [161, 106519], [167, 106799]]}, {"verse": 15, "start": 107978, "end": 115025, "text": "Teniendo esperanza en Dios que ha de haber resurrección de los muertos, así de justos como de injustos, la cual también ellos esperan.", "words": [[0, 107978], [9, 108337], [19, 108937], [22, 109077], [27, 109297], [31, 109597], [34, 109717], [37, 109797], [43, 109957], [56, 110657], [59, 110777], [63, 110877], [72, 111577], [76, 111757], [79, 111937], [86, 112377], [91, 112557], [94, 112697], [104, 113477], [107, 113557], [112, 113737], [120, 114037], [126, 114377]]}, {"verse": 16, "start": 115475, "end": 121714, "text": "Y por esto, procuro yo tener siempre conciencia sin remordimiento acerca de Dios y acerca de los hombres.", "words": [[0, 115475], [2, 115575], [6, 115735], [12, 115935], [20, 116475], [23, 116635], [29, 116895], [37, 117335], [48, 118035], [52, 118275], [66, 119075], [73, 119395], [76, 119695], [81, 119935], [83, 120455], [90, 120795], [93, 120995], [97, 121115]]}, {"verse": 17, "start": 122164, "end": 126768, "text": "Pero pasados muchos años, vine a hacer limosnas a mi nación, y ofrendas,", "words": [[0, 122164], [5, 122285], [13, 122725], [20, 122945], [26, 123385], [31, 123925], [33, 124145], [39, 124417], [48, 124689], [50, 124961], [53, 125233], [61, 125505], [63, 126045]]}, {"verse": 18, "start": 127218, "end": 132738, "text": "Cuando me hallaron purificado en el templo (no con multitud ni con alboroto) unos judíos de Asia;", "words": [[0, 127218], [7, 127355], [10, 127585], [19, 127815], [30, 128455], [33, 128535], [36, 128675], [43, 129475], [47, 129555], [51, 129755], [60, 130235], [63, 130395], [67, 130515], [77, 131475], [82, 131635], [89, 132095], [92, 132215]]}, {"verse": 19, "start": 133188, "end": 137673, "text": "Los cuales debieron comparecer delante de ti, y acusarme, si contra mí tenían algo.", "words": [[0, 133188], [4, 133268], [11, 133548], [20, 133948], [31, 134628], [39, 135028], [42, 135168], [46, 135388], [48, 135748], [58, 136308], [61, 136508], [68, 136768], [71, 136948], [78, 137128]]}, {"verse": 20, "start": 138123, "end": 143495, "text": "O digan estos mismos si hallaron en mí alguna cosa mal hecha, cuando yo estuve en el Consejo,", "words": [[0, 138123], [2, 138249], [8, 138589], [14, 138789], [21, 139209], [24, 139449], [33, 139809], [36, 139929], [39, 140109], [46, 140429], [51, 140756], [55, 141082], [62, 141409], [69, 141949], [72, 142189], [79, 142569], [82, 142709], [85, 142809]]}, {"verse": 21, "start": 143945, "end": 151460, "text": "A no ser que, estando entre ellos prorrumpí en alta voz: Acerca de la resurrección de los muertos soy hoy juzgado de vosotros.", "words": [[0, 143945], [2, 144064], [5, 144164], [9, 144364], [14, 144904], [22, 145344], [28, 145584], [34, 146034], [44, 146484], [47, 146604], [52, 146804], [57, 147566], [64, 147990], [67, 148110], [70, 148230], [83, 148890], [86, 149010], [90, 149110], [98, 149770], [102, 149910], [106, 150070], [114, 150550], [117, 150730]]}, {"verse": 22, "start": 151810, "end": 165865, "text": "Entonces Félix, oídas estas cosas, estando bien informado de esta secta, aplazó el asunto, diciendo: Cuando descienda el comandante Lisias acabaré de conocer de vuestro asunto.", "words": [[0, 151810], [9, 152854], [16, 153714], [22, 154314], [28, 154514], [35, 155194], [43, 155594], [48, 156094], [58, 156594], [61, 156754], [66, 156934], [73, 157914], [80, 158414], [83, 158534], [91, 159274], [101, 160276], [108, 160454], [118, 161114], [121, 161214], [132, 161974], [139, 162734], [147, 163294], [150, 163414], [158, 163794], [161, 164034], [169, 164354]]}, {"verse": 23, "start": 166215, "end": 176983, "text": "Y mandó al centurión que Pablo fuese guardado, y aliviado de las prisiones; y que no prohibiese a ninguno de sus conocidos atenderlo, o venir a él.", "words": [[0, 166215], [2, 166337], [8, 166757], [11, 166897], [21, 167517], [25, 167657], [31, 168057], [37, 168437], [47, 169077], [49, 169217], [58, 169837], [61, 169997], [65, 170137], [76, 171387], [78, 171387], [82, 171497], [85, 171797], [96, 172757], [98, 173037], [106, 173657], [109, 173777], [113, 173997], [123, 174757], [134, 175657], [136, 176117], [142, 176397], [144, 176577]]}, {"verse": 24, "start": 177433, "end": 187984, "text": "Y algunos días después, viniendo Félix con Drusila, su mujer, la cual era judía, llamó a Pablo, y oyó de él la fe que es en Jesucristo.", "words": [[0, 177433], [2, 177556], [10, 177836], [15, 178136], [24, 178536], [33, 179376], [39, 179896], [43, 180466], [52, 181036], [55, 181136], [62, 182076], [65, 182176], [70, 182376], [74, 182616], [81, 183556], [87, 184036], [89, 184136], [96, 184456], [98, 185116], [102, 185556], [105, 185676], [108, 185896], [111, 186076], [114, 186296], [118, 186596], [121, 186836], [124, 187016]]}, {"verse": 25, "start": 188434, "end": 200690, "text": "Y disertando él de la justicia, y del dominio propio, y del juicio venidero, espantado Félix, respondió: Ahora vete; pero cuando tenga oportunidad te llamaré:", "words": [[0, 188434], [2, 188562], [13, 189382], [16, 189862], [19, 189922], [22, 190022], [32, 190762], [34, 191222], [38, 191382], [46, 191882], [54, 192282], [56, 192882], [60, 193022], [67, 193462], [77, 194202], [87, 195002], [94, 196102], [105, 197128], [111, 197388], [117, 198261], [122, 198405], [129, 198685], [135, 199085], [147, 199765], [150, 200105]]}, {"verse": 26, "start": 201040, "end": 212622, "text": "Esperando también con esto, que de parte de Pablo le serían dados dineros, porque le soltase; por lo cual, haciéndole venir muchas veces, hablaba con él.", "words": [[0, 201040], [10, 201739], [18, 202199], [22, 202519], [28, 203379], [32, 203419], [35, 203579], [41, 203959], [44, 204179], [50, 204579], [53, 204839], [60, 205279], [66, 205679], [75, 206519], [82, 206999], [85, 207179], [94, 208355], [98, 208479], [101, 208619], [107, 209039], [118, 209919], [124, 210219], [131, 210639], [138, 211139], [146, 211979], [150, 212199]]}, {"verse": 27, "start": 213072, "end": 222947, "text": "Pero al cabo de dos años recibió Félix por sucesor a Porcio Festo: y queriendo Félix ganar la gracia de los judíos, dejó preso a Pablo.", "words": [[0, 213072], [5, 213249], [8, 213459], [13, 213699], [16, 213919], [20, 214139], [25, 214519], [33, 215039], [39, 215459], [43, 215699], [51, 216559], [53, 216759], [60, 217299], [67, 218292], [69, 218420], [79, 218900], [85, 219360], [91, 219860], [94, 219980], [101, 220460], [104, 220560], [108, 220680], [116, 221580], [121, 221860], [127, 222280], [129, 222360]]}]}