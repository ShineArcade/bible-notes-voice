{"book": "LUK", "chapter": 14, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 287224, "verses": [{"verse": 1, "start": 300, "end": 8023, "text": "Y aconteció que entrando en casa de un príncipe de los fariseos un sábado a comer pan, ellos le acechaban.", "words": [[0, 300], [2, 423], [12, 1163], [16, 1363], [25, 2063], [28, 2263], [33, 2583], [36, 2843], [39, 2983], [48, 3723], [51, 3883], [55, 4003], [64, 4683], [67, 4863], [74, 5323], [76, 5443], [82, 5663], [87, 6563], [93, 6703], [96, 7363]]}, {"verse": 2, "start": 8373, "end": 13967, "text": "Y he aquí un hombre con hinchazón por retención de líquidos estaba delante de él.", "words": [[0, 8373], [2, 8557], [5, 8697], [10, 9017], [13, 9257], [20, 9557], [24, 9817], [34, 10717], [38, 10957], [48, 11677], [51, 11857], [60, 12417], [67, 12897], [75, 13477], [78, 13657]]}, {"verse": 3, "start": 13967, "end": 22911, "text": "Y respondiendo Jesús, habló a los intérpretes de la ley y a los fariseos, diciendo: ¿Es lícito sanar en sábado?", "words": [[0, 13969], [2, 14129], [15, 14909], [22, 15889], [28, 16309], [30, 16409], [34, 16529], [46, 17409], [49, 17509], [52, 17649], [56, 17969], [58, 18369], [60, 18429], [64, 18549], [74, 19589], [84, 20552], [88, 20736], [95, 21416], [101, 21996], [104, 22156]]}, {"verse": 4, "start": 23261, "end": 28563, "text": "Y ellos callaron. Entonces él tomándole, le sanó, y le despidió.", "words": [[0, 23261], [2, 23424], [8, 24038], [18, 24815], [27, 25304], [30, 25724], [41, 26144], [44, 26564], [50, 26984], [52, 27544], [55, 27664]]}, {"verse": 5, "start": 28913, "end": 37803, "text": "Y respondiendo a ellos dijo: ¿El asno o el buey de cuál de vosotros caerá en algún pozo, y no lo sacará enseguida en día de sábado?", "words": [[0, 28913], [2, 29039], [15, 29899], [17, 30059], [23, 30299], [29, 31261], [33, 31411], [38, 31871], [40, 32151], [43, 32491], [48, 32831], [51, 33011], [56, 33211], [59, 33431], [68, 33851], [74, 34351], [77, 34431], [83, 34671], [89, 35191], [91, 35511], [94, 35651], [97, 35751], [104, 36211], [114, 36731], [117, 36831], [121, 37031], [124, 37171]]}, {"verse": 6, "start": 38153, "end": 40753, "text": "Y no le podían replicar a estas cosas.", "words": [[0, 38153], [2, 38261], [5, 38361], [8, 38501], [15, 38941], [24, 39621], [26, 39781], [32, 39941]]}, {"verse": 7, "start": 41103, "end": 49592, "text": "Y observando cómo escogían los primeros asientos a la mesa, refirió una parábola a los invitados, diciéndoles:", "words": [[0, 41103], [2, 41241], [13, 41901], [18, 42221], [27, 42801], [31, 43021], [40, 43601], [49, 44061], [51, 44281], [54, 44381], [60, 45321], [68, 46021], [72, 46301], [81, 46921], [83, 47161], [87, 47281], [98, 48461]]}, {"verse": 8, "start": 49942, "end": 59017, "text": "Cuando seas invitado de alguno a bodas, no te sientes en el primer lugar, no sea que otro más honrado que tú esté por él invitado,", "words": [[0, 49942], [7, 50144], [12, 50444], [21, 51144], [24, 51304], [31, 51744], [33, 51844], [40, 52664], [43, 52944], [46, 53124], [54, 53544], [57, 53764], [60, 53924], [67, 54304], [74, 55184], [77, 55384], [81, 55624], [85, 55844], [90, 56064], [94, 56424], [102, 57164], [106, 57364], [109, 57564], [114, 57804], [118, 58084], [121, 58224]]}, {"verse": 9, "start": 59367, "end": 68495, "text": "Y viniendo el que te llamó a ti y a él, te diga: Da lugar a este: y entonces comiences con vergüenza a tener el lugar último.", "words": [[0, 59367], [2, 59474], [11, 59994], [14, 60114], [18, 60214], [21, 60374], [27, 60714], [29, 60874], [32, 60994], [34, 61154], [36, 61234], [40, 61554], [43, 61834], [49, 62565], [52, 62730], [58, 63010], [60, 63250], [66, 64096], [68, 64241], [77, 64701], [87, 65621], [91, 65841], [101, 66521], [103, 66721], [109, 66981], [112, 67221], [118, 67541]]}, {"verse": 10, "start": 68845, "end": 82670, "text": "Pero cuando seas invitado, ve, y siéntate en el último lugar; para que cuando venga el que te convidó, te diga: Amigo, sube más arriba: entonces tendrás gloria delante de los que juntamente se asientan a la mesa.", "words": [[0, 68845], [5, 68972], [12, 69272], [17, 69592], [27, 70272], [31, 70532], [33, 71172], [42, 71772], [45, 71932], [48, 72052], [55, 72312], [62, 73155], [67, 73321], [71, 73480], [78, 73700], [84, 74020], [87, 74340], [91, 74440], [94, 74601], [103, 75080], [106, 75240], [112, 75895], [119, 76241], [124, 76821], [128, 77001], [136, 77809], [145, 78292], [153, 78912], [160, 79532], [168, 80032], [171, 80192], [175, 80332], [179, 80512], [190, 81172], [193, 81432], [202, 82012], [204, 82072], [207, 82172]]}, {"verse": 11, "start": 83020, "end": 90042, "text": "Porque cualquiera que se enaltece, será humillado; y el que se humilla, será enaltecido.", "words": [[0, 83020], [7, 83225], [18, 83865], [22, 84025], [25, 84185], [35, 84965], [40, 85565], [51, 86775], [53, 87089], [56, 87209], [60, 87349], [63, 87529], [72, 88109], [77, 88589]]}, {"verse": 12, "start": 90392, "end": 105964, "text": "Y dijo también al que le había invitado: Cuando haces comida o cena, no llames a tus amigos, ni a tus hermanos, ni a tus parientes, ni a vecinos ricos; no sea que ellos también te vuelvan a invitar, y te sea hecha compensación.", "words": [[0, 90392], [2, 90516], [7, 90796], [15, 91216], [18, 91636], [22, 91816], [25, 91976], [31, 92256], [41, 93307], [48, 93551], [54, 94011], [61, 94491], [63, 94731], [69, 95471], [72, 95571], [79, 95971], [81, 96131], [85, 96251], [93, 96771], [96, 97291], [98, 97411], [102, 97551], [112, 98071], [115, 98591], [117, 98671], [121, 98751], [132, 99341], [135, 99931], [137, 100011], [145, 100431], [152, 101389], [155, 101515], [159, 101735], [163, 101955], [169, 102215], [177, 102575], [180, 102855], [188, 103275], [190, 103355], [199, 103835], [201, 104028], [204, 104222], [208, 104415], [214, 104695]]}, {"verse": 13, "start": 106314, "end": 112728, "text": "Pero cuando haces banquete, llama a los pobres, los mancos, los cojos, los ciegos;", "words": [[0, 106314], [5, 106478], [12, 106758], [18, 107298], [28, 108218], [34, 108658], [36, 108918], [40, 109038], [48, 110018], [52, 110118], [60, 111038], [64, 111138], [71, 111978], [75, 112098]]}, {"verse": 14, "start": 113078, "end": 121430, "text": "Y serás bienaventurado; porque no te pueden retribuir; pero te será recompensado en la resurrección de los justos.", "words": [[0, 113078], [2, 113183], [8, 114151], [24, 115312], [31, 115516], [34, 115776], [37, 115936], [44, 116276], [55, 117469], [60, 117773], [63, 117973], [68, 118213], [81, 119313], [84, 119453], [87, 119633], [100, 120513], [103, 120673], [107, 120813]]}, {"verse": 15, "start": 121780, "end": 130383, "text": "Y oyendo esto uno de los que juntamente estaban sentados a la mesa, le dijo: Bienaventurado el que comerá pan en el reino de los cielos.", "words": [[0, 121780], [2, 122100], [9, 122480], [14, 123240], [18, 123420], [21, 123600], [25, 123720], [29, 123880], [40, 124480], [48, 124840], [57, 125400], [59, 125580], [62, 125700], [68, 126320], [71, 126400], [77, 127533], [92, 128013], [95, 128173], [99, 128313], [106, 128713], [110, 128993], [113, 129193], [116, 129313], [122, 129573], [125, 129673], [129, 129793]]}, {"verse": 16, "start": 130663, "end": 136445, "text": "Él entonces le dijo: Un hombre hizo una grande cena, y invitó a muchos.", "words": [[0, 130663], [3, 130925], [12, 131565], [15, 131945], [21, 132703], [24, 132853], [31, 133173], [36, 133613], [40, 133973], [47, 134313], [53, 134753], [55, 135008], [62, 135708], [64, 135808]]}, {"verse": 17, "start": 136795, "end": 143702, "text": "Y a la hora de la cena envió a su siervo a decir a los invitados: Venid, que ya está todo preparado.", "words": [[0, 136795], [2, 136902], [4, 136982], [7, 137102], [12, 137362], [15, 137522], [18, 137642], [23, 137982], [29, 138782], [31, 138902], [34, 139042], [41, 139542], [43, 139662], [49, 139902], [51, 140082], [55, 140242], [66, 141403], [73, 141827], [77, 141987], [80, 142187], [85, 142427], [90, 142807]]}, {"verse": 18, "start": 144052, "end": 154257, "text": "Y comenzaron todos a una a excusarse. El primero le dijo: He comprado un terreno, y necesito salir y verlo; te ruego que me des por excusado.", "words": [[0, 144052], [2, 144175], [13, 144875], [19, 145255], [21, 145635], [25, 145855], [27, 146115], [38, 147364], [41, 147507], [49, 147867], [52, 148067], [58, 148790], [61, 148875], [70, 149415], [73, 149575], [82, 150115], [84, 150455], [93, 151055], [99, 151315], [101, 151535], [108, 152279], [111, 152364], [117, 152724], [121, 152884], [124, 153004], [128, 153184], [132, 153344]]}, {"verse": 19, "start": 154607, "end": 162180, "text": "Y el otro dijo: He comprado cinco yuntas de bueyes, y voy a probarlos; te ruego que me des por excusado.", "words": [[0, 154607], [2, 154753], [5, 154873], [10, 155153], [16, 156180], [19, 156364], [28, 156864], [34, 157354], [41, 157844], [44, 157964], [52, 158384], [54, 158864], [58, 159004], [60, 159164], [71, 160202], [74, 160287], [80, 160647], [84, 160807], [87, 160927], [91, 161107], [95, 161267]]}, {"verse": 20, "start": 162530, "end": 166868, "text": "Y el otro dijo: Acabo de casarme, y por tanto no puedo ir.", "words": [[0, 162530], [2, 162676], [5, 162796], [10, 163076], [16, 164103], [22, 164485], [25, 164625], [34, 165225], [36, 165430], [40, 165610], [46, 165930], [49, 166130], [55, 166390]]}, {"verse": 21, "start": 167218, "end": 182977, "text": "Y vuelto el siervo, hizo saber estas cosas a su señor. Entonces enojado el padre de la familia, dijo a su siervo: Ve pronto por las plazas y por las calles de la ciudad, y mete acá los pobres, los mancos, y cojos, y ciegos.", "words": [[0, 167218], [2, 167380], [9, 167800], [12, 167980], [20, 168472], [25, 168965], [31, 169285], [37, 169565], [43, 169965], [45, 170225], [48, 170365], [55, 171204], [64, 171817], [72, 172597], [75, 172737], [81, 172997], [84, 173217], [87, 173317], [96, 173737], [101, 174097], [103, 174357], [106, 174497], [114, 175292], [117, 175477], [124, 175857], [128, 176197], [132, 176377], [139, 176957], [141, 177097], [145, 177257], [149, 177457], [156, 177877], [159, 177997], [162, 178097], [170, 178377], [172, 178737], [177, 179017], [181, 179357], [185, 179877], [193, 180817], [197, 180877], [205, 181517], [207, 181717], [214, 182157], [216, 182337]]}, {"verse": 22, "start": 183327, "end": 188558, "text": "Y dijo el siervo: Señor, hecho es como mandaste, y aún hay lugar.", "words": [[0, 183327], [2, 183454], [7, 183714], [10, 183874], [18, 184696], [25, 185073], [31, 185433], [34, 185653], [39, 185873], [49, 186853], [51, 187153], [55, 187714], [59, 187914]]}, {"verse": 23, "start": 188908, "end": 196318, "text": "Y dijo el señor al siervo: Ve por los caminos y por las cercas, y fuérzalos a entrar, para que se llene mi casa.", "words": [[0, 188908], [2, 189024], [7, 189324], [10, 189444], [16, 189704], [19, 189944], [27, 190812], [30, 191016], [34, 191296], [38, 191456], [46, 191936], [48, 192096], [52, 192316], [56, 192496], [64, 193196], [66, 193616], [76, 194036], [78, 194116], [86, 194536], [91, 194976], [95, 195136], [98, 195256], [104, 195556], [107, 195696]]}, {"verse": 24, "start": 196668, "end": 201358, "text": "Porque os digo que ninguno de aquellos hombres que fueron llamados, gustará mi cena.", "words": [[0, 196668], [7, 196851], [10, 197031], [15, 197251], [19, 197431], [27, 197911], [30, 198011], [39, 198231], [47, 198671], [51, 198871], [58, 199131], [68, 199771], [76, 200591], [79, 200851]]}, {"verse": 25, "start": 201708, "end": 206197, "text": "Y grandes multitudes iban con él; y volviéndose les dijo:", "words": [[0, 201708], [2, 202016], [10, 202376], [21, 203216], [26, 203656], [30, 203876], [34, 204500], [36, 204605], [48, 205125], [52, 205645]]}, {"verse": 26, "start": 206547, "end": 217881, "text": "Si alguno viene a mí, y no aborrece a su padre, y madre, y mujer, e hijos, y hermanos, y hermanas, y aun también su vida, no puede ser mi discípulo.", "words": [[0, 206547], [3, 206711], [10, 207211], [16, 207411], [18, 207611], [22, 207771], [24, 208271], [27, 208471], [36, 209091], [38, 209231], [41, 209371], [48, 210191], [50, 210411], [57, 211131], [59, 211151], [66, 211991], [68, 212091], [75, 212831], [77, 212911], [87, 213691], [89, 213771], [99, 214523], [101, 214683], [105, 214823], [113, 215223], [116, 215483], [122, 215803], [125, 215983], [131, 216263], [135, 216643], [138, 216883]]}, {"verse": 27, "start": 218231, "end": 223964, "text": "Y cualquiera que no lleva su cruz, y viene en pos de mí, no puede ser mi discípulo.", "words": [[0, 218231], [2, 218328], [13, 218888], [17, 219038], [20, 219188], [26, 219428], [29, 219628], [35, 220228], [37, 220448], [43, 220728], [46, 221088], [50, 221308], [53, 221488], [57, 221748], [60, 222388], [66, 222628], [70, 222948], [73, 223128]]}, {"verse": 28, "start": 224314, "end": 232882, "text": "Porque ¿cuál de vosotros, queriendo edificar una torre, no cuenta primero sentado los gastos, si tiene lo que necesita para acabarla?", "words": [[0, 224436], [7, 224596], [13, 224956], [16, 225096], [26, 225596], [36, 226236], [45, 226796], [49, 227036], [56, 227576], [59, 228076], [66, 228436], [74, 228816], [82, 229476], [86, 229636], [94, 230256], [97, 230536], [103, 230836], [106, 231016], [110, 231156], [119, 231696], [124, 232016]]}, {"verse": 29, "start": 233232, "end": 241564, "text": "No sea que, después de poner los cimientos, no pueda terminarla, todos los que lo vean, no comiencen a hacer burla de él,", "words": [[0, 233232], [3, 233377], [7, 233617], [12, 233837], [20, 234137], [23, 234357], [29, 234597], [33, 234857], [44, 235477], [47, 235937], [53, 236277], [65, 237397], [71, 237657], [75, 238117], [79, 238297], [82, 238437], [88, 238937], [91, 239277], [101, 239897], [103, 240037], [109, 240337], [115, 240917], [118, 241117]]}, {"verse": 30, "start": 241914, "end": 246350, "text": "Diciendo: Este hombre comenzó a edificar, y no pudo acabar.", "words": [[0, 241914], [10, 243036], [15, 243404], [22, 243644], [30, 244184], [32, 244244], [42, 244744], [44, 245064], [47, 245204], [52, 245644]]}, {"verse": 31, "start": 246700, "end": 257587, "text": "¿O cuál rey, habiendo de ir a hacer guerra contra otro rey, sentándose primero no consulta si puede salir al encuentro con diez mil al que viene contra él con veinte mil?", "words": [[0, 246700], [3, 246802], [8, 247042], [13, 247482], [22, 248042], [25, 248242], [28, 248462], [30, 248582], [36, 248902], [43, 249242], [50, 249702], [55, 250042], [60, 250762], [71, 251422], [79, 251762], [82, 252002], [91, 252662], [94, 252822], [100, 253082], [106, 253402], [109, 253622], [119, 254462], [123, 254642], [128, 254882], [132, 255242], [135, 255542], [139, 255702], [145, 255942], [152, 256362], [155, 256622], [159, 256802], [166, 257142]]}, {"verse": 32, "start": 257937, "end": 264366, "text": "De otra manera, cuando aun el otro está lejos, le ruega por la paz, enviándole una delegación.", "words": [[0, 257937], [3, 258082], [8, 258262], [16, 258622], [23, 258862], [27, 259342], [30, 259582], [35, 259802], [40, 260022], [47, 260462], [50, 260922], [56, 261282], [60, 261462], [63, 261602], [68, 262282], [79, 263122], [83, 263382]]}, {"verse": 33, "start": 264716, "end": 271699, "text": "Así pues, cualquiera de vosotros que no renuncia a todas las cosas que posee, no puede ser mi discípulo.", "words": [[0, 264716], [4, 265008], [10, 265308], [21, 265988], [24, 266128], [33, 266728], [37, 266988], [40, 267208], [49, 267928], [51, 268088], [57, 268248], [61, 268548], [67, 268828], [71, 269068], [78, 269808], [81, 270068], [87, 270388], [91, 270708], [94, 270928]]}, {"verse": 34, "start": 272049, "end": 278348, "text": "Buena es la sal; pero si aun la sal pierde su sabor, ¿con qué se sazonará?", "words": [[0, 272049], [6, 272276], [9, 272536], [12, 272796], [17, 273502], [22, 273646], [25, 273906], [29, 274266], [32, 274486], [36, 274846], [43, 275366], [46, 275546], [53, 276526], [58, 276866], [62, 277166], [65, 277386]]}, {"verse": 35, "start": 278698, "end": 286824, "text": "Ni para la tierra, ni para el montón de estiércol es buena; fuera la arrojan. Quien tiene oídos para oír, oiga.", "words": [[0, 278747], [3, 278827], [8, 279047], [11, 279227], [19, 279697], [22, 280167], [27, 280347], [30, 280487], [37, 280927], [40, 281227], [50, 281527], [53, 281827], [60, 282689], [66, 282997], [69, 283522], [78, 284202], [84, 284426], [90, 284706], [96, 285186], [101, 285426], [106, 286326]]}]}