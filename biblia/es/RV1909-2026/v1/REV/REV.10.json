65, 58676], [67, 58816], [73, 59016], [76, 59216], [86, 60176], [89, 60256], [98, 60756], [101, 60856], [106, 61076], [111, 61336], [122, 62452], [127, 62649], [130, 62889], [133, 63009], [141, 63489], [143, 63569], [147, 63689], [155, 64149], [159, 64309]]}, {"verse": 8, "start": 65566, "end": 77254, "text": "Y la voz que oí del cielo hablaba otra vez conmigo, y decía: Ve, y toma el librito abierto de la mano del ángel que está sobre el mar y sobre la tierra.", "words": [[0, 65566], [2, 65685], [5, 65805], [9, 66045], [13, 66245], [16, 66445], [20, 66605], [26, 66925], [34, 67385], [39, 67585], [43, 67845], [52, 68745], [54, 68805], [61, 69669], [65, 69994], [67, 70594], [72, 70894], [75, 71074], [83, 71514], [91, 72014], [94, 72174], [97, 72294], [102, 72634], [106, 72834], [112, 73374], [116, 73854], [121, 74134], [127, 74474], [130, 74674], [134, 74934], [136, 75334], [142, 75574], [145, 75754]]}, {"verse": 9, "start": 77776, "end": 89093, "text": "Y fui al ángel, diciéndole que me diese el librito, y él me dijo: Toma, y cómelo; y él te hará amargar tu vientre, pero en tu boca será dulce como la miel.", "words": [[0, 77776], [2, 77905], [6, 78065], [9, 78285], [16, 78885], [27, 79425], [31, 79605], [34, 79765], [40, 80125], [43, 80265], [52, 81285], [54, 81365], [57, 81505], [60, 81625], [66, 82413], [72, 82778], [74, 82998], [82, 83912], [84, 84071], [87, 84191], [90, 84331], [95, 84551], [103, 84951], [106, 85071], [115, 86051], [120, 86331], [123, 86471], [126, 86571], [131, 86851], [136, 87131], [142, 87531], [147, 87711], [150, 87851]]}, {"verse": 10, "start": 89543, "end": 97857, "text": "Y tomé el librito de la mano del ángel, y lo devoré; y era dulce en mi boca como la miel; y cuando lo hube devorado, fue amargo mi vientre.", "words": [[0, 89543], [2, 89644], [7, 90024], [10, 90294], [18, 90564], [21, 90684], [24, 90804], [29, 91084], [33, 91264], [40, 91724], [42, 91884], [45, 91984], [53, 92816], [55, 92957], [59, 93097], [65, 93497], [68, 93597], [71,