{"book": "LUK", "chapter": 20, "lang": "en", "bible": "KJV-2026", "engine": "chatterbox-videos-v1", "durationMs": 312369, "verses": [{"verse": 1, "start": 300, "end": 10351, "text": "And it came to pass, that on one of those days, as he taught the people in the temple, and preached the gospel, the chief priests and the scribes came upon him with the elders,", "words": [[0, 300], [4, 436], [7, 556], [12, 796], [15, 996], [21, 1476], [26, 1796], [29, 1976], [33, 2216], [36, 2336], [42, 2556], [48, 2976], [51, 3276], [54, 3396], [61, 3656], [65, 3836], [72, 4116], [75, 4336], [79, 4436], [87, 4776], [91, 5376], [100, 5716], [104, 5956], [112, 6875], [116, 6972], [122, 7232], [130, 7612], [134, 8012], [138, 8152], [146, 8632], [151, 8792], [156, 9072], [160, 9372], [165, 9572], [169, 9692]]}, {"verse": 2, "start": 10801, "end": 17834, "text": "And spoke to him, saying, Tell us, by what authority are you doing these things? or who is he that gave you this authority?", "words": [[0, 10801], [4, 10943], [10, 11203], [13, 11463], [18, 11663], [26, 13104], [31, 13237], [35, 13357], [38, 13537], [43, 13717], [53, 14197], [57, 14497], [61, 14637], [67, 14917], [73, 15117], [81, 15904], [84, 16047], [88, 16227], [91, 16407], [94, 16627], [99, 16827], [104, 17047], [108, 17167], [113, 17327]]}, {"verse": 3, "start": 18184, "end": 23217, "text": "And he answered and said to them, I will also ask you one thing; and answer me:", "words": [[0, 18184], [4, 18320], [7, 18440], [16, 18820], [20, 19020], [25, 19260], [28, 19460], [34, 20065], [36, 20232], [41, 20392], [46, 20692], [50, 20992], [54, 21172], [58, 21412], [65, 22185], [69, 22343], [76, 22723]]}, {"verse": 4, "start": 23667, "end": 27006, "text": "The baptism of John, was it from heaven, or of men?", "words": [[0, 23667], [4, 23803], [12, 24183], [15, 24483], [21, 25303], [25, 25403], [28, 25543], [33, 25723], [41, 25963], [44, 26423], [47, 26583]]}, {"verse": 5, "start": 27356, "end": 33982, "text": "And they reasoned with themselves, saying, If we shall say, From heaven; he will say, Why then believed you him not?", "words": [[0, 27356], [4, 27460], [9, 27580], [18, 28060], [23, 28160], [35, 29040], [43, 29850], [46, 29993], [49, 30133], [55, 30333], [60, 30673], [65, 30973], [73, 31828], [76, 31907], [81, 32067], [86, 32287], [90, 32547], [95, 32747], [104, 33087], [108, 33287], [112, 33467]]}, {"verse": 6, "start": 34432, "end": 40345, "text": "But and if we say, Of men; all the people will stone us: for they are persuaded that John was a prophet.", "words": [[0, 34432], [4, 34549], [8, 34669], [11, 34789], [14, 34909], [19, 35149], [22, 35329], [27, 36063], [31, 36249], [35, 36389], [42, 36629], [47, 36849], [53, 37149], [57, 37871], [61, 37990], [66, 38210], [70, 38390], [80, 38810], [85, 39150], [90, 39430], [94, 39650], [96, 39770]]}, {"verse": 7, "start": 40695, "end": 43334, "text": "And they answered, that they could not tell from where it was.", "words": [[0, 40695], [4, 40847], [9, 40967], [19, 41287], [24, 41527], [29, 41687], [35, 41807], [39, 41987], [44, 42247], [49, 42467], [55, 42627], [58, 42767]]}, {"verse": 8, "start": 43784, "end": 48750, "text": "And Jesus said to them, Neither tell I you by what authority I do these things.", "words": [[0, 43784], [4, 43933], [10, 44253], [15, 44593], [18, 44753], [24, 45401], [32, 45744], [37, 46084], [39, 46284], [43, 46504], [46, 46744], [51, 47004], [61, 47384], [63, 47664], [66, 47864], [72, 48104]]}, {"verse": 9, "start": 49100, "end": 58506, "text": "Then began he to speak to the people this parable; A certain man planted a vineyard, and let it forth to vinedressers, and went into a far country for a long time.", "words": [[0, 49100], [5, 49289], [11, 49669], [14, 50009], [17, 50309], [23, 50529], [26, 50729], [30, 50849], [37, 51109], [42, 51369], [51, 52243], [53, 52387], [61, 52587], [65, 52927], [73, 53307], [75, 53467], [85, 53887], [89, 54217], [93, 54547], [96, 54667], [102, 54887], [105, 55357], [119, 55827], [123, 56247], [128, 56427], [133, 56647], [135, 56807], [139, 57027], [147, 57407], [151, 57647], [153, 57747], [158, 57967]]}, {"verse": 10, "start": 58956, "end": 67819, "text": "And at the season he sent a servant to the vinedressers, that they should give him of the fruit of the vineyard: but the vinedressers beat him, and sent him away empty.", "words": [[0, 58956], [4, 59186], [7, 59326], [11, 59446], [18, 59866], [21, 60126], [26, 60386], [28, 60526], [36, 60866], [39, 61086], [43, 61516], [57, 61946], [62, 62446], [67, 62606], [74, 62766], [79, 63006], [83, 63246], [86, 63426], [90, 63526], [96, 63786], [99, 63946], [103, 64046], [113, 64838], [117, 65094], [121, 65394], [134, 65694], [139, 65974], [144, 66194], [148, 66574], [153, 66834], [157, 67014], [162, 67234]]}, {"verse": 11, "start": 68269, "end": 74569, "text": "And again he sent another servant: and they beat him also, and entreated him shamefully, and sent him away empty.", "words": [[0, 68269], [4, 68370], [10, 68650], [13, 68870], [18, 69110], [26, 69430], [35, 70323], [39, 70442], [44, 70522], [49, 70742], [53, 70902], [59, 71242], [63, 71762], [73, 72162], [77, 72362], [89, 72942], [93, 73382], [98, 73602], [102, 73782], [107, 74022]]}, {"verse": 12, "start": 74919, "end": 79344, "text": "And again he sent a third: and they wounded him also, and cast him out.", "words": [[0, 74919], [4, 75072], [10, 75551], [13, 75652], [18, 75892], [20, 76051], [27, 76898], [31, 77078], [36, 77198], [44, 77498], [48, 77738], [54, 78098], [58, 78498], [63, 78718], [67, 78958]]}, {"verse": 13, "start": 79794, "end": 88505, "text": "Then said the lord of the vineyard, What shall I do? I will send my beloved son: it may be they will reverence him when they see him.", "words": [[0, 79794], [5, 80218], [10, 80498], [14, 80698], [19, 80898], [22, 81098], [26, 81218], [36, 82587], [41, 82716], [47, 82936], [49, 83076], [53, 83759], [55, 83882], [60, 84002], [65, 84242], [68, 84422], [76, 84782], [81, 85702], [84, 85827], [88, 86007], [91, 86327], [96, 86727], [101, 86887], [111, 87507], [115, 87647], [120, 87807], [125, 87967], [129, 88187]]}, {"verse": 14, "start": 88855, "end": 97991, "text": "But when the vinedressers saw him, they reasoned among themselves, saying, This is the heir: come, let us kill him, that the inheritance may be ours.", "words": [[0, 88855], [4, 88959], [9, 89119], [13, 89469], [26, 89819], [30, 90119], [35, 90639], [40, 90759], [49, 91239], [55, 91379], [67, 92539], [75, 93437], [80, 93673], [83, 93813], [87, 94128], [93, 94713], [99, 95237], [103, 95337], [106, 95477], [111, 95737], [116, 96217], [121, 96317], [125, 96457], [137, 96877], [141, 97197], [144, 97337]]}, {"verse": 15, "start": 98291, "end": 103976, "text": "So they cast him out of the vineyard, and killed him. What therefore shall the lord of the vineyard do to them?", "words": [[0, 98291], [3, 98421], [8, 98581], [13, 98901], [17, 99141], [21, 99401], [24, 99501], [28, 99601], [38, 100021], [42, 100241], [49, 100521], [54, 101212], [59, 101349], [69, 101789], [75, 102109], [79, 102289], [84, 102529], [87, 102669], [91, 102769], [100, 103109], [103, 103409], [106, 103569]]}, {"verse": 16, "start": 104426, "end": 111732, "text": "He shall come and destroy these vinedressers, and shall give the vineyard to others. And when they heard it, they said, God forbid.", "words": [[0, 104426], [3, 104533], [9, 104733], [14, 105033], [18, 105153], [26, 105553], [32, 106373], [46, 107193], [50, 107293], [56, 107473], [61, 107713], [65, 107913], [74, 108253], [77, 108433], [85, 109328], [89, 109447], [94, 109587], [99, 109767], [105, 110007], [109, 110247], [114, 110327], [120, 111063], [124, 111248]]}, {"verse": 17, "start": 112082, "end": 120127, "text": "And he beheld them, and said, What is this then that is written, The stone which the builders rejected, the same is become the head of the corner?", "words": [[0, 112082], [4, 112204], [7, 112324], [14, 112784], [20, 113064], [24, 113344], [30, 114086], [35, 114232], [38, 114412], [43, 114652], [48, 114952], [53, 115192], [56, 115332], [65, 116152], [69, 116312], [75, 116652], [81, 116892], [85, 117072], [94, 117332], [104, 118292], [108, 118452], [113, 118662], [116, 118872], [123, 119172], [127, 119352], [132, 119472], [135, 119572], [139, 119672]]}, {"verse": 18, "start": 120577, "end": 127443, "text": "Whoever shall fall upon that stone shall be broken; but on whomsoever it shall fall, it will grind him to powder.", "words": [[0, 120577], [8, 121014], [14, 121334], [19, 121574], [24, 121814], [29, 122074], [35, 122414], [41, 122654], [44, 122794], [52, 123582], [56, 123715], [59, 124155], [70, 124595], [73, 124795], [79, 124975], [85, 125915], [88, 126035], [93, 126155], [99, 126475], [103, 126735], [106, 126895]]}, {"verse": 19, "start": 127793, "end": 138300, "text": "¶ And the chief priests and the scribes the same hour sought to lay hands on him; and they feared the people: for they perceived that he had spoken this parable against them.", "words": [[2, 127793], [6, 127939], [10, 128039], [16, 128299], [24, 128759], [28, 129239], [32, 129399], [40, 130279], [44, 130439], [49, 130819], [54, 131179], [61, 131559], [64, 131799], [68, 131979], [74, 132279], [77, 132519], [82, 133118], [86, 133262], [91, 133402], [98, 133742], [102, 133962], [110, 134805], [114, 135085], [119, 135245], [129, 135785], [134, 136105], [137, 136245], [141, 136405], [148, 136805], [153, 137085], [161, 137545], [169, 137865]]}, {"verse": 20, "start": 138750, "end": 149884, "text": "And they watched him, and sent forth spies, which should feign themselves just men, that they might take hold of his words, that so they might deliver him to the power and authority of the governor.", "words": [[0, 138750], [4, 138901], [9, 139001], [17, 139361], [22, 139641], [26, 139901], [31, 140161], [37, 140421], [44, 141421], [50, 141581], [57, 141821], [63, 142181], [74, 142521], [79, 142901], [84, 143201], [89, 143781], [94, 143921], [100, 144121], [105, 144401], [110, 144701], [113, 144901], [117, 145041], [124, 145994], [129, 146121], [132, 146341], [137, 146521], [143, 146721], [151, 147121], [155, 147361], [158, 147541], [162, 147681], [168, 148041], [172, 148281], [182, 148781], [185, 149101], [189, 149221]]}, {"verse": 21, "start": 150334, "end": 158974, "text": "And they asked him, saying, Master, we know that you say and teach rightly, neither do you accept the person of any, but teach the way of God truly:", "words": [[0, 150334], [4, 150472], [9, 150632], [15, 150972], [20, 151212], [28, 152514], [36, 152856], [39, 153076], [44, 153236], [49, 153416], [53, 153536], [57, 153816], [61, 154076], [67, 154336], [76, 155216], [84, 155456], [87, 155696], [91, 155816], [98, 156156], [102, 156316], [109, 156596], [112, 156776], [117, 157436], [121, 157576], [127, 157776], [131, 157956], [135, 158096], [138, 158216], [142, 158416]]}, {"verse": 22, "start": 159424, "end": 162416, "text": "Is it lawful for us to give tribute to Cæsar, or no?", "words": [[0, 159424], [3, 159574], [6, 159714], [13, 160154], [17, 160354], [20, 160514], [23, 160654], [28, 160894], [36, 161274], [39, 161534], [46, 161794], [49, 162114]]}, {"verse": 23, "start": 162766, "end": 166511, "text": "But he perceived their craftiness, and said to them, Why do you tempt me?", "words": [[0, 162766], [4, 162871], [7, 162971], [17, 163411], [23, 163631], [35, 164271], [39, 164571], [44, 164791], [47, 164991], [53, 165514], [57, 165677], [60, 165837], [64, 165937], [70, 166177]]}, {"verse": 24, "start": 166961, "end": 175761, "text": "Show me a denarius. Whose image and inscription has it? They answered and said, Cæsar’s.", "words": [[0, 166961], [5, 167190], [8, 167410], [10, 167490], [20, 168580], [26, 168709], [32, 169109], [36, 169369], [48, 169809], [52, 170229], [54, 172059], [56, 173600], [61, 173714], [70, 174134], [74, 174394], [80, 175442]]}, {"verse": 25, "start": 176111, "end": 183453, "text": "And he said to them, Render therefore to Cæsar the things which be Cæsar’s, and to God the things which be God’s.", "words": [[0, 176111], [4, 176241], [7, 176361], [12, 176601], [15, 176801], [21, 177397], [28, 177702], [38, 178302], [41, 178612], [47, 178922], [51, 179262], [58, 179622], [64, 179882], [67, 180402], [76, 180922], [80, 181282], [83, 181442], [87, 181782], [91, 182062], [98, 182362], [104, 182602], [107, 182782]]}, {"verse": 26, "start": 183803, "end": 190346, "text": "And they could not take hold of his words before the people: and they marvelled at his answer, and kept silent.", "words": [[0, 183803], [4, 183949], [9, 184049], [15, 184209], [19, 184449], [24, 184749], [29, 185049], [32, 185229], [36, 185409], [42, 185809], [49, 186269], [53, 186509], [61, 187381], [65, 187525], [70, 187895], [80, 188265], [83, 188345], [87, 188525], [95, 188985], [99, 189365], [104, 189645]]}, {"verse": 27, "start": 190796, "end": 197437, "text": "¶ Then came to him certain of the Sadducees, which deny that there is any resurrection; and they asked him,", "words": [[2, 190796], [7, 190995], [12, 191275], [15, 191515], [19, 191695], [27, 192055], [30, 192315], [34, 192415], [45, 193355], [51, 193495], [56, 193875], [61, 194195], [67, 194355], [70, 194515], [74, 194695], [88, 195912], [92, 196038], [97, 196158], [103, 196833]]}, {"verse": 28, "start": 197887, "end": 208698, "text": "Saying, Master, Moses wrote to us, If any man’s brother die, having a wife, and he die without children, that his brother should take his wife, and raise up seed to his brother.", "words": [[0, 198019], [8, 198439], [16, 198763], [22, 199163], [28, 199483], [31, 199683], [35, 199843], [38, 200263], [42, 200563], [48, 200923], [56, 201143], [61, 201503], [68, 201903], [70, 202083], [76, 202383], [80, 202803], [83, 202983], [87, 203283], [95, 203543], [105, 204083], [110, 204523], [114, 204683], [122, 204983], [129, 205203], [134, 205463], [138, 205623], [144, 206363], [148, 206526], [154, 206746], [157, 206946], [162, 207146], [165, 207326], [169, 207446]]}, {"verse": 29, "start": 209148, "end": 213711, "text": "There were therefore seven brethren: and the first took a wife, and died without children.", "words": [[0, 209148], [6, 209283], [11, 209443], [21, 209783], [27, 210223], [37, 211135], [41, 211259], [45, 211339], [51, 211539], [56, 211779], [58, 211859], [64, 212139], [68, 212499], [73, 212779], [81, 213099]]}, {"verse": 30, "start": 214161, "end": 216998, "text": "And the second took her to wife, and he died childless.", "words": [[0, 214161], [4, 214304], [8, 214404], [15, 214704], [20, 214944], [24, 215044], [27, 215164], [33, 215684], [37, 215904], [40, 216024], [45, 216224]]}, {"verse": 31, "start": 217448, "end": 222854, "text": "And the third took her; and in like manner the seven also: and they left no children, and died.", "words": [[0, 217448], [4, 217608], [8, 217708], [14, 217968], [19, 218208], [24, 218784], [28, 218930], [31, 219030], [36, 219210], [43, 219530], [47, 219780], [53, 220030], [59, 220865], [63, 221003], [68, 221123], [73, 221363], [76, 221583], [86, 222003], [90, 222343]]}, {"verse": 32, "start": 223304, "end": 224877, "text": "Last of all the woman died also.", "words": [[0, 223304], [5, 223524], [8, 223704], [12, 223924], [16, 223924], [22, 224124], [27, 224384]]}, {"verse": 33, "start": 225327, "end": 230260, "text": "Therefore in the resurrection whose wife of them is she? for seven had her to wife.", "words": [[0, 225327], [10, 225786], [13, 225886], [17, 225986], [30, 226866], [36, 227026], [41, 227306], [44, 227466], [49, 227686], [52, 227826], [57, 228841], [61, 228901], [67, 229241], [71, 229561], [75, 229721], [78, 229861]]}, {"verse": 34, "start": 230610, "end": 237372, "text": "And Jesus answering said to them, The children of this world marry, and are given in marriage:", "words": [[0, 230610], [4, 230758], [10, 231078], [20, 231678], [25, 231958], [28, 232158], [34, 233954], [38, 234033], [47, 234413], [50, 234613], [55, 234813], [61, 235133], [68, 235513], [72, 236133], [76, 236253], [82, 236493], [85, 236733]]}, {"verse": 35, "start": 237822, "end": 245200, "text": "But they which shall be accounted worthy to obtain that world, and the resurrection from the dead, neither marry, nor are given in marriage:", "words": [[0, 237822], [4, 237944], [9, 238184], [15, 238404], [21, 238644], [24, 238804], [34, 239164], [41, 239604], [44, 239844], [51, 240224], [56, 240444], [63, 241184], [67, 241344], [71, 241444], [84, 241824], [89, 242224], [93, 242344], [99, 242624], [107, 242964], [114, 243384], [118, 243944], [122, 244224], [128, 244464], [131, 244664]]}, {"verse": 36, "start": 245650, "end": 253213, "text": "Neither can they die any more: for they are equal to the angels; and are the children of God, being the children of the resurrection.", "words": [[0, 245650], [8, 245914], [12, 246174], [17, 246294], [21, 246614], [25, 246934], [31, 247519], [35, 247641], [40, 247821], [44, 247961], [50, 248301], [53, 248561], [57, 248701], [65, 249685], [69, 249802], [73, 249922], [77, 250042], [86, 250362], [89, 250542], [94, 250862], [100, 251482], [104, 251682], [113, 252062], [116, 252262], [120, 252362]]}, {"verse": 37, "start": 253663, "end": 262313, "text": "Now that the dead are raised, even Moses showed at the bush, when he calls the Lord the God of Abraham, and the God of Isaac, and the God of Jacob.", "words": [[0, 253663], [4, 253879], [9, 254099], [13, 254219], [18, 254459], [22, 254579], [30, 255319], [35, 255539], [41, 255959], [48, 256299], [51, 256459], [55, 256559], [61, 257279], [66, 257439], [69, 257579], [75, 257819], [79, 258039], [84, 258259], [88, 258439], [92, 258679], [95, 258799], [104, 259299], [108, 259919], [112, 260039], [116, 260279], [119, 260399], [126, 261139], [130, 261423], [134, 261523], [138, 261703], [141, 261823]]}, {"verse": 38, "start": 262763, "end": 267730, "text": "For he is not a God of the dead, but of the living: for all live to him.", "words": [[0, 262763], [4, 262875], [7, 263115], [10, 263375], [14, 263595], [16, 263775], [20, 264035], [23, 264195], [27, 264315], [33, 264855], [37, 265175], [40, 265315], [44, 265455], [52, 266301], [56, 266428], [60, 266748], [65, 267108], [68, 267368]]}, {"verse": 39, "start": 268080, "end": 272166, "text": "¶ Then certain of the scribes answering said, Master, you have well said.", "words": [[2, 268080], [7, 268334], [15, 268714], [18, 268914], [22, 269034], [30, 269554], [40, 269874], [46, 270710], [54, 271067], [58, 271307], [63, 271487], [68, 271687]]}, {"verse": 40, "start": 272516, "end": 275528, "text": "And after that they dared not ask him any question at all.", "words": [[0, 272516], [4, 272652], [10, 272912], [15, 273232], [20, 273352], [26, 273592], [30, 273812], [34, 274172], [38, 274332], [42, 274532], [51, 274892], [54, 275152]]}, {"verse": 41, "start": 275978, "end": 279548, "text": "And he said to them, How say they that Christ is David’s son?", "words": [[0, 275978], [4, 276104], [7, 276204], [12, 276404], [15, 276584], [21, 277173], [25, 277336], [29, 277576], [34, 277776], [39, 277996], [46, 278296], [49, 278576], [57, 279156]]}, {"verse": 42, "start": 279998, "end": 285220, "text": "And David himself says in the book of Psalms, The LORD said to my Lord, Sit on my right hand,", "words": [[0, 279998], [4, 280140], [10, 280420], [18, 280840], [23, 281160], [26, 281360], [30, 281440], [35, 281620], [38, 281720], [46, 282500], [50, 282620], [55, 282840], [60, 283080], [63, 283240], [66, 283400], [72, 283960], [76, 284140], [79, 284320], [82, 284480], [88, 284680]]}, {"verse": 43, "start": 285670, "end": 287494, "text": "Till I make your enemies your footstool.", "words": [[0, 285670], [5, 285808], [7, 285948], [12, 286148], [17, 286308], [25, 286628], [30, 286848]]}, {"verse": 44, "start": 287944, "end": 291547, "text": "David therefore calls him Lord, how is he then his son?", "words": [[0, 287944], [6, 288241], [16, 288661], [22, 289041], [26, 289241], [32, 290041], [36, 290261], [39, 290481], [42, 290621], [47, 290861], [51, 291041]]}, {"verse": 45, "start": 291897, "end": 295579, "text": "¶ Then in the audience of all the people he said to his disciples,", "words": [[2, 291897], [7, 292127], [10, 292347], [14, 292467], [23, 292867], [26, 293167], [30, 293427], [34, 293587], [41, 293867], [44, 294107], [49, 294327], [52, 294527], [56, 294707]]}, {"verse": 46, "start": 295829, "end": 305623, "text": "Beware of the scribes, which desire to walk in long robes, and love greetings in the markets, and the highest seats in the synagogues, and the chief rooms at feasts;", "words": [[0, 295829], [7, 296265], [10, 296405], [14, 296505], [23, 297265], [29, 297485], [36, 297945], [39, 298165], [44, 298485], [47, 298645], [52, 298925], [59, 299545], [63, 299925], [68, 300165], [78, 300565], [81, 300865], [85, 300965], [94, 301745], [98, 301905], [102, 302045], [110, 302305], [116, 302705], [119, 302905], [123, 303005], [135, 303925], [139, 303965], [143, 304085], [149, 304325], [155, 304785], [158, 304985]]}, {"verse": 47, "start": 306073, "end": 311969, "text": "Which devour widows’ houses, and for a show make long prayers: the same shall receive greater damnation.", "words": [[0, 306073], [6, 306218], [13, 306698], [21, 307138], [29, 307418], [33, 308078], [37, 308258], [39, 308358], [44, 308578], [49, 308818], [54, 309058], [63, 310000], [67, 310099], [72, 310379], [78, 310599], [86, 310919], [94, 311239]]}]}