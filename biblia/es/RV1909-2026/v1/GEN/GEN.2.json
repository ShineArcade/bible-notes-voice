{"book": "GEN", "chapter": 2, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 210536, "verses": [{"verse": 1, "start": 300, "end": 6039, "text": "Así quedaron terminados los cielos y la tierra, y todo lo que hay en ellos.", "words": [[0, 300], [4, 582], [13, 1102], [24, 1922], [28, 2202], [35, 3022], [37, 3222], [40, 3362], [48, 3762], [50, 4267], [55, 4567], [58, 4847], [62, 5027], [66, 5207], [69, 5447]]}, {"verse": 2, "start": 6389, "end": 14635, "text": "Y acabó Dios en el día séptimo su obra que hizo, y reposó el día séptimo de toda su obra que había hecho.", "words": [[0, 6389], [2, 6507], [8, 6987], [13, 7247], [16, 7507], [19, 7647], [23, 7847], [31, 8487], [34, 8727], [39, 9087], [43, 9287], [49, 10267], [51, 10737], [58, 11207], [61, 11347], [65, 11527], [73, 12307], [76, 12807], [81, 13047], [84, 13367], [89, 13627], [93, 13847], [99, 14087]]}, {"verse": 3, "start": 14985, "end": 23553, "text": "Y bendijo Dios al día séptimo, y lo santificó, porque en él reposó de toda su obra que había Dios creado y hecho.", "words": [[0, 14985], [2, 15106], [10, 15566], [15, 15846], [18, 16146], [22, 16346], [31, 17446], [33, 17706], [36, 17826], [47, 19106], [54, 19486], [57, 19686], [60, 19846], [67, 20446], [70, 20586], [75, 20786], [78, 21126], [83, 21406], [87, 21666], [93, 21926], [98, 22266], [105, 22826], [107, 23026]]}, {"verse": 4, "start": 23903, "end": 32278, "text": "Estos son los orígenes de los cielos y de la tierra cuando fueron creados, el día que Jehová Dios hizo la tierra y los cielos,", "words": [[0, 23903], [6, 24308], [10, 24548], [14, 24728], [23, 25428], [26, 25508], [30, 25648], [37, 26228], [39, 26348], [42, 26448], [45, 26588], [52, 27148], [59, 27328], [66, 27668], [75, 28428], [78, 28933], [82, 29173], [86, 29373], [93, 29873], [98, 30143], [103, 30413], [106, 30573], [113, 30953], [115, 31353], [119, 31513]]}, {"verse": 5, "start": 32628, "end": 46567, "text": "Y toda planta del campo antes que fuese en