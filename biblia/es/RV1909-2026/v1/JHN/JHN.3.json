{"book": "JHN", "chapter": 3, "lang": "es", "bible": "RV1909-2026", "engine": "chatterbox-videos-v1", "durationMs": 268276, "verses": [{"verse": 1, "start": 300, "end": 6444, "text": "Y había un hombre de los fariseos que se llamaba Nicodemo, dirigente de los judíos.", "words": [[0, 300], [2, 427], [8, 627], [11, 947], [18, 1247], [21, 1467], [25, 1627], [34, 2307], [38, 2447], [41, 2587], [49, 3087], [59, 4502], [69, 5262], [72, 5442], [76, 5582]]}, {"verse": 2, "start": 6794, "end": 16683, "text": "Este vino a Jesús de noche, y le dijo: Rabí, sabemos que has venido de Dios por maestro; porque nadie puede hacer estas señales que tú haces, si no está Dios con él.", "words": [[0, 6794], [5, 7019], [10, 7279], [12, 7459], [18, 7679], [21, 7919], [28, 8259], [30, 8639], [33, 8759], [39, 9663], [45, 9883], [53, 10163], [57, 10403], [61, 10523], [68, 10863], [71, 11003], [76, 11203], [80, 11463], [89, 12384], [96, 12565], [102, 12825], [108, 13125], [114, 13445], [120, 13705], [128, 14225], [132, 14405], [135, 14605], [142, 15065], [145, 15545], [148, 15645], [153, 15865], [158, 16065], [162, 16385]]}, {"verse": 3, "start": 16963, "end": 25586, "text": "Respondió Jesús, y le dijo: De cierto, de cierto te digo, que el que no nazca otra vez, no puede ver el reino de Dios.", "words": [[0, 16963], [10, 17523], [17, 17843], [19, 18063], [22, 18203], [28, 19162], [31, 19466], [39, 19770], [42, 20074], [49, 20378], [52, 20558], [58, 20898], [62, 21618], [65, 21738], [69, 21878], [72, 22078], [78, 22478], [83, 22718], [88, 23358], [91, 23758], [97, 24018], [101, 24298], [104, 24438], [110, 24818], [113, 24978]]}, {"verse": 4, "start": 25936, "end": 32625, "text": "Le dice Nicodemo: ¿Cómo puede el hombre nacer siendo viejo? ¿puede entrar otra vez en el vientre de su madre, y nacer?", "words": [[0, 25936], [3, 26157], [8, 26417], [18, 27479], [24, 27639], [30, 27919], [33, 28079], [40, 28239], [46, 28619], [53, 28879], [60, 29625], [67, 29807], [74, 30147], [79, 30347], [83, 30607], [86, 30747], [89, 30847], [97, 31187], [100, 31287], [103, 31427], [110, 31747], [112, 32147]]}, {"verse": 5, "start": 32905, "end": 41990, "text": "Respondió Jesús: De cierto, de cierto te digo, que el que no nazca de agua y del Espíritu, no puede entrar en el reino de Dios.", "words": [[0, 33059], [10, 33479], [17, 34381], [20, 34381], [28, 34381], [31, 34606], [38, 35726], [41, 36046], [47, 36966], [51, 37246], [54, 37426], [58, 37586], [61, 37806], [67, 38246], [70, 38446], [75, 38766], [77, 38926], [81, 39046], [91, 39606], [94, 39726], [100, 40006], [107, 40406], [110, 40646], [113, 40786], [119, 41186], [122, 41366]]}, {"verse": 6, "start": 42340, "end": 48573, "text": "Lo que es nacido de la carne, carne es; y lo que es nacido del Espíritu, espíritu es.", "words": [[0, 42340], [3, 42486], [7, 42646], [10, 42886], [17, 43631], [20, 43791], [23, 43911], [30, 44751], [36, 45211], [40, 46061], [42, 46163], [45, 46283], [49, 46423], [52, 46523], [59, 47043], [63, 47243], [73, 47863], [82, 48403]]}, {"verse": 7, "start": 48923, "end": 54426, "text": "No te maravilles de que te dije: Os es necesario nacer otra vez.", "words": [[0, 49093], [3, 49293], [6, 49513], [17, 50073], [20, 50233], [24, 50333], [27, 50493], [33, 51300], [36, 51680], [39, 52020], [49, 52920], [55, 53500], [60, 53860]]}, {"verse": 8, "start": 54776, "end": 65224, "text": "El viento de donde quiere sopla, y oyes su sonido; pero ni sabes de dónde viene, ni a dónde vaya: así es todo aquel que es nacido del Espíritu.", "words": [[0, 54776], [3, 54957], [10, 55337], [13, 55557], [19, 55757], [26, 56157], [33, 56777], [35, 57187], [40, 57597], [43, 57777], [51, 58721], [56, 58980], [59, 59140], [65, 59460], [68, 59700], [74, 59880], [81, 60271], [84, 60662], [86, 61052], [92, 61443], [98, 62009], [102, 62320], [105, 62520], [110, 62800], [116, 63260], [120, 63380], [123, 63580], [130, 64220], [134, 64400]]}, {"verse": 9, "start": 65574, "end": 69636, "text": "Respondió Nicodemo, y le dijo: ¿Cómo puede esto hacerse?", "words": [[0, 65574], [10, 66260], [20, 66980], [22, 67160], [25, 67260], [31, 68061], [37, 68258], [43, 68638], [48, 68918]]}, {"verse": 10, "start": 69916, "end": 75234, "text": "Respondió Jesús, y le dijo: ¿Tú eres el maestro de Israel, y no sabes esto?", "words": [[0, 69916], [10, 70476], [17, 70796], [19, 71016], [22, 71156], [28, 71844], [32, 71989], [37, 72289], [40, 72509], [48, 73069], [51, 73269], [59, 73809], [61, 74184], [64, 74304], [70, 74584]]}, {"verse": 11, "start": 75584, "end": 84314, "text": "De cierto, de cierto te digo, que lo que sabemos hablamos, y lo que hemos visto, testificamos; y no recibís nuestro testimonio.", "words": [[0, 75808], [3, 76068], [11, 76328], [14, 76588], [21, 76848], [24, 77028], [30, 77348], [34, 77528], [37, 77668], [41, 77788], [49, 78268], [59, 79108], [61, 79348], [64, 79488], [68, 79648], [74, 79868], [81, 80368], [95, 82180], [97, 82322], [100, 82482], [108, 83082], [116, 83342]]}, {"verse": 12, "start": 84664, "end": 91714, "text": "Si os he hablado de cosas terrenales y no creéis, ¿cómo creeréis si os digo las celestiales?", "words": [[0, 84664], [3, 84798], [6, 84964], [9, 85131], [17, 85771], [20, 85911], [26, 86211], [37, 87191], [39, 87451], [42, 87591], [50, 88531], [56, 88851], [65, 89851], [68, 89991], [71, 90131], [76, 90471], [80, 90611]]}, {"verse": 13, "start": 92064, "end": 99213, "text": "Y nadie subió al cielo, sino el que descendió del cielo, el Hijo del hombre, que está en el cielo.", "words": [[0, 92064], [2, 92064], [8, 92486], [14, 93046], [17, 93206], [24, 93646], [29, 94266], [32, 94526], [36, 94666], [46, 95526], [50, 95666], [57, 96226], [60, 96706], [65, 96946], [69, 97166], [77, 97506], [81, 97926], [86, 98166], [89, 98406], [92, 98546]]}, {"verse": 14, "start": 99563, "end": 107552, "text": "Y como Moisés levantó la serpiente en el desierto, así es necesario que el Hijo del hombre sea levantado;", "words": [[0, 99563], [2, 99705], [7, 100005], [14, 100565], [22, 101345], [25, 101465], [35, 102145], [38, 102305], [41, 102425], [51, 103525], [55, 103865], [58, 104125], [68, 104905], [72, 105260], [75, 105460], [80, 105700], [84, 105880], [91, 106200], [95, 106620]]}, {"verse": 15, "start": 107902, "end": 113380, "text": "Para que todo aquel que en él crea, no se pierda, sino que tenga vida eterna.", "words": [[0, 107902], [5, 108066], [9, 108226], [14, 108586], [20, 109186], [24, 109339], [27, 109493], [30, 109646], [36, 110066], [39, 110246], [42, 110406], [50, 111346], [55, 111546], [59, 111746], [65, 112086], [70, 112426]]}, {"verse": 16, "start": 113730, "end": 124583, "text": "Porque de tal manera amó Dios al mundo, que ha dado a su Hijo unigénito, para que todo aquel que en él cree, no se pierda, sino que tenga vida eterna.", "words": [[0, 113730], [7, 113952], [10, 114152], [14, 114412], [21, 114850], [25, 115289], [30, 115727], [33, 115867], [40, 116307], [44, 116747], [47, 116887], [52, 117127], [54, 117267], [57, 117447], [62, 118027], [73, 118607], [78, 119052], [82, 119212], [87, 119472], [93, 119972], [97, 120072], [100, 120252], [103, 120352], [109, 120792], [112, 121412], [115, 121592], [123, 122501], [128, 122781], [132, 123001], [138, 123301], [143, 123661]]}, {"verse": 17, "start": 124933, "end": 131474, "text": "Porque no envió Dios a su Hijo al mundo para que condene al mundo, sino para que el mundo sea salvo por él.", "words": [[0, 124933], [7, 125155], [10, 125435], [16, 125795], [21, 126015], [23, 126195], [26, 126355], [31, 126575], [34, 126755], [40, 127015], [45, 127295], [49, 127455], [57, 128015], [60, 128115], [67, 128535], [72, 128715], [77, 128995], [81, 129175], [84, 129335], [90, 129695], [94, 130135], [100, 130855], [104, 131115]]}, {"verse": 18, "start": 131824, "end": 141537, "text": "El que en él cree, no es condenado; pero el que no cree, ya es condenado, porque no creyó en el nombre del unigénito Hijo de Dios.", "words": [[0, 131824], [3, 132009], [7, 132249], [10, 132509], [13, 132629], [19, 133109], [22, 133689], [25, 133889], [36, 134978], [41, 135110], [44, 135280], [48, 135420], [51, 135600], [57, 136260], [60, 136708], [63, 137155], [74, 137603], [81, 137815], [84, 138055], [90, 138495], [93, 138635], [96, 138775], [103, 139215], [107, 139495], [117, 140415], [122, 140795], [125, 140995]]}, {"verse": 19, "start": 141887, "end": 151946, "text": "Y esta es la condenación: porque la luz vino al mundo, y los hombres amaron más las tinieblas que la luz; porque sus obras eran malas.", "words": [[0, 141887], [2, 142044], [7, 142284], [10, 142404], [13, 142544], [26, 143634], [33, 143879], [36, 144079], [40, 144359], [45, 144819], [48, 145099], [55, 145519], [57, 145734], [61, 145934], [69, 146314], [76, 147234], [80, 147574], [84, 148124], [94, 148674], [98, 148874], [101, 149014], [106, 149748], [113, 149949], [117, 150189], [123, 150649], [128, 151089]]}, {"verse": 20, "start": 152296, "end": 161150, "text": "Porque todo aquel que hace lo malo, aborrece la luz y no viene a la luz, para que sus obras no sean puestas en evidencia.", "words": [[0, 152296], [7, 152521], [12, 152861], [18, 153401], [22, 153521], [27, 153801], [30, 154001], [36, 154701], [45, 155341], [48, 155541], [52, 155801], [54, 156081], [57, 156281], [63, 156641], [65, 156841], [68, 156941], [73, 157701], [78, 157981], [82, 158121], [86, 158301], [92, 158681], [95, 159181], [100, 159441], [108, 160041], [111, 160201]]}, {"verse": 21, "start": 161500, "end": 168333, "text": "Pero el que practica la verdad, viene a la luz, para que sus obras sean manifestadas que son hechas en Dios.", "words": [[0, 161500], [5, 161644], [8, 161824], [12, 162204], [21, 162584], [24, 162744], [32, 163144], [38, 163604], [40, 163804], [43, 163864], [48, 164164], [53, 164679], [57, 164819], [61, 164999], [67, 165399], [72, 165779], [85, 166659], [89, 166839], [93, 167159], [100, 167479], [103, 167759]]}, {"verse": 22, "start": 168683, "end": 175826, "text": "Pasado esto, vino Jesús con sus discípulos a la tierra de Judea; y estaba allí con ellos, y bautizaba.", "words": [[0, 168683], [7, 169066], [13, 169346], [18, 169626], [24, 170126], [28, 170726], [32, 170946], [43, 171626], [45, 171806], [48, 171886], [55, 172186], [58, 172386], [65, 173221], [67, 173473], [74, 173753], [79, 174033], [83, 174313], [90, 174593], [92, 174933]]}, {"verse": 23, "start": 176176, "end": 183926, "text": "Y bautizaba también Juan en Enón junto a Salim, porque había allí muchas aguas; y venían, y eran bautizados.", "words": [[0, 176176], [2, 176282], [12, 176902], [20, 177262], [25, 177682], [28, 178002], [33, 178282], [39, 178582], [41, 178842], [48, 179262], [55, 179762], [61, 180082], [66, 180342], [73, 180602], [80, 181541], [82, 181670], [90, 182130], [92, 182650], [97, 182830]]}, {"verse": 24, "start": 184276, "end": 187314, "text": "Porque Juan no había sido aún puesto en la carcel.", "words": [[0, 184276], [7, 184498], [12, 184818], [15, 185318], [21, 185478], [26, 185838], [30, 186078], [37, 186378], [40, 186578], [43, 186678]]}, {"verse": 25, "start": 187664, "end": 193658, "text": "Y hubo una discusión entre los discípulos de Juan y los judíos acerca de la purificación.", "words": [[0, 187664], [2, 187789], [7, 188029], [11, 188189], [21, 188909], [27, 189169], [31, 189369], [42, 189949], [45, 190109], [50, 190409], [52, 190829], [56, 190949], [63, 191489], [70, 192009], [73, 192309], [76, 192409]]}, {"verse": 26, "start": 194008, "end": 203738, "text": "Y vinieron a Juan, y le dijeron: Rabí, el que estaba contigo del otro lado del Jordán, del cual tú diste testimonio, he aquí bautiza, y todos vienen a él.", "words": [[0, 194008], [2, 194133], [11, 194553], [13, 194693], [19, 194973], [21, 195233], [24, 195333], [33, 196284], [39, 196470], [42, 196657], [46, 196737], [53, 197057], [61, 197577], [65, 197757], [70, 197997], [75, 198257], [79, 198477], [87, 199357], [91, 199457], [96, 199677], [99, 199897], [105, 200237], [117, 201197], [120, 201337], [125, 201557], [134, 202517], [136, 202597], [142, 202837], [149, 203217], [151, 203437]]}, {"verse": 27, "start": 204018, "end": 209480, "text": "Respondió Juan, y dijo: No puede el hombre recibir algo, si no le es dado del cielo.", "words": [[0, 204018], [10, 204662], [16, 204962], [18, 205222], [24, 205936], [27, 206077], [33, 206357], [36, 206557], [43, 206757], [51, 207157], [57, 207877], [60, 208097], [63, 208257], [66, 208397], [69, 208537], [74, 208757], [78, 208977]]}, {"verse": 28, "start": 209830, "end": 215952, "text": "Vosotros mismos me sois testigos que dije: Yo no soy el Cristo, sino que soy enviado delante de él.", "words": [[0, 209830], [9, 210272], [16, 210572], [19, 210852], [24, 211172], [33, 211612], [37, 211812], [43, 212477], [46, 212644], [49, 212764], [53, 213064], [56, 213184], [64, 213964], [69, 214144], [73, 214324], [77, 214504], [85, 215024], [93, 215464], [96, 215644]]}, {"verse": 29, "start": 216302, "end": 226557, "text": "El que tiene la esposa, es el esposo; pero el amigo del esposo, que está en pie y le oye, se goza grandemente de la voz del esposo; así pues, este mi gozo es cumplido.", "words": [[0, 216302], [3, 216434], [7, 216574], [13, 216834], [16, 216994], [24, 217534], [27, 217974], [30, 218114], [38, 219001], [43, 219122], [46, 219242], [52, 219482], [56, 219682], [64, 220182], [68, 220362], [73, 220542], [76, 220742], [80, 220922], [82, 221082], [85, 221142], [90, 221722], [93, 221822], [98, 222102], [110, 222782], [113, 222962], [116, 223062], [120, 223242], [124, 223422], [132, 224305], [136, 224483], [142, 224963], [147, 225190], [150, 225416], [155, 225643], [158, 225843]]}, {"verse": 30, "start": 226907, "end": 229156, "text": "A él conviene crecer, pero a mí menguar.", "words": [[0, 226907], [2, 227034], [5, 227194], [14, 227634], [22, 228234], [27, 228334], [29, 228434], [32, 228824]]}, {"verse": 31, "start": 229506, "end": 238268, "text": "El que de arriba viene, sobre todos es: el que es de la tierra, terreno es, y cosas terrenas habla: el que viene del cielo, sobre todos es.", "words": [[0, 229506], [3, 229626], [7, 229746], [10, 229886], [17, 230126], [24, 230506], [30, 230806], [36, 231126], [40, 231876], [43, 232026], [47, 232186], [50, 232346], [53, 232446], [56, 232546], [64, 232926], [72, 233486], [76, 233826], [78, 234226], [84, 234466], [93, 235166], [100, 235928], [103, 236050], [107, 236170], [113, 236410], [117, 236630], [124, 237030], [130, 237350], [136, 237670]]}, {"verse": 32, "start": 238618, "end": 243116, "text": "Y lo que vio y oyó, esto testifica: y nadie recibe su testimonio.", "words": [[0, 238618], [2, 238722], [5, 238822], [9, 238962], [13, 239282], [15, 239502], [20, 240022], [25, 240282], [36, 241376], [38, 241499], [44, 241699], [51, 242219], [54, 242319]]}, {"verse": 33, "start": 243466, "end": 248898, "text": "El que recibe su testimonio, este confirmó con su sello que Dios es verdadero.", "words": [[0, 243522], [3, 243592], [7, 243732], [14, 244272], [17, 244432], [29, 245772], [34, 245972], [43, 246612], [47, 246752], [50, 246932], [56, 247352], [60, 247532], [65, 247812], [68, 248132]]}, {"verse": 34, "start": 249248, "end": 255542, "text": "Porque el que Dios envió, las palabras de Dios habla: porque no da Dios el Espíritu por medida.", "words": [[0, 249248], [7, 249451], [10, 249611], [14, 249751], [19, 249971], [26, 250931], [30, 251051], [39, 251431], [42, 251671], [47, 252116], [54, 252733], [61, 252939], [64, 253159], [67, 253359], [72, 253559], [75, 253779], [84, 254339], [88, 254499]]}, {"verse": 35, "start": 255892, "end": 259499, "text": "El Padre ama al Hijo, y todas las cosas dio en su mano.", "words": [[0, 255892], [3, 256010], [9, 256430], [13, 256650], [16, 256850], [22, 257150], [24, 257630], [30, 257850], [34, 258110], [40, 258410], [44, 258770], [47, 258950], [50, 259090]]}, {"verse": 36, "start": 259849, "end": 267876, "text": "El que cree en el Hijo, tiene vida eterna; pero el que es incrédulo al Hijo, no verá la vida, sino que la ira de Dios está sobre él.", "words": [[0, 259849], [3, 259970], [7, 260090], [12, 260370], [15, 260530], [18, 260650], [24, 260950], [30, 261410], [35, 261690], [43, 262500], [48, 262634], [51, 262794], [55, 262934], [58, 263134], [68, 263734], [71, 263914], [77, 264234], [80, 264614], [85, 264894], [88, 264994], [94, 265574], [99, 265874], [103, 266074], [106, 266214], [110, 266514], [113, 266614], [118, 266874], [123, 267234], [129, 267514]]}]}